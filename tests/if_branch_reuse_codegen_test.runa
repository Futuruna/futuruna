> suffix_or_self(text: String) -> String {
    = suffix = if string_length(text) > 3 {
        substring(text, 1, 3)
    } else {
        text
    }
    suffix + ":" + text
}

= short_ok = suffix_or_self("cat") == "cat:cat"
| short_holds: short_ok -> short_ok
? short_holds

= long_ok = suffix_or_self("futuruna") == "utu:futuruna"
| long_holds: long_ok -> long_ok
? long_holds

@ print("if branch reuse codegen passed")
