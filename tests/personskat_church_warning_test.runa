@ sprog da

@ importer ../examples / danish - income - tax / personskat - beregningskontrol
@ importer ../examples / danish - income - tax / personskat - kirkeskat

= kirkeskat_vurdering = personskat_beregningsvurdering([
    PersonskatInputkontrol(sti = "fiktiv_kontrol", gyldig = Sandt, forklaring = "Fiktiv kontrol, ikke kildefakta.")
    ], 12345)
= kirkeskat_ugyldig = personskat_beregningsvurdering([
    PersonskatInputkontrol(sti = "fiktiv_kontrol", gyldig = Falskt, forklaring = "Fiktiv fejl.")
    ], 12345)

| kirkeskat_forbehold_bevares: kirkeskat_vurdering -> any(kirkeskat_vurdering.forbehold, |tekst: Tekst| tekst == personskat_kirkeskat_forbehold) && any(kirkeskat_ugyldig.forbehold, |tekst: Tekst| tekst == personskat_kirkeskat_forbehold)
| kirkeskat_forbehold_bevarer_kontrolstatus: kirkeskat_vurdering -> kirkeskat_vurdering.status == BeregnetMedForbehold && kirkeskat_vurdering.slutskat_til_sammenligning_øre == Some(12345) && kirkeskat_vurdering.samlet_modeldækning_bekræftet == Falskt && kirkeskat_ugyldig.slutskat_til_sammenligning_øre == None

= kirkestatusser = [KirkeskatUoplyst, IngenKirkeskatHeleÅret, KirkeskatHeleÅret, KirkeskatEnDelAfÅret]
| kun_afklarede_helårsstatusser_understøttes: kirkestatusser -> map(kirkestatusser, personskat_kirkeskat_status_understøttet) == [Falskt, Sandt, Sandt, Falskt]
| helårsbro_bevarer_medlem_og_diagnostik: kirkestatusser -> map(kirkestatusser, personskat_kirkeskat_til_helårsberegning) == [Falskt, Falskt, Sandt, Falskt]

? kirkeskat_forbehold_bevares
? kirkeskat_forbehold_bevarer_kontrolstatus
? kun_afklarede_helårsstatusser_understøttes
? helårsbro_bevarer_medlem_og_diagnostik
