-- multiline_list_test.runa — Multi-line list literals

@ print("=== Multi-line Lists ===")

-- Basic multi-line
= nums = [
1,
2,
3,
4,
5
]
@ print("nums: " + show(nums))

-- Trailing comma
= colors = [
"red",
"green",
"blue",
]
@ print("colors: " + show(colors))

-- Nested multi-line
= grid = [
[1, 2, 3],
[4, 5, 6],
[7, 8, 9],
]
@ print("grid: " + show(grid))

-- Single line still works
= xs = [10, 20, 30]
@ print("xs: " + show(xs))

-- Struct constructors in multi-line list
# Point(x: Int, y: Int)

= points = [
Point(0, 0),
Point(1, 1),
Point(2, 4),
]
@ print("points: " + show(points))

-- Multi-line with expressions
= computed = [
1 + 2,
3 * 4,
10 - 5,
]
@ print("computed: " + show(computed))

-- Multi-line in function call argument
= total = sum_list([
100,
200,
300,
])
@ print("total: " + show(total))

-- Mixed: some on same line, some on new lines
= mixed = [1, 2,
3, 4,
5]
@ print("mixed: " + show(mixed))

@ print("")
@ print("=== All multi-line list tests passed! ===")
