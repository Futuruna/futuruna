-- Explicit proof fixture for `runa verify`

| add_comm: (a, b) -> a + b == b + a
? add_comm by {
    | (lhs, rhs) -> apply int_ring.comm_add
}

| mul_comm: (a, b) -> a * b == b * a
? mul_comm by {
    | (lhs, rhs) -> apply int_ring.comm_mul
}

| zero_self: x -> x >= x
? zero_self by {
    | n -> apply int_ord.le_refl
}

= proof_anchor = 0
| literal_order: proof_anchor -> 2 <= 5
? literal_order by {
    | n -> apply int_ord.le_of_concrete
}
