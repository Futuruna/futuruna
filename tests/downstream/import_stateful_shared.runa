-- library-hygiene: importable
-- roundtrip-skip: library file, no expected output

@ export
~ visit_pages = subject("boot")

@ export
~ visit_channels = subject("seed")

@ export
> latest_visit_page() -> String {
    visit_pages.latest
}

@ export
> latest_visit_channel() -> String {
    visit_channels.latest
}

@ export
> visit_snapshot() -> String {
    "pages=" + show(visit_pages.count) + "|channels=" + show(visit_channels.count) + "|latest_page=" + latest_visit_page() + "|latest_channel=" + latest_visit_channel()
}
