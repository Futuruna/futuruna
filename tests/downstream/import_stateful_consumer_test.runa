-- roundtrip-skip: imported downstream stateful consumers use actor surfaces

@ import ./import_stateful_shared
@ import StatePolicy from ./import_stateful_policy

= queue = spawn(job_queue, empty_queue())

queue <- Enqueue("ingest")
queue <- Enqueue("score")
queue <- Enqueue("archive")

= first_pick = ask(queue, StartNext)
= first_ok = queue_snapshot(first_pick) == "pending=score>archive|active=ingest|done="
? first_ok

queue <- FinishActive
= second_pick = ask(queue, StartNext)
= second_ok = queue_snapshot(second_pick) == "pending=archive|active=score|done=ingest"
? second_ok

queue <- FinishActive
= third_pick = ask(queue, StartNext)
= third_ok = queue_snapshot(third_pick) == "pending=|active=archive|done=ingest>score"
? third_ok

queue <- FinishActive
= drained = ask(queue, StartNext)
= drained_snapshot = queue_snapshot(drained)
= drained_ok = drained_snapshot == "pending=|active=idle|done=ingest>score>archive"
? drained_ok

= archive_ok = StatePolicy.needs_archive(third_pick.active)
? archive_ok

= idle_ok = StatePolicy.is_idle(drained_snapshot)
? idle_ok

@ print("downstream stateful consumer passed")
