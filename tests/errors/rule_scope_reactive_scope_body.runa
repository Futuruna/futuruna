-- expect-error: `| scope` is a reactive lifecycle scope; use `# TaxCase(...) { | rule(...) -> ... }` for pure scoped rules
# Person(age: Int)

# TaxCase(person: Person) {
    | scope Inner {
        = value = 1
    }
    | allowance() -> person.age
}

= tax = TaxCase(Person(40))
= allowance = tax.allowance()
