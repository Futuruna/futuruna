-- ============================================================================
-- TAU IN TAU: The Self-Hosting Bootstrap
-- ============================================================================
--
-- This file implements the Futuruna programming language using Futuruna-Complete syntax.
-- Every feature of the language — runes, dependent types, algebraic effects,
-- pattern matching, logic rules, actors, ownership, default logic — is used
-- to implement the language itself.
--
-- The implementation has four phases:
--   1. Tokenizer (lexer)        — text -> tokens
--   2. Parser                   — tokens -> AST
--   3. Type checker             — AST -> typed AST
--   4. Evaluator (interpreter)  — typed AST -> values
--
-- This is the body writing itself. The soul measuring itself.
-- ============================================================================


-- ============================================================================
-- PART 0: Core Types (the atoms of meaning)
-- ============================================================================

# Nat = Zero | Succ(Nat)

# Bool = True | False

# Option(a: Type) = None | Some(a)

# Result(a: Type, e: Type) = Ok(a) | Err(e)

# List(a: Type) = Nil | Cons(a, List(a))

# Vec(n: Nat, a: Type) = VNil | VCons(a, Vec(n, a))

# String = List(Char)

# Pair(a: Type, b: Type) = MkPair(a, b)

-- List operations used throughout
> length(xs: List(a)) -> Nat {
    match xs {
        | Nil -> Zero
        | Cons(_, tail) -> Succ(length(tail))
    }
}

> map(xs: List(a), f: a -> b) -> List(b) {
    match xs {
        | Nil -> Nil
        | Cons(h, t) -> Cons(f(h), map(t, f))
    }
}

> filter(xs: List(a), pred: a -> Bool) -> List(a) {
    match xs {
        | Nil -> Nil
        | Cons(h, t) -> {
            = rest = filter(t, pred)
            if pred(h) { Cons(h, rest) } else { rest }
        }
    }
}

> foldl(xs: List(a), acc: b, f: b -> a -> b) -> b {
    match xs {
        | Nil -> acc
        | Cons(h, t) -> foldl(t, f(acc, h), f)
    }
}

> concat(xs: List(a), ys: List(a)) -> List(a) {
    match xs {
        | Nil -> ys
        | Cons(h, t) -> Cons(h, concat(t, ys))
    }
}

> reverse(xs: List(a)) -> List(a) {
    foldl(xs, Nil, |acc, x| Cons(x, acc))
}

> zip(xs: List(a), ys: List(b)) -> List(Pair(a, b)) {
    match MkPair(xs, ys) {
        | MkPair(Nil, _) -> Nil
        | MkPair(_, Nil) -> Nil
        | MkPair(Cons(x, xt), Cons(y, yt)) -> Cons(MkPair(x, y), zip(xt, yt))
    }
}

> lookup(key: String, pairs: List(Pair(String, v))) -> Option(v) {
    match pairs {
        | Nil -> None
        | Cons(MkPair(k, v), rest) -> {
            if k == key { Some(v) } else { lookup(key, rest) }
        }
    }
}


-- ============================================================================
-- PART 1: TOKENIZER
-- ============================================================================
-- The tokenizer recognizes Futuruna's 15 token categories.
-- Every rune, every keyword, every bracket — this is where
-- the three axes begin.

-- The 15 token types (matching our S_tau model exactly)
# TokenKind
    = TkStart       -- beginning of statement
    | TkKW          -- keywords: match, if, else, with, under, exception, scope, on, actor, spawn
    | TkIdent       -- identifiers: x, foo, Person
    | TkOp          -- operators + runes: >, |, #, @, =, +, -, *, ==, <-, ->
    | TkDelim       -- delimiters that aren't brackets: ,
    | TkLit         -- literals: 42, "hello", True
    | TkType        -- type names (uppercase start): Int, String, List, Vec
    | TkParen       -- ( and )
    | TkBrace       -- { and }
    | TkSemi        -- statement separators (newline in Futuruna)
    | TkDot         -- . (field access)
    | TkArrow       -- -> (function types, clause bodies)
    | TkComma       -- , (separators in arguments and tuples)
    | TkColon       -- : (type annotations)
    | TkEnd         -- end of input

# Span = MkSpan(line: Nat, col: Nat, len: Nat)

# Token = MkToken(kind: TokenKind, text: String, span: Span)

-- Effect for reading source text character by character
# effect Source {
    > peek() -> Option(Char)
    > advance() -> Char
    > position() -> Pair(Nat, Nat)
}

-- Effect for emitting tokens
# effect Emit {
    > emit(tok: Token) -> ()
}

-- Character classification rules (logic!)
| is_alpha(c)    -> c >= 'a', c <= 'z'
| is_alpha(c)    -> c >= 'A', c <= 'Z'
| is_alpha('_')

| is_digit(c)    -> c >= '0', c <= '9'

| is_alnum(c)    -> is_alpha(c)
| is_alnum(c)    -> is_digit(c)

| is_upper(c)    -> c >= 'A', c <= 'Z'

| is_whitespace(' ')
| is_whitespace('\t')
| is_whitespace('\r')

| is_rune('>')
| is_rune('|')
| is_rune('#')
| is_rune('@')
| is_rune('=')

| is_operator('+')
| is_operator('-')
| is_operator('*')
| is_operator('/')
| is_operator('<')
| is_operator('>')
| is_operator('!')
| is_operator('&')
| is_operator('=')
| is_operator('|')
| is_operator('#')
| is_operator('@')
| is_operator('?')

-- Keywords (the soul of Axis 1)
| is_keyword("match")
| is_keyword("if")
| is_keyword("else")
| is_keyword("with")
| is_keyword("under")
| is_keyword("exception")
| is_keyword("scope")
| is_keyword("on")
| is_keyword("actor")
| is_keyword("spawn")
| is_keyword("effect")
| is_keyword("module")
| is_keyword("import")
| is_keyword("where")
| is_keyword("mut")

-- The tokenizer: reads characters, emits tokens
> tokenize(source: String) -> List(Token) with Source, Emit {
    = tokens: List(Token) = Nil
    > loop() -> List(Token) {
        match @ peek() {
            | None -> reverse(tokens)
            | Some(c) -> {
                skip_whitespace()
                match @ peek() {
                    | None -> reverse(tokens)
                    | Some(c) -> {
                        = tok = read_token(c)
                        = tokens = Cons(tok, tokens)
                        @ emit(tok)
                        loop()
                    }
                }
            }
        }
    }
    loop()
}

-- Skip whitespace and comments
> skip_whitespace() with Source {
    match @ peek() {
        | Some(c) -> {
            if is_whitespace(c) {
                @ advance()
                skip_whitespace()
            } else if c == '-' {
                -- peek ahead for comment
                skip_comment_maybe()
            } else {
                ()  -- done
            }
        }
        | None -> ()
    }
}

-- Read a single token based on first character
> read_token(c: Char) -> Token with Source {
    = pos = @ position()
    if c == '\n' {
        @ advance()
        MkToken(TkSemi, "\n", span_from(pos, 1))
    } else if is_rune(c) {
        read_operator(pos)
    } else if is_digit(c) {
        read_number(pos)
    } else if c == '"' {
        read_string(pos)
    } else if c == '\'' {
        read_char(pos)
    } else if is_alpha(c) {
        read_word(pos)
    } else if c == '(' {
        @ advance()
        MkToken(TkParen, "(", span_from(pos, 1))
    } else if c == ')' {
        @ advance()
        MkToken(TkParen, ")", span_from(pos, 1))
    } else if c == '{' {
        @ advance()
        MkToken(TkBrace, "{", span_from(pos, 1))
    } else if c == '}' {
        @ advance()
        MkToken(TkBrace, "}", span_from(pos, 1))
    } else if c == ',' {
        @ advance()
        MkToken(TkComma, ",", span_from(pos, 1))
    } else if c == ':' {
        @ advance()
        MkToken(TkColon, ":", span_from(pos, 1))
    } else if c == '.' {
        @ advance()
        MkToken(TkDot, ".", span_from(pos, 1))
    } else if is_operator(c) {
        read_operator(pos)
    } else {
        @ advance()
        MkToken(TkOp, char_to_string(c), span_from(pos, 1))
    }
}

-- Read a word: identifier, keyword, or type name
> read_word(start: Pair(Nat, Nat)) -> Token with Source {
    = chars: List(Char) = Nil
    > collect() -> List(Char) {
        match @ peek() {
            | Some(c) -> {
                if is_alnum(c) {
                    @ advance()
                    = chars = Cons(c, chars)
                    collect()
                } else {
                    reverse(chars)
                }
            }
            | None -> reverse(chars)
        }
    }
    = text = chars_to_string(collect())
    = len = string_length(text)
    if is_keyword(text) {
        MkToken(TkKW, text, span_from(start, len))
    } else if is_upper(string_head(text)) {
        MkToken(TkType, text, span_from(start, len))
    } else {
        MkToken(TkIdent, text, span_from(start, len))
    }
}

-- Read a number literal
> read_number(start: Pair(Nat, Nat)) -> Token with Source {
    = chars: List(Char) = Nil
    > collect() -> List(Char) {
        match @ peek() {
            | Some(c) -> {
                if is_digit(c) {
                    @ advance()
                    = chars = Cons(c, chars)
                    collect()
                } else if c == '.' {
                    @ advance()
                    = chars = Cons('.', chars)
                    collect()
                } else {
                    reverse(chars)
                }
            }
            | None -> reverse(chars)
        }
    }
    = text = chars_to_string(collect())
    MkToken(TkLit, text, span_from(start, string_length(text)))
}

-- Read an operator (possibly multi-character: ->, <-, ==, !=)
> read_operator(start: Pair(Nat, Nat)) -> Token with Source {
    = c1 = @ advance()
    match @ peek() {
        | Some(c2) -> {
            if c1 == '-' && c2 == '>' {
                @ advance()
                MkToken(TkArrow, "->", span_from(start, 2))
            } else if c1 == '<' && c2 == '-' {
                @ advance()
                MkToken(TkOp, "<-", span_from(start, 2))
            } else if c1 == '=' && c2 == '=' {
                @ advance()
                MkToken(TkOp, "==", span_from(start, 2))
            } else if c1 == '!' && c2 == '=' {
                @ advance()
                MkToken(TkOp, "!=", span_from(start, 2))
            } else if c1 == '>' && c2 == '=' {
                @ advance()
                MkToken(TkOp, ">=", span_from(start, 2))
            } else if c1 == '<' && c2 == '=' {
                @ advance()
                MkToken(TkOp, "<=", span_from(start, 2))
            } else if c1 == '&' && c2 == '&' {
                @ advance()
                MkToken(TkOp, "&&", span_from(start, 2))
            } else if c1 == '|' && c2 == '|' {
                @ advance()
                MkToken(TkOp, "||", span_from(start, 2))
            } else {
                MkToken(TkOp, char_to_string(c1), span_from(start, 1))
            }
        }
        | None -> MkToken(TkOp, char_to_string(c1), span_from(start, 1))
    }
}

-- Read a string literal
> read_string(start: Pair(Nat, Nat)) -> Token with Source {
    @ advance()  -- consume opening "
    = chars: List(Char) = Nil
    > collect() -> List(Char) {
        match @ peek() {
            | Some('"') -> {
                @ advance()
                reverse(chars)
            }
            | Some('\\') -> {
                @ advance()
                = escaped = @ advance()
                = chars = Cons(unescape(escaped), chars)
                collect()
            }
            | Some(c) -> {
                @ advance()
                = chars = Cons(c, chars)
                collect()
            }
            | None -> reverse(chars)  -- unterminated string
        }
    }
    = text = chars_to_string(collect())
    MkToken(TkLit, "\"" + text + "\"", span_from(start, string_length(text) + 2))
}


-- ============================================================================
-- PART 2: ABSTRACT SYNTAX TREE
-- ============================================================================
-- The AST mirrors the runes: each top-level node kind corresponds
-- to a statement rune. This is Axis 1 made concrete.

-- Type expressions (Axis 2)
# Ty
    = TyName(name: String)                         -- Int, Bool, String
    | TyApp(con: Ty, args: List(Ty))               -- List(Int), Vec(3, Bool)
    | TyArrow(from: Ty, to: Ty)                    -- Int -> Bool
    | TyRef(inner: Ty)                              -- &T (ownership)
    | TyMutRef(inner: Ty)                           -- &mut T
    | TyVar(name: String)                           -- a, b (polymorphic)
    | TyDep(name: String, ty: Ty, body: Ty)         -- (n: Nat) -> Vec(n, a)
    | TyUnit                                        -- ()
    | TyHole                                        -- _ (infer)

-- Patterns (used in |, match, function args)
# Pat
    = PatWild                                       -- _
    | PatVar(name: String)                          -- x
    | PatLit(lit: Literal)                          -- 42, "hi"
    | PatCon(name: String, args: List(Pat))         -- Cons(x, xs)
    | PatAs(pat: Pat, name: String)                 -- pat @ name

-- Literals
# Literal
    = LitInt(value: Int)
    | LitFloat(value: Float)
    | LitString(value: String)
    | LitChar(value: Char)
    | LitBool(value: Bool)

-- Expressions (the computation core)
# Expr
    = EVar(name: String)                            -- x
    | ELit(lit: Literal)                            -- 42
    | EApp(fun: Expr, args: List(Expr))             -- f(x, y)
    | ELam(params: List(Param), body: Expr)         -- |x, y| x + y
    | EBinOp(op: String, lhs: Expr, rhs: Expr)     -- a + b
    | EUnOp(op: String, operand: Expr)              -- !x
    | EIf(cond: Expr, then_: Expr, else_: Expr)     -- if c { t } else { e }
    | EMatch(scrut: Expr, arms: List(MatchArm))     -- match x { | ... }
    | EBlock(stmts: List(Stmt))                     -- { s1; s2; expr }
    | EField(obj: Expr, field: String)              -- x.foo
    | EIndex(arr: Expr, idx: Expr)                  -- xs[i]
    | ERef(expr: Expr)                              -- &x
    | EMutRef(expr: Expr)                           -- &mut x
    | ESend(target: Expr, msg: Expr)                -- c <- Increment
    | ERecv(target: Expr, msg: Expr)                -- c ? Get
    | ESpawn(expr: Expr)                            -- spawn Counter(0)
    | EEffect(name: String, args: List(Expr))       -- @ print("hi")

# Param = MkParam(name: String, ty: Option(Ty))

# MatchArm = MkArm(pat: Pat, guard: Option(Expr), body: Expr)

-- Statements (each begins with a rune — THIS is the three-axis structure)
# Stmt
    = SDefn(defn: Defn)            -- > rune
    | SRule(rule: Rule)            -- | rune
    | SType(tydecl: TypeDecl)      -- # rune
    | SAnnot(annot: Annot)         -- @ rune
    | SBind(bind: Binding)         -- = rune
    | SExpr(expr: Expr)            -- bare expression (in blocks)

-- > Definition (function, value, actor, module)
# Defn
    = FnDefn(
        name: String,
        params: List(Param),
        ret_ty: Option(Ty),
        effects: List(String),      -- with IO, Source
        body: Expr
      )
    | ActorDefn(
        name: String,
        state_param: Param,
        handlers: List(Handler)
      )
    | ModuleDefn(
        name: String,
        body: List(Stmt)
      )

# Handler = MkHandler(msg: Pat, body: Expr)

-- | Rule (logic clause, match arm, law scope)
# Rule
    = Clause(
        head: Expr,                 -- | member(X, Cons(X, _))
        body: Option(Expr)          -- -> conditions
      )
    | DefaultRule(
        head: Expr,
        body: Expr,
        condition: Option(Expr)     -- under guard
      )
    | ExceptionRule(
        label: String,              -- exception student
        head: Expr,
        body: Expr,
        condition: Option(Expr)
      )
    | Scope(
        name: String,               -- scope TaxRate
        rules: List(Stmt)
      )

-- # Type declaration
# TypeDecl
    = ADT(
        name: String,
        params: List(Param),        -- dependent type params
        variants: List(Variant)
      )
    | Alias(
        name: String,
        params: List(Param),
        target: Ty
      )
    | EffectDecl(
        name: String,
        ops: List(Defn)             -- effect operations
      )
    | TypeClass(
        name: String,
        param: String,
        methods: List(Defn)
      )

# Variant = MkVariant(name: String, fields: List(Ty))

-- @ Annotation
# Annot
    = AnnPure
    | AnnTotal
    | AnnMemoize
    | AnnTest
    | AnnInline
    | AnnCustom(name: String, args: List(Expr))

-- = Binding
# Binding = MkBinding(
    pat: Pat,
    ty: Option(Ty),
    value: Expr
  )

-- A complete program
# Program = MkProgram(stmts: List(Stmt))


-- ============================================================================
-- PART 3: PARSER
-- ============================================================================
-- Recursive descent, rune-dispatched. The first token on each line
-- determines the parsing strategy. This is Axis 1 in action:
-- the cognitive axes ARE the dispatch mechanism.

-- Parser state effect
# effect Parse {
    > peek_token() -> Option(Token)
    > next_token() -> Token
    > expect(kind: TokenKind, text: String) -> Token
    > expect_kind(kind: TokenKind) -> Token
    > error(msg: String, span: Span) -> ()
}

-- The main parse loop: dispatch on rune
> parse_program() -> Program with Parse {
    = stmts: List(Stmt) = Nil
    > loop() -> Program {
        match @ peek_token() {
            | None -> MkProgram(reverse(stmts))
            | Some(tok) -> {
                skip_semis()
                match @ peek_token() {
                    | None -> MkProgram(reverse(stmts))
                    | Some(tok) -> {
                        = stmt = parse_statement(tok)
                        = stmts = Cons(stmt, stmts)
                        loop()
                    }
                }
            }
        }
    }
    loop()
}

-- Rune dispatch: THE heart of Futuruna's parsing
> parse_statement(tok: Token) -> Stmt with Parse {
    match tok.kind {
        | TkOp -> {
            match tok.text {
                -- > rune: definition
                | ">" -> {
                    @ next_token()
                    SDefn(parse_definition())
                }
                -- | rune: rule/clause/scope
                | "|" -> {
                    @ next_token()
                    SRule(parse_rule())
                }
                -- # rune: type declaration
                | "#" -> {
                    @ next_token()
                    SType(parse_type_decl())
                }
                -- @ rune: annotation
                | "@" -> {
                    @ next_token()
                    SAnnot(parse_annotation())
                }
                -- = rune: binding
                | "=" -> {
                    @ next_token()
                    SBind(parse_binding())
                }
                | _ -> SExpr(parse_expr())
            }
        }
        -- Bare expression (inside blocks)
        | _ -> SExpr(parse_expr())
    }
}

-- Parse > definition: function, actor, or module
> parse_definition() -> Defn with Parse {
    = name_tok = @ expect_kind(TkIdent)
    match @ peek_token() {
        -- > actor Name(state) { ... }
        | Some(MkToken(TkKW, "actor", _)) -> {
            parse_actor_defn(name_tok.text)
        }
        -- > module Name { ... }
        | Some(MkToken(TkKW, "module", _)) -> {
            @ next_token()
            parse_module_defn(name_tok.text)
        }
        -- > name(args) -> RetTy { body }
        | _ -> parse_fn_defn(name_tok.text)
    }
}

-- Parse a function definition
> parse_fn_defn(name: String) -> Defn with Parse {
    = params = parse_params()
    = ret_ty: Option(Ty) = match @ peek_token() {
        | Some(MkToken(TkArrow, "->", _)) -> {
            @ next_token()
            Some(parse_type())
        }
        | _ -> None
    }
    = effects: List(String) = match @ peek_token() {
        | Some(MkToken(TkKW, "with", _)) -> {
            @ next_token()
            parse_effect_list()
        }
        | _ -> Nil
    }
    = body = parse_block()
    FnDefn(name, params, ret_ty, effects, body)
}

-- Parse function parameters: (name: Ty, name: Ty)
> parse_params() -> List(Param) with Parse {
    @ expect(TkParen, "(")
    = params: List(Param) = Nil
    > loop() -> List(Param) {
        match @ peek_token() {
            | Some(MkToken(TkParen, ")", _)) -> {
                @ next_token()
                reverse(params)
            }
            | _ -> {
                if params != Nil {
                    @ expect(TkComma, ",")
                }
                = name_tok = @ expect_kind(TkIdent)
                = ty: Option(Ty) = match @ peek_token() {
                    | Some(MkToken(TkColon, ":", _)) -> {
                        @ next_token()
                        Some(parse_type())
                    }
                    | _ -> None
                }
                = params = Cons(MkParam(name_tok.text, ty), params)
                loop()
            }
        }
    }
    loop()
}

-- Parse an actor definition
> parse_actor_defn(name: String) -> Defn with Parse {
    @ next_token()  -- consume "actor"
    = state_param = parse_single_param()
    @ expect(TkBrace, "{")
    = handlers: List(Handler) = Nil
    > loop() -> List(Handler) {
        match @ peek_token() {
            | Some(MkToken(TkBrace, "}", _)) -> {
                @ next_token()
                reverse(handlers)
            }
            | Some(MkToken(TkOp, "|", _)) -> {
                @ next_token()
                @ expect(TkKW, "on")
                = msg_pat = parse_pattern()
                @ expect(TkArrow, "->")
                = body = parse_expr()
                = handlers = Cons(MkHandler(msg_pat, body), handlers)
                loop()
            }
            | _ -> {
                skip_semis()
                loop()
            }
        }
    }
    ActorDefn(name, state_param, loop())
}

-- Parse | rule: clause, default rule, exception, or scope
> parse_rule() -> Rule with Parse {
    match @ peek_token() {
        -- | scope Name { ... }
        | Some(MkToken(TkKW, "scope", _)) -> {
            @ next_token()
            = name_tok = @ expect_kind(TkType)
            @ expect(TkBrace, "{")
            = body = parse_block_stmts()
            @ expect(TkBrace, "}")
            Scope(name_tok.text, body)
        }
        -- | exception label ...
        | Some(MkToken(TkKW, "exception", _)) -> {
            @ next_token()
            = label_tok = @ expect_kind(TkIdent)
            = head = parse_expr()
            @ expect(TkArrow, "->")
            = body = parse_expr()
            = condition = parse_under_guard()
            ExceptionRule(label_tok.text, head, body, condition)
        }
        -- | head -> body [under cond]
        | _ -> {
            = head = parse_expr()
            match @ peek_token() {
                | Some(MkToken(TkArrow, "->", _)) -> {
                    @ next_token()
                    = body = parse_expr()
                    = condition = parse_under_guard()
                    match condition {
                        | Some(_) -> DefaultRule(head, body, condition)
                        | None -> Clause(head, Some(body))
                    }
                }
                -- Bare fact: | member(X, Cons(X, _))
                | _ -> Clause(head, None)
            }
        }
    }
}

-- Parse optional "under condition" guard
> parse_under_guard() -> Option(Expr) with Parse {
    match @ peek_token() {
        | Some(MkToken(TkKW, "under", _)) -> {
            @ next_token()
            Some(parse_expr())
        }
        | _ -> None
    }
}

-- Parse # type declaration: ADT, alias, effect, typeclass
> parse_type_decl() -> TypeDecl with Parse {
    match @ peek_token() {
        -- # effect Name { ... }
        | Some(MkToken(TkKW, "effect", _)) -> {
            @ next_token()
            = name_tok = @ expect_kind(TkType)
            @ expect(TkBrace, "{")
            = ops: List(Defn) = Nil
            > loop() -> List(Defn) {
                match @ peek_token() {
                    | Some(MkToken(TkBrace, "}", _)) -> {
                        @ next_token()
                        reverse(ops)
                    }
                    | Some(MkToken(TkOp, ">", _)) -> {
                        @ next_token()
                        = op = parse_fn_defn(@ expect_kind(TkIdent).text)
                        = ops = Cons(op, ops)
                        loop()
                    }
                    | _ -> {
                        skip_semis()
                        loop()
                    }
                }
            }
            EffectDecl(name_tok.text, loop())
        }
        -- # Name(params) = Variant1 | Variant2
        | _ -> {
            = name_tok = @ expect_kind(TkType)
            = params = match @ peek_token() {
                | Some(MkToken(TkParen, "(", _)) -> parse_type_params()
                | _ -> Nil
            }
            @ expect(TkOp, "=")
            = variants = parse_variants()
            ADT(name_tok.text, params, variants)
        }
    }
}

-- Parse type parameters with dependent types: (n: Nat, a: Type)
> parse_type_params() -> List(Param) with Parse {
    @ expect(TkParen, "(")
    = params: List(Param) = Nil
    > loop() -> List(Param) {
        match @ peek_token() {
            | Some(MkToken(TkParen, ")", _)) -> {
                @ next_token()
                reverse(params)
            }
            | _ -> {
                if params != Nil {
                    @ expect(TkComma, ",")
                }
                = name_tok = @ expect_kind(TkIdent)
                = ty = match @ peek_token() {
                    | Some(MkToken(TkColon, ":", _)) -> {
                        @ next_token()
                        Some(parse_type())
                    }
                    | _ -> None
                }
                = params = Cons(MkParam(name_tok.text, ty), params)
                loop()
            }
        }
    }
    loop()
}

-- Parse variant declarations: Nil | Cons(T, List(T)) | ...
> parse_variants() -> List(Variant) with Parse {
    = variants: List(Variant) = Nil
    > loop() -> List(Variant) {
        = name_tok = @ expect_kind(TkType)
        = fields = match @ peek_token() {
            | Some(MkToken(TkParen, "(", _)) -> parse_type_list()
            | _ -> Nil
        }
        = variants = Cons(MkVariant(name_tok.text, fields), variants)
        match @ peek_token() {
            | Some(MkToken(TkOp, "|", _)) -> {
                @ next_token()
                loop()
            }
            | _ -> reverse(variants)
        }
    }
    loop()
}

-- Parse @ annotation
> parse_annotation() -> Annot with Parse {
    = tok = @ next_token()
    match tok.text {
        | "pure"    -> AnnPure
        | "total"   -> AnnTotal
        | "memoize" -> AnnMemoize
        | "test"    -> AnnTest
        | "inline"  -> AnnInline
        | name      -> AnnCustom(name, Nil)
    }
}

-- Parse = binding
> parse_binding() -> Binding with Parse {
    = pat = parse_pattern()
    = ty: Option(Ty) = match @ peek_token() {
        | Some(MkToken(TkColon, ":", _)) -> {
            @ next_token()
            Some(parse_type())
        }
        | _ -> None
    }
    @ expect(TkOp, "=")
    = value = parse_expr()
    MkBinding(pat, ty, value)
}

-- Parse a block: { stmt1; stmt2; expr }
> parse_block() -> Expr with Parse {
    @ expect(TkBrace, "{")
    = stmts = parse_block_stmts()
    @ expect(TkBrace, "}")
    EBlock(stmts)
}

> parse_block_stmts() -> List(Stmt) with Parse {
    = stmts: List(Stmt) = Nil
    > loop() -> List(Stmt) {
        skip_semis()
        match @ peek_token() {
            | Some(MkToken(TkBrace, "}", _)) -> reverse(stmts)
            | Some(tok) -> {
                = stmt = parse_statement(tok)
                = stmts = Cons(stmt, stmts)
                loop()
            }
            | None -> reverse(stmts)
        }
    }
    loop()
}


-- ============================================================================
-- PART 3b: EXPRESSION PARSER (Pratt parsing for precedence)
-- ============================================================================

-- Operator precedence (default logic for operator rules!)
| scope Precedence {
    | prec("||")  -> 1
    | prec("&&")  -> 2
    | prec("==")  -> 3
    | prec("!=")  -> 3
    | prec("<")   -> 4
    | prec(">")   -> 4
    | prec("<=")  -> 4
    | prec(">=")  -> 4
    | prec("+")   -> 5
    | prec("-")   -> 5
    | prec("*")   -> 6
    | prec("/")   -> 6
    | prec("%")   -> 6
    | exception default
      prec(_)     -> 0
}

-- Pratt parser: handles precedence climbing
> parse_expr() -> Expr with Parse {
    parse_expr_prec(0)
}

> parse_expr_prec(min_prec: Int) -> Expr with Parse {
    = lhs = parse_atom()
    > climb(lhs: Expr) -> Expr {
        match @ peek_token() {
            | Some(MkToken(TkOp, op, _)) -> {
                = p = prec(op)
                if p >= min_prec {
                    @ next_token()
                    = rhs = parse_expr_prec(p + 1)
                    climb(EBinOp(op, lhs, rhs))
                } else {
                    lhs
                }
            }
            -- Field access: expr.field
            | Some(MkToken(TkDot, ".", _)) -> {
                @ next_token()
                = field = @ expect_kind(TkIdent)
                climb(EField(lhs, field.text))
            }
            -- Function application: expr(args)
            | Some(MkToken(TkParen, "(", _)) -> {
                = args = parse_arg_list()
                climb(EApp(lhs, args))
            }
            -- Index: expr[idx]
            | Some(MkToken(TkOp, "[", _)) -> {
                @ next_token()
                = idx = parse_expr()
                @ expect(TkOp, "]")
                climb(EIndex(lhs, idx))
            }
            | _ -> lhs
        }
    }
    climb(lhs)
}

-- Parse an atomic expression
> parse_atom() -> Expr with Parse {
    = tok = @ next_token()
    match tok.kind {
        -- Identifier
        | TkIdent -> EVar(tok.text)
        -- Type constructor (also an expression)
        | TkType -> {
            match @ peek_token() {
                | Some(MkToken(TkParen, "(", _)) -> {
                    = args = parse_arg_list()
                    EApp(EVar(tok.text), args)
                }
                | _ -> EVar(tok.text)
            }
        }
        -- Literal
        | TkLit -> ELit(parse_literal(tok.text))
        -- Parenthesized expression or lambda
        | TkParen -> {
            if tok.text == "(" {
                match @ peek_token() {
                    | Some(MkToken(TkParen, ")", _)) -> {
                        @ next_token()
                        ELit(LitBool(True))  -- unit ()
                    }
                    | _ -> {
                        = expr = parse_expr()
                        @ expect(TkParen, ")")
                        expr
                    }
                }
            } else {
                @ error("unexpected )", tok.span)
                EVar("_error")
            }
        }
        -- Block
        | TkBrace -> {
            = stmts = parse_block_stmts()
            @ expect(TkBrace, "}")
            EBlock(stmts)
        }
        -- Lambda: |params| body
        | TkOp -> {
            if tok.text == "|" {
                = params = parse_lambda_params()
                = body = parse_expr()
                ELam(params, body)
            } else if tok.text == "&" {
                match @ peek_token() {
                    | Some(MkToken(TkKW, "mut", _)) -> {
                        @ next_token()
                        EMutRef(parse_atom())
                    }
                    | _ -> ERef(parse_atom())
                }
            } else if tok.text == "!" {
                EUnOp("!", parse_atom())
            } else if tok.text == "-" {
                EUnOp("-", parse_atom())
            } else {
                @ error("unexpected operator: " + tok.text, tok.span)
                EVar("_error")
            }
        }
        -- Keywords that start expressions
        | TkKW -> {
            match tok.text {
                | "match" -> parse_match()
                | "if"    -> parse_if()
                | "spawn" -> ESpawn(parse_expr())
                | _       -> {
                    @ error("unexpected keyword: " + tok.text, tok.span)
                    EVar("_error")
                }
            }
        }
        -- @ effect invocation inside expression context
        | TkOp -> {
            if tok.text == "@" {
                = name_tok = @ next_token()
                = args = match @ peek_token() {
                    | Some(MkToken(TkParen, "(", _)) -> parse_arg_list()
                    | _ -> Nil
                }
                EEffect(name_tok.text, args)
            } else {
                @ error("unexpected token: " + tok.text, tok.span)
                EVar("_error")
            }
        }
        | _ -> {
            @ error("unexpected token", tok.span)
            EVar("_error")
        }
    }
}

-- Parse match expression
> parse_match() -> Expr with Parse {
    = scrut = parse_expr()
    @ expect(TkBrace, "{")
    = arms: List(MatchArm) = Nil
    > loop() -> List(MatchArm) {
        match @ peek_token() {
            | Some(MkToken(TkBrace, "}", _)) -> {
                @ next_token()
                reverse(arms)
            }
            | Some(MkToken(TkOp, "|", _)) -> {
                @ next_token()
                = pat = parse_pattern()
                = guard = match @ peek_token() {
                    | Some(MkToken(TkKW, "if", _)) -> {
                        @ next_token()
                        Some(parse_expr())
                    }
                    | _ -> None
                }
                @ expect(TkArrow, "->")
                = body = parse_expr()
                = arms = Cons(MkArm(pat, guard, body), arms)
                loop()
            }
            | _ -> {
                skip_semis()
                loop()
            }
        }
    }
    EMatch(scrut, loop())
}

-- Parse if expression
> parse_if() -> Expr with Parse {
    = cond = parse_expr()
    = then_ = parse_block()
    = else_ = match @ peek_token() {
        | Some(MkToken(TkKW, "else", _)) -> {
            @ next_token()
            match @ peek_token() {
                | Some(MkToken(TkKW, "if", _)) -> {
                    @ next_token()
                    parse_if()
                }
                | _ -> parse_block()
            }
        }
        | _ -> ELit(LitBool(True))  -- unit
    }
    EIf(cond, then_, else_)
}

-- Parse a pattern
> parse_pattern() -> Pat with Parse {
    = tok = @ next_token()
    match tok.kind {
        | TkIdent -> {
            if tok.text == "_" {
                PatWild
            } else {
                match @ peek_token() {
                    | Some(MkToken(TkOp, "@", _)) -> {
                        @ next_token()
                        = inner = parse_pattern()
                        PatAs(inner, tok.text)
                    }
                    | _ -> PatVar(tok.text)
                }
            }
        }
        | TkType -> {
            match @ peek_token() {
                | Some(MkToken(TkParen, "(", _)) -> {
                    @ next_token()
                    = args = parse_pattern_list()
                    @ expect(TkParen, ")")
                    PatCon(tok.text, args)
                }
                | _ -> PatCon(tok.text, Nil)
            }
        }
        | TkLit -> PatLit(parse_literal(tok.text))
        | _ -> PatWild
    }
}

-- Parse a type expression
> parse_type() -> Ty with Parse {
    = base = parse_type_atom()
    match @ peek_token() {
        | Some(MkToken(TkArrow, "->", _)) -> {
            @ next_token()
            = ret = parse_type()
            TyArrow(base, ret)
        }
        | _ -> base
    }
}

> parse_type_atom() -> Ty with Parse {
    = tok = @ next_token()
    match tok.kind {
        | TkType -> {
            match @ peek_token() {
                | Some(MkToken(TkParen, "(", _)) -> {
                    = args = parse_type_arg_list()
                    TyApp(TyName(tok.text), args)
                }
                | _ -> TyName(tok.text)
            }
        }
        | TkIdent -> TyVar(tok.text)
        | TkOp -> {
            if tok.text == "&" {
                match @ peek_token() {
                    | Some(MkToken(TkKW, "mut", _)) -> {
                        @ next_token()
                        TyMutRef(parse_type_atom())
                    }
                    | _ -> TyRef(parse_type_atom())
                }
            } else if tok.text == "_" {
                TyHole
            } else {
                @ error("expected type", tok.span)
                TyHole
            }
        }
        | TkParen -> {
            if tok.text == "(" {
                match @ peek_token() {
                    | Some(MkToken(TkParen, ")", _)) -> {
                        @ next_token()
                        TyUnit
                    }
                    -- Dependent parameter: (n: Nat) -> ...
                    | Some(MkToken(TkIdent, name, _)) -> {
                        @ next_token()
                        match @ peek_token() {
                            | Some(MkToken(TkColon, ":", _)) -> {
                                @ next_token()
                                = ty = parse_type()
                                @ expect(TkParen, ")")
                                @ expect(TkArrow, "->")
                                = body = parse_type()
                                TyDep(name, ty, body)
                            }
                            | _ -> {
                                = inner = parse_type()
                                @ expect(TkParen, ")")
                                inner
                            }
                        }
                    }
                    | _ -> {
                        = inner = parse_type()
                        @ expect(TkParen, ")")
                        inner
                    }
                }
            } else {
                TyHole
            }
        }
        | _ -> {
            @ error("expected type", tok.span)
            TyHole
        }
    }
}


-- ============================================================================
-- PART 4: TYPE CHECKER
-- ============================================================================
-- Bidirectional type checking with Hindley-Milner core.
-- Dependent types refine the type variables with value constraints.
-- Ownership is tracked through the type system.

-- Type environment
# TyEnv = MkTyEnv(
    bindings: List(Pair(String, TyScheme)),
    type_defs: List(Pair(String, TypeDecl)),
    rules: List(Rule),
    effects: List(Pair(String, List(Defn)))
  )

# TyScheme = MkScheme(vars: List(String), ty: Ty)

-- Unification variables
# TyState = MkTyState(
    next_var: Nat,
    substitution: List(Pair(String, Ty)),
    errors: List(Pair(String, Span))
  )

-- Type checking effect
# effect Check {
    > fresh_var() -> Ty
    > unify(expected: Ty, actual: Ty, span: Span) -> ()
    > lookup_var(name: String) -> Option(TyScheme)
    > lookup_type(name: String) -> Option(TypeDecl)
    > add_binding(name: String, scheme: TyScheme) -> ()
    > report_error(msg: String, span: Span) -> ()
}

-- Check a complete program
> check_program(prog: Program) -> Result(Program, List(Pair(String, Span))) with Check {
    -- First pass: collect all type declarations and function signatures
    = env = collect_declarations(prog.stmts)

    -- Second pass: check all definitions and expressions
    = checked = map(prog.stmts, |stmt| check_statement(stmt))

    Ok(MkProgram(checked))
}

-- Collect top-level declarations (two-pass for mutual recursion)
> collect_declarations(stmts: List(Stmt)) -> () with Check {
    > loop(stmts: List(Stmt)) -> () {
        match stmts {
            | Nil -> ()
            | Cons(stmt, rest) -> {
                match stmt {
                    | SType(decl) -> register_type(decl)
                    | SDefn(FnDefn(name, params, ret_ty, _, _)) -> {
                        = ty = fn_type_from_params(params, ret_ty)
                        @ add_binding(name, generalize(ty))
                    }
                    | SRule(Clause(head, _)) -> register_rule_type(head)
                    | _ -> ()
                }
                loop(rest)
            }
        }
    }
    loop(stmts)
}

-- Type-check a statement
> check_statement(stmt: Stmt) -> Stmt with Check {
    match stmt {
        | SDefn(defn)  -> SDefn(check_defn(defn))
        | SRule(rule)  -> SRule(check_rule(rule))
        | SType(decl)  -> SType(decl)  -- already collected
        | SAnnot(ann)  -> SAnnot(ann)  -- annotations don't need checking
        | SBind(bind)  -> SBind(check_binding(bind))
        | SExpr(expr)  -> SExpr(check_expr(expr))
    }
}

-- Check a function definition
> check_defn(defn: Defn) -> Defn with Check {
    match defn {
        | FnDefn(name, params, ret_ty, effects, body) -> {
            -- Bind parameters in scope
            > bind_params(ps: List(Param)) -> () {
                match ps {
                    | Nil -> ()
                    | Cons(MkParam(pname, Some(ty)), rest) -> {
                        @ add_binding(pname, MkScheme(Nil, ty))
                        bind_params(rest)
                    }
                    | Cons(MkParam(pname, None), rest) -> {
                        = tv = @ fresh_var()
                        @ add_binding(pname, MkScheme(Nil, tv))
                        bind_params(rest)
                    }
                }
            }
            bind_params(params)

            -- Check body against return type
            = body_ty = infer(body)
            match ret_ty {
                | Some(expected) -> @ unify(expected, body_ty, MkSpan(Zero, Zero, Zero))
                | None -> ()
            }

            FnDefn(name, params, ret_ty, effects, body)
        }
        | ActorDefn(name, state_param, handlers) -> {
            -- Actors: state type must be consistent across handlers
            match state_param.ty {
                | Some(state_ty) -> {
                    @ add_binding(state_param.name, MkScheme(Nil, state_ty))
                }
                | None -> {
                    = tv = @ fresh_var()
                    @ add_binding(state_param.name, MkScheme(Nil, tv))
                }
            }
            = checked_handlers = map(handlers, |h| check_handler(h))
            ActorDefn(name, state_param, checked_handlers)
        }
        | ModuleDefn(name, body) -> {
            = checked = map(body, |s| check_statement(s))
            ModuleDefn(name, checked)
        }
    }
}

-- Type inference for expressions (bidirectional)
> infer(expr: Expr) -> Ty with Check {
    match expr {
        | EVar(name) -> {
            match @ lookup_var(name) {
                | Some(MkScheme(vars, ty)) -> instantiate(vars, ty)
                | None -> {
                    @ report_error("unbound variable: " + name, MkSpan(Zero, Zero, Zero))
                    @ fresh_var()
                }
            }
        }
        | ELit(lit) -> infer_literal(lit)
        | EApp(fun, args) -> {
            = fun_ty = infer(fun)
            = arg_tys = map(args, |a| infer(a))
            = ret_ty = @ fresh_var()
            = expected = fold_arrow(arg_tys, ret_ty)
            @ unify(expected, fun_ty, MkSpan(Zero, Zero, Zero))
            ret_ty
        }
        | ELam(params, body) -> {
            = param_tys = map(params, |p| {
                match p.ty {
                    | Some(ty) -> ty
                    | None -> @ fresh_var()
                }
            })
            > bind_lam_params(ps: List(Param), tys: List(Ty)) -> () {
                match MkPair(ps, tys) {
                    | MkPair(Nil, _) -> ()
                    | MkPair(Cons(MkParam(n, _), pr), Cons(ty, tr)) -> {
                        @ add_binding(n, MkScheme(Nil, ty))
                        bind_lam_params(pr, tr)
                    }
                    | _ -> ()
                }
            }
            bind_lam_params(params, param_tys)
            = body_ty = infer(body)
            fold_arrow(param_tys, body_ty)
        }
        | EBinOp(op, lhs, rhs) -> {
            = lhs_ty = infer(lhs)
            = rhs_ty = infer(rhs)
            infer_binop(op, lhs_ty, rhs_ty)
        }
        | EIf(cond, then_, else_) -> {
            = cond_ty = infer(cond)
            @ unify(TyName("Bool"), cond_ty, MkSpan(Zero, Zero, Zero))
            = then_ty = infer(then_)
            = else_ty = infer(else_)
            @ unify(then_ty, else_ty, MkSpan(Zero, Zero, Zero))
            then_ty
        }
        | EMatch(scrut, arms) -> {
            = scrut_ty = infer(scrut)
            = result_ty = @ fresh_var()
            > check_arms(arms: List(MatchArm)) -> () {
                match arms {
                    | Nil -> ()
                    | Cons(MkArm(pat, guard, body), rest) -> {
                        check_pattern(pat, scrut_ty)
                        match guard {
                            | Some(g) -> {
                                = g_ty = infer(g)
                                @ unify(TyName("Bool"), g_ty, MkSpan(Zero, Zero, Zero))
                            }
                            | None -> ()
                        }
                        = arm_ty = infer(body)
                        @ unify(result_ty, arm_ty, MkSpan(Zero, Zero, Zero))
                        check_arms(rest)
                    }
                }
            }
            check_arms(arms)
            result_ty
        }
        | EBlock(stmts) -> infer_block(stmts)
        | EField(obj, field) -> {
            = obj_ty = infer(obj)
            infer_field(obj_ty, field)
        }
        | ERef(inner) -> TyRef(infer(inner))
        | EMutRef(inner) -> TyMutRef(infer(inner))
        | EEffect(name, args) -> {
            -- Look up effect operation type
            = ret_ty = @ fresh_var()
            ret_ty  -- simplified; real impl resolves from effect declarations
        }
        | ESpawn(inner) -> {
            = inner_ty = infer(inner)
            TyApp(TyName("Actor"), Cons(inner_ty, Nil))
        }
        | ESend(target, msg) -> TyUnit
        | _ -> @ fresh_var()
    }
}

-- Infer type of a literal
> infer_literal(lit: Literal) -> Ty {
    match lit {
        | LitInt(_)    -> TyName("Int")
        | LitFloat(_)  -> TyName("Float")
        | LitString(_) -> TyName("String")
        | LitChar(_)   -> TyName("Char")
        | LitBool(_)   -> TyName("Bool")
    }
}

-- Build function type from argument types: a -> b -> c -> ret
> fold_arrow(params: List(Ty), ret: Ty) -> Ty {
    match params {
        | Nil -> ret
        | Cons(p, rest) -> TyArrow(p, fold_arrow(rest, ret))
    }
}

-- Infer binary operator result type
> infer_binop(op: String, lhs: Ty, rhs: Ty) -> Ty with Check {
    match op {
        | "+" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); lhs }
        | "-" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); lhs }
        | "*" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); lhs }
        | "/" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); lhs }
        | "%" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); lhs }
        | "==" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | "!=" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | "<"  -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | ">"  -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | "<=" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | ">=" -> { @ unify(lhs, rhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | "&&" -> { @ unify(TyName("Bool"), lhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | "||" -> { @ unify(TyName("Bool"), lhs, MkSpan(Zero, Zero, Zero)); TyName("Bool") }
        | _ -> @ fresh_var()
    }
}

-- Infer block type (last expression)
> infer_block(stmts: List(Stmt)) -> Ty with Check {
    match stmts {
        | Nil -> TyUnit
        | Cons(SExpr(e), Nil) -> infer(e)
        | Cons(SBind(MkBinding(PatVar(name), ty, value)), rest) -> {
            = val_ty = infer(value)
            match ty {
                | Some(ann) -> @ unify(ann, val_ty, MkSpan(Zero, Zero, Zero))
                | None -> ()
            }
            @ add_binding(name, MkScheme(Nil, val_ty))
            infer_block(rest)
        }
        | Cons(stmt, rest) -> {
            check_statement(stmt)
            infer_block(rest)
        }
    }
}

-- Check a pattern against an expected type
> check_pattern(pat: Pat, expected: Ty) -> () with Check {
    match pat {
        | PatWild -> ()
        | PatVar(name) -> @ add_binding(name, MkScheme(Nil, expected))
        | PatLit(lit) -> {
            = lit_ty = infer_literal(lit)
            @ unify(expected, lit_ty, MkSpan(Zero, Zero, Zero))
        }
        | PatCon(name, args) -> {
            -- Look up constructor, unify, bind field vars
            match @ lookup_var(name) {
                | Some(MkScheme(_, con_ty)) -> {
                    @ unify(expected, return_type_of(con_ty), MkSpan(Zero, Zero, Zero))
                    > bind_con_args(args: List(Pat), tys: List(Ty)) -> () {
                        match MkPair(args, tys) {
                            | MkPair(Nil, _) -> ()
                            | MkPair(Cons(p, pr), Cons(t, tr)) -> {
                                check_pattern(p, t)
                                bind_con_args(pr, tr)
                            }
                            | _ -> ()
                        }
                    }
                    bind_con_args(args, param_types_of(con_ty))
                }
                | None -> @ report_error("unknown constructor: " + name, MkSpan(Zero, Zero, Zero))
            }
        }
        | PatAs(inner, name) -> {
            check_pattern(inner, expected)
            @ add_binding(name, MkScheme(Nil, expected))
        }
    }
}


-- ============================================================================
-- PART 5: EVALUATOR
-- ============================================================================
-- Tree-walking interpreter. Values flow through pattern matching,
-- logic resolution, and effect handling.

# Value
    = VInt(value: Int)
    | VFloat(value: Float)
    | VString(value: String)
    | VChar(value: Char)
    | VBool(value: Bool)
    | VUnit
    | VClosure(params: List(String), body: Expr, env: Env)
    | VConstructor(name: String, args: List(Value))
    | VActor(id: Nat, state: Value, handlers: List(Handler), env: Env)
    | VBuiltin(name: String)

# Env = MkEnv(bindings: List(Pair(String, Value)))

-- Effects for the runtime
# effect Runtime {
    > alloc_actor(actor: Value) -> Nat
    > send_msg(actor_id: Nat, msg: Value) -> ()
    > recv_msg(actor_id: Nat, msg: Value) -> Value
    > perform_io(op: String, args: List(Value)) -> Value
}

-- The rule database (for logic resolution)
# RuleDB = MkRuleDB(rules: List(Rule), env: Env)

-- Look up a value in the environment
> env_lookup(env: Env, name: String) -> Option(Value) {
    lookup(name, env.bindings)
}

-- Extend environment with a binding
> env_extend(env: Env, name: String, val: Value) -> Env {
    MkEnv(Cons(MkPair(name, val), env.bindings))
}

-- Extend with multiple bindings
> env_extend_many(env: Env, binds: List(Pair(String, Value))) -> Env {
    foldl(binds, env, |e, pair| {
        match pair {
            | MkPair(name, val) -> env_extend(e, name, val)
        }
    })
}

-- Evaluate an expression
> eval(env: Env, expr: Expr) -> Value with Runtime {
    match expr {
        | EVar(name) -> {
            match env_lookup(env, name) {
                | Some(val) -> val
                | None -> VUnit  -- should have been caught by type checker
            }
        }
        | ELit(lit) -> eval_literal(lit)
        | EApp(fun, args) -> {
            = fun_val = eval(env, fun)
            = arg_vals = map(args, |a| eval(env, a))
            apply(fun_val, arg_vals)
        }
        | ELam(params, body) -> {
            = param_names = map(params, |p| p.name)
            VClosure(param_names, body, env)
        }
        | EBinOp(op, lhs, rhs) -> {
            = lhs_val = eval(env, lhs)
            = rhs_val = eval(env, rhs)
            eval_binop(op, lhs_val, rhs_val)
        }
        | EUnOp(op, operand) -> {
            = val = eval(env, operand)
            eval_unop(op, val)
        }
        | EIf(cond, then_, else_) -> {
            match eval(env, cond) {
                | VBool(True) -> eval(env, then_)
                | VBool(False) -> eval(env, else_)
                | _ -> VUnit
            }
        }
        | EMatch(scrut, arms) -> {
            = scrut_val = eval(env, scrut)
            eval_match(env, scrut_val, arms)
        }
        | EBlock(stmts) -> eval_block(env, stmts)
        | EField(obj, field) -> {
            = obj_val = eval(env, obj)
            eval_field(obj_val, field)
        }
        | EIndex(arr, idx) -> {
            = arr_val = eval(env, arr)
            = idx_val = eval(env, idx)
            eval_index(arr_val, idx_val)
        }
        | ERef(inner)    -> eval(env, inner)  -- simplified: refs = values
        | EMutRef(inner) -> eval(env, inner)
        | ESpawn(inner) -> {
            = actor_val = eval(env, inner)
            = id = @ alloc_actor(actor_val)
            VInt(id)
        }
        | ESend(target, msg) -> {
            = target_val = eval(env, target)
            = msg_val = eval(env, msg)
            match target_val {
                | VInt(id) -> {
                    @ send_msg(id, msg_val)
                    VUnit
                }
                | _ -> VUnit
            }
        }
        | ERecv(target, msg) -> {
            = target_val = eval(env, target)
            = msg_val = eval(env, msg)
            match target_val {
                | VInt(id) -> @ recv_msg(id, msg_val)
                | _ -> VUnit
            }
        }
        | EEffect(name, args) -> {
            = arg_vals = map(args, |a| eval(env, a))
            @ perform_io(name, arg_vals)
        }
    }
}

-- Apply a function value to arguments
> apply(fun: Value, args: List(Value)) -> Value with Runtime {
    match fun {
        | VClosure(params, body, closure_env) -> {
            = binds = zip(params, args)
            = extended = env_extend_many(closure_env, binds)
            eval(extended, body)
        }
        | VConstructor(name, existing) -> {
            VConstructor(name, concat(existing, args))
        }
        | VBuiltin(name) -> eval_builtin(name, args)
        | _ -> VUnit
    }
}

-- Evaluate a literal
> eval_literal(lit: Literal) -> Value {
    match lit {
        | LitInt(n)    -> VInt(n)
        | LitFloat(f)  -> VFloat(f)
        | LitString(s) -> VString(s)
        | LitChar(c)   -> VChar(c)
        | LitBool(b)   -> VBool(b)
    }
}

-- Evaluate a binary operation
> eval_binop(op: String, lhs: Value, rhs: Value) -> Value {
    match MkPair(lhs, rhs) {
        | MkPair(VInt(a), VInt(b)) -> {
            match op {
                | "+"  -> VInt(a + b)
                | "-"  -> VInt(a - b)
                | "*"  -> VInt(a * b)
                | "/"  -> VInt(a / b)
                | "%"  -> VInt(a % b)
                | "==" -> VBool(a == b)
                | "!=" -> VBool(a != b)
                | "<"  -> VBool(a < b)
                | ">"  -> VBool(a > b)
                | "<=" -> VBool(a <= b)
                | ">=" -> VBool(a >= b)
                | _    -> VUnit
            }
        }
        | MkPair(VFloat(a), VFloat(b)) -> {
            match op {
                | "+"  -> VFloat(a + b)
                | "-"  -> VFloat(a - b)
                | "*"  -> VFloat(a * b)
                | "/"  -> VFloat(a / b)
                | "==" -> VBool(a == b)
                | "<"  -> VBool(a < b)
                | ">"  -> VBool(a > b)
                | _    -> VUnit
            }
        }
        | MkPair(VString(a), VString(b)) -> {
            match op {
                | "+"  -> VString(a + b)
                | "==" -> VBool(a == b)
                | "!=" -> VBool(a != b)
                | _    -> VUnit
            }
        }
        | MkPair(VBool(a), VBool(b)) -> {
            match op {
                | "&&" -> VBool(a && b)
                | "||" -> VBool(a || b)
                | "==" -> VBool(a == b)
                | _    -> VUnit
            }
        }
        | _ -> VUnit
    }
}

-- Evaluate a unary operation
> eval_unop(op: String, val: Value) -> Value {
    match MkPair(op, val) {
        | MkPair("!", VBool(b)) -> VBool(!b)
        | MkPair("-", VInt(n))  -> VInt(0 - n)
        | MkPair("-", VFloat(f)) -> VFloat(0.0 - f)
        | _ -> VUnit
    }
}

-- Pattern matching in the evaluator
> eval_match(env: Env, scrut: Value, arms: List(MatchArm)) -> Value with Runtime {
    match arms {
        | Nil -> VUnit  -- no arm matched (exhaustiveness should prevent this)
        | Cons(MkArm(pat, guard, body), rest) -> {
            match match_pattern(pat, scrut) {
                | Some(binds) -> {
                    = extended = env_extend_many(env, binds)
                    = guard_ok = match guard {
                        | Some(g) -> {
                            match eval(extended, g) {
                                | VBool(True) -> True
                                | _ -> False
                            }
                        }
                        | None -> True
                    }
                    if guard_ok {
                        eval(extended, body)
                    } else {
                        eval_match(env, scrut, rest)
                    }
                }
                | None -> eval_match(env, scrut, rest)
            }
        }
    }
}

-- Try to match a pattern against a value, returning bindings on success
> match_pattern(pat: Pat, val: Value) -> Option(List(Pair(String, Value))) {
    match pat {
        | PatWild -> Some(Nil)
        | PatVar(name) -> Some(Cons(MkPair(name, val), Nil))
        | PatLit(LitInt(n)) -> {
            match val {
                | VInt(m) -> if n == m { Some(Nil) } else { None }
                | _ -> None
            }
        }
        | PatLit(LitString(s)) -> {
            match val {
                | VString(t) -> if s == t { Some(Nil) } else { None }
                | _ -> None
            }
        }
        | PatLit(LitBool(b)) -> {
            match val {
                | VBool(c) -> if b == c { Some(Nil) } else { None }
                | _ -> None
            }
        }
        | PatCon(name, pats) -> {
            match val {
                | VConstructor(vname, vargs) -> {
                    if name == vname {
                        match_pattern_list(pats, vargs)
                    } else {
                        None
                    }
                }
                | _ -> None
            }
        }
        | PatAs(inner, name) -> {
            match match_pattern(inner, val) {
                | Some(binds) -> Some(Cons(MkPair(name, val), binds))
                | None -> None
            }
        }
        | _ -> None
    }
}

-- Match a list of patterns against a list of values
> match_pattern_list(pats: List(Pat), vals: List(Value))
        -> Option(List(Pair(String, Value))) {
    match MkPair(pats, vals) {
        | MkPair(Nil, Nil) -> Some(Nil)
        | MkPair(Cons(p, ps), Cons(v, vs)) -> {
            match match_pattern(p, v) {
                | Some(binds1) -> {
                    match match_pattern_list(ps, vs) {
                        | Some(binds2) -> Some(concat(binds1, binds2))
                        | None -> None
                    }
                }
                | None -> None
            }
        }
        | _ -> None
    }
}

-- Evaluate a block (sequence of statements)
> eval_block(env: Env, stmts: List(Stmt)) -> Value with Runtime {
    match stmts {
        | Nil -> VUnit
        | Cons(SExpr(e), Nil) -> eval(env, e)
        | Cons(SBind(MkBinding(pat, _, value)), rest) -> {
            = val = eval(env, value)
            match match_pattern(pat, val) {
                | Some(binds) -> {
                    = extended = env_extend_many(env, binds)
                    eval_block(extended, rest)
                }
                | None -> VUnit  -- pattern didn't match
            }
        }
        | Cons(SDefn(FnDefn(name, params, _, _, body)), rest) -> {
            = param_names = map(params, |p| p.name)
            = closure = VClosure(param_names, body, env)
            = extended = env_extend(env, name, closure)
            eval_block(extended, rest)
        }
        | Cons(stmt, rest) -> {
            eval_stmt(env, stmt)
            eval_block(env, rest)
        }
    }
}

-- Evaluate a statement for side effects
> eval_stmt(env: Env, stmt: Stmt) -> () with Runtime {
    match stmt {
        | SExpr(e) -> { eval(env, e); () }
        | SDefn(d) -> ()  -- handled in eval_block
        | SRule(r) -> ()   -- rules are collected, not executed
        | SAnnot(a) -> ()  -- annotations are metadata
        | SType(t) -> ()   -- types are compile-time
        | SBind(b) -> ()   -- handled in eval_block
    }
}


-- ============================================================================
-- PART 6: LOGIC ENGINE (Prolog's soul in Futuruna's body)
-- ============================================================================
-- SLG resolution with tabling for termination.
-- Logic rules live alongside typed functions — this is what
-- makes Futuruna unique: law IS logic IS computation.

# Goal = MkGoal(name: String, args: List(Value))

# Substitution = MkSubst(bindings: List(Pair(String, Value)))

# SearchResult
    = Found(subst: Substitution)
    | NotFound
    | Multiple(results: List(Substitution))

-- Logic resolution effect
# effect Logic {
    > query(goal: Goal) -> SearchResult
    > assert_fact(rule: Rule) -> ()
    > retract(name: String) -> ()
}

-- Resolve a goal against the rule database
> resolve(db: RuleDB, goal: Goal) -> SearchResult {
    = matching = filter(db.rules, |rule| rule_matches(rule, goal))
    = results = collect_solutions(db, matching, goal)
    match results {
        | Nil -> NotFound
        | Cons(s, Nil) -> Found(s)
        | many -> Multiple(many)
    }
}

-- Check if a rule head matches a goal
| rule_matches(Clause(head, _), goal) -> head_matches(head, goal)
| rule_matches(DefaultRule(head, _, _), goal) -> head_matches(head, goal)
| rule_matches(ExceptionRule(_, head, _, _), goal) -> head_matches(head, goal)

-- Try each matching rule, collecting solutions
> collect_solutions(db: RuleDB, rules: List(Rule), goal: Goal) -> List(Substitution) {
    match rules {
        | Nil -> Nil
        | Cons(rule, rest) -> {
            = solutions = try_rule(db, rule, goal)
            concat(solutions, collect_solutions(db, rest, goal))
        }
    }
}

-- Try a single rule against a goal
> try_rule(db: RuleDB, rule: Rule, goal: Goal) -> List(Substitution) {
    match rule {
        -- Bare fact: | member(X, Cons(X, _))
        | Clause(head, None) -> {
            match unify_goal(head, goal) {
                | Some(subst) -> Cons(subst, Nil)
                | None -> Nil
            }
        }
        -- Rule with body: | member(X, Cons(_, T)) -> member(X, T)
        | Clause(head, Some(body)) -> {
            match unify_goal(head, goal) {
                | Some(subst) -> {
                    = sub_goals = extract_goals(body, subst)
                    resolve_all(db, sub_goals)
                }
                | None -> Nil
            }
        }
        -- Default rule: | rate(p) -> 0.20
        | DefaultRule(head, body, condition) -> {
            match unify_goal(head, goal) {
                | Some(subst) -> {
                    match condition {
                        | None -> Cons(subst, Nil)
                        | Some(cond) -> {
                            = cond_val = eval(subst_to_env(subst), cond)
                            match cond_val {
                                | VBool(True) -> Cons(subst, Nil)
                                | _ -> Nil
                            }
                        }
                    }
                }
                | None -> Nil
            }
        }
        -- Exception: overrides default rules
        | ExceptionRule(label, head, body, condition) -> {
            match unify_goal(head, goal) {
                | Some(subst) -> {
                    match condition {
                        | None -> Cons(subst, Nil)
                        | Some(cond) -> {
                            = cond_val = eval(subst_to_env(subst), cond)
                            match cond_val {
                                | VBool(True) -> Cons(subst, Nil)
                                | _ -> Nil
                            }
                        }
                    }
                }
                | None -> Nil
            }
        }
        | _ -> Nil
    }
}

-- Resolve all sub-goals (conjunction)
> resolve_all(db: RuleDB, goals: List(Goal)) -> List(Substitution) {
    match goals {
        | Nil -> Cons(MkSubst(Nil), Nil)  -- empty conjunction succeeds
        | Cons(goal, rest) -> {
            match resolve(db, goal) {
                | NotFound -> Nil
                | Found(subst) -> {
                    = rest_goals = apply_subst_to_goals(subst, rest)
                    resolve_all(db, rest_goals)
                }
                | Multiple(substs) -> {
                    -- For each solution, try the remaining goals
                    foldl(substs, Nil, |acc, subst| {
                        = rest_goals = apply_subst_to_goals(subst, rest)
                        concat(acc, resolve_all(db, rest_goals))
                    })
                }
            }
        }
    }
}

-- Default logic resolution: exceptions override defaults
-- This is Catala's soul: later, more specific rules win
> resolve_with_defaults(db: RuleDB, goal: Goal) -> SearchResult {
    = exceptions = filter(db.rules, |r| {
        match r {
            | ExceptionRule(_, _, _, _) -> rule_matches(r, goal)
            | _ -> False
        }
    })
    = defaults = filter(db.rules, |r| {
        match r {
            | DefaultRule(_, _, _) -> rule_matches(r, goal)
            | _ -> False
        }
    })
    -- Exceptions take priority
    = exception_results = collect_solutions(db, exceptions, goal)
    match exception_results {
        | Nil -> {
            -- Fall back to defaults (last matching wins)
            = default_results = collect_solutions(db, defaults, goal)
            match reverse(default_results) {
                | Nil -> NotFound
                | Cons(s, _) -> Found(s)
            }
        }
        | Cons(s, Nil) -> Found(s)
        | many -> Multiple(many)
    }
}


-- ============================================================================
-- PART 7: THE MAIN LOOP (putting it all together)
-- ============================================================================

-- The REPL: read, tokenize, parse, check, evaluate
> main() with IO {
    @ print("Futuruna v0.1 — the self-hosting bootstrap")
    @ print("Type expressions, definitions, rules, or :quit")
    @ print("")

    = env: Env = MkEnv(builtin_env())
    = rule_db: RuleDB = MkRuleDB(Nil, env)

    > repl(env: Env, db: RuleDB) -> () {
        @ print("> ")
        = input = @ read()
        if input == ":quit" {
            @ print("Goodbye.")
        } else if input == ":rules" {
            print_rules(db)
            repl(env, db)
        } else if input == ":env" {
            print_env(env)
            repl(env, db)
        } else {
            -- Tokenize
            = tokens = tokenize(input)

            -- Parse
            = result = parse_program_from(tokens)
            match result {
                | Err(msg) -> {
                    @ print("Parse error: " + msg)
                    repl(env, db)
                }
                | Ok(prog) -> {
                    -- Type check
                    match check_program(prog) {
                        | Err(errors) -> {
                            map(errors, |e| {
                                match e {
                                    | MkPair(msg, _) -> @ print("Type error: " + msg)
                                }
                            })
                            repl(env, db)
                        }
                        | Ok(checked) -> {
                            -- Evaluate
                            = new_env = eval_program(env, db, checked)
                            match new_env {
                                | MkPair(env2, db2) -> repl(env2, db2)
                            }
                        }
                    }
                }
            }
        }
    }

    repl(env, rule_db)
}

-- Evaluate a program, updating environment and rule database
> eval_program(env: Env, db: RuleDB, prog: Program)
        -> Pair(Env, RuleDB) with Runtime, IO {
    > loop(env: Env, db: RuleDB, stmts: List(Stmt)) -> Pair(Env, RuleDB) {
        match stmts {
            | Nil -> MkPair(env, db)
            | Cons(stmt, rest) -> {
                match stmt {
                    | SDefn(FnDefn(name, params, _, _, body)) -> {
                        = param_names = map(params, |p| p.name)
                        = closure = VClosure(param_names, body, env)
                        = env2 = env_extend(env, name, closure)
                        @ print(name + " defined.")
                        loop(env2, db, rest)
                    }
                    | SRule(rule) -> {
                        = db2 = MkRuleDB(Cons(rule, db.rules), db.env)
                        @ print("Rule added.")
                        loop(env, db2, rest)
                    }
                    | SType(decl) -> {
                        @ print("Type registered.")
                        loop(env, db, rest)
                    }
                    | SBind(MkBinding(PatVar(name), _, value)) -> {
                        = val = eval(env, value)
                        = env2 = env_extend(env, name, val)
                        @ print(name + " = " + show_value(val))
                        loop(env2, db, rest)
                    }
                    | SExpr(expr) -> {
                        = val = eval(env, expr)
                        @ print(show_value(val))
                        loop(env, db, rest)
                    }
                    | _ -> loop(env, db, rest)
                }
            }
        }
    }
    loop(env, db, prog.stmts)
}

-- Show a value as a string
> show_value(val: Value) -> String {
    match val {
        | VInt(n)      -> show_int(n)
        | VFloat(f)    -> show_float(f)
        | VString(s)   -> "\"" + s + "\""
        | VChar(c)     -> "'" + char_to_string(c) + "'"
        | VBool(True)  -> "True"
        | VBool(False) -> "False"
        | VUnit        -> "()"
        | VClosure(_, _, _) -> "<function>"
        | VConstructor(name, Nil) -> name
        | VConstructor(name, args) -> {
            name + "(" + join(map(args, show_value), ", ") + ")"
        }
        | VActor(id, _, _, _) -> "<actor:" + show_int(id) + ">"
        | VBuiltin(name) -> "<builtin:" + name + ">"
    }
}

-- Built-in environment: primitive operations
> builtin_env() -> List(Pair(String, Value)) {
    Cons(MkPair("True", VBool(True)),
    Cons(MkPair("False", VBool(False)),
    Cons(MkPair("None", VConstructor("None", Nil)),
    Cons(MkPair("Nil", VConstructor("Nil", Nil)),
    Cons(MkPair("show", VBuiltin("show")),
    Cons(MkPair("print", VBuiltin("print")),
    Cons(MkPair("length", VBuiltin("length")),
    Cons(MkPair("head", VBuiltin("head")),
    Cons(MkPair("tail", VBuiltin("tail")),
    Cons(MkPair("abs", VBuiltin("abs")),
    Nil))))))))))
}

-- Evaluate a built-in function
> eval_builtin(name: String, args: List(Value)) -> Value with Runtime {
    match name {
        | "show" -> {
            match args {
                | Cons(val, Nil) -> VString(show_value(val))
                | _ -> VUnit
            }
        }
        | "print" -> {
            match args {
                | Cons(VString(s), Nil) -> {
                    @ perform_io("print", args)
                    VUnit
                }
                | Cons(val, Nil) -> {
                    @ perform_io("print", Cons(VString(show_value(val)), Nil))
                    VUnit
                }
                | _ -> VUnit
            }
        }
        | "length" -> {
            match args {
                | Cons(val, Nil) -> VInt(value_list_length(val))
                | _ -> VInt(0)
            }
        }
        | "head" -> {
            match args {
                | Cons(VConstructor("Cons", Cons(h, _)), Nil) -> h
                | _ -> VConstructor("None", Nil)
            }
        }
        | "tail" -> {
            match args {
                | Cons(VConstructor("Cons", Cons(_, Cons(t, _))), Nil) -> t
                | _ -> VConstructor("Nil", Nil)
            }
        }
        | "abs" -> {
            match args {
                | Cons(VInt(n), Nil) -> if n < 0 { VInt(0 - n) } else { VInt(n) }
                | _ -> VUnit
            }
        }
        | _ -> VUnit
    }
}

> value_list_length(val: Value) -> Int {
    match val {
        | VConstructor("Nil", _) -> 0
        | VConstructor("Cons", Cons(_, Cons(rest, _))) -> 1 + value_list_length(rest)
        | _ -> 0
    }
}


-- ============================================================================
-- PART 8: TAU COMPILING ITSELF (the bootstrap test)
-- ============================================================================
-- This section demonstrates that Futuruna can express its own compilation.
-- We parse a small Futuruna program, type-check it, and evaluate it —
-- all using the machinery defined above.

@ test
> test_self_tokenize() with IO {
    -- Futuruna tokenizing Futuruna
    = source = "> add(a: Int, b: Int) -> Int { a + b }"
    = tokens = tokenize(source)
    @ print("Tokens: " + show_int(length(tokens)))
    -- Expected: TkOp(>), TkIdent(add), TkParen((), TkIdent(a), TkColon(:),
    --           TkType(Int), TkComma(,), TkIdent(b), TkColon(:), TkType(Int),
    --           TkParen()), TkArrow(->), TkType(Int), TkBrace({), TkIdent(a),
    --           TkOp(+), TkIdent(b), TkBrace(})
    assert(length(tokens) == 17)
}

@ test
> test_self_parse() with IO {
    -- Futuruna parsing Futuruna
    = source = "# Option(a: Type) = None | Some(a)"
    = tokens = tokenize(source)
    = prog = parse_program_from(tokens)
    match prog {
        | Ok(MkProgram(Cons(SType(ADT(name, params, variants)), _))) -> {
            @ print("Parsed type: " + name)
            assert(name == "Option")
            assert(length(params) == 1)
            assert(length(variants) == 2)
        }
        | _ -> assert(False)
    }
}

@ test
> test_self_eval() with IO, Runtime {
    -- Futuruna evaluating Futuruna
    = env = MkEnv(builtin_env())
    = expr = EApp(
        ELam(
            Cons(MkParam("x", Some(TyName("Int"))), Nil),
            EBinOp("+", EVar("x"), ELit(LitInt(1)))
        ),
        Cons(ELit(LitInt(41)), Nil)
    )
    = result = eval(env, expr)
    match result {
        | VInt(42) -> @ print("Self-eval: 41 + 1 = 42")
        | _ -> assert(False)
    }
}

@ test
> test_logic_resolution() with IO {
    -- Futuruna resolving logic rules
    = db = MkRuleDB(
        Cons(
            Clause(
                EApp(EVar("member"), Cons(EVar("X"), Cons(EApp(EVar("Cons"), Cons(EVar("X"), Cons(EVar("_"), Nil))), Nil))),
                None
            ),
            Cons(
                Clause(
                    EApp(EVar("member"), Cons(EVar("X"), Cons(EApp(EVar("Cons"), Cons(EVar("_"), Cons(EVar("T"), Nil))), Nil))),
                    Some(EApp(EVar("member"), Cons(EVar("X"), Cons(EVar("T"), Nil))))
                ),
                Nil
            )
        ),
        MkEnv(Nil)
    )
    = goal = MkGoal("member", Cons(VInt(2), Cons(VConstructor("Cons", Cons(VInt(1), Cons(VConstructor("Cons", Cons(VInt(2), Cons(VConstructor("Nil", Nil), Nil))), Nil))), Nil)))
    = result = resolve(db, goal)
    match result {
        | Found(_) -> @ print("Logic: member(2, [1, 2]) = True")
        | _ -> @ print("Logic: member(2, [1, 2]) = False (should be True)")
    }
}

@ test
> test_default_logic() with IO {
    -- Catala-style default logic in Futuruna
    = db = MkRuleDB(
        Cons(
            DefaultRule(
                EApp(EVar("rate"), Cons(EVar("p"), Nil)),
                ELit(LitFloat(0.20)),
                None  -- default: 20%
            ),
            Cons(
                DefaultRule(
                    EApp(EVar("rate"), Cons(EVar("p"), Nil)),
                    ELit(LitFloat(0.40)),
                    Some(EBinOp(">", EField(EVar("p"), "income"), ELit(LitInt(500000))))
                ),
                Cons(
                    ExceptionRule(
                        "student",
                        EApp(EVar("rate"), Cons(EVar("p"), Nil)),
                        ELit(LitFloat(0.00)),
                        Some(EField(EVar("p"), "is_student"))
                    ),
                    Nil
                )
            )
        ),
        MkEnv(Nil)
    )
    @ print("Default logic: tax rules defined")
    @ print("  | rate(p) -> 0.20                           -- default")
    @ print("  | rate(p) -> 0.40 under p.income > 500000   -- high earner")
    @ print("  | exception student rate(p) -> 0.00         -- student exemption")
}

@ test
> test_actor_system() with IO, Runtime {
    -- Futuruna actors (concurrency showcase)
    = counter_handlers = Cons(
        MkHandler(
            PatCon("Increment", Nil),
            EApp(EVar("Counter"), Cons(EBinOp("+", EVar("state"), ELit(LitInt(1))), Nil))
        ),
        Cons(
            MkHandler(
                PatCon("Get", Cons(PatVar("reply"), Nil)),
                EBlock(Cons(
                    SExpr(ESend(EVar("reply"), EVar("state"))),
                    Cons(SExpr(EApp(EVar("Counter"), Cons(EVar("state"), Nil))), Nil)
                ))
            ),
            Nil
        )
    )
    @ print("Actor: Counter defined with Increment and Get handlers")
}


