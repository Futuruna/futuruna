-- Test: variables used in list literals are auto-cloned when used afterwards
-- Previously, putting a struct in [t1, t2, ...] moved it, making later use fail.

# Item(name: String, value: Int)

= a = Item("alpha", 1)
= b = Item("beta", 2)
= c = Item("gamma", 3)

-- Put them in a list (should auto-clone since used again below)
= items = [a, b, c]

-- Use the variables AFTER the list construction
@ print("After list construction:")
@ print("  a.name = " + a.name)
@ print("  b.name = " + b.name)
@ print("  c.name = " + c.name)

-- Also use the list
= n = count(items)
@ print("  list length = " + show(n))

| list_clone_preserves_a: a.name -> a.name == "alpha"
| list_clone_preserves_b: b.name -> b.name == "beta"
| list_clone_preserves_c: c.name -> c.name == "gamma"
| list_clone_preserves_length: n -> n == 3

? list_clone_preserves_a
? list_clone_preserves_b
? list_clone_preserves_c
? list_clone_preserves_length

-- Reused string bindings should survive list construction too.
= first = "delta"
= second = "omega"
= labels = [first, second]
@ print("String reuse after list construction:")
@ print("  labels = " + show(labels))
@ print("  first = " + first)
@ print("  second = " + second)

-- Reused list bindings should survive nested list construction.
= base = ["north", "south"]
= bags = [base]
@ print("Nested list reuse after list construction:")
@ print("  bags = " + show(bags))
@ print("  base = " + show(base))

| list_clone_preserves_first: first -> first == "delta"
| list_clone_preserves_second: second -> second == "omega"
| list_clone_preserves_labels: labels -> count(labels) == 2
| list_clone_preserves_base: base -> count(base) == 2
| list_clone_preserves_bags: bags -> count(bags) == 1

? list_clone_preserves_first
? list_clone_preserves_second
? list_clone_preserves_labels
? list_clone_preserves_base
? list_clone_preserves_bags

@ print("PASS: list auto-clone works")
