-- Test: variables used in list literals are auto-cloned when used afterwards
-- Previously, putting a struct in [t1, t2, ...] moved it, making later use fail.

# Item(name: String, value: Int)

= a = Item("alpha", 1)
= b = Item("beta", 2)
= c = Item("gamma", 3)

-- Put them in a list (should auto-clone since used again below)
= items = [a, b, c]

-- Use the variables AFTER the list construction
@ print("After list construction:")
@ print("  a.name = " + a.name)
@ print("  b.name = " + b.name)
@ print("  c.name = " + c.name)

-- Also use the list
= n = count(items)
@ print("  list length = " + show(n))

? assert(a.name == "alpha")
? assert(b.name == "beta")
? assert(c.name == "gamma")
? assert(n == 3)

-- Reused string bindings should survive list construction too.
= first = "delta"
= second = "omega"
= labels = [first, second]
@ print("String reuse after list construction:")
@ print("  labels = " + show(labels))
@ print("  first = " + first)
@ print("  second = " + second)

-- Reused list bindings should survive nested list construction.
= base = ["north", "south"]
= bags = [base]
@ print("Nested list reuse after list construction:")
@ print("  bags = " + show(bags))
@ print("  base = " + show(base))

? assert(first == "delta")
? assert(second == "omega")
? assert(count(labels) == 2)
? assert(count(base) == 2)
? assert(count(bags) == 1)

@ print("PASS: list auto-clone works")
