-- expect-command: meta
-- expect-args: --type Shape --role source
-- expect-status: pass
-- expect-stdout: filter type Shape role source
-- expect-stdout: references: 2
-- expect-stdout: reference shape_filter role source binding primary_shape type Shape value Circle
-- expect-stdout: reference shape_filter role source binding secondary_shape type Shape value Square
-- expect-stdout-not: role warning

# Shape = Circle | Triangle | Square
# Warning(message: String)

= primary_shape = Circle
= secondary_shape = Square
= shape_warning = Warning(message = "Not selected")

@ meta(primary_shape)
@ meta(secondary_shape)
@ meta(shape_warning)
@ section shape_filter {

| circles_rule(shape: Shape) -> shape == Circle

}
