-- Every list builtin keeps the element type of the joined list.
# unit Micro "millionths of a share"
= amounts: List(Micro) = [1, 2]
= a: String = head(concat([0], amounts))
= b: String = last(concat(amounts, [0]))
= c: String = nth(concat([0], amounts), 1)
= d: String = head(tail(concat([0], amounts)))
= e: String = head(reverse(concat([0], amounts)))
= f: String = head(take(concat([0], amounts), 1))
= g: String = head(skip(concat([0], amounts), 1))
= h: String = first(concat([0], amounts))
= i: String = first(amounts)
