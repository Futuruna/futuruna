-- An entry's result must not depend on which facts are known: no `answer` is reached from one.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: `answer` in `asked_tax`, reached from the calculation `reaches_answer`

@ import ./answer_law

> asked_tax(h: Household) -> Int {
    = asked = answer(household_tax, h, from_case(h))
    match asked.outcome {
        | Answered -> 1
        | Unanswered -> 0
    }
}

@ entry
| reaches_answer(h: Household) -> asked_tax(h)
