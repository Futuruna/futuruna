-- Who answers does not depend on which element: a guide names no index.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: the AnswerGuide `household_guide` names the element `[0]`

@ import ./answer_law

# Origin = Customer
= household_guide = AnswerGuide(fields = [EntryField(path = pathof(Household::children[0]::age), by = Customer)])
