-- A passage cited `as amended` needs the amending act's instruction for it
-- quoted in the same section; without one the wording in force is unknown.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: § 8 A, stk. 2, 1. pkt. as amended: no instruction quoted in this section amends § 8 A, stk. 2, 1. pkt.

# SourceInfo(file: String, identifier: String)
# impl Document for SourceInfo {}
= personskatteloven = SourceInfo(file = "sources/personskatteloven.txt", identifier = "Personskatteloven, LBK nr. 1284 af 14/06/2021")
= personskatteloven_aendring = SourceInfo(file = "sources/personskatteloven-aendring.txt", identifier = "LOV nr. 1691 af 30/12/2024")

@ section share_income {

@ quote(personskatteloven)
----
§ 8 a. Skat af aktieindkomst, der ikke overstiger et grundbeløb på 48.300 kr.
(2010-niveau), beregnes som en endelig skat på 27 pct., jf. dog stk. 2.

Stk. 2. Skat af aktieindkomst, der overstiger grundbeløbet, beregnes med 42 pct.
----

@ quote(personskatteloven_aendring)
----
§ 4 I personskatteloven, jf. lovbekendtgørelse nr. 1284 af 14. juni 2021, foretages følgende ændring:

1. § 8 a, stk. 1, 1. pkt., affattes således:

Skat af aktieindkomst, der ikke overstiger et grundbeløb på 51.500 kr. (2010-niveau), beregnes som en endelig skat på 27 pct.
----

@ cite(§ 8 a, stk. 1, 1. pkt. as amended)
| threshold_kr() -> 51500
@ cite(§ 8 a, stk. 2, 1. pkt. as amended)
| high_rate_bp() -> 4200

}
