-- pathof into an optional record rejects a member the record does not declare, at that segment.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: pathof type `Spouse` has no field `incme`

# Spouse(income: Int, age: Int, cohabiting: Bool)
# Household(income: Int, spouse: Spouse?)
# TaxResult(tax: Int)
# CalculationField(path: String, label: String, question: String?, help: String?, unit: String?)
# RelativeField(path: ProgramReference, label: String, question: String?)
# SourceInfo(url: String, section: String)
# CalculationMetaRole(a) = Source(value: a)
# CalculationMeta(a) = CalculationMeta(fields: List(CalculationField), attachments: a)
# RelativeMeta(fields: List(RelativeField))
# impl MetaRole for CalculationMetaRole {}
# impl Meta for CalculationMeta {}
# impl Meta for RelativeMeta {}

= household_meta = CalculationMeta(
    fields = [
        CalculationField(path = pathof(Household::spouse::incme), label = "Spouse income", question = None, help = None, unit = None)
    ],
    attachments = ()
)

--@label:household_tax::meta:household_meta--

@ calculate
| household_tax(h: Household) -> TaxResult(tax = h.income)
