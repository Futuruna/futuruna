-- A guide's paths are into the input of the entry it answers.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: the AnswerGuide `spouse_guide` names paths into `Spouse`, but `household_tax` takes a `Household`

@ import ./answer_law

# Origin = Customer
= spouse_guide = AnswerGuide(fields = [EntryField(path = pathof(Spouse::income), by = Customer)])
= h = Household(income = 1, married = False, spouse = None, children = [])
= asked = answer(household_tax, h, spouse_guide, from_case(h))
