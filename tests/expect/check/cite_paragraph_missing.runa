-- A citation must name a paragraph the quote of its section holds.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: citation `§ 2, stk. 3`: § 2, stk. 3 does not appear in the quote of this section; the quote holds § 1; § 2, stk. 1, 2 (section `tax`)

# SourceInfo(file: String)
# impl Document for SourceInfo {}
= tax_law = SourceInfo(file = "sources/tax-law.txt")

@ section tax {

@ quote(tax_law)
----
§ 1. Skatten beregnes af summen af posterne.

§ 2. Skatten er 27 pct.

Stk. 2. For indkomstår før 2020 er skatten 15 pct.
----

@ cite(§ 2, stk. 3)
| rate_bp(year: Int) -> 2700

}
