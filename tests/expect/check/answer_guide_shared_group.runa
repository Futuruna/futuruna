-- Two guides in one file, each with its own group type declaring `Customer`:
-- a group resolves as any constructor does, bare where the guide's declared
-- type gives it a type and qualified where nothing does.
-- expect-command: check
-- roundtrip-skip: a file of guides runs only in the interpreter
-- expect-status: pass

@ import ./answer_law

# SpouseOrigin = Customer | Registry
# ChildOrigin = Schools | Customer
= spouse_guide: AnswerGuide(Household, SpouseOrigin) = AnswerGuide(fields = [
    EntryField(path = pathof(Household::spouse), by = Customer),
    EntryField(path = pathof(Household::children), by = Registry)
])
= child_guide = AnswerGuide(fields = [
    EntryField(path = pathof(Household::spouse), by = ChildOrigin.Customer),
    EntryField(path = pathof(Household::children), by = Schools)
])
