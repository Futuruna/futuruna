-- Every field metadata declaration names the field.
-- expect-command: check
-- expect-status: fail
-- expect-stderr: `@ field` needs a `label`, or only `key` (`@ field(key = True)`)

# Input(
    @ field(help = "Before tax.")
    income: Int
)
# TaxResult(tax: Int)

@ calculate
| tax(input: Input) -> TaxResult(tax = input.income)
