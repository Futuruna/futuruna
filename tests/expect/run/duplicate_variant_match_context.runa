-- expect-command: run
-- expect-status: pass
-- expect-stdout: 42
--
-- Named call shape and a typed match subject disambiguate a shared constructor.

# Event = Shared(value: Int) | EventOnly
# Legacy = Shared(legacy_value: Int) | LegacyOnly

| event_value(event: Event) -> match event {
    | Shared(value) -> value
    | EventOnly -> 0
}

= result = event_value(Shared(value = 42))
@ print(show(result))
