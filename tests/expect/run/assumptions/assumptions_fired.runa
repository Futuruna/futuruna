-- Every result carries the assumptions it rests on, without --explain: an
-- `Assumption` on a clause is there when that clause fired and absent when it
-- did not (the open account has no closing day, the closed one no open
-- value); one on a section is there when a rule clause of the section fired
-- (the transfer statement only for the transferred account); the entry's own
-- section's is always there. Each is listed once, however often its clause
-- fired (`room` runs twice) or wherever else it is written
-- (`transfer_statement` is also on the `received` clause), in the order the
-- model writes them.
-- expect-command: call
-- expect-input: assumptions_fired.json
-- expect-stdout-file: assumptions_fired.stdout

# AssumptionInfo(id: String, statement: String)
# LawRole(a) = Assumption(value: a)
# impl MetaRole for LawRole {}

= whole_kroner = AssumptionInfo(id = "WHOLE-KRONER", statement = "Amounts are whole kroner.")
= open_value = AssumptionInfo(id = "OPEN-VALUE", statement = "The value of an open account is the custodian's year-end value.")
= closing_day = AssumptionInfo(id = "CLOSING-DAY", statement = "The value on the closing day is the custodian's.")
= transfer_statement = AssumptionInfo(id = "TRANSFER", statement = "The giving institute's statement is complete.")
# Account(value: Int, closed: Bool, transferred: Bool)
# Result(room: Int, room_again: Int, received: Int)

@ section closing {

@ meta(Assumption(value = open_value))
| room(closed: Bool, value: Int): Int -> 1000 - value
@ meta(Assumption(value = closing_day))
| exception closed room(closed, value) -> 0 under closed

}

@ meta(Assumption(value = transfer_statement))
@ section transfer {

@ meta(Assumption(value = transfer_statement))
| received(value: Int) -> value

}

@ meta(Assumption(value = whole_kroner))
@ section report {

@ entry
> assumptions_fired(a: Account) -> Result {
    Result(
        room = room(a.closed, a.value),
        room_again = room(a.closed, a.value),
        received = if a.transferred { received(a.value) } else { 0 }
    )
}

}
