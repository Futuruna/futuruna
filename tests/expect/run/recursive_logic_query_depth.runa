-- expect-command: interp
-- expect-status: fail
-- expect-env: FUTURUNA_STACK_MB=256
-- expect-stderr: exceeded the recursion limit at depth
-- expect-stderr: the evaluation stack is exhausted; evaluation is incomplete
-- expect-stderr-not: panicked
-- roundtrip-skip: unbounded recursion stops at a stack depth that differs between execution modes
-- A cyclic relation queried for an unreachable target recurses without bound
-- and stops with a located error.

| edge("a", "b")
| edge("b", "a")
| reach(x, y) -> edge(x, y)
| reach(x, y) -> edge(x, middle), reach(middle, y)

@ print(show(reach("a", "z")))
