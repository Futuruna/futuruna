-- A path the guide does not name is required: the integrator builds it into the
-- case, and a need there is an error that names the path and the guide.
-- expect-command: interp
-- expect-status: fail
-- roundtrip-skip: `answer`, `query` and `unknown` run only in the interpreter
-- expect-stderr: `answer(household_tax, …)`, round 1: `income` is required (the AnswerGuide `spouse_only` names no group for it), but the case leaves it unknown

@ import ./answer_household_law

# Origin = Customer

= spouse_only = AnswerGuide(fields = [EntryField(path = pathof(Household::spouse), by = Customer)])

= complete = Household(income = 500, married = False, spouse = None, children = [])
= started: Household = Household(income = unknown, married = False, spouse = None, children = [])
= answered = answer(household_tax, started, spouse_only, from_case(complete))
@ print(show(length(answered.rounds)))
