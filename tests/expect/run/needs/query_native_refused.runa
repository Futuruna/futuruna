-- A query runs in the interpreter; native code takes complete input.
-- expect-command: run
-- expect-status: fail
-- expect-stderr: `query` runs in the interpreter; native code takes complete input
-- roundtrip-skip: tests that `runa run` refuses `query`, which runs only in the interpreter

# Spouse(@ field(label = "Spouse's income") income: Int, cohabiting: Bool)
# Household(income: Int, married: Bool, spouse: Option(Spouse))
# Result(tax: Int)

@ section transfer {
| threshold(h: Household) -> match h.spouse {
    | Some(s) -> if s.cohabiting { 200 - s.income } else { 100 }
    | None -> 100
}
}

@ entry
| household_tax(h: Household) -> Result(tax = h.income - threshold(h))

= asked = query household_tax(Household(income = 500, married = True, spouse = unknown))
