-- Every entry generates its AnswerGuide from the law: each input path pattern
-- at which a need can arise, with its type and the law's metadata, in the
-- order the input type declares them. It names nobody who answers.
-- expect-command: interp
-- roundtrip-skip: `answer_guide` and `query` run only in the interpreter
-- expect-stdout: [income, married, spouse, spouse.income, spouse.cohabiting, children, children[].name, children[].age]
-- expect-stdout: [Int, Bool, Spouse?, Int, Bool, List(Child), String, Int]
-- expect-stdout: |every_need_has_its_pattern| holds

@ import ./answer_household_law

= guide = answer_guide(household_tax)
@ print(show(map(guide.needs, |n| n.pattern)))
@ print(show(map(guide.needs, |n| n.value_type)))

= patterns = map(guide.needs, |n| n.pattern)
= asked = query household_tax(Household(income = unknown, married = True, spouse = unknown, children = [Child(name = "Ada", age = unknown)]))
| every_need_has_its_pattern: asked -> match asked {
    | Needs -> length(asked.needs) == 3 && any(patterns, |p| p == "children[].age")
    | Complete -> False
}

? every_need_has_its_pattern
