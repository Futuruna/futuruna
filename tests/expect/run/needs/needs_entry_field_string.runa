-- The string form of needs_entry_field.runa, still read: the same contract
-- (schema hash) and the same need. `runa fmt --migrate` rewrites it as the
-- typed form.
-- expect-command: call
-- expect-input: needs_entry_field.json
-- expect-args: --entry household_tax --partial
-- expect-stdout-file: needs_entry_field.stdout

# Spouse(income: Int)
# Household(
    income: Int,
    spouse: Spouse,
    @ field(label = "Spouse's share income", unit = "øre", entry = refof(share_income), subject = pathof(Household::spouse))
    spouse_share_income: Int
)
# Result(tax: Int)

@ entry
| share_income(s: Spouse) -> s.income

| threshold(h: Household): Int -> 100
| exception transferred threshold(h) -> 200 - h.spouse_share_income under h.spouse_share_income < 100

@ entry
| household_tax(h: Household) -> Result(tax = h.income - threshold(h))
