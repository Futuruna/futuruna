--
-- Fielded and nullary variants of the same sum type must not compare equal.

# Lease = Fixed(years: Int) | Unlimited

= fixed = Fixed(years = 10)

@ print(show(fixed == Unlimited))
@ print(show(fixed != Unlimited))
@ print(show(fixed == Fixed(years = 10)))
