-- expect-command: interp
-- expect-status: pass
-- expect-stdout: label=a:1
-- expect-stdout: first=a:1
-- expect-stdout: zipped=(1, a)
-- expect-stdout: same=true
-- A builtin's two-element tuple result is a Pair and the other way round.

> label(entry: Pair(String, Int)) -> String { entry.fst + ":" + show(entry.snd) }
> first_entry(m: Map(String, Int)) -> Pair(String, Int) { head(map_entries(m)) }
> first_zip() -> Pair(Int, String) { head(zip([1], ["a"])) }

= m = map_from([("a", 1)])

@ print("label=" + label(head(map_entries(m))))
@ print("first=" + label(first_entry(m)))
@ print("zipped=" + show(first_zip()))
@ print("same=" + show(Pair(1, "b") == (1, "b")))
