-- expect-skip: dependency-only fixture for needs_options_in_qualified_import_interp.runa: a qualified module that compares the Options of its query answers with Options it builds
-- roundtrip-skip: `query` and `unknown` run only in the interpreter; it runs through needs_options_in_qualified_import_interp.runa

# AssumptionInfo(id: String)
# LawRole(a) = Assumption(value: a)
# impl MetaRole for LawRole {}

@ export
# Account(value: Int, closed: Bool)
# Result(room: Int)

@ section closing {

| room(closed: Bool, value: Int): Int -> 1000 - value
@ meta(Assumption(value = AssumptionInfo(id = "CLOSING-DAY")))
| exception closed room(closed, value) -> 0 under closed

}

@ calculate
| account_room(a: Account) -> Result(room = room(a.closed, a.value))

> section_name(s: Option(ProgramReference)) -> String {
    match s {
        | Some(reference) -> if reference == refof(section closing) { "closing" } else { "other" }
        | None -> "none"
    }
}

@ export
> assumption_compared() -> Bool {
    = q = query account_room(Account(value = unknown, closed = True))
    match q {
        | Complete -> any(q.assumptions, |a| a.section == Some(refof(section closing)) and a.rule == Some(refof(room)) and a.binding == None)
        | Needs -> False
    }
}

> rule_name(r: Option(ProgramReference)) -> String {
    match r {
        | Some(rule) -> if rule == refof(room) { "room" } else { "other" }
        | None -> "none"
    }
}

> binding_name(b: Option(ProgramReference)) -> String {
    match b {
        | Some(binding) -> "some"
        | None -> "none"
    }
}

@ export
> assumption_matched() -> String {
    = q = query account_room(Account(value = unknown, closed = True))
    match q {
        | Complete -> join(map(q.assumptions, |a| section_name(a.section) + "/" + rule_name(a.rule) + "/" + binding_name(a.binding)), ",")
        | Needs -> "needs"
    }
}

@ export
> need_compared() -> Bool {
    = q = query account_room(Account(value = 5, closed = unknown))
    match q {
        | Needs -> all(q.needs, |n| n.entry == None and any(n.waiting, |w| w.section == Some(refof(section closing))))
        | Complete -> False
    }
}

> entry_kind(e: Option(ProgramReference)) -> String {
    match e {
        | Some(entry) -> if entry == refof(share_income) { "entry share_income" } else { "entry other" }
        | None -> "fact"
    }
}

@ export
> need_matched() -> String {
    = q = query account_room(Account(value = 5, closed = unknown))
    match q {
        | Needs -> join(map(q.needs, |n| entry_kind(n.entry) + ":" + join(map(n.waiting, |w| section_name(w.section)), "+")), ",")
        | Complete -> "complete"
    }
}

# Spouse(income: Int)
# Household(
    income: Int,
    spouse: Spouse,
    @ field(label = "Spouse's share income", entry = refof(share_income), subject = pathof(Household::spouse))
    spouse_share_income: Int
)
# Tax(amount: Int)

@ calculate
| share_income(s: Spouse) -> s.income

@ calculate
| household_tax(h: Household) -> Tax(amount = h.income - h.spouse_share_income)

> provided() -> Household { Household(income = 500, spouse = Spouse(income = 50), spouse_share_income = unknown) }

@ export
> entry_compared() -> Bool {
    = q = query household_tax(provided())
    match q {
        | Needs -> any(q.needs, |n| n.entry == Some(refof(share_income)))
        | Complete -> False
    }
}

@ export
> entry_matched() -> String {
    = q = query household_tax(provided())
    match q {
        | Needs -> join(map(q.needs, |n| entry_kind(n.entry)), ",")
        | Complete -> "complete"
    }
}
