-- A qualified module compares the `Option` members of its query answers
-- (an assumption's section, rule and binding; a need's entry and its
-- waiting sections) with `Some`/`None` it builds itself, and matches on them.
-- expect-command: interp
-- expect-stdout: assumption compared: true
-- expect-stdout: assumption matched: closing/room/none
-- expect-stdout: need compared: true
-- expect-stdout: need matched: fact:closing

@ import Accounts from ./needs_options_in_qualified_import_lib

@ print("assumption compared: " + show(Accounts.assumption_compared()))
@ print("assumption matched: " + Accounts.assumption_matched())
@ print("need compared: " + show(Accounts.need_compared()))
@ print("need matched: " + Accounts.need_matched())
