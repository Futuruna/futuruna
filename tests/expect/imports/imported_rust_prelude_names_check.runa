-- expect-command: check
-- expect-status: pass

@ import ./imported_rust_prelude_names_lib

-- Types declared in an imported file keep their meaning in native code, as
-- they do when the root file declares them: neither the prelude nor Rust may
-- take `Result`, `Option`, `Vec` or another Rust name from them.
= vec = Vec(x = 3, y = 4)
= result = total(vec)
= option = Option(label = "seven")

@ print("result=" + show(result.value))
@ print("direct=" + show(Result(value = 1)))
@ print("option=" + option.label)
@ print("vec=" + show(vec))
@ print("default=" + show(Default(rate = 2).rate))
@ print("clone=" + show(Clone(copies = 3)))
@ print("map=" + show(HashMap(size = 1).size))
