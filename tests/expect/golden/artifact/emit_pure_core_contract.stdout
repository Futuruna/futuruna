    if (a >= b) { a } else { b }
}

fn min_int(a: i64, b: i64) -> i64 {
    if (a <= b) { a } else { b }
}

fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if (x < lo) { lo } else { if (x > hi) { hi } else { x } }
}

fn identity<A: __FuturunaShow + __FuturunaOrd + Clone>(x: A) -> A {
    x
}

fn add_bias(__fut_globals: &__FutGlobals, x: i64) -> i64 {
    { let __fut_l: i64 = x; let __fut_r: i64 = __fut_globals.doubled.clone().expect("top-level binding `doubled` not initialized"); __fut_l.checked_add(__fut_r).expect("integer addition overflow") }
}

const __FUT_RUNTIME_MAIN_STACK_BYTES: usize = 64 * 1024 * 1024;

fn __fut_runtime_main_inner() {
    let mut __fut_globals = __FutGlobals::default();
    let base = 7i64;
    __fut_globals.base = Some(base.clone());
    let doubled = { let __fut_l: i64 = base; let __fut_r: i64 = 2i64; __fut_l.checked_mul(__fut_r).expect("integer multiplication overflow") };
    __fut_globals.doubled = Some(doubled.clone());
    println!("{}", __futuruna_show_any(&(add_bias(&__fut_globals, base))));
}

fn main() {
    __futuruna_install_error_hook();
    let __fut_runtime_main = std::thread::Builder::new()
        .name("futuruna-main".to_string())
        .stack_size(__FUT_RUNTIME_MAIN_STACK_BYTES)
        .spawn(__fut_runtime_main_inner)
        .unwrap_or_else(|error| panic!("failed to start Futuruna program: {}", error));
    if __fut_runtime_main.join().is_err() {
        std::process::exit(1);
    }
}
