-- `runa verify` assumes the checks of a named scalar input that translate
-- to SMT: `m` is passed where a `Month` is declared, so it is between 1 and
-- 12, and the quarter is between 1 and 4. Over every Int it is not.
-- expect-command: verify
-- expect-args: --smt
-- expect-status: pass
-- expect-stdout: ; The checks of named scalar inputs
-- expect-stdout: (assert (__scalar_check_Month_0 runa_v_6d))
-- expect-stdout: PROVED: |quarter_in_range|
-- expect-stdout: Verification: 1 of 1 invariant(s) proved.

| between(n: Int, low: Int, high: Int) -> n >= low && n <= high
# Month: Int "a month of the year" where between(1, 12)

| quarter(m: Month) -> (m - 1) / 3 + 1
| quarter_in_range: quarter(m) -> quarter(m) >= 1 && quarter(m) <= 4
