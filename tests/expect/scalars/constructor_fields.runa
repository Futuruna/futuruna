-- A constructor field of type `String` takes an `Isin`, and a literal takes
-- the named scalar its field expects (and `runa check` checks it).
-- expect-command: interp
-- expect-status: pass
-- expect-stdout: DK0060534915/DK0060534915

@ import ./isin_lib

# Holding(isin: Isin, name: String)

= home = Holding(isin = "DK0060534915", name = "Novo")
= copy = Holding(isin = home.isin, name = home.isin)
@ print(copy.isin + "/" + copy.name)
