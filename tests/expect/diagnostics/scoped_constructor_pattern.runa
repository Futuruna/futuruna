-- expect-command: check
-- expect-status: fail
-- expect-stderr: constructor pattern `Closed` belongs to `Event` and `AskYearEvent`, and the matched value has no known type; write `Event.Closed` or `AskYearEvent.Closed`
# Event = Trade(id: String, amount: Int) | Closed
# AskYearEvent = Trade(id: String, amount: Int, year: Int) | Closed

> kind(e) -> String {
    match e {
        | Closed -> "closed"
        | _ -> "other"
    }
}
