-- inexpressible2.runa: A program no other language can express
--
-- Not because the individual features are unique — other languages have ADTs,
-- streams, rules, effects. What's inexpressible is the COUPLING: all seven
-- dimensions interact in a single coherent program where removing any one
-- breaks the others.
--
-- Scenario: A medical alert system that monitors patient vitals,
-- applies clinical rules (with exception overrides), streams alerts,
-- and verifies safety invariants — all in ~80 lines of executable code.

-- ============================================================================
-- # TYPE DIMENSION: the shape of medical data
-- ============================================================================

# Vital = HeartRate(bpm: Int) | BloodPressure(sys: Int, dia: Int) | SpO2(pct: Int)
# Severity = Normal | WarningHigh | WarningLow | Critical
# Alert(vital: String, level: String, message: String)

-- ============================================================================
-- > FUNCTION DIMENSION: pure clinical logic with borrow inference
-- ============================================================================

> classify_hr(bpm: Int) -> Severity {
    if bpm < 50 { Critical }
    else if bpm < 60 { WarningLow }
    else if bpm > 150 { Critical }
    else if bpm > 120 { WarningHigh }
    else { Normal }
}

> classify_bp(sys: Int, dia: Int) -> Severity {
    if sys > 180 { Critical }
    else if sys > 140 { WarningHigh }
    else if dia > 120 { Critical }
    else if dia > 90 { WarningLow }
    else { Normal }
}

> classify_spo2(pct: Int) -> Severity {
    if pct < 90 { Critical }
    else if pct < 95 { WarningHigh }
    else { Normal }
}

> severity_name(s: Severity) -> String {
    match s {
        | Normal -> "NORMAL"
        | WarningHigh -> "WARNING HIGH"
        | WarningLow -> "WARNING LOW"
        | Critical -> "CRITICAL"
    }
}

> classify_vital(v: Vital) -> Severity {
    match v {
        | HeartRate(bpm: b) -> classify_hr(b)
        | BloodPressure(sys: s, dia: d) -> classify_bp(s, d)
        | SpO2(pct: p) -> classify_spo2(p)
    }
}

> vital_name(v: Vital) -> String {
    match v {
        | HeartRate(bpm: _) -> "HeartRate"
        | BloodPressure(sys: _, dia: _) -> "BloodPressure"
        | SpO2(pct: _) -> "SpO2"
    }
}

-- ============================================================================
-- | RULE DIMENSION: Catala-style default logic with exceptions
--   Clinical rules have overrides — a patient on beta-blockers has a
--   naturally low heart rate, so the "low HR = warning" rule is suppressed.
-- ============================================================================

-- Default: classify based on standard thresholds
| alert_for(v) -> Alert(vital_name(v), severity_name(classify_vital(v)), show(v))

-- Exception: beta-blocker patient — low HR (45-59) is expected, override to Normal
| exception beta_blocker alert_for(v) -> Alert("HeartRate", "NORMAL", show(v) + " (beta-blocker)") under match v { | HeartRate(bpm: b) -> b >= 45 && b < 60 | _ -> false }

-- ============================================================================
-- ~ STREAM DIMENSION: vitals arrive as a push stream, alerts are derived
-- ============================================================================

~ vitals = subject()

-- Push a sequence of readings (simulating real-time monitoring)
vitals <- HeartRate(72)
vitals <- BloodPressure(120, 80)
vitals <- SpO2(98)
vitals <- HeartRate(52)
vitals <- BloodPressure(185, 95)
vitals <- SpO2(88)
vitals <- HeartRate(155)
vitals <- SpO2(93)
vitals <- BloodPressure(145, 85)
vitals <- HeartRate(130)

-- Derive alert stream using rules + stream operators
~ alerts = vitals |> map(|v| alert_for(v))

-- Filter to only non-normal alerts
~ critical_alerts = alerts |> filter(|a: Alert| a.level != "NORMAL")

-- ============================================================================
-- @ EFFECT DIMENSION: side effects triggered by stream data
-- ============================================================================

@ print("=== Medical Alert System ===")
@ print("")

-- @ comptime: pre-compute threshold reference at compile time
@ comptime
= hr_info = "HR: <50 crit, 50-59 warn, 60-120 ok, 121-150 warn, >150 crit"

@ print("Thresholds: " + hr_info)
@ print("")

-- Process all alerts
@ print("--- All Readings ---")
~ alerts | a -> {
    @ print("  " + a.vital + " -> " + a.level + "  (" + a.message + ")")
}

@ print("")
@ print("--- Critical/WarningHigh Only ---")
~ critical_alerts | a -> {
    @ print("  ** " + a.vital + " -> " + a.level + "  (" + a.message + ")")
}

= num_critical = critical_alerts |> count
@ print("")
@ print("Total readings: " + show(vitals.count))
@ print("Alerts raised: " + show(num_critical))

-- ============================================================================
-- ? VERIFICATION DIMENSION: prove safety invariants
-- ============================================================================

-- Define named invariants (Catala-style: name: subject -> predicate)
= normal_hr = classify_hr(70)
| hr_normal: normal_hr -> normal_hr == Normal

= critical_spo2 = classify_spo2(85)
| spo2_critical: critical_spo2 -> critical_spo2 == Critical

= crisis_bp = classify_bp(190, 80)
| bp_crisis: crisis_bp -> crisis_bp == Critical

| alerts_exist: num_critical -> num_critical > 0

@ print("")
@ print("--- Safety Verification ---")

? hr_normal -> {
    @ print("  [PASS] Normal HR (70) -> Normal")
} else {
    @ print("  [FAIL] Normal HR (70) did not classify as Normal!")
}

? spo2_critical -> {
    @ print("  [PASS] Low SpO2 (85) -> Critical")
} else {
    @ print("  [FAIL] Low SpO2 (85) did not classify as Critical!")
}

? bp_crisis -> {
    @ print("  [PASS] Hypertensive crisis (190/80) -> Critical")
}

? alerts_exist -> {
    @ print("  [PASS] Alert count > 0")
}

-- ============================================================================
-- | SCOPE DIMENSION: teardown when monitoring ends
-- ============================================================================

@ print("")
@ print("--- Scope Lifecycle ---")

| scope Monitor {
    = patient = "Patient-42"
    ~ log = subject()
    log <- "monitoring started"
    log <- "vitals received"
    @ print("  " + patient + ": " + show(log.count) + " log entries")
}

@ print("  Monitor.patient = " + Monitor.patient)
@ teardown("Monitor")
@ print("  Monitor torn down — lifecycle complete")

@ print("")
@ print("=== 7 dimensions, 1 program, 0 boilerplate ===")

-- ============================================================================
-- WHY THIS IS INEXPRESSIBLE IN OTHER LANGUAGES:
-- ============================================================================
--
-- The program above uses ALL SEVEN Futuruna dimensions in a single
-- coherent program where the dimensions CROSS-COUPLE:
--
--   # types    <-> | rules      Type variants determine which rules fire
--   ~ streams  <-> > functions  Stream ops compose with pure functions
--   | rules    <-> | exception  Clinical overrides (beta-blocker) change behavior
--   ? verify   <-> > functions  Invariants prove the same functions correct
--   = values   <-> ~ streams   Bindings capture stream aggregations
--   @ comptime <-> = values    Compile-time computation feeds runtime
--   | scope    <-> ~ subjects  Scope lifecycle controls stream lifetime
--
-- In Kotlin: sealed classes + RxJava + Drools + JUnit = 4 libraries
--   that don't compose. Beta-blocker override requires imperative if/else
--   tangled in business logic. ~200 lines.
--
-- In Rust: enums + tokio + no rule engine + no verification = you write
--   the rule engine yourself. ~300 lines of async boilerplate.
--
-- In Haskell: ADTs + conduit + no default logic + QuickCheck = three
--   separate mental models. No exception rules without a logic DSL.
--
-- In Catala: Default logic with exceptions is native! But no reactive
--   streams, no effect system, no scope lifecycle. Catala is for law,
--   not monitoring systems.
--
-- Futuruna: 80 lines. All seven dimensions. One mental model.
-- d_eff >= 3 because removing any dimension breaks the program.
