-- hash_math.runa: Module for content-addressed import testing
-- These functions can be imported by hash from other files.

> square(x: Int) -> Int { x * x }

> cube(x: Int) -> Int { x * x * x }

> double(x: Int) -> Int { x * 2 }

> factorial(n: Int) -> Int {
    if n <= 1 { 1 } else { n * factorial(n - 1) }
}
