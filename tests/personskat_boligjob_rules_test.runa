@ sprog da
@ importer ../examples / danish - income - tax / ligningsloven - par8v - boligjob

= boligjob_lofter = [ll8v_service_loft(2023) == 6600, ll8v_service_loft(2024) == 11900, ll8v_service_loft(2025) == 17500, ll8v_service_loft(2026) == 18300, ll8v_håndværker_loft(2023) == 0, ll8v_håndværker_loft(2024) == 0, ll8v_håndværker_loft(2025) == 8600, ll8v_håndværker_loft(2026) == 9000, ll8v_service_loft(2027) == 0]
= boligjob_datoer = [
    ll8v_fradragsår(Dato(år = 2023, måned = 12, dag = 1), Dato(år = 2024, måned = 2, dag = 29)) == 2023,
    ll8v_fradragsår(Dato(år = 2023, måned = 12, dag = 1), Dato(år = 2024, måned = 3, dag = 1)) == 2024,
    ll8v_fradragsår(Dato(år = 2025, måned = 12, dag = 1), Dato(år = 2026, måned = 2, dag = 28)) == 2025,
    ll8v_fradragsår(Dato(år = 2025, måned = 12, dag = 1), Dato(år = 2026, måned = 2, dag = 29)) == 0
]
= boligjob_tidsgrænser = [ll8v_arbejdsår_omfattet(Ll8VTagisolering, 2024) == Falskt, ll8v_arbejdsår_omfattet(Ll8VTagisolering, 2025), ll8v_arbejdsår_omfattet(Ll8VTagrender, 2024) == Falskt, ll8v_arbejdsår_omfattet(Ll8VTagrender, 2025), ll8v_arbejdsår_omfattet(Ll8VHvidevarereparation, 2027), ll8v_arbejdsår_omfattet(Ll8VHvidevarereparation, 2028) == Falskt]
= boligjob_budget = [ll8v_restbudget(9223372036854775807, Ll8VAndel(personreference = "a", arbejdsløn_øre = 9223372036854775807)) == 0, ll8v_restbudget(100, Ll8VAndel(personreference = "a", arbejdsløn_øre = 101)) == -1, ll8v_restbudget(100, Ll8VAndel(personreference = "a", arbejdsløn_øre = -1)) == -1]
= boligjob_arbejdsdækning = [
    ll8v_arbejdsdato_dækket(Dato(år = 2022, måned = 3, dag = 31)) == Falskt,
    ll8v_arbejdsdato_dækket(Dato(år = 2022, måned = 4, dag = 1)),
    ll8v_arbejdsdato_dækket(Dato(år = 2021, måned = 12, dag = 31)) == Falskt,
    ll8v_arbejdsdato_dækket(Dato(år = 2022, måned = 4, dag = 31)) == Falskt,
    ll8v_arbejdsdato_dækket(Dato(år = 2026, måned = 12, dag = 31)),
    ll8v_arbejdsdato_dækket(Dato(år = 2027, måned = 1, dag = 1)) == Falskt
]

| boligjob_årslofter: boligjob_lofter -> all(boligjob_lofter, |ok: Boolsk| ok)
| boligjob_betalingsår: boligjob_datoer -> all(boligjob_datoer, |ok: Boolsk| ok)
| boligjob_ydelsers_virkningstid: boligjob_tidsgrænser -> all(boligjob_tidsgrænser, |ok: Boolsk| ok)
| boligjob_fordelingsbudget: boligjob_budget -> all(boligjob_budget, |ok: Boolsk| ok)
| boligjob_arbejdsdatodækning: boligjob_arbejdsdækning -> all(boligjob_arbejdsdækning, |ok: Boolsk| ok)

? boligjob_årslofter
? boligjob_betalingsår
? boligjob_ydelsers_virkningstid
? boligjob_fordelingsbudget
? boligjob_arbejdsdatodækning

-- Fiktiv rengøring i december 2024 betalt i marts 2025. Udførerens alder
-- følger arbejdsåret, selv om køberens fradrag henføres til betalingsåret.
> boligjob_privatpost(udfører_født_år: Heltal) -> Ll8VPost {
    Ll8VPost(
        betaling = Ll8VBetalingsfakta(
            identifikation = "fiktiv-linje",
            kildereference = "fiktiv-serviceerklæring",
            betalingsreference = "fiktiv-overførsel",
            boligreference = "fiktiv-helårsbolig",
            ydelse = Ll8VRengøring,
            arbejdsdato = Dato(år = 2024, måned = 12, dag = 1),
            betalingsdato = Dato(år = 2025, måned = 3, dag = 1),
            land = Ll8VDanmark,
            eksisterende_bolig = Ll8VJa,
            leverandør = Ll8VPrivatperson(fødselsdato = Dato(år = udfører_født_år, måned = 12, dag = 31), fuld_skattepligt_i = Ll8VDanskRegistrering),
            betalt_arbejdsløn_øre = 300000,
            betalte_materialer_kørsel_m_v_øre = 0,
            betalingsform = Ll8VKontooverførsel,
            arbejdsbilag_med_påkrævede_oplysninger = Ll8VJa,
            betalingsbilag = Ll8VJa,
            offentligt_tilskud = Ll8VNej,
            samme_udgift_fradraget_efter_andre_regler = Ll8VNej,
            børnepasning_skattefri_efter_par7æ = Ll8VNej,
            udfører_bor_i_helårsboligen_eller_ejer_fritidsboligen_eller_bor_med_ejer = Ll8VNej,
            betalerreference = "fiktiv-person",
            andele = [Ll8VAndel(personreference = "fiktiv-person", arbejdsløn_øre = 300000)],
            særligt_forhold = Ll8VAlmindeligUdgift
        ),
        boligforhold = Ll8VHelårsbolig(fast_bopæl_ved_arbejdet = Ll8VJa, individuel_råderet_og_vedligeholdelsesret = Ll8VJa),
        fællesøkonomi_med_betalende_ægtefælle_eller_samlever = Ll8VUoplyst,
        indberettet_med_leverandøroplysninger = Ll8VJa
    )
}
= boligjob_ung_udfører = ll8v_postresultat(2025, Dato(år = 1980, måned = 1, dag = 1), "fiktiv-person", Ll8VFuldtSkattepligtig, boligjob_privatpost(2007))
= boligjob_voksen_udfører = ll8v_postresultat(2025, Dato(år = 1980, måned = 1, dag = 1), "fiktiv-person", Ll8VFuldtSkattepligtig, boligjob_privatpost(2006))
= boligjob_ung_holder = boligjob_ung_udfører.input_gyldigt && boligjob_ung_udfører.fradragsår == 2025 && boligjob_ung_udfører.betingelser_opfyldt == Falskt && boligjob_ung_udfører.medregnet_før_årsloft_øre == 0
= boligjob_voksen_holder = boligjob_voksen_udfører.input_gyldigt && boligjob_voksen_udfører.betingelser_opfyldt && boligjob_voksen_udfører.medregnet_før_årsloft_øre == 300000
| boligjob_sen_betaling_ændrer_ikke_udførers_alderskrav: boligjob_ung_holder -> boligjob_ung_holder
| boligjob_18_ved_arbejdsårets_udløb_er_nok: boligjob_voksen_holder -> boligjob_voksen_holder
? boligjob_sen_betaling_ændrer_ikke_udførers_alderskrav
? boligjob_18_ved_arbejdsårets_udløb_er_nok
