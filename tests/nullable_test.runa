-- nullable_test.runa: Kotlin-style nullability (T?, ?., ?:)
-- These desugar to Option(T), match on Some/None

-- T? type annotation on return type
> find(x: Int) -> Int? {
    if x > 0 { Some(x * 10) }
    else { None }
}

-- Record type for testing safe call
# Point(x: Int, y: Int)

> make_point(n: Int) -> Point? {
    if n > 0 { Some(Point(n, n * 2)) }
    else { None }
}

-- Test T? type annotation
= p1 = make_point(5)
= p2 = make_point(0)
@ print("p1 = " + show(p1))
@ print("p2 = " + show(p2))

-- Safe field access: p1?.x should be Some(5), p2?.x should be None
= x1 = p1?.x
= x2 = p2?.x
@ print("p1?.x = " + show(x1))
@ print("p2?.x = " + show(x2))

-- Elvis operator: unwrap with default
= val1 = find(3) ?: 0
= val2 = find(-1) ?: 42
@ print("find(3) ?: 0 = " + show(val1))
@ print("find(-1) ?: 42 = " + show(val2))

-- Chaining: safe call then elvis
= chained = make_point(5)?.x ?: 99
@ print("make_point(5)?.x ?: 99 = " + show(chained))

= chained2 = make_point(0)?.x ?: 99
@ print("make_point(0)?.x ?: 99 = " + show(chained2))
