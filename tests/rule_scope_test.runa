-- rule_scope_test.runa: pure scoped legal rules
-- Covers constructor inputs, sibling scoped rules, under/default/exception
-- priority, method parameters, field projection returns, ADT-valued product
-- fields, rules returning scoped values, and global-name collision without leakage.

# Person(age: Int, gross_income: Int, lives_in_denmark: Bool)
# TaxRates(personal_allowance: Int, child_allowance: Int, municipal_percent: Int, state_percent: Int)
# FilingMode = Digital | Paper(String)
# TaxSummary(total: Int, source: String)

# FilingLabel(prefix: String, mode: FilingMode) {
    > suffix() -> String {
        match mode {
            | Digital -> "digital"
            | Paper(code) -> code
        }
    }
}

# Receipt(amount: Int) {
    > double() -> Int { amount * 2 }
    > label() -> String { "receipt:" + show(amount) }
}

| personal_allowance() -> 999

# TaxCase(person: Person, rates: TaxRates) {
    | personal_allowance() -> rates.child_allowance under person.age < 18
    | personal_allowance() -> rates.personal_allowance

    | taxable_income() -> person.gross_income - personal_allowance()
    | municipal_tax() -> taxable_income() * rates.municipal_percent / 100
    | state_tax() -> taxable_income() * rates.state_percent / 100
    | tax_due() -> municipal_tax() + state_tax()
    | final_due() -> tax_due()
    | projected_tax(extra_income: Int) -> tax_due() + extra_income * rates.municipal_percent / 100
    | reported_income() -> person.gross_income
    | summary() -> TaxSummary(tax_due(), filing_status())
    | summary_copy() -> summary()
    | summary_total() -> summary().total
    | summary_source_copy() -> summary_copy().source

    | filing_status() -> "resident"
    | exception nonresident filing_status() -> "nonresident" under person.lives_in_denmark == False
    | status_copy() -> filing_status()

    > method_due() -> Int { tax_due() }
    > self_method_due(self) -> Int { self.tax_due() }
    > labeled_status(label: FilingLabel) -> String { label.prefix + ":" + label.suffix() + ":" + filing_status() }
    > method_field_projection() -> Int { person.gross_income }
}

= rates = TaxRates(100, 300, 20, 5)
= child = TaxCase(Person(12, 1000, True), rates)
= adult = TaxCase(Person(40, 1000, True), rates)
= foreign = TaxCase(Person(40, 1000, False), rates)
= direct_due = TaxCase(Person(40, 1000, True), rates).tax_due()
| adult_case() -> TaxCase(Person(40, 1000, True), rates)
= adult_from_rule = adult_case()
= due_from_rule_returned_scope = adult_case().tax_due()
= bound_rule_returned_due = adult_from_rule.tax_due()
= receipt = Receipt(7)
= filing_label = FilingLabel("case", Paper("manual"))

| child_allowance_ok: child.personal_allowance() -> child.personal_allowance() == 300
| adult_allowance_ok: adult.personal_allowance() -> adult.personal_allowance() == 100
| sibling_ok: adult.tax_due() -> adult.tax_due() == 225
| direct_constructor_ok: direct_due -> direct_due == 225
| rule_returned_scope_member_ok: due_from_rule_returned_scope -> due_from_rule_returned_scope == 225
| bound_rule_returned_scope_member_ok: bound_rule_returned_due -> bound_rule_returned_due == 225
| final_call_only_ok: adult.final_due() -> adult.final_due() == 225
| projected_param_ok: adult.projected_tax(100) -> adult.projected_tax(100) == 245
| field_projection_ok: adult.reported_income() -> adult.reported_income() == 1000
| rulescope_record_delegation_ok: adult.summary_copy() -> adult.summary_copy().total == 225
| rulescope_delegated_projection_ok: adult.summary_total() -> adult.summary_total() == 225
| rulescope_delegated_record_projection_ok: adult.summary_source_copy() -> adult.summary_source_copy() == "resident"
| exception_ok: foreign.filing_status() -> foreign.filing_status() == "nonresident"
| call_only_string_ok: foreign.status_copy() -> foreign.status_copy() == "nonresident"
| global_collision_ok: personal_allowance() -> personal_allowance() == 999
| method_calls_rule_ok: adult.method_due() -> adult.method_due() == 225
| explicit_self_method_ok: adult.self_method_due() -> adult.self_method_due() == 225
| method_cross_product_ok: adult.labeled_status(filing_label) -> adult.labeled_status(filing_label) == "case:manual:resident"
| method_adt_field_ok: filing_label.suffix() -> filing_label.suffix() == "manual"
| method_field_projection_ok: adult.method_field_projection() -> adult.method_field_projection() == 1000
| method_only_product_ok: receipt.double() -> receipt.double() == 14
| method_only_product_label_ok: receipt.label() -> receipt.label() == "receipt:7"

? child_allowance_ok
? adult_allowance_ok
? sibling_ok
? direct_constructor_ok
? rule_returned_scope_member_ok
? bound_rule_returned_scope_member_ok
? final_call_only_ok
? projected_param_ok
? field_projection_ok
? rulescope_record_delegation_ok
? rulescope_delegated_projection_ok
? rulescope_delegated_record_projection_ok
? exception_ok
? call_only_string_ok
? global_collision_ok
? method_calls_rule_ok
? explicit_self_method_ok
? method_cross_product_ok
? method_adt_field_ok
? method_field_projection_ok
? method_only_product_ok
? method_only_product_label_ok
