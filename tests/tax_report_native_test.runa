@ sprog da
@ importer ../examples / danish - income - tax / aarsopgoerelse - afstemning.calculate

-- Fiktive, positivt oplyste rapportfakta; aldrig skabelonens standardværdier.
> nulrapport(år: Heltal, komplet: Boolsk, skat: Heltal?, nedslag: Heltal?, restskat: Boolsk) -> ÅrsopgørelseAfstemningsinput {
    ÅrsopgørelseAfstemningsinput(
        skatteår = år, kommune = København, betaler_kirkeskat = Falskt,
        ægtefællens_kommune = None, gift_samlevende_ved_årets_udløb = Some(Falskt),
        indkomstbro = Some(RapportIndkomstBro(personlig_indkomst_kroner = 0, kapitalindkomst_kroner = 0, ligningsmæssige_fradrag_kroner = 0, skattepligtig_indkomst_kroner = 0, øvrige_indkomstreguleringer_kroner = 0, oplyst_ægtefælleunderskud_kroner = Some(0))),
        ægtefællenedslag = RapportÆgtefællenedslag(statsligt_personfradrag_øre = nedslag, kommunalt_personfradrag_øre = nedslag, kirkeligt_personfradrag_øre = nedslag, kommunalt_og_kirkeligt_personfradrag_øre = None, negativ_kapitalindkomst_øre = nedslag, eget_negativ_kapitalindkomstnedslag_øre = nedslag),
        skat = RapportSkat(poster_uden_ægtefællenedslag = [], poster_uden_ægtefællenedslag_komplette = komplet, oplyst_beregnet_skat_øre = skat),
        betaling = RapportBetaling(oplyst_forskudsskat_øre = skat, oplyst_beregnet_skat_øre = skat, tillæg_til_slutskat = [], tillæg_til_slutskat_komplette = Sandt, oplyst_overskydende_skat_øre = hvis restskat { None } ellers { Some(0) }, korrektioner_til_udbetaling = [], korrektioner_komplette = Sandt, oplyst_udbetaling_kroner = hvis restskat { None } ellers { Some(0) }, restskat = hvis restskat { Some(RapportRestskat(oplyst_restskat_øre = Some(0))) } ellers { None })
    )
}

> delvis_ægtefællerapport(statsligt_nedslag: Heltal?, kommunalt_nedslag: Heltal?, samlet_nedslag: Heltal) -> ÅrsopgørelseAfstemningsinput {
    ÅrsopgørelseAfstemningsinput(
        skatteår = 2023, kommune = København, betaler_kirkeskat = Falskt,
        ægtefællens_kommune = None, gift_samlevende_ved_årets_udløb = None,
        indkomstbro = Some(RapportIndkomstBro(personlig_indkomst_kroner = 400000, kapitalindkomst_kroner = -10000, ligningsmæssige_fradrag_kroner = 45000, skattepligtig_indkomst_kroner = 333000, øvrige_indkomstreguleringer_kroner = 0, oplyst_ægtefælleunderskud_kroner = Some(12000))),
        ægtefællenedslag = RapportÆgtefællenedslag(statsligt_personfradrag_øre = statsligt_nedslag, kommunalt_personfradrag_øre = kommunalt_nedslag, kirkeligt_personfradrag_øre = Some(0), kommunalt_og_kirkeligt_personfradrag_øre = None, negativ_kapitalindkomst_øre = Some(80000), eget_negativ_kapitalindkomstnedslag_øre = Some(80000)),
        skat = RapportSkat(poster_uden_ægtefællenedslag = [RapportBeløb(navn = "Fiktiv øvrig skat", beløb_øre = 9820000 + samlet_nedslag)], poster_uden_ægtefællenedslag_komplette = Sandt, oplyst_beregnet_skat_øre = Some(9820000)),
        betaling = RapportBetaling(oplyst_forskudsskat_øre = Some(9900000), oplyst_beregnet_skat_øre = Some(9820000), tillæg_til_slutskat = [], tillæg_til_slutskat_komplette = Sandt, oplyst_overskydende_skat_øre = Some(80000), korrektioner_til_udbetaling = [RapportBeløb(navn = "Fiktiv oplyst godtgørelse", beløb_øre = 1234)], korrektioner_komplette = Sandt, oplyst_udbetaling_kroner = Some(812), restskat = None)
    )
}

> ægtefællerapport(statsligt_nedslag: Heltal) -> ÅrsopgørelseAfstemningsinput {
    delvis_ægtefællerapport(Some(statsligt_nedslag), Some(200000), 380000)
}

= fakta = [
    nulrapport(2026, Sandt, Some(0), Some(0), Falskt),
    nulrapport(2026, Falskt, Some(0), Some(0), Falskt),
    nulrapport(2026, Sandt, None, Some(0), Falskt),
    nulrapport(2026, Sandt, Some(0), None, Falskt),
    nulrapport(2026, Sandt, Some(1), Some(0), Falskt),
    nulrapport(2026, Sandt, Some(1), None, Falskt),
    nulrapport(2022, Sandt, Some(0), Some(0), Falskt),
    nulrapport(2027, Sandt, Some(0), Some(0), Falskt),
    nulrapport(2023, Sandt, Some(0), Some(0), Falskt),
    nulrapport(2024, Sandt, Some(0), Some(0), Falskt),
    nulrapport(2025, Sandt, Some(0), Some(0), Falskt),
    nulrapport(2026, Sandt, Some(0), Some(0), Sandt),
    nulrapport(2026, Sandt, Some(1), Some(0), Sandt),
    nulrapport(2026, Falskt, Some(0), Some(0), Sandt),
    ægtefællerapport(100000),
    ægtefællerapport(100001),
    delvis_ægtefællerapport(Some(100000), None, 179999),
    delvis_ægtefællerapport(Some(100000), None, 180000),
    delvis_ægtefællerapport(None, Some(200000), 858880),
    delvis_ægtefællerapport(None, Some(200000), 858881),
    delvis_ægtefællerapport(None, None, 380000)
]
= resultater = map(fakta, afstem_årsopgørelse)
= statusser = map(resultater, |r: ÅrsopgørelseAfstemningsresultat| r.status)
= forventede = [BetingetAfstemt, Ufuldstændig, Ufuldstændig, Ufuldstændig, Modstrid, Modstrid, IkkeUnderstøttetÅrEllerKommune, IkkeUnderstøttetÅrEllerKommune, BetingetAfstemt, BetingetAfstemt, BetingetAfstemt, BetingetAfstemt, Modstrid, Ufuldstændig, BetingetAfstemt, Modstrid, Modstrid, Ufuldstændig, Ufuldstændig, Modstrid, Ufuldstændig]
| korrekte_statusser: statusser -> statusser == forventede
| fortsat_betinget: resultater -> all(resultater, |r: ÅrsopgørelseAfstemningsresultat| r.uafhængig_skatteberegning_udført == Falskt && length(r.uafklaret) > 0)
? korrekte_statusser
? fortsat_betinget

-- Den samlede observation er kendt; de særskilte None-felter skal ikke
-- udløse manglende oplysninger, opdigtet fordeling eller dobbelt medregning.
= samlet_lokalt = RapportÆgtefællenedslag(statsligt_personfradrag_øre = Some(619716), kommunalt_personfradrag_øre = None, kirkeligt_personfradrag_øre = None, kommunalt_og_kirkeligt_personfradrag_øre = Some(1253880), negativ_kapitalindkomst_øre = Some(0), eget_negativ_kapitalindkomstnedslag_øre = Some(0))
= dobbelt_lokalt = RapportÆgtefællenedslag(statsligt_personfradrag_øre = Some(0), kommunalt_personfradrag_øre = Some(0), kirkeligt_personfradrag_øre = None, kommunalt_og_kirkeligt_personfradrag_øre = Some(0), negativ_kapitalindkomst_øre = Some(0), eget_negativ_kapitalindkomstnedslag_øre = Some(0))
| samlet_observation_tælles_en_gang: samlet_lokalt -> rapport_lokalt_nedslag_entydigt(samlet_lokalt) && rapport_samlet_ægtefællenedslag(samlet_lokalt) == Some(1873596) && length(rapport_lokale_nedslag_med_loft(samlet_lokalt, Some(1212600), Some(41280))) == 1
| dobbelt_observation_afvises_også_ved_nul: dobbelt_lokalt -> rapport_lokalt_nedslag_entydigt(dobbelt_lokalt) == Falskt
| modtagers_loft_kræver_ikke_ægtefællekommune: fakta -> rapport_kommunalt_personfradragsloft(head(fakta), 54100) == Some(1265399)
? samlet_observation_tælles_en_gang
? dobbelt_observation_afvises_også_ved_nul
? modtagers_loft_kræver_ikke_ægtefællekommune

-- KSL §§ 61–62: samme grundlag før begge betalingsspor og korrektioner.
> betaling_med_tillæg(tillæg: Heltal, komplette: Boolsk) -> RapportBetaling {
    RapportBetaling(oplyst_forskudsskat_øre = Some(9900000), oplyst_beregnet_skat_øre = Some(9820000), tillæg_til_slutskat = [RapportBeløb(navn = "Fiktivt overført beløb", beløb_øre = tillæg)], tillæg_til_slutskat_komplette = komplette, oplyst_overskydende_skat_øre = None, korrektioner_til_udbetaling = [RapportBeløb(navn = "Fiktiv godtgørelse", beløb_øre = 1234)], korrektioner_komplette = Sandt, oplyst_udbetaling_kroner = None, restskat = None)
}
= tillægsbetaling = betaling_med_tillæg(50000, Sandt)
= ukendte_tillæg = betaling_med_tillæg(50000, Falskt)
| tillæg_før_udbetaling: tillægsbetaling -> rapport_overskydende(tillægsbetaling) == Some(30000) && rapport_udbetaling(tillægsbetaling) == Some(312)
| ukendte_tillæg_tilbageholder_begge_spor: ukendte_tillæg -> rapport_overskydende(ukendte_tillæg) == None && rapport_restskat(ukendte_tillæg) == None && rapport_udbetaling(ukendte_tillæg) == None
= grænsetillæg = [79999, 80000, 80001]
| samme_balance_ved_en_øres_grænse: grænsetillæg -> all(grænsetillæg, |tillæg: Heltal| rapport_overskydende(betaling_med_tillæg(tillæg, Sandt)) == Some(80000 - tillæg) && rapport_restskat(betaling_med_tillæg(tillæg, Sandt)) == Some(tillæg - 80000))
? tillæg_før_udbetaling
? ukendte_tillæg_tilbageholder_begge_spor
? samme_balance_ved_en_øres_grænse
@ print(vis(resultater))
