| balance("bob", -5)
| surcharge(-1) -> 100
| surcharge(n) -> 0
| tags("ann", [1, 2])
| fraction(-1.5)
| labels(["law", "code"])
| matrix([[1, -2], [3]])
# Basket(items: List(Int))
| accepted(Basket([-1, 2]))
| sum_pair(Basket([left, right])) -> left + right
| sum_pair(other: Basket) -> 0
| empty_basket(Basket([]))

assert(balance("bob", -5))
assert(not(balance("bob", 7)))
assert(surcharge(-1) == 100)
assert(surcharge(5) == 0)
assert(tags("ann", [1, 2]))
assert(not(tags("ann", [9, 9, 9])))
assert(not(tags("ann", [1, 9])))
assert(fraction(-1.5))
assert(not(fraction(1.5)))
assert(findall(value, balance("bob", value)) == [-5])
assert(findall(value, tags("ann", value)) == [[1, 2]])
assert(labels(["law", "code"]))
assert(not(labels(["law", "wrong"])))
assert(matrix([[1, -2], [3]]))
assert(not(matrix([[1, -2], []])))
assert(accepted(Basket([-1, 2])))
assert(not(accepted(Basket([1, 2]))))
assert(not(accepted(Basket([-1]))))
assert(sum_pair(Basket([3, 4])) == 7)
assert(sum_pair(Basket([3])) == 0)
assert(empty_basket(Basket([])))
assert(not(empty_basket(Basket([1]))))
@ print("signed and list rule heads passed")
