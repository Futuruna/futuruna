-- Reviewer #14: and/comma bind within each independent or branch.
| person(1)
| edge(1, 2)
| wanted(2)
| alternate(1, 3)
| other(3)
| comma_form(x) -> person(x), edge(x, y), wanted(y)
| and_form(x) -> person(x) and edge(x, y) and wanted(y)
| either(x) -> person(x) and edge(x, y) and False or alternate(x, y) and other(y)

assert(comma_form(1))
assert(and_form(1))
assert(either(1))
assert(not(and_form(2)))
assert(findall(person, either(person)) == [1])
@ print("logic goal separators passed")
