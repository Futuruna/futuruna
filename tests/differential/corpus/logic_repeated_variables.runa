| edge("a", "b")
| edge("b", "c")
| same(x: Int, x: Int)
| has_self_loop() -> edge(n, n), True
| cyclic_edge("a", "b")
| cyclic_edge("b", "b")
| has_loop() -> cyclic_edge(n, n), True
| same_text(text: String, text: String)
| same_float(value: Float, value: Float)
# TextPair(left: String, right: String)
| same_fields(TextPair(text, text))
# Numbers(items: List(Int))
| same_elements(Numbers([item, item]))
| row("wrong", "a", "b")
| row("right", "b", "b")
# Color = Red | Blue
| same_color(left: Color, right: Color) -> left == right
> select_node() -> String { "missing" }
= selected_node = select_node()
| has_selected_node(selected_node: String) -> cyclic_edge(selected_node, node), True
| near_pair(0.0, 0.0000000000000001)
| near_pair(1.0, 2.0)
| lazy_row("bad", [1], [2])
| lazy_row("good", [3], [3])

assert(same(1, 1))
assert(not(same(1, 2)))
assert(not(has_self_loop()))
assert(length(findall(n, edge(n, n))) == 0)
assert(has_loop())
assert(findall(n, cyclic_edge(n, n)) == ["b"])
assert(same_text("law", "law"))
assert(not(same_text("law", "code")))
assert(same_float(0.0, 0.0000000000000001))
assert(not(same_float(0.0, 0.5)))
assert(same_fields(TextPair("law", "law")))
assert(not(same_fields(TextPair("law", "code"))))
assert(same_elements(Numbers([7, 7])))
assert(not(same_elements(Numbers([7, 8]))))
assert(not(same_elements(Numbers([7]))))
assert(findall(result, row(result, same_node, same_node)) == ["right"])
assert(findall(color, same_color(color, color)) == [Red, Blue])
assert(length(findall(n, cyclic_edge(selected_node, n))) == 0)
assert(not(has_selected_node(selected_node)))
assert(findall(value, near_pair(value, value)) == [0.0])
assert(findall(result, lazy_row(result, items, items)) == ["good"])
@ print("repeated logic variables passed")
