-- Reviewer #52: omitted parameter annotations do not turn Bool misses into strings.
| eligible(age) -> True under age >= 18
| exception adult exception_only(age) -> True under age >= 18
| declined(age) -> False under age >= 18
| named(name) -> True under name == "Ada"
# BooleanMissClaim(amount: Int)
| covered(claim) -> True under claim.amount > 0
= enabled = False
| configured(value: Int) -> True under enabled

@ print(show(eligible(10)))
@ print(show(eligible(20)))
@ print(if eligible(10) { "yes" } else { "no" })
@ print(show(eligible(10) == False))
@ print(show(not(eligible(10))))
@ print(show(eligible(10) && True))
@ print(show(exception_only(10)))
@ print(show(exception_only(20)))
@ print(show(declined(20)))
@ print(show(declined(10)))
@ print(show(named("Ada")))
@ print(show(named("Other")))
@ print(show(covered(BooleanMissClaim(1))))
@ print(show(covered(BooleanMissClaim(0))))
@ print(show(configured(1)))
