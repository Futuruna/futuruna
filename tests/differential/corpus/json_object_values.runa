@ print(json_object([["k\"ey", "1"]]))
@ print(json_object([["note", "line1\nline2"]]))
@ print(json_object([["title", "[draft] Lov om skat"]]))
@ print(json_object([["quote", "\"Loven\" gælder"]]))
@ print(json_object([["amount", "NaN"]]))
@ print(json_object([["amount", "inf"]]))
@ print(json_object([["amount", "+5"]]))
@ print(json_object([["amount", ".5"]]))
@ print(json_object([["tab", "a\tb"]]))
@ print(json_object([["slash\\key", "a\\b\nnext"]]))
@ print(json_object([["city", "\"Copenhagen\""], ["temp", "22"]]))
@ print(json_object([["nested", "{\"active\":true}"], ["items", "[1,2]"], ["empty", "null"]]))
@ print(json_object([["literal", "\"true\""], ["flag", "true"], ["identifier", "\"12345\""]]))
@ print(json_object([["number", " 1.5e2 "], ["unquoted", "ordinary text"]]))
@ print(json_object([["key", "1"], ["key", "2"]]))
