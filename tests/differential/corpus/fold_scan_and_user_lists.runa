-- Untyped reduce/scan lambdas, sort_by with an untyped key, and a folded
-- user-declared Cons list compile and match the interpreter.
# List(a) = Nil | Cons(a, List(a))
> all_items() -> List(Int) { Cons(3, Cons(1, Cons(2, Nil))) }
> total(xs: List(Int)) -> Int {
    match xs {
        | Nil -> 0
        | Cons(h, t) -> h + total(t)
    }
}
= items = all_items()
@ print(show(total(items)))
@ print(show(items))
= peak = reduce(from_list([3, 9, 4]), 0, |mx, x| if x > mx { x } else { mx })
@ print(show(peak))
~ running = from_list([3, 9, 4]) |> scan(0, |mx, x| if x > mx { x } else { mx })
@ print(show(running))
@ print(show(sort_by([100, 9, 10], |x| x)))
