| parent("alice", "bob")
| parent("bob", "charlie")
| parent("alice", "diana")
| ancestor(a, b) -> parent(a, b)
| ancestor(a, b) -> parent(a, mid), ancestor(mid, b)
assert(findall(c, ancestor("alice", c)) == ["bob", "diana", "charlie"])
assert(ancestor("alice", "charlie"))
assert(not(ancestor("charlie", "alice")))
@ print("recursive query passed")
