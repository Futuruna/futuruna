# Item(left: String, right: String)
= pairs = [("a", "b"), ("a", "b"), ("a", "c"), ("a, b", "c"), ("a", "b, c")]
@ print(show(distinct([3, 1, 3, 2, 1])))
@ print(show(length(distinct(pairs))))
@ print(show(length(distinct([[1, 2], [1, 2], [2, 1]]))))
@ print(show(length(distinct([Some(1), None, Some(1), None, Some(2)]))))
@ print(show(length(distinct([Item("a", "b"), Item("a", "b"), Item("a", "c")]))))
@ print(show(length(distinct([0.0, -0.0, 1.0, 1.0]))))
= expected = refof(Item::left)
@ print(show(all([1, 2], |n: Int| {
        = reference = refof(Item::left)
        reference == expected && pathof(Item::right) == "right" && n > 0
    })))
