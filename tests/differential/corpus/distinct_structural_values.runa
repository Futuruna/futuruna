# Line(document: String, line: String)
# Reference = Document(String) | Import(String)

= ids = [("document", "line"), ("document", "line"), ("other", "line"), ("a, b", "c"), ("a", "b, c")]
= unique = distinct(ids)
@ print(show(length(unique)))
@ print(show(unique == [("document", "line"), ("other", "line"), ("a, b", "c"), ("a", "b, c")]))
@ print(show(distinct([Line("a, line: b", "c"), Line("a", "b, line: c"), Line("a, line: b", "c")]) == [Line("a, line: b", "c"), Line("a", "b, line: c")]))
@ print(show(distinct([["a, b", "c"], ["a", "b, c"], ["a, b", "c"]]) == [["a, b", "c"], ["a", "b, c"]]))
@ print(show(distinct([Document("same"), Import("same"), Document("same")]) == [Document("same"), Import("same")]))
@ print(show(distinct([Some(("d", "l")), None, Some(("d", "l")), None]) == [Some(("d", "l")), None]))
@ print(show(distinct(["æ\\\"{1}", "æ\\\"{1}", "æ{1}"]) == ["æ\\\"{1}", "æ{1}"]))
@ print(show(distinct([3, 1, 3, 2, 1]) == [3, 1, 2]))
@ print(show(distinct([True, False, True]) == [True, False]))
@ print(show(distinct([0.0, -0.0, 1.5, 0.0]) == [0.0, 1.5]))
@ print(show(distinct([1.5, 2.5, 1.5]) == [1.5, 2.5]))
@ print(show(length(distinct(filter(ids, |id| False))) == 0))
@ print(show(length(ids)))
@ print(show(("document", "line") == ("document", "line")))
@ print(show(("a, b", "c") == ("a", "b, c")))
