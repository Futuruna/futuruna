-- expect-stdout: 2

| amount(value: Int) -> value + 1000
> module First {
    | amount(value: Int) -> value + 10
    | amounts(value: Int) -> [value, value + 1]
}
> module Second {
    | amount(value: Int) -> value + 20
}

@ print(show(First.amount(2)))
@ print(show(Second.amount(2)))
@ print(show(amount(2)))
@ print(show(length(First.amounts(2))))
