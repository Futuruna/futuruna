-- Clause reachability: unreachable clauses and overlapping guards.

| status(x: Int): String -> "mortal"
| status(x) -> "immortal" under x > 0
| status(x) -> "god" under x > 0

| band(x: Int): Int -> 0
| band(x) -> 70 under x > 7
| band(x) -> 80 under x > 8

| rate(x: Int): Int -> 1
| rate(x) -> 2 under x > 10
| rate(x) -> 3 under x < 20

| never(x: Int): Int -> 1
| never(x) -> 2 under x > 5 && x < 3

-- Guards over RuleScope fields that call another pure rule.
| limit(kind: Int): Int -> 100
| limit(kind) -> 500 under kind > 1

# Claim(amount: Int, kind: Int) {
    | payout(): Int -> 0
    | payout() -> amount under amount < limit(kind)
    | payout() -> 1 under amount < limit(kind) && amount > 0
}
