-- Imported rules for clause_gaps_import.calculate.runa.

-- Reached by the calculation: nothing covers a share income of 0.
# ShareTax(own_ore: Int) {
    | tax_ore() -> own_ore / 4 under own_ore > 0
    | exception negative_share_income tax_ore() -> own_ore / 4 under own_ore < 0
}

-- Not reached by the calculation, so not in its audit scope.
| unused_sign(x: Int) -> 1 under x > 0
| unused_sign(x: Int) -> -1 under x < 0
