-- Clause reachability: every clause can fire and no tier is ambiguous.

| bracket(x: Int) -> 0
| bracket(x: Int) -> 10 under x > 100 && x <= 200
| bracket(x: Int) -> 20 under x > 200

-- A narrower guard before a broader one is ordinary first-match refinement.
| fee(x: Int) -> 0
| fee(x: Int) -> 5 under x > 1000
| fee(x: Int) -> 2 under x > 0

-- A specific head pattern before a general one.
# Status = Single | Married
| allowance(Single) -> 100
| allowance(s: Status) -> 200

-- A repeated head variable requires equal arguments.
| pairing(a: Int, b: Int) -> "differ"
| pairing(a: Int, a: Int) -> "same" under a >= 0
| pairing(a: Int, b: Int) -> "other" under a >= 0

-- A Boolean clause with body `false` only marks the matched head.
| adult(age: Int) -> false
| adult(age: Int) -> true under age >= 18

-- RuleScope fields and a call to another pure rule.
| cap(x: Int) -> 1000
| cap(x: Int) -> 2000 under x > 1

# Case(income: Int) {
    | tier() -> "none"
    | tier() -> "low" under income > 0 && income <= cap(100)
    | tier() -> "high" under income > cap(100)
}
