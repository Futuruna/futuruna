@ import ./fields

# DuplicateImportedInput(amount: Int)
# DuplicateImportedResult(amount: Int)

= local_amount_field = CalculationField(
    path = "amount",
    label = "Local amount",
    question = None,
    help = None,
    unit = None
)
--@label:calculate_imported_fields::meta:local_amount_field--

@ calculate
| calculate_imported_fields(input: DuplicateImportedInput) -> DuplicateImportedResult(
    amount = input.amount
)
