-- A model in the retired comment-directive syntax. The test migrates a copy
-- with `runa fmt --migrate` and compares results and contract hash with the
-- ones this file had before (expected.json).
@ import ./domain_meta

= assumption_whole_kroner = AssumptionInfo(id = "WHOLE-KRONER", statement = "Amounts are whole kroner.")
= tax_meta = Metadata(
    attachments = (
        Source(value = law),
        Assumption(value = assumption_whole_kroner),
    )
)

--@label:tax::meta:tax_meta--
----
[sources/law.txt]

§ 1. Skatten er 10 pct. af grundlaget.

§ 2. Grundlaget er indkomsten med fradrag.

Stk. 2. Fradraget er højst 1000 kr.
----

--@begin:tax--
--@cite:§ 2; § 2, stk. 2--
| base(i: Input) -> i.income - min_int(i.deduction, 1000)
--@cite:§ 1--
| tax(i: Input) -> base(i) / 10
--@end:tax--

@ entry("Tax")
| calculate(i: Input) -> Result(tax = tax(i), base = base(i))
