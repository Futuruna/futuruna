# Shape = Circle | Triangle | Square
# ShapeWarning(message: String)
# CorpusRole(a) = Source(value: a) | Warning(value: a)
# impl MetaRole for CorpusRole {}
# impl Meta for CorpusRole {}

= square_source = Square
= shape_warning = ShapeWarning(message = "Review this shape")

----
Square source
----

@ meta(Source(value = square_source))
@ meta(Warning(value = shape_warning))
| square_rule(shape: Shape) -> shape == Square
