-- A fee on a transfer of more than 2^53 − 1 øre: no integrator can send that
-- amount, since the SDK holds an Int exactly only up to there.

# SourceInfo(file: String)
# impl Document for SourceInfo {}
= law = SourceInfo(file = "sources/law.txt")

# Transfer(amount: Int)

@ section transfer {

@ quote(law)
----
§ 15. Af en overførsel over 9.007.199.254.740.991 øre betales et gebyr på 1 øre.
----

@ cite(§ 15)
| fee(amount: Int): Int -> 0
@ cite(§ 15)
| exception huge fee(amount) -> 1 under amount > 9007199254740991

}

@ entry
> transfer_fee(t: Transfer) -> Int {
    fee(t.amount)
}
