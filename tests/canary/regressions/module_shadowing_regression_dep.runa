-- Dependency fixture for regression canary around imported top-level bindings,
-- computed exports, and free-function visibility.
-- roundtrip-skip: dependency-only module fixture

@ export
= region_names = ["north", "west", "vip"]

@ export
= base_targets = [6, 3, 8]

@ export
= extra_boost = 2

@ export
= plan_threshold = length(region_names) * 6 + extra_boost

@ export
> lane_label(i: Int) -> String {
    region_names[i] + ":" + show(base_targets[i] + extra_boost)
}
