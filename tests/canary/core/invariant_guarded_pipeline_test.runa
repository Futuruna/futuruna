-- Authored core canary: ordinary data pipeline guarded by runtime invariants
-- over its derived verdict semantics.

# Verdict = Queue(Int) | Review(Int) | Freeze(Int)

> verdict_label(v: Verdict) -> String {
    match v {
        | Queue(score) -> "queue"
        | Review(score) -> "review"
        | Freeze(score) -> "freeze"
    }
}

> verdict_points(v: Verdict) -> Int {
    match v {
        | Queue(score) -> score
        | Review(score) -> score
        | Freeze(score) -> 100
    }
}

> review_slots(v: Verdict) -> Int {
    match v {
        | Queue(score) -> 0
        | Review(score) -> 1
        | Freeze(score) -> 2
    }
}

= base_scores = [18, 42, 37, 41]
= adjustments = [5, -3, 10, 7]
= blended = map(zip(base_scores, adjustments), |p| fst(p) + snd(p))
= high_risk = filter(blended, |score| score >= 40)
= review_batches = chunked(high_risk, 2)
= batch_labels = map(enumerate(review_batches), |entry| {
        "slot-" + show(fst(entry) + 1) + ":" + join(map(snd(entry), |n| show(n)), "+")
    })
= escalation_score = foldl(high_risk, 0, |acc, score| acc + score)
= audit_bonus = 12
= raw_priority = escalation_score + audit_bonus
= verdict = Freeze(raw_priority)
= runtime_points = verdict_points(verdict)
= runtime_slots = review_slots(verdict)
= status = verdict_label(verdict)

| blended_ok: blended -> show(blended) == "[23, 39, 47, 48]"
? blended_ok

| high_risk_ok: high_risk -> show(high_risk) == "[47, 48]"
? high_risk_ok

| batches_ok: review_batches -> show(review_batches) == "[[47, 48]]"
? batches_ok

| batch_labels_ok: batch_labels -> show(batch_labels) == "[slot-1:47+48]"
? batch_labels_ok

| status_ok: status -> status == "freeze"
? status_ok

| runtime_points_ok: runtime_points -> runtime_points == 100
? runtime_points_ok

| runtime_slots_ok: runtime_slots -> runtime_slots == 2
? runtime_slots_ok

@ print("canary invariant guarded pipeline passed")
