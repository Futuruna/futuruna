-- std.runa: Futuruna Standard Library
-- The prelude (auto-imported) is embedded in runa.rs. This file provides
-- additional library functions that can be imported with @ import ./std

-- ============================================================================
-- Prelude Summary (auto-imported, no @ import needed)
-- ============================================================================
-- Types:  Option(a), Result(a, e), Pair(a, b)
-- Option: unwrap_or, is_some, is_none
-- Math:   max_int, min_int, clamp
-- Core:   identity
--
-- Note: # Chain(a) is NOT in the prelude. Programs that want an End/Link
-- linked list define it themselves. Programs using List(Int) in type annotations
-- get Vec<i64> (the default mapping).
-- ============================================================================

-- ============================================================================
-- Chain Functions (require user-defined # Chain(a) = End | Link(a, Chain(a)))
-- ============================================================================

# Chain(a) = End | Link(a, Chain(a))

> sum(xs: Chain(Int)) -> Int {
    match xs {
        | End -> 0
        | Link(h, t) -> h + sum(t)
    }
}

> filter_list(xs: Chain(a), pred: a -> Bool) -> Chain(a) {
    match xs {
        | End -> End
        | Link(h, t) -> if pred(h) { Link(h, filter_list(t, pred)) } else { filter_list(t, pred) }
    }
}

> foldl_list(xs: Chain(a), acc: b, f: (b, a) -> b) -> b {
    match xs {
        | End -> acc
        | Link(h, t) -> foldl_list(t, f(acc, h), f)
    }
}

> foldr_list(xs: Chain(a), init: b, f: (a, b) -> b) -> b {
    match xs {
        | End -> init
        | Link(h, t) -> f(h, foldr_list(t, init, f))
    }
}

> reverse_list(xs: Chain(a)) -> Chain(a) {
    reverse_acc(xs, End)
}

> reverse_acc(xs: Chain(a), acc: Chain(a)) -> Chain(a) {
    match xs {
        | End -> acc
        | Link(h, t) -> reverse_acc(t, Link(h, acc))
    }
}

> append(xs: Chain(a), ys: Chain(a)) -> Chain(a) {
    match xs {
        | End -> ys
        | Link(h, t) -> Link(h, append(t, ys))
    }
}

> take_list(n: Int, xs: Chain(a)) -> Chain(a) {
    if n <= 0 { End } else {
        match xs {
            | End -> End
            | Link(h, t) -> Link(h, take_list(n - 1, t))
        }
    }
}

> drop_list(n: Int, xs: Chain(a)) -> Chain(a) {
    if n <= 0 { xs } else {
        match xs {
            | End -> End
            | Link(_, t) -> drop_list(n - 1, t)
        }
    }
}

> zip_with(xs: Chain(a), ys: Chain(b), f: (a, b) -> c) -> Chain(c) {
    match xs {
        | End -> End
        | Link(x, xt) -> match ys {
            | End -> End
            | Link(y, yt) -> Link(f(x, y), zip_with(xt, yt, f))
        }
    }
}

-- ============================================================================
-- Composition (beyond prelude)
-- ============================================================================

> compose(f: a -> b, g: b -> c) -> (a -> c) {
    |x| g(f(x))
}

> flip(f: (a, b) -> c) -> ((b, a) -> c) {
    |b, a| f(a, b)
}

-- ============================================================================
-- String
-- ============================================================================

> repeat_string(s: String, n: Int) -> String {
    if n <= 0 { "" } else { s + repeat_string(s, n - 1) }
}

> join(xs: Chain(String), sep: String) -> String {
    match xs {
        | End -> ""
        | Link(h, t) -> match t {
            | End -> h
            | _ -> h + sep + join(t, sep)
        }
    }
}

-- ============================================================================
-- Tests (only run when this file is executed directly)
-- ============================================================================

@ print("=== Futuruna Standard Library Tests ===")
@ print("")

-- List operations
= nums = Link(1, Link(2, Link(3, Link(4, Link(5, End)))))
@ print("sum: " + show(sum(nums)))

= total = foldl_list(nums, 0, |acc, x| acc + x)
@ print("foldl +: " + show(total))

= rev = reverse_list(nums)
@ print("reverse sum: " + show(sum(rev)))

= combined = append(nums, nums)
@ print("append sum: " + show(sum(combined)))

= first3 = take_list(3, nums)
@ print("take 3 sum: " + show(sum(first3)))

= last2 = drop_list(3, nums)
@ print("drop 3 sum: " + show(sum(last2)))

-- Prelude functions (auto-imported)
= x = Some(42)
= empty = None
@ print("unwrap_or: " + show(unwrap_or(x, 0)))
@ print("is_some: " + show(is_some(x)))
@ print("is_none: " + show(is_none(empty)))
@ print("max(3,7): " + show(max_int(3, 7)))
@ print("min(3,7): " + show(min_int(3, 7)))
@ print("clamp(10,0,5): " + show(clamp(10, 0, 5)))
@ print("identity(42): " + show(identity(42)))

@ print("")
@ print("=== All stdlib tests passed! ===")
