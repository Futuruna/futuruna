-- inventory.runa — Warehouse Inventory Management System
--
-- A production-ready inventory tracker with SQLite persistence, actor-based
-- stock management, stream analytics for demand forecasting, Catala-style
-- reorder rules, and full verification. All seven runes. Runs to completion.
--
-- Run:   runa run project-examples/inventory/inventory.runa
-- Build: runa build project-examples/inventory/inventory.runa
-- Check: runa check project-examples/inventory/inventory.runa


-- ============================================================================
-- # TYPES — Domain model
-- ============================================================================

# Category = Electronics | Food | Tools | Clothing | Chemicals
# StockStatus = InStock | LowStock | OutOfStock | Overstock
# OrderType = Purchase | Sale | Return | Adjustment
# Priority = Urgent | Normal | Low

# Product(id: Int, name: String, category: Category, price_kr: Int, quantity: Int, reorder_point: Int, max_stock: Int)
# Order(product_id: Int, order_type: OrderType, amount: Int, note: String)


-- ============================================================================
-- > FUNCTIONS — Core logic
-- ============================================================================

> category_label(c: Category) -> String {
    match c {
        | Electronics -> "electronics"
        | Food -> "food"
        | Tools -> "tools"
        | Clothing -> "clothing"
        | Chemicals -> "chemicals"
    }
}

> order_label(o: OrderType) -> String {
    match o {
        | Purchase -> "PURCHASE"
        | Sale -> "SALE"
        | Return -> "RETURN"
        | Adjustment -> "ADJUST"
    }
}

> stock_status(quantity: Int, reorder_point: Int, max_stock: Int) -> StockStatus {
    if quantity == 0 { OutOfStock }
    else if quantity <= reorder_point { LowStock }
    else if quantity > max_stock { Overstock }
    else { InStock }
}

> status_label(s: StockStatus) -> String {
    match s {
        | InStock -> "IN_STOCK"
        | LowStock -> "LOW_STOCK"
        | OutOfStock -> "OUT_OF_STOCK"
        | Overstock -> "OVERSTOCK"
    }
}

> priority_label(p: Priority) -> String {
    match p {
        | Urgent -> "URGENT"
        | Normal -> "NORMAL"
        | Low -> "LOW"
    }
}

> reorder_priority(quantity: Int, reorder_point: Int) -> Priority {
    if quantity == 0 { Urgent }
    else if quantity <= reorder_point / 2 { Urgent }
    else if quantity <= reorder_point { Normal }
    else { Low }
}

> reorder_qty(current: Int, max_stock: Int) -> Int {
    = needed = max_stock - current
    if needed > 0 { needed } else { 0 }
}

> format_product(p: Product) -> String {
    "[" + show(p.id) + "] " + p.name + " (" + category_label(p.category) + ") qty=" + show(p.quantity) + " @ " + show(p.price_kr) + " kr"
}

-- SQL helpers
> sql_insert_product(p: Product) -> String {
    "INSERT INTO products VALUES (" + show(p.id) + ", '" + p.name + "', '" + category_label(p.category) + "', " + show(p.price_kr) + ", " + show(p.quantity) + ", " + show(p.reorder_point) + ", " + show(p.max_stock) + ")"
}


-- ============================================================================
-- | RULES — Catala-style business rules (single-param for clean codegen)
-- ============================================================================

-- Reorder trigger: should we auto-reorder?
| should_auto_reorder(product) -> False
| exception low_stock_reorder should_auto_reorder(product) -> True under product.quantity <= product.reorder_point
| exception out_of_stock_reorder should_auto_reorder(product) -> True under product.quantity == 0

-- Hazardous material handling
| needs_special_handling(product) -> False
| exception chemical_handling needs_special_handling(product) -> True under product.category == Chemicals

-- Priority escalation
| needs_escalation(product) -> False
| exception critical_stock needs_escalation(product) -> True under product.quantity == 0
| exception chemicals_low needs_escalation(product) -> True under product.category == Chemicals && product.quantity <= product.reorder_point

-- Shelf life concern (food at high stock)
| shelf_life_risk(product) -> False
| exception food_overstock shelf_life_risk(product) -> True under product.category == Food && product.quantity > product.max_stock


-- ============================================================================
-- = BINDINGS — Test data
-- ============================================================================

= products = [
    Product(1, "Laptop", Electronics, 8999, 45, 10, 100),
    Product(2, "USB Cable", Electronics, 79, 250, 50, 500),
    Product(3, "Organic Milk", Food, 15, 8, 20, 100),
    Product(4, "Power Drill", Tools, 1299, 30, 5, 50),
    Product(5, "Winter Jacket", Clothing, 599, 3, 10, 40),
    Product(6, "Cleaning Solvent", Chemicals, 89, 60, 15, 200),
    Product(7, "Headphones", Electronics, 349, 0, 10, 80),
    Product(8, "Bread", Food, 25, 150, 30, 300),
    Product(9, "Screwdriver Set", Tools, 199, 12, 8, 60),
    Product(10, "Lab Gloves", Chemicals, 45, 500, 100, 1000),
]


-- ============================================================================
-- | INVARIANTS
-- ============================================================================

-- Stock status logic
| out_at_zero: stock_status(0, 10, 100) -> stock_status(0, 10, 100) == OutOfStock
| low_at_point: stock_status(10, 10, 100) -> stock_status(10, 10, 100) == LowStock
| in_stock_normal: stock_status(50, 10, 100) -> stock_status(50, 10, 100) == InStock
| over_at_max: stock_status(150, 10, 100) -> stock_status(150, 10, 100) == Overstock

-- Reorder priority
| urgent_at_zero: reorder_priority(0, 10) -> reorder_priority(0, 10) == Urgent
| urgent_at_half: reorder_priority(4, 10) -> reorder_priority(4, 10) == Urgent
| normal_at_point: reorder_priority(10, 10) -> reorder_priority(10, 10) == Normal
| low_above_point: reorder_priority(50, 10) -> reorder_priority(50, 10) == Low

-- Rule tests
= test_elec = Product(99, "Test", Electronics, 10, 50, 10, 100)
= test_chem = Product(98, "Acid", Chemicals, 50, 5, 10, 50)
= test_out = Product(97, "Gone", Tools, 20, 0, 5, 30)
= test_food_over = Product(96, "Milk", Food, 10, 200, 20, 100)

| chem_needs_handling: needs_special_handling(test_chem) -> needs_special_handling(test_chem) == True
| elec_no_handling: needs_special_handling(test_elec) -> needs_special_handling(test_elec) == False
| out_needs_reorder: should_auto_reorder(test_out) -> should_auto_reorder(test_out) == True
| stocked_no_reorder: should_auto_reorder(test_elec) -> should_auto_reorder(test_elec) == False
| out_needs_escalation: needs_escalation(test_out) -> needs_escalation(test_out) == True
| chem_low_escalates: needs_escalation(test_chem) -> needs_escalation(test_chem) == True
| food_over_shelf_risk: shelf_life_risk(test_food_over) -> shelf_life_risk(test_food_over) == True
| elec_no_shelf_risk: shelf_life_risk(test_elec) -> shelf_life_risk(test_elec) == False


-- ============================================================================
-- ? VERIFY
-- ============================================================================

@ print("=== Warehouse Inventory System ===")
@ print("")
@ print("  Verifying business rules:")

? out_at_zero -> { @ print("    out of stock at 0:    OK") }
? low_at_point -> { @ print("    low stock at point:   OK") }
? in_stock_normal -> { @ print("    in stock normal:      OK") }
? over_at_max -> { @ print("    overstock detected:   OK") }
? urgent_at_zero -> { @ print("    urgent at 0:          OK") }
? urgent_at_half -> { @ print("    urgent at half:       OK") }
? normal_at_point -> { @ print("    normal at point:      OK") }
? low_above_point -> { @ print("    low above point:      OK") }
? chem_needs_handling -> { @ print("    chemical handling:    OK") }
? elec_no_handling -> { @ print("    electronics clear:    OK") }
? out_needs_reorder -> { @ print("    out-of-stock reorder: OK") }
? stocked_no_reorder -> { @ print("    stocked no reorder:   OK") }
? out_needs_escalation -> { @ print("    out-stock escalation: OK") }
? chem_low_escalates -> { @ print("    chem low escalates:   OK") }
? food_over_shelf_risk -> { @ print("    food overstock risk:  OK") }
? elec_no_shelf_risk -> { @ print("    electronics no risk:  OK") }

@ print("  16/16 invariants verified.")


-- ============================================================================
-- > ACTORS — Counters
-- ============================================================================

> actor order_counter(n: Int) {
    | NewOrder -> n + 1
    | ResetOrders -> 0
}

> actor reorder_counter(n: Int) {
    | NeedReorder -> n + 1
    | ResetReorders -> 0
}

> actor denied_counter(n: Int) {
    | Denied -> n + 1
    | ResetDenied -> 0
}

= ord_actor = spawn(order_counter, 0)
= reord_actor = spawn(reorder_counter, 0)
= deny_actor = spawn(denied_counter, 0)


-- ============================================================================
-- @ DATABASE — Persistence
-- ============================================================================

@ print("")
@ print("--- Database Setup ---")

= db = db_open(":memory:")

@ db_exec(db, "CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, category TEXT, price INTEGER, quantity INTEGER, reorder_point INTEGER, max_stock INTEGER)")
@ db_exec(db, "CREATE TABLE stock_events (id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER, delta INTEGER, reason TEXT)")
@ db_exec(db, "CREATE TABLE orders (id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER, order_type TEXT, amount INTEGER, status TEXT)")

for p in products {
    @ db_exec(db, sql_insert_product(p))
}

@ print("  3 tables created, 10 products seeded.")


-- ============================================================================
-- ~ STREAMS — Inventory analytics
-- ============================================================================

@ print("")
@ print("--- Product Catalog ---")

for p in products {
    = ss = stock_status(p.quantity, p.reorder_point, p.max_stock)
    @ print("  " + format_product(p) + " [" + status_label(ss) + "]")
}

-- Stream analytics on quantities
~ qty_stream = from_list(map(products, |p| p.quantity))
~ price_stream = from_list(map(products, |p| p.price_kr))
~ cumulative_qty = qty_stream |> scan(0, |acc, x| acc + x)

@ print("")
@ print("--- Cumulative Stock ---")
~ cumulative_qty | total -> {
    @ print("  " + show(total) + " units")
}

-- Value distribution
= all_prices = map(products, |p| p.price_kr)
= premium_count = count_by(all_prices, |p| p > 500)
= budget_count = count_by(all_prices, |p| p <= 100)
= total_value = foldl(products, 0, |acc, p| acc + p.price_kr * p.quantity)

@ print("")
@ print("  Premium products (>500 kr): " + show(premium_count))
@ print("  Budget products (<=100 kr): " + show(budget_count))
@ print("  Total inventory value: " + show(total_value) + " kr")


-- ============================================================================
-- APPLY RULES — Check each product against business rules
-- ============================================================================

@ print("")
@ print("--- Rule Engine ---")

for p in products {
    = reorder = should_auto_reorder(p)
    = handling = needs_special_handling(p)
    = escalate = needs_escalation(p)
    = shelf = shelf_life_risk(p)

    if reorder {
        = needed = reorder_qty(p.quantity, p.max_stock)
        = prio = reorder_priority(p.quantity, p.reorder_point)
        @ print("  REORDER: " + p.name + " need=" + show(needed) + " [" + priority_label(prio) + "]")
        reord_actor <- NeedReorder
    }
    if handling {
        @ print("  HAZMAT:  " + p.name + " requires special handling")
    }
    if escalate {
        @ print("  ESCALATE: " + p.name + " needs management attention")
    }
    if shelf {
        @ print("  SHELF RISK: " + p.name + " food overstock, check expiry")
    }
}


-- ============================================================================
-- SIMULATE ORDERS — Process a day of transactions
-- ============================================================================

@ print("")
@ print("--- Processing Orders ---")

~ order_log = subject()

-- Build a qty map from products for in-memory tracking
= qty_map = map_new()
for p in products {
    = qty_map = map_insert(qty_map, show(p.id), p.quantity)
}

= orders = [
    Order(1, Sale, 5, "customer order A100"),
    Order(2, Sale, 30, "bulk cable order"),
    Order(3, Purchase, 80, "restock organic milk"),
    Order(5, Sale, 1, "winter jacket sold"),
    Order(7, Purchase, 50, "headphone restock"),
    Order(8, Sale, 20, "bakery weekly order"),
    Order(4, Return, 2, "defective drill return"),
    Order(10, Sale, 50, "lab supply order"),
    Order(6, Sale, 10, "cleaning contract"),
    Order(9, Purchase, 30, "screwdriver restock"),
    Order(1, Sale, 3, "customer order A101"),
    Order(2, Sale, 100, "warehouse transfer"),
]

-- Name lookup
= name_map = map_new()
for p in products {
    = name_map = map_insert(name_map, show(p.id), p.name)
}

for o in orders {
    = key = show(o.product_id)
    = current_qty = map_get_or(qty_map, key, 0)
    = pname = map_get_or(name_map, key, "unknown")

    = delta = match o.order_type {
        | Sale -> 0 - o.amount
        | Purchase -> o.amount
        | Return -> o.amount
        | Adjustment -> o.amount
    }

    = new_qty = current_qty + delta

    if new_qty >= 0 {
        = qty_map = map_insert(qty_map, key, new_qty)
        @ db_exec(db, "INSERT INTO stock_events (product_id, delta, reason) VALUES (" + show(o.product_id) + ", " + show(delta) + ", '" + o.note + "')")
        @ db_exec(db, "INSERT INTO orders (product_id, order_type, amount, status) VALUES (" + show(o.product_id) + ", '" + order_label(o.order_type) + "', " + show(o.amount) + ", 'OK')")
        @ db_exec(db, "UPDATE products SET quantity = " + show(new_qty) + " WHERE id = " + show(o.product_id))
        ord_actor <- NewOrder
        order_log <- order_label(o.order_type) + " " + pname + " x" + show(o.amount) + " -> qty=" + show(new_qty)
    } else {
        @ db_exec(db, "INSERT INTO orders (product_id, order_type, amount, status) VALUES (" + show(o.product_id) + ", '" + order_label(o.order_type) + "', " + show(o.amount) + ", 'DENIED')")
        deny_actor <- Denied
        order_log <- "DENIED " + pname + " x" + show(o.amount) + " (insufficient stock)"
    }
}

~ order_log | msg -> {
    @ print("  " + msg)
}


-- ============================================================================
-- ~ STREAM ANALYTICS — Order patterns
-- ============================================================================

@ print("")
@ print("--- Order Analytics ---")

= order_amounts = map(orders, |o| o.amount)
~ amount_stream = from_list(order_amounts)
~ cumulative_sold = amount_stream |> scan(0, |acc, x| acc + x)

@ print("")
@ print("  Cumulative order volume:")
~ cumulative_sold | total -> {
    @ print("    " + show(total) + " units")
}

-- Pairwise deltas
~ amount_pairs = amount_stream |> pairwise
~ deltas = amount_pairs |> map(|p| snd(p) - fst(p))

@ print("")
@ print("  Order size deltas:")
~ deltas | d -> {
    = label = if d > 0 { "+" + show(d) } else { show(d) }
    @ print("    " + label)
}

= total_ordered = sum_list(order_amounts)
= avg_order = total_ordered / length(orders)
= large_orders = count_by(order_amounts, |a| a >= 30)

@ print("")
@ print("  Total ordered: " + show(total_ordered) + " units")
@ print("  Avg order size: " + show(avg_order))
@ print("  Large orders (>=30): " + show(large_orders))


-- ============================================================================
-- | SCOPE — Dashboard
-- ============================================================================

@ print("")
@ print("--- Dashboard ---")

| scope Dashboard {
    = total_products = db_query_row(db, "SELECT COUNT(*) FROM products")
    = total_orders = db_query_row(db, "SELECT COUNT(*) FROM orders")
    = completed = db_query_row(db, "SELECT COUNT(*) FROM orders WHERE status = 'OK'")
    = denied_count = db_query_row(db, "SELECT COUNT(*) FROM orders WHERE status = 'DENIED'")
    = total_units = db_query_row(db, "SELECT COALESCE(SUM(quantity), 0) FROM products")
    = low_stock = db_query_row(db, "SELECT COUNT(*) FROM products WHERE quantity <= reorder_point")
    = out_of_stock = db_query_row(db, "SELECT COUNT(*) FROM products WHERE quantity = 0")
    = events = db_query_row(db, "SELECT COUNT(*) FROM stock_events")

    @ print("")
    @ print("  Products:     " + show(total_products))
    @ print("  Total units:  " + show(total_units))
    @ print("  Orders:       " + show(total_orders) + " (" + show(completed) + " ok, " + show(denied_count) + " denied)")
    @ print("  Stock events: " + show(events))
    @ print("  Low stock:    " + show(low_stock))
    @ print("  Out of stock: " + show(out_of_stock))
}


-- ============================================================================
-- | SCOPE — Post-Order Reorder Check
-- ============================================================================

@ print("")
@ print("--- Post-Order Reorder Report ---")

| scope ReorderCheck {
    = reorder_list = db_query(db, "SELECT name, quantity, reorder_point, max_stock FROM products WHERE quantity <= reorder_point ORDER BY quantity ASC")

    for row in reorder_list {
        @ print("  " + show(row))
    }
}


-- ============================================================================
-- > ACTOR STATE
-- ============================================================================

= final_orders = ask(ord_actor, NewOrder)
= final_reorders = ask(reord_actor, NeedReorder)
= final_denied = ask(deny_actor, Denied)

@ print("")
@ print("--- Actor State ---")
@ print("  Orders processed: " + show(final_orders - 1))
@ print("  Reorders needed:  " + show(final_reorders - 1))
@ print("  Orders denied:    " + show(final_denied - 1))


-- ============================================================================
-- @ JSON — Snapshot
-- ============================================================================

@ print("")
@ print("--- JSON Snapshot ---")

= snapshot = json_object([
    ["total_products", "10"],
    ["orders_processed", show(final_orders - 1)],
    ["orders_denied", show(final_denied - 1)],
    ["reorders_needed", show(final_reorders - 1)],
    ["total_value_kr", show(total_value)],
])

@ print("  " + snapshot)

= parsed = json_parse(snapshot)
= rt_orders = json_get(parsed, "orders_processed")
@ print("  Round-trip: orders=" + rt_orders)


-- ============================================================================
-- CLEANUP
-- ============================================================================

@ db_close(db)


-- ============================================================================
-- SUMMARY
-- ============================================================================

@ print("")
@ print("=== Inventory System Complete ===")
@ print("  5 ADTs + 2 structs")
@ print("  16 verified invariants")
@ print("  8 Catala rules (reorder, hazmat, escalation, shelf-life)")
@ print("  3 actors (order, reorder, denied counters)")
@ print("  4 stream pipelines (scan, pairwise, map)")
@ print("  1 subject (order_log) with subscription")
@ print("  2 scopes (Dashboard, ReorderCheck)")
@ print("  SQLite: 3 tables, 30+ queries")
@ print("  Map-based in-memory stock tracking")
@ print("  JSON snapshot with round-trip")
@ print("  12 orders simulated (purchases, sales, returns)")
@ print("  All 7 runes exercised.")
