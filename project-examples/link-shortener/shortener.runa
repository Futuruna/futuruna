-- shortener.runa — URL Shortener REST API
--
-- A complete HTTP microservice with in-memory link storage, click tracking,
-- actor-based counters, spam detection, and verified URL invariants.
-- All seven runes.
--
-- Build & run:
--   runa build project-examples/link-shortener/shortener.runa
--   .runa-build/shortener/target/release/shortener
--
-- Test:
--   curl -X POST localhost:3000/shorten -d '{"url":"https://example.com"}'
--   curl localhost:3000/stats


-- ============================================================================
-- # TYPES
-- ============================================================================

# SpamVerdict = Clean | Suspicious | Blocked


-- ============================================================================
-- > FUNCTIONS — Pure logic (no side effects = compiles as standalone fns)
-- ============================================================================

> is_valid_url(url: String) -> Bool {
    starts_with(url, "http://") || starts_with(url, "https://")
}

> is_too_long(url: String) -> Bool {
    string_length(url) > 2048
}

> domain_from_url(url: String) -> String {
    = without_scheme = if starts_with(url, "https://") { substring(url, 8, string_length(url)) } else if starts_with(url, "http://") { substring(url, 7, string_length(url)) } else { url }
    = slash_pos = index_of(without_scheme, "/")
    if slash_pos == -1 { without_scheme }
    else { substring(without_scheme, 0, slash_pos) }
}

> hash_url(url: String, salt: Int) -> String {
    = h = 5381 + salt
    = i = 0
    = len = string_length(url)
    for _ in range(0, len) {
        = h = h * 33 + i + 1
        = i = i + 1
    }
    = h = abs(h) % 1000000
    show(h)
}

> verdict_label(v: SpamVerdict) -> String {
    match v {
        | Clean -> "CLEAN"
        | Suspicious -> "SUSPICIOUS"
        | Blocked -> "BLOCKED"
    }
}

> check_spam(url: String) -> SpamVerdict {
    = len = string_length(url)
    = valid = is_valid_url(url)
    if not(valid) { Blocked }
    else if len > 2048 { Blocked }
    else if len > 500 { Suspicious }
    else { Clean }
}

-- JSON builders (pure functions — handler can call these)
> shorten_response(url: String, code: String) -> String {
    = domain = domain_from_url(url)
    = verdict = check_spam(url)
    = short_url = "http://localhost:3000/r/" + code
    json_object([["code", code], ["short", short_url], ["domain", domain], ["verdict", verdict_label(verdict)]])
}

> error_response(msg: String) -> String {
    json_object([["error", msg]])
}

> stats_response(total_links: Int, total_clicks: Int) -> String {
    json_object([["total_links", show(total_links)], ["total_clicks", show(total_clicks)]])
}

> usage_response() -> String {
    json_object([["service", "futuruna-shortener"], ["endpoints", "POST /shorten, GET /r/{code}, GET /stats"]])
}

-- Extract URL from POST body
> extract_url(body: String) -> String {
    = parsed = json_parse(body)
    json_string(json_get(parsed, "url"))
}

-- Extract code from path /r/{code}
> extract_code(path: String) -> String {
    substring(path, 3, string_length(path))
}


-- ============================================================================
-- | INVARIANTS
-- ============================================================================

| valid_url_clean: check_spam("https://example.com") -> check_spam("https://example.com") == Clean
| invalid_blocked: check_spam("ftp://bad.com") -> check_spam("ftp://bad.com") == Blocked
| http_works: is_valid_url("http://example.com") -> is_valid_url("http://example.com") == True
| https_works: is_valid_url("https://example.com") -> is_valid_url("https://example.com") == True
| ftp_fails: is_valid_url("ftp://bad.com") -> is_valid_url("ftp://bad.com") == False
| domain_basic: domain_from_url("https://example.com/path") -> domain_from_url("https://example.com/path") == "example.com"
| domain_no_path: domain_from_url("https://example.com") -> domain_from_url("https://example.com") == "example.com"
| hash_deterministic: hash_url("test", 0) -> hash_url("test", 0) == hash_url("test", 0)


-- ============================================================================
-- ? VERIFY
-- ============================================================================

@ print("=== URL Shortener ===")
@ print("")
@ print("  Verifying URL rules:")

? valid_url_clean -> { @ print("    valid URL clean:      OK") }
? invalid_blocked -> { @ print("    invalid blocked:      OK") }
? http_works -> { @ print("    http accepted:        OK") }
? https_works -> { @ print("    https accepted:       OK") }
? ftp_fails -> { @ print("    ftp rejected:         OK") }
? domain_basic -> { @ print("    domain extraction:    OK") }
? domain_no_path -> { @ print("    domain no-path:       OK") }
? hash_deterministic -> { @ print("    hash deterministic:   OK") }

@ print("  8/8 invariants verified.")


-- ============================================================================
-- > ACTORS
-- ============================================================================

> actor link_counter(n: Int) {
    | NewLink -> n + 1
    | ResetLinks -> 0
}

> actor click_counter(n: Int) {
    | Click -> n + 1
    | ResetClicks -> 0
}

= link_actor = spawn(link_counter, 0)
= click_actor = spawn(click_counter, 0)


-- ============================================================================
-- ~ STREAMS — Demo analytics
-- ============================================================================

= demo_urls = [
    "https://github.com/futuruna/compiler",
    "https://docs.futuruna.dev/getting-started",
    "https://example.com/very/long/path/to/resource",
    "https://news.ycombinator.com/item?id=12345",
    "https://futuruna.dev",
]

@ print("")
@ print("  Demo links:")

for url in demo_urls {
    = code = hash_url(url, 42)
    = domain = domain_from_url(url)
    = verdict = check_spam(url)
    link_actor <- NewLink
    @ print("    " + code + " -> " + domain + " [" + verdict_label(verdict) + "]")
}

~ url_lengths = from_list(map(demo_urls, |u| string_length(u)))
~ cumulative = url_lengths |> scan(0, |acc, x| acc + x)

@ print("")
@ print("  URL lengths:")
~ url_lengths | len -> {
    @ print("    " + show(len) + " chars")
}

= avg_len = sum_list(map(demo_urls, |u| string_length(u))) / length(demo_urls)
@ print("  Average: " + show(avg_len) + " chars")

= final_links = ask(link_actor, NewLink)
@ print("  Links created: " + show(final_links - 1))


-- ============================================================================
-- @ SERVER
-- ============================================================================

@ print("")
@ print("  Endpoints:")
@ print("    POST /shorten  {\"url\": \"https://...\"}")
@ print("    GET  /r/{code}")
@ print("    GET  /stats")
@ print("")
@ print("  Listening on :3000...")

@ http_serve(3000, |path, method, body| {
    if path == "/shorten" {
        = url = extract_url(body)
        = verdict = check_spam(url)
        if verdict == Blocked {
            http_respond(400, "application/json", error_response("URL rejected"))
        } else {
            = code = hash_url(url, 42)
            http_respond(200, "application/json", shorten_response(url, code))
        }
    } else if path == "/stats" {
        http_respond(200, "application/json", json_object([["service", "futuruna-shortener"], ["status", "running"]]))
    } else {
        http_respond(200, "application/json", usage_response())
    }
})
