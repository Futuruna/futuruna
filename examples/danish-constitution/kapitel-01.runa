@ sprog da

@ importer ./grundlov - faelles

--@label:grundlov_indledning::meta:grundlov_kildemetadata--
----
Danmarks Riges Grundlov (Grundloven) (* 1)

Vi Frederik den Niende, af Guds Nåde Konge til Danmark, de Venders og Goters,
Hertug til Slesvig, Holsten, Stormarn, Ditmarsken, Lauenborg og Oldenborg, Gør
vitterligt: I overensstemmelse med bestemmelserne i § 94 i Danmarks Riges
Grundlov af 5. juni 1915 med ændringer af 10. september 1920 har rigsdagen 2
gange vedtaget, og folketingsvælgerne ved en den 28. maj 1953 afholdt
folkeafstemning godkendt, hvorefter Vi nu ved Vort allerhøjeste samtykke
stadfæster DANMARKS RIGES GRUNDLOV
----

--@begin:grundlov_indledning--

= grundlovsfolkeafstemningens_dato = Dato(år = 1953, måned = 5, dag = 28)
| rigsdagen_vedtog_grundloven_to_gange()
| dato_for_grundlovsfolkeafstemningen() -> grundlovsfolkeafstemningens_dato
| folketingsvælgerne_godkendte_grundloven_ved_folkeafstemning(dato: Dato) -> dato == grundlovsfolkeafstemningens_dato
| kongen_stadfæstede_grundloven()
--@end:grundlov_indledning--

-- ═══════════════════════════════════════════════════════════════
-- Kapitel I — Statsformen (§ 1–4)
-- ═══════════════════════════════════════════════════════════════

--@label:grundlov_par1::meta:grundlov_kildemetadata--
----
§ 1. Denne grundlov gælder for alle dele af Danmarks Rige.
----

--@begin:grundlov_par1--

| grundloven_gælder_for_alle_dele_af_riget()
| grundloven_gælder_for(del: Rigsdel) -> Sandt
--@end:grundlov_par1--

--@label:grundlov_par2::meta:grundlov_kildemetadata--
----
§ 2. Regeringsformen er indskrænket-monarkisk.
Kongemagten nedarves til mænd og kvinder efter de i
tronfølgeloven af 27. marts 1953 fastsatte regler.
----

--@begin:grundlov_par2--

| regeringsformen_er_indskrænket_monarkisk()
| tronfølgeloven_regulerer_arvefølgen()
| kongemagten_nedarves_til(køn: Køn) -> Sandt
= tronfølgeloven_dato = Dato(år = 1953, måned = 3, dag = 27)
| dato_for_tronfølgeloven() -> tronfølgeloven_dato
--@end:grundlov_par2--

--@label:grundlov_par3::meta:grundlov_kildemetadata--
----
§ 3. Den lovgivende magt er hos kongen og folketinget i forening.
Den udøvende magt er hos kongen.
Den dømmende magt er hos domstolene.
----

--@begin:grundlov_par3--

| statsmagtens_placering(magt: Statsmagt) -> match magt {
    | Lovgivende -> Magtplacering(
        magt = Lovgivende,
        udøvelse = IForening(
            organ = KongenSomStatsorgan,
            medorgan = Folketinget
        )
    )
    | Udøvende -> Magtplacering(
        magt = Udøvende,
        udøvelse = Hos(organ = KongenSomStatsorgan)
    )
    | Dømmende -> Magtplacering(
        magt = Dømmende,
        udøvelse = Hos(organ = Domstolene)
    )
}

| statsorgan_deltager_i(organ: Statsorgan, magt: Statsmagt) -> match statsmagtens_placering(magt).udøvelse {
    | Hos(placeret_organ) -> organ == placeret_organ
    | IForening(første_organ, andet_organ) -> organ == første_organ || organ == andet_organ
}

| statsmagt_udøves_i_forening(magt: Statsmagt) -> match statsmagtens_placering(magt).udøvelse {
    | Hos(_) -> Falskt
    | IForening(_, _) -> Sandt
}
--@end:grundlov_par3--

--@label:grundlov_par4::meta:grundlov_kildemetadata--
----
§ 4. Den evangelisk-lutherske kirke er den danske folkekirke
og understøttes som sådan af staten.
----

--@begin:grundlov_par4--

| folkekirken_er(EvangeliskLuthersk)
| staten_understøtter_folkekirken()
--@end:grundlov_par4--
