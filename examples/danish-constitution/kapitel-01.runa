@ sprog da

----
Danmarks Riges Grundlov (Grundloven)
af 5. juni 1953

Vi Frederik den Niende, af Guds Nåde Konge til Danmark, de Venders og Goters,
Hertug til Slesvig, Holsten, Stormarn, Ditmarsken, Lauenborg og Oldenborg,
gør vitterligt: Rigsdagen har to gange vedtaget og folketingsvælgerne ved
folkeafstemning den 28. maj 1953 godkendt, hvorefter Vi stadfæster
DANMARKS RIGES GRUNDLOV
----

-- ═══════════════════════════════════════════════════════════════
-- Kapitel I — Statsformen (§ 1–4)
-- ═══════════════════════════════════════════════════════════════

-- Rigets dele (§ 1)
# Rigsdel = Danmark | Færøerne | Grønland

-- Statsmagterne (§ 3)
# Statsmagt = Lovgivende | Udøvende | Dømmende
# Institution = Kongen | Folketinget | Domstolene

-- Køn for tronfølge (§ 2)
# Køn = Mand | Kvinde

-- Trossamfund (§ 4)
# Trossamfund = EvangeliskLuthersk

----
§ 1. Denne grundlov gælder for alle dele af Danmarks Rige.
----

| grundloven_gælder_for(del: Rigsdel) -> true

----
§ 2. Regeringsformen er indskrænket-monarkisk.
Kongemagten nedarves til mænd og kvinder efter de i
tronfølgeloven af 27. marts 1953 fastsatte regler.
----

| regeringsformen_er_indskrænket_monarkisk()
| kongemagten_nedarves_til(køn: Køn) -> true
= tronfølgeloven_dato = "27. marts 1953"

----
§ 3. Den lovgivende magt er hos kongen og folketinget i forening.
Den udøvende magt er hos kongen.
Den dømmende magt er hos domstolene.
----

-- Hvem udøver hvilken magt
| udøver(Kongen, Lovgivende)
| udøver(Folketinget, Lovgivende)
| udøver(Kongen, Udøvende)
| udøver(Domstolene, Dømmende)

-- "I forening" — lovgivning kræver begge
| lovgivning_kræver(Kongen)
| lovgivning_kræver(Folketinget)

----
§ 4. Den evangelisk-lutherske kirke er den danske folkekirke
og understøttes som sådan af staten.
----

| folkekirken_er(EvangeliskLuthersk)
| staten_understøtter_folkekirken()

-- ═══════════════════════════════════════════════════════════════
-- Verifikation — bevisbare invarianter
-- ═══════════════════════════════════════════════════════════════

@ print("--- Kapitel I: Statsformen ---")

-- § 1: Grundloven dækker hele riget (alle tre dele)
= rigsdele = findall(del, grundloven_gælder_for(del))
| alle_rigsdele_dækket: rigsdele -> length(rigsdele) == 3
? alle_rigsdele_dækket -> { @ print("§ 1  ✓ Grundloven dækker alle " + show(length(rigsdele)) + " rigsdele") } else { @ print("§ 1  ✗ FEJL: ikke alle rigsdele dækket") }

-- § 1: Specifikt: Danmark, Færøerne, Grønland
| danmark_dækket: rigsdele -> grundloven_gælder_for(Danmark)
| færøerne_dækket: rigsdele -> grundloven_gælder_for(Færøerne)
| grønland_dækket: rigsdele -> grundloven_gælder_for(Grønland)
? danmark_dækket -> { @ print("§ 1  ✓ Danmark") } else { @ print("§ 1  ✗ Danmark MANGLER") }
? færøerne_dækket -> { @ print("§ 1  ✓ Færøerne") } else { @ print("§ 1  ✗ Færøerne MANGLER") }
? grønland_dækket -> { @ print("§ 1  ✓ Grønland") } else { @ print("§ 1  ✗ Grønland MANGLER") }

-- § 2: Begge køn arver tronen
= arvekøn = findall(k, kongemagten_nedarves_til(k))
| begge_køn_arver: arvekøn -> length(arvekøn) == 2
? begge_køn_arver -> { @ print("§ 2  ✓ Begge køn arver (" + show(arvekøn) + ")") } else { @ print("§ 2  ✗ FEJL: ikke begge køn") }

-- § 3: Magtens tredeling — tre adskilte magter
= lovgivere = findall(i, udøver(i, Lovgivende))
= udøvere = findall(i, udøver(i, Udøvende))
= dommere = findall(i, udøver(i, Dømmende))

| tredeling_lovgivende: lovgivere -> length(lovgivere) > 0
| tredeling_udøvende: udøvere -> length(udøvere) > 0
| tredeling_dømmende: dommere -> length(dommere) > 0
? tredeling_lovgivende -> { @ print("§ 3  ✓ Lovgivende: " + show(lovgivere)) } else { @ print("§ 3  ✗ Lovgivende magt mangler") }
? tredeling_udøvende -> { @ print("§ 3  ✓ Udøvende: " + show(udøvere)) } else { @ print("§ 3  ✗ Udøvende magt mangler") }
? tredeling_dømmende -> { @ print("§ 3  ✓ Dømmende: " + show(dommere)) } else { @ print("§ 3  ✗ Dømmende magt mangler") }

-- § 3: Lovgivning kræver BÅDE Kongen og Folketinget ("i forening")
= krævet = findall(i, lovgivning_kræver(i))
| lovgivning_kræver_begge: krævet -> length(krævet) == 2
? lovgivning_kræver_begge -> { @ print("§ 3  ✓ Lovgivning kræver: " + show(krævet)) } else { @ print("§ 3  ✗ FEJL: lovgivning kræver ikke to parter") }

-- § 3: Domstolene er UAFHÆNGIGE (har ikke lovgivende eller udøvende magt)
| domstolene_kun_dømmende: dommere -> not(udøver(Domstolene, Lovgivende)) && not(udøver(Domstolene, Udøvende))
? domstolene_kun_dømmende -> { @ print("§ 3  ✓ Domstolene kun dømmende (uafhængige)") } else { @ print("§ 3  ✗ FEJL: Domstolene har anden magt") }

-- § 4: Folkekirken
| folkekirke_er_evangelisk: rigsdele -> folkekirken_er(EvangeliskLuthersk)
? folkekirke_er_evangelisk -> { @ print("§ 4  ✓ Folkekirken er evangelisk-luthersk") } else { @ print("§ 4  ✗ FEJL") }
