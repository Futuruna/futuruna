@ sprog da

@ importer ./kapitel - 07

-- Scenarierne prøver §§ 67-70 uden at indføre fortolkninger ud over ordlyden.

= beskyttet_lære = Religionsudøvelse(
    udtryk = Lære,
    stemmer_med_overbevisningen = Sandt,
    strider_mod_sædeligheden = Falskt,
    strider_mod_den_offentlige_orden = Falskt
)
= beskyttet_foretagelse = Religionsudøvelse(
    udtryk = Foretagelse,
    stemmer_med_overbevisningen = Sandt,
    strider_mod_sædeligheden = Falskt,
    strider_mod_den_offentlige_orden = Falskt
)
= lære_uden_overbevisningssammenhæng = Religionsudøvelse(
    udtryk = Lære,
    stemmer_med_overbevisningen = Falskt,
    strider_mod_sædeligheden = Falskt,
    strider_mod_den_offentlige_orden = Falskt
)
= lære_mod_sædeligheden = Religionsudøvelse(
    udtryk = Lære,
    stemmer_med_overbevisningen = Sandt,
    strider_mod_sædeligheden = Sandt,
    strider_mod_den_offentlige_orden = Falskt
)
= foretagelse_mod_den_offentlige_orden = Religionsudøvelse(
    udtryk = Foretagelse,
    stemmer_med_overbevisningen = Sandt,
    strider_mod_sædeligheden = Falskt,
    strider_mod_den_offentlige_orden = Sandt
)

| par67_beskytter_begge_udtryksformer: beskyttet_lære.er_beskyttet_efter_par67() -> beskyttet_lære.er_beskyttet_efter_par67() && beskyttet_foretagelse.er_beskyttet_efter_par67()
| par67_kræver_overbevisningssammenhæng_og_begge_grænser: lære_uden_overbevisningssammenhæng.er_beskyttet_efter_par67() -> lære_uden_overbevisningssammenhæng.er_beskyttet_efter_par67() == Falskt && lære_mod_sædeligheden.er_beskyttet_efter_par67() == Falskt && foretagelse_mod_den_offentlige_orden.er_beskyttet_efter_par67() == Falskt

= bidrag_til_egen_gudsdyrkelse = PersonligtBidragsforhold(gudsdyrkelse = EgenGudsdyrkelse, bidragspligt_pålagt = Sandt)
= frivilligt_bidrag_til_anden_gudsdyrkelse = PersonligtBidragsforhold(gudsdyrkelse = AndenGudsdyrkelse, bidragspligt_pålagt = Falskt)
= pligtbidrag_til_anden_gudsdyrkelse = PersonligtBidragsforhold(gudsdyrkelse = AndenGudsdyrkelse, bidragspligt_pålagt = Sandt)

| par68_afgrænser_bidrag_til_anden_gudsdyrkelse: bidrag_til_egen_gudsdyrkelse.opfylder_par68() -> bidrag_til_egen_gudsdyrkelse.opfylder_par68() && frivilligt_bidrag_til_anden_gudsdyrkelse.opfylder_par68() && pligtbidrag_til_anden_gudsdyrkelse.opfylder_par68() == Falskt

= trosbaseret_berøvelse_af_borgerlig_ret = Par70Sag(
    grund = Trosbekendelse,
    virkning = BerøvelseAfRettighed(rettighed = BorgerligRettighed),
    virkningen_sker_på_grund_af_grunden = Sandt
)
= afstamningsbaseret_berøvelse_af_politisk_ret = Par70Sag(
    grund = AfstamningSomLigebehandlingsgrund,
    virkning = BerøvelseAfRettighed(rettighed = PolitiskRettighed),
    virkningen_sker_på_grund_af_grunden = Sandt
)
= trosbaseret_unddragelse_fra_borgerpligt = Par70Sag(
    grund = Trosbekendelse,
    virkning = UnddragelseFraAlmindeligBorgerpligt,
    virkningen_sker_på_grund_af_grunden = Sandt
)
= ikke_årsagsbestemt_rettighedsvirkning = Par70Sag(
    grund = AfstamningSomLigebehandlingsgrund,
    virkning = BerøvelseAfRettighed(rettighed = BorgerligRettighed),
    virkningen_sker_på_grund_af_grunden = Falskt
)
= ikke_årsagsbestemt_borgerpligt = Par70Sag(
    grund = AfstamningSomLigebehandlingsgrund,
    virkning = UnddragelseFraAlmindeligBorgerpligt,
    virkningen_sker_på_grund_af_grunden = Falskt
)

| par70_omfatter_begge_grunde_og_rettighedstyper: trosbaseret_berøvelse_af_borgerlig_ret.grund_er_omfattet() -> trosbaseret_berøvelse_af_borgerlig_ret.grund_er_omfattet() && afstamningsbaseret_berøvelse_af_politisk_ret.grund_er_omfattet() && trosbaseret_berøvelse_af_borgerlig_ret.virkning_er_omfattet() && afstamningsbaseret_berøvelse_af_politisk_ret.virkning_er_omfattet()
| par70_forbyder_årsagsbestemt_rettighedsberøvelse_og_pligtunddragelse: ikke_årsagsbestemt_rettighedsvirkning.opfylder_par70() -> trosbaseret_berøvelse_af_borgerlig_ret.opfylder_par70() == Falskt && afstamningsbaseret_berøvelse_af_politisk_ret.opfylder_par70() == Falskt && trosbaseret_unddragelse_fra_borgerpligt.opfylder_par70() == Falskt && ikke_årsagsbestemt_rettighedsvirkning.opfylder_par70() && ikke_årsagsbestemt_borgerpligt.opfylder_par70()

? par67_beskytter_begge_udtryksformer
? par67_kræver_overbevisningssammenhæng_og_begge_grænser
? par68_afgrænser_bidrag_til_anden_gudsdyrkelse
? par70_omfatter_begge_grunde_og_rettighedstyper
? par70_forbyder_årsagsbestemt_rettighedsberøvelse_og_pligtunddragelse

@ skriv("Scenarierne for religion og ligebehandling holder.")
