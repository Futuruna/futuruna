@ sprog da

-- Fælles domæne og typet kildeprotokol for grundlovskorpuset.

# Dato(år: Heltal, måned: Heltal, dag: Heltal)
# Brøk(tæller: Heltal, nævner: Heltal)
# Rigsdel = Danmark | Færøerne | Grønland
# Statsmagt = Lovgivende | Udøvende | Dømmende
# Statsorgan = KongenSomStatsorgan | Folketinget | Domstolene
# Udøvelsesform = Hos(organ: Statsorgan) | IForening(organ: Statsorgan, medorgan: Statsorgan)
# Magtplacering(magt: Statsmagt, udøvelse: Udøvelsesform)
# Køn = Mand | Kvinde
# Trossamfund = EvangeliskLuthersk | Andet(navn: Tekst)
# Samtykke = Givet | IkkeGivet
# Forsikringsstatus = IkkeAfgivet | AfgivetSomTronfølger
# Monark(alder: Heltal, trossamfund: Trossamfund, forsikring: Forsikringsstatus)
# Tronfølger(alder: Heltal, trossamfund: Trossamfund, forsikring: Forsikringsstatus)

# Modellag = Kildemodel | Fortolkningsmodel(navn: Tekst)
# Udsagnsstatus = TekstnærKontrol | Modelresultat | Fortolkningsspørgsmål | RetskildestøttetKonklusion
# Prøvningsomfang = EnkeltScenarie | Scenariesamling | Grænseanalyse | UdtømmendeLukketDomæne | AfgrænsetSøgning(beskrivelse: Tekst)

# GrundlovKildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Dato)
# Fortolkningsgrundlag(kilder: List(GrundlovKildeInfo), forudsætninger: List(Tekst))
# GrundlovMetaRolle(a) = Source(value: a) | SupportingSource(value: a)
# GrundlovMetadata(a) = GrundlovMetadata(attachments: a)

# impl MetaRole for GrundlovMetaRolle {}
# impl Meta for GrundlovMetadata {}

= grundlov_retsinformation = GrundlovKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/1953/169",
    identifier = "Danmarks Riges Grundlov, LOV nr. 169 af 05/06/1953",
    hentet_dato = Dato(år = 2026, måned = 8, dag = 12)
)

= grundlov_folketinget = GrundlovKildeInfo(
    url = "https://www.ft.dk/da/dokumenter/bestil-publikationer/publikationer/grundloven/danmarks-riges-grundlov",
    identifier = "Folketingets parlamentariske tekstspejl af Danmarks Riges Grundlov",
    hentet_dato = Dato(år = 2026, måned = 8, dag = 12)
)

= grundlov_kildemetadata = GrundlovMetadata(
    attachments = (
        Source(value = grundlov_retsinformation),
        SupportingSource(value = grundlov_folketinget),
    )
)
