-- Par. 86: kommunal valgret følger folketingsvalgret
| par86_kommunal_følger() -> kommunal_valgretsalder_følger_folketingsvalg()
| par86_menighedsråd_følger() -> menighedsråd_valgretsalder_følger_folketingsvalg()

-- Delegationer (kap. IX)
| delegation_færøerne_kommunal_valgret() -> færøerne_kommunal_valgretsalder_fastsættes_ved_lov()
| delegation_grønland_kommunal_valgret() -> grønland_kommunal_valgretsalder_fastsættes_ved_lov()

-- Par. 87: islandske statsborgeres rettigheder
| par87_islandske_rettigheder() -> islandske_statsborgere_bevarer_grundlovsrettigheder()

-- Par. 88: grundlovsændring — dobbelt godkendelseskrav
= par88_godkendt = grundlovsændring_godkendt(600000, 1000000, 1400000)
= par88_flertal_men_under_40pct = grundlovsændring_godkendt(510000, 1000000, 1400000)
= par88_minoritet = grundlovsændring_godkendt(400000, 1000000, 1400000)
| par88_begge_krav_opfyldt: par88_godkendt -> par88_godkendt == Sandt
| par88_mangler_40pct: par88_flertal_men_under_40pct -> par88_flertal_men_under_40pct == Falskt
| par88_mangler_flertal: par88_minoritet -> par88_minoritet == Falskt

-- Par. 88: tærskel
| par88_tærskel: godkendelsestærskel_pct -> godkendelsestærskel_pct == 40
| par88_frist: frist_folkeafstemning_måneder -> frist_folkeafstemning_måneder == 6

-- Delegationer (kap. X)
| delegation_afstemningsregler() -> afstemningsregler_fastsættes_ved_lov()

-- Tværgående: par. 88 vs par. 42 stk. 5 — to folkeafstemninger, forskellige tærskler
-- § 42 stk. 5: lovforslag forkastes ved flertal + 30% af stemmeberettigede.
-- § 88: grundlovsændring godkendes ved flertal + 40% af stemmeberettigede.
-- Grundlovsændring kræver MERE end lovforkastelse — 40% vs 30%.
-- Bevidst asymmetri: det er sværere at ændre grundloven end at forkaste en lov.
| par42_par88_lov_tærskel: godkendelsestærskel_pct -> godkendelsestærskel_pct == 40
-- § 42 bruger 30%, § 88 bruger 40% — grundlovsændring er hårdere

-- Tværgående: par. 88 — firetrinstærskel for grundlovsændring
-- 1. Første folketing vedtager. 2. Nyvalg. 3. Nyt folketing genvedtager uændret.
-- 4. Folkeafstemning med flertal + 40%. 5. Kongelig stadfæstelse.
-- Grundloven er den hårdeste norm at ændre — sværere end enhver lov.
| par88_krav_nyvalg() -> grundlovsændring_kræver_nyvalg()
| par88_krav_genvedtagelse() -> grundlovsændring_kræver_uændret_genvedtagelse()
| par88_krav_folkeafstemning() -> grundlovsændring_kræver_folkeafstemning()
| par88_krav_stadfæstelse() -> grundlovsændring_kræver_kongelig_stadfæstelse()

-- Par. 89: ikrafttrædelse
| par89_straks() -> grundloven_træder_i_kraft_straks()

-- Tværgående: par. 20 vs par. 88 — suverænitet kan flyttes uden grundlovsændringsformen
-- § 20 kan overlade grundlovsbeføjelser til mellemfolkelige myndigheder ved
-- 5/6-flertal, eller ved almindeligt flertal efterfulgt af folkeafstemning.
-- § 88 kræver derimod nyvalg, uændret genvedtagelse, folkeafstemning og
-- stadfæstelse. Tensionen er, at forfatningsvirkelighed kan ændres uden at
-- selve grundlovsteksten ændres.
| par20_suverænitet_kan_overlades() -> beføjelser_kan_overlades_mellemfolkeligt()
| par20_alternativ_folkeafstemning() -> alternativt_folkeafstemning_ved_simpelt_flertal()
| par20_tærskel: suverænitetskrav_flertal -> suverænitetskrav_flertal == "5/6 af folketingets medlemmer"
| par20_par88_nyvalg_asymmetri() -> grundlovsændring_kræver_nyvalg()

-- Tværgående: par. 31 vs par. 56 — repræsentation af anskuelser, men frit mandat
-- § 31 pålægger valgloven at sikre ligelig repræsentation af anskuelser.
-- § 56 binder det enkelte medlem alene ved sin overbevisning.
-- Systemet repræsenterer vælgernes anskuelser; mandatet er ikke bundet af dem.
| par31_repræsenterer_anskuelser() -> ligelig_repræsentation_af_anskuelser()
| par56_frit_mandat() -> frit_mandat()
| par56_ikke_bundet_af_vælgere() -> ikke_bundet_af_vælgernes_forskrift()

-- Tværgående: par. 49 — offentlighed med intern lukkemekanisme
-- Folketingets møder er offentlige som udgangspunkt, men formand, medlemmer
-- eller ministre kan forlange dørene lukkede. Offentlighed er default, ikke absolut.
| par49_offentlighed_default() -> folketingets_møder_er_offentlige()
| par49_lukket_møde_kan_rejses() -> formanden_kan_forlange_lukket_møde()
| par49_lukning_afgøres_uden_forhandling() -> lukket_møde_afgøres_uden_forhandling()

-- Tværgående: par. 29 vs par. 86 — national valgretsalder og rigsdelsundtagelser
-- § 29 ændrer folketingsvalgretsalder via lov + folkeafstemning.
-- § 86 lader kommunal valgretsalder følge folketinget, men Færøerne og Grønland
-- kan fastsættes ved lov. Rigets dele får dermed en eksplicit lokal lovkanal.
| par29_valgretsalder_folkeafstemning() -> ændring_af_valgretsalder_kræver_folkeafstemning()
| par86_kommunal_følger_folketinget() -> kommunal_valgretsalder_følger_folketingsvalg()
| par86_rigsdelsundtagelser() -> færøerne_kommunal_valgretsalder_fastsættes_ved_lov()

? par86_kommunal_følger
? par86_menighedsråd_følger
? delegation_færøerne_kommunal_valgret
? delegation_grønland_kommunal_valgret
? par87_islandske_rettigheder
? par88_begge_krav_opfyldt
? par88_mangler_40pct
? par88_mangler_flertal
? par88_tærskel
? par88_frist
? delegation_afstemningsregler
? par88_krav_nyvalg
? par88_krav_genvedtagelse
? par88_krav_folkeafstemning
? par88_krav_stadfæstelse
? par89_straks
? par20_suverænitet_kan_overlades
? par20_alternativ_folkeafstemning
? par20_tærskel
? par20_par88_nyvalg_asymmetri
? par31_repræsenterer_anskuelser
? par56_frit_mandat
? par56_ikke_bundet_af_vælgere
? par49_offentlighed_default
? par49_lukket_møde_kan_rejses
? par49_lukning_afgøres_uden_forhandling
? par29_valgretsalder_folkeafstemning
? par86_kommunal_følger_folketinget
? par86_rigsdelsundtagelser

? all -> {
    @ skriv("Alle invarianter holder.")
} else {
    @ skriv("Nogle invarianter fejlede.")
}
