@ sprog da

@ importer ./grundlov - faelles

-- Kapitel XI -- Ikrafttrædelsesbestemmelser

--@label:grundlov_par89::meta:grundlov_kildemetadata--
----
§ 89. Denne grundlov træder i kraft straks. Dog vedbliver den i henhold til
Danmarks Riges Grundlov af 5. juni 1915 med ændringer af 10. september 1920
senest valgte rigsdag at bestå, indtil nyvalg har fundet sted i
overensstemmelse med reglerne i kapitel IV. Indtil nyvalg har fundet sted,
forbliver de i Danmarks Riges Grundlov af 5. juni 1915 med ændringer af
10. september 1920 for rigsdagen fastsatte bestemmelser i kraft.
----

--@begin:grundlov_par89--

# TidligereForfatningsgrundlag(titel: Tekst, grundlovsdato: Dato, ændringsdato: Dato)
# Grundlovsovergangsfase = FørNyvalgEfterKapitelIV | EfterNyvalgEfterKapitelIV
# Grundlovsovergang(fase: Grundlovsovergangsfase) {
    | grundloven_er_i_kraft_efter_par89() -> Sandt
    | den_senest_valgte_rigsdag_består_efter_par89() -> fase == FørNyvalgEfterKapitelIV
    | de_tidligere_rigsdagsbestemmelser_er_i_kraft_efter_par89() -> fase == FørNyvalgEfterKapitelIV
}

= overgangens_tidligere_forfatningsgrundlag = TidligereForfatningsgrundlag(
    titel = "Danmarks Riges Grundlov",
    grundlovsdato = Dato(år = 1915, måned = 6, dag = 5),
    ændringsdato = Dato(år = 1920, måned = 9, dag = 10)
)
--@end:grundlov_par89--

--@label:grundlov_stadfaestelse::meta:grundlov_kildemetadata--
----
Så er da nu gældende ret, alle til ubrødelig efterlevelse,

DANMARKS RIGES GRUNDLOV

Givet på Christiansborg slot, den 5. juni 1953 .

Under Vor Kongelige Hånd og Segl.

Frederik R.

(L.S.)

Erik Eriksen.        Ole Bjørn Kraft.         Thorkil Kristensen.
Harald Petersen.      Carl Hermansen              Jens Sønderup.
Aksel Møller.     Flemming Hvidbjerg.           Poul Sørensen.
Helga Pedersen.   Knud Ree.   Aage L. Rytter. Jørgen Jørgensen.
----

--@begin:grundlov_stadfaestelse--

# GrundlovensUdstedelsessted = ChristiansborgSlot
# StadfæstendeMonark = FrederikDenNiende

= grundlovens_udstedelsesdato = Dato(år = 1953, måned = 6, dag = 5)
# Grundlovsstadfæstelse(dato: Dato, sted: GrundlovensUdstedelsessted, monark: StadfæstendeMonark, under_kongelig_hånd: Boolsk, under_kongeligt_segl: Boolsk) {
    | opfylder_stadfæstelsesteksten() -> dato == grundlovens_udstedelsesdato && sted == ChristiansborgSlot && monark == FrederikDenNiende && under_kongelig_hånd && under_kongeligt_segl
}

= grundlovens_stadfæstelse = Grundlovsstadfæstelse(
    dato = grundlovens_udstedelsesdato,
    sted = ChristiansborgSlot,
    monark = FrederikDenNiende,
    under_kongelig_hånd = Sandt,
    under_kongeligt_segl = Sandt
)

| grundloven_er_gældende_ret()
--@end:grundlov_stadfaestelse--
