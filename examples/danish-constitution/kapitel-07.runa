@ sprog da

@ importer ./grundlov - faelles

-- Kapitel VII -- Folkekirken og trossamfund

--@label:grundlov_par66::meta:grundlov_kildemetadata--
----
§ 66. Folkekirkens forfatning ordnes ved lov.
----

--@begin:grundlov_par66--

| folkekirkens_forfatning_ordnes_ved_lov()
--@end:grundlov_par66--

--@label:grundlov_par67::meta:grundlov_kildemetadata--
----
§ 67. Borgerne har ret til at forene sig i samfund for at dyrke Gud på den
måde, der stemmer med deres overbevisning, dog at intet læres eller foretages,
som strider mod sædeligheden eller den offentlige orden.
----

--@begin:grundlov_par67--

# Religionsudtryk = Lære | Foretagelse
# Religionsudøvelse(udtryk: Religionsudtryk, stemmer_med_overbevisningen: Boolsk, strider_mod_sædeligheden: Boolsk, strider_mod_den_offentlige_orden: Boolsk) {
    | er_beskyttet_efter_par67() -> stemmer_med_overbevisningen && strider_mod_sædeligheden == Falskt && strider_mod_den_offentlige_orden == Falskt && match udtryk {
        | Lære -> Sandt
        | Foretagelse -> Sandt
    }
}
| borgerne_har_ret_til_at_forene_sig_i_samfund_for_at_dyrke_gud()
--@end:grundlov_par67--

--@label:grundlov_par68::meta:grundlov_kildemetadata--
----
§ 68. Ingen er pligtig at yde personlige bidrag til nogen anden gudsdyrkelse
end den, som er hans egen.
----

--@begin:grundlov_par68--

# Gudsdyrkelse = EgenGudsdyrkelse | AndenGudsdyrkelse
# PersonligtBidragsforhold(gudsdyrkelse: Gudsdyrkelse, bidragspligt_pålagt: Boolsk) {
    | opfylder_par68() -> match gudsdyrkelse {
        | EgenGudsdyrkelse -> Sandt
        | AndenGudsdyrkelse -> bidragspligt_pålagt == Falskt
    }
}
--@end:grundlov_par68--

--@label:grundlov_par69::meta:grundlov_kildemetadata--
----
§ 69. De fra folkekirken afvigende trossamfunds forhold ordnes nærmere ved lov.
----

--@begin:grundlov_par69--

| de_fra_folkekirken_afvigende_trossamfunds_forhold_ordnes_nærmere_ved_lov()
--@end:grundlov_par69--

--@label:grundlov_par70::meta:grundlov_kildemetadata--
----
§ 70. Ingen kan på grund af sin trosbekendelse eller afstamning berøves adgang
til den fulde nydelse af borgerlige og politiske rettigheder eller unddrage sig
opfyldelsen af nogen almindelig borgerpligt.
----

--@begin:grundlov_par70--

# Ligebehandlingsgrund = Trosbekendelse | AfstamningSomLigebehandlingsgrund
# Rettighedstype = BorgerligRettighed | PolitiskRettighed
# Par70Virkning = BerøvelseAfRettighed(rettighed: Rettighedstype) | UnddragelseFraAlmindeligBorgerpligt
# Par70Sag(grund: Ligebehandlingsgrund, virkning: Par70Virkning, virkningen_sker_på_grund_af_grunden: Boolsk) {
    | opfylder_par70() -> virkningen_sker_på_grund_af_grunden == Falskt && grund_er_omfattet() && virkning_er_omfattet()
    | grund_er_omfattet() -> match grund {
        | Trosbekendelse -> Sandt
        | AfstamningSomLigebehandlingsgrund -> Sandt
    }
    | virkning_er_omfattet() -> match virkning {
        | BerøvelseAfRettighed(_) -> Sandt
        | UnddragelseFraAlmindeligBorgerpligt -> Sandt
    }
}
--@end:grundlov_par70--
