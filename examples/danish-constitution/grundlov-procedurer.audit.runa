@ sprog da

@ importer ./kapitel - 02
@ importer ./kapitel - 03
@ importer ./kapitel - 05
@ importer ./kapitel - 06
@ importer ./kapitel - 08
@ importer ./kapitel - 10
@ importer ./grundlov - proevning - faelles

-- Procedureprøvningen prøver samtykke, konsistente tællinger, strenge og
-- inklusive tærskler samt forskellen mellem udløser, forløb og retsvirkning.

= procedurer_taerskler_fund = GrundlovPrøvningsfund(
    titel = "Proceduregrænser i §§ 42, 73 og 88",
    modellag = Kildemodel,
    udsagnsstatus = Modelresultat,
    prøvningsomfang = Grænseanalyse,
    programhenvisninger = [
        refof(lovforslag_forkastet_ved_folkeafstemning),
        refof(Ekspropriationsudsættelsesbegæring::opfylder_par73_stk2),
        refof(Grundlovsafstemningsresultat::opfylder_godkendelseskravet_i_par88)
    ],
    grundlag = Fortolkningsgrundlag(
        kilder = [grundlov_retsinformation],
        forudsætninger = []
    ),
    resultat = "De tre procedurer bevarer hver sin stemmeretning, frist og tærskel, inklusive forskellen mellem strengt flertal og mindst-krav.",
    afgrænsning = "Kontrollen sammenligner de kodede grænser; den rangordner ikke procedurerne retligt."
)

| procedurer_samtykke_er_positivt_og_manglende_samtykke_negativt() -> {
    = anden_person = AndenPerson(
        kongen_finder_forbrydelsen_særdeles_farlig_for_staten = Sandt
    )
    = rigsretssag_med_samtykke = Rigsretssag(
        tiltaler = KongenSomRigsretstiltaler,
        tiltalt = anden_person,
        folketingets_samtykke = Givet
    )
    = rigsretssag_uden_samtykke = Rigsretssag(
        tiltaler = KongenSomRigsretstiltaler,
        tiltalt = anden_person,
        folketingets_samtykke = IkkeGivet
    )
    (
        regent_i_udlandet(Givet)
        && regent_i_udlandet(IkkeGivet) == Falskt
        && årpenge_i_udlandet(Givet)
        && årpenge_i_udlandet(IkkeGivet) == Falskt
        && benådning_af_rigsretsdømt_minister_opfylder_par24(Givet)
        && benådning_af_rigsretsdømt_minister_opfylder_par24(IkkeGivet) == Falskt
        && rigsretssag_med_samtykke.kan_påkendes_efter_par60()
        && rigsretssag_uden_samtykke.kan_påkendes_efter_par60() == Falskt
    )
}

| procedurer_fælles_medlemstærskler_validerer_optællingen() -> {
    = to_femtedele = Brøk(tæller = 2, nævner = 5)
    = en_tredjedel = Brøk(tæller = 1, nævner = 3)
    = tooghalvfjerds_medlemmer = Medlemsopbakning(antal = 72, medlemmer_i_alt = 179)
    = enoghalvfjerds_medlemmer = Medlemsopbakning(antal = 71, medlemmer_i_alt = 179)
    = tres_medlemmer = Medlemsopbakning(antal = 60, medlemmer_i_alt = 179)
    = nioghalvtreds_medlemmer = Medlemsopbakning(antal = 59, medlemmer_i_alt = 179)
    = umulig_opbakning = Medlemsopbakning(antal = 180, medlemmer_i_alt = 179)
    (
        medlemsopbakning_er_mindst(tooghalvfjerds_medlemmer, to_femtedele)
        && medlemsopbakning_er_mindst(enoghalvfjerds_medlemmer, to_femtedele) == Falskt
        && medlemsopbakning_er_mindst(tres_medlemmer, en_tredjedel)
        && medlemsopbakning_er_mindst(nioghalvtreds_medlemmer, en_tredjedel) == Falskt
        && medlemsopbakning_er_mindst(umulig_opbakning, en_tredjedel) == Falskt
    )
}

--@label:audit_procedurer_taerskler::meta:procedurer_taerskler_fund--
--@begin:audit_procedurer_taerskler--
| procedurer_par42_har_strengt_flertal_og_inklusiv_tredive_procent() -> {
    = forkastet = Folkeafstemningsresultat(
        mod_stemmer = 30,
        deltagende = 59,
        stemmeberettigede = 100
    )
    = ikke_strengt_flertal = Folkeafstemningsresultat(
        mod_stemmer = 30,
        deltagende = 60,
        stemmeberettigede = 100
    )
    = under_tredive_procent = Folkeafstemningsresultat(
        mod_stemmer = 29,
        deltagende = 57,
        stemmeberettigede = 100
    )
    (
        lovforslag_forkastet_ved_folkeafstemning(forkastet)
        && lovforslag_forkastet_ved_folkeafstemning(ikke_strengt_flertal) == Falskt
        && lovforslag_forkastet_ved_folkeafstemning(under_tredive_procent) == Falskt
    )
}

| procedurer_par73_har_inklusiv_tredjedel_og_tre_soegnedage() -> {
    = rettidig_tredjedel = Ekspropriationsudsættelsesbegæring(
        lovforslag_vedrører_ekspropriation_af_ejendom = Sandt,
        lovforslag_endeligt_vedtaget = Sandt,
        opbakning = Medlemsopbakning(antal = 60, medlemmer_i_alt = 179),
        søgnedage_efter_endelig_vedtagelse = 3
    )
    = under_tredjedel = Ekspropriationsudsættelsesbegæring(
        lovforslag_vedrører_ekspropriation_af_ejendom = Sandt,
        lovforslag_endeligt_vedtaget = Sandt,
        opbakning = Medlemsopbakning(antal = 59, medlemmer_i_alt = 179),
        søgnedage_efter_endelig_vedtagelse = 3
    )
    = for_sen_begæring = Ekspropriationsudsættelsesbegæring(
        lovforslag_vedrører_ekspropriation_af_ejendom = Sandt,
        lovforslag_endeligt_vedtaget = Sandt,
        opbakning = Medlemsopbakning(antal = 60, medlemmer_i_alt = 179),
        søgnedage_efter_endelig_vedtagelse = 4
    )
    (
        rettidig_tredjedel.opfylder_par73_stk2()
        && under_tredjedel.opfylder_par73_stk2() == Falskt
        && for_sen_begæring.opfylder_par73_stk2() == Falskt
    )
}

| procedurer_par88_har_strengt_flertal_og_inklusiv_fyrre_procent() -> {
    = godkendt = Grundlovsafstemningsresultat(
        for_stemmer = 40,
        deltagende = 79,
        stemmeberettigede = 100
    )
    = ikke_strengt_flertal = Grundlovsafstemningsresultat(
        for_stemmer = 40,
        deltagende = 80,
        stemmeberettigede = 100
    )
    = under_fyrre_procent = Grundlovsafstemningsresultat(
        for_stemmer = 39,
        deltagende = 77,
        stemmeberettigede = 100
    )
    = umuligt_stemmetal = Grundlovsafstemningsresultat(
        for_stemmer = 101,
        deltagende = 100,
        stemmeberettigede = 100
    )
    (
        godkendt.opfylder_godkendelseskravet_i_par88()
        && ikke_strengt_flertal.opfylder_godkendelseskravet_i_par88() == Falskt
        && under_fyrre_procent.opfylder_godkendelseskravet_i_par88() == Falskt
        && umuligt_stemmetal.opfylder_godkendelseskravet_i_par88() == Falskt
    )
}
--@end:audit_procedurer_taerskler--

| procedurer_par88_adskiller_udloeser_fuldt_forloeb_og_retsvirkning() -> {
    = udløsende_forslagsforløb = Grundlovsforslagsforløb(
        første_folketing_har_vedtaget = Sandt,
        regeringen_vil_fremme_sagen = Sandt,
        nyvalg_til_folketinget_udskrevet = Falskt,
        det_følgende_folketing_har_vedtaget = Falskt,
        skikkelse_ved_genvedtagelsen = UændretSkikkelse
    )
    = fuldført_forslagsforløb = Grundlovsforslagsforløb(
        første_folketing_har_vedtaget = Sandt,
        regeringen_vil_fremme_sagen = Sandt,
        nyvalg_til_folketinget_udskrevet = Sandt,
        det_følgende_folketing_har_vedtaget = Sandt,
        skikkelse_ved_genvedtagelsen = UændretSkikkelse
    )
    = godkendende_afstemning = Grundlovsafstemning(
        forelæggelsestidspunkt = IndenEtHalvtÅrEfterEndeligVedtagelse,
        forelagt_ved_direkte_afstemning = Sandt,
        resultat = Grundlovsafstemningsresultat(
            for_stemmer = 40,
            deltagende = 79,
            stemmeberettigede = 100
        )
    )
    = ikke_stadfæstet_sag = Grundlovsændringssag(
        forslagsforløb = fuldført_forslagsforløb,
        afstemning = godkendende_afstemning,
        stadfæstet_af_kongen = Falskt
    )
    (
        udløsende_forslagsforløb.udløser_nyvalg_efter_par88()
        && udløsende_forslagsforløb.opfylder_forslagsforløbet_i_par88() == Falskt
        && ikke_stadfæstet_sag.bliver_grundlov_efter_par88() == Falskt
    )
}

| procedurer_audit_består() -> (
    procedurer_samtykke_er_positivt_og_manglende_samtykke_negativt()
    && procedurer_fælles_medlemstærskler_validerer_optællingen()
    && procedurer_par42_har_strengt_flertal_og_inklusiv_tredive_procent()
    && procedurer_par73_har_inklusiv_tredjedel_og_tre_soegnedage()
    && procedurer_par88_har_strengt_flertal_og_inklusiv_fyrre_procent()
    && procedurer_par88_adskiller_udloeser_fuldt_forloeb_og_retsvirkning()
)

= procedurer_audit_resultat = procedurer_audit_består()
| procedurer_audit_holder: procedurer_audit_resultat -> procedurer_audit_resultat == Sandt

? procedurer_audit_holder
