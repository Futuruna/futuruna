@ sprog da

@ importer ./grundlov - faelles

-- Kapitel VIII -- Borgernes rettigheder

--@label:grundlov_par71::meta:grundlov_kildemetadata--
----
§ 71. Stk. 1. Den personlige frihed er ukrænkelig. Ingen dansk borger kan på
grund af sin politiske eller religiøse overbevisning eller sin afstamning
underkastes nogen form for frihedsberøvelse.

Stk. 2. Frihedsberøvelse kan kun finde sted med hjemmel i loven.

Stk. 3. Enhver, der anholdes, skal inden 24 timer stilles for en dommer. Hvis
den anholdte ikke straks kan sættes på fri fod, skal dommeren ved en af grunde
ledsaget kendelse, der afsiges snarest muligt og senest inden tre dage, afgøre,
om han skal fængsles, og, hvis han kan løslades mod sikkerhed, bestemme dennes
art og størrelse. Denne bestemmelse kan for Grønlands vedkommende fraviges ved
lov, forsåvidt dette efter de stedlige forhold må anses for påkrævet.

Stk. 4. Den kendelse, som dommeren afsiger, kan af vedkommende straks særskilt
indbringes for højere ret.

Stk. 5. Ingen kan underkastes varetægtsfængsel for en forseelse, som kun kan
medføre straf af bøde eller hæfte.

Stk. 6. Udenfor strafferetsplejen skal lovligheden af en frihedsberøvelse, der
ikke er besluttet af en dømmende myndighed, og som ikke har hjemmel i
lovgivningen om udlændinge, på begæring af den, der er berøvet sin frihed,
eller den, der handler på hans vegne, forelægges de almindelige domstole eller
anden dømmende myndighed til prøvelse. Nærmere regler herom fastsættes ved lov.

Stk. 7. Behandlingen af de i stk. 6 nævnte personer undergives et af
folketinget valgt tilsyn, hvortil de pågældende skal have adgang til at rette
henvendelse.
----

--@begin:grundlov_par71--

# PersonkredsPar71 = DanskBorger | AndenPerson
# Frihedsberøvelsesgrund = PolitiskOverbevisning | ReligiøsOverbevisning | AfstamningSomFrihedsberøvelsesgrund | AndenFrihedsberøvelsesgrund
# Frihedsberøvelsessag(personkreds: PersonkredsPar71, grund: Frihedsberøvelsesgrund, har_lovhjemmel: Boolsk) {
    | grund_er_beskyttet_efter_stk1() -> match grund {
        | PolitiskOverbevisning -> Sandt
        | ReligiøsOverbevisning -> Sandt
        | AfstamningSomFrihedsberøvelsesgrund -> Sandt
        | AndenFrihedsberøvelsesgrund -> Falskt
    }

    | opfylder_par71_stk1_og_2() -> har_lovhjemmel
    | exception dansk_borger_og_beskyttet_grund opfylder_par71_stk1_og_2() -> Falskt under personkreds == DanskBorger && grund_er_beskyttet_efter_stk1()
}

| personlig_frihed_er_ukrænkelig()

= frist_fremstilling_timer = 24
= frist_kendelse_dage = 3

# Anholdelsesforløb(timer_til_fremstilling_for_dommer: Heltal, straks_løsladt: Boolsk, kendelse_afsagt_snarest_muligt: Boolsk, dage_til_kendelse: Heltal, kendelse_begrundet: Boolsk, fængslingsspørgsmålet_afgjort: Boolsk, løsladelse_mod_sikkerhed_mulig: Boolsk, sikkerhedens_art_og_størrelse_bestemt: Boolsk) {
    | tidsangivelser_er_konsistente() -> timer_til_fremstilling_for_dommer >= 0 && dage_til_kendelse >= 0
    | opfylder_hovedreglen_i_par71_stk3() -> tidsangivelser_er_konsistente() && timer_til_fremstilling_for_dommer <= frist_fremstilling_timer && hvis straks_løsladt {
        Sandt
    } ellers {
        kendelse_afsagt_snarest_muligt && dage_til_kendelse <= frist_kendelse_dage && kendelse_begrundet && fængslingsspørgsmålet_afgjort && (løsladelse_mod_sikkerhed_mulig == Falskt || sikkerhedens_art_og_størrelse_bestemt)
    }
}

# Fremstillingssag(sted: Rigsdel, forløb: Anholdelsesforløb, grønlandsk_fravigelse_hjemlet_ved_lov: Boolsk, stedlige_forhold_gør_fravigelse_påkrævet: Boolsk) {
    | opfylder_par71_stk3() -> forløb.opfylder_hovedreglen_i_par71_stk3()
    | exception grønlandsk_lovfravigelse opfylder_par71_stk3() -> forløb.tidsangivelser_er_konsistente() under sted == Grønland && grønlandsk_fravigelse_hjemlet_ved_lov && stedlige_forhold_gør_fravigelse_påkrævet
}

# Kendelsesanke(straks_indbragt: Boolsk, særskilt_indbragt: Boolsk, indbragt_for_højere_ret: Boolsk)
| kendelsesanke_opfylder_par71_stk4(anke: Kendelsesanke) -> anke.straks_indbragt && anke.særskilt_indbragt && anke.indbragt_for_højere_ret

# Forseelsesstraf = KunBødeEllerHæfte | KanMedføreAndenStraf
| varetægtsfængsling_opfylder_par71_stk5(straf: Forseelsesstraf) -> straf != KunBødeEllerHæfte

# Frihedsberøvelsesbeslutning = BesluttetAfDømmendeMyndighed | IkkeBesluttetAfDømmendeMyndighed
# Prøvelsesbegærer = DenFrihedsberøvede | RepræsentantForDenFrihedsberøvede | IngenPrøvelsesbegærer
# PrøvelsesvejPar71 = AlmindeligeDomstole | AndenDømmendeMyndighed | IngenPrøvelsesvej
# AdministrativFrihedsberøvelse(hører_til_strafferetsplejen: Boolsk, beslutning: Frihedsberøvelsesbeslutning, har_hjemmel_i_udlændingelovgivningen: Boolsk, begærer: Prøvelsesbegærer, prøvelsesvej: PrøvelsesvejPar71) {
    | person_er_omfattet_af_par71_stk6() -> hører_til_strafferetsplejen == Falskt && beslutning == IkkeBesluttetAfDømmendeMyndighed && har_hjemmel_i_udlændingelovgivningen == Falskt
    | prøvelse_er_begæret_af_berettiget() -> begærer == DenFrihedsberøvede || begærer == RepræsentantForDenFrihedsberøvede
    | prøvelsespligt_indtræder_efter_par71_stk6() -> person_er_omfattet_af_par71_stk6() && prøvelse_er_begæret_af_berettiget()
    | prøvelsesforløb_opfylder_par71_stk6() -> hvis prøvelsespligt_indtræder_efter_par71_stk6() {
        prøvelsesvej == AlmindeligeDomstole || prøvelsesvej == AndenDømmendeMyndighed
    } ellers {
        Sandt
    }
}

| prøvelse_af_frihedsberøvelse_fastsættes_ved_lov()

# TilsynsforløbPar71(frihedsberøvelse: AdministrativFrihedsberøvelse, folketinget_har_valgt_tilsyn: Boolsk, den_frihedsberøvede_har_adgang_til_henvendelse: Boolsk) {
    | opfylder_par71_stk7() -> hvis frihedsberøvelse.person_er_omfattet_af_par71_stk6() {
        folketinget_har_valgt_tilsyn && den_frihedsberøvede_har_adgang_til_henvendelse
    } ellers {
        Sandt
    }
}
--@end:grundlov_par71--

--@label:grundlov_par72::meta:grundlov_kildemetadata--
----
§ 72. Boligen er ukrænkelig. Husundersøgelse, beslaglæggelse og undersøgelse
af breve og andre papirer samt brud på post-, telegraf- og telefonhemmeligheden
må, hvor ingen lov hjemler en særegen undtagelse, alene ske efter en
retskendelse.
----

--@begin:grundlov_par72--

# Privatlivsindgreb = Husundersøgelse | Beslaglæggelse | UndersøgelseAfBreveOgAndrePapirer | BrudPåPostTelegrafEllerTelefonhemmeligheden
# Privatlivsindgrebssag(indgreb: Privatlivsindgreb, retskendelse_foreligger: Boolsk, særegen_undtagelse_hjemlet_ved_lov: Boolsk) {
    | indgreb_er_omfattet() -> match indgreb {
        | Husundersøgelse -> Sandt
        | Beslaglæggelse -> Sandt
        | UndersøgelseAfBreveOgAndrePapirer -> Sandt
        | BrudPåPostTelegrafEllerTelefonhemmeligheden -> Sandt
    }

    | opfylder_par72() -> indgreb_er_omfattet() && retskendelse_foreligger
    | exception særegen_lovundtagelse opfylder_par72() -> indgreb_er_omfattet() under særegen_undtagelse_hjemlet_ved_lov
}

| boligen_er_ukrænkelig()
--@end:grundlov_par72--

--@label:grundlov_par73::meta:grundlov_kildemetadata--
----
§ 73. Stk. 1. Ejendomsretten er ukrænkelig. Ingen kan tilpligtes at afstå sin
ejendom, uden hvor almenvellet kræver det. Det kan kun ske ifølge lov og mod
fuldstændig erstatning.

Stk. 2. Når et lovforslag vedrørende ekspropriation af ejendom er vedtaget,
kan en trediedel af folketingets medlemmer indenfor en frist af tre søgnedage
fra forslagets endelige vedtagelse kræve, at det først indstilles til kongelig
stadfæstelse, når nyvalg til folketinget har fundet sted, og forslaget påny er
vedtaget af det derefter sammentrædende folketing.

Stk. 3. Ethvert spørgsmål om ekspropriationsaktens lovlighed og erstatningens
størrelse kan indbringes for domstolene. Prøvelsen af erstatningens størrelse
kan ved lov henlægges til domstole oprettet i dette øjemed.
----

--@begin:grundlov_par73--

# Ekspropriationssag(almenvellet_kræver_afståelsen: Boolsk, afståelsen_sker_ifølge_lov: Boolsk, fuldstændig_erstatning_ydes: Boolsk) {
    | opfylder_par73_stk1() -> almenvellet_kræver_afståelsen && afståelsen_sker_ifølge_lov && fuldstændig_erstatning_ydes
}

| ejendomsretten_er_ukrænkelig()

= ekspropriation_frist_søgnedage = 3
= ekspropriationsbegæringens_medlemstærskel = Brøk(tæller = 1, nævner = 3)

# Ekspropriationsudsættelsesbegæring(lovforslag_vedrører_ekspropriation_af_ejendom: Boolsk, lovforslag_endeligt_vedtaget: Boolsk, opbakning: Medlemsopbakning, søgnedage_efter_endelig_vedtagelse: Heltal) {
    | opfylder_par73_stk2() -> lovforslag_vedrører_ekspropriation_af_ejendom && lovforslag_endeligt_vedtaget && medlemsopbakning_er_mindst(opbakning, ekspropriationsbegæringens_medlemstærskel) && søgnedage_efter_endelig_vedtagelse >= 0 && søgnedage_efter_endelig_vedtagelse <= ekspropriation_frist_søgnedage
}

# Ekspropriationsstadfæstelsesforløb(begæring: Ekspropriationsudsættelsesbegæring, nyvalg_til_folketinget_afholdt: Boolsk, forslaget_genvedtaget_af_det_nye_folketing: Boolsk) {
    | opfylder_par73_stk2() -> hvis begæring.opfylder_par73_stk2() {
        nyvalg_til_folketinget_afholdt && forslaget_genvedtaget_af_det_nye_folketing
    } ellers {
        Sandt
    }
}

# Ekspropriationsprøvelsesemne = EkspropriationsaktensLovlighed | ErstatningensStørrelse
# Ekspropriationsprøvelsesvej = AlmindeligeDomstoleSomPrøvelsesvej | SærligErstatningsdomstol(oprettet_ved_lov: Boolsk)
# Ekspropriationsprøvelse(emne: Ekspropriationsprøvelsesemne, vej: Ekspropriationsprøvelsesvej) {
    | opfylder_par73_stk3() -> match emne {
        | EkspropriationsaktensLovlighed -> vej == AlmindeligeDomstoleSomPrøvelsesvej
        | ErstatningensStørrelse -> match vej {
            | AlmindeligeDomstoleSomPrøvelsesvej -> Sandt
            | SærligErstatningsdomstol(oprettet_ved_lov) -> oprettet_ved_lov
        }
    }
}
--@end:grundlov_par73--

--@label:grundlov_par74::meta:grundlov_kildemetadata--
----
§ 74. Alle indskrænkninger i den fri og lige adgang til erhverv, som ikke er
begrundede i det almene vel, skal hæves ved lov.
----

--@begin:grundlov_par74--

# Erhvervsindskrænkning(begrundet_i_det_almene_vel: Boolsk, hævet_ved_lov: Boolsk) {
    | opfylder_par74() -> hvis begrundet_i_det_almene_vel {
        Sandt
    } ellers {
        hævet_ved_lov
    }
}
--@end:grundlov_par74--

--@label:grundlov_par75::meta:grundlov_kildemetadata--
----
§ 75. Stk. 1. Til fremme af almenvellet bør det tilstræbes, at enhver
arbejdsduelig borger har mulighed for arbejde på vilkår, der betrygger hans
tilværelse.

Stk. 2. Den, der ikke selv kan ernære sig eller sine, og hvis forsørgelse ikke
påhviler nogen anden, er berettiget til hjælp af det offentlige, dog mod at
underkaste sig de forpligtelser, som loven herom påbyder.
----

--@begin:grundlov_par75--

# Arbejdsmulighedsmålsætning(tilstræbt_til_fremme_af_almenvellet: Boolsk, arbejdsduelig_borger_har_mulighed_for_arbejde: Boolsk, arbejdsvilkår_betrygger_tilværelsen: Boolsk) {
    | tilstræbelsen_opfylder_ordlydens_modalitet_i_par75_stk1() -> tilstræbt_til_fremme_af_almenvellet
    | målsætningens_tilsigtede_tilstand_er_opnået() -> arbejdsduelig_borger_har_mulighed_for_arbejde && arbejdsvilkår_betrygger_tilværelsen
}

# OffentligHjælpssag(kan_selv_ernære_sig_eller_sine: Boolsk, forsørgelsen_påhviler_en_anden: Boolsk, underkaster_sig_lovpåbudte_forpligtelser: Boolsk) {
    | har_ret_til_offentlig_hjælp_efter_par75_stk2() -> kan_selv_ernære_sig_eller_sine == Falskt && forsørgelsen_påhviler_en_anden == Falskt && underkaster_sig_lovpåbudte_forpligtelser
}
--@end:grundlov_par75--

--@label:grundlov_par76::meta:grundlov_kildemetadata--
----
§ 76. Alle børn i den undervisningspligtige alder har ret til fri undervisning i
folkeskolen. Forældre eller værger, der selv sørger for, at børnene får en
undervisning, der kan stå mål med, hvad der almindeligvis kræves i folkeskolen,
er ikke pligtige at lade børnene undervise i folkeskolen.
----

--@begin:grundlov_par76--

# Undervisningssag(barn_i_undervisningspligtig_alder: Boolsk, forældre_eller_værger_sørger_selv_for_undervisning: Boolsk, undervisningen_står_mål_med_folkeskolen: Boolsk) {
    | barn_har_ret_til_fri_undervisning_i_folkeskolen() -> barn_i_undervisningspligtig_alder
    | fritaget_fra_pligt_til_undervisning_i_folkeskolen() -> barn_i_undervisningspligtig_alder && forældre_eller_værger_sørger_selv_for_undervisning && undervisningen_står_mål_med_folkeskolen
}
--@end:grundlov_par76--

--@label:grundlov_par77::meta:grundlov_kildemetadata--
----
§ 77. Enhver er berettiget til på tryk, i skrift og tale at offentliggøre sine
tanker, dog under ansvar for domstolene. Censur og andre forebyggende
forholdsregler kan ingensinde påny indføres.
----

--@begin:grundlov_par77--

# Offentliggørelsesform = Tryk | Skrift | Tale
# Ytringssag(form: Offentliggørelsesform) {
    | retten_til_at_offentliggøre_tanker_omfatter_formen() -> match form {
        | Tryk -> Sandt
        | Skrift -> Sandt
        | Tale -> Sandt
    }
    | offentliggørelse_er_under_ansvar_for_domstolene() -> Sandt
}

# ForebyggendeYtringsforholdsregel = Censur | AndenForebyggendeForholdsregel
| forebyggende_ytringsforholdsregel_kan_indføres_efter_par77(forholdsregel: ForebyggendeYtringsforholdsregel) -> Falskt
--@end:grundlov_par77--

--@label:grundlov_par78::meta:grundlov_kildemetadata--
----
§ 78. Stk. 1. Borgerne har ret til uden forudgående tilladelse at danne
foreninger i ethvert lovligt øjemed.

Stk. 2. Foreninger, der virker ved eller søger at nå deres mål ved vold,
anstiftelse af vold eller lignende strafbar påvirkning af anderledes tænkende,
bliver at opløse ved dom.

Stk. 3. Ingen forening kan opløses ved en regeringsforanstaltning. Dog kan en
forening foreløbig forbydes, men der skal da straks anlægges sag imod den til
dens opløsning.

Stk. 4. Sager om opløsning af politiske foreninger skal uden særlig tilladelse
kunne indbringes for rigets øverste domstol.

Stk. 5. Opløsningens retsvirkninger fastsættes nærmere ved lov.
----

--@begin:grundlov_par78--

# Foreningsformål = LovligtFormål | UlovligtFormål
| forening_kan_dannes_uden_forudgående_tilladelse(formål: Foreningsformål) -> formål == LovligtFormål

# StrafbarForeningspåvirkning = Vold | AnstiftelseAfVold | LignendeStrafbarPåvirkningAfAnderledesTænkende
# Foreningsvirke = VirkerVed(påvirkning: StrafbarForeningspåvirkning) | SøgerAtNåSitMålVed(påvirkning: StrafbarForeningspåvirkning) | AndetForeningsvirke
| forening_skal_opløses_ved_dom(virke: Foreningsvirke) -> match virke {
    | VirkerVed(_) -> Sandt
    | SøgerAtNåSitMålVed(_) -> Sandt
    | AndetForeningsvirke -> Falskt
}

# Foreningsindgreb = OpløsningVedRegeringsforanstaltning | ForeløbigtForbud(sag_til_opløsning_straks_anlagt: Boolsk)
| foreningsindgreb_opfylder_par78_stk3(indgreb: Foreningsindgreb) -> match indgreb {
    | OpløsningVedRegeringsforanstaltning -> Falskt
    | ForeløbigtForbud(sag_straks_anlagt) -> sag_straks_anlagt
}

| politisk_forenings_opløsningssag_kan_indbringes_for_rigets_øverste_domstol(særlig_tilladelse_kræves: Boolsk) -> særlig_tilladelse_kræves == Falskt
| opløsningens_retsvirkninger_fastsættes_ved_lov()
--@end:grundlov_par78--

--@label:grundlov_par79::meta:grundlov_kildemetadata--
----
§ 79. Borgerne har ret til uden forudgående tilladelse at samle sig ubevæbnede.
Offentlige forsamlinger har politiet ret til at overvære. Forsamlinger under
åben himmel kan forbydes, når der af dem kan befrygtes fare for den offentlige
fred.
----

--@begin:grundlov_par79--

# Forsamlingssag(ubevæbnet: Boolsk, offentlig: Boolsk, under_åben_himmel: Boolsk, fare_for_den_offentlige_fred: Boolsk) {
    | kan_samles_uden_forudgående_tilladelse() -> ubevæbnet
    | politiet_har_ret_til_at_overvære() -> offentlig
    | kan_forbydes_efter_par79() -> under_åben_himmel && fare_for_den_offentlige_fred
}
--@end:grundlov_par79--

--@label:grundlov_par80::meta:grundlov_kildemetadata--
----
§ 80. Ved opløb må den væbnede magt, når den ikke angribes, kun skride ind,
efter at mængden tre gange i kongens og lovens navn forgæves er opfordret til at
skilles.
----

--@begin:grundlov_par80--

= opfordringer_før_magtanvendelse = 3

# Opløbssituation(den_væbnede_magt_angribes: Boolsk, forgæves_opfordringer_til_at_skilles: Heltal, opfordret_i_kongens_og_lovens_navn: Boolsk) {
    | opfordringsantal_er_konsistent() -> forgæves_opfordringer_til_at_skilles >= 0
    | den_væbnede_magt_kan_skride_ind_efter_par80() -> opfordringsantal_er_konsistent() && forgæves_opfordringer_til_at_skilles >= opfordringer_før_magtanvendelse && opfordret_i_kongens_og_lovens_navn
    | exception angrebet den_væbnede_magt_kan_skride_ind_efter_par80() -> opfordringsantal_er_konsistent() under den_væbnede_magt_angribes
}
--@end:grundlov_par80--

--@label:grundlov_par81::meta:grundlov_kildemetadata--
----
§ 81. Enhver våbenfør mand er forpligtet til med sin person at bidrage til
fædrelandets forsvar efter de nærmere bestemmelser, som loven foreskriver.
----

--@begin:grundlov_par81--

# Våbenførhed = Våbenfør | IkkeVåbenfør
# Værnepligtslovgrundlag = NærmereBestemmelserFastsatVedLov | NærmereBestemmelserIkkeFastsatVedLov
# Værnepligtssag(våbenførhed: Våbenførhed, køn: Køn, lovgrundlag: Værnepligtslovgrundlag) {
    | er_forpligtet_til_personligt_at_bidrage_til_fædrelandets_forsvar() -> våbenførhed == Våbenfør && køn == Mand
    | opfylder_par81() -> hvis er_forpligtet_til_personligt_at_bidrage_til_fædrelandets_forsvar() {
        lovgrundlag == NærmereBestemmelserFastsatVedLov
    } ellers {
        Sandt
    }
}
--@end:grundlov_par81--

--@label:grundlov_par82::meta:grundlov_kildemetadata--
----
§ 82. Kommunernes ret til under statens tilsyn selvstændigt at styre deres
anliggender ordnes ved lov.
----

--@begin:grundlov_par82--

# KommunalStyrelsesordning(selvstændig_styring_af_egne_anliggender: Boolsk, under_statens_tilsyn: Boolsk, ordnet_ved_lov: Boolsk) {
    | opfylder_par82() -> selvstændig_styring_af_egne_anliggender && under_statens_tilsyn && ordnet_ved_lov
}
--@end:grundlov_par82--

--@label:grundlov_par83::meta:grundlov_kildemetadata--
----
§ 83. Enhver i lovgivningen til adel, titel og rang knyttet forret er afskaffet.
----

--@begin:grundlov_par83--

# Forretsgrundlag = Adel | Titel | Rang
| forret_knyttet_i_lovgivningen_er_afskaffet(grundlag: Forretsgrundlag) -> match grundlag {
    | Adel -> Sandt
    | Titel -> Sandt
    | Rang -> Sandt
}
--@end:grundlov_par83--

--@label:grundlov_par84::meta:grundlov_kildemetadata--
----
§ 84. Intet len, stamhus, fideikommisgods eller andet familiefideikommis kan for
fremtiden oprettes.
----

--@begin:grundlov_par84--

# Familiefideikommisform = Len | Stamhus | Fideikommisgods | AndetFamiliefideikommis
| familiefideikommis_kan_oprettes_for_fremtiden(form: Familiefideikommisform) -> Falskt
--@end:grundlov_par84--

--@label:grundlov_par85::meta:grundlov_kildemetadata--
----
§ 85. For forsvarsmagten er de i §§ 71, 78 og 79 givne bestemmelser kun
anvendelige med de indskrænkninger, der følger af de militære loves forskrifter.
----

--@begin:grundlov_par85--

# Frihedsbestemmelse = PersonligFrihedPar71 | YtringsfrihedPar77 | ForeningsfrihedPar78 | ForsamlingsfrihedPar79
# MilitærIndskrænkning(bestemmelse: Frihedsbestemmelse, følger_af_militære_loves_forskrifter: Boolsk) {
    | bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() -> match bestemmelse {
        | PersonligFrihedPar71 -> Sandt
        | YtringsfrihedPar77 -> Falskt
        | ForeningsfrihedPar78 -> Sandt
        | ForsamlingsfrihedPar79 -> Sandt
    }

    | opfylder_par85() -> bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() && følger_af_militære_loves_forskrifter
}
--@end:grundlov_par85--
