= frist_fremstilling_timer = 24
= frist_kendelse_dage = 3

| anholdte_stilles_for_dommer_inden_24_timer()
| kendelse_snarest_muligt_senest_3_dage()
| løsladelse_mod_sikkerhed_mulig()
| grønland_kan_fravige_fremstillingsfrist_ved_lov()

-- Stk. 4
