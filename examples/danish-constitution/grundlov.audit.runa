| par3_par64_lovbundethed: dommere_retter_sig_alene_efter_loven() -> dommere_retter_sig_alene_efter_loven()

-- Tværgående: par. 16 vs par. 60 — rigsretten gentager ministreansvaret
-- § 16 (kap. III): rigsretten påkender ministersager.
-- § 60 (kap. VI): rigsretten påkender sager anlagt af kongen eller folketinget.
= par60_ministersag_fra_kongen = Rigsretssag(tiltaler = KongenSomRigsretstiltaler, tiltalt = Minister, folketingets_samtykke = IkkeGivet).kan_påkendes_efter_par60()
= par60_ministersag_fra_folketinget = Rigsretssag(tiltaler = FolketingetSomRigsretstiltaler, tiltalt = Minister, folketingets_samtykke = IkkeGivet).kan_påkendes_efter_par60()
| par16_par60_kongen: par60_ministersag_fra_kongen -> par60_ministersag_fra_kongen
| par16_par60_folketinget: par60_ministersag_fra_folketinget -> par60_ministersag_fra_folketinget

-- Tværgående: par. 27 stk. 3 og par. 64 — forskellige forflyttelsesbetingelser
= par27_forflyttelse_uden_indkomsttab_og_med_valg = forflyttelse_af_kongeligt_udnævnt_tjenestemand_opfylder_par27(ForflyttelseUdenSamtykke(
    indkomsttab = Falskt,
    valg_mellem_forflyttelse_og_afsked_med_pension = Sandt
))
= par64_forflyttelse_uden_omordning = dommerindgreb_opfylder_par64(ForflyttelseModØnske(
    omordning_af_domstolene_finder_sted = Falskt
))
| par27_par64_forskellige_forflyttelsesbetingelser: par27_forflyttelse_uden_indkomsttab_og_med_valg -> par27_forflyttelse_uden_indkomsttab_og_med_valg && par64_forflyttelse_uden_omordning == Falskt

-- Tværgående: par. 6 og par. 70 — troskrav og rettighedsberøvelse
-- Kildemodellen viser begge ordlydsnære krav. Om kongestillingen er en
-- borgerlig eller politisk rettighed efter § 70, afgøres ikke her.
= par70_trosbaseret_borgerlig_rettighedsberøvelse = Par70Sag(
    grund = Trosbekendelse,
    virkning = BerøvelseAfRettighed(rettighed = BorgerligRettighed),
    virkningen_sker_på_grund_af_grunden = Sandt
).opfylder_par70()
| par6_par70_ordlydsnære_resultater: par6_luthersk -> par6_luthersk && par6_katolsk == Falskt && par70_trosbaseret_borgerlig_rettighedsberøvelse == Falskt

-- Tværgående: par. 4 og par. 67-68 — understøttelse og individuel religionsudøvelse
= par67_beskyttet_lære = Religionsudøvelse(
    udtryk = Lære,
    stemmer_med_overbevisningen = Sandt,
    strider_mod_sædeligheden = Falskt,
    strider_mod_den_offentlige_orden = Falskt
).er_beskyttet_efter_par67()
= par68_intet_pligtbidrag_til_anden_gudsdyrkelse = PersonligtBidragsforhold(
    gudsdyrkelse = AndenGudsdyrkelse,
    bidragspligt_pålagt = Falskt
).opfylder_par68()
| par4_par67_understøttelse_og_religionsudøvelse: staten_understøtter_folkekirken() -> staten_understøtter_folkekirken() && par67_beskyttet_lære
| par4_par68_understøttelse_og_personligt_bidrag: staten_understøtter_folkekirken() -> staten_understøtter_folkekirken() && par68_intet_pligtbidrag_til_anden_gudsdyrkelse

-- Tværgående: par. 42 stk. 1 og par. 73 stk. 2 deler 1/3-tærskel
| tærskel_symmetri_42_73: par42_1f3 -> par42_1f3 == par73_1f3

-- Tværgående: par. 34 vs par. 71 — ukrænkelighed
-- § 34: folketinget er ukrænkeligt. § 71: personlig frihed er ukrænkelig.
-- § 72: boligen er ukrænkelig. § 73: ejendomsretten er ukrænkelig.
-- Fire ukrænkeligheder med forskellige undtagelsesmekanismer.
| ukrænkelighed_folketinget: folketinget_er_ukrænkeligt() -> folketinget_er_ukrænkeligt()
| ukrænkelighed_person: personlig_frihed_er_ukrænkelig() -> personlig_frihed_er_ukrænkelig()
| ukrænkelighed_bolig: boligen_er_ukrænkelig() -> boligen_er_ukrænkelig()
| ukrænkelighed_ejendom: ejendomsretten_er_ukrænkelig() -> ejendomsretten_er_ukrænkelig()

-- Tværgående: par. 61 og par. 73 stk. 3 — to ordlydsnære domstolsregler
-- Kildemodellen afgør ikke, om en domstol oprettet til erstatningsprøvelse
-- skal klassificeres som en særdomstol efter § 61 eller som en undtagelse.
= par61_særdomstol_kan_nedsættes = særdomstol_med_dømmende_myndighed_kan_nedsættes_efter_par61()
= par73_særlig_erstatningsdomstol = Ekspropriationsprøvelse(
    emne = ErstatningensStørrelse,
    vej = SærligErstatningsdomstol(oprettet_ved_lov = Sandt)
).opfylder_par73_stk3()
| par61_par73_ordlydsnære_domstolsresultater: par61_særdomstol_kan_nedsættes -> par61_særdomstol_kan_nedsættes == Falskt && par73_særlig_erstatningsdomstol

-- Tværgående: par. 43 vs par. 73 — beskatning vs ekspropriation
-- § 43: skat kræver lov. § 73: ekspropriation kræver fuldstændig erstatning.
-- Kildemodellen rummer ikke en klassifikationsregel, som afgør, hvornår en
-- økonomisk byrde hører under den ene eller den anden bestemmelse.
| par43_skat_kræver_lov: ingen_skat_uden_lov() -> ingen_skat_uden_lov()
= par73_ekspropriation_med_alle_betingelser = Ekspropriationssag(
    almenvellet_kræver_afståelsen = Sandt,
    afståelsen_sker_ifølge_lov = Sandt,
    fuldstændig_erstatning_ydes = Sandt
).opfylder_par73_stk1()
| par73_ekspropriation_kræver_alle_betingelser: par73_ekspropriation_med_alle_betingelser -> par73_ekspropriation_med_alle_betingelser

-- Par. 73 stk. 2: frist
| par73_frist: ekspropriation_frist_søgnedage -> ekspropriation_frist_søgnedage == 3

-- Par. 80: tre opfordringer før magtanvendelse
| par80_opfordringer: opfordringer_før_magtanvendelse -> opfordringer_før_magtanvendelse == 3

-- Delegationer (kap. VIII, §§ 75-85)
| delegation_opløsningens_retsvirkninger: opløsningens_retsvirkninger_fastsættes_ved_lov() -> opløsningens_retsvirkninger_fastsættes_ved_lov()
= audit_værnepligt_med_lovgrundlag = Værnepligtssag(
    våbenførhed = Våbenfør,
    køn = Mand,
    lovgrundlag = NærmereBestemmelserFastsatVedLov
)
= audit_kommunal_styrelsesordning = KommunalStyrelsesordning(
    selvstændig_styring_af_egne_anliggender = Sandt,
    under_statens_tilsyn = Sandt,
    ordnet_ved_lov = Sandt
)
| delegation_værnepligt: audit_værnepligt_med_lovgrundlag.opfylder_par81() -> audit_værnepligt_med_lovgrundlag.opfylder_par81()
| delegation_kommuner: audit_kommunal_styrelsesordning.opfylder_par82() -> audit_kommunal_styrelsesordning.opfylder_par82()

-- Tværgående: par. 85 — ordlydens udtrykkelige henvisninger
-- § 85 henviser til §§ 71, 78 og 79, men ikke § 77. Fraværet af en henvisning
-- afgør ikke i sig selv, hvilke andre retsgrundlag der kan begrænse en rettighed.
= par85_indskrænkning_par71 = MilitærIndskrænkning(bestemmelse = PersonligFrihedPar71, følger_af_militære_loves_forskrifter = Sandt)
= par85_indskrænkning_par77 = MilitærIndskrænkning(bestemmelse = YtringsfrihedPar77, følger_af_militære_loves_forskrifter = Sandt)
= par85_indskrænkning_par78 = MilitærIndskrænkning(bestemmelse = ForeningsfrihedPar78, følger_af_militære_loves_forskrifter = Sandt)
= par85_indskrænkning_par79 = MilitærIndskrænkning(bestemmelse = ForsamlingsfrihedPar79, følger_af_militære_loves_forskrifter = Sandt)
| par85_henviser_par71: par85_indskrænkning_par71.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() -> par85_indskrænkning_par71.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85()
| par85_henviser_par78: par85_indskrænkning_par78.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() -> par85_indskrænkning_par78.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85()
| par85_henviser_par79: par85_indskrænkning_par79.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() -> par85_indskrænkning_par79.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85()
| par85_henviser_ikke_par77: par85_indskrænkning_par77.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() -> par85_indskrænkning_par77.bestemmelsen_er_omfattet_af_ordlydens_henvisning_i_par85() == Falskt

-- Tværgående: par. 81 og par. 85 — pligt og lovbundne indskrænkninger
| par81_ordlydens_personkreds: audit_værnepligt_med_lovgrundlag.er_forpligtet_til_personligt_at_bidrage_til_fædrelandets_forsvar() -> audit_værnepligt_med_lovgrundlag.er_forpligtet_til_personligt_at_bidrage_til_fædrelandets_forsvar()
| par81_par85_lovgrundlag: audit_værnepligt_med_lovgrundlag.opfylder_par81() -> audit_værnepligt_med_lovgrundlag.opfylder_par81() && par85_indskrænkning_par71.opfylder_par85()

-- Tværgående: par. 70 vs par. 71 stk. 1 — diskriminationsgrundlag
-- § 70: trosbekendelse + afstamning (borgerlige/politiske rettigheder).
-- § 71: politisk overbevisning + religiøs overbevisning + afstamning (frihedsberøvelse).
-- Auditresultatet er en forskel i de udtrykkeligt nævnte grunde og virkninger,
-- ikke en rangordning af bestemmelsernes styrke.
= par70_trosbaseret_politisk_rettighedsberøvelse = Par70Sag(
    grund = Trosbekendelse,
    virkning = BerøvelseAfRettighed(rettighed = PolitiskRettighed),
    virkningen_sker_på_grund_af_grunden = Sandt
).opfylder_par70()
= par70_afstamningsbaseret_borgerlig_rettighedsberøvelse = Par70Sag(
    grund = AfstamningSomLigebehandlingsgrund,
    virkning = BerøvelseAfRettighed(rettighed = BorgerligRettighed),
    virkningen_sker_på_grund_af_grunden = Sandt
).opfylder_par70()
= par71_politisk_frihedsberøvelse_af_dansk_borger = Frihedsberøvelsessag(
    personkreds = DanskBorger,
    grund = PolitiskOverbevisning,
    har_lovhjemmel = Sandt
).opfylder_par71_stk1_og_2()
| par70_tro: par70_trosbaseret_politisk_rettighedsberøvelse -> par70_trosbaseret_politisk_rettighedsberøvelse == Falskt
| par70_afstamning: par70_afstamningsbaseret_borgerlig_rettighedsberøvelse -> par70_afstamningsbaseret_borgerlig_rettighedsberøvelse == Falskt
| par71_politisk_overbevisning: par71_politisk_frihedsberøvelse_af_dansk_borger -> par71_politisk_frihedsberøvelse_af_dansk_borger == Falskt

-- Tværgående: par. 57 vs par. 77 — to slags ytringsfrihed
-- § 57 (kap. V): parlamentarisk immunitet — intet medlem kan drages til
-- ansvar for ytringer i folketinget, medmindre folketinget samtykker.
-- § 77 (kap. VIII): generel ytringsfrihed — alle borgere, men under
-- ansvar for domstolene.
-- Bestemmelserne har forskellige personkredse og ansvarsmekanismer. En
-- sammenligning af deres samlede styrke kræver en særskilt fortolkning.
= par57_ansvar_uden_samtykke = ansvar_uden_for_folketinget_for_ytring_opfylder_par57(Ytringsansvarssag(
    folketingets_samtykke = IkkeGivet
))
= par77_offentliggørelse_under_domstolsansvar = Ytringssag(form = Tale).offentliggørelse_er_under_ansvar_for_domstolene()
| par57_par77_parlamentarisk: par57_ansvar_uden_samtykke -> par57_ansvar_uden_samtykke == Falskt
| par57_par77_generel: par77_offentliggørelse_under_domstolsansvar -> par77_offentliggørelse_under_domstolsansvar

-- Tværgående: par. 72 vs par. 71 — retskendelse vs lovhjemmel
-- Begge starter med "ukrænkelig", men bruger forskellige hovedregler og
-- udtrykkelige undtagelser. Auditresultatet rangordner dem ikke.
= par71_frihedsberøvelse_med_lovhjemmel = Frihedsberøvelsessag(
    personkreds = AndenPerson,
    grund = AndenFrihedsberøvelsesgrund,
    har_lovhjemmel = Sandt
).opfylder_par71_stk1_og_2()
= par72_husundersøgelse_med_retskendelse = Privatlivsindgrebssag(
    indgreb = Husundersøgelse,
    retskendelse_foreligger = Sandt,
    særegen_undtagelse_hjemlet_ved_lov = Falskt
).opfylder_par72()
| par71_lovhjemmel: par71_frihedsberøvelse_med_lovhjemmel -> par71_frihedsberøvelse_med_lovhjemmel
| par72_retskendelse: par72_husundersøgelse_med_retskendelse -> par72_husundersøgelse_med_retskendelse

-- Tværgående: par. 73-75 — forskellige modaliteter for økonomiske forhold
-- Kildemodellen bevarer "ukrænkelig", "skal" og "bør" som forskellige
-- regelstrukturer uden at udlede en samlet rangordning.
= par74_ubegrundet_indskrænkning_hævet_ved_lov = Erhvervsindskrænkning(
    begrundet_i_det_almene_vel = Falskt,
    hævet_ved_lov = Sandt
).opfylder_par74()
= par75_tilstræbt_uden_opnået_resultat = Arbejdsmulighedsmålsætning(
    tilstræbt_til_fremme_af_almenvellet = Sandt,
    arbejdsduelig_borger_har_mulighed_for_arbejde = Falskt,
    arbejdsvilkår_betrygger_tilværelsen = Falskt
).tilstræbelsen_opfylder_ordlydens_modalitet_i_par75_stk1()
| par73_ejendom_ukrænkelig: ejendomsretten_er_ukrænkelig() -> ejendomsretten_er_ukrænkelig()
| par74_erhvervsindskrænkningens_modalitet: par74_ubegrundet_indskrænkning_hævet_ved_lov -> par74_ubegrundet_indskrænkning_hævet_ved_lov
| par75_arbejdsmulighedens_modalitet: par75_tilstræbt_uden_opnået_resultat -> par75_tilstræbt_uden_opnået_resultat

-- Tværgående: par. 78 + par. 79 — "uden forudgående tilladelse"
-- Begge bruger den identiske formulering "uden forudgående tilladelse" —
-- parallelt sprog, mens indgrebsbetingelserne er forskellige.
= par78_forening_uden_tilladelse = forening_kan_dannes_uden_forudgående_tilladelse(LovligtFormål)
= par79_forsamling_uden_tilladelse = Forsamlingssag(
    ubevæbnet = Sandt,
    offentlig = Sandt,
    under_åben_himmel = Falskt,
    fare_for_den_offentlige_fred = Falskt
).kan_samles_uden_forudgående_tilladelse()
= par78_voldspåvirkning = forening_skal_opløses_ved_dom(VirkerVed(påvirkning = Vold))
= par79_udendørs_fare = Forsamlingssag(
    ubevæbnet = Sandt,
    offentlig = Sandt,
    under_åben_himmel = Sandt,
    fare_for_den_offentlige_fred = Sandt
).kan_forbydes_efter_par79()
| par78_par79_forening_uden_tilladelse: par78_forening_uden_tilladelse -> par78_forening_uden_tilladelse
| par78_par79_forsamling_uden_tilladelse: par79_forsamling_uden_tilladelse -> par79_forsamling_uden_tilladelse
| par78_voldspåvirkning_opløses_ved_dom: par78_voldspåvirkning -> par78_voldspåvirkning
| par79_udendørs_fare_kan_forbydes: par79_udendørs_fare -> par79_udendørs_fare

-- Tværgående: par. 71 stk. 6 vs par. 63 — udlændinge-undtagelsen
-- § 63 stk. 1: domstolene prøver øvrighedens grænser (generel domstolsprøvelse).
-- § 71 stk. 6 undtager udlændingelovgivningen fra netop sin særlige
-- forelæggelsespligt. Kildemodellen udleder ikke deraf manglende prøvelse ad
-- andre veje.
= par63_øvrighedsgrænse_kan_prøves = Øvrighedsgrænsesag(øvrighedens_befaling_foreløbigt_efterkommet = Sandt).kan_påkendes_af_domstolene_efter_par63_stk1()
= par71_udlændingelovgivning_uden_for_stk6 = AdministrativFrihedsberøvelse(
    hører_til_strafferetsplejen = Falskt,
    beslutning = IkkeBesluttetAfDømmendeMyndighed,
    har_hjemmel_i_udlændingelovgivningen = Sandt,
    begærer = DenFrihedsberøvede,
    prøvelsesvej = IngenPrøvelsesvej
).person_er_omfattet_af_par71_stk6()
| par63_generel_prøvelse: par63_øvrighedsgrænse_kan_prøves -> par63_øvrighedsgrænse_kan_prøves
| par71_udlændingelovgivning_uden_for_stk6: par71_udlændingelovgivning_uden_for_stk6 -> par71_udlændingelovgivning_uden_for_stk6 == Falskt

-- Tværgående: par. 71 stk. 7 vs par. 55 — to folketingstilsyn
-- § 55: folketinget vælger tilsynspersoner for civil og militær forvaltning
-- (ombudsmandsinstitutionen).
-- § 71 stk. 7: folketinget vælger tilsyn med administrativt frihedsberøvede.
-- To parallelle tilsynsmandater, begge valgt af folketinget.
-- § 55 er generelt (al forvaltning). § 71 stk. 7 er specifikt (detention).
| par55_generelt_tilsyn: folketinget_vælger_tilsynspersoner_ved_lov() -> folketinget_vælger_tilsynspersoner_ved_lov()
= par71_tilsynsgrundlag = AdministrativFrihedsberøvelse(
    hører_til_strafferetsplejen = Falskt,
    beslutning = IkkeBesluttetAfDømmendeMyndighed,
    har_hjemmel_i_udlændingelovgivningen = Falskt,
    begærer = DenFrihedsberøvede,
    prøvelsesvej = AlmindeligeDomstole
)
= par71_specifikt_tilsynsforløb = TilsynsforløbPar71(
    frihedsberøvelse = par71_tilsynsgrundlag,
    folketinget_har_valgt_tilsyn = Sandt,
    den_frihedsberøvede_har_adgang_til_henvendelse = Sandt
).opfylder_par71_stk7()
| par71_specifikt_tilsyn: par71_specifikt_tilsynsforløb -> par71_specifikt_tilsynsforløb

-- Tværgående: par. 23 vs par. 77 — foreløbige love vs censurforbud
-- § 23: kongen kan udstede foreløbige love, "der dog ikke må stride mod
-- grundloven."
-- § 77: censur kan "ingensinde påny" indføres — absolut forbud.
-- En foreløbig lov kan aldrig indføre censur, fordi § 23 eksplicit
-- underkaster sig grundloven, og § 77 er grundlov.
= par23_grundlovsstridig_sag = ForeløbigLovssag(
    særdeles_påtrængende = Sandt,
    folketinget_kan_samles = Falskt,
    strider_mod_grundloven = Sandt
)
= par23_grundlovsstridig_resultat = foreløbig_lov_kan_udstedes(par23_grundlovsstridig_sag)
| par23_grundlovsbundet: par23_grundlovsstridig_resultat -> par23_grundlovsstridig_resultat == Falskt
| par77_censur_kan_ikke_indføres: forebyggende_ytringsforholdsregel_kan_indføres_efter_par77(Censur) -> forebyggende_ytringsforholdsregel_kan_indføres_efter_par77(Censur) == Falskt

-- Tværgående: par. 83-84 — feudal afskaffelse (par)
-- § 83 fjerner eksisterende privilegier (adel, titel, rang).
-- § 84 forhindrer nye feudale strukturer (len, stamhus, fideikommis).
-- Tilsammen har bestemmelserne en bagudrettet og en fremadrettet regel.
| feudal_bagud: forret_knyttet_i_lovgivningen_er_afskaffet(Adel) -> forret_knyttet_i_lovgivningen_er_afskaffet(Adel)
| feudal_fremad: familiefideikommis_kan_oprettes_for_fremtiden(Len) -> familiefideikommis_kan_oprettes_for_fremtiden(Len) == Falskt

-- Tværgående: par. 8 + par. 27 stk. 1 + par. 32 stk. 7 — tre eder
-- Tre grupper aflægger forsikring om at holde grundloven:
-- § 8: kongen (ved tiltræden — modelleret via ForsikringsStatus).
-- § 27: kongens tjenestemænd. § 32 stk. 7: nye folketingsmedlemmer.
-- Alle tre: "forsikring om at holde grundloven."
-- Kongen, embedsværket og den lovgivende magt er alle edsforpligtede.
| ed_tjenestemand_gentagelse: kongens_tjenestemand_aflægger_grundlovs_ed() -> kongens_tjenestemand_aflægger_grundlovs_ed()
| forsikring_folketingsmedlem_gentagelse: nyt_medlem_afgiver_højtidelig_forsikring_om_at_holde_grundloven() -> nyt_medlem_afgiver_højtidelig_forsikring_om_at_holde_grundloven()

