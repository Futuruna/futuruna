-- Tværgående: delegationer til lov
| delegation_regentskab: regentskab_fastsættes_ved_lov(Umyndighed) -> regentskab_fastsættes_ved_lov(Umyndighed)
| delegation_statsydelse: statsydelse_fastsættes_ved_lov() -> statsydelse_fastsættes_ved_lov()
| delegation_årpenge: årpenge_fastsættes_ved_lov() -> årpenge_fastsættes_ved_lov()
| delegation_ministeransvar: ministeransvar_fastsættes_ved_lov() -> ministeransvar_fastsættes_ved_lov()
| delegation_udenrigsnævn: udenrigsnævn_fastsættes_ved_lov() -> udenrigsnævn_fastsættes_ved_lov()
| delegation_tjenestemandsansættelse: tjenestemandsansættelse_fastsættes_ved_lov() -> tjenestemandsansættelse_fastsættes_ved_lov()
| delegation_tjenestemandsafskedigelse: tjenestemandsforhold_fastsættes_ved_lov() -> tjenestemandsforhold_fastsættes_ved_lov()
| delegation_tab_af_valgret: omfang_af_tab_af_valgret_fastsættes_ved_lov(Straf) -> omfang_af_tab_af_valgret_fastsættes_ved_lov(Straf) && omfang_af_tab_af_valgret_fastsættes_ved_lov(UnderstøttelseBetragtetSomFattighjælp)
| delegation_valgmåde: valgmåde_fastsættes_ved_valglov() -> valgmåde_fastsættes_ved_valglov()
| delegation_rigsretten: rigsretten_fastsættes_ved_lov() -> rigsretten_fastsættes_ved_lov()
= audit_retsplejeordning = Retsplejeordning(
    retsplejen_adskilt_fra_forvaltningen = Sandt,
    regler_fastsat_ved_lov = Sandt
)
= audit_forvaltningsdomstolsordning = Forvaltningsdomstolsordning(
    henlagt_ved_lov = Sandt,
    afgørelser_kan_prøves_ved_rigets_øverste_domstol = Sandt,
    nærmere_regler_fastsat_ved_lov = Sandt
)
= audit_strafferetsplejeordning = Strafferetsplejeordning(
    lægmænd_medvirker = Sandt,
    medvirkningens_sager_og_former_fastsat_ved_lov = Sandt,
    nævningesager_fastsat_ved_lov = Sandt
)
| delegation_dømmende_magt: dømmende_magts_ordning_opfylder_par61(Sandt) -> dømmende_magts_ordning_opfylder_par61(Sandt)
| delegation_adskillelse: audit_retsplejeordning.opfylder_par62() -> audit_retsplejeordning.opfylder_par62()
| delegation_forvaltningsdomstole: audit_forvaltningsdomstolsordning.opfylder_par63_stk2() -> audit_forvaltningsdomstolsordning.opfylder_par63_stk2()
| delegation_strafferetsplejens_lægmandsordning: audit_strafferetsplejeordning.opfylder_par65_stk2() -> audit_strafferetsplejeordning.opfylder_par65_stk2()
| delegation_folkekirkens_forfatning: folkekirkens_forfatning_ordnes_ved_lov() -> folkekirkens_forfatning_ordnes_ved_lov()
| delegation_afvigende_trossamfund: afvigende_trossamfund_ordnes_ved_lov() -> afvigende_trossamfund_ordnes_ved_lov()
| delegation_frihedsberøvelse_prøvelse: prøvelse_af_frihedsberøvelse_fastsættes_ved_lov() -> prøvelse_af_frihedsberøvelse_fastsættes_ved_lov()

-- Tværgående: par. 3 og par. 61-64 — placering, ordning og dommerens normbinding
= par3_dømmende_magt = statsmagtens_placering(Dømmende)
| par3_par61_dømmende_magt_og_lovordning: par3_dømmende_magt -> par3_dømmende_magt == Magtplacering(magt = Dømmende, udøvelse = Hos(organ = Domstolene)) && dømmende_magts_ordning_opfylder_par61(Sandt)
