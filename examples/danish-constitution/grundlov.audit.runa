@ sprog da

-- Grundlov audit -- Kapitel I-XI

@ importer ./kapitel - 01
@ importer ./kapitel - 02
@ importer ./kapitel - 03
@ importer ./kapitel - 04
@ importer ./kapitel - 05
@ importer ./kapitel - 06
@ importer ./kapitel - 07
@ importer ./kapitel - 08
@ importer ./kapitel - 09
@ importer ./kapitel - 10
@ importer ./kapitel - 11

-- ============================================================================
-- Audit-scenarier
-- ============================================================================

-- Disse typer og regler er ikke ny lovtekst. De er auditens konkrete
-- scenarier for at teste den formaliserede lovtekst ovenfor.

> audit_lovforslag(område: Lovforslagsområde) -> Lovforslag {
    Lovforslag(
        område = område,
        påtrængende_efter_par41 = Falskt,
        ikrafttræden_kan_udsættes = Sandt,
        særdeles_påtrængende_efter_par42 = Falskt,
        straksstadfæstelse_bestemt_i_forslaget = Falskt
    )
}

| ændre_rigets_område(samtykke: Samtykke) -> mellemfolkelig_sag_opfylder_par19_stk1(MellemfolkeligSag(
    handling = ÆndrerRigetsOmråde,
    folketingets_samtykke = samtykke
))

| indgå_forpligtelse_af_betydning(samtykke: Samtykke) -> mellemfolkelig_sag_opfylder_par19_stk1(MellemfolkeligSag(
    handling = IndgårForpligtelse(
        folketingets_medvirken_nødvendig = Falskt,
        større_betydning = Sandt
    ),
    folketingets_samtykke = samtykke
))

| opsige_overenskomst_indgået_med_samtykke(samtykke: Samtykke) -> mellemfolkelig_sag_opfylder_par19_stk1(MellemfolkeligSag(
    handling = OpsigerOverenskomst(indgået_med_folketingets_samtykke = Sandt),
    folketingets_samtykke = samtykke
))

| folkeafstemning_afskåret(forslag: Lovforslag) -> lovforslag_kan_undergives_folkeafstemning(forslag) == Falskt

| udsættelse_af_tredje_behandling_afskåret(forslag: Lovforslag) -> lovforslag_er_undtaget_fra_udsættelse(forslag)

| dobbelt_afskåret(forslag: Lovforslag) -> folkeafstemning_afskåret(forslag) && udsættelse_af_tredje_behandling_afskåret(forslag)

-- ============================================================================
-- Invarianter
-- ============================================================================

-- Par. 1: universalitet
= par1_dk = grundloven_gælder_for(Danmark)
= par1_fo = grundloven_gælder_for(Færøerne)
= par1_gl = grundloven_gælder_for(Grønland)
| par1_danmark: par1_dk -> par1_dk == Sandt
| par1_færøerne: par1_fo -> par1_fo == Sandt
| par1_grønland: par1_gl -> par1_gl == Sandt

-- Par. 5: samtykke-mønster
= par5_uden = regent_i_udlandet(IkkeGivet)
= par5_med = regent_i_udlandet(Givet)
| par5_default_nej: par5_uden -> par5_uden == Falskt
| par5_samtykke_ja: par5_med -> par5_med == Sandt

-- Par. 6: troskrav absolut
= luthersk = Monark(
    alder = 50,
    trossamfund = EvangeliskLuthersk,
    forsikring = IkkeAfgivet
)
= katolsk = Monark(
    alder = 50,
    trossamfund = Andet(navn = "Katolsk"),
    forsikring = IkkeAfgivet
)
= par6_luthersk = monark_opfylder_troskrav(luthersk)
= par6_katolsk = monark_opfylder_troskrav(katolsk)
| par6_godkendt: par6_luthersk -> par6_luthersk == Sandt
| par6_afvist: par6_katolsk -> par6_katolsk == Falskt

-- Par. 7: myndig ved 18, symmetri monark/tronfølger
= monark_17 = Monark(
    alder = 17,
    trossamfund = EvangeliskLuthersk,
    forsikring = IkkeAfgivet
)
= monark_18 = Monark(
    alder = 18,
    trossamfund = EvangeliskLuthersk,
    forsikring = IkkeAfgivet
)
= tf_17 = Tronfølger(alder = 17, trossamfund = EvangeliskLuthersk, forsikring = IkkeAfgivet)
= tf_18 = Tronfølger(alder = 18, trossamfund = EvangeliskLuthersk, forsikring = IkkeAfgivet)
= par7_m17 = monark_er_myndig(monark_17)
= par7_m18 = monark_er_myndig(monark_18)
= par7_t17 = tronfølger_er_myndig(tf_17)
= par7_t18 = tronfølger_er_myndig(tf_18)
| par7_umyndig: par7_m17 -> par7_m17 == Falskt
| par7_myndig: par7_m18 -> par7_m18 == Sandt
| par7_tf_umyndig: par7_t17 -> par7_t17 == Falskt
| par7_tf_myndig: par7_t18 -> par7_t18 == Sandt
| par7_symmetri: par7_m18 -> par7_m18 == par7_t18

-- Par. 11: samtykke-mønster
= par11_uden = årpenge_i_udlandet(IkkeGivet)
= par11_med = årpenge_i_udlandet(Givet)
| par11_default_nej: par11_uden -> par11_uden == Falskt
| par11_samtykke_ja: par11_med -> par11_med == Sandt

-- Par. 14: gyldighed kræver begge underskrifter
= begge_underskrifter = KongeligBeslutning(område = Lovgivning, kongens_underskrift = Underskrevet, ministerunderskrifter = EnEllerFlereMinisterunderskrifter)
= mangler_minister = KongeligBeslutning(område = Lovgivning, kongens_underskrift = Underskrevet, ministerunderskrifter = IngenMinisterunderskrift)
= mangler_konge = KongeligBeslutning(område = Lovgivning, kongens_underskrift = IkkeUnderskrevet, ministerunderskrifter = EnEllerFlereMinisterunderskrifter)
= mangler_begge = KongeligBeslutning(område = Lovgivning, kongens_underskrift = IkkeUnderskrevet, ministerunderskrifter = IngenMinisterunderskrift)
= par14_gyldig = kongelig_beslutning_er_gyldig(begge_underskrifter)
= par14_uden_minister = kongelig_beslutning_er_gyldig(mangler_minister)
= par14_uden_konge = kongelig_beslutning_er_gyldig(mangler_konge)
= par14_uden_begge = kongelig_beslutning_er_gyldig(mangler_begge)
| par14_begge_kræves: par14_gyldig -> par14_gyldig == Sandt
| par14_minister_påkrævet: par14_uden_minister -> par14_uden_minister == Falskt
| par14_konge_påkrævet: par14_uden_konge -> par14_uden_konge == Falskt
| par14_ingen_er_ugyldig: par14_uden_begge -> par14_uden_begge == Falskt

-- Par. 15: mistillid
= par15_udtalt = minister_kan_forblive(Udtalt)
= par15_ikke_udtalt = minister_kan_forblive(IkkeUdtalt)
| par15_mistillid_fjerner: par15_udtalt -> par15_udtalt == Falskt
| par15_uden_mistillid_bliver: par15_ikke_udtalt -> par15_ikke_udtalt == Sandt

-- Par. 15 stk. 2: ministeriet skal afgå medmindre nyvalg
= par15_nyvalg = ministeriet_skal_begære_afsked(Sandt)
= par15_ingen_nyvalg = ministeriet_skal_begære_afsked(Falskt)
| par15_nyvalg_undtager: par15_nyvalg -> par15_nyvalg == Falskt
| par15_uden_nyvalg_afgår: par15_ingen_nyvalg -> par15_ingen_nyvalg == Sandt

-- Par. 17: tronfølger i statsrådet følger par. 7 myndighedsalder
= par17_tf_17 = tronfølger_tager_sæde_i_statsrådet(tf_17)
= par17_tf_18 = tronfølger_tager_sæde_i_statsrådet(tf_18)
| par17_umyndig_tf_ej_i_statsråd: par17_tf_17 -> par17_tf_17 == Falskt
| par17_myndig_tf_i_statsråd: par17_tf_18 -> par17_tf_18 == Sandt
| par17_par7_symmetri: par17_tf_18 -> par17_tf_18 == par7_t18

-- Par. 19 stk. 2: forsvar kræver ikke samtykke, andet gør
= par19_forsvar = militær_magtanvendelse_opfylder_par19_stk2(MilitærMagtanvendelse(grund = ForsvarModVæbnetAngrebPåRiget, folketingets_samtykke = IkkeGivet))
= par19_anden_uden = militær_magtanvendelse_opfylder_par19_stk2(MilitærMagtanvendelse(grund = AndenMilitærgrund, folketingets_samtykke = IkkeGivet))
= par19_anden_med = militær_magtanvendelse_opfylder_par19_stk2(MilitærMagtanvendelse(grund = AndenMilitærgrund, folketingets_samtykke = Givet))
| par19_forsvar_altid: par19_forsvar -> par19_forsvar == Sandt
| par19_anden_default_nej: par19_anden_uden -> par19_anden_uden == Falskt
| par19_anden_samtykke_ja: par19_anden_med -> par19_anden_med == Sandt

-- Par. 19 stk. 1: tre samtykke-krav alle følger mønster
= par19_område_uden = ændre_rigets_område(IkkeGivet)
= par19_område_med = ændre_rigets_område(Givet)
= par19_forpligtelse_uden = indgå_forpligtelse_af_betydning(IkkeGivet)
= par19_forpligtelse_med = indgå_forpligtelse_af_betydning(Givet)
= par19_opsige_uden = opsige_overenskomst_indgået_med_samtykke(IkkeGivet)
= par19_opsige_med = opsige_overenskomst_indgået_med_samtykke(Givet)
| par19_område_nej: par19_område_uden -> par19_område_uden == Falskt
| par19_område_ja: par19_område_med -> par19_område_med == Sandt
| par19_forpligtelse_nej: par19_forpligtelse_uden -> par19_forpligtelse_uden == Falskt
| par19_forpligtelse_ja: par19_forpligtelse_med -> par19_forpligtelse_med == Sandt
| par19_opsige_nej: par19_opsige_uden -> par19_opsige_uden == Falskt
| par19_opsige_ja: par19_opsige_med -> par19_opsige_med == Sandt

-- Par. 24: benådning af ministre
= par24_uden = benådning_af_rigsretsdømt_minister_opfylder_par24(IkkeGivet)
= par24_med = benådning_af_rigsretsdømt_minister_opfylder_par24(Givet)
| par24_benåde_nej: par24_uden -> par24_uden == Falskt
| par24_benåde_ja: par24_med -> par24_med == Sandt

-- Par. 28: mandattal
| par28_max: folketingets_max_medlemmer -> folketingets_max_medlemmer == 179
| par28_færøerne: færøske_mandater -> færøske_mandater == 2
| par28_grønland: grønlandske_mandater -> grønlandske_mandater == 2

-- Par. 29: valgret kumulativt
= valgretsforhold_alle_opfyldt = Valgretsforhold(
    har_dansk_indfødsret = Sandt,
    har_fast_bopæl_i_riget = Sandt,
    har_nået_valgretsalderen = Sandt,
    er_umyndiggjort = Falskt,
    valgret_tabt_efter_lovbestemmelse = Falskt
)
= valgretsforhold_mangler_indfødsret = Valgretsforhold(
    har_dansk_indfødsret = Falskt,
    har_fast_bopæl_i_riget = Sandt,
    har_nået_valgretsalderen = Sandt,
    er_umyndiggjort = Falskt,
    valgret_tabt_efter_lovbestemmelse = Falskt
)
= valgretsforhold_mangler_bopæl = Valgretsforhold(
    har_dansk_indfødsret = Sandt,
    har_fast_bopæl_i_riget = Falskt,
    har_nået_valgretsalderen = Sandt,
    er_umyndiggjort = Falskt,
    valgret_tabt_efter_lovbestemmelse = Falskt
)
= valgretsforhold_mangler_alder = Valgretsforhold(
    har_dansk_indfødsret = Sandt,
    har_fast_bopæl_i_riget = Sandt,
    har_nået_valgretsalderen = Falskt,
    er_umyndiggjort = Falskt,
    valgret_tabt_efter_lovbestemmelse = Falskt
)
= valgretsforhold_umyndiggjort = Valgretsforhold(
    har_dansk_indfødsret = Sandt,
    har_fast_bopæl_i_riget = Sandt,
    har_nået_valgretsalderen = Sandt,
    er_umyndiggjort = Sandt,
    valgret_tabt_efter_lovbestemmelse = Falskt
)
= valgretsforhold_tab_efter_lov = Valgretsforhold(
    har_dansk_indfødsret = Sandt,
    har_fast_bopæl_i_riget = Sandt,
    har_nået_valgretsalderen = Sandt,
    er_umyndiggjort = Falskt,
    valgret_tabt_efter_lovbestemmelse = Sandt
)
= valgret_alle_opfyldt = opfylder_par29_stk1(valgretsforhold_alle_opfyldt)
= valgret_mangler_indfødsret = opfylder_par29_stk1(valgretsforhold_mangler_indfødsret)
= valgret_mangler_bopæl = opfylder_par29_stk1(valgretsforhold_mangler_bopæl)
= valgret_mangler_alder = opfylder_par29_stk1(valgretsforhold_mangler_alder)
= valgret_umyndiggjort = opfylder_par29_stk1(valgretsforhold_umyndiggjort)
= valgret_tabt_efter_lov = opfylder_par29_stk1(valgretsforhold_tab_efter_lov)
| par29_alle_krav: valgret_alle_opfyldt -> valgret_alle_opfyldt == Sandt
| par29_kræver_indfødsret: valgret_mangler_indfødsret -> valgret_mangler_indfødsret == Falskt
| par29_kræver_bopæl: valgret_mangler_bopæl -> valgret_mangler_bopæl == Falskt
| par29_kræver_alder: valgret_mangler_alder -> valgret_mangler_alder == Falskt
| par29_umyndig_udelukker: valgret_umyndiggjort -> valgret_umyndiggjort == Falskt
| par29_tab_efter_lov_udelukker: valgret_tabt_efter_lov -> valgret_tabt_efter_lov == Falskt

-- Par. 30: valgbarhed kræver valgret + ingen uværdig straf
= valgbar_ren = opfylder_par30_stk1(Valgbarhedsforhold(
    valgretsforhold = valgretsforhold_alle_opfyldt,
    straffet_for_uværdig_handling = Falskt
))
= valgbar_straffet = opfylder_par30_stk1(Valgbarhedsforhold(
    valgretsforhold = valgretsforhold_alle_opfyldt,
    straffet_for_uværdig_handling = Sandt
))
= valgbar_ingen_valgret = opfylder_par30_stk1(Valgbarhedsforhold(
    valgretsforhold = valgretsforhold_mangler_indfødsret,
    straffet_for_uværdig_handling = Falskt
))
| par30_valgbar: valgbar_ren -> valgbar_ren == Sandt
| par30_straf_udelukker: valgbar_straffet -> valgbar_straffet == Falskt
| par30_kræver_valgret: valgbar_ingen_valgret -> valgbar_ingen_valgret == Falskt

-- Par. 32: valgperiode og nyvalg efter nyt ministerium
| par32_valgperiode: valgperiode_år -> valgperiode_år == 4
= par32_fremstillet = kongen_kan_udskrive_nyvalg(Nyvalgssituation(
    nyt_ministerium_udnævnt = Sandt,
    statsministeren_har_fremstillet_sig = Sandt
))
= par32_ikke_fremstillet = kongen_kan_udskrive_nyvalg(Nyvalgssituation(
    nyt_ministerium_udnævnt = Sandt,
    statsministeren_har_fremstillet_sig = Falskt
))
| par32_fremstillet_ja: par32_fremstillet -> par32_fremstillet == Sandt
| par32_ikke_fremstillet_nej: par32_ikke_fremstillet -> par32_ikke_fremstillet == Falskt

-- Par. 39: formanden skal indkalde
= par39_pm = formanden_skal_indkalde(Mødebegæring(
    begærer = StatsministerenSomMødebegærer,
    skriftlig = Sandt,
    dagsorden_angivet = Sandt
))
= par39_2f5 = formanden_skal_indkalde(Mødebegæring(
    begærer = FolketingsmedlemmerSomMødebegærere(
        opbakning = Medlemsopbakning(antal = 72, medlemmer_i_alt = 179)
    ),
    skriftlig = Sandt,
    dagsorden_angivet = Sandt
))
= par39_under = formanden_skal_indkalde(Mødebegæring(
    begærer = FolketingsmedlemmerSomMødebegærere(
        opbakning = Medlemsopbakning(antal = 71, medlemmer_i_alt = 179)
    ),
    skriftlig = Sandt,
    dagsorden_angivet = Sandt
))
| par39_statsminister_altid: par39_pm -> par39_pm == Sandt
| par39_to_femtedele_nok: par39_2f5 -> par39_2f5 == Sandt
| par39_under_to_femtedele_nej: par39_under -> par39_under == Falskt

-- Par. 41 stk. 3: udsættelse kræver 2/5
= par41_2f5 = udsættelsesbegæring_opfylder_par41_stk3(Udsættelsesbegæring(
    forslag = audit_lovforslag(AlmindeligtLovforslag),
    opbakning = Medlemsopbakning(antal = 72, medlemmer_i_alt = 179),
    skriftlig = Sandt,
    underskrevet = Sandt
))
= par41_under = udsættelsesbegæring_opfylder_par41_stk3(Udsættelsesbegæring(
    forslag = audit_lovforslag(AlmindeligtLovforslag),
    opbakning = Medlemsopbakning(antal = 71, medlemmer_i_alt = 179),
    skriftlig = Sandt,
    underskrevet = Sandt
))
| par41_udsættelse_nok: par41_2f5 -> par41_2f5 == Sandt
| par41_udsættelse_nej: par41_under -> par41_under == Falskt

-- Par. 42 stk. 1: folkeafstemning kræver 1/3
= par42_1f3 = folkeafstemningsbegæring_opfylder_par42_stk1(Folkeafstemningsbegæring(
    forslag = audit_lovforslag(AlmindeligtLovforslag),
    opbakning = Medlemsopbakning(antal = 60, medlemmer_i_alt = 179),
    søgnedage_efter_endelig_vedtagelse = 3,
    skriftlig = Sandt,
    underskrevet = Sandt
))
= par42_under = folkeafstemningsbegæring_opfylder_par42_stk1(Folkeafstemningsbegæring(
    forslag = audit_lovforslag(AlmindeligtLovforslag),
    opbakning = Medlemsopbakning(antal = 59, medlemmer_i_alt = 179),
    søgnedage_efter_endelig_vedtagelse = 3,
    skriftlig = Sandt,
    underskrevet = Sandt
))
| par42_begæring_nok: par42_1f3 -> par42_1f3 == Sandt
| par42_begæring_nej: par42_under -> par42_under == Falskt

-- Par. 42 stk. 5: dobbelt bortfaldskrav
= par42_flertal_og_30pct = lovforslag_forkastet_ved_folkeafstemning(Folkeafstemningsresultat(
    mod_stemmer = 600000,
    deltagende = 1000000,
    stemmeberettigede = 1800000
))
= par42_flertal_men_under_30pct = lovforslag_forkastet_ved_folkeafstemning(Folkeafstemningsresultat(
    mod_stemmer = 510000,
    deltagende = 1000000,
    stemmeberettigede = 1800000
))
= par42_minoritet = lovforslag_forkastet_ved_folkeafstemning(Folkeafstemningsresultat(
    mod_stemmer = 400000,
    deltagende = 1000000,
    stemmeberettigede = 1800000
))
| par42_begge_krav_opfyldt: par42_flertal_og_30pct -> par42_flertal_og_30pct == Sandt
| par42_mangler_30pct: par42_flertal_men_under_30pct -> par42_flertal_men_under_30pct == Falskt
| par42_mangler_flertal: par42_minoritet -> par42_minoritet == Falskt

-- Par. 50: beslutningsdygtighed
= par50_nok = folketinget_er_beslutningsdygtigt(Afstemningsdeltagelse(
    tilstede_og_deltagende = 90,
    medlemmer_i_alt = 179
))
= par50_halvdelen = folketinget_er_beslutningsdygtigt(Afstemningsdeltagelse(
    tilstede_og_deltagende = 89,
    medlemmer_i_alt = 179
))
| par50_over_halvdelen: par50_nok -> par50_nok == Sandt
| par50_ikke_nok: par50_halvdelen -> par50_halvdelen == Falskt

-- Par. 59: rigsrettens sammensætning
| par59_max_dommere: rigsret_max_dommermedlemmer -> rigsret_max_dommermedlemmer == 15
| par59_valgperiode: rigsret_valgperiode_år -> rigsret_valgperiode_år == 6

-- Par. 59: afbalancering — inhabilde dommere reducerer begge sider
= par59_grundsammensætning = Rigsretsgrundsammensætning(
    dommermedlemmer_fra_rigets_øverste_domstol = 15,
    folketingsvalgte_medlemmer = 15,
    dommermedlemmer_udvalgt_efter_embedsalder = Sandt,
    folketingsmedlemmer_valgt_efter_forholdstal = Sandt,
    stedfortrædere_valgt_for_hvert_folketingsvalgt_medlem = Sandt,
    et_folketingsmedlem_er_valgt_eller_virker_i_rigsretten = Falskt
)
= par59_fuld_sag = Rigsretssagssammensætning(
    grundsammensætning = par59_grundsammensætning,
    dommermedlemmer_som_ikke_kan_deltage = 0,
    sidst_valgte_rigsretsmedlemmer_som_fratræder = 0
)
= par59_3_inhabilde_sag = Rigsretssagssammensætning(
    grundsammensætning = par59_grundsammensætning,
    dommermedlemmer_som_ikke_kan_deltage = 3,
    sidst_valgte_rigsretsmedlemmer_som_fratræder = 3
)
= par59_fuld = par59_fuld_sag.deltagende_dommermedlemmer()
= par59_3_inhabilde = par59_3_inhabilde_sag.deltagende_dommermedlemmer()
= par59_paritet = par59_3_inhabilde_sag.er_afbalanceret_efter_par59_stk1()
| par59_fuld_besætning: par59_fuld -> par59_fuld == 15
| par59_reduceret: par59_3_inhabilde -> par59_3_inhabilde == 12
| par59_paritet_sikret: par59_paritet -> par59_paritet == Sandt

-- Par. 60 stk. 2: samtykke-mønster
= par60_sag_mod_anden_uden_samtykke = Rigsretssag(
    tiltaler = KongenSomRigsretstiltaler,
    tiltalt = AndenPerson(kongen_finder_forbrydelsen_særdeles_farlig_for_staten = Sandt),
    folketingets_samtykke = IkkeGivet
)
= par60_sag_mod_anden_med_samtykke = Rigsretssag(
    tiltaler = KongenSomRigsretstiltaler,
    tiltalt = AndenPerson(kongen_finder_forbrydelsen_særdeles_farlig_for_staten = Sandt),
    folketingets_samtykke = Givet
)
= par60_tiltale_uden = par60_sag_mod_anden_uden_samtykke.kan_påkendes_efter_par60()
= par60_tiltale_med = par60_sag_mod_anden_med_samtykke.kan_påkendes_efter_par60()
| par60_tiltale_nej: par60_tiltale_uden -> par60_tiltale_uden == Falskt
| par60_tiltale_ja: par60_tiltale_med -> par60_tiltale_med == Sandt

-- Par. 64: dommerafskedigelsesalder
| par64_afskedigelsesalder: dommer_afskedigelsesalder -> dommer_afskedigelsesalder == 65
= par64_64 = dommerindgreb_opfylder_par64(Aldersafskedigelse(
    alder = 64,
    indtægter_bevaret_til_pligtig_afgangsalder = Sandt
))
= par64_65 = dommerindgreb_opfylder_par64(Aldersafskedigelse(
    alder = 65,
    indtægter_bevaret_til_pligtig_afgangsalder = Sandt
))
| par64_under_65_nej: par64_64 -> par64_64 == Falskt
| par64_65_ja: par64_65 -> par64_65 == Sandt

-- Par. 71 stk. 3: tidsfrister
| par71_frist_fremstilling: frist_fremstilling_timer -> frist_fremstilling_timer == 24
| par71_frist_kendelse: frist_kendelse_dage -> frist_kendelse_dage == 3

-- Par. 73 stk. 2: 1/3 kan kræve ekspropriationsudsættelse (samme tærskel som par. 42)
= par73_1f3 = Ekspropriationsudsættelsesbegæring(
    lovforslag_vedrører_ekspropriation_af_ejendom = Sandt,
    lovforslag_endeligt_vedtaget = Sandt,
    opbakning = Medlemsopbakning(antal = 60, medlemmer_i_alt = 179),
    søgnedage_efter_endelig_vedtagelse = 3
).opfylder_par73_stk2()
= par73_under = Ekspropriationsudsættelsesbegæring(
    lovforslag_vedrører_ekspropriation_af_ejendom = Sandt,
    lovforslag_endeligt_vedtaget = Sandt,
    opbakning = Medlemsopbakning(antal = 59, medlemmer_i_alt = 179),
    søgnedage_efter_endelig_vedtagelse = 3
).opfylder_par73_stk2()
| par73_begæring_nok: par73_1f3 -> par73_1f3 == Sandt
| par73_begæring_nej: par73_under -> par73_under == Falskt

-- Tværgående: par. 39 og 41 stk. 3 deler 2/5-tærskel
| tærskel_symmetri_39_41: par39_2f5 -> par39_2f5 == par41_2f5

-- Tværgående: par. 2 vs par. 6 — arvefølge vs troskrav
-- En tronfølger arver tronen (par. 2), men par. 6 kræver evangelisk-luthersk
-- trossamfund for kongen. Troskravet gælder IKKE tronfølgeren (par. 6 har
-- ingen udvidelse som par. 7). Hvad sker der, når en ikke-luthersk
-- tronfølger arver? Grundloven er tavs.
= muslim_arving = Monark(
    alder = 30,
    trossamfund = Andet(navn = "Muslim"),
    forsikring = AfgivetSomTronfølger
)
= par2_vs_par6 = monark_opfylder_troskrav(muslim_arving)
| arvefølge_troskrav_spænding: par2_vs_par6 -> par2_vs_par6 == Falskt

-- Tværgående: par. 7 vs par. 8 — umyndig tronfølger med ed
-- § 8 siger: har kongen allerede som tronfølger afgivet forsikring,
-- tiltræder han umiddelbart ved tronskiftet. Ingen alderskontrol.
-- § 7 siger: myndig ved 18. § 9: regentskab ved umyndighed.
-- Men § 8's umiddelbare tiltræden tjekker IKKE alder!
= umyndig_med_ed = Monark(
    alder = 16,
    trossamfund = EvangeliskLuthersk,
    forsikring = AfgivetSomTronfølger
)
= par8_tiltræder = regering_ved_tronskifte(Tronskiftesituation(
    monark = umyndig_med_ed,
    kan_afgive_forsikring_umiddelbart = Sandt,
    anden_ordning_ved_lov = Falskt
))
= par7_umyndig_check = monark_er_myndig(umyndig_med_ed)
-- § 8 siger MonarkenSelv. § 7 siger umyndig. Hvem har ret?
| par7_vs_par8_umyndig: par7_umyndig_check -> par7_umyndig_check == Falskt

-- Tværgående: par. 15 vs par. 32 stk. 2 — dødvande
-- § 15: ved mistillid SKAL ministeriet afgå (medmindre nyvalg).
-- § 32 stk. 2: efter nyt ministerium kan valg IKKE udskrives
-- før statsministeren har fremstillet sig for folketinget.
-- Scenarie: nyt ministerium udnævnt, PM ikke fremstillet endnu,
-- folketinget udtrykker straks mistillid. PM kan hverken blive
-- (§ 15) eller udskrive valg (§ 32 stk. 2).
= dødvande_kan_forblive = minister_kan_forblive(Udtalt)
= dødvande_kan_udskrive = kongen_kan_udskrive_nyvalg(Nyvalgssituation(
    nyt_ministerium_udnævnt = Sandt,
    statsministeren_har_fremstillet_sig = Falskt
))
-- Begge veje er blokeret: kan ikke forblive OG kan ikke udskrive valg
| dødvande_forblive_blokeret: dødvande_kan_forblive -> dødvande_kan_forblive == Falskt
| dødvande_valg_blokeret: dødvande_kan_udskrive -> dødvande_kan_udskrive == Falskt
| dødvande_begge_blokeret: dødvande_kan_forblive -> dødvande_kan_forblive == dødvande_kan_udskrive

-- Tværgående: par. 14 vs par. 22 — kongen nægter at underskrive
-- § 14: kongens underskrift + ministers underskrift giver gyldighed.
-- § 22: lovforslag får lovskraft ved stadfæstelse inden 30 dage.
-- Grundloven siger IKKE hvad der sker, hvis kongen nægter.
-- Kongens underskrift er NØDVENDIG (par. 14), men ingen tvangsmiddel.
= kongen_nægter = KongeligBeslutning(
    område = Lovgivning,
    kongens_underskrift = IkkeUnderskrevet,
    ministerunderskrifter = EnEllerFlereMinisterunderskrifter
)
= par14_vs_par22 = kongelig_beslutning_er_gyldig(kongen_nægter)
| kongen_kan_blokere_lovgivning: par14_vs_par22 -> par14_vs_par22 == Falskt

-- Tværgående: par. 29 vs par. 27 — indfødsret som fælles krav
-- § 27 stk. 1: tjenestemænd kræver indfødsret.
-- § 29 stk. 1: valgret kræver indfødsret.
-- § 44 stk. 1: indfødsret kun ved lov.
-- Tab af indfødsret rammer BÅDE tjenestemandsstatus OG valgret.
= kandidat_uden_indfødsret = Tjenestemandskandidat(har_indfødsret = Falskt)
= opfylder_ikke_tjenestemandskrav = tjenestemandskandidat_opfylder_indfødsretskravet(kandidat_uden_indfødsret)
| indfødsret_krav_tjenestemand: opfylder_ikke_tjenestemandskrav -> opfylder_ikke_tjenestemandskrav == Falskt
| indfødsret_krav_valgret: valgret_mangler_indfødsret -> valgret_mangler_indfødsret == Falskt

-- Tværgående: par. 29, 41, 42 og 44 — vælgerkorps uden referendum
-- § 44: indfødsret gives ved lov. § 29: indfødsret er adgangsbillet til valgret.
-- § 41 stk. 3: indfødsretslove kan ikke bremses med 12 dages udsættelse.
-- § 42 stk. 6: indfødsretslove kan ikke undergives folkeafstemning.
-- Vælgerkorpsets medlemskreds kan derfor udvides ved almindelig lov uden
-- den folkeafstemningslås, som gælder for valgretsalderen.
= par29_44_indfødsret_uden_referendum = folkeafstemning_afskåret(audit_lovforslag(Indfødsretslovsforslag))
= par41_42_indfødsret_dobbelt = dobbelt_afskåret(audit_lovforslag(Indfødsretslovsforslag))
= par41_42_ekspropriation_dobbelt = dobbelt_afskåret(audit_lovforslag(Ekspropriationslovsforslag))
= par41_42_direkte_skat_kun_referendum = dobbelt_afskåret(audit_lovforslag(DirekteSkattelovsforslag))
| indfødsret_udvider_vælgerkorps_uden_referendum: par29_44_indfødsret_uden_referendum -> par29_44_indfødsret_uden_referendum == Sandt
| indfødsret_dobbelt_afskåret: par41_42_indfødsret_dobbelt -> par41_42_indfødsret_dobbelt == Sandt
| ekspropriation_dobbelt_afskåret: par41_42_ekspropriation_dobbelt -> par41_42_ekspropriation_dobbelt == Sandt
| direkte_skat_ikke_dobbelt_afskåret: par41_42_direkte_skat_kun_referendum -> par41_42_direkte_skat_kun_referendum == Falskt

-- Tværgående: par. 29 vs par. 75 — hjælp som ret, men med politisk risiko
-- § 75 giver ret til offentlig hjælp ved manglende forsørgelse.
-- § 29 lader loven bestemme, hvornår understøttelse betragtet som fattighjælp
-- medfører tab af valgret. Grundloven åbner dermed en lovgivningskanal, men
-- fastslår ikke selv, at modtagelse af hjælp medfører tab af valgret.
= par75_hjælp_ret = OffentligHjælpssag(
    kan_selv_ernære_sig_eller_sine = Falskt,
    forsørgelsen_påhviler_en_anden = Falskt,
    underkaster_sig_lovpåbudte_forpligtelser = Sandt
).har_ret_til_offentlig_hjælp_efter_par75_stk2()
= par29_fattighjælp_valgretstab_lovkanal = omfang_af_tab_af_valgret_fastsættes_ved_lov(UnderstøttelseBetragtetSomFattighjælp)
| par75_hjælp_er_ret: par75_hjælp_ret -> par75_hjælp_ret == Sandt
| par29_fattighjælp_kan_koste_valgret: par29_fattighjælp_valgretstab_lovkanal -> par29_fattighjælp_valgretstab_lovkanal == Sandt

-- Tværgående: par. 42 stk. 5 — lavt valgdeltagelse-paradoks
-- Ved folkeafstemning: bortfald kræver flertal + 30% af stemmeberettigede.
-- Hvis kun 40% af stemmeberettigede deltager, og ALLE stemmer imod:
-- mod=40%, deltagende=40%, stemmeberettigede=100%.
-- Flertal: 40% > 20% ✓. Men 40% >= 30% ✓. Bortfald!
-- Hvis kun 20% deltager, og ALLE stemmer imod:
-- mod=20%, deltagende=20%, stemmeberettigede=100%.
-- Flertal: 20% > 10% ✓. Men 20% < 30% ✗. IKKE bortfald!
-- 100% modstand er ikke nok ved lav deltagelse.
= par42_lav_deltagelse = lovforslag_forkastet_ved_folkeafstemning(Folkeafstemningsresultat(
    mod_stemmer = 200000,
    deltagende = 200000,
    stemmeberettigede = 1000000
))
= par42_grænse_deltagelse = lovforslag_forkastet_ved_folkeafstemning(Folkeafstemningsresultat(
    mod_stemmer = 300000,
    deltagende = 300000,
    stemmeberettigede = 1000000
))
| par42_enstemmig_modstand_ikke_nok: par42_lav_deltagelse -> par42_lav_deltagelse == Falskt
| par42_grænse_30pct_nok: par42_grænse_deltagelse -> par42_grænse_deltagelse == Sandt

-- Tværgående: par. 42 stk. 7 — påtrængende love virker før vælgerkontrol
-- Påtrængende lovforslag kan stadfæstes straks. Hvis en tredjedel derefter
-- kræver folkeafstemning og loven forkastes, bortfalder den først fra
-- kundgørelsesdagen. Referendumkontrollen kan altså være efterfølgende,
-- ikke opsættende.
= par42_påtrængende_før_afstemning = straksstadfæstet_lov_har_lovskraft_efter_par42_stk7(FørFolkeafstemning)
= par42_påtrængende_efter_forkastelse = straksstadfæstet_lov_har_lovskraft_efter_par42_stk7(ForkastelseKundgjort)
| påtrængende_lov_midlertidigt_i_kraft: par42_påtrængende_før_afstemning -> par42_påtrængende_før_afstemning == Sandt
| påtrængende_lov_bortfalder_efter_kundgørelse: par42_påtrængende_efter_forkastelse -> par42_påtrængende_efter_forkastelse == Falskt

-- Tværgående: par. 27 + 32 stk. 7 — samme højtidelige forsikring
| forsikring_symmetri_tjenestemand_folketingsmedlem: nyt_medlem_afgiver_højtidelig_forsikring_om_at_holde_grundloven() -> nyt_medlem_afgiver_højtidelig_forsikring_om_at_holde_grundloven()

