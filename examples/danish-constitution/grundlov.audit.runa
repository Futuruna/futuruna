@ sprog da

-- Tynd samlet indgang til prøvningen af Grundlovens kildemodel. De konkrete
-- fortolkningsvalg prøves særskilt i grundlov-fortolkninger.scenario.runa.

@ importer ./grundlov - bestemmelser.audit
@ importer ./grundlov - procedurer.audit
@ importer ./grundlov - rettigheder.audit
@ importer ./grundlov - tvaergaaende.audit

| bestemmelser_audit_er_samlet: bestemmelser_audit_består() -> bestemmelser_audit_består() == Sandt
| procedurer_audit_er_samlet: procedurer_audit_består() -> procedurer_audit_består() == Sandt
| rettigheder_audit_er_samlet: rettigheder_audit_består() -> rettigheder_audit_består() == Sandt
| tvaergaaende_audit_er_samlet: tvaergaaende_audit_består() -> tvaergaaende_audit_består() == Sandt

= samlet_grundlovsaudit_resultat = (
    bestemmelser_audit_består()
    && procedurer_audit_består()
    && rettigheder_audit_består()
    && tvaergaaende_audit_består()
)
| samlet_grundlovsaudit_holder: samlet_grundlovsaudit_resultat -> samlet_grundlovsaudit_resultat == Sandt

? bestemmelser_audit_er_samlet
? procedurer_audit_er_samlet
? rettigheder_audit_er_samlet
? tvaergaaende_audit_er_samlet
? samlet_grundlovsaudit_holder

? all -> {
    @ skriv("Alle målrettede grundlovsaudits holder.")
} else {
    @ skriv("En eller flere målrettede grundlovsaudits fejlede.")
}
