| kilde_er_selskabsskatteloven(kilde: Retskilde) -> (kilde.nummer == 1241 && kilde.år == 2022) || (kilde.nummer == 279 && kilde.år == 2025)
| kilde_er_pensionsbeskatningsloven(kilde: Retskilde) -> kilde.nummer == 1243 && kilde.år == 2024
| kilde_er_sømandsbeskatningsloven(kilde: Retskilde) -> kilde.nummer == 1181 && kilde.år == 2023
