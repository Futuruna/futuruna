# Kildestatus = Gældende | Historisk
# Beregningsformål = AktuelSkatteberegning | HistoriskAudit | KildeDiff
# Retskilde(eli: Tekst, år: Heltal, nummer: Heltal, status: Kildestatus)

= personskatteloven_2019_799 = Retskilde("https://www.retsinformation.dk/eli/lta/2019/799", 2019, 799, Historisk)
= personskatteloven_2021_1284 = Retskilde("https://www.retsinformation.dk/eli/lta/2021/1284", 2021, 1284, Gældende)
= personskat_reform_2024_482 = Retskilde("https://www.retsinformation.dk/eli/lta/2024/482", 2024, 482, Gældende)
= arbejdsmarkedsbidragsloven_2020_121 = Retskilde("https://www.retsinformation.dk/eli/lta/2020/121", 2020, 121, Gældende)
= kommuneskatteloven_2019_935 = Retskilde("https://www.retsinformation.dk/eli/lta/2019/935", 2019, 935, Gældende)
= folkekirkens_økonomilov_2023_424 = Retskilde("https://www.retsinformation.dk/eli/lta/2023/424", 2023, 424, Gældende)
= folkekirke_økonomi_aendring_2025_1772 = Retskilde("https://www.retsinformation.dk/eli/lta/2025/1772", 2025, 1772, Gældende)
= kildeskatteloven_2024_460 = Retskilde("https://www.retsinformation.dk/eli/lta/2024/460", 2024, 460, Gældende)

| kilde_er_personskatteloven(kilde: Retskilde) -> kilde.nummer == 799 || kilde.nummer == 1284
| kilde_er_personskat_reform(kilde: Retskilde) -> kilde.nummer == 482 && kilde.år == 2024
| kilde_er_arbejdsmarkedsbidragsloven(kilde: Retskilde) -> kilde.nummer == 121 && kilde.år == 2020
| kilde_er_kommuneskatteloven(kilde: Retskilde) -> kilde.nummer == 935 && kilde.år == 2019
| kilde_er_folkekirkens_økonomilov(kilde: Retskilde) -> kilde.nummer == 424 && kilde.år == 2023
| kilde_er_folkekirke_økonomi_aendring(kilde: Retskilde) -> kilde.nummer == 1772 && kilde.år == 2025
| kilde_er_kildeskatteloven(kilde: Retskilde) -> kilde.nummer == 460 && kilde.år == 2024

| kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Sandt under kilde.status == Gældende
| kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Sandt under formål == HistoriskAudit || formål == KildeDiff
| exception historisk_kilde kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Falskt under kilde.status == Historisk && formål == AktuelSkatteberegning

= historisk_til_aktuel_beregning = kilde_egnet_til_formål(personskatteloven_2019_799, AktuelSkatteberegning)
= gældende_til_aktuel_beregning = kilde_egnet_til_formål(personskatteloven_2021_1284, AktuelSkatteberegning)
= reform_til_aktuel_beregning = kilde_egnet_til_formål(personskat_reform_2024_482, AktuelSkatteberegning)
= am_lov_til_aktuel_beregning = kilde_egnet_til_formål(arbejdsmarkedsbidragsloven_2020_121, AktuelSkatteberegning)
= kommuneskattelov_til_aktuel_beregning = kilde_egnet_til_formål(kommuneskatteloven_2019_935, AktuelSkatteberegning)
= folkekirkens_økonomilov_til_aktuel_beregning = kilde_egnet_til_formål(folkekirkens_økonomilov_2023_424, AktuelSkatteberegning)
= folkekirke_aendring_til_aktuel_beregning = kilde_egnet_til_formål(folkekirke_økonomi_aendring_2025_1772, AktuelSkatteberegning)
= kildeskattelov_til_aktuel_beregning = kilde_egnet_til_formål(kildeskatteloven_2024_460, AktuelSkatteberegning)
= historisk_til_audit = kilde_egnet_til_formål(personskatteloven_2019_799, HistoriskAudit)

| historisk_kilde_afvises_til_aktuel_beregning: historisk_til_aktuel_beregning -> historisk_til_aktuel_beregning == Falskt
| gældende_kilde_accepteres_til_aktuel_beregning: gældende_til_aktuel_beregning -> gældende_til_aktuel_beregning == Sandt
| reformkilde_accepteres_til_aktuel_beregning: reform_til_aktuel_beregning -> reform_til_aktuel_beregning == Sandt
| arbejdsmarkedsbidragslov_accepteres_til_aktuel_beregning: am_lov_til_aktuel_beregning -> am_lov_til_aktuel_beregning == Sandt
| kommuneskattelov_accepteres_til_aktuel_beregning: kommuneskattelov_til_aktuel_beregning -> kommuneskattelov_til_aktuel_beregning == Sandt
| folkekirkens_økonomilov_accepteres_til_aktuel_beregning: folkekirkens_økonomilov_til_aktuel_beregning -> folkekirkens_økonomilov_til_aktuel_beregning == Sandt
| folkekirke_aendring_accepteres_til_aktuel_beregning: folkekirke_aendring_til_aktuel_beregning -> folkekirke_aendring_til_aktuel_beregning == Sandt
| kildeskattelov_accepteres_til_aktuel_beregning: kildeskattelov_til_aktuel_beregning -> kildeskattelov_til_aktuel_beregning == Sandt
| historisk_kilde_accepteres_til_audit: historisk_til_audit -> historisk_til_audit == Sandt
