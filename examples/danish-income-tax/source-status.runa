| kilde_er_kildeskattebekendtgørelse(kilde: Retskilde) -> kilde.nummer == 839 && kilde.år == 2025
| kilde_er_forskudsregistrering_indeholdelsesprocent(kilde: Retskilde) -> kilde.nummer == 1094 && kilde.år == 2025 || kilde.nummer == 1828 && kilde.år == 2025
| kilde_er_opkrævningsloven(kilde: Retskilde) -> kilde.nummer == 1040 && kilde.år == 2024
| kilde_er_opkrævningslov_aendring(kilde: Retskilde) -> (kilde.nummer == 1694 && kilde.år == 2024) || (kilde.nummer == 1783 && kilde.år == 2025) || (kilde.nummer == 1793 && kilde.år == 2025)
| kilde_er_ligningsloven(kilde: Retskilde) -> kilde.nummer == 1500 && kilde.år == 2025
| kilde_er_kursgevinstloven(kilde: Retskilde) -> kilde.nummer == 1176 && kilde.år == 2025
| kilde_er_aktieavancebeskatningsloven(kilde: Retskilde) -> kilde.nummer == 1098 && kilde.år == 2025
| kilde_er_virksomhedsskatteloven(kilde: Retskilde) -> kilde.nummer == 1836 && kilde.år == 2021
| kilde_er_ejendomsskatteloven(kilde: Retskilde) -> kilde.nummer == 678 && kilde.år == 2023
| kilde_er_ejendomsværdiskatteloven(kilde: Retskilde) -> kilde.nummer == 1590 && kilde.år == 2020

| kilde_metadata_dækker_dato(kilde: Retskilde, dato_yyyymmdd: Heltal) -> kilde.metadata_start_yyyymmdd <= dato_yyyymmdd && dato_yyyymmdd <= kilde.metadata_end_yyyymmdd
| kilde_metadata_horisont_udløbet(kilde: Retskilde, dato_yyyymmdd: Heltal) -> kilde.metadata_end_yyyymmdd < dato_yyyymmdd
| kilde_hentet_på_statusdato(kilde: Retskilde) -> kilde.hentet_yyyymmdd == aktuel_kildestatusdato_yyyymmdd
| kilde_formelt_gældende_men_metadata_udløbet(kilde: Retskilde) -> kilde.status == Gældende && kilde_metadata_horisont_udløbet(kilde, aktuel_kildestatusdato_yyyymmdd)

| kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Sandt under kilde.status == Gældende && formål == AktuelSkatteberegning
| kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Sandt under kilde.status == Gældende && formål == DagsaktuelAutomatiskBeregning && kilde_metadata_dækker_dato(kilde, aktuel_kildestatusdato_yyyymmdd)
| kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Sandt under formål == HistoriskAudit || formål == KildeDiff
| exception historisk_kilde kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Falskt under kilde.status == Historisk && (formål == AktuelSkatteberegning || formål == DagsaktuelAutomatiskBeregning)
| exception udløbet_metadata_horisont kilde_egnet_til_formål(kilde: Retskilde, formål: Beregningsformål) -> Falskt under formål == DagsaktuelAutomatiskBeregning && kilde_metadata_horisont_udløbet(kilde, aktuel_kildestatusdato_yyyymmdd)

