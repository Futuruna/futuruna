--@label:børnebidragsloven_par19::meta:børnebidragsloven_par19_metadata--
----
§ 19. Der kan pålægges faderen eller medmoderen at udrede bidrag til udgifterne
ved fødslen og ved barnets navngivning, herunder ved dåb, og til moderens
underhold 2 måneder før og 1 måned efter fødslen. Under særlige omstændigheder,
navnlig i tilfælde af moderens sygdom forårsaget ved svangerskabet eller
fødslen, kan bidrag pålægges for indtil 4 måneder før og 9 måneder efter
fødslen. Bidraget kan pålægges, uanset at barnet er dødfødt.

Stk. 2. Endvidere kan der pålægges den, der har eller kan have besvangret en
kvinde, eller den, der har givet samtykke til, at en kvinde er behandlet med
assisteret reproduktion, hvis barnet må antages at være blevet til ved denne
behandling, jf. børnelovens §§ 27 eller 27 a, at udrede bidrag til de ved en
abort forvoldte særlige udgifter.

Stk. 3. Bidrag efter denne paragrafs stk. 1 forfalder, hvis barnet er født,
straks ved bidragsfastsættelsen og ellers til de tidspunkter, der er fastsat i
afgørelsen om bidrag efter stk. 1. Bidrag efter stk. 2 forfalder straks.

Stk. 4. Bidrag i henhold til nærværende kapitel tilkommer moderen eller den
offentlige myndighed eller institution, der har afholdt de pågældende udgifter.
----

--@begin:børnebidragsloven_par19--
# Børnebidragslov19Fødselsudfald = Levendefødt | Dødfødt
# Børnebidragslov19Hændelse = Fødsel(fødselsdato: Dato, udfald: Børnebidragslov19Fødselsudfald) | Abort(abortdato: Dato)
# Børnebidragslov19Barselsperiode = AlmindeligBarselsperiode(måneder_før_fødslen: Heltal, måneder_efter_fødslen: Heltal) | ForlængetBarselsperiode(måneder_før_fødslen: Heltal, måneder_efter_fødslen: Heltal, særlige_omstændigheder_dokumentreference: Tekst)
# Børnebidragslov19Bidragsart = Fødselsbidrag | NavngivningsbidragHerunderDåb | Barselsbidrag(periode: Børnebidragslov19Barselsperiode) | Abortudgiftsbidrag(dokumenterede_særlige_udgifter_kroner: Heltal)
# Børnebidragslov19Bidragsydergrundlag = Far | Medmor | HarEllerKanHaveBesvangretKvinden | SamtykkedeTilAssisteretReproduktion
# Børnebidragslov19RetligModtager = Moderen | OffentligMyndighedEllerInstitution(identifikation: Tekst)
# Børnebidragslov19Fastsættelse = FastsatAfFamilieretshuset | DokumenteretBindendeAftale(dokumentreference: Tekst) | Par19UdenDokumenteretFastsættelse
# Børnebidragslov19Forfaldsgrundlag = StraksVedFastsættelsenEfterFødslen | VedFødslenEfterFastsættelseFørFødslen | AndetTidspunktFastsatIAfgørelsen(dokumentreference: Tekst) | StraksVedAbortbidragetsFastsættelse
# Børnebidragslov19Skatterolle = Bidragsyder(modtageridentitet_oplyst: Boolsk, betalt_af_bidragsyderen_selv: Boolsk) | MorSomRetligBidragsmodtager | BarnMedSkattemæssigHenføring
# Børnebidragslov19Navngivningsskattekontekst = UdenNavngivningsskattekontekst | MedNavngivningsskattekontekst(retsgrundlag: Ligningslov10Og11Retsgrundlag, barnets_bopæl: Ligningslov10Og11BarnetsBopæl, forsørger_eller_bidragspligt_over_for_det_offentlige: Boolsk)
# Børnebidragslov19BidragFakta(identifikation: Tekst, indkomstår: Heltal, rolle: Børnebidragslov19Skatterolle, hændelse: Børnebidragslov19Hændelse, bidragsart: Børnebidragslov19Bidragsart, bidragsydergrundlag: Børnebidragslov19Bidragsydergrundlag, retlig_modtager: Børnebidragslov19RetligModtager, fastsættelse: Børnebidragslov19Fastsættelse, ansøgningsgrundlag: Børnebidragslov19Ansøgningsgrundlag, fastsættelsesdato: Dato, forfaldsgrundlag: Børnebidragslov19Forfaldsgrundlag, forfaldsdato: Dato, betalingsdato: Dato, beløb_kroner: Heltal, barnets_identifikation: Tekst, navngivningsskattekontekst: Børnebidragslov19Navngivningsskattekontekst)
# Børnebidragslov19BidragResultat(fakta: Børnebidragslov19BidragFakta, input_gyldigt: Boolsk, hændelse_og_bidragsart_svarer: Boolsk, bidragsydergrundlag_opfyldt: Boolsk, retlig_modtager_gyldig: Boolsk, fastsættelse_dokumenteret: Boolsk, ansøgningsgrundlag_gyldigt: Boolsk, barselsperiode_gyldig: Boolsk, forfaldsgrundlag_opfyldt: Boolsk, satsår_understøttet: Boolsk, officiel_sats_kroner: Heltal, beløb_svarer_til_offentlig_fastsættelse: Boolsk, navngivningsskattekontekst_gyldig: Boolsk, navngivningsskat: Ligningslov10Og11BidragResultat?, modtagerbeskatning_kildeafklaret: Boolsk, ligningsmæssigt_fradrag_kroner: Heltal, personlig_indkomst_kroner: Heltal, kan_sammensættes: Boolsk)
# Børnebidragslov19Årsinput(bidrag: List(Børnebidragslov19BidragFakta))
# Børnebidragslov19Årsresultat(indkomstår: Heltal, input: Børnebidragslov19Årsinput, resultater: List(Børnebidragslov19BidragResultat), identifikationer_entydige: Boolsk, alle_input_gyldige: Boolsk, alle_modtagerbeskatninger_kildeafklarede: Boolsk, samlet_ligningsmæssigt_fradrag_kroner: Heltal, samlet_personlig_indkomst_kroner: Heltal, kan_sammensættes: Boolsk)

| børnebidragslov19_tomt_årsinput() -> Børnebidragslov19Årsinput(bidrag = [])
| børnebidragslov19_hændelsesdato(hændelse: Børnebidragslov19Hændelse) -> match hændelse {
    | Fødsel(fødselsdato, _) -> fødselsdato
    | Abort(abortdato) -> abortdato
}
| børnebidragslov19_fødsel(hændelse: Børnebidragslov19Hændelse) -> match hændelse {
    | Fødsel(_, _) -> Sandt
    | Abort(_) -> Falskt
}
| børnebidragslov19_abort(hændelse: Børnebidragslov19Hændelse) -> match hændelse {
    | Fødsel(_, _) -> Falskt
    | Abort(_) -> Sandt
}
| børnebidragslov19_navngivningsbidrag(art: Børnebidragslov19Bidragsart) -> match art {
    | NavngivningsbidragHerunderDåb -> Sandt
    | _ -> Falskt
}
| børnebidragslov19_hændelse_og_bidragsart_svarer(fakta: Børnebidragslov19BidragFakta) -> match fakta.bidragsart {
    | Fødselsbidrag -> børnebidragslov19_fødsel(fakta.hændelse)
    | NavngivningsbidragHerunderDåb -> match fakta.hændelse {
        | Fødsel(_, Levendefødt) -> Sandt
        | _ -> Falskt
    }
    | Barselsbidrag(_) -> børnebidragslov19_fødsel(fakta.hændelse)
    | Abortudgiftsbidrag(_) -> børnebidragslov19_abort(fakta.hændelse)
}
| børnebidragslov19_stk1_bidragsydergrundlag(grundlag: Børnebidragslov19Bidragsydergrundlag) -> match grundlag {
    | Far -> Sandt
    | Medmor -> Sandt
    | _ -> Falskt
}
| børnebidragslov19_stk2_bidragsydergrundlag(grundlag: Børnebidragslov19Bidragsydergrundlag) -> match grundlag {
    | HarEllerKanHaveBesvangretKvinden -> Sandt
    | SamtykkedeTilAssisteretReproduktion -> Sandt
    | _ -> Falskt
}
| børnebidragslov19_bidragsydergrundlag_opfyldt(fakta: Børnebidragslov19BidragFakta) -> match fakta.bidragsart {
    | Abortudgiftsbidrag(_) -> børnebidragslov19_stk2_bidragsydergrundlag(fakta.bidragsydergrundlag)
    | _ -> børnebidragslov19_stk1_bidragsydergrundlag(fakta.bidragsydergrundlag)
}
| børnebidragslov19_retlig_modtager_gyldig(modtager: Børnebidragslov19RetligModtager) -> match modtager {
    | Moderen -> Sandt
    | OffentligMyndighedEllerInstitution(identifikation) -> identifikation != ""
}
| børnebidragslov19_fastsættelse_dokumenteret(fastsættelse: Børnebidragslov19Fastsættelse) -> match fastsættelse {
    | FastsatAfFamilieretshuset -> Sandt
    | DokumenteretBindendeAftale(dokumentreference) -> dokumentreference != ""
    | Par19UdenDokumenteretFastsættelse -> Falskt
}
| børnebidragslov19_barselsperiode_gyldig(art: Børnebidragslov19Bidragsart) -> match art {
    | Barselsbidrag(AlmindeligBarselsperiode(måneder_før, måneder_efter)) -> måneder_før >= 0 && måneder_før <= 2 && måneder_efter >= 0 && måneder_efter <= 1 && måneder_før + måneder_efter > 0
    | Barselsbidrag(ForlængetBarselsperiode(måneder_før, måneder_efter, dokumentreference)) -> måneder_før >= 0 && måneder_før <= 4 && måneder_efter >= 0 && måneder_efter <= 9 && måneder_før + måneder_efter > 0 && dokumentreference != ""
    | _ -> Sandt
}
| børnebidragslov19_forfaldsgrundlag_opfyldt(fakta: Børnebidragslov19BidragFakta) -> match fakta.hændelse {
    | Fødsel(fødselsdato, _) -> match fakta.forfaldsgrundlag {
        | StraksVedFastsættelsenEfterFødslen -> dato_før_eller_lig_med(fødselsdato, fakta.fastsættelsesdato) && fakta.forfaldsdato == fakta.fastsættelsesdato
        | VedFødslenEfterFastsættelseFørFødslen -> dato_før(fakta.fastsættelsesdato, fødselsdato) && fakta.forfaldsdato == fødselsdato
        | AndetTidspunktFastsatIAfgørelsen(dokumentreference) -> dokumentreference != "" && dato_før_eller_lig_med(fakta.fastsættelsesdato, fakta.forfaldsdato)
        | StraksVedAbortbidragetsFastsættelse -> Falskt
    }
    | Abort(_) -> match fakta.forfaldsgrundlag {
        | StraksVedAbortbidragetsFastsættelse -> fakta.forfaldsdato == fakta.fastsættelsesdato
        | _ -> Falskt
    }
}
| børnebidragslov19_barselsmåneder(art: Børnebidragslov19Bidragsart) -> match art {
    | Barselsbidrag(AlmindeligBarselsperiode(måneder_før, måneder_efter)) -> måneder_før + måneder_efter
    | Barselsbidrag(ForlængetBarselsperiode(måneder_før, måneder_efter, _)) -> måneder_før + måneder_efter
    | _ -> 0
}
| børnebidragslov19_officiel_sats_kroner(fakta: Børnebidragslov19BidragFakta) -> match fakta.bidragsart {
    | Fødselsbidrag -> børnebidragslov19_fødselsbidrag_sats_kroner(fakta.fastsættelsesdato.år)
    | NavngivningsbidragHerunderDåb -> børnebidragslov19_navngivningsbidrag_sats_kroner(fakta.fastsættelsesdato.år)
    | Barselsbidrag(_) -> børnebidragslov19_barselsbidrag_månedssats_kroner(fakta.fastsættelsesdato.år) * børnebidragslov19_barselsmåneder(fakta.bidragsart)
    | Abortudgiftsbidrag(dokumenterede_særlige_udgifter_kroner) -> dokumenterede_særlige_udgifter_kroner
}
| børnebidragslov19_beløb_svarer_til_offentlig_fastsættelse(fakta: Børnebidragslov19BidragFakta) -> match fakta.fastsættelse {
    | FastsatAfFamilieretshuset -> fakta.beløb_kroner == børnebidragslov19_officiel_sats_kroner(fakta)
    | DokumenteretBindendeAftale(_) -> match fakta.bidragsart {
        | Abortudgiftsbidrag(dokumenterede_særlige_udgifter_kroner) -> fakta.beløb_kroner == dokumenterede_særlige_udgifter_kroner
        | _ -> fakta.beløb_kroner > 0
    }
    | Par19UdenDokumenteretFastsættelse -> Falskt
}
| børnebidragslov19_mor_som_retlig_modtager(modtager: Børnebidragslov19RetligModtager) -> match modtager {
    | Moderen -> Sandt
    | _ -> Falskt
}
| børnebidragslov19_rolle_og_modtager_svarer(fakta: Børnebidragslov19BidragFakta) -> match fakta.rolle {
    | Bidragsyder(_, _) -> Sandt
    | MorSomRetligBidragsmodtager -> børnebidragslov19_mor_som_retlig_modtager(fakta.retlig_modtager)
    | BarnMedSkattemæssigHenføring -> børnebidragslov19_navngivningsbidrag(fakta.bidragsart) && børnebidragslov19_mor_som_retlig_modtager(fakta.retlig_modtager)
}
| børnebidragslov19_navngivningsskattekontekst_krævet(fakta: Børnebidragslov19BidragFakta) -> børnebidragslov19_navngivningsbidrag(fakta.bidragsart) && match fakta.rolle {
    | Bidragsyder(_, _) -> Sandt
    | BarnMedSkattemæssigHenføring -> Sandt
    | MorSomRetligBidragsmodtager -> Falskt
}
| børnebidragslov19_navngivningsskattekontekst_gyldig(fakta: Børnebidragslov19BidragFakta) -> hvis børnebidragslov19_navngivningsskattekontekst_krævet(fakta) {
    match fakta.navngivningsskattekontekst {
        | MedNavngivningsskattekontekst(_, _, _) -> fakta.barnets_identifikation != ""
        | UdenNavngivningsskattekontekst -> Falskt
    }
} ellers {
    fakta.navngivningsskattekontekst == UdenNavngivningsskattekontekst
}
| børnebidragslov19_input_gyldigt(fakta: Børnebidragslov19BidragFakta) -> fakta.identifikation != "" && dato_gyldig(børnebidragslov19_hændelsesdato(fakta.hændelse)) && dato_gyldig(fakta.fastsættelsesdato) && dato_gyldig(fakta.forfaldsdato) && dato_gyldig(fakta.betalingsdato) && fakta.indkomstår == fakta.betalingsdato.år && børnebidragslov19_satsår_understøttet(fakta.fastsættelsesdato.år) && børnebidragslov19_hændelse_og_bidragsart_svarer(fakta) && børnebidragslov19_bidragsydergrundlag_opfyldt(fakta) && børnebidragslov19_retlig_modtager_gyldig(fakta.retlig_modtager) && børnebidragslov19_fastsættelse_dokumenteret(fakta.fastsættelse) && børnebidragslov19_ansøgningsgrundlag_gyldigt(fakta) && børnebidragslov19_barselsperiode_gyldig(fakta.bidragsart) && børnebidragslov19_forfaldsgrundlag_opfyldt(fakta) && børnebidragslov19_beløb_svarer_til_offentlig_fastsættelse(fakta) && børnebidragslov19_rolle_og_modtager_svarer(fakta) && børnebidragslov19_navngivningsskattekontekst_gyldig(fakta)
--@end:børnebidragsloven_par19--

= børnebidragsbekendtgørelsen_bek285_par3_par4_par9_par10_par11 = Børnebidragslov19KildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2019/285",
    identifier = "Bidragsbekendtgørelsen §§ 3-4 og 9-11 i BEK nr. 285 af 20/03/2019",
    hentet_dato = "2026-08-10",
    ændringsstatus = "Gældende bekendtgørelse; fristerne styrer offentlig fastsættelse af § 19-bidrag"
)
= børnebidragsbekendtgørelsen_par19_frist_metadata = Metadata(
    attachments = (
        Source(value = børnebidragsbekendtgørelsen_bek285_par3_par4_par9_par10_par11),
        Dependency(value = børnebidragsloven_lbk773_par19),
        Guidance(value = børnebidragsloven_bidrag_vejledning),
    )
)

--@label:børnebidragsbekendtgørelsen_par19_frist::meta:børnebidragsbekendtgørelsen_par19_frist_metadata--
----
§ 3. Børnebidrag efter § 14, stk. 1, i lov om børns forsørgelse fastsættes fra
den relevante ændring i barnets forhold, der udløste ansøgningen om bidrag,
hvis ansøgningen er indgivet inden 2 måneder efter den pågældende begivenhed.

§ 4. Selvom en ansøgning om fastsættelse af børnebidrag efter § 14, stk. 1, i
lov om børns forsørgelse er indgivet efter udløb af fristen i § 3, fastsættes
bidraget fra barnets fødsel, når en sag om faderskabet eller medmoderskabet til
barnet er indledt i forbindelse med barnets fødsel, og ansøgningen om
fastsættelse af bidrag er indgivet inden 2 måneder efter afslutningen af sagen om
faderskab eller medmoderskab. Bidraget fastsættes dog først fra afslutningen af
sagen om faderskab eller medmoderskab, hvis sagen om faderskab eller
medmoderskab først afsluttes mere end 2 år efter barnets fødsel.

§ 9. Uanset §§ 3-8 kan bidraget fastsættes fra et tidligere eller senere
tidspunkt, hvis der foreligger helt særlige omstændigheder.

§ 10. Der fastsættes normalt kun bidrag til udgifterne ved fødslen og ved
barnets navngivning, herunder ved dåb, og bidrag til moderens underhold før og
efter fødslen efter § 19, stk. 1, i lov om børns forsørgelse, hvis de tidsmæssige
betingelser for at fastsætte bidrag til barnet fra fødslen er opfyldt.

§ 11. Der fastsættes normalt kun bidrag til dækning af de ved en abort forvoldte
særlige udgifter efter § 19, stk. 2, i lov om børns forsørgelse, hvis ansøgningen
er indgivet inden 2 måneder efter aborten.
----

--@begin:børnebidragsbekendtgørelsen_par19_frist--
# Børnebidragslov19Fristgrundlag = FødslenSomFristgrundlag | FaderskabEllerMedmoderskabIndledtVedFødslen(sagsafslutningsdato: Dato, sagsreference: Tekst) | AbortenSomFristgrundlag | HeltSærligeOmstændigheder(afgørelsesreference: Tekst)
# Børnebidragslov19Ansøgningsgrundlag = Myndighedsansøgning(ansøgningsdato: Dato, fristgrundlag: Børnebidragslov19Fristgrundlag) | PrivatAftaleUdenMyndighedsansøgning

| børnebidragslov19_fødselsfrist_gyldig(fødselsdato: Dato, ansøgningsdato: Dato, fastsættelsesdato: Dato, fristgrundlag: Børnebidragslov19Fristgrundlag) -> match fristgrundlag {
    | FødslenSomFristgrundlag -> dato_før_eller_lig_med(ansøgningsdato, dato_plus_måneder(fødselsdato, 2))
    | FaderskabEllerMedmoderskabIndledtVedFødslen(sagsafslutningsdato, sagsreference) -> dato_gyldig(sagsafslutningsdato) && sagsreference != "" && dato_før_eller_lig_med(sagsafslutningsdato, dato_plus_år(fødselsdato, 2)) && dato_før_eller_lig_med(ansøgningsdato, dato_plus_måneder(sagsafslutningsdato, 2)) && dato_før_eller_lig_med(sagsafslutningsdato, fastsættelsesdato)
    | HeltSærligeOmstændigheder(afgørelsesreference) -> afgørelsesreference != ""
    | AbortenSomFristgrundlag -> Falskt
}
| børnebidragslov19_abortfrist_gyldig(abortdato: Dato, ansøgningsdato: Dato, fristgrundlag: Børnebidragslov19Fristgrundlag) -> match fristgrundlag {
    | AbortenSomFristgrundlag -> dato_før_eller_lig_med(abortdato, ansøgningsdato) && dato_før_eller_lig_med(ansøgningsdato, dato_plus_måneder(abortdato, 2))
    | HeltSærligeOmstændigheder(afgørelsesreference) -> afgørelsesreference != ""
    | _ -> Falskt
}
| børnebidragslov19_myndighedsansøgning_gyldig(fakta: Børnebidragslov19BidragFakta, ansøgningsdato: Dato, fristgrundlag: Børnebidragslov19Fristgrundlag) -> dato_gyldig(ansøgningsdato) && dato_før_eller_lig_med(ansøgningsdato, fakta.fastsættelsesdato) && match fakta.hændelse {
    | Fødsel(fødselsdato, _) -> børnebidragslov19_fødselsfrist_gyldig(fødselsdato, ansøgningsdato, fakta.fastsættelsesdato, fristgrundlag)
    | Abort(abortdato) -> børnebidragslov19_abortfrist_gyldig(abortdato, ansøgningsdato, fristgrundlag)
}
| børnebidragslov19_ansøgningsgrundlag_gyldigt(fakta: Børnebidragslov19BidragFakta) -> match fakta.fastsættelse {
    | FastsatAfFamilieretshuset -> match fakta.ansøgningsgrundlag {
        | Myndighedsansøgning(ansøgningsdato, fristgrundlag) -> børnebidragslov19_myndighedsansøgning_gyldig(fakta, ansøgningsdato, fristgrundlag)
        | PrivatAftaleUdenMyndighedsansøgning -> Falskt
    }
    | DokumenteretBindendeAftale(_) -> fakta.ansøgningsgrundlag == PrivatAftaleUdenMyndighedsansøgning
    | Par19UdenDokumenteretFastsættelse -> Falskt
}
--@end:børnebidragsbekendtgørelsen_par19_frist--

= skat_børnebidrag_fødsel_vejledning = Børnebidragslov19KildeInfo(
    url = "https://info.skat.dk/data.aspx?oid=2061803",
