--@label:børnebidragsloven_par19_skat::meta:børnebidragsloven_par19_skat_metadata--
----
Bidrag, der efter pålæg efter § 19 i lov om børns forsørgelse betales af en far
til et barn uden for ægteskab til dækning af udgifter ved fødslen og til
moderens underhold omkring fødslen, kan ikke fratrækkes, da sådanne ydelser
betragtes som bidrag til moderen og ikke til barnet.

Fradragsretten omfatter principielt kun løbende underholdsbidrag, men efter
praksis omfatter fradragsretten dog også visse engangsbidrag, der betales i
anledning af et barns fødsel samt i anledning af, at barnet når
konfirmationsalderen. Se LSRM 1946.88.LSR og afsnit C.A.9.2 om børns
beskatning.

Det samme er gældende for bidrag i anledning af dåb eller navngivning, som
udgør et beløb svarende til det månedlige normalbidrags grundbeløb.
----

----
Implementeringsnote: C.A.9.5 afskærer udtrykkeligt fradrag for fødselsudgifter
og moderens underhold efter § 19, stk. 1. Abortudgiftsbidragets nulfradrag
afledes særskilt af § 19, stk. 2 og 4, sammenholdt med Ligningslovens §§ 10-11:
betalingen tilkommer moren eller den myndighed eller institution, der har
afholdt udgiften, og er ikke et underholdsbidrag til et barn. De fundne
officielle kilder afklarer ikke modtagerbeskatningen hos moren; den gren fejler
derfor lukket.
----

--@begin:børnebidragsloven_par19_skat--
| børnebidragslov19_ll_rolle(rolle: Børnebidragslov19Skatterolle) -> match rolle {
    | Bidragsyder(modtageridentitet_oplyst, _) -> Bidragsyder(modtageridentitet_oplyst = modtageridentitet_oplyst)
    | BarnMedSkattemæssigHenføring -> Bidragsmodtager
    | MorSomRetligBidragsmodtager -> Bidragsmodtager
}
| børnebidragslov19_ll_fastsættelse(fastsættelse: Børnebidragslov19Fastsættelse) -> match fastsættelse {
    | FastsatAfFamilieretshuset -> FastsatAfOffentligMyndighed
    | DokumenteretBindendeAftale(_) -> DokumenteretPrivatAftale(fradragsvurdering = IkkeRelevantForFradraget)
    | Par19UdenDokumenteretFastsættelse -> UdenDokumenteretFastsættelse
}
| børnebidragslov19_betalt_af_bidragsyderen_selv(rolle: Børnebidragslov19Skatterolle) -> match rolle {
    | Bidragsyder(_, betalt) -> betalt
    | _ -> Falskt
}
| børnebidragslov19_fødselsdato(fakta: Børnebidragslov19BidragFakta) -> match fakta.hændelse {
    | Fødsel(fødselsdato, _) -> fødselsdato
    | Abort(abortdato) -> abortdato
}
| børnebidragslov19_navngivningsskat_fakta(fakta: Børnebidragslov19BidragFakta, retsgrundlag: Ligningslov10Og11Retsgrundlag, bopæl: Ligningslov10Og11BarnetsBopæl, offentlig_forsørgerpligt: Boolsk) -> Ligningslov10Og11BidragFakta(
    identifikation = fakta.identifikation,
    indkomstår = fakta.indkomstår,
    rolle = børnebidragslov19_ll_rolle(fakta.rolle),
    retsgrundlag = retsgrundlag,
    modtager_identifikation = fakta.barnets_identifikation,
    modtager = Barn(fakta = Ligningslov10Og11BarnFakta(
        fødselsdato = børnebidragslov19_fødselsdato(fakta),
        bopæl = bopæl,
        forsørger_eller_bidragspligt_over_for_det_offentlige = offentlig_forsørgerpligt
    )),
    fastsættelse = børnebidragslov19_ll_fastsættelse(fakta.fastsættelse),
    bidragsart = DåbsEllerNavngivningsbidrag(dokumenteret_til_begivenhedsudgifter = Sandt),
    betalingsvej = BetaltTilDenBidragsberettigede,
    restancestatus = OrdinærBetaling,
    forfaldsdato = fakta.forfaldsdato,
    betalingsdato = fakta.betalingsdato,
    beløb_kroner = fakta.beløb_kroner,
    betalt_af_bidragsyderen_selv = børnebidragslov19_betalt_af_bidragsyderen_selv(fakta.rolle)
)
| børnebidragslov19_navngivningsskat(fakta: Børnebidragslov19BidragFakta) -> match fakta.navngivningsskattekontekst {
    | UdenNavngivningsskattekontekst -> None
    | MedNavngivningsskattekontekst(retsgrundlag, bopæl, offentlig_forsørgerpligt) -> Some(ligningslov10_11_bidrag_resultat(børnebidragslov19_navngivningsskat_fakta(fakta, retsgrundlag, bopæl, offentlig_forsørgerpligt)))
}
| børnebidragslov19_navngivningsskat_kan_sammensættes(resultat: Ligningslov10Og11BidragResultat?) -> match resultat {
    | None -> Falskt
    | Some(navngivningsskat) -> navngivningsskat.input_gyldigt && navngivningsskat.bidragsbetingelser_opfyldt
}
| børnebidragslov19_modtagerbeskatning_kildeafklaret(fakta: Børnebidragslov19BidragFakta) -> match fakta.rolle {
    | Bidragsyder(_, _) -> Sandt
    | BarnMedSkattemæssigHenføring -> børnebidragslov19_navngivningsbidrag(fakta.bidragsart)
    | MorSomRetligBidragsmodtager -> Falskt
}
| børnebidragslov19_ligningsmæssigt_fradrag_kroner(fakta: Børnebidragslov19BidragFakta, navngivningsskat: Ligningslov10Og11BidragResultat?) -> match fakta.rolle {
    | Bidragsyder(_, _) -> hvis børnebidragslov19_navngivningsbidrag(fakta.bidragsart) {
        match navngivningsskat {
            | None -> 0
            | Some(resultat) -> resultat.ligningsmæssigt_fradrag_kroner
        }
    } ellers {
        0
    }
    | _ -> 0
}
| børnebidragslov19_personlig_indkomst_kroner(fakta: Børnebidragslov19BidragFakta, navngivningsskat: Ligningslov10Og11BidragResultat?) -> match fakta.rolle {
    | BarnMedSkattemæssigHenføring -> match navngivningsskat {
        | None -> 0
        | Some(resultat) -> resultat.personlig_indkomst_kroner
    }
    | _ -> 0
}
| børnebidragslov19_bidrag_resultat(fakta: Børnebidragslov19BidragFakta) -> {
    = input_gyldigt = børnebidragslov19_input_gyldigt(fakta)
    = navngivningsskat = børnebidragslov19_navngivningsskat(fakta)
    = navngivningsskattekontekst_gyldig = børnebidragslov19_navngivningsskattekontekst_gyldig(fakta) && hvis børnebidragslov19_navngivningsskattekontekst_krævet(fakta) { børnebidragslov19_navngivningsskat_kan_sammensættes(navngivningsskat) } ellers { Sandt }
    = modtagerbeskatning_kildeafklaret = børnebidragslov19_modtagerbeskatning_kildeafklaret(fakta)
    Børnebidragslov19BidragResultat(
        fakta = fakta,
        input_gyldigt = input_gyldigt,
        hændelse_og_bidragsart_svarer = børnebidragslov19_hændelse_og_bidragsart_svarer(fakta),
        bidragsydergrundlag_opfyldt = børnebidragslov19_bidragsydergrundlag_opfyldt(fakta),
        retlig_modtager_gyldig = børnebidragslov19_retlig_modtager_gyldig(fakta.retlig_modtager),
        fastsættelse_dokumenteret = børnebidragslov19_fastsættelse_dokumenteret(fakta.fastsættelse),
        ansøgningsgrundlag_gyldigt = børnebidragslov19_ansøgningsgrundlag_gyldigt(fakta),
        barselsperiode_gyldig = børnebidragslov19_barselsperiode_gyldig(fakta.bidragsart),
        forfaldsgrundlag_opfyldt = børnebidragslov19_forfaldsgrundlag_opfyldt(fakta),
        satsår_understøttet = børnebidragslov19_satsår_understøttet(fakta.fastsættelsesdato.år),
        officiel_sats_kroner = børnebidragslov19_officiel_sats_kroner(fakta),
        beløb_svarer_til_offentlig_fastsættelse = børnebidragslov19_beløb_svarer_til_offentlig_fastsættelse(fakta),
        navngivningsskattekontekst_gyldig = navngivningsskattekontekst_gyldig,
        navngivningsskat = navngivningsskat,
        modtagerbeskatning_kildeafklaret = modtagerbeskatning_kildeafklaret,
        ligningsmæssigt_fradrag_kroner = hvis input_gyldigt && navngivningsskattekontekst_gyldig { børnebidragslov19_ligningsmæssigt_fradrag_kroner(fakta, navngivningsskat) } ellers { 0 },
        personlig_indkomst_kroner = hvis input_gyldigt && navngivningsskattekontekst_gyldig && modtagerbeskatning_kildeafklaret { børnebidragslov19_personlig_indkomst_kroner(fakta, navngivningsskat) } ellers { 0 },
        kan_sammensættes = input_gyldigt && navngivningsskattekontekst_gyldig && modtagerbeskatning_kildeafklaret
    )
}
| børnebidragslov19_identifikationer_entydige(bidrag: List(Børnebidragslov19BidragFakta)) -> length(distinct(map(bidrag, |fakta: Børnebidragslov19BidragFakta| fakta.identifikation))) == length(bidrag) && all(bidrag, |fakta: Børnebidragslov19BidragFakta| fakta.identifikation != "")
| børnebidragslov19_årsresultat(indkomstår: Heltal, input: Børnebidragslov19Årsinput) -> {
    = identifikationer_entydige = børnebidragslov19_identifikationer_entydige(input.bidrag)
    = resultater = map(input.bidrag, børnebidragslov19_bidrag_resultat)
    = alle_input_gyldige = identifikationer_entydige && all(input.bidrag, |fakta: Børnebidragslov19BidragFakta| fakta.indkomstår == indkomstår) && all(resultater, |resultat: Børnebidragslov19BidragResultat| resultat.input_gyldigt && resultat.navngivningsskattekontekst_gyldig)
    = alle_modtagerbeskatninger_kildeafklarede = all(resultater, |resultat: Børnebidragslov19BidragResultat| resultat.modtagerbeskatning_kildeafklaret)
    = kan_sammensættes = alle_input_gyldige && alle_modtagerbeskatninger_kildeafklarede && all(resultater, |resultat: Børnebidragslov19BidragResultat| resultat.kan_sammensættes)
    Børnebidragslov19Årsresultat(
        indkomstår = indkomstår,
        input = input,
        resultater = resultater,
        identifikationer_entydige = identifikationer_entydige,
        alle_input_gyldige = alle_input_gyldige,
        alle_modtagerbeskatninger_kildeafklarede = alle_modtagerbeskatninger_kildeafklarede,
        samlet_ligningsmæssigt_fradrag_kroner = hvis kan_sammensættes { foldl(resultater, 0, |sum_kroner: Heltal, resultat: Børnebidragslov19BidragResultat| sum_kroner + resultat.ligningsmæssigt_fradrag_kroner) } ellers { 0 },
        samlet_personlig_indkomst_kroner = hvis kan_sammensættes { foldl(resultater, 0, |sum_kroner: Heltal, resultat: Børnebidragslov19BidragResultat| sum_kroner + resultat.personlig_indkomst_kroner) } ellers { 0 },
        kan_sammensættes = kan_sammensættes
    )
}
--@end:børnebidragsloven_par19_skat--

