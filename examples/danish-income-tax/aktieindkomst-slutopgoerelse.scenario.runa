@ print("scenarie1 mand aktieindkomst med aegtefaelles ubrugt grundbeloeb: samlet skat inkl. endelig aktieskat " + vis(scenarie1_mand_aktie_slutopgørelse.samlet_skat_inkl_endelig_aktieskat_kroner))
