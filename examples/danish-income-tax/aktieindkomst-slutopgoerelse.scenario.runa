    a_skat_månedligt_kroner = scenarie1_mand_genereret_skattekort_a_skat,
    aktieindkomst_kroner = 150000,
    ægtefælle_aktieindkomst_kroner = 0,
    samlevende_ved_årets_udløb = Sandt,
    indeholdt_udbytteskat_kroner = 40500
)
