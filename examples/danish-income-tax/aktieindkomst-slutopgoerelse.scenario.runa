@ sprog da

@ importer ./aktieindkomst - slutopgoerelse
@ importer ./husholdning - scenarier.scenario

-- Aktieindkomst i årsopgørelsen for den fiktive lønmodtager.

= scenarie1_mand_aktie_slutopgørelse_case = AktieindkomstSlutopgørelseCase(
    person = scenarie1_mand,
    a_skat_månedligt_kroner = scenarie1_mand_genereret_skattekort_a_skat,
    aktieindkomst_kroner = 150000,
    ægtefælle_aktieindkomst_kroner = 0,
    samlevende_ved_årets_udløb = Sandt,
    indeholdt_udbytteskat_kroner = 40500
)
= scenarie1_mand_aktie_slutopgørelse = aktieindkomst_slutopgørelse_resultat(scenarie1_mand_aktie_slutopgørelse_case)

= scenarie1_mand_aktie_høj_skat_case = AktieindkomstSlutopgørelseCase(
    person = scenarie1_mand,
    a_skat_månedligt_kroner = scenarie1_mand_genereret_skattekort_a_skat,
    aktieindkomst_kroner = 150000,
    ægtefælle_aktieindkomst_kroner = 100000,
    samlevende_ved_årets_udløb = Sandt,
    indeholdt_udbytteskat_kroner = 40500
)
= scenarie1_mand_aktie_høj_skat_slutopgørelse = aktieindkomst_slutopgørelse_resultat(scenarie1_mand_aktie_høj_skat_case)

= scenarie1_lav_løn_høj_aktie_person = beregn_lønmodtager(LønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 0,
    positiv_nettokapitalindkomst_kroner = 0,
    ligningsmæssige_fradrag_kroner = 0,
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
))
= scenarie1_lav_løn_høj_aktie_case = AktieindkomstSlutopgørelseCase(
    person = scenarie1_lav_løn_høj_aktie_person,
    a_skat_månedligt_kroner = 0,
    aktieindkomst_kroner = 150000,
    ægtefælle_aktieindkomst_kroner = 100000,
    samlevende_ved_årets_udløb = Sandt,
    indeholdt_udbytteskat_kroner = 40500
)
= scenarie1_lav_løn_høj_aktie_slutopgørelse = aktieindkomst_slutopgørelse_resultat(scenarie1_lav_løn_høj_aktie_case)

= scenarie1_mand_negativ_aktie_slutopgørelse_case = AktieindkomstNegativSlutopgørelseCase(
    person = scenarie1_mand,
    a_skat_månedligt_kroner = scenarie1_mand_genereret_skattekort_a_skat,
    negativ_aktieindkomst_kroner = -120000,
    ægtefælle_positiv_aktieindkomst_kroner = 20000,
    ægtefælle_slutskat_kroner = 0,
    samlevende_ved_årets_udløb = Sandt,
    indeholdt_udbytteskat_kroner = 2700
)
= scenarie1_mand_negativ_aktie_slutopgørelse = aktieindkomst_negativ_slutopgørelse_resultat(scenarie1_mand_negativ_aktie_slutopgørelse_case)

= scenarie1_mand_stor_negativ_aktie_slutopgørelse_case = AktieindkomstNegativSlutopgørelseCase(
    person = scenarie1_mand,
    a_skat_månedligt_kroner = scenarie1_mand_genereret_skattekort_a_skat,
    negativ_aktieindkomst_kroner = -900000,
    ægtefælle_positiv_aktieindkomst_kroner = 0,
    ægtefælle_slutskat_kroner = 50000,
    samlevende_ved_årets_udløb = Sandt,
    indeholdt_udbytteskat_kroner = 2700
)
= scenarie1_mand_stor_negativ_aktie_slutopgørelse = aktieindkomst_negativ_slutopgørelse_resultat(scenarie1_mand_stor_negativ_aktie_slutopgørelse_case)

= scenarie1_par_negativ_aktie_slutopgørelse_case = AktieindkomstNegativParSlutopgørelseCase(
    egen_person = scenarie1_mand,
    ægtefælle_person = scenarie1_ægtefælle,
    egen_a_skat_månedligt_kroner = scenarie1_mand_genereret_skattekort_a_skat,
    ægtefælle_a_skat_månedligt_kroner = scenarie1_ægtefælle_genereret_skattekort_a_skat,
    egen_negativ_aktieindkomst_kroner = -900000,
    ægtefælle_positiv_aktieindkomst_kroner = 150000,
