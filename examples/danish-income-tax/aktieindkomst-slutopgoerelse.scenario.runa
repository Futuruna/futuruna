| fremført_negativ_aktieskat_bruger_ældste_tranche_først: fremført_negativ_aktieskat_parfordeling -> fremført_negativ_aktieskat_parfordeling.input_gyldigt && head(fremført_negativ_aktieskat_parfordeling.egne_anvendelser).tranche.oprindelsesår == 2023 && head(fremført_negativ_aktieskat_parfordeling.egne_anvendelser).modregnet_i_egen_slutskat_kroner == 100 && head(tail(fremført_negativ_aktieskat_parfordeling.egne_anvendelser)).tranche.oprindelsesår == 2024 && head(tail(fremført_negativ_aktieskat_parfordeling.egne_anvendelser)).modregnet_i_egen_slutskat_kroner == 20 && head(tail(fremført_negativ_aktieskat_parfordeling.egne_anvendelser)).modregnet_i_ægtefælles_slutskat_kroner == 30 && head(tail(fremført_negativ_aktieskat_parfordeling.egne_anvendelser)).fremført_kroner == 30
| fremført_negativ_aktieskat_bevarer_primo_anvendelse_og_ultimo: fremført_negativ_aktieskat_parfordeling -> fremført_negativ_aktieskat_parfordeling.samlet_negativ_skat_primo_kroner == 250 && fremført_negativ_aktieskat_parfordeling.samlet_negativ_skat_modregnet_kroner == 220 && fremført_negativ_aktieskat_parfordeling.samlet_negativ_skat_fremført_kroner == 30 && fremført_negativ_aktieskat_parfordeling.egen_slutskat_modregnet_kroner == 120 && fremført_negativ_aktieskat_parfordeling.ægtefælles_slutskat_modregnet_kroner == 100 && fremført_negativ_aktieskat_parfordeling.samlet_slutskat_efter_fremført_negativ_skat_kroner == 0
| fremført_negativ_aktieskat_er_symmetrisk_ved_rolleombytning: fremført_negativ_aktieskat_parfordeling_ombyttet -> fremført_negativ_aktieskat_parfordeling_ombyttet.egne_anvendelser == fremført_negativ_aktieskat_parfordeling.ægtefælles_anvendelser && fremført_negativ_aktieskat_parfordeling_ombyttet.ægtefælles_anvendelser == fremført_negativ_aktieskat_parfordeling.egne_anvendelser && fremført_negativ_aktieskat_parfordeling_ombyttet.egen_slutskat_modregnet_kroner == fremført_negativ_aktieskat_parfordeling.ægtefælles_slutskat_modregnet_kroner && fremført_negativ_aktieskat_parfordeling_ombyttet.ægtefælles_slutskat_modregnet_kroner == fremført_negativ_aktieskat_parfordeling.egen_slutskat_modregnet_kroner && fremført_negativ_aktieskat_parfordeling_ombyttet.samlet_negativ_skat_fremført_kroner == fremført_negativ_aktieskat_parfordeling.samlet_negativ_skat_fremført_kroner
| fremført_negativ_aktieskat_kræver_samliv_for_ægtefællemodregning: fremført_negativ_aktieskat_ikke_samlevende -> fremført_negativ_aktieskat_ikke_samlevende.egen_slutskat_modregnet_kroner == 120 && fremført_negativ_aktieskat_ikke_samlevende.ægtefælles_slutskat_modregnet_kroner == 70 && fremført_negativ_aktieskat_ikke_samlevende.samlet_negativ_skat_fremført_kroner == 60 && fremført_negativ_aktieskat_ikke_samlevende.ægtefælles_slutskat_efter_fremført_negativ_skat_kroner == 30
| fremført_negativ_aktieskat_afviser_dobbelt_oprindelsesår: fremført_negativ_aktieskat_dobbelt_oprindelsesår -> fremført_negativ_aktieskat_dobbelt_oprindelsesår.input_gyldigt == Falskt && fremført_negativ_aktieskat_dobbelt_oprindelsesår.samlet_negativ_skat_primo_kroner == 0 && fremført_negativ_aktieskat_dobbelt_oprindelsesår.samlet_negativ_skat_modregnet_kroner == 0 && fremført_negativ_aktieskat_dobbelt_oprindelsesår.samlet_slutskat_efter_fremført_negativ_skat_kroner == 220

