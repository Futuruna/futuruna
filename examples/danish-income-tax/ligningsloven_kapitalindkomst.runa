# Ligningslov12BÅrsfordeling(modtager_ikke_skattepligtig_aktivandel_kroner: Heltal, yder_fradrag_helt_afskåret_kroner: Heltal, yder_anskaffelsessum_forhøjes_i_stedet_kroner: Heltal, overtager_nærtstående_fradrag_afskåret_kroner: Heltal)
# Ligningslov12BOphørsfordeling(modtager_ikke_skattepligtig_aktivandel_kroner: Heltal, yder_ophør_ikke_medregnes_kroner: Heltal, yder_ophør_nedsætter_anskaffelsessum_kroner: Heltal)
# Ligningslov12BInput(indkomstår: Heltal, rolle: Ligningslov12BRolle, aftale: Ligningslov12BAftale, position: Ligningslov12BPosition, begivenhed: Ligningslov12BBegivenhed, årsfordeling: Ligningslov12BÅrsfordeling, ophørsfordeling: Ligningslov12BOphørsfordeling)
# Ligningslov12BResultat(indkomstår: Heltal, rolle: Ligningslov12BRolle, begivenhed: Ligningslov12BBegivenhed, regime: Ligningslov12BRegime, aftaledato_gyldig: Boolsk, input_gyldigt: Boolsk, omfattet_af_par12b: Boolsk, kapitalisering_påkrævet: Boolsk, saldo_påkrævet: Boolsk, saldo_indgangsværdi_ved_skattepligtsindtræden_kroner: Heltal, oplysningspligter_overholdt: Boolsk, henstandsgrundlag_gyldigt: Boolsk, omfattet_af_stk4_til_7_eller_9: Boolsk, saldo_reduktion_kroner: Heltal, saldo_efter_reduktion_kroner: Heltal, negativ_saldo_beløb_kroner: Heltal, efterfølgende_betalte_ydelser_kroner: Heltal, ophørs_saldo_kroner: Heltal, modtager_skattepligtigt_kroner: Heltal, modtager_fradrag_kroner: Heltal, yder_fradrag_kroner: Heltal, yder_skattepligtigt_kroner: Heltal, tredjemand_skattepligtigt_kroner: Heltal, anskaffelsessum_forhøjes_kroner: Heltal, anskaffelsessum_nedsættes_kroner: Heltal, overtager_indgangsværdi_kroner: Heltal, netto_skattepligtigt_eller_fradragsberettiget_kroner: Heltal)

| ll12b_skudår(år: Heltal) -> år % 400 == 0 || år % 4 == 0 && år % 100 != 0
| ll12b_dage_i_måned(år: Heltal, måned: Heltal) -> match måned {
    | 1 -> 31
    | 2 -> hvis ll12b_skudår(år) { 29 } ellers { 28 }
    | 3 -> 31
    | 4 -> 30
    | 5 -> 31
    | 6 -> 30
    | 7 -> 31
    | 8 -> 31
    | 9 -> 30
    | 10 -> 31
    | 11 -> 30
    | 12 -> 31
    | _ -> 0
}
| ll12b_dato_gyldig(dato: Ligningslov12BDato) -> dato.år > 0 && dato.måned >= 1 && dato.måned <= 12 && dato.dag >= 1 && dato.dag <= ll12b_dage_i_måned(dato.år, dato.måned)
| ll12b_dato_yyyymmdd(dato: Ligningslov12BDato) -> dato.år * 10000 + dato.måned * 100 + dato.dag
| ll12b_regime(dato: Ligningslov12BDato) -> hvis ll12b_dato_gyldig(dato) == Falskt || ll12b_dato_yyyymmdd(dato) < 19990701 { Ll12BUdenForAnvendelsesperioden } ellers { hvis ll12b_dato_yyyymmdd(dato) < 20250319 { Ll12B1Juli1999Til18Marts2025 } ellers { hvis ll12b_dato_yyyymmdd(dato) < 20260101 { Ll12B19Marts2025Til31December2025 } ellers { Ll12BFra1Januar2026 } } }
| ll12b_reviderede_saldoregler(regime: Ligningslov12BRegime) -> regime == Ll12B19Marts2025Til31December2025 || regime == Ll12BFra1Januar2026

| ll12b_rolle_modtager(rolle: Ligningslov12BRolle) -> rolle == Ll12BModtager
| ll12b_rolle_yder(rolle: Ligningslov12BRolle) -> rolle == Ll12BYder
| ll12b_rolle_overtager(rolle: Ligningslov12BRolle) -> rolle == Ll12BForpligtelsesOvertager
| ll12b_rolle_tredjemand(rolle: Ligningslov12BRolle) -> rolle == Ll12BTredjemandErhverver

| ll12b_betalte_ydelser_kroner(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed {
    | Ll12BÅrligBetaling(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Ll12BYdelseOphører(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Ll12BTredjemandModtagerYdelse(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | _ -> 0
}
| ll12b_kontantomregnet_vederlag_kroner(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed {
    | Ll12BModtagerAfstårRet(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Ll12BModtagerAfstårRetTilYder(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Ll12BYderOverdragerForpligtelse(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | _ -> 0
}
| ll12b_årlig_betaling(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed { | Ll12BÅrligBetaling(_) -> Sandt | _ -> Falskt }
| ll12b_ydelse_ophører(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed { | Ll12BYdelseOphører(_) -> Sandt | _ -> Falskt }
| ll12b_modtager_afstår_ret(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed { | Ll12BModtagerAfstårRet(_) -> Sandt | _ -> Falskt }
| ll12b_modtager_afstår_ret_til_yder(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed { | Ll12BModtagerAfstårRetTilYder(_) -> Sandt | _ -> Falskt }
| ll12b_yder_overdrager_forpligtelse(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed { | Ll12BYderOverdragerForpligtelse(_) -> Sandt | _ -> Falskt }
| ll12b_tredjemand_modtager_ydelse(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed { | Ll12BTredjemandModtagerYdelse(_) -> Sandt | _ -> Falskt }
| ll12b_henstandsgrundlag_kroner(grundlag: Ligningslov12BHenstandsgrundlag) -> match grundlag {
    | Ll12BIntetUbetaltHenstandsgrundlag -> 0
    | Ll12BUbetaltAfskrivningslov40Stk7(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Ll12BUbetaltLigningslov12BStk10(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
}
| ll12b_henstandsgrundlag_tilladt(regime: Ligningslov12BRegime, grundlag: Ligningslov12BHenstandsgrundlag) -> match grundlag {
    | Ll12BIntetUbetaltHenstandsgrundlag -> Sandt
    | Ll12BUbetaltAfskrivningslov40Stk7(_) -> regime == Ll12B1Juli1999Til18Marts2025 || regime == Ll12B19Marts2025Til31December2025
    | Ll12BUbetaltLigningslov12BStk10(_) -> regime == Ll12BFra1Januar2026
}
| ll12b_henstandsgrundlag_beløb_gyldigt(grundlag: Ligningslov12BHenstandsgrundlag) -> match grundlag {
    | Ll12BIntetUbetaltHenstandsgrundlag -> Sandt
    | Ll12BUbetaltAfskrivningslov40Stk7(beløb_kroner) -> beløb_kroner >= 0
    | Ll12BUbetaltLigningslov12BStk10(beløb_kroner) -> beløb_kroner >= 0
}
| ll12b_begivenhedsbeløb_gyldigt(begivenhed: Ligningslov12BBegivenhed) -> match begivenhed {
    | Ll12BÅrligBetaling(beløb_kroner) -> beløb_kroner >= 0
    | Ll12BYdelseOphører(beløb_kroner) -> beløb_kroner >= 0
    | Ll12BModtagerAfstårRet(beløb_kroner) -> beløb_kroner >= 0
    | Ll12BModtagerAfstårRetTilYder(beløb_kroner) -> beløb_kroner >= 0
    | Ll12BYderOverdragerForpligtelse(beløb_kroner) -> beløb_kroner >= 0
    | Ll12BTredjemandModtagerYdelse(beløb_kroner) -> beløb_kroner >= 0
}

| ll12b_aftale_løbende_ydelse_definition_opfyldt(aftale: Ligningslov12BAftale) -> (aftale.usikker_varighed || aftale.usikker_årlig_størrelse) && aftale.løber_ud_over_aftaleåret
| ll12b_aftale_omfattet_af_stk1(aftale: Ligningslov12BAftale) -> ll12b_dato_gyldig(aftale.aftaledato) && ll12b_regime(aftale.aftaledato) != Ll12BUdenForAnvendelsesperioden && aftale.gensidigt_bebyrdende && aftale.antal_overdragne_aktiver > 0 && aftale.løbende_ydelse_helt_eller_delvist_vederlag && ll12b_aftale_løbende_ydelse_definition_opfyldt(aftale) && aftale.anden_lov_regulerer_beskatningen == Falskt
| ll12b_aftale_mindst_en_part_omfattet(aftale: Ligningslov12BAftale) -> aftale.parter.mindst_en_part_skattepligtig_ved_aftalen || aftale.parter.anden_part_senere_fuldt_skattepligtig
| ll12b_aftale_stk2_anvendelig(aftale: Ligningslov12BAftale) -> ll12b_aftale_omfattet_af_stk1(aftale) && ll12b_aftale_mindst_en_part_omfattet(aftale)
| ll12b_aftale_beregningsregler_anvendelige(aftale: Ligningslov12BAftale) -> ll12b_aftale_stk2_anvendelig(aftale) && aftale.parter.yder_betaler_til_selvejende_institution_med_stifterindflydelse == Falskt
| ll12b_aftale_kapitalisering_påkrævet(aftale: Ligningslov12BAftale) -> ll12b_aftale_stk2_anvendelig(aftale) && (ll12b_reviderede_saldoregler(ll12b_regime(aftale.aftaledato)) == Falskt || aftale.kun_aktier_omfattet_af_abl8_for_begge_parter == Falskt)
| ll12b_aftale_saldo_påkrævet(aftale: Ligningslov12BAftale) -> ll12b_aftale_beregningsregler_anvendelige(aftale) && ll12b_aftale_kapitalisering_påkrævet(aftale)

# Ligningslov12BSag(input: Ligningslov12BInput) {
    | aftaledato_gyldig() -> ll12b_dato_gyldig(input.aftale.aftaledato)
    | regime() -> ll12b_regime(input.aftale.aftaledato)
    | grunddata_gyldige() -> aftaledato_gyldig() && input.indkomstår > 0 && input.aftale.antal_overdragne_aktiver >= 0 && input.aftale.kapitaliseret_værdi_kroner >= 0 && input.aftale.parter.ydelser_betalt_før_skattepligtsindtræden_kroner >= 0 && ll12b_begivenhedsbeløb_gyldigt(input.begivenhed) && ll12b_henstandsgrundlag_beløb_gyldigt(input.position.henstandsgrundlag) && input.årsfordeling.modtager_ikke_skattepligtig_aktivandel_kroner >= 0 && input.årsfordeling.yder_fradrag_helt_afskåret_kroner >= 0 && input.årsfordeling.yder_anskaffelsessum_forhøjes_i_stedet_kroner >= 0 && input.årsfordeling.overtager_nærtstående_fradrag_afskåret_kroner >= 0 && input.ophørsfordeling.modtager_ikke_skattepligtig_aktivandel_kroner >= 0 && input.ophørsfordeling.yder_ophør_ikke_medregnes_kroner >= 0 && input.ophørsfordeling.yder_ophør_nedsætter_anskaffelsessum_kroner >= 0
    | aftale_omfattet_af_stk1() -> grunddata_gyldige() && ll12b_aftale_omfattet_af_stk1(input.aftale)
    | beregningsregler_anvendelige() -> grunddata_gyldige() && ll12b_aftale_beregningsregler_anvendelige(input.aftale)
    | kapitalisering_påkrævet() -> grunddata_gyldige() && ll12b_aftale_kapitalisering_påkrævet(input.aftale)
    | saldo_påkrævet() -> grunddata_gyldige() && ll12b_aftale_saldo_påkrævet(input.aftale)
    | saldo_indgangsværdi_ved_skattepligtsindtræden_kroner() -> hvis saldo_påkrævet() { input.aftale.kapitaliseret_værdi_kroner - hvis input.aftale.parter.mindst_en_part_skattepligtig_ved_aftalen { 0 } ellers { input.aftale.parter.ydelser_betalt_før_skattepligtsindtræden_kroner } } ellers { 0 }
    | input_gyldigt() -> grunddata_gyldige() && hvis kapitalisering_påkrævet() { input.aftale.kapitaliseret_værdi_kroner > 0 } ellers { Sandt }
    | omfattet_af_par12b() -> aftale_omfattet_af_stk1() && input_gyldigt()
    | henstandsgrundlag_gyldigt() -> ll12b_henstandsgrundlag_tilladt(regime(), input.position.henstandsgrundlag)
    | oplysningspligter_overholdt() -> hvis ll12b_aftale_stk2_anvendelig(input.aftale) { input.aftale.oplysninger.aktiver_og_fordeling_fremgår_af_aftalen && input.aftale.oplysninger.aftale_meddelt_rettidigt && (kapitalisering_påkrævet() == Falskt || input.aftale.oplysninger.kapitalisering_foretaget_rettidigt) && (saldo_påkrævet() == Falskt || input.aftale.oplysninger.saldo_oplyst_rettidigt) } ellers { Sandt }
    | omfattet_af_stk4() -> beregningsregler_anvendelige() && input_gyldigt() && ll12b_rolle_modtager(input.rolle) && (ll12b_årlig_betaling(input.begivenhed) || ll12b_ydelse_ophører(input.begivenhed) || ll12b_modtager_afstår_ret(input.begivenhed))
    | omfattet_af_stk5() -> beregningsregler_anvendelige() && input_gyldigt() && ll12b_rolle_yder(input.rolle) && (ll12b_årlig_betaling(input.begivenhed) || ll12b_ydelse_ophører(input.begivenhed))
    | omfattet_af_stk7() -> beregningsregler_anvendelige() && input_gyldigt() && ll12b_rolle_yder(input.rolle) && ll12b_modtager_afstår_ret_til_yder(input.begivenhed)
    | omfattet_af_stk9_yder() -> beregningsregler_anvendelige() && input_gyldigt() && ll12b_rolle_yder(input.rolle) && ll12b_yder_overdrager_forpligtelse(input.begivenhed)
    | omfattet_af_stk9_overtager() -> beregningsregler_anvendelige() && input_gyldigt() && ll12b_rolle_overtager(input.rolle) && (ll12b_årlig_betaling(input.begivenhed) || ll12b_ydelse_ophører(input.begivenhed) || ll12b_yder_overdrager_forpligtelse(input.begivenhed))
    | omfattet_af_stk4_til_7_eller_9() -> omfattet_af_stk4() || omfattet_af_stk5() || omfattet_af_stk7() || omfattet_af_stk9_yder() || omfattet_af_stk9_overtager()
    | omfattet_af_stk8() -> beregningsregler_anvendelige() && input_gyldigt() && ll12b_rolle_tredjemand(input.rolle) && ll12b_tredjemand_modtager_ydelse(input.begivenhed)
    | betalte_ydelser_kroner() -> ll12b_betalte_ydelser_kroner(input.begivenhed)
    | kontantomregnet_vederlag_kroner() -> ll12b_kontantomregnet_vederlag_kroner(input.begivenhed)
    | begivenhedsbeløb_kroner() -> betalte_ydelser_kroner() + kontantomregnet_vederlag_kroner()
    | begivenhed_reducerer_saldo() -> omfattet_af_stk4() || omfattet_af_stk5() || omfattet_af_stk7() || omfattet_af_stk9_yder() || omfattet_af_stk9_overtager() && ll12b_yder_overdrager_forpligtelse(input.begivenhed) == Falskt
    | saldo_reduktion_kroner() -> hvis saldo_påkrævet() && begivenhed_reducerer_saldo() { begivenhedsbeløb_kroner() } ellers { 0 }
    | saldo_efter_reduktion_kroner() -> hvis saldo_påkrævet() { input.position.saldo_primo_kroner - saldo_reduktion_kroner() } ellers { 0 }
    | saldo_bliver_negativ_i_året() -> saldo_påkrævet() && input.position.saldo_primo_kroner > 0 && saldo_efter_reduktion_kroner() < 0
    | negativ_saldo_beløb_kroner() -> hvis saldo_bliver_negativ_i_året() { 0 - saldo_efter_reduktion_kroner() } ellers { 0 }
    | efterfølgende_betalte_ydelser_kroner() -> hvis saldo_påkrævet() && input.position.saldo_primo_kroner <= 0 && begivenhed_reducerer_saldo() && ll12b_ydelse_ophører(input.begivenhed) == Falskt { begivenhedsbeløb_kroner() } ellers { 0 }
    | ophørs_saldo_kroner() -> hvis saldo_påkrævet() && ll12b_ydelse_ophører(input.begivenhed) && saldo_efter_reduktion_kroner() > 0 { saldo_efter_reduktion_kroner() } ellers { 0 }
    | modtager_skattepligtig_brutto_kroner() -> hvis omfattet_af_stk4() && ll12b_ydelse_ophører(input.begivenhed) == Falskt { hvis saldo_påkrævet() { negativ_saldo_beløb_kroner() + efterfølgende_betalte_ydelser_kroner() } ellers { begivenhedsbeløb_kroner() } } ellers { 0 }
    | modtager_årsafskæring_kroner() -> hvis ll12b_reviderede_saldoregler(regime()) { hvis input.aftale.kun_aktier_omfattet_af_abl8_for_begge_parter { modtager_skattepligtig_brutto_kroner() } ellers { penge_positivt_beløb(input.årsfordeling.modtager_ikke_skattepligtig_aktivandel_kroner) } } ellers { 0 }
    | modtager_skattepligtigt_kroner() -> penge_positivt_beløb(modtager_skattepligtig_brutto_kroner() - modtager_årsafskæring_kroner())
    | modtager_fradrag_brutto_kroner() -> hvis omfattet_af_stk4() { ophørs_saldo_kroner() } ellers { 0 }
    | gyldigt_henstandsgrundlag_kroner() -> hvis henstandsgrundlag_gyldigt() { ll12b_henstandsgrundlag_kroner(input.position.henstandsgrundlag) } ellers { 0 }
    | modtager_fradrag_kroner() -> penge_positivt_beløb(modtager_fradrag_brutto_kroner() - penge_positivt_beløb(input.ophørsfordeling.modtager_ikke_skattepligtig_aktivandel_kroner) - gyldigt_henstandsgrundlag_kroner())
    | yder_fradrag_brutto_kroner() -> hvis (omfattet_af_stk5() || omfattet_af_stk7() || omfattet_af_stk9_yder() || omfattet_af_stk9_overtager()) && ll12b_ydelse_ophører(input.begivenhed) == Falskt { hvis saldo_påkrævet() { negativ_saldo_beløb_kroner() + efterfølgende_betalte_ydelser_kroner() } ellers { begivenhedsbeløb_kroner() } } ellers { 0 }
    | yder_årsafskæring_kroner() -> hvis ll12b_reviderede_saldoregler(regime()) { hvis input.aftale.kun_aktier_omfattet_af_abl8_for_begge_parter { yder_fradrag_brutto_kroner() } ellers { penge_positivt_beløb(input.årsfordeling.yder_fradrag_helt_afskåret_kroner) + penge_positivt_beløb(input.årsfordeling.yder_anskaffelsessum_forhøjes_i_stedet_kroner) + penge_positivt_beløb(input.årsfordeling.overtager_nærtstående_fradrag_afskåret_kroner) } } ellers { 0 }
    | yder_fradrag_kroner() -> penge_positivt_beløb(yder_fradrag_brutto_kroner() - yder_årsafskæring_kroner())
    | yder_skattepligtig_brutto_kroner() -> hvis (omfattet_af_stk5() || omfattet_af_stk7() || omfattet_af_stk9_yder()) && ll12b_ydelse_ophører(input.begivenhed) { ophørs_saldo_kroner() } ellers { 0 }
    | yder_skattepligtigt_kroner() -> penge_positivt_beløb(yder_skattepligtig_brutto_kroner() - penge_positivt_beløb(input.ophørsfordeling.yder_ophør_ikke_medregnes_kroner) - penge_positivt_beløb(input.ophørsfordeling.yder_ophør_nedsætter_anskaffelsessum_kroner))
    | tredjemand_skattepligtigt_kroner() -> hvis omfattet_af_stk8() { betalte_ydelser_kroner() } ellers { 0 }
    | anskaffelsessum_forhøjes_kroner() -> hvis ll12b_reviderede_saldoregler(regime()) { penge_mindste_beløb(yder_fradrag_brutto_kroner(), penge_positivt_beløb(input.årsfordeling.yder_anskaffelsessum_forhøjes_i_stedet_kroner)) } ellers { 0 }
    | anskaffelsessum_nedsættes_kroner() -> penge_mindste_beløb(yder_skattepligtig_brutto_kroner(), penge_positivt_beløb(input.ophørsfordeling.yder_ophør_nedsætter_anskaffelsessum_kroner))
    | overtager_indgangsværdi_kroner() -> hvis omfattet_af_stk9_overtager() && ll12b_yder_overdrager_forpligtelse(input.begivenhed) { kontantomregnet_vederlag_kroner() } ellers { 0 }
    | netto_skattepligtigt_eller_fradragsberettiget_kroner() -> modtager_skattepligtigt_kroner() + yder_skattepligtigt_kroner() + tredjemand_skattepligtigt_kroner() - modtager_fradrag_kroner() - yder_fradrag_kroner()
    | resultat() -> Ligningslov12BResultat(
        indkomstår = input.indkomstår,
        rolle = input.rolle,
        begivenhed = input.begivenhed,
        regime = regime(),
        aftaledato_gyldig = aftaledato_gyldig(),
        input_gyldigt = input_gyldigt(),
        omfattet_af_par12b = omfattet_af_par12b(),
        kapitalisering_påkrævet = kapitalisering_påkrævet(),
        saldo_påkrævet = saldo_påkrævet(),
        saldo_indgangsværdi_ved_skattepligtsindtræden_kroner = saldo_indgangsværdi_ved_skattepligtsindtræden_kroner(),
        oplysningspligter_overholdt = oplysningspligter_overholdt(),
        henstandsgrundlag_gyldigt = henstandsgrundlag_gyldigt(),
        omfattet_af_stk4_til_7_eller_9 = omfattet_af_stk4_til_7_eller_9(),
        saldo_reduktion_kroner = saldo_reduktion_kroner(),
        saldo_efter_reduktion_kroner = saldo_efter_reduktion_kroner(),
        negativ_saldo_beløb_kroner = negativ_saldo_beløb_kroner(),
        efterfølgende_betalte_ydelser_kroner = efterfølgende_betalte_ydelser_kroner(),
        ophørs_saldo_kroner = ophørs_saldo_kroner(),
        modtager_skattepligtigt_kroner = modtager_skattepligtigt_kroner(),
        modtager_fradrag_kroner = modtager_fradrag_kroner(),
        yder_fradrag_kroner = yder_fradrag_kroner(),
        yder_skattepligtigt_kroner = yder_skattepligtigt_kroner(),
        tredjemand_skattepligtigt_kroner = tredjemand_skattepligtigt_kroner(),
        anskaffelsessum_forhøjes_kroner = anskaffelsessum_forhøjes_kroner(),
        anskaffelsessum_nedsættes_kroner = anskaffelsessum_nedsættes_kroner(),
        overtager_indgangsværdi_kroner = overtager_indgangsværdi_kroner(),
        netto_skattepligtigt_eller_fradragsberettiget_kroner = netto_skattepligtigt_eller_fradragsberettiget_kroner()
    )
}
| ligningslov12b_sag(input: Ligningslov12BInput) -> Ligningslov12BSag(input)
| ligningslov12b_resultat(input: Ligningslov12BInput) -> ligningslov12b_sag(input).resultat()

# Ligningslov12BArbejdsmarkedsbidragHjemmel = Ll12BIntetArbejdsmarkedsbidrag | Ll12BArbejdsmarkedsbidragslovPar4 | Ll12BArbejdsmarkedsbidragslovPar5
# Ligningslov12BHenstandsfinansiering(kapitaliseret_værdi_henført_til_aktiv_kroner: Heltal, afståelsessum_for_aktiv_kroner: Heltal)
# Ligningslov12BHenstandSkatteberegning(skat_med_fortjeneste_kroner: Heltal, skat_uden_fortjeneste_kroner: Heltal, arbejdsmarkedsbidrag_hjemmel: Ligningslov12BArbejdsmarkedsbidragHjemmel, arbejdsmarkedsbidrag_med_fortjeneste_kroner: Heltal, arbejdsmarkedsbidrag_uden_fortjeneste_kroner: Heltal, kommunal_andel_af_skatten_kroner: Heltal)
# Ligningslov12BHenstandBegæring(aftale: Ligningslov12BAftale, finansiering: Ligningslov12BHenstandsfinansiering, begæring_indsendt_rettidigt: Boolsk, skatteberegning: Ligningslov12BHenstandSkatteberegning)
# Ligningslov12BHenstandBevillingResultat(aftaledato: Ligningslov12BDato, regime: Ligningslov12BRegime, beregning_gyldig: Boolsk, finansiering_gyldig: Boolsk, betingelser_opfyldt: Boolsk, arbejdsmarkedsbidrag_hjemmel: Ligningslov12BArbejdsmarkedsbidragHjemmel, kapitaliseret_værdi_af_løbende_ydelse_kroner: Heltal, kapitaliseret_værdi_henført_til_aktiv_kroner: Heltal, afståelsessum_for_aktiv_kroner: Heltal, forhold_tæller_kroner: Heltal, forhold_nævner_kroner: Heltal, skat_beregnet_på_fortjenesten_kroner: Heltal, arbejdsmarkedsbidrag_beregnet_på_fortjenesten_kroner: Heltal, henstand_med_skat_kroner: Heltal, henstand_med_arbejdsmarkedsbidrag_kroner: Heltal, samlet_henstandsbeløb_kroner: Heltal, henstand_fradrages_i_slutskat_kroner: Heltal, kommunal_andel_afregnes_i_indkomståret_kroner: Heltal, lovbestemt_syvårsgrænse: Boolsk)

# Ligningslov12BHenstandBevillingSag(input: Ligningslov12BHenstandBegæring) {
    | regime() -> ll12b_regime(input.aftale.aftaledato)
    | skatteberegning_gyldig() -> input.skatteberegning.skat_med_fortjeneste_kroner >= 0 && input.skatteberegning.skat_uden_fortjeneste_kroner >= 0 && input.skatteberegning.skat_med_fortjeneste_kroner >= input.skatteberegning.skat_uden_fortjeneste_kroner && input.skatteberegning.kommunal_andel_af_skatten_kroner >= 0 && input.skatteberegning.kommunal_andel_af_skatten_kroner <= input.skatteberegning.skat_med_fortjeneste_kroner
    | arbejdsmarkedsbidragsberegning_gyldig() -> input.skatteberegning.arbejdsmarkedsbidrag_med_fortjeneste_kroner >= 0 && input.skatteberegning.arbejdsmarkedsbidrag_uden_fortjeneste_kroner >= 0 && match input.skatteberegning.arbejdsmarkedsbidrag_hjemmel {
        | Ll12BIntetArbejdsmarkedsbidrag -> input.skatteberegning.arbejdsmarkedsbidrag_med_fortjeneste_kroner == 0 && input.skatteberegning.arbejdsmarkedsbidrag_uden_fortjeneste_kroner == 0
        | Ll12BArbejdsmarkedsbidragslovPar4 -> input.skatteberegning.arbejdsmarkedsbidrag_med_fortjeneste_kroner >= input.skatteberegning.arbejdsmarkedsbidrag_uden_fortjeneste_kroner
        | Ll12BArbejdsmarkedsbidragslovPar5 -> input.skatteberegning.arbejdsmarkedsbidrag_med_fortjeneste_kroner >= input.skatteberegning.arbejdsmarkedsbidrag_uden_fortjeneste_kroner
    }
    | beregning_gyldig() -> skatteberegning_gyldig() && arbejdsmarkedsbidragsberegning_gyldig()
    | finansiering_gyldig() -> input.aftale.kapitaliseret_værdi_kroner > 0 && input.finansiering.kapitaliseret_værdi_henført_til_aktiv_kroner > 0 && input.finansiering.kapitaliseret_værdi_henført_til_aktiv_kroner <= input.aftale.kapitaliseret_værdi_kroner && input.finansiering.afståelsessum_for_aktiv_kroner > 0 && input.finansiering.kapitaliseret_værdi_henført_til_aktiv_kroner <= input.finansiering.afståelsessum_for_aktiv_kroner
    | betingelser_opfyldt() -> regime() == Ll12BFra1Januar2026 && ll12b_aftale_beregningsregler_anvendelige(input.aftale) && ll12b_aftale_kapitalisering_påkrævet(input.aftale) && input.begæring_indsendt_rettidigt && beregning_gyldig() && finansiering_gyldig()
    | forhold_tæller_kroner() -> hvis betingelser_opfyldt() { input.finansiering.kapitaliseret_værdi_henført_til_aktiv_kroner } ellers { 0 }
    | forhold_nævner_kroner() -> hvis betingelser_opfyldt() { input.finansiering.afståelsessum_for_aktiv_kroner } ellers { 0 }
    | skat_beregnet_på_fortjenesten_kroner() -> hvis skatteberegning_gyldig() { input.skatteberegning.skat_med_fortjeneste_kroner - input.skatteberegning.skat_uden_fortjeneste_kroner } ellers { 0 }
    | arbejdsmarkedsbidrag_beregnet_på_fortjenesten_kroner() -> hvis arbejdsmarkedsbidragsberegning_gyldig() { input.skatteberegning.arbejdsmarkedsbidrag_med_fortjeneste_kroner - input.skatteberegning.arbejdsmarkedsbidrag_uden_fortjeneste_kroner } ellers { 0 }
    | henstand_med_skat_kroner() -> hvis betingelser_opfyldt() { skat_beregnet_på_fortjenesten_kroner() * forhold_tæller_kroner() / forhold_nævner_kroner() } ellers { 0 }
    | henstand_med_arbejdsmarkedsbidrag_kroner() -> hvis betingelser_opfyldt() { arbejdsmarkedsbidrag_beregnet_på_fortjenesten_kroner() * forhold_tæller_kroner() / forhold_nævner_kroner() } ellers { 0 }
    | samlet_henstandsbeløb_kroner() -> henstand_med_skat_kroner() + henstand_med_arbejdsmarkedsbidrag_kroner()
    | kommunal_andel_afregnes_i_indkomståret_kroner() -> hvis betingelser_opfyldt() { input.skatteberegning.kommunal_andel_af_skatten_kroner } ellers { 0 }
    | resultat() -> Ligningslov12BHenstandBevillingResultat(
        aftaledato = input.aftale.aftaledato,
        regime = regime(),
        beregning_gyldig = beregning_gyldig(),
        finansiering_gyldig = finansiering_gyldig(),
        betingelser_opfyldt = betingelser_opfyldt(),
        arbejdsmarkedsbidrag_hjemmel = input.skatteberegning.arbejdsmarkedsbidrag_hjemmel,
        kapitaliseret_værdi_af_løbende_ydelse_kroner = input.aftale.kapitaliseret_værdi_kroner,
        kapitaliseret_værdi_henført_til_aktiv_kroner = input.finansiering.kapitaliseret_værdi_henført_til_aktiv_kroner,
        afståelsessum_for_aktiv_kroner = input.finansiering.afståelsessum_for_aktiv_kroner,
        forhold_tæller_kroner = forhold_tæller_kroner(),
        forhold_nævner_kroner = forhold_nævner_kroner(),
        skat_beregnet_på_fortjenesten_kroner = skat_beregnet_på_fortjenesten_kroner(),
        arbejdsmarkedsbidrag_beregnet_på_fortjenesten_kroner = arbejdsmarkedsbidrag_beregnet_på_fortjenesten_kroner(),
        henstand_med_skat_kroner = henstand_med_skat_kroner(),
        henstand_med_arbejdsmarkedsbidrag_kroner = henstand_med_arbejdsmarkedsbidrag_kroner(),
        samlet_henstandsbeløb_kroner = samlet_henstandsbeløb_kroner(),
        henstand_fradrages_i_slutskat_kroner = henstand_med_skat_kroner(),
        kommunal_andel_afregnes_i_indkomståret_kroner = kommunal_andel_afregnes_i_indkomståret_kroner(),
        lovbestemt_syvårsgrænse = Falskt
    )
}
| ligningslov12b_henstand_bevilling_sag(input: Ligningslov12BHenstandBegæring) -> Ligningslov12BHenstandBevillingSag(input)
| ligningslov12b_henstand_bevilling(input: Ligningslov12BHenstandBegæring) -> ligningslov12b_henstand_bevilling_sag(input).resultat()

# Ligningslov12BHenstandStatus = Ll12BHenstandAktiv | Ll12BHenstandAfviklet | Ll12BHenstandMisligholdt | Ll12BHenstandFrafaldet
# Ligningslov12BHenstandsafdragArt = Ll12BForholdsmæssigtRealiseringsafdrag | Ll12BRestForfaldetEfterMisligholdelse | Ll12BRestFrafaldetVedOphør
# Ligningslov12BHenstandsafdragStatus = Ll12BAfdragAfventerForfald | Ll12BAfdragForfaldent | Ll12BAfdragBetalt | Ll12BAfdragFrafaldet
# Ligningslov12BHenstandsafdrag(identifikation: Tekst, art: Ligningslov12BHenstandsafdragArt, realisationsgrundlag_kroner: Heltal, realisationsdato: Ligningslov12BDato, forfaldsdato: Ligningslov12BDato, sidste_rettidige_betalingsdato: Ligningslov12BDato, oprindeligt_skatteafdrag_kroner: Heltal, oprindeligt_arbejdsmarkedsbidragsafdrag_kroner: Heltal, ubetalt_skatteafdrag_kroner: Heltal, ubetalt_arbejdsmarkedsbidragsafdrag_kroner: Heltal, status: Ligningslov12BHenstandsafdragStatus, sidst_beregnede_rentemånedsindeks: Heltal, beregnet_rente_før_minimum_kroner: Heltal, pålignet_ikke_fradragsberettiget_rente_kroner: Heltal, antal_erindringsskrivelser: Heltal)
# Ligningslov12BHenstandPosition(bevilling: Ligningslov12BHenstandBevillingResultat, status: Ligningslov12BHenstandStatus, opgjort_pr: Ligningslov12BDato, aktiv_henstand_skat_kroner: Heltal, aktiv_henstand_arbejdsmarkedsbidrag_kroner: Heltal, afdrag: List(Ligningslov12BHenstandsafdrag), konto_for_opsparet_overskud_kroner: Heltal)
# Ligningslov12BHenstandHændelse = Ll12BHenstandYdelseModtaget(afdragsidentifikation: Tekst, realisationsdato: Ligningslov12BDato, beløb_kroner: Heltal) | Ll12BHenstandRetAfstået(afdragsidentifikation: Tekst, realisationsdato: Ligningslov12BDato, kontantomregnet_vederlag_kroner: Heltal) | Ll12BHenstandAfdragBetalt(afdragsidentifikation: Tekst, betalingsdato: Ligningslov12BDato, betalt_skatteafdrag_kroner: Heltal, betalt_arbejdsmarkedsbidragsafdrag_kroner: Heltal) | Ll12BHenstandErindringsskrivelse(afdragsidentifikation: Tekst, erindringsdato: Ligningslov12BDato) | Ll12BHenstandGrovGentagenMisligholdelse(afdragsidentifikation: Tekst, påkravsdato: Ligningslov12BDato) | Ll12BHenstandYdelserEndeligtOphørt(frafaldsidentifikation: Tekst, ophørsdato: Ligningslov12BDato, saldo_efter_ophør_kroner: Heltal, anvender_virksomhedsordningen: Boolsk, opsparet_overskud_henført_til_ubetalt_henstand_kroner: Heltal) | Ll12BHenstandOpgørelse(opgørelsesdato: Ligningslov12BDato)
# Ligningslov12BHenstandBetalingsfrist = Ll12BIngenNyBetalingsfrist | Ll12BNyBetalingsfrist(forfaldsdato: Ligningslov12BDato, sidste_rettidige_betalingsdato: Ligningslov12BDato)
# Ligningslov12BHenstandHændelsesinput(position: Ligningslov12BHenstandPosition, hændelse: Ligningslov12BHenstandHændelse)
# Ligningslov12BHenstandHændelsesresultat(hændelse: Ligningslov12BHenstandHændelse, hændelsesdato: Ligningslov12BDato, input_gyldigt: Boolsk, rente_kilder_påkrævet: Boolsk, rente_kilder_tilgængelige: Boolsk, nyt_skatteafdrag_kroner: Heltal, nyt_arbejdsmarkedsbidragsafdrag_kroner: Heltal, ny_betalingsfrist: Ligningslov12BHenstandBetalingsfrist, betalt_skatteafdrag_kroner: Heltal, betalt_arbejdsmarkedsbidragsafdrag_kroner: Heltal, forfaldent_skatteafdrag_efter_kroner: Heltal, forfaldent_arbejdsmarkedsbidragsafdrag_efter_kroner: Heltal, afventer_forfald_skatteafdrag_efter_kroner: Heltal, afventer_forfald_arbejdsmarkedsbidragsafdrag_efter_kroner: Heltal, ny_ikke_fradragsberettiget_rente_kroner: Heltal, rykkergebyr_kroner: Heltal, resterende_henstandsbeløb_forfalder_efter_påkrav_kroner: Heltal, frafaldet_henstandsbeløb_kroner: Heltal, konto_for_opsparet_overskud_reduktion_kroner: Heltal, position_efter: Ligningslov12BHenstandPosition)

| ll12b_dato_før_eller_lig_med(venstre: Ligningslov12BDato, højre: Ligningslov12BDato) -> ll12b_dato_yyyymmdd(venstre) <= ll12b_dato_yyyymmdd(højre)
| ll12b_dato_efter(venstre: Ligningslov12BDato, højre: Ligningslov12BDato) -> ll12b_dato_yyyymmdd(venstre) > ll12b_dato_yyyymmdd(højre)
| ll12b_henstand_månedsindeks(dato: Ligningslov12BDato) -> dato.år * 12 + dato.måned - 1
| ll12b_henstand_år_fra_månedsindeks(månedsindeks: Heltal) -> månedsindeks / 12
| ll12b_henstand_forfaldsdato(realisationsdato: Ligningslov12BDato) -> Ligningslov12BDato(
    år = opkrævning_år_for_måned_efter(realisationsdato.år, realisationsdato.måned),
    måned = opkrævning_måned_efter(realisationsdato.måned),
    dag = 1
)
| ll12b_henstand_sidste_rettidige_betalingsdato(realisationsdato: Ligningslov12BDato) -> Ligningslov12BDato(
    år = opkrævning_år_for_måned_efter(realisationsdato.år, realisationsdato.måned),
    måned = opkrævning_måned_efter(realisationsdato.måned),
    dag = 10
)

| ll12b_henstand_hændelsesdato(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse {
    | Ll12BHenstandYdelseModtaget(_, dato, _) -> dato
    | Ll12BHenstandRetAfstået(_, dato, _) -> dato
    | Ll12BHenstandAfdragBetalt(_, dato, _, _) -> dato
    | Ll12BHenstandErindringsskrivelse(_, dato) -> dato
    | Ll12BHenstandGrovGentagenMisligholdelse(_, dato) -> dato
    | Ll12BHenstandYdelserEndeligtOphørt(_, dato, _, _, _) -> dato
    | Ll12BHenstandOpgørelse(dato) -> dato
}
| ll12b_henstand_hændelsesidentifikation(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse {
    | Ll12BHenstandYdelseModtaget(identifikation, _, _) -> identifikation
    | Ll12BHenstandRetAfstået(identifikation, _, _) -> identifikation
    | Ll12BHenstandAfdragBetalt(identifikation, _, _, _) -> identifikation
    | Ll12BHenstandErindringsskrivelse(identifikation, _) -> identifikation
    | Ll12BHenstandGrovGentagenMisligholdelse(identifikation, _) -> identifikation
    | Ll12BHenstandYdelserEndeligtOphørt(identifikation, _, _, _, _) -> identifikation
    | Ll12BHenstandOpgørelse(_) -> ""
}
| ll12b_henstand_realiseret_beløb_kroner(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse {
    | Ll12BHenstandYdelseModtaget(_, _, beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Ll12BHenstandRetAfstået(_, _, beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | _ -> 0
}
| ll12b_henstand_betalt_skat_kroner(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandAfdragBetalt(_, _, beløb_kroner, _) -> penge_positivt_beløb(beløb_kroner) | _ -> 0 }
| ll12b_henstand_betalt_arbejdsmarkedsbidrag_kroner(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandAfdragBetalt(_, _, _, beløb_kroner) -> penge_positivt_beløb(beløb_kroner) | _ -> 0 }
| ll12b_henstand_realisering(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandYdelseModtaget(_, _, _) -> Sandt | Ll12BHenstandRetAfstået(_, _, _) -> Sandt | _ -> Falskt }
| ll12b_henstand_betaling(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandAfdragBetalt(_, _, _, _) -> Sandt | _ -> Falskt }
| ll12b_henstand_erindringsskrivelse(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandErindringsskrivelse(_, _) -> Sandt | _ -> Falskt }
| ll12b_henstand_misligholdelse(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandGrovGentagenMisligholdelse(_, _) -> Sandt | _ -> Falskt }
| ll12b_henstand_ophør(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandYdelserEndeligtOphørt(_, _, _, _, _) -> Sandt | _ -> Falskt }
| ll12b_henstand_opgørelse(hændelse: Ligningslov12BHenstandHændelse) -> match hændelse { | Ll12BHenstandOpgørelse(_) -> Sandt | _ -> Falskt }

| ll12b_henstandsafdrag_ubetalt_kroner(afdrag: Ligningslov12BHenstandsafdrag) -> penge_positivt_beløb(afdrag.ubetalt_skatteafdrag_kroner) + penge_positivt_beløb(afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner)
| ll12b_henstandsafdrag_rentemånedsindekser(afdrag: Ligningslov12BHenstandsafdrag, opgørelsesdato: Ligningslov12BDato) -> hvis afdrag.status != Ll12BAfdragFrafaldet && ll12b_henstandsafdrag_ubetalt_kroner(afdrag) > 0 && ll12b_dato_efter(opgørelsesdato, afdrag.sidste_rettidige_betalingsdato) { range(afdrag.sidst_beregnede_rentemånedsindeks + 1, ll12b_henstand_månedsindeks(opgørelsesdato) + 1) } ellers { [] }
| ll12b_henstand_renteår_kildebelagt(renteår: Heltal) -> opkrævning_par7_offentliggjort_sats(renteår).kilde_eli != ""
| ll12b_henstandsafdrag_rentekilder_tilgængelige(afdrag: Ligningslov12BHenstandsafdrag, opgørelsesdato: Ligningslov12BDato) -> all(ll12b_henstandsafdrag_rentemånedsindekser(afdrag, opgørelsesdato), |månedsindeks: Heltal| ll12b_henstand_renteår_kildebelagt(ll12b_henstand_år_fra_månedsindeks(månedsindeks)))
| ll12b_henstandsafdrag_nye_rentebasispoint(afdrag: Ligningslov12BHenstandsafdrag, opgørelsesdato: Ligningslov12BDato) -> foldl(ll12b_henstandsafdrag_rentemånedsindekser(afdrag, opgørelsesdato), 0, |sum: Heltal, månedsindeks: Heltal| sum + opkrævning_par7_offentliggjort_stk2_rente_basispoint(ll12b_henstand_år_fra_månedsindeks(månedsindeks)) + 40)
| ll12b_henstandsafdrag_ny_rente_før_minimum_kroner(afdrag: Ligningslov12BHenstandsafdrag, opgørelsesdato: Ligningslov12BDato) -> hvis ll12b_henstandsafdrag_rentekilder_tilgængelige(afdrag, opgørelsesdato) { ll12b_henstandsafdrag_ubetalt_kroner(afdrag) * ll12b_henstandsafdrag_nye_rentebasispoint(afdrag, opgørelsesdato) / 10000 } ellers { 0 }
| ll12b_henstandsafdrag_opgjort_status(afdrag: Ligningslov12BHenstandsafdrag, opgørelsesdato: Ligningslov12BDato) -> hvis afdrag.status == Ll12BAfdragFrafaldet { Ll12BAfdragFrafaldet } ellers { hvis ll12b_henstandsafdrag_ubetalt_kroner(afdrag) == 0 { Ll12BAfdragBetalt } ellers { hvis ll12b_dato_efter(opgørelsesdato, afdrag.sidste_rettidige_betalingsdato) { Ll12BAfdragForfaldent } ellers { Ll12BAfdragAfventerForfald } } }
| ll12b_henstandsafdrag_opgjort(afdrag: Ligningslov12BHenstandsafdrag, opgørelsesdato: Ligningslov12BDato) -> Ligningslov12BHenstandsafdrag(
    identifikation = afdrag.identifikation,
    art = afdrag.art,
    realisationsgrundlag_kroner = afdrag.realisationsgrundlag_kroner,
    realisationsdato = afdrag.realisationsdato,
    forfaldsdato = afdrag.forfaldsdato,
    sidste_rettidige_betalingsdato = afdrag.sidste_rettidige_betalingsdato,
    oprindeligt_skatteafdrag_kroner = afdrag.oprindeligt_skatteafdrag_kroner,
    oprindeligt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner,
    ubetalt_skatteafdrag_kroner = afdrag.ubetalt_skatteafdrag_kroner,
    ubetalt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner,
    status = ll12b_henstandsafdrag_opgjort_status(afdrag, opgørelsesdato),
    sidst_beregnede_rentemånedsindeks = hvis length(ll12b_henstandsafdrag_rentemånedsindekser(afdrag, opgørelsesdato)) > 0 && ll12b_henstandsafdrag_rentekilder_tilgængelige(afdrag, opgørelsesdato) { ll12b_henstand_månedsindeks(opgørelsesdato) } ellers { afdrag.sidst_beregnede_rentemånedsindeks },
    beregnet_rente_før_minimum_kroner = afdrag.beregnet_rente_før_minimum_kroner + ll12b_henstandsafdrag_ny_rente_før_minimum_kroner(afdrag, opgørelsesdato),
    pålignet_ikke_fradragsberettiget_rente_kroner = hvis length(ll12b_henstandsafdrag_rentemånedsindekser(afdrag, opgørelsesdato)) > 0 && ll12b_henstandsafdrag_rentekilder_tilgængelige(afdrag, opgørelsesdato) { penge_største_beløb(25, afdrag.beregnet_rente_før_minimum_kroner + ll12b_henstandsafdrag_ny_rente_før_minimum_kroner(afdrag, opgørelsesdato)) } ellers { afdrag.pålignet_ikke_fradragsberettiget_rente_kroner },
    antal_erindringsskrivelser = afdrag.antal_erindringsskrivelser
)

| ll12b_henstandsafdrag_identifikation_antal(afdrag: List(Ligningslov12BHenstandsafdrag), identifikation: Tekst) -> foldl(afdrag, 0, |antal: Heltal, post: Ligningslov12BHenstandsafdrag| antal + hvis post.identifikation == identifikation { 1 } ellers { 0 })
| ll12b_henstandsafdrag_identifikationer_entydige(afdrag: List(Ligningslov12BHenstandsafdrag)) -> all(afdrag, |post: Ligningslov12BHenstandsafdrag| post.identifikation != "" && ll12b_henstandsafdrag_identifikation_antal(afdrag, post.identifikation) == 1)
| ll12b_henstandsafdrag_oprindelig_skat_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + post.oprindeligt_skatteafdrag_kroner)
| ll12b_henstandsafdrag_oprindeligt_arbejdsmarkedsbidrag_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + post.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner)
| ll12b_henstandsafdrag_ubetalt_skat_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + post.ubetalt_skatteafdrag_kroner)
| ll12b_henstandsafdrag_ubetalt_arbejdsmarkedsbidrag_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + post.ubetalt_arbejdsmarkedsbidragsafdrag_kroner)
| ll12b_henstandsafdrag_forfaldent_skat_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.status == Ll12BAfdragForfaldent { post.ubetalt_skatteafdrag_kroner } ellers { 0 })
| ll12b_henstandsafdrag_forfaldent_arbejdsmarkedsbidrag_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.status == Ll12BAfdragForfaldent { post.ubetalt_arbejdsmarkedsbidragsafdrag_kroner } ellers { 0 })
| ll12b_henstandsafdrag_afventer_skat_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.status == Ll12BAfdragAfventerForfald { post.ubetalt_skatteafdrag_kroner } ellers { 0 })
| ll12b_henstandsafdrag_afventer_arbejdsmarkedsbidrag_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.status == Ll12BAfdragAfventerForfald { post.ubetalt_arbejdsmarkedsbidragsafdrag_kroner } ellers { 0 })
| ll12b_henstandsafdrag_pålignet_rente_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + post.pålignet_ikke_fradragsberettiget_rente_kroner)
| ll12b_henstandsafdrag_realiseret_grundlag_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.art == Ll12BForholdsmæssigtRealiseringsafdrag { post.realisationsgrundlag_kroner } ellers { 0 })
| ll12b_henstandsafdrag_forholdsmæssig_skat_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.art == Ll12BForholdsmæssigtRealiseringsafdrag { post.oprindeligt_skatteafdrag_kroner } ellers { 0 })
| ll12b_henstandsafdrag_forholdsmæssigt_arbejdsmarkedsbidrag_kroner(afdrag: List(Ligningslov12BHenstandsafdrag)) -> foldl(afdrag, 0, |sum: Heltal, post: Ligningslov12BHenstandsafdrag| sum + hvis post.art == Ll12BForholdsmæssigtRealiseringsafdrag { post.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner } ellers { 0 })

| ll12b_henstandsafdrag_gyldigt(afdrag: Ligningslov12BHenstandsafdrag, opgjort_pr: Ligningslov12BDato) -> afdrag.identifikation != "" && afdrag.realisationsgrundlag_kroner >= 0 && ll12b_dato_gyldig(afdrag.realisationsdato) && ll12b_dato_gyldig(afdrag.forfaldsdato) && ll12b_dato_gyldig(afdrag.sidste_rettidige_betalingsdato) && ll12b_dato_før_eller_lig_med(afdrag.realisationsdato, opgjort_pr) && afdrag.oprindeligt_skatteafdrag_kroner >= 0 && afdrag.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner >= 0 && afdrag.ubetalt_skatteafdrag_kroner >= 0 && afdrag.ubetalt_skatteafdrag_kroner <= afdrag.oprindeligt_skatteafdrag_kroner && afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner >= 0 && afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner <= afdrag.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner && afdrag.sidst_beregnede_rentemånedsindeks >= ll12b_henstand_månedsindeks(afdrag.forfaldsdato) - 1 && afdrag.sidst_beregnede_rentemånedsindeks <= ll12b_henstand_månedsindeks(opgjort_pr) && afdrag.beregnet_rente_før_minimum_kroner >= 0 && afdrag.pålignet_ikke_fradragsberettiget_rente_kroner >= afdrag.beregnet_rente_før_minimum_kroner && afdrag.antal_erindringsskrivelser >= 0 && hvis afdrag.art == Ll12BForholdsmæssigtRealiseringsafdrag { afdrag.realisationsgrundlag_kroner > 0 && afdrag.forfaldsdato == ll12b_henstand_forfaldsdato(afdrag.realisationsdato) && afdrag.sidste_rettidige_betalingsdato == ll12b_henstand_sidste_rettidige_betalingsdato(afdrag.realisationsdato) } ellers { afdrag.realisationsgrundlag_kroner == 0 } && match afdrag.status { | Ll12BAfdragAfventerForfald -> ll12b_henstandsafdrag_ubetalt_kroner(afdrag) > 0 && ll12b_dato_efter(opgjort_pr, afdrag.sidste_rettidige_betalingsdato) == Falskt | Ll12BAfdragForfaldent -> ll12b_henstandsafdrag_ubetalt_kroner(afdrag) > 0 | Ll12BAfdragBetalt -> ll12b_henstandsafdrag_ubetalt_kroner(afdrag) == 0 | Ll12BAfdragFrafaldet -> ll12b_henstandsafdrag_ubetalt_kroner(afdrag) == 0 }
| ll12b_henstand_position_gyldig(position: Ligningslov12BHenstandPosition) -> position.bevilling.betingelser_opfyldt && ll12b_dato_gyldig(position.opgjort_pr) && ll12b_dato_før_eller_lig_med(position.bevilling.aftaledato, position.opgjort_pr) && position.aktiv_henstand_skat_kroner >= 0 && position.aktiv_henstand_arbejdsmarkedsbidrag_kroner >= 0 && position.konto_for_opsparet_overskud_kroner >= 0 && ll12b_henstandsafdrag_identifikationer_entydige(position.afdrag) && all(position.afdrag, |afdrag: Ligningslov12BHenstandsafdrag| ll12b_henstandsafdrag_gyldigt(afdrag, position.opgjort_pr)) && position.aktiv_henstand_skat_kroner + ll12b_henstandsafdrag_oprindelig_skat_kroner(position.afdrag) == position.bevilling.henstand_med_skat_kroner && position.aktiv_henstand_arbejdsmarkedsbidrag_kroner + ll12b_henstandsafdrag_oprindeligt_arbejdsmarkedsbidrag_kroner(position.afdrag) == position.bevilling.henstand_med_arbejdsmarkedsbidrag_kroner && match position.status { | Ll12BHenstandAktiv -> position.aktiv_henstand_skat_kroner + position.aktiv_henstand_arbejdsmarkedsbidrag_kroner + ll12b_henstandsafdrag_ubetalt_skat_kroner(position.afdrag) + ll12b_henstandsafdrag_ubetalt_arbejdsmarkedsbidrag_kroner(position.afdrag) > 0 | Ll12BHenstandAfviklet -> position.aktiv_henstand_skat_kroner + position.aktiv_henstand_arbejdsmarkedsbidrag_kroner + ll12b_henstandsafdrag_ubetalt_skat_kroner(position.afdrag) + ll12b_henstandsafdrag_ubetalt_arbejdsmarkedsbidrag_kroner(position.afdrag) == 0 | Ll12BHenstandMisligholdt -> position.aktiv_henstand_skat_kroner + position.aktiv_henstand_arbejdsmarkedsbidrag_kroner == 0 | Ll12BHenstandFrafaldet -> position.aktiv_henstand_skat_kroner + position.aktiv_henstand_arbejdsmarkedsbidrag_kroner + ll12b_henstandsafdrag_ubetalt_skat_kroner(position.afdrag) + ll12b_henstandsafdrag_ubetalt_arbejdsmarkedsbidrag_kroner(position.afdrag) == 0 }
| ligningslov12b_henstand_startposition(bevilling: Ligningslov12BHenstandBevillingResultat, konto_for_opsparet_overskud_kroner: Heltal) -> Ligningslov12BHenstandPosition(bevilling = bevilling, status = hvis bevilling.samlet_henstandsbeløb_kroner > 0 { Ll12BHenstandAktiv } ellers { Ll12BHenstandAfviklet }, opgjort_pr = bevilling.aftaledato, aktiv_henstand_skat_kroner = bevilling.henstand_med_skat_kroner, aktiv_henstand_arbejdsmarkedsbidrag_kroner = bevilling.henstand_med_arbejdsmarkedsbidrag_kroner, afdrag = [], konto_for_opsparet_overskud_kroner = penge_positivt_beløb(konto_for_opsparet_overskud_kroner))

| ll12b_henstandsafdrag_efter_betaling(afdrag: Ligningslov12BHenstandsafdrag, identifikation: Tekst, betalt_skat_kroner: Heltal, betalt_arbejdsmarkedsbidrag_kroner: Heltal, betalingsdato: Ligningslov12BDato) -> hvis afdrag.identifikation == identifikation { Ligningslov12BHenstandsafdrag(identifikation = afdrag.identifikation, art = afdrag.art, realisationsgrundlag_kroner = afdrag.realisationsgrundlag_kroner, realisationsdato = afdrag.realisationsdato, forfaldsdato = afdrag.forfaldsdato, sidste_rettidige_betalingsdato = afdrag.sidste_rettidige_betalingsdato, oprindeligt_skatteafdrag_kroner = afdrag.oprindeligt_skatteafdrag_kroner, oprindeligt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner, ubetalt_skatteafdrag_kroner = afdrag.ubetalt_skatteafdrag_kroner - betalt_skat_kroner, ubetalt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner - betalt_arbejdsmarkedsbidrag_kroner, status = hvis afdrag.ubetalt_skatteafdrag_kroner - betalt_skat_kroner + afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner - betalt_arbejdsmarkedsbidrag_kroner == 0 { Ll12BAfdragBetalt } ellers { hvis ll12b_dato_efter(betalingsdato, afdrag.sidste_rettidige_betalingsdato) { Ll12BAfdragForfaldent } ellers { Ll12BAfdragAfventerForfald } }, sidst_beregnede_rentemånedsindeks = afdrag.sidst_beregnede_rentemånedsindeks, beregnet_rente_før_minimum_kroner = afdrag.beregnet_rente_før_minimum_kroner, pålignet_ikke_fradragsberettiget_rente_kroner = afdrag.pålignet_ikke_fradragsberettiget_rente_kroner, antal_erindringsskrivelser = afdrag.antal_erindringsskrivelser) } ellers { afdrag }
| ll12b_henstandsafdrag_efter_erindring(afdrag: Ligningslov12BHenstandsafdrag, identifikation: Tekst) -> hvis afdrag.identifikation == identifikation { Ligningslov12BHenstandsafdrag(identifikation = afdrag.identifikation, art = afdrag.art, realisationsgrundlag_kroner = afdrag.realisationsgrundlag_kroner, realisationsdato = afdrag.realisationsdato, forfaldsdato = afdrag.forfaldsdato, sidste_rettidige_betalingsdato = afdrag.sidste_rettidige_betalingsdato, oprindeligt_skatteafdrag_kroner = afdrag.oprindeligt_skatteafdrag_kroner, oprindeligt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner, ubetalt_skatteafdrag_kroner = afdrag.ubetalt_skatteafdrag_kroner, ubetalt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner, status = afdrag.status, sidst_beregnede_rentemånedsindeks = afdrag.sidst_beregnede_rentemånedsindeks, beregnet_rente_før_minimum_kroner = afdrag.beregnet_rente_før_minimum_kroner, pålignet_ikke_fradragsberettiget_rente_kroner = afdrag.pålignet_ikke_fradragsberettiget_rente_kroner, antal_erindringsskrivelser = afdrag.antal_erindringsskrivelser + 1) } ellers { afdrag }
| ll12b_henstandsafdrag_frafaldet(afdrag: Ligningslov12BHenstandsafdrag) -> hvis ll12b_henstandsafdrag_ubetalt_kroner(afdrag) > 0 { Ligningslov12BHenstandsafdrag(identifikation = afdrag.identifikation, art = afdrag.art, realisationsgrundlag_kroner = afdrag.realisationsgrundlag_kroner, realisationsdato = afdrag.realisationsdato, forfaldsdato = afdrag.forfaldsdato, sidste_rettidige_betalingsdato = afdrag.sidste_rettidige_betalingsdato, oprindeligt_skatteafdrag_kroner = afdrag.oprindeligt_skatteafdrag_kroner, oprindeligt_arbejdsmarkedsbidragsafdrag_kroner = afdrag.oprindeligt_arbejdsmarkedsbidragsafdrag_kroner, ubetalt_skatteafdrag_kroner = 0, ubetalt_arbejdsmarkedsbidragsafdrag_kroner = 0, status = Ll12BAfdragFrafaldet, sidst_beregnede_rentemånedsindeks = afdrag.sidst_beregnede_rentemånedsindeks, beregnet_rente_før_minimum_kroner = afdrag.beregnet_rente_før_minimum_kroner, pålignet_ikke_fradragsberettiget_rente_kroner = afdrag.pålignet_ikke_fradragsberettiget_rente_kroner, antal_erindringsskrivelser = afdrag.antal_erindringsskrivelser) } ellers { afdrag }

# Ligningslov12BHenstandHændelsessag(input: Ligningslov12BHenstandHændelsesinput) {
    | hændelsesdato() -> ll12b_henstand_hændelsesdato(input.hændelse)
    | identifikation() -> ll12b_henstand_hændelsesidentifikation(input.hændelse)
    | position_gyldig() -> ll12b_henstand_position_gyldig(input.position)
    | dato_gyldig_og_kronologisk() -> ll12b_dato_gyldig(hændelsesdato()) && ll12b_dato_før_eller_lig_med(input.position.opgjort_pr, hændelsesdato())
    | afdrag_før_hændelse() -> map(input.position.afdrag, |afdrag: Ligningslov12BHenstandsafdrag| ll12b_henstandsafdrag_opgjort(afdrag, hændelsesdato()))
    | rente_kilder_påkrævet() -> any(input.position.afdrag, |afdrag: Ligningslov12BHenstandsafdrag| length(ll12b_henstandsafdrag_rentemånedsindekser(afdrag, hændelsesdato())) > 0)
    | rente_kilder_tilgængelige() -> all(input.position.afdrag, |afdrag: Ligningslov12BHenstandsafdrag| ll12b_henstandsafdrag_rentekilder_tilgængelige(afdrag, hændelsesdato()))
    | aktiv_eller_misligholdt() -> input.position.status == Ll12BHenstandAktiv || input.position.status == Ll12BHenstandMisligholdt
    | hændelse_tilladt_for_status() -> hvis ll12b_henstand_realisering(input.hændelse) || ll12b_henstand_misligholdelse(input.hændelse) || ll12b_henstand_ophør(input.hændelse) { input.position.status == Ll12BHenstandAktiv } ellers { hvis ll12b_henstand_betaling(input.hændelse) || ll12b_henstand_erindringsskrivelse(input.hændelse) { aktiv_eller_misligholdt() } ellers { ll12b_henstand_opgørelse(input.hændelse) } }
    | identifikation_findes() -> ll12b_henstandsafdrag_identifikation_antal(afdrag_før_hændelse(), identifikation()) == 1
    | identifikation_er_ny() -> identifikation() != "" && ll12b_henstandsafdrag_identifikation_antal(afdrag_før_hændelse(), identifikation()) == 0
    | realiseret_beløb_kroner() -> ll12b_henstand_realiseret_beløb_kroner(input.hændelse)
    | realisering_gyldig() -> ll12b_henstand_realisering(input.hændelse) == Falskt || identifikation_er_ny() && realiseret_beløb_kroner() > 0
    | betalt_skat_kroner() -> ll12b_henstand_betalt_skat_kroner(input.hændelse)
    | betalt_arbejdsmarkedsbidrag_kroner() -> ll12b_henstand_betalt_arbejdsmarkedsbidrag_kroner(input.hændelse)
    | mål_ubetalt_skat_kroner() -> foldl(afdrag_før_hændelse(), 0, |sum: Heltal, afdrag: Ligningslov12BHenstandsafdrag| sum + hvis afdrag.identifikation == identifikation() { afdrag.ubetalt_skatteafdrag_kroner } ellers { 0 })
    | mål_ubetalt_arbejdsmarkedsbidrag_kroner() -> foldl(afdrag_før_hændelse(), 0, |sum: Heltal, afdrag: Ligningslov12BHenstandsafdrag| sum + hvis afdrag.identifikation == identifikation() { afdrag.ubetalt_arbejdsmarkedsbidragsafdrag_kroner } ellers { 0 })
    | betaling_gyldig() -> ll12b_henstand_betaling(input.hændelse) == Falskt || identifikation_findes() && betalt_skat_kroner() + betalt_arbejdsmarkedsbidrag_kroner() > 0 && betalt_skat_kroner() <= mål_ubetalt_skat_kroner() && betalt_arbejdsmarkedsbidrag_kroner() <= mål_ubetalt_arbejdsmarkedsbidrag_kroner()
    | erindring_gyldig() -> ll12b_henstand_erindringsskrivelse(input.hændelse) == Falskt || identifikation_findes() && any(afdrag_før_hændelse(), |afdrag: Ligningslov12BHenstandsafdrag| afdrag.identifikation == identifikation() && afdrag.status == Ll12BAfdragForfaldent)
    | misligholdelse_gyldig() -> ll12b_henstand_misligholdelse(input.hændelse) == Falskt || identifikation_er_ny()
    | ophørssaldo_kroner() -> match input.hændelse { | Ll12BHenstandYdelserEndeligtOphørt(_, _, saldo_kroner, _, _) -> saldo_kroner | _ -> 0 }
    | opsparet_overskud_henført_kroner() -> match input.hændelse { | Ll12BHenstandYdelserEndeligtOphørt(_, _, _, _, beløb_kroner) -> beløb_kroner | _ -> 0 }
    | anvender_virksomhedsordningen() -> match input.hændelse { | Ll12BHenstandYdelserEndeligtOphørt(_, _, _, anvender, _) -> anvender | _ -> Falskt }
    | ophør_gyldigt() -> ll12b_henstand_ophør(input.hændelse) == Falskt || identifikation_er_ny() && ophørssaldo_kroner() > 0 && opsparet_overskud_henført_kroner() >= 0
    | input_gyldigt() -> position_gyldig() && dato_gyldig_og_kronologisk() && rente_kilder_tilgængelige() && hændelse_tilladt_for_status() && realisering_gyldig() && betaling_gyldig() && erindring_gyldig() && misligholdelse_gyldig() && ophør_gyldigt()
    | realiseret_grundlag_før_kroner() -> ll12b_henstandsafdrag_realiseret_grundlag_kroner(input.position.afdrag)
    | realiseret_grundlag_efter_kroner() -> penge_mindste_beløb(input.position.bevilling.kapitaliseret_værdi_af_løbende_ydelse_kroner, realiseret_grundlag_før_kroner() + realiseret_beløb_kroner())
    | forholdsmæssig_skat_efter_kroner() -> hvis input.position.bevilling.kapitaliseret_værdi_af_løbende_ydelse_kroner > 0 { input.position.bevilling.henstand_med_skat_kroner * realiseret_grundlag_efter_kroner() / input.position.bevilling.kapitaliseret_værdi_af_løbende_ydelse_kroner } ellers { 0 }
    | forholdsmæssigt_arbejdsmarkedsbidrag_efter_kroner() -> hvis input.position.bevilling.kapitaliseret_værdi_af_løbende_ydelse_kroner > 0 { input.position.bevilling.henstand_med_arbejdsmarkedsbidrag_kroner * realiseret_grundlag_efter_kroner() / input.position.bevilling.kapitaliseret_værdi_af_løbende_ydelse_kroner } ellers { 0 }
    | nyt_skatteafdrag_kroner() -> hvis input_gyldigt() && ll12b_henstand_realisering(input.hændelse) { penge_mindste_beløb(input.position.aktiv_henstand_skat_kroner, penge_positivt_beløb(forholdsmæssig_skat_efter_kroner() - ll12b_henstandsafdrag_forholdsmæssig_skat_kroner(input.position.afdrag))) } ellers { 0 }
    | nyt_arbejdsmarkedsbidragsafdrag_kroner() -> hvis input_gyldigt() && ll12b_henstand_realisering(input.hændelse) { penge_mindste_beløb(input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner, penge_positivt_beløb(forholdsmæssigt_arbejdsmarkedsbidrag_efter_kroner() - ll12b_henstandsafdrag_forholdsmæssigt_arbejdsmarkedsbidrag_kroner(input.position.afdrag))) } ellers { 0 }
    | nyt_realiseringsafdrag() -> Ligningslov12BHenstandsafdrag(identifikation = identifikation(), art = Ll12BForholdsmæssigtRealiseringsafdrag, realisationsgrundlag_kroner = realiseret_beløb_kroner(), realisationsdato = hændelsesdato(), forfaldsdato = ll12b_henstand_forfaldsdato(hændelsesdato()), sidste_rettidige_betalingsdato = ll12b_henstand_sidste_rettidige_betalingsdato(hændelsesdato()), oprindeligt_skatteafdrag_kroner = nyt_skatteafdrag_kroner(), oprindeligt_arbejdsmarkedsbidragsafdrag_kroner = nyt_arbejdsmarkedsbidragsafdrag_kroner(), ubetalt_skatteafdrag_kroner = nyt_skatteafdrag_kroner(), ubetalt_arbejdsmarkedsbidragsafdrag_kroner = nyt_arbejdsmarkedsbidragsafdrag_kroner(), status = hvis nyt_skatteafdrag_kroner() + nyt_arbejdsmarkedsbidragsafdrag_kroner() > 0 { Ll12BAfdragAfventerForfald } ellers { Ll12BAfdragBetalt }, sidst_beregnede_rentemånedsindeks = ll12b_henstand_månedsindeks(ll12b_henstand_forfaldsdato(hændelsesdato())) - 1, beregnet_rente_før_minimum_kroner = 0, pålignet_ikke_fradragsberettiget_rente_kroner = 0, antal_erindringsskrivelser = 0)
    | terminalt_restafdrag(art: Ligningslov12BHenstandsafdragArt, status: Ligningslov12BHenstandsafdragStatus) -> Ligningslov12BHenstandsafdrag(identifikation = identifikation(), art = art, realisationsgrundlag_kroner = 0, realisationsdato = hændelsesdato(), forfaldsdato = hændelsesdato(), sidste_rettidige_betalingsdato = hændelsesdato(), oprindeligt_skatteafdrag_kroner = input.position.aktiv_henstand_skat_kroner, oprindeligt_arbejdsmarkedsbidragsafdrag_kroner = input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner, ubetalt_skatteafdrag_kroner = hvis status == Ll12BAfdragFrafaldet { 0 } ellers { input.position.aktiv_henstand_skat_kroner }, ubetalt_arbejdsmarkedsbidragsafdrag_kroner = hvis status == Ll12BAfdragFrafaldet { 0 } ellers { input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner }, status = status, sidst_beregnede_rentemånedsindeks = ll12b_henstand_månedsindeks(hændelsesdato()) - 1, beregnet_rente_før_minimum_kroner = 0, pålignet_ikke_fradragsberettiget_rente_kroner = 0, antal_erindringsskrivelser = 0)
    | afdrag_efter_betaling() -> map(afdrag_før_hændelse(), |afdrag: Ligningslov12BHenstandsafdrag| ll12b_henstandsafdrag_efter_betaling(afdrag, identifikation(), betalt_skat_kroner(), betalt_arbejdsmarkedsbidrag_kroner(), hændelsesdato()))
    | afdrag_efter_erindring() -> map(afdrag_før_hændelse(), |afdrag: Ligningslov12BHenstandsafdrag| ll12b_henstandsafdrag_efter_erindring(afdrag, identifikation()))
    | afdrag_efter_frafald() -> concat(map(afdrag_før_hændelse(), |afdrag: Ligningslov12BHenstandsafdrag| ll12b_henstandsafdrag_frafaldet(afdrag)), hvis input.position.aktiv_henstand_skat_kroner + input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner > 0 { [terminalt_restafdrag(Ll12BRestFrafaldetVedOphør, Ll12BAfdragFrafaldet)] } ellers { [] })
    | afdrag_efter_hændelse() -> hvis ll12b_henstand_realisering(input.hændelse) { concat(afdrag_før_hændelse(), [nyt_realiseringsafdrag()]) } ellers { hvis ll12b_henstand_betaling(input.hændelse) { afdrag_efter_betaling() } ellers { hvis ll12b_henstand_erindringsskrivelse(input.hændelse) { afdrag_efter_erindring() } ellers { hvis ll12b_henstand_misligholdelse(input.hændelse) { concat(afdrag_før_hændelse(), hvis input.position.aktiv_henstand_skat_kroner + input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner > 0 { [terminalt_restafdrag(Ll12BRestForfaldetEfterMisligholdelse, Ll12BAfdragForfaldent)] } ellers { [] }) } ellers { hvis ll12b_henstand_ophør(input.hændelse) { afdrag_efter_frafald() } ellers { afdrag_før_hændelse() } } } } }
    | aktiv_henstand_skat_efter_kroner() -> hvis ll12b_henstand_realisering(input.hændelse) { input.position.aktiv_henstand_skat_kroner - nyt_skatteafdrag_kroner() } ellers { hvis ll12b_henstand_misligholdelse(input.hændelse) || ll12b_henstand_ophør(input.hændelse) { 0 } ellers { input.position.aktiv_henstand_skat_kroner } }
    | aktiv_henstand_arbejdsmarkedsbidrag_efter_kroner() -> hvis ll12b_henstand_realisering(input.hændelse) { input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner - nyt_arbejdsmarkedsbidragsafdrag_kroner() } ellers { hvis ll12b_henstand_misligholdelse(input.hændelse) || ll12b_henstand_ophør(input.hændelse) { 0 } ellers { input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner } }
    | frafaldet_henstandsbeløb_kroner() -> hvis input_gyldigt() && ll12b_henstand_ophør(input.hændelse) { input.position.aktiv_henstand_skat_kroner + input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner + ll12b_henstandsafdrag_ubetalt_skat_kroner(afdrag_før_hændelse()) + ll12b_henstandsafdrag_ubetalt_arbejdsmarkedsbidrag_kroner(afdrag_før_hændelse()) } ellers { 0 }
    | resterende_henstandsbeløb_forfalder_efter_påkrav_kroner() -> hvis input_gyldigt() && ll12b_henstand_misligholdelse(input.hændelse) { input.position.aktiv_henstand_skat_kroner + input.position.aktiv_henstand_arbejdsmarkedsbidrag_kroner } ellers { 0 }
    | konto_for_opsparet_overskud_reduktion_kroner() -> hvis input_gyldigt() && ll12b_henstand_ophør(input.hændelse) && anvender_virksomhedsordningen() { penge_mindste_beløb(input.position.konto_for_opsparet_overskud_kroner, opsparet_overskud_henført_kroner()) } ellers { 0 }
    | status_efter() -> hvis ll12b_henstand_misligholdelse(input.hændelse) { Ll12BHenstandMisligholdt } ellers { hvis ll12b_henstand_ophør(input.hændelse) { Ll12BHenstandFrafaldet } ellers { hvis input.position.status == Ll12BHenstandMisligholdt { Ll12BHenstandMisligholdt } ellers { hvis input.position.status == Ll12BHenstandFrafaldet { Ll12BHenstandFrafaldet } ellers { hvis aktiv_henstand_skat_efter_kroner() + aktiv_henstand_arbejdsmarkedsbidrag_efter_kroner() + ll12b_henstandsafdrag_ubetalt_skat_kroner(afdrag_efter_hændelse()) + ll12b_henstandsafdrag_ubetalt_arbejdsmarkedsbidrag_kroner(afdrag_efter_hændelse()) == 0 { Ll12BHenstandAfviklet } ellers { Ll12BHenstandAktiv } } } } }
    | position_efter_gyldig_hændelse() -> Ligningslov12BHenstandPosition(bevilling = input.position.bevilling, status = status_efter(), opgjort_pr = hændelsesdato(), aktiv_henstand_skat_kroner = aktiv_henstand_skat_efter_kroner(), aktiv_henstand_arbejdsmarkedsbidrag_kroner = aktiv_henstand_arbejdsmarkedsbidrag_efter_kroner(), afdrag = afdrag_efter_hændelse(), konto_for_opsparet_overskud_kroner = input.position.konto_for_opsparet_overskud_kroner - konto_for_opsparet_overskud_reduktion_kroner())
    | position_efter() -> hvis input_gyldigt() { position_efter_gyldig_hændelse() } ellers { input.position }
    | ny_betalingsfrist() -> hvis input_gyldigt() && ll12b_henstand_realisering(input.hændelse) { Ll12BNyBetalingsfrist(forfaldsdato = ll12b_henstand_forfaldsdato(hændelsesdato()), sidste_rettidige_betalingsdato = ll12b_henstand_sidste_rettidige_betalingsdato(hændelsesdato())) } ellers { Ll12BIngenNyBetalingsfrist }
    | ny_rente_kroner() -> hvis input_gyldigt() { penge_positivt_beløb(ll12b_henstandsafdrag_pålignet_rente_kroner(afdrag_før_hændelse()) - ll12b_henstandsafdrag_pålignet_rente_kroner(input.position.afdrag)) } ellers { 0 }
    | rykkergebyr_kroner() -> hvis input_gyldigt() && ll12b_henstand_erindringsskrivelse(input.hændelse) { 65 } ellers { 0 }
    | resultat() -> Ligningslov12BHenstandHændelsesresultat(
        hændelse = input.hændelse,
        hændelsesdato = hændelsesdato(),
        input_gyldigt = input_gyldigt(),
        rente_kilder_påkrævet = rente_kilder_påkrævet(),
        rente_kilder_tilgængelige = rente_kilder_tilgængelige(),
        nyt_skatteafdrag_kroner = nyt_skatteafdrag_kroner(),
        nyt_arbejdsmarkedsbidragsafdrag_kroner = nyt_arbejdsmarkedsbidragsafdrag_kroner(),
        ny_betalingsfrist = ny_betalingsfrist(),
        betalt_skatteafdrag_kroner = hvis input_gyldigt() { betalt_skat_kroner() } ellers { 0 },
        betalt_arbejdsmarkedsbidragsafdrag_kroner = hvis input_gyldigt() { betalt_arbejdsmarkedsbidrag_kroner() } ellers { 0 },
        forfaldent_skatteafdrag_efter_kroner = ll12b_henstandsafdrag_forfaldent_skat_kroner(position_efter().afdrag),
        forfaldent_arbejdsmarkedsbidragsafdrag_efter_kroner = ll12b_henstandsafdrag_forfaldent_arbejdsmarkedsbidrag_kroner(position_efter().afdrag),
        afventer_forfald_skatteafdrag_efter_kroner = ll12b_henstandsafdrag_afventer_skat_kroner(position_efter().afdrag),
        afventer_forfald_arbejdsmarkedsbidragsafdrag_efter_kroner = ll12b_henstandsafdrag_afventer_arbejdsmarkedsbidrag_kroner(position_efter().afdrag),
        ny_ikke_fradragsberettiget_rente_kroner = ny_rente_kroner(),
        rykkergebyr_kroner = rykkergebyr_kroner(),
        resterende_henstandsbeløb_forfalder_efter_påkrav_kroner = resterende_henstandsbeløb_forfalder_efter_påkrav_kroner(),
        frafaldet_henstandsbeløb_kroner = frafaldet_henstandsbeløb_kroner(),
        konto_for_opsparet_overskud_reduktion_kroner = konto_for_opsparet_overskud_reduktion_kroner(),
        position_efter = position_efter()
    )
}
| ligningslov12b_henstand_hændelsessag(input: Ligningslov12BHenstandHændelsesinput) -> Ligningslov12BHenstandHændelsessag(input)
| ligningslov12b_henstand_hændelsesresultat(input: Ligningslov12BHenstandHændelsesinput) -> ligningslov12b_henstand_hændelsessag(input).resultat()

--@end:ligningsloven_par12b_2026_aendring--
