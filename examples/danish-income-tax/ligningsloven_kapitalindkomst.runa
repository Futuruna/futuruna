----
§ 14 A. Beløb, som låntager betaler til et realkreditinstitut efter § 10 b,
stk. 3, 4. pkt., i bekendtgørelse nr. 571 af 15. august 1989 af lov om
realkreditinstitutter og § 4 b i bekendtgørelse nr. 699 af 5. november 1987 af
lov om et finansieringsinstitut for landbrug mv., som ændret ved lov nr. 373
af 6. juli 1988, kan fradrages i den skattepligtige indkomst for
indbetalingsåret.

Stk. 2. Beløb, som udbetales fra en restgældsreguleringsfond som nævnt i § 23 g,
stk. 1, i bekendtgørelse nr. 571 af 15. august 1989 af lov om
realkreditinstitutter og § 4 b i bekendtgørelse nr. 699 af 5. november 1987 af
lov om et finansieringsinstitut for landbrug mv., som ændret ved lov nr. 373
af 6. juli 1988, medregnes ved opgørelsen af den skattepligtige indkomst.
----

# Ligningslov14AInput(indkomstår: Heltal, indbetalingsår: Heltal, indbetaling_kroner: Heltal, indbetaling_efter_realkreditinstitutlov10b_stk3_4pkt: Boolsk, indbetaling_efter_landbrugsfinansieringsinstitut4b: Boolsk, udbetalingsår: Heltal, udbetaling_kroner: Heltal, udbetaling_fra_restgældsreguleringsfond: Boolsk)
# Ligningslov14AResultat(indkomstår: Heltal, indbetaling_omfattet_af_stk1: Boolsk, indbetaling_i_indbetalingsåret: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal, udbetaling_omfattet_af_stk2: Boolsk, udbetaling_i_udbetalingsåret: Boolsk, skattepligtig_udbetaling_kroner: Heltal, netto_skattepligtig_indkomst_kroner: Heltal)

# Ligningslov14ASag(input: Ligningslov14AInput) {
    | positiv_indbetaling_kroner() -> penge_positivt_beløb(input.indbetaling_kroner)
    | positiv_udbetaling_kroner() -> penge_positivt_beløb(input.udbetaling_kroner)
    | indbetaling_omfattet_af_stk1() -> input.indbetaling_efter_realkreditinstitutlov10b_stk3_4pkt || input.indbetaling_efter_landbrugsfinansieringsinstitut4b
    | indbetaling_i_indbetalingsåret() -> input.indkomstår == input.indbetalingsår
    | fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | exception ll14a_stk1_indbetalingsår fradrag_i_skattepligtig_indkomst_kroner() -> positiv_indbetaling_kroner() under indbetaling_omfattet_af_stk1() && indbetaling_i_indbetalingsåret()
    | udbetaling_omfattet_af_stk2() -> input.udbetaling_fra_restgældsreguleringsfond
    | udbetaling_i_udbetalingsåret() -> input.indkomstår == input.udbetalingsår
    | skattepligtig_udbetaling_kroner() -> 0
    | exception ll14a_stk2_udbetalingsår skattepligtig_udbetaling_kroner() -> positiv_udbetaling_kroner() under udbetaling_omfattet_af_stk2() && udbetaling_i_udbetalingsåret()
    | netto_skattepligtig_indkomst_kroner() -> skattepligtig_udbetaling_kroner() - fradrag_i_skattepligtig_indkomst_kroner()
    | resultat() -> Ligningslov14AResultat(
        indkomstår = input.indkomstår,
        indbetaling_omfattet_af_stk1 = indbetaling_omfattet_af_stk1(),
        indbetaling_i_indbetalingsåret = indbetaling_i_indbetalingsåret(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        udbetaling_omfattet_af_stk2 = udbetaling_omfattet_af_stk2(),
        udbetaling_i_udbetalingsåret = udbetaling_i_udbetalingsåret(),
        skattepligtig_udbetaling_kroner = skattepligtig_udbetaling_kroner(),
        netto_skattepligtig_indkomst_kroner = netto_skattepligtig_indkomst_kroner()
    )
}
| ligningslov14a_sag(input: Ligningslov14AInput) -> Ligningslov14ASag(input)
| ligningslov14a_resultat(input: Ligningslov14AInput) -> ligningslov14a_sag(input).resultat()

