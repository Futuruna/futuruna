| ll12b_modtager_beskattes_når_saldo_bliver_negativ: ll12b_modtager_negativ_saldo_fixture -> ll12b_modtager_negativ_saldo_fixture.saldo_efter_reduktion_kroner == -8000 && ll12b_modtager_negativ_saldo_fixture.modtager_skattepligtigt_kroner == 8000 && ll12b_modtager_negativ_saldo_fixture.netto_skattepligtigt_eller_fradragsberettiget_kroner == 8000
| ll12b_yder_fradrag_med_afskæring_og_anskaffelsessum: ll12b_yder_efterfølgende_fradrag_fixture -> ll12b_yder_efterfølgende_fradrag_fixture.efterfølgende_betalte_ydelser_kroner == 20000 && ll12b_yder_efterfølgende_fradrag_fixture.yder_fradrag_kroner == 13000 && ll12b_yder_efterfølgende_fradrag_fixture.anskaffelsessum_forhøjes_kroner == 4000
| ll12b_modtager_ophørsfradrag_begrænses: ll12b_modtager_ophør_fradrag_fixture -> ll12b_modtager_ophør_fradrag_fixture.ophørs_saldo_kroner == 40000 && ll12b_modtager_ophør_fradrag_fixture.modtager_fradrag_kroner == 30000 && ll12b_modtager_ophør_fradrag_fixture.netto_skattepligtigt_eller_fradragsberettiget_kroner == -30000
| ll12b_yder_ophørsbeskattes_med_anskaffelsessum_nedsættelse: ll12b_yder_ophør_skat_fixture -> ll12b_yder_ophør_skat_fixture.ophørs_saldo_kroner == 25000 && ll12b_yder_ophør_skat_fixture.yder_skattepligtigt_kroner == 15000 && ll12b_yder_ophør_skat_fixture.anskaffelsessum_nedsættes_kroner == 4000
| ll12b_stk6_afståelse_anvender_stk4: ll12b_stk6_afståelse_fixture -> ll12b_stk6_afståelse_fixture.negativ_saldo_beløb_kroner == 3000 && ll12b_stk6_afståelse_fixture.modtager_skattepligtigt_kroner == 3000
| ll12b_stk9_overtager_efterfølgende_fradrag_begrænses: ll12b_stk9_overtager_fixture -> ll12b_stk9_overtager_fixture.overtager_indgangsværdi_kroner == 0 && ll12b_stk9_overtager_fixture.yder_fradrag_kroner == 11000
| ll12b_anden_lov_udelukker_par12b: ll12b_anden_lov_fixture -> ll12b_anden_lov_fixture.omfattet_af_par12b == Falskt && ll12b_anden_lov_fixture.netto_skattepligtigt_eller_fradragsberettiget_kroner == 0
