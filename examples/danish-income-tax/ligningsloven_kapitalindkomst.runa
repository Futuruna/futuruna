        personskattelov_par4a_stk2_undtagelse = personskattelov_par4a_stk2_undtagelse()
    )
}
| ligningslov7n_sag(input: Ligningslov7NInput) -> Ligningslov7NSag(input)
| ligningslov7n_resultat(input: Ligningslov7NInput) -> ligningslov7n_sag(input).resultat()

