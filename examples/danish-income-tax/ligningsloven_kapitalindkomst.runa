| ll8_stk3_litra_b_fradrages: ll8_stk3_kaution_fixture -> ll8_stk3_kaution_fixture.omfattet_af_litra_b == Sandt && ll8_stk3_kaution_fixture.fradrag_kroner == 2500
| ll8_stk3_litra_c_under_to_år_fradrages: ll8_stk3_engangs_under_to_år_fixture -> ll8_stk3_engangs_under_to_år_fixture.omfattet_af_litra_c == Sandt && ll8_stk3_engangs_under_to_år_fixture.løbetid_under_to_år == Sandt && ll8_stk3_engangs_under_to_år_fixture.fradrag_kroner == 6000
