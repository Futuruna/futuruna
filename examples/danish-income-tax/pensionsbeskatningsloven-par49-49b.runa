    )
)

--@label:pensionsbeskatningsloven_par49_til49b_samordning::meta:pensionsbeskatningsloven_par49_til49b_samordning_metadata--
----
Kildeskatteloven § 2, stk. 9:

Stk. 9. Skattepligten i medfør af stk. 1, nr. 1, 2, 5, 7 og 9-27, og stk. 2
omfatter alene de dér nævnte indtægter. Udgifter kan kun fratrækkes, i det
omfang de vedrører disse indtægter, jf. dog stk. 2, 4. og 5. pkt., afsnit I A og
pensionsbeskatningslovens § 49.

Kildeskatteloven § 5 A, stk. 1:

§ 5 A. Dette afsnit finder anvendelse på personer, som er skattepligtige efter
kildeskattelovens § 2 eller kulbrinteskatteloven, eller som efter en indgået
dobbeltbeskatningsoverenskomst er hjemmehørende i en anden stat, i Grønland eller
på Færøerne. Hvis indkomst hidrørende fra personligt arbejde og fra selvstændig
erhvervsvirksomhed, der kan beskattes her i landet - herunder efter en
dobbeltbeskatningsoverenskomst - med tillæg af renteudgifter og kurstab på gæld,
der er fradraget i denne indkomst, i et indkomstår udgør mindst 75 pct. af de
efter dansk skattelovgivning opgjorte samlede indtægter med fradrag af samtlige
udgifter afholdt for at erhverve indkomsten opgjort efter statsskattelovens § 6,
litra a, kan den skattepligtige vælge at blive beskattet efter §§ 5 A-D.
Tilsvarende gælder i et indkomstår, hvor både den danske indkomst og den samlede
indkomst er negativ, hvis den skattepligtige i det seneste indkomstår med dansk
positiv indkomst er blevet beskattet efter dette afsnit.

Kildeskatteloven § 5 B, stk. 1, indledning og nr. 3:

§ 5 B. Ved opgørelsen af den skattepligtige indkomst gives fradrag efter
skattelovgivningens almindelige regler for skattepligtige efter § 1, stk. 1, for
følgende udgifter, der vedrører den skattepligtiges familiemæssige og personlige
forhold:

3) Indbetalinger til pensionsordninger og A-kasse-indbetalinger, der er
fradragsberettigede efter pensionsbeskatningsloven.
----

--@begin::pensionsbeskatningsloven_par49_til49b_samordning--
| pbl49a_49b_skattepligtsbetingelse_opfyldt(position: Pbl49Skattepligtsposition) -> position == Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark || position == Pbl49GrænsegængerEfterKildeskattelovensPar5ATil5D

# Pbl49Til49BBidragSag(indkomstår: Heltal, skattepligtsposition: Pbl49Skattepligtsposition, akassemedlemskab_indbetalt_kroner: Heltal, fakta: Pbl49Til49BBidragsfakta) {
    | input_gyldigt() -> fakta.identifikation != "" && fakta.indkomstår == indkomstår && fakta.betalt_beløb_kroner >= 0
    | er_akassekontingent() -> match fakta.art { | Pbl49Akassekontingent(_, _) -> Sandt | _ -> Falskt }
    | er_privat_arbejdsløshedsforsikring() -> match fakta.art { | Pbl49PrivatArbejdsløshedsforsikring(_, _) -> Sandt | _ -> Falskt }
    | er_seniormedlemskontingent() -> match fakta.art { | Pbl49Seniormedlemskontingent(_, _) -> Sandt | _ -> Falskt }
    | er_efterlønsbidrag() -> match fakta.art { | Pbl49AEfterlønsbidrag(_, _, _) -> Sandt | _ -> Falskt }
    | er_fleksydelsesbidrag() -> match fakta.art { | Pbl49BFleksydelsesbidrag(_, _) -> Sandt | _ -> Falskt }
    | arbejdsløshedskasse_opfyldt() -> match fakta.art {
        | Pbl49Akassekontingent(arbejdsløshedskasse, _) -> pbl49_arbejdsløshedskasse_opfyldt(arbejdsløshedskasse)
        | Pbl49Seniormedlemskontingent(arbejdsløshedskasse, _) -> pbl49_arbejdsløshedskasse_opfyldt(arbejdsløshedskasse)
        | Pbl49AEfterlønsbidrag(arbejdsløshedskasse, _, _) -> pbl49_arbejdsløshedskasse_opfyldt(arbejdsløshedskasse)
        | _ -> Sandt
    }
    | skattepligtsbetingelse_opfyldt() -> hvis er_efterlønsbidrag() || er_fleksydelsesbidrag() { pbl49a_49b_skattepligtsbetingelse_opfyldt(skattepligtsposition) } ellers { pbl49_skattepligtsbetingelse_opfyldt(skattepligtsposition) }
    | privat_forsikrings_minimum_opfyldt() -> er_privat_arbejdsløshedsforsikring() == Falskt || akassemedlemskab_indbetalt_kroner >= 1300
    | skatteyderrelation_opfyldt() -> match fakta.art {
        | Pbl49Akassekontingent(_, skatteyderen_er_medlem_og_forsikret) -> skatteyderen_er_medlem_og_forsikret
        | _ -> pbl54_ejer_og_forsikrede_opfyldt(fakta.art)
    }
    | ordningsbetingelser_opfyldt() -> Falskt
    | exception pbl49_akasse_ordning_opfyldt ordningsbetingelser_opfyldt() -> arbejdsløshedskasse_opfyldt() && skatteyderrelation_opfyldt() under er_akassekontingent()
    | exception pbl49_privat_forsikring_ordning_opfyldt ordningsbetingelser_opfyldt() -> privat_forsikrings_minimum_opfyldt() && skatteyderrelation_opfyldt() under er_privat_arbejdsløshedsforsikring()
    | exception pbl49_seniormedlemskab_opfyldt ordningsbetingelser_opfyldt() -> match fakta.art { | Pbl49Seniormedlemskontingent(_, seniormedlem) -> arbejdsløshedskasse_opfyldt() && seniormedlem | _ -> Falskt } under er_seniormedlemskontingent()
    | exception pbl49a_efterlønsordning_opfyldt ordningsbetingelser_opfyldt() -> pbl49a_ordningsbetingelser_opfyldt(fakta.art) under er_efterlønsbidrag()
    | exception pbl49b_fleksydelsesordning_opfyldt ordningsbetingelser_opfyldt() -> pbl49b_ordningsbetingelser_opfyldt(fakta.art) under er_fleksydelsesbidrag()
    | fradragsberettiget() -> input_gyldigt() && skattepligtsbetingelse_opfyldt() && privat_forsikrings_minimum_opfyldt() && skatteyderrelation_opfyldt() && ordningsbetingelser_opfyldt()
    | hjemmel() -> Pbl49IngenFradragshjemmel
    | exception pbl49_arbejdsløshedsforsikring_hjemmel hjemmel() -> Pbl49Arbejdsløshedsforsikringsfradrag under fradragsberettiget() && (er_akassekontingent() || er_privat_arbejdsløshedsforsikring() || er_seniormedlemskontingent())
    | exception pbl49a_efterløn_hjemmel hjemmel() -> Pbl49AEfterlønsfradrag under fradragsberettiget() && er_efterlønsbidrag()
    | exception pbl49b_fleksydelse_hjemmel hjemmel() -> Pbl49BFleksydelsesfradrag under fradragsberettiget() && er_fleksydelsesbidrag()
    | fradrag_kroner() -> hvis fradragsberettiget() { fakta.betalt_beløb_kroner } ellers { 0 }
    | resultat() -> Pbl49Til49BBidragsresultat(
        fakta = fakta,
        input_gyldigt = input_gyldigt(),
        arbejdsløshedskasse_opfyldt = arbejdsløshedskasse_opfyldt(),
        skattepligtsbetingelse_opfyldt = skattepligtsbetingelse_opfyldt(),
        privat_forsikrings_minimum_opfyldt = privat_forsikrings_minimum_opfyldt(),
        skatteyderrelation_opfyldt = skatteyderrelation_opfyldt(),
        ordningsbetingelser_opfyldt = ordningsbetingelser_opfyldt(),
        fradragsberettiget = fradragsberettiget(),
        hjemmel = hjemmel(),
        fradrag_kroner = fradrag_kroner()
    )
}

| pbl49_til49b_bidrag_resultat(indkomstår: Heltal, skattepligtsposition: Pbl49Skattepligtsposition, akassemedlemskab_indbetalt_kroner: Heltal, fakta: Pbl49Til49BBidragsfakta) -> Pbl49Til49BBidragSag(indkomstår, skattepligtsposition, akassemedlemskab_indbetalt_kroner, fakta).resultat()
| pbl49_til49b_identifikationer_entydige(bidrag: List(Pbl49Til49BBidragsfakta)) -> length(distinct(map(bidrag, |fakta: Pbl49Til49BBidragsfakta| fakta.identifikation))) == length(bidrag) && all(bidrag, |fakta: Pbl49Til49BBidragsfakta| fakta.identifikation != "")
| pbl49_til49b_fradrag_kroner(resultater: List(Pbl49Til49BBidragsresultat)) -> foldl(resultater, 0, |sum_kroner: Heltal, resultat: Pbl49Til49BBidragsresultat| sum_kroner + resultat.fradrag_kroner)
| pbl49_til49b_betalt_kroner(bidrag: List(Pbl49Til49BBidragsfakta)) -> foldl(bidrag, 0, |sum_kroner: Heltal, fakta: Pbl49Til49BBidragsfakta| sum_kroner + hvis fakta.betalt_beløb_kroner > 0 { fakta.betalt_beløb_kroner } ellers { 0 })
| pbl49_til49b_årsresultat(indkomstår: Heltal, input: Pbl49Til49BÅrsinput) -> {
    = akassemedlemskab_indbetalt_kroner = pbl49_akassemedlemskab_indbetalt_kroner(input.bidrag, indkomstår)
    = bidragsresultater = map(input.bidrag, |fakta: Pbl49Til49BBidragsfakta| pbl49_til49b_bidrag_resultat(indkomstår, input.skattepligtsposition, akassemedlemskab_indbetalt_kroner, fakta))
    = skatteår_understøttet = length(input.bidrag) == 0 || pbl49_skatteår_understøttet(indkomstår)
    = identifikationer_entydige = pbl49_til49b_identifikationer_entydige(input.bidrag)
    = alle_input_gyldige = skatteår_understøttet && identifikationer_entydige && all(bidragsresultater, |resultat: Pbl49Til49BBidragsresultat| resultat.input_gyldigt)
    = fradrag_før_validering_kroner = pbl49_til49b_fradrag_kroner(bidragsresultater)
    = samlet_fradrag_kroner = hvis alle_input_gyldige { fradrag_før_validering_kroner } ellers { 0 }
    Pbl49Til49BÅrsresultat(
        indkomstår = indkomstår,
        input = input,
        bidragsresultater = bidragsresultater,
        skatteår_understøttet = skatteår_understøttet,
        identifikationer_entydige = identifikationer_entydige,
        alle_input_gyldige = alle_input_gyldige,
        akassemedlemskab_indbetalt_kroner = akassemedlemskab_indbetalt_kroner,
        samlet_fradrag_kroner = samlet_fradrag_kroner,
        ikke_fradraget_kroner = pbl49_til49b_betalt_kroner(input.bidrag) - samlet_fradrag_kroner
    )
}
--@end::pensionsbeskatningsloven_par49_til49b_samordning--
