--@label:pensionsbeskatningsloven_par49_fradrag::meta:pensionsbeskatningsloven_par49_metadata--
----
§ 49. Ved opgørelsen af den skattepligtige indkomst for den forsikrede kan
fradrages udgifter til arbejdsløshedsforsikring, og for seniormedlemmer af en
arbejdsløshedskasse kan fradrages udgifter til seniormedlemskabskontingent.
Personer, som er skattepligtige efter kildeskattelovens § 2, jf. dog
kildeskattelovens §§ 5 A-5 D, kan kun opnå fradrag efter 1. pkt. i indkomst
omfattet af kildeskattelovens § 2, stk. 1, nr. 1 eller 4, eller i
arbejdsløshedsdagpenge, sygedagpenge og barselsdagpenge omfattet af
kildeskattelovens § 2, stk. 1, nr. 12, og kun i det omfang udgiften efter
udenlandske regler ikke kan fradrages ved beskatning i udlandet. 2. pkt. finder
tilsvarende anvendelse for personer, som er omfattet af kildeskattelovens § 1,
og som anses for hjemmehørende i en fremmed stat, i Grønland eller på Færøerne
efter bestemmelserne i en dobbeltbeskatningsoverenskomst.

Stk. 3. Fradragsretten for udgifter til private arbejdsløshedsforsikringer efter
stk. 1, 1. pkt., er betinget af, at der i indkomståret er indbetalt mindst
1.300 kr. til et medlemskab af en arbejdsløshedskasse. Arbejdsløshedskasser med
hjemsted i et andet land inden for EU/EØS end Danmark skal opfylde betingelserne
for anerkendelse af en arbejdsløshedskasse i § 32, stk. 1, nr. 1, og stk. 2, i
lov om arbejdsløshedsforsikring m.v.
----

--@begin::pensionsbeskatningsloven_par49_fradrag--
# Pbl49ArbejdsløshedskasseStatus = Pbl49DanskAnerkendtArbejdsløshedskasse | Pbl49EUEØSArbejdsløshedskasseAnerkendtEfterArbejdsløshedsforsikringslov32 | Pbl49EUEØSArbejdsløshedskasseIkkeAnerkendtEfterArbejdsløshedsforsikringslov32 | Pbl49ArbejdsløshedskasseUdenForEUEØS | Pbl49IkkeArbejdsløshedskasse
# Pbl49DanskIndkomstgrundlag = Pbl49Kildeskattelov2Stk1Nr1Eller4 | Pbl49Kildeskattelov2Stk1Nr12Dagpenge | Pbl49AndetIndkomstgrundlag
# Pbl49Skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark | Pbl49GrænsegængerEfterKildeskattelovensPar5ATil5D | Pbl49BegrænsetSkattepligtig(indkomstgrundlag: Pbl49DanskIndkomstgrundlag, udgiften_kan_fradrages_i_udlandet: Boolsk) | Pbl49FuldtSkattepligtigMenDobbeltbeskatningshjemmehørendeIUdlandet(indkomstgrundlag: Pbl49DanskIndkomstgrundlag, udgiften_kan_fradrages_i_udlandet: Boolsk)
# Pbl49Til49BBidragsart = Pbl49Akassekontingent(arbejdsløshedskasse: Pbl49ArbejdsløshedskasseStatus, skatteyderen_er_medlem_og_forsikret: Boolsk) | Pbl49PrivatArbejdsløshedsforsikring(skatteyderen_er_forsikringsejer: Boolsk, skatteyderen_er_forsikret: Boolsk) | Pbl49Seniormedlemskontingent(arbejdsløshedskasse: Pbl49ArbejdsløshedskasseStatus, seniormedlem: Boolsk) | Pbl49AEfterlønsbidrag(arbejdsløshedskasse: Pbl49ArbejdsløshedskasseStatus, medlem_af_arbejdsløshedskasse: Boolsk, bidrag_efter_arbejdsløshedsforsikringslov77_stk4: Boolsk) | Pbl49BFleksydelsesbidrag(tilmeldt_fleksydelsesordningen_efter_fleksydelseslov4: Boolsk, bidrag_efter_fleksydelseslov7: Boolsk) | Pbl49AndetBidrag
# Pbl49Til49BBidragsfakta(identifikation: Tekst, indkomstår: Heltal, betalt_beløb_kroner: Heltal, art: Pbl49Til49BBidragsart)
# Pbl49Til49BÅrsinput(skattepligtsposition: Pbl49Skattepligtsposition, bidrag: List(Pbl49Til49BBidragsfakta))
# Pbl49Til49BHjemmel = Pbl49IngenFradragshjemmel | Pbl49Arbejdsløshedsforsikringsfradrag | Pbl49AEfterlønsfradrag | Pbl49BFleksydelsesfradrag
# Pbl49Til49BBidragsresultat(fakta: Pbl49Til49BBidragsfakta, input_gyldigt: Boolsk, arbejdsløshedskasse_opfyldt: Boolsk, skattepligtsbetingelse_opfyldt: Boolsk, privat_forsikrings_minimum_opfyldt: Boolsk, skatteyderrelation_opfyldt: Boolsk, ordningsbetingelser_opfyldt: Boolsk, fradragsberettiget: Boolsk, hjemmel: Pbl49Til49BHjemmel, fradrag_kroner: Heltal)
# Pbl49Til49BÅrsresultat(indkomstår: Heltal, input: Pbl49Til49BÅrsinput, bidragsresultater: List(Pbl49Til49BBidragsresultat), skatteår_understøttet: Boolsk, identifikationer_entydige: Boolsk, alle_input_gyldige: Boolsk, akassemedlemskab_indbetalt_kroner: Heltal, samlet_fradrag_kroner: Heltal, ikke_fradraget_kroner: Heltal)

| pbl49_skatteår_understøttet(indkomstår: Heltal) -> indkomstår == 2025 || indkomstår == 2026
| pbl49_arbejdsløshedskasse_opfyldt(status: Pbl49ArbejdsløshedskasseStatus) -> status != Pbl49IkkeArbejdsløshedskasse
| pbl49_stk3_akassemedlemskab_opfyldt(status: Pbl49ArbejdsløshedskasseStatus) -> status == Pbl49DanskAnerkendtArbejdsløshedskasse || status == Pbl49EUEØSArbejdsløshedskasseAnerkendtEfterArbejdsløshedsforsikringslov32 || status == Pbl49ArbejdsløshedskasseUdenForEUEØS
| pbl49_relevant_dansk_indkomst(indkomstgrundlag: Pbl49DanskIndkomstgrundlag) -> indkomstgrundlag == Pbl49Kildeskattelov2Stk1Nr1Eller4 || indkomstgrundlag == Pbl49Kildeskattelov2Stk1Nr12Dagpenge
| pbl49_skattepligtsbetingelse_opfyldt(position: Pbl49Skattepligtsposition) -> match position {
    | Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark -> Sandt
    | Pbl49GrænsegængerEfterKildeskattelovensPar5ATil5D -> Sandt
    | Pbl49BegrænsetSkattepligtig(indkomstgrundlag, udgiften_kan_fradrages_i_udlandet) -> pbl49_relevant_dansk_indkomst(indkomstgrundlag) && udgiften_kan_fradrages_i_udlandet == Falskt
    | Pbl49FuldtSkattepligtigMenDobbeltbeskatningshjemmehørendeIUdlandet(indkomstgrundlag, udgiften_kan_fradrages_i_udlandet) -> pbl49_relevant_dansk_indkomst(indkomstgrundlag) && udgiften_kan_fradrages_i_udlandet == Falskt
}
| pbl49_bidrag_er_stk3_akassemedlemskab(fakta: Pbl49Til49BBidragsfakta) -> match fakta.art { | Pbl49Akassekontingent(arbejdsløshedskasse, skatteyderen_er_medlem_og_forsikret) -> skatteyderen_er_medlem_og_forsikret && pbl49_stk3_akassemedlemskab_opfyldt(arbejdsløshedskasse) | _ -> Falskt }
| pbl49_akassemedlemskab_indbetalt_kroner(bidrag: List(Pbl49Til49BBidragsfakta), indkomstår: Heltal) -> foldl(bidrag, 0, |sum_kroner: Heltal, fakta: Pbl49Til49BBidragsfakta| sum_kroner + hvis fakta.indkomstår == indkomstår && fakta.betalt_beløb_kroner > 0 && pbl49_bidrag_er_stk3_akassemedlemskab(fakta) { fakta.betalt_beløb_kroner } ellers { 0 })
--@end::pensionsbeskatningsloven_par49_fradrag--

