--@label:pensionsbeskatningsloven_par49a_efterloensfradrag::meta:pensionsbeskatningsloven_par49a_metadata--
----
§ 49 A. Ved opgørelsen af den skattepligtige indkomst for et medlem af en
arbejdsløshedskasse kan der fradrages udgifter til bidrag til
efterlønsordningen, jf. lov om arbejdsløshedsforsikring m.v. § 77, stk. 4.
----

--@begin::pensionsbeskatningsloven_par49a_efterloensfradrag--
| pbl49a_ordningsbetingelser_opfyldt(art: Pbl49Til49BBidragsart) -> match art {
    | Pbl49AEfterlønsbidrag(arbejdsløshedskasse, medlem_af_arbejdsløshedskasse, bidrag_efter_arbejdsløshedsforsikringslov77_stk4) -> pbl49_arbejdsløshedskasse_opfyldt(arbejdsløshedskasse) && medlem_af_arbejdsløshedskasse && bidrag_efter_arbejdsløshedsforsikringslov77_stk4
    | _ -> Falskt
}
--@end::pensionsbeskatningsloven_par49a_efterloensfradrag--

= pensionsbeskatningsloven_lbk1243_par49b = Pbl49KildeInfo(
