)

--@label:pensionsbeskatningsloven_par49b_fleksydelsesfradrag::meta:pensionsbeskatningsloven_par49b_metadata--
----
§ 49 B. Ved opgørelsen af den skattepligtige indkomst kan en person, der er
tilmeldt fleksydelsesordningen, jf. lov om fleksydelse § 4, fradrage udgifter til
bidrag til fleksydelsesordningen, jf. lov om fleksydelse § 7.
----

--@begin::pensionsbeskatningsloven_par49b_fleksydelsesfradrag--
| pbl49b_ordningsbetingelser_opfyldt(art: Pbl49Til49BBidragsart) -> match art {
    | Pbl49BFleksydelsesbidrag(tilmeldt_fleksydelsesordningen_efter_fleksydelseslov4, bidrag_efter_fleksydelseslov7) -> tilmeldt_fleksydelsesordningen_efter_fleksydelseslov4 && bidrag_efter_fleksydelseslov7
    | _ -> Falskt
}
--@end::pensionsbeskatningsloven_par49b_fleksydelsesfradrag--

