@ sprog da

@ importer ./metadata

# PersonskatFolkepensionKilde(url: Tekst, identifier: Tekst, hentet_dato: Tekst)
= personskat_folkepension_skat_kilde = PersonskatFolkepensionKilde(url = "https://info.skat.dk/data.aspx?oid=1976824", identifier = "DJV C.A.3.6.5: folkepension, pensionstillæg og supplerende pensionsydelse er skattepligtige", hentet_dato = "2026-09-25")
= personskat_folkepension_personlig_kilde = PersonskatFolkepensionKilde(url = "https://info.skat.dk/data.aspx?oid=2061678", identifier = "DJV C.A.2.2.1 / PSL § 3: sociale pensionsindtægter er personlig indkomst", hentet_dato = "2026-09-25")
= personskat_folkepension_fritagelse_kilde = PersonskatFolkepensionKilde(url = "https://www.retsinformation.dk/eli/lta/2025/1500", identifier = "LL § 7, nr. 8: personlige tillæg og helbredstillæg efter lov om social pension; § 9 C, stk. 4 og § 9 L, stk. 2 afgrænser fradragsgrundlagene", hentet_dato = "2026-09-25")
= personskat_folkepension_tillæg_kilde = PersonskatFolkepensionKilde(url = "https://www.retsinformation.dk/eli/lta/2024/1123", identifier = "Lov om social pension §§ 12–14 a og 72 d: grundbeløb, pensionstillæg, personligt tillæg, varmetillæg, helbredstillæg og ældrecheck", hentet_dato = "2026-09-25")
= personskat_folkepension_am_kilde = PersonskatFolkepensionKilde(url = "https://skat.dk/borger/am-bidrag", identifier = "Pension er ikke AM-bidragspligtig", hentet_dato = "2026-09-25")
= personskat_folkepension_metadata = Metadata(attachments = (Guidance(value = personskat_folkepension_skat_kilde), Guidance(value = personskat_folkepension_personlig_kilde), Source(value = personskat_folkepension_fritagelse_kilde), Source(value = personskat_folkepension_tillæg_kilde), Guidance(value = personskat_folkepension_am_kilde)))

--@label:personskat_folkepension::meta:personskat_folkepension_metadata--
----
Ældrechecken er skattepligtig indkomst.
----
-- DJV C.A.3.6.5. Personligt tillæg (herunder varme) og helbredstillæg
-- efter socialpensionsloven er derimod fritaget efter LL § 7, nr. 8.
-- Kun ordinære danske beløb til modtageren: ingen afgørelse om ret, sats,
-- indtægtsregulering, opsat pension, udland, tilbagebetaling eller omperiodisering.
-- Ingen ATP-/privatpensionsudbetalinger eller ydelser efter andre pensionslove.
-- De dækkede beløb er hverken arbejdsindkomst efter LL §§ 9 J–9 K,
-- LL § 9 C-aftrapningsindkomst eller PBL § 20-udbetalinger til LL § 9 L.
--@begin:personskat_folkepension--
# PersonskatFolkepensionArt = FolkepensionsartUoplystEllerUdenForModellen | FolkepensionGrundbeløb | FolkepensionPensionstillæg | FolkepensionÆldrecheck | FolkepensionPersonligtTillægEfterPar14 | FolkepensionVarmetillægEfterPar14 | FolkepensionHelbredstillægEfterPar14A
# PersonskatFolkepensionFakta(identifikation: Tekst, indkomstår: Heltal, kildereference: Tekst, art: PersonskatFolkepensionArt, beløb_før_skat_kroner: Heltal, ordinær_dansk_udbetaling_uden_korrektioner: Boolsk)
# PersonskatFolkepensionResultat(fakta: PersonskatFolkepensionFakta, input_gyldigt: Boolsk, personlig_indkomst_uden_am_kroner: Heltal, skattefrit_tillæg_kroner: Heltal, ll9c_aftrapningsindkomst_kroner: Option(Heltal))

| personskat_folkepension_input_gyldigt(fakta: PersonskatFolkepensionFakta) -> trim(fakta.identifikation) != "" && trim(fakta.kildereference) != "" && fakta.indkomstår >= 2023 && fakta.indkomstår <= 2026 && fakta.beløb_før_skat_kroner >= 0 && fakta.ordinær_dansk_udbetaling_uden_korrektioner && fakta.art != FolkepensionsartUoplystEllerUdenForModellen
| personskat_folkepension_art_skattepligtig(art: PersonskatFolkepensionArt) -> match art {
    | FolkepensionGrundbeløb -> Sandt
    | FolkepensionPensionstillæg -> Sandt
    | FolkepensionÆldrecheck -> Sandt
    | FolkepensionPersonligtTillægEfterPar14 -> Falskt
    | FolkepensionVarmetillægEfterPar14 -> Falskt
    | FolkepensionHelbredstillægEfterPar14A -> Falskt
    | FolkepensionsartUoplystEllerUdenForModellen -> Falskt
}
| personskat_folkepension_resultat(fakta: PersonskatFolkepensionFakta) -> PersonskatFolkepensionResultat(
    fakta = fakta,
    input_gyldigt = personskat_folkepension_input_gyldigt(fakta),
    personlig_indkomst_uden_am_kroner = hvis personskat_folkepension_input_gyldigt(fakta) && personskat_folkepension_art_skattepligtig(fakta.art) { fakta.beløb_før_skat_kroner } ellers { 0 },
    skattefrit_tillæg_kroner = hvis personskat_folkepension_input_gyldigt(fakta) && personskat_folkepension_art_skattepligtig(fakta.art) == Falskt { fakta.beløb_før_skat_kroner } ellers { 0 },
    ll9c_aftrapningsindkomst_kroner = hvis personskat_folkepension_input_gyldigt(fakta) { Some(0) } ellers { None }
)
--@end:personskat_folkepension--

= personskat_folkepension_felter = TypetBeregningsmeta(
    felter = [
        TypetBeregningsfelt(path = refof(PersonskatFolkepensionFakta::identifikation), label = "Folkepensionspostens identifikation", question = Some("Hvilken entydig identifikation har denne post?"), help = Some("Opdel beløb efter ydelsesart. En samlet udbetaling og dens bestanddele må ikke tælles to gange."), unit = None),
        TypetBeregningsfelt(path = refof(PersonskatFolkepensionFakta::indkomstår), label = "Udbetalingens indkomstår", question = Some("I hvilket indkomstår blev det ordinære beløb udbetalt?"), help = Some("2023–2026. Brug udbetalingsoplysningerne; tidligere år, tilbagebetaling og omkontering kræver særskilt behandling."), unit = Some("år")),
        TypetBeregningsfelt(path = refof(PersonskatFolkepensionFakta::kildereference), label = "Kilde til folkepensionsposten", question = Some("Hvilken pensionsmeddelelse eller tillægsafgørelse dokumenterer art, modtager og beløb?"), help = Some("En lokal reference er nok; ikke CPR. Brug ikke en restdifference i årsopgørelsen som uafhængig kilde."), unit = None),
        TypetBeregningsfelt(path = refof(PersonskatFolkepensionFakta::art::$variant), label = "Folkepension eller særskilt tillæg", question = Some("Er dette grundbeløb, pensionstillæg, ældrecheck, personligt tillæg, varmetillæg eller helbredstillæg efter socialpensionsloven?"), help = Some("Pensionstillæg og ældrecheck er skattepligtige; personligt tillæg, varme og helbred efter de angivne paragraffer er skattefri. Ordene tillæg eller pension alene afgør ikke grenen. Privat pension, ATP-udbetaling, førtids-/seniorpension og opsat pension bruger ikke denne indgang."), unit = None),
        TypetBeregningsfelt(path = refof(PersonskatFolkepensionFakta::beløb_før_skat_kroner), label = "Årets udbetaling før skat", question = Some("Hvad er årets dokumenterede beløb før A-skat for netop denne ydelsesart?"), help = Some("Ikke månedsbeløbet eller bankens nettobeløb. Skattefri tillæg står særskilt med det faktisk ydede beløb. Indsæt ikke en maksimal pensionssats i stedet for din udbetaling."), unit = Some("kr./år")),
        TypetBeregningsfelt(path = refof(PersonskatFolkepensionFakta::ordinær_dansk_udbetaling_uden_korrektioner), label = "Ordinær dansk folkepensionspost afklaret", question = Some("Er dette afklaret som ordinær dansk folkepension eller dækket tillæg, uden udland, opsat pension, efterlevelsespension, tilbagebetaling eller omperiodisering?"), help = Some("Bekræft kun efter gennemgang. Falsk bevarer sagen som uafklaret/uden for modellen. Folkepensionens størrelse eller ret til tillæg beregnes ikke her."), unit = None)
    ],
    spørgsmål = [],
    beløbsfelter = [],
    attachments = (Guidance(value = personskat_folkepension_skat_kilde), Guidance(value = personskat_folkepension_personlig_kilde), Source(value = personskat_folkepension_fritagelse_kilde), Source(value = personskat_folkepension_tillæg_kilde), Guidance(value = personskat_folkepension_am_kilde))
)
--@label:PersonskatFolkepensionFakta::meta:personskat_folkepension_felter--
