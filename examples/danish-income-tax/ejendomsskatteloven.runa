# EjendomsskattelovRabatÅrsresultat(kapabilitet: EjendomsskattelovRegelkapabilitet, input_gyldigt: Boolsk, par15_og_par42_perioder_konsistente: Boolsk, eget_grundlag_2024: Option(EjendomsskattelovRabat2024Resultat), rabat_ejendomsværdiskat_før_par41_stk3_øre: Heltal, rabat_grundskyld_før_par41_stk3_øre: Heltal, rabat_ejendomsværdiskat_øre: Heltal, rabat_grundskyld_øre: Heltal, samlet_rabat_øre: Heltal)
# EjendomsskattelovRabatBeløbstilstand(identifikation: Tekst, ejerandel_basispoint: Heltal, rabat_ejendomsværdiskat_helår_øre: Heltal, rabat_grundskyld_helår_øre: Heltal, kan_tjene_til_bolig_for_ejeren: Boolsk, kapabilitet: EjendomsskattelovRegelkapabilitet, input_gyldigt: Boolsk)
# EjendomsskattelovRabatHændelsesvalidering(seneste_dato: EjendomsskattelovDato, input_gyldigt: Boolsk)
# EjendomsskattelovRabatÅrsakkumulator(seneste_dato: EjendomsskattelovDato, seneste_dag_i_indkomståret: Heltal, beløb: EjendomsskattelovRabatBeløbstilstand, akkumuleret_ejendomsværdiskat_øre_dage: Heltal, akkumuleret_grundskyld_øre_dage: Heltal)

| ejendomsskattelov_ejerskabstilstand_ved_dato(historik: EjendomsskattelovEjerskabshistorik, dato: EjendomsskattelovDato) -> foldl(
    filter(historik.ejerskifter, |ejerskifte: EjendomsskattelovEjerskifte| ejendomsskattelov_dato_før_eller_lig_med(ejerskifte.dato, dato)),
    EjendomsskattelovEjerskabstilstand(
        seneste_dato = historik.oprindelig_erhvervelsesdato,
        input_gyldigt = ejendomsskattelov_dato_gyldig(historik.oprindelig_erhvervelsesdato),
        ret_til_par23_og_par24 = ejendomsskattelov_dato_gyldig(historik.oprindelig_erhvervelsesdato) && ejendomsskattelov_dato_før_eller_lig_med(historik.oprindelig_erhvervelsesdato, EjendomsskattelovDato(år = 1998, måned = 7, dag = 1)),
        ret_til_overgangsrabat = ejendomsskattelov_dato_gyldig(historik.oprindelig_erhvervelsesdato) && ejendomsskattelov_dato_før_eller_lig_med(historik.oprindelig_erhvervelsesdato, EjendomsskattelovDato(år = 2023, måned = 12, dag = 31))
    ),
    ejendomsskattelov_ejerskabstrin
)
| ejendomsskattelov_heltal_option_ikke_negativt(værdi: Option(Heltal)) -> match værdi {
    | None -> Sandt
    | Some(beløb) -> beløb >= 0
}
| ejendomsskattelov_byggeri_ved_overgang_input_gyldigt(byggeri: EjendomsskattelovByggeriVedOvergang) -> match byggeri {
    | EjskIngenNyEllerOmbygning -> Sandt
    | EjskNybygningVedOvergang(None, _) -> Sandt
    | EjskNybygningVedOvergang(Some(dato), _) -> ejendomsskattelov_dato_gyldig(dato)
    | EjskOmbygningVedOvergang(None, _, _) -> Sandt
    | EjskOmbygningVedOvergang(Some(dato), _, _) -> ejendomsskattelov_dato_gyldig(dato)
}
| ejendomsskattelov_par36_byggeri_berettiget(byggeri: EjendomsskattelovByggeriVedOvergang) -> match byggeri {
    | EjskIngenNyEllerOmbygning -> Sandt
    | EjskNybygningVedOvergang(None, _) -> Falskt
    | EjskNybygningVedOvergang(Some(dato), underkendt) -> underkendt == Falskt && ejendomsskattelov_dato_før_eller_lig_med(dato, EjendomsskattelovDato(år = 2024, måned = 1, dag = 1))
    | EjskOmbygningVedOvergang(None, underkendt, før_ombygning) -> underkendt == Falskt && før_ombygning
    | EjskOmbygningVedOvergang(Some(dato), underkendt, før_ombygning) -> underkendt == Falskt && (ejendomsskattelov_dato_før_eller_lig_med(dato, EjendomsskattelovDato(år = 2024, måned = 1, dag = 1)) || før_ombygning)
}
| ejendomsskattelov_evsl_historiske_begrænsningsfakta_gyldige(fakta: EjendomsskattelovEvslHistoriskeBegrænsningsfakta) -> ejendomsskattelov_heltal_option_ikke_negativt(fakta.foregående_indkomstårs_ejendomsværdiskat_øre) && fakta.par9b_nedsættelse_øre >= 0
| ejendomsskattelov_tidligere_ejendomsværdiskat_2024_fakta_gyldige(fakta: EjendomsskattelovTidligereEjendomsværdiskat2024Fakta) -> fakta.ejendomsværdi_året_før_kroner >= 0 && fakta.ejendomsværdi_2001_kroner >= 0 && fakta.ejendomsværdi_2002_kroner >= 0 && ejendomsskattelov_evsl_historiske_begrænsningsfakta_gyldige(fakta.historisk_begrænsning) && ejendomsskattelov_udenlandske_ejendomsskatter_gyldige(fakta.udenlandske_ejendomsskatter)
| ejendomsskattelov_tidligere_grundskyld_2024_fakta_gyldige(fakta: EjendomsskattelovTidligereGrundskyld2024Fakta) -> fakta.grundværdi_efter_fradrag_og_fritagelser_kroner >= 0 && fakta.foregående_års_afgiftspligtige_grundværdi_kroner >= 0 && fakta.grundskyld_promille_2023_tiendedele >= 0
| ejendomsskattelov_rabat_2024_helårsgrundlag_gyldigt(fakta: EjendomsskattelovRabat2024Fakta) -> fakta.kontekst_2024.indkomstår == 2024 && fakta.ny_lov_helårsgrundlag.ejendomsværdiskatteperiode == HeleEjendomsskatteåret && fakta.ny_lov_helårsgrundlag.grundskyldsperiode == HeleEjendomsskatteåret
| ejendomsskattelov_rabat_2024_fakta_gyldige(fakta: EjendomsskattelovRabat2024Fakta) -> ejendomsskattelov_rabat_2024_helårsgrundlag_gyldigt(fakta) && ejendomsskattelov_person_årskontekst_gyldig(fakta.kontekst_2024) && ejendomsskattelov_nedslagsfakta_gyldige(fakta.ny_lov_nedslagsfakta) && ejendomsskattelov_tidligere_ejendomsværdiskat_2024_fakta_gyldige(fakta.tidligere_ejendomsværdiskat) && ejendomsskattelov_tidligere_grundskyld_2024_fakta_gyldige(fakta.tidligere_grundskyld) && ejendomsskattelov_byggeri_ved_overgang_input_gyldigt(fakta.byggeri) && fakta.grundskyld_fritaget_basispoint >= 0 && fakta.grundskyld_fritaget_basispoint <= 10000

| ejendomsskattelov_evsl_par4a_beregningsgrundlag_kroner(fakta: EjendomsskattelovTidligereEjendomsværdiskat2024Fakta) -> penge_mindste_beløb(fakta.ejendomsværdi_året_før_kroner * 80 / 100, penge_mindste_beløb(fakta.ejendomsværdi_2001_kroner * 105 / 100, fakta.ejendomsværdi_2002_kroner))
| ejendomsskattelov_evsl_par5_skat_før_nedslag_øre(grundlag_kroner: Heltal, ejerandel_basispoint: Heltal) -> penge_øre_nedrundet((penge_mindste_beløb(grundlag_kroner, 3040000) * 92 + penge_positivt_beløb(grundlag_kroner - 3040000) * 300) * ejerandel_basispoint, 100 * 10000)
| ejendomsskattelov_evsl_par6_nedslag_øre(grundlag_kroner: Heltal, ejerandel_basispoint: Heltal, berettiget: Boolsk) -> hvis berettiget { penge_øre_nedrundet(grundlag_kroner * 18 * ejerandel_basispoint, 100 * 10000) } ellers { 0 }
| ejendomsskattelov_evsl_par7_nedslag_øre(grundlag_kroner: Heltal, ejerandel_basispoint: Heltal, nedslagsfakta: EjendomsskattelovNedslagsfakta, berettiget: Boolsk) -> hvis berettiget { penge_øre_nedrundet(penge_mindste_beløb(penge_øre_nedrundet(grundlag_kroner * 37, 100), 120000 * nedslagsfakta.selvstændige_boligenheder) * ejerandel_basispoint, 10000) } ellers { 0 }
| ejendomsskattelov_evsl_par8_nedslag_før_par10_øre(grundlag_kroner: Heltal, ejerandel_basispoint: Heltal, nedslagsfakta: EjendomsskattelovNedslagsfakta, berettiget: Boolsk) -> hvis berettiget { penge_øre_nedrundet(penge_mindste_beløb(penge_øre_nedrundet(grundlag_kroner * 37, 100), ejendomsskattelov_par25_helårsloft_øre(nedslagsfakta)) * ejerandel_basispoint, 10000) } ellers { 0 }
| ejendomsskattelov_evsl_par9_eller_par9a_betingelser_opfyldt(fakta: EjendomsskattelovEvslHistoriskeBegrænsningsfakta) -> fakta.vurderet_helt_eller_delvis_benyttet_til_ejerbolig && fakta.ejerlejlighed_frigjort_for_lejemål == Falskt && fakta.ombygning_over_100_procent == Falskt
| ejendomsskattelov_evsl_par9_begrænset_skat_øre(skat_øre: Heltal, foregående_skat_øre: Heltal) -> penge_største_beløb(penge_mindste_beløb(skat_øre, foregående_skat_øre + 50000), penge_positivt_beløb(foregående_skat_øre * 120 / 100 - 90000))
| ejendomsskattelov_evsl_par9a_begrænset_skat_øre(skat_øre: Heltal, foregående_skat_øre: Heltal) -> penge_største_beløb(penge_mindste_beløb(skat_øre, foregående_skat_øre + 240000), foregående_skat_øre * 120 / 100)
| ejendomsskattelov_evsl_historisk_begrænset_skat_øre(skat_efter_par9b_øre: Heltal, pensionist: Boolsk, fakta: EjendomsskattelovEvslHistoriskeBegrænsningsfakta) -> match fakta.foregående_indkomstårs_ejendomsværdiskat_øre {
    | None -> skat_efter_par9b_øre
    | Some(foregående_skat_øre) -> hvis ejendomsskattelov_evsl_par9_eller_par9a_betingelser_opfyldt(fakta) { hvis pensionist { ejendomsskattelov_evsl_par9_begrænset_skat_øre(skat_efter_par9b_øre, foregående_skat_øre) } ellers { ejendomsskattelov_evsl_par9a_begrænset_skat_øre(skat_efter_par9b_øre, foregående_skat_øre) } } ellers { skat_efter_par9b_øre }
}
| ejendomsskattelov_tidligere_ejendomsværdiskat_2024_resultat(fakta: EjendomsskattelovRabat2024Fakta) -> {
    = input_gyldigt = ejendomsskattelov_rabat_2024_fakta_gyldige(fakta)
    = ejerandel_basispoint = fakta.ny_lov_helårsgrundlag.ejerandel_basispoint
    = ejerskab_2024 = ejendomsskattelov_ejerskabstilstand_ved_dato(fakta.ny_lov_nedslagsfakta.ejerskabshistorik, EjendomsskattelovDato(år = 2024, måned = 1, dag = 1))
    = beregningsgrundlag_kroner = ejendomsskattelov_evsl_par4a_beregningsgrundlag_kroner(fakta.tidligere_ejendomsværdiskat)
    = skat_før_nedslag_øre = ejendomsskattelov_evsl_par5_skat_før_nedslag_øre(beregningsgrundlag_kroner, ejerandel_basispoint)
    = par6_berettiget = ejerskab_2024.ret_til_par23_og_par24
    = par7_berettiget = par6_berettiget && ejendomsskattelov_par24_kategori_omfattet(ejendomsskattelov_par3_hjemmel(fakta.ny_lov_helårsgrundlag.kategori, 2024)) && fakta.ny_lov_nedslagsfakta.ejendomsform == EjskIkkeEjerlejlighed && fakta.ny_lov_nedslagsfakta.fredet_og_omfattet_af_ligningslovens_par15k == Falskt
    = pensionist = ejendomsskattelov_par25_pensionsbetingelse_opfyldt(fakta.kontekst_2024, fakta.ny_lov_nedslagsfakta.pensionistsuccession) && ejendomsskattelov_par25_hjemsted_betingelser_opfyldt(fakta.kontekst_2024.kildefakta.skattemæssigt_hjemsted)
    = par6_nedslag_øre = ejendomsskattelov_evsl_par6_nedslag_øre(beregningsgrundlag_kroner, ejerandel_basispoint, par6_berettiget)
    = par7_nedslag_øre = ejendomsskattelov_evsl_par7_nedslag_øre(beregningsgrundlag_kroner, ejerandel_basispoint, fakta.ny_lov_nedslagsfakta, par7_berettiget)
    = par8_nedslag_før_par10_øre = ejendomsskattelov_evsl_par8_nedslag_før_par10_øre(beregningsgrundlag_kroner, ejerandel_basispoint, fakta.ny_lov_nedslagsfakta, pensionist)
    = par10_reduktion_øre = hvis pensionist { penge_mindste_beløb(par8_nedslag_før_par10_øre, ejendomsskattelov_par26_overskydende_indkomst_kroner(fakta.kontekst_2024) * 5) } ellers { 0 }
    = skat_før_historisk_begrænsning_øre = penge_positivt_beløb(skat_før_nedslag_øre - par6_nedslag_øre - par7_nedslag_øre - par8_nedslag_før_par10_øre - fakta.tidligere_ejendomsværdiskat.historisk_begrænsning.par9b_nedsættelse_øre)
    = par9_eller_par9a_begrænset_skat_øre = ejendomsskattelov_evsl_historisk_begrænset_skat_øre(skat_før_historisk_begrænsning_øre, pensionist, fakta.tidligere_ejendomsværdiskat.historisk_begrænsning)
    = skat_efter_par10_øre = penge_mindste_beløb(penge_positivt_beløb(skat_før_nedslag_øre - par6_nedslag_øre - par7_nedslag_øre), par9_eller_par9a_begrænset_skat_øre + par10_reduktion_øre)
    = udenlandsk_skat_øre = hvis fakta.ny_lov_helårsgrundlag.beliggenhed == EjskUdlandFaeroerneGroenland { penge_mindste_beløb(skat_efter_par10_øre, ejendomsskattelov_par27_kvalificerende_udenlandsk_skat_øre(fakta.tidligere_ejendomsværdiskat.udenlandske_ejendomsskatter)) } ellers { 0 }
    = skat_før_historisk_begrænsning_til_forskelsbeløb_øre = penge_positivt_beløb(skat_før_nedslag_øre - par6_nedslag_øre - par7_nedslag_øre - fakta.tidligere_ejendomsværdiskat.historisk_begrænsning.par9b_nedsættelse_øre)
    = historisk_begrænset_skat_til_forskelsbeløb_øre = ejendomsskattelov_evsl_historisk_begrænset_skat_øre(skat_før_historisk_begrænsning_til_forskelsbeløb_øre, pensionist, fakta.tidligere_ejendomsværdiskat.historisk_begrænsning)
    = skat_til_forskelsbeløb_før_udenlandsk_skat_øre = penge_mindste_beløb(penge_positivt_beløb(skat_før_nedslag_øre - par6_nedslag_øre - par7_nedslag_øre), historisk_begrænset_skat_til_forskelsbeløb_øre)
    = udenlandsk_skat_til_forskelsbeløb_øre = hvis fakta.ny_lov_helårsgrundlag.beliggenhed == EjskUdlandFaeroerneGroenland { penge_mindste_beløb(skat_til_forskelsbeløb_før_udenlandsk_skat_øre, ejendomsskattelov_par27_kvalificerende_udenlandsk_skat_øre(fakta.tidligere_ejendomsværdiskat.udenlandske_ejendomsskatter)) } ellers { 0 }
    EjendomsskattelovTidligereEjendomsværdiskat2024Resultat(
        input_gyldigt = input_gyldigt,
        beregningsgrundlag_kroner = beregningsgrundlag_kroner,
        skat_før_nedslag_øre = skat_før_nedslag_øre,
        par6_nedslag_øre = par6_nedslag_øre,
        par7_nedslag_øre = par7_nedslag_øre,
        par8_nedslag_før_par10_øre = par8_nedslag_før_par10_øre,
        par10_reduktion_øre = par10_reduktion_øre,
        par9_eller_par9a_begrænset_skat_øre = par9_eller_par9a_begrænset_skat_øre,
        par9b_nedsættelse_øre = fakta.tidligere_ejendomsværdiskat.historisk_begrænsning.par9b_nedsættelse_øre,
        udenlandsk_skat_øre = udenlandsk_skat_øre,
        skat_øre = hvis input_gyldigt { penge_positivt_beløb(skat_efter_par10_øre - udenlandsk_skat_øre) } ellers { 0 },
        skat_til_forskelsbeløb_øre = hvis input_gyldigt { penge_positivt_beløb(skat_til_forskelsbeløb_før_udenlandsk_skat_øre - udenlandsk_skat_til_forskelsbeløb_øre) } ellers { 0 }
    )
}
| ejendomsskattelov_tidligere_grundskyld_2024_beskatningsgrundlag_kroner(fakta: EjendomsskattelovTidligereGrundskyld2024Fakta) -> {
    = loftsværdi_kroner = fakta.foregående_års_afgiftspligtige_grundværdi_kroner * 1028 / 1000
    penge_mindste_beløb(fakta.grundværdi_efter_fradrag_og_fritagelser_kroner, loftsværdi_kroner)
}
| ejendomsskattelov_tidligere_grundskyld_2024_øre(fakta: EjendomsskattelovRabat2024Fakta) -> penge_øre_nedrundet(ejendomsskattelov_tidligere_grundskyld_2024_beskatningsgrundlag_kroner(fakta.tidligere_grundskyld) * fakta.tidligere_grundskyld.grundskyld_promille_2023_tiendedele * fakta.ny_lov_helårsgrundlag.ejerandel_basispoint, 100 * 10000)

| ejendomsskattelov_par36_berettiget(fakta: EjendomsskattelovRabat2024Fakta, ny_nedslag: EjendomsskattelovNedslagResultat) -> ejendomsskattelov_ejerskabstilstand_ved_dato(fakta.ny_lov_nedslagsfakta.ejerskabshistorik, EjendomsskattelovDato(år = 2023, måned = 12, dag = 31)).ret_til_overgangsrabat && ny_nedslag.skat_før_nedslag_øre >= 0 && ejendomsskattelov_par3_stk1_hjemmel_findes(ejendomsskattelov_par3_hjemmel(fakta.ny_lov_helårsgrundlag.kategori, 2024)) && ejendomsskattelov_par36_byggeri_berettiget(fakta.byggeri)
| ejendomsskattelov_par38_vurderingskategori_omfattet(kategori: EjendomsskattelovVurderingskategori) -> kategori == EjskEjerboligEfterEjendomsvurderingslovensPar3Stk1Nr1 || kategori == EjskBoligdelEfterEjendomsskattelovensPar3Stk1Nr3Eller4
| ejendomsskattelov_par38_ejerkreds_omfattet(ejerkreds: EjendomsskattelovEjerkreds) -> ejerkreds == EjskKunFysiskeEjere || ejerkreds == EjskFysiskEjerSammenMedDødsbo
| ejendomsskattelov_par38_berettiget(omfang: EjendomsskattelovOvergangsomfang, fakta: EjendomsskattelovRabat2024Fakta) -> ejendomsskattelov_ejerskabstilstand_ved_dato(fakta.ny_lov_nedslagsfakta.ejerskabshistorik, EjendomsskattelovDato(år = 2023, måned = 12, dag = 31)).ret_til_overgangsrabat && ejendomsskattelov_par38_vurderingskategori_omfattet(omfang.vurderingskategori) && ejendomsskattelov_par38_ejerkreds_omfattet(omfang.ejerkreds) && fakta.grundskyld_fritaget_basispoint < 10000
| ejendomsskattelov_par39_ny_grundskyld_øre(fakta: EjendomsskattelovRabat2024Fakta, ny_ordinær: EjendomsskattelovOrdinærPersonEjendomResultat) -> penge_øre_nedrundet(
    ny_ordinær.grundskyld.beskatningsgrundlag_kroner * ny_ordinær.grundskyld.grundskyld_promille_tiendedele * ny_ordinær.grundskyld.ejerandel_basispoint * (10000 - fakta.grundskyld_fritaget_basispoint),
    100 * 10000 * 10000
)
| ejendomsskattelov_par40_rabat_ejendomsværdiskat_øre(forskelsbeløb_ejendomsværdiskat_øre: Heltal, forskelsbeløb_grundskyld_øre: Heltal, tværgående_opgørelse: Boolsk, berettiget: Boolsk) -> hvis berettiget { hvis tværgående_opgørelse { penge_positivt_beløb(forskelsbeløb_ejendomsværdiskat_øre + penge_mindste_beløb(forskelsbeløb_grundskyld_øre, 0)) } ellers { penge_positivt_beløb(forskelsbeløb_ejendomsværdiskat_øre) } } ellers { 0 }
| ejendomsskattelov_par40_rabat_grundskyld_øre(forskelsbeløb_ejendomsværdiskat_øre: Heltal, forskelsbeløb_grundskyld_øre: Heltal, tværgående_opgørelse: Boolsk, berettiget: Boolsk) -> hvis berettiget { hvis tværgående_opgørelse { penge_positivt_beløb(forskelsbeløb_grundskyld_øre + penge_mindste_beløb(forskelsbeløb_ejendomsværdiskat_øre, 0)) } ellers { penge_positivt_beløb(forskelsbeløb_grundskyld_øre) } } ellers { 0 }
| ejendomsskattelov_ny_ejendomsværdiskat_til_forskelsbeløb_øre(fakta: EjendomsskattelovRabat2024Fakta, ny_nedslag: EjendomsskattelovNedslagResultat) -> {
    = skat_før_udenlandsk_skat_øre = penge_positivt_beløb(ny_nedslag.skat_før_nedslag_øre - ny_nedslag.par23_nedslag_øre - ny_nedslag.par24_nedslag_øre)
    = udenlandsk_skat_øre = hvis fakta.ny_lov_helårsgrundlag.beliggenhed == EjskUdlandFaeroerneGroenland { penge_mindste_beløb(skat_før_udenlandsk_skat_øre, ejendomsskattelov_par27_kvalificerende_udenlandsk_skat_øre(fakta.ny_lov_nedslagsfakta.udenlandske_ejendomsskatter)) } ellers { 0 }
    penge_positivt_beløb(skat_før_udenlandsk_skat_øre - udenlandsk_skat_øre)
}
| ejendomsskattelov_rabat_2024_resultat(omfang: EjendomsskattelovOvergangsomfang, fakta: EjendomsskattelovRabat2024Fakta) -> {
    = input_gyldigt = ejendomsskattelov_rabat_2024_fakta_gyldige(fakta)
    = ny_ordinær = ejendomsskattelov_ordinær_person_ejendom_resultat(2024, fakta.ny_lov_helårsgrundlag)
    = ny_nedslag = ejendomsskattelov_nedslag_resultat(fakta.kontekst_2024, fakta.ny_lov_helårsgrundlag, fakta.ny_lov_nedslagsfakta)
    = tidligere_ejendomsværdiskat = ejendomsskattelov_tidligere_ejendomsværdiskat_2024_resultat(fakta)
    = par36_berettiget = input_gyldigt && ejendomsskattelov_par36_berettiget(fakta, ny_nedslag)
    = par38_berettiget = input_gyldigt && ejendomsskattelov_par38_berettiget(omfang, fakta)
    = ny_ejendomsværdiskat_øre = hvis par36_berettiget { ejendomsskattelov_ny_ejendomsværdiskat_til_forskelsbeløb_øre(fakta, ny_nedslag) } ellers { 0 }
    = tidligere_ejendomsværdiskat_øre = hvis par36_berettiget { tidligere_ejendomsværdiskat.skat_til_forskelsbeløb_øre } ellers { 0 }
    = forskelsbeløb_ejendomsværdiskat_øre = hvis par36_berettiget { ny_ejendomsværdiskat_øre - tidligere_ejendomsværdiskat_øre } ellers { 0 }
    = ny_grundskyld_øre = hvis par38_berettiget { ejendomsskattelov_par39_ny_grundskyld_øre(fakta, ny_ordinær) } ellers { 0 }
    = tidligere_grundskyld_øre = hvis par38_berettiget { ejendomsskattelov_tidligere_grundskyld_2024_øre(fakta) } ellers { 0 }
    = forskelsbeløb_grundskyld_øre = hvis par38_berettiget { ny_grundskyld_øre - tidligere_grundskyld_øre } ellers { 0 }
    = tværgående_opgørelse = par36_berettiget && par38_berettiget && fakta.grundskyld_kan_fordeles_på_samme_boligenhed
    = rabat_ejendomsværdiskat_øre = ejendomsskattelov_par40_rabat_ejendomsværdiskat_øre(forskelsbeløb_ejendomsværdiskat_øre, forskelsbeløb_grundskyld_øre, tværgående_opgørelse, par36_berettiget)
    = rabat_grundskyld_øre = ejendomsskattelov_par40_rabat_grundskyld_øre(forskelsbeløb_ejendomsværdiskat_øre, forskelsbeløb_grundskyld_øre, tværgående_opgørelse, par38_berettiget)
    = regelgrundlag_understøttet = ny_ordinær.regelgrundlag_understøttet && ejendomsskattelov_kapabilitet_beregnet(ny_nedslag.kapabilitet)
    = kapabilitet = hvis input_gyldigt == Falskt { EjskInputUgyldigt } ellers { hvis par36_berettiget || par38_berettiget { hvis regelgrundlag_understøttet { EjskUnderstøttet } ellers { EjskIkkeUnderstøttet } } ellers { EjskIkkeRelevant } }
    EjendomsskattelovRabat2024Resultat(
        kapabilitet = kapabilitet,
        input_gyldigt = input_gyldigt,
        par36_berettiget = par36_berettiget,
        par38_berettiget = par38_berettiget,
        ny_ejendomsværdiskat_øre = ny_ejendomsværdiskat_øre,
        tidligere_ejendomsværdiskat_øre = tidligere_ejendomsværdiskat_øre,
        forskelsbeløb_ejendomsværdiskat_øre = forskelsbeløb_ejendomsværdiskat_øre,
        ny_grundskyld_øre = ny_grundskyld_øre,
        tidligere_grundskyld_øre = tidligere_grundskyld_øre,
        forskelsbeløb_grundskyld_øre = forskelsbeløb_grundskyld_øre,
        tværgående_opgørelse = tværgående_opgørelse,
        rabat_ejendomsværdiskat_øre = rabat_ejendomsværdiskat_øre,
        rabat_grundskyld_øre = rabat_grundskyld_øre,
        samlet_rabat_øre = rabat_ejendomsværdiskat_øre + rabat_grundskyld_øre
    )
}

| ejendomsskattelov_kombiner_regelkapabilitet(venstre: EjendomsskattelovRegelkapabilitet, højre: EjendomsskattelovRegelkapabilitet) -> hvis venstre == EjskInputUgyldigt || højre == EjskInputUgyldigt { EjskInputUgyldigt } ellers { hvis venstre == EjskManglerKildefakta || højre == EjskManglerKildefakta { EjskManglerKildefakta } ellers { hvis venstre == EjskIkkeUnderstøttet || højre == EjskIkkeUnderstøttet { EjskIkkeUnderstøttet } ellers { hvis venstre == EjskUnderstøttet || højre == EjskUnderstøttet { EjskUnderstøttet } ellers { EjskIkkeRelevant } } } }
| ejendomsskattelov_ægtefælleoverdragelsesgrund_opfyldt(grund: EjendomsskattelovÆgtefælleoverdragelsesgrund) -> match grund {
    | EjskOverdragelseMellemÆgtefæller -> Sandt
    | EjskLængstlevendeOvertagelse(sidder_i_uskiftet_bo, har_overtaget_ejendommen_eller_ejerandelen) -> sidder_i_uskiftet_bo || har_overtaget_ejendommen_eller_ejerandelen
    | EjskSkilsmisseoverdragelse(boet_er_endnu_ikke_delt) -> boet_er_endnu_ikke_delt
}
| ejendomsskattelov_overtaget_rabatgrundlag_input_gyldigt(grundlag: EjendomsskattelovOvertagetRabatgrundlag) -> ejendomsskattelov_rabat_2024_fakta_gyldige(grundlag.rabat_2024)
| ejendomsskattelov_ægtefælleoverdragelsesretning_input_gyldig(retning: EjendomsskattelovÆgtefælleoverdragelsesretning) -> match retning {
    | EjskAfgiverRabatTilÆgtefælle(ny_ejerandel_basispoint) -> ny_ejerandel_basispoint >= 0 && ny_ejerandel_basispoint < 10000
    | EjskModtagerRabatFraÆgtefælle(ny_ejerandel_basispoint, overtaget_rabatgrundlag) -> ny_ejerandel_basispoint > 0 && ny_ejerandel_basispoint <= 10000 && ejendomsskattelov_overtaget_rabatgrundlag_input_gyldigt(overtaget_rabatgrundlag)
}
| ejendomsskattelov_rabathændelse_art_input_gyldig(art: EjendomsskattelovRabatHændelseArt) -> match art {
    | EjskDelvisOverdragelseTilFysiskePersoner(ny_ejerandel_basispoint) -> ny_ejerandel_basispoint > 0 && ny_ejerandel_basispoint < 10000
    | EjskDelvisOverdragelseTilJuridiskePersoner(ny_ejerandel_basispoint) -> ny_ejerandel_basispoint > 0 && ny_ejerandel_basispoint < 10000
    | EjskÆgtefælleoverdragelse(grund, retning) -> ejendomsskattelov_ægtefælleoverdragelsesgrund_opfyldt(grund) && ejendomsskattelov_ægtefælleoverdragelsesretning_input_gyldig(retning)
    | _ -> Sandt
}
| ejendomsskattelov_rabathændelsesvalideringstrin(tilstand: EjendomsskattelovRabatHændelsesvalidering, hændelse: EjendomsskattelovRabatHændelse) -> EjendomsskattelovRabatHændelsesvalidering(
    seneste_dato = hændelse.dato,
    input_gyldigt = tilstand.input_gyldigt && ejendomsskattelov_dato_gyldig(hændelse.dato) && ejendomsskattelov_dato_før_eller_lig_med(tilstand.seneste_dato, hændelse.dato) && ejendomsskattelov_dato_før_eller_lig_med(EjendomsskattelovDato(år = 2024, måned = 1, dag = 1), hændelse.dato) && ejendomsskattelov_rabathændelse_art_input_gyldig(hændelse.art)
)
| ejendomsskattelov_rabathændelser_input_gyldige(hændelser: List(EjendomsskattelovRabatHændelse)) -> foldl(hændelser, EjendomsskattelovRabatHændelsesvalidering(seneste_dato = EjendomsskattelovDato(år = 2024, måned = 1, dag = 1), input_gyldigt = Sandt), ejendomsskattelov_rabathændelsesvalideringstrin).input_gyldigt
| ejendomsskattelov_boligstatus_efter_rabathændelse(kan_tjene_til_bolig_for_ejeren: Boolsk, art: EjendomsskattelovRabatHændelseArt) -> match art {
    | EjskBoligKanIkkeTjeneTilBoligForEjeren -> Falskt
    | EjskBoligKanIgenTjeneTilBoligForEjeren -> Sandt
    | _ -> kan_tjene_til_bolig_for_ejeren
}
| ejendomsskattelov_rabathændelse_har_virkning_senest_på_dag(indkomstår: Heltal, dagnummer: Heltal, hændelse: EjendomsskattelovRabatHændelse) -> hændelse.dato.år < indkomstår || hændelse.dato.år == indkomstår && ejendomsskattelov_par72_dagnummer(hændelse.dato) <= dagnummer
| ejendomsskattelov_boligstatus_på_dag(indkomstår: Heltal, dagnummer: Heltal, hændelser: List(EjendomsskattelovRabatHændelse)) -> foldl(
    filter(hændelser, |hændelse: EjendomsskattelovRabatHændelse| ejendomsskattelov_rabathændelse_har_virkning_senest_på_dag(indkomstår, dagnummer, hændelse)),
    Sandt,
    |kan_tjene_til_bolig_for_ejeren: Boolsk, hændelse: EjendomsskattelovRabatHændelse| ejendomsskattelov_boligstatus_efter_rabathændelse(kan_tjene_til_bolig_for_ejeren, hændelse.art)
)
| ejendomsskattelov_par15_og_par42_perioder_konsistente(indkomstår: Heltal, aktuel_fakta: EjendomsskattelovOrdinærPersonEjendomFakta, hændelser: List(EjendomsskattelovRabatHændelse)) -> ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, aktuel_fakta.ejendomsværdiskatteperiode) && ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, aktuel_fakta.grundskyldsperiode) && all(
    range(1, 361),
    |dagnummer: Heltal| ejendomsskattelov_par72_periode_omfatter_dag(aktuel_fakta.ejendomsværdiskatteperiode, dagnummer) == (ejendomsskattelov_par72_periode_omfatter_dag(aktuel_fakta.grundskyldsperiode, dagnummer) && ejendomsskattelov_boligstatus_på_dag(indkomstår, dagnummer, hændelser))
)
| ejendomsskattelov_eget_rabatgrundlag_2024_resultat(omfang: EjendomsskattelovOvergangsomfang, eget_rabatgrundlag_2024: Option(EjendomsskattelovRabat2024Fakta)) -> match eget_rabatgrundlag_2024 {
    | None -> None
    | Some(fakta) -> Some(ejendomsskattelov_rabat_2024_resultat(omfang, fakta))
}
| ejendomsskattelov_rabat_startbeløb(identifikation: Tekst, omfang: EjendomsskattelovOvergangsomfang, eget_rabatgrundlag_2024: Option(EjendomsskattelovRabat2024Fakta)) -> match eget_rabatgrundlag_2024 {
    | None -> EjendomsskattelovRabatBeløbstilstand(
        identifikation = identifikation,
        ejerandel_basispoint = 0,
        rabat_ejendomsværdiskat_helår_øre = 0,
        rabat_grundskyld_helår_øre = 0,
        kan_tjene_til_bolig_for_ejeren = Sandt,
        kapabilitet = EjskIkkeRelevant,
        input_gyldigt = Sandt
    )
    | Some(fakta) -> {
        = resultat = ejendomsskattelov_rabat_2024_resultat(omfang, fakta)
        EjendomsskattelovRabatBeløbstilstand(
            identifikation = identifikation,
            ejerandel_basispoint = fakta.ny_lov_helårsgrundlag.ejerandel_basispoint,
            rabat_ejendomsværdiskat_helår_øre = resultat.rabat_ejendomsværdiskat_øre,
            rabat_grundskyld_helår_øre = resultat.rabat_grundskyld_øre,
            kan_tjene_til_bolig_for_ejeren = Sandt,
            kapabilitet = resultat.kapabilitet,
            input_gyldigt = resultat.input_gyldigt && fakta.ny_lov_helårsgrundlag.identifikation == identifikation
        )
    }
}
| ejendomsskattelov_rabatbeløb_skaleret(tilstand: EjendomsskattelovRabatBeløbstilstand, ny_ejerandel_basispoint: Heltal, grundskyld_bevares: Boolsk, trin_gyldigt: Boolsk) -> EjendomsskattelovRabatBeløbstilstand(
    identifikation = tilstand.identifikation,
    ejerandel_basispoint = ny_ejerandel_basispoint,
    rabat_ejendomsværdiskat_helår_øre = hvis tilstand.ejerandel_basispoint > 0 { tilstand.rabat_ejendomsværdiskat_helår_øre * ny_ejerandel_basispoint / tilstand.ejerandel_basispoint } ellers { 0 },
    rabat_grundskyld_helår_øre = hvis grundskyld_bevares && tilstand.ejerandel_basispoint > 0 { tilstand.rabat_grundskyld_helår_øre * ny_ejerandel_basispoint / tilstand.ejerandel_basispoint } ellers { 0 },
    kan_tjene_til_bolig_for_ejeren = tilstand.kan_tjene_til_bolig_for_ejeren,
    kapabilitet = tilstand.kapabilitet,
    input_gyldigt = tilstand.input_gyldigt && trin_gyldigt
)
| ejendomsskattelov_rabatbeløb_efter_ægtefælleoverdragelse(tilstand: EjendomsskattelovRabatBeløbstilstand, grund: EjendomsskattelovÆgtefælleoverdragelsesgrund, retning: EjendomsskattelovÆgtefælleoverdragelsesretning) -> match retning {
    | EjskAfgiverRabatTilÆgtefælle(ny_ejerandel_basispoint) -> ejendomsskattelov_rabatbeløb_skaleret(
        tilstand,
        ny_ejerandel_basispoint,
        Sandt,
        ejendomsskattelov_ægtefælleoverdragelsesgrund_opfyldt(grund) && tilstand.ejerandel_basispoint > 0 && ny_ejerandel_basispoint >= 0 && ny_ejerandel_basispoint < tilstand.ejerandel_basispoint
    )
    | EjskModtagerRabatFraÆgtefælle(ny_ejerandel_basispoint, overtaget_rabatgrundlag) -> {
        = overtaget_resultat = ejendomsskattelov_rabat_2024_resultat(overtaget_rabatgrundlag.overgangsomfang, overtaget_rabatgrundlag.rabat_2024)
        = overtaget_ejerandel_basispoint = overtaget_rabatgrundlag.rabat_2024.ny_lov_helårsgrundlag.ejerandel_basispoint
        = trin_gyldigt = ejendomsskattelov_ægtefælleoverdragelsesgrund_opfyldt(grund) && overtaget_resultat.input_gyldigt && overtaget_resultat.kapabilitet == EjskUnderstøttet && overtaget_rabatgrundlag.rabat_2024.ny_lov_helårsgrundlag.identifikation == tilstand.identifikation && ny_ejerandel_basispoint == tilstand.ejerandel_basispoint + overtaget_ejerandel_basispoint && ny_ejerandel_basispoint <= 10000
        EjendomsskattelovRabatBeløbstilstand(
            identifikation = tilstand.identifikation,
            ejerandel_basispoint = ny_ejerandel_basispoint,
            rabat_ejendomsværdiskat_helår_øre = tilstand.rabat_ejendomsværdiskat_helår_øre + overtaget_resultat.rabat_ejendomsværdiskat_øre,
            rabat_grundskyld_helår_øre = tilstand.rabat_grundskyld_helår_øre + overtaget_resultat.rabat_grundskyld_øre,
            kan_tjene_til_bolig_for_ejeren = tilstand.kan_tjene_til_bolig_for_ejeren,
            kapabilitet = ejendomsskattelov_kombiner_regelkapabilitet(tilstand.kapabilitet, overtaget_resultat.kapabilitet),
            input_gyldigt = tilstand.input_gyldigt && trin_gyldigt
        )
    }
}
| ejendomsskattelov_rabatbeløb_med_boligstatus(tilstand: EjendomsskattelovRabatBeløbstilstand, kan_tjene_til_bolig_for_ejeren: Boolsk, trin_gyldigt: Boolsk) -> EjendomsskattelovRabatBeløbstilstand(
    identifikation = tilstand.identifikation,
    ejerandel_basispoint = tilstand.ejerandel_basispoint,
    rabat_ejendomsværdiskat_helår_øre = tilstand.rabat_ejendomsværdiskat_helår_øre,
    rabat_grundskyld_helår_øre = tilstand.rabat_grundskyld_helår_øre,
    kan_tjene_til_bolig_for_ejeren = kan_tjene_til_bolig_for_ejeren,
    kapabilitet = tilstand.kapabilitet,
    input_gyldigt = tilstand.input_gyldigt && trin_gyldigt
)
| ejendomsskattelov_rabatbeløb_efter_hændelse(tilstand: EjendomsskattelovRabatBeløbstilstand, hændelse: EjendomsskattelovRabatHændelse) -> match hændelse.art {
    | EjskDelvisOverdragelseTilFysiskePersoner(ny_ejerandel_basispoint) -> ejendomsskattelov_rabatbeløb_skaleret(tilstand, ny_ejerandel_basispoint, Sandt, ny_ejerandel_basispoint > 0 && ny_ejerandel_basispoint < tilstand.ejerandel_basispoint)
    | EjskDelvisOverdragelseTilJuridiskePersoner(ny_ejerandel_basispoint) -> ejendomsskattelov_rabatbeløb_skaleret(tilstand, ny_ejerandel_basispoint, Falskt, ny_ejerandel_basispoint > 0 && ny_ejerandel_basispoint < tilstand.ejerandel_basispoint)
    | EjskAlmindeligtFuldtEjerskifte -> EjendomsskattelovRabatBeløbstilstand(identifikation = tilstand.identifikation, ejerandel_basispoint = 0, rabat_ejendomsværdiskat_helår_øre = 0, rabat_grundskyld_helår_øre = 0, kan_tjene_til_bolig_for_ejeren = tilstand.kan_tjene_til_bolig_for_ejeren, kapabilitet = tilstand.kapabilitet, input_gyldigt = tilstand.input_gyldigt)
    | EjskÆgtefælleoverdragelse(grund, retning) -> ejendomsskattelov_rabatbeløb_efter_ægtefælleoverdragelse(tilstand, grund, retning)
    | EjskBoligKanIkkeTjeneTilBoligForEjeren -> ejendomsskattelov_rabatbeløb_med_boligstatus(tilstand, Falskt, tilstand.kan_tjene_til_bolig_for_ejeren)
    | EjskBoligKanIgenTjeneTilBoligForEjeren -> ejendomsskattelov_rabatbeløb_med_boligstatus(tilstand, Sandt, tilstand.kan_tjene_til_bolig_for_ejeren == Falskt)
    | EjskBfeNummerBortfalder -> EjendomsskattelovRabatBeløbstilstand(identifikation = tilstand.identifikation, ejerandel_basispoint = tilstand.ejerandel_basispoint, rabat_ejendomsværdiskat_helår_øre = 0, rabat_grundskyld_helår_øre = 0, kan_tjene_til_bolig_for_ejeren = tilstand.kan_tjene_til_bolig_for_ejeren, kapabilitet = tilstand.kapabilitet, input_gyldigt = tilstand.input_gyldigt)
    | EjskIkkeLængereEjendomEfterPar3 -> EjendomsskattelovRabatBeløbstilstand(identifikation = tilstand.identifikation, ejerandel_basispoint = tilstand.ejerandel_basispoint, rabat_ejendomsværdiskat_helår_øre = 0, rabat_grundskyld_helår_øre = tilstand.rabat_grundskyld_helår_øre, kan_tjene_til_bolig_for_ejeren = tilstand.kan_tjene_til_bolig_for_ejeren, kapabilitet = tilstand.kapabilitet, input_gyldigt = tilstand.input_gyldigt)
    | EjskIkkeLængereGrundskyldskategoriEfterPar38 -> EjendomsskattelovRabatBeløbstilstand(identifikation = tilstand.identifikation, ejerandel_basispoint = tilstand.ejerandel_basispoint, rabat_ejendomsværdiskat_helår_øre = tilstand.rabat_ejendomsværdiskat_helår_øre, rabat_grundskyld_helår_øre = 0, kan_tjene_til_bolig_for_ejeren = tilstand.kan_tjene_til_bolig_for_ejeren, kapabilitet = tilstand.kapabilitet, input_gyldigt = tilstand.input_gyldigt)
}
| ejendomsskattelov_rabatårsakkumulatortrin(indkomstår: Heltal, tilstand: EjendomsskattelovRabatÅrsakkumulator, hændelse: EjendomsskattelovRabatHændelse) -> {
    = hændelsesdag = ejendomsskattelov_par72_dagnummer(hændelse.dato)
    = dage_med_tidligere_beløb = hvis hændelse.dato.år == indkomstår { hændelsesdag - tilstand.seneste_dag_i_indkomståret } ellers { 0 }
    = nyt_beløb = ejendomsskattelov_rabatbeløb_efter_hændelse(tilstand.beløb, hændelse)
    EjendomsskattelovRabatÅrsakkumulator(
        seneste_dato = hændelse.dato,
        seneste_dag_i_indkomståret = hvis hændelse.dato.år == indkomstår { hændelsesdag } ellers { 1 },
        beløb = nyt_beløb,
        akkumuleret_ejendomsværdiskat_øre_dage = tilstand.akkumuleret_ejendomsværdiskat_øre_dage + hvis tilstand.beløb.kan_tjene_til_bolig_for_ejeren { tilstand.beløb.rabat_ejendomsværdiskat_helår_øre * dage_med_tidligere_beløb } ellers { 0 },
        akkumuleret_grundskyld_øre_dage = tilstand.akkumuleret_grundskyld_øre_dage + tilstand.beløb.rabat_grundskyld_helår_øre * dage_med_tidligere_beløb
    )
}
| ejendomsskattelov_rabat_årsresultat(indkomstår: Heltal, omfang: EjendomsskattelovOvergangsomfang, fakta: EjendomsskattelovRabatOvergangsfakta, aktuel_fakta: EjendomsskattelovOrdinærPersonEjendomFakta, ejendomsværdiskat_før_rabat_øre: Heltal, grundskyld_før_rabat_øre: Heltal) -> {
    = eget_grundlag_2024 = ejendomsskattelov_eget_rabatgrundlag_2024_resultat(omfang, fakta.eget_rabatgrundlag_2024)
    = hændelser_til_og_med_året = filter(fakta.hændelser, |hændelse: EjendomsskattelovRabatHændelse| ejendomsskattelov_dato_før_eller_lig_med(hændelse.dato, EjendomsskattelovDato(år = indkomstår, måned = 12, dag = 31)))
    = startbeløb = ejendomsskattelov_rabat_startbeløb(aktuel_fakta.identifikation, omfang, fakta.eget_rabatgrundlag_2024)
    = årsakkumulator = foldl(hændelser_til_og_med_året, EjendomsskattelovRabatÅrsakkumulator(seneste_dato = EjendomsskattelovDato(år = 2024, måned = 1, dag = 1), seneste_dag_i_indkomståret = 1, beløb = startbeløb, akkumuleret_ejendomsværdiskat_øre_dage = 0, akkumuleret_grundskyld_øre_dage = 0), |tilstand: EjendomsskattelovRabatÅrsakkumulator, hændelse: EjendomsskattelovRabatHændelse| ejendomsskattelov_rabatårsakkumulatortrin(indkomstår, tilstand, hændelse))
    = resterende_dage = 361 - årsakkumulator.seneste_dag_i_indkomståret
    = rabat_ejendomsværdiskat_før_par41_stk3_øre = (årsakkumulator.akkumuleret_ejendomsværdiskat_øre_dage + hvis årsakkumulator.beløb.kan_tjene_til_bolig_for_ejeren { årsakkumulator.beløb.rabat_ejendomsværdiskat_helår_øre * resterende_dage } ellers { 0 }) / 360
    = rabat_grundskyld_før_par41_stk3_øre = (årsakkumulator.akkumuleret_grundskyld_øre_dage + årsakkumulator.beløb.rabat_grundskyld_helår_øre * resterende_dage) / 360
    = rabat_ejendomsværdiskat_øre = penge_mindste_beløb(ejendomsværdiskat_før_rabat_øre, rabat_ejendomsværdiskat_før_par41_stk3_øre)
    = rabat_grundskyld_øre = penge_mindste_beløb(grundskyld_før_rabat_øre, rabat_grundskyld_før_par41_stk3_øre)
    = par15_og_par42_perioder_konsistente = ejendomsskattelov_par15_og_par42_perioder_konsistente(indkomstår, aktuel_fakta, fakta.hændelser)
    = input_gyldigt = indkomstår >= 2024 && ejendomsskattelov_rabathændelser_input_gyldige(fakta.hændelser) && par15_og_par42_perioder_konsistente && årsakkumulator.beløb.input_gyldigt
    = kapabilitet = hvis input_gyldigt == Falskt { EjskInputUgyldigt } ellers { årsakkumulator.beløb.kapabilitet }
    EjendomsskattelovRabatÅrsresultat(
        kapabilitet = kapabilitet,
        input_gyldigt = input_gyldigt,
        par15_og_par42_perioder_konsistente = par15_og_par42_perioder_konsistente,
        eget_grundlag_2024 = eget_grundlag_2024,
        rabat_ejendomsværdiskat_før_par41_stk3_øre = rabat_ejendomsværdiskat_før_par41_stk3_øre,
        rabat_grundskyld_før_par41_stk3_øre = rabat_grundskyld_før_par41_stk3_øre,
        rabat_ejendomsværdiskat_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { rabat_ejendomsværdiskat_øre } ellers { 0 },
        rabat_grundskyld_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { rabat_grundskyld_øre } ellers { 0 },
        samlet_rabat_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { rabat_ejendomsværdiskat_øre + rabat_grundskyld_øre } ellers { 0 }
    )
}
--@end:ejendomsskatteloven_rabatordning--

= ejendomsskatteloven_stigningsbegraensning_metadata = Metadata(
    attachments = (
        Source(value = ejendomsskatteloven_lov678_par35_til_45),
        AmendmentSource(value = ejendomsskatteloven_lov562_par1_nr31_til_33),
        Source(value = ejendomsskatteloven_tidligere_kommunale_ejendomsskattelov),
        Guidance(value = ejendomsskatteloven_vejledning_stigningsbegraensning),
    )
)

--@label:ejendomsskatteloven_stigningsbegraensning::meta:ejendomsskatteloven_stigningsbegraensning_metadata--
----
§ 44. Der ydes rabat i form af begrænsning af stigninger i grundskyld, jf. §
45, til følgende fysiske og juridiske personer:
1) Fysiske personer, der ejer ejendomme, der ikke er nævnt i § 38, stk. 1, nr.
1.
2) Fysiske personer, der ejer ejendomme nævnt i § 38, stk. 1, nr. 1, sammen med
juridiske personer, og fysiske personer, der efter kildeskattelovens § 3, stk.
1, er undtaget fra indkomstskat, jf. § 38, stk. 2, 1. pkt.
3) Juridiske personer, der ejer ejendomme.

§ 45. For kalenderåret 2024 udgør grundskyld af ejendomme omfattet af § 44 det
laveste af følgende:
1) Grundskyld opgjort efter kapitel 1-5 for kalenderåret.
2) Grundskyld opgjort efter den tidligere gældende lov om kommunal
ejendomsskat, jf. lovbekendtgørelse nr. 1463 af 6. oktober 2020 med senere
ændringer, for kalenderåret med anvendelse af den grundskyldspromille, som
kommunalbestyrelsen har fastsat for skatteåret 2023, og med anvendelse af en
reguleringsprocent på 2,8 pct.

Stk. 2. For kalenderåret 2025 og efterfølgende kalenderår udgør grundskyld af
ejendomme omfattet af § 44 det laveste af følgende, jf. dog stk. 3:
1) Grundskyld opgjort efter kapitel 1-5 for kalenderåret.
2) Grundskyld for det nærmest forudgående kalenderår med tillæg af 4,75 pct. af
grundskylden efter nr. 1, dog kun med tillæg af 3,50 pct. af grundskylden efter
nr. 1 til og med kalenderåret 2040 for almene boliger omfattet af lov om almene
boliger m.v.

Stk. 3. For nyopståede ejendomme, ejendomme, der omkategoriseres efter
ejendomsvurderingsloven, ejendomme omfattet af § 41, stk. 2, eller § 43, stk.
3, 2. pkt., ejendomme, der ophører med at være undtaget fra vurdering efter
ejendomsvurderingslovens §§ 9 eller 13, og ejendomme, hvis identifikationsnummer
(BFE-nummer) bortfalder, udgør grundskylden det første kalenderår grundskyld
opgjort efter kapitel 1-5 for kalenderåret.
For de efterfølgende kalenderår udgør grundskylden det laveste beløb efter stk.
2.

Stk. 4. For ejendomme, der ophører med at være fritaget for grundskyld efter
kapitel 1, udgør grundskylden for det første og de efterfølgende kalenderår det
laveste beløb efter stk. 2.
----

----
LOV nr. 562 af 27. maj 2025 § 1, nr. 31-33:

31. I § 45, stk. 1, nr. 2, ændres »kalenderåret 2023« til: »skatteåret 2023«.

32. I § 45, stk. 3, 1. pkt., indsættes efter »§ 43, stk. 3, 2. pkt.,«:
»ejendomme, der ophører med at være undtaget fra vurdering efter
ejendomsvurderingslovens §§ 9 eller 13,«.

33. I § 45 indsættes som stk. 4:
»Stk. 4. For ejendomme, der ophører med at være fritaget for grundskyld efter
kapitel 1, udgør grundskylden for det første og de efterfølgende kalenderår det
laveste beløb efter stk. 2.«
----

--@begin:ejendomsskatteloven_stigningsbegraensning--
# EjendomsskattelovStigningshændelse = EjskIngenStigningshændelse | EjskNyopståetEjendom | EjskOmkategoriseretEjendom | EjskOmfattetAfPar41Stk2 | EjskAnvendelsesændringEfterPar43Stk3 | EjskVurderingsundtagelseOphørt | EjskBfeNummerBortfaldet | EjskGrundskyldsfritagelseOphørt
# EjendomsskattelovStigningsårsfakta(kalenderår: Heltal, kommune: Kommune, grundværdi_kroner: Heltal, produktionsjord: Boolsk, ejerandel_basispoint: Heltal, almen_bolig: Boolsk, hændelse: EjendomsskattelovStigningshændelse)
# EjendomsskattelovStigningsbegrænsningsfakta(tidligere_grundskyld_2024: EjendomsskattelovTidligereGrundskyld2024Fakta, tidligere_år: List(EjendomsskattelovStigningsårsfakta), aktuel_almen_bolig: Boolsk, aktuel_hændelse: EjendomsskattelovStigningshændelse)
# EjendomsskattelovStigningstilstand(seneste_kalenderår: Heltal, input_gyldigt: Boolsk, regelgrundlag_understøttet: Boolsk, ordinær_grundskyld_øre: Heltal, grundskyld_efter_stigningsbegrænsning_øre: Heltal)
# EjendomsskattelovStigningsbegrænsningsresultat(kapabilitet: EjendomsskattelovRegelkapabilitet, input_gyldigt: Boolsk, par44_omfattet: Boolsk, kalenderår: Heltal, foregående_års_grundskyld_øre: Heltal, ordinær_grundskyld_helår_øre: Heltal, ordinær_grundskyld_øre: Heltal, stigningssats_basispoint: Heltal, nulstillet_til_ordinær_grundskyld: Boolsk, grundskyld_efter_stigningsbegrænsning_helår_øre: Heltal, grundskyld_efter_stigningsbegrænsning_øre: Heltal, begrænsning_øre: Heltal)

| ejendomsskattelov_par44_omfattet(vurderingskategori: EjendomsskattelovVurderingskategori, ejerkreds: EjendomsskattelovEjerkreds) -> vurderingskategori == EjskAndenVurderingskategori || ejerkreds == EjskFysiskEjerSammenMedJuridiskPerson || ejerkreds == EjskFysiskEjerUndtagetEfterKildeskattelovensPar3Stk1
| ejendomsskattelov_stigningshændelse_nulstiller(hændelse: EjendomsskattelovStigningshændelse) -> hændelse == EjskNyopståetEjendom || hændelse == EjskOmkategoriseretEjendom || hændelse == EjskOmfattetAfPar41Stk2 || hændelse == EjskAnvendelsesændringEfterPar43Stk3 || hændelse == EjskVurderingsundtagelseOphørt || hændelse == EjskBfeNummerBortfaldet
| ejendomsskattelov_par45_stigningssats_basispoint(kalenderår: Heltal, almen_bolig: Boolsk) -> hvis almen_bolig && kalenderår <= 2040 { 350 } ellers { 475 }
| ejendomsskattelov_stigningsårsfakta_input_gyldige(fakta: EjendomsskattelovStigningsårsfakta) -> fakta.kalenderår >= 2024 && fakta.grundværdi_kroner >= 0 && ejendomsskattelov_ejerandel_gyldig(fakta.ejerandel_basispoint)
| ejendomsskattelov_stigningsår_ordinær_grundskyld_øre(fakta: EjendomsskattelovStigningsårsfakta) -> {
    = beskatningsgrundlag_kroner = hvis fakta.produktionsjord { fakta.grundværdi_kroner } ellers { ejendomsskattelov_par17_beskatningsgrundlag_kroner(fakta.grundværdi_kroner) }
    penge_øre_nedrundet(beskatningsgrundlag_kroner * kommunale_parametre_for(fakta.kalenderår, fakta.kommune).grundskyld_promille_tiendedele * fakta.ejerandel_basispoint, 100 * 10000)
}
| ejendomsskattelov_tidligere_grundskyld_2024_for_ejerandel_øre(fakta: EjendomsskattelovTidligereGrundskyld2024Fakta, ejerandel_basispoint: Heltal) -> penge_øre_nedrundet(ejendomsskattelov_tidligere_grundskyld_2024_beskatningsgrundlag_kroner(fakta) * fakta.grundskyld_promille_2023_tiendedele * ejerandel_basispoint, 100 * 10000)
| ejendomsskattelov_stigningstrin(tidligere_grundskyld_2024: EjendomsskattelovTidligereGrundskyld2024Fakta, tilstand: EjendomsskattelovStigningstilstand, årsfakta: EjendomsskattelovStigningsårsfakta) -> {
    = input_gyldigt = tilstand.input_gyldigt && ejendomsskattelov_stigningsårsfakta_input_gyldige(årsfakta) && årsfakta.kalenderår == tilstand.seneste_kalenderår + 1
    = regelgrundlag_understøttet = tilstand.regelgrundlag_understøttet && kommune_understøttet_i_år(årsfakta.kalenderår, årsfakta.kommune)
    = ordinær_grundskyld_øre = hvis regelgrundlag_understøttet { ejendomsskattelov_stigningsår_ordinær_grundskyld_øre(årsfakta) } ellers { 0 }
    = nulstillet = ejendomsskattelov_stigningshændelse_nulstiller(årsfakta.hændelse)
    = stigningssats_basispoint = ejendomsskattelov_par45_stigningssats_basispoint(årsfakta.kalenderår, årsfakta.almen_bolig)
    = loft_2024_øre = ejendomsskattelov_tidligere_grundskyld_2024_for_ejerandel_øre(tidligere_grundskyld_2024, årsfakta.ejerandel_basispoint)
    = loft_fra_2025_øre = tilstand.grundskyld_efter_stigningsbegrænsning_øre + ordinær_grundskyld_øre * stigningssats_basispoint / 10000
    = grundskyld_efter_stigningsbegrænsning_øre = hvis nulstillet { ordinær_grundskyld_øre } ellers { hvis årsfakta.kalenderår == 2024 { penge_mindste_beløb(ordinær_grundskyld_øre, loft_2024_øre) } ellers { penge_mindste_beløb(ordinær_grundskyld_øre, loft_fra_2025_øre) } }
    EjendomsskattelovStigningstilstand(
        seneste_kalenderår = årsfakta.kalenderår,
        input_gyldigt = input_gyldigt,
        regelgrundlag_understøttet = regelgrundlag_understøttet,
        ordinær_grundskyld_øre = ordinær_grundskyld_øre,
        grundskyld_efter_stigningsbegrænsning_øre = hvis input_gyldigt && regelgrundlag_understøttet { grundskyld_efter_stigningsbegrænsning_øre } ellers { 0 }
    )
}
| ejendomsskattelov_stigningsbeløb_for_periode_øre(helårsbeløb_øre: Heltal, periode: EjendomsskattelovÅrsperiode) -> penge_øre_nedrundet(helårsbeløb_øre * ejendomsskattelov_par72_skattepligtige_dage(periode), 360)
| ejendomsskattelov_stigningsbegrænsningsresultat(indkomstår: Heltal, omfang: EjendomsskattelovOvergangsomfang, fakta: EjendomsskattelovStigningsbegrænsningsfakta, aktuel_fakta: EjendomsskattelovOrdinærPersonEjendomFakta) -> {
    = starttilstand = EjendomsskattelovStigningstilstand(seneste_kalenderår = 2023, input_gyldigt = ejendomsskattelov_tidligere_grundskyld_2024_fakta_gyldige(fakta.tidligere_grundskyld_2024), regelgrundlag_understøttet = Sandt, ordinær_grundskyld_øre = 0, grundskyld_efter_stigningsbegrænsning_øre = 0)
    = historisk_tilstand = foldl(fakta.tidligere_år, starttilstand, |tilstand: EjendomsskattelovStigningstilstand, årsfakta: EjendomsskattelovStigningsårsfakta| ejendomsskattelov_stigningstrin(fakta.tidligere_grundskyld_2024, tilstand, årsfakta))
    = foregående_års_grundskyld_øre = historisk_tilstand.grundskyld_efter_stigningsbegrænsning_øre
    = aktuel_årsfakta = EjendomsskattelovStigningsårsfakta(kalenderår = indkomstår, kommune = aktuel_fakta.kommune, grundværdi_kroner = aktuel_fakta.grundværdi_kroner, produktionsjord = aktuel_fakta.produktionsjord, ejerandel_basispoint = aktuel_fakta.ejerandel_basispoint, almen_bolig = fakta.aktuel_almen_bolig, hændelse = fakta.aktuel_hændelse)
    = aktuel_tilstand = ejendomsskattelov_stigningstrin(fakta.tidligere_grundskyld_2024, historisk_tilstand, aktuel_årsfakta)
    = par44_omfattet = ejendomsskattelov_par44_omfattet(omfang.vurderingskategori, omfang.ejerkreds)
    = aktuel_periode_gyldig = ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, aktuel_fakta.grundskyldsperiode)
    = input_gyldigt = par44_omfattet == Falskt || (aktuel_tilstand.input_gyldigt && aktuel_periode_gyldig)
    = kapabilitet = hvis input_gyldigt == Falskt { EjskInputUgyldigt } ellers { hvis par44_omfattet == Falskt { EjskIkkeRelevant } ellers { hvis aktuel_tilstand.regelgrundlag_understøttet { EjskUnderstøttet } ellers { EjskIkkeUnderstøttet } } }
    = ordinær_grundskyld_helår_øre = aktuel_tilstand.ordinær_grundskyld_øre
    = grundskyld_efter_stigningsbegrænsning_helår_øre = aktuel_tilstand.grundskyld_efter_stigningsbegrænsning_øre
    = ordinær_grundskyld_øre = ejendomsskattelov_grundskyld_resultat(indkomstår, aktuel_fakta).skat_øre
    = grundskyld_efter_stigningsbegrænsning_øre = hvis grundskyld_efter_stigningsbegrænsning_helår_øre < ordinær_grundskyld_helår_øre { ejendomsskattelov_stigningsbeløb_for_periode_øre(grundskyld_efter_stigningsbegrænsning_helår_øre, aktuel_fakta.grundskyldsperiode) } ellers { ordinær_grundskyld_øre }
    EjendomsskattelovStigningsbegrænsningsresultat(
        kapabilitet = kapabilitet,
        input_gyldigt = input_gyldigt,
        par44_omfattet = par44_omfattet,
        kalenderår = indkomstår,
        foregående_års_grundskyld_øre = foregående_års_grundskyld_øre,
        ordinær_grundskyld_helår_øre = ordinær_grundskyld_helår_øre,
        ordinær_grundskyld_øre = ordinær_grundskyld_øre,
        stigningssats_basispoint = ejendomsskattelov_par45_stigningssats_basispoint(indkomstår, fakta.aktuel_almen_bolig),
        nulstillet_til_ordinær_grundskyld = ejendomsskattelov_stigningshændelse_nulstiller(fakta.aktuel_hændelse),
        grundskyld_efter_stigningsbegrænsning_helår_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { grundskyld_efter_stigningsbegrænsning_helår_øre } ellers { 0 },
        grundskyld_efter_stigningsbegrænsning_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { grundskyld_efter_stigningsbegrænsning_øre } ellers { 0 },
        begrænsning_øre = hvis kapabilitet == EjskUnderstøttet { penge_positivt_beløb(ordinær_grundskyld_øre - grundskyld_efter_stigningsbegrænsning_øre) } ellers { 0 }
    )
}
--@end:ejendomsskatteloven_stigningsbegraensning--

= ejendomsskatteloven_person_ejendom_metadata = Metadata(
    attachments = (
        Source(value = ejendomsskatteloven_lov678_par13_til_31_og_par72),
        Source(value = ejendomsskatteloven_lov678_par23_til_27),
    )
)

--@label:ejendomsskatteloven_person_ejendom::meta:ejendomsskatteloven_person_ejendom_metadata--
----
§ 13. Ejendomsværdiskatten opgøres som beskatningsgrundlaget efter stk. 2-4
ganget med ejendomsværdiskattesatsen i § 22 med fradrag for nedslagsbeløb efter
§§ 15, 23-25 og 27 og rabat efter § 40, stk. 2, og med tillæg efter § 26.

§ 17. Grundskylden opgøres som beskatningsgrundlaget efter stk. 2 og 3 ganget
med grundskyldssatsen i § 28 med fradrag for grundforbedringer efter
ejendomsvurderingslovens §§ 22 og 23 og for fritagelse efter § 5, stk. 2, og §
7, stk. 2. Derudover fradrages rabat efter § 40, stk. 3, eller begrænsning af
stigninger i grundskyld efter § 45.
----

--@begin:ejendomsskatteloven_person_ejendom--
# EjendomsskattelovRabatvurderinger = EjskIngenRabatvurderingerOplyst | EjskRabatvurderingerOplyst(fakta: EjendomsskattelovRabatOvergangsfakta)
# EjendomsskattelovStigningsvurderinger = EjskIngenStigningsvurderingerOplyst | EjskStigningsvurderingerOplyst(fakta: EjendomsskattelovStigningsbegrænsningsfakta)
# EjendomsskattelovOvergangsvurderinger(rabat: EjendomsskattelovRabatvurderinger, stigningsbegrænsning: EjendomsskattelovStigningsvurderinger)
# EjendomsskattelovPersonEjendomFakta(ordinært_grundlag: EjendomsskattelovOrdinærPersonEjendomFakta, nedslagsfakta: EjendomsskattelovNedslagsfakta, overgangsomfang: EjendomsskattelovOvergangsomfang, overgangsvurderinger: EjendomsskattelovOvergangsvurderinger)
# EjendomsskattelovPersonÅrsfakta(person: EjendomsskattelovPersonKildeFakta, ejendomme: List(EjendomsskattelovPersonEjendomFakta))
# EjendomsskattelovRabatberegning = EjskRabatberegningUdenKildefakta(kapabilitet: EjendomsskattelovRegelkapabilitet) | EjskBeregnetRabat(resultat: EjendomsskattelovRabatÅrsresultat)
# EjendomsskattelovStigningsberegning = EjskStigningsberegningUdenKildefakta(kapabilitet: EjendomsskattelovRegelkapabilitet) | EjskBeregnetStigningsbegrænsning(resultat: EjendomsskattelovStigningsbegrænsningsresultat)
# EjendomsskattelovOvergangsresultat(rabat: EjendomsskattelovRabatberegning, stigningsbegrænsning: EjendomsskattelovStigningsberegning, kapabilitet: EjendomsskattelovRegelkapabilitet, input_gyldigt: Boolsk, rabat_ejendomsværdiskat_øre: Heltal, rabat_grundskyld_øre: Heltal, grundskyld_efter_stigningsbegrænsning_øre: Heltal, ejendomsværdiskat_øre: Heltal, grundskyld_øre: Heltal)
# EjendomsskattelovPersonEjendomResultat(indkomstår: Heltal, fakta: EjendomsskattelovPersonEjendomFakta, ordinært_resultat: EjendomsskattelovOrdinærPersonEjendomResultat, nedslag: EjendomsskattelovNedslagResultat, overgang: EjendomsskattelovOvergangsresultat, overgangskapabilitet: EjendomsskattelovRegelkapabilitet, input_gyldigt: Boolsk, regelgrundlag_understøttet: Boolsk, ejendomsværdiskat_før_overgang_øre: Heltal, grundskyld_før_overgang_øre: Heltal, ejendomsværdiskat_øre: Heltal, grundskyld_øre: Heltal, samlet_ejendomsskat_øre: Heltal, samlet_ejendomsskat_kroner: Heltal)
# EjendomsskattelovPersonÅrsresultat(indkomstår: Heltal, ejendomsresultater: List(EjendomsskattelovPersonEjendomResultat), identifikationer_entydige: Boolsk, alle_input_gyldige: Boolsk, regelgrundlag_understøttet: Boolsk, samlet_ejendomsværdiskat_øre: Heltal, samlet_grundskyld_øre: Heltal, samlet_ejendomsskat_øre: Heltal, samlet_ejendomsskat_kroner: Heltal)

| ejendomsskattelov_ingen_person_kildefakta() -> EjendomsskattelovPersonKildeFakta(
    ejer_folkepensionsalder = EjskFolkepensionsalderIkkeOpnået,
    samlevende_ægtefælles_folkepensionsalder = EjskFolkepensionsalderIkkeOpnået,
    skattemæssigt_hjemsted = EjskFuldtSkattepligtigEfterKildeskattelovensPar1,
    egen_udbytteindkomst_kroner = 0,
    ægtefælles_udbytteindkomst_kroner = 0,
    egne_historiske_aktielønshændelser = [],
    ægtefælles_historiske_aktielønshændelser = []
)
| ejendomsskattelov_ingen_person_årsfakta() -> EjendomsskattelovPersonÅrsfakta(person = ejendomsskattelov_ingen_person_kildefakta(), ejendomme = [])
| ejendomsskattelov_ingen_overgangsvurderinger() -> EjendomsskattelovOvergangsvurderinger(rabat = EjskIngenRabatvurderingerOplyst, stigningsbegrænsning = EjskIngenStigningsvurderingerOplyst)
| ejendomsskattelov_rabat_kildefakta_relevante(fakta: EjendomsskattelovPersonEjendomFakta) -> ejendomsskattelov_ejerskabstilstand(fakta.nedslagsfakta.ejerskabshistorik).ret_til_overgangsrabat && (ejendomsskattelov_par3_stk1_hjemmel_findes(ejendomsskattelov_par3_hjemmel(fakta.ordinært_grundlag.kategori, 2024)) || (ejendomsskattelov_par38_vurderingskategori_omfattet(fakta.overgangsomfang.vurderingskategori) && ejendomsskattelov_par38_ejerkreds_omfattet(fakta.overgangsomfang.ejerkreds)))
| ejendomsskattelov_stigningskildefakta_relevante(fakta: EjendomsskattelovPersonEjendomFakta) -> ejendomsskattelov_par44_omfattet(fakta.overgangsomfang.vurderingskategori, fakta.overgangsomfang.ejerkreds)
| ejendomsskattelov_rabatkapabilitet_uden_kildefakta(fakta: EjendomsskattelovPersonEjendomFakta) -> {
    = ejerskab = ejendomsskattelov_ejerskabstilstand(fakta.nedslagsfakta.ejerskabshistorik)
    hvis ejerskab.input_gyldigt == Falskt { EjskInputUgyldigt } ellers { hvis ejendomsskattelov_rabat_kildefakta_relevante(fakta) { EjskManglerKildefakta } ellers { EjskIkkeRelevant } }
}
| ejendomsskattelov_stigningskapabilitet_uden_kildefakta(fakta: EjendomsskattelovPersonEjendomFakta) -> hvis ejendomsskattelov_stigningskildefakta_relevante(fakta) { EjskManglerKildefakta } ellers { EjskIkkeRelevant }
| ejendomsskattelov_rabatberegning(kontekst: EjendomsskattelovPersonÅrskontekst, fakta: EjendomsskattelovPersonEjendomFakta, ejendomsværdiskat_før_overgang_øre: Heltal, grundskyld_før_overgang_øre: Heltal) -> match fakta.overgangsvurderinger.rabat {
    | EjskIngenRabatvurderingerOplyst -> EjskRabatberegningUdenKildefakta(ejendomsskattelov_rabatkapabilitet_uden_kildefakta(fakta))
    | EjskRabatvurderingerOplyst(rabatfakta) -> EjskBeregnetRabat(ejendomsskattelov_rabat_årsresultat(kontekst.indkomstår, fakta.overgangsomfang, rabatfakta, fakta.ordinært_grundlag, ejendomsværdiskat_før_overgang_øre, grundskyld_før_overgang_øre))
}
| ejendomsskattelov_stigningsberegning(kontekst: EjendomsskattelovPersonÅrskontekst, fakta: EjendomsskattelovPersonEjendomFakta) -> match fakta.overgangsvurderinger.stigningsbegrænsning {
    | EjskIngenStigningsvurderingerOplyst -> EjskStigningsberegningUdenKildefakta(ejendomsskattelov_stigningskapabilitet_uden_kildefakta(fakta))
    | EjskStigningsvurderingerOplyst(stigningsfakta) -> EjskBeregnetStigningsbegrænsning(ejendomsskattelov_stigningsbegrænsningsresultat(kontekst.indkomstår, fakta.overgangsomfang, stigningsfakta, fakta.ordinært_grundlag))
}
| ejendomsskattelov_rabatberegning_kapabilitet(beregning: EjendomsskattelovRabatberegning) -> match beregning {
    | EjskRabatberegningUdenKildefakta(kapabilitet) -> kapabilitet
    | EjskBeregnetRabat(resultat) -> resultat.kapabilitet
}
| ejendomsskattelov_stigningsberegning_kapabilitet(beregning: EjendomsskattelovStigningsberegning) -> match beregning {
    | EjskStigningsberegningUdenKildefakta(kapabilitet) -> kapabilitet
    | EjskBeregnetStigningsbegrænsning(resultat) -> resultat.kapabilitet
}
| ejendomsskattelov_rabatberegning_input_gyldig(beregning: EjendomsskattelovRabatberegning) -> match beregning {
    | EjskRabatberegningUdenKildefakta(kapabilitet) -> kapabilitet != EjskInputUgyldigt
    | EjskBeregnetRabat(resultat) -> resultat.input_gyldigt
}
| ejendomsskattelov_stigningsberegning_input_gyldig(beregning: EjendomsskattelovStigningsberegning) -> match beregning {
    | EjskStigningsberegningUdenKildefakta(kapabilitet) -> kapabilitet != EjskInputUgyldigt
    | EjskBeregnetStigningsbegrænsning(resultat) -> resultat.input_gyldigt
}
| ejendomsskattelov_rabat_ejendomsværdiskat_øre(beregning: EjendomsskattelovRabatberegning) -> match beregning {
    | EjskRabatberegningUdenKildefakta(_) -> 0
    | EjskBeregnetRabat(resultat) -> resultat.rabat_ejendomsværdiskat_øre
}
| ejendomsskattelov_rabat_grundskyld_øre(beregning: EjendomsskattelovRabatberegning) -> match beregning {
    | EjskRabatberegningUdenKildefakta(_) -> 0
    | EjskBeregnetRabat(resultat) -> resultat.rabat_grundskyld_øre
}
| ejendomsskattelov_stigningsbegrænset_grundskyld_øre(beregning: EjendomsskattelovStigningsberegning, grundskyld_efter_rabat_øre: Heltal) -> match beregning {
    | EjskStigningsberegningUdenKildefakta(_) -> grundskyld_efter_rabat_øre
    | EjskBeregnetStigningsbegrænsning(resultat) -> hvis resultat.par44_omfattet { resultat.grundskyld_efter_stigningsbegrænsning_øre } ellers { grundskyld_efter_rabat_øre }
}
| ejendomsskattelov_kombiner_overgangskapabilitet(rabat: EjendomsskattelovRegelkapabilitet, stigningsbegrænsning: EjendomsskattelovRegelkapabilitet) -> ejendomsskattelov_kombiner_regelkapabilitet(rabat, stigningsbegrænsning)
| ejendomsskattelov_overgangsresultat(kontekst: EjendomsskattelovPersonÅrskontekst, fakta: EjendomsskattelovPersonEjendomFakta, ejendomsværdiskat_før_overgang_øre: Heltal, grundskyld_før_overgang_øre: Heltal) -> {
    = rabat = ejendomsskattelov_rabatberegning(kontekst, fakta, ejendomsværdiskat_før_overgang_øre, grundskyld_før_overgang_øre)
    = stigningsbegrænsning = ejendomsskattelov_stigningsberegning(kontekst, fakta)
    = kapabilitet = ejendomsskattelov_kombiner_overgangskapabilitet(ejendomsskattelov_rabatberegning_kapabilitet(rabat), ejendomsskattelov_stigningsberegning_kapabilitet(stigningsbegrænsning))
    = input_gyldigt = ejendomsskattelov_rabatberegning_input_gyldig(rabat) && ejendomsskattelov_stigningsberegning_input_gyldig(stigningsbegrænsning)
    = rabat_ejendomsværdiskat_øre = ejendomsskattelov_rabat_ejendomsværdiskat_øre(rabat)
    = rabat_grundskyld_øre = ejendomsskattelov_rabat_grundskyld_øre(rabat)
    = ejendomsværdiskat_øre = penge_positivt_beløb(ejendomsværdiskat_før_overgang_øre - rabat_ejendomsværdiskat_øre)
    = grundskyld_efter_rabat_øre = penge_positivt_beløb(grundskyld_før_overgang_øre - rabat_grundskyld_øre)
    = grundskyld_øre = ejendomsskattelov_stigningsbegrænset_grundskyld_øre(stigningsbegrænsning, grundskyld_efter_rabat_øre)
    EjendomsskattelovOvergangsresultat(
        rabat = rabat,
        stigningsbegrænsning = stigningsbegrænsning,
        kapabilitet = kapabilitet,
        input_gyldigt = input_gyldigt,
        rabat_ejendomsværdiskat_øre = rabat_ejendomsværdiskat_øre,
        rabat_grundskyld_øre = rabat_grundskyld_øre,
        grundskyld_efter_stigningsbegrænsning_øre = grundskyld_øre,
        ejendomsværdiskat_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { ejendomsværdiskat_øre } ellers { 0 },
        grundskyld_øre = hvis ejendomsskattelov_kapabilitet_beregnet(kapabilitet) { grundskyld_øre } ellers { 0 }
    )
}
| ejendomsskattelov_person_ejendom_resultat(kontekst: EjendomsskattelovPersonÅrskontekst, fakta: EjendomsskattelovPersonEjendomFakta) -> {
    = ordinært_resultat = ejendomsskattelov_ordinær_person_ejendom_resultat(kontekst.indkomstår, fakta.ordinært_grundlag)
    = nedslag = ejendomsskattelov_nedslag_resultat(kontekst, fakta.ordinært_grundlag, fakta.nedslagsfakta)
    = ejendomsværdiskat_før_overgang_øre = nedslag.skat_efter_par23_til_par27_øre
    = grundskyld_før_overgang_øre = ordinært_resultat.grundskyld.skat_øre
    = overgang = ejendomsskattelov_overgangsresultat(kontekst, fakta, ejendomsværdiskat_før_overgang_øre, grundskyld_før_overgang_øre)
    = overgangskapabilitet = overgang.kapabilitet
    = input_gyldigt = ordinært_resultat.input_gyldigt && nedslag.input_gyldigt && overgangskapabilitet != EjskInputUgyldigt
    = regelgrundlag_understøttet = ordinært_resultat.regelgrundlag_understøttet && ejendomsskattelov_kapabilitet_beregnet(nedslag.kapabilitet) && ejendomsskattelov_kapabilitet_beregnet(overgangskapabilitet)
    = ejendomsværdiskat_øre = hvis regelgrundlag_understøttet { overgang.ejendomsværdiskat_øre } ellers { 0 }
    = grundskyld_øre = hvis regelgrundlag_understøttet { overgang.grundskyld_øre } ellers { 0 }
    = samlet_ejendomsskat_øre = ejendomsværdiskat_øre + grundskyld_øre
    EjendomsskattelovPersonEjendomResultat(
        indkomstår = kontekst.indkomstår,
        fakta = fakta,
        ordinært_resultat = ordinært_resultat,
        nedslag = nedslag,
        overgang = overgang,
        overgangskapabilitet = overgangskapabilitet,
        input_gyldigt = input_gyldigt,
        regelgrundlag_understøttet = regelgrundlag_understøttet,
        ejendomsværdiskat_før_overgang_øre = ejendomsværdiskat_før_overgang_øre,
        grundskyld_før_overgang_øre = grundskyld_før_overgang_øre,
        ejendomsværdiskat_øre = ejendomsværdiskat_øre,
        grundskyld_øre = grundskyld_øre,
        samlet_ejendomsskat_øre = samlet_ejendomsskat_øre,
        samlet_ejendomsskat_kroner = samlet_ejendomsskat_øre / 100
    )
}
| ejendomsskattelov_person_ejendomsresultater(kontekst: EjendomsskattelovPersonÅrskontekst, ejendomme: List(EjendomsskattelovPersonEjendomFakta)) -> map(ejendomme, |fakta: EjendomsskattelovPersonEjendomFakta| ejendomsskattelov_person_ejendom_resultat(kontekst, fakta))
| ejendomsskattelov_person_ejendomme_med_identifikation(ejendomme: List(EjendomsskattelovPersonEjendomFakta), identifikation: Tekst) -> filter(ejendomme, |fakta: EjendomsskattelovPersonEjendomFakta| fakta.ordinært_grundlag.identifikation == identifikation)
| ejendomsskattelov_person_identifikationer_entydige(ejendomme: List(EjendomsskattelovPersonEjendomFakta)) -> all(ejendomme, |fakta: EjendomsskattelovPersonEjendomFakta| length(ejendomsskattelov_person_ejendomme_med_identifikation(ejendomme, fakta.ordinært_grundlag.identifikation)) == 1)
| ejendomsskattelov_person_årsresultat(kontekst: EjendomsskattelovPersonÅrskontekst, ejendomme: List(EjendomsskattelovPersonEjendomFakta)) -> {
    = resultater = ejendomsskattelov_person_ejendomsresultater(kontekst, ejendomme)
    = identifikationer_entydige = ejendomsskattelov_person_identifikationer_entydige(ejendomme)
    = samlet_ejendomsværdiskat_øre = foldl(resultater, 0, |sum: Heltal, resultat: EjendomsskattelovPersonEjendomResultat| sum + resultat.ejendomsværdiskat_øre)
    = samlet_grundskyld_øre = foldl(resultater, 0, |sum: Heltal, resultat: EjendomsskattelovPersonEjendomResultat| sum + resultat.grundskyld_øre)
    = samlet_ejendomsskat_øre = samlet_ejendomsværdiskat_øre + samlet_grundskyld_øre
    EjendomsskattelovPersonÅrsresultat(
        indkomstår = kontekst.indkomstår,
        ejendomsresultater = resultater,
        identifikationer_entydige = identifikationer_entydige,
        alle_input_gyldige = identifikationer_entydige && all(resultater, |resultat: EjendomsskattelovPersonEjendomResultat| resultat.input_gyldigt),
        regelgrundlag_understøttet = all(resultater, |resultat: EjendomsskattelovPersonEjendomResultat| resultat.regelgrundlag_understøttet),
        samlet_ejendomsværdiskat_øre = samlet_ejendomsværdiskat_øre,
        samlet_grundskyld_øre = samlet_grundskyld_øre,
        samlet_ejendomsskat_øre = samlet_ejendomsskat_øre,
        samlet_ejendomsskat_kroner = samlet_ejendomsskat_øre / 100
    )
}
--@end:ejendomsskatteloven_person_ejendom--
