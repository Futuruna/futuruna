= ejsk_2027_landzone_fixture = ejendomsskattelov_par3_resultat(EjendomsskattelovPar3Input(indkomstår = 2027, kategori = EjskLandzoneOver5000M2, beliggenhed = EjskDanmark, erhvervsmæssigt_udlejet = Falskt, særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt))
= ejsk_2027_blandet_fixture = ejendomsskattelov_par3_resultat(EjendomsskattelovPar3Input(indkomstår = 2027, kategori = EjskBlandetBoligErhverv, beliggenhed = EjskDanmark, erhvervsmæssigt_udlejet = Falskt, særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt))
= ejsk_2027_tre_til_seks_fixture = ejendomsskattelov_par3_resultat(EjendomsskattelovPar3Input(indkomstår = 2027, kategori = EjskEjerlejlighedTreTilSeks, beliggenhed = EjskDanmark, erhvervsmæssigt_udlejet = Falskt, særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt))
