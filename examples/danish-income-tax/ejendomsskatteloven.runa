| ejsk_2027_tre_til_seks_betingelser_mangler_afskærer_ejendomsværdiskat: ejsk_2027_tre_til_seks_betingelser_mangler_fixture -> ejsk_2027_tre_til_seks_betingelser_mangler_fixture.stk1_hjemmel == EjskPar3Stk1Nr5 && ejsk_2027_tre_til_seks_betingelser_mangler_fixture.omfattet_af_ejendomsværdiskat == Falskt
