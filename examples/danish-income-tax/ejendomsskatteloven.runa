| ejsk_2026_landzone_er_gammel_nr9_og_psl_nr6: ejsk_2026_landzone_fixture -> ejsk_2026_landzone_fixture.stk1_hjemmel == EjskPar3Stk1Nr9 && ejsk_2026_landzone_fixture.omfattet_af_personskattelov_par4_nr6 == Sandt
