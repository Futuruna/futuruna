--@label:ejendomsskatteloven_par72::meta:ejendomsskatteloven_par72_metadata--
----
§ 72. I hele loven anses indkomståret og kalenderåret at udgøre 360 dage med
30 dage i hver kalendermåned.
----

--@begin:ejendomsskatteloven_par72--
# EjendomsskattelovDato(år: Heltal, måned: Heltal, dag: Heltal)
# EjendomsskattelovDatointerval(fra_dato: EjendomsskattelovDato, til_dato: EjendomsskattelovDato)
# EjendomsskattelovÅrsperiode = HeleEjendomsskatteåret | EjendomsskatFraOgMed(dato: EjendomsskattelovDato) | EjendomsskatTilOgMed(dato: EjendomsskattelovDato) | EjendomsskatFraOgMedTilOgMed(fra_dato: EjendomsskattelovDato, til_dato: EjendomsskattelovDato) | EjendomsskatIIntervaller(intervaller: List(EjendomsskattelovDatointerval))
# EjendomsskattelovIntervalvalidering(seneste_slutdag: Heltal, input_gyldigt: Boolsk)
# EjendomsskattelovPeriodeResultat(periode: EjendomsskattelovÅrsperiode, datoer_gyldige: Boolsk, skattepligtige_dage: Heltal, indkomstårets_dage: Heltal)

| ejendomsskattelov_dato_skudår(år: Heltal) -> år % 400 == 0 || år % 4 == 0 && år % 100 != 0
| ejendomsskattelov_dato_dage_i_måned(år: Heltal, måned: Heltal) -> match måned {
    | 2 -> hvis ejendomsskattelov_dato_skudår(år) { 29 } ellers { 28 }
    | 4 -> 30
    | 6 -> 30
    | 9 -> 30
    | 11 -> 30
    | _ -> 31
}
| ejendomsskattelov_dato_gyldig(dato: EjendomsskattelovDato) -> dato.år > 0 && dato.måned >= 1 && dato.måned <= 12 && dato.dag >= 1 && dato.dag <= ejendomsskattelov_dato_dage_i_måned(dato.år, dato.måned)
| ejendomsskattelov_dato_yyyymmdd(dato: EjendomsskattelovDato) -> dato.år * 10000 + dato.måned * 100 + dato.dag
| ejendomsskattelov_dato_før(venstre: EjendomsskattelovDato, højre: EjendomsskattelovDato) -> ejendomsskattelov_dato_yyyymmdd(venstre) < ejendomsskattelov_dato_yyyymmdd(højre)
| ejendomsskattelov_dato_før_eller_lig_med(venstre: EjendomsskattelovDato, højre: EjendomsskattelovDato) -> ejendomsskattelov_dato_yyyymmdd(venstre) <= ejendomsskattelov_dato_yyyymmdd(højre)
| ejendomsskattelov_par72_normaliseret_dag(dag: Heltal) -> hvis dag > 30 { 30 } ellers { dag }
| ejendomsskattelov_par72_dagnummer(dato: EjendomsskattelovDato) -> (dato.måned - 1) * 30 + ejendomsskattelov_par72_normaliseret_dag(dato.dag)
| ejendomsskattelov_datointerval_gyldigt(indkomstår: Heltal, interval: EjendomsskattelovDatointerval) -> ejendomsskattelov_dato_gyldig(interval.fra_dato) && ejendomsskattelov_dato_gyldig(interval.til_dato) && interval.fra_dato.år == indkomstår && interval.til_dato.år == indkomstår && ejendomsskattelov_par72_dagnummer(interval.fra_dato) <= ejendomsskattelov_par72_dagnummer(interval.til_dato)
| ejendomsskattelov_intervalvalideringstrin(indkomstår: Heltal, tilstand: EjendomsskattelovIntervalvalidering, interval: EjendomsskattelovDatointerval) -> EjendomsskattelovIntervalvalidering(
    seneste_slutdag = ejendomsskattelov_par72_dagnummer(interval.til_dato),
    input_gyldigt = tilstand.input_gyldigt && ejendomsskattelov_datointerval_gyldigt(indkomstår, interval) && ejendomsskattelov_par72_dagnummer(interval.fra_dato) > tilstand.seneste_slutdag
)
| ejendomsskattelov_datointervaller_gyldige(indkomstår: Heltal, intervaller: List(EjendomsskattelovDatointerval)) -> foldl(
    intervaller,
    EjendomsskattelovIntervalvalidering(seneste_slutdag = 0, input_gyldigt = Sandt),
    |tilstand: EjendomsskattelovIntervalvalidering, interval: EjendomsskattelovDatointerval| ejendomsskattelov_intervalvalideringstrin(indkomstår, tilstand, interval)
).input_gyldigt
| ejendomsskattelov_datointerval_dage(interval: EjendomsskattelovDatointerval) -> ejendomsskattelov_par72_dagnummer(interval.til_dato) - ejendomsskattelov_par72_dagnummer(interval.fra_dato) + 1
| ejendomsskattelov_datointervaller_dage(intervaller: List(EjendomsskattelovDatointerval)) -> foldl(intervaller, 0, |dage: Heltal, interval: EjendomsskattelovDatointerval| dage + ejendomsskattelov_datointerval_dage(interval))
| ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår: Heltal, periode: EjendomsskattelovÅrsperiode) -> match periode {
    | HeleEjendomsskatteåret -> Sandt
    | EjendomsskatFraOgMed(dato) -> ejendomsskattelov_dato_gyldig(dato) && dato.år == indkomstår
    | EjendomsskatTilOgMed(dato) -> ejendomsskattelov_dato_gyldig(dato) && dato.år == indkomstår
    | EjendomsskatFraOgMedTilOgMed(fra_dato, til_dato) -> ejendomsskattelov_dato_gyldig(fra_dato) && ejendomsskattelov_dato_gyldig(til_dato) && fra_dato.år == indkomstår && til_dato.år == indkomstår && ejendomsskattelov_par72_dagnummer(fra_dato) <= ejendomsskattelov_par72_dagnummer(til_dato)
    | EjendomsskatIIntervaller(intervaller) -> ejendomsskattelov_datointervaller_gyldige(indkomstår, intervaller)
}
| ejendomsskattelov_par72_skattepligtige_dage(periode: EjendomsskattelovÅrsperiode) -> match periode {
    | HeleEjendomsskatteåret -> 360
    | EjendomsskatFraOgMed(dato) -> 361 - ejendomsskattelov_par72_dagnummer(dato)
    | EjendomsskatTilOgMed(dato) -> ejendomsskattelov_par72_dagnummer(dato)
    | EjendomsskatFraOgMedTilOgMed(fra_dato, til_dato) -> ejendomsskattelov_par72_dagnummer(til_dato) - ejendomsskattelov_par72_dagnummer(fra_dato) + 1
    | EjendomsskatIIntervaller(intervaller) -> ejendomsskattelov_datointervaller_dage(intervaller)
}
| ejendomsskattelov_par72_periode_omfatter_dag(periode: EjendomsskattelovÅrsperiode, dagnummer: Heltal) -> match periode {
    | HeleEjendomsskatteåret -> dagnummer >= 1 && dagnummer <= 360
    | EjendomsskatFraOgMed(dato) -> dagnummer >= ejendomsskattelov_par72_dagnummer(dato) && dagnummer <= 360
    | EjendomsskatTilOgMed(dato) -> dagnummer >= 1 && dagnummer <= ejendomsskattelov_par72_dagnummer(dato)
    | EjendomsskatFraOgMedTilOgMed(fra_dato, til_dato) -> dagnummer >= ejendomsskattelov_par72_dagnummer(fra_dato) && dagnummer <= ejendomsskattelov_par72_dagnummer(til_dato)
    | EjendomsskatIIntervaller(intervaller) -> any(intervaller, |interval: EjendomsskattelovDatointerval| dagnummer >= ejendomsskattelov_par72_dagnummer(interval.fra_dato) && dagnummer <= ejendomsskattelov_par72_dagnummer(interval.til_dato))
}
| ejendomsskattelov_par72_periode_resultat(indkomstår: Heltal, periode: EjendomsskattelovÅrsperiode) -> EjendomsskattelovPeriodeResultat(
    periode = periode,
    datoer_gyldige = ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, periode),
    skattepligtige_dage = hvis ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, periode) { ejendomsskattelov_par72_skattepligtige_dage(periode) } ellers { 0 },
    indkomstårets_dage = 360
)

= ejsk_par72_august_til_december_fixture = ejendomsskattelov_par72_periode_resultat(2025, EjendomsskatFraOgMed(EjendomsskattelovDato(år = 2025, måned = 8, dag = 1)))
| ejsk_par72_august_til_december_er_150_dage: ejsk_par72_august_til_december_fixture -> ejsk_par72_august_til_december_fixture.datoer_gyldige && ejsk_par72_august_til_december_fixture.skattepligtige_dage == 150 && ejsk_par72_august_til_december_fixture.indkomstårets_dage == 360
--@end:ejendomsskatteloven_par72--

