--@label:ejendomsskatteloven_par72::meta:ejendomsskatteloven_par72_metadata--
----
§ 72. I hele loven anses indkomståret og kalenderåret at udgøre 360 dage med
30 dage i hver kalendermåned.
----

--@begin:ejendomsskatteloven_par72--
# EjendomsskattelovDato(år: Heltal, måned: Heltal, dag: Heltal)
# EjendomsskattelovÅrsperiode = HeleEjendomsskatteåret | EjendomsskatFraOgMed(dato: EjendomsskattelovDato) | EjendomsskatTilOgMed(dato: EjendomsskattelovDato) | EjendomsskatFraOgMedTilOgMed(fra_dato: EjendomsskattelovDato, til_dato: EjendomsskattelovDato)
# EjendomsskattelovPeriodeResultat(periode: EjendomsskattelovÅrsperiode, datoer_gyldige: Boolsk, skattepligtige_dage: Heltal, indkomstårets_dage: Heltal)

| ejendomsskattelov_dato_skudår(år: Heltal) -> år % 400 == 0 || år % 4 == 0 && år % 100 != 0
| ejendomsskattelov_dato_dage_i_måned(år: Heltal, måned: Heltal) -> match måned {
    | 2 -> hvis ejendomsskattelov_dato_skudår(år) { 29 } ellers { 28 }
    | 4 -> 30
    | 6 -> 30
    | 9 -> 30
    | 11 -> 30
    | _ -> 31
}
| ejendomsskattelov_dato_gyldig(dato: EjendomsskattelovDato) -> dato.år > 0 && dato.måned >= 1 && dato.måned <= 12 && dato.dag >= 1 && dato.dag <= ejendomsskattelov_dato_dage_i_måned(dato.år, dato.måned)
| ejendomsskattelov_par72_normaliseret_dag(dag: Heltal) -> hvis dag > 30 { 30 } ellers { dag }
| ejendomsskattelov_par72_dagnummer(dato: EjendomsskattelovDato) -> (dato.måned - 1) * 30 + ejendomsskattelov_par72_normaliseret_dag(dato.dag)
| ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår: Heltal, periode: EjendomsskattelovÅrsperiode) -> match periode {
    | HeleEjendomsskatteåret -> Sandt
    | EjendomsskatFraOgMed(dato) -> ejendomsskattelov_dato_gyldig(dato) && dato.år == indkomstår
    | EjendomsskatTilOgMed(dato) -> ejendomsskattelov_dato_gyldig(dato) && dato.år == indkomstår
    | EjendomsskatFraOgMedTilOgMed(fra_dato, til_dato) -> ejendomsskattelov_dato_gyldig(fra_dato) && ejendomsskattelov_dato_gyldig(til_dato) && fra_dato.år == indkomstår && til_dato.år == indkomstår && ejendomsskattelov_par72_dagnummer(fra_dato) <= ejendomsskattelov_par72_dagnummer(til_dato)
}
| ejendomsskattelov_par72_skattepligtige_dage(periode: EjendomsskattelovÅrsperiode) -> match periode {
    | HeleEjendomsskatteåret -> 360
    | EjendomsskatFraOgMed(dato) -> 361 - ejendomsskattelov_par72_dagnummer(dato)
    | EjendomsskatTilOgMed(dato) -> ejendomsskattelov_par72_dagnummer(dato)
    | EjendomsskatFraOgMedTilOgMed(fra_dato, til_dato) -> ejendomsskattelov_par72_dagnummer(til_dato) - ejendomsskattelov_par72_dagnummer(fra_dato) + 1
}
| ejendomsskattelov_par72_periode_resultat(indkomstår: Heltal, periode: EjendomsskattelovÅrsperiode) -> EjendomsskattelovPeriodeResultat(
    periode = periode,
    datoer_gyldige = ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, periode),
    skattepligtige_dage = hvis ejendomsskattelov_par72_periode_datoer_gyldige(indkomstår, periode) { ejendomsskattelov_par72_skattepligtige_dage(periode) } ellers { 0 },
    indkomstårets_dage = 360
)

= ejsk_par72_august_til_december_fixture = ejendomsskattelov_par72_periode_resultat(2025, EjendomsskatFraOgMed(EjendomsskattelovDato(år = 2025, måned = 8, dag = 1)))
| ejsk_par72_august_til_december_er_150_dage: ejsk_par72_august_til_december_fixture -> ejsk_par72_august_til_december_fixture.datoer_gyldige && ejsk_par72_august_til_december_fixture.skattepligtige_dage == 150 && ejsk_par72_august_til_december_fixture.indkomstårets_dage == 360
--@end:ejendomsskatteloven_par72--

