    label = "Erhvervspostens indkomstår",
    question = Some("Hvilket indkomstår vedrører erhvervsposten?"),
    help = Some("Året skal svare til både virksomheden og den delegerede lovberegning."),
    unit = Some("år")
)
= personskat_par3_erhvervsposter_felt_hjemmel = TypetBeregningsfelt(
