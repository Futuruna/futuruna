@ sprog da

@ importer ./metadata
@ importer ./personskat - personlig - indkomst - kildefakta

= personskat_par3_erhvervsposter_felt_liste = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::erhvervsposter_efter_par3_stk2_nr4_til_10),
    label = "Andre erhvervsposter efter personskattelovens § 3, stk. 2",
    question = Some("Har virksomheden husdyr, varelager, udligningshenlæggelser, tilbagebetalte offentlige ydelser eller skattemæssige afskrivninger?"),
    help = Some("Opret én række pr. dokumenteret post. Futuruna afleder beløbet og placeringen i personlig indkomst fra den valgte lovregel."),
    unit = None
)
= personskat_par3_erhvervsposter_felt_identifikation = TypetBeregningsfelt(
