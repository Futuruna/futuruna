    label = "Erhvervspostens identifikation",
    question = Some("Hvilken entydig identifikation skal erhvervsposten have?"),
    help = Some("Brug en stabil reference fra regnskabet eller bilaget, så samme post ikke medregnes to gange."),
    unit = None
)
= personskat_par3_erhvervsposter_felt_indkomstår = TypetBeregningsfelt(
