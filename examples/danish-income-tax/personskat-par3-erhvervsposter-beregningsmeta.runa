@ sprog da

@ importer ./metadata
@ importer ./personskat-personlig-indkomst-kildefakta

= personskat_al21_aktividentifikation_beregningsmeta = Beregningsmeta(
    felter = [
        Beregningsfelt(
            path = refof(Afskrivningslov21NedskrevetVærdiInput::aktiv_identifikation),
            label = "Det afståede aktivs identifikation",
            question = Some("Hvilken stabil identifikation har den afståede bygning eller installation?"),
            help = Some("Identifikationen skal svare til aktivets fordelingspost, når salgssummen kommer fra afskrivningslovens § 45."),
            unit = None
        )
    ],
    attachments = (Source(value = afskrivningsloven_lbk1222),)
)

@ meta(personskat_al21_aktividentifikation_beregningsmeta) for Afskrivningslov21NedskrevetVærdiInput
