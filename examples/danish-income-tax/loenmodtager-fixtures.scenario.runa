@ sprog da

@ importer ./loenmodtager_beregning

-- Personskatteloven — executable ordinary wage-earner fixtures.

----
Fixture 1
Skatteår: 2025
Kommune: København
Bruttoløn: 500.000 kr.
Positiv nettokapitalindkomst: 0 kr.
Ligningsmæssige fradrag: 0 kr.
Kirkeskat: ja
Kilder: Personskatteloven §§ 1, 3, 6, 7 og 9; Ligningsloven §§ 9 J og 9 K;
Skattestyrelsens 2025-satser; Skatteministeriets kommuneskat for København
2025.
----

= m4_københavn_2025_input = LønmodtagerInput(
    skatteår = 2025,
    kommune = København,
    bruttoløn_kroner = 500000,
    øvrig_personlig_indkomst_kroner = 0,
    nettokapitalindkomst_kroner = 0,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Sandt
)
= m4_københavn_2025 = beregn_lønmodtager(m4_københavn_2025_input)

