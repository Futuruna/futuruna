Fixture 9
Skatteår: 2025
§ 13-situation: passiv virksomhedsunderskud modregnes kun i samme virksomhed og
fremføres med restbeløbet.
Kilder: Personskatteloven § 13, stk. 6-7.
----

= m4_par13_virksomhed_indkomstgrundlag = Par13KompleksIndkomstgrundlag(2025, 0, 0, 0)
= m4_par13_virksomhed_fakta = Par13KompleksVirksomhedsunderskud(80000, 30000, PassivVirksomhedPar4Nr9Eller11)
= m4_par13_virksomhed_input = Par13KompleksBeregningInput(m4_par13_virksomhed_indkomstgrundlag, m4_par13_københavn_satser, m4_par13_ingen_modregningsskatter, m4_par13_ingen_ægtefælle, m4_par13_ingen_stk5_begrænsning, m4_par13_virksomhed_fakta)
= m4_par13_virksomhed = beregn_par13_kompleks(m4_par13_virksomhed_input)

| m4_par13_virksomhed_fremfører_rest: m4_par13_virksomhed -> m4_par13_virksomhed.virksomhedsunderskud.fradrag_i_øvrig_indkomst_kroner == 0 && m4_par13_virksomhed.virksomhedsunderskud.modregnet_i_samme_virksomhed_kroner == 30000 && m4_par13_virksomhed.virksomhedsunderskud.fremført_til_samme_virksomhed_kroner == 50000

? m4_par13_virksomhed_fremfører_rest

@ print("m4 København 2025 samlet inkl. AM efter personfradrag: " + vis(m4_københavn_2025.samlet_inkl_am_efter_personfradrag_kroner))
@ print("m4 Gentofte 2025 samlet inkl. AM efter personfradrag: " + vis(m4_gentofte_2025.samlet_inkl_am_efter_personfradrag_kroner))
@ print("m4 København 2026 mellemskat/topskat/toptopskat: " + vis(m4_københavn_2026.mellemskat_før_personfradrag_kroner) + "/" + vis(m4_københavn_2026.topskat_før_personfradrag_kroner) + "/" + vis(m4_københavn_2026_toptop.toptopskat_før_personfradrag_kroner))
@ print("m4 København 2026 positiv nettokapital mellemskat: " + vis(m4_københavn_2026_kapital.mellemskat_før_personfradrag_kroner))
@ print("m4 §13 kompleks ægtefælleoverførsel: " + vis(m4_par13_ægtefælle.ægtefælleoverførsel.fradrag_i_ægtefælle_indkomst_kroner))
@ print("m4 §13 2026 PBL-afskæring: " + vis(m4_par13_2026_pbl.stk5_overførsel.afskåret_pbl16_kroner))
