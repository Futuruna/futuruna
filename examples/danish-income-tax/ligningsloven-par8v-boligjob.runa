= ll8vleverandør_meta = TypetBeregningsmeta(
    felter = [
        TypetBeregningsfelt(path = refof(Ll8VLeverandør::$variant), label = "Udføreren af arbejdet", question = Some("Blev arbejdet udført af en virksomhed eller en privatperson, eller er udføreren uafklaret?"), help = Some("En privatperson kan kun udføre omfattede serviceydelser, ikke grønne håndværksydelser. Vælg uoplyst frem for at gætte, hvis kilden ikke afklarer leverandøren."), unit = None),
        TypetBeregningsfelt(path = refof(Ll8VLeverandør::Ll8VPrivatperson::fødselsdato::år), label = "Den private udførers fødselsår", question = Some("Hvilket år er den private person, som udførte arbejdet, født?"), help = Some("Dette er udføreren, ikke køberen. Udføreren skal være fyldt 18 ved arbejdsårets udløb; en senere betaling flytter ikke alderskravet. Fødselsdatoen skal være afklaret fra kilden. Brug Ll8VUoplystLeverandør, hvis oplysningerne mangler, ikke en opdigtet dato."), unit = Some("år")),
        TypetBeregningsfelt(path = refof(Ll8VLeverandør::Ll8VPrivatperson::fødselsdato::måned), label = "Den private udførers fødselsmåned", question = Some("Hvilken måned er den private udfører født?"), help = Some("Oplys udførerens dokumenterede fødselsmåned; kopier ikke køberens dato, og gæt ikke manglende dele."), unit = Some("måned")),
        TypetBeregningsfelt(path = refof(Ll8VLeverandør::Ll8VPrivatperson::fødselsdato::dag), label = "Den private udførers fødselsdag", question = Some("Hvilken dag i måneden er den private udfører født?"), help = Some("Oplys udførerens dokumenterede fødselsdag; en umulig eller uoplyst dato er ikke bevis for alderskravet."), unit = Some("dag"))
    ], spørgsmål = [], beløbsfelter = [], attachments = (Source(value = ll8v_kilde), Guidance(value = ll8v_privatleverandør_kilde))
)
