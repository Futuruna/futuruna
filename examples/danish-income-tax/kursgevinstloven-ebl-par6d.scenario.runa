@ sprog da

@ importer ./kursgevinstloven - ebl - par6d

--@label:kgl_ebl_par6d_scenarier::guidance:kgl_ebl_par6d_vejledning_2026--
--@begin:kgl_ebl_par6d_scenarier--
| kgl_ebl_par6d_scenarie_afdragsplan() -> [
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 1, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 2, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 3, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 4, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 5, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 6, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 7, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 8, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 9, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 10, hovedstol_forfalder_kroner = 375000)
]

| kgl_ebl_par6d_scenarie_partrelation() -> EblPar6DPartrelationFakta(
    overdragerens_kapitalandel_i_erhververen_promille = 0,
    overdragerens_stemmeandel_i_erhververen_promille = 0,
    erhververens_kapitalandel_i_overdrageren_promille = 0,
    erhververens_stemmeandel_i_overdrageren_promille = 0,
    parterne_er_nærtstående_efter_ligningslovens_par2_stk2 = Falskt,
    parterne_har_aftale_om_fælles_bestemmende_indflydelse = Falskt,
    parterne_er_under_fælles_bestemmende_indflydelse = Falskt
)

| kgl_ebl_par6d_scenarie_meddelelse() -> EblPar6DRettidigMeddelelse(indhold = EblPar6DMeddelelsesindhold(
    kopi_af_sælgerpantebrev_vedlagt = Sandt,
    oplyst_skattepligtig_fortjeneste_efter_par6_kroner = 5000000,
    oplyst_valgt_udskudt_fortjeneste_kroner = 3000000,
    oplyst_årligt_beløb_kroner = 300000,
    oplyst_antal_år = 10
))

| kgl_ebl_par6d_scenarie_pantebrev() -> EblPar6DSælgerpantebrev(
    identifikation = "Sælgerpantebrev kurs 80",
    fordring_mod_erhververen = Sandt,
    pant_i_den_overdragne_ejendom = Sandt,
    kontantværdi_kroner = 3000000,
    hovedstol_kroner = 3750000,
    løbetid_år = 10,
    afdragsplan = kgl_ebl_par6d_scenarie_afdragsplan()
)

| kgl_ebl_par6d_scenarie_par6d_resultat(årsforhold: List(EblPar6DÅrsforhold)) -> ebl_par6d_resultat(
    kontekst = EblPar6DKontekst(
        afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
        skattepligtig_fortjeneste_før_par6d_kroner = 5000000,
        kvalificerende_erhvervsfortjeneste_efter_par6_kroner = 5000000,
        kontantomregnet_afståelsessum_for_kvalificerende_erhvervsdel_kroner = 30000000,
        ejendom_omfattet_af_par8 = Falskt
    ),
    valg = EblMedPar6DValg(fakta = EblPar6DValgfakta(
        valgt_udskudt_fortjeneste_kroner = 3000000,
        årligt_beløb_kroner = 300000,
        fordelingsår = 10,
        erhververen_erhvervede_ejendommen_som_led_i_næring = Falskt,
        partrelation = kgl_ebl_par6d_scenarie_partrelation(),
        overdragerens_anvendelse = EblPar6DEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
        erhververens_anvendelse_ved_overdragelsen = EblPar6DEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
        sælgerpantebrev = kgl_ebl_par6d_scenarie_pantebrev(),
        meddelelse = kgl_ebl_par6d_scenarie_meddelelse(),
        sælgers_skatteforhold = EblPar6DSælgerskatteforhold(
            skattepligtsstatus = EblPar6DFuldtSkattepligtigTilDanmark,
            hjemland_omfattet_af_nordisk_overenskomst_eller_eu_inddrivelsesdirektiv = Sandt,
            sikkerhed = EblPar6DIngenSikkerhed
        ),
        ejendomsplacering = EblPar6DEjendomIDanmark,
        afståelsesårets_hændelse = EblPar6DIngenFremrykningshændelse,
        efterfølgende_årsforhold = årsforhold
    ))
)

| kgl_ebl_par6d_scenarie_skatteyderfakta() -> KglEblPar6DSkatteyderfakta(
    udøver_næring_ved_køb_og_salg_af_fordringer = Falskt,
    fordringen_erhvervet_uden_for_fordringsnæring = Sandt,
    fordringen_erhvervet_som_vederlag_for_leverede_varer_eller_tjenesteydelser = Falskt,
    fordringen_erhvervet_i_direkte_tilknytning_til_erhvervsmæssig_drift = Falskt,
    debitor_omfattet_af_tabsbegrænsningen_i_kgl_par14_stk2 = Falskt,
    renter_eller_gevinster_fritaget_efter_dobbeltbeskatningsoverenskomst = Falskt
)

| kgl_ebl_par6d_scenarie_resultat(årsforhold: List(EblPar6DÅrsforhold)) -> {
    = par6d_resultat = kgl_ebl_par6d_scenarie_par6d_resultat(årsforhold)
    kgl_ebl_par6d_resultat(
        fakta = KglEblPar6DSælgerpantebrevsfakta(
            sælgerpantebrev_identifikation = "Sælgerpantebrev kurs 80",
            skatteyderfakta = kgl_ebl_par6d_scenarie_skatteyderfakta(),
            dispositioner_efter_ebl_forløbet = []
        ),
        par6d_resultat = par6d_resultat
    )
}

= kgl_ebl_par6d_scenarie_hel_afståelse = kgl_ebl_par6d_scenarie_resultat([
    EblPar6DÅrsforhold(
        indkomstår = 2027,
        betalt_ordinært_hovedstolsafdrag_kroner = 375000,
        hændelse = EblPar6DPantebrevAfståetEllerIndfriet(
            art = EblPar6DPantebrevAfstået,
            berørt_restgæld_kroner = 3375000,
            afståelses_eller_indfrielsesprovenu_kroner = 3000000,
            succession = EblPar6DIngenÆgtefællesuccession
        )
    )
])

= kgl_ebl_par6d_scenarie_delvis_indfrielse = kgl_ebl_par6d_scenarie_resultat([
    EblPar6DÅrsforhold(
        indkomstår = 2027,
        betalt_ordinært_hovedstolsafdrag_kroner = 375000,
        hændelse = EblPar6DPantebrevAfståetEllerIndfriet(
            art = EblPar6DPantebrevIndfriet,
            berørt_restgæld_kroner = 375000,
            afståelses_eller_indfrielsesprovenu_kroner = 375000,
            succession = EblPar6DIngenÆgtefællesuccession
        )
    )
])

= kgl_ebl_par6d_scenarie_ægtefællesuccession = kgl_ebl_par6d_scenarie_resultat([
    EblPar6DÅrsforhold(
        indkomstår = 2027,
        betalt_ordinært_hovedstolsafdrag_kroner = 375000,
        hændelse = EblPar6DPantebrevAfståetEllerIndfriet(
            art = EblPar6DPantebrevAfstået,
            berørt_restgæld_kroner = 3375000,
            afståelses_eller_indfrielsesprovenu_kroner = 0,
            succession = EblPar6DÆgtefælleMedSuccessionEfterKildeskattelovensPar26B
        )
    )
])

| kgl_ebl_par6d_scenarie_afståelse_holder_lovene_adskilt: kgl_ebl_par6d_scenarie_hel_afståelse -> kgl_ebl_par6d_scenarie_hel_afståelse.input_gyldigt && kgl_ebl_par6d_scenarie_hel_afståelse.par6d_resultat.årsresultater[1].samlet_medregnet_fortjeneste_kroner == 3000000 && kgl_ebl_par6d_scenarie_hel_afståelse.kursgevinstresultat.dispositionsresultater[1].frigivet_anskaffelsessum_kroner == 2700000 && kgl_ebl_par6d_scenarie_hel_afståelse.kursgevinstresultat.dispositionsresultater[1].rå_gevinst_kroner == 300000 && kgl_ebl_par6d_scenarie_hel_afståelse.kursgevinstresultat.samlet_rå_gevinst_kroner == 375000
| kgl_ebl_par6d_scenarie_indfrielse_fordeler_begge_beløb: kgl_ebl_par6d_scenarie_delvis_indfrielse -> kgl_ebl_par6d_scenarie_delvis_indfrielse.input_gyldigt && kgl_ebl_par6d_scenarie_delvis_indfrielse.par6d_resultat.årsresultater[1].fremrykket_fortjeneste_kroner == 300000 && kgl_ebl_par6d_scenarie_delvis_indfrielse.kursgevinstresultat.dispositionsresultater[1].frigivet_anskaffelsessum_kroner == 300000 && kgl_ebl_par6d_scenarie_delvis_indfrielse.kursgevinstresultat.dispositionsresultater[1].rå_gevinst_kroner == 75000 && kgl_ebl_par6d_scenarie_delvis_indfrielse.kursgevinstresultat.samlet_rå_gevinst_kroner == 150000
| kgl_ebl_par6d_scenarie_succession_fejler_lukket_i_kgl: kgl_ebl_par6d_scenarie_ægtefællesuccession -> kgl_ebl_par6d_scenarie_ægtefællesuccession.par6d_resultat.input_gyldigt && kgl_ebl_par6d_scenarie_ægtefællesuccession.par6d_resultat.årsresultater[1].fremrykket_fortjeneste_kroner == 0 && kgl_ebl_par6d_scenarie_ægtefællesuccession.input_gyldigt == Falskt && kgl_ebl_par6d_scenarie_ægtefællesuccession.kursgevinstresultat.regelgrundlag_understøttet == Falskt

? kgl_ebl_par6d_scenarie_afståelse_holder_lovene_adskilt
? kgl_ebl_par6d_scenarie_indfrielse_fordeler_begge_beløb
? kgl_ebl_par6d_scenarie_succession_fejler_lukket_i_kgl

@ print("KGL/EBL § 6 D bridge scenarios passed")
--@end:kgl_ebl_par6d_scenarier--
