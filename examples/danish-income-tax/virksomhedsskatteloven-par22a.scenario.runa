        vsl22a_scenarie_par8_aktiv("dublet", Vsl22AAlmindeligtAktiv, Vsl22AUdelukkendeErhvervsmæssig, 100000),
        vsl22a_scenarie_par8_aktiv("dublet", Vsl22AAlmindeligtAktiv, Vsl22AUdelukkendeErhvervsmæssig, 100000),
    ],
