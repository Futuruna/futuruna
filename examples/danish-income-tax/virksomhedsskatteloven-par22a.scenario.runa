    0
)
= vsl22a_scenarie_dublerede_aktiver = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_dublerede_aktiver_person,
    Vsl22AIkkeGiftEllerIkkeSamlevendeVedIndkomståretsUdgang,
    Vsl22AÉnVirksomhed(drevet_af_person_identifikation = "dublet-person"),
    Sandt
))

= vsl22a_scenarie_par22c_kildeinput = Virksomhedsskattelov22CKildeInput(
    indkomstår = 2026,
    vælger_kapitalafkastordning = Sandt,
    fuld_skattepligt_og_hjemmehørende = Sandt,
    kontantomregnet_vederlag_kroner = 1000000,
    ejerandel_basispoint = 2600,
    stemmeværdi_basispoint = 0,
    ansatte_samlet_ejerandel_basispoint = 0,
    ansatte_samlet_stemmeværdi_basispoint = 0,
    ingen_ansat_råder_over_mere_end_50_pct_stemmer = Sandt,
    selskab_ikke_passiv_kapitalanbringelse_eller_næring_finansiering = Sandt,
    aktier_ikke_omfattet_af_abl19b_eller_19c = Sandt,
    ikke_erhvervet_ved_omdannelse_aktieombytning_etableringskonto = Sandt,
    ejet_i_mindre_end_11_år = Sandt,
    ejerperiode_hele_måneder = 12
)
= vsl22a_scenarie_par22c_kilderesultat = virksomhedsskattelov22c_kilde_resultat(vsl22a_scenarie_par22c_kildeinput)
= vsl22a_scenarie_par22c_uden_valg = virksomhedsskattelov22c_kilde_resultat(Virksomhedsskattelov22CKildeInput(
    indkomstår = 2026,
    vælger_kapitalafkastordning = Falskt,
    fuld_skattepligt_og_hjemmehørende = Sandt,
    kontantomregnet_vederlag_kroner = 1000000,
    ejerandel_basispoint = 2600,
    stemmeværdi_basispoint = 0,
    ansatte_samlet_ejerandel_basispoint = 0,
    ansatte_samlet_stemmeværdi_basispoint = 0,
    ingen_ansat_råder_over_mere_end_50_pct_stemmer = Sandt,
    selskab_ikke_passiv_kapitalanbringelse_eller_næring_finansiering = Sandt,
    aktier_ikke_omfattet_af_abl19b_eller_19c = Sandt,
    ikke_erhvervet_ved_omdannelse_aktieombytning_etableringskonto = Sandt,
    ejet_i_mindre_end_11_år = Sandt,
    ejerperiode_hele_måneder = 12
))

= vsl22a_scenarie_par23a_fra_par22a = virksomhedsskattelov23a_bundet_resultat(Virksomhedsskattelov23ABundetInput(
    kilde = Vsl23AKapitalafkastEfterPar22A(input = vsl22a_scenarie_kildeinput(
        vsl22a_scenarie_alle_aktivgrene_person,
        Vsl22AIkkeGiftEllerIkkeSamlevendeVedIndkomståretsUdgang,
        Vsl22AÉnVirksomhed(drevet_af_person_identifikation = "person-a"),
        Sandt
    )),
    ønsket_medregnet_personlig_indkomst_kroner = 5000
))
= vsl22a_scenarie_par7_kildeinput = Virksomhedsskattelov7KildeInput(
    par8_input = Virksomhedsskattelov8Input(
        indkomstår = 2026,
        opgørelsestidspunkt = Vsl8IndkomståretsBegyndelse,
        aktiver = [Virksomhedsskattelov8Aktiv(
            identifikation = "par7-aktiv",
            værdiansættelse = Vsl8AndenLøsøregenstand(handelsværdi_kroner = 500000)
        )],
        fradragsposter = Virksomhedsskattelov8Fradragsposter(
            gældsposter = [],
            afsat_efter_par4_kroner = 0,
            afsat_efter_par10_stk1_kroner = 0,
            indestående_på_mellemregningskonto_efter_par4a_kroner = 0,
            tidligere_indkomstårs_beløb_omfattet_af_par4b_stk1_kroner = 0,
            overførsler_til_privatøkonomien = []
        )
    ),
    skattepligtigt_overskud_kroner = 100000,
    regnskabsperiode_hele_måneder = 12
)
= vsl22a_scenarie_par23a_fra_par7 = virksomhedsskattelov23a_bundet_resultat(Virksomhedsskattelov23ABundetInput(
    kilde = Vsl23AKapitalafkastEfterPar7(input = vsl22a_scenarie_par7_kildeinput),
    ønsket_medregnet_personlig_indkomst_kroner = 6000
))
= vsl22a_scenarie_par11_kilderesultat = virksomhedsskattelov11_kilde_resultat(Virksomhedsskattelov11KildeInput(
    indkomstår = 2026,
    negativ_indskudskonto_start_eller_primo_abs_kroner = 100000,
    negativ_indskudskonto_ultimo_abs_kroner = 80000,
    negativt_afkastgrundlag_start_eller_primo_abs_kroner = 60000,
    negativt_afkastgrundlag_ultimo_abs_kroner = 40000,
    nettofinansieringsudgifter_efter_kursgevinstlov_kroner = 3000,
    overført_efter_par5_stk1_nr5_og_stk2_kroner = 0,
    indskud_efter_par3_stk1_kroner = 0
))

| vsl22a_scenarie_stk5_stk6_og_arbejdskapital: vsl22a_scenarie_alle_aktivgrene -> vsl22a_scenarie_alle_aktivgrene.input_gyldigt && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.direkte_afkastgrundlag_kroner == 490000 && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.arbejdskapitalaktiver_kroner == 240000 && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.varekreditorer_kroner == 150000 && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.arbejdskapital_efter_stk7_kroner == 90000 && vsl22a_scenarie_alle_aktivgrene.samlet_afkastgrundlag_kroner == 580000 && vsl22a_scenarie_alle_aktivgrene.par22a_resultat.kapitalafkastsats_basispoint == 200 && vsl22a_scenarie_alle_aktivgrene.skattepligtiges_kapitalafkast_kroner == 11600
| vsl22a_scenarie_stk7_udelukkelser_er_typed: vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat -> vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[6].behandling == Vsl22AUdeladt(grund = Vsl22AKontantBeløbEfterStk7) && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[7].behandling == Vsl22AUdeladt(grund = Vsl22AAndenFordringEfterStk7) && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[8].behandling == Vsl22AUdeladt(grund = Vsl22AAndenAktieEllerFinansieltAktivEfterStk7) && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[9].behandling == Vsl22AUdeladt(grund = Vsl22APersonskattelov4Stk1Nr9) && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[10].behandling == Vsl22AUdeladt(grund = Vsl22APersonskattelov4Stk1Nr11) && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[11].behandling == Vsl22AUdeladt(grund = Vsl22AKonkursskattelov6)
| vsl22a_scenarie_stk8_og_ikke_erhvervsmæssig_anvendelse_udelukkes: vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat -> vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[12].behandling == Vsl22AUdeladt(grund = Vsl22ANærtståendeBoligEfterStk8) && vsl22a_scenarie_alle_aktivgrene.skattepligtig_resultat.aktivresultater[13].behandling == Vsl22AUdeladt(grund = Vsl22AIkkeErhvervsmæssigEfterStk5Eller6)
| vsl22a_scenarie_hver_sin_virksomhed_fordeles_efter_aktiver: vsl22a_scenarie_hver_sin_virksomhed -> vsl22a_scenarie_hver_sin_virksomhed.input_gyldigt && vsl22a_scenarie_hver_sin_virksomhed.samlet_afkastgrundlag_kroner == 400000 && vsl22a_scenarie_hver_sin_virksomhed.skattepligtiges_kapitalafkast_kroner == 6000 && vsl22a_scenarie_hver_sin_virksomhed.ægtefællens_kapitalafkast_kroner == 2000
| vsl22a_scenarie_én_virksomhed_henføres_til_driveren: vsl22a_scenarie_én_virksomhed_hos_ægtefællen -> vsl22a_scenarie_én_virksomhed_hos_ægtefællen.input_gyldigt && vsl22a_scenarie_én_virksomhed_hos_ægtefællen.skattepligtiges_kapitalafkast_kroner == 0 && vsl22a_scenarie_én_virksomhed_hos_ægtefællen.ægtefællens_kapitalafkast_kroner == 8000
| vsl22a_scenarie_ægtefællens_vso_udelades_før_beregning: vsl22a_scenarie_ægtefælle_bruger_vso -> vsl22a_scenarie_ægtefælle_bruger_vso.input_gyldigt && vsl22a_scenarie_ægtefælle_bruger_vso.ægtefællens_virksomhedsordning_udeladt && vsl22a_scenarie_ægtefælle_bruger_vso.samlet_afkastgrundlag_kroner == 300000 && vsl22a_scenarie_ægtefælle_bruger_vso.samlet_personlig_nettoindkomst_kroner == 100000 && vsl22a_scenarie_ægtefælle_bruger_vso.samlet_nettokapitalindkomst_kroner == 0 && vsl22a_scenarie_ægtefælle_bruger_vso.skattepligtiges_kapitalafkast_kroner == 6000 && vsl22a_scenarie_ægtefælle_bruger_vso.ægtefællens_kapitalafkast_kroner == 0
| vsl22a_scenarie_signed_indkomster_sammenlægges_før_loftet: vsl22a_scenarie_signed_husstandsindkomst -> vsl22a_scenarie_signed_husstandsindkomst.input_gyldigt && vsl22a_scenarie_signed_husstandsindkomst.samlet_personlig_nettoindkomst_kroner == -10000 && vsl22a_scenarie_signed_husstandsindkomst.samlet_nettokapitalindkomst_kroner == -2000 && vsl22a_scenarie_signed_husstandsindkomst.par22a_resultat.loft_efter_stk3_kroner == 2000 && vsl22a_scenarie_signed_husstandsindkomst.par22a_resultat.kapitalafkast_kroner == 2000
