    [
        vsl22a_scenarie_par8_aktiv("almindeligt", Vsl22AAlmindeligtAktiv, Vsl22AUdelukkendeErhvervsmæssig, 400000),
        vsl22a_scenarie_par8_aktiv("blandet", Vsl22AAlmindeligtAktiv, Vsl22ABlandetErhvervOgPrivatOmfattetAfPar1Stk3(erhvervsandel_basispoint = 4000), 100000),
        vsl22a_scenarie_par8_aktiv("foreningsandel", Vsl22AAndelIForeningEfterSelskabsskattelov1Stk1Nr3Eller4, Vsl22AUdelukkendeErhvervsmæssig, 50000),
        vsl22a_scenarie_igangværende_arbejde("igangværende", 80000),
        vsl22a_scenarie_varelager("varelager", 100000),
        vsl22a_scenarie_par8_aktiv("varedebitor", Vsl22AVaredebitor, Vsl22AUdelukkendeErhvervsmæssig, 60000),
        vsl22a_scenarie_par8_aktiv("kontanter", Vsl22AKontantBeløb, Vsl22AUdelukkendeErhvervsmæssig, 30000),
        vsl22a_scenarie_par8_aktiv("anden-fordring", Vsl22AAndenFordring, Vsl22AUdelukkendeErhvervsmæssig, 40000),
        vsl22a_scenarie_par8_aktiv("andet-finansielt", Vsl22AAndenAktieEllerFinansieltAktiv, Vsl22AUdelukkendeErhvervsmæssig, 50000),
        vsl22a_scenarie_par8_aktiv("psl-nr9", Vsl22AVirksomhedBeskattetEfterPersonskattelov4Stk1Nr9, Vsl22AUdelukkendeErhvervsmæssig, 60000),
        vsl22a_scenarie_par8_aktiv("psl-nr11", Vsl22AVirksomhedBeskattetEfterPersonskattelov4Stk1Nr11, Vsl22AUdelukkendeErhvervsmæssig, 70000),
        vsl22a_scenarie_par8_aktiv("konkurs", Vsl22AKonkursindkomstEfterKonkursskattelov6, Vsl22AUdelukkendeErhvervsmæssig, 80000),
        vsl22a_scenarie_nærtstående_bolig("barnets-bolig", 900000),
        vsl22a_scenarie_par8_aktiv("ikke-erhvervsmæssigt", Vsl22AAlmindeligtAktiv, Vsl22AIkkeErhvervsmæssigEllerIkkeOmfattetAfPar1Stk3, 100000),
    ],
    [Virksomhedsskattelov22AVarekreditor(identifikation = "varekreditor", værdi_kroner = 150000)],
    100000,
    -20000
)
= vsl22a_scenarie_alle_aktivgrene = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_alle_aktivgrene_person,
    Vsl22AIkkeGiftEllerIkkeSamlevendeVedIndkomståretsUdgang,
    Vsl22AÉnVirksomhed(drevet_af_person_identifikation = "person-a"),
    Sandt
))

= vsl22a_scenarie_ægtefælle_a = vsl22a_scenarie_person(
    "ægtefælle-a",
    Falskt,
    [vsl22a_scenarie_par8_aktiv("a-aktiv", Vsl22AAlmindeligtAktiv, Vsl22AUdelukkendeErhvervsmæssig, 300000)],
    [],
    100000,
    0
)
= vsl22a_scenarie_ægtefælle_b = vsl22a_scenarie_person(
    "ægtefælle-b",
    Falskt,
    [vsl22a_scenarie_par8_aktiv("b-aktiv", Vsl22AAlmindeligtAktiv, Vsl22AUdelukkendeErhvervsmæssig, 100000)],
    [],
    100000,
    0
)
= vsl22a_scenarie_hver_sin_virksomhed = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_ægtefælle_a,
    Vsl22AGiftOgSamlevendeVedIndkomståretsUdgang(grundlag = vsl22a_scenarie_ægtefælle_b),
    Vsl22AÆgtefællerDriverHverSinVirksomhed,
    Sandt
))
= vsl22a_scenarie_én_virksomhed_hos_ægtefællen = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_ægtefælle_a,
    Vsl22AGiftOgSamlevendeVedIndkomståretsUdgang(grundlag = vsl22a_scenarie_ægtefælle_b),
    Vsl22AÉnVirksomhed(drevet_af_person_identifikation = "ægtefælle-b"),
