@ sprog da

@ importer ./virksomhedsskatteloven

| vsl22a_scenarie_par8_aktiv(identifikation: Tekst, kategori: Virksomhedsskattelov22AAktivkategori, anvendelse: Virksomhedsskattelov22AAnvendelse, værdi_kroner: Heltal) -> Virksomhedsskattelov22AAktiv(
    identifikation = identifikation,
    kategori = kategori,
    anvendelse = anvendelse,
    værdi = Vsl22AVærdiEfterPar8Stk2(
        værdiansættelse = Vsl8AndenLøsøregenstand(handelsværdi_kroner = værdi_kroner)
    )
)
| vsl22a_scenarie_varelager(identifikation: Tekst, værdi_kroner: Heltal) -> Virksomhedsskattelov22AAktiv(
    identifikation = identifikation,
    kategori = Vsl22AVarelager,
    anvendelse = Vsl22AUdelukkendeErhvervsmæssig,
    værdi = Vsl22AVærdiEfterPar8Stk2(
        værdiansættelse = Vsl8Varelager(værdi_efter_varelagerloven_kroner = værdi_kroner)
    )
)
| vsl22a_scenarie_igangværende_arbejde(identifikation: Tekst, nettoværdi_kroner: Heltal) -> Virksomhedsskattelov22AAktiv(
    identifikation = identifikation,
    kategori = Vsl22AIgangværendeArbejdeForFremmedRegning,
    anvendelse = Vsl22AUdelukkendeErhvervsmæssig,
    værdi = Vsl22AIgangværendeArbejdeNettoværdi(nettoværdi_kroner = nettoværdi_kroner)
)
| vsl22a_scenarie_nærtstående_bolig(identifikation: Tekst, værdi_kroner: Heltal) -> Virksomhedsskattelov22AAktiv(
    identifikation = identifikation,
    kategori = Vsl22AAlmindeligtAktiv,
    anvendelse = Vsl22AUdelukkendeErhvervsmæssig,
    værdi = Vsl22AVærdiEfterPar8Stk2(
        værdiansættelse = Vsl8FastEjendom(fakta = Virksomhedsskattelov8FastEjendomFakta(
            anskaffelsesår = 2020,
            kontant_anskaffelsessum_kroner = værdi_kroner,
            anskaffelsessum_for_ombygning_og_forbedringer_efter_anskaffelsen_kroner = 0,
            værdiansættelse = Vsl8KontantAnskaffelsessum,
            boliganvendelse = Vsl8StilletTilRådighedSomNærtståendeBolig(
                relation = Vsl8SkattepligtigesEllerÆgtefællesBarn
            )
        ))
    )
)
| vsl22a_scenarie_person(person_identifikation: Tekst, anvender_virksomhedsordningen: Boolsk, aktiver: List(Virksomhedsskattelov22AAktiv), varekreditorer: List(Virksomhedsskattelov22AVarekreditor), personlig_nettoindkomst_kroner: Heltal, nettokapitalindkomst_kroner: Heltal) -> Virksomhedsskattelov22APersongrundlag(
    person_identifikation = person_identifikation,
    anvender_virksomhedsordningen = anvender_virksomhedsordningen,
    opgørelsestidspunkt = Vsl8IndkomståretsBegyndelse,
    aktiver = aktiver,
    varekreditorer = varekreditorer,
    personlig_nettoindkomst_fra_selvstændig_erhvervsvirksomhed_kroner = personlig_nettoindkomst_kroner,
    nettokapitalindkomst_uden_par22a_og_personskattelov4_stk1_nr9_og_nr11_kroner = nettokapitalindkomst_kroner
)
| vsl22a_scenarie_kildeinput(skattepligtig: Virksomhedsskattelov22APersongrundlag, ægtefælle: Virksomhedsskattelov22AÆgtefælle, virksomhedsfordeling: Virksomhedsskattelov22AVirksomhedsfordeling, vælger_kapitalafkastordning: Boolsk) -> Virksomhedsskattelov22AKildeInput(
    indkomstår = 2026,
    skattepligtig = skattepligtig,
    ægtefælle = ægtefælle,
    virksomhedsfordeling = virksomhedsfordeling,
    vælger_kapitalafkastordning = vælger_kapitalafkastordning,
    periode_hele_måneder = 12
)

= vsl22a_scenarie_alle_aktivgrene_person = vsl22a_scenarie_person(
    "person-a",
