))

= vsl22a_scenarie_uden_valg = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_ægtefælle_a,
    Vsl22AIkkeGiftEllerIkkeSamlevendeVedIndkomståretsUdgang,
    Vsl22AÉnVirksomhed(drevet_af_person_identifikation = "ægtefælle-a"),
