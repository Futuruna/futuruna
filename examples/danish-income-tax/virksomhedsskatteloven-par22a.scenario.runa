    [vsl22a_scenarie_par8_aktiv("signed-b-aktiv", Vsl22AAlmindeligtAktiv, Vsl22AUdelukkendeErhvervsmæssig, 500000)],
    [],
    -20000,
    3000
)
= vsl22a_scenarie_signed_husstandsindkomst = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_signed_a,
    Vsl22AGiftOgSamlevendeVedIndkomståretsUdgang(grundlag = vsl22a_scenarie_signed_b),
    Vsl22AÆgtefællerDriverHverSinVirksomhed,
