    [],
    100000,
    -100000
)
= vsl22a_scenarie_ægtefælle_bruger_vso = virksomhedsskattelov22a_kilde_resultat(vsl22a_scenarie_kildeinput(
    vsl22a_scenarie_ægtefælle_a,
    Vsl22AGiftOgSamlevendeVedIndkomståretsUdgang(grundlag = vsl22a_scenarie_ægtefælle_b_vso),
