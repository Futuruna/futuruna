| al25_resultat_for(grundlag: Afskrivningslov25Grundlag, indkomstår: Heltal, tidligere_afskrivninger_kroner: Heltal, valgt_afskrivning_kroner: Heltal, hændelse: Afskrivningslov25Hændelse) -> afskrivningslov25_resultat(al25_input_for(grundlag, indkomstår, tidligere_afskrivninger_kroner, valgt_afskrivning_kroner, hændelse))

= al25_lejet_grund_40_år = al25_resultat_for(al25_lejet_grundlag(2024, al25_uden_afskæring, 100, Sandt), 2026, 0, 25000, Al25FortsatAnvendelse)
