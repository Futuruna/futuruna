| al26_resultat_for(par25_input: Afskrivningslov25Input, hændelse: Afskrivningslov25Hændelse, lejer_køber_grunden: Boolsk, salgssum_for_aktiv_kroner: Heltal, salgssum_for_materialer_kroner: Heltal, gennemsnitlig_andel_basispoint: Heltal) -> afskrivningslov26_resultat(Afskrivningslov26Input(
