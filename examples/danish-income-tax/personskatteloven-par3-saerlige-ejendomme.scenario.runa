)

| al25_input_for(grundlag: Afskrivningslov25Grundlag, indkomstår: Heltal, tidligere_afskrivninger_kroner: Heltal, valgt_afskrivning_kroner: Heltal, hændelse: Afskrivningslov25Hændelse) -> Afskrivningslov25Input(
