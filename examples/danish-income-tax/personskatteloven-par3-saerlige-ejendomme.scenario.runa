))

| scenarie_al25_lejeperioden_begrænser_tre_procent: al25_lejet_grund_40_år -> al25_lejet_grund_40_år.højeste_ordinære_sats_basispoint == 300 && al25_lejet_grund_40_år.lineært_lejeperiodemaksimum_kroner == 25000 && al25_lejet_grund_40_år.højeste_afskrivning_kroner == 25000 && al25_lejet_grund_40_år.fradrag_i_skattepligtig_indkomst_kroner == 25000
| scenarie_al25_før_2023_har_fire_procent_men_samme_lejeperiodeloft: al25_før_2023 -> al25_før_2023.højeste_ordinære_sats_basispoint == 400 && al25_før_2023.højeste_afskrivning_kroner == 25000
| scenarie_al25_væsentlig_erhvervsandel: al25_blandet_væsentlig_del -> al25_blandet_væsentlig_del.erhvervsandel_basispoint == 4000 && al25_blandet_væsentlig_del.afskrivningsgrundlag_kroner == 400000 && al25_blandet_væsentlig_del.højeste_afskrivning_kroner == 10000
