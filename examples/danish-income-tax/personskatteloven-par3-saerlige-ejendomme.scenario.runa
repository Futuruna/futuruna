| scenarie_al25_hjemfald_fordeler_par14_bygninger: al25_officielt_hjemfaldseksempel -> afskrivningslov25_par14_fordeling_gyldig(Al25Stk3Hjemfaldsforpligtelse, Sandt, 300000, 1000000) && afskrivningslov25_par14_fordeling_gyldig(Al25Stk3Hjemfaldsforpligtelse, Sandt, 0, 1000000) == Falskt && afskrivningslov25_par14_fordeling_gyldig(Al25Stk1LejetGrund, Falskt, 0, 1000000)
| scenarie_al25_officiel_hjemfaldsskala: al25_officielt_hjemfaldseksempel -> al25_officielt_hjemfaldseksempel.hjemfald_multiplikationsfaktor_millital == 1025 && al25_officielt_hjemfaldseksempel.hjemfald_fradrag_pr_10000_kroner == 20 && al25_officielt_hjemfaldseksempel.højeste_afskrivning_kroner == 3269 && al25_officielt_hjemfaldseksempel.valg_gyldigt
| scenarie_al26_ophør_og_køb_af_grunden: al26_lejemålsophør -> al26_lejemålsophør.hændelse_matcher && al26_lejemålsophør.uafskrevet_beløb_kroner == 700000 && al26_lejemålsophør.fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner == 700000 && al26_lejemålsophør_fordi_lejer_køber.fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner == 0
| scenarie_al26_salg_beskatter_kun_genvundne_afskrivninger: al26_salg_med_genvundne_afskrivninger -> al26_salg_med_genvundne_afskrivninger.beregnede_genvundne_afskrivninger_kroner == 200000 && al26_salg_med_genvundne_afskrivninger.skattepligtige_genvundne_afskrivninger_kroner == 200000 && al26_salg_med_ikke_fradragsberettiget_tab.råt_tab_ved_salg_kroner == 100000 && al26_salg_med_ikke_fradragsberettiget_tab.fradragsberettiget_tab_ved_salg_kroner == 0
| scenarie_al26_nedrivning_og_hændelsesintegritet: al26_nedrivning -> al26_nedrivning.nedrivningsfradrag_kroner == 600000 && al26_forkert_hændelse_afvises.hændelse_matcher == Falskt && al26_forkert_hændelse_afvises.nedrivningsfradrag_kroner == 0
| scenarie_al26_blandet_nedrivning_bruger_gennemsnitlig_andel: al26_blandet_nedrivning -> al26_blandet_nedrivning.uafskrevet_beløb_kroner == 300000 && al26_blandet_nedrivning.uafskrevet_beløb_efter_gennemsnitlig_andel_kroner == 200000 && al26_blandet_nedrivning.nedrivningsfradrag_kroner == 150000
| scenarie_al27_ejerens_position_følger_ejendommen: al27_ejersalg -> al27_ejersalg.højeste_afskrivning_kroner == 200000 && al27_ejersalg.fradrag_i_skattepligtig_indkomst_kroner == 200000 && al27_ejersalg.succession_sker && al27_ejersalg.genvundne_afskrivninger_ved_overdragelse_kroner == 0 && al27_ejersalg.position_efter.skatteyder == AlAndenFysiskPerson && al27_ejersalg.position_efter.samlede_foretagne_afskrivninger_kroner == 200000
| scenarie_al27_forpagterens_position_følger_til_ejeren: al27_forpagtningsophør -> al27_forpagtningsophør.overdragelse_gyldig && al27_forpagtningsophør.fradrag_i_skattepligtig_indkomst_kroner == 100000 && al27_forpagtningsophør.position_efter.rettighedshaver == Al27Ejer && al27_forpagtningsophør.position_efter.samlede_foretagne_afskrivninger_kroner == 200000
| scenarie_al27_fuld_afskrivning_efterlader_ingen_succession: al27_fuldt_afskrevet_ejersalg -> al27_fuldt_afskrevet_ejersalg.overdragelse_gyldig && al27_fuldt_afskrevet_ejersalg.resterende_afskrivningsgrundlag_kroner == 0 && al27_fuldt_afskrevet_ejersalg.succession_sker == Falskt && al27_fuldt_afskrevet_ejersalg.position_efter.skatteyder == AlSelvstændigErhvervsdrivendePerson && al27_fuldt_afskrevet_ejersalg.position_efter.samlede_foretagne_afskrivninger_kroner == 1000000
| scenarie_par3_nr10_adskiller_særlige_ejendomseffekter: par3_nr10_særlige_ejendomme -> length(par3_nr10_særlige_ejendomme.post_resultater) == 4 && par3_nr10_særlige_ejendomme.brutto_indtægtsføringer_efter_afskrivningsloven_kroner == 200000 && par3_nr10_særlige_ejendomme.indtægtsføring_i_personlig_indkomst_kroner == 200000 && par3_nr10_særlige_ejendomme.brutto_skattemæssige_afskrivninger_kroner == 225000 && par3_nr10_særlige_ejendomme.brutto_tab_kroner == 0 && par3_nr10_særlige_ejendomme.brutto_andre_fradrag_kroner == 600000 && par3_nr10_særlige_ejendomme.fradrag_i_personlig_indkomst_kroner == 825000

? scenarie_al25_lejeperioden_begrænser_tre_procent
? scenarie_al25_før_2023_har_fire_procent_men_samme_lejeperiodeloft
? scenarie_al25_væsentlig_erhvervsandel
? scenarie_al25_kontrol_kræver_manglende_reel_risiko
? scenarie_al25_hjemfald_fordeler_par14_bygninger
? scenarie_al25_officiel_hjemfaldsskala
? scenarie_al26_ophør_og_køb_af_grunden
? scenarie_al26_salg_beskatter_kun_genvundne_afskrivninger
