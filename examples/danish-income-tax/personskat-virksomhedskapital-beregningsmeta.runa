@ sprog da

@ importer ./metadata
@ importer ./personskat-virksomhedskapital-kildefakta

= personskat_ambl_biblioteksafgift_felt_år = Beregningsfelt(path = refof(ArbejdsmarkedsbidragBiblioteksafgiftFakta::modtagelsesdato::år), label = "Biblioteksafgiftens modtagelsesdato (ISO 8601) - år", question = Some("I hvilket år blev biblioteksafgiften modtaget?"), help = None, unit = Some("år"))
= personskat_ambl_biblioteksafgift_felt_måned = Beregningsfelt(path = refof(ArbejdsmarkedsbidragBiblioteksafgiftFakta::modtagelsesdato::måned), label = "Biblioteksafgiftens modtagelsesdato (ISO 8601) - måned", question = Some("I hvilken måned blev biblioteksafgiften modtaget?"), help = None, unit = Some("måned"))
= personskat_ambl_biblioteksafgift_felt_dag = Beregningsfelt(path = refof(ArbejdsmarkedsbidragBiblioteksafgiftFakta::modtagelsesdato::dag), label = "Biblioteksafgiftens modtagelsesdato (ISO 8601) - dag", question = Some("På hvilken dag blev biblioteksafgiften modtaget?"), help = None, unit = Some("dag"))
= personskat_ambl_biblioteksafgift_beregningsmeta = Beregningsmeta(
    felter = [
        personskat_ambl_biblioteksafgift_felt_år,
        personskat_ambl_biblioteksafgift_felt_måned,
        personskat_ambl_biblioteksafgift_felt_dag
    ],
    attachments = (Source(value = arbejdsmarkedsbidragsloven_lbk121_par5), Source(value = arbejdsmarkedsbidragsloven_lbk121_par6))
)
@ meta(personskat_ambl_biblioteksafgift_beregningsmeta) for ArbejdsmarkedsbidragBiblioteksafgiftFakta
