@ sprog da

@ importer ./metadata
@ importer ./ligningsloven - par9a - rejser

= personskat_ll9a_felt_personrolle = TypetBeregningsfelt(
    path = refof(Ligningslov9AÅrsinput::personrolle),
    label = "Personens rolle ved rejserne",
    question = Some("I hvilken rolle er rejserne foretaget?"),
    help = Some("Rollen afgør, om personen kan modtage skattefri rejsegodtgørelse og vælge standard- eller udgiftsfradrag."),
    unit = None
)
= personskat_ll9a_felt_rejser = TypetBeregningsfelt(
    path = refof(Ligningslov9AÅrsinput::rejser),
    label = "Arbejdsrejser med overnatning",
    question = Some("Hvilke arbejdsrejser med overnatning skal indgå i årsopgørelsen?"),
    help = Some("Opret én række pr. sammenhængende rejse til samme midlertidige arbejdssted."),
    unit = None
)
= personskat_ll9a_felt_identifikation = TypetBeregningsfelt(
    path = refof(Ligningslov9AÅrsinput::rejser::identifikation),
    label = "Rejsens identifikation",
    question = Some("Hvilken entydig identifikation har rejsen?"),
    help = Some("Brug en stabil reference fra rejseafregningen, så samme rejse ikke medregnes to gange."),
    unit = None
)
= personskat_ll9a_felt_indkomstår = TypetBeregningsfelt(
    path = refof(Ligningslov9AÅrsinput::rejser::indkomstår),
    label = "Rejsens indkomstår",
    question = Some("Hvilket indkomstår vedrører rejsen?"),
    help = None,
    unit = Some("år")
)
= personskat_ll9a_felt_rejseart = TypetBeregningsfelt(
    path = refof(Ligningslov9AÅrsinput::rejser::rejseart),
    label = "Rejsens art",
    question = Some("Er rejsen selvvalgt eller en tjenesterejse på arbejdsgiverens initiativ?"),
    help = Some("En enkeltstående kortvarig rejse til samme sted kræver, at den er en tjenesterejse."),
    unit = None
)
= personskat_ll9a_felt_arbejdssted_identifikation = TypetBeregningsfelt(
