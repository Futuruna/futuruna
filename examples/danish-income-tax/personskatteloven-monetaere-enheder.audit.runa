| personskat_monetaer_ejendomsskat_bevarer_øre_foer_projektion: personskat_monetaer_ejendomsskat_fixture -> personskat_monetaer_ejendomsskat_fixture.samlet_ejendomsskat_øre == 601205 && personskat_monetaer_ejendomsskat_fixture.samlet_ejendomsskat_kroner == 6012 && personskat_monetaer_ejendomsskat_fixture.samlet_ejendomsskat_øre % 100 == 5
| personskat_monetaer_ørebroek_bevarer_taeller_og_naevner: penge_øre_beregning(57000000000, 3650000) -> penge_øre_beregning(57000000000, 3650000).tæller == 57000000000 && penge_øre_beregning(57000000000, 3650000).nævner == 3650000 && penge_øre_beregning(57000000000, 3650000).øre_nedrundet == 15616
--@end:personskat_monetaer_ejendomsskattelov--

= personskat_monetaer_ksl_slutopgoerelse_metadata = Metadata(
    attachments = (
        Source(value = personskat_monetaer_ksl_kilde),
    )
)

--@label:personskat_monetaer_ksl_slutopgoerelse::meta:personskat_monetaer_ksl_slutopgoerelse_metadata--
----
§ 60. I den slutskat, der for et år udskrives for den skattepligtige, med
tillæg af eventuel overført restskat m.v. efter § 61, stk. 3, og afgiften
omfattet af pensionsbeskatningslovens § 25 A, stk. 5-9, modregnes nedennævnte
beløb vedrørende samme år:

a) Foreløbige skattebeløb, som er indeholdt i A-indkomst og
arbejdsmarkedsbidragspligtig indkomst, der skal medregnes ved den
skattepligtiges ansættelse til slutskat.
b) Foreløbige skattebeløb, som har skullet indbetales efter § 68.
c) Foreløbige skattebeløb, som har skullet betales i henhold til skattebillet.
d) De i § 67, stk. 1, 1. pkt., nævnte beløb.
e) Beløb, som den skattepligtige har indbetalt i henhold til § 59.
f) Beløb efter virksomhedsskattelovens § 10, stk. 3, 2. pkt., § 13, stk. 1,
3. pkt., og § 22 b, stk. 5.
g) Beløb efter personskattelovens § 8 a, stk. 5.
h) Beløb, der er indbetalt som acontoskat efter afskrivningslovens § 40 C,
stk. 8-10.
i) Beløb efter § 6 i lov om arbejdsmarkedsbidrag.
j) Nedslag efter lov om skattenedslag for seniorer.
k) Beløb efter lov om skattefri kompensation for forhøjede energi- og
miljøafgifter.

Stk. 3. Ved opgørelsen af det beløb, der skal modregnes efter stk. 1 eller
stk. 2, fradrages skatter, der måtte være tilbagebetalt i henhold til § 55.

§ 61. Den skattepligtige skal tilsvare det beløb, hvormed slutskatten med
tillæg af eventuel overført restskat m.v. efter stk. 3, og af eventuel afgift
omfattet af pensionsbeskatningslovens § 25 A, stk. 5-9, måtte overstige de
foreløbige skatter, der modregnes efter § 60.

Beløbet benævnes »restskat«.

Stk. 2. Ved betaling af restskat skal der ud over restskatten betales et
procenttillæg til staten af restskatten.

Procenttillægget beregnes en gang årligt og fastsættes som rentesatsen i
opkrævningslovens § 7, stk. 2, 3. pkt., med tillæg af 1,5 procentpoint afrundet
til en decimal.

Af restskat og procenttillæg efter 1. pkt. beregnes en rente svarende til
renten i opkrævningslovens § 7, stk. 2, med tillæg af 0,4 procentpoint pr.
påbegyndt måned fra den 1. september i året efter indkomståret og indtil
udskrivningsdatoen for den skattepligtiges årsopgørelse, hvis den
skattepligtige ikke rettidigt har opfyldt sin oplysningspligt efter
skattekontrollovens § 2.

§ 62. Det beløb hvormed slutskatten med tillæg af eventuel overført restskat
m.v. efter § 61, stk. 3, og af eventuel afgift omfattet af
pensionsbeskatningslovens § 25 A, stk. 5-9, måtte være mindre end de
foreløbige skatter, der modregnes efter § 60, benævnes »overskydende skat«.

Stk. 2. Ved tilbagebetaling af overskydende skat ydes der den
skattepligtige et procenttillæg af beløbet i godtgørelse.

Procenttillægget beregnes en gang årligt og fastsættes som rentesatsen i
opkrævningslovens § 7, stk. 2, 3. pkt., med fradrag af 5,2 procentpoint
afrundet til en decimal.

Procenttillægget kan dog ikke fastsættes til mindre end 0,0 pct. af den
overskydende skat.

I det omfang overskydende skat modsvares af beløb, der er indbetalt efter
§ 59, ydes ingen godtgørelse efter 1. pkt. Betalt rente af indbetalinger efter
§ 59 tilbagebetales, i det omfang indbetalingen modsvares af overskydende skat.

Ved flere indbetalinger efter § 59 anses de seneste indbetalinger i størst
muligt omfang at modsvares af overskydende skat.

Der ydes ingen godtgørelse for et beløb, som modsvares af nedslaget efter lov
om skattenedslag for seniorer og efter lov om skattefri kompensation for
forhøjede energi- og miljøafgifter.

Stk. 3. Tilbagebetaling af overskydende skat med godtgørelse efter stk. 2 sker
i tiden fra den 1. marts til den 1. september i året efter indkomståret.

Der tilkommer den skattepligtige en rente svarende til renten i henhold til
opkrævningslovens § 7, stk. 2, med tillæg af 0,4 procentpoint pr. påbegyndt
måned fra den 1. september at regne, hvis tilbagebetaling sker efter denne
dato.

Inden tilbagebetaling finder sted, modregnes eventuelle restancer af personlig
skat med påløbne morarenter, uanset om renterne er forfaldne.

Modregningen kræver ingen særskilt erklæring herom fra told- og
skatteforvaltningen.

Stk. 4. Af det beløb, der efter foranstående skal udbetales den skattepligtige,
udbetales kun det hele kronebeløb.

§ 62 C. Stk. 4. Ved opkrævning af beløb efter denne lov opkræves kun hele
kronebeløb. Tilsvarende gælder ved opkrævning af rater efter stk. 1.
----

--@begin:personskat_monetaer_ksl_slutopgoerelse--
= personskat_monetaer_par60_trin = PersonskatMonetærtTrin(
    navn = "KSL §§ 60-62: slutskat og foreløbige skatter modregnes",
    input_enhed = Øre,
    beregningsenheder = [],
    output_enhed = Øre,
    afrunding = IngenMonetærAfrunding,
    belæg = UdtrykkeligLovregel,
    offentligt_slutskattetrin = Sandt,
    implementeringsissue = ""
)

= personskat_monetaer_par62_udbetaling_trin = PersonskatMonetærtTrin(
    navn = "KSL § 62, stk. 4: udbetaling af overskydende skat",
    input_enhed = Øre,
    beregningsenheder = [],
    output_enhed = HeleKroner,
    afrunding = HeleKronerMedØrerest,
    belæg = UdtrykkeligLovregel,
    offentligt_slutskattetrin = Sandt,
    implementeringsissue = ""
)

= personskat_monetaer_par62c_opkraevning_trin = PersonskatMonetærtTrin(
    navn = "KSL § 62 C, stk. 4: opkrævning af restskat",
    input_enhed = Øre,
    beregningsenheder = [],
    output_enhed = HeleKroner,
    afrunding = HeleKronerMedØrerest,
    belæg = UdtrykkeligLovregel,
    offentligt_slutskattetrin = Sandt,
    implementeringsissue = ""
)

| personskat_monetaer_slutopgoerelse_input(slutskat_øre: Heltal, indeholdt_øre: Heltal) -> KildeskatSlutopgørelseEksaktInput(
    slutskat_øre = slutskat_øre,
    overført_restskat_mv_øre = 0,
    pensionsbeskatningsafgift_øre = 0,
    kreditter = KildeskatPar60KreditterØre(
        a_skat_og_am_indeholdt_øre = indeholdt_øre,
        par68_indbetalt_øre = 0,
        b_skat_betalt_øre = 0,
        udbytteskat_modregningsberettiget_øre = 0,
        frivillig_indbetaling_par59_øre = 0,
        virksomhedsordning_beløb_øre = 0,
        personskattelov_par8a_stk5_beløb_øre = 0,
        afskrivningslov_acontoskat_øre = 0,
        am_lov_par6_beløb_øre = 0,
        seniornedslag_øre = 0,
        energiafgiftskompensation_øre = 0,
        tilbagebetalt_par55_øre = 0
    )
)

= personskat_monetaer_overskydende_skat_fixture = kildeskat_slutopgørelse_eksakt_resultat(personskat_monetaer_slutopgoerelse_input(
    slutskat_øre = 100000,
    indeholdt_øre = 108280
))

= personskat_monetaer_restskat_fixture = kildeskat_slutopgørelse_eksakt_resultat(personskat_monetaer_slutopgoerelse_input(
    slutskat_øre = 108280,
    indeholdt_øre = 100000
))

= personskat_monetaer_overskydende_skat_afregning_fixture = kildeskat_overskydende_afregning_eksakt(
    personskat_monetaer_overskydende_skat_fixture,
    KildeskatOverskydendeAfregningEksaktFakta(
        indkomstår = 2025,
        modsvarer_par59_indbetaling_øre = 0,
        tilbagebetalt_rente_par59_øre = 0,
        modsvarer_seniornedslag_øre = 0,
        modsvarer_energiafgiftskompensation_øre = 0,
        restancer_personlig_skat_med_morarenter_øre = 0,
        tilbagebetaling_efter_1_september = Falskt,
        påbegyndte_måneder_efter_1_september = 0
    )
)

= personskat_monetaer_restskat_afregning_fixture = kildeskat_restskat_afregning_eksakt(
    personskat_monetaer_restskat_fixture,
    KildeskatRestskatAfregningEksaktFakta(
        indkomstår = 2025,
        oplysningspligt_ikke_rettidigt_opfyldt = Falskt,
        påbegyndte_måneder_fra_1_september = 0,
        øvrige_skyldige_renter_øre = 0
    )
)

| personskat_monetaer_overskydende_skat_bevarer_øre_til_lovgraensen: personskat_monetaer_overskydende_skat_fixture -> personskat_monetaer_overskydende_skat_fixture.slutskat_med_tillæg_øre == 100000 && personskat_monetaer_overskydende_skat_fixture.modregnede_foreløbige_skatter_øre == 108280 && personskat_monetaer_overskydende_skat_fixture.overskydende_skat_øre == 8280 && personskat_monetaer_overskydende_skat_afregning_fixture.godtgørelse_øre == 0 && personskat_monetaer_overskydende_skat_afregning_fixture.udbetaling_før_hele_kroner_øre == 8280 && personskat_monetaer_overskydende_skat_afregning_fixture.udbetales_kroner == 82 && personskat_monetaer_overskydende_skat_afregning_fixture.ikke_udbetalt_øre == 80
| personskat_monetaer_restskat_bevarer_øre_til_lovgraensen: personskat_monetaer_restskat_fixture -> personskat_monetaer_restskat_fixture.slutskat_med_tillæg_øre == 108280 && personskat_monetaer_restskat_fixture.modregnede_foreløbige_skatter_øre == 100000 && personskat_monetaer_restskat_fixture.restskat_øre == 8280 && personskat_monetaer_restskat_afregning_fixture.procenttillæg_basispoint == 570 && personskat_monetaer_restskat_afregning_fixture.procenttillæg_øre == 471 && personskat_monetaer_restskat_afregning_fixture.opkrævning_før_hele_kroner_øre == 8751 && personskat_monetaer_restskat_afregning_fixture.opkræves_kroner == 87 && personskat_monetaer_restskat_afregning_fixture.ikke_opkrævet_øre == 51
--@end:personskat_monetaer_ksl_slutopgoerelse--

= personskat_monetaer_eksakt_slutskat_metadata = Metadata(
    attachments = (
        Guidance(value = personskat_monetaer_uafrundet_skat_kilde),
        DependencySource(value = personskat_monetaer_ksl_kilde),
    )
)

--@label:personskat_monetaer_eksakt_slutskat::meta:personskat_monetaer_eksakt_slutskat_metadata--
----
Skatteberegningen sker herefter for alle skatters vedkommende på grundlag af
uafrundede beregningsgrundlag i hele kroner. Ørebeløb medregnes ved
skatteberegningen.
----

--@begin:personskat_monetaer_eksakt_slutskat--
= personskat_monetaer_eksakt_slutskat_trin = PersonskatMonetærtTrin(
    navn = "Kanonisk ørepræcis slutskat til KSL § 60",
    input_enhed = Øre,
    beregningsenheder = [],
    output_enhed = Øre,
    afrunding = IngenMonetærAfrunding,
    belæg = KildedrevetEksaktBeregning,
    offentligt_slutskattetrin = Sandt,
    implementeringsissue = ""
)

= personskat_monetaer_eksakt_slutskat_fixture_øre = personskat_monetaer_kommuneskat_foer_øre + personskat_monetaer_ejendomsskat_fixture.samlet_ejendomsskat_øre
= personskat_monetaer_helkronekomposition_fixture_kroner = personskat_monetaer_kommuneskat_foer_kroner + personskat_monetaer_ejendomsskat_fixture.samlet_ejendomsskat_kroner
= personskat_monetaer_eksakt_slutskat_fixture = kildeskat_slutopgørelse_eksakt_resultat(personskat_monetaer_slutopgoerelse_input(
    slutskat_øre = personskat_monetaer_eksakt_slutskat_fixture_øre,
    indeholdt_øre = personskat_monetaer_eksakt_slutskat_fixture_øre + 8280
))

| personskat_monetaer_eksakt_slutskat_bevarer_komponenters_ørerester: personskat_monetaer_eksakt_slutskat_fixture -> personskat_monetaer_eksakt_slutskat_fixture_øre == 16396668 && personskat_monetaer_helkronekomposition_fixture_kroner * 100 == 16396600 && personskat_monetaer_eksakt_slutskat_fixture.slutskat_med_tillæg_øre == personskat_monetaer_eksakt_slutskat_fixture_øre && personskat_monetaer_eksakt_slutskat_fixture.overskydende_skat_øre == 8280
--@end:personskat_monetaer_eksakt_slutskat--

| personskat_monetaere_trin() -> [
    personskat_monetaer_procentkomponent_trin,
    personskat_monetaer_procentkomponent_kroner_trin,
    personskat_monetaer_personfradrag_trin,
    personskat_monetaer_personfradrag_kroner_trin,
    personskat_monetaer_underskudsoverfoersel_trin,
    personskat_monetaer_underskudsoverfoersel_kroner_trin,
    personskat_monetaer_par14_trin,
    personskat_monetaer_par20_trin,
    personskat_monetaer_ksl_par48_trin,
    personskat_monetaer_dis_forholdsmaessig_lempelse_trin,
    personskat_monetaer_ejendomsskat_broek_trin,
    personskat_monetaer_ejendomsskat_kroner_trin,
    personskat_monetaer_par60_trin,
    personskat_monetaer_par62_udbetaling_trin,
    personskat_monetaer_par62c_opkraevning_trin,
    personskat_monetaer_eksakt_slutskat_trin,
]
| personskat_monetaere_offentlige_slutskattetrin() -> filter(personskat_monetaere_trin(), |trin: PersonskatMonetærtTrin| trin.offentligt_slutskattetrin)
| personskat_monetaere_bekræftede_præcisionstab() -> filter(personskat_monetaere_trin(), |trin: PersonskatMonetærtTrin| trin.belæg == BekræftetPræcisionstab)
| personskat_monetaer_audit_resultat() -> PersonskatMonetærAuditResultat(
    trin = personskat_monetaere_trin(),
    alle_trin_navngivet = all(personskat_monetaere_trin(), |trin: PersonskatMonetærtTrin| trin.navn != ""),
    antal_offentlige_slutskattetrin = length(personskat_monetaere_offentlige_slutskattetrin()),
    antal_bekræftede_præcisionstab = length(personskat_monetaere_bekræftede_præcisionstab())
)

= personskat_monetaer_audit = personskat_monetaer_audit_resultat()

| personskat_monetaer_audit_har_komplet_stagekontrakt: personskat_monetaer_audit -> length(personskat_monetaer_audit.trin) == 16 && personskat_monetaer_audit.alle_trin_navngivet && personskat_monetaer_audit.antal_offentlige_slutskattetrin == 13
| personskat_monetaer_audit_adskiller_satser_og_fordelingsnaevnere: personskat_monetaer_audit -> personskat_monetaer_procentkomponent_trin.beregningsenheder == [Basispoint] && personskat_monetaer_par14_trin.beregningsenheder == [Fordelingsnævner] && personskat_monetaer_par20_trin.beregningsenheder == [ReguleringsTiendedele] && personskat_monetaer_dis_forholdsmaessig_lempelse_trin.beregningsenheder == [Fordelingsnævner] && personskat_monetaer_ejendomsskat_broek_trin.beregningsenheder == [PromilleTiendedele, Basispoint, Fordelingsnævner]
| personskat_monetaer_audit_har_ingen_bekræftede_præcisionstab: personskat_monetaer_audit -> personskat_monetaer_audit.antal_bekræftede_præcisionstab == 0

? personskat_monetaer_genberegning_er_ikke_additiv_i_kroner
? personskat_monetaer_genberegning_er_ikke_additiv_i_øre
? personskat_monetaer_nærmeste_krone_adskilles_fra_nedrunding
? personskat_monetaer_par14_positive_og_negative_halver
? personskat_monetaer_par20_runder_kun_naar_noedvendigt
? personskat_monetaer_a_skattegrundlag_nedrundes_til_ti
? personskat_monetaer_dis_lempelse_bevarer_forholdsbroek_og_ørerest
? personskat_monetaer_ejendomsskat_bevarer_øre_foer_projektion
? personskat_monetaer_ørebroek_bevarer_taeller_og_naevner
? personskat_monetaer_overskydende_skat_bevarer_øre_til_lovgraensen
? personskat_monetaer_restskat_bevarer_øre_til_lovgraensen
? personskat_monetaer_eksakt_slutskat_bevarer_komponenters_ørerester
? personskat_monetaer_audit_har_komplet_stagekontrakt
? personskat_monetaer_audit_adskiller_satser_og_fordelingsnaevnere
? personskat_monetaer_audit_har_ingen_bekræftede_præcisionstab

@ print("Personskat monetære trin: " + vis(length(personskat_monetaer_audit.trin)))
@ print("Offentlige slutskattetrin: " + vis(personskat_monetaer_audit.antal_offentlige_slutskattetrin))
@ print("Bekræftede præcisionstab: " + vis(personskat_monetaer_audit.antal_bekræftede_præcisionstab))
