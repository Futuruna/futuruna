@ sprog da

@ importer ./ligningsloven_fradrag
@ importer ./personskat.calculate

-- Fokuserede scenarier for Ligningslovens § 9 D og den kanoniske Personskat-bro.

| ll9d_scenarie_egen_bil_input(skatteår: Heltal, årlige_kilometer: Heltal) -> Ligningslov9DInput(
    skatteår = skatteår,
    befordringsformål = Par9DArbejdsplads,
    kvalifikationsgrundlag = Par9DKroniskSygdomMedNødvendigeSærligeUdgifter,
    normaludgiftsgrundlag = Ll9dEgetBefordringsmiddelNårOffentligBefordringIkkeKanAnvendes(årlige_kilometer = årlige_kilometer),
    faktisk_udgiftsgrundlag = Ll9dErhvervssatsForNødvendigEgenBil(årlige_kilometer = årlige_kilometer)
)

| ll9d_scenarie_dokumenteret_input(skatteår: Heltal) -> Ligningslov9DInput(
    skatteår = skatteår,
    befordringsformål = Par9DArbejdsplads,
    kvalifikationsgrundlag = Par9DVarigtNedsatFunktionsevneMedNødvendigeSærligeUdgifter,
    normaludgiftsgrundlag = Ll9dBilligsteOffentligeBefordringsmiddel(årlig_udgift_kroner = 3000),
    faktisk_udgiftsgrundlag = Ll9dDokumenteredeFaktiskeBefordringsudgifter(beløb_kroner = 10000)
)

| ll9d_scenarie_egenbetaling_uden_tilskud() -> Ll9dSkattepligtigeHarSelvAfholdtUdgiften(
    skattefrit_tilskud = Ll9dIntetSkattefritTilskud
)

| ll9d_scenarie_personskat_fakta(input: Ligningslov9DInput, befordringsformål: Ligningslov9CBefordringsformål, bopæl_i_yderkommune_eller_lille_ø: Boolsk, modtaget_skattefri_godtgørelse: Boolsk, arbejdsgiverbetalt_befordring: PersonskatArbejdsgiverbetaltBefordring, skattefrit_tilskud: Ligningslov9DSkattefritTilskud) -> PersonskatBefordringsfradragFakta(
    identifikation = "ll9d-scenarie-" + vis(input.skatteår),
    befordringsmål_identifikation = "fast-arbejds-eller-uddannelsessted",
    arbejdsdage = 200,
    daglige_befordringskilometer = 30,
    bopæl_i_yderkommune_eller_lille_ø = bopæl_i_yderkommune_eller_lille_ø,
    befordringsformål = befordringsformål,
    modtaget_skattefri_befordringsgodtgørelse_for_strækning = modtaget_skattefri_godtgørelse,
    modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = Falskt,
    ligningslov9d = MedLigningslov9D(
        input = input,
        skattefrit_tilskud = skattefrit_tilskud
    ),
    fradrag_udelukket_folketingshverv_m_v = Falskt,
    arbejdsgiverbetalt_befordring = arbejdsgiverbetalt_befordring,
    broer = ll9c_ingen_bropassager(),
    særlig_transport = ll9c_ingen_særlig_transport()
)

= ll9d_scenarie_2023 = ll9d_resultat(ll9d_scenarie_egen_bil_input(2023, 6000), ll9d_scenarie_egenbetaling_uden_tilskud())
= ll9d_scenarie_2024 = ll9d_resultat(ll9d_scenarie_egen_bil_input(2024, 6000), ll9d_scenarie_egenbetaling_uden_tilskud())
