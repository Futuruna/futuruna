    betalingsforhold = Ll9dSkattepligtigeHarSelvAfholdtUdgiften(
        skattefrit_tilskud = Ll9dSkattefritServicelovstilskud(beløb_kroner = 10001)
    )
)
= ll9d_scenarie_arbejdsgiverbetalt = ll9d_resultat(ll9d_scenarie_dokumenteret_input(2026), Ll9dArbejdsgiverHarBetaltBefordringen)
= ll9d_scenarie_skattefri_godtgørelse = ll9d_resultat(ll9d_scenarie_dokumenteret_input(2026), Ll9dSkattefriGodtgørelseEfterPar9BModtaget)
= ll9d_scenarie_uden_kvalifikation = ll9d_resultat(Ligningslov9DInput(
    skatteår = 2026,
    befordringsformål = Par9DArbejdsplads,
    kvalifikationsgrundlag = Par9DKvalifikationIkkeGodtgjort,
    normaludgiftsgrundlag = Ll9dBilligsteOffentligeBefordringsmiddel(årlig_udgift_kroner = 3000),
    faktisk_udgiftsgrundlag = Ll9dDokumenteredeFaktiskeBefordringsudgifter(beløb_kroner = 10000)
    ), ll9d_scenarie_egenbetaling_uden_tilskud())
= ll9d_scenarie_uden_afholdt_udgift_input = Ligningslov9DInput(
