    faktisk_udgiftsgrundlag = Ll9dDokumenteredeFaktiskeBefordringsudgifter(beløb_kroner = 0)
)
= ll9d_scenarie_uden_afholdt_udgift = ll9d_resultat(ll9d_scenarie_uden_afholdt_udgift_input, Ll9dIngenUdgiftAfholdt)

= ll9d_scenarie_2025_personskat_fakta = ll9d_scenarie_personskat_fakta(
