--@label:ligningsloven_par13_kontingentfradrag::meta:ligningsloven_par13_metadata--
----
§ 13. Ved opgørelsen af den skattepligtige indkomst kan fradrages udgifter til
kontingenter til arbejdsgiverforeninger, fagforeninger og andre faglige
sammenslutninger, der har til hovedformål at varetage de økonomiske interesser
for den erhvervsgruppe, hvortil den skattepligtige hører. Det årlige fradrag
efter 1. pkt. kan ikke overstige et beløb på 7.000 kr. 2. pkt. finder dog ikke
anvendelse for selvstændigt erhvervsdrivende og selskaber m.v. (juridiske
personer). Erstatninger eller ydelser, der udbetales til medlemmerne af
sammenslutninger som nævnt i 1. pkt., medregnes til modtagerens skattepligtige
indkomst, jf. dog §§ 30 og 31.

Stk. 2. Fradrag efter stk. 1 er betinget af, at den faglige forening, hvis den
er indberetningspligtig efter skatteindberetningslovens § 31, har indberettet
kontingentudgiften til told- og skatteforvaltningen.
----

--@begin::ligningsloven_par13_kontingentfradrag--
# Ligningslov13Skatteyderstatus = Ll13Lønmodtager | Ll13SelvstændigtErhvervsdrivende | Ll13JuridiskPerson
# Ligningslov13Foreningsart = Ll13Arbejdsgiverforening | Ll13Fagforening | Ll13AndenFagligSammenslutning | Ll13AndenForening
# Ligningslov13Indberetningsstatus = Ll13IkkeIndberetningspligtig | Ll13IndberettetEfterSkatteindberetningslov31 | Ll13IkkeIndberettetEfterSkatteindberetningslov31
# Ligningslov13Kontingentperiode(fra_dato: Dato, til_dato: Dato)
# Ligningslov13KontingentFakta(identifikation: Tekst, forening_identifikation: Tekst, indkomstår: Heltal, periode: Ligningslov13Kontingentperiode, foreningsart: Ligningslov13Foreningsart, betalt_kontingent_kroner: Heltal, foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner: Heltal, foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser: Boolsk, skatteyder_hører_til_erhvervsgruppen: Boolsk, indberetningsstatus: Ligningslov13Indberetningsstatus)
# Ligningslov13Årsinput(skatteyderstatus: Ligningslov13Skatteyderstatus, kontingenter: List(Ligningslov13KontingentFakta))
# Ligningslov13KontingentResultat(fakta: Ligningslov13KontingentFakta, input_gyldigt: Boolsk, periode_gyldig: Boolsk, foreningens_opgjorte_andel_gyldig: Boolsk, foreningsart_omfattet: Boolsk, hovedformål_og_erhvervsgruppe_opfyldt: Boolsk, indberetningsbetingelse_opfyldt: Boolsk, fradragsberettiget: Boolsk, fradragsberettiget_før_årsloft_kroner: Heltal)
# Ligningslov13Årsresultat(indkomstår: Heltal, input: Ligningslov13Årsinput, kontingentresultater: List(Ligningslov13KontingentResultat), skatteår_understøttet: Boolsk, identifikationer_entydige: Boolsk, foreningsfakta_konsistente: Boolsk, kontingentperioder_ikke_overlappende: Boolsk, alle_input_gyldige: Boolsk, fradrag_før_årsloft_kroner: Heltal, årsloft_kroner: Heltal, samlet_fradrag_kroner: Heltal, ikke_fradraget_kroner: Heltal)
# Ligningslov13ForeningsydelseFakta(identifikation: Tekst, indkomstår: Heltal, foreningsart: Ligningslov13Foreningsart, beløb_kroner: Heltal, foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser: Boolsk, modtager_hører_til_erhvervsgruppen: Boolsk, modtager_er_medlem: Boolsk, undtagelse: Ligningslov30Og31Undtagelse)
# Ligningslov13ForeningsydelseResultat(fakta: Ligningslov13ForeningsydelseFakta, input_gyldigt: Boolsk, foreningsart_omfattet: Boolsk, hovedformål_og_erhvervsgruppe_opfyldt: Boolsk, modtager_er_medlem: Boolsk, undtagelsesresultat: Ligningslov30Og31Undtagelsesresultat, kan_sammensættes: Boolsk, skattefri_beløb_kroner: Heltal, skattepligtigt_beløb_kroner: Heltal)

| ligningslov13_skatteår_understøttet(indkomstår: Heltal) -> indkomstår == 2025 || indkomstår == 2026
| ligningslov13_foreningsart_omfattet(art: Ligningslov13Foreningsart) -> art == Ll13Arbejdsgiverforening || art == Ll13Fagforening || art == Ll13AndenFagligSammenslutning
| ligningslov13_indberetningsbetingelse_opfyldt(status: Ligningslov13Indberetningsstatus) -> status == Ll13IkkeIndberetningspligtig || status == Ll13IndberettetEfterSkatteindberetningslov31
| ligningslov13_foreningsydelse_yderrelation(art: Ligningslov13Foreningsart) -> match art {
    | Ll13Fagforening -> Ll30Og31Fagforening
    | Ll13AndenFagligSammenslutning -> Ll30Og31AndenFagligSammenslutning
    | _ -> Ll30Og31AndenYder
}
| ligningslov13_foreningsydelse_resultat(fakta: Ligningslov13ForeningsydelseFakta) -> {
    = foreningsart_omfattet = ligningslov13_foreningsart_omfattet(fakta.foreningsart)
    = hovedformål_og_erhvervsgruppe_opfyldt = fakta.foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser && fakta.modtager_hører_til_erhvervsgruppen
    = undtagelsesresultat = ligningslov30_og_31_undtagelsesresultat(fakta.indkomstår, ligningslov13_foreningsydelse_yderrelation(fakta.foreningsart), fakta.beløb_kroner, fakta.undtagelse)
    = input_gyldigt = fakta.identifikation != "" && ligningslov13_skatteår_understøttet(fakta.indkomstår) && fakta.beløb_kroner >= 0 && undtagelsesresultat.input_gyldigt
    = kan_sammensættes = input_gyldigt && foreningsart_omfattet && hovedformål_og_erhvervsgruppe_opfyldt && fakta.modtager_er_medlem
    Ligningslov13ForeningsydelseResultat(
        fakta = fakta,
        input_gyldigt = input_gyldigt,
        foreningsart_omfattet = foreningsart_omfattet,
        hovedformål_og_erhvervsgruppe_opfyldt = hovedformål_og_erhvervsgruppe_opfyldt,
        modtager_er_medlem = fakta.modtager_er_medlem,
        undtagelsesresultat = undtagelsesresultat,
        kan_sammensættes = kan_sammensættes,
        skattefri_beløb_kroner = hvis kan_sammensættes { undtagelsesresultat.skattefri_beløb_kroner } ellers { 0 },
        skattepligtigt_beløb_kroner = hvis kan_sammensættes { undtagelsesresultat.skattepligtigt_beløb_kroner } ellers { 0 }
    )
}

# Ligningslov13KontingentSag(indkomstår: Heltal, fakta: Ligningslov13KontingentFakta) {
    | periode_gyldig() -> dato_gyldig(fakta.periode.fra_dato) && dato_gyldig(fakta.periode.til_dato) && fakta.periode.fra_dato.år == indkomstår && fakta.periode.til_dato.år == indkomstår && dato_før_eller_lig_med(fakta.periode.fra_dato, fakta.periode.til_dato)
    | foreningens_opgjorte_andel_gyldig() -> fakta.foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner >= 0 && fakta.foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner <= fakta.betalt_kontingent_kroner
    | input_gyldigt() -> fakta.identifikation != "" && fakta.forening_identifikation != "" && fakta.indkomstår == indkomstår && fakta.betalt_kontingent_kroner >= 0 && periode_gyldig() && foreningens_opgjorte_andel_gyldig()
    | foreningsart_omfattet() -> ligningslov13_foreningsart_omfattet(fakta.foreningsart)
    | hovedformål_og_erhvervsgruppe_opfyldt() -> fakta.foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser && fakta.skatteyder_hører_til_erhvervsgruppen
    | indberetningsbetingelse_opfyldt() -> ligningslov13_indberetningsbetingelse_opfyldt(fakta.indberetningsstatus)
    | fradragsberettiget() -> input_gyldigt() && foreningsart_omfattet() && hovedformål_og_erhvervsgruppe_opfyldt() && indberetningsbetingelse_opfyldt()
    | fradragsberettiget_før_årsloft_kroner() -> hvis fradragsberettiget() { fakta.foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner } ellers { 0 }
    | resultat() -> Ligningslov13KontingentResultat(
        fakta = fakta,
        input_gyldigt = input_gyldigt(),
        periode_gyldig = periode_gyldig(),
        foreningens_opgjorte_andel_gyldig = foreningens_opgjorte_andel_gyldig(),
        foreningsart_omfattet = foreningsart_omfattet(),
        hovedformål_og_erhvervsgruppe_opfyldt = hovedformål_og_erhvervsgruppe_opfyldt(),
        indberetningsbetingelse_opfyldt = indberetningsbetingelse_opfyldt(),
        fradragsberettiget = fradragsberettiget(),
        fradragsberettiget_før_årsloft_kroner = fradragsberettiget_før_årsloft_kroner()
    )
}

| ligningslov13_kontingent_resultat(indkomstår: Heltal, fakta: Ligningslov13KontingentFakta) -> Ligningslov13KontingentSag(indkomstår, fakta).resultat()
| ligningslov13_identifikationer_entydige(kontingenter: List(Ligningslov13KontingentFakta)) -> length(distinct(map(kontingenter, |fakta: Ligningslov13KontingentFakta| fakta.identifikation))) == length(kontingenter) && all(kontingenter, |fakta: Ligningslov13KontingentFakta| fakta.identifikation != "")
| ligningslov13_foreningsfakta_svarer(a: Ligningslov13KontingentFakta, b: Ligningslov13KontingentFakta) -> a.forening_identifikation != b.forening_identifikation || a.foreningsart == b.foreningsart && a.foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser == b.foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser && a.skatteyder_hører_til_erhvervsgruppen == b.skatteyder_hører_til_erhvervsgruppen
| ligningslov13_foreningsfakta_konsistente(kontingenter: List(Ligningslov13KontingentFakta)) -> all(kontingenter, |a: Ligningslov13KontingentFakta| all(kontingenter, |b: Ligningslov13KontingentFakta| ligningslov13_foreningsfakta_svarer(a, b)))
| ligningslov13_kontingentperioder_overlapper(a: Ligningslov13KontingentFakta, b: Ligningslov13KontingentFakta) -> a.identifikation != b.identifikation && a.forening_identifikation == b.forening_identifikation && dato_før_eller_lig_med(a.periode.fra_dato, b.periode.til_dato) && dato_før_eller_lig_med(b.periode.fra_dato, a.periode.til_dato)
| ligningslov13_kontingentperioder_ikke_overlappende(kontingenter: List(Ligningslov13KontingentFakta)) -> all(kontingenter, |a: Ligningslov13KontingentFakta| all(kontingenter, |b: Ligningslov13KontingentFakta| ligningslov13_kontingentperioder_overlapper(a, b) == Falskt))
| ligningslov13_fradrag_før_årsloft_kroner(resultater: List(Ligningslov13KontingentResultat)) -> foldl(resultater, 0, |sum_kroner: Heltal, resultat: Ligningslov13KontingentResultat| sum_kroner + resultat.fradragsberettiget_før_årsloft_kroner)
| ligningslov13_betalt_kontingent_kroner(kontingenter: List(Ligningslov13KontingentFakta)) -> foldl(kontingenter, 0, |sum_kroner: Heltal, fakta: Ligningslov13KontingentFakta| sum_kroner + penge_positivt_beløb(fakta.betalt_kontingent_kroner))
| ligningslov13_årsloft_kroner(indkomstår: Heltal, skatteyderstatus: Ligningslov13Skatteyderstatus) -> 7000
| exception ligningslov13_selvstændig_uden_årsloft ligningslov13_årsloft_kroner(indkomstår: Heltal, skatteyderstatus: Ligningslov13Skatteyderstatus) -> 0 under skatteyderstatus == Ll13SelvstændigtErhvervsdrivende
| exception ligningslov13_juridisk_person_uden_årsloft ligningslov13_årsloft_kroner(indkomstår: Heltal, skatteyderstatus: Ligningslov13Skatteyderstatus) -> 0 under skatteyderstatus == Ll13JuridiskPerson
| ligningslov13_fradrag_efter_årsloft_kroner(skatteyderstatus: Ligningslov13Skatteyderstatus, fradrag_før_årsloft_kroner: Heltal) -> penge_mindste_beløb(fradrag_før_årsloft_kroner, 7000)
| exception ligningslov13_selvstændig_får_fuldt_fradrag ligningslov13_fradrag_efter_årsloft_kroner(skatteyderstatus: Ligningslov13Skatteyderstatus, fradrag_før_årsloft_kroner: Heltal) -> fradrag_før_årsloft_kroner under skatteyderstatus == Ll13SelvstændigtErhvervsdrivende
| exception ligningslov13_juridisk_person_får_fuldt_fradrag ligningslov13_fradrag_efter_årsloft_kroner(skatteyderstatus: Ligningslov13Skatteyderstatus, fradrag_før_årsloft_kroner: Heltal) -> fradrag_før_årsloft_kroner under skatteyderstatus == Ll13JuridiskPerson
| ligningslov13_årsresultat(indkomstår: Heltal, input: Ligningslov13Årsinput) -> {
    = kontingentresultater = map(input.kontingenter, |fakta: Ligningslov13KontingentFakta| ligningslov13_kontingent_resultat(indkomstår, fakta))
    = skatteår_understøttet = length(input.kontingenter) == 0 || ligningslov13_skatteår_understøttet(indkomstår)
    = identifikationer_entydige = ligningslov13_identifikationer_entydige(input.kontingenter)
    = foreningsfakta_konsistente = ligningslov13_foreningsfakta_konsistente(input.kontingenter)
    = kontingentperioder_ikke_overlappende = ligningslov13_kontingentperioder_ikke_overlappende(input.kontingenter)
    = alle_input_gyldige = skatteår_understøttet && identifikationer_entydige && foreningsfakta_konsistente && kontingentperioder_ikke_overlappende && all(kontingentresultater, |resultat: Ligningslov13KontingentResultat| resultat.input_gyldigt)
    = fradrag_før_årsloft_kroner = ligningslov13_fradrag_før_årsloft_kroner(kontingentresultater)
    = samlet_fradrag_kroner = hvis alle_input_gyldige { ligningslov13_fradrag_efter_årsloft_kroner(input.skatteyderstatus, fradrag_før_årsloft_kroner) } ellers { 0 }
    Ligningslov13Årsresultat(
        indkomstår = indkomstår,
        input = input,
        kontingentresultater = kontingentresultater,
        skatteår_understøttet = skatteår_understøttet,
        identifikationer_entydige = identifikationer_entydige,
        foreningsfakta_konsistente = foreningsfakta_konsistente,
        kontingentperioder_ikke_overlappende = kontingentperioder_ikke_overlappende,
        alle_input_gyldige = alle_input_gyldige,
        fradrag_før_årsloft_kroner = fradrag_før_årsloft_kroner,
        årsloft_kroner = ligningslov13_årsloft_kroner(indkomstår, input.skatteyderstatus),
        samlet_fradrag_kroner = samlet_fradrag_kroner,
        ikke_fradraget_kroner = ligningslov13_betalt_kontingent_kroner(input.kontingenter) - samlet_fradrag_kroner
    )
}
--@end::ligningsloven_par13_kontingentfradrag--

