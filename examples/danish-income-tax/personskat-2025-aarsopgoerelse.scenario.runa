@ importer ./loenmodtager_beregning
@ importer ./loenmodtager - eksakt - skat
@ importer ./slutopgoerelse
@ importer ./metadata
@ importer ./ligningsloven - par33
@ importer ./personskat.calculate

-- Anonymiseret realitetstest mod en privat årsopgørelse for indkomståret 2025.
-- Personnummer, navn, adresser og ejendomsidentifikationer er bevidst udeladt.

----
Årsopgørelsens indkomstgrundlag, beløb i hele kroner:

Løn før arbejdsmarkedsbidrag: 817.097
Arbejdsmarkedsbidrag: 65.367
Gruppeliv og øvrige arbejdsgiverbetalte ydelser: 507
Arbejdsgiveradministreret pensionsbeløb efter arbejdsmarkedsbidrag: 911
Privat livrenteindbetaling: 844
Virksomhedsunderskud: 2.368

Rente- og investeringsindtægter i kapitalindkomsten: 9, 2.310 og 2.693
Renteudgifter i kapitalindkomsten: 18.884 og 22.532

Fagforening: 3.513
A-kasse mv.: 5.988
Gaver: 2.160
Beskæftigelsesfradrag: 55.600
Jobfradrag: 2.900
Ekstra pensionsfradrag: 495

Ægtefællens overførte underskud: 39.617
Aktieindkomst: 14.967

Specifikation af aktieindkomst og nedslag, beløb i kroner:

Udenlandsk aktieudbytte i dansk depot: 398
Aktieskat 27 pct.: 4.041,09
Forholdsmæssigt dansk skatteloft: 4.041,09 * 398 / 14.967
Godkendt udenlandsk skat og nedslag efter creditprincippet: 6,00
----

----
Afgrænsning:

Dette scenarie er et resultatbaseret afstemningsorakel. Dets lokale
sammenfatninger må ikke bruges som rå felter i den kanoniske Personskat-kontrakt.
Den typede grænse mellem årsopgørelsens linjer og beregningens kildefakta ligger
i `personskat-aarsopgoerelse-kildemapping.runa`; den afviser eller efterspørger
supplerende fakta, når en linje kun viser et beregnet eller aggregeret resultat.
----

# Årsopgørelse2025PersonligFakta(løn_før_am_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal, gruppeliv_og_ydelser_kroner: Heltal, arbejdsgiverpension_efter_am_kroner: Heltal, privat_livrente_kroner: Heltal, virksomhedsunderskud_kroner: Heltal)
# Årsopgørelse2025KapitalFakta(renteindtægt_kroner: Heltal, investeringsudlodning_kroner: Heltal, investeringsgevinst_kroner: Heltal, realkreditrenter_kroner: Heltal, bankrenter_kroner: Heltal)
# Årsopgørelse2025Fradragsfakta(fagforening_kroner: Heltal, a_kasse_mv_kroner: Heltal, gaver_kroner: Heltal, beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, pensionsgrundlag_kroner: Heltal, ekstra_pensionsfradrag_basispoint: Heltal)
# Årsopgørelse2025ÆgtefælleKildeFakta(renteudgifter_kroner: Heltal, samlevende_ved_indkomstårets_udløb: Boolsk)
# Årsopgørelse2025Forudbetaling(a_skat_kroner: Heltal, indeholdt_am_kroner: Heltal, udbytteskat_øre: Heltal, tidligere_udbetalt_overskydende_skat_øre: Heltal, afrunding_øre: Heltal)
# Årsopgørelse2025Afstemning(lovberegnet_skat_øre: Heltal, årsopgørelsens_beregnede_skat_øre: Heltal, uforklaret_forskel_øre: Heltal, forskellens_proveniens_afklaret: Boolsk)
# Årsopgørelse2025PrivatKildeInfo(dokumenttype: Tekst, indkomstår: Heltal, side: Heltal, persondata_udeladt: Boolsk)

= årsopgørelse2025_ligningslov33_kilde = Årsopgørelse2025PrivatKildeInfo(
    dokumenttype = "Privat årsopgørelse",
    indkomstår = 2025,
    side = 4,
    persondata_udeladt = Sandt
)
= årsopgørelse2025_ligningslov33_metadata = Metadata(
    attachments = (
        Source(value = årsopgørelse2025_ligningslov33_kilde),
        DependencySource(value = ligningsloven_lbk1500_par33),
    )
)

= årsopgørelse2025_personlig = Årsopgørelse2025PersonligFakta(
    løn_før_am_kroner = 817097,
    arbejdsmarkedsbidrag_kroner = 65367,
    gruppeliv_og_ydelser_kroner = 507,
    arbejdsgiverpension_efter_am_kroner = 911,
    privat_livrente_kroner = 844,
    virksomhedsunderskud_kroner = 2368
)

= årsopgørelse2025_kapital = Årsopgørelse2025KapitalFakta(
    renteindtægt_kroner = 9,
    investeringsudlodning_kroner = 2310,
    investeringsgevinst_kroner = 2693,
    realkreditrenter_kroner = 18884,
    bankrenter_kroner = 22532
)

= årsopgørelse2025_fradrag = Årsopgørelse2025Fradragsfakta(
    fagforening_kroner = 3513,
    a_kasse_mv_kroner = 5988,
    gaver_kroner = 2160,
    beskæftigelsesfradrag_kroner = 55600,
    jobfradrag_kroner = 2900,
    pensionsgrundlag_kroner = 4123,
    ekstra_pensionsfradrag_basispoint = 1200
)

----
Årsopgørelsen viser de modtagne ægtefælleoverførsler, men ikke ægtefællens
underliggende indkomstposter. Den minimale kilderekonstruktion nedenfor har
ingen løn eller anden indkomst og 39.617 kr. i renteudgifter. Reglerne skal
selv udlede de tre beløb, som årsopgørelsen viser virkningen af.
----

= årsopgørelse2025_ægtefælle = Årsopgørelse2025ÆgtefælleKildeFakta(
    renteudgifter_kroner = 39617,
    samlevende_ved_indkomstårets_udløb = Sandt
)

= årsopgørelse2025_ejendom = EjendomsskattelovOrdinærPersonEjendomFakta(
    identifikation = "anonymiseret-ejerbolig",
    kommune = København,
    kategori = EjskEnBoligenhed,
    beliggenhed = EjskDanmark,
    erhvervsmæssigt_udlejet = Falskt,
    særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt,
    ejendomsværdi_kroner = 3710000,
    grundværdi_kroner = 3363000,
    produktionsjord = Falskt,
    ejendomsværdiskatteperiode = EjendomsskatFraOgMed(EjendomsskattelovDato(år = 2025, måned = 8, dag = 1)),
    grundskyldsperiode = EjendomsskatFraOgMed(EjendomsskattelovDato(år = 2025, måned = 8, dag = 1)),
    ejerandel_basispoint = 5000
)
= årsopgørelse2025_ejendom_resultat = ejendomsskattelov_ordinær_person_ejendom_resultat(2025, årsopgørelse2025_ejendom)

= årsopgørelse2025_forudbetaling = Årsopgørelse2025Forudbetaling(
    a_skat_kroner = 258036,
    indeholdt_am_kroner = 65368,
    udbytteskat_øre = 435314,
    tidligere_udbetalt_overskydende_skat_øre = 3708400,
    afrunding_øre = 0 - 80
)
= årsopgørelse2025_årsopgørelsens_beregnede_skat_øre = 29059034
= årsopgørelse2025_par60_kreditter = KildeskatPar60KreditterØre(
    a_skat_og_am_indeholdt_øre = årsopgørelse2025_forudbetaling.a_skat_kroner * 100 + årsopgørelse2025_forudbetaling.indeholdt_am_kroner * 100,
    par68_indbetalt_øre = 0,
    b_skat_betalt_øre = 0,
    udbytteskat_modregningsberettiget_øre = årsopgørelse2025_forudbetaling.udbytteskat_øre,
    frivillig_indbetaling_par59_øre = 0,
    virksomhedsordning_beløb_øre = 0,
    personskattelov_par8a_stk5_beløb_øre = 0,
    afskrivningslov_acontoskat_øre = 0,
    am_lov_par6_beløb_øre = 0,
    seniornedslag_øre = 0,
    energiafgiftskompensation_øre = 0,
    tilbagebetalt_par55_øre = årsopgørelse2025_forudbetaling.tidligere_udbetalt_overskydende_skat_øre
)
= årsopgørelse2025_nationale_parametre = nationalparametre_for(2025)
= årsopgørelse2025_kommunale_parametre = kommunale_parametre_for(2025, Frederiksberg)
= årsopgørelse2025_personfradrag_kroner = personfradrag_beløb_for(2025, Fyldt18EllerGift)

--@label:årsopgørelse2025_ligningslov33_nedslag::meta:årsopgørelse2025_ligningslov33_metadata--
----
Årsopgørelsens side 4 viser en dansk aktieskat på 4.041,09 kr. og beregner
det forholdsmæssige danske skatteloft med brøken 398 / 14.967. Den godkendte
udenlandske skat på 6,00 kr. er mindre end loftet og bliver derfor årets
nedslag for udenlandsk aktieudbytte efter creditprincippet.
----

--@begin:årsopgørelse2025_ligningslov33_nedslag--

= årsopgørelse2025_ligningslov33_input = Ligningslov33Årsinput(
    dansk_bruttoindkomst_kroner = 14569,
    ikke_henførbare_udgifter_kroner = 0,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
    landelinjer = [Ligningslov33LandelinjeFakta(
        indkomstfakta = Ligningslov33Indkomstfakta(
            område = Ll33FremmedStat("anonymiseret"),
            udenlandsk_bruttoindkomst_kroner = 398,
            direkte_henførbare_udgifter_kroner = 0
        ),
        skattebetaling = Ligningslov33Skattebetaling(
            opkrævningsmåde = Ll33Indeholdelse,
            betalt_udenlandsk_skat_øre = 600,
            skatteart = Ll33Indkomstskat,
            betalingsdokumentreference = "Anonymiseret privat årsopgørelse 2025, side 2",
            overenskomstgrundlag = Ll33SkatteforvaltningenFastsatSkat(
                fradragsberettiget_udenlandsk_skat_øre = 600,
                dokumentreference = "Anonymiseret privat årsopgørelse 2025, side 4"
            )
        )
    )]
)
= årsopgørelse2025_ligningslov33_resultat = ligningslov33_årsresultat(
    årsopgørelse2025_ligningslov33_input,
    Ligningslov33DanskSkattekreds(
        samlet_beskattet_indkomst_kroner = 14967,
        dansk_skat_før_nedslag_øre = årsopgørelse2025_aktieindkomstskat_øre()
    )
)

--@end:årsopgørelse2025_ligningslov33_nedslag--

| årsopgørelse2025_personlig_indkomst_kroner(fakta: Årsopgørelse2025PersonligFakta) -> fakta.løn_før_am_kroner - fakta.arbejdsmarkedsbidrag_kroner + fakta.gruppeliv_og_ydelser_kroner + fakta.arbejdsgiverpension_efter_am_kroner - fakta.privat_livrente_kroner - fakta.virksomhedsunderskud_kroner
| årsopgørelse2025_nettokapitalindkomst_kroner(fakta: Årsopgørelse2025KapitalFakta) -> fakta.renteindtægt_kroner + fakta.investeringsudlodning_kroner + fakta.investeringsgevinst_kroner - fakta.realkreditrenter_kroner - fakta.bankrenter_kroner
| årsopgørelse2025_ekstra_pensionsfradrag_kroner(fakta: Årsopgørelse2025Fradragsfakta) -> penge_beløb_gange_basispoint_afrundet_kroner(fakta.pensionsgrundlag_kroner, fakta.ekstra_pensionsfradrag_basispoint)
| årsopgørelse2025_øvrige_ligningsfradrag_kroner(fakta: Årsopgørelse2025Fradragsfakta) -> fakta.fagforening_kroner + fakta.a_kasse_mv_kroner + fakta.gaver_kroner
| årsopgørelse2025_samlede_ligningsfradrag_kroner(fakta: Årsopgørelse2025Fradragsfakta) -> årsopgørelse2025_øvrige_ligningsfradrag_kroner(fakta) + fakta.beskæftigelsesfradrag_kroner + fakta.jobfradrag_kroner + årsopgørelse2025_ekstra_pensionsfradrag_kroner(fakta)
| årsopgørelse2025_skattepligtig_indkomst_kroner(personlig: Årsopgørelse2025PersonligFakta, kapital: Årsopgørelse2025KapitalFakta, fradrag: Årsopgørelse2025Fradragsfakta, overført_underskud_kroner: Heltal) -> årsopgørelse2025_personlig_indkomst_kroner(personlig) + årsopgørelse2025_nettokapitalindkomst_kroner(kapital) - årsopgørelse2025_samlede_ligningsfradrag_kroner(fradrag) - overført_underskud_kroner

| årsopgørelse2025_skat_øre(grundlag_kroner: Heltal, sats_basispoint: Heltal) -> grundlag_kroner * sats_basispoint / 100
| årsopgørelse2025_bundskat_øre() -> årsopgørelse2025_skat_øre(årsopgørelse2025_personlig_indkomst_kroner(årsopgørelse2025_personlig), årsopgørelse2025_nationale_parametre.bundskat_basispoint)
| årsopgørelse2025_topskat_øre() -> årsopgørelse2025_skat_øre(årsopgørelse2025_personlig_indkomst_kroner(årsopgørelse2025_personlig) - årsopgørelse2025_nationale_parametre.topskattegrænse_efter_am_kroner, årsopgørelse2025_nationale_parametre.topskat_basispoint)
| årsopgørelse2025_kommuneskat_øre() -> årsopgørelse2025_skat_øre(årsopgørelse2025_skattepligtig_indkomst_kroner(årsopgørelse2025_personlig, årsopgørelse2025_kapital, årsopgørelse2025_fradrag, årsopgørelse2025_overført_underskud_kroner), årsopgørelse2025_kommunale_parametre.kommuneskat_basispoint)
| årsopgørelse2025_aktieindkomstskat_øre() -> årsopgørelse2025_skat_øre(14967, årsopgørelse2025_nationale_parametre.aktieindkomst_lav_basispoint)
| årsopgørelse2025_statsligt_personfradrag_øre() -> årsopgørelse2025_skat_øre(årsopgørelse2025_personfradrag_kroner, årsopgørelse2025_nationale_parametre.bundskat_basispoint)
| årsopgørelse2025_kommunalt_personfradrag_øre() -> årsopgørelse2025_skat_øre(årsopgørelse2025_personfradrag_kroner, årsopgørelse2025_kommunale_parametre.kommuneskat_basispoint)
| årsopgørelse2025_statsligt_ægtefællepersonfradrag_øre() -> årsopgørelse2025_skat_øre(personfradrag_beløb_for(2025, Fyldt18EllerGift), årsopgørelse2025_nationale_parametre.bundskat_basispoint)
| årsopgørelse2025_kommunalt_ægtefællepersonfradrag_øre() -> årsopgørelse2025_skat_øre(personfradrag_beløb_for(2025, Fyldt18EllerGift), årsopgørelse2025_kommunale_parametre.kommuneskat_basispoint)
| årsopgørelse2025_eget_negativt_kapitalnedslag_øre() -> årsopgørelse2025_skat_øre(0 - årsopgørelse2025_nettokapitalindkomst_kroner(årsopgørelse2025_kapital), negativ_kapital_nedslag_sats_basispoint(2025))
| årsopgørelse2025_ægtefælles_negativt_kapitalnedslag_øre() -> årsopgørelse2025_skat_øre(årsopgørelse2025_ægtefælle.renteudgifter_kroner, negativ_kapital_nedslag_sats_basispoint(2025))
| årsopgørelse2025_ejendomsværdiskat_øre() -> årsopgørelse2025_ejendom_resultat.ejendomsværdiskat.skat_øre
| årsopgørelse2025_grundskyld_øre() -> årsopgørelse2025_ejendom_resultat.grundskyld.skat_øre
| årsopgørelse2025_komponentberegnet_skat_før_ligningslov33_øre() -> årsopgørelse2025_personlig.arbejdsmarkedsbidrag_kroner * 100 + årsopgørelse2025_bundskat_øre() + årsopgørelse2025_topskat_øre() + årsopgørelse2025_kommuneskat_øre() + årsopgørelse2025_aktieindkomstskat_øre() - årsopgørelse2025_statsligt_personfradrag_øre() - årsopgørelse2025_kommunalt_personfradrag_øre() - årsopgørelse2025_statsligt_ægtefællepersonfradrag_øre() - årsopgørelse2025_kommunalt_ægtefællepersonfradrag_øre() - årsopgørelse2025_eget_negativt_kapitalnedslag_øre() - årsopgørelse2025_ægtefælles_negativt_kapitalnedslag_øre() + årsopgørelse2025_ejendomsværdiskat_øre() + årsopgørelse2025_grundskyld_øre()
| årsopgørelse2025_komponentberegnet_skat_efter_ligningslov33_øre() -> årsopgørelse2025_komponentberegnet_skat_før_ligningslov33_øre() - årsopgørelse2025_ligningslov33_resultat.samlet_nedslag_øre
| årsopgørelse2025_forudbetalt_skat_øre(fakta: Årsopgørelse2025Forudbetaling) -> fakta.a_skat_kroner * 100 + fakta.indeholdt_am_kroner * 100 + fakta.udbytteskat_øre
| årsopgørelse2025_årsopgørelsens_overskydende_skat_øre() -> årsopgørelse2025_forudbetalt_skat_øre(årsopgørelse2025_forudbetaling) - årsopgørelse2025_årsopgørelsens_beregnede_skat_øre
| årsopgørelse2025_årsopgørelsens_udbetaling_nu_øre() -> årsopgørelse2025_årsopgørelsens_overskydende_skat_øre() - årsopgørelse2025_forudbetaling.tidligere_udbetalt_overskydende_skat_øre + årsopgørelse2025_forudbetaling.afrunding_øre

= årsopgørelse2025_slutopgørelsesinput = KildeskatSlutopgørelseEksaktInput(
    slutskat_øre = årsopgørelse2025_årsopgørelsens_beregnede_skat_øre,
    overført_restskat_mv_øre = 0,
    pensionsbeskatningsafgift_øre = 0,
    kreditter = årsopgørelse2025_par60_kreditter
)
= årsopgørelse2025_slutopgørelsesresultat = kildeskat_slutopgørelse_eksakt_resultat(årsopgørelse2025_slutopgørelsesinput)
= årsopgørelse2025_afregningsfakta = KildeskatOverskydendeAfregningEksaktFakta(
    indkomstår = 2025,
    modsvarer_par59_indbetaling_øre = 0,
    tilbagebetalt_rente_par59_øre = 0,
    modsvarer_seniornedslag_øre = 0,
    modsvarer_energiafgiftskompensation_øre = 0,
    restancer_personlig_skat_med_morarenter_øre = 0,
    tilbagebetaling_efter_1_september = Falskt,
    påbegyndte_måneder_efter_1_september = 0
)
= årsopgørelse2025_afregningsresultat = kildeskat_overskydende_afregning_eksakt(årsopgørelse2025_slutopgørelsesresultat, årsopgørelse2025_afregningsfakta)

----
Kanonisk kilderekonstruktion:

Årsopgørelsen dokumenterer beløbene og flere af deres skattemæssige kategorier,
men ikke alle underliggende ordnings- og instrumentvilkår. De supplerende fakta
nedenfor er derfor en minimal, eksplicit rekonstruktion, som skal bekræftes mod
eIndkomst, pensionsoversigter, virksomhedsregnskab og depotoplysninger. De er
ikke udledt af myndighedens beregnede slutskat.

Arbejdsgiverens rateindbetaling på 3.279 kr. efter AM-bidrag er repræsenteret
som 3.564 kr. før og 285 kr. i indeholdt AM-bidrag. Aldersopsparing er valgt som
den konkrete § 19-undtagelse bag de 911 kr.; en anden dokumenteret undtaget
ordning kan erstatte typen uden at ændre dette års beløbsmæssige resultat.
----

| årsopgørelse2025_arbejdsgiverydelse(identifikation: Tekst, ydelse: PersonskatArbejdsgiverydelse) -> PersonskatArbejdsgiverydelseFakta(
    identifikation = identifikation,
    indkomstår = 2025,
    ydelse = ydelse
)
| årsopgørelse2025_pbl18_indbetaling(identifikation: Tekst, ordning: Pbl18Ordning, indbetalingskilde: Pbl18Indbetalingskilde, beløb_før_am_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = identifikation,
    ordning = ordning,
    indbetalingskilde = indbetalingskilde,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = beløb_før_am_kroner,
        forfaldsår = 2025,
        betalingsår = 2025,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsmarkedsbidrag_kroner = arbejdsmarkedsbidrag_kroner
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = Pbl18Indeksvalg(fradragsvalgte_kontraktbidrag_kroner = []),
    indeksordningsgrundlag = Pbl18IkkeIndeksordning,
    forfaldne_ikke_tidligere_fratrukket_kroner = beløb_før_am_kroner,
    særligt_ordningsgrundlag = Pbl18IntetSærligtOrdningsgrundlag,
    begrænsninger = Pbl18Begrænsninger(
        pbl54_personkreds_opfyldt = Sandt,
        afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
        udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Falskt
    )
)

= årsopgørelse2025_arbejdsgiveradministreret_samlepost = ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(
    indberettet_beløb_før_indeholdt_arbejdsmarkedsbidrag_kroner = None,
    indberettet_beløb_efter_indeholdt_arbejdsmarkedsbidrag_kroner = årsopgørelse2025_personlig.arbejdsgiverpension_efter_am_kroner
)
= årsopgørelse2025_personlig_indkomst_input = PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = [
            årsopgørelse2025_arbejdsgiverydelse(
