@ sprog da
@ importer ./ligningsloven_fradrag
@ importer ./ligningsloven - par9j - enlig

-- Aflæste offentlige, fiktive cases; ikke forventninger afledt af modellen.
-- Profil, kilder, beregningskonvention og kendte afvigelser: skatdk-fradrag-oere-ekstern.md.
# SkatDkTillægsfradrag(år: Heltal, fødselsår: Heltal, løn: Heltal, kvartaler: Heltal, senior: Heltal, enlig: Heltal)
= skatdk_tillæg = [
    SkatDkTillægsfradrag(2026, 1960, 100000, 0, 1400, 0),
    SkatDkTillægsfradrag(2026, 1960, 100001, 0, 1401, 0),
    SkatDkTillægsfradrag(2026, 1960, 100286, 0, 1404, 0),
    SkatDkTillægsfradrag(2026, 1960, 100429, 0, 1406, 0),
    SkatDkTillægsfradrag(2026, 1960, 435642, 0, 6099, 0),
    SkatDkTillægsfradrag(2026, 1960, 435643, 0, 6099, 0),
    SkatDkTillægsfradrag(2026, 1960, 435644, 0, 6100, 0),
    SkatDkTillægsfradrag(2025, 1990, 100001, 4, 0, 11501),
    SkatDkTillægsfradrag(2025, 1990, 100010, 3, 0, 8626),
    SkatDkTillægsfradrag(2025, 1990, 100087, 4, 0, 11510),
    SkatDkTillægsfradrag(2026, 1990, 100001, 1, 0, 2876),
    SkatDkTillægsfradrag(2026, 1990, 100010, 3, 0, 8626),
    SkatDkTillægsfradrag(2026, 1990, 100087, 4, 0, 11510),
    SkatDkTillægsfradrag(2026, 1990, 100487, 1, 0, 2889),
    SkatDkTillægsfradrag(2026, 1990, 100661, 3, 0, 8682),
    SkatDkTillægsfradrag(2026, 1990, 100035, 3, 0, 8629),
    SkatDkTillægsfradrag(2026, 1990, 439991, 4, 0, 50599),
    SkatDkTillægsfradrag(2026, 1990, 439992, 4, 0, 50600),
    SkatDkTillægsfradrag(2026, 1990, 600000, 1, 0, 12650)
]
> skatdk_tillæg_matcher(o: SkatDkTillægsfradrag) -> Boolsk {
    = senior = ll9j_senior_resultat(o.år, Dato(år = o.fødselsår, måned = 1, dag = 1), o.løn, Sandt)
    = fakta = OplystEkstraBørnetilskud(
        kvartaler = map(range(1, o.kvartaler + 1), |k: Heltal| Ligningslov9JEnligKvartal(o.år, k, Sandt, Sandt, "fiktiv fuldstændig ydelsesoversigt")),
        oplysninger_for_året_komplette = Sandt
    )
    = enlig = ll9j_enlig_resultat(o.år, o.løn, Sandt, fakta)
    senior.input_gyldigt && enlig.input_gyldigt && senior.fradrag_kroner == o.senior && enlig.fradrag_kroner == o.enlig
}

# SkatDkØrefradrag(år: Heltal, løn: Heltal, beskæftigelse: Heltal, job: Heltal)
= skatdk_ørefradrag = [
    SkatDkØrefradrag(2025, 100187, 12323, 0),
    SkatDkØrefradrag(2025, 100122, 12315, 0),
    SkatDkØrefradrag(2025, 100870, 12408, 0),
    SkatDkØrefradrag(2026, 100251, 12782, 0),
    SkatDkØrefradrag(2026, 100353, 12795, 0),
    SkatDkØrefradrag(2026, 100008, 12752, 0),
    SkatDkØrefradrag(2025, 224589, 27625, 4),
    SkatDkØrefradrag(2026, 235289, 30000, 4)
]
> skatdk_ørefradrag_matcher(o: SkatDkØrefradrag) -> Boolsk {
    = input = LigningslovLønmodtagerFradragInput(o.år, o.løn, Falskt)
    ll_lønmodtager_beskæftigelsesfradrag_kroner(input) == o.beskæftigelse && ll_lønmodtager_jobfradrag_kroner(input) == o.job
}

| skatdk_tillæg_matcher_kilden: skatdk_tillæg -> length(skatdk_tillæg) == 19 && all(skatdk_tillæg, skatdk_tillæg_matcher)
| skatdk_ørefradrag_matcher_kilden: skatdk_ørefradrag -> length(skatdk_ørefradrag) == 8 && all(skatdk_ørefradrag, skatdk_ørefradrag_matcher)
? skatdk_tillæg_matcher_kilden
? skatdk_ørefradrag_matcher_kilden

-- KENDTE AFVIGELSER, IKKE bestået ekstern konformitet. Modellen bevarer
-- nøjagtigt én øre; 2026-beregneren viste én krone mindre i disse to cases.
-- Ingen tolerance gør dem automatisk til match; se dokumentation og opfølgning.
= skatdk_kendte_afvigelser_kroner = [
    ll9j_beskæftigelsesfradrag_kroner(Ligningslov9JInput(2026, 100204, Falskt)) - 12776,
    ll9j_senior_resultat(2026, Dato(år = 1960, måned = 1, dag = 1), 100215, Sandt).fradrag_kroner - 1403
]
| skatdk_kendte_afvigelser_er_synlige: skatdk_kendte_afvigelser_kroner -> skatdk_kendte_afvigelser_kroner == [1, 1]
? skatdk_kendte_afvigelser_er_synlige
@ print("SKAT: 27 fradragscases stemmer; 2 kendte afvigelser på én krone er fortsat åbne.")
