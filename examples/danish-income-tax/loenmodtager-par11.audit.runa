@ sprog da

@ importer ./loenmodtager_beregning

-- Focused audit for Personskatteloven § 11 inside the ordinary wage-earner calculator.

= m5_2026_negativ_kapital_model = beregn_lønmodtager_model(LønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    nettokapitalindkomst_kroner = -40000,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
))

| m5_lønmodtager_model_par11_negativ_kapital_indgår: m5_2026_negativ_kapital_model -> m5_2026_negativ_kapital_model.indkomstgrundlag.nettokapitalindkomst_kroner == -40000 && m5_2026_negativ_kapital_model.indkomstgrundlag.positiv_nettokapitalindkomst_kroner == 0 && m5_2026_negativ_kapital_model.par11_nedslag.nedslag.nedslagsgrundlag_kroner == 40000 && m5_2026_negativ_kapital_model.par11_nedslag.nedslag.nedslag_kroner == 3200 && m5_2026_negativ_kapital_model.efter_personfradrag_før_skatteloft.bundskat_kroner == m5_2026_negativ_kapital_model.par11_nedslag.modregning.par6_efter_kroner && m5_2026_negativ_kapital_model.slutskat.samlet_indkomstskat_kroner == m5_2026_negativ_kapital_model.slutskat.statslig_indkomstskat_kroner + m5_2026_negativ_kapital_model.slutskat.kommunal_og_kirkelig_indkomstskat_kroner

? m5_lønmodtager_model_par11_negativ_kapital_indgår
