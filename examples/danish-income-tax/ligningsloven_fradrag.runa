--@label:ligningsloven_par8o::meta:ligningsloven_par8o_metadata--
----
Ligningsloven, LBK nr. 1500 af 24/11/2025:

§ 8 O. Skattepligtig kontanthjælp og introduktionsydelse m.v., der er
tilbagebetalingspligtig efter kapitel 12 i lov om aktiv socialpolitik eller
kapitel 7 i integrationsloven, fradrages i den skattepligtige indkomst i det
indkomstår, hvori tilbagebetalingen finder sted.

LOV nr. 198 af 25/02/2025:

§ 3

2. I § 8 O ændres »Skattepligtig kontanthjælp og introduktionsydelse m.v., der
er tilbagebetalingspligtig efter kapitel 12 i lov om aktiv socialpolitik eller
kapitel 7 i integrationsloven,« til: »Skattepligtige ydelser udbetalt efter lov
om aktiv socialpolitik og §§ 123, 126 og 136 i lov om en aktiv
beskæftigelsesindsats«.

§ 8

Stk. 3. § 3, nr. 2, og §§ 4 og 5 træder i kraft den 1. januar 2026.
----

--@begin::ligningsloven_par8o--
# Ligningslov8OYdelsesgrundlag = Ll8OAktivlovenKontanthjælp | Ll8OIntegrationslovenIntroduktionsydelse | Ll8OIntegrationslovenSærligIntroduktionsydelse | Ll8OAktivlovenEngangshjælp | Ll8OAndenSkattepligtigYdelseEfterAktivloven | Ll8OLabPar123 | Ll8OLabPar126 | Ll8OLabPar136 | Ll8OAndenYdelse
# Ligningslov8OKilde = Ll8OLbk1500Før2026 | Ll8OLov198Fra2026
# Ligningslov8OInput(indkomstår: Heltal, ydelsesgrundlag: Ligningslov8OYdelsesgrundlag, ydelsen_var_skattepligtig_ved_udbetaling: Boolsk, oprindeligt_skattepligtigt_bruttobeløb_kroner: Heltal, tidligere_tilbagebetalt_bruttobeløb_kroner: Heltal, tilbagebetalt_bruttobeløb_i_indkomståret_kroner: Heltal, samme_beløb_tidligere_fradraget_i_udbetalingsåret: Boolsk)
# Ligningslov8OResultat(indkomstår: Heltal, kilde: Ligningslov8OKilde, ydelse_omfattet: Boolsk, tilbagebetalt_bruttobeløb_i_indkomståret_kroner: Heltal, fradragsrelevant_tilbagebetaling_kroner: Heltal, resterende_tidligere_beskattet_bruttobeløb_før_årets_tilbagebetaling_kroner: Heltal, resterende_tidligere_beskattet_bruttobeløb_efter_årets_tilbagebetaling_kroner: Heltal, dobbeltfradrag_afskåret: Boolsk, fradrag_i_personlig_indkomst_kroner: Heltal)

# Ligningslov8OSag(input: Ligningslov8OInput) {
    | før_2026() -> input.indkomstår < 2026
    | fra_2026() -> input.indkomstår >= 2026
    | ydelse_omfattet_før_2026() -> input.ydelsesgrundlag == Ll8OAktivlovenKontanthjælp || input.ydelsesgrundlag == Ll8OIntegrationslovenIntroduktionsydelse || input.ydelsesgrundlag == Ll8OIntegrationslovenSærligIntroduktionsydelse || input.ydelsesgrundlag == Ll8OAktivlovenEngangshjælp
    | ydelse_efter_aktivloven() -> input.ydelsesgrundlag == Ll8OAktivlovenKontanthjælp || input.ydelsesgrundlag == Ll8OAktivlovenEngangshjælp || input.ydelsesgrundlag == Ll8OAndenSkattepligtigYdelseEfterAktivloven
    | ydelse_efter_lab_par123_126_eller_136() -> input.ydelsesgrundlag == Ll8OLabPar123 || input.ydelsesgrundlag == Ll8OLabPar126 || input.ydelsesgrundlag == Ll8OLabPar136
    | ydelse_omfattet_fra_2026() -> ydelse_efter_aktivloven() || ydelse_efter_lab_par123_126_eller_136()
    | ydelse_omfattet() -> før_2026() && ydelse_omfattet_før_2026() || fra_2026() && ydelse_omfattet_fra_2026()
    | oprindeligt_skattepligtigt_bruttobeløb_kroner() -> ligningslov_positivt_beløb(input.oprindeligt_skattepligtigt_bruttobeløb_kroner)
    | tidligere_tilbagebetalt_bruttobeløb_kroner() -> ligningslov_mindste_beløb(ligningslov_positivt_beløb(input.tidligere_tilbagebetalt_bruttobeløb_kroner), oprindeligt_skattepligtigt_bruttobeløb_kroner())
    | tilbagebetalt_bruttobeløb_i_indkomståret_kroner() -> ligningslov_positivt_beløb(input.tilbagebetalt_bruttobeløb_i_indkomståret_kroner)
    | resterende_tidligere_beskattet_bruttobeløb_før_årets_tilbagebetaling_kroner() -> oprindeligt_skattepligtigt_bruttobeløb_kroner() - tidligere_tilbagebetalt_bruttobeløb_kroner()
    | fradragsrelevant_tilbagebetaling_kroner() -> ligningslov_mindste_beløb(tilbagebetalt_bruttobeløb_i_indkomståret_kroner(), resterende_tidligere_beskattet_bruttobeløb_før_årets_tilbagebetaling_kroner())
    | resterende_tidligere_beskattet_bruttobeløb_efter_årets_tilbagebetaling_kroner() -> resterende_tidligere_beskattet_bruttobeløb_før_årets_tilbagebetaling_kroner() - fradragsrelevant_tilbagebetaling_kroner()
    | dobbeltfradrag_afskåret() -> input.samme_beløb_tidligere_fradraget_i_udbetalingsåret && fradragsrelevant_tilbagebetaling_kroner() > 0
    | fradragsberettiget() -> ydelse_omfattet() && input.ydelsen_var_skattepligtig_ved_udbetaling && fradragsrelevant_tilbagebetaling_kroner() > 0 && dobbeltfradrag_afskåret() == Falskt
    | fradrag_i_personlig_indkomst_kroner() -> 0
    | exception faktisk_tilbagebetaling_af_skattepligtig_omfattet_ydelse fradrag_i_personlig_indkomst_kroner() -> fradragsrelevant_tilbagebetaling_kroner() under fradragsberettiget()
    | kilde() -> Ll8OLbk1500Før2026
    | exception lov198_fra_2026 kilde() -> Ll8OLov198Fra2026 under fra_2026()
    | resultat() -> Ligningslov8OResultat(
        indkomstår = input.indkomstår,
        kilde = kilde(),
        ydelse_omfattet = ydelse_omfattet(),
        tilbagebetalt_bruttobeløb_i_indkomståret_kroner = tilbagebetalt_bruttobeløb_i_indkomståret_kroner(),
        fradragsrelevant_tilbagebetaling_kroner = fradragsrelevant_tilbagebetaling_kroner(),
        resterende_tidligere_beskattet_bruttobeløb_før_årets_tilbagebetaling_kroner = resterende_tidligere_beskattet_bruttobeløb_før_årets_tilbagebetaling_kroner(),
        resterende_tidligere_beskattet_bruttobeløb_efter_årets_tilbagebetaling_kroner = resterende_tidligere_beskattet_bruttobeløb_efter_årets_tilbagebetaling_kroner(),
        dobbeltfradrag_afskåret = dobbeltfradrag_afskåret(),
        fradrag_i_personlig_indkomst_kroner = fradrag_i_personlig_indkomst_kroner()
    )
}

| ligningslov8o_sag(input: Ligningslov8OInput) -> Ligningslov8OSag(input)
| ligningslov8o_resultat(input: Ligningslov8OInput) -> ligningslov8o_sag(input).resultat()
--@end::ligningsloven_par8o--

