= ligningsloven_lbk1500_par30a = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 30 A",
    hentet_dato = "2026-07-18"
