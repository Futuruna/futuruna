--@label:ligningsloven_par9l::meta:ligningsloven_par9l_metadata--
----
§ 9 L. Ved opgørelsen af den skattepligtige indkomst kan personer fradrage
procenten nævnt i stk. 3 af deres fradragsberettigede pensionsindbetalinger
omfattet af pensionsbeskatningslovens § 18 og pensionsindbetalinger omfattet af
pensionsbeskatningslovens § 19, jf. dog 2.-5. pkt. og stk. 2.

Pensionsindbetalinger omfattet af pensionsbeskatningslovens § 18 indgår med
det beløb, hvormed de i indkomståret fradrages efter pensionsbeskatningslovens
§ 18.

Indbetalinger til ratepension og ophørende livrente omfattet af
pensionsbeskatningslovens § 19 indgår med det beløb, for hvilket der er
bortseelsesret efter pensionsbeskatningslovens § 19, og efter fradrag af
indeholdt arbejdsmarkedsbidrag.

Øvrige pensionsindbetalinger omfattet af pensionsbeskatningslovens § 19 indgår
efter fradrag af indeholdt arbejdsmarkedsbidrag.

Der kan højst beregnes fradrag af et grundbeløb på 63.900 kr. (2010-niveau).

Grundbeløbet reguleres efter personskattelovens § 20.

Stk. 2. Indkomstskattepligtige pensionsudbetalinger omfattet af
pensionsbeskatningslovens § 20, stk. 1, nr. 1-4, fragår i den efter stk. 1
beregnede sum af fradragsberettigede pensionsindbetalinger omfattet af
pensionsbeskatningslovens § 18 og bortseelsesberettigede pensionsindbetalinger
omfattet af pensionsbeskatningslovens § 19, når der i det foregående indkomstår
er foretaget sådanne udbetalinger.

1. pkt. gælder dog ikke:
1) Udbetaling af invalidepension indtil opnåelse af folkepensionsalderen, jf.
§ 1 a i lov om social pension.
2) Udbetaling af rateforsikring i tilfælde af forsikredes invaliditet.
3) Udbetaling af rateopsparing i tilfælde af kontohaverens varigt nedsatte
arbejdsevne, som efter reglerne i lov om social pension berettiger kontohaveren
til at oppebære førtidspension eller seniorpension.
4) Udbetaling af ægtefælle- eller samleverpension.
5) Udbetaling til efterladte.
6) Udbetaling af pension som nævnt i pensionsbeskatningslovens § 2, stk. 1,
nr. 1 og 2.
7) Udbetaling af børnepension.

Stk. 3. Procenten nævnt i stk. 1 udgør 8 for indkomstårene 2018 og 2019 og
12 for indkomståret 2020 og efterfølgende indkomstår, jf. dog 2. pkt.
Fra og med det 15. indkomstår før det indkomstår, hvor personen når den
folkepensionsalder, jf. § 1 a i lov om social pension, der gælder for den
pågældende ved indkomstårets begyndelse, udgør procenten 20 for indkomståret
2018, 22 for indkomståret 2019 og 32 for indkomståret 2020 og efterfølgende
indkomstår.
----

----
Skatteministeriet, historiske og aktuelle satser og beløbsgrænser:

Ekstra pensionsfradrag, § 9 L
2016: ikke gældende.
2017: ikke gældende.

Maksimalt grundlag for ekstra pensionsfradrag, § 9 L, stk. 1
2025: 83.800 kr.
2026: 87.800 kr.

Ekstra pensionsfradrag indtil 15 år før folkepensionsalderen
2025: 12,0 pct.
2026: 12,0 pct.

Ekstra pensionsfradrag fra 15 år til folkepensionsalderen
2025: 32,0 pct.
2026: 32,0 pct.
----

--@begin::ligningsloven_par9l--
# Ligningslov9LPensionsalderStatus = Ll9lMereEnd15ÅrFørFolkepension | Ll9lFra15ÅrFørFolkepension
# Ligningslov9LPensionsudbetalingStatus = Ll9lIngenPbl20Udbetaling | Ll9lModregningspligtigPbl20Udbetaling | Ll9lUndtagetPbl20Udbetaling
# Ligningslov9LPensionsalderResultat(skatteår: Heltal, folkepensionsalder: Socialpensionslov1AResultat, første_indkomstår_med_forhøjet_sats: Heltal, pensionsalder_status: Ligningslov9LPensionsalderStatus, input_gyldigt: Boolsk)
# Ligningslov9LInput(skatteår: Heltal, fødselsdato: Dato, pbl18_fradragsberettiget_indbetaling_kroner: Heltal, pbl19_rate_ophørende_bortseelsesret_efter_am_kroner: Heltal, pbl19_øvrige_indbetalinger_efter_am_kroner: Heltal, pbl20_indkomstskattepligtig_udbetaling_kroner: Heltal, pbl20_udbetaling_status: Ligningslov9LPensionsudbetalingStatus)
# Ligningslov9LParametre(skatteår: Heltal, pensionsfradrag_basispoint: Heltal, maksimalt_grundlag_kroner: Heltal)
# Ligningslov9J9K9LInput(skatteår: Heltal, arbejdsmarkedsbidragsgrundlag_kroner: Heltal, udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver: Boolsk, fødselsdato: Dato, pbl18_fradragsberettiget_indbetaling_kroner: Heltal, pbl19_rate_ophørende_bortseelsesret_efter_am_kroner: Heltal, pbl19_øvrige_indbetalinger_efter_am_kroner: Heltal, pbl20_indkomstskattepligtig_udbetaling_kroner: Heltal, pbl20_udbetaling_status: Ligningslov9LPensionsudbetalingStatus)
# Ligningslov9J9K9LResult(pensionsalder_resultat: Ligningslov9LPensionsalderResultat, beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, ekstra_pensionsfradrag_kroner: Heltal, samlet_fradrag_kroner: Heltal)

| ll9l_gælder_for_skatteår(skatteår: Heltal) -> skatteår >= 2018
| ll9l_pensionsalder_resultat(skatteår: Heltal, fødselsdato: Dato) -> {
    = folkepensionsalder = socialpensionslov1a_resultat_for_indkomstår(fødselsdato, skatteår)
    = input_gyldigt = ll9l_gælder_for_skatteår(skatteår) && folkepensionsalder.input_gyldigt
    = første_indkomstår_med_forhøjet_sats = hvis input_gyldigt { folkepensionsalder.folkepension_opnåelsesår - 15 } ellers { 0 }
    = pensionsalder_status = hvis input_gyldigt && skatteår >= første_indkomstår_med_forhøjet_sats { Ll9lFra15ÅrFørFolkepension } ellers { Ll9lMereEnd15ÅrFørFolkepension }
    Ligningslov9LPensionsalderResultat(
        skatteår = skatteår,
        folkepensionsalder = folkepensionsalder,
        første_indkomstår_med_forhøjet_sats = første_indkomstår_med_forhøjet_sats,
        pensionsalder_status = pensionsalder_status,
        input_gyldigt = input_gyldigt
    )
}
| ll9l_maksimalt_grundlag_2010_niveau_kroner() -> 63900
| ll9l_maksimalt_grundlag_kroner(skatteår: Heltal) -> par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
    grundbeløb_2010_niveau_kroner = ll9l_maksimalt_grundlag_2010_niveau_kroner(),
    reguleringstal_tiendedele = par20_reguleringstal_tiendedele(skatteår)
)) under ll9l_gælder_for_skatteår(skatteår)
| ll9l_ordinær_sats_basispoint(skatteår: Heltal) -> 800 under skatteår >= 2018 && skatteår <= 2019
| ll9l_ordinær_sats_basispoint(skatteår: Heltal) -> 1200 under skatteår >= 2020
| ll9l_folkepensionsnær_sats_basispoint(skatteår: Heltal) -> 2000 under skatteår == 2018
| ll9l_folkepensionsnær_sats_basispoint(skatteår: Heltal) -> 2200 under skatteår == 2019
| ll9l_folkepensionsnær_sats_basispoint(skatteår: Heltal) -> 3200 under skatteår >= 2020
| ll9l_sats_basispoint(skatteår: Heltal, status: Ligningslov9LPensionsalderStatus) -> ll9l_ordinær_sats_basispoint(skatteår)
| exception ll9l_fra15år_før_folkepension ll9l_sats_basispoint(skatteår: Heltal, status: Ligningslov9LPensionsalderStatus) -> ll9l_folkepensionsnær_sats_basispoint(skatteår) under status == Ll9lFra15ÅrFørFolkepension
| ll9l_parametre_for(skatteår: Heltal, status: Ligningslov9LPensionsalderStatus) -> Ligningslov9LParametre(
    skatteår = skatteår,
    pensionsfradrag_basispoint = ll9l_sats_basispoint(skatteår, status),
    maksimalt_grundlag_kroner = ll9l_maksimalt_grundlag_kroner(skatteår)
) under ll9l_gælder_for_skatteår(skatteår)
| ll9l_pensionsindbetalinger_før_udbetalinger_kroner(input: Ligningslov9LInput) -> ligningslov_positivt_beløb(input.pbl18_fradragsberettiget_indbetaling_kroner) + ligningslov_positivt_beløb(input.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner) + ligningslov_positivt_beløb(input.pbl19_øvrige_indbetalinger_efter_am_kroner)
| ll9l_modregningspligtig_udbetaling_kroner(input: Ligningslov9LInput) -> 0
| exception ll9l_modregner_pbl20_udbetaling ll9l_modregningspligtig_udbetaling_kroner(input: Ligningslov9LInput) -> ligningslov_positivt_beløb(input.pbl20_indkomstskattepligtig_udbetaling_kroner) under input.pbl20_udbetaling_status == Ll9lModregningspligtigPbl20Udbetaling
| ll9l_nettopensionsindbetalinger_kroner(input: Ligningslov9LInput) -> ligningslov_positivt_beløb(ll9l_pensionsindbetalinger_før_udbetalinger_kroner(input) - ll9l_modregningspligtig_udbetaling_kroner(input))
| ll9l_fradragsgrundlag_kroner(input: Ligningslov9LInput) -> ligningslov_mindste_beløb(ll9l_nettopensionsindbetalinger_kroner(input), ll9l_parametre_for(input.skatteår, ll9l_pensionsalder_resultat(input.skatteår, input.fødselsdato).pensionsalder_status).maksimalt_grundlag_kroner)
| ll9l_ekstra_pensionsfradrag_kroner(input: Ligningslov9LInput) -> 0
| exception ll9l_gældende_skatteår_og_gyldig_fødselsdato ll9l_ekstra_pensionsfradrag_kroner(input: Ligningslov9LInput) -> penge_beløb_gange_basispoint_afrundet_kroner(ll9l_fradragsgrundlag_kroner(input), ll9l_parametre_for(input.skatteår, ll9l_pensionsalder_resultat(input.skatteår, input.fødselsdato).pensionsalder_status).pensionsfradrag_basispoint) under ll9l_pensionsalder_resultat(input.skatteår, input.fødselsdato).input_gyldigt
| ll9j_9k_9l_9j_input(input: Ligningslov9J9K9LInput) -> Ligningslov9JInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.arbejdsmarkedsbidragsgrundlag_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = input.udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver
)
| ll9j_9k_9l_9k_input(input: Ligningslov9J9K9LInput) -> Ligningslov9KInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.arbejdsmarkedsbidragsgrundlag_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = input.udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver
)
| ll9j_9k_9l_9l_input(input: Ligningslov9J9K9LInput) -> Ligningslov9LInput(
    skatteår = input.skatteår,
    fødselsdato = input.fødselsdato,
    pbl18_fradragsberettiget_indbetaling_kroner = input.pbl18_fradragsberettiget_indbetaling_kroner,
    pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = input.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner,
    pbl19_øvrige_indbetalinger_efter_am_kroner = input.pbl19_øvrige_indbetalinger_efter_am_kroner,
    pbl20_indkomstskattepligtig_udbetaling_kroner = input.pbl20_indkomstskattepligtig_udbetaling_kroner,
    pbl20_udbetaling_status = input.pbl20_udbetaling_status
)
| ll9j_9k_9l_fradrag_resultat(input: Ligningslov9J9K9LInput) -> Ligningslov9J9K9LResult(
    pensionsalder_resultat = ll9l_pensionsalder_resultat(input.skatteår, input.fødselsdato),
    beskæftigelsesfradrag_kroner = ll9j_beskæftigelsesfradrag_kroner(ll9j_9k_9l_9j_input(input)),
    jobfradrag_kroner = ll9k_jobfradrag_kroner(ll9j_9k_9l_9k_input(input)),
    ekstra_pensionsfradrag_kroner = ll9l_ekstra_pensionsfradrag_kroner(ll9j_9k_9l_9l_input(input)),
    samlet_fradrag_kroner = ll9j_beskæftigelsesfradrag_kroner(ll9j_9k_9l_9j_input(input)) + ll9k_jobfradrag_kroner(ll9j_9k_9l_9k_input(input)) + ll9l_ekstra_pensionsfradrag_kroner(ll9j_9k_9l_9l_input(input))
)
--@end::ligningsloven_par9l--

= ligningsloven_lbk1500_par14 = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 14",
    hentet_dato = "2026-07-18"
)

= ll_par14_kildemeta = Source(
    value = ligningsloven_lbk1500_par14
)
--@label:ligningsloven_par14::meta:ll_par14_kildemeta--
----
§ 14. Ved opgørelsen af den skattepligtige indkomst kan fradrages beløb, som i
indkomståret er anvendt til skatter og afgifter, bortset fra
ejendomsværdiskatter, på fast ejendom og næring, til forpagtningsafgifter og
lignende byrder, jf. dog stk. 2 og 3.

Stk. 2. Udgifter til ejendomsskatter på ejendomme, der indeholder en eller to
selvstændige lejligheder, kan ikke fradrages, hvis ejendommen i indkomståret
har tjent til bolig for ejeren. Fradrag indrømmes endvidere ikke for udgifter
til ejendomsskatter, som vedrører et stuehus med tilhørende grund og have, hvis
stuehuset i indkomståret har tjent til bolig for ejeren. Begrænsningen i 2.
pkt. gælder, når stuehuset er beliggende på en ejendom, der efter
ejendomsvurderingsloven anses for en landbrugsejendom. Fradrag indrømmes
tilsvarende ikke for ejendomme omfattet af ejendomsskattelovens § 3, stk. 1,
nr. 4 og 6-10. Tilsvarende gælder ejendomme af den art, der er nævnt i
ejendomsskattelovens § 3, stk. 1, nr. 4, 9 og 10, som er beliggende i
udlandet, på Færøerne eller i Grønland. Fradrag indrømmes heller ikke for
udgifter til ejendomsskatter på ubebyggede grunde, der er erhvervet med
henblik på privat benyttelse, og som ikke senere er overgået til
erhvervsmæssig benyttelse.

Stk. 3. Begrænsningen i stk. 2, 1.-4. pkt., gælder ikke i det omfang,
ejendommen eller stuehuset er benyttet erhvervsmæssigt i indkomståret. Der
bortses dog fra uvæsentlig erhvervsmæssig benyttelse. Som uvæsentligt
erhvervsmæssigt benyttet, jf. 2. pkt., anses en ejendom, der kun anvendes af
ejeren til boligformål og erhvervsmæssige formål, når den erhvervsmæssigt
benyttede del af ejendommen i henhold til en fordeling efter
ejendomsavancebeskatningslovens § 4, stk. 5, eller afskrivningslovens § 45,
stk. 2, der fortsat anses for retvisende, udgør mindre end 10 pct. af
ejendommens kontante anskaffelsessum. I andre tilfælde anses en ejendom, der
kun anvendes af ejeren til boligformål og erhvervsmæssige formål, som
uvæsentligt erhvervsmæssigt benyttet, jf. 2. pkt., når ejendomsværdien for den
del af ejendommen, der anvendes til boligformål, udgør mere end 90 pct. af
ejendommens kontante anskaffelsessum. Virksomhedsskattelovens § 1, stk. 3, 5.
og 6. pkt., finder tilsvarende anvendelse.
----

--@begin::ligningsloven_par14--
# Ligningslov14Udgiftsart = Ll14Ejendomsskat | Ll14AndenSkatEllerAfgiftPåFastEjendomOgNæring | Ll14Forpagtningsafgift | Ll14LignendeByrde | Ll14Ejendomsværdiskat | Ll14AndenUdgift
# Ligningslov14Stk2Ejendomsart = Ll14IngenStk2Begrænsning | Ll14EnEllerToLejlighederTjentTilEjerbolig | Ll14StuehusPåLandbrugsejendomTjentTilEjerbolig | Ll14EjendomOmfattetAfEjendomsskattelov3 | Ll14TilsvarendeEjendomIUlandetFærøerneEllerGrønland | Ll14UbebyggetGrundErhvervetTilPrivatBrug
# Ligningslov14Fordelingsgrundlag = Ll14FordelingEfterEabl4EllerAfskrivningslov45 | Ll14BoligdelensEjendomsværdiModKontantAnskaffelsessum | Ll14IngenBlandetFordeling
# Ligningslov14Input(indkomstår: Heltal, anvendelsesår: Heltal, udgiftsart: Ligningslov14Udgiftsart, ejendomsart: Ligningslov14Stk2Ejendomsart, fordelingsgrundlag: Ligningslov14Fordelingsgrundlag, anvendt_beløb_kroner: Heltal, erhvervsandel_basispoint: Heltal, fordeling_fortsat_retvisende: Boolsk)
# Ligningslov14Resultat(indkomstår: Heltal, udgiftsart: Ligningslov14Udgiftsart, stk1_udgift_omfattet: Boolsk, stk2_begrænsning_finder_anvendelse: Boolsk, erhvervsmæssig_benyttelse_væsentlig: Boolsk, fradragsandel_basispoint: Heltal, anvendt_beløb_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, ikke_fradraget_kroner: Heltal)

# Ligningslov14Sag(input: Ligningslov14Input) {
    | anvendt_i_indkomståret() -> input.anvendelsesår == input.indkomstår
    | stk1_udgiftsart_omfattet() -> input.udgiftsart == Ll14Ejendomsskat || input.udgiftsart == Ll14AndenSkatEllerAfgiftPåFastEjendomOgNæring || input.udgiftsart == Ll14Forpagtningsafgift || input.udgiftsart == Ll14LignendeByrde
    | stk1_udgift_omfattet() -> anvendt_i_indkomståret() && stk1_udgiftsart_omfattet()
    | stk2_begrænsning_finder_anvendelse() -> input.udgiftsart == Ll14Ejendomsskat && input.ejendomsart != Ll14IngenStk2Begrænsning
    | stk3_kan_undtage_stk2_begrænsningen() -> input.ejendomsart == Ll14EnEllerToLejlighederTjentTilEjerbolig || input.ejendomsart == Ll14StuehusPåLandbrugsejendomTjentTilEjerbolig || input.ejendomsart == Ll14EjendomOmfattetAfEjendomsskattelov3
    | erhvervsandel_basispoint() -> penge_mindste_beløb(penge_positivt_beløb(input.erhvervsandel_basispoint), 10000)
    | fordeling_kan_anvendes() -> input.fordelingsgrundlag == Ll14BoligdelensEjendomsværdiModKontantAnskaffelsessum || (input.fordelingsgrundlag == Ll14FordelingEfterEabl4EllerAfskrivningslov45 && input.fordeling_fortsat_retvisende)
    | erhvervsmæssig_benyttelse_væsentlig() -> fordeling_kan_anvendes() && erhvervsandel_basispoint() >= 1000
    | fradragsandel_basispoint() -> 0
    | exception stk1_udgift_uden_stk2_begrænsning_fradrages_fuldt fradragsandel_basispoint() -> 10000 under stk1_udgift_omfattet() && stk2_begrænsning_finder_anvendelse() == Falskt
    | exception stk3_fradrager_den_væsentlige_erhvervsandel fradragsandel_basispoint() -> erhvervsandel_basispoint() under stk1_udgift_omfattet() && stk2_begrænsning_finder_anvendelse() && stk3_kan_undtage_stk2_begrænsningen() && erhvervsmæssig_benyttelse_væsentlig()
    | anvendt_beløb_kroner() -> penge_positivt_beløb(input.anvendt_beløb_kroner)
    | fradrag_i_skattepligtig_indkomst_kroner() -> penge_beløb_gange_basispoint_kroner(anvendt_beløb_kroner(), fradragsandel_basispoint())
    | ikke_fradraget_kroner() -> anvendt_beløb_kroner() - fradrag_i_skattepligtig_indkomst_kroner()
    | resultat() -> Ligningslov14Resultat(
        indkomstår = input.indkomstår,
        udgiftsart = input.udgiftsart,
        stk1_udgift_omfattet = stk1_udgift_omfattet(),
        stk2_begrænsning_finder_anvendelse = stk2_begrænsning_finder_anvendelse(),
        erhvervsmæssig_benyttelse_væsentlig = erhvervsmæssig_benyttelse_væsentlig(),
        fradragsandel_basispoint = fradragsandel_basispoint(),
        anvendt_beløb_kroner = anvendt_beløb_kroner(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        ikke_fradraget_kroner = ikke_fradraget_kroner()
    )
}

| ligningslov14_sag(input: Ligningslov14Input) -> Ligningslov14Sag(input)
| ligningslov14_resultat(input: Ligningslov14Input) -> ligningslov14_sag(input).resultat()
--@end::ligningsloven_par14--

= ligningsloven_lbk1500_par14f = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 14 F",
    hentet_dato = "2026-07-18"
)

= ll_par14f_kildemeta = Source(
    value = ligningsloven_lbk1500_par14f
)
--@label:ligningsloven_par14f::meta:ll_par14f_kildemeta--
----
§ 14 F. Ved opgørelsen af en arbejdsgivers skattepligtige indkomst kan
fradrages bidrag til en fond, hvis formål er at betrygge eller forbedre kårene
for personer, der er eller har været ansat i arbejdsgiverens virksomhed, eller
deres pårørende. Fonden må ikke udbetale ydelser af pensionslignende karakter.
Hvis arbejdsgiveren yder bidraget ved at påtage sig en gældsforpligtelse over
for fonden, fradrages et beløb svarende til fordringens kursværdi ved
stiftelsen.

Stk. 2. Et flertal af fondsbestyrelsens medlemmer skal vælges af og blandt de
af virksomhedens ansatte, der kan nyde godt af fondens virke.

Stk. 3. Bidrag til fonde efter stk. 1 kan ikke fradrages efter reglerne i § 12,
stk. 2.
----

--@begin::ligningsloven_par14f--
# Ligningslov14FBidragsform = Ll14FKontantBidrag | Ll14FGældsforpligtelseOverForFonden
# Ligningslov14FInput(indkomstår: Heltal, bidragsform: Ligningslov14FBidragsform, kontant_bidrag_kroner: Heltal, fordringens_kursværdi_ved_stiftelsen_kroner: Heltal, fondens_formål_betrygger_eller_forbedrer_ansatte_tidligere_ansatte_eller_pårørendes_kår: Boolsk, fonden_udbetaler_pensionslignende_ydelser: Boolsk, bestyrelsesflertal_valgt_af_og_blandt_omfattede_ansatte: Boolsk, samme_bidrag_fradraget_efter_par12_stk2: Boolsk)
# Ligningslov14FResultat(indkomstår: Heltal, bidragsform: Ligningslov14FBidragsform, betingelser_opfyldt: Boolsk, bidragsværdi_kroner: Heltal, dobbeltfradrag_efter_par12_stk2_afskåret: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal)

# Ligningslov14FSag(input: Ligningslov14FInput) {
    | bidragsværdi_kroner() -> penge_positivt_beløb(input.kontant_bidrag_kroner)
    | exception gældsforpligtelse_værdiansættes_til_kursværdi bidragsværdi_kroner() -> penge_positivt_beløb(input.fordringens_kursværdi_ved_stiftelsen_kroner) under input.bidragsform == Ll14FGældsforpligtelseOverForFonden
    | dobbeltfradrag_efter_par12_stk2_afskåret() -> input.samme_bidrag_fradraget_efter_par12_stk2 && bidragsværdi_kroner() > 0
    | betingelser_opfyldt() -> input.fondens_formål_betrygger_eller_forbedrer_ansatte_tidligere_ansatte_eller_pårørendes_kår && input.fonden_udbetaler_pensionslignende_ydelser == Falskt && input.bestyrelsesflertal_valgt_af_og_blandt_omfattede_ansatte && dobbeltfradrag_efter_par12_stk2_afskåret() == Falskt
    | fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | exception arbejdsgiverbidrag_til_medarbejderfond_fradrages fradrag_i_skattepligtig_indkomst_kroner() -> bidragsværdi_kroner() under betingelser_opfyldt()
    | resultat() -> Ligningslov14FResultat(
        indkomstår = input.indkomstår,
        bidragsform = input.bidragsform,
        betingelser_opfyldt = betingelser_opfyldt(),
        bidragsværdi_kroner = bidragsværdi_kroner(),
        dobbeltfradrag_efter_par12_stk2_afskåret = dobbeltfradrag_efter_par12_stk2_afskåret(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner()
    )
}

| ligningslov14f_sag(input: Ligningslov14FInput) -> Ligningslov14FSag(input)
| ligningslov14f_resultat(input: Ligningslov14FInput) -> ligningslov14f_sag(input).resultat()
--@end::ligningsloven_par14f--

----
§ 15 P. Lejere, der fremlejer en del af værelserne i egen lejet lejlighed til
beboelse, kan ved indkomstopgørelsen vælge kun at medregne den del af
bruttolejeindtægten, der overstiger et bundfradrag på ⅔ af fremlejers egen
årlige leje for hele lejligheden. Andelshavere i private andelsboligforeninger
anses i denne forbindelse som lejere, og andelshaveres boligafgift anses som
leje. Ejere, der udlejer en del af værelserne i en lejlighed i egen ejendom
omfattet af ejendomsskattelovens § 3, til beboelse, kan ved
indkomstopgørelsen vælge kun at medregne den del af bruttolejeindtægten, der
overstiger et bundfradrag på 1⅓ pct. af ejendomsværdien, jf.
ejendomsskattelovens § 13, stk. 2, dog altid mindst 24.000 kr., jf. dog 5. pkt.
For ejendomme beliggende i udlandet m.v. udgør bundfradraget 1⅓ pct. af
udenlandsk ejendomsvurdering, som kan sidestilles med en dansk, jf.
ejendomsskattelovens § 14, stk. 1, eller i mangel heraf handelsværdien beregnet
efter ejendomsskattelovens § 14, stk. 2, dog altid mindst 24.000 kr., jf. dog
5. pkt. For fremlejere, andelshavere og ejere, der kun har lejet eller ejet
lejligheden en del af indkomståret, beregnes der kun bundfradrag af denne del af
den årlige leje eller ejendomsværdiskat. Bundfradraget dækker samtlige udgifter
og afskrivninger, der ellers ville være fradragsberettigede i forbindelse med
fremlejningen eller udlejningen. For ejere beregnes ejendomsværdiskat efter
ejendomsskatteloven for den udlejede del af boligen.

Stk. 2. Lejere, der fremlejer lejligheden en del af indkomståret til beboelse,
kan ved indkomstopgørelsen vælge kun at medregne den del af bruttolejeindtægten,
der overstiger et bundfradrag på ⅔ af fremlejers egen årlige leje.
Andelshavere i private andelsboligforeninger anses i denne forbindelse som
lejere, og andelshaveres boligafgift anses som leje. Ejere af en helårsbolig,
som er omfattet af ejendomsskattelovens § 3, der udlejer boligen en del af
indkomståret til beboelse, kan ved indkomstopgørelsen vælge kun at medregne den
del af bruttolejeindtægten, der overstiger et bundfradrag som nævnt i stk. 1,
3. pkt. Stk. 1, 4. pkt., finder dog tilsvarende anvendelse. For fremlejere,
andelshavere og ejere, der kun har lejet eller ejet lejligheden eller
ejendommen en del af indkomståret, beregnes der kun bundfradrag af denne del af
den årlige leje eller ejendomsværdiskat. Bundfradraget dækker samtlige udgifter
og afskrivninger, der ellers ville være fradragsberettigede i forbindelse med
fremlejningen eller udlejningen. For ejere beregnes ejendomsværdiskat efter
ejendomsskatteloven i udlejningsperioden.

Stk. 3. Lejere og ejere som nævnt i stk. 1 og 2, der ikke anvender
bundfradragsreglen i stk. 1 eller 2, kan ved indkomstopgørelsen foretage
fradrag for udgifter mv. som nævnt i stk. 1, 6. pkt., og stk. 2, 6. pkt. Det
samlede fradragsbeløb kan dog ikke overstige bruttolejeindtægten. Foretages
fradraget efter 1. pkt., kan den pågældende lejer eller ejer ikke senere overgå
til bundfradrag efter stk. 1 eller 2.

Stk. 4. Stk. 1-3 gælder alene for ejere, andelshavere og lejere, hvis
udlejningen eller fremlejningen sker til den samme person eller de samme
personer i en sammenhængende periode på mindst 4 måneder.
----

# Ligningslov15PRolle = Ll15PEjer | Ll15PAndelshaver | Ll15PLejer
# Ligningslov15PUdlejningsform = Ll15PVærelser | Ll15PHeleBoligen
# Ligningslov15PMetode = Ll15PSkematiskBundfradrag | Ll15PRegnskabsmæssigeUdgifter
# Ligningslov15PBundfradragskilde = Ll15PLejeEllerBoligafgift | Ll15PEjendomsværdi
# Ligningslov15PInput(skatteår: Heltal, rolle: Ligningslov15PRolle, udlejningsform: Ligningslov15PUdlejningsform, metode: Ligningslov15PMetode, bruttolejeindtægt_kroner: Heltal, årlig_leje_eller_boligafgift_kroner: Heltal, ejendomsværdi_kroner: Heltal, ejer_ejendom_omfattet_af_ejendomsskattelov3: Boolsk, samme_personer_mindst_fire_måneder: Boolsk, lejet_eller_ejet_dage: Heltal, udlejningsdage: Heltal, indkomstårets_dage: Heltal, faktiske_udgifter_kroner: Heltal)
# Ligningslov15PResultat(skatteår: Heltal, rolle: Ligningslov15PRolle, udlejningsform: Ligningslov15PUdlejningsform, metode: Ligningslov15PMetode, grundbetingelser_opfyldt: Boolsk, skematisk_anvendelig: Boolsk, regnskabsmæssig_anvendelig: Boolsk, bundfradragskilde: Ligningslov15PBundfradragskilde, bruttolejeindtægt_kroner: Heltal, fuldt_bundfradrag_kroner: Heltal, lejet_eller_ejet_dage: Heltal, udlejningsdage: Heltal, forholdsmæssigt_bundfradrag_kroner: Heltal, bundfradrag_anvendt_kroner: Heltal, faktiske_udgifter_fradrag_kroner: Heltal, fradrag_i_indkomstopgørelse_kroner: Heltal, skattepligtig_indkomst_kroner: Heltal, regnskabsmæssig_metode_spærrer_senere_bundfradrag: Boolsk)

| ll15p_lejer_lignende(rolle: Ligningslov15PRolle) -> rolle == Ll15PLejer || rolle == Ll15PAndelshaver
| ll15p_ejer(rolle: Ligningslov15PRolle) -> rolle == Ll15PEjer
| ll15p_ejer_betingelse_opfyldt(rolle: Ligningslov15PRolle, ejer_ejendom_omfattet_af_ejendomsskattelov3: Boolsk) -> Sandt
| exception ll15p_ejer_kræver_ejendomsskattelov3 ll15p_ejer_betingelse_opfyldt(rolle: Ligningslov15PRolle, ejer_ejendom_omfattet_af_ejendomsskattelov3: Boolsk) -> ejer_ejendom_omfattet_af_ejendomsskattelov3 under ll15p_ejer(rolle)
| ll15p_bundfradragskilde(rolle: Ligningslov15PRolle) -> Ll15PLejeEllerBoligafgift
| exception ll15p_ejer_bundfradrag_fra_ejendomsværdi ll15p_bundfradragskilde(rolle: Ligningslov15PRolle) -> Ll15PEjendomsværdi under ll15p_ejer(rolle)
| ll15p_lejer_bundfradrag_kroner(årlig_leje_eller_boligafgift_kroner: Heltal) -> ligningslov_positivt_beløb(årlig_leje_eller_boligafgift_kroner) * 2 / 3
| ll15p_ejer_bundfradrag_kroner(ejendomsværdi_kroner: Heltal) -> ligningslov_største_beløb(ligningslov_positivt_beløb(ejendomsværdi_kroner) / 75, 24000)
| ll15p_forholdsmæssigt_bundfradrag_kroner(fuldt_bundfradrag_kroner: Heltal, lejet_eller_ejet_dage: Heltal, indkomstårets_dage: Heltal) -> 0
| exception ll15p_forholdsmæssig_rådighedsperiode ll15p_forholdsmæssigt_bundfradrag_kroner(fuldt_bundfradrag_kroner: Heltal, lejet_eller_ejet_dage: Heltal, indkomstårets_dage: Heltal) -> fuldt_bundfradrag_kroner * ligningslov_mindste_beløb(lejet_eller_ejet_dage, indkomstårets_dage) / indkomstårets_dage under fuldt_bundfradrag_kroner > 0 && lejet_eller_ejet_dage > 0 && indkomstårets_dage > 0

# Ligningslov15PSag(input: Ligningslov15PInput) {
    | bruttolejeindtægt_kroner() -> ligningslov_positivt_beløb(input.bruttolejeindtægt_kroner)
    | grundbetingelser_opfyldt() -> input.samme_personer_mindst_fire_måneder && ll15p_ejer_betingelse_opfyldt(input.rolle, input.ejer_ejendom_omfattet_af_ejendomsskattelov3)
    | skematisk_anvendelig() -> input.metode == Ll15PSkematiskBundfradrag && grundbetingelser_opfyldt()
    | regnskabsmæssig_anvendelig() -> input.metode == Ll15PRegnskabsmæssigeUdgifter && grundbetingelser_opfyldt()
    | bundfradragskilde() -> ll15p_bundfradragskilde(input.rolle)
    | fuldt_bundfradrag_kroner() -> ll15p_lejer_bundfradrag_kroner(input.årlig_leje_eller_boligafgift_kroner)
    | exception ll15p_ejer_fuldt_bundfradrag fuldt_bundfradrag_kroner() -> ll15p_ejer_bundfradrag_kroner(input.ejendomsværdi_kroner) under ll15p_ejer(input.rolle)
    | lejet_eller_ejet_dage() -> ligningslov_mindste_beløb(ligningslov_positivt_beløb(input.lejet_eller_ejet_dage), ligningslov_positivt_beløb(input.indkomstårets_dage))
    | udlejningsdage() -> ligningslov_mindste_beløb(ligningslov_positivt_beløb(input.udlejningsdage), ligningslov_positivt_beløb(input.indkomstårets_dage))
    | forholdsmæssigt_bundfradrag_kroner() -> ll15p_forholdsmæssigt_bundfradrag_kroner(fuldt_bundfradrag_kroner(), lejet_eller_ejet_dage(), input.indkomstårets_dage)
    | bundfradrag_anvendt_kroner() -> 0
    | exception ll15p_skematisk_bundfradrag bundfradrag_anvendt_kroner() -> ligningslov_mindste_beløb(forholdsmæssigt_bundfradrag_kroner(), bruttolejeindtægt_kroner()) under skematisk_anvendelig()
    | faktiske_udgifter_fradrag_kroner() -> 0
    | exception ll15p_regnskabsmæssige_udgifter faktiske_udgifter_fradrag_kroner() -> ligningslov_mindste_beløb(ligningslov_positivt_beløb(input.faktiske_udgifter_kroner), bruttolejeindtægt_kroner()) under regnskabsmæssig_anvendelig()
    | fradrag_i_indkomstopgørelse_kroner() -> bundfradrag_anvendt_kroner() + faktiske_udgifter_fradrag_kroner()
    | skattepligtig_indkomst_kroner() -> ligningslov_positivt_beløb(bruttolejeindtægt_kroner() - fradrag_i_indkomstopgørelse_kroner())
    | regnskabsmæssig_metode_spærrer_senere_bundfradrag() -> regnskabsmæssig_anvendelig()
    | resultat() -> Ligningslov15PResultat(
        skatteår = input.skatteår,
        rolle = input.rolle,
        udlejningsform = input.udlejningsform,
        metode = input.metode,
        grundbetingelser_opfyldt = grundbetingelser_opfyldt(),
        skematisk_anvendelig = skematisk_anvendelig(),
        regnskabsmæssig_anvendelig = regnskabsmæssig_anvendelig(),
        bundfradragskilde = bundfradragskilde(),
        bruttolejeindtægt_kroner = bruttolejeindtægt_kroner(),
        fuldt_bundfradrag_kroner = fuldt_bundfradrag_kroner(),
        lejet_eller_ejet_dage = lejet_eller_ejet_dage(),
        udlejningsdage = udlejningsdage(),
        forholdsmæssigt_bundfradrag_kroner = forholdsmæssigt_bundfradrag_kroner(),
        bundfradrag_anvendt_kroner = bundfradrag_anvendt_kroner(),
        faktiske_udgifter_fradrag_kroner = faktiske_udgifter_fradrag_kroner(),
        fradrag_i_indkomstopgørelse_kroner = fradrag_i_indkomstopgørelse_kroner(),
        skattepligtig_indkomst_kroner = skattepligtig_indkomst_kroner(),
        regnskabsmæssig_metode_spærrer_senere_bundfradrag = regnskabsmæssig_metode_spærrer_senere_bundfradrag()
    )
}
| ligningslov15p_sag(input: Ligningslov15PInput) -> Ligningslov15PSag(input)
| ligningslov15p_resultat(input: Ligningslov15PInput) -> ligningslov15p_sag(input).resultat()
| ll15p_ingen_resultat() -> Ligningslov15PResultat(
    skatteår = 0,
    rolle = Ll15PLejer,
    udlejningsform = Ll15PVærelser,
    metode = Ll15PSkematiskBundfradrag,
    grundbetingelser_opfyldt = Falskt,
    skematisk_anvendelig = Falskt,
    regnskabsmæssig_anvendelig = Falskt,
    bundfradragskilde = Ll15PLejeEllerBoligafgift,
    bruttolejeindtægt_kroner = 0,
    fuldt_bundfradrag_kroner = 0,
    lejet_eller_ejet_dage = 0,
    udlejningsdage = 0,
    forholdsmæssigt_bundfradrag_kroner = 0,
    bundfradrag_anvendt_kroner = 0,
    faktiske_udgifter_fradrag_kroner = 0,
    fradrag_i_indkomstopgørelse_kroner = 0,
    skattepligtig_indkomst_kroner = 0,
    regnskabsmæssig_metode_spærrer_senere_bundfradrag = Falskt
)

= ll15p_ejer_eksempel1_fixture = ligningslov15p_resultat(Ligningslov15PInput(
