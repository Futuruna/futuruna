# Ligningslov9CKilde = LigningslovLbk1500Af2025Par9C | SkatteraadetBek1333Af2025Par1Par3 | Lov616Af2026Par1 | SkatDkKoerselsfradrag2026
# Ligningslov9CBefordringsformål = IndtægtsgivendeArbejdsplads | SuUddannelsessted | AndetBefordringsformål
# Ligningslov9CBroPassager(storebælt_bil_motorcykel_passager: Heltal, storebælt_kollektiv_passager: Heltal, øresund_bil_motorcykel_passager: Heltal, øresund_kollektiv_passager: Heltal, dokumenteret_og_afholdt_af_skattepligtige: Boolsk)
# Ligningslov9CSærligTransport(faktisk_dokumenteret_udgift_kroner: Heltal, geografiske_forhold_tidsforbrug_økonomisk_rimelighed_kræver_transporten: Boolsk)
# Ligningslov9DBefordringsformål = Par9DArbejdsplads | Par9DUddannelsessted | Par9DIkkeOmfattet
# Ligningslov9DInput(skatteår: Heltal, befordringsformål: Ligningslov9DBefordringsformål, godtgjort_varigt_nedsat_funktionsevne_eller_kronisk_sygdom: Boolsk, særlige_udgifter_til_befordring: Boolsk, offentlig_befordring_kan_anvendes: Boolsk, billigste_offentlige_befordring_kroner: Heltal, normal_egen_befordringsudgift_kroner: Heltal, faktisk_befordringsudgift_kroner: Heltal)
# Ligningslov9DResultat(omfattet_af_par9d: Boolsk, afskærer_par9c_stk1_8: Boolsk, afskærer_par9c_stk10: Boolsk, normal_befordringsudgift_kroner: Heltal, normal_befordringsudgift_over_2000_kroner: Heltal, faktisk_udgift_over_normal_kroner: Heltal, fradrag_kroner: Heltal)
# Ligningslov9CInput(skatteår: Heltal, arbejdsdage: Heltal, daglige_befordringskilometer: Heltal, bopæl_i_yderkommune_eller_lille_ø: Boolsk, aftrapningsindkomst_kroner: Heltal, befordringsformål: Ligningslov9CBefordringsformål, modtaget_skattefri_befordringsgodtgørelse_for_strækning: Boolsk, modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning: Boolsk, par9d: Ligningslov9DResultat, fradrag_udelukket_folketingshverv_m_v: Boolsk, fri_befordring_betalt_af_arbejdsgiver_for_hele_strækningen: Boolsk, broer: Ligningslov9CBroPassager, særlig_transport: Ligningslov9CSærligTransport)
# Ligningslov9CSatser(skatteår: Heltal, almindelig_op_til_120_øre_pr_km: Heltal, almindelig_over_120_øre_pr_km: Heltal, yderkommune_op_til_120_øre_pr_km: Heltal, yderkommune_over_120_øre_pr_km: Heltal, lavindkomst_tillæg_basispoint: Heltal, lavindkomst_aftrapning_basispoint_pr_1000: Heltal, lavindkomst_maks_kroner: Heltal, lavindkomst_indkomstgrænse_kroner: Heltal, kilde: Ligningslov9CKilde)
# Ligningslov9CResultat(berettiget_til_ordinært_fradrag: Boolsk, daglige_fradragsberettigede_kilometer: Heltal, op_til_120_kilometer_pr_dag: Heltal, over_120_kilometer_pr_dag: Heltal, op_til_120_øre_pr_km: Heltal, over_120_øre_pr_km: Heltal, afstandsfradrag_kroner: Heltal, særlig_transportfradrag_kroner: Heltal, brofradrag_kroner: Heltal, grundfradrag_før_lavindkomsttillæg_kroner: Heltal, lavindkomst_tillæg_kroner: Heltal, fri_befordring_skattepligtig_værdi_kroner: Heltal, samlet_befordringsfradrag_kroner: Heltal, kilde: Ligningslov9CKilde)

| ll9c_ingen_bropassager() -> Ligningslov9CBroPassager(
    storebælt_bil_motorcykel_passager = 0,
    storebælt_kollektiv_passager = 0,
    øresund_bil_motorcykel_passager = 0,
    øresund_kollektiv_passager = 0,
    dokumenteret_og_afholdt_af_skattepligtige = Falskt
)
| ll9c_ingen_særlig_transport() -> Ligningslov9CSærligTransport(
    faktisk_dokumenteret_udgift_kroner = 0,
    geografiske_forhold_tidsforbrug_økonomisk_rimelighed_kræver_transporten = Falskt
)
| ll9d_omfattet(input: Ligningslov9DInput) -> Falskt
| exception ll9d_arbejdsplads_varigt_nedsat_funktionsevne ll9d_omfattet(input: Ligningslov9DInput) -> Sandt under input.befordringsformål == Par9DArbejdsplads && input.godtgjort_varigt_nedsat_funktionsevne_eller_kronisk_sygdom == Sandt && input.særlige_udgifter_til_befordring == Sandt
| exception ll9d_su_uddannelsessted_varigt_nedsat_funktionsevne ll9d_omfattet(input: Ligningslov9DInput) -> Sandt under input.skatteår >= 2026 && input.befordringsformål == Par9DUddannelsessted && input.godtgjort_varigt_nedsat_funktionsevne_eller_kronisk_sygdom == Sandt && input.særlige_udgifter_til_befordring == Sandt
| ll9d_normal_befordringsudgift_kroner(input: Ligningslov9DInput) -> ligningslov_positivt_beløb(input.normal_egen_befordringsudgift_kroner)
| exception ll9d_offentlig_befordring_billigste ll9d_normal_befordringsudgift_kroner(input: Ligningslov9DInput) -> ligningslov_positivt_beløb(input.billigste_offentlige_befordring_kroner) under input.offentlig_befordring_kan_anvendes == Sandt
| ll9d_normal_befordringsudgift_over_2000_kroner(input: Ligningslov9DInput) -> ligningslov_positivt_beløb(ll9d_normal_befordringsudgift_kroner(input) - 2000)
| ll9d_faktisk_udgift_over_normal_kroner(input: Ligningslov9DInput) -> ligningslov_positivt_beløb(input.faktisk_befordringsudgift_kroner - ll9d_normal_befordringsudgift_kroner(input))
| ll9d_fradrag_kroner(input: Ligningslov9DInput) -> 0
| exception ll9d_omfattet_fradrag ll9d_fradrag_kroner(input: Ligningslov9DInput) -> ll9d_normal_befordringsudgift_over_2000_kroner(input) + ll9d_faktisk_udgift_over_normal_kroner(input) under ll9d_omfattet(input)
| ll9d_afskærer_par9c_stk1_8(input: Ligningslov9DInput) -> ll9d_omfattet(input) && input.befordringsformål == Par9DArbejdsplads
| ll9d_afskærer_par9c_stk10(input: Ligningslov9DInput) -> ll9d_omfattet(input) && input.befordringsformål == Par9DUddannelsessted
| ll9d_resultat(input: Ligningslov9DInput) -> Ligningslov9DResultat(
    omfattet_af_par9d = ll9d_omfattet(input),
    afskærer_par9c_stk1_8 = ll9d_afskærer_par9c_stk1_8(input),
    afskærer_par9c_stk10 = ll9d_afskærer_par9c_stk10(input),
    normal_befordringsudgift_kroner = ll9d_normal_befordringsudgift_kroner(input),
    normal_befordringsudgift_over_2000_kroner = ll9d_normal_befordringsudgift_over_2000_kroner(input),
    faktisk_udgift_over_normal_kroner = ll9d_faktisk_udgift_over_normal_kroner(input),
    fradrag_kroner = ll9d_fradrag_kroner(input)
)
| ll9d_ikke_omfattet_resultat() -> ll9d_resultat(Ligningslov9DInput(
    skatteår = 2026,
    befordringsformål = Par9DIkkeOmfattet,
    godtgjort_varigt_nedsat_funktionsevne_eller_kronisk_sygdom = Falskt,
    særlige_udgifter_til_befordring = Falskt,
    offentlig_befordring_kan_anvendes = Falskt,
    billigste_offentlige_befordring_kroner = 0,
    normal_egen_befordringsudgift_kroner = 0,
    faktisk_befordringsudgift_kroner = 0
))
| ll9c_øre_afrundet_til_kroner(øre: Heltal) -> 0
| exception ll9c_positive_øre_afrundes ll9c_øre_afrundet_til_kroner(øre: Heltal) -> (øre + 50) / 100 under øre > 0
| ll9c_satser_for(skatteår: Heltal) -> Ligningslov9CSatser(
    skatteår = 2025,
    almindelig_op_til_120_øre_pr_km = 223,
    almindelig_over_120_øre_pr_km = 112,
    yderkommune_op_til_120_øre_pr_km = 247,
