    lejet_eller_ejet_dage = 365,
    udlejningsdage = 300,
    indkomstårets_dage = 365,
    faktiske_udgifter_kroner = 0
))
= ll15p_ejer_eksempel3_fixture = ligningslov15p_resultat(Ligningslov15PInput(
