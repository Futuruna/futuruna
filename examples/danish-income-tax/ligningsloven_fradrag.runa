))
= ll15p_regnskabsmæssig_fixture = ligningslov15p_resultat(Ligningslov15PInput(
    skatteår = 2026,
    rolle = Ll15PLejer,
    udlejningsform = Ll15PVærelser,
    metode = Ll15PRegnskabsmæssigeUdgifter,
    bruttolejeindtægt_kroner = 80000,
    årlig_leje_eller_boligafgift_kroner = 120000,
