| exception ll9c_ordinært_lavindkomsttillæg ll9c_lavindkomst_tillæg_kroner(input: Ligningslov9CInput) -> ll9c_lavindkomst_tillæg_for_årsgrundlag_kroner(input.skatteår, input.aftrapningsindkomst_kroner, ll9c_grundfradrag_før_lavindkomsttillæg_kroner(input)) under ll9c_ordinært_befordringsfradrag_berettiget(input)
