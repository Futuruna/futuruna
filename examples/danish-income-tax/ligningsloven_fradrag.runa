    over_120_kilometer_pr_dag = ll9c_over_120_kilometer_pr_dag(input),
    op_til_120_øre_pr_km = ll9c_op_til_120_øre_pr_km(input),
    over_120_øre_pr_km = ll9c_over_120_øre_pr_km(input),
    afstandsfradrag_kroner = ll9c_afstandsfradrag_kroner(input),
    særlig_transportfradrag_kroner = ll9c_særlig_transportfradrag_kroner(input),
    brofradrag_kroner = ll9c_brofradrag_kroner(input),
    grundfradrag_før_lavindkomsttillæg_kroner = ll9c_grundfradrag_før_lavindkomsttillæg_kroner(input),
    lavindkomst_tillæg_kroner = ll9c_lavindkomst_tillæg_kroner(input),
    fri_befordring_skattepligtig_værdi_kroner = ll9c_fri_befordring_skattepligtig_værdi_kroner(input),
