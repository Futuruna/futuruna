# LigningslovFradragKildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)

= ligningsloven_lbk1500_par8 = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 8",
    hentet_dato = "2026-07-18"
)

= ll_par8_kildemeta = Source(
    value = ligningsloven_lbk1500_par8
)
--@label:ligningsloven_par8::meta:ll_par8_kildemeta--
----
§ 8. Ved opgørelsen af den skattepligtige indkomst fradrages udgifter, som i
forbindelse med den skattepligtiges erhverv er afholdt til rejser, reklame og
lignende med det formål at opnå salg af varer og tjenesteydelser i det
pågældende og senere indkomstår.

Stk. 2. Bestemmelserne i stk. 1 finder ikke anvendelse i de tilfælde, hvor den
skattepligtige indkomst opgøres som en procentdel af en forenings formue efter
reglerne i selskabsskatteloven.

Stk. 3. Ved opgørelsen af den skattepligtige indkomst fradrages:
a) løbende provisioner eller præmier for lån, som den skattepligtige optager,
eller for sikring af hans tilgodehavende,
b) præmier og lignende løbende ydelser for kaution for den skattepligtiges
gæld, og
c) stiftelsesprovisioner, engangspræmier og lignende engangsydelser for lån,
sikring af tilgodehavender eller kaution, som nævnt under a) og b), såfremt
løbetiden er mindre end 2 år.

Stk. 4. Ved opgørelsen af den skattepligtige indkomst fradrages udgifter til
repræsentation dog kun med et beløb svarende til 25 pct. af de afholdte
udgifter.
----

--@begin::ligningsloven_par8--
# Ligningslov8Stk1Udgiftsart = Ll8Stk1Rejse | Ll8Stk1Reklame | Ll8Stk1LignendeSalgsudgift | Ll8Stk1Repræsentation | Ll8Stk1AndenUdgift
# Ligningslov8Stk1Input(indkomstår: Heltal, afholdelsesår: Heltal, udgiftsart: Ligningslov8Stk1Udgiftsart, afholdt_udgift_kroner: Heltal, afholdt_i_forbindelse_med_skattepligtiges_erhverv: Boolsk, formål_at_opnå_salg_af_varer_eller_tjenesteydelser: Boolsk, foreningsindkomst_opgjort_som_procent_af_formue: Boolsk)
# Ligningslov8Stk1Resultat(indkomstår: Heltal, udgiftsart: Ligningslov8Stk1Udgiftsart, udgift_omfattet_af_stk1: Boolsk, afskåret_efter_stk2: Boolsk, begrænset_som_repræsentation_efter_stk4: Boolsk, fradragssats_basispoint: Heltal, afholdt_udgift_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, ikke_fradraget_kroner: Heltal)

# Ligningslov8Stk1Sag(input: Ligningslov8Stk1Input) {
    | udgiftsart_nævnt_i_stk1() -> input.udgiftsart == Ll8Stk1Rejse || input.udgiftsart == Ll8Stk1Reklame || input.udgiftsart == Ll8Stk1LignendeSalgsudgift || input.udgiftsart == Ll8Stk1Repræsentation
    | afholdt_i_indkomståret() -> input.afholdelsesår == input.indkomstår
    | afskåret_efter_stk2() -> input.foreningsindkomst_opgjort_som_procent_af_formue
    | udgift_omfattet_af_stk1() -> udgiftsart_nævnt_i_stk1() && afholdt_i_indkomståret() && input.afholdt_i_forbindelse_med_skattepligtiges_erhverv && input.formål_at_opnå_salg_af_varer_eller_tjenesteydelser && afskåret_efter_stk2() == Falskt
    | begrænset_som_repræsentation_efter_stk4() -> udgift_omfattet_af_stk1() && input.udgiftsart == Ll8Stk1Repræsentation
    | fradragssats_basispoint() -> 10000
    | exception repræsentation_fradrages_med_femogtyve_procent fradragssats_basispoint() -> 2500 under begrænset_som_repræsentation_efter_stk4()
    | afholdt_udgift_kroner() -> penge_positivt_beløb(input.afholdt_udgift_kroner)
    | fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | exception stk1_erhvervsmæssig_salgsudgift_fradrages fradrag_i_skattepligtig_indkomst_kroner() -> penge_beløb_gange_basispoint_kroner(afholdt_udgift_kroner(), fradragssats_basispoint()) under udgift_omfattet_af_stk1()
    | ikke_fradraget_kroner() -> afholdt_udgift_kroner() - fradrag_i_skattepligtig_indkomst_kroner()
    | resultat() -> Ligningslov8Stk1Resultat(
        indkomstår = input.indkomstår,
        udgiftsart = input.udgiftsart,
        udgift_omfattet_af_stk1 = udgift_omfattet_af_stk1(),
        afskåret_efter_stk2 = afskåret_efter_stk2(),
        begrænset_som_repræsentation_efter_stk4 = begrænset_som_repræsentation_efter_stk4(),
        fradragssats_basispoint = fradragssats_basispoint(),
        afholdt_udgift_kroner = afholdt_udgift_kroner(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        ikke_fradraget_kroner = ikke_fradraget_kroner()
    )
}

| ligningslov8_stk1_sag(input: Ligningslov8Stk1Input) -> Ligningslov8Stk1Sag(input)
| ligningslov8_stk1_resultat(input: Ligningslov8Stk1Input) -> ligningslov8_stk1_sag(input).resultat()
--@end::ligningsloven_par8--

= ligningsloven_lbk1500_par8b = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 8 B",
    hentet_dato = "2026-07-18"
)

= ll_par8b_kildemeta = Source(
    value = ligningsloven_lbk1500_par8b
)
--@label:ligningsloven_par8b::meta:ll_par8b_kildemeta--
----
§ 8 B. Ved opgørelsen af den skattepligtige indkomst kan udgifter, som
afholdes til forsøgs- og forskningsvirksomhed i tilknytning til den
skattepligtiges erhverv, bortset fra udgifter til efterforskning efter
råstoffer, jf. stk. 2, efter den skattepligtiges valg enten fradrages fuldt ud
i det indkomstår, hvori de er afholdt, eller afskrives med lige store årlige
beløb over dette og de følgende 4 indkomstår. Det samme gælder udgifter til
grundforskning, der afholdes af en igangværende virksomhed. Hvis udgifter som
nævnt i 1. pkt. er afholdt, før den skattepligtige påbegyndte erhvervet, kan
udgifterne først fradrages i det indkomstår, hvori erhvervet er påbegyndt,
eller afskrives som anført fra og med dette indkomstår, medmindre der er tale
om et aktie- eller anpartsselskab. Told- og skatteforvaltningen kan dog
tillade, at udgifterne fradrages eller afskrives som anført før påbegyndelsen
af erhvervet.

Stk. 2. Ved opgørelsen af den skattepligtige indkomst kan fradrages udgifter,
som afholdes til efterforskning efter råstoffer i tilknytning til den
skattepligtiges erhverv. Hvis udgifterne er afholdt, før den skattepligtige
påbegyndte erhvervet, afskrives udgifterne dog med lige store årlige beløb over
5 år fra og med det indkomstår, hvori erhvervet blev påbegyndt. Det samme
gælder, hvis udgifterne i det indkomstår, hvori de er afholdt, overstiger 30
pct. af den skattepligtiges overskud ved selvstændig erhvervsvirksomhed,
opgjort uden fradrag og afskrivning efter dette stykke, men med tillæg af
renteudgifter og valutakurstab og med fradrag af rente- og udbytteindtægter,
samt valutakursgevinst, som indgår i opgørelsen af overskuddet. Told- og
skatteforvaltningen kan tillade, at udgifter som omhandlet i 2. pkt. fradrages
eller afskrives før igangsættelsen af den erhvervsvirksomhed, hvorpå
efterforskningen tager sigte. Når omstændighederne taler derfor, kan told- og
skatteforvaltningen desuden tillade, at udgifter som omhandlet i 3. pkt.
fradrages på én gang.

Stk. 3. Uanset stk. 1 og 2 kan udgifter til anskaffelse af maskiner, inventar
og lignende driftsmidler, skibe og fast ejendom kun fradrages eller afskrives
efter lov om skattemæssige afskrivninger m.v.

Stk. 4. Fradrag eller afskrivninger efter stk. 1 kan for udgifter afholdt i
indkomstårene 2018 og 2019 foretages med et beløb svarende til 101,5 pct. af
den afholdte udgift, for indkomståret 2020 med 103 pct., for indkomstårene 2021
og 2022 med 105 pct. og for indkomstårene 2023-2025 med 108 pct. For
indkomstårene 2020-2022 kan der ud over fradrag eller afskrivninger efter 1.
pkt. foretages fradrag eller afskrivninger på 27 pct. for indkomståret 2020 og
25 pct. for indkomstårene 2021 og 2022 af udgiften. Fradrag eller afskrivninger
som nævnt i 1. pkt. kan for indkomståret 2026 foretages med et beløb svarende
til 114 pct. af den afholdte udgift, for indkomståret 2027 med et beløb
svarende til 116 pct. af den afholdte udgift og fra og med indkomståret 2028
med et beløb svarende til 120 pct. af den afholdte udgift. Fradrag eller
afskrivninger efter 2. pkt. og fradrag efter afskrivningslovens § 6, stk. 1,
nr. 3, 3. pkt., kan højst foretages for samlede udgifter på 845 mio. kr. i
indkomståret 2020 og 910 mio. kr. i indkomstårene 2021 og 2022. Fradrag eller
afskrivning efter 3. pkt. og fradrag efter afskrivningslovens § 6, stk. 1, nr.
3, 4. pkt., kan højst foretages for samlede udgifter på 793 mio. kr.
(2010-niveau). Udgifter over loftet i 5. pkt. kan fra og med indkomståret 2026
fradrages med 110 pct. Begrænsningerne efter 4. og 5. pkt. gælder samlet for
sambeskattede selskaber i samme koncern, idet den samlede begrænsning fordeles
forholdsmæssigt mellem de sambeskattede selskabers udgifter omfattet af 4. og
5. pkt. Grundbeløbet i 5. pkt. reguleres efter personskattelovens § 20, dog
således at det regulerede beløb afrundes opad til nærmeste kronebeløb, der kan
deles med 100.000.
----

--@begin::ligningsloven_par8b--
# Ligningslov8BUdgiftsart = Ll8BForsøgsOgForskningsvirksomhed | Ll8BGrundforskning | Ll8BRåstofefterforskning | Ll8BMaskineInventarEllerDriftsmiddel | Ll8BSkib | Ll8BFastEjendom | Ll8BAndenUdgift
# Ligningslov8BValg = Ll8BStraksfradrag | Ll8BLineærAfskrivningOverFemÅr
# Ligningslov8BErhvervsstart = Ll8BKendtErhvervspåbegyndelsesår(år: Heltal) | Ll8BErhvervEndnuIkkePåbegyndt
# Ligningslov8BInput(indkomstår: Heltal, afholdelsesår: Heltal, erhvervsstart: Ligningslov8BErhvervsstart, udgiftsart: Ligningslov8BUdgiftsart, valg: Ligningslov8BValg, afholdt_udgift_kroner: Heltal, tilknytning_til_skattepligtiges_erhverv: Boolsk, igangværende_virksomhed: Boolsk, aktie_eller_anpartsselskab: Boolsk, told_skat_tillader_fradrag_før_erhvervsstart: Boolsk, selvstændigt_overskud_før_stk2_fradrag_kroner: Heltal, renteudgifter_og_valutakurstab_i_overskud_kroner: Heltal, rente_udbytteindtægter_og_valutakursgevinster_i_overskud_kroner: Heltal, told_skat_tillader_straksfradrag_for_stort_råstofbeløb: Boolsk, tidligere_stk4_udgifter_under_koncernloft_kroner: Heltal, reguleringstal_tiendedele: Heltal)
# Ligningslov8BResultat(indkomstår: Heltal, afholdelsesår: Heltal, udgiftsart: Ligningslov8BUdgiftsart, omfattet_af_stk1: Boolsk, omfattet_af_stk2: Boolsk, henvist_til_afskrivningsloven_efter_stk3: Boolsk, afholdt_før_erhvervsstart: Boolsk, afventer_fastlagt_erhvervspåbegyndelsesår: Boolsk, råstofudgift_over_tredive_procent_af_overskud: Boolsk, fradragsstartår: Heltal, lineær_afskrivning_påkrævet_eller_valgt: Boolsk, stk4_loft_kroner: Heltal, udgift_under_stk4_loft_kroner: Heltal, udgift_over_stk4_loft_kroner: Heltal, forhøjet_fradragsgrundlag_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, henvist_til_afskrivningsloven_kroner: Heltal)

| ligningslov8b_afrund_op_til_hundrede_tusinde_kroner(beløb_kroner: Heltal) -> hvis beløb_kroner > 0 { (beløb_kroner + 99999) / 100000 * 100000 } ellers { 0 }
| ligningslov8b_stk4_loft_kroner(afholdelsesår: Heltal, reguleringstal_tiendedele: Heltal) -> 0
| exception ligningslov8b_loft_2020 ligningslov8b_stk4_loft_kroner(afholdelsesår: Heltal, reguleringstal_tiendedele: Heltal) -> 845000000 under afholdelsesår == 2020
| exception ligningslov8b_loft_2021_2022 ligningslov8b_stk4_loft_kroner(afholdelsesår: Heltal, reguleringstal_tiendedele: Heltal) -> 910000000 under afholdelsesår == 2021 || afholdelsesår == 2022
| exception ligningslov8b_reguleret_loft_fra_2026 ligningslov8b_stk4_loft_kroner(afholdelsesår: Heltal, reguleringstal_tiendedele: Heltal) -> ligningslov8b_afrund_op_til_hundrede_tusinde_kroner(793000000 * reguleringstal_tiendedele / 1000) under afholdelsesår >= 2026 && reguleringstal_tiendedele > 0

# Ligningslov8BSag(input: Ligningslov8BInput) {
    | afholdt_udgift_kroner() -> penge_positivt_beløb(input.afholdt_udgift_kroner)
    | henvist_til_afskrivningsloven_efter_stk3() -> input.udgiftsart == Ll8BMaskineInventarEllerDriftsmiddel || input.udgiftsart == Ll8BSkib || input.udgiftsart == Ll8BFastEjendom
    | omfattet_af_stk1_art() -> input.udgiftsart == Ll8BForsøgsOgForskningsvirksomhed || input.udgiftsart == Ll8BGrundforskning
    | grundforskning_opfylder_igangværende_krav() -> input.udgiftsart != Ll8BGrundforskning || input.igangværende_virksomhed
    | erhvervsstart_oplysning_gyldig() -> match input.erhvervsstart {
        | Ll8BKendtErhvervspåbegyndelsesår(år) -> år > 0
        | Ll8BErhvervEndnuIkkePåbegyndt -> Sandt
    }
    | kendt_erhvervspåbegyndelsesår() -> match input.erhvervsstart {
        | Ll8BKendtErhvervspåbegyndelsesår(år) -> penge_positivt_beløb(år)
        | Ll8BErhvervEndnuIkkePåbegyndt -> 0
    }
    | erhverv_endnu_ikke_påbegyndt() -> input.erhvervsstart == Ll8BErhvervEndnuIkkePåbegyndt
    | omfattet_af_stk1() -> omfattet_af_stk1_art() && grundforskning_opfylder_igangværende_krav() && input.tilknytning_til_skattepligtiges_erhverv && erhvervsstart_oplysning_gyldig() && henvist_til_afskrivningsloven_efter_stk3() == Falskt
    | omfattet_af_stk2() -> input.udgiftsart == Ll8BRåstofefterforskning && input.tilknytning_til_skattepligtiges_erhverv && erhvervsstart_oplysning_gyldig() && henvist_til_afskrivningsloven_efter_stk3() == Falskt
    | afholdt_før_erhvervsstart() -> erhverv_endnu_ikke_påbegyndt() || kendt_erhvervspåbegyndelsesår() > 0 && input.afholdelsesår < kendt_erhvervspåbegyndelsesår()
    | afventer_fastlagt_erhvervspåbegyndelsesår() -> (omfattet_af_stk1() || omfattet_af_stk2()) && erhverv_endnu_ikke_påbegyndt() && input.aktie_eller_anpartsselskab == Falskt && input.told_skat_tillader_fradrag_før_erhvervsstart == Falskt
    | stk1_må_fradrages_fra_afholdelsesåret() -> input.aktie_eller_anpartsselskab || afholdt_før_erhvervsstart() == Falskt || input.told_skat_tillader_fradrag_før_erhvervsstart
    | stk2_overskud_før_nulgrænse_kroner() -> input.selvstændigt_overskud_før_stk2_fradrag_kroner + penge_positivt_beløb(input.renteudgifter_og_valutakurstab_i_overskud_kroner) - penge_positivt_beløb(input.rente_udbytteindtægter_og_valutakursgevinster_i_overskud_kroner)
    | stk2_overskud_efter_lovens_korrektioner_kroner() -> penge_positivt_beløb(stk2_overskud_før_nulgrænse_kroner())
    | stk2_tredive_procent_af_overskud_kroner() -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(stk2_overskud_efter_lovens_korrektioner_kroner()), 3000)
    | råstofudgift_over_tredive_procent_af_overskud() -> omfattet_af_stk2() && afholdt_udgift_kroner() > stk2_tredive_procent_af_overskud_kroner()
    | fradragsstartår() -> input.afholdelsesår
    | exception stk1_udgift_venter_til_kendt_erhvervsstart fradragsstartår() -> kendt_erhvervspåbegyndelsesår() under omfattet_af_stk1() && afholdt_før_erhvervsstart() && kendt_erhvervspåbegyndelsesår() > 0 && stk1_må_fradrages_fra_afholdelsesåret() == Falskt
    | exception stk2_udgift_venter_til_kendt_erhvervsstart fradragsstartår() -> kendt_erhvervspåbegyndelsesår() under omfattet_af_stk2() && afholdt_før_erhvervsstart() && kendt_erhvervspåbegyndelsesår() > 0 && input.told_skat_tillader_fradrag_før_erhvervsstart == Falskt
    | exception udgift_afventer_endnu_ukendt_erhvervsstart fradragsstartår() -> 0 under afventer_fastlagt_erhvervspåbegyndelsesår()
    | lineær_afskrivning_påkrævet_eller_valgt() -> Falskt
    | exception stk1_vælger_lineær_afskrivning lineær_afskrivning_påkrævet_eller_valgt() -> Sandt under omfattet_af_stk1() && input.valg == Ll8BLineærAfskrivningOverFemÅr
    | exception stk2_før_start_afskrives_lineært lineær_afskrivning_påkrævet_eller_valgt() -> Sandt under omfattet_af_stk2() && afholdt_før_erhvervsstart() && input.told_skat_tillader_fradrag_før_erhvervsstart == Falskt
    | exception stk2_før_start_med_tilladelse_vælger_lineær_afskrivning lineær_afskrivning_påkrævet_eller_valgt() -> Sandt under omfattet_af_stk2() && afholdt_før_erhvervsstart() && input.told_skat_tillader_fradrag_før_erhvervsstart && input.valg == Ll8BLineærAfskrivningOverFemÅr
    | exception stk2_stort_beløb_afskrives_lineært lineær_afskrivning_påkrævet_eller_valgt() -> Sandt under omfattet_af_stk2() && råstofudgift_over_tredive_procent_af_overskud() && input.told_skat_tillader_straksfradrag_for_stort_råstofbeløb == Falskt
    | stk4_loft_kroner() -> ligningslov8b_stk4_loft_kroner(input.afholdelsesår, input.reguleringstal_tiendedele)
    | tidligere_stk4_udgifter_under_koncernloft_kroner() -> penge_positivt_beløb(input.tidligere_stk4_udgifter_under_koncernloft_kroner)
    | resterende_stk4_loft_kroner() -> penge_positivt_beløb(stk4_loft_kroner() - tidligere_stk4_udgifter_under_koncernloft_kroner())
    | udgift_under_stk4_loft_kroner() -> afholdt_udgift_kroner()
    | exception stk4_loft_fordeler_udgiften udgift_under_stk4_loft_kroner() -> penge_mindste_beløb(afholdt_udgift_kroner(), resterende_stk4_loft_kroner()) under omfattet_af_stk1() && stk4_loft_kroner() > 0
    | udgift_over_stk4_loft_kroner() -> afholdt_udgift_kroner() - udgift_under_stk4_loft_kroner()
    | stk4_grundsats_basispoint() -> 10000
    | exception stk4_2018_2019_sats stk4_grundsats_basispoint() -> 10150 under input.afholdelsesår == 2018 || input.afholdelsesår == 2019
    | exception stk4_2020_sats stk4_grundsats_basispoint() -> 10300 under input.afholdelsesår == 2020
    | exception stk4_2021_2022_sats stk4_grundsats_basispoint() -> 10500 under input.afholdelsesår == 2021 || input.afholdelsesår == 2022
    | exception stk4_2023_2025_sats stk4_grundsats_basispoint() -> 10800 under input.afholdelsesår >= 2023 && input.afholdelsesår <= 2025
    | exception stk4_2026_sats stk4_grundsats_basispoint() -> 11400 under input.afholdelsesår == 2026
    | exception stk4_2027_sats stk4_grundsats_basispoint() -> 11600 under input.afholdelsesår == 2027
    | exception stk4_fra_2028_sats stk4_grundsats_basispoint() -> 12000 under input.afholdelsesår >= 2028
    | stk4_ekstra_sats_under_loft_basispoint() -> 0
    | exception stk4_2020_ekstra_sats stk4_ekstra_sats_under_loft_basispoint() -> 2700 under input.afholdelsesår == 2020
    | exception stk4_2021_2022_ekstra_sats stk4_ekstra_sats_under_loft_basispoint() -> 2500 under input.afholdelsesår == 2021 || input.afholdelsesår == 2022
    | stk4_over_loft_sats_basispoint() -> stk4_grundsats_basispoint()
    | exception stk4_fra_2026_over_loft_110_procent stk4_over_loft_sats_basispoint() -> 11000 under input.afholdelsesår >= 2026
    | forhøjet_stk1_fradragsgrundlag_kroner() -> penge_beløb_gange_basispoint_kroner(udgift_under_stk4_loft_kroner(), stk4_grundsats_basispoint() + stk4_ekstra_sats_under_loft_basispoint()) + penge_beløb_gange_basispoint_kroner(udgift_over_stk4_loft_kroner(), stk4_over_loft_sats_basispoint())
    | forhøjet_fradragsgrundlag_kroner() -> afholdt_udgift_kroner()
    | exception stk1_forhøjes_efter_stk4 forhøjet_fradragsgrundlag_kroner() -> forhøjet_stk1_fradragsgrundlag_kroner() under omfattet_af_stk1()
    | indkomstår_i_femårsperiode() -> input.indkomstår >= fradragsstartår() && input.indkomstår <= fradragsstartår() + 4
    | lineært_årsfradrag_kroner() -> 0
    | exception første_fire_lineære_år lineært_årsfradrag_kroner() -> forhøjet_fradragsgrundlag_kroner() / 5 under indkomstår_i_femårsperiode() && input.indkomstår < fradragsstartår() + 4
    | exception sidste_lineære_år_bevarer_resten lineært_årsfradrag_kroner() -> forhøjet_fradragsgrundlag_kroner() - forhøjet_fradragsgrundlag_kroner() / 5 * 4 under indkomstår_i_femårsperiode() && input.indkomstår == fradragsstartår() + 4
    | straksfradrag_i_indkomståret_kroner() -> 0
    | exception straksfradrag_i_startåret straksfradrag_i_indkomståret_kroner() -> forhøjet_fradragsgrundlag_kroner() under input.indkomstår == fradragsstartår()
    | fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | exception omfattet_lineær_udgift_fradrages fradrag_i_skattepligtig_indkomst_kroner() -> lineært_årsfradrag_kroner() under (omfattet_af_stk1() || omfattet_af_stk2()) && lineær_afskrivning_påkrævet_eller_valgt()
    | exception omfattet_straksudgift_fradrages fradrag_i_skattepligtig_indkomst_kroner() -> straksfradrag_i_indkomståret_kroner() under (omfattet_af_stk1() || omfattet_af_stk2()) && lineær_afskrivning_påkrævet_eller_valgt() == Falskt
    | henvist_til_afskrivningsloven_kroner() -> 0
    | exception stk3_henviser_anskaffelsen_til_afskrivningsloven henvist_til_afskrivningsloven_kroner() -> afholdt_udgift_kroner() under henvist_til_afskrivningsloven_efter_stk3()
    | resultat() -> Ligningslov8BResultat(
        indkomstår = input.indkomstår,
        afholdelsesår = input.afholdelsesår,
        udgiftsart = input.udgiftsart,
        omfattet_af_stk1 = omfattet_af_stk1(),
        omfattet_af_stk2 = omfattet_af_stk2(),
        henvist_til_afskrivningsloven_efter_stk3 = henvist_til_afskrivningsloven_efter_stk3(),
        afholdt_før_erhvervsstart = afholdt_før_erhvervsstart(),
        afventer_fastlagt_erhvervspåbegyndelsesår = afventer_fastlagt_erhvervspåbegyndelsesår(),
        råstofudgift_over_tredive_procent_af_overskud = råstofudgift_over_tredive_procent_af_overskud(),
        fradragsstartår = fradragsstartår(),
        lineær_afskrivning_påkrævet_eller_valgt = lineær_afskrivning_påkrævet_eller_valgt(),
        stk4_loft_kroner = stk4_loft_kroner(),
        udgift_under_stk4_loft_kroner = udgift_under_stk4_loft_kroner(),
        udgift_over_stk4_loft_kroner = udgift_over_stk4_loft_kroner(),
        forhøjet_fradragsgrundlag_kroner = forhøjet_fradragsgrundlag_kroner(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        henvist_til_afskrivningsloven_kroner = henvist_til_afskrivningsloven_kroner()
    )
}

| ligningslov8b_sag(input: Ligningslov8BInput) -> Ligningslov8BSag(input)
| ligningslov8b_resultat(input: Ligningslov8BInput) -> ligningslov8b_sag(input).resultat()
--@end::ligningsloven_par8b--

= ligningsloven_lbk1500_par8k = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 8 K",
    hentet_dato = "2026-07-18"
)

= ll_par8k_kildemeta = Source(
    value = ligningsloven_lbk1500_par8k
)
--@label:ligningsloven_par8k::meta:ll_par8k_kildemeta--
----
§ 8 K. Ved opgørelsen af den skattepligtige indkomst kan udgifter, der
afholdes til nyplantning af fredskov, fradrages med indtil 20 pct. årligt.
Overstiger udgifterne ikke 25.000 kr. pr. år pr. ejendom, kan beløbet dog
fradrages i det indkomstår, hvori udgiften er afholdt. Såfremt ejendommen
sælges eller det tilplantede areal ryddes efter brand, kan udgifter, der endnu
ikke er fradraget efter 1. pkt., fratrækkes i det indkomstår, hvori salget
eller rydningen sker. Det er en betingelse for fradrag, at det tilplantede
areal pålægges fredskovspligt efter skovlovens bestemmelser herom, og at
fredskovspligten registreres i matrikelregisteret og på matrikelkortet.
Udgifter til genplantning af skov kan fradrages straks.

Stk. 2. Ved opgørelsen af den skattepligtige indkomst kan udgifter til
plantning af træer, der er bestemt til erhvervsmæssig anvendelse som juletræer
eller pyntegrønt i kort omdrift, samt frugttræer og frugtbuske fradrages med
indtil 20 pct. årligt. Overstiger udgifterne ikke 25.000 kr. pr. år pr.
ejendom, kan beløbet dog fradrages i det indkomstår, hvori udgiften er afholdt.
Udgifter til genplantning i skov af træer, der er bestemt til erhvervsmæssig
anvendelse som juletræer eller pyntegrønt, kan dog uanset 1. pkt. fradrages
straks. Såfremt ejendommen sælges, eller det tilplantede areal ryddes, kan
udgifter, der endnu ikke er fradraget efter 1. pkt., fratrækkes i det
indkomstår, hvori salget eller rydningen sker.

Stk. 3. Ved opgørelsen af den skattepligtige indkomst kan udgifter, der
afholdes til anlæg af læhegn samt supplerende lægivende løvtræplantning, jf.
lov om læhegn og tilskud til læplantning, fradrages fuldt ud i den
skattepligtige indkomst i det indkomstår, hvori udgiften er afholdt. Tilskud
til læplantning ydet efter lov om læhegn medregnes i den skattepligtige
indkomst i samme indkomstår, hvori udgifter efter 1. pkt. afholdes.

Stk. 4. Ved opgørelsen af den skattepligtige indkomst kan udgifter til
plantning af flerårige energiafgrøder i form af ask, el, elefantgræs, hassel,
pil, poppel og præriegræs fradrages fuldt ud i den skattepligtige indkomst for
det indkomstår, hvori udgiften er afholdt. Det er en betingelse, at den
skattepligtiges areal med planter af de arter, som er nævnt i 1. pkt., i ren
eller blandet bestand er på mindst 0,30 ha. Der kan dog ikke opnås fradrag for
udgifter, der afholdes til plantning af flerårige energiafgrøder uden for
EU/EØS, Grønland og Færøerne.

Stk. 5. Anskaffelsessummer og afståelsessummer for træer mv. omfattet af stk.
1-4 omregnes til kontantværdi.

Stk. 6. Stk. 1-5 finder tilsvarende anvendelse på udgifter til plantning på
lejet eller forpagtet jord. Det gælder dog ikke adgangen til straksfradrag for
udgifter, der ikke overstiger 25.000 kr. pr. år pr. ejendom, jf. stk. 1, 2.
pkt., og stk. 2, 2. pkt., samt adgangen til at fratrække udgifter, der endnu
ikke er fradraget ved salg af ejendommen, jf. stk. 1, 3. pkt., og stk. 2, 4.
pkt. Ophører et leje- eller forpagtningsforhold, kan lejeren eller forpagteren
fratrække udgifter, der endnu ikke er fradraget efter stk. 1 eller stk. 2, 1.
pkt., i det år, hvori leje- eller forpagtningsforholdet ophører.

Stk. 7. Udgifter, der er fratrukket efter stk. 1-5, medregnes ikke til
anskaffelsessummen ved opgørelsen af skattepligtig fortjeneste eller tab ved
afståelse af fast ejendom.

Stk. 8. Uanset stk. 1-4 kan udgifter til anskaffelse af maskiner, inventar og
lignende driftsmidler og fast ejendom kun fradrages eller afskrives efter lov
om skattemæssige afskrivninger mv.
----

--@begin::ligningsloven_par8k--
# Ligningslov8KPlantningsart = Ll8KNyplantningAfFredskov | Ll8KGenplantningAfSkov | Ll8KKortOmdriftJuletræEllerPyntegrønt | Ll8KFrugttræEllerFrugtbusk | Ll8KGenplantningAfJuletræEllerPyntegrøntISkov | Ll8KLæhegnEllerSupplerendeLæplantning | Ll8KEnergiafgrødeAsk | Ll8KEnergiafgrødeEl | Ll8KEnergiafgrødeElefantgræs | Ll8KEnergiafgrødeHassel | Ll8KEnergiafgrødePil | Ll8KEnergiafgrødePoppel | Ll8KEnergiafgrødePræriegræs | Ll8KAndenPlantning
# Ligningslov8KHændelse = Ll8KIngenSærhændelse | Ll8KEjendomSolgt | Ll8KArealRyddetEfterBrand | Ll8KArealRyddetAfAndenGrund | Ll8KLejeEllerForpagtningOphørt
# Ligningslov8KOmråde = Ll8KEuEøs | Ll8KGrønlandEllerFærøerne | Ll8KUdenforTilladtOmråde
# Ligningslov8KInput(indkomstår: Heltal, afholdelsesår: Heltal, plantningsart: Ligningslov8KPlantningsart, hændelse: Ligningslov8KHændelse, område: Ligningslov8KOmråde, afholdt_udgift_kroner: Heltal, tidligere_fradraget_kroner: Heltal, årets_samlede_udgifter_pr_ejendom_kroner: Heltal, valgt_fradrag_kroner: Heltal, fredskovspligt_pålagt_og_registreret: Boolsk, energiafgrødeareal_kvadratmeter: Heltal, lejet_eller_forpagtet_jord: Boolsk, udgift_til_maskine_inventar_driftsmiddel_eller_fast_ejendom: Boolsk)
# Ligningslov8KResultat(indkomstår: Heltal, plantningsart: Ligningslov8KPlantningsart, omfattet_af_stk1: Boolsk, omfattet_af_stk2: Boolsk, omfattet_af_stk3: Boolsk, omfattet_af_stk4: Boolsk, straksfradrag_tilladt: Boolsk, højeste_fradrag_i_indkomståret_kroner: Heltal, valgt_fradrag_kroner: Heltal, valgt_fradrag_begrænset: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal, resterende_ikke_fradraget_kroner: Heltal, fradrag_udelukket_fra_ejendommens_anskaffelsessum: Boolsk, henvist_til_afskrivningsloven_kroner: Heltal)

# Ligningslov8KSag(input: Ligningslov8KInput) {
    | afholdt_udgift_kroner() -> penge_positivt_beløb(input.afholdt_udgift_kroner)
    | tidligere_fradraget_kroner() -> penge_mindste_beløb(penge_positivt_beløb(input.tidligere_fradraget_kroner), afholdt_udgift_kroner())
    | resterende_før_årets_fradrag_kroner() -> afholdt_udgift_kroner() - tidligere_fradraget_kroner()
    | henvist_til_afskrivningsloven() -> input.udgift_til_maskine_inventar_driftsmiddel_eller_fast_ejendom
    | omfattet_af_stk1() -> (input.plantningsart == Ll8KNyplantningAfFredskov || input.plantningsart == Ll8KGenplantningAfSkov) && input.fredskovspligt_pålagt_og_registreret && henvist_til_afskrivningsloven() == Falskt
    | omfattet_af_stk2() -> (input.plantningsart == Ll8KKortOmdriftJuletræEllerPyntegrønt || input.plantningsart == Ll8KFrugttræEllerFrugtbusk || input.plantningsart == Ll8KGenplantningAfJuletræEllerPyntegrøntISkov) && henvist_til_afskrivningsloven() == Falskt
    | omfattet_af_stk3() -> input.plantningsart == Ll8KLæhegnEllerSupplerendeLæplantning && henvist_til_afskrivningsloven() == Falskt
    | er_energiafgrøde_nævnt_i_stk4() -> input.plantningsart == Ll8KEnergiafgrødeAsk || input.plantningsart == Ll8KEnergiafgrødeEl || input.plantningsart == Ll8KEnergiafgrødeElefantgræs || input.plantningsart == Ll8KEnergiafgrødeHassel || input.plantningsart == Ll8KEnergiafgrødePil || input.plantningsart == Ll8KEnergiafgrødePoppel || input.plantningsart == Ll8KEnergiafgrødePræriegræs
    | energiafgrøde_i_tilladt_område() -> input.område == Ll8KEuEøs || input.område == Ll8KGrønlandEllerFærøerne
    | omfattet_af_stk4() -> er_energiafgrøde_nævnt_i_stk4() && input.energiafgrødeareal_kvadratmeter >= 3000 && energiafgrøde_i_tilladt_område() && henvist_til_afskrivningsloven() == Falskt
    | omfattet_af_stk1_eller_stk2() -> omfattet_af_stk1() || omfattet_af_stk2()
    | afholdt_i_indkomståret() -> input.indkomstår == input.afholdelsesår
    | årets_samlede_udgifter_pr_ejendom_kroner() -> penge_største_beløb(afholdt_udgift_kroner(), penge_positivt_beløb(input.årets_samlede_udgifter_pr_ejendom_kroner))
    | under_femogtyve_tusinde_pr_ejendom() -> årets_samlede_udgifter_pr_ejendom_kroner() <= 25000
    | straksfradrag_for_lille_ejerudgift() -> omfattet_af_stk1_eller_stk2() && afholdt_i_indkomståret() && under_femogtyve_tusinde_pr_ejendom() && input.lejet_eller_forpagtet_jord == Falskt
    | straksfradrag_for_genplantning() -> afholdt_i_indkomståret() && (input.plantningsart == Ll8KGenplantningAfSkov || input.plantningsart == Ll8KGenplantningAfJuletræEllerPyntegrøntISkov) && (omfattet_af_stk1() || omfattet_af_stk2())
    | stk1_terminal_hændelse() -> omfattet_af_stk1() && input.plantningsart == Ll8KNyplantningAfFredskov && input.lejet_eller_forpagtet_jord == Falskt && (input.hændelse == Ll8KEjendomSolgt || input.hændelse == Ll8KArealRyddetEfterBrand)
    | stk2_terminal_hændelse() -> omfattet_af_stk2() && (input.plantningsart == Ll8KKortOmdriftJuletræEllerPyntegrønt || input.plantningsart == Ll8KFrugttræEllerFrugtbusk) && input.lejet_eller_forpagtet_jord == Falskt && (input.hændelse == Ll8KEjendomSolgt || input.hændelse == Ll8KArealRyddetEfterBrand || input.hændelse == Ll8KArealRyddetAfAndenGrund)
    | lejeophør_udløser_restfradrag() -> omfattet_af_stk1_eller_stk2() && input.lejet_eller_forpagtet_jord && input.hændelse == Ll8KLejeEllerForpagtningOphørt
    | stk3_eller_stk4_straksfradrag() -> afholdt_i_indkomståret() && (omfattet_af_stk3() || omfattet_af_stk4())
    | straksfradrag_tilladt() -> straksfradrag_for_lille_ejerudgift() || straksfradrag_for_genplantning() || stk1_terminal_hændelse() || stk2_terminal_hændelse() || lejeophør_udløser_restfradrag() || stk3_eller_stk4_straksfradrag()
    | ordinært_tyve_procent_fradrag_kroner() -> penge_beløb_gange_basispoint_kroner(afholdt_udgift_kroner(), 2000)
    | højeste_fradrag_i_indkomståret_kroner() -> 0
    | exception stk1_stk2_ordinært_tyve_procent_fradrag højeste_fradrag_i_indkomståret_kroner() -> penge_mindste_beløb(ordinært_tyve_procent_fradrag_kroner(), resterende_før_årets_fradrag_kroner()) under omfattet_af_stk1_eller_stk2() && input.indkomstår >= input.afholdelsesår && straksfradrag_tilladt() == Falskt
    | exception straksfradrag_omfatter_resten højeste_fradrag_i_indkomståret_kroner() -> resterende_før_årets_fradrag_kroner() under straksfradrag_tilladt()
    | valgt_fradrag_kroner() -> penge_positivt_beløb(input.valgt_fradrag_kroner)
    | valgt_fradrag_begrænset() -> valgt_fradrag_kroner() > højeste_fradrag_i_indkomståret_kroner()
    | fradrag_i_skattepligtig_indkomst_kroner() -> penge_mindste_beløb(valgt_fradrag_kroner(), højeste_fradrag_i_indkomståret_kroner())
    | resterende_ikke_fradraget_kroner() -> resterende_før_årets_fradrag_kroner() - fradrag_i_skattepligtig_indkomst_kroner()
    | fradrag_udelukket_fra_ejendommens_anskaffelsessum() -> fradrag_i_skattepligtig_indkomst_kroner() > 0
    | henvist_til_afskrivningsloven_kroner() -> 0
    | exception stk8_henviser_aktivudgift_til_afskrivningsloven henvist_til_afskrivningsloven_kroner() -> afholdt_udgift_kroner() under henvist_til_afskrivningsloven()
    | resultat() -> Ligningslov8KResultat(
        indkomstår = input.indkomstår,
        plantningsart = input.plantningsart,
        omfattet_af_stk1 = omfattet_af_stk1(),
        omfattet_af_stk2 = omfattet_af_stk2(),
        omfattet_af_stk3 = omfattet_af_stk3(),
        omfattet_af_stk4 = omfattet_af_stk4(),
        straksfradrag_tilladt = straksfradrag_tilladt(),
        højeste_fradrag_i_indkomståret_kroner = højeste_fradrag_i_indkomståret_kroner(),
        valgt_fradrag_kroner = valgt_fradrag_kroner(),
        valgt_fradrag_begrænset = valgt_fradrag_begrænset(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        resterende_ikke_fradraget_kroner = resterende_ikke_fradraget_kroner(),
        fradrag_udelukket_fra_ejendommens_anskaffelsessum = fradrag_udelukket_fra_ejendommens_anskaffelsessum(),
        henvist_til_afskrivningsloven_kroner = henvist_til_afskrivningsloven_kroner()
    )
}

| ligningslov8k_sag(input: Ligningslov8KInput) -> Ligningslov8KSag(input)
| ligningslov8k_resultat(input: Ligningslov8KInput) -> ligningslov8k_sag(input).resultat()
--@end::ligningsloven_par8k--

= ligningsloven_lbk1500_par8l = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 8 L",
    hentet_dato = "2026-07-18"
)

= ll_par8l_kildemeta = Source(
    value = ligningsloven_lbk1500_par8l
)
--@label:ligningsloven_par8l::meta:ll_par8l_kildemeta--
----
§ 8 L. Ved opgørelsen af den skattepligtige indkomst kan fradrages beløb, som
efter lov om friplejeboliger er indbetalt til Landsbyggefonden som følge af,
at huslejeindtægterne overstiger udgifterne på bygningerne opgjort efter
reglerne i lov om friplejeboliger.

Stk. 2. Ved opgørelsen af den skattepligtige indkomst fradrages beløb, som er
indbetalt til Landsbyggefonden i forbindelse med, at friplejeboliger eller
servicearealer tilknyttet friplejeboliger er solgt eller taget i brug til
anden anvendelse efter kapitel 9 i lov om friplejeboliger.
----

--@begin::ligningsloven_par8l--
# Ligningslov8LIndbetalingsgrundlag = Ll8LHuslejeindtægterOverstigerBygningsudgifter | Ll8LSalgAfFriplejeboligEllerServiceareal | Ll8LAndenAnvendelseAfFriplejeboligEllerServiceareal | Ll8LAndenIndbetaling
# Ligningslov8LInput(indkomstår: Heltal, indbetalingsår: Heltal, indbetalingsgrundlag: Ligningslov8LIndbetalingsgrundlag, indbetalt_til_landsbyggefonden_kroner: Heltal, omfattet_af_lov_om_friplejeboliger: Boolsk)
# Ligningslov8LResultat(indkomstår: Heltal, indbetalingsgrundlag: Ligningslov8LIndbetalingsgrundlag, omfattet_af_stk1: Boolsk, omfattet_af_stk2: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal)

# Ligningslov8LSag(input: Ligningslov8LInput) {
    | indbetalt_i_indkomståret() -> input.indbetalingsår == input.indkomstår
    | omfattet_af_stk1() -> input.omfattet_af_lov_om_friplejeboliger && indbetalt_i_indkomståret() && input.indbetalingsgrundlag == Ll8LHuslejeindtægterOverstigerBygningsudgifter
    | omfattet_af_stk2() -> input.omfattet_af_lov_om_friplejeboliger && indbetalt_i_indkomståret() && (input.indbetalingsgrundlag == Ll8LSalgAfFriplejeboligEllerServiceareal || input.indbetalingsgrundlag == Ll8LAndenAnvendelseAfFriplejeboligEllerServiceareal)
    | fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | exception landsbyggefondsindbetaling_fradrages fradrag_i_skattepligtig_indkomst_kroner() -> penge_positivt_beløb(input.indbetalt_til_landsbyggefonden_kroner) under omfattet_af_stk1() || omfattet_af_stk2()
    | resultat() -> Ligningslov8LResultat(
        indkomstår = input.indkomstår,
        indbetalingsgrundlag = input.indbetalingsgrundlag,
        omfattet_af_stk1 = omfattet_af_stk1(),
        omfattet_af_stk2 = omfattet_af_stk2(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner()
    )
}

| ligningslov8l_sag(input: Ligningslov8LInput) -> Ligningslov8LSag(input)
| ligningslov8l_resultat(input: Ligningslov8LInput) -> ligningslov8l_sag(input).resultat()
--@end::ligningsloven_par8l--

= ligningsloven_lbk1500_par8m = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 8 M",
    hentet_dato = "2026-07-18"
)

= ll_par8m_kildemeta = Source(
    value = ligningsloven_lbk1500_par8m
)
--@label:ligningsloven_par8m::meta:ll_par8m_kildemeta--
----
§ 8 M. Arbejdsmarkedsbidrag af indkomst omfattet af § 2, stk. 1, nr. 2, og §§
4 og 5 i lov om arbejdsmarkedsbidrag fragår ved opgørelsen af den pågældendes
skattepligtige indkomst for det indkomstår, bidraget vedrører. Tilsvarende
gælder indkomst omfattet af § 2, stk. 1, nr. 1, når arbejdsgiveren ikke er
indeholdelsespligtig af udbetalt løn, vederlag, honorar m.v. til den ansatte.

Stk. 2. For personer omfattet af kildeskattelovens § 1 fragår obligatoriske
udenlandske sociale bidrag ved opgørelsen af den skattepligtige indkomst for det
indkomstår, som bidraget vedrører, når den pågældende
1) i henhold til en eventuel dobbeltbeskatningsoverenskomst ikke er
hjemmehørende i fremmed stat, Grønland eller Færøerne og
2) er omfattet af social sikringslovgivning i fremmed stat i medfør af De
Europæiske Fællesskabers forordninger om social sikring for arbejdstagere,
selvstændigt erhvervsdrivende og deres familiemedlemmer, der flytter inden for
Fællesskabet.

Stk. 3. Bestemmelsen i stk. 2 finder tilsvarende anvendelse på personer, som i
medfør af en mellemfolkelig aftale, som Danmark har tiltrådt, er omfattet af
udenlandsk social sikringslovgivning.

Stk. 4. Personer, som er omfattet af kildeskattelovens § 2, stk. 1, nr. 1 eller
3, og som i medfør af De Europæiske Fællesskabers forordninger om social
sikring for arbejdstagere, selvstændigt erhvervsdrivende og deres familier, der
flytter inden for Det Europæiske Fællesskab, er undergivet udenlandsk social
sikringslovgivning, kan fradrage udenlandske obligatoriske sociale
arbejdsgiverbidrag ved opgørelsen af den skattepligtige indkomst for det
indkomstår, som bidragene vedrører. Det er en betingelse for fradrag, at der i
medfør af De Europæiske Fællesskabers forordninger om social sikring er indgået
aftale om, at de udenlandske arbejdsgiverbidrag påhviler lønmodtageren.

Stk. 5. Skatteministeren kan fastsætte bestemmelser om opkrævning og afregning
af bidrag efter stk. 4.
----

--@begin::ligningsloven_par8m--
# Ligningslov8MArbejdsmarkedsbidragHjemmel = Ll8MAmblPar2Stk1Nr1 | Ll8MAmblPar2Stk1Nr2 | Ll8MAmblPar4 | Ll8MAmblPar5 | Ll8MAmblIkkeOmfattet
# Ligningslov8MKildeskattepligt = Ll8MKildeskattelovPar1 | Ll8MKildeskattelovPar2Stk1Nr1 | Ll8MKildeskattelovPar2Stk1Nr3 | Ll8MAndenKildeskattepligt
# Ligningslov8MArbejdsmarkedsbidragInput(hjemmel: Ligningslov8MArbejdsmarkedsbidragHjemmel, bidrag_kroner: Heltal, bidrag_vedrører_indkomstår: Heltal, arbejdsgiver_indeholdelsespligtig: Boolsk)
# Ligningslov8MUdenlandskSocialtBidragInput(bidrag_kroner: Heltal, bidrag_vedrører_indkomstår: Heltal, obligatorisk: Boolsk, ikke_hjemmehørende_i_fremmed_stat_grønland_eller_færøerne_efter_dbo: Boolsk, omfattet_af_eu_socialsikringsforordning: Boolsk, omfattet_af_mellemfolkelig_aftale_som_danmark_har_tiltrådt: Boolsk)
# Ligningslov8MUdenlandskArbejdsgiverbidragInput(bidrag_kroner: Heltal, bidrag_vedrører_indkomstår: Heltal, obligatorisk: Boolsk, omfattet_af_eu_socialsikringsforordning: Boolsk, aftale_om_at_bidrag_påhviler_lønmodtageren: Boolsk)
# Ligningslov8MInput(indkomstår: Heltal, kildeskattepligt: Ligningslov8MKildeskattepligt, arbejdsmarkedsbidrag: Ligningslov8MArbejdsmarkedsbidragInput, udenlandsk_socialt_bidrag: Ligningslov8MUdenlandskSocialtBidragInput, udenlandsk_arbejdsgiverbidrag: Ligningslov8MUdenlandskArbejdsgiverbidragInput)
# Ligningslov8MResultat(indkomstår: Heltal, kildeskattepligt: Ligningslov8MKildeskattepligt, arbejdsmarkedsbidrag_omfattet_af_stk1: Boolsk, arbejdsmarkedsbidrag_fradrag_kroner: Heltal, udenlandsk_socialt_bidrag_omfattet_af_stk2: Boolsk, udenlandsk_socialt_bidrag_omfattet_af_stk3: Boolsk, udenlandsk_socialt_bidrag_fradrag_kroner: Heltal, udenlandsk_arbejdsgiverbidrag_omfattet_af_stk4: Boolsk, udenlandsk_arbejdsgiverbidrag_fradrag_kroner: Heltal, samlet_fradrag_kroner: Heltal, skatteministeren_bemyndiget_efter_stk5: Boolsk)

# Ligningslov8MSag(input: Ligningslov8MInput) {
    | arbejdsmarkedsbidrag_vedrører_indkomståret() -> input.arbejdsmarkedsbidrag.bidrag_vedrører_indkomstår == input.indkomstår
    | arbejdsmarkedsbidrag_omfattet_af_stk1() -> Falskt
    | exception ambl_par2_stk1_nr2_og_par4_par5 arbejdsmarkedsbidrag_omfattet_af_stk1() -> Sandt under arbejdsmarkedsbidrag_vedrører_indkomståret() && (input.arbejdsmarkedsbidrag.hjemmel == Ll8MAmblPar2Stk1Nr2 || input.arbejdsmarkedsbidrag.hjemmel == Ll8MAmblPar4 || input.arbejdsmarkedsbidrag.hjemmel == Ll8MAmblPar5)
    | exception ambl_par2_stk1_nr1_uden_indeholdelsespligt arbejdsmarkedsbidrag_omfattet_af_stk1() -> Sandt under arbejdsmarkedsbidrag_vedrører_indkomståret() && input.arbejdsmarkedsbidrag.hjemmel == Ll8MAmblPar2Stk1Nr1 && input.arbejdsmarkedsbidrag.arbejdsgiver_indeholdelsespligtig == Falskt
    | arbejdsmarkedsbidrag_fradrag_kroner() -> 0
    | exception arbejdsmarkedsbidrag_fradrages arbejdsmarkedsbidrag_fradrag_kroner() -> penge_positivt_beløb(input.arbejdsmarkedsbidrag.bidrag_kroner) under arbejdsmarkedsbidrag_omfattet_af_stk1()
    | udenlandsk_socialt_bidrag_vedrører_indkomståret() -> input.udenlandsk_socialt_bidrag.bidrag_vedrører_indkomstår == input.indkomstår
    | udenlandsk_socialt_bidrag_fælles_betingelser() -> udenlandsk_socialt_bidrag_vedrører_indkomståret() && input.kildeskattepligt == Ll8MKildeskattelovPar1 && input.udenlandsk_socialt_bidrag.obligatorisk && input.udenlandsk_socialt_bidrag.ikke_hjemmehørende_i_fremmed_stat_grønland_eller_færøerne_efter_dbo
    | udenlandsk_socialt_bidrag_omfattet_af_stk2() -> udenlandsk_socialt_bidrag_fælles_betingelser() && input.udenlandsk_socialt_bidrag.omfattet_af_eu_socialsikringsforordning
    | udenlandsk_socialt_bidrag_omfattet_af_stk3() -> udenlandsk_socialt_bidrag_fælles_betingelser() && input.udenlandsk_socialt_bidrag.omfattet_af_mellemfolkelig_aftale_som_danmark_har_tiltrådt
    | udenlandsk_socialt_bidrag_omfattet() -> udenlandsk_socialt_bidrag_omfattet_af_stk2() || udenlandsk_socialt_bidrag_omfattet_af_stk3()
    | udenlandsk_socialt_bidrag_fradrag_kroner() -> 0
    | exception obligatorisk_udenlandsk_socialt_bidrag_fradrages udenlandsk_socialt_bidrag_fradrag_kroner() -> penge_positivt_beløb(input.udenlandsk_socialt_bidrag.bidrag_kroner) under udenlandsk_socialt_bidrag_omfattet()
    | udenlandsk_arbejdsgiverbidrag_vedrører_indkomståret() -> input.udenlandsk_arbejdsgiverbidrag.bidrag_vedrører_indkomstår == input.indkomstår
    | begrænset_skattepligt_omfattet_af_stk4() -> input.kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr1 || input.kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr3
    | udenlandsk_arbejdsgiverbidrag_omfattet_af_stk4() -> udenlandsk_arbejdsgiverbidrag_vedrører_indkomståret() && begrænset_skattepligt_omfattet_af_stk4() && input.udenlandsk_arbejdsgiverbidrag.obligatorisk && input.udenlandsk_arbejdsgiverbidrag.omfattet_af_eu_socialsikringsforordning && input.udenlandsk_arbejdsgiverbidrag.aftale_om_at_bidrag_påhviler_lønmodtageren
    | udenlandsk_arbejdsgiverbidrag_fradrag_kroner() -> 0
    | exception udenlandsk_arbejdsgiverbidrag_fradrages udenlandsk_arbejdsgiverbidrag_fradrag_kroner() -> penge_positivt_beløb(input.udenlandsk_arbejdsgiverbidrag.bidrag_kroner) under udenlandsk_arbejdsgiverbidrag_omfattet_af_stk4()
    | samlet_fradrag_kroner() -> arbejdsmarkedsbidrag_fradrag_kroner() + udenlandsk_socialt_bidrag_fradrag_kroner() + udenlandsk_arbejdsgiverbidrag_fradrag_kroner()
    | skatteministeren_bemyndiget_efter_stk5() -> Sandt
    | resultat() -> Ligningslov8MResultat(
        indkomstår = input.indkomstår,
        kildeskattepligt = input.kildeskattepligt,
        arbejdsmarkedsbidrag_omfattet_af_stk1 = arbejdsmarkedsbidrag_omfattet_af_stk1(),
        arbejdsmarkedsbidrag_fradrag_kroner = arbejdsmarkedsbidrag_fradrag_kroner(),
        udenlandsk_socialt_bidrag_omfattet_af_stk2 = udenlandsk_socialt_bidrag_omfattet_af_stk2(),
        udenlandsk_socialt_bidrag_omfattet_af_stk3 = udenlandsk_socialt_bidrag_omfattet_af_stk3(),
        udenlandsk_socialt_bidrag_fradrag_kroner = udenlandsk_socialt_bidrag_fradrag_kroner(),
        udenlandsk_arbejdsgiverbidrag_omfattet_af_stk4 = udenlandsk_arbejdsgiverbidrag_omfattet_af_stk4(),
        udenlandsk_arbejdsgiverbidrag_fradrag_kroner = udenlandsk_arbejdsgiverbidrag_fradrag_kroner(),
        samlet_fradrag_kroner = samlet_fradrag_kroner(),
        skatteministeren_bemyndiget_efter_stk5 = skatteministeren_bemyndiget_efter_stk5()
    )
}

| ligningslov8m_sag(input: Ligningslov8MInput) -> Ligningslov8MSag(input)
| ligningslov8m_resultat(input: Ligningslov8MInput) -> ligningslov8m_sag(input).resultat()
--@end::ligningsloven_par8m--

= ligningsloven_lbk1500_par8n = LigningslovFradragKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 8 N",
    hentet_dato = "2026-07-18"
)

= ll_par8n_kildemeta = Source(
    value = ligningsloven_lbk1500_par8n
)
--@label:ligningsloven_par8n::meta:ll_par8n_kildemeta--
----
§ 8 N. Ved opgørelsen af den skattepligtige indkomst kan fradrages
erhvervsmæssige lønudgifter til personer i ansættelsesforhold,
bestyrelseshonorarer og erhvervsmæssige udgifter tilknyttet ansættelsesforholdet
eller bestyrelseserhvervet, jf. dog stk. 3-5.

Stk. 2. Betaling for erhvervsmæssige udgifter omfattet af stk. 1 kan fradrages
ved opgørelsen af den skattepligtige indkomst hos det betalende selskab, hvis
det betalende og det modtagende selskab sambeskattes eller ville kunne
sambeskattes efter selskabsskattelovens § 31 A.

Stk. 3. Der kan dog ikke efter stk. 1 og 2 samlet fradrages udgifter for mere
end et grundbeløb på 6.339.800 kr. (i 2010-niveau) for en person i et
indkomstår. 1. pkt. gælder for de udgifter omfattet af stk. 1 og 2, der hos
personen, som udgiften vedrører, skal medregnes ved opgørelsen af den
skattepligtige indkomst eller beskattes som en arbejdsmarkedsbidragspligtig
ydelse efter arbejdsmarkedsbidragsloven, eller, såfremt personen ikke er
skattepligtig her til landet, som ville have været beskattet som en
arbejdsmarkedsbidragspligtig ydelse efter arbejdsmarkedsbidragsloven, såfremt
personen var skattepligtig her til landet. Til udgifterne nævnt i 2. pkt.
medregnes tillige befordring, der er betalt af arbejdsgiveren, og som hos
modtageren er skattefri efter § 9 C, stk. 7. Grundbeløbet reguleres efter
personskattelovens § 20.

Stk. 4. Stk. 3 finder anvendelse samlet for alle skattepligtige, der har en
forbindelse som omhandlet i § 2. Grundbeløbet i stk. 3 fordeles forholdsmæssigt
mellem de skattepligtige, som har en forbindelse som omhandlet i § 2, såfremt
flere skattepligtige har udgifter som nævnt i stk. 3 til den samme person i
samme indkomstår.

Stk. 5. For køberetter til aktier og tegningsretter til aktier, der er
omfattet af stk. 1 og 2, og hvor udgiften for det selskab, der har ydet
køberetterne eller tegningsretterne, fradrages efter § 28, stk. 3, finder stk.
3 anvendelse for værdien af køberetten eller tegningsretten på
udnyttelsestidspunktet, og værdien tillægges de udgifter, der er omfattet af
stk. 3, for den person, som køberetten eller tegningsretten oprindelig er
udstedt til.
----

--@begin::ligningsloven_par8n--
# Ligningslov8NUdgiftsart = Ll8NErhvervsmæssigLøn | Ll8NBestyrelseshonorar | Ll8NErhvervsmæssigUdgiftTilknyttetAnsættelse | Ll8NErhvervsmæssigUdgiftTilknyttetBestyrelseserhverv | Ll8NArbejdsgiverbetaltBefordringEfterPar9CStk7 | Ll8NKøberetEllerTegningsretEfterPar28Stk3 | Ll8NAndenUdgift
# Ligningslov8NInput(indkomstår: Heltal, udgiftsart: Ligningslov8NUdgiftsart, udgift_kroner: Heltal, erhvervsmæssig: Boolsk, betalende_selskab_fradrager_for_modtagende_selskab: Boolsk, betalende_og_modtagende_selskab_sambeskattes_eller_kan_sambeskattes: Boolsk, personen_beskattes_af_udgiften_eller_arbejdsmarkedsbidragspligtig_ydelse: Boolsk, ikke_skattepligtig_person_ville_være_arbejdsmarkedsbidragspligtig: Boolsk, samlede_omfattede_udgifter_før_denne_kroner: Heltal, grundbeløbsandel_basispoint: Heltal, køberet_eller_tegningsret_oprindelig_udstedt_til_personen: Boolsk)
# Ligningslov8NResultat(indkomstår: Heltal, udgiftsart: Ligningslov8NUdgiftsart, omfattet_af_stk1: Boolsk, omfattet_af_stk2: Boolsk, stk3_loft_finder_anvendelse: Boolsk, reguleret_grundbeløb_kroner: Heltal, fordelt_grundbeløb_kroner: Heltal, resterende_loft_før_udgiften_kroner: Heltal, udgift_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, afskåret_efter_stk3_kroner: Heltal)

# Ligningslov8NSag(input: Ligningslov8NInput) {
    | udgift_kroner() -> penge_positivt_beløb(input.udgift_kroner)
    | almindelig_stk1_udgiftsart() -> input.udgiftsart == Ll8NErhvervsmæssigLøn || input.udgiftsart == Ll8NBestyrelseshonorar || input.udgiftsart == Ll8NErhvervsmæssigUdgiftTilknyttetAnsættelse || input.udgiftsart == Ll8NErhvervsmæssigUdgiftTilknyttetBestyrelseserhverv || input.udgiftsart == Ll8NArbejdsgiverbetaltBefordringEfterPar9CStk7
    | stk5_aktieret_omfattet() -> input.udgiftsart == Ll8NKøberetEllerTegningsretEfterPar28Stk3 && input.køberet_eller_tegningsret_oprindelig_udstedt_til_personen
    | udgiftsart_omfattet() -> almindelig_stk1_udgiftsart() || stk5_aktieret_omfattet()
    | omfattet_af_stk1() -> udgiftsart_omfattet() && input.erhvervsmæssig && input.betalende_selskab_fradrager_for_modtagende_selskab == Falskt
    | omfattet_af_stk2() -> udgiftsart_omfattet() && input.erhvervsmæssig && input.betalende_selskab_fradrager_for_modtagende_selskab && input.betalende_og_modtagende_selskab_sambeskattes_eller_kan_sambeskattes
    | grundlæggende_fradragsret() -> omfattet_af_stk1() || omfattet_af_stk2()
    | befordring_omfattet_af_stk3() -> input.udgiftsart == Ll8NArbejdsgiverbetaltBefordringEfterPar9CStk7 && input.erhvervsmæssig
    | stk3_loft_finder_anvendelse() -> grundlæggende_fradragsret() && (input.personen_beskattes_af_udgiften_eller_arbejdsmarkedsbidragspligtig_ydelse || input.ikke_skattepligtig_person_ville_være_arbejdsmarkedsbidragspligtig || stk5_aktieret_omfattet() || befordring_omfattet_af_stk3())
    | reguleret_grundbeløb_kroner() -> 0
    | exception stk3_grundbeløb_reguleres_efter_par20 reguleret_grundbeløb_kroner() -> par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
        grundbeløb_2010_niveau_kroner = 6339800,
        reguleringstal_tiendedele = par20_reguleringstal_tiendedele(input.indkomstår)
    )) under input.indkomstår >= 2009 && input.indkomstår <= 2026
    | grundbeløbsandel_basispoint() -> penge_mindste_beløb(penge_positivt_beløb(input.grundbeløbsandel_basispoint), 10000)
    | fordelt_grundbeløb_kroner() -> penge_beløb_gange_basispoint_kroner(reguleret_grundbeløb_kroner(), grundbeløbsandel_basispoint())
    | samlede_omfattede_udgifter_før_denne_kroner() -> penge_positivt_beløb(input.samlede_omfattede_udgifter_før_denne_kroner)
    | resterende_loft_før_udgiften_kroner() -> penge_positivt_beløb(fordelt_grundbeløb_kroner() - samlede_omfattede_udgifter_før_denne_kroner())
    | fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | exception stk1_stk2_udgift_uden_loft_fradrages_fuldt fradrag_i_skattepligtig_indkomst_kroner() -> udgift_kroner() under grundlæggende_fradragsret() && stk3_loft_finder_anvendelse() == Falskt
    | exception stk3_begrænser_omfattet_udgift fradrag_i_skattepligtig_indkomst_kroner() -> penge_mindste_beløb(udgift_kroner(), resterende_loft_før_udgiften_kroner()) under grundlæggende_fradragsret() && stk3_loft_finder_anvendelse()
    | afskåret_efter_stk3_kroner() -> hvis grundlæggende_fradragsret() { udgift_kroner() - fradrag_i_skattepligtig_indkomst_kroner() } ellers { 0 }
    | resultat() -> Ligningslov8NResultat(
        indkomstår = input.indkomstår,
        udgiftsart = input.udgiftsart,
        omfattet_af_stk1 = omfattet_af_stk1(),
        omfattet_af_stk2 = omfattet_af_stk2(),
        stk3_loft_finder_anvendelse = stk3_loft_finder_anvendelse(),
        reguleret_grundbeløb_kroner = reguleret_grundbeløb_kroner(),
        fordelt_grundbeløb_kroner = fordelt_grundbeløb_kroner(),
        resterende_loft_før_udgiften_kroner = resterende_loft_før_udgiften_kroner(),
        udgift_kroner = udgift_kroner(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        afskåret_efter_stk3_kroner = afskåret_efter_stk3_kroner()
    )
}

| ligningslov8n_sag(input: Ligningslov8NInput) -> Ligningslov8NSag(input)
| ligningslov8n_resultat(input: Ligningslov8NInput) -> ligningslov8n_sag(input).resultat()
--@end::ligningsloven_par8n--

