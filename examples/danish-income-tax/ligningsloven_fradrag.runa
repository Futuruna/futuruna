| ll9c_arbejdsplads_befordringsfradrag_berettiget(input: Ligningslov9CInput) -> input.befordringsformål == IndtægtsgivendeArbejdsplads && input.modtaget_skattefri_befordringsgodtgørelse_for_strækning == Falskt && input.par9d.afskærer_par9c_stk1_8 == Falskt && input.fradrag_udelukket_folketingshverv_m_v == Falskt
| ll9c_su_uddannelsessted_befordringsfradrag_berettiget(input: Ligningslov9CInput) -> input.skatteår >= 2026 && input.befordringsformål == SuUddannelsessted && input.bopæl_i_yderkommune_eller_lille_ø == Sandt && input.modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning == Falskt && input.par9d.afskærer_par9c_stk10 == Falskt
| ll9c_ordinært_befordringsfradrag_berettiget(input: Ligningslov9CInput) -> ll9c_arbejdsplads_befordringsfradrag_berettiget(input) || ll9c_su_uddannelsessted_befordringsfradrag_berettiget(input)
| ll9c_bropassagefradrag_berettiget(input: Ligningslov9CInput) -> ll9c_ordinært_befordringsfradrag_berettiget(input)
| exception ll9c_par9d_afskærer_ikke_bropassage ll9c_bropassagefradrag_berettiget(input: Ligningslov9CInput) -> Sandt under input.befordringsformål == IndtægtsgivendeArbejdsplads && input.par9d.afskærer_par9c_stk1_8 == Sandt
| ll9c_daglige_fradragsberettigede_kilometer(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(input.daglige_befordringskilometer - 24)
| ll9c_op_til_120_kilometer_pr_dag(input: Ligningslov9CInput) -> ligningslov_mindste_beløb(ll9c_daglige_fradragsberettigede_kilometer(input), 96)
| ll9c_over_120_kilometer_pr_dag(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(input.daglige_befordringskilometer - 120)
| ll9c_op_til_120_øre_pr_km(input: Ligningslov9CInput) -> ll9c_satser_for(input.skatteår).almindelig_op_til_120_øre_pr_km
| exception ll9c_yderkommune_op_til_120_sats ll9c_op_til_120_øre_pr_km(input: Ligningslov9CInput) -> ll9c_satser_for(input.skatteår).yderkommune_op_til_120_øre_pr_km under input.bopæl_i_yderkommune_eller_lille_ø == Sandt
| ll9c_over_120_øre_pr_km(input: Ligningslov9CInput) -> ll9c_satser_for(input.skatteår).almindelig_over_120_øre_pr_km
| exception ll9c_yderkommune_over_120_sats ll9c_over_120_øre_pr_km(input: Ligningslov9CInput) -> ll9c_satser_for(input.skatteår).yderkommune_over_120_øre_pr_km under input.bopæl_i_yderkommune_eller_lille_ø == Sandt
| ll9c_dagligt_afstandsfradrag_øre(input: Ligningslov9CInput) -> ll9c_op_til_120_kilometer_pr_dag(input) * ll9c_op_til_120_øre_pr_km(input) + ll9c_over_120_kilometer_pr_dag(input) * ll9c_over_120_øre_pr_km(input)
| ll9c_afstandsfradrag_kroner(input: Ligningslov9CInput) -> 0
| exception ll9c_ordinær_afstand_giver_fradrag ll9c_afstandsfradrag_kroner(input: Ligningslov9CInput) -> ll9c_øre_afrundet_til_kroner(ll9c_dagligt_afstandsfradrag_øre(input) * ligningslov_positivt_beløb(input.arbejdsdage)) under ll9c_ordinært_befordringsfradrag_berettiget(input)
| ll9c_særlig_transportfradrag_kroner(input: Ligningslov9CInput) -> 0
| exception ll9c_færge_fly_lignende_faktisk_udgift ll9c_særlig_transportfradrag_kroner(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(input.særlig_transport.faktisk_dokumenteret_udgift_kroner) under ll9c_ordinært_befordringsfradrag_berettiget(input) && input.særlig_transport.geografiske_forhold_tidsforbrug_økonomisk_rimelighed_kræver_transporten == Sandt
| ll9c_brofradrag_kroner(input: Ligningslov9CInput) -> 0
| exception ll9c_dokumenterede_brofradrag ll9c_brofradrag_kroner(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(input.broer.storebælt_bil_motorcykel_passager) * 110 + ligningslov_positivt_beløb(input.broer.storebælt_kollektiv_passager) * 15 + ligningslov_positivt_beløb(input.broer.øresund_bil_motorcykel_passager) * 50 + ligningslov_positivt_beløb(input.broer.øresund_kollektiv_passager) * 8 under ll9c_bropassagefradrag_berettiget(input) && input.broer.dokumenteret_og_afholdt_af_skattepligtige == Sandt
| ll9c_grundfradrag_før_lavindkomsttillæg_kroner(input: Ligningslov9CInput) -> ll9c_afstandsfradrag_kroner(input) + ll9c_særlig_transportfradrag_kroner(input) + ll9c_brofradrag_kroner(input)
| ll9c_lavindkomst_overskydende_indkomst_kroner(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(input.aftrapningsindkomst_kroner - ll9c_satser_for(input.skatteår).lavindkomst_indkomstgrænse_kroner)
| ll9c_lavindkomst_aftrapningstrin_1000(input: Ligningslov9CInput) -> ll9c_lavindkomst_overskydende_indkomst_kroner(input) / 1000
| ll9c_lavindkomst_tillæg_basispoint_efter_aftrapning(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(ll9c_satser_for(input.skatteår).lavindkomst_tillæg_basispoint - ll9c_lavindkomst_aftrapningstrin_1000(input) * ll9c_satser_for(input.skatteår).lavindkomst_aftrapning_basispoint_pr_1000)
| ll9c_lavindkomst_maks_basispoint_efter_aftrapning(input: Ligningslov9CInput) -> ligningslov_positivt_beløb(10000 - ll9c_lavindkomst_aftrapningstrin_1000(input) * 200)
| ll9c_lavindkomst_maks_efter_aftrapning_kroner(input: Ligningslov9CInput) -> penge_beløb_gange_basispoint_kroner(ll9c_satser_for(input.skatteår).lavindkomst_maks_kroner, ll9c_lavindkomst_maks_basispoint_efter_aftrapning(input))
| ll9c_lavindkomst_tillæg_for_årsgrundlag_kroner(skatteår: Heltal, aftrapningsindkomst_kroner: Heltal, årsgrundlag_kroner: Heltal) -> {
    = satser = ll9c_satser_for(skatteår)
    = overskydende_indkomst_kroner = ligningslov_positivt_beløb(aftrapningsindkomst_kroner - satser.lavindkomst_indkomstgrænse_kroner)
    = aftrapningstrin_1000 = overskydende_indkomst_kroner / 1000
    = tillæg_basispoint = ligningslov_positivt_beløb(satser.lavindkomst_tillæg_basispoint - aftrapningstrin_1000 * satser.lavindkomst_aftrapning_basispoint_pr_1000)
    = maksimum_basispoint = ligningslov_positivt_beløb(10000 - aftrapningstrin_1000 * 200)
    = maksimum_kroner = penge_beløb_gange_basispoint_kroner(satser.lavindkomst_maks_kroner, maksimum_basispoint)
    ligningslov_mindste_beløb(
        penge_beløb_gange_basispoint_kroner(ligningslov_positivt_beløb(årsgrundlag_kroner), tillæg_basispoint),
        maksimum_kroner
    )
}
