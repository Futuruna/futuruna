# Ligningslov9J9K9LResult(beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, ekstra_pensionsfradrag_kroner: Heltal, samlet_fradrag_kroner: Heltal)

| ll9l_gælder_for_skatteår(skatteår: Heltal) -> skatteår >= 2018
| ll9l_maksimalt_grundlag_2010_niveau_kroner() -> 63900
| ll9l_maksimalt_grundlag_kroner(skatteår: Heltal) -> par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
    grundbeløb_2010_niveau_kroner = ll9l_maksimalt_grundlag_2010_niveau_kroner(),
    reguleringstal_tiendedele = par20_reguleringstal_tiendedele(skatteår)
)) under ll9l_gælder_for_skatteår(skatteår)
| ll9l_ordinær_sats_basispoint(skatteår: Heltal) -> 800 under skatteår >= 2018 && skatteår <= 2019
| ll9l_ordinær_sats_basispoint(skatteår: Heltal) -> 1200 under skatteår >= 2020
| ll9l_folkepensionsnær_sats_basispoint(skatteår: Heltal) -> 2000 under skatteår == 2018
| ll9l_folkepensionsnær_sats_basispoint(skatteår: Heltal) -> 2200 under skatteår == 2019
| ll9l_folkepensionsnær_sats_basispoint(skatteår: Heltal) -> 3200 under skatteår >= 2020
| ll9l_sats_basispoint(skatteår: Heltal, status: Ligningslov9LPensionsalderStatus) -> ll9l_ordinær_sats_basispoint(skatteår)
| exception ll9l_fra15år_før_folkepension ll9l_sats_basispoint(skatteår: Heltal, status: Ligningslov9LPensionsalderStatus) -> ll9l_folkepensionsnær_sats_basispoint(skatteår) under status == Ll9lFra15ÅrFørFolkepension
| ll9l_parametre_for(skatteår: Heltal, status: Ligningslov9LPensionsalderStatus) -> Ligningslov9LParametre(
    skatteår = skatteår,
    pensionsfradrag_basispoint = ll9l_sats_basispoint(skatteår, status),
    maksimalt_grundlag_kroner = ll9l_maksimalt_grundlag_kroner(skatteår)
) under ll9l_gælder_for_skatteår(skatteår)
| ll9l_pensionsindbetalinger_før_udbetalinger_kroner(input: Ligningslov9LInput) -> ligningslov_positivt_beløb(input.pbl18_fradragsberettiget_indbetaling_kroner) + ligningslov_positivt_beløb(input.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner) + ligningslov_positivt_beløb(input.pbl19_øvrige_indbetalinger_efter_am_kroner)
| ll9l_modregningspligtig_udbetaling_kroner(input: Ligningslov9LInput) -> 0
| exception ll9l_modregner_pbl20_udbetaling ll9l_modregningspligtig_udbetaling_kroner(input: Ligningslov9LInput) -> ligningslov_positivt_beløb(input.pbl20_indkomstskattepligtig_udbetaling_kroner) under input.pbl20_udbetaling_status == Ll9lModregningspligtigPbl20Udbetaling
| ll9l_nettopensionsindbetalinger_kroner(input: Ligningslov9LInput) -> ligningslov_positivt_beløb(ll9l_pensionsindbetalinger_før_udbetalinger_kroner(input) - ll9l_modregningspligtig_udbetaling_kroner(input))
| ll9l_fradragsgrundlag_kroner(input: Ligningslov9LInput) -> ligningslov_mindste_beløb(ll9l_nettopensionsindbetalinger_kroner(input), ll9l_parametre_for(input.skatteår, input.pensionsalder_status).maksimalt_grundlag_kroner)
| ll9l_ekstra_pensionsfradrag_kroner(input: Ligningslov9LInput) -> 0
| exception ll9l_gældende_skatteår ll9l_ekstra_pensionsfradrag_kroner(input: Ligningslov9LInput) -> penge_beløb_gange_basispoint_kroner(ll9l_fradragsgrundlag_kroner(input), ll9l_parametre_for(input.skatteår, input.pensionsalder_status).pensionsfradrag_basispoint) under ll9l_gælder_for_skatteår(input.skatteår)
| ll9j_9k_9l_9j_input(input: Ligningslov9J9K9LInput) -> Ligningslov9JInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.arbejdsmarkedsbidragsgrundlag_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = input.udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver
)
| ll9j_9k_9l_9k_input(input: Ligningslov9J9K9LInput) -> Ligningslov9KInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.arbejdsmarkedsbidragsgrundlag_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = input.udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver
)
| ll9j_9k_9l_9l_input(input: Ligningslov9J9K9LInput) -> Ligningslov9LInput(
    skatteår = input.skatteår,
    pensionsalder_status = input.pensionsalder_status,
    pbl18_fradragsberettiget_indbetaling_kroner = input.pbl18_fradragsberettiget_indbetaling_kroner,
    pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = input.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner,
    pbl19_øvrige_indbetalinger_efter_am_kroner = input.pbl19_øvrige_indbetalinger_efter_am_kroner,
    pbl20_indkomstskattepligtig_udbetaling_kroner = input.pbl20_indkomstskattepligtig_udbetaling_kroner,
    pbl20_udbetaling_status = input.pbl20_udbetaling_status
)
| ll9j_9k_9l_fradrag_resultat(input: Ligningslov9J9K9LInput) -> Ligningslov9J9K9LResult(
    beskæftigelsesfradrag_kroner = ll9j_beskæftigelsesfradrag_kroner(ll9j_9k_9l_9j_input(input)),
    jobfradrag_kroner = ll9k_jobfradrag_kroner(ll9j_9k_9l_9k_input(input)),
    ekstra_pensionsfradrag_kroner = ll9l_ekstra_pensionsfradrag_kroner(ll9j_9k_9l_9l_input(input)),
    samlet_fradrag_kroner = ll9j_beskæftigelsesfradrag_kroner(ll9j_9k_9l_9j_input(input)) + ll9k_jobfradrag_kroner(ll9j_9k_9l_9k_input(input)) + ll9l_ekstra_pensionsfradrag_kroner(ll9j_9k_9l_9l_input(input))
)

