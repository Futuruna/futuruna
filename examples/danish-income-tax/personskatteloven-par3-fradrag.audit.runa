@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Focused validation for Personskatteloven § 3, stk. 2, nr. 1.
-- Source: Retsinformation, LBK nr. 1284 af 14/06/2021.
-- https://www.retsinformation.dk/eli/lta/2021/1284

----
§ 3. Personlig indkomst omfatter alle de indkomster, der indgår i den
skattepligtige indkomst, og som ikke er kapitalindkomst.

Stk. 2. Ved opgørelsen af den personlige indkomst fradrages
1) udgifter, som i årets løb er anvendt til at erhverve, sikre og vedligeholde
indkomst ved selvstændig erhvervsvirksomhed, dog med undtagelse af de i § 4,
stk. 1, nr. 1, 2, 7 og 8, og ligningslovens §§ 9 G og 13 nævnte udgifter,
2) udgifter, som nævnt i ligningslovens §§ 8, stk. 1, 8 B, 8 K, 8 L, 8 N,
14, stk. 1, 14 F og 30 A, og overført indkomst efter kildeskattelovens § 25 A,
stk. 3-5, ved selvstændig erhvervsvirksomhed,
3) bidrag og præmier til pensionsordninger mv. i samme omfang som nævnt i
pensionsbeskatningslovens §§ 18 og 52, jf. dog § 4 a, stk. 3,
4) forskelsbeløb og nedskrivning på husdyrbesætninger efter lov om den
skattemæssige behandling af husdyrbesætninger §§ 2 og 8,
5) nedskrivning af varelager efter varelagerlovens § 1, stk. 4,
6) arbejdsmarkedsbidrag og obligatoriske udenlandske sociale bidrag i samme
omfang som nævnt i ligningslovens § 8 M,
7) henlæggelser efter § 22 b og § 22 d i virksomhedsskatteloven,
8) udgifter, der er fradragsberettigede efter ligningslovens § 9 B,
9) tilbagebetalt skattepligtig kontanthjælp i samme omfang som nævnt i
ligningslovens § 8 O,
10) skattemæssige afskrivninger, tab og fradrag efter afskrivningsloven og
statsskatteloven for selvstændige erhvervsdrivende og
11) indskud på iværksætterkonto efter lov om indskud på etableringskonto og
iværksætterkonto
----

= par3_stk2_nr1_drift_probe = par3_stk2_nr1_udgift_resultat(Par3Stk2Nr1UdgiftInput(
    afgrænsning = SelvstændigErhvervsindkomstUdgift,
    beløb_kroner = 25000
))

= par3_stk2_nr1_renter_probe = par3_stk2_nr1_udgift_resultat(Par3Stk2Nr1UdgiftInput(
    afgrænsning = Par4Stk1Nr1RenterOgLl6,
    beløb_kroner = 5000
))

= par3_stk2_nr1_ll13_probe = par3_stk2_nr1_udgift_resultat(Par3Stk2Nr1UdgiftInput(
    afgrænsning = Ligningslov13Udgift,
    beløb_kroner = 7000
))

= par3_stk2_nr1_samlet_probe = par3_personlig_indkomst_resultat(Par3PersonligIndkomstInput(
    indkomstposter = [
        Par3Indkomstpost(indgår_i_skattepligtig_indkomst = Sandt, er_kapitalindkomst = Falskt, beløb_kroner = 100000)
    ],
    fradragsposter = [
        Par3Fradragspost(art = ErhverveSikreVedligeholdeSelvstændigIndkomst, stk2_nr1_afgrænsning = SelvstændigErhvervsindkomstUdgift, beløb_kroner = 25000),
        Par3Fradragspost(art = ErhverveSikreVedligeholdeSelvstændigIndkomst, stk2_nr1_afgrænsning = Par4Stk1Nr1RenterOgLl6, beløb_kroner = 5000),
        Par3Fradragspost(art = ErhverveSikreVedligeholdeSelvstændigIndkomst, stk2_nr1_afgrænsning = Ligningslov13Udgift, beløb_kroner = 7000),
        Par3Fradragspost(art = ArbejdsmarkedsbidragOgUdenlandskeSocialeBidrag, stk2_nr1_afgrænsning = IkkeStk2Nr1Udgift, beløb_kroner = 8000)
    ]
))

| par3_stk2_nr1_fradrager_erhvervsudgift: par3_stk2_nr1_drift_probe -> par3_stk2_nr1_drift_probe.fradragsberettiget_i_personlig_indkomst == Sandt && par3_stk2_nr1_drift_probe.fradrag_kroner == 25000 && par3_stk2_nr1_drift_probe.afskåret_til_anden_regel_kroner == 0
| par3_stk2_nr1_undtager_par4_nr1: par3_stk2_nr1_renter_probe -> par3_stk2_nr1_renter_probe.fradragsberettiget_i_personlig_indkomst == Falskt && par3_stk2_nr1_renter_probe.fradrag_kroner == 0 && par3_stk2_nr1_renter_probe.afskåret_til_anden_regel_kroner == 5000
| par3_stk2_nr1_undtager_ligningslov13: par3_stk2_nr1_ll13_probe -> par3_stk2_nr1_ll13_probe.fradragsberettiget_i_personlig_indkomst == Falskt && par3_stk2_nr1_ll13_probe.fradrag_kroner == 0 && par3_stk2_nr1_ll13_probe.afskåret_til_anden_regel_kroner == 7000
| par3_stk2_nr1_samlet_personlig_indkomst_afskærer_undtagelser: par3_stk2_nr1_samlet_probe -> par3_stk2_nr1_samlet_probe.brutto_personlig_indkomst_kroner == 100000 && par3_stk2_nr1_samlet_probe.fradrag_i_personlig_indkomst_kroner == 33000 && par3_stk2_nr1_samlet_probe.netto_personlig_indkomst_kroner == 67000

? par3_stk2_nr1_fradrager_erhvervsudgift
? par3_stk2_nr1_undtager_par4_nr1
? par3_stk2_nr1_undtager_ligningslov13
? par3_stk2_nr1_samlet_personlig_indkomst_afskærer_undtagelser

@ print("§3 stk.2 nr.1 fradrag efter undtagelser: " + vis(par3_stk2_nr1_samlet_probe.fradrag_i_personlig_indkomst_kroner))
