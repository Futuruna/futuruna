    label = "Arbejdsperioder for almindelige fradrag",
    question = Some("Hvilket arbejdsforhold eller hvilken årsfordeling vedrører hvert fradrag, som kan blive berørt af sømandsfradraget?"),
    help = Some("Opret én række pr. fradragskilde. En § 9 B-kørsel skal være opdelt pr. arbejdsperiode; årsfordeling må kun bruges til kilder, der reelt foreligger som et samlet årsbeløb."),
    unit = None
)
= personskat_søbl4_felt_kilde = TypetBeregningsfelt(
    path = refof(Sømandsbeskatningslov4Årsinput::kildetilknytninger::kilde::$variant),
    label = "Fradragskilde omfattet af § 4",
    question = Some("Er kilden en § 9, stk. 1-lønmodtagerudgift, en § 9 B-kørsel, det samlede §§ 9 C-9 D-befordringsfradrag, årets § 13-kontingentfradrag eller et § 49, stk. 1-bidrag?"),
    help = Some("Kildetypen bruges kun til at forbinde allerede oplyste kildefakta med det arbejdsforhold, de vedrører."),
    unit = None
)
= personskat_søbl4_felt_ll9_stk1_kildeidentifikation = TypetBeregningsfelt(
