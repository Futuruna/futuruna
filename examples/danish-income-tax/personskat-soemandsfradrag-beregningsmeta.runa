@ sprog da

@ importer ./metadata
@ importer ./soemandsbeskatningsloven - par3 - par4

= personskat_sømandsfradrag_felt_valg = TypetBeregningsfelt(
    path = refof(Sømandsbeskatningslov3Årsinput::valg::$variant),
    label = "Valg af sømandsfradrag",
    question = Some("Skal sømandsfradraget anvendes for indkomståret?"),
    help = Some("Et fravalg bevarer de almindelige lønmodtagerfradrag. Futuruna afgør ud fra beskæftigelserne, om et valg kan gennemføres."),
    unit = None
)
