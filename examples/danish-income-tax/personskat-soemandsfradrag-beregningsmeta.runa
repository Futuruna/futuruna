    question = Some("Hvilken oplyst lønmodtagerudgift vedrører denne arbejdsperiode?"),
    help = Some("Identifikationen skal svare præcist til udgiftens identifikation. Opret en særskilt udgift for hvert arbejdsforhold."),
    unit = None
)
