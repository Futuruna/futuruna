@ sprog da

@ importer ./personskat - par3 - erhvervsposter - kildefakta

----
Scenarier for Afskrivningsloven § 45 som beløbskilde til §§ 17, 19 og 21.
Lovtekst og kildeankre ligger i de importerede lovmoduler.
----

= al45_kontantvaerdi_fordeling = Afskrivningslov45FordelingsInput(
    kontantomregning_input = Afskrivningslov45KontantomregningInput(
        kontant_del_kroner = 1000000,
        gældsposter = [Afskrivningslov45Gældspost(
            identifikation = "realkredit",
            nominelt_beløb_kroner = 200000,
            kurs_på_opgørelsestidspunktet_basispoint = 10000,
            inkonverterbart_lån_for_fiskerfartøj = Falskt,
            stiftet_eller_overtaget_af_sælger_før_1993_05_19 = Falskt,
            kurs_ved_stiftelse_eller_overtagelse_basispoint = 10000
        )],
        afståelsessituation = Sandt
    ),
    overdragne_aktiver = [
        Afskrivningslov45OverdragetAktiv(kategori = Al45Bygning, identifikation = "hotel"),
        Afskrivningslov45OverdragetAktiv(kategori = Al45Installation, identifikation = "ventilation"),
        Afskrivningslov45OverdragetAktiv(kategori = Al45Bolig, identifikation = "ejerbolig")
    ],
    fordelingsposter = [
        Afskrivningslov45Fordelingspost(kategori = Al45Bygning, nøgle = Al45IndividueltAktiv(identifikation = "hotel"), fordelt_kontantværdi_kroner = 900000),
        Afskrivningslov45Fordelingspost(kategori = Al45Installation, nøgle = Al45IndividueltAktiv(identifikation = "ventilation"), fordelt_kontantværdi_kroner = 200000),
        Afskrivningslov45Fordelingspost(kategori = Al45Bolig, nøgle = Al45IndividueltAktiv(identifikation = "ejerbolig"), fordelt_kontantværdi_kroner = 100000)
    ],
    skriftligt_aftalt_af_sælger_og_køber = Sandt
)

| al45_kontantvaerdi_fordelingsvalg(kategori: Afskrivningslov45Aktivkategori, identifikation: Tekst) -> Afskrivningslov45FordeltKontantværdiInput(
    fordelings_input = al45_kontantvaerdi_fordeling,
    kategori = kategori,
    nøgle = Al45IndividueltAktiv(identifikation = identifikation)
)
| al45_kontantvaerdi_kilde(kategori: Afskrivningslov45Aktivkategori, identifikation: Tekst) -> Al45FordeltKontantværdi(input = al45_kontantvaerdi_fordelingsvalg(kategori, identifikation))

= al45_kontantvaerdi_bygningsfordeling = al45_kontantvaerdi_fordelingsvalg(Al45Bygning, "hotel")
= al45_kontantvaerdi_boligfordeling = al45_kontantvaerdi_fordelingsvalg(Al45Bolig, "ejerbolig")
= al45_kontantvaerdi_bygning = al45_kontantvaerdi_kilde(Al45Bygning, "hotel")
= al45_kontantvaerdi_installation = al45_kontantvaerdi_kilde(Al45Installation, "ventilation")
= al45_kontantvaerdi_manglende_aktiv = al45_kontantvaerdi_kilde(Al45Bygning, "ukendt")

= al45_kontantvaerdi_ubalanceret_fordeling = Al45FordeltKontantværdi(input = Afskrivningslov45FordeltKontantværdiInput(
    fordelings_input = Afskrivningslov45FordelingsInput(
        kontantomregning_input = al45_kontantvaerdi_fordeling.kontantomregning_input,
        overdragne_aktiver = al45_kontantvaerdi_fordeling.overdragne_aktiver,
        fordelingsposter = [
            Afskrivningslov45Fordelingspost(kategori = Al45Bygning, nøgle = Al45IndividueltAktiv(identifikation = "hotel"), fordelt_kontantværdi_kroner = 800000),
            Afskrivningslov45Fordelingspost(kategori = Al45Installation, nøgle = Al45IndividueltAktiv(identifikation = "ventilation"), fordelt_kontantværdi_kroner = 200000),
            Afskrivningslov45Fordelingspost(kategori = Al45Bolig, nøgle = Al45IndividueltAktiv(identifikation = "ejerbolig"), fordelt_kontantværdi_kroner = 100000)
        ],
        skriftligt_aftalt_af_sælger_og_køber = Sandt
    ),
    kategori = Al45Bygning,
    nøgle = Al45IndividueltAktiv(identifikation = "hotel")
))

= al45_kontantvaerdi_bygning_input = Afskrivningslov14Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    anvendelse = Al14HotelEllerCampinghytte,
    erhvervsmæssigt_benyttet = Sandt,
    postsortering_med_industrielt_præg = Falskt,
    tilknytning = Al14IkkeTilknyttet,
    tilknyttet_art = Al14BygningEllerLokale
)

= al45_kontantvaerdi_par16_input = Afskrivningslov16Input(
    aktiv = AlK3Bygning(input = al45_kontantvaerdi_bygning_input),
    hændelse = Al16Anskaffelse,
    indkomstår = 2023,
    erhvervet_eller_opført = Sandt,
    udgift_afholdt = Falskt,
    benyttes_erhvervsmæssigt = Sandt
)

= al45_kontantvaerdi_par20_input = Afskrivningslov20Input(
    indkomstår = 2026,
    aktiv = AlK3Bygning(input = al45_kontantvaerdi_bygning_input),
    begivenhed = Al20FortsatErhvervsmæssigAnvendelse,
    erhvervsmæssigt_anvendt_i_indkomståret = Sandt
)

| al45_kontantvaerdi_par17_input(kilde: Afskrivningslov45Kontantværdikilde) -> Afskrivningslov17Input(
    indkomstår = 2026,
    par16_input = al45_kontantvaerdi_par16_input,
    par20_input = al45_kontantvaerdi_par20_input,
    afskrivningsgrundlag = kilde,
    tidligere_årsopgørelser = [],
    antaget_levetid_år = 0,
    accessorisk_hovedbygning = Al17IngenAccessoriskHovedbygning,
    valg = Al17ValgtAfskrivning(beregnet_afskrivning_før_erhvervsandel_kroner = 27000)
)

= al45_kontantvaerdi_par17 = afskrivningslov17_resultat(al45_kontantvaerdi_par17_input(al45_kontantvaerdi_bygning))
= al45_kontantvaerdi_par17_kategorifejl = afskrivningslov17_resultat(al45_kontantvaerdi_par17_input(al45_kontantvaerdi_installation))
= al45_kontantvaerdi_par17_ubalanceret = afskrivningslov17_resultat(al45_kontantvaerdi_par17_input(al45_kontantvaerdi_ubalanceret_fordeling))

| al45_kontantvaerdi_par19_input(anskaffelsessum: Afskrivningslov19Anskaffelsessum) -> Afskrivningslov19Input(
    bygning_input = al45_kontantvaerdi_bygning_input,
    anskaffelsessum = anskaffelsessum,
    samlet_etageareal_kvadratmeter = 1000,
    afskrivningsberettiget_etageareal_kvadratmeter = 400,
    ejerbolig_etageareal_kvadratmeter = 200,
    tidligere_afskrivningsberettigede_indkomstår_for_bygningen = 0,
    tidligere_intervaller = []
)

= al45_kontantvaerdi_par19 = afskrivningslov19_resultat(al45_kontantvaerdi_par19_input(Al19FordeltAnskaffelsessumEfterPar45(bygningsfordeling = al45_kontantvaerdi_bygningsfordeling, boligfordeling = Some(al45_kontantvaerdi_boligfordeling))))
= al45_kontantvaerdi_par19_mangler_boligfordeling = afskrivningslov19_resultat(al45_kontantvaerdi_par19_input(Al19FordeltAnskaffelsessumEfterPar45(bygningsfordeling = al45_kontantvaerdi_bygningsfordeling, boligfordeling = None)))

= al45_kontantvaerdi_par21 = afskrivningslov21_resultat(Afskrivningslov21Input(
    indkomstår = 2026,
    nedskrevet_værdi_input = Afskrivningslov21NedskrevetVærdiInput(
        aktiv = AlK3Bygning(input = al45_kontantvaerdi_bygning_input),
        grundlag = Al21OrdinærtGrundlag(
            samlede_anskaffelses_og_forbedringsudgifter_kroner = 900000,
            straksfradrag_som_ikke_medregnes_kroner = 0,
            afskrivningsposter = [Afskrivningslov21Afskrivningspost(beregnede_afskrivninger_kroner = 27000, fratrukne_afskrivninger_kroner = 27000)]
        ),
        par39_historik = Afskrivningslov21Par39Historik(afholdte_ombygningsudgifter_kroner = 0, foretagne_afskrivninger_kroner = 0)
    ),
    salg_gennemført = Sandt,
    samlet_salgssum = al45_kontantvaerdi_bygning,
    kontrol = Afskrivningslov21Kontrol(
        sælgerne_er_en_eller_flere_personer = Sandt,
        køber_er_selskab_mv = Falskt,
        kapitalandel_basispoint = 0,
        stemmerettigheder_basispoint = 0,
        anden_bestemmende_indflydelse = Falskt
    )
))

| al45_kontantvaerdi_personskat_fakta(kilde: Afskrivningslov45Kontantværdikilde) -> PersonskatPar3Erhvervspostfakta(
    identifikation = "hotel-afskrivning-2026",
    indkomstår = 2026,
    kilde = PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Bygning(kilde = PsPar3Nr10Al17(input = al45_kontantvaerdi_par17_input(kilde))))
)

= al45_kontantvaerdi_personskat_gyldig = al45_kontantvaerdi_personskat_fakta(al45_kontantvaerdi_bygning)
= al45_kontantvaerdi_personskat_kategorifejl = al45_kontantvaerdi_personskat_fakta(al45_kontantvaerdi_installation)
= al45_kontantvaerdi_personskat_ubalanceret = al45_kontantvaerdi_personskat_fakta(al45_kontantvaerdi_ubalanceret_fordeling)

| scenarie_al45_fordelt_kontantvaerdi_er_entydig: al45_kontantvaerdi_bygning -> afskrivningslov45_kontantværdi_resultat(al45_kontantvaerdi_bygning).input_gyldigt && afskrivningslov45_kontantværdi_resultat(al45_kontantvaerdi_bygning).kontantværdi_kroner == 900000 && afskrivningslov45_kontantværdi_resultat(al45_kontantvaerdi_manglende_aktiv).input_gyldigt == Falskt && afskrivningslov45_kontantværdi_resultat(al45_kontantvaerdi_manglende_aktiv).kontantværdi_kroner == 0
| scenarie_al45_par17_afleder_afskrivningsgrundlaget: al45_kontantvaerdi_par17 -> al45_kontantvaerdi_par17.afskrivningsgrundlag_kroner == 900000 && al45_kontantvaerdi_par17.valg_gyldigt && al45_kontantvaerdi_par17.fradrag_i_skattepligtig_indkomst_kroner == 27000
| scenarie_al45_par19_afleder_forholdsmaessigt_grundlag: al45_kontantvaerdi_par19 -> al45_kontantvaerdi_par19.omfattet_af_par19 && al45_kontantvaerdi_par19.samlet_anskaffelsessum_før_ejerbolig_kroner == 1000000 && al45_kontantvaerdi_par19.ejerbolig_anskaffelsessum_kroner == 100000 && al45_kontantvaerdi_par19.anskaffelsessum_efter_ejerbolig_kroner == 900000 && al45_kontantvaerdi_par19.aktuelt_afskrivningsberettiget_grundlag_kroner == 450000 && al45_kontantvaerdi_par19_mangler_boligfordeling.omfattet_af_par19 == Falskt && al45_kontantvaerdi_par19_mangler_boligfordeling.anskaffelsessum_efter_ejerbolig_kroner == 0
| scenarie_al45_par21_afleder_salgssum_og_genvundne_afskrivninger: al45_kontantvaerdi_par21 -> al45_kontantvaerdi_par21.omfattet_af_par21 && al45_kontantvaerdi_par21.samlet_salgssum_kroner == 900000 && al45_kontantvaerdi_par21.nedskrevet_værdi_kroner == 873000 && al45_kontantvaerdi_par21.skattepligtige_genvundne_afskrivninger_kroner == 27000
| scenarie_al45_kategorifejl_og_ubalanceret_fordeling_fejler_lukket: al45_kontantvaerdi_par17_kategorifejl -> al45_kontantvaerdi_par17_kategorifejl.aktiv_omfattet == Falskt && al45_kontantvaerdi_par17_kategorifejl.fradrag_i_skattepligtig_indkomst_kroner == 0 && al45_kontantvaerdi_par17_ubalanceret.aktiv_omfattet == Falskt && al45_kontantvaerdi_par17_ubalanceret.fradrag_i_skattepligtig_indkomst_kroner == 0
| scenarie_al45_kildefejl_afvises_foer_personskat: al45_kontantvaerdi_personskat_gyldig -> personskat_par3_erhvervspostfakta_grundfakta_gyldige(al45_kontantvaerdi_personskat_gyldig, 2026) && personskat_par3_erhvervspostfakta_grundfakta_gyldige(al45_kontantvaerdi_personskat_kategorifejl, 2026) == Falskt && personskat_par3_erhvervspostfakta_grundfakta_gyldige(al45_kontantvaerdi_personskat_ubalanceret, 2026) == Falskt
| scenarie_al45_oplyst_kontantvaerdi_er_bagudkompatibel: al45_kontantvaerdi_bygning -> afskrivningslov45_kontantværdi_resultat(Al45OplystKontantværdi(beløb_kroner = 900000)).input_gyldigt && afskrivningslov45_kontantværdi_resultat(Al45OplystKontantværdi(beløb_kroner = 900000)).kontantværdi_kroner == 900000 && afskrivningslov45_kontantværdi_resultat(Al45OplystKontantværdi(beløb_kroner = -1)).input_gyldigt == Falskt

? scenarie_al45_fordelt_kontantvaerdi_er_entydig
? scenarie_al45_par17_afleder_afskrivningsgrundlaget
? scenarie_al45_par19_afleder_forholdsmaessigt_grundlag
? scenarie_al45_par21_afleder_salgssum_og_genvundne_afskrivninger
? scenarie_al45_kategorifejl_og_ubalanceret_fordeling_fejler_lukket
? scenarie_al45_kildefejl_afvises_foer_personskat
? scenarie_al45_oplyst_kontantvaerdi_er_bagudkompatibel
