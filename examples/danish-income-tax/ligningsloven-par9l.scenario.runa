    fødselsdato = Dato(år = 1990, måned = 1, dag = 1),
    pbl18_fradragsberettiget_indbetaling_kroner = 50000,
    pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = 0,
    pbl19_øvrige_indbetalinger_efter_am_kroner = 0,
    pbl20_indkomstskattepligtig_udbetaling_kroner = 10000,
