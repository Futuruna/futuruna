))

| ll9l_2019_reguleret_maks_og_22pct: ll9l_2019_folkepensionsnær_maks_fixture -> ll9l_2019_folkepensionsnær_maks_fixture == 15730
| ll9l_2026_reguleret_maks_og_12pct: ll9l_2026_ordinær_maks_fixture -> ll9l_2026_ordinær_maks_fixture == 10536
| ll9l_2025_afrundes_til_nærmeste_hele_krone: ll9l_2025_afrundet_fixture -> ll9l_2025_afrundet_fixture == 495
| ll9l_pbl20_udbetaling_modregnes: ll9l_2026_modregnet_udbetaling_fixture -> ll9l_2026_modregnet_udbetaling_fixture == 4800
| ll9l_pbl20_udbetaling_undtages: ll9l_2026_undtaget_udbetaling_fixture -> ll9l_2026_undtaget_udbetaling_fixture == 6000
| ll9l_ugyldig_fødselsdato_failer_lukket: ll9l_2026_ugyldig_fødselsdato_fixture -> ll9l_2026_ugyldig_fødselsdato_fixture == 0 && ll9l_pensionsalder_resultat(2026, Dato(år = 1990, måned = 2, dag = 30)).input_gyldigt == Falskt
| ll9j_9k_9l_samlet_fradrag: ll9j_9k_9l_2026_fixture -> ll9j_9k_9l_2026_fixture.pensionsalder_resultat.input_gyldigt && ll9j_9k_9l_2026_fixture.samlet_fradrag_kroner == 76936
| ll9j_9k_9l_2017_kun_9j_fradrag: ll9j_9k_9l_2017_fixture -> ll9j_9k_9l_2017_fixture.beskæftigelsesfradrag_kroner == 30000 && ll9j_9k_9l_2017_fixture.jobfradrag_kroner == 0 && ll9j_9k_9l_2017_fixture.ekstra_pensionsfradrag_kroner == 0 && ll9j_9k_9l_2017_fixture.samlet_fradrag_kroner == 30000

? ll9l_2018_bruger_2015_reglerne
? ll9l_2020_er_femtende_indkomstår_før_68_år
? ll9l_2021_bruger_2020_reglerne
? ll9l_2025_bruger_2020_reglerne_før_ikrafttræden
? ll9l_2026_bruger_2025_reglerne_efter_ikrafttræden
? ll9l_halvårsalder_bevares_i_måneder
? ll9l_2019_reguleret_maks_og_22pct
? ll9l_2026_reguleret_maks_og_12pct
? ll9l_2025_afrundes_til_nærmeste_hele_krone
? ll9l_pbl20_udbetaling_modregnes
? ll9l_pbl20_udbetaling_undtages
? ll9l_ugyldig_fødselsdato_failer_lukket
? ll9j_9k_9l_samlet_fradrag
? ll9j_9k_9l_2017_kun_9j_fradrag

@ print("Ligningslovens § 9 L: folkepensionsalderen afledes fra fødselsdato og den tidsmæssigt gældende § 1 a")
