= ll9l_2026_undtaget_udbetaling_fixture = ll9l_ekstra_pensionsfradrag_kroner(Ligningslov9LInput(
    skatteår = 2026,
    fødselsdato = Dato(år = 1990, måned = 1, dag = 1),
    pbl18_fradragsberettiget_indbetaling_kroner = 50000,
    pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = 0,
    pbl19_øvrige_indbetalinger_efter_am_kroner = 0,
    pbl20_indkomstskattepligtig_udbetaling_kroner = 10000,
    pbl20_udbetaling_status = Ll9lUndtagetPbl20Udbetaling
))
= ll9l_2026_ugyldig_fødselsdato_fixture = ll9l_ekstra_pensionsfradrag_kroner(Ligningslov9LInput(
    skatteår = 2026,
    fødselsdato = Dato(år = 1990, måned = 2, dag = 30),
    pbl18_fradragsberettiget_indbetaling_kroner = 100000,
