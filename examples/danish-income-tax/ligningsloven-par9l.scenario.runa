= ll9j_9k_9l_2026_fixture = ll9j_9k_9l_fradrag_resultat(Ligningslov9J9K9LInput(
    skatteår = 2026,
    arbejdsmarkedsbidragsgrundlag_kroner = 600000,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = Falskt,
