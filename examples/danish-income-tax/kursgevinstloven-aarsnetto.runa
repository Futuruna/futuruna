--@label:kursgevinstloven_årsnetto_afgrænsning::meta:kursgevinstloven_årsnetto_afgrænsning_metadata--
----
§ 1. Denne lov omfatter
1) gevinst og tab ved afståelse eller indfrielse af pengefordringer herunder
obligationer, pantebreve og gældsbreve,
2) gevinst og tab ved frigørelse for gæld og
3) gevinst og tab på terminskontrakter og aftaler om køberetter og salgsretter
uden hensyn til de regler, der gælder for det underliggende aktiv.

Stk. 2. Uanset ligningslovens §§ 16 A og 16 B skal afdrag på og
afståelsessummer for fordringer på koncernforbundne selskaber, jf.
ligningslovens § 2, behandles efter reglerne i denne lov.

Stk. 3. Loven omfatter ikke gevinst og tab på fordringer og gæld, der indgår i
beskatningen af avance ved salg af fast ejendom, der henhører til den
skattepligtiges næringsvej, jf. statsskattelovens § 4, jf. § 5 a.

Stk. 4. Loven omfatter endvidere ikke gevinst og tab på konvertible obligationer
og præmieobligationer.

§ 12. Personer, der er skattepligtige efter kildeskatteloven, og dødsboer, der
er skattepligtige efter dødsboskatteloven, skal ved opgørelsen af den
skattepligtige indkomst medregne gevinst og tab på fordringer og gæld, som
omfattes af § 1, efter de regler, der er angivet i dette kapitel og § 29 samt i
kapitel 4, 5 og 7.

§ 13. Hvis personen eller dødsboet udøver næring ved køb og salg af fordringer
eller driver næringsvirksomhed ved finansiering, medregnes gevinst og tab på
fordringer ved opgørelsen af den skattepligtige indkomst, jf. dog § 18.

Stk. 2. Godtgøres det, at en fordring er erhvervet uden for den skattepligtiges
næringsvirksomhed og ikke senere er indgået i denne, omfatter stk. 1 ikke
gevinst og tab på en sådan fordring.

§ 14. Gevinst og tab på fordringer medregnes ved opgørelsen af den
skattepligtige indkomst, jf. dog stk. 2 og §§ 15, 17 og 18. 1. pkt. finder dog
alene anvendelse, hvis årets nettogevinst eller nettotab sammenlagt med
nettogevinster og nettotab omfattet af § 23 og gevinst og tab på
investeringsbeviser i obligationsbaserede investeringsinstitutter med
minimumsbeskatning, jf. aktieavancebeskatningslovens § 22, overstiger 2.000 kr.

Stk. 2. Tab på fordringer på selskaber, hvorover den skattepligtige har eller
har haft en indflydelse som omhandlet i aktieavancebeskatningslovens § 4, eller
tab på fordringer på den skattepligtiges ægtefælle, forældre og bedsteforældre
samt børn og børnebørn og disses ægtefæller eller dødsboer efter de nævnte
personer kan ikke fradrages. Stedbarns- og adoptivforhold sidestilles med
naturligt slægtskabsforhold. For fordringer i fremmed valuta opgøres det
ikkefradragsberettigede tab efter 1. og 2. pkt. på grundlag af valutakurserne
på tidspunktet for fordringens erhvervelse.

§ 15. Fradrag for tab efter § 14, stk. 1, på fordringer, der er optaget til
handel på et reguleret marked, er betinget af, at told- og skatteforvaltningen
inden udløbet af oplysningsfristen efter skattekontrollovens §§ 10 og 11,
jf. § 13, for det indkomstår, hvor erhvervelsen har fundet sted, har modtaget
oplysninger om erhvervelsen af fordringen med angivelse af fordringens
identitet, antallet eller pålydende værdi, anskaffelsestidspunktet og
anskaffelsessummen.

§ 17. For tab på fordringer, der er erhvervet som vederlag i næring og for tab
på fordringer, der i øvrigt er erhvervet i tilknytning til den erhvervsmæssige
drift af virksomheden, finder reglerne i statsskattelovens § 6 a anvendelse,
jf. dog § 18.

§ 18. Uanset §§ 13, 14 og 17 kan tab på en fordring ikke fradrages, såfremt
renteindtægter af fordringen eller gevinster på fordringen omfattet af denne
lov som følge af en dobbeltbeskatningsoverenskomst ikke skal medregnes ved
opgørelse af den skattepligtige indkomst.
----

--@begin:kursgevinstloven_årsnetto_afgrænsning--
# KglÅrsnettoFordringsart = KglÅrsnettoPengefordring | KglÅrsnettoObligation | KglÅrsnettoFordringIFastEjendomsNæring | KglÅrsnettoKonvertibelObligation | KglÅrsnettoPræmieobligation
# KglÅrsnettoOplysningsstatus = KglÅrsnettoOplystRettidigt | KglÅrsnettoIkkeOplystRettidigt
# KglÅrsnettoMarkedsfakta = KglÅrsnettoIkkeOptagetPåReguleretMarked | KglÅrsnettoOptagetPåReguleretMarked(oplysningsstatus: KglÅrsnettoOplysningsstatus)
# KglÅrsnettoDebitorrelation = KglÅrsnettoUafhængigDebitor | KglÅrsnettoKontrolleretSelskab | KglÅrsnettoNærtståendePerson
# KglÅrsnettoNæringsforhold = KglÅrsnettoIkkeNæringsdrivende | KglÅrsnettoFordringsEllerFinansieringsnæring | KglÅrsnettoDokumenteretErhvervetUdenForNæring
# KglÅrsnettoErhvervelsesgrundlag = KglÅrsnettoAlmindeligErhvervelse | KglÅrsnettoVederlagINæring | KglÅrsnettoTilknyttetErhvervsdrift
# KglÅrsnettoDbaStatus = KglÅrsnettoIngenDbaBegrænsning | KglÅrsnettoRenterEllerGevinsterUndtagetEfterDba
# KglÅrsnettoFordringskilde(fordringsart: KglÅrsnettoFordringsart, markedsfakta: KglÅrsnettoMarkedsfakta, debitorrelation: KglÅrsnettoDebitorrelation, næringsforhold: KglÅrsnettoNæringsforhold, erhvervelsesgrundlag: KglÅrsnettoErhvervelsesgrundlag, dba_status: KglÅrsnettoDbaStatus)

| kgl_årsnetto_par1_afgrænsning(kilde: KglÅrsnettoFordringskilde) -> match kilde.fordringsart {
    | KglÅrsnettoFordringIFastEjendomsNæring -> KglFastEjendomNæringUndtaget
    | KglÅrsnettoKonvertibelObligation -> KglKonvertibelEllerPræmieobligationUndtaget
    | KglÅrsnettoPræmieobligation -> KglKonvertibelEllerPræmieobligationUndtaget
    | _ -> KglPar1Omfattet
}
| kgl_årsnetto_markedsnoteret(markedsfakta: KglÅrsnettoMarkedsfakta) -> match markedsfakta { | KglÅrsnettoOptagetPåReguleretMarked(_) -> Sandt | _ -> Falskt }
| kgl_årsnetto_oplyst_rettidigt(markedsfakta: KglÅrsnettoMarkedsfakta) -> match markedsfakta { | KglÅrsnettoOptagetPåReguleretMarked(status) -> status == KglÅrsnettoOplystRettidigt | _ -> Sandt }
| kgl_årsnetto_udøver_næring(næringsforhold: KglÅrsnettoNæringsforhold) -> næringsforhold != KglÅrsnettoIkkeNæringsdrivende
| kgl_årsnetto_fordring_erhvervet_udenfor_næring(næringsforhold: KglÅrsnettoNæringsforhold) -> næringsforhold == KglÅrsnettoDokumenteretErhvervetUdenForNæring
| kgl_årsnetto_fordring_omfattet_af_par13(kilde: KglÅrsnettoFordringskilde) -> kgl_årsnetto_udøver_næring(kilde.næringsforhold) && kgl_årsnetto_fordring_erhvervet_udenfor_næring(kilde.næringsforhold) == Falskt
| kgl_årsnetto_fordring_omfattet_af_par17(kilde: KglÅrsnettoFordringskilde) -> kilde.erhvervelsesgrundlag == KglÅrsnettoVederlagINæring || kilde.erhvervelsesgrundlag == KglÅrsnettoTilknyttetErhvervsdrift
| kgl_årsnetto_fordring_tabsgrundlag(kilde: KglÅrsnettoFordringskilde) -> KglFordringstabEfterPar14
| exception kgl_årsnetto_par17_erhvervsfordring kgl_årsnetto_fordring_tabsgrundlag(kilde: KglÅrsnettoFordringskilde) -> KglFordringstabEfterPar17Statsskattelov6A under kgl_årsnetto_fordring_omfattet_af_par17(kilde)
| kgl_årsnetto_fordring_tabsbegrænsning(kilde: KglÅrsnettoFordringskilde) -> KglFordringstabIkkeAfskåret
| exception kgl_årsnetto_par18_dba kgl_årsnetto_fordring_tabsbegrænsning(kilde: KglÅrsnettoFordringskilde) -> KglFordringstabDbaAfskåret under kilde.dba_status == KglÅrsnettoRenterEllerGevinsterUndtagetEfterDba
| exception kgl_årsnetto_par14_stk2_kontrol kgl_årsnetto_fordring_tabsbegrænsning(kilde: KglÅrsnettoFordringskilde) -> KglFordringstabKontrolEllerNærtstående under kgl_årsnetto_fordring_omfattet_af_par17(kilde) == Falskt && kilde.debitorrelation != KglÅrsnettoUafhængigDebitor
| exception kgl_årsnetto_par15_manglende_oplysning kgl_årsnetto_fordring_tabsbegrænsning(kilde: KglÅrsnettoFordringskilde) -> KglFordringstabReguleretMarkedUdenOplysning under kgl_årsnetto_fordring_omfattet_af_par17(kilde) == Falskt && kgl_årsnetto_markedsnoteret(kilde.markedsfakta) && kgl_årsnetto_oplyst_rettidigt(kilde.markedsfakta) == Falskt
| kgl_årsnetto_fordring_i_par14_bagatelgrundlag(kilde: KglÅrsnettoFordringskilde) -> kgl_årsnetto_par1_afgrænsning(kilde) == KglPar1Omfattet && kgl_årsnetto_fordring_omfattet_af_par13(kilde) == Falskt && kgl_årsnetto_fordring_omfattet_af_par17(kilde) == Falskt
--@end:kursgevinstloven_årsnetto_afgrænsning--

= kursgevinstloven_årsnetto_opgørelse_metadata = Metadata(
    attachments = (
        Source(value = kursgevinstloven_lbk1176_årsnetto),
        Guidance(value = kursgevinstloven_vejledning_årsnetto_par25),
        Guidance(value = kursgevinstloven_vejledning_årsnetto_par42),
        Guidance(value = kursgevinstloven_vejledning_årsnetto_par26_realisering),
        Guidance(value = kursgevinstloven_vejledning_årsnetto_par26_gennemsnit),
    )
)

--@label:kursgevinstloven_årsnetto_opgørelse::meta:kursgevinstloven_årsnetto_opgørelse_metadata--
----
§ 25. Gevinst og tab på fordringer og gæld, der skal medregnes ved opgørelsen af
den skattepligtige indkomst, medregnes i det indkomstår, hvori gevinsten eller
tabet realiseres (realisationsprincippet), jf. dog stk. 2-10, og § 22, stk. 1,
samt §§ 36 og 37.

Stk. 2. Skattepligtige omfattet af § 12 kan vælge at anvende lagerprincippet,
jf. § 33, stk. 1, ved opgørelsen af gevinst og tab på obligationer optaget til
handel på et reguleret marked og på gevinst og tab som følge af
valutakursændringer på fordringer og gæld i fremmed valuta. Valget træffes
samlet for henholdsvis obligationer optaget til handel på et reguleret marked
og valutakursændringer på fordringer og gæld i fremmed valuta. Ved anvendelse
af lagerprincippet, jf. 1. pkt., opgøres gevinst og tab på obligationer optaget
til handel på et reguleret marked på grundlag af valutakurserne på tidspunktet
for obligationens erhvervelse uden hensyn til ændringer i valutakurserne. Når
lagerprincippet er valgt, kan valget heraf kun ændres efter tilladelse fra
told- og skatteforvaltningen.

§ 26. Gevinst og tab på fordringer og gæld opgøres efter reglerne i stk. 2-5,
jf. dog § 25, stk. 2-5, om lagerprincippet og § 25, stk. 7-10.

Stk. 2. Gevinst eller tab på fordringer opgøres som forskellen mellem
anskaffelsessummen og afståelsessummen. Som anskaffelsessum anvendes kursværdien
på erhvervelsestidspunktet, medmindre den skattepligtige godtgør at have
erhvervet fordringen for et højere beløb.

Stk. 4. Skattepligtige omfattet af §§ 2 eller 13 skal ved afståelse af
fordringer, som er registreret i en værdipapircentral inden for samme fondskode,
eller fordringer udstedt på samme vilkår af samme udsteder anvende den
gennemsnitlige anskaffelsessum for samtlige disse fordringer. Tilsvarende
anvendes for selskabers gæld og personers gæld omfattet af § 19, der er udstedt
på samme vilkår af samme udsteder, den gennemsnitlige anskaffelsessum for
samtlige disse gældsforhold.

Stk. 5. Hvis en skattepligtig omfattet af § 12, der ikke driver
næringsvirksomhed ved finansiering, jf. § 13, ejer fordringer, som er registreret
i en værdipapircentral inden for samme fondskode eller er udstedt på samme
vilkår af samme udsteder, anses de først erhvervede fordringer for de først
afståede. Tilsvarende anses den gæld, der er optaget først, for først indfriet,
hvis gælden er optaget på samme vilkår hos samme långiver.

§ 42.

Stk. 9. Personer og dødsboer, som for indkomståret 1998 eller senere skifter
fra lagerprincippet til realisationsprincippet i henhold til § 25, skal anvende
ultimoværdien for fordringer og gæld for det seneste indkomstår før ændring af
opgørelsesmåden som henholdsvis anskaffelsessum for fordringen eller
forpligtelsens værdi for gælden ved en senere opgørelse af gevinst og tab på de
pågældende fordringer og gæld. Ved ændring fra realisationsprincippet til
lagerprincippet anvendes fordringens anskaffelsessum eller forpligtelsens værdi
ved stiftelsen, jf. dog stk. 11-15, som værdien primo for det første indkomstår,
hvor ændringen har virkning fra.
----

--@begin:kursgevinstloven_årsnetto_opgørelse--
# KglÅrsnettoPar25ValgPrimo = KglÅrsnettoIntetPar25ValgPrimo | KglÅrsnettoVidereførtPar25Valg(fra_indkomstår: Heltal, princip: KursgevinstlovOpgørelsesprincip)
# KglÅrsnettoPar25Ændringstilladelse = KglÅrsnettoIngenPar25Ændringstilladelse | KglÅrsnettoPar25ÆndringTilladt(afgørelsesreference: Tekst)
# KglÅrsnettoPar25KategoriÅrsvalg(position_primo: KglÅrsnettoPar25ValgPrimo, aktuelt_princip: KursgevinstlovOpgørelsesprincip, ændringstilladelse: KglÅrsnettoPar25Ændringstilladelse)
# KglÅrsnettoPar25Årsvalg(obligationer_på_reguleret_marked: KglÅrsnettoPar25KategoriÅrsvalg, valutakursændringer: KglÅrsnettoPar25KategoriÅrsvalg)
# KglÅrsnettoPar25Valgposition(indkomstår: Heltal, princip: KursgevinstlovOpgørelsesprincip)
# KglÅrsnettoPar25Valgpositioner(obligationer_på_reguleret_marked: KglÅrsnettoPar25Valgposition, valutakursændringer: KglÅrsnettoPar25Valgposition)
# KglÅrsnettoPar25Valgresultat(input: KglÅrsnettoPar25Årsvalg, input_gyldigt: Boolsk, obligationsvalg_ultimo: KglÅrsnettoPar25Valgposition, valutavalg_ultimo: KglÅrsnettoPar25Valgposition)

| kgl_årsnetto_par25_tilladelse_angivet(tilladelse: KglÅrsnettoPar25Ændringstilladelse) -> match tilladelse { | KglÅrsnettoPar25ÆndringTilladt(reference) -> reference != "" | _ -> Falskt }
| kgl_årsnetto_par25_lager_til_realisation(position_primo: KglÅrsnettoPar25ValgPrimo, aktuelt_princip: KursgevinstlovOpgørelsesprincip) -> match position_primo { | KglÅrsnettoVidereførtPar25Valg(_, princip) -> princip == KglLagerprincip && aktuelt_princip == KglRealisationsprincip | _ -> Falskt }
| kgl_årsnetto_par25_kategorivalg_gyldigt(valg: KglÅrsnettoPar25KategoriÅrsvalg, indkomstår: Heltal) -> match valg.position_primo {
    | KglÅrsnettoIntetPar25ValgPrimo -> kgl_årsnetto_par25_tilladelse_angivet(valg.ændringstilladelse) == Falskt
    | KglÅrsnettoVidereførtPar25Valg(fra_indkomstår, _) -> fra_indkomstår == indkomstår - 1 && kgl_årsnetto_par25_tilladelse_angivet(valg.ændringstilladelse) == kgl_årsnetto_par25_lager_til_realisation(valg.position_primo, valg.aktuelt_princip)
}
| kgl_årsnetto_par25_valutaårsvalg_gyldigt(valg: KglÅrsnettoPar25KategoriÅrsvalg, indkomstår: Heltal) -> kgl_årsnetto_par25_kategorivalg_gyldigt(valg, indkomstår) && (valg.aktuelt_princip != KglLagerprincip || indkomstår >= 2016)
| kgl_årsnetto_par25_valgresultat(input: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal) -> KglÅrsnettoPar25Valgresultat(
    input = input,
    input_gyldigt = indkomstår > 0 && kgl_årsnetto_par25_kategorivalg_gyldigt(input.obligationer_på_reguleret_marked, indkomstår) && kgl_årsnetto_par25_valutaårsvalg_gyldigt(input.valutakursændringer, indkomstår),
    obligationsvalg_ultimo = KglÅrsnettoPar25Valgposition(indkomstår = indkomstår, princip = input.obligationer_på_reguleret_marked.aktuelt_princip),
    valutavalg_ultimo = KglÅrsnettoPar25Valgposition(indkomstår = indkomstår, princip = input.valutakursændringer.aktuelt_princip)
)
| kgl_årsnetto_tomt_par25_kategorivalg() -> KglÅrsnettoPar25KategoriÅrsvalg(position_primo = KglÅrsnettoIntetPar25ValgPrimo, aktuelt_princip = KglRealisationsprincip, ændringstilladelse = KglÅrsnettoIngenPar25Ændringstilladelse)
| kgl_årsnetto_tomt_par25_årsvalg() -> KglÅrsnettoPar25Årsvalg(obligationer_på_reguleret_marked = kgl_årsnetto_tomt_par25_kategorivalg(), valutakursændringer = kgl_årsnetto_tomt_par25_kategorivalg())
| kgl_årsnetto_par25_primo_anvendte_lager(position: KglÅrsnettoPar25ValgPrimo) -> match position { | KglÅrsnettoVidereførtPar25Valg(_, princip) -> princip == KglLagerprincip | _ -> Falskt }
| kgl_årsnetto_par25_valgpositioner(valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal) -> KglÅrsnettoPar25Valgpositioner(
    obligationer_på_reguleret_marked = KglÅrsnettoPar25Valgposition(indkomstår = indkomstår, princip = valg.obligationer_på_reguleret_marked.aktuelt_princip),
    valutakursændringer = KglÅrsnettoPar25Valgposition(indkomstår = indkomstår, princip = valg.valutakursændringer.aktuelt_princip)
)
| kgl_årsnetto_par25_valgposition_gyldig(position: KglÅrsnettoPar25Valgposition, indkomstår: Heltal) -> indkomstår > 0 && position.indkomstår == indkomstår
| kgl_årsnetto_par25_valgpositioner_gyldige(positioner: KglÅrsnettoPar25Valgpositioner, indkomstår: Heltal) -> kgl_årsnetto_par25_valgposition_gyldig(positioner.obligationer_på_reguleret_marked, indkomstår) && kgl_årsnetto_par25_valgposition_gyldig(positioner.valutakursændringer, indkomstår)
| kgl_årsnetto_par25_valgprimo_matcher_position(position_primo: KglÅrsnettoPar25ValgPrimo, position: KglÅrsnettoPar25Valgposition) -> match position_primo {
    | KglÅrsnettoIntetPar25ValgPrimo -> Falskt
    | KglÅrsnettoVidereførtPar25Valg(fra_indkomstår, princip) -> fra_indkomstår == position.indkomstår && princip == position.princip
}
| kgl_årsnetto_par25_årsvalg_matcher_positioner(valg: KglÅrsnettoPar25Årsvalg, positioner: KglÅrsnettoPar25Valgpositioner) -> kgl_årsnetto_par25_valgprimo_matcher_position(valg.obligationer_på_reguleret_marked.position_primo, positioner.obligationer_på_reguleret_marked) && kgl_årsnetto_par25_valgprimo_matcher_position(valg.valutakursændringer.position_primo, positioner.valutakursændringer)

# KglÅrsnettoValuta(iso_4217_kode: Tekst)
# KglÅrsnettoValutakurs(dkk_øre_tæller: Heltal, valuta_hundreddele_nævner: Heltal)
# KglÅrsnettoValutaværdi(beløb_hundreddele: Heltal, kurs: KglÅrsnettoValutakurs)
# KglÅrsnettoValutaaktiv = KglÅrsnettoValutafordring(kilde: KglÅrsnettoFordringskilde) | KglÅrsnettoValutagældEfterPar23
# KglÅrsnettoValutaposition(indkomstår: Heltal, erhvervelsesår: Heltal, valuta: KglÅrsnettoValuta, par25_valgpositioner: KglÅrsnettoPar25Valgpositioner, anskaffelsesværdi: KglÅrsnettoValutaværdi, seneste_værdi: KglÅrsnettoValutaværdi, kredit_eller_pris_tidligere_medregnet_øre: Heltal, valutakurs_tidligere_medregnet_øre: Heltal)
# KglÅrsnettoValutapositionPrimo = KglÅrsnettoIngenValutapositionPrimo | KglÅrsnettoVidereførtValutapositionPrimo(position: KglÅrsnettoValutaposition)
# KglÅrsnettoValutaÅrsændring = KglÅrsnettoValutaAnskaffetOgUltimoværdi(anskaffelsesværdi: KglÅrsnettoValutaværdi, ultimoværdi: KglÅrsnettoValutaværdi) | KglÅrsnettoValutaAnskaffetOgAfstået(anskaffelsesværdi: KglÅrsnettoValutaværdi, afståelsesværdi: KglÅrsnettoValutaværdi) | KglÅrsnettoValutaUltimoværdi(ultimoværdi: KglÅrsnettoValutaværdi) | KglÅrsnettoValutaAfstået(afståelsesværdi: KglÅrsnettoValutaværdi)
# KglÅrsnettoValutaforløb(identifikation: Tekst, valuta: KglÅrsnettoValuta, aktiv: KglÅrsnettoValutaaktiv, position_primo: KglÅrsnettoValutapositionPrimo, årsændring: KglÅrsnettoValutaÅrsændring)
# KglÅrsnettoValutakomponentart = KglÅrsnettoKreditEllerPriskomponent | KglÅrsnettoValutakurskomponent
# KglÅrsnettoValutakomponentresultat(art: KglÅrsnettoValutakomponentart, opgørelsesprincip: KursgevinstlovOpgørelsesprincip, kumulativ_rå_netto_øre: Heltal, tidligere_medregnet_øre: Heltal, årets_rå_netto_øre: Heltal, årets_rå_netto_kroner: Heltal)
# KglÅrsnettoValutaforløbsresultat(fakta: KglÅrsnettoValutaforløb, input_gyldigt: Boolsk, kredit_eller_pris: KglÅrsnettoValutakomponentresultat, valutakurs: KglÅrsnettoValutakomponentresultat, årets_rå_netto_kroner: Heltal, position_ultimo: Option(KglÅrsnettoValutaposition), kursgevinstlov_resultater: List(KursgevinstlovResultat))

| kgl_årsnetto_valuta_gyldig(valuta: KglÅrsnettoValuta) -> string_length(valuta.iso_4217_kode) == 3 && valuta.iso_4217_kode != "DKK"
| kgl_årsnetto_valutakurs_gyldig(kurs: KglÅrsnettoValutakurs) -> kurs.dkk_øre_tæller > 0 && kurs.valuta_hundreddele_nævner > 0
| kgl_årsnetto_valutaværdi_gyldig(værdi: KglÅrsnettoValutaværdi) -> værdi.beløb_hundreddele >= 0 && kgl_årsnetto_valutakurs_gyldig(værdi.kurs)
| kgl_årsnetto_valutaværdi_ved_kurs_øre(beløb_hundreddele: Heltal, kurs: KglÅrsnettoValutakurs) -> beløb_hundreddele * kurs.dkk_øre_tæller / kurs.valuta_hundreddele_nævner
| kgl_årsnetto_valutaværdi_dkk_øre(værdi: KglÅrsnettoValutaværdi) -> kgl_årsnetto_valutaværdi_ved_kurs_øre(værdi.beløb_hundreddele, værdi.kurs)
| kgl_årsnetto_valutaaktiv_fortegn(aktiv: KglÅrsnettoValutaaktiv) -> match aktiv { | KglÅrsnettoValutafordring(_) -> 1 | KglÅrsnettoValutagældEfterPar23 -> -1 }
| kgl_årsnetto_valutaaktiv_er_markedsnoteret_obligation(aktiv: KglÅrsnettoValutaaktiv) -> match aktiv { | KglÅrsnettoValutafordring(kilde) -> kilde.fordringsart == KglÅrsnettoObligation && kgl_årsnetto_markedsnoteret(kilde.markedsfakta) | _ -> Falskt }
| kgl_årsnetto_valutaaktiv_gyldigt(aktiv: KglÅrsnettoValutaaktiv) -> match aktiv { | KglÅrsnettoValutafordring(kilde) -> kgl_årsnetto_par1_afgrænsning(kilde) == KglPar1Omfattet | KglÅrsnettoValutagældEfterPar23 -> Sandt }
| kgl_årsnetto_valuta_kredit_eller_pris_princip(aktiv: KglÅrsnettoValutaaktiv, valg: KglÅrsnettoPar25Årsvalg) -> hvis kgl_årsnetto_valutaaktiv_er_markedsnoteret_obligation(aktiv) && valg.obligationer_på_reguleret_marked.aktuelt_princip == KglLagerprincip { KglLagerprincip } ellers { KglRealisationsprincip }
| kgl_årsnetto_valutakurs_princip(aktiv: KglÅrsnettoValutaaktiv, valg: KglÅrsnettoPar25Årsvalg) -> hvis valg.valutakursændringer.aktuelt_princip == KglLagerprincip || kgl_årsnetto_valutaaktiv_er_markedsnoteret_obligation(aktiv) && valg.obligationer_på_reguleret_marked.aktuelt_princip == KglLagerprincip { KglLagerprincip } ellers { KglRealisationsprincip }
| kgl_årsnetto_valuta_kredit_eller_pris_primo_lager(aktiv: KglÅrsnettoValutaaktiv, valg: KglÅrsnettoPar25Årsvalg) -> kgl_årsnetto_valutaaktiv_er_markedsnoteret_obligation(aktiv) && kgl_årsnetto_par25_primo_anvendte_lager(valg.obligationer_på_reguleret_marked.position_primo)
| kgl_årsnetto_valutakurs_primo_lager(aktiv: KglÅrsnettoValutaaktiv, valg: KglÅrsnettoPar25Årsvalg) -> kgl_årsnetto_par25_primo_anvendte_lager(valg.valutakursændringer.position_primo) || kgl_årsnetto_valutaaktiv_er_markedsnoteret_obligation(aktiv) && kgl_årsnetto_par25_primo_anvendte_lager(valg.obligationer_på_reguleret_marked.position_primo)

| kgl_årsnetto_valuta_tom_værdi() -> KglÅrsnettoValutaværdi(beløb_hundreddele = 0, kurs = KglÅrsnettoValutakurs(dkk_øre_tæller = 1, valuta_hundreddele_nævner = 1))
| kgl_årsnetto_valuta_årsændring_matcher_position(position: KglÅrsnettoValutapositionPrimo, ændring: KglÅrsnettoValutaÅrsændring) -> match position {
    | KglÅrsnettoIngenValutapositionPrimo -> match ændring { | KglÅrsnettoValutaAnskaffetOgUltimoværdi(_, _) -> Sandt | KglÅrsnettoValutaAnskaffetOgAfstået(_, _) -> Sandt | _ -> Falskt }
    | KglÅrsnettoVidereførtValutapositionPrimo(_) -> match ændring { | KglÅrsnettoValutaUltimoværdi(_) -> Sandt | KglÅrsnettoValutaAfstået(_) -> Sandt | _ -> Falskt }
}
| kgl_årsnetto_valuta_årsændring_afstået(ændring: KglÅrsnettoValutaÅrsændring) -> match ændring { | KglÅrsnettoValutaAnskaffetOgAfstået(_, _) -> Sandt | KglÅrsnettoValutaAfstået(_) -> Sandt | _ -> Falskt }
| kgl_årsnetto_valuta_årsændring_anskaffelsesværdi(ændring: KglÅrsnettoValutaÅrsændring) -> match ændring { | KglÅrsnettoValutaAnskaffetOgUltimoværdi(anskaffelse, _) -> anskaffelse | KglÅrsnettoValutaAnskaffetOgAfstået(anskaffelse, _) -> anskaffelse | _ -> kgl_årsnetto_valuta_tom_værdi() }
| kgl_årsnetto_valuta_årsændring_slutværdi(ændring: KglÅrsnettoValutaÅrsændring) -> match ændring { | KglÅrsnettoValutaAnskaffetOgUltimoværdi(_, ultimo) -> ultimo | KglÅrsnettoValutaAnskaffetOgAfstået(_, afståelse) -> afståelse | KglÅrsnettoValutaUltimoværdi(ultimo) -> ultimo | KglÅrsnettoValutaAfstået(afståelse) -> afståelse }
| kgl_årsnetto_valuta_position_primo_gyldig(position: KglÅrsnettoValutapositionPrimo, valuta: KglÅrsnettoValuta, indkomstår: Heltal) -> match position {
    | KglÅrsnettoIngenValutapositionPrimo -> Sandt
    | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> værdi.indkomstår == indkomstår - 1 && værdi.erhvervelsesår > 0 && værdi.erhvervelsesår <= værdi.indkomstår && værdi.valuta == valuta && kgl_årsnetto_par25_valgpositioner_gyldige(værdi.par25_valgpositioner, værdi.indkomstår) && kgl_årsnetto_valutaværdi_gyldig(værdi.anskaffelsesværdi) && værdi.anskaffelsesværdi.beløb_hundreddele > 0 && kgl_årsnetto_valutaværdi_gyldig(værdi.seneste_værdi)
}
| kgl_årsnetto_valuta_position_matcher_par25_årsvalg(position: KglÅrsnettoValutapositionPrimo, valg: KglÅrsnettoPar25Årsvalg) -> match position {
    | KglÅrsnettoIngenValutapositionPrimo -> Sandt
    | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> kgl_årsnetto_par25_årsvalg_matcher_positioner(valg, værdi.par25_valgpositioner)
}
| kgl_årsnetto_valuta_anskaffelsesværdi(position: KglÅrsnettoValutapositionPrimo, ændring: KglÅrsnettoValutaÅrsændring) -> match position { | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> værdi.anskaffelsesværdi | _ -> kgl_årsnetto_valuta_årsændring_anskaffelsesværdi(ændring) }
| kgl_årsnetto_valuta_erhvervelsesår(position: KglÅrsnettoValutapositionPrimo, indkomstår: Heltal) -> match position { | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> værdi.erhvervelsesår | _ -> indkomstår }
| kgl_årsnetto_valuta_tidligere_kredit_eller_pris_medregnet_øre(position: KglÅrsnettoValutapositionPrimo) -> match position { | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> værdi.kredit_eller_pris_tidligere_medregnet_øre | _ -> 0 }
| kgl_årsnetto_valuta_tidligere_valutakurs_medregnet_øre(position: KglÅrsnettoValutapositionPrimo) -> match position { | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> værdi.valutakurs_tidligere_medregnet_øre | _ -> 0 }
| kgl_årsnetto_valuta_forrige_værdi(position: KglÅrsnettoValutapositionPrimo, ændring: KglÅrsnettoValutaÅrsændring) -> match position { | KglÅrsnettoVidereførtValutapositionPrimo(værdi) -> værdi.seneste_værdi | _ -> kgl_årsnetto_valuta_årsændring_anskaffelsesværdi(ændring) }

| kgl_årsnetto_valuta_kumulativ_kredit_eller_pris_øre(aktiv: KglÅrsnettoValutaaktiv, anskaffelse: KglÅrsnettoValutaværdi, aktuel: KglÅrsnettoValutaværdi) -> kgl_årsnetto_valutaaktiv_fortegn(aktiv) * (kgl_årsnetto_valutaværdi_ved_kurs_øre(aktuel.beløb_hundreddele, anskaffelse.kurs) - kgl_årsnetto_valutaværdi_dkk_øre(anskaffelse))
| kgl_årsnetto_valuta_kumulativ_total_øre(aktiv: KglÅrsnettoValutaaktiv, anskaffelse: KglÅrsnettoValutaværdi, aktuel: KglÅrsnettoValutaværdi) -> kgl_årsnetto_valutaaktiv_fortegn(aktiv) * (kgl_årsnetto_valutaværdi_dkk_øre(aktuel) - kgl_årsnetto_valutaværdi_dkk_øre(anskaffelse))
| kgl_årsnetto_valuta_kumulativ_valutakurs_øre(aktiv: KglÅrsnettoValutaaktiv, anskaffelse: KglÅrsnettoValutaværdi, aktuel: KglÅrsnettoValutaværdi) -> kgl_årsnetto_valuta_kumulativ_total_øre(aktiv, anskaffelse, aktuel) - kgl_årsnetto_valuta_kumulativ_kredit_eller_pris_øre(aktiv, anskaffelse, aktuel)
| kgl_årsnetto_valuta_årets_komponent_øre(kumulativ_øre: Heltal, tidligere_medregnet_øre: Heltal, princip: KursgevinstlovOpgørelsesprincip, afstået: Boolsk) -> hvis princip == KglLagerprincip || afstået { kumulativ_øre - tidligere_medregnet_øre } ellers { 0 }
| kgl_årsnetto_valuta_komponentresultat(art: KglÅrsnettoValutakomponentart, princip: KursgevinstlovOpgørelsesprincip, kumulativ_øre: Heltal, tidligere_medregnet_øre: Heltal, afstået: Boolsk) -> {
    = årets_rå_netto_øre = kgl_årsnetto_valuta_årets_komponent_øre(kumulativ_øre, tidligere_medregnet_øre, princip, afstået)
    KglÅrsnettoValutakomponentresultat(art = art, opgørelsesprincip = princip, kumulativ_rå_netto_øre = kumulativ_øre, tidligere_medregnet_øre = tidligere_medregnet_øre, årets_rå_netto_øre = årets_rå_netto_øre, årets_rå_netto_kroner = årets_rå_netto_øre / 100)
}
| kgl_årsnetto_valuta_forrige_kumulative_kredit_eller_pris_øre(fakta: KglÅrsnettoValutaforløb) -> {
    = anskaffelse = kgl_årsnetto_valuta_anskaffelsesværdi(fakta.position_primo, fakta.årsændring)
    kgl_årsnetto_valuta_kumulativ_kredit_eller_pris_øre(fakta.aktiv, anskaffelse, kgl_årsnetto_valuta_forrige_værdi(fakta.position_primo, fakta.årsændring))
}
| kgl_årsnetto_valuta_forrige_kumulative_valutakurs_øre(fakta: KglÅrsnettoValutaforløb) -> {
    = anskaffelse = kgl_årsnetto_valuta_anskaffelsesværdi(fakta.position_primo, fakta.årsændring)
    kgl_årsnetto_valuta_kumulativ_valutakurs_øre(fakta.aktiv, anskaffelse, kgl_årsnetto_valuta_forrige_værdi(fakta.position_primo, fakta.årsændring))
}
| kgl_årsnetto_valuta_tidligere_medregning_konsistent(fakta: KglÅrsnettoValutaforløb, valg: KglÅrsnettoPar25Årsvalg) -> match fakta.position_primo {
    | KglÅrsnettoIngenValutapositionPrimo -> Sandt
    | KglÅrsnettoVidereførtValutapositionPrimo(position) -> (kgl_årsnetto_valuta_kredit_eller_pris_primo_lager(fakta.aktiv, valg) == Falskt || position.kredit_eller_pris_tidligere_medregnet_øre == kgl_årsnetto_valuta_forrige_kumulative_kredit_eller_pris_øre(fakta)) && (kgl_årsnetto_valutakurs_primo_lager(fakta.aktiv, valg) == Falskt || position.valutakurs_tidligere_medregnet_øre == kgl_årsnetto_valuta_forrige_kumulative_valutakurs_øre(fakta))
}

| kgl_årsnetto_valuta_tabsbegrænsning_uden_par14_stk2(kilde: KglÅrsnettoFordringskilde) -> hvis kilde.dba_status == KglÅrsnettoRenterEllerGevinsterUndtagetEfterDba { KglFordringstabDbaAfskåret } ellers { hvis kgl_årsnetto_fordring_omfattet_af_par17(kilde) == Falskt && kgl_årsnetto_markedsnoteret(kilde.markedsfakta) && kgl_årsnetto_oplyst_rettidigt(kilde.markedsfakta) == Falskt { KglFordringstabReguleretMarkedUdenOplysning } ellers { KglFordringstabIkkeAfskåret } }
| kgl_årsnetto_valuta_fordring_tabsbegrænsning(kilde: KglÅrsnettoFordringskilde, art: KglÅrsnettoValutakomponentart) -> hvis art == KglÅrsnettoKreditEllerPriskomponent { kgl_årsnetto_fordring_tabsbegrænsning(kilde) } ellers { kgl_årsnetto_valuta_tabsbegrænsning_uden_par14_stk2(kilde) }
| kgl_årsnetto_valuta_fordringsopgørelse(kilde: KglÅrsnettoFordringskilde, art: KglÅrsnettoValutakomponentart, rå_netto_kroner: Heltal) -> KursgevinstlovFordringOpgørelse(
    tabsgrundlag = kgl_årsnetto_fordring_tabsgrundlag(kilde),
    tabsbegrænsning = kgl_årsnetto_valuta_fordring_tabsbegrænsning(kilde, art),
    anskaffelsessum_kroner = hvis rå_netto_kroner < 0 { 0 - rå_netto_kroner } ellers { 0 },
    afståelsessum_kroner = hvis rå_netto_kroner > 0 { rå_netto_kroner } ellers { 0 }
)
| kgl_årsnetto_valuta_fordringsinput(fakta: KglÅrsnettoValutaforløb, kilde: KglÅrsnettoFordringskilde, komponent: KglÅrsnettoValutakomponentresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> KursgevinstlovInput(
    indkomstår = indkomstår,
    rolle = KglPersonEfterKildeskatteloven,
    aktiv = KglFordring,
    par1_afgrænsning = kgl_årsnetto_par1_afgrænsning(kilde),
    bagatelgrundlag = KursgevinstlovBagatelOpgørelse(årets_netto_fordringer_valutagæld_investbeviser_kroner = årets_samlede_netto_kroner),
    fordring = kgl_årsnetto_valuta_fordringsopgørelse(kilde, komponent.art, komponent.årets_rå_netto_kroner),
    gæld = kgl_tom_gæld(),
    kontrakt = kgl_tom_kontrakt(),
    udøver_fordrings_eller_kontraktnæring = kgl_årsnetto_udøver_næring(kilde.næringsforhold),
    fordring_erhvervet_udenfor_næring = kgl_årsnetto_fordring_erhvervet_udenfor_næring(kilde.næringsforhold),
    anvender_lagerprincip_efter_par25 = komponent.opgørelsesprincip == KglLagerprincip
)
| kgl_årsnetto_valuta_gældsbeløb(rå_netto_kroner: Heltal) -> KursgevinstlovGældBeløb(
    gældens_værdi_ved_påtagelse_kroner = hvis rå_netto_kroner > 0 { rå_netto_kroner } ellers { 0 },
    gældens_værdi_ved_frigørelse_eller_indfrielse_kroner = hvis rå_netto_kroner < 0 { 0 - rå_netto_kroner } ellers { 0 },
    fordringens_værdi_for_kreditor_kroner = hvis rå_netto_kroner < 0 { 0 - rå_netto_kroner } ellers { 0 }
)
| kgl_årsnetto_valuta_gældsinput(fakta: KglÅrsnettoValutaforløb, komponent: KglÅrsnettoValutakomponentresultat, indkomstår: Heltal) -> kursgevinstlov_gæld_input(indkomstår, KursgevinstlovGældFakta(
    identifikation = fakta.identifikation + hvis komponent.art == KglÅrsnettoKreditEllerPriskomponent { ":kredit" } ellers { ":valuta" },
    beløb = kgl_årsnetto_valuta_gældsbeløb(komponent.årets_rå_netto_kroner),
    frigørelsesart = KglGældOrdinærIndfrielse,
    erhvervsforhold = KglGældUdenFinansieringsnæring,
    valuta = KglGældFremmedValuta,
    selskabsfakta = kgl_gæld_tom_par21_stk2_selskabsfakta(),
    gældsordning = KglIngenDokumenteretGældsordning,
    vedrører_ikke_indbetalt_selskabskapital = Falskt,
    par22_hændelse = KglIngenPar22Hændelse
))

# KglÅrsnettoValutaforløbssag(fakta: KglÅrsnettoValutaforløb, valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) {
    | anskaffelsesværdi() -> kgl_årsnetto_valuta_anskaffelsesværdi(fakta.position_primo, fakta.årsændring)
    | slutværdi() -> kgl_årsnetto_valuta_årsændring_slutværdi(fakta.årsændring)
    | afstået() -> kgl_årsnetto_valuta_årsændring_afstået(fakta.årsændring)
    | kredit_eller_pris_princip() -> kgl_årsnetto_valuta_kredit_eller_pris_princip(fakta.aktiv, valg)
    | valutakurs_princip() -> kgl_årsnetto_valutakurs_princip(fakta.aktiv, valg)
    | kumulativ_kredit_eller_pris_øre() -> kgl_årsnetto_valuta_kumulativ_kredit_eller_pris_øre(fakta.aktiv, anskaffelsesværdi(), slutværdi())
    | kumulativ_valutakurs_øre() -> kgl_årsnetto_valuta_kumulativ_valutakurs_øre(fakta.aktiv, anskaffelsesværdi(), slutværdi())
    | kredit_eller_pris() -> kgl_årsnetto_valuta_komponentresultat(KglÅrsnettoKreditEllerPriskomponent, kredit_eller_pris_princip(), kumulativ_kredit_eller_pris_øre(), kgl_årsnetto_valuta_tidligere_kredit_eller_pris_medregnet_øre(fakta.position_primo), afstået())
    | valutakurs() -> kgl_årsnetto_valuta_komponentresultat(KglÅrsnettoValutakurskomponent, valutakurs_princip(), kumulativ_valutakurs_øre(), kgl_årsnetto_valuta_tidligere_valutakurs_medregnet_øre(fakta.position_primo), afstået())
    | input_gyldigt() -> fakta.identifikation != "" && kgl_årsnetto_valuta_gyldig(fakta.valuta) && kgl_årsnetto_valutaaktiv_gyldigt(fakta.aktiv) && kgl_årsnetto_valuta_position_primo_gyldig(fakta.position_primo, fakta.valuta, indkomstår) && kgl_årsnetto_valuta_position_matcher_par25_årsvalg(fakta.position_primo, valg) && kgl_årsnetto_valuta_årsændring_matcher_position(fakta.position_primo, fakta.årsændring) && kgl_årsnetto_valutaværdi_gyldig(anskaffelsesværdi()) && anskaffelsesværdi().beløb_hundreddele > 0 && kgl_årsnetto_valutaværdi_gyldig(slutværdi()) && kgl_årsnetto_valuta_tidligere_medregning_konsistent(fakta, valg)
    | position_ultimo() -> hvis input_gyldigt() && afstået() == Falskt { Some(KglÅrsnettoValutaposition(
        indkomstår = indkomstår,
        erhvervelsesår = kgl_årsnetto_valuta_erhvervelsesår(fakta.position_primo, indkomstår),
        valuta = fakta.valuta,
        par25_valgpositioner = kgl_årsnetto_par25_valgpositioner(valg, indkomstår),
        anskaffelsesværdi = anskaffelsesværdi(),
        seneste_værdi = slutværdi(),
        kredit_eller_pris_tidligere_medregnet_øre = kgl_årsnetto_valuta_tidligere_kredit_eller_pris_medregnet_øre(fakta.position_primo) + kredit_eller_pris().årets_rå_netto_øre,
        valutakurs_tidligere_medregnet_øre = kgl_årsnetto_valuta_tidligere_valutakurs_medregnet_øre(fakta.position_primo) + valutakurs().årets_rå_netto_øre
    )) } ellers { None }
    | komponentresultat(komponent: KglÅrsnettoValutakomponentresultat) -> match fakta.aktiv {
        | KglÅrsnettoValutafordring(kilde) -> kursgevinstlov_resultat(kgl_årsnetto_valuta_fordringsinput(fakta, kilde, komponent, indkomstår, årets_samlede_netto_kroner))
        | KglÅrsnettoValutagældEfterPar23 -> kursgevinstlov_resultat_fra_gæld(kgl_årsnetto_valuta_gældsinput(fakta, komponent, indkomstår), årets_samlede_netto_kroner)
    }
    | kursgevinstlov_resultater() -> hvis input_gyldigt() { concat(hvis kredit_eller_pris().årets_rå_netto_kroner != 0 { [komponentresultat(kredit_eller_pris())] } ellers { [] }, hvis valutakurs().årets_rå_netto_kroner != 0 { [komponentresultat(valutakurs())] } ellers { [] }) } ellers { [] }
    | resultat() -> KglÅrsnettoValutaforløbsresultat(
        fakta = fakta,
        input_gyldigt = input_gyldigt(),
        kredit_eller_pris = kredit_eller_pris(),
        valutakurs = valutakurs(),
        årets_rå_netto_kroner = kredit_eller_pris().årets_rå_netto_kroner + valutakurs().årets_rå_netto_kroner,
        position_ultimo = position_ultimo(),
        kursgevinstlov_resultater = kursgevinstlov_resultater()
    )
}
| kgl_årsnetto_valutaforløbsresultat(fakta: KglÅrsnettoValutaforløb, valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> KglÅrsnettoValutaforløbssag(fakta, valg, indkomstår, årets_samlede_netto_kroner).resultat()

# KglÅrsnettoMængdeenhed = KglÅrsnettoAntalStyk | KglÅrsnettoNominelleHundreddele
# KglÅrsnettoFordringsgruppe = KglÅrsnettoEnkeltfordring(mængdeenhed: KglÅrsnettoMængdeenhed) | KglÅrsnettoFondskode(fondskode: Tekst, mængdeenhed: KglÅrsnettoMængdeenhed) | KglÅrsnettoSammeVilkår(udsteder_identifikation: Tekst, vilkårsidentifikation: Tekst, mængdeenhed: KglÅrsnettoMængdeenhed)
# KglÅrsnettoTidspunkt(dato: Dato, rækkefølge_på_dagen: Heltal)
# KglÅrsnettoFordringstranche(identifikation: Tekst, anskaffelsestidspunkt: KglÅrsnettoTidspunkt, resterende_mængde: Heltal, resterende_anskaffelsessum_kroner: Heltal)
# KglÅrsnettoAllokeringsprincip = KglÅrsnettoHelpositionsallokering | KglÅrsnettoGennemsnitsmetodeEfterPar26Stk4 | KglÅrsnettoFifoEfterPar26Stk5
# KglÅrsnettoTranchefordeling(frigivet_anskaffelsessum_kroner: Heltal, afstået_mængde: Heltal, resterende_trancher: List(KglÅrsnettoFordringstranche))
# KglÅrsnettoPositionPrimo = KglÅrsnettoIngenPositionPrimo | KglÅrsnettoVidereførtPositionPrimo(fra_indkomstår: Heltal, skattemæssig_værdi_kroner: Heltal, opgørelsesprincip: KursgevinstlovOpgørelsesprincip) | KglÅrsnettoVidereførtMængdepositionPrimo(fra_indkomstår: Heltal, fordringsgruppe: KglÅrsnettoFordringsgruppe, trancher: List(KglÅrsnettoFordringstranche), opgørelsesprincip: KursgevinstlovOpgørelsesprincip)
# KglÅrsnettoPositionUltimo = KglÅrsnettoIngenPositionUltimo | KglÅrsnettoAktivPositionUltimo(indkomstår: Heltal, skattemæssig_værdi_kroner: Heltal, opgørelsesprincip: KursgevinstlovOpgørelsesprincip) | KglÅrsnettoAktivMængdepositionUltimo(indkomstår: Heltal, fordringsgruppe: KglÅrsnettoFordringsgruppe, trancher: List(KglÅrsnettoFordringstranche), opgørelsesprincip: KursgevinstlovOpgørelsesprincip)
# KglÅrsnettoMængdeafståelsesart = KglÅrsnettoSalg | KglÅrsnettoFuldIndfrielse | KglÅrsnettoDelafdrag
# KglÅrsnettoHændelse = KglÅrsnettoAnskaffelse(anskaffelsessum_kroner: Heltal) | KglÅrsnettoAfståelse(afståelsessum_kroner: Heltal) | KglÅrsnettoUltimoværdi(værdi_kroner: Heltal) | KglÅrsnettoMængdeanskaffelse(tidspunkt: KglÅrsnettoTidspunkt, tranche_identifikation: Tekst, mængde: Heltal, anskaffelsessum_kroner: Heltal) | KglÅrsnettoMængdeafståelse(tidspunkt: KglÅrsnettoTidspunkt, afståelsesart: KglÅrsnettoMængdeafståelsesart, mængde: Heltal, afståelsessum_kroner: Heltal) | KglÅrsnettoMængdeultimoværdi(tidspunkt: KglÅrsnettoTidspunkt, værdi_kroner: Heltal)
# KglÅrsnettoHændelsesresultat(hændelse: KglÅrsnettoHændelse, hændelse_gyldig: Boolsk, er_opgørelse: Boolsk, opgørelsesgrundlag_kroner: Heltal, opgørelsesslutværdi_kroner: Heltal, rå_netto_kroner: Heltal, position_aktiv_efter: Boolsk, resterende_mængde_efter: Heltal, skattemæssig_værdi_efter_kroner: Heltal, trancher_efter: List(KglÅrsnettoFordringstranche))
# KglÅrsnettoForløbstilstand(mængdeforløb: Boolsk, position_aktiv: Boolsk, trancher: List(KglÅrsnettoFordringstranche), tranche_identifikationer: List(Tekst), seneste_tidspunkt: Option(KglÅrsnettoTidspunkt), skattemæssig_værdi_kroner: Heltal, anskaffet_i_indkomståret: Boolsk, afstået_i_indkomståret: Boolsk, ultimoværdi_angivet: Boolsk, har_opgørelse: Boolsk, opgørelsesgrundlag_kroner: Heltal, opgørelsesslutværdi_kroner: Heltal, rå_netto_kroner: Heltal, hændelsesresultater: List(KglÅrsnettoHændelsesresultat), alle_hændelser_gyldige: Boolsk)
# KglÅrsnettoForløbsresultat(indkomstår: Heltal, fordringsgruppe: KglÅrsnettoFordringsgruppe, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), opgørelsesprincip: KursgevinstlovOpgørelsesprincip, allokeringsprincip: KglÅrsnettoAllokeringsprincip, hændelsesresultater: List(KglÅrsnettoHændelsesresultat), har_opgørelse: Boolsk, opgørelsesgrundlag_kroner: Heltal, opgørelsesslutværdi_kroner: Heltal, rå_netto_kroner: Heltal, resterende_mængde: Heltal, position_ultimo: KglÅrsnettoPositionUltimo, input_gyldigt: Boolsk)

| kgl_årsnetto_tom_fordringsgruppe() -> KglÅrsnettoEnkeltfordring(mængdeenhed = KglÅrsnettoNominelleHundreddele)
| kgl_årsnetto_fordringsgruppe_gyldig(gruppe: KglÅrsnettoFordringsgruppe) -> match gruppe {
    | KglÅrsnettoEnkeltfordring(_) -> Sandt
    | KglÅrsnettoFondskode(fondskode, _) -> fondskode != ""
    | KglÅrsnettoSammeVilkår(udsteder, vilkår, _) -> udsteder != "" && vilkår != ""
}
| kgl_årsnetto_fordringsgruppe_tillader_flere_trancher(gruppe: KglÅrsnettoFordringsgruppe) -> match gruppe { | KglÅrsnettoEnkeltfordring(_) -> Falskt | _ -> Sandt }
| kgl_årsnetto_tidspunkt_gyldigt(tidspunkt: KglÅrsnettoTidspunkt) -> dato_gyldig(tidspunkt.dato) && tidspunkt.rækkefølge_på_dagen > 0
| kgl_årsnetto_tidspunkt_før(venstre: KglÅrsnettoTidspunkt, højre: KglÅrsnettoTidspunkt) -> dato_før(venstre.dato, højre.dato) || venstre.dato == højre.dato && venstre.rækkefølge_på_dagen < højre.rækkefølge_på_dagen
| kgl_årsnetto_tidspunkt_i_indkomstår(tidspunkt: KglÅrsnettoTidspunkt, indkomstår: Heltal) -> kgl_årsnetto_tidspunkt_gyldigt(tidspunkt) && tidspunkt.dato.år == indkomstår
| kgl_årsnetto_tidspunkt_er_ultimo(tidspunkt: KglÅrsnettoTidspunkt, indkomstår: Heltal) -> tidspunkt.dato == Dato(år = indkomstår, måned = 12, dag = 31)
| kgl_årsnetto_tranche_gyldig(tranche: KglÅrsnettoFordringstranche, seneste_indkomstår: Heltal) -> tranche.identifikation != "" && kgl_årsnetto_tidspunkt_gyldigt(tranche.anskaffelsestidspunkt) && tranche.anskaffelsestidspunkt.dato.år <= seneste_indkomstår && tranche.resterende_mængde > 0 && tranche.resterende_anskaffelsessum_kroner >= 0
| kgl_årsnetto_tranche_identifikationer(trancher: List(KglÅrsnettoFordringstranche)) -> map(trancher, |tranche: KglÅrsnettoFordringstranche| tranche.identifikation)
| kgl_årsnetto_tranche_identifikationer_unikke(trancher: List(KglÅrsnettoFordringstranche)) -> length(kgl_årsnetto_tranche_identifikationer(trancher)) == length(distinct(kgl_årsnetto_tranche_identifikationer(trancher)))
| kgl_årsnetto_trancher_tidsordnede(trancher: List(KglÅrsnettoFordringstranche)) -> hvis length(trancher) <= 1 { Sandt } ellers { kgl_årsnetto_tidspunkt_før(head(trancher).anskaffelsestidspunkt, head(tail(trancher)).anskaffelsestidspunkt) && kgl_årsnetto_trancher_tidsordnede(tail(trancher)) }
| kgl_årsnetto_trancher_gyldige(trancher: List(KglÅrsnettoFordringstranche), seneste_indkomstår: Heltal, gruppe: KglÅrsnettoFordringsgruppe) -> length(trancher) > 0 && all(trancher, |tranche: KglÅrsnettoFordringstranche| kgl_årsnetto_tranche_gyldig(tranche, seneste_indkomstår)) && kgl_årsnetto_tranche_identifikationer_unikke(trancher) && kgl_årsnetto_trancher_tidsordnede(trancher) && (kgl_årsnetto_fordringsgruppe_tillader_flere_trancher(gruppe) || length(trancher) == 1)
| kgl_årsnetto_trancher_mængde(trancher: List(KglÅrsnettoFordringstranche)) -> foldl(trancher, 0, |sum: Heltal, tranche: KglÅrsnettoFordringstranche| sum + tranche.resterende_mængde)
| kgl_årsnetto_trancher_anskaffelsessum_kroner(trancher: List(KglÅrsnettoFordringstranche)) -> foldl(trancher, 0, |sum: Heltal, tranche: KglÅrsnettoFordringstranche| sum + tranche.resterende_anskaffelsessum_kroner)

| kgl_årsnetto_position_primo_er_mængdeposition(position: KglÅrsnettoPositionPrimo) -> match position { | KglÅrsnettoVidereførtMængdepositionPrimo(_, _, _, _) -> Sandt | _ -> Falskt }
| kgl_årsnetto_position_primo_gyldig_for_gruppe(position: KglÅrsnettoPositionPrimo, indkomstår: Heltal, gruppe: KglÅrsnettoFordringsgruppe) -> match position {
    | KglÅrsnettoIngenPositionPrimo -> Sandt
    | KglÅrsnettoVidereførtPositionPrimo(fra_indkomstår, værdi, _) -> fra_indkomstår == indkomstår - 1 && værdi >= 0
    | KglÅrsnettoVidereførtMængdepositionPrimo(fra_indkomstår, positionsgruppe, trancher, _) -> fra_indkomstår == indkomstår - 1 && positionsgruppe == gruppe && kgl_årsnetto_fordringsgruppe_gyldig(positionsgruppe) && kgl_årsnetto_trancher_gyldige(trancher, fra_indkomstår, positionsgruppe)
}
| kgl_årsnetto_position_primo_gyldig(position: KglÅrsnettoPositionPrimo, indkomstår: Heltal) -> kgl_årsnetto_position_primo_gyldig_for_gruppe(position, indkomstår, kgl_årsnetto_tom_fordringsgruppe())
| kgl_årsnetto_position_primo_aktiv(position: KglÅrsnettoPositionPrimo) -> match position { | KglÅrsnettoIngenPositionPrimo -> Falskt | _ -> Sandt }
| kgl_årsnetto_position_primo_trancher(position: KglÅrsnettoPositionPrimo) -> match position { | KglÅrsnettoVidereførtMængdepositionPrimo(_, _, trancher, _) -> trancher | _ -> [] }
| kgl_årsnetto_position_primo_værdi_kroner(position: KglÅrsnettoPositionPrimo) -> match position { | KglÅrsnettoIngenPositionPrimo -> 0 | KglÅrsnettoVidereførtPositionPrimo(_, værdi, _) -> værdi | KglÅrsnettoVidereførtMængdepositionPrimo(_, _, trancher, _) -> kgl_årsnetto_trancher_anskaffelsessum_kroner(trancher) }
| kgl_årsnetto_position_primo_matcher_par25_valgprimo(position: KglÅrsnettoPositionPrimo, valgprimo: KglÅrsnettoPar25ValgPrimo) -> match position {
    | KglÅrsnettoIngenPositionPrimo -> Sandt
    | KglÅrsnettoVidereførtPositionPrimo(fra_indkomstår, _, princip) -> kgl_årsnetto_par25_valgprimo_matcher_position(valgprimo, KglÅrsnettoPar25Valgposition(indkomstår = fra_indkomstår, princip = princip))
    | KglÅrsnettoVidereførtMængdepositionPrimo(fra_indkomstår, _, _, princip) -> kgl_årsnetto_par25_valgprimo_matcher_position(valgprimo, KglÅrsnettoPar25Valgposition(indkomstår = fra_indkomstår, princip = princip))
}
| kgl_årsnetto_position_primo_fra_ultimo(position: KglÅrsnettoPositionUltimo) -> match position { | KglÅrsnettoIngenPositionUltimo -> KglÅrsnettoIngenPositionPrimo | KglÅrsnettoAktivPositionUltimo(indkomstår, værdi, princip) -> KglÅrsnettoVidereførtPositionPrimo(fra_indkomstår = indkomstår, skattemæssig_værdi_kroner = værdi, opgørelsesprincip = princip) | KglÅrsnettoAktivMængdepositionUltimo(indkomstår, gruppe, trancher, princip) -> KglÅrsnettoVidereførtMængdepositionPrimo(fra_indkomstår = indkomstår, fordringsgruppe = gruppe, trancher = trancher, opgørelsesprincip = princip) }

| kgl_årsnetto_tranche_med_beløb(tranche: KglÅrsnettoFordringstranche, mængde: Heltal, anskaffelsessum_kroner: Heltal) -> KglÅrsnettoFordringstranche(identifikation = tranche.identifikation, anskaffelsestidspunkt = tranche.anskaffelsestidspunkt, resterende_mængde = mængde, resterende_anskaffelsessum_kroner = anskaffelsessum_kroner)
| kgl_årsnetto_trancher_med_samlet_værdi(trancher: List(KglÅrsnettoFordringstranche), samlet_værdi_kroner: Heltal) -> hvis length(trancher) == 0 { [] } ellers hvis length(trancher) == 1 { [kgl_årsnetto_tranche_med_beløb(head(trancher), head(trancher).resterende_mængde, samlet_værdi_kroner)] } ellers {
    = første = head(trancher)
    = samlet_mængde = kgl_årsnetto_trancher_mængde(trancher)
    = første_værdi = samlet_værdi_kroner * første.resterende_mængde / samlet_mængde
    concat([kgl_årsnetto_tranche_med_beløb(første, første.resterende_mængde, første_værdi)], kgl_årsnetto_trancher_med_samlet_værdi(tail(trancher), samlet_værdi_kroner - første_værdi))
}
| kgl_årsnetto_fifo_tranchefordeling(trancher: List(KglÅrsnettoFordringstranche), mængde: Heltal) -> hvis mængde <= 0 || length(trancher) == 0 { KglÅrsnettoTranchefordeling(frigivet_anskaffelsessum_kroner = 0, afstået_mængde = 0, resterende_trancher = trancher) } ellers {
    = første = head(trancher)
    = afstået_fra_første = hvis mængde < første.resterende_mængde { mængde } ellers { første.resterende_mængde }
    = frigivet_fra_første = hvis afstået_fra_første == første.resterende_mængde { første.resterende_anskaffelsessum_kroner } ellers { første.resterende_anskaffelsessum_kroner * afstået_fra_første / første.resterende_mængde }
    = første_restmængde = første.resterende_mængde - afstået_fra_første
    = første_rest = hvis første_restmængde > 0 { [kgl_årsnetto_tranche_med_beløb(første, første_restmængde, første.resterende_anskaffelsessum_kroner - frigivet_fra_første)] } ellers { [] }
    = restfordeling = kgl_årsnetto_fifo_tranchefordeling(tail(trancher), mængde - afstået_fra_første)
    KglÅrsnettoTranchefordeling(
        frigivet_anskaffelsessum_kroner = frigivet_fra_første + restfordeling.frigivet_anskaffelsessum_kroner,
        afstået_mængde = afstået_fra_første + restfordeling.afstået_mængde,
        resterende_trancher = concat(første_rest, restfordeling.resterende_trancher)
    )
}
| kgl_årsnetto_gennemsnitlig_tranchefordeling(trancher: List(KglÅrsnettoFordringstranche), mængde: Heltal) -> {
    = samlet_mængde = kgl_årsnetto_trancher_mængde(trancher)
    = samlet_anskaffelsessum = kgl_årsnetto_trancher_anskaffelsessum_kroner(trancher)
    = mængdefordeling = kgl_årsnetto_fifo_tranchefordeling(trancher, mængde)
    = frigivet_anskaffelsessum = hvis mængde == samlet_mængde { samlet_anskaffelsessum } ellers { samlet_anskaffelsessum * mængde / samlet_mængde }
    KglÅrsnettoTranchefordeling(
        frigivet_anskaffelsessum_kroner = frigivet_anskaffelsessum,
        afstået_mængde = mængdefordeling.afstået_mængde,
        resterende_trancher = kgl_årsnetto_trancher_med_samlet_værdi(mængdefordeling.resterende_trancher, samlet_anskaffelsessum - frigivet_anskaffelsessum)
    )
}
| kgl_årsnetto_tranchefordeling(trancher: List(KglÅrsnettoFordringstranche), mængde: Heltal, allokeringsprincip: KglÅrsnettoAllokeringsprincip) -> hvis allokeringsprincip == KglÅrsnettoGennemsnitsmetodeEfterPar26Stk4 { kgl_årsnetto_gennemsnitlig_tranchefordeling(trancher, mængde) } ellers { kgl_årsnetto_fifo_tranchefordeling(trancher, mængde) }

| kgl_årsnetto_hændelse_er_mængdehændelse(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoMængdeanskaffelse(_, _, _, _) -> Sandt | KglÅrsnettoMængdeafståelse(_, _, _, _) -> Sandt | KglÅrsnettoMængdeultimoværdi(_, _) -> Sandt | _ -> Falskt }
| kgl_årsnetto_hændelse_er_legacyhændelse(hændelse: KglÅrsnettoHændelse) -> kgl_årsnetto_hændelse_er_mængdehændelse(hændelse) == Falskt
| kgl_årsnetto_forløbstype_gyldig(position: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse)) -> {
    = har_mængdehændelse = any(hændelser, kgl_årsnetto_hændelse_er_mængdehændelse)
    = har_legacyhændelse = any(hændelser, kgl_årsnetto_hændelse_er_legacyhændelse)
    hvis har_mængdehændelse && har_legacyhændelse {
        Falskt
    } ellers hvis har_mængdehændelse {
        match position { | KglÅrsnettoVidereførtPositionPrimo(_, _, _) -> Falskt | _ -> Sandt }
    } ellers hvis har_legacyhændelse {
        kgl_årsnetto_position_primo_er_mængdeposition(position) == Falskt
    } ellers {
        Sandt
    }
}
| kgl_årsnetto_hændelsestidspunkt(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoMængdeanskaffelse(tidspunkt, _, _, _) -> Some(tidspunkt) | KglÅrsnettoMængdeafståelse(tidspunkt, _, _, _) -> Some(tidspunkt) | KglÅrsnettoMængdeultimoværdi(tidspunkt, _) -> Some(tidspunkt) | _ -> None }
| kgl_årsnetto_hændelsesrækkefølge_gyldig(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, indkomstår: Heltal) -> match kgl_årsnetto_hændelsestidspunkt(hændelse) { | None -> tilstand.mængdeforløb == Falskt | Some(tidspunkt) -> tilstand.mængdeforløb && kgl_årsnetto_tidspunkt_i_indkomstår(tidspunkt, indkomstår) && match tilstand.seneste_tidspunkt { | None -> Sandt | Some(seneste) -> kgl_årsnetto_tidspunkt_før(seneste, tidspunkt) } }
| kgl_årsnetto_hændelsesbeløb_kroner(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoAnskaffelse(beløb) -> beløb | KglÅrsnettoAfståelse(beløb) -> beløb | KglÅrsnettoUltimoværdi(beløb) -> beløb | KglÅrsnettoMængdeanskaffelse(_, _, _, beløb) -> beløb | KglÅrsnettoMængdeafståelse(_, _, _, beløb) -> beløb | KglÅrsnettoMængdeultimoværdi(_, beløb) -> beløb }
| kgl_årsnetto_hændelsesmængde(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoMængdeanskaffelse(_, _, mængde, _) -> mængde | KglÅrsnettoMængdeafståelse(_, _, mængde, _) -> mængde | _ -> 0 }
| kgl_årsnetto_hændelsestranche_identifikation(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoMængdeanskaffelse(_, identifikation, _, _) -> identifikation | _ -> "" }
| kgl_årsnetto_mængdeafståelsesart_gyldig(art: KglÅrsnettoMængdeafståelsesart, mængde: Heltal, samlet_mængde: Heltal) -> match art { | KglÅrsnettoSalg -> Sandt | KglÅrsnettoFuldIndfrielse -> mængde == samlet_mængde | KglÅrsnettoDelafdrag -> mængde < samlet_mængde }
| kgl_årsnetto_hændelse_gyldig(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, princip: KursgevinstlovOpgørelsesprincip, indkomstår: Heltal, gruppe: KglÅrsnettoFordringsgruppe) -> kgl_årsnetto_hændelsesbeløb_kroner(hændelse) >= 0 && kgl_årsnetto_hændelsesrækkefølge_gyldig(tilstand, hændelse, indkomstår) && match hændelse {
    | KglÅrsnettoAnskaffelse(_) -> tilstand.position_aktiv == Falskt && tilstand.anskaffet_i_indkomståret == Falskt && tilstand.afstået_i_indkomståret == Falskt && tilstand.ultimoværdi_angivet == Falskt && tilstand.har_opgørelse == Falskt
    | KglÅrsnettoAfståelse(_) -> tilstand.position_aktiv && tilstand.afstået_i_indkomståret == Falskt && tilstand.ultimoværdi_angivet == Falskt && tilstand.har_opgørelse == Falskt
    | KglÅrsnettoUltimoværdi(_) -> tilstand.position_aktiv && princip == KglLagerprincip && tilstand.afstået_i_indkomståret == Falskt && tilstand.ultimoværdi_angivet == Falskt && tilstand.har_opgørelse == Falskt
    | KglÅrsnettoMængdeanskaffelse(_, identifikation, mængde, _) -> identifikation != "" && contains(tilstand.tranche_identifikationer, identifikation) == Falskt && mængde > 0 && tilstand.ultimoværdi_angivet == Falskt && (kgl_årsnetto_fordringsgruppe_tillader_flere_trancher(gruppe) || length(tilstand.tranche_identifikationer) == 0)
    | KglÅrsnettoMængdeafståelse(_, art, mængde, _) -> tilstand.position_aktiv && mængde > 0 && mængde <= kgl_årsnetto_trancher_mængde(tilstand.trancher) && kgl_årsnetto_mængdeafståelsesart_gyldig(art, mængde, kgl_årsnetto_trancher_mængde(tilstand.trancher)) && tilstand.ultimoværdi_angivet == Falskt
    | KglÅrsnettoMængdeultimoværdi(tidspunkt, _) -> tilstand.position_aktiv && princip == KglLagerprincip && kgl_årsnetto_tidspunkt_er_ultimo(tidspunkt, indkomstår) && tilstand.ultimoværdi_angivet == Falskt
}
| kgl_årsnetto_hændelse_er_opgørelse(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoAnskaffelse(_) -> Falskt | KglÅrsnettoMængdeanskaffelse(_, _, _, _) -> Falskt | _ -> Sandt }
| kgl_årsnetto_ny_tranche(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoMængdeanskaffelse(tidspunkt, identifikation, mængde, anskaffelsessum) -> KglÅrsnettoFordringstranche(identifikation = identifikation, anskaffelsestidspunkt = tidspunkt, resterende_mængde = mængde, resterende_anskaffelsessum_kroner = anskaffelsessum) | _ -> KglÅrsnettoFordringstranche(identifikation = "", anskaffelsestidspunkt = KglÅrsnettoTidspunkt(dato = dato_ugyldig(), rækkefølge_på_dagen = 0), resterende_mængde = 0, resterende_anskaffelsessum_kroner = 0) }

# KglÅrsnettoHændelsessag(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, princip: KursgevinstlovOpgørelsesprincip, allokeringsprincip: KglÅrsnettoAllokeringsprincip, indkomstår: Heltal, gruppe: KglÅrsnettoFordringsgruppe) {
    | hændelse_gyldig() -> kgl_årsnetto_hændelse_gyldig(tilstand, hændelse, princip, indkomstår, gruppe)
    | er_opgørelse() -> hændelse_gyldig() && kgl_årsnetto_hændelse_er_opgørelse(hændelse)
    | tranchefordeling() -> match hændelse { | KglÅrsnettoMængdeafståelse(_, _, mængde, _) -> hvis hændelse_gyldig() { kgl_årsnetto_tranchefordeling(tilstand.trancher, mængde, allokeringsprincip) } ellers { KglÅrsnettoTranchefordeling(frigivet_anskaffelsessum_kroner = 0, afstået_mængde = 0, resterende_trancher = tilstand.trancher) } | _ -> KglÅrsnettoTranchefordeling(frigivet_anskaffelsessum_kroner = 0, afstået_mængde = 0, resterende_trancher = tilstand.trancher) }
    | opgørelsesgrundlag_kroner() -> hvis er_opgørelse() { match hændelse { | KglÅrsnettoMængdeafståelse(_, _, _, _) -> tranchefordeling().frigivet_anskaffelsessum_kroner | _ -> tilstand.skattemæssig_værdi_kroner } } ellers { 0 }
    | opgørelsesslutværdi_kroner() -> hvis er_opgørelse() { kgl_årsnetto_hændelsesbeløb_kroner(hændelse) } ellers { 0 }
    | rå_netto_kroner() -> opgørelsesslutværdi_kroner() - opgørelsesgrundlag_kroner()
    | trancher_efter() -> hvis hændelse_gyldig() == Falskt { tilstand.trancher } ellers { match hændelse {
        | KglÅrsnettoMængdeanskaffelse(_, _, _, _) -> concat(tilstand.trancher, [kgl_årsnetto_ny_tranche(hændelse)])
        | KglÅrsnettoMængdeafståelse(_, _, _, _) -> tranchefordeling().resterende_trancher
        | KglÅrsnettoMængdeultimoværdi(_, værdi) -> kgl_årsnetto_trancher_med_samlet_værdi(tilstand.trancher, værdi)
        | _ -> tilstand.trancher
    } }
    | position_aktiv_efter() -> hvis hændelse_gyldig() == Falskt { tilstand.position_aktiv } ellers hvis tilstand.mængdeforløb { length(trancher_efter()) > 0 } ellers { match hændelse { | KglÅrsnettoAnskaffelse(_) -> Sandt | KglÅrsnettoAfståelse(_) -> Falskt | KglÅrsnettoUltimoværdi(_) -> Sandt | _ -> tilstand.position_aktiv } }
    | skattemæssig_værdi_efter_kroner() -> hvis hændelse_gyldig() == Falskt { tilstand.skattemæssig_værdi_kroner } ellers hvis tilstand.mængdeforløb { kgl_årsnetto_trancher_anskaffelsessum_kroner(trancher_efter()) } ellers { match hændelse { | KglÅrsnettoAnskaffelse(beløb) -> beløb | KglÅrsnettoAfståelse(_) -> 0 | KglÅrsnettoUltimoværdi(beløb) -> beløb | _ -> tilstand.skattemæssig_værdi_kroner } }
    | seneste_tidspunkt_efter() -> {
        = resultat: Option(KglÅrsnettoTidspunkt) = hvis hændelse_gyldig() { match kgl_årsnetto_hændelsestidspunkt(hændelse) { | Some(tidspunkt) -> Some(tidspunkt) | None -> tilstand.seneste_tidspunkt } } ellers { tilstand.seneste_tidspunkt }
        resultat
    }
    | tranche_identifikationer_efter() -> hvis hændelse_gyldig() { match hændelse { | KglÅrsnettoMængdeanskaffelse(_, identifikation, _, _) -> concat(tilstand.tranche_identifikationer, [identifikation]) | _ -> tilstand.tranche_identifikationer } } ellers { tilstand.tranche_identifikationer }
    | hændelsesresultat() -> KglÅrsnettoHændelsesresultat(
        hændelse = hændelse,
        hændelse_gyldig = hændelse_gyldig(),
        er_opgørelse = er_opgørelse(),
        opgørelsesgrundlag_kroner = opgørelsesgrundlag_kroner(),
        opgørelsesslutværdi_kroner = opgørelsesslutværdi_kroner(),
        rå_netto_kroner = rå_netto_kroner(),
        position_aktiv_efter = position_aktiv_efter(),
        resterende_mængde_efter = kgl_årsnetto_trancher_mængde(trancher_efter()),
        skattemæssig_værdi_efter_kroner = skattemæssig_værdi_efter_kroner(),
        trancher_efter = trancher_efter()
    )
    | næste_tilstand() -> KglÅrsnettoForløbstilstand(
        mængdeforløb = tilstand.mængdeforløb,
        position_aktiv = position_aktiv_efter(),
        trancher = trancher_efter(),
        tranche_identifikationer = tranche_identifikationer_efter(),
        seneste_tidspunkt = seneste_tidspunkt_efter(),
        skattemæssig_værdi_kroner = skattemæssig_værdi_efter_kroner(),
        anskaffet_i_indkomståret = tilstand.anskaffet_i_indkomståret || hændelse_gyldig() && match hændelse { | KglÅrsnettoAnskaffelse(_) -> Sandt | KglÅrsnettoMængdeanskaffelse(_, _, _, _) -> Sandt | _ -> Falskt },
        afstået_i_indkomståret = tilstand.afstået_i_indkomståret || hændelse_gyldig() && match hændelse { | KglÅrsnettoAfståelse(_) -> Sandt | KglÅrsnettoMængdeafståelse(_, _, _, _) -> Sandt | _ -> Falskt },
        ultimoværdi_angivet = tilstand.ultimoværdi_angivet || hændelse_gyldig() && match hændelse { | KglÅrsnettoUltimoværdi(_) -> Sandt | KglÅrsnettoMængdeultimoværdi(_, _) -> Sandt | _ -> Falskt },
        har_opgørelse = tilstand.har_opgørelse || er_opgørelse(),
        opgørelsesgrundlag_kroner = tilstand.opgørelsesgrundlag_kroner + opgørelsesgrundlag_kroner(),
        opgørelsesslutværdi_kroner = tilstand.opgørelsesslutværdi_kroner + opgørelsesslutværdi_kroner(),
        rå_netto_kroner = tilstand.rå_netto_kroner + rå_netto_kroner(),
        hændelsesresultater = concat(tilstand.hændelsesresultater, [hændelsesresultat()]),
        alle_hændelser_gyldige = tilstand.alle_hændelser_gyldige && hændelse_gyldig()
    )
}
| kgl_årsnetto_hændelsestrin(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, princip: KursgevinstlovOpgørelsesprincip, allokeringsprincip: KglÅrsnettoAllokeringsprincip, indkomstår: Heltal, gruppe: KglÅrsnettoFordringsgruppe) -> KglÅrsnettoHændelsessag(tilstand, hændelse, princip, allokeringsprincip, indkomstår, gruppe).næste_tilstand()
| kgl_årsnetto_allokeringsprincip_gyldigt(mængdeforløb: Boolsk, allokeringsprincip: KglÅrsnettoAllokeringsprincip) -> mængdeforløb == Falskt || allokeringsprincip != KglÅrsnettoHelpositionsallokering

# KglÅrsnettoForløbssag(indkomstår: Heltal, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), princip: KursgevinstlovOpgørelsesprincip, fordringsgruppe: KglÅrsnettoFordringsgruppe, allokeringsprincip: KglÅrsnettoAllokeringsprincip) {
    | mængdeforløb() -> kgl_årsnetto_position_primo_er_mængdeposition(position_primo) || any(hændelser, kgl_årsnetto_hændelse_er_mængdehændelse)
    | starttrancher() -> kgl_årsnetto_position_primo_trancher(position_primo)
    | starttilstand() -> KglÅrsnettoForløbstilstand(
        mængdeforløb = mængdeforløb(),
        position_aktiv = kgl_årsnetto_position_primo_aktiv(position_primo),
        trancher = starttrancher(),
        tranche_identifikationer = kgl_årsnetto_tranche_identifikationer(starttrancher()),
        seneste_tidspunkt = None,
        skattemæssig_værdi_kroner = kgl_årsnetto_position_primo_værdi_kroner(position_primo),
        anskaffet_i_indkomståret = Falskt,
        afstået_i_indkomståret = Falskt,
        ultimoværdi_angivet = Falskt,
        har_opgørelse = Falskt,
        opgørelsesgrundlag_kroner = 0,
        opgørelsesslutværdi_kroner = 0,
        rå_netto_kroner = 0,
        hændelsesresultater = [],
        alle_hændelser_gyldige = kgl_årsnetto_fordringsgruppe_gyldig(fordringsgruppe) && kgl_årsnetto_position_primo_gyldig_for_gruppe(position_primo, indkomstår, fordringsgruppe) && kgl_årsnetto_forløbstype_gyldig(position_primo, hændelser) && kgl_årsnetto_allokeringsprincip_gyldigt(mængdeforløb(), allokeringsprincip)
    )
    | sluttilstand() -> foldl(hændelser, starttilstand(), |tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse| kgl_årsnetto_hændelsestrin(tilstand, hændelse, princip, allokeringsprincip, indkomstår, fordringsgruppe))
    | har_position_eller_hændelse() -> kgl_årsnetto_position_primo_aktiv(position_primo) || length(hændelser) > 0
    | årsafslutning_gyldig() -> princip != KglLagerprincip || sluttilstand().position_aktiv == Falskt || sluttilstand().ultimoværdi_angivet
    | position_ultimo() -> hvis sluttilstand().position_aktiv { hvis mængdeforløb() { KglÅrsnettoAktivMængdepositionUltimo(indkomstår = indkomstår, fordringsgruppe = fordringsgruppe, trancher = sluttilstand().trancher, opgørelsesprincip = princip) } ellers { KglÅrsnettoAktivPositionUltimo(indkomstår = indkomstår, skattemæssig_værdi_kroner = sluttilstand().skattemæssig_værdi_kroner, opgørelsesprincip = princip) } } ellers { KglÅrsnettoIngenPositionUltimo }
    | input_gyldigt() -> indkomstår > 0 && har_position_eller_hændelse() && sluttilstand().alle_hændelser_gyldige && årsafslutning_gyldig()
    | resultat() -> KglÅrsnettoForløbsresultat(
        indkomstår = indkomstår,
        fordringsgruppe = fordringsgruppe,
        position_primo = position_primo,
        hændelser = hændelser,
        opgørelsesprincip = princip,
        allokeringsprincip = hvis mængdeforløb() { allokeringsprincip } ellers { KglÅrsnettoHelpositionsallokering },
        hændelsesresultater = sluttilstand().hændelsesresultater,
        har_opgørelse = sluttilstand().har_opgørelse,
        opgørelsesgrundlag_kroner = sluttilstand().opgørelsesgrundlag_kroner,
        opgørelsesslutværdi_kroner = sluttilstand().opgørelsesslutværdi_kroner,
        rå_netto_kroner = sluttilstand().rå_netto_kroner,
        resterende_mængde = kgl_årsnetto_trancher_mængde(sluttilstand().trancher),
        position_ultimo = hvis input_gyldigt() { position_ultimo() } ellers { KglÅrsnettoIngenPositionUltimo },
        input_gyldigt = input_gyldigt()
    )
}
| kgl_årsnetto_grupperet_forløbsresultat(indkomstår: Heltal, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), princip: KursgevinstlovOpgørelsesprincip, fordringsgruppe: KglÅrsnettoFordringsgruppe, allokeringsprincip: KglÅrsnettoAllokeringsprincip) -> KglÅrsnettoForløbssag(indkomstår, position_primo, hændelser, princip, fordringsgruppe, allokeringsprincip).resultat()
| kgl_årsnetto_forløbsresultat(indkomstår: Heltal, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), princip: KursgevinstlovOpgørelsesprincip) -> kgl_årsnetto_grupperet_forløbsresultat(indkomstår, position_primo, hændelser, princip, kgl_årsnetto_tom_fordringsgruppe(), KglÅrsnettoFifoEfterPar26Stk5)
--@end:kursgevinstloven_årsnetto_opgørelse--

= aktieavancebeskatningsloven_lbk1098_par22_årsnetto = KursgevinstlovÅrsnettoKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1098",
    identifier = "LBK nr. 1098 af 27/08/2025: Aktieavancebeskatningslovens § 22",
    hentet_dato = "2026-08-03"
)

= kursgevinstloven_årsnetto_abl22_metadata = Metadata(
    attachments = (
        DependencySource(value = aktieavancebeskatningsloven_lbk1098_par22_årsnetto),
    )
)

--@label:kursgevinstloven_årsnetto_abl22::meta:kursgevinstloven_årsnetto_abl22_metadata--
----
§ 22.
Gevinst og tab ved afståelse af omsættelige beviser for indskud i
investeringsinstitutter med minimumsbeskatning, jf. ligningslovens § 16 C,
stk. 1, der er obligationsbaserede, jf. stk. 2-5, medregnes ved opgørelsen af
den skattepligtige indkomst. 1. pkt. finder dog alene anvendelse, hvis årets
nettogevinst eller nettotab sammenlagt med nettogevinster og nettotab på
fordringer og gæld omfattet af kursgevinstlovens §§ 14 og 23 overstiger
2.000 kr. Reglerne i § 14 finder tilsvarende anvendelse.

Stk. 2. Et investeringsinstitut med minimumsbeskatning er obligationsbaseret,
medmindre investeringsinstituttet opfylder betingelserne i § 21, stk. 2.

Stk. 3. Ved opgørelse af, om anbringelserne overholder betingelsen i stk. 2,
medregnes aktiver som nævnt i kursgevinstlovens §§ 29-33 med værdien af det
underliggende aktiv.

Stk. 4. Hvis investeringsinstituttets anbringelser ikke overholder betingelsen i
stk. 2, anses instituttet for at have skiftet skattemæssig status til et
aktiebaseret investeringsinstitut med minimumsbeskatning, jf. § 33 og
selskabsskattelovens § 5 F, og reglerne i § 21 finder anvendelse.

Stk. 5. Investeringsinstituttet skal indsende oplysninger til told- og
skatteforvaltningen til vurdering af, om anbringelsesgrænsen i stk. 2 er
overholdt. Oplysningerne skal indsendes senest samtidig med oplysninger til
bedømmelse af, om investeringsinstituttet overholder betingelserne for at være
et investeringsinstitut med minimumsbeskatning. Hvis anbringelsesgrænsen ikke er
overholdt, skal investeringsinstituttet offentliggøre dette.

Stk. 6. I tilfælde, der er omfattet af stk. 1, finder reglerne i §§ 5 A, 12,
13 A, 19 B, 19 C og 44 ikke anvendelse. Stk. 1 finder ikke anvendelse i de i
§ 17 nævnte tilfælde.
----

--@begin:kursgevinstloven_årsnetto_abl22--
# KglÅrsnettoFordringsforløb(identifikation: Tekst, kilde: KglÅrsnettoFordringskilde, fordringsgruppe: KglÅrsnettoFordringsgruppe, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse))
# KglÅrsnettoAbl22Kilde(klassifikation: AktieavancePar21Par22Input, par17_modprøve: AktieavancePar17Modprøve)
# KglÅrsnettoAbl22Forløb(kilde: KglÅrsnettoAbl22Kilde, beholdning: AktieavanceInvesteringsbevisBeholdningsforløbsinput)
# KursgevinstlovÅrsnettoInput(par25_valg: KglÅrsnettoPar25Årsvalg, fordringer: List(KglÅrsnettoFordringsforløb), valutainstrumenter: List(KglÅrsnettoValutaforløb), obligationsbaserede_minimumsbeviser: List(KglÅrsnettoAbl22Forløb))
# KglÅrsnettoFordringsopgørelse(hændelsesresultat: KglÅrsnettoHændelsesresultat, kursgevinstlov_input: KursgevinstlovInput, kursgevinstlov_resultat: KursgevinstlovResultat)
# KglÅrsnettoFordringsresultat(fakta: KglÅrsnettoFordringsforløb, forløb: KglÅrsnettoForløbsresultat, omfattet_af_par14_bagatelgrundlag: Boolsk, opgørelser: List(KglÅrsnettoFordringsopgørelse), input_gyldigt: Boolsk)
# KglÅrsnettoAbl22Opgørelse(afståelsesresultat: AktieavanceInvesteringsbevisAfståelsesresultat, aktieavancebeskatningslov_input: AktieavancebeskatningslovInput, aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat)
# KglÅrsnettoAbl22Resultat(fakta: KglÅrsnettoAbl22Forløb, beholdningsresultat: AktieavanceInvesteringsbevisBeholdningsforløbsresultat, klassifikationsresultat: AktieavancePar21Par22Resultat, effektivt_obligationsbaseret_efter_par22: Boolsk, omfattet_af_par22_bagatelgrundlag: Boolsk, opgørelser: List(KglÅrsnettoAbl22Opgørelse), samlet_aktieavancebeskatningslov_input: AktieavancebeskatningslovInput, samlet_aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat, input_gyldigt: Boolsk)
# KursgevinstlovÅrsnettoResultat(input: KursgevinstlovÅrsnettoInput, input_gyldigt: Boolsk, par25_valgresultat: KglÅrsnettoPar25Valgresultat, rå_netto_til_par14_og_abl22_kroner: Heltal, fordringsresultater: List(KglÅrsnettoFordringsresultat), valutainstrumentresultater: List(KglÅrsnettoValutaforløbsresultat), obligationsbevisresultater: List(KglÅrsnettoAbl22Resultat), kursgevinstlov_resultater: List(KursgevinstlovResultat), aktieavancebeskatningslov_resultater: List(AktieavancebeskatningslovResultat))

| kgl_årsnetto_tomt_input() -> KursgevinstlovÅrsnettoInput(par25_valg = kgl_årsnetto_tomt_par25_årsvalg(), fordringer = [], valutainstrumenter = [], obligationsbaserede_minimumsbeviser = [])
| kgl_årsnetto_fordring_er_markedsnoteret_obligation(fakta: KglÅrsnettoFordringsforløb) -> fakta.kilde.fordringsart == KglÅrsnettoObligation && kgl_årsnetto_markedsnoteret(fakta.kilde.markedsfakta)
| kgl_årsnetto_fordringsposition_matcher_par25_årsvalg(fakta: KglÅrsnettoFordringsforløb, valg: KglÅrsnettoPar25Årsvalg) -> kgl_årsnetto_fordring_er_markedsnoteret_obligation(fakta) == Falskt || kgl_årsnetto_position_primo_matcher_par25_valgprimo(fakta.position_primo, valg.obligationer_på_reguleret_marked.position_primo)
| kgl_årsnetto_par25_valgresultat_for_årsinput(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal) -> {
    = basis = kgl_årsnetto_par25_valgresultat(input.par25_valg, indkomstår)
    = videreførte_fordringspositioner_matcher = all(input.fordringer, |fakta: KglÅrsnettoFordringsforløb| kgl_årsnetto_fordringsposition_matcher_par25_årsvalg(fakta, input.par25_valg))
    = videreførte_valutapositioner_matcher = all(input.valutainstrumenter, |fakta: KglÅrsnettoValutaforløb| kgl_årsnetto_valuta_position_matcher_par25_årsvalg(fakta.position_primo, input.par25_valg))
    KglÅrsnettoPar25Valgresultat(
        input = basis.input,
        input_gyldigt = basis.input_gyldigt && videreførte_fordringspositioner_matcher && videreførte_valutapositioner_matcher,
        obligationsvalg_ultimo = basis.obligationsvalg_ultimo,
        valutavalg_ultimo = basis.valutavalg_ultimo
    )
}
| kgl_årsnetto_fordringsprincip(kilde: KglÅrsnettoFordringskilde, valg: KglÅrsnettoPar25Årsvalg) -> hvis kilde.fordringsart == KglÅrsnettoObligation && kgl_årsnetto_markedsnoteret(kilde.markedsfakta) && valg.obligationer_på_reguleret_marked.aktuelt_princip == KglLagerprincip { KglLagerprincip } ellers { KglRealisationsprincip }
| kgl_årsnetto_fordringsallokeringsprincip(kilde: KglÅrsnettoFordringskilde) -> hvis kgl_årsnetto_fordring_omfattet_af_par13(kilde) { KglÅrsnettoGennemsnitsmetodeEfterPar26Stk4 } ellers { KglÅrsnettoFifoEfterPar26Stk5 }
| kgl_årsnetto_fordringsforløbsresultat(fakta: KglÅrsnettoFordringsforløb, valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal) -> kgl_årsnetto_grupperet_forløbsresultat(indkomstår, fakta.position_primo, fakta.hændelser, kgl_årsnetto_fordringsprincip(fakta.kilde, valg), fakta.fordringsgruppe, kgl_årsnetto_fordringsallokeringsprincip(fakta.kilde))
| kgl_årsnetto_fordringsinput(fakta: KglÅrsnettoFordringsforløb, princip: KursgevinstlovOpgørelsesprincip, hændelsesresultat: KglÅrsnettoHændelsesresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    KursgevinstlovInput(
        indkomstår = indkomstår,
        rolle = KglPersonEfterKildeskatteloven,
        aktiv = KglFordring,
        par1_afgrænsning = kgl_årsnetto_par1_afgrænsning(fakta.kilde),
        bagatelgrundlag = KursgevinstlovBagatelOpgørelse(årets_netto_fordringer_valutagæld_investbeviser_kroner = årets_samlede_netto_kroner),
        fordring = KursgevinstlovFordringOpgørelse(tabsgrundlag = kgl_årsnetto_fordring_tabsgrundlag(fakta.kilde), tabsbegrænsning = kgl_årsnetto_fordring_tabsbegrænsning(fakta.kilde), anskaffelsessum_kroner = hændelsesresultat.opgørelsesgrundlag_kroner, afståelsessum_kroner = hændelsesresultat.opgørelsesslutværdi_kroner),
        gæld = kgl_tom_gæld(),
        kontrakt = kgl_tom_kontrakt(),
        udøver_fordrings_eller_kontraktnæring = kgl_årsnetto_udøver_næring(fakta.kilde.næringsforhold),
        fordring_erhvervet_udenfor_næring = kgl_årsnetto_fordring_erhvervet_udenfor_næring(fakta.kilde.næringsforhold),
        anvender_lagerprincip_efter_par25 = princip == KglLagerprincip
    )
}
| kgl_årsnetto_fordringsopgørelse(fakta: KglÅrsnettoFordringsforløb, princip: KursgevinstlovOpgørelsesprincip, hændelsesresultat: KglÅrsnettoHændelsesresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = kgl_input = kgl_årsnetto_fordringsinput(fakta, princip, hændelsesresultat, indkomstår, årets_samlede_netto_kroner)
    KglÅrsnettoFordringsopgørelse(hændelsesresultat = hændelsesresultat, kursgevinstlov_input = kgl_input, kursgevinstlov_resultat = kursgevinstlov_resultat(kgl_input))
}
| kgl_årsnetto_fordringsopgørelser(fakta: KglÅrsnettoFordringsforløb, forløb: KglÅrsnettoForløbsresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> flat_map(forløb.hændelsesresultater, |hændelsesresultat: KglÅrsnettoHændelsesresultat| hvis hændelsesresultat.er_opgørelse { [kgl_årsnetto_fordringsopgørelse(fakta, forløb.opgørelsesprincip, hændelsesresultat, indkomstår, årets_samlede_netto_kroner)] } ellers { [] })
| kgl_årsnetto_fordringsresultat(fakta: KglÅrsnettoFordringsforløb, valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = forløb = kgl_årsnetto_fordringsforløbsresultat(fakta, valg, indkomstår)
    = position_matcher_valghistorik = kgl_årsnetto_fordringsposition_matcher_par25_årsvalg(fakta, valg)
    = input_gyldigt = fakta.identifikation != "" && forløb.input_gyldigt && position_matcher_valghistorik
    KglÅrsnettoFordringsresultat(
        fakta = fakta,
        forløb = forløb,
        omfattet_af_par14_bagatelgrundlag = kgl_årsnetto_fordring_i_par14_bagatelgrundlag(fakta.kilde),
        opgørelser = hvis input_gyldigt { kgl_årsnetto_fordringsopgørelser(fakta, forløb, indkomstår, årets_samlede_netto_kroner) } ellers { [] },
        input_gyldigt = input_gyldigt
    )
}
| kgl_årsnetto_fordring_rå_netto_kroner(fakta: KglÅrsnettoFordringsforløb, valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal) -> {
    = resultat = kgl_årsnetto_fordringsresultat(fakta, valg, indkomstår, 0)
    hvis resultat.input_gyldigt && resultat.forløb.har_opgørelse && resultat.omfattet_af_par14_bagatelgrundlag { resultat.forløb.rå_netto_kroner } ellers { 0 }
}

| kgl_årsnetto_abl22_beholdningsresultat(fakta: KglÅrsnettoAbl22Forløb) -> aktieavance_investeringsbevis_beholdningsforløbsresultat(fakta.beholdning)
| kgl_årsnetto_abl22_klassifikationsresultat(fakta: KglÅrsnettoAbl22Forløb) -> aktieavance_par21_par22_resultat(fakta.kilde.klassifikation)
| kgl_årsnetto_abl22_effektivt_obligationsbaseret(fakta: KglÅrsnettoAbl22Forløb) -> kgl_årsnetto_abl22_klassifikationsresultat(fakta).input_gyldigt && kgl_årsnetto_abl22_klassifikationsresultat(fakta).effektiv_status == AblObligationsbaseretMinimumsinstitutEfterPar22
| kgl_årsnetto_abl22_omfattet_af_bagatelgrundlag(fakta: KglÅrsnettoAbl22Forløb) -> kgl_årsnetto_abl22_effektivt_obligationsbaseret(fakta) && aktieavance_par17_modprøve_stk3_omfattet(fakta.kilde.par17_modprøve) == Falskt
| kgl_årsnetto_abl22_input(fakta: KglÅrsnettoAbl22Forløb, afståelsesresultat: AktieavanceInvesteringsbevisAfståelsesresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> AktieavancebeskatningslovInput(
    indkomstår = indkomstår,
    aktiv = AblMinimumsinstitutTilKlassifikation,
    afståelsessum_kroner = afståelsesresultat.afståelse.afståelsessum_kroner,
    anskaffelsessum_kroner = afståelsesresultat.hændelsesresultat.anskaffelsessum_henført_til_afståelse_kroner,
    par17_modprøve = fakta.kilde.par17_modprøve,
    koncernintern_konvertibel_eller_tegningsret = Falskt,
    andelsforening_stiftet_før_22_maj_1987 = Falskt,
    afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
    investeringsklassifikation = AblPar21Par22Klassifikation(input = fakta.kilde.klassifikation),
    årets_netto_med_kgl_par14_23_kroner = årets_samlede_netto_kroner
)
| kgl_årsnetto_abl22_opgørelse(fakta: KglÅrsnettoAbl22Forløb, afståelsesresultat: AktieavanceInvesteringsbevisAfståelsesresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = abl_input = kgl_årsnetto_abl22_input(fakta, afståelsesresultat, indkomstår, årets_samlede_netto_kroner)
    KglÅrsnettoAbl22Opgørelse(
        afståelsesresultat = afståelsesresultat,
        aktieavancebeskatningslov_input = abl_input,
        aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat(abl_input)
    )
}
| kgl_årsnetto_abl22_samlet_afståelsessum_kroner(beholdning: AktieavanceInvesteringsbevisBeholdningsforløbsresultat) -> foldl(beholdning.afståelsesresultater, 0, |sum: Heltal, afståelse: AktieavanceInvesteringsbevisAfståelsesresultat| sum + afståelse.afståelse.afståelsessum_kroner)
| kgl_årsnetto_abl22_samlet_anskaffelsessum_kroner(beholdning: AktieavanceInvesteringsbevisBeholdningsforløbsresultat) -> foldl(beholdning.afståelsesresultater, 0, |sum: Heltal, afståelse: AktieavanceInvesteringsbevisAfståelsesresultat| sum + afståelse.hændelsesresultat.anskaffelsessum_henført_til_afståelse_kroner)
| kgl_årsnetto_abl22_samlet_input(fakta: KglÅrsnettoAbl22Forløb, beholdning: AktieavanceInvesteringsbevisBeholdningsforløbsresultat, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> AktieavancebeskatningslovInput(
    indkomstår = indkomstår,
    aktiv = AblMinimumsinstitutTilKlassifikation,
    afståelsessum_kroner = kgl_årsnetto_abl22_samlet_afståelsessum_kroner(beholdning),
    anskaffelsessum_kroner = kgl_årsnetto_abl22_samlet_anskaffelsessum_kroner(beholdning),
    par17_modprøve = fakta.kilde.par17_modprøve,
    koncernintern_konvertibel_eller_tegningsret = Falskt,
    andelsforening_stiftet_før_22_maj_1987 = Falskt,
    afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
    investeringsklassifikation = AblPar21Par22Klassifikation(input = fakta.kilde.klassifikation),
    årets_netto_med_kgl_par14_23_kroner = årets_samlede_netto_kroner
)
| kgl_årsnetto_abl22_resultat(fakta: KglÅrsnettoAbl22Forløb, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = beholdning = kgl_årsnetto_abl22_beholdningsresultat(fakta)
    = klassifikation = kgl_årsnetto_abl22_klassifikationsresultat(fakta)
    = effektivt_obligationsbaseret = kgl_årsnetto_abl22_effektivt_obligationsbaseret(fakta)
    = input_gyldigt = fakta.kilde.klassifikation.indkomstår == indkomstår && fakta.beholdning.indkomstår == indkomstår && klassifikation.input_gyldigt && effektivt_obligationsbaseret && beholdning.input_gyldigt
    = samlet_abl_input = kgl_årsnetto_abl22_samlet_input(fakta, beholdning, indkomstår, årets_samlede_netto_kroner)
    KglÅrsnettoAbl22Resultat(
        fakta = fakta,
        beholdningsresultat = beholdning,
        klassifikationsresultat = klassifikation,
        effektivt_obligationsbaseret_efter_par22 = effektivt_obligationsbaseret,
        omfattet_af_par22_bagatelgrundlag = kgl_årsnetto_abl22_omfattet_af_bagatelgrundlag(fakta),
        opgørelser = hvis input_gyldigt { map(beholdning.afståelsesresultater, |afståelsesresultat: AktieavanceInvesteringsbevisAfståelsesresultat| kgl_årsnetto_abl22_opgørelse(fakta, afståelsesresultat, indkomstår, årets_samlede_netto_kroner)) } ellers { [] },
        samlet_aktieavancebeskatningslov_input = samlet_abl_input,
        samlet_aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat(samlet_abl_input),
        input_gyldigt = input_gyldigt
    )
}
| kgl_årsnetto_abl22_rå_netto_kroner(fakta: KglÅrsnettoAbl22Forløb, indkomstår: Heltal) -> {
    = resultat = kgl_årsnetto_abl22_resultat(fakta, indkomstår, 0)
    hvis resultat.input_gyldigt && length(resultat.opgørelser) > 0 && resultat.omfattet_af_par22_bagatelgrundlag { aktieavance_investeringsbevis_rå_netto_kroner(resultat.beholdningsresultat) } ellers { 0 }
}

| kgl_årsnetto_abl22_identifikationer(fakta: KglÅrsnettoAbl22Forløb) -> concat([fakta.beholdning.identifikation], map(fakta.beholdning.afståelser, |afståelse: AktieavanceInvesteringsbevisAfståelse| afståelse.identifikation))
| kgl_årsnetto_identifikationer(input: KursgevinstlovÅrsnettoInput) -> concat(concat(map(input.fordringer, |fakta: KglÅrsnettoFordringsforløb| fakta.identifikation), map(input.valutainstrumenter, |fakta: KglÅrsnettoValutaforløb| fakta.identifikation)), flat_map(input.obligationsbaserede_minimumsbeviser, kgl_årsnetto_abl22_identifikationer))
| kgl_årsnetto_identifikationer_unikke(input: KursgevinstlovÅrsnettoInput) -> all(kgl_årsnetto_identifikationer(input), |identifikation: Tekst| identifikation != "" && length(filter(kgl_årsnetto_identifikationer(input), |anden: Tekst| anden == identifikation)) == 1)
| kgl_årsnetto_abl22_udstederidentifikationer(input: KursgevinstlovÅrsnettoInput) -> map(input.obligationsbaserede_minimumsbeviser, |fakta: KglÅrsnettoAbl22Forløb| aktieavance_investeringsbevis_udstederidentifikation(fakta.beholdning))
| kgl_årsnetto_abl22_udstederidentifikationer_entydige(input: KursgevinstlovÅrsnettoInput) -> length(kgl_årsnetto_abl22_udstederidentifikationer(input)) == length(distinct(kgl_årsnetto_abl22_udstederidentifikationer(input)))
| kgl_årsnetto_valutainstrument_rå_netto_kroner(fakta: KglÅrsnettoValutaforløb, valg: KglÅrsnettoPar25Årsvalg, indkomstår: Heltal) -> {
    = resultat = kgl_årsnetto_valutaforløbsresultat(fakta, valg, indkomstår, 0)
    hvis resultat.input_gyldigt { resultat.årets_rå_netto_kroner } ellers { 0 }
}
| kgl_årsnetto_rå_netto_kroner(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal) -> foldl(input.fordringer, foldl(input.valutainstrumenter, foldl(input.obligationsbaserede_minimumsbeviser, 0, |sum: Heltal, fakta: KglÅrsnettoAbl22Forløb| sum + kgl_årsnetto_abl22_rå_netto_kroner(fakta, indkomstår)), |sum: Heltal, fakta: KglÅrsnettoValutaforløb| sum + kgl_årsnetto_valutainstrument_rå_netto_kroner(fakta, input.par25_valg, indkomstår)), |sum: Heltal, fakta: KglÅrsnettoFordringsforløb| sum + kgl_årsnetto_fordring_rå_netto_kroner(fakta, input.par25_valg, indkomstår))
| kgl_årsnetto_fordringsresultater(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> map(input.fordringer, |fakta: KglÅrsnettoFordringsforløb| kgl_årsnetto_fordringsresultat(fakta, input.par25_valg, indkomstår, årets_samlede_netto_kroner))
| kgl_årsnetto_valutainstrumentresultater(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> map(input.valutainstrumenter, |fakta: KglÅrsnettoValutaforløb| kgl_årsnetto_valutaforløbsresultat(fakta, input.par25_valg, indkomstår, årets_samlede_netto_kroner))
| kgl_årsnetto_abl22_resultater(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> map(input.obligationsbaserede_minimumsbeviser, |fakta: KglÅrsnettoAbl22Forløb| kgl_årsnetto_abl22_resultat(fakta, indkomstår, årets_samlede_netto_kroner))
| kgl_årsnetto_alle_fordringsresultater_gyldige(resultater: List(KglÅrsnettoFordringsresultat)) -> all(resultater, |resultat: KglÅrsnettoFordringsresultat| resultat.input_gyldigt)
| kgl_årsnetto_alle_valutainstrumentresultater_gyldige(resultater: List(KglÅrsnettoValutaforløbsresultat)) -> all(resultater, |resultat: KglÅrsnettoValutaforløbsresultat| resultat.input_gyldigt)
| kgl_årsnetto_alle_abl22_resultater_gyldige(resultater: List(KglÅrsnettoAbl22Resultat)) -> all(resultater, |resultat: KglÅrsnettoAbl22Resultat| resultat.input_gyldigt)
| kgl_årsnetto_kursgevinstlov_resultater(resultater: List(KglÅrsnettoFordringsresultat)) -> flat_map(resultater, |resultat: KglÅrsnettoFordringsresultat| hvis resultat.input_gyldigt { map(resultat.opgørelser, |opgørelse: KglÅrsnettoFordringsopgørelse| opgørelse.kursgevinstlov_resultat) } ellers { [] })
| kgl_årsnetto_valuta_kursgevinstlov_resultater(resultater: List(KglÅrsnettoValutaforløbsresultat)) -> flat_map(resultater, |resultat: KglÅrsnettoValutaforløbsresultat| resultat.kursgevinstlov_resultater)
| kgl_årsnetto_aktieavancebeskatningslov_resultater(resultater: List(KglÅrsnettoAbl22Resultat)) -> flat_map(resultater, |resultat: KglÅrsnettoAbl22Resultat| hvis resultat.input_gyldigt && length(resultat.opgørelser) > 0 { [resultat.samlet_aktieavancebeskatningslov_resultat] } ellers { [] })

# KursgevinstlovÅrsnettoSag(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) {
    | par25_valgresultat() -> kgl_årsnetto_par25_valgresultat_for_årsinput(input, indkomstår)
    | fordringsresultater() -> kgl_årsnetto_fordringsresultater(input, indkomstår, årets_samlede_netto_kroner)
    | valutainstrumentresultater() -> kgl_årsnetto_valutainstrumentresultater(input, indkomstår, årets_samlede_netto_kroner)
    | obligationsbevisresultater() -> kgl_årsnetto_abl22_resultater(input, indkomstår, årets_samlede_netto_kroner)
    | input_gyldigt() -> indkomstår > 0 && par25_valgresultat().input_gyldigt && kgl_årsnetto_identifikationer_unikke(input) && kgl_årsnetto_abl22_udstederidentifikationer_entydige(input) && kgl_årsnetto_alle_fordringsresultater_gyldige(fordringsresultater()) && kgl_årsnetto_alle_valutainstrumentresultater_gyldige(valutainstrumentresultater()) && kgl_årsnetto_alle_abl22_resultater_gyldige(obligationsbevisresultater())
    | kursgevinstlov_resultater() -> hvis input_gyldigt() { concat(kgl_årsnetto_kursgevinstlov_resultater(fordringsresultater()), kgl_årsnetto_valuta_kursgevinstlov_resultater(valutainstrumentresultater())) } ellers { [] }
    | aktieavancebeskatningslov_resultater() -> hvis input_gyldigt() { kgl_årsnetto_aktieavancebeskatningslov_resultater(obligationsbevisresultater()) } ellers { [] }
    | resultat() -> KursgevinstlovÅrsnettoResultat(
        input = input,
        input_gyldigt = input_gyldigt(),
        par25_valgresultat = par25_valgresultat(),
        rå_netto_til_par14_og_abl22_kroner = kgl_årsnetto_rå_netto_kroner(input, indkomstår),
        fordringsresultater = fordringsresultater(),
        valutainstrumentresultater = valutainstrumentresultater(),
        obligationsbevisresultater = obligationsbevisresultater(),
        kursgevinstlov_resultater = kursgevinstlov_resultater(),
        aktieavancebeskatningslov_resultater = aktieavancebeskatningslov_resultater()
    )
}
| kursgevinstlov_årsnetto_resultat(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> KursgevinstlovÅrsnettoSag(input, indkomstår, årets_samlede_netto_kroner).resultat()
--@end:kursgevinstloven_årsnetto_abl22--
