@ sprog da

@ importer ./metadata
@ importer ./kursgevinstloven
@ importer ./aktieavancebeskatningsloven

# KursgevinstlovÅrsnettoKildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)

= kursgevinstloven_lbk1176_årsnetto = KursgevinstlovÅrsnettoKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1176",
    identifier = "LBK nr. 1176 af 19/09/2025: Kursgevinstlovens §§ 1, 12-18 og 25-26",
    hentet_dato = "2026-08-03"
)

= kursgevinstloven_årsnetto_afgrænsning_metadata = Metadata(
    attachments = (
        Source(value = kursgevinstloven_lbk1176_årsnetto),
    )
)

--@label:kursgevinstloven_årsnetto_afgrænsning::meta:kursgevinstloven_årsnetto_afgrænsning_metadata--
----
§ 1. Denne lov omfatter
1) gevinst og tab ved afståelse eller indfrielse af pengefordringer herunder
obligationer, pantebreve og gældsbreve,
2) gevinst og tab ved frigørelse for gæld og
3) gevinst og tab på terminskontrakter og aftaler om køberetter og salgsretter
uden hensyn til de regler, der gælder for det underliggende aktiv.

Stk. 2. Uanset ligningslovens §§ 16 A og 16 B skal afdrag på og
afståelsessummer for fordringer på koncernforbundne selskaber, jf.
ligningslovens § 2, behandles efter reglerne i denne lov.

Stk. 3. Loven omfatter ikke gevinst og tab på fordringer og gæld, der indgår i
beskatningen af avance ved salg af fast ejendom, der henhører til den
skattepligtiges næringsvej, jf. statsskattelovens § 4, jf. § 5 a.

Stk. 4. Loven omfatter endvidere ikke gevinst og tab på konvertible obligationer
og præmieobligationer.

§ 12. Personer, der er skattepligtige efter kildeskatteloven, og dødsboer, der
er skattepligtige efter dødsboskatteloven, skal ved opgørelsen af den
skattepligtige indkomst medregne gevinst og tab på fordringer og gæld, som
omfattes af § 1, efter de regler, der er angivet i dette kapitel og § 29 samt i
kapitel 4, 5 og 7.

§ 13. Hvis personen eller dødsboet udøver næring ved køb og salg af fordringer
eller driver næringsvirksomhed ved finansiering, medregnes gevinst og tab på
fordringer ved opgørelsen af den skattepligtige indkomst, jf. dog § 18.

Stk. 2. Godtgøres det, at en fordring er erhvervet uden for den skattepligtiges
næringsvirksomhed og ikke senere er indgået i denne, omfatter stk. 1 ikke
gevinst og tab på en sådan fordring.

§ 14. Gevinst og tab på fordringer medregnes ved opgørelsen af den
skattepligtige indkomst, jf. dog stk. 2 og §§ 15, 17 og 18. 1. pkt. finder dog
alene anvendelse, hvis årets nettogevinst eller nettotab sammenlagt med
nettogevinster og nettotab omfattet af § 23 og gevinst og tab på
investeringsbeviser i obligationsbaserede investeringsinstitutter med
minimumsbeskatning, jf. aktieavancebeskatningslovens § 22, overstiger 2.000 kr.

Stk. 2. Tab på fordringer på selskaber, hvorover den skattepligtige har eller
har haft en indflydelse som omhandlet i aktieavancebeskatningslovens § 4, eller
tab på fordringer på den skattepligtiges ægtefælle, forældre og bedsteforældre
samt børn og børnebørn og disses ægtefæller eller dødsboer efter de nævnte
personer kan ikke fradrages. Stedbarns- og adoptivforhold sidestilles med
naturligt slægtskabsforhold. For fordringer i fremmed valuta opgøres det
ikkefradragsberettigede tab efter 1. og 2. pkt. på grundlag af valutakurserne
på tidspunktet for fordringens erhvervelse.

§ 15. Fradrag for tab efter § 14, stk. 1, på fordringer, der er optaget til
handel på et reguleret marked, er betinget af, at told- og skatteforvaltningen
inden udløbet af oplysningsfristen efter skattekontrollovens §§ 10 og 11,
jf. § 13, for det indkomstår, hvor erhvervelsen har fundet sted, har modtaget
oplysninger om erhvervelsen af fordringen med angivelse af fordringens
identitet, antallet eller pålydende værdi, anskaffelsestidspunktet og
anskaffelsessummen.

§ 17. For tab på fordringer, der er erhvervet som vederlag i næring og for tab
på fordringer, der i øvrigt er erhvervet i tilknytning til den erhvervsmæssige
drift af virksomheden, finder reglerne i statsskattelovens § 6 a anvendelse,
jf. dog § 18.

§ 18. Uanset §§ 13, 14 og 17 kan tab på en fordring ikke fradrages, såfremt
renteindtægter af fordringen eller gevinster på fordringen omfattet af denne
lov som følge af en dobbeltbeskatningsoverenskomst ikke skal medregnes ved
opgørelse af den skattepligtige indkomst.
----

--@begin:kursgevinstloven_årsnetto_afgrænsning--
# KglÅrsnettoFordringsart = KglÅrsnettoPengefordring | KglÅrsnettoObligation | KglÅrsnettoFordringIFastEjendomsNæring | KglÅrsnettoKonvertibelObligation | KglÅrsnettoPræmieobligation
# KglÅrsnettoOplysningsstatus = KglÅrsnettoOplystRettidigt | KglÅrsnettoIkkeOplystRettidigt
# KglÅrsnettoMarkedsfakta = KglÅrsnettoIkkeOptagetPåReguleretMarked | KglÅrsnettoOptagetPåReguleretMarked(oplysningsstatus: KglÅrsnettoOplysningsstatus)
# KglÅrsnettoDebitorrelation = KglÅrsnettoUafhængigDebitor | KglÅrsnettoKontrolleretSelskab | KglÅrsnettoNærtståendePerson
# KglÅrsnettoNæringsforhold = KglÅrsnettoIkkeNæringsdrivende | KglÅrsnettoFordringsEllerFinansieringsnæring | KglÅrsnettoDokumenteretErhvervetUdenForNæring
# KglÅrsnettoErhvervelsesgrundlag = KglÅrsnettoAlmindeligErhvervelse | KglÅrsnettoVederlagINæring | KglÅrsnettoTilknyttetErhvervsdrift
# KglÅrsnettoDbaStatus = KglÅrsnettoIngenDbaBegrænsning | KglÅrsnettoRenterEllerGevinsterUndtagetEfterDba
# KglÅrsnettoFordringskilde(fordringsart: KglÅrsnettoFordringsart, markedsfakta: KglÅrsnettoMarkedsfakta, debitorrelation: KglÅrsnettoDebitorrelation, næringsforhold: KglÅrsnettoNæringsforhold, erhvervelsesgrundlag: KglÅrsnettoErhvervelsesgrundlag, dba_status: KglÅrsnettoDbaStatus, opgørelsesprincip: KursgevinstlovOpgørelsesprincip)

| kgl_årsnetto_par1_afgrænsning(kilde: KglÅrsnettoFordringskilde) -> match kilde.fordringsart {
    | KglÅrsnettoFordringIFastEjendomsNæring -> KglFastEjendomNæringUndtaget
    | KglÅrsnettoKonvertibelObligation -> KglKonvertibelEllerPræmieobligationUndtaget
    | KglÅrsnettoPræmieobligation -> KglKonvertibelEllerPræmieobligationUndtaget
    | _ -> KglPar1Omfattet
}
| kgl_årsnetto_markedsnoteret(markedsfakta: KglÅrsnettoMarkedsfakta) -> match markedsfakta { | KglÅrsnettoOptagetPåReguleretMarked(_) -> Sandt | _ -> Falskt }
| kgl_årsnetto_oplyst_rettidigt(markedsfakta: KglÅrsnettoMarkedsfakta) -> match markedsfakta { | KglÅrsnettoOptagetPåReguleretMarked(status) -> status == KglÅrsnettoOplystRettidigt | _ -> Sandt }
| kgl_årsnetto_udøver_næring(næringsforhold: KglÅrsnettoNæringsforhold) -> næringsforhold != KglÅrsnettoIkkeNæringsdrivende
| kgl_årsnetto_fordring_erhvervet_udenfor_næring(næringsforhold: KglÅrsnettoNæringsforhold) -> næringsforhold == KglÅrsnettoDokumenteretErhvervetUdenForNæring
| kgl_årsnetto_fordring_omfattet_af_par13(kilde: KglÅrsnettoFordringskilde) -> kgl_årsnetto_udøver_næring(kilde.næringsforhold) && kgl_årsnetto_fordring_erhvervet_udenfor_næring(kilde.næringsforhold) == Falskt
| kgl_årsnetto_fordring_omfattet_af_par17(kilde: KglÅrsnettoFordringskilde) -> kilde.erhvervelsesgrundlag == KglÅrsnettoVederlagINæring || kilde.erhvervelsesgrundlag == KglÅrsnettoTilknyttetErhvervsdrift
| kgl_årsnetto_fordring_tabstatus(kilde: KglÅrsnettoFordringskilde) -> KglFordringTabAlmindelig
| exception kgl_årsnetto_par15_manglende_oplysning kgl_årsnetto_fordring_tabstatus(kilde: KglÅrsnettoFordringskilde) -> KglFordringTabReguleretMarkedUdenOplysning under kgl_årsnetto_markedsnoteret(kilde.markedsfakta) && kgl_årsnetto_oplyst_rettidigt(kilde.markedsfakta) == Falskt
| exception kgl_årsnetto_par14_stk2_kontrol kgl_årsnetto_fordring_tabstatus(kilde: KglÅrsnettoFordringskilde) -> KglFordringTabKontrolEllerNærtstående under kilde.debitorrelation != KglÅrsnettoUafhængigDebitor
| exception kgl_årsnetto_par17_erhvervsfordring kgl_årsnetto_fordring_tabstatus(kilde: KglÅrsnettoFordringskilde) -> KglFordringTabPar17Statsskattelov6A under kgl_årsnetto_fordring_omfattet_af_par17(kilde)
| exception kgl_årsnetto_par18_dba kgl_årsnetto_fordring_tabstatus(kilde: KglÅrsnettoFordringskilde) -> KglFordringTabDbaAfskåret under kilde.dba_status == KglÅrsnettoRenterEllerGevinsterUndtagetEfterDba
| kgl_årsnetto_lagerprincip_gyldigt(kilde: KglÅrsnettoFordringskilde) -> kilde.opgørelsesprincip == KglRealisationsprincip || kilde.fordringsart == KglÅrsnettoObligation && kgl_årsnetto_markedsnoteret(kilde.markedsfakta)
| kgl_årsnetto_fordringskilde_gyldig(kilde: KglÅrsnettoFordringskilde) -> kgl_årsnetto_lagerprincip_gyldigt(kilde)
| kgl_årsnetto_fordring_i_par14_bagatelgrundlag(kilde: KglÅrsnettoFordringskilde) -> kgl_årsnetto_par1_afgrænsning(kilde) == KglPar1Omfattet && kgl_årsnetto_fordring_omfattet_af_par13(kilde) == Falskt && kgl_årsnetto_fordring_omfattet_af_par17(kilde) == Falskt
--@end:kursgevinstloven_årsnetto_afgrænsning--

= kursgevinstloven_årsnetto_opgørelse_metadata = Metadata(
    attachments = (
        Source(value = kursgevinstloven_lbk1176_årsnetto),
    )
)

--@label:kursgevinstloven_årsnetto_opgørelse::meta:kursgevinstloven_årsnetto_opgørelse_metadata--
----
§ 25. Gevinst og tab på fordringer og gæld, der skal medregnes ved opgørelsen af
den skattepligtige indkomst, medregnes i det indkomstår, hvori gevinsten eller
tabet realiseres (realisationsprincippet), jf. dog stk. 2-10, og § 22, stk. 1,
samt §§ 36 og 37.

Stk. 2. Skattepligtige omfattet af § 12 kan vælge at anvende lagerprincippet,
jf. § 33, stk. 1, ved opgørelsen af gevinst og tab på obligationer optaget til
handel på et reguleret marked og på gevinst og tab som følge af
valutakursændringer på fordringer og gæld i fremmed valuta. Valget træffes
samlet for henholdsvis obligationer optaget til handel på et reguleret marked
og valutakursændringer på fordringer og gæld i fremmed valuta. Ved anvendelse
af lagerprincippet, jf. 1. pkt., opgøres gevinst og tab på obligationer optaget
til handel på et reguleret marked på grundlag af valutakurserne på tidspunktet
for obligationens erhvervelse uden hensyn til ændringer i valutakurserne. Når
lagerprincippet er valgt, kan valget heraf kun ændres efter tilladelse fra
told- og skatteforvaltningen.

§ 26. Gevinst og tab på fordringer og gæld opgøres efter reglerne i stk. 2-5,
jf. dog § 25, stk. 2-5, om lagerprincippet og § 25, stk. 7-10.

Stk. 2. Gevinst eller tab på fordringer opgøres som forskellen mellem
anskaffelsessummen og afståelsessummen. Som anskaffelsessum anvendes kursværdien
på erhvervelsestidspunktet, medmindre den skattepligtige godtgør at have
erhvervet fordringen for et højere beløb.
----

--@begin:kursgevinstloven_årsnetto_opgørelse--
# KglÅrsnettoPositionPrimo = KglÅrsnettoIngenPositionPrimo | KglÅrsnettoVidereførtPositionPrimo(fra_indkomstår: Heltal, skattemæssig_værdi_kroner: Heltal)
# KglÅrsnettoPositionUltimo = KglÅrsnettoIngenPositionUltimo | KglÅrsnettoAktivPositionUltimo(indkomstår: Heltal, skattemæssig_værdi_kroner: Heltal)
# KglÅrsnettoHændelse = KglÅrsnettoAnskaffelse(anskaffelsessum_kroner: Heltal) | KglÅrsnettoAfståelse(afståelsessum_kroner: Heltal) | KglÅrsnettoUltimoværdi(værdi_kroner: Heltal)
# KglÅrsnettoHændelsesresultat(hændelse: KglÅrsnettoHændelse, hændelse_gyldig: Boolsk, rå_netto_kroner: Heltal, position_aktiv_efter: Boolsk, skattemæssig_værdi_efter_kroner: Heltal)
# KglÅrsnettoForløbstilstand(position_aktiv: Boolsk, skattemæssig_værdi_kroner: Heltal, anskaffet_i_indkomståret: Boolsk, afstået_i_indkomståret: Boolsk, ultimoværdi_angivet: Boolsk, har_opgørelse: Boolsk, opgørelsesgrundlag_kroner: Heltal, opgørelsesslutværdi_kroner: Heltal, rå_netto_kroner: Heltal, hændelsesresultater: List(KglÅrsnettoHændelsesresultat), alle_hændelser_gyldige: Boolsk)
# KglÅrsnettoForløbsresultat(indkomstår: Heltal, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), opgørelsesprincip: KursgevinstlovOpgørelsesprincip, hændelsesresultater: List(KglÅrsnettoHændelsesresultat), har_opgørelse: Boolsk, opgørelsesgrundlag_kroner: Heltal, opgørelsesslutværdi_kroner: Heltal, rå_netto_kroner: Heltal, position_ultimo: KglÅrsnettoPositionUltimo, input_gyldigt: Boolsk)

| kgl_årsnetto_position_primo_gyldig(position: KglÅrsnettoPositionPrimo, indkomstår: Heltal) -> match position { | KglÅrsnettoIngenPositionPrimo -> Sandt | KglÅrsnettoVidereførtPositionPrimo(fra_indkomstår, værdi) -> fra_indkomstår == indkomstår - 1 && værdi >= 0 }
| kgl_årsnetto_position_primo_aktiv(position: KglÅrsnettoPositionPrimo) -> match position { | KglÅrsnettoIngenPositionPrimo -> Falskt | KglÅrsnettoVidereførtPositionPrimo(_, _) -> Sandt }
| kgl_årsnetto_position_primo_værdi_kroner(position: KglÅrsnettoPositionPrimo) -> match position { | KglÅrsnettoIngenPositionPrimo -> 0 | KglÅrsnettoVidereførtPositionPrimo(_, værdi) -> værdi }
| kgl_årsnetto_hændelsesbeløb_kroner(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoAnskaffelse(beløb) -> beløb | KglÅrsnettoAfståelse(beløb) -> beløb | KglÅrsnettoUltimoværdi(beløb) -> beløb }
| kgl_årsnetto_hændelse_gyldig(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, princip: KursgevinstlovOpgørelsesprincip) -> kgl_årsnetto_hændelsesbeløb_kroner(hændelse) >= 0 && match hændelse {
    | KglÅrsnettoAnskaffelse(_) -> tilstand.position_aktiv == Falskt && tilstand.anskaffet_i_indkomståret == Falskt && tilstand.afstået_i_indkomståret == Falskt && tilstand.ultimoværdi_angivet == Falskt && tilstand.har_opgørelse == Falskt
    | KglÅrsnettoAfståelse(_) -> tilstand.position_aktiv && tilstand.afstået_i_indkomståret == Falskt && tilstand.ultimoværdi_angivet == Falskt && tilstand.har_opgørelse == Falskt
    | KglÅrsnettoUltimoværdi(_) -> tilstand.position_aktiv && princip == KglLagerprincip && tilstand.afstået_i_indkomståret == Falskt && tilstand.ultimoværdi_angivet == Falskt && tilstand.har_opgørelse == Falskt
}
| kgl_årsnetto_hændelse_er_opgørelse(hændelse: KglÅrsnettoHændelse) -> match hændelse { | KglÅrsnettoAnskaffelse(_) -> Falskt | _ -> Sandt }
| kgl_årsnetto_position_aktiv_efter(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, gyldig: Boolsk) -> hvis gyldig == Falskt { tilstand.position_aktiv } ellers { match hændelse { | KglÅrsnettoAnskaffelse(_) -> Sandt | KglÅrsnettoAfståelse(_) -> Falskt | KglÅrsnettoUltimoværdi(_) -> Sandt } }
| kgl_årsnetto_skattemæssig_værdi_efter_kroner(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, gyldig: Boolsk) -> hvis gyldig == Falskt { tilstand.skattemæssig_værdi_kroner } ellers { match hændelse { | KglÅrsnettoAnskaffelse(beløb) -> beløb | KglÅrsnettoAfståelse(_) -> 0 | KglÅrsnettoUltimoværdi(beløb) -> beløb } }
| kgl_årsnetto_hændelse_rå_netto_kroner(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, gyldig: Boolsk) -> hvis gyldig && kgl_årsnetto_hændelse_er_opgørelse(hændelse) { kgl_årsnetto_hændelsesbeløb_kroner(hændelse) - tilstand.skattemæssig_værdi_kroner } ellers { 0 }

# KglÅrsnettoHændelsessag(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, princip: KursgevinstlovOpgørelsesprincip) {
    | hændelse_gyldig() -> kgl_årsnetto_hændelse_gyldig(tilstand, hændelse, princip)
    | er_opgørelse() -> hændelse_gyldig() && kgl_årsnetto_hændelse_er_opgørelse(hændelse)
    | rå_netto_kroner() -> kgl_årsnetto_hændelse_rå_netto_kroner(tilstand, hændelse, hændelse_gyldig())
    | position_aktiv_efter() -> kgl_årsnetto_position_aktiv_efter(tilstand, hændelse, hændelse_gyldig())
    | skattemæssig_værdi_efter_kroner() -> kgl_årsnetto_skattemæssig_værdi_efter_kroner(tilstand, hændelse, hændelse_gyldig())
    | hændelsesresultat() -> KglÅrsnettoHændelsesresultat(hændelse = hændelse, hændelse_gyldig = hændelse_gyldig(), rå_netto_kroner = rå_netto_kroner(), position_aktiv_efter = position_aktiv_efter(), skattemæssig_værdi_efter_kroner = skattemæssig_værdi_efter_kroner())
    | næste_tilstand() -> KglÅrsnettoForløbstilstand(
        position_aktiv = position_aktiv_efter(),
        skattemæssig_værdi_kroner = skattemæssig_værdi_efter_kroner(),
        anskaffet_i_indkomståret = tilstand.anskaffet_i_indkomståret || hændelse_gyldig() && match hændelse { | KglÅrsnettoAnskaffelse(_) -> Sandt | _ -> Falskt },
        afstået_i_indkomståret = tilstand.afstået_i_indkomståret || hændelse_gyldig() && match hændelse { | KglÅrsnettoAfståelse(_) -> Sandt | _ -> Falskt },
        ultimoværdi_angivet = tilstand.ultimoværdi_angivet || hændelse_gyldig() && match hændelse { | KglÅrsnettoUltimoværdi(_) -> Sandt | _ -> Falskt },
        har_opgørelse = tilstand.har_opgørelse || er_opgørelse(),
        opgørelsesgrundlag_kroner = hvis er_opgørelse() { tilstand.skattemæssig_værdi_kroner } ellers { tilstand.opgørelsesgrundlag_kroner },
        opgørelsesslutværdi_kroner = hvis er_opgørelse() { kgl_årsnetto_hændelsesbeløb_kroner(hændelse) } ellers { tilstand.opgørelsesslutværdi_kroner },
        rå_netto_kroner = tilstand.rå_netto_kroner + rå_netto_kroner(),
        hændelsesresultater = concat(tilstand.hændelsesresultater, [hændelsesresultat()]),
        alle_hændelser_gyldige = tilstand.alle_hændelser_gyldige && hændelse_gyldig()
    )
}
| kgl_årsnetto_hændelsestrin(tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse, princip: KursgevinstlovOpgørelsesprincip) -> KglÅrsnettoHændelsessag(tilstand, hændelse, princip).næste_tilstand()

# KglÅrsnettoForløbssag(indkomstår: Heltal, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), princip: KursgevinstlovOpgørelsesprincip) {
    | starttilstand() -> KglÅrsnettoForløbstilstand(position_aktiv = kgl_årsnetto_position_primo_aktiv(position_primo), skattemæssig_værdi_kroner = kgl_årsnetto_position_primo_værdi_kroner(position_primo), anskaffet_i_indkomståret = Falskt, afstået_i_indkomståret = Falskt, ultimoværdi_angivet = Falskt, har_opgørelse = Falskt, opgørelsesgrundlag_kroner = 0, opgørelsesslutværdi_kroner = 0, rå_netto_kroner = 0, hændelsesresultater = [], alle_hændelser_gyldige = kgl_årsnetto_position_primo_gyldig(position_primo, indkomstår))
    | sluttilstand() -> foldl(hændelser, starttilstand(), |tilstand: KglÅrsnettoForløbstilstand, hændelse: KglÅrsnettoHændelse| kgl_årsnetto_hændelsestrin(tilstand, hændelse, princip))
    | har_position_eller_hændelse() -> kgl_årsnetto_position_primo_aktiv(position_primo) || length(hændelser) > 0
    | årsafslutning_gyldig() -> princip != KglLagerprincip || sluttilstand().position_aktiv == Falskt || sluttilstand().ultimoværdi_angivet
    | position_ultimo() -> hvis sluttilstand().position_aktiv { KglÅrsnettoAktivPositionUltimo(indkomstår = indkomstår, skattemæssig_værdi_kroner = sluttilstand().skattemæssig_værdi_kroner) } ellers { KglÅrsnettoIngenPositionUltimo }
    | input_gyldigt() -> indkomstår > 0 && har_position_eller_hændelse() && sluttilstand().alle_hændelser_gyldige && årsafslutning_gyldig()
    | resultat() -> KglÅrsnettoForløbsresultat(indkomstår = indkomstår, position_primo = position_primo, hændelser = hændelser, opgørelsesprincip = princip, hændelsesresultater = sluttilstand().hændelsesresultater, har_opgørelse = sluttilstand().har_opgørelse, opgørelsesgrundlag_kroner = sluttilstand().opgørelsesgrundlag_kroner, opgørelsesslutværdi_kroner = sluttilstand().opgørelsesslutværdi_kroner, rå_netto_kroner = sluttilstand().rå_netto_kroner, position_ultimo = position_ultimo(), input_gyldigt = input_gyldigt())
}
| kgl_årsnetto_forløbsresultat(indkomstår: Heltal, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse), princip: KursgevinstlovOpgørelsesprincip) -> KglÅrsnettoForløbssag(indkomstår, position_primo, hændelser, princip).resultat()
--@end:kursgevinstloven_årsnetto_opgørelse--

= aktieavancebeskatningsloven_lbk1098_par22_årsnetto = KursgevinstlovÅrsnettoKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1098",
    identifier = "LBK nr. 1098 af 27/08/2025: Aktieavancebeskatningslovens § 22",
    hentet_dato = "2026-08-03"
)

= kursgevinstloven_årsnetto_abl22_metadata = Metadata(
    attachments = (
        DependencySource(value = aktieavancebeskatningsloven_lbk1098_par22_årsnetto),
    )
)

--@label:kursgevinstloven_årsnetto_abl22::meta:kursgevinstloven_årsnetto_abl22_metadata--
----
§ 22.
Gevinst og tab ved afståelse af omsættelige beviser for indskud i
investeringsinstitutter med minimumsbeskatning, jf. ligningslovens § 16 C,
stk. 1, der er obligationsbaserede, jf. stk. 2-5, medregnes ved opgørelsen af
den skattepligtige indkomst. 1. pkt. finder dog alene anvendelse, hvis årets
nettogevinst eller nettotab sammenlagt med nettogevinster og nettotab på
fordringer og gæld omfattet af kursgevinstlovens §§ 14 og 23 overstiger
2.000 kr. Reglerne i § 14 finder tilsvarende anvendelse.

Stk. 2. Et investeringsinstitut med minimumsbeskatning er obligationsbaseret,
medmindre investeringsinstituttet opfylder betingelserne i § 21, stk. 2.

Stk. 3. Ved opgørelse af, om anbringelserne overholder betingelsen i stk. 2,
medregnes aktiver som nævnt i kursgevinstlovens §§ 29-33 med værdien af det
underliggende aktiv.

Stk. 4. Hvis investeringsinstituttets anbringelser ikke overholder betingelsen i
stk. 2, anses instituttet for at have skiftet skattemæssig status til et
aktiebaseret investeringsinstitut med minimumsbeskatning, jf. § 33 og
selskabsskattelovens § 5 F, og reglerne i § 21 finder anvendelse.

Stk. 5. Investeringsinstituttet skal indsende oplysninger til told- og
skatteforvaltningen til vurdering af, om anbringelsesgrænsen i stk. 2 er
overholdt. Oplysningerne skal indsendes senest samtidig med oplysninger til
bedømmelse af, om investeringsinstituttet overholder betingelserne for at være
et investeringsinstitut med minimumsbeskatning. Hvis anbringelsesgrænsen ikke er
overholdt, skal investeringsinstituttet offentliggøre dette.

Stk. 6. I tilfælde, der er omfattet af stk. 1, finder reglerne i §§ 5 A, 12,
13 A, 19 B, 19 C og 44 ikke anvendelse. Stk. 1 finder ikke anvendelse i de i
§ 17 nævnte tilfælde.
----

--@begin:kursgevinstloven_årsnetto_abl22--
# KglÅrsnettoFordringsforløb(identifikation: Tekst, kilde: KglÅrsnettoFordringskilde, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse))
# KglÅrsnettoAbl22Kilde(klassifikation: AktieavancePar21Par22Input, par17_modprøve: AktieavancePar17Modprøve)
# KglÅrsnettoAbl22Forløb(identifikation: Tekst, kilde: KglÅrsnettoAbl22Kilde, position_primo: KglÅrsnettoPositionPrimo, hændelser: List(KglÅrsnettoHændelse))
# KursgevinstlovÅrsnettoInput(fordringer: List(KglÅrsnettoFordringsforløb), obligationsbaserede_minimumsbeviser: List(KglÅrsnettoAbl22Forløb))
# KglÅrsnettoFordringsresultat(fakta: KglÅrsnettoFordringsforløb, forløb: KglÅrsnettoForløbsresultat, kilde_gyldig: Boolsk, omfattet_af_par14_bagatelgrundlag: Boolsk, kursgevinstlov_input: KursgevinstlovInput, kursgevinstlov_resultat: KursgevinstlovResultat, input_gyldigt: Boolsk)
# KglÅrsnettoAbl22Resultat(fakta: KglÅrsnettoAbl22Forløb, forløb: KglÅrsnettoForløbsresultat, klassifikationsresultat: AktieavancePar21Par22Resultat, effektivt_obligationsbaseret_efter_par22: Boolsk, omfattet_af_par22_bagatelgrundlag: Boolsk, aktieavancebeskatningslov_input: AktieavancebeskatningslovInput, aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat, input_gyldigt: Boolsk)
# KursgevinstlovÅrsnettoResultat(input: KursgevinstlovÅrsnettoInput, input_gyldigt: Boolsk, rå_netto_til_par14_og_abl22_kroner: Heltal, fordringsresultater: List(KglÅrsnettoFordringsresultat), obligationsbevisresultater: List(KglÅrsnettoAbl22Resultat), kursgevinstlov_resultater: List(KursgevinstlovResultat), aktieavancebeskatningslov_resultater: List(AktieavancebeskatningslovResultat))

| kgl_årsnetto_tomt_input() -> KursgevinstlovÅrsnettoInput(fordringer = [], obligationsbaserede_minimumsbeviser = [])
| kgl_årsnetto_fordringsforløbsresultat(fakta: KglÅrsnettoFordringsforløb, indkomstår: Heltal) -> kgl_årsnetto_forløbsresultat(indkomstår, fakta.position_primo, fakta.hændelser, fakta.kilde.opgørelsesprincip)
| kgl_årsnetto_fordringsinput(fakta: KglÅrsnettoFordringsforløb, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = forløb = kgl_årsnetto_fordringsforløbsresultat(fakta, indkomstår)
    KursgevinstlovInput(
        indkomstår = indkomstår,
        rolle = KglPersonEfterKildeskatteloven,
        aktiv = KglFordring,
        par1_afgrænsning = kgl_årsnetto_par1_afgrænsning(fakta.kilde),
        bagatelgrundlag = KursgevinstlovBagatelOpgørelse(årets_netto_fordringer_valutagæld_investbeviser_kroner = årets_samlede_netto_kroner),
        fordring = KursgevinstlovFordringOpgørelse(tab_status = kgl_årsnetto_fordring_tabstatus(fakta.kilde), anskaffelsessum_kroner = forløb.opgørelsesgrundlag_kroner, afståelsessum_kroner = forløb.opgørelsesslutværdi_kroner),
        gæld = kgl_tom_gæld(),
        kontrakt = kgl_tom_kontrakt(),
        udøver_fordrings_eller_kontraktnæring = kgl_årsnetto_udøver_næring(fakta.kilde.næringsforhold),
        fordring_erhvervet_udenfor_næring = kgl_årsnetto_fordring_erhvervet_udenfor_næring(fakta.kilde.næringsforhold),
        anvender_lagerprincip_efter_par25 = fakta.kilde.opgørelsesprincip == KglLagerprincip
    )
}
| kgl_årsnetto_fordringsresultat(fakta: KglÅrsnettoFordringsforløb, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = forløb = kgl_årsnetto_fordringsforløbsresultat(fakta, indkomstår)
    = kilde_gyldig = kgl_årsnetto_fordringskilde_gyldig(fakta.kilde)
    = kgl_input = kgl_årsnetto_fordringsinput(fakta, indkomstår, årets_samlede_netto_kroner)
    KglÅrsnettoFordringsresultat(
        fakta = fakta,
        forløb = forløb,
        kilde_gyldig = kilde_gyldig,
        omfattet_af_par14_bagatelgrundlag = kgl_årsnetto_fordring_i_par14_bagatelgrundlag(fakta.kilde),
        kursgevinstlov_input = kgl_input,
        kursgevinstlov_resultat = kursgevinstlov_resultat(kgl_input),
        input_gyldigt = fakta.identifikation != "" && kilde_gyldig && forløb.input_gyldigt
    )
}
| kgl_årsnetto_fordring_rå_netto_kroner(fakta: KglÅrsnettoFordringsforløb, indkomstår: Heltal) -> {
    = resultat = kgl_årsnetto_fordringsresultat(fakta, indkomstår, 0)
    hvis resultat.input_gyldigt && resultat.forløb.har_opgørelse && resultat.omfattet_af_par14_bagatelgrundlag { resultat.forløb.rå_netto_kroner } ellers { 0 }
}

| kgl_årsnetto_abl22_forløbsresultat(fakta: KglÅrsnettoAbl22Forløb, indkomstår: Heltal) -> kgl_årsnetto_forløbsresultat(indkomstår, fakta.position_primo, fakta.hændelser, KglRealisationsprincip)
| kgl_årsnetto_abl22_klassifikationsresultat(fakta: KglÅrsnettoAbl22Forløb) -> aktieavance_par21_par22_resultat(fakta.kilde.klassifikation)
| kgl_årsnetto_abl22_effektivt_obligationsbaseret(fakta: KglÅrsnettoAbl22Forløb) -> kgl_årsnetto_abl22_klassifikationsresultat(fakta).input_gyldigt && kgl_årsnetto_abl22_klassifikationsresultat(fakta).effektiv_status == AblObligationsbaseretMinimumsinstitutEfterPar22
| kgl_årsnetto_abl22_omfattet_af_bagatelgrundlag(fakta: KglÅrsnettoAbl22Forløb) -> kgl_årsnetto_abl22_effektivt_obligationsbaseret(fakta) && aktieavance_par17_modprøve_stk3_omfattet(fakta.kilde.par17_modprøve) == Falskt
| kgl_årsnetto_abl22_input(fakta: KglÅrsnettoAbl22Forløb, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = forløb = kgl_årsnetto_abl22_forløbsresultat(fakta, indkomstår)
    AktieavancebeskatningslovInput(
        indkomstår = indkomstår,
        aktiv = AblMinimumsinstitutTilKlassifikation,
        afståelsessum_kroner = forløb.opgørelsesslutværdi_kroner,
        anskaffelsessum_kroner = forløb.opgørelsesgrundlag_kroner,
        par17_modprøve = fakta.kilde.par17_modprøve,
        koncernintern_konvertibel_eller_tegningsret = Falskt,
        andelsforening_stiftet_før_22_maj_1987 = Falskt,
        afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
        investeringsklassifikation = AblPar21Par22Klassifikation(input = fakta.kilde.klassifikation),
        årets_netto_med_kgl_par14_23_kroner = årets_samlede_netto_kroner
    )
}
| kgl_årsnetto_abl22_resultat(fakta: KglÅrsnettoAbl22Forløb, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> {
    = forløb = kgl_årsnetto_abl22_forløbsresultat(fakta, indkomstår)
    = klassifikation = kgl_årsnetto_abl22_klassifikationsresultat(fakta)
    = abl_input = kgl_årsnetto_abl22_input(fakta, indkomstår, årets_samlede_netto_kroner)
    = effektivt_obligationsbaseret = kgl_årsnetto_abl22_effektivt_obligationsbaseret(fakta)
    KglÅrsnettoAbl22Resultat(
        fakta = fakta,
        forløb = forløb,
        klassifikationsresultat = klassifikation,
        effektivt_obligationsbaseret_efter_par22 = effektivt_obligationsbaseret,
        omfattet_af_par22_bagatelgrundlag = kgl_årsnetto_abl22_omfattet_af_bagatelgrundlag(fakta),
        aktieavancebeskatningslov_input = abl_input,
        aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat(abl_input),
        input_gyldigt = fakta.identifikation != "" && fakta.kilde.klassifikation.indkomstår == indkomstår && klassifikation.input_gyldigt && effektivt_obligationsbaseret && forløb.input_gyldigt
    )
}
| kgl_årsnetto_abl22_rå_netto_kroner(fakta: KglÅrsnettoAbl22Forløb, indkomstår: Heltal) -> {
    = resultat = kgl_årsnetto_abl22_resultat(fakta, indkomstår, 0)
    hvis resultat.input_gyldigt && resultat.forløb.har_opgørelse && resultat.omfattet_af_par22_bagatelgrundlag { resultat.forløb.rå_netto_kroner } ellers { 0 }
}

| kgl_årsnetto_identifikationer(input: KursgevinstlovÅrsnettoInput) -> concat(map(input.fordringer, |fakta: KglÅrsnettoFordringsforløb| fakta.identifikation), map(input.obligationsbaserede_minimumsbeviser, |fakta: KglÅrsnettoAbl22Forløb| fakta.identifikation))
| kgl_årsnetto_identifikationer_unikke(input: KursgevinstlovÅrsnettoInput) -> all(kgl_årsnetto_identifikationer(input), |identifikation: Tekst| identifikation != "" && length(filter(kgl_årsnetto_identifikationer(input), |anden: Tekst| anden == identifikation)) == 1)
| kgl_årsnetto_rå_netto_kroner(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal) -> foldl(input.fordringer, foldl(input.obligationsbaserede_minimumsbeviser, 0, |sum: Heltal, fakta: KglÅrsnettoAbl22Forløb| sum + kgl_årsnetto_abl22_rå_netto_kroner(fakta, indkomstår)), |sum: Heltal, fakta: KglÅrsnettoFordringsforløb| sum + kgl_årsnetto_fordring_rå_netto_kroner(fakta, indkomstår))
| kgl_årsnetto_fordringsresultater(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> map(input.fordringer, |fakta: KglÅrsnettoFordringsforløb| kgl_årsnetto_fordringsresultat(fakta, indkomstår, årets_samlede_netto_kroner))
| kgl_årsnetto_abl22_resultater(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> map(input.obligationsbaserede_minimumsbeviser, |fakta: KglÅrsnettoAbl22Forløb| kgl_årsnetto_abl22_resultat(fakta, indkomstår, årets_samlede_netto_kroner))
| kgl_årsnetto_alle_fordringsresultater_gyldige(resultater: List(KglÅrsnettoFordringsresultat)) -> all(resultater, |resultat: KglÅrsnettoFordringsresultat| resultat.input_gyldigt)
| kgl_årsnetto_alle_abl22_resultater_gyldige(resultater: List(KglÅrsnettoAbl22Resultat)) -> all(resultater, |resultat: KglÅrsnettoAbl22Resultat| resultat.input_gyldigt)
| kgl_årsnetto_kursgevinstlov_resultater(resultater: List(KglÅrsnettoFordringsresultat)) -> flat_map(resultater, |resultat: KglÅrsnettoFordringsresultat| hvis resultat.input_gyldigt && resultat.forløb.har_opgørelse { [resultat.kursgevinstlov_resultat] } ellers { [] })
| kgl_årsnetto_aktieavancebeskatningslov_resultater(resultater: List(KglÅrsnettoAbl22Resultat)) -> flat_map(resultater, |resultat: KglÅrsnettoAbl22Resultat| hvis resultat.input_gyldigt && resultat.forløb.har_opgørelse { [resultat.aktieavancebeskatningslov_resultat] } ellers { [] })

# KursgevinstlovÅrsnettoSag(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) {
    | fordringsresultater() -> kgl_årsnetto_fordringsresultater(input, indkomstår, årets_samlede_netto_kroner)
    | obligationsbevisresultater() -> kgl_årsnetto_abl22_resultater(input, indkomstår, årets_samlede_netto_kroner)
    | input_gyldigt() -> indkomstår > 0 && kgl_årsnetto_identifikationer_unikke(input) && kgl_årsnetto_alle_fordringsresultater_gyldige(fordringsresultater()) && kgl_årsnetto_alle_abl22_resultater_gyldige(obligationsbevisresultater())
    | kursgevinstlov_resultater() -> hvis input_gyldigt() { kgl_årsnetto_kursgevinstlov_resultater(fordringsresultater()) } ellers { [] }
    | aktieavancebeskatningslov_resultater() -> hvis input_gyldigt() { kgl_årsnetto_aktieavancebeskatningslov_resultater(obligationsbevisresultater()) } ellers { [] }
    | resultat() -> KursgevinstlovÅrsnettoResultat(
        input = input,
        input_gyldigt = input_gyldigt(),
        rå_netto_til_par14_og_abl22_kroner = kgl_årsnetto_rå_netto_kroner(input, indkomstår),
        fordringsresultater = fordringsresultater(),
        obligationsbevisresultater = obligationsbevisresultater(),
        kursgevinstlov_resultater = kursgevinstlov_resultater(),
        aktieavancebeskatningslov_resultater = aktieavancebeskatningslov_resultater()
    )
}
| kursgevinstlov_årsnetto_resultat(input: KursgevinstlovÅrsnettoInput, indkomstår: Heltal, årets_samlede_netto_kroner: Heltal) -> KursgevinstlovÅrsnettoSag(input, indkomstår, årets_samlede_netto_kroner).resultat()
--@end:kursgevinstloven_årsnetto_abl22--
