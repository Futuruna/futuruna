# EjendomsavancePar4Anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag | EblPar4Stk3Nr1Anskaffelsesgrundlag | EblPar4Stk3Nr2Anskaffelsesgrundlag | EblPar4DagældendeVurderingslov4BAnskaffelsesgrundlag | EblPar4Stk3TredjePktAnskaffelsesgrundlag(tab_efter_ejendomsværdi_par4_stk3_nr1_eller_2_kroner: Heltal) | EblPar4Stk3FemtePktUdenlandskHandelsværdiAnskaffelsesgrundlag | EblPar4Stk3SjettePktUdenlandskFaktiskAnskaffelsesgrundlag
# EblPar5Udgiftsstatus = EblPar5UdgiftMedregningsberettiget | EblPar5UdgiftKunStandardfradragEfterTidligereLigningslov15J | EblPar5UdgiftFradragsberettiget | EblPar5UdgiftStraksfradragetEllerStraksafskrevet | EblPar5UdgiftFredetBygningMedFremtidigtFradrag | EblPar5UdgiftModsvaretAfSkattefritTilskud | EblPar5UdgiftFradragetEfterTidligereLigningslov15N | EblPar5UdgiftLigningslov16TillagtBeregningsgrundlag | EblPar5UdgiftLigningslov16IkkeTillagtBeregningsgrundlag | EblPar5UdgiftEfterSenesteLigningslov16Omfattelse | EblPar5UdgiftFredetBygningUdenIndkomstfradrag
# EblPar5Udgift(afholdelsesdato: EblDato, fuldførelsesår: Heltal, beløb_for_afstået_del_kroner: Heltal, status: EblPar5Udgiftsstatus)
# EblPar5Nedsættelsesgrund = EblPar5Stk4Nr1AfskrivningIkkeBeskattetSomGenvunden | EblPar5Stk4Nr1AfskrivningBeskattetSomGenvunden | EblPar5Stk4Nr2NedrevetBygningEllerInstallation | EblPar5Stk4Nr3TabEllerVærdiforringelse | EblPar5Stk4Nr4RåstofEllerJordværdiforringelse | EblPar5Stk4Nr5DræningEllerMarkvanding
