# EblPar5Stk6Fakta(ejendomskategori: EblPar5Stk6Ejendomskategori, tillægsparcelværdi_kroner: Heltal, teknisk_værdi_kroner: Heltal, afskrivninger_på_vurderingsomfattede_bygninger_kroner: Heltal, stk4_nr2_afskrivninger_på_vurderingsomfattede_nedrevne_bygninger_kroner: Heltal, nedskrevet_værdi_af_vurderingsomfattede_bygninger_kroner: Heltal, afstået_jord_anskaffelsessum_før_overførsel_kroner: Heltal, samlet_jord_anskaffelsessum_før_overførsel_kroner: Heltal)
# EblPar5Stk6Overførsel = EblPar5UdenStk6Overførsel | EblPar5MedStk6Overførsel(fakta: EblPar5Stk6Fakta)
# EblPar5Stk6Resultat(forhold: EblPar5Stk6Overførsel, input_gyldigt: Boolsk, betingelser_opfyldt: Boolsk, højeste_vurderingsværdi_kroner: Heltal, vurderingsomfattede_nedsættelser_kroner: Heltal, overførselsberettiget_beløb_for_hele_ejendommen_kroner: Heltal, skattepligtiges_overførselsberettigede_beløb_kroner: Heltal, overført_til_afstået_jord_kroner: Heltal, reguleret_overførsel_efter_par5a_kroner: Heltal, restejendommens_anskaffelsessum_nedsættes_kroner: Heltal)
# EblPar5AIndekseringskategori = EblPar5ALandbrugsejendom | EblPar5ASkovejendom | EblPar5ANaturejendom
# EblPar5Reguleringsvalg = EblPar5UdenIndeksering | EblPar5AMedIndeksering(kategori: EblPar5AIndekseringskategori)
# EblPar5Fakta(anskaffelsesdato: EblDato, anskaffelsesgrundlag: EjendomsavancePar4Anskaffelsesgrundlag, fordeling: EblPar5Fordeling, vedligeholdelses_og_forbedringsudgifter: List(EblPar5Udgift), nedsættelser: List(EblPar5Nedsættelse), mælkekvoter: List(EblPar5MælkekvoteFakta), stk6_overførsel: EblPar5Stk6Overførsel, reguleringsvalg: EblPar5Reguleringsvalg)
# EblPar5ÅrsudgiftResultat(indkomstår: Heltal, medregningsberettigede_udgifter_kroner: Heltal, årlig_grænse_kroner: Heltal, tillæg_efter_stk2_kroner: Heltal, reguleret_tillæg_efter_par5a_kroner: Heltal)
# EblPar5Nedsættelsesresultat(nedsættelse: EblPar5Nedsættelse, nedsættelse_efter_stk4_til_8_kroner: Heltal, reguleret_nedsættelse_efter_par5a_kroner: Heltal)
# EblPar5Resultat(fakta: EblPar5Fakta, afståelsesdato: EblDato, anskaffelsessum_før_par5_kroner: Heltal, input_gyldigt: Boolsk, regelgrundlag_understøttet: Boolsk, beregning_anvendt: Boolsk, indeksering_anvendt: Boolsk, reguleringsprocent_tiendedele: Heltal, tillægsår: List(Heltal), fast_tillæg_efter_stk1_kroner: Heltal, reguleret_fast_tillæg_efter_par5a_kroner: Heltal, årsudgift_resultater: List(EblPar5ÅrsudgiftResultat), vedligeholdelses_og_forbedringstillæg_efter_stk2_kroner: Heltal, reguleret_vedligeholdelses_og_forbedringstillæg_efter_par5a_kroner: Heltal, mælkekvote_resultater: List(EblPar5MælkekvoteResultat), mælkekvoteforhøjelse_efter_stk3_kroner: Heltal, reguleret_mælkekvoteforhøjelse_efter_par5a_kroner: Heltal, stk6_resultat: EblPar5Stk6Resultat, stk6_overført_til_afstået_jord_kroner: Heltal, reguleret_stk6_overførsel_efter_par5a_kroner: Heltal, nedsættelsesresultater: List(EblPar5Nedsættelsesresultat), nedsættelser_efter_stk4_til_8_kroner: Heltal, regulerede_nedsættelser_efter_par5a_kroner: Heltal, reguleret_anskaffelsessum_kroner: Heltal, regulering_efter_par5_og_par5a_kroner: Heltal)

| ebl_dato_skudår(år: Heltal) -> år % 400 == 0 || år % 4 == 0 && år % 100 != 0
| ebl_dato_dage_i_måned(år: Heltal, måned: Heltal) -> match måned {
    | 1 -> 31
    | 2 -> hvis ebl_dato_skudår(år) { 29 } ellers { 28 }
    | 3 -> 31
    | 4 -> 30
    | 5 -> 31
    | 6 -> 30
    | 7 -> 31
    | 8 -> 31
    | 9 -> 30
    | 10 -> 31
    | 11 -> 30
    | 12 -> 31
    | _ -> 0
}
| ebl_dato_gyldig(dato: EblDato) -> dato.år > 0 && dato.måned >= 1 && dato.måned <= 12 && dato.dag >= 1 && dato.dag <= ebl_dato_dage_i_måned(dato.år, dato.måned)
| ebl_dato_yyyymmdd(dato: EblDato) -> dato.år * 10000 + dato.måned * 100 + dato.dag
| ebl_dato_før_eller_lig_med(venstre: EblDato, højre: EblDato) -> ebl_dato_yyyymmdd(venstre) <= ebl_dato_yyyymmdd(højre)
| ebl_dato_plus_et_år(dato: EblDato) -> EblDato(
    år = dato.år + 1,
    måned = dato.måned,
    dag = hvis dato.måned == 2 && dato.dag == 29 && ebl_dato_skudår(dato.år + 1) == Falskt { 28 } ellers { dato.dag }
)

| ebl_par4_anskaffelsesgrundlag_er_stk3(grundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> grundlag != EblPar4AlmindeligtAnskaffelsesgrundlag
| ebl_par4_anskaffelsesgrundlag_gyldigt(grundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> match grundlag {
    | EblPar4Stk3TredjePktAnskaffelsesgrundlag(tab_efter_ejendomsværdi_par4_stk3_nr1_eller_2_kroner) -> tab_efter_ejendomsværdi_par4_stk3_nr1_eller_2_kroner >= 0
    | _ -> Sandt
}
| ebl_par5_afståelsesomfang_gyldigt(omfang: EblPar5Afståelsesomfang) -> match omfang {
    | EblPar5HeleEjendommen -> Sandt
    | EblPar5DelAfEjendommen(afstået_del_anskaffelsessum_før_par5_kroner, hele_ejendommens_anskaffelsessum_før_par5_kroner, ikke_boligdelens_anskaffelsessum_før_par5_kroner) -> afstået_del_anskaffelsessum_før_par5_kroner > 0 && hele_ejendommens_anskaffelsessum_før_par5_kroner > 0 && afstået_del_anskaffelsessum_før_par5_kroner <= hele_ejendommens_anskaffelsessum_før_par5_kroner && match ikke_boligdelens_anskaffelsessum_før_par5_kroner {
        | None -> Sandt
        | Some(ikke_boligdel_kroner) -> ikke_boligdel_kroner > 0 && afstået_del_anskaffelsessum_før_par5_kroner <= ikke_boligdel_kroner && ikke_boligdel_kroner <= hele_ejendommens_anskaffelsessum_før_par5_kroner
    }
}
| ebl_par5_fordeling_gyldig(fordeling: EblPar5Fordeling) -> fordeling.ejerandel_promille > 0 && fordeling.ejerandel_promille <= 1000 && ebl_par5_afståelsesomfang_gyldigt(fordeling.afståelsesomfang)
| ebl_par5_delafståelse(fordeling: EblPar5Fordeling) -> match fordeling.afståelsesomfang {
    | EblPar5DelAfEjendommen(_, _, _) -> Sandt
    | _ -> Falskt
}
| ebl_par5_fordel_på_afstået_del_kroner(fordeling: EblPar5Fordeling, beløb_kroner: Heltal) -> match fordeling.afståelsesomfang {
    | EblPar5HeleEjendommen -> penge_positivt_beløb(beløb_kroner)
    | EblPar5DelAfEjendommen(afstået_del_anskaffelsessum_før_par5_kroner, hele_ejendommens_anskaffelsessum_før_par5_kroner, _) -> penge_positivt_beløb(beløb_kroner) * afstået_del_anskaffelsessum_før_par5_kroner / hele_ejendommens_anskaffelsessum_før_par5_kroner
}
| ebl_par5_fordel_mælkekvote_på_afstået_del_kroner(fordeling: EblPar5Fordeling, beløb_kroner: Heltal) -> match fordeling.afståelsesomfang {
    | EblPar5HeleEjendommen -> penge_positivt_beløb(beløb_kroner)
    | EblPar5DelAfEjendommen(afstået_del_anskaffelsessum_før_par5_kroner, _, Some(ikke_boligdelens_anskaffelsessum_før_par5_kroner)) -> penge_positivt_beløb(beløb_kroner) * afstået_del_anskaffelsessum_før_par5_kroner / ikke_boligdelens_anskaffelsessum_før_par5_kroner
    | EblPar5DelAfEjendommen(_, _, None) -> 0
}
| ebl_par5_mælkekvote_fordelingsgrundlag_tilgængeligt(fordeling: EblPar5Fordeling) -> match fordeling.afståelsesomfang {
    | EblPar5HeleEjendommen -> Sandt
    | EblPar5DelAfEjendommen(_, _, Some(_)) -> Sandt
    | EblPar5DelAfEjendommen(_, _, None) -> Falskt
}
| ebl_par5_fordel_ejerandel_kroner(fordeling: EblPar5Fordeling, beløb_kroner: Heltal) -> penge_positivt_beløb(beløb_kroner) * fordeling.ejerandel_promille / 1000
| ebl_par5_første_tillægsår(fakta: EblPar5Fakta) -> hvis ebl_par4_anskaffelsesgrundlag_er_stk3(fakta.anskaffelsesgrundlag) { 1993 } ellers { fakta.anskaffelsesdato.år }
| ebl_par5_sidste_tillægsår(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> hvis fakta.anskaffelsesdato.år == afståelsesdato.år { afståelsesdato.år } ellers { afståelsesdato.år - 1 }
| ebl_par5_tillægsår(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> hvis ebl_par5_første_tillægsår(fakta) <= ebl_par5_sidste_tillægsår(fakta, afståelsesdato) { range(ebl_par5_første_tillægsår(fakta), ebl_par5_sidste_tillægsår(fakta, afståelsesdato) + 1) } ellers { [] }
| ebl_par5_årligt_tillæg_kroner(fakta: EblPar5Fakta) -> ebl_par5_fordel_på_afstået_del_kroner(fakta.fordeling, ebl_par5_fordel_ejerandel_kroner(fakta.fordeling, 10000))
| ebl_par5_fast_tillæg_efter_stk1_kroner(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> length(ebl_par5_tillægsår(fakta, afståelsesdato)) * ebl_par5_årligt_tillæg_kroner(fakta)

| ebl_par5_udgiftsstatus_medregningsberettiget(status: EblPar5Udgiftsstatus) -> match status {
    | EblPar5UdgiftMedregningsberettiget -> Sandt
    | EblPar5UdgiftKunStandardfradragEfterTidligereLigningslov15J -> Sandt
    | EblPar5UdgiftLigningslov16TillagtBeregningsgrundlag -> Sandt
    | EblPar5UdgiftEfterSenesteLigningslov16Omfattelse -> Sandt
    | EblPar5UdgiftFredetBygningUdenIndkomstfradrag -> Sandt
    | _ -> Falskt
}
| ebl_par5_udgift_efter_startdato(fakta: EblPar5Fakta, udgift: EblPar5Udgift) -> match fakta.anskaffelsesgrundlag {
    | EblPar4DagældendeVurderingslov4BAnskaffelsesgrundlag -> ebl_dato_yyyymmdd(udgift.afholdelsesdato) > 19930519
    | EblPar4Stk3FemtePktUdenlandskHandelsværdiAnskaffelsesgrundlag -> ebl_dato_yyyymmdd(udgift.afholdelsesdato) > 19930519
    | EblPar4AlmindeligtAnskaffelsesgrundlag -> ebl_dato_før_eller_lig_med(fakta.anskaffelsesdato, udgift.afholdelsesdato)
    | _ -> ebl_dato_yyyymmdd(udgift.afholdelsesdato) >= 19930101
}
| ebl_par5_udgift_medregningsberettiget(fakta: EblPar5Fakta, udgift: EblPar5Udgift, afståelsesdato: EblDato) -> ebl_dato_gyldig(udgift.afholdelsesdato) && ebl_par5_udgift_efter_startdato(fakta, udgift) && ebl_dato_før_eller_lig_med(udgift.afholdelsesdato, afståelsesdato) && ebl_par5_udgiftsstatus_medregningsberettiget(udgift.status)
| ebl_par5_medregningsberettigede_udgifter(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> filter(fakta.vedligeholdelses_og_forbedringsudgifter, |udgift: EblPar5Udgift| ebl_par5_udgift_medregningsberettiget(fakta, udgift, afståelsesdato))
| ebl_par5_udgiftsår(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> distinct(map(ebl_par5_medregningsberettigede_udgifter(fakta, afståelsesdato), |udgift: EblPar5Udgift| udgift.afholdelsesdato.år))
| ebl_par5_udgifter_for_år_kroner(fakta: EblPar5Fakta, afståelsesdato: EblDato, indkomstår: Heltal) -> foldl(ebl_par5_medregningsberettigede_udgifter(fakta, afståelsesdato), 0, |sum: Heltal, udgift: EblPar5Udgift| sum + hvis udgift.afholdelsesdato.år == indkomstår { penge_positivt_beløb(udgift.beløb_for_afstået_del_kroner) } ellers { 0 })
| ebl_par5_årsudgift_tillæg_kroner(fakta: EblPar5Fakta, afståelsesdato: EblDato, indkomstår: Heltal) -> penge_positivt_beløb(ebl_par5_udgifter_for_år_kroner(fakta, afståelsesdato, indkomstår) - ebl_par5_årligt_tillæg_kroner(fakta))

| ebl_par5_nedsættelse_medregnes(nedsættelse: EblPar5Nedsættelse) -> nedsættelse.grund != EblPar5Stk4Nr1AfskrivningBeskattetSomGenvunden
| ebl_par5_nedsættelse_efter_stk4_til_8_kroner(fakta: EblPar5Fakta, nedsættelse: EblPar5Nedsættelse) -> hvis ebl_par5_nedsættelse_medregnes(nedsættelse) && (ebl_par4_anskaffelsesgrundlag_er_stk3(fakta.anskaffelsesgrundlag) == Falskt || nedsættelse.indkomstår >= 1993) { penge_positivt_beløb(nedsættelse.beløb_for_afstået_del_kroner) } ellers { 0 }

| ebl_par5_mælkekvote_anskaffelsesgrundlag_kroner(grundlag: EblPar5MælkekvoteAnskaffelsesgrundlag) -> match grundlag {
    | EblPar5MælkekvoteKøbt(vederlag_kroner) -> penge_positivt_beløb(vederlag_kroner)
    | EblPar5MælkekvoteVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner) -> penge_positivt_beløb(beskattet_værdi_ved_tildeling_kroner)
}
| ebl_par5_mælkekvote_anskaffelsesgrundlag_gyldigt(grundlag: EblPar5MælkekvoteAnskaffelsesgrundlag) -> match grundlag {
    | EblPar5MælkekvoteKøbt(vederlag_kroner) -> vederlag_kroner > 0
    | EblPar5MælkekvoteVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner) -> beskattet_værdi_ved_tildeling_kroner >= 0
}
| ebl_par5_mælkekvote_dispositionsdato(disposition: EblPar5MælkekvoteDisposition) -> match disposition {
    | EblPar5MælkekvoteAfstået(afståelsesdato, _) -> afståelsesdato
    | EblPar5MælkekvoteUdløbet(udløbsdato) -> udløbsdato
    | EblPar5MælkekvoteToldetUdenErstatning(toldningsdato) -> toldningsdato
}
| ebl_par5_mælkekvote_afståelsesvederlag_kroner(disposition: EblPar5MælkekvoteDisposition) -> match disposition {
    | EblPar5MælkekvoteAfstået(_, vederlag_kroner) -> penge_positivt_beløb(vederlag_kroner)
    | _ -> 0
}
| ebl_par5_mælkekvote_toldet(disposition: EblPar5MælkekvoteDisposition) -> match disposition {
    | EblPar5MælkekvoteToldetUdenErstatning(_) -> Sandt
    | _ -> Falskt
}
| ebl_par5_mælkekvote_disposition_gyldig(disposition: EblPar5MælkekvoteDisposition) -> ebl_dato_gyldig(ebl_par5_mælkekvote_dispositionsdato(disposition)) && match disposition {
    | EblPar5MælkekvoteAfstået(_, vederlag_kroner) -> vederlag_kroner >= 0
    | _ -> Sandt
}
| ebl_par5_mælkekvote_input_gyldigt(fakta: EblPar5MælkekvoteFakta) -> fakta.identifikation != "" && ebl_dato_gyldig(fakta.anskaffelsesdato) && ebl_par5_mælkekvote_anskaffelsesgrundlag_gyldigt(fakta.anskaffelsesgrundlag) && ebl_par5_mælkekvote_disposition_gyldig(fakta.disposition) && ebl_dato_før_eller_lig_med(fakta.anskaffelsesdato, ebl_par5_mælkekvote_dispositionsdato(fakta.disposition)) && fakta.oprindelige_enheder > 0 && fakta.disponerede_enheder > 0 && fakta.disponerede_enheder <= fakta.oprindelige_enheder
| ebl_par5_mælkekvote_identifikation_unik(mælkekvoter: List(EblPar5MælkekvoteFakta), fakta: EblPar5MælkekvoteFakta) -> length(filter(mælkekvoter, |anden: EblPar5MælkekvoteFakta| anden.identifikation == fakta.identifikation)) == 1
| ebl_par5_mælkekvoter_gyldige(mælkekvoter: List(EblPar5MælkekvoteFakta)) -> all(mælkekvoter, |fakta: EblPar5MælkekvoteFakta| ebl_par5_mælkekvote_input_gyldigt(fakta) && ebl_par5_mælkekvote_identifikation_unik(mælkekvoter, fakta))
| ebl_par5_mælkekvote_omfattet_af_ebl(fakta: EblPar5MælkekvoteFakta, ejendommens_afståelsesdato: EblDato) -> ebl_dato_yyyymmdd(fakta.anskaffelsesdato) < 20050101 && ebl_dato_før_eller_lig_med(ebl_par5_mælkekvote_dispositionsdato(fakta.disposition), ejendommens_afståelsesdato)
| ebl_par5_mælkekvote_fordelingsgrundlag_påkrævet(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> any(fakta.mælkekvoter, |mælkekvote: EblPar5MælkekvoteFakta| ebl_par5_mælkekvote_omfattet_af_ebl(mælkekvote, afståelsesdato))
| ebl_par5_mælkekvote_datoafgrænset_indgangsværdi(grundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> match grundlag {
    | EblPar4Stk3Nr1Anskaffelsesgrundlag -> Sandt
    | EblPar4Stk3Nr2Anskaffelsesgrundlag -> Sandt
    | EblPar4DagældendeVurderingslov4BAnskaffelsesgrundlag -> Sandt
    | EblPar4Stk3FemtePktUdenlandskHandelsværdiAnskaffelsesgrundlag -> Sandt
    | _ -> Falskt
}
| ebl_par5_mælkekvote_nedsættelse_anvendes(fakta: EblPar5MælkekvoteFakta, anskaffelsesgrundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> ebl_par5_mælkekvote_toldet(fakta.disposition) == Falskt && (ebl_par5_mælkekvote_datoafgrænset_indgangsværdi(anskaffelsesgrundlag) == Falskt || ebl_dato_yyyymmdd(ebl_par5_mælkekvote_dispositionsdato(fakta.disposition)) >= 19930618)
| ebl_par5_mælkekvote_forhøjelsesbetingelse_opfyldt(fakta: EblPar5MælkekvoteFakta, anskaffelsesgrundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> ebl_par5_mælkekvote_toldet(fakta.disposition) || ebl_dato_yyyymmdd(fakta.anskaffelsesdato) < 19930519 || ebl_dato_yyyymmdd(ebl_par5_mælkekvote_dispositionsdato(fakta.disposition)) < 19930618 || ebl_par5_mælkekvote_nedsættelse_anvendes(fakta, anskaffelsesgrundlag)
| ebl_par5_mælkekvote_anskaffelsesgrundlag_for_disponerede_enheder_kroner(fakta: EblPar5MælkekvoteFakta) -> ebl_par5_mælkekvote_anskaffelsesgrundlag_kroner(fakta.anskaffelsesgrundlag) * fakta.disponerede_enheder / fakta.oprindelige_enheder

| ebl_par5_stk6_kategori_berettiget(kategori: EblPar5Stk6Ejendomskategori, afståelsesdato: EblDato) -> match kategori {
    | EblPar5Stk6Landbrugsejendom -> Sandt
    | EblPar5Stk6Skovejendom -> ebl_dato_yyyymmdd(afståelsesdato) >= 20270101
    | EblPar5Stk6Naturejendom -> ebl_dato_yyyymmdd(afståelsesdato) >= 20270101
}
| ebl_par5_stk6_anskaffelsesgrundlag_berettiget(grundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> grundlag == EblPar4Stk3Nr1Anskaffelsesgrundlag || grundlag == EblPar4Stk3Nr2Anskaffelsesgrundlag || grundlag == EblPar4DagældendeVurderingslov4BAnskaffelsesgrundlag
| ebl_par5_stk6_højeste_vurderingsværdi_kroner(fakta: EblPar5Stk6Fakta) -> penge_største_beløb(fakta.tillægsparcelværdi_kroner, fakta.teknisk_værdi_kroner)
| ebl_par5_stk6_vurderingsomfattede_nedsættelser_kroner(fakta: EblPar5Stk6Fakta) -> fakta.afskrivninger_på_vurderingsomfattede_bygninger_kroner + fakta.stk4_nr2_afskrivninger_på_vurderingsomfattede_nedrevne_bygninger_kroner + fakta.nedskrevet_værdi_af_vurderingsomfattede_bygninger_kroner
| ebl_par5_stk6_input_gyldigt(fakta: EblPar5Stk6Fakta) -> fakta.tillægsparcelværdi_kroner >= 0 && fakta.teknisk_værdi_kroner >= 0 && fakta.afskrivninger_på_vurderingsomfattede_bygninger_kroner >= 0 && fakta.stk4_nr2_afskrivninger_på_vurderingsomfattede_nedrevne_bygninger_kroner >= 0 && fakta.nedskrevet_værdi_af_vurderingsomfattede_bygninger_kroner >= 0 && ebl_par5_stk6_vurderingsomfattede_nedsættelser_kroner(fakta) <= ebl_par5_stk6_højeste_vurderingsværdi_kroner(fakta) && fakta.afstået_jord_anskaffelsessum_før_overførsel_kroner > 0 && fakta.samlet_jord_anskaffelsessum_før_overførsel_kroner > 0 && fakta.afstået_jord_anskaffelsessum_før_overførsel_kroner <= fakta.samlet_jord_anskaffelsessum_før_overførsel_kroner
| ebl_par5_stk6_forhold_input_gyldigt(forhold: EblPar5Stk6Overførsel) -> match forhold {
    | EblPar5UdenStk6Overførsel -> Sandt
    | EblPar5MedStk6Overførsel(fakta) -> ebl_par5_stk6_input_gyldigt(fakta)
}

| ebl_par5a_gammelt_reguleringstal_tiendedele(år: Heltal) -> match år {
    | 1993 -> 1200
    | 1994 -> 1236
    | 1995 -> 1245
    | 1996 -> 1279
    | 1997 -> 1287
    | 1998 -> 1322
    | 1999 -> 1360
    | 2000 -> 1408
    | 2001 -> 1457
    | 2002 -> 1501
    | 2003 -> 1554
    | 2004 -> 1604
    | 2005 -> 1639
    | 2006 -> 1677
    | 2007 -> 1722
    | 2008 -> 1767
    | 2009 -> 1827
    | _ -> 0
}
| ebl_par5a_reguleringstal_tiendedele(år: Heltal) -> hvis år <= 2009 { ebl_par5a_gammelt_reguleringstal_tiendedele(år) } ellers { par20_reguleringstal_tiendedele(år) }
| ebl_par5a_reguleringsfaktor_tusindedele(fra_år: Heltal, til_år: Heltal) -> {
    = fra_indeks = ebl_par5a_reguleringstal_tiendedele(fra_år)
    = til_indeks = par20_reguleringstal_tiendedele(til_år)
    hvis fra_indeks <= 0 || til_indeks <= 0 || fra_år > til_år {
        0
    } ellers {
        hvis fra_år <= 2009 {
            = nævner = fra_indeks * 1000
            (ebl_par5a_gammelt_reguleringstal_tiendedele(2009) * til_indeks * 1000 + nævner / 2) / nævner
        } ellers {
            (til_indeks * 1000 + fra_indeks / 2) / fra_indeks
        }
    }
}
| ebl_par5a_reguleringsprocent_tiendedele(fra_år: Heltal, til_år: Heltal) -> penge_positivt_beløb(ebl_par5a_reguleringsfaktor_tusindedele(fra_år, til_år) - 1000)
| ebl_par5a_reguler_beløb_kroner(beløb_kroner: Heltal, fra_år: Heltal, til_år: Heltal) -> hvis beløb_kroner > 0 && ebl_par5a_reguleringsfaktor_tusindedele(fra_år, til_år) > 0 { (beløb_kroner * ebl_par5a_reguleringsfaktor_tusindedele(fra_år, til_år) + 500) / 1000 } ellers { 0 }
| ebl_par5a_startår(fakta: EblPar5Fakta) -> hvis ebl_par4_anskaffelsesgrundlag_er_stk3(fakta.anskaffelsesgrundlag) { 1993 } ellers { fakta.anskaffelsesdato.år }
| ebl_par5a_henføringsår(fakta: EblPar5Fakta, indkomstår: Heltal) -> penge_største_beløb(ebl_par5a_startår(fakta), indkomstår)
| ebl_par5a_valgt(fakta: EblPar5Fakta) -> fakta.reguleringsvalg != EblPar5UdenIndeksering
| ebl_par5a_kategori_berettiget(kategori: EblPar5AIndekseringskategori, afståelsesdato: EblDato) -> match kategori {
    | EblPar5ALandbrugsejendom -> Sandt
    | EblPar5ASkovejendom -> Sandt
    | EblPar5ANaturejendom -> ebl_dato_yyyymmdd(afståelsesdato) >= 20270101
}
| ebl_par5a_valg_berettiget(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> match fakta.reguleringsvalg {
    | EblPar5UdenIndeksering -> Sandt
    | EblPar5AMedIndeksering(kategori) -> ebl_par5a_kategori_berettiget(kategori, afståelsesdato)
}
| ebl_par5a_mælkekvote_kilder_tilgængelige(fakta: EblPar5Fakta, mælkekvote: EblPar5MælkekvoteFakta, afståelsesdato: EblDato) -> ebl_par5_mælkekvote_omfattet_af_ebl(mælkekvote, afståelsesdato) == Falskt || ebl_par5a_reguleringsfaktor_tusindedele(ebl_par5a_henføringsår(fakta, mælkekvote.anskaffelsesdato.år), afståelsesdato.år) > 0 && ebl_par5a_reguleringsfaktor_tusindedele(ebl_par5a_henføringsår(fakta, ebl_par5_mælkekvote_dispositionsdato(mælkekvote.disposition).år), afståelsesdato.år) > 0
| ebl_par5a_kilder_tilgængelige(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> ebl_par5a_reguleringsfaktor_tusindedele(ebl_par5a_startår(fakta), afståelsesdato.år) > 0 && all(ebl_par5_tillægsår(fakta, afståelsesdato), |år: Heltal| ebl_par5a_reguleringsfaktor_tusindedele(år, afståelsesdato.år) > 0) && all(ebl_par5_medregningsberettigede_udgifter(fakta, afståelsesdato), |udgift: EblPar5Udgift| ebl_par5a_reguleringsfaktor_tusindedele(udgift.fuldførelsesår, afståelsesdato.år) > 0) && all(fakta.nedsættelser, |nedsættelse: EblPar5Nedsættelse| ebl_par5a_reguleringsfaktor_tusindedele(nedsættelse.indkomstår, afståelsesdato.år) > 0) && all(fakta.mælkekvoter, |mælkekvote: EblPar5MælkekvoteFakta| ebl_par5a_mælkekvote_kilder_tilgængelige(fakta, mælkekvote, afståelsesdato))

| ebl_par5_mælkekvote_resultat(fakta: EblPar5Fakta, mælkekvote: EblPar5MælkekvoteFakta, afståelsesdato: EblDato) -> {
    = input_gyldigt = ebl_par5_mælkekvote_input_gyldigt(mælkekvote)
    = omfattet_af_ejendomsavancebeskatningsloven = input_gyldigt && ebl_par5_mælkekvote_omfattet_af_ebl(mælkekvote, afståelsesdato)
    = forhøjelsesbetingelse_opfyldt = omfattet_af_ejendomsavancebeskatningsloven && ebl_par5_mælkekvote_forhøjelsesbetingelse_opfyldt(mælkekvote, fakta.anskaffelsesgrundlag)
    = anskaffelsesgrundlag_for_disponerede_enheder_kroner = hvis input_gyldigt { ebl_par5_mælkekvote_anskaffelsesgrundlag_for_disponerede_enheder_kroner(mælkekvote) } ellers { 0 }
    = forhøjelse_efter_stk3_kroner = hvis forhøjelsesbetingelse_opfyldt { ebl_par5_fordel_mælkekvote_på_afstået_del_kroner(fakta.fordeling, anskaffelsesgrundlag_for_disponerede_enheder_kroner) } ellers { 0 }
    = reguleret_forhøjelse_efter_par5a_kroner = hvis ebl_par5a_valgt(fakta) { ebl_par5a_reguler_beløb_kroner(forhøjelse_efter_stk3_kroner, ebl_par5a_henføringsår(fakta, mælkekvote.anskaffelsesdato.år), afståelsesdato.år) } ellers { forhøjelse_efter_stk3_kroner }
    = afståelsesvederlag_kroner = hvis input_gyldigt { ebl_par5_mælkekvote_afståelsesvederlag_kroner(mælkekvote.disposition) } ellers { 0 }
    = nedsættelse_efter_stk4_nr6_kroner = hvis omfattet_af_ejendomsavancebeskatningsloven && ebl_par5_mælkekvote_nedsættelse_anvendes(mælkekvote, fakta.anskaffelsesgrundlag) { ebl_par5_fordel_mælkekvote_på_afstået_del_kroner(fakta.fordeling, afståelsesvederlag_kroner) } ellers { 0 }
    = reguleret_nedsættelse_efter_par5a_kroner = hvis ebl_par5a_valgt(fakta) { ebl_par5a_reguler_beløb_kroner(nedsættelse_efter_stk4_nr6_kroner, ebl_par5a_henføringsår(fakta, ebl_par5_mælkekvote_dispositionsdato(mælkekvote.disposition).år), afståelsesdato.år) } ellers { nedsættelse_efter_stk4_nr6_kroner }
    EblPar5MælkekvoteResultat(
        fakta = mælkekvote,
        input_gyldigt = input_gyldigt,
        omfattet_af_ejendomsavancebeskatningsloven = omfattet_af_ejendomsavancebeskatningsloven,
        forhøjelsesbetingelse_opfyldt = forhøjelsesbetingelse_opfyldt,
        anskaffelsesgrundlag_for_disponerede_enheder_kroner = anskaffelsesgrundlag_for_disponerede_enheder_kroner,
        forhøjelse_efter_stk3_kroner = forhøjelse_efter_stk3_kroner,
        reguleret_forhøjelse_efter_par5a_kroner = reguleret_forhøjelse_efter_par5a_kroner,
        afståelsesvederlag_kroner = afståelsesvederlag_kroner,
        nedsættelse_efter_stk4_nr6_kroner = nedsættelse_efter_stk4_nr6_kroner,
        reguleret_nedsættelse_efter_par5a_kroner = reguleret_nedsættelse_efter_par5a_kroner
    )
}
| ebl_par5_mælkekvote_resultater(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> map(fakta.mælkekvoter, |mælkekvote: EblPar5MælkekvoteFakta| ebl_par5_mælkekvote_resultat(fakta, mælkekvote, afståelsesdato))

| ebl_par5_ingen_stk6_resultat() -> EblPar5Stk6Resultat(
    forhold = EblPar5UdenStk6Overførsel,
    input_gyldigt = Sandt,
    betingelser_opfyldt = Falskt,
    højeste_vurderingsværdi_kroner = 0,
    vurderingsomfattede_nedsættelser_kroner = 0,
    overførselsberettiget_beløb_for_hele_ejendommen_kroner = 0,
    skattepligtiges_overførselsberettigede_beløb_kroner = 0,
    overført_til_afstået_jord_kroner = 0,
    reguleret_overførsel_efter_par5a_kroner = 0,
    restejendommens_anskaffelsessum_nedsættes_kroner = 0
)
| ebl_par5_stk6_resultat(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> match fakta.stk6_overførsel {
    | EblPar5UdenStk6Overførsel -> ebl_par5_ingen_stk6_resultat()
    | EblPar5MedStk6Overførsel(stk6_fakta) -> {
        = input_gyldigt = ebl_par5_stk6_input_gyldigt(stk6_fakta)
        = betingelser_opfyldt = input_gyldigt && ebl_par5_delafståelse(fakta.fordeling) && ebl_par5_stk6_anskaffelsesgrundlag_berettiget(fakta.anskaffelsesgrundlag) && ebl_par5_stk6_kategori_berettiget(stk6_fakta.ejendomskategori, afståelsesdato)
        = højeste_vurderingsværdi_kroner = hvis input_gyldigt { ebl_par5_stk6_højeste_vurderingsværdi_kroner(stk6_fakta) } ellers { 0 }
        = vurderingsomfattede_nedsættelser_kroner = hvis input_gyldigt { ebl_par5_stk6_vurderingsomfattede_nedsættelser_kroner(stk6_fakta) } ellers { 0 }
        = overførselsberettiget_beløb_for_hele_ejendommen_kroner = hvis betingelser_opfyldt { højeste_vurderingsværdi_kroner - vurderingsomfattede_nedsættelser_kroner } ellers { 0 }
        = skattepligtiges_overførselsberettigede_beløb_kroner = ebl_par5_fordel_ejerandel_kroner(fakta.fordeling, overførselsberettiget_beløb_for_hele_ejendommen_kroner)
        = overført_til_afstået_jord_kroner = hvis betingelser_opfyldt { skattepligtiges_overførselsberettigede_beløb_kroner * stk6_fakta.afstået_jord_anskaffelsessum_før_overførsel_kroner / stk6_fakta.samlet_jord_anskaffelsessum_før_overførsel_kroner } ellers { 0 }
        = reguleret_overførsel_efter_par5a_kroner = hvis ebl_par5a_valgt(fakta) { ebl_par5a_reguler_beløb_kroner(overført_til_afstået_jord_kroner, ebl_par5a_startår(fakta), afståelsesdato.år) } ellers { overført_til_afstået_jord_kroner }
        EblPar5Stk6Resultat(
            forhold = fakta.stk6_overførsel,
            input_gyldigt = input_gyldigt,
            betingelser_opfyldt = betingelser_opfyldt,
            højeste_vurderingsværdi_kroner = højeste_vurderingsværdi_kroner,
            vurderingsomfattede_nedsættelser_kroner = vurderingsomfattede_nedsættelser_kroner,
            overførselsberettiget_beløb_for_hele_ejendommen_kroner = overførselsberettiget_beløb_for_hele_ejendommen_kroner,
            skattepligtiges_overførselsberettigede_beløb_kroner = skattepligtiges_overførselsberettigede_beløb_kroner,
            overført_til_afstået_jord_kroner = overført_til_afstået_jord_kroner,
            reguleret_overførsel_efter_par5a_kroner = reguleret_overførsel_efter_par5a_kroner,
            restejendommens_anskaffelsessum_nedsættes_kroner = overført_til_afstået_jord_kroner
        )
    }
}

| ebl_par5_årsudgift_resultat(fakta: EblPar5Fakta, afståelsesdato: EblDato, indkomstår: Heltal) -> EblPar5ÅrsudgiftResultat(
    indkomstår = indkomstår,
    medregningsberettigede_udgifter_kroner = ebl_par5_udgifter_for_år_kroner(fakta, afståelsesdato, indkomstår),
    årlig_grænse_kroner = ebl_par5_årligt_tillæg_kroner(fakta),
    tillæg_efter_stk2_kroner = ebl_par5_årsudgift_tillæg_kroner(fakta, afståelsesdato, indkomstår),
    reguleret_tillæg_efter_par5a_kroner = hvis ebl_par5a_valgt(fakta) { ebl_par5a_reguler_beløb_kroner(ebl_par5_årsudgift_tillæg_kroner(fakta, afståelsesdato, indkomstår), indkomstår, afståelsesdato.år) } ellers { ebl_par5_årsudgift_tillæg_kroner(fakta, afståelsesdato, indkomstår) }
)
| ebl_par5_årsudgift_resultater(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> map(ebl_par5_udgiftsår(fakta, afståelsesdato), |år: Heltal| ebl_par5_årsudgift_resultat(fakta, afståelsesdato, år))
| ebl_par5_nedsættelsesresultat(fakta: EblPar5Fakta, afståelsesdato: EblDato, nedsættelse: EblPar5Nedsættelse) -> EblPar5Nedsættelsesresultat(
    nedsættelse = nedsættelse,
    nedsættelse_efter_stk4_til_8_kroner = ebl_par5_nedsættelse_efter_stk4_til_8_kroner(fakta, nedsættelse),
    reguleret_nedsættelse_efter_par5a_kroner = hvis ebl_par5a_valgt(fakta) { ebl_par5a_reguler_beløb_kroner(ebl_par5_nedsættelse_efter_stk4_til_8_kroner(fakta, nedsættelse), nedsættelse.indkomstår, afståelsesdato.år) } ellers { ebl_par5_nedsættelse_efter_stk4_til_8_kroner(fakta, nedsættelse) }
)
| ebl_par5_nedsættelsesresultater(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> map(fakta.nedsættelser, |nedsættelse: EblPar5Nedsættelse| ebl_par5_nedsættelsesresultat(fakta, afståelsesdato, nedsættelse))

| ebl_par5_udgift_gyldig(udgift: EblPar5Udgift) -> ebl_dato_gyldig(udgift.afholdelsesdato) && udgift.fuldførelsesår >= udgift.afholdelsesdato.år && udgift.beløb_for_afstået_del_kroner >= 0
| ebl_par5_nedsættelse_gyldig(nedsættelse: EblPar5Nedsættelse, fakta: EblPar5Fakta, afståelsesdato: EblDato) -> nedsættelse.indkomstår >= fakta.anskaffelsesdato.år && nedsættelse.indkomstår <= afståelsesdato.år && nedsættelse.beløb_for_afstået_del_kroner >= 0
| ebl_par5_input_gyldigt(fakta: EblPar5Fakta, afståelsesdato: EblDato, anskaffelsessum_før_par5_kroner: Heltal) -> ebl_dato_gyldig(fakta.anskaffelsesdato) && ebl_dato_gyldig(afståelsesdato) && ebl_dato_før_eller_lig_med(fakta.anskaffelsesdato, afståelsesdato) && anskaffelsessum_før_par5_kroner >= 0 && ebl_par5_fordeling_gyldig(fakta.fordeling) && (ebl_par5_mælkekvote_fordelingsgrundlag_påkrævet(fakta, afståelsesdato) == Falskt || ebl_par5_mælkekvote_fordelingsgrundlag_tilgængeligt(fakta.fordeling)) && ebl_par4_anskaffelsesgrundlag_gyldigt(fakta.anskaffelsesgrundlag) && all(fakta.vedligeholdelses_og_forbedringsudgifter, ebl_par5_udgift_gyldig) && all(fakta.nedsættelser, |nedsættelse: EblPar5Nedsættelse| ebl_par5_nedsættelse_gyldig(nedsættelse, fakta, afståelsesdato)) && ebl_par5_mælkekvoter_gyldige(fakta.mælkekvoter) && ebl_par5_stk6_forhold_input_gyldigt(fakta.stk6_overførsel)
| ebl_par5_udgiftsfuldførelse_understøttet(fakta: EblPar5Fakta) -> all(fakta.vedligeholdelses_og_forbedringsudgifter, |udgift: EblPar5Udgift| udgift.fuldførelsesår == udgift.afholdelsesdato.år)
| ebl_par5_regelgrundlag_understøttet(fakta: EblPar5Fakta, afståelsesdato: EblDato) -> ebl_par5_udgiftsfuldførelse_understøttet(fakta) && ebl_par5a_valg_berettiget(fakta, afståelsesdato) && (ebl_par5a_valgt(fakta) == Falskt || ebl_par5a_kilder_tilgængelige(fakta, afståelsesdato))
| ebl_par5_standardfakta(anskaffelsesdato: EblDato, anskaffelsesgrundlag: EjendomsavancePar4Anskaffelsesgrundlag) -> EblPar5Fakta(
    anskaffelsesdato = anskaffelsesdato,
    anskaffelsesgrundlag = anskaffelsesgrundlag,
    fordeling = EblPar5Fordeling(
        ejerandel_promille = 1000,
        afståelsesomfang = EblPar5HeleEjendommen
    ),
    vedligeholdelses_og_forbedringsudgifter = [],
    nedsættelser = [],
    mælkekvoter = [],
    stk6_overførsel = EblPar5UdenStk6Overførsel,
    reguleringsvalg = EblPar5UdenIndeksering
)

# EblPar5Sag(fakta: EblPar5Fakta, afståelsesdato: EblDato, anskaffelsessum_før_par5_kroner: Heltal) {
    | input_gyldigt() -> ebl_par5_input_gyldigt(fakta, afståelsesdato, anskaffelsessum_før_par5_kroner)
    | regelgrundlag_understøttet() -> ebl_par5_regelgrundlag_understøttet(fakta, afståelsesdato)
    | beregning_anvendt() -> input_gyldigt() && regelgrundlag_understøttet()
    | indeksering_anvendt() -> beregning_anvendt() && ebl_par5a_valgt(fakta)
    | tillægsår() -> ebl_par5_tillægsår(fakta, afståelsesdato)
    | fast_tillæg_efter_stk1_kroner() -> ebl_par5_fast_tillæg_efter_stk1_kroner(fakta, afståelsesdato)
    | reguleret_fast_tillæg_efter_par5a_kroner() -> hvis indeksering_anvendt() { foldl(tillægsår(), 0, |sum: Heltal, år: Heltal| sum + ebl_par5a_reguler_beløb_kroner(ebl_par5_årligt_tillæg_kroner(fakta), år, afståelsesdato.år)) } ellers { fast_tillæg_efter_stk1_kroner() }
    | årsudgift_resultater() -> ebl_par5_årsudgift_resultater(fakta, afståelsesdato)
    | vedligeholdelses_og_forbedringstillæg_efter_stk2_kroner() -> foldl(årsudgift_resultater(), 0, |sum: Heltal, resultat: EblPar5ÅrsudgiftResultat| sum + resultat.tillæg_efter_stk2_kroner)
    | reguleret_vedligeholdelses_og_forbedringstillæg_efter_par5a_kroner() -> foldl(årsudgift_resultater(), 0, |sum: Heltal, resultat: EblPar5ÅrsudgiftResultat| sum + resultat.reguleret_tillæg_efter_par5a_kroner)
    | mælkekvote_resultater() -> ebl_par5_mælkekvote_resultater(fakta, afståelsesdato)
    | mælkekvoteforhøjelse_efter_stk3_kroner() -> foldl(mælkekvote_resultater(), 0, |sum: Heltal, resultat: EblPar5MælkekvoteResultat| sum + resultat.forhøjelse_efter_stk3_kroner)
    | reguleret_mælkekvoteforhøjelse_efter_par5a_kroner() -> foldl(mælkekvote_resultater(), 0, |sum: Heltal, resultat: EblPar5MælkekvoteResultat| sum + resultat.reguleret_forhøjelse_efter_par5a_kroner)
    | stk6_resultat() -> ebl_par5_stk6_resultat(fakta, afståelsesdato)
    | stk6_overført_til_afstået_jord_kroner() -> stk6_resultat().overført_til_afstået_jord_kroner
    | reguleret_stk6_overførsel_efter_par5a_kroner() -> stk6_resultat().reguleret_overførsel_efter_par5a_kroner
    | nedsættelsesresultater() -> ebl_par5_nedsættelsesresultater(fakta, afståelsesdato)
    | mælkekvotenedsættelser_efter_stk4_nr6_kroner() -> foldl(mælkekvote_resultater(), 0, |sum: Heltal, resultat: EblPar5MælkekvoteResultat| sum + resultat.nedsættelse_efter_stk4_nr6_kroner)
    | regulerede_mælkekvotenedsættelser_efter_par5a_kroner() -> foldl(mælkekvote_resultater(), 0, |sum: Heltal, resultat: EblPar5MælkekvoteResultat| sum + resultat.reguleret_nedsættelse_efter_par5a_kroner)
    | nedsættelser_efter_stk4_til_8_kroner() -> foldl(nedsættelsesresultater(), mælkekvotenedsættelser_efter_stk4_nr6_kroner(), |sum: Heltal, resultat: EblPar5Nedsættelsesresultat| sum + resultat.nedsættelse_efter_stk4_til_8_kroner)
    | regulerede_nedsættelser_efter_par5a_kroner() -> foldl(nedsættelsesresultater(), regulerede_mælkekvotenedsættelser_efter_par5a_kroner(), |sum: Heltal, resultat: EblPar5Nedsættelsesresultat| sum + resultat.reguleret_nedsættelse_efter_par5a_kroner)
    | reguleringsprocent_tiendedele() -> hvis indeksering_anvendt() { ebl_par5a_reguleringsprocent_tiendedele(ebl_par5a_startår(fakta), afståelsesdato.år) } ellers { 0 }
    | anskaffelsessum_efter_valgt_regulering_kroner() -> hvis indeksering_anvendt() { ebl_par5a_reguler_beløb_kroner(anskaffelsessum_før_par5_kroner, ebl_par5a_startår(fakta), afståelsesdato.år) + reguleret_fast_tillæg_efter_par5a_kroner() + reguleret_vedligeholdelses_og_forbedringstillæg_efter_par5a_kroner() + reguleret_mælkekvoteforhøjelse_efter_par5a_kroner() + reguleret_stk6_overførsel_efter_par5a_kroner() - regulerede_nedsættelser_efter_par5a_kroner() } ellers { anskaffelsessum_før_par5_kroner + fast_tillæg_efter_stk1_kroner() + vedligeholdelses_og_forbedringstillæg_efter_stk2_kroner() + mælkekvoteforhøjelse_efter_stk3_kroner() + stk6_overført_til_afstået_jord_kroner() - nedsættelser_efter_stk4_til_8_kroner() }
    | reguleret_anskaffelsessum_kroner() -> hvis beregning_anvendt() { penge_positivt_beløb(anskaffelsessum_efter_valgt_regulering_kroner()) } ellers { penge_positivt_beløb(anskaffelsessum_før_par5_kroner) }
    | regulering_efter_par5_og_par5a_kroner() -> reguleret_anskaffelsessum_kroner() - penge_positivt_beløb(anskaffelsessum_før_par5_kroner)
    | resultat() -> EblPar5Resultat(
        fakta = fakta,
        afståelsesdato = afståelsesdato,
        anskaffelsessum_før_par5_kroner = anskaffelsessum_før_par5_kroner,
        input_gyldigt = input_gyldigt(),
        regelgrundlag_understøttet = regelgrundlag_understøttet(),
        beregning_anvendt = beregning_anvendt(),
        indeksering_anvendt = indeksering_anvendt(),
        reguleringsprocent_tiendedele = reguleringsprocent_tiendedele(),
        tillægsår = tillægsår(),
        fast_tillæg_efter_stk1_kroner = fast_tillæg_efter_stk1_kroner(),
        reguleret_fast_tillæg_efter_par5a_kroner = reguleret_fast_tillæg_efter_par5a_kroner(),
        årsudgift_resultater = årsudgift_resultater(),
        vedligeholdelses_og_forbedringstillæg_efter_stk2_kroner = vedligeholdelses_og_forbedringstillæg_efter_stk2_kroner(),
        reguleret_vedligeholdelses_og_forbedringstillæg_efter_par5a_kroner = reguleret_vedligeholdelses_og_forbedringstillæg_efter_par5a_kroner(),
        mælkekvote_resultater = mælkekvote_resultater(),
        mælkekvoteforhøjelse_efter_stk3_kroner = mælkekvoteforhøjelse_efter_stk3_kroner(),
        reguleret_mælkekvoteforhøjelse_efter_par5a_kroner = reguleret_mælkekvoteforhøjelse_efter_par5a_kroner(),
        stk6_resultat = stk6_resultat(),
        stk6_overført_til_afstået_jord_kroner = stk6_overført_til_afstået_jord_kroner(),
        reguleret_stk6_overførsel_efter_par5a_kroner = reguleret_stk6_overførsel_efter_par5a_kroner(),
        nedsættelsesresultater = nedsættelsesresultater(),
        nedsættelser_efter_stk4_til_8_kroner = nedsættelser_efter_stk4_til_8_kroner(),
        regulerede_nedsættelser_efter_par5a_kroner = regulerede_nedsættelser_efter_par5a_kroner(),
        reguleret_anskaffelsessum_kroner = reguleret_anskaffelsessum_kroner(),
        regulering_efter_par5_og_par5a_kroner = regulering_efter_par5_og_par5a_kroner()
    )
}
| ebl_par5_sag(fakta: EblPar5Fakta, afståelsesdato: EblDato, anskaffelsessum_før_par5_kroner: Heltal) -> EblPar5Sag(fakta, afståelsesdato, anskaffelsessum_før_par5_kroner)
| ebl_par5_resultat(fakta: EblPar5Fakta, afståelsesdato: EblDato, anskaffelsessum_før_par5_kroner: Heltal) -> ebl_par5_sag(fakta, afståelsesdato, anskaffelsessum_før_par5_kroner).resultat()
--@end:ebl_par5_par5a--
