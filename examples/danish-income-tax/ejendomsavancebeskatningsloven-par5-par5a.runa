# EblPar5MælkekvoteDisposition = EblPar5MælkekvoteAfstået(afståelsesdato: EblDato, vederlag_kroner: Heltal) | EblPar5MælkekvoteUdløbet(udløbsdato: EblDato) | EblPar5MælkekvoteToldetUdenErstatning(toldningsdato: EblDato)
# EblPar5MælkekvoteFakta(identifikation: Tekst, anskaffelsesdato: EblDato, oprindelige_enheder: Heltal, disponerede_enheder: Heltal, anskaffelsesgrundlag: EblPar5MælkekvoteAnskaffelsesgrundlag, disposition: EblPar5MælkekvoteDisposition)
# EblPar5MælkekvoteResultat(fakta: EblPar5MælkekvoteFakta, input_gyldigt: Boolsk, omfattet_af_ejendomsavancebeskatningsloven: Boolsk, forhøjelsesbetingelse_opfyldt: Boolsk, anskaffelsesgrundlag_for_disponerede_enheder_kroner: Heltal, forhøjelse_efter_stk3_kroner: Heltal, reguleret_forhøjelse_efter_par5a_kroner: Heltal, afståelsesvederlag_kroner: Heltal, nedsættelse_efter_stk4_nr6_kroner: Heltal, reguleret_nedsættelse_efter_par5a_kroner: Heltal)
