)

= abl19c_kapital_fixture = aktieavancebeskatningslov_resultat(abl19c_kapital_input)
= abl19c_hvis17_fixture = aktieavancebeskatningslov_resultat(abl19c_hvis17_input)
= abl22_tab_fixture = aktieavancebeskatningslov_resultat(abl22_tab_input)
= abl22_under_bagatel_fixture = aktieavancebeskatningslov_resultat(abl22_under_bagatel_input)

| abl19c_kapitalindkomstklassifikation: abl19c_kapital_fixture -> abl19c_kapital_fixture.effektiv_aktiv == AblInvesteringsselskab19C && abl19c_kapital_fixture.skattepligtig_gevinst_kroner == 12000 && abl19c_kapital_fixture.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5
| abl19c_hvis_par17_bliver_personlig: abl19c_hvis17_fixture -> abl19c_hvis17_fixture.skattepligtig_gevinst_kroner == 7000 && abl19c_hvis17_fixture.personskattelov_kategori == AblPersonligIndkomstEfterPslUndtagelse
| abl22_tab_over_bagatel_fradrages: abl22_tab_fixture -> abl22_tab_fixture.fradragsberettiget_tab_kroner == 3000 && abl22_tab_fixture.netto_efter_aktieavancebeskatningsloven_kroner == -3000 && abl22_tab_fixture.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5
| abl22_under_bagatel_afskæres: abl22_under_bagatel_fixture -> abl22_under_bagatel_fixture.medregnes_i_skattepligtig_indkomst == Falskt && abl22_under_bagatel_fixture.netto_efter_aktieavancebeskatningsloven_kroner == 0
