--@label:personskat_arbejdsgiverydelser::meta:personskat_personlig_indkomst_kildefakta_metadata--
----
Personskatteloven § 3, stk. 1:

Personlig indkomst omfatter alle de indkomster, der indgår i den
skattepligtige indkomst, og som ikke er kapitalindkomst.

Arbejdsmarkedsbidragsloven § 2, stk. 1, nr. 1, og stk. 2:

Grundlaget for arbejdsmarkedsbidrag for lønmodtagere m.v. er følgende
indkomster, jf. dog stk. 2 og § 3:
1) Ethvert vederlag i penge eller naturalier, der kan henføres til personligt
arbejde i ansættelsesforhold, herunder løn i opsigelsesperiode, løn under
sygdom og barsel m.v., efterbetalinger, fratrædelsesgodtgørelser, efterløns- og
pensionslignende ydelser m.v., når sådanne ydelser har sammenhæng med et
tidligere ansættelsesforhold eller hverv.

Stk. 2. Vederlag i form af naturalier som nævnt i stk. 1 indgår i grundlaget
for arbejdsmarkedsbidrag med den skattepligtige værdi.

Pensionsbeskatningsloven § 56, stk. 5:

Har en arbejdsgiver og en arbejdstager aftalt, at en gruppelivsforsikring, der
ikke er fradragsberettiget, indgår som en ikke adskilt del af en
pensionsordning, der er omfattet af § 19, anvendes reglerne i stk. 1, 1. pkt.,
på indbetalingerne til denne ordning. Gruppelivsforsikringen behandles i øvrigt
efter reglerne i § 53 A.

Pensionsbeskatningsloven § 19, stk. 1, 1., 2. og 8. pkt.:

Ved opgørelsen af en arbejdstagers skattepligtige indkomst medregnes ikke
beløb, der af arbejdsgiveren indbetales til en af kapitel 1 omfattet ordning
for arbejdstageren, herunder indbetalinger til Arbejdsmarkedets Tillægspension
vedrørende arbejdsgiverbetalte dagpengeydelser i henhold til lov om
sygedagpenge. Det samme gælder indbetalinger fra en tidligere arbejdsgiver til
en af kapitel 1 omfattet ordning. 1. og 2. pkt. gælder ikke præmier og bidrag
til aldersopsparing, aldersforsikring eller den del af et pensionskassemedlems
årlige bidrag, der anvendes til finansiering af supplerende engangssummer som
nævnt i § 29 A, stk. 1.
----

--@begin:personskat_arbejdsgiverydelser--
# PersonskatArbejdsgiverydelse = DirekteArbejdsgiverbetaltGruppeliv(præmie_før_arbejdsmarkedsbidrag_kroner: Heltal) | GruppelivSomUadskiltDelAfPbl19Ordning(personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner: Heltal) | ArbejdsgiveradministreretPensionEfterPbl19(fakta: Pbl19ArbejdsgiverindbetalingFakta) | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(indberettet_beløb_før_indeholdt_arbejdsmarkedsbidrag_kroner: Option(Heltal), indberettet_beløb_efter_indeholdt_arbejdsmarkedsbidrag_kroner: Heltal) | NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(art: ArbejdsmarkedsbidragNaturaliaArt, skattepligtig_værdi_kroner: Heltal) | UklassificeretArbejdsgiverbetaltYdelse(beskrivelse: Tekst, beløb_kroner: Heltal)
# PersonskatArbejdsgiverydelseFakta(identifikation: Tekst, indkomstår: Heltal, ydelse: PersonskatArbejdsgiverydelse)
# PersonskatArbejdsgiverydelseAmKlassifikation = AnsættelsesvederlagEfterPar2Stk1Nr1 | GruppelivMedAlleredeIndeholdtArbejdsmarkedsbidrag | PensionEfterPbl19MedAlleredeIndeholdtArbejdsmarkedsbidrag(resultat: Pbl19ArbejdsgiverindbetalingResultat) | SamlepostEfterPbl19EllerPbl56MedAlleredeIndeholdtArbejdsmarkedsbidrag | NaturalieOmfattetAfPar2Stk2(resultat: ArbejdsmarkedsbidragNaturaliaResultat) | IkkeUnderstøttetArbejdsgiverydelseAmKlassifikation
# PersonskatArbejdsgiverydelseBeregning(fakta: PersonskatArbejdsgiverydelseFakta, am_klassifikation: PersonskatArbejdsgiverydelseAmKlassifikation, par3_indkomstpost: Par3Indkomstpost, par3_indkomstresultat_for_ydelsen: Par3PersonligIndkomstResultat, arbejdsmarkedsbidragsgrundlag_tillæg_kroner: Heltal, arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner: Heltal, personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner: Heltal)
# PersonskatArbejdsgiverydelseResultat = UgyldigArbejdsgiverydelse(fakta: PersonskatArbejdsgiverydelseFakta, identifikation_unik: Boolsk, skatteår_matcher: Boolsk, grundfakta_gyldige: Boolsk) | IkkeUnderstøttetArbejdsgiverydelse(fakta: PersonskatArbejdsgiverydelseFakta) | BeregnetArbejdsgiverydelse(beregning: PersonskatArbejdsgiverydelseBeregning)

| personskat_tomt_par3_personlig_indkomst_input(indkomstposter: List(Par3Indkomstpost), stk2_nr1_udgifter: List(Par3Stk2Nr1UdgiftInput)) -> Par3PersonligIndkomstInput(
    indkomstposter = indkomstposter,
    stk2_nr1_udgifter = stk2_nr1_udgifter,
    stk2_nr2_input = Par3Stk2Nr2Input(poster = []),
    stk2_nr3_til_11_input = Par3Stk2Nr3Til11Input(poster = [])
)
| personskat_arbejdsgiverydelse_beløb_kroner(ydelse: PersonskatArbejdsgiverydelse) -> match ydelse {
    | DirekteArbejdsgiverbetaltGruppeliv(beløb_kroner) -> beløb_kroner
    | GruppelivSomUadskiltDelAfPbl19Ordning(beløb_kroner) -> beløb_kroner
    | ArbejdsgiveradministreretPensionEfterPbl19(fakta) -> fakta.indberettet_indbetaling_efter_indeholdt_arbejdsmarkedsbidrag_kroner
    | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(_, beløb_kroner) -> beløb_kroner
    | NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(_, beløb_kroner) -> beløb_kroner
    | UklassificeretArbejdsgiverbetaltYdelse(_, beløb_kroner) -> beløb_kroner
}
| personskat_arbejdsgiveradministreret_samlepost_bruttobeløb_gyldigt(bruttobeløb: Option(Heltal), nettobeløb_kroner: Heltal) -> match bruttobeløb {
    | Some(bruttobeløb_kroner) -> bruttobeløb_kroner >= nettobeløb_kroner
    | None -> Sandt
}
| personskat_arbejdsgiveradministreret_samlepost_bruttobeløb_kroner(bruttobeløb: Option(Heltal)) -> match bruttobeløb {
    | Some(bruttobeløb_kroner) -> bruttobeløb_kroner
    | None -> 0
}
| personskat_arbejdsgiverydelse_grundfakta_gyldige(fakta: PersonskatArbejdsgiverydelseFakta) -> fakta.identifikation != "" && personskat_arbejdsgiverydelse_beløb_kroner(fakta.ydelse) >= 0
| personskat_arbejdsgiverydelse_understøttet(ydelse: PersonskatArbejdsgiverydelse, indkomstår: Heltal) -> match ydelse {
    | DirekteArbejdsgiverbetaltGruppeliv(_) -> Sandt
    | GruppelivSomUadskiltDelAfPbl19Ordning(_) -> Sandt
    | ArbejdsgiveradministreretPensionEfterPbl19(fakta) -> pbl19_stk1_arbejdsgiverindbetaling_resultat(fakta, indkomstår).input_gyldigt
    | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(bruttobeløb, nettobeløb_kroner) -> personskat_arbejdsgiveradministreret_samlepost_bruttobeløb_gyldigt(bruttobeløb, nettobeløb_kroner)
    | NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(art, beløb_kroner) -> arbejdsmarkedsbidrag_par2_stk2_naturalia_resultat(ArbejdsmarkedsbidragNaturaliaPost(
        art = art,
        skattepligtig_værdi_kroner = beløb_kroner,
        nævnt_i_par2_stk1 = Sandt
    )).par2_stk2_art_omfattet
    | UklassificeretArbejdsgiverbetaltYdelse(_, _) -> Falskt
}
| personskat_arbejdsgiverydelse_am_klassifikation(ydelse: PersonskatArbejdsgiverydelse, indkomstår: Heltal) -> match ydelse {
    | DirekteArbejdsgiverbetaltGruppeliv(_) -> AnsættelsesvederlagEfterPar2Stk1Nr1
    | GruppelivSomUadskiltDelAfPbl19Ordning(_) -> GruppelivMedAlleredeIndeholdtArbejdsmarkedsbidrag
    | ArbejdsgiveradministreretPensionEfterPbl19(fakta) -> PensionEfterPbl19MedAlleredeIndeholdtArbejdsmarkedsbidrag(resultat = pbl19_stk1_arbejdsgiverindbetaling_resultat(fakta, indkomstår))
    | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(_, _) -> SamlepostEfterPbl19EllerPbl56MedAlleredeIndeholdtArbejdsmarkedsbidrag
    | NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(art, beløb_kroner) -> NaturalieOmfattetAfPar2Stk2(resultat = arbejdsmarkedsbidrag_par2_stk2_naturalia_resultat(ArbejdsmarkedsbidragNaturaliaPost(
        art = art,
        skattepligtig_værdi_kroner = beløb_kroner,
        nævnt_i_par2_stk1 = Sandt
    )))
    | UklassificeretArbejdsgiverbetaltYdelse(_, _) -> IkkeUnderstøttetArbejdsgiverydelseAmKlassifikation
}
| personskat_arbejdsgiverydelse_personlig_indkomst_kroner(ydelse: PersonskatArbejdsgiverydelse, indkomstår: Heltal) -> match ydelse {
    | ArbejdsgiveradministreretPensionEfterPbl19(fakta) -> pbl19_stk1_arbejdsgiverindbetaling_resultat(fakta, indkomstår).personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner
    | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(_, beløb_kroner) -> beløb_kroner
    | _ -> personskat_arbejdsgiverydelse_beløb_kroner(ydelse)
}
| personskat_arbejdsgiverydelse_par3_indkomstpost(ydelse: PersonskatArbejdsgiverydelse, indkomstår: Heltal) -> Par3Indkomstpost(
    indgår_i_skattepligtig_indkomst = Sandt,
    er_kapitalindkomst = Falskt,
    beløb_kroner = personskat_arbejdsgiverydelse_personlig_indkomst_kroner(ydelse, indkomstår)
)
| personskat_arbejdsgiverydelse_arbejdsmarkedsbidragsgrundlag_kroner(ydelse: PersonskatArbejdsgiverydelse) -> match ydelse {
    | DirekteArbejdsgiverbetaltGruppeliv(beløb_kroner) -> beløb_kroner
    | NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(art, beløb_kroner) -> arbejdsmarkedsbidrag_par2_stk2_naturalia_resultat(ArbejdsmarkedsbidragNaturaliaPost(
        art = art,
        skattepligtig_værdi_kroner = beløb_kroner,
        nævnt_i_par2_stk1 = Sandt
    )).grundlag_kroner
    | _ -> 0
}
| personskat_arbejdsgiverydelse_arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner(ydelse: PersonskatArbejdsgiverydelse, indkomstår: Heltal) -> match ydelse {
    | ArbejdsgiveradministreretPensionEfterPbl19(fakta) -> pbl19_stk1_arbejdsgiverindbetaling_resultat(fakta, indkomstår).arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner
    | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(bruttobeløb, _) -> personskat_arbejdsgiveradministreret_samlepost_bruttobeløb_kroner(bruttobeløb)
    | _ -> 0
}
| personskat_arbejdsgiverydelse_personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner(ydelse: PersonskatArbejdsgiverydelse, indkomstår: Heltal) -> match ydelse {
    | GruppelivSomUadskiltDelAfPbl19Ordning(beløb_kroner) -> beløb_kroner
    | ArbejdsgiveradministreretPensionEfterPbl19(fakta) -> pbl19_stk1_arbejdsgiverindbetaling_resultat(fakta, indkomstår).personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner
    | ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(_, beløb_kroner) -> beløb_kroner
    | _ -> 0
}
| personskat_arbejdsgiverydelse_beregning(fakta: PersonskatArbejdsgiverydelseFakta) -> {
    = par3_indkomstpost = personskat_arbejdsgiverydelse_par3_indkomstpost(fakta.ydelse, fakta.indkomstår)
    PersonskatArbejdsgiverydelseBeregning(
        fakta = fakta,
        am_klassifikation = personskat_arbejdsgiverydelse_am_klassifikation(fakta.ydelse, fakta.indkomstår),
        par3_indkomstpost = par3_indkomstpost,
        par3_indkomstresultat_for_ydelsen = par3_personlig_indkomst_resultat(personskat_tomt_par3_personlig_indkomst_input([par3_indkomstpost], [])),
        arbejdsmarkedsbidragsgrundlag_tillæg_kroner = personskat_arbejdsgiverydelse_arbejdsmarkedsbidragsgrundlag_kroner(fakta.ydelse),
        arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner = personskat_arbejdsgiverydelse_arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner(fakta.ydelse, fakta.indkomstår),
        personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner = personskat_arbejdsgiverydelse_personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner(fakta.ydelse, fakta.indkomstår)
    )
}
| personskat_arbejdsgiverydelse_resultat(fakta: PersonskatArbejdsgiverydelseFakta, skatteår: Heltal, identifikation_unik: Boolsk) -> hvis identifikation_unik == Falskt || fakta.indkomstår != skatteår || personskat_arbejdsgiverydelse_grundfakta_gyldige(fakta) == Falskt {
    UgyldigArbejdsgiverydelse(
        fakta = fakta,
        identifikation_unik = identifikation_unik,
        skatteår_matcher = fakta.indkomstår == skatteår,
        grundfakta_gyldige = personskat_arbejdsgiverydelse_grundfakta_gyldige(fakta)
    )
} ellers hvis personskat_arbejdsgiverydelse_understøttet(fakta.ydelse, fakta.indkomstår) == Falskt {
    IkkeUnderstøttetArbejdsgiverydelse(fakta = fakta)
} ellers {
    BeregnetArbejdsgiverydelse(beregning = personskat_arbejdsgiverydelse_beregning(fakta))
}
| personskat_arbejdsgiverydelse_resultat_gyldigt(resultat: PersonskatArbejdsgiverydelseResultat) -> match resultat {
    | BeregnetArbejdsgiverydelse(_) -> Sandt
    | _ -> Falskt
}
| personskat_arbejdsgiverydelse_resultat_am_grundlag_kroner(resultat: PersonskatArbejdsgiverydelseResultat) -> match resultat {
    | BeregnetArbejdsgiverydelse(beregning) -> beregning.arbejdsmarkedsbidragsgrundlag_tillæg_kroner
    | _ -> 0
}
| personskat_arbejdsgiverydelse_resultat_am_grundlag_med_indeholdt_bidrag_kroner(resultat: PersonskatArbejdsgiverydelseResultat) -> match resultat {
    | BeregnetArbejdsgiverydelse(beregning) -> beregning.arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner
    | _ -> 0
}
| personskat_arbejdsgiverydelse_resultat_personlig_indkomst_uden_nyt_am_kroner(resultat: PersonskatArbejdsgiverydelseResultat) -> match resultat {
    | BeregnetArbejdsgiverydelse(beregning) -> beregning.personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner
    | _ -> 0
}
--@end:personskat_arbejdsgiverydelser--

= personskat_personligt_arbejdsvederlag_metadata = Metadata(
    attachments = (
        Source(value = personskatteloven_lbk1284_par3),
        DependencySource(value = arbejdsmarkedsbidragsloven_lbk121_par2),
        Guidance(value = skat_honorar_vejledning),
    )
)

--@label:personskat_personligt_arbejdsvederlag::meta:personskat_personligt_arbejdsvederlag_metadata--
----
Personskatteloven § 3, stk. 1:

Personlig indkomst omfatter alle de indkomster, der indgår i den
skattepligtige indkomst, og som ikke er kapitalindkomst.

Arbejdsmarkedsbidragsloven § 2, stk. 1, nr. 2:

2) Ethvert vederlag, som indgår i den personlige indkomst, i penge eller
naturalier modtaget uden for ansættelsesforhold, når der ikke er tale om
selvstændig erhvervsvirksomhed, herunder efterbetalinger m.v. i forbindelse
hermed samt den skattepligtige værdi af udbytter som nævnt i ligningslovens
§ 16 A, stk. 5.

Arbejdsmarkedsbidragsloven § 2, stk. 2:

Stk. 2. Vederlag i form af naturalier som nævnt i stk. 1 indgår i grundlaget
for arbejdsmarkedsbidrag med den skattepligtige værdi.

Ved naturalier forstås i denne lov:
1) Fri kost og logi.
2) Bil, som helt eller delvis vederlagsfrit stilles til rådighed for den
skattepligtige.
3) Fri telefon, herunder fri datakommunikationsforbindelse, jf. ligningslovens
§ 16, stk. 3, nr. 3, og stk. 12.
4) Fri sommerbolig omfattet af ligningslovens § 16, stk. 5, 2.-4. og 8. pkt.
5) Fri lystbåd omfattet af ligningslovens § 16, stk. 6, 2.-4. og 9. pkt.
6) Fri helårsbolig omfattet af ligningslovens § 16, stk. 9, bortset fra de
tilfælde, der er nævnt i ligningslovens § 16, stk. 9, 13. pkt.
7) Aktier, tegningsretter til aktier eller køberetter til aktier omfattet af
ligningslovens § 16 eller § 28, stk. 1 eller 2, jf. statsskattelovens § 4.
8) Arbejdsgiverbetalte sundhedsbehandlinger m.v. og den arbejdsgiverbetalte
præmie for forsikringer, der dækker de pågældende behandlinger m.v.
----

--@begin:personskat_personligt_arbejdsvederlag--
# PersonskatPersonligtArbejdsvederlagsforhold = PsArbejdeUdenAnsættelse | PsArbejdeIAnsættelse | PsSelvstændigtArbejde
# PersonskatPersonligtArbejdsvederlagsform = PsArbejdsvederlagIPenge | PsArbejdsvederlagINaturalie(art: ArbejdsmarkedsbidragNaturaliaArt)
# PersonskatPersonligtArbejdsvederlagFakta(identifikation: Tekst, indkomstår: Heltal, forhold: PersonskatPersonligtArbejdsvederlagsforhold, vederlagsform: PersonskatPersonligtArbejdsvederlagsform, skattepligtig_værdi_kroner: Heltal)
# PersonskatPersonligtArbejdsvederlagBeregning(fakta: PersonskatPersonligtArbejdsvederlagFakta, par3_indkomstpost: Par3Indkomstpost, par3_indkomstresultat_for_vederlaget: Par3PersonligIndkomstResultat, arbejdsmarkedsbidrag: ArbejdsmarkedsbidragLønmodtagerGrundlagResultat)
# PersonskatPersonligtArbejdsvederlagResultat = UgyldigtPersonligtArbejdsvederlag(fakta: PersonskatPersonligtArbejdsvederlagFakta, identifikation_unik: Boolsk, skatteår_matcher: Boolsk, grundfakta_gyldige: Boolsk) | PersonligtArbejdsvederlagUdenForPar2Stk1Nr2(fakta: PersonskatPersonligtArbejdsvederlagFakta) | BeregnetPersonligtArbejdsvederlag(beregning: PersonskatPersonligtArbejdsvederlagBeregning)

| personskat_personligt_arbejdsvederlagsform_gyldig(form: PersonskatPersonligtArbejdsvederlagsform) -> match form {
    | PsArbejdsvederlagIPenge -> Sandt
    | PsArbejdsvederlagINaturalie(art) -> arbejdsmarkedsbidrag_par2_stk2_naturalia_resultat(ArbejdsmarkedsbidragNaturaliaPost(
        art = art,
        skattepligtig_værdi_kroner = 0,
        nævnt_i_par2_stk1 = Sandt
    )).par2_stk2_art_omfattet
}
| personskat_personligt_arbejdsvederlag_grundfakta_gyldige(fakta: PersonskatPersonligtArbejdsvederlagFakta) -> fakta.identifikation != "" && fakta.indkomstår > 0 && fakta.skattepligtig_værdi_kroner >= 0 && personskat_personligt_arbejdsvederlagsform_gyldig(fakta.vederlagsform)
| personskat_personligt_arbejdsvederlag_omfattet_af_par2_stk1_nr2(fakta: PersonskatPersonligtArbejdsvederlagFakta) -> fakta.forhold == PsArbejdeUdenAnsættelse
| personskat_personligt_arbejdsvederlag_par3_indkomstpost(fakta: PersonskatPersonligtArbejdsvederlagFakta) -> Par3Indkomstpost(
    indgår_i_skattepligtig_indkomst = Sandt,
    er_kapitalindkomst = Falskt,
    beløb_kroner = fakta.skattepligtig_værdi_kroner
)
| personskat_personligt_arbejdsvederlag_am_input(fakta: PersonskatPersonligtArbejdsvederlagFakta) -> ArbejdsmarkedsbidragUdvidetLønmodtagerInput(
    ansættelsesvederlag_skatteværdi_kroner = 0,
    udenfor_ansættelse_skatteværdi_kroner = fakta.skattepligtig_værdi_kroner,
    rådighed_danmark_skatteværdi_kroner = 0,
    arbejdsgiver_pension_kroner = 0,
    udenlandsk_pension_kroner = 0,
    pbl14b_udbetaling_kroner = 0,
    fælles_firmapension_kroner = 0,
    sømandsvederlag_kroner = 0,
    biblioteksafgift_kroner = 0,
    ikke_skattepligtigt_vederlag_kroner = 0,
    pensionsindbetaling_af_ikke_skattepligtigt_vederlag_kroner = 0,
    obligatorisk_atp_pension_kroner = 0
)

# PersonskatPersonligtArbejdsvederlagSag(fakta: PersonskatPersonligtArbejdsvederlagFakta, skatteår: Heltal, identifikation_unik: Boolsk) {
    | grundfakta_gyldige() -> personskat_personligt_arbejdsvederlag_grundfakta_gyldige(fakta)
    | skatteår_matcher() -> fakta.indkomstår == skatteår
    | omfattet_af_par2_stk1_nr2() -> personskat_personligt_arbejdsvederlag_omfattet_af_par2_stk1_nr2(fakta)
    | par3_indkomstpost() -> personskat_personligt_arbejdsvederlag_par3_indkomstpost(fakta)
    | beregning() -> PersonskatPersonligtArbejdsvederlagBeregning(
        fakta = fakta,
        par3_indkomstpost = par3_indkomstpost(),
        par3_indkomstresultat_for_vederlaget = par3_personlig_indkomst_resultat(personskat_tomt_par3_personlig_indkomst_input([par3_indkomstpost()], [])),
        arbejdsmarkedsbidrag = arbejdsmarkedsbidrag_lønmodtager_grundlag_resultat(personskat_personligt_arbejdsvederlag_am_input(fakta))
    )
    | resultat() -> hvis identifikation_unik == Falskt || skatteår_matcher() == Falskt || grundfakta_gyldige() == Falskt {
        UgyldigtPersonligtArbejdsvederlag(
            fakta = fakta,
            identifikation_unik = identifikation_unik,
            skatteår_matcher = skatteår_matcher(),
            grundfakta_gyldige = grundfakta_gyldige()
        )
    } ellers hvis omfattet_af_par2_stk1_nr2() == Falskt {
        PersonligtArbejdsvederlagUdenForPar2Stk1Nr2(fakta = fakta)
    } ellers {
        BeregnetPersonligtArbejdsvederlag(beregning = beregning())
    }
}

| personskat_personligt_arbejdsvederlag_resultat(fakta: PersonskatPersonligtArbejdsvederlagFakta, skatteår: Heltal, identifikation_unik: Boolsk) -> PersonskatPersonligtArbejdsvederlagSag(
    fakta = fakta,
    skatteår = skatteår,
    identifikation_unik = identifikation_unik
).resultat()
| personskat_personligt_arbejdsvederlag_resultat_gyldigt(resultat: PersonskatPersonligtArbejdsvederlagResultat) -> match resultat {
    | UgyldigtPersonligtArbejdsvederlag(_, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_personligt_arbejdsvederlag_resultat_am_grundlag_kroner(resultat: PersonskatPersonligtArbejdsvederlagResultat) -> match resultat {
    | BeregnetPersonligtArbejdsvederlag(beregning) -> beregning.arbejdsmarkedsbidrag.grundlag_kroner
    | _ -> 0
}
--@end:personskat_personligt_arbejdsvederlag--

--@label:personskat_ordinaer_virksomhedsindkomst::meta:personskat_personlig_indkomst_kildefakta_metadata--
----
Personskatteloven § 3, stk. 2, nr. 1:

Ved opgørelsen af den personlige indkomst fradrages
1) udgifter, som i årets løb er anvendt til at erhverve, sikre og vedligeholde
indkomst ved selvstændig erhvervsvirksomhed, dog med undtagelse af de i § 4,
stk. 1, nr. 1, 2, 7 og 8, og ligningslovens §§ 9 G og 13 nævnte udgifter,

Arbejdsmarkedsbidragsloven § 4:

Grundlaget for arbejdsmarkedsbidrag for selvstændigt erhvervsdrivende, som
ikke anvender virksomhedsordningen i virksomhedsskattelovens afsnit I, udgør
den personlige indkomst ved selvstændig virksomhed, jf. personskattelovens § 3.

Ydelser i henhold til lov om biblioteksafgift medregnes ikke i grundlaget.

Stk. 2. Bidrag og præmier til pensionsordninger m.v. i samme omfang som nævnt i
pensionsbeskatningslovens § 18 samt bidrag efter denne lov fragår ikke ved
opgørelsen af grundlaget for arbejdsmarkedsbidraget.

Stk. 3. Negativ personlig indkomst, der er fremført efter personskattelovens
§ 13, stk. 3 og 4, fragår i grundlaget for arbejdsmarkedsbidraget.

Den del af den fremførte negative personlige indkomst, der hidrører fra bidrag
og præmier til pensionsordninger m.v. som nævnt i pensionsbeskatningslovens
§ 18, fragår dog ikke.
----

--@begin:personskat_ordinaer_virksomhedsindkomst--
# PersonskatVirksomhedsindtægtsart = OrdinærDriftsindtægt | KapitalindkomstEfterPersonskattelovensPar4 | AktieindkomstEfterPersonskattelovensPar4A | UklassificeretVirksomhedsindtægt
# PersonskatVirksomhedsindtægtFakta(identifikation: Tekst, art: PersonskatVirksomhedsindtægtsart, beløb_kroner: Heltal)
# PersonskatVirksomhedsudgiftFakta(identifikation: Tekst, afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning, beløb_kroner: Heltal)
# PersonskatOrdinærVirksomhedFakta(identifikation: Tekst, indkomstår: Heltal, indtægter: List(PersonskatVirksomhedsindtægtFakta), udgifter: List(PersonskatVirksomhedsudgiftFakta))
# PersonskatOrdinærVirksomhedBeregning(fakta: PersonskatOrdinærVirksomhedFakta, par3_input_for_virksomheden: Par3PersonligIndkomstInput, par3_indkomstresultat_for_virksomheden: Par3PersonligIndkomstResultat, arbejdsmarkedsbidrag_input_for_virksomheden: ArbejdsmarkedsbidragSelvstændigInput, arbejdsmarkedsbidragsgrundlag_tillæg_kroner: Heltal, personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner: Heltal)
# PersonskatOrdinærVirksomhedResultat = UgyldigOrdinærVirksomhed(fakta: PersonskatOrdinærVirksomhedFakta, identifikation_unik: Boolsk, skatteår_matcher: Boolsk, grundfakta_gyldige: Boolsk) | IkkeUnderstøttetOrdinærVirksomhed(fakta: PersonskatOrdinærVirksomhedFakta, indtægtsarter_understøttet: Boolsk, udgiftsafgrænsninger_understøttet: Boolsk) | BeregnetOrdinærVirksomhed(beregning: PersonskatOrdinærVirksomhedBeregning)

| personskat_virksomhedsindtægt_grundfakta_gyldige(fakta: PersonskatVirksomhedsindtægtFakta) -> fakta.identifikation != "" && fakta.beløb_kroner >= 0
| personskat_virksomhedsudgift_grundfakta_gyldige(fakta: PersonskatVirksomhedsudgiftFakta) -> fakta.identifikation != "" && fakta.beløb_kroner >= 0
| personskat_virksomhedsindtægt_understøttet(fakta: PersonskatVirksomhedsindtægtFakta) -> fakta.art == OrdinærDriftsindtægt
| personskat_virksomhedsudgift_understøttet(fakta: PersonskatVirksomhedsudgiftFakta) -> fakta.afgrænsning == SelvstændigErhvervsindkomstUdgift
| personskat_virksomhed_postidentifikationer(fakta: PersonskatOrdinærVirksomhedFakta) -> concat(
    map(fakta.indtægter, |indtægt: PersonskatVirksomhedsindtægtFakta| indtægt.identifikation),
    map(fakta.udgifter, |udgift: PersonskatVirksomhedsudgiftFakta| udgift.identifikation)
)
| personskat_virksomhed_postidentifikationer_entydige(fakta: PersonskatOrdinærVirksomhedFakta) -> length(distinct(personskat_virksomhed_postidentifikationer(fakta))) == length(personskat_virksomhed_postidentifikationer(fakta))
| personskat_virksomhed_grundfakta_gyldige(fakta: PersonskatOrdinærVirksomhedFakta) -> fakta.identifikation != "" && length(fakta.indtægter) + length(fakta.udgifter) > 0 && personskat_virksomhed_postidentifikationer_entydige(fakta) && all(fakta.indtægter, personskat_virksomhedsindtægt_grundfakta_gyldige) && all(fakta.udgifter, personskat_virksomhedsudgift_grundfakta_gyldige)
| personskat_virksomhed_indtægtsarter_understøttet(fakta: PersonskatOrdinærVirksomhedFakta) -> all(fakta.indtægter, personskat_virksomhedsindtægt_understøttet)
| personskat_virksomhed_udgiftsafgrænsninger_understøttet(fakta: PersonskatOrdinærVirksomhedFakta) -> all(fakta.udgifter, personskat_virksomhedsudgift_understøttet)
| personskat_virksomhedsindtægt_par3_indkomstpost(fakta: PersonskatVirksomhedsindtægtFakta) -> Par3Indkomstpost(
    indgår_i_skattepligtig_indkomst = Sandt,
    er_kapitalindkomst = fakta.art != OrdinærDriftsindtægt,
    beløb_kroner = fakta.beløb_kroner
)
| personskat_virksomhedsudgift_par3_stk2_nr1(fakta: PersonskatVirksomhedsudgiftFakta) -> Par3Stk2Nr1UdgiftInput(
    afgrænsning = fakta.afgrænsning,
    beløb_kroner = fakta.beløb_kroner
)
| personskat_virksomhed_par3_input(fakta: PersonskatOrdinærVirksomhedFakta) -> personskat_tomt_par3_personlig_indkomst_input(
    map(fakta.indtægter, personskat_virksomhedsindtægt_par3_indkomstpost),
    map(fakta.udgifter, personskat_virksomhedsudgift_par3_stk2_nr1)
)
| personskat_virksomhed_arbejdsmarkedsbidrag_input(par3_resultat: Par3PersonligIndkomstResultat) -> ArbejdsmarkedsbidragSelvstændigInput(
    personlig_indkomst_ved_selvstændig_virksomhed_kroner = par3_resultat.netto_personlig_indkomst_kroner,
    biblioteksafgift_kroner = 0,
    fremført_negativ_personlig_indkomst_kroner = 0,
    fremført_negativ_personlig_indkomst_fra_pension_kroner = 0
)
| personskat_virksomhed_personlig_indkomst_uden_nyt_am_kroner(par3_resultat: Par3PersonligIndkomstResultat) -> hvis par3_resultat.netto_personlig_indkomst_kroner < 0 { par3_resultat.netto_personlig_indkomst_kroner } ellers { 0 }
| personskat_virksomhed_beregning(fakta: PersonskatOrdinærVirksomhedFakta) -> {
    = par3_input = personskat_virksomhed_par3_input(fakta)
    = par3_resultat = par3_personlig_indkomst_resultat(par3_input)
    = arbejdsmarkedsbidrag_input = personskat_virksomhed_arbejdsmarkedsbidrag_input(par3_resultat)
    PersonskatOrdinærVirksomhedBeregning(
        fakta = fakta,
        par3_input_for_virksomheden = par3_input,
        par3_indkomstresultat_for_virksomheden = par3_resultat,
        arbejdsmarkedsbidrag_input_for_virksomheden = arbejdsmarkedsbidrag_input,
        arbejdsmarkedsbidragsgrundlag_tillæg_kroner = arbejdsmarkedsbidrag_selvstændig_uden_virksomhedsordning_grundlag_kroner(arbejdsmarkedsbidrag_input),
        personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner = personskat_virksomhed_personlig_indkomst_uden_nyt_am_kroner(par3_resultat)
    )
}
| personskat_virksomhed_resultat(fakta: PersonskatOrdinærVirksomhedFakta, skatteår: Heltal, identifikation_unik: Boolsk) -> hvis identifikation_unik == Falskt || fakta.indkomstår != skatteår || personskat_virksomhed_grundfakta_gyldige(fakta) == Falskt {
    UgyldigOrdinærVirksomhed(
        fakta = fakta,
        identifikation_unik = identifikation_unik,
        skatteår_matcher = fakta.indkomstår == skatteår,
        grundfakta_gyldige = personskat_virksomhed_grundfakta_gyldige(fakta)
    )
} ellers hvis personskat_virksomhed_indtægtsarter_understøttet(fakta) == Falskt || personskat_virksomhed_udgiftsafgrænsninger_understøttet(fakta) == Falskt {
    IkkeUnderstøttetOrdinærVirksomhed(
        fakta = fakta,
        indtægtsarter_understøttet = personskat_virksomhed_indtægtsarter_understøttet(fakta),
        udgiftsafgrænsninger_understøttet = personskat_virksomhed_udgiftsafgrænsninger_understøttet(fakta)
    )
} ellers {
    BeregnetOrdinærVirksomhed(beregning = personskat_virksomhed_beregning(fakta))
}
| personskat_virksomhed_resultat_gyldigt(resultat: PersonskatOrdinærVirksomhedResultat) -> match resultat {
    | BeregnetOrdinærVirksomhed(_) -> Sandt
    | _ -> Falskt
}
| personskat_virksomhed_resultat_am_grundlag_kroner(resultat: PersonskatOrdinærVirksomhedResultat) -> match resultat {
    | BeregnetOrdinærVirksomhed(beregning) -> beregning.arbejdsmarkedsbidragsgrundlag_tillæg_kroner
    | _ -> 0
}
| personskat_virksomhed_resultat_personlig_indkomst_uden_nyt_am_kroner(resultat: PersonskatOrdinærVirksomhedResultat) -> match resultat {
    | BeregnetOrdinærVirksomhed(beregning) -> beregning.personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner
    | _ -> 0
}
--@end:personskat_ordinaer_virksomhedsindkomst--

--@begin:personskat_personlig_indkomst_kildefakta--
# PersonskatForeningsOgArbejdsløshedsydelseFakta = PersonskatForeningsydelseEfterLigningslov13(fakta: Ligningslov13ForeningsydelseFakta) | PersonskatArbejdsløshedsforsikringsudbetalingEfterPbl49(fakta: Pbl49ArbejdsløshedsforsikringsudbetalingFakta)
# PersonskatForeningsOgArbejdsløshedsydelseResultat = UgyldigForeningsEllerArbejdsløshedsydelse(fakta: PersonskatForeningsOgArbejdsløshedsydelseFakta, identifikation_unik: Boolsk, skatteår_matcher: Boolsk) | BeregnetForeningsydelseEfterLigningslov13(resultat: Ligningslov13ForeningsydelseResultat) | BeregnetArbejdsløshedsforsikringsudbetalingEfterPbl49(resultat: Pbl49ArbejdsløshedsforsikringsudbetalingResultat)
# PersonskatOrdinærPersonligIndkomstInput(arbejdsgiverydelser: List(PersonskatArbejdsgiverydelseFakta), personlige_arbejdsvederlag: List(PersonskatPersonligtArbejdsvederlagFakta), virksomheder_uden_virksomhedsordning: List(PersonskatOrdinærVirksomhedFakta), forenings_og_arbejdsløshedsydelser: List(PersonskatForeningsOgArbejdsløshedsydelseFakta))
# PersonskatOrdinærPersonligIndkomstResultat(input: PersonskatOrdinærPersonligIndkomstInput, arbejdsgiverydelser: List(PersonskatArbejdsgiverydelseResultat), personlige_arbejdsvederlag: List(PersonskatPersonligtArbejdsvederlagResultat), virksomheder_uden_virksomhedsordning: List(PersonskatOrdinærVirksomhedResultat), forenings_og_arbejdsløshedsydelser: List(PersonskatForeningsOgArbejdsløshedsydelseResultat), arbejdsgiverydelsesidentifikationer_entydige: Boolsk, personlige_arbejdsvederlagsidentifikationer_entydige: Boolsk, virksomhedsidentifikationer_entydige: Boolsk, forenings_og_arbejdsløshedsydelsesidentifikationer_entydige: Boolsk, alle_input_gyldige: Boolsk, arbejdsmarkedsbidragsgrundlag_tillæg_kroner: Heltal, arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner: Heltal, personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner: Heltal)
# PersonskatPersonligIndkomstInput(etableringskonto: PersonskatEtableringskontoInput, ordinære_forhold: PersonskatOrdinærPersonligIndkomstInput, arbejdsudleje: List(KildeskattelovArbejdsudlejeInput), underholdsbidrag: Ligningslov10Og11Årsinput, børnebidragslov19_bidrag: Børnebidragslov19Årsinput, sømandsbeskatning: Søbl5Til8Årsinput)
# PersonskatPersonligIndkomstResultat(input: PersonskatPersonligIndkomstInput, etableringskonto: PersonskatEtableringskontoResultat, ordinære_forhold: PersonskatOrdinærPersonligIndkomstResultat, arbejdsudleje: List(KildeskattelovArbejdsudlejeResultat), arbejdsudlejeidentifikationer_entydige: Boolsk, underholdsbidrag: Ligningslov10Og11Årsresultat, børnebidragslov19_bidrag: Børnebidragslov19Årsresultat, sømandsbeskatning: Søbl5Til8Årsresultat, alle_input_gyldige: Boolsk, arbejdsmarkedsbidragsgrundlag_tillæg_kroner: Heltal, arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner: Heltal, personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner: Heltal, fradrag_i_personlig_indkomst_kroner: Heltal, ligningsmæssigt_fradrag_kroner: Heltal, endeligt_arbejdsmarkedsbidrag_fra_arbejdsudleje_kroner: Heltal, endelig_arbejdsudlejeskat_kroner: Heltal, samlet_endelig_arbejdsudlejebeskatning_kroner: Heltal)

| personskat_ingen_ordinær_personlig_indkomst() -> PersonskatOrdinærPersonligIndkomstInput(
    arbejdsgiverydelser = [],
    personlige_arbejdsvederlag = [],
    virksomheder_uden_virksomhedsordning = [],
    forenings_og_arbejdsløshedsydelser = []
)
| personskat_ingen_personlig_indkomst() -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = personskat_ingen_ordinær_personlig_indkomst(),
    arbejdsudleje = [],
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| personskat_arbejdsgiverydelsesidentifikationer_entydige(fakta: List(PersonskatArbejdsgiverydelseFakta)) -> length(distinct(map(fakta, |post: PersonskatArbejdsgiverydelseFakta| post.identifikation))) == length(fakta)
| personskat_personlige_arbejdsvederlagsidentifikationer_entydige(fakta: List(PersonskatPersonligtArbejdsvederlagFakta)) -> length(distinct(map(fakta, |post: PersonskatPersonligtArbejdsvederlagFakta| post.identifikation))) == length(fakta)
| personskat_arbejdsudlejeidentifikationer_entydige(fakta: List(KildeskattelovArbejdsudlejeInput)) -> length(distinct(map(fakta, |post: KildeskattelovArbejdsudlejeInput| post.identifikation))) == length(fakta)
| personskat_virksomhedsidentifikationer_entydige(fakta: List(PersonskatOrdinærVirksomhedFakta)) -> length(distinct(map(fakta, |virksomhed: PersonskatOrdinærVirksomhedFakta| virksomhed.identifikation))) == length(fakta)
| personskat_forenings_og_arbejdsløshedsydelse_identifikation(fakta: PersonskatForeningsOgArbejdsløshedsydelseFakta) -> match fakta {
    | PersonskatForeningsydelseEfterLigningslov13(ydelse) -> ydelse.identifikation
    | PersonskatArbejdsløshedsforsikringsudbetalingEfterPbl49(ydelse) -> ydelse.identifikation
}
| personskat_forenings_og_arbejdsløshedsydelse_indkomstår(fakta: PersonskatForeningsOgArbejdsløshedsydelseFakta) -> match fakta {
    | PersonskatForeningsydelseEfterLigningslov13(ydelse) -> ydelse.indkomstår
    | PersonskatArbejdsløshedsforsikringsudbetalingEfterPbl49(ydelse) -> ydelse.indkomstår
}
| personskat_forenings_og_arbejdsløshedsydelsesidentifikationer_entydige(fakta: List(PersonskatForeningsOgArbejdsløshedsydelseFakta)) -> length(distinct(map(fakta, personskat_forenings_og_arbejdsløshedsydelse_identifikation))) == length(fakta)
| personskat_arbejdsgiverydelse_resultater(fakta: List(PersonskatArbejdsgiverydelseFakta), skatteår: Heltal, identifikationer_entydige: Boolsk) -> map(fakta, |post: PersonskatArbejdsgiverydelseFakta| personskat_arbejdsgiverydelse_resultat(post, skatteår, identifikationer_entydige))
| personskat_personligt_arbejdsvederlag_resultater(fakta: List(PersonskatPersonligtArbejdsvederlagFakta), skatteår: Heltal, identifikationer_entydige: Boolsk) -> map(fakta, |post: PersonskatPersonligtArbejdsvederlagFakta| personskat_personligt_arbejdsvederlag_resultat(post, skatteår, identifikationer_entydige))
| personskat_arbejdsudlejeresultater(fakta: List(KildeskattelovArbejdsudlejeInput)) -> map(fakta, |post: KildeskattelovArbejdsudlejeInput| kildeskat_arbejdsudleje_resultat(post))
| personskat_virksomhed_resultater(fakta: List(PersonskatOrdinærVirksomhedFakta), skatteår: Heltal, identifikationer_entydige: Boolsk) -> map(fakta, |virksomhed: PersonskatOrdinærVirksomhedFakta| personskat_virksomhed_resultat(virksomhed, skatteår, identifikationer_entydige))
| personskat_forenings_og_arbejdsløshedsydelse_resultat(fakta: PersonskatForeningsOgArbejdsløshedsydelseFakta, skatteår: Heltal, identifikation_unik: Boolsk) -> hvis identifikation_unik == Falskt || personskat_forenings_og_arbejdsløshedsydelse_indkomstår(fakta) != skatteår {
    UgyldigForeningsEllerArbejdsløshedsydelse(
        fakta = fakta,
        identifikation_unik = identifikation_unik,
        skatteår_matcher = personskat_forenings_og_arbejdsløshedsydelse_indkomstår(fakta) == skatteår
    )
} ellers {
    match fakta {
        | PersonskatForeningsydelseEfterLigningslov13(ydelse) -> BeregnetForeningsydelseEfterLigningslov13(resultat = ligningslov13_foreningsydelse_resultat(ydelse))
        | PersonskatArbejdsløshedsforsikringsudbetalingEfterPbl49(ydelse) -> BeregnetArbejdsløshedsforsikringsudbetalingEfterPbl49(resultat = pbl49_arbejdsløshedsforsikringsudbetaling_resultat(ydelse))
    }
}
| personskat_forenings_og_arbejdsløshedsydelse_resultater(fakta: List(PersonskatForeningsOgArbejdsløshedsydelseFakta), skatteår: Heltal, identifikationer_entydige: Boolsk) -> map(fakta, |ydelse: PersonskatForeningsOgArbejdsløshedsydelseFakta| personskat_forenings_og_arbejdsløshedsydelse_resultat(ydelse, skatteår, identifikationer_entydige))
| personskat_forenings_og_arbejdsløshedsydelse_resultat_gyldigt(resultat: PersonskatForeningsOgArbejdsløshedsydelseResultat) -> match resultat {
    | BeregnetForeningsydelseEfterLigningslov13(kilde) -> kilde.kan_sammensættes
    | BeregnetArbejdsløshedsforsikringsudbetalingEfterPbl49(kilde) -> kilde.kan_sammensættes
    | _ -> Falskt
}
| personskat_forenings_og_arbejdsløshedsydelse_skattepligtigt_beløb_kroner(resultat: PersonskatForeningsOgArbejdsløshedsydelseResultat) -> match resultat {
    | BeregnetForeningsydelseEfterLigningslov13(kilde) -> hvis kilde.kan_sammensættes { kilde.skattepligtigt_beløb_kroner } ellers { 0 }
    | BeregnetArbejdsløshedsforsikringsudbetalingEfterPbl49(kilde) -> hvis kilde.kan_sammensættes { kilde.skattepligtigt_beløb_kroner } ellers { 0 }
    | _ -> 0
}

# PersonskatOrdinærPersonligIndkomstSag(input: PersonskatOrdinærPersonligIndkomstInput, skatteår: Heltal) {
    | arbejdsgiverydelsesidentifikationer_entydige() -> personskat_arbejdsgiverydelsesidentifikationer_entydige(input.arbejdsgiverydelser)
    | personlige_arbejdsvederlagsidentifikationer_entydige() -> personskat_personlige_arbejdsvederlagsidentifikationer_entydige(input.personlige_arbejdsvederlag)
    | virksomhedsidentifikationer_entydige() -> personskat_virksomhedsidentifikationer_entydige(input.virksomheder_uden_virksomhedsordning)
    | forenings_og_arbejdsløshedsydelsesidentifikationer_entydige() -> personskat_forenings_og_arbejdsløshedsydelsesidentifikationer_entydige(input.forenings_og_arbejdsløshedsydelser)
    | arbejdsgiverydelser() -> personskat_arbejdsgiverydelse_resultater(input.arbejdsgiverydelser, skatteår, arbejdsgiverydelsesidentifikationer_entydige())
    | personlige_arbejdsvederlag() -> personskat_personligt_arbejdsvederlag_resultater(input.personlige_arbejdsvederlag, skatteår, personlige_arbejdsvederlagsidentifikationer_entydige())
    | virksomheder() -> personskat_virksomhed_resultater(input.virksomheder_uden_virksomhedsordning, skatteår, virksomhedsidentifikationer_entydige())
    | forenings_og_arbejdsløshedsydelser() -> personskat_forenings_og_arbejdsløshedsydelse_resultater(input.forenings_og_arbejdsløshedsydelser, skatteår, forenings_og_arbejdsløshedsydelsesidentifikationer_entydige())
    | alle_input_gyldige() -> all(arbejdsgiverydelser(), personskat_arbejdsgiverydelse_resultat_gyldigt) && all(personlige_arbejdsvederlag(), personskat_personligt_arbejdsvederlag_resultat_gyldigt) && all(virksomheder(), personskat_virksomhed_resultat_gyldigt) && all(forenings_og_arbejdsløshedsydelser(), personskat_forenings_og_arbejdsløshedsydelse_resultat_gyldigt)
    | arbejdsmarkedsbidragsgrundlag_tillæg_kroner() -> foldl(arbejdsgiverydelser(), 0, |sum_kroner: Heltal, resultat: PersonskatArbejdsgiverydelseResultat| sum_kroner + personskat_arbejdsgiverydelse_resultat_am_grundlag_kroner(resultat)) + foldl(personlige_arbejdsvederlag(), 0, |sum_kroner: Heltal, resultat: PersonskatPersonligtArbejdsvederlagResultat| sum_kroner + personskat_personligt_arbejdsvederlag_resultat_am_grundlag_kroner(resultat)) + foldl(virksomheder(), 0, |sum_kroner: Heltal, resultat: PersonskatOrdinærVirksomhedResultat| sum_kroner + personskat_virksomhed_resultat_am_grundlag_kroner(resultat))
    | arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner() -> foldl(arbejdsgiverydelser(), 0, |sum_kroner: Heltal, resultat: PersonskatArbejdsgiverydelseResultat| sum_kroner + personskat_arbejdsgiverydelse_resultat_am_grundlag_med_indeholdt_bidrag_kroner(resultat))
    | personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner() -> foldl(arbejdsgiverydelser(), 0, |sum_kroner: Heltal, resultat: PersonskatArbejdsgiverydelseResultat| sum_kroner + personskat_arbejdsgiverydelse_resultat_personlig_indkomst_uden_nyt_am_kroner(resultat)) + foldl(virksomheder(), 0, |sum_kroner: Heltal, resultat: PersonskatOrdinærVirksomhedResultat| sum_kroner + personskat_virksomhed_resultat_personlig_indkomst_uden_nyt_am_kroner(resultat)) + foldl(forenings_og_arbejdsløshedsydelser(), 0, |sum_kroner: Heltal, resultat: PersonskatForeningsOgArbejdsløshedsydelseResultat| sum_kroner + personskat_forenings_og_arbejdsløshedsydelse_skattepligtigt_beløb_kroner(resultat))
    | resultat() -> PersonskatOrdinærPersonligIndkomstResultat(
        input = input,
        arbejdsgiverydelser = arbejdsgiverydelser(),
        personlige_arbejdsvederlag = personlige_arbejdsvederlag(),
        virksomheder_uden_virksomhedsordning = virksomheder(),
        forenings_og_arbejdsløshedsydelser = forenings_og_arbejdsløshedsydelser(),
        arbejdsgiverydelsesidentifikationer_entydige = arbejdsgiverydelsesidentifikationer_entydige(),
        personlige_arbejdsvederlagsidentifikationer_entydige = personlige_arbejdsvederlagsidentifikationer_entydige(),
        virksomhedsidentifikationer_entydige = virksomhedsidentifikationer_entydige(),
        forenings_og_arbejdsløshedsydelsesidentifikationer_entydige = forenings_og_arbejdsløshedsydelsesidentifikationer_entydige(),
        alle_input_gyldige = alle_input_gyldige(),
        arbejdsmarkedsbidragsgrundlag_tillæg_kroner = arbejdsmarkedsbidragsgrundlag_tillæg_kroner(),
        arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner = arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner(),
        personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner = personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner()
    )
}

| personskat_ordinær_personlig_indkomst_resultat(input: PersonskatOrdinærPersonligIndkomstInput, skatteår: Heltal) -> PersonskatOrdinærPersonligIndkomstSag(input, skatteår).resultat()

# PersonskatPersonligIndkomstSag(input: PersonskatPersonligIndkomstInput, skatteår: Heltal) {
    | etableringskonto() -> personskat_etableringskonto_resultat(input.etableringskonto, skatteår)
    | ordinære_forhold() -> personskat_ordinær_personlig_indkomst_resultat(input.ordinære_forhold, skatteår)
    | arbejdsudlejeidentifikationer_entydige() -> personskat_arbejdsudlejeidentifikationer_entydige(input.arbejdsudleje)
    | arbejdsudleje() -> personskat_arbejdsudlejeresultater(input.arbejdsudleje)
    | arbejdsudleje_alle_gyldige() -> arbejdsudlejeidentifikationer_entydige() && all(arbejdsudleje(), |resultat: KildeskattelovArbejdsudlejeResultat| resultat.kan_sammensættes)
    | arbejdsudleje_ordinært_am_grundlag_kroner() -> hvis arbejdsudlejeidentifikationer_entydige() { foldl(arbejdsudleje(), 0, |sum_kroner: Heltal, resultat: KildeskattelovArbejdsudlejeResultat| sum_kroner + resultat.ordinært_arbejdsmarkedsbidragsgrundlag_kroner) } ellers { 0 }
    | arbejdsudleje_ordinært_personligt_fradrag_kroner() -> hvis arbejdsudlejeidentifikationer_entydige() { foldl(arbejdsudleje(), 0, |sum_kroner: Heltal, resultat: KildeskattelovArbejdsudlejeResultat| sum_kroner + resultat.ordinært_fradrag_i_personlig_indkomst_kroner) } ellers { 0 }
    | arbejdsudleje_endeligt_am_kroner() -> hvis arbejdsudlejeidentifikationer_entydige() { foldl(arbejdsudleje(), 0, |sum_kroner: Heltal, resultat: KildeskattelovArbejdsudlejeResultat| sum_kroner + resultat.endeligt_arbejdsmarkedsbidrag_kroner) } ellers { 0 }
    | arbejdsudleje_endelig_indkomstskat_kroner() -> hvis arbejdsudlejeidentifikationer_entydige() { foldl(arbejdsudleje(), 0, |sum_kroner: Heltal, resultat: KildeskattelovArbejdsudlejeResultat| sum_kroner + resultat.endelig_arbejdsudlejeskat_kroner) } ellers { 0 }
    | underholdsbidrag() -> ligningslov10_11_årsresultat(skatteår, input.underholdsbidrag)
    | børnebidragslov19_bidrag() -> børnebidragslov19_årsresultat(skatteår, input.børnebidragslov19_bidrag)
    | sømandsbeskatning() -> søbl5_til8_årsresultat(skatteår, input.sømandsbeskatning)
    | resultat() -> PersonskatPersonligIndkomstResultat(
        input = input,
        etableringskonto = etableringskonto(),
        ordinære_forhold = ordinære_forhold(),
        arbejdsudleje = arbejdsudleje(),
        arbejdsudlejeidentifikationer_entydige = arbejdsudlejeidentifikationer_entydige(),
        underholdsbidrag = underholdsbidrag(),
        børnebidragslov19_bidrag = børnebidragslov19_bidrag(),
        sømandsbeskatning = sømandsbeskatning(),
        alle_input_gyldige = personskat_etableringskonto_input_gyldigt(etableringskonto()) && ordinære_forhold().alle_input_gyldige && arbejdsudleje_alle_gyldige() && underholdsbidrag().kan_sammensættes && børnebidragslov19_bidrag().kan_sammensættes && sømandsbeskatning().alle_input_gyldige && sømandsbeskatning().beregningsklar && sømandsbeskatning().kanonisk_fuld_skattepligt_understøttet,
        arbejdsmarkedsbidragsgrundlag_tillæg_kroner = ordinære_forhold().arbejdsmarkedsbidragsgrundlag_tillæg_kroner + arbejdsudleje_ordinært_am_grundlag_kroner() + sømandsbeskatning().samlet_ordinær_bruttoløn_kroner + sømandsbeskatning().samlet_anden_ligningslov7u_indkomst_efter_bundfradrag_kroner,
        arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner = ordinære_forhold().arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner,
        personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner = ordinære_forhold().personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner + underholdsbidrag().samlet_personlig_indkomst_kroner + børnebidragslov19_bidrag().samlet_personlig_indkomst_kroner + sømandsbeskatning().samlet_dis_personlig_indkomst_kroner,
        fradrag_i_personlig_indkomst_kroner = personskat_etableringskonto_personligt_fradrag_kroner(etableringskonto()) + arbejdsudleje_ordinært_personligt_fradrag_kroner(),
        ligningsmæssigt_fradrag_kroner = personskat_etableringskonto_ligningsfradrag_kroner(etableringskonto()) + underholdsbidrag().samlet_ligningsmæssigt_fradrag_kroner + børnebidragslov19_bidrag().samlet_ligningsmæssigt_fradrag_kroner,
        endeligt_arbejdsmarkedsbidrag_fra_arbejdsudleje_kroner = arbejdsudleje_endeligt_am_kroner(),
        endelig_arbejdsudlejeskat_kroner = arbejdsudleje_endelig_indkomstskat_kroner(),
        samlet_endelig_arbejdsudlejebeskatning_kroner = arbejdsudleje_endeligt_am_kroner() + arbejdsudleje_endelig_indkomstskat_kroner()
    )
}

| personskat_personlig_indkomst_resultat(input: PersonskatPersonligIndkomstInput, skatteår: Heltal) -> PersonskatPersonligIndkomstSag(input, skatteår).resultat()
--@end:personskat_personlig_indkomst_kildefakta--
