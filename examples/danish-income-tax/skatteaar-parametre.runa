| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(
    skatteår = 2025,
    kommune = København,
    kommunekode = 101,
    kommuneskat_basispoint = 2350,
    kirkeskat_basispoint = 80,
