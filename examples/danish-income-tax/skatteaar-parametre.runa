| nationalparametre_værdi_for(skatteår: Heltal) -> NationalParametre(
    skatteår = 2025,
    bundskat_basispoint = 1201,
    topskat_basispoint = 1500,
    topskattegrænse_efter_am_kroner = 611800,
    mellemskat_basispoint = 0,
    mellemskattegrænse_efter_am_kroner = 0,
    toptopskat_basispoint = 0,
    toptopskattegrænse_efter_am_kroner = 0,
    am_bidrag_basispoint = 800,
    personfradrag_voksen_kroner = 51600,
    personfradrag_under18_kroner = 51600,
    aktieindkomst_progressionsgrænse_kroner = 67500,
    aktieindkomst_lav_basispoint = 2700,
    aktieindkomst_høj_basispoint = 4200,
    positiv_nettokapital_progressiv_bundfradrag_kroner = 52400,
    skatteloft_personlig_basispoint = 5207,
    skatteloft_positiv_nettokapital_basispoint = 4200
) under skatteår == 2025

----
Skattestyrelsen, "Se alle skattesatser for i år og de forudgående år"
Kategori: Skat
År: 2026

Aktieindkomst (progressionsgrænse): 79.400 kr.
Aktieindkomst (skattesatser under/over progressionsgrænsen): 27/42 %
Am-bidrag (arbejdsmarkedsbidrag): 8 %
Bundfradrag i positiv nettokapitalindkomst i mellemskattegrundlaget: 55.000 kr.
Bundskat: 12,01%
Mellemskat (fra 2026) / skattegrænse efter am-bidrag er fratrukket: 7,5 % / 641.200 kr.
Personfradrag (fyldt 18 år): 54.100 kr.
Personfradrag (under 18 år): 54.100 kr.
Skatteloft (personlig indkomst): 44,57%
Skatteloft (positiv nettokapitalindkomst): 42%
Topskat (fra 2026) / skattegrænse efter am-bidrag er fratrukket: 7,5 % / 777.900 kr.
Toptopskat (fra 2026) / skattegrænse efter am-bidrag er fratrukket: 5 % / 2.592.700 kr.
----

| nationalparametre_værdi_for(skatteår: Heltal) -> NationalParametre(
    skatteår = 2026,
    bundskat_basispoint = 1201,
    topskat_basispoint = 750,
    topskattegrænse_efter_am_kroner = 777900,
    mellemskat_basispoint = 750,
    mellemskattegrænse_efter_am_kroner = 641200,
    toptopskat_basispoint = 500,
    toptopskattegrænse_efter_am_kroner = 2592700,
    am_bidrag_basispoint = 800,
    personfradrag_voksen_kroner = 54100,
    personfradrag_under18_kroner = 54100,
    aktieindkomst_progressionsgrænse_kroner = 79400,
    aktieindkomst_lav_basispoint = 2700,
    aktieindkomst_høj_basispoint = 4200,
    positiv_nettokapital_progressiv_bundfradrag_kroner = 55000,
    skatteloft_personlig_basispoint = 4457,
    skatteloft_positiv_nettokapital_basispoint = 4200
) under skatteår == 2026

| nationalparametre_kilde(skatteår: Heltal) -> SkattestyrelsenSatserSkat2024 under skatteår == 2024
| nationalparametre_kilde(skatteår: Heltal) -> SkattestyrelsenSatserSkat2025 under skatteår == 2025
| nationalparametre_kilde(skatteår: Heltal) -> SkattestyrelsenSatserSkat2026 under skatteår == 2026
| nationalparametre_resultat(skatteår: Heltal) -> NationalParametreResultat(
    skatteår = skatteår,
    kilde = nationalparametre_kilde(skatteår),
    parametre = nationalparametre_værdi_for(skatteår)
) under skatteår_understøttet(skatteår)
| nationalparametre_for(skatteår: Heltal) -> nationalparametre_resultat(skatteår).parametre

| skatteår_understøttet(skatteår: Heltal) -> Falskt
| exception skatteår_2024 skatteår_understøttet(skatteår: Heltal) -> Sandt under skatteår == 2024
| exception skatteår_2025 skatteår_understøttet(skatteår: Heltal) -> Sandt under skatteår == 2025
| exception skatteår_2026 skatteår_understøttet(skatteår: Heltal) -> Sandt under skatteår == 2026

| skatteår_parameterpakke_resultat(skatteår: Heltal, kommune: Kommune) -> SkatteårParameterpakkeResultat(
    skatteår = skatteår,
    kommune = kommune,
    national_kilde = nationalparametre_resultat(skatteår).kilde,
    kommunal_kilde = kommunale_parametre_resultat(skatteår, kommune).kilde,
    pakke = SkatteårParameterpakke(
        nationale = nationalparametre_for(skatteår),
        kommunale = kommunale_parametre_for(skatteår, kommune)
    )
) under parameterpakke_komplet(skatteår, kommune)
| skatteår_parameterpakke_for(skatteår: Heltal, kommune: Kommune) -> skatteår_parameterpakke_resultat(skatteår, kommune).pakke

| samlet_indkomstskatteprocent_basispoint(kommunale: KommunaleParametre) -> kommunale.kommuneskat_basispoint + kommunale.kirkeskat_basispoint + kommunale.sundhedsbidrag_basispoint + kommunale.bundskat_basispoint - kommunale.skatteloftsnedslag_basispoint
| parameterpakke_komplet(skatteår: Heltal, kommune: Kommune) -> skatteår_understøttet(skatteår) && kommune_understøttet_i_år(skatteår, kommune)

= m3_2024_national_resultat = nationalparametre_resultat(2024)
= m3_2026_national_resultat = nationalparametre_resultat(2026)
= m3_2024_national = nationalparametre_for(2024)
= m3_2025_national = nationalparametre_for(2025)
= m3_2026_national = nationalparametre_for(2026)
= m3_2025_gentofte_resultat = kommunale_parametre_resultat(2025, Gentofte)
= m3_2025_frederiksberg_resultat = kommunale_parametre_resultat(2025, Frederiksberg)
= m3_2026_langeland_resultat = kommunale_parametre_resultat(2026, Langeland)
= m3_2024_københavn = kommunale_parametre_for(2024, København)
= m3_2025_gentofte = kommunale_parametre_for(2025, Gentofte)
= m3_2025_frederiksberg = kommunale_parametre_for(2025, Frederiksberg)
= m3_2026_københavn = kommunale_parametre_for(2026, København)
= m3_2026_gentofte = kommunale_parametre_for(2026, Gentofte)
= m3_2026_langeland = kommunale_parametre_for(2026, Langeland)
= m3_2024_københavn_samlet = samlet_indkomstskatteprocent_basispoint(m3_2024_københavn)
= m3_2025_gentofte_samlet = samlet_indkomstskatteprocent_basispoint(m3_2025_gentofte)
= m3_2026_københavn_samlet = samlet_indkomstskatteprocent_basispoint(m3_2026_københavn)
= m3_2026_langeland_samlet = samlet_indkomstskatteprocent_basispoint(m3_2026_langeland)
= m3_2024_københavn_pakke = skatteår_parameterpakke_for(2024, København)
= m3_2026_københavn_pakke = skatteår_parameterpakke_for(2026, København)
= m3_2026_langeland_pakke_resultat = skatteår_parameterpakke_resultat(2026, Langeland)
= m3_2026_understøttet = skatteår_understøttet(2026)
= m3_2026_langeland_pakke_komplet = parameterpakke_komplet(2026, Langeland)
= m3_2023_langeland_pakke_ikke_komplet = parameterpakke_komplet(2023, Langeland)

| m3_2024_national_kilde_fra_skat: m3_2024_national_resultat -> m3_2024_national_resultat.kilde == SkattestyrelsenSatserSkat2024 && m3_2024_national_resultat.parametre.topskattegrænse_efter_am_kroner == 588900
| m3_2026_national_kilde_fra_skat: m3_2026_national_resultat -> m3_2026_national_resultat.kilde == SkattestyrelsenSatserSkat2026 && m3_2026_national_resultat.parametre.mellemskat_basispoint == 750 && m3_2026_national_resultat.parametre.toptopskattegrænse_efter_am_kroner == 2592700
| m3_2024_bundskat_fra_skat: m3_2024_national -> m3_2024_national.bundskat_basispoint == 1201
| m3_2025_topskatgrænse_fra_skat: m3_2025_national -> m3_2025_national.topskattegrænse_efter_am_kroner == 611800
| m3_2026_mellemskatgrænse_fra_skat: m3_2026_national -> m3_2026_national.mellemskattegrænse_efter_am_kroner == 641200
| m3_2026_topskatgrænse_fra_skat: m3_2026_national -> m3_2026_national.topskattegrænse_efter_am_kroner == 777900
| m3_2026_toptopskatgrænse_fra_skat: m3_2026_national -> m3_2026_national.toptopskattegrænse_efter_am_kroner == 2592700
| m3_2026_personfradrag_fra_skat: m3_2026_national -> m3_2026_national.personfradrag_voksen_kroner == 54100
| m3_2025_gentofte_kommunal_kilde_fra_skm: m3_2025_gentofte_resultat -> m3_2025_gentofte_resultat.kilde == SkatteministerietKommuneskatter2025 && m3_2025_gentofte_resultat.parametre.kirkeskat_basispoint == 39
| m3_2025_frederiksberg_kommunal_kilde_fra_skm: m3_2025_frederiksberg_resultat -> m3_2025_frederiksberg_resultat.kilde == SkatteministerietKommuneskatter2025 && m3_2025_frederiksberg_resultat.parametre.kommunekode == 147
| m3_2026_langeland_kommunal_kilde_fra_skm: m3_2026_langeland_resultat -> m3_2026_langeland_resultat.kilde == SkatteministerietKommuneskattesatser2026Xlsx && m3_2026_langeland_resultat.parametre.skatteloftsnedslag_basispoint == 124
| m3_2024_københavn_kommuneskat_fra_skm: m3_2024_københavn -> m3_2024_københavn.kommuneskat_basispoint == 2360
| m3_2025_gentofte_kirkeskat_fra_skm: m3_2025_gentofte -> m3_2025_gentofte.kirkeskat_basispoint == 39
| m3_2025_frederiksberg_satser_fra_skm: m3_2025_frederiksberg -> m3_2025_frederiksberg.kommuneskat_basispoint == 2457 && m3_2025_frederiksberg.kirkeskat_basispoint == 50 && m3_2025_frederiksberg.grundskyld_promille_tiendedele == 31
| m3_2026_københavn_kommuneskat_fra_skm: m3_2026_københavn -> m3_2026_københavn.kommuneskat_basispoint == 2339
| m3_2026_gentofte_kirkeskat_fra_skm: m3_2026_gentofte -> m3_2026_gentofte.kirkeskat_basispoint == 38
| m3_2026_langeland_kommuneskat_fra_skm: m3_2026_langeland -> m3_2026_langeland.kommuneskat_basispoint == 2630
| m3_2026_langeland_skatteloftsnedslag_fra_skm: m3_2026_langeland -> m3_2026_langeland.skatteloftsnedslag_basispoint == 124
| m3_2026_langeland_grundskyld_fra_skm: m3_2026_langeland -> m3_2026_langeland.grundskyld_promille_tiendedele == 122
| m3_2024_københavn_samlet_procent: m3_2024_københavn_samlet -> m3_2024_københavn_samlet == 3641
| m3_2025_gentofte_samlet_procent: m3_2025_gentofte_samlet -> m3_2025_gentofte_samlet == 3664
| m3_2026_københavn_samlet_procent: m3_2026_københavn_samlet -> m3_2026_københavn_samlet == 3619
| m3_2026_langeland_samlet_procent: m3_2026_langeland_samlet -> m3_2026_langeland_samlet == 3821
| m3_pakke_bærer_nationalt_år: m3_2024_københavn_pakke -> m3_2024_københavn_pakke.nationale.skatteår == 2024
| m3_pakke_bærer_kommunekode: m3_2024_københavn_pakke -> m3_2024_københavn_pakke.kommunale.kommunekode == 101
| m3_2026_pakke_bærer_reformår: m3_2026_københavn_pakke -> m3_2026_københavn_pakke.nationale.skatteår == 2026
| m3_2026_langeland_pakke_bærer_kilder: m3_2026_langeland_pakke_resultat -> m3_2026_langeland_pakke_resultat.national_kilde == SkattestyrelsenSatserSkat2026 && m3_2026_langeland_pakke_resultat.kommunal_kilde == SkatteministerietKommuneskattesatser2026Xlsx && m3_2026_langeland_pakke_resultat.pakke.kommunale.kommunekode == 482
| m3_2026_er_i_pakken: m3_2026_understøttet -> m3_2026_understøttet == Sandt
| m3_2026_langeland_er_komplet: m3_2026_langeland_pakke_komplet -> m3_2026_langeland_pakke_komplet == Sandt
| m3_2023_langeland_er_ikke_komplet: m3_2023_langeland_pakke_ikke_komplet -> m3_2023_langeland_pakke_ikke_komplet == Falskt
