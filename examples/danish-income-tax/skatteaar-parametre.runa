# Kommune = København | Gentofte
# KommunaleParametre(skatteår: Heltal, kommune: Kommune, kommunekode: Heltal, kommuneskat_basispoint: Heltal, kirkeskat_basispoint: Heltal, sundhedsbidrag_basispoint: Heltal, bundskat_basispoint: Heltal, skatteloftsnedslag_basispoint: Heltal, grundskyld_promille_tiendedele: Heltal)
# SkatteårParameterpakke(nationale: NationalParametre, kommunale: KommunaleParametre)

| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(2024, København, 101, 2360, 80, 0, 1201, 0, 51) under skatteår == 2024 && kommune == København
| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(2024, Gentofte, 157, 2434, 40, 0, 1201, 0, 51) under skatteår == 2024 && kommune == Gentofte

