    bundskat_basispoint = 1201,
    skatteloftsnedslag_basispoint = 0,
    grundskyld_promille_tiendedele = 51
) under skatteår == 2025 && kommune == København
| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(
    skatteår = 2025,
    kommune = Gentofte,
    kommunekode = 157,
    kommuneskat_basispoint = 2424,
    kirkeskat_basispoint = 39,
    sundhedsbidrag_basispoint = 0,
