----
Skatteministeriet, "Oversigt over kommuneskatter"
Tabel: Kommuneskatter
År: 2024

Kommunenavn | År | Kommuneskat | Kirkeskat | Sundhedsbidrag | Bundskat | I alt | Skatteloftsnedslag* | Grundskyldspromille (Kommune)
København | 2024 | 23,60 | 0,80 | 0,00 | 12,01 | 36,41 | 0,00 | 5,10
Gentofte | 2024 | 24,34 | 0,40 | 0,00 | 12,01 | 36,75 | 0,00 | 5,10
----

# Kommune = København | Gentofte | Langeland
# KommunaleParametre(skatteår: Heltal, kommune: Kommune, kommunekode: Heltal, kommuneskat_basispoint: Heltal, kirkeskat_basispoint: Heltal, sundhedsbidrag_basispoint: Heltal, bundskat_basispoint: Heltal, skatteloftsnedslag_basispoint: Heltal, grundskyld_promille_tiendedele: Heltal)
# SkatteårParameterpakke(nationale: NationalParametre, kommunale: KommunaleParametre)

| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(
    skatteår = 2024,
    kommune = København,
    kommunekode = 101,
    kommuneskat_basispoint = 2360,
    kirkeskat_basispoint = 80,
    sundhedsbidrag_basispoint = 0,
    bundskat_basispoint = 1201,
    skatteloftsnedslag_basispoint = 0,
    grundskyld_promille_tiendedele = 51
) under skatteår == 2024 && kommune == København
| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(
    skatteår = 2024,
    kommune = Gentofte,
    kommunekode = 157,
    kommuneskat_basispoint = 2434,
    kirkeskat_basispoint = 40,
    sundhedsbidrag_basispoint = 0,
    bundskat_basispoint = 1201,
    skatteloftsnedslag_basispoint = 0,
    grundskyld_promille_tiendedele = 51
) under skatteår == 2024 && kommune == Gentofte

