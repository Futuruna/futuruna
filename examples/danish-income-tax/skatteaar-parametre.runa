@ sprog da

@ importer ./kommunale - parametre

-- Personskatteloven — skatteårsspecifikke parameterpakker.
--
-- Kilder:
-- Skattestyrelsen, "Se alle skattesatser for i år og de forudgående år".
-- https://skat.dk/hjaelp/satser
--
-- Skatteministeriet, "Personskatteloven".
-- https://skm.dk/tal-og-metode/satser/satser-og-beloebsgraenser-i-lovgivningen/personskatteloven
--
-- Skatteministeriet, "Oversigt over kommuneskatter".
-- https://skm.dk/tal-og-metode/satser/oversigt-over-kommuneskatter

----
Skattestyrelsen, "Se alle skattesatser for i år og de forudgående år"
Kategori: Skat
År: 2024

Aktieindkomst (progressionsgrænse): 61.000 kr.
Aktieindkomst (skattesatser under/over progressionsgrænsen): 27/42 %
Am-bidrag (arbejdsmarkedsbidrag): 8 %
Bundfradrag i positiv nettokapitalindkomst i topskattegrundlaget: 50.500 kr.
Bundskat: 12,01 %
Personfradrag (fyldt 18 år): 49.700 kr.
Personfradrag (under 18 år): 49.700 kr.
Skatteloft (personlig indkomst): 52,07 %
Skatteloft (positiv nettokapitalindkomst): 42 %
Topskat (til og med 2025): 15 %
Topskat (topskattegrænse til og med 2025 efter am-bidrag er fratrukket): 588.900 kr.
----

# NationalParametre(skatteår: Heltal, bundskat_basispoint: Heltal, topskat_basispoint: Heltal, topskattegrænse_efter_am_kroner: Heltal, mellemskat_basispoint: Heltal, mellemskattegrænse_efter_am_kroner: Heltal, toptopskat_basispoint: Heltal, toptopskattegrænse_efter_am_kroner: Heltal, am_bidrag_basispoint: Heltal, personfradrag_voksen_kroner: Heltal, personfradrag_under18_kroner: Heltal, aktieindkomst_progressionsgrænse_kroner: Heltal, aktieindkomst_lav_basispoint: Heltal, aktieindkomst_høj_basispoint: Heltal, positiv_nettokapital_progressiv_bundfradrag_kroner: Heltal, skatteloft_personlig_basispoint: Heltal, skatteloft_positiv_nettokapital_basispoint: Heltal)
# NationalParametreKilde = SkattestyrelsenSatserSkat2024 | SkattestyrelsenSatserSkat2025 | SkattestyrelsenSatserSkat2026
# NationalParametreResultat(skatteår: Heltal, kilde: NationalParametreKilde, parametre: NationalParametre)
# SkatteårParameterpakke(nationale: NationalParametre, kommunale: KommunaleParametre)
# SkatteårParameterpakkeResultat(skatteår: Heltal, kommune: Kommune, national_kilde: NationalParametreKilde, kommunal_kilde: KommunaleParametreKilde, pakke: SkatteårParameterpakke)

| nationalparametre_værdi_for(skatteår: Heltal) -> NationalParametre(
    skatteår = 2024,
    bundskat_basispoint = 1201,
    topskat_basispoint = 1500,
    topskattegrænse_efter_am_kroner = 588900,
    mellemskat_basispoint = 0,
    mellemskattegrænse_efter_am_kroner = 0,
    toptopskat_basispoint = 0,
    toptopskattegrænse_efter_am_kroner = 0,
    am_bidrag_basispoint = 800,
    personfradrag_voksen_kroner = 49700,
    personfradrag_under18_kroner = 49700,
    aktieindkomst_progressionsgrænse_kroner = 61000,
    aktieindkomst_lav_basispoint = 2700,
    aktieindkomst_høj_basispoint = 4200,
    positiv_nettokapital_progressiv_bundfradrag_kroner = 50500,
    skatteloft_personlig_basispoint = 5207,
    skatteloft_positiv_nettokapital_basispoint = 4200
) under skatteår == 2024

