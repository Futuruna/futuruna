| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(2025, Gentofte, 157, 2424, 39, 0, 1201, 0, 51) under skatteår == 2025 && kommune == Gentofte

----
Skatteministeriet, "Kommuneskattesatser 2026"
Projektmappe: kommuneskattesatser_2026.xlsx
Ark: 2026

Kommune | Region | Kommune nr. | Region nr. | Alfabet nr. | Skatte pct. | Kirke pct. | Nedslag pct. | Grundskyldspromille
København | Hovedstaden | 101 | 1084 | 50 | 23,39 | 0,80 | 0,00 | 5,10
Gentofte | Hovedstaden | 157 | 1084 | 24 | 24,14 | 0,38 | 0,00 | 5,10
----

| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(2026, København, 101, 2339, 80, 0, 1201, 0, 51) under skatteår == 2026 && kommune == København
| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> KommunaleParametre(2026, Gentofte, 157, 2414, 38, 0, 1201, 0, 51) under skatteår == 2026 && kommune == Gentofte

| skatteår_understøttet(skatteår: Heltal) -> Falskt
| exception skatteår_2024 skatteår_understøttet(skatteår: Heltal) -> Sandt under skatteår == 2024
| exception skatteår_2025 skatteår_understøttet(skatteår: Heltal) -> Sandt under skatteår == 2025
| exception skatteår_2026 skatteår_understøttet(skatteår: Heltal) -> Sandt under skatteår == 2026

| kommune_understøttet(kommune: Kommune) -> Sandt
| skatteår_parameterpakke_for(skatteår: Heltal, kommune: Kommune) -> SkatteårParameterpakke(nationalparametre_for(skatteår), kommunale_parametre_for(skatteår, kommune)) under skatteår_understøttet(skatteår) && kommune_understøttet(kommune)

| samlet_indkomstskatteprocent_basispoint(kommunale: KommunaleParametre) -> kommunale.kommuneskat_basispoint + kommunale.kirkeskat_basispoint + kommunale.sundhedsbidrag_basispoint + kommunale.bundskat_basispoint - kommunale.skatteloftsnedslag_basispoint
| parameterpakke_komplet(skatteår: Heltal, kommune: Kommune) -> skatteår_understøttet(skatteår) && kommune_understøttet(kommune)

= m3_2024_national = nationalparametre_for(2024)
= m3_2025_national = nationalparametre_for(2025)
= m3_2026_national = nationalparametre_for(2026)
= m3_2024_københavn = kommunale_parametre_for(2024, København)
= m3_2025_gentofte = kommunale_parametre_for(2025, Gentofte)
= m3_2026_københavn = kommunale_parametre_for(2026, København)
= m3_2026_gentofte = kommunale_parametre_for(2026, Gentofte)
= m3_2024_københavn_samlet = samlet_indkomstskatteprocent_basispoint(m3_2024_københavn)
= m3_2025_gentofte_samlet = samlet_indkomstskatteprocent_basispoint(m3_2025_gentofte)
= m3_2026_københavn_samlet = samlet_indkomstskatteprocent_basispoint(m3_2026_københavn)
= m3_2024_københavn_pakke = skatteår_parameterpakke_for(2024, København)
= m3_2026_københavn_pakke = skatteår_parameterpakke_for(2026, København)
= m3_2026_understøttet = skatteår_understøttet(2026)

| m3_2024_bundskat_fra_skat: m3_2024_national -> m3_2024_national.bundskat_basispoint == 1201
| m3_2025_topskatgrænse_fra_skat: m3_2025_national -> m3_2025_national.topskattegrænse_efter_am_kroner == 611800
| m3_2026_mellemskatgrænse_fra_skat: m3_2026_national -> m3_2026_national.mellemskattegrænse_efter_am_kroner == 641200
| m3_2026_topskatgrænse_fra_skat: m3_2026_national -> m3_2026_national.topskattegrænse_efter_am_kroner == 777900
| m3_2026_toptopskatgrænse_fra_skat: m3_2026_national -> m3_2026_national.toptopskattegrænse_efter_am_kroner == 2592700
| m3_2026_personfradrag_fra_skat: m3_2026_national -> m3_2026_national.personfradrag_voksen_kroner == 54100
| m3_2024_københavn_kommuneskat_fra_skm: m3_2024_københavn -> m3_2024_københavn.kommuneskat_basispoint == 2360
| m3_2025_gentofte_kirkeskat_fra_skm: m3_2025_gentofte -> m3_2025_gentofte.kirkeskat_basispoint == 39
| m3_2026_københavn_kommuneskat_fra_skm: m3_2026_københavn -> m3_2026_københavn.kommuneskat_basispoint == 2339
| m3_2026_gentofte_kirkeskat_fra_skm: m3_2026_gentofte -> m3_2026_gentofte.kirkeskat_basispoint == 38
| m3_2024_københavn_samlet_procent: m3_2024_københavn_samlet -> m3_2024_københavn_samlet == 3641
| m3_2025_gentofte_samlet_procent: m3_2025_gentofte_samlet -> m3_2025_gentofte_samlet == 3664
| m3_2026_københavn_samlet_procent: m3_2026_københavn_samlet -> m3_2026_københavn_samlet == 3619
| m3_pakke_bærer_nationalt_år: m3_2024_københavn_pakke -> m3_2024_københavn_pakke.nationale.skatteår == 2024
| m3_pakke_bærer_kommunekode: m3_2024_københavn_pakke -> m3_2024_københavn_pakke.kommunale.kommunekode == 101
| m3_2026_pakke_bærer_reformår: m3_2026_københavn_pakke -> m3_2026_københavn_pakke.nationale.skatteår == 2026
| m3_2026_er_i_pakken: m3_2026_understøttet -> m3_2026_understøttet == Sandt
