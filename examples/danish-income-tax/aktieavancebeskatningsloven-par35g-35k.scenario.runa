@ sprog da

@ importer ./aktieavancebeskatningsloven - par35g - 35k

----
Fokuserede scenarier for medarbejderejeordningen i
Aktieavancebeskatningslovens §§ 35 G-35 K. Scenarierne kæder den typede
overdragerskat gennem flere indkomstår og holder straksbeskatning, uforfalden
saldo og allerede forfaldne afdrag adskilt.
----

= par35_scenario_virkning_2025 = aktieavance_par35g_til_par35k_har_virkning(2025)
= par35_scenario_virkning_2026 = aktieavance_par35g_til_par35k_har_virkning(2026)

= par35_scenario_partier = [
    AktieavancePar35GOverdragelsesparti(
        identifikation = "parti-a",
        selskabsidentifikation = "drift-a",
        aktieserie = "ordinær",
        erhvervelsesrækkefølge = 1,
        antal = 100,
        skattemæssig_anskaffelsessum_kroner = 100000,
        handelsværdi_kroner = 200000
    ),
    AktieavancePar35GOverdragelsesparti(
        identifikation = "parti-b",
        selskabsidentifikation = "drift-a",
        aktieserie = "ordinær",
        erhvervelsesrækkefølge = 2,
        antal = 100,
        skattemæssig_anskaffelsessum_kroner = 150000,
        handelsværdi_kroner = 300000
    )
]

= par35_scenario_dansk_valg = AktieavancePar35GValg(
    overdragelsesår = 2026,
    overdrager_er_fysisk_person = Sandt,
    hjemsted = AblPar35GDanmark,
    dansk_virksomhed_omfattet_af_sel_par1_stk1_nr2j = Sandt,
    udenlandsk_virksomhed_svarer_til_sel_par1_stk1_nr2j = Falskt,
    udenlandsk_virksomhed_opfylder_erhvervsvirksomhedslov_kap5c = Falskt,
    udenlandsk_virksomhed_forpligter_sig_til_overdragerskat = Falskt,
    udenlandsk_virksomhed_forpligter_sig_til_årsoplysninger = Falskt,
    aktier_opfylder_par34_stk1_nr3 = Sandt,
    parterne_har_valgt_ordningen = Sandt,
    meddelelse_rettidig = Sandt,
    beholdningsoversigt_vedlagt = Sandt,
    saldo_vedlagt = Sandt,
    land_omfattet_af_inddrivelsesbistand = Sandt,
    sikkerhedsform = AblPar35GIngenSikkerhed,
    sikkerhed_står_i_passende_forhold = Falskt,
    partier = par35_scenario_partier
)
= par35_scenario_start = aktieavance_par35g_overdragelsesresultat(par35_scenario_dansk_valg)

= par35_scenario_negativt_valg = AktieavancePar35GValg(
    overdragelsesår = 2026,
    overdrager_er_fysisk_person = Sandt,
    hjemsted = AblPar35GDanmark,
    dansk_virksomhed_omfattet_af_sel_par1_stk1_nr2j = Sandt,
    udenlandsk_virksomhed_svarer_til_sel_par1_stk1_nr2j = Falskt,
    udenlandsk_virksomhed_opfylder_erhvervsvirksomhedslov_kap5c = Falskt,
    udenlandsk_virksomhed_forpligter_sig_til_overdragerskat = Falskt,
    udenlandsk_virksomhed_forpligter_sig_til_årsoplysninger = Falskt,
    aktier_opfylder_par34_stk1_nr3 = Sandt,
    parterne_har_valgt_ordningen = Sandt,
    meddelelse_rettidig = Sandt,
    beholdningsoversigt_vedlagt = Sandt,
    saldo_vedlagt = Sandt,
    land_omfattet_af_inddrivelsesbistand = Sandt,
    sikkerhedsform = AblPar35GIngenSikkerhed,
    sikkerhed_står_i_passende_forhold = Falskt,
    partier = [
        AktieavancePar35GOverdragelsesparti(
            identifikation = "negativt-parti",
            selskabsidentifikation = "drift-negativ",
            aktieserie = "ordinær",
            erhvervelsesrækkefølge = 1,
            antal = 100,
            skattemæssig_anskaffelsessum_kroner = -50000,
            handelsværdi_kroner = 100000
        )
    ]
)
= par35_scenario_negativt_resultat = aktieavance_par35g_overdragelsesresultat(par35_scenario_negativt_valg)
= par35_scenario_negativt_psl = aktieavance_par35h_personskattelov_resultat(par35_scenario_negativt_resultat)

