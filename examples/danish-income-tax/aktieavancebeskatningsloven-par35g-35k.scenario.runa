| par35_forløb_afleder_straksindkomst_fra_kildefakta: par35_scenario_negativt_forløb -> par35_scenario_negativt_forløb.input_gyldigt && par35_scenario_negativt_forløb.umiddelbar_skattepligtig_gevinst_kroner == 50000 && par35_scenario_negativt_forløb.aktieavancebeskatningslov_resultat.skattepligtig_gevinst_kroner == 50000 && par35_scenario_negativt_forløb.tilstand_ultimo.overdragerskat_saldo_kroner == 22000
| par35_forløb_årsoplysningssvigt_forfalder_saldo: par35_scenario_forløb_årsoplysninger_for_sent -> par35_scenario_forløb_årsoplysninger_for_sent.input_gyldigt && par35_scenario_forløb_årsoplysninger_for_sent.årets_nye_forfald_kroner == 55000 && par35_scenario_forløb_årsoplysninger_for_sent.tilstand_ultimo.ordning_aktiv == Falskt
| par35_forløb_hjemstedsflytning_forfalder_saldo: par35_scenario_forløb_hjemstedsflytning -> par35_scenario_forløb_hjemstedsflytning.input_gyldigt && par35_scenario_forløb_hjemstedsflytning.årets_nye_forfald_kroner == 55000 && par35_scenario_forløb_hjemstedsflytning.tilstand_ultimo.hjemsted == AblPar35GFærøerne && par35_scenario_forløb_hjemstedsflytning.tilstand_ultimo.ordning_aktiv == Falskt
