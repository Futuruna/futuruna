| par35_salg_betalt: par35_scenario_salg_et_betalt -> par35_scenario_salg_et_betalt.hændelse_gyldig && par35_scenario_salg_et_betalt.tilstand_efter.overdragerskat_saldo_kroner == 25000 && length(par35_scenario_salg_et_betalt.tilstand_efter.forfaldsposter) == 0
| par35_udbytte: par35_scenario_udbytte -> par35_scenario_udbytte.hændelse_gyldig && par35_scenario_udbytte.otte_pct_grænse_kroner == 40000 && par35_scenario_udbytte.fritaget_udbytte_kroner == 40000 && par35_scenario_udbytte.afdragsgrundlag_kroner == 20000 && par35_scenario_udbytte.nyt_forfald_kroner == 4000 && head(par35_scenario_udbytte.tilstand_efter.beholdning).resterende_fritaget_udbytte_kroner == 40000
| par35_udbytte_kun_en_gang_pr_år: par35_scenario_gentaget_udbytte -> par35_scenario_gentaget_udbytte.hændelse_gyldig == Falskt
| par35_slutsalg: par35_scenario_salg_to -> par35_scenario_salg_to.hændelse_gyldig && par35_scenario_salg_to.fritaget_udbytte_tillagt_afståelsessum_kroner == 40000 && par35_scenario_salg_to.gevinst_kroner == 40000 && par35_scenario_salg_to.nyt_forfald_kroner == 8800 && par35_scenario_salg_to.saldobortfald_kroner == 12200 && par35_scenario_salg_to.tilstand_efter.overdragerskat_saldo_kroner == 8800 && length(par35_scenario_salg_to.tilstand_efter.beholdning) == 0
| par35_slutbetaling: par35_scenario_slutbetaling -> par35_scenario_slutbetaling.hændelse_gyldig && par35_scenario_slutbetaling.tilstand_efter.overdragerskat_saldo_kroner == 0 && length(par35_scenario_slutbetaling.tilstand_efter.forfaldsposter) == 0
| par35_omstrukturering: par35_scenario_omstrukturering -> par35_scenario_omstrukturering.hændelse_gyldig && head(par35_scenario_omstrukturering.tilstand_efter.beholdning).identifikation == "vederlagsaktier"
| par35_tvangsgrænser: par35_scenario_pengetank -> par35_scenario_pengetank.anses_for_afstået && par35_scenario_pengetank.afståelsesår == 2029 && par35_scenario_pengetank_efter_perioden.anses_for_afstået == Falskt && par35_scenario_ejerskab.anses_for_afstået && par35_scenario_ejerskab.afståelsesår == 2028 && par35_scenario_sel_brist.anses_for_afstået
