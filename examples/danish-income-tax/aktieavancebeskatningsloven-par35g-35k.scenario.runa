| par35_ikrafttræden: par35_scenario_virkning_2026 -> par35_scenario_virkning_2025 == Falskt && par35_scenario_virkning_2026
| par35_startsaldo: par35_scenario_start -> par35_scenario_start.valg.kan_anvende_par35h_til_par35k && par35_scenario_start.oprindelig_overdragerskat_kroner == 55000 && length(par35_scenario_start.tilstand.beholdning) == 2
