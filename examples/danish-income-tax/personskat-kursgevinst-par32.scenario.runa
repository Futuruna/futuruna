@ sprog da

@ importer ./personskat.calculate

----
Regressionsscenarier for det kanoniske samspil mellem kursgevinstlovens § 32,
aktieavancebeskatningsloven og Personskatteloven.

Scenarierne er ikke lovtekst. De fastholder, at kontraktresultater udledes af
kildefakta, at fremførsel genberegnes fra tidligere indkomstår, og at kun det
færdige § 32-årsresultat føres videre til Personskatteloven.
----

| personskat_par32_scenarie_kontrakt(identifikation: Tekst, rækkefølge: Heltal, anskaffelsessum_kroner: Heltal, afståelsesværdi_kroner: Heltal, udøver_næring: Boolsk, relationsfakta: KursgevinstPar32Kontraktrelationsfakta, underliggende: KursgevinstPar32Underliggendefakta) -> KursgevinstPar32KildekontraktFakta(
    identifikation = identifikation,
    rækkefølge_i_indkomståret = rækkefølge,
    kontrakt = KursgevinstlovKontraktKildeFakta(
        aftaleart = KglPar30IngenUndtagelsesaftale,
        har_modgående_kontrakt_eller_forretning = Falskt,
        værdi_primo_kroner = 0,
        værdi_ultimo_kroner = 0,
        anskaffelsessum_kroner = anskaffelsessum_kroner,
        afståelsesværdi_kroner = afståelsesværdi_kroner,
        anskaffet_i_indkomståret = Sandt,
        realiseret_i_indkomståret = Sandt,
        udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = udøver_næring
    ),
    relationsfakta = relationsfakta,
    underliggende = underliggende
)
| personskat_par32_scenarie_valg_med_fordeling(aktiemodregning: KursgevinstPar32Aktiemodregningsomfang, fordeling: KursgevinstPar32Aktiemodregningsfordeling) -> KursgevinstPar32Kildeårsvalg(
    tabsprioritet = KglPar32AlmindeligeTabFørst,
    fast_ejendomstabsprioritet = KglPar32SælgertabFørst,
    aktiemodregningsvalg = KursgevinstPar32Aktiemodregningsvalg(
        omfang = aktiemodregning,
        beløb = KglPar32MaksimalAktiemodregning
    ),
    aktiemodregningsfordeling = fordeling
)
| personskat_par32_scenarie_valg(aktiemodregning: KursgevinstPar32Aktiemodregningsomfang) -> personskat_par32_scenarie_valg_med_fordeling(aktiemodregning, KglPar32AfledEntydigFordeling)
| personskat_par32_scenarie_kildeår_med_fordeling(indkomstår: Heltal, kontrakter: List(KursgevinstPar32KildekontraktFakta), aktiemodregning: KursgevinstPar32Aktiemodregningsomfang, fordeling: KursgevinstPar32Aktiemodregningsfordeling) -> KursgevinstPar32PersonKildeårsfakta(
    indkomstår = indkomstår,
    kontrakter = kontrakter,
    valg = personskat_par32_scenarie_valg_med_fordeling(aktiemodregning, fordeling)
)
| personskat_par32_scenarie_kildeår(indkomstår: Heltal, kontrakter: List(KursgevinstPar32KildekontraktFakta), aktiemodregning: KursgevinstPar32Aktiemodregningsomfang) -> personskat_par32_scenarie_kildeår_med_fordeling(indkomstår, kontrakter, aktiemodregning, KglPar32AfledEntydigFordeling)
| personskat_par32_scenarie_kursgevinst_med_årsnetto_og_gæld(tidligere_år: List(PersonskatKursgevinstPar32Historikår), aktuelt_år: KursgevinstPar32PersonKildeårsfakta, øvrige_instrumenter: KursgevinstlovÅrsnettoInput, gældsposter: List(KursgevinstlovGældFakta)) -> MedKursgevinst(fakta = PersonskatKursgevinstÅrsfakta(
    skatteyder_identifikation = "person-par32",
    ægtefælles_skatteyder_identifikation = None,
    sælgerpantebreve = [],
    gældsposter = gældsposter,
    øvrige_instrumenter = øvrige_instrumenter,
    par32_kontraktforløb = MedPar32Kontraktforløb(tidligere_år = tidligere_år, aktuelt_år = aktuelt_år)
))
| personskat_par32_scenarie_kursgevinst_med_årsnetto(tidligere_år: List(PersonskatKursgevinstPar32Historikår), aktuelt_år: KursgevinstPar32PersonKildeårsfakta, øvrige_instrumenter: KursgevinstlovÅrsnettoInput) -> personskat_par32_scenarie_kursgevinst_med_årsnetto_og_gæld(tidligere_år, aktuelt_år, øvrige_instrumenter, [])
| personskat_par32_scenarie_kursgevinst(tidligere_år: List(PersonskatKursgevinstPar32Historikår), aktuelt_år: KursgevinstPar32PersonKildeårsfakta) -> personskat_par32_scenarie_kursgevinst_med_årsnetto(tidligere_år, aktuelt_år, kgl_årsnetto_tomt_input())
| personskat_par32_scenarie_historisk_årsgrundlag(øvrige_instrumenter: KursgevinstlovÅrsnettoInput, gældsposter: List(KursgevinstlovGældFakta)) -> PersonskatKursgevinstÅrsgrundlag(
    ejendomsavance = UdenEjendomsavance,
    sælgerpantebreve = [],
    gældsposter = gældsposter,
    øvrige_instrumenter = øvrige_instrumenter
)
| personskat_par32_scenarie_kapitalindkomst(kursgevinst: PersonskatKursgevinstInput) -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = kursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    omkostninger = []
)
| personskat_par32_scenarie_input(kursgevinst: PersonskatKursgevinstInput, aktieavance: PersonskatAktieavanceInput) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 0,
        personlig_indkomst = personskat_ingen_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_par32_scenarie_kapitalindkomst(kursgevinst),
    aktieavance = aktieavance,
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)

= personskat_par32_scenarie_aktieposition = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-PAR32-AKTIE",
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    anskaffelsessum_kroner = 10000
)
= personskat_par32_scenarie_aktiesalg = AblOrdinærAfståelse(
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    afståelsessum_kroner = 30000,
    vilkår = AktieavanceOrdinærAfståelsesvilkår(
        markedsstatus = AblOptagetTilHandelPåReguleretMarked,
        har_tidligere_været_optaget_til_handel = Sandt,
        hovedaktionæraktier = Falskt,
        afståede_aktiers_handelsværdi_kroner = 30000,
        beholdte_aktiers_handelsværdi_kroner = 0,
        oplysningsstatus = AblOplystRettidigt,
        boligret = AblUdenBoligret
    ),
    par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
)
= personskat_par32_scenarie_aktieår = AktieavanceOrdinærPersonÅrsinput(
    indkomstår = 2026,
    hændelsesforløb = [AktieavanceOrdinærHændelsesforløbInput(
        position_primo = personskat_par32_scenarie_aktieposition,
        hændelser = [personskat_par32_scenarie_aktiesalg]
    )],
    investeringsbeviser = [],
    fremført_tab_efter_par13a_kroner = 0
)
= personskat_par32_scenarie_aktiemodregning_resultat = beregn_personskat(personskat_par32_scenarie_input(
    kursgevinst = personskat_par32_scenarie_kursgevinst(
        tidligere_år = [],
        aktuelt_år = personskat_par32_scenarie_kildeår(
            indkomstår = 2026,
            kontrakter = [personskat_par32_scenarie_kontrakt(
                identifikation = "aktiebaseret-tab",
                rækkefølge = 1,
                anskaffelsessum_kroner = 18000,
                afståelsesværdi_kroner = 10000,
                udøver_næring = Falskt,
                relationsfakta = KglPar32KildeUdenSærligRelation,
                underliggende = KglPar32KildeEnkeltaktie(markedsstatus = AblOptagetTilHandelPåReguleretMarked)
            )],
            aktiemodregning = KglPar32KunEgneAktiegevinster
        )
    ),
    aktieavance = PersonskatAktieavanceInput(
        ordinært_aktieår = MedOrdinærtAktieår(input = personskat_par32_scenarie_aktieår),
        særlige_aktiver = [],
        udbytter = []
    )
))

= personskat_par32_scenarie_fremførsel_resultat = beregn_personskat(personskat_par32_scenarie_input(
    kursgevinst = personskat_par32_scenarie_kursgevinst(
        tidligere_år = [PersonskatKursgevinstPar32Historikår(
            fakta = personskat_par32_scenarie_kildeår(
                indkomstår = 2025,
                kontrakter = [personskat_par32_scenarie_kontrakt("tab-2025", 1, 20000, 10000, Falskt, KglPar32KildeUdenSærligRelation, KglPar32KildeIkkeAktiebaseret)],
                aktiemodregning = KglPar32IngenAktiemodregning
            ),
            aktieavance = personskat_ingen_aktieavance(),
            årsgrundlag = personskat_par32_scenarie_historisk_årsgrundlag(kgl_årsnetto_tomt_input(), []),
            gift_og_samlevende_ved_indkomstårets_udgang = Falskt
        )],
        aktuelt_år = personskat_par32_scenarie_kildeår(
            indkomstår = 2026,
            kontrakter = [personskat_par32_scenarie_kontrakt("gevinst-2026", 1, 10000, 14000, Falskt, KglPar32KildeUdenSærligRelation, KglPar32KildeIkkeAktiebaseret)],
            aktiemodregning = KglPar32IngenAktiemodregning
        )
    ),
    aktieavance = personskat_ingen_aktieavance()
))

= personskat_par32_scenarie_par17_fakta = PersonskatPar17Kildefakta(
    indkomstår = 2026,
    skattepligtsgrundlag = AblPar7PersonEfterKildeskatteloven,
    næringsstatus = AblPar17UdøverNæringVedKøbOgSalgAfAktier,
    instrument = AblPar17AlmindeligAktie,
    erhvervelsesstatus = AblPar17ErhvervetSomLedINæringsvej,
    afståelsessum_kroner = 15000,
    anskaffelsessum_kroner = 10000
)
= personskat_par32_scenarie_par17_resultat = beregn_personskat(personskat_par32_scenarie_input(
    kursgevinst = personskat_par32_scenarie_kursgevinst(
        tidligere_år = [],
        aktuelt_år = personskat_par32_scenarie_kildeår(
            indkomstår = 2026,
            kontrakter = [personskat_par32_scenarie_kontrakt(
                identifikation = "abl17-kontrakt",
                rækkefølge = 1,
                anskaffelsessum_kroner = 19000,
                afståelsesværdi_kroner = 10000,
                udøver_næring = Sandt,
                relationsfakta = KglPar32KildeTilknyttetAblAktiv(aktieaktiv_identifikation = "abl17-aktiv"),
                underliggende = KglPar32KildeEnkeltaktieFraAblReference
            )],
            aktiemodregning = KglPar32IngenAktiemodregning
        )
    ),
    aktieavance = PersonskatAktieavanceInput(
        ordinært_aktieår = UdenOrdinærtAktieår,
        særlige_aktiver = [PersonskatSærligtAktieaktivFakta(
            identifikation = "abl17-aktiv",
            kilde = PersonskatAktieaktivEfterPar17(fakta = personskat_par32_scenarie_par17_fakta),
            markedsstatus = AblOptagetTilHandelPåReguleretMarked
        )],
        udbytter = []
    )
))

| personskat_par32_scenarie_par17_fakta_fra_abl(input: AktieavancebeskatningslovInput, instrument: AktieavancePar17Instrument) -> PersonskatPar17Kildefakta(
    indkomstår = input.indkomstår,
    skattepligtsgrundlag = AblPar7PersonEfterKildeskatteloven,
    næringsstatus = input.par17_modprøve.næringsstatus,
    instrument = instrument,
    erhvervelsesstatus = input.par17_modprøve.erhvervelsesstatus,
    afståelsessum_kroner = input.afståelsessum_kroner,
    anskaffelsessum_kroner = input.anskaffelsessum_kroner
)
| personskat_par32_scenarie_særligt_aktiv_fra_abl(identifikation: Tekst, input: AktieavancebeskatningslovInput, instrument: AktieavancePar17Instrument) -> PersonskatSærligtAktieaktivFakta(
    identifikation = identifikation,
    kilde = PersonskatØvrigtAktieaktiv(
        input = PersonskatØvrigtSærligtAktieaktivInput(
            indkomstår = input.indkomstår,
            aktiv = input.aktiv,
            afståelsessum_kroner = input.afståelsessum_kroner,
            anskaffelsessum_kroner = input.anskaffelsessum_kroner,
            koncernintern_konvertibel_eller_tegningsret = input.koncernintern_konvertibel_eller_tegningsret,
            andelsforening_stiftet_før_22_maj_1987 = input.andelsforening_stiftet_før_22_maj_1987,
            afståelse_sker_for_at_undgå_likvidationsbeskatning = input.afståelse_sker_for_at_undgå_likvidationsbeskatning,
            investeringsklassifikation = input.investeringsklassifikation
        ),
        par17_modprøvekilde = MedPar17Modprøvekilde(fakta = personskat_par32_scenarie_par17_fakta_fra_abl(input, instrument))
    ),
    markedsstatus = AblOptagetTilHandelPåReguleretMarked
)
| personskat_par32_scenarie_abl22_klassifikation(indkomstår: Heltal) -> AktieavancePar21Par22Input(
    indkomstår = indkomstår,
    aktivmasse = AktieavanceInvesteringsaktivmasse(
        indkomstår = indkomstår,
        direkte_aktiver = abl22_aktivmasse.direkte_aktiver,
        ejerposter = []
    ),
    oplysninger = AblPar21OplysningerIndsendt(
        frist = AktieavanceInvesteringsdato(år = indkomstår + 1, måned = 7, dag = 1),
        indsendelsesdato = AktieavanceInvesteringsdato(år = indkomstår + 1, måned = 7, dag = 1)
    )
)
| personskat_par32_scenarie_abl22_forløb(identifikation: Tekst, indkomstår: Heltal, anskaffelsessum_kroner: Heltal, afståelsessum_kroner: Heltal) -> KglÅrsnettoAbl22Forløb(
    identifikation = identifikation,
    kilde = KglÅrsnettoAbl22Kilde(
        klassifikation = personskat_par32_scenarie_abl22_klassifikation(indkomstår),
        par17_modprøve = AktieavancePar17Modprøve(
            næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
            erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
        )
    ),
    position_primo = KglÅrsnettoIngenPositionPrimo,
    hændelser = [
        KglÅrsnettoAnskaffelse(anskaffelsessum_kroner = anskaffelsessum_kroner),
        KglÅrsnettoAfståelse(afståelsessum_kroner = afståelsessum_kroner)
    ]
)
| personskat_par32_scenarie_årsnetto_med_abl22(forløb: KglÅrsnettoAbl22Forløb) -> KursgevinstlovÅrsnettoInput(
    par25_valg = kgl_årsnetto_tomt_par25_årsvalg(),
    fordringer = [],
    valutainstrumenter = [],
    obligationsbaserede_minimumsbeviser = [forløb]
)
| personskat_par32_scenarie_gæld(identifikation: Tekst, værdi_ved_påtagelse_kroner: Heltal, værdi_ved_frigørelse_kroner: Heltal) -> KursgevinstlovGældFakta(
    identifikation = identifikation,
    beløb = KursgevinstlovGældBeløb(
        gældens_værdi_ved_påtagelse_kroner = værdi_ved_påtagelse_kroner,
        gældens_værdi_ved_frigørelse_eller_indfrielse_kroner = værdi_ved_frigørelse_kroner,
        fordringens_værdi_for_kreditor_kroner = værdi_ved_frigørelse_kroner
    ),
    frigørelsesart = KglGældOrdinærIndfrielse,
    erhvervsforhold = KglGældUdenFinansieringsnæring,
    valuta = KglGældFremmedValuta,
    selskabsfakta = kgl_gæld_tom_par21_stk2_selskabsfakta(),
    gældsordning = KglIngenDokumenteretGældsordning,
    vedrører_ikke_indbetalt_selskabskapital = Falskt,
    par22_hændelse = KglIngenPar22Hændelse
)
| personskat_par32_scenarie_historikår_med_årsgrundlag(kontrakt_identifikation: Tekst, kontrakttab_kroner: Heltal, årsgrundlag: PersonskatKursgevinstÅrsgrundlag) -> PersonskatKursgevinstPar32Historikår(
    fakta = personskat_par32_scenarie_kildeår(
        indkomstår = 2025,
        kontrakter = [personskat_par32_scenarie_kontrakt(
            identifikation = kontrakt_identifikation,
            rækkefølge = 1,
            anskaffelsessum_kroner = 10000 + kontrakttab_kroner,
            afståelsesværdi_kroner = 10000,
            udøver_næring = Falskt,
            relationsfakta = KglPar32KildeUdenSærligRelation,
            underliggende = KglPar32KildeEnkeltaktie(markedsstatus = AblOptagetTilHandelPåReguleretMarked)
        )],
        aktiemodregning = KglPar32KunEgneAktiegevinster
    ),
    aktieavance = personskat_ingen_aktieavance(),
    årsgrundlag = årsgrundlag,
    gift_og_samlevende_ved_indkomstårets_udgang = Falskt
)
| personskat_par32_scenarie_sælgerpantebrevsfakta_uden_ejendom(identifikation: Tekst) -> KglEblPar6DSælgerpantebrevsfakta(
    sælgerpantebrev_identifikation = identifikation,
    oprindelig_skatteyder_identifikation = "person-par32",
    skatteyderfakta = KglEblPar6DSkatteyderfakta(
        udøver_næring_ved_køb_og_salg_af_fordringer = Falskt,
        fordringen_erhvervet_uden_for_fordringsnæring = Sandt,
        fordringen_erhvervet_som_vederlag_for_leverede_varer_eller_tjenesteydelser = Falskt,
        fordringen_erhvervet_i_direkte_tilknytning_til_erhvervsmæssig_drift = Falskt,
        debitor_omfattet_af_tabsbegrænsningen_i_kgl_par14_stk2 = Falskt,
        renter_eller_gevinster_fritaget_efter_dobbeltbeskatningsoverenskomst = Falskt
    ),
    dispositioner_efter_ebl_forløbet = []
)
| personskat_par32_scenarie_blandet_input(fordeling: KursgevinstPar32Aktiemodregningsfordeling) -> personskat_par32_scenarie_input(
    kursgevinst = personskat_par32_scenarie_kursgevinst_med_årsnetto(
        tidligere_år = [],
        aktuelt_år = personskat_par32_scenarie_kildeår_med_fordeling(
            indkomstår = 2026,
            kontrakter = [personskat_par32_scenarie_kontrakt(
                identifikation = "par32-blandet-kontrakttab",
                rækkefølge = 1,
                anskaffelsessum_kroner = 40000,
                afståelsesværdi_kroner = 10000,
                udøver_næring = Falskt,
                relationsfakta = KglPar32KildeUdenSærligRelation,
                underliggende = KglPar32KildeEnkeltaktie(markedsstatus = AblOptagetTilHandelPåReguleretMarked)
            )],
            aktiemodregning = KglPar32KunEgneAktiegevinster,
            fordeling = fordeling
        ),
        øvrige_instrumenter = personskat_par32_scenarie_årsnetto_med_abl22(personskat_par32_scenarie_abl22_forløb(
            identifikation = "par32-abl22-kapital",
            indkomstår = 2026,
            anskaffelsessum_kroner = 10000,
            afståelsessum_kroner = 18000
        ))
    ),
    aktieavance = PersonskatAktieavanceInput(
        ordinært_aktieår = UdenOrdinærtAktieår,
        særlige_aktiver = [
            personskat_par32_scenarie_særligt_aktiv_fra_abl("par32-abl19b-aktie", abl19b_aktieindkomst_input, AblPar17UndtagetEfterPar19B),
            personskat_par32_scenarie_særligt_aktiv_fra_abl("par32-abl19c-kapital", abl19c_kapital_input, AblPar17UndtagetEfterPar19C)
        ],
        udbytter = []
    )
)

= personskat_par32_scenarie_blandet_fordeling = KglPar32FordelEfterKilder(kilder = [
    KglPar32SupplerendeAblKilde(kildeidentifikation = "par32-abl19c-kapital"),
    KglPar32SupplerendeAblKilde(kildeidentifikation = "par32-abl22-kapital"),
    KglPar32SupplerendeAblKilde(kildeidentifikation = "par32-abl19b-aktie")
])
= personskat_par32_scenarie_blandet_resultat = beregn_personskat(personskat_par32_scenarie_blandet_input(personskat_par32_scenarie_blandet_fordeling))
= personskat_par32_scenarie_blandet_automatisk_resultat = beregn_personskat(personskat_par32_scenarie_blandet_input(KglPar32AfledEntydigFordeling))
= personskat_par32_scenarie_abl22_fælles_bagatel_resultat = beregn_personskat(personskat_par32_scenarie_input(
