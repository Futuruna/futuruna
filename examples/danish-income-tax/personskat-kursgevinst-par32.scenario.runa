= personskat_par32_scenarie_blandet_kontrol = match personskat_par32_scenarie_blandet_resultat.kursgevinst_par32 {
    | BeregnetPar32Kontraktforløb(_, aktuelt_årsresultat, _, _, input_gyldigt) -> {
        = fordeling = aktuelt_årsresultat.venstre_aktiemodregningsfordeling
        = samlet_fordeling_gyldig = input_gyldigt && aktuelt_årsresultat.input_gyldigt && fordeling.input_gyldigt && fordeling.modregning_i_alt_kroner == 30000 && fordeling.fordelt_i_alt_kroner == 30000 && length(fordeling.anvendelser) == 3
        = første_kilde_gyldig = fordeling.anvendelser[0].kilde.mål == KglPar32SupplerendeAblKilde(kildeidentifikation = "par32-abl19c-kapital") && fordeling.anvendelser[0].kilde.klasser == [KglPar32Abl19CInvesteringsselskab] && fordeling.anvendelser[0].kilde.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5 && fordeling.anvendelser[0].modregnet_kroner == 12000
        = anden_kilde_gyldig = fordeling.anvendelser[1].kilde.mål == KglPar32SupplerendeAblKilde(kildeidentifikation = "par32-abl22-kapital") && fordeling.anvendelser[1].kilde.klasser == [KglPar32Abl22ObligationsbaseretMinimumsbevis] && fordeling.anvendelser[1].kilde.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5 && fordeling.anvendelser[1].modregnet_kroner == 8000
        = tredje_kilde_gyldig = fordeling.anvendelser[2].kilde.mål == KglPar32SupplerendeAblKilde(kildeidentifikation = "par32-abl19b-aktie") && fordeling.anvendelser[2].kilde.klasser == [KglPar32Abl19BInvesteringsselskab] && fordeling.anvendelser[2].kilde.personskattelov_kategori == AblAktieindkomstEfterPslPar4a && fordeling.anvendelser[2].modregnet_kroner == 10000
        = indkomstklasser_bevaret = personskat_par32_scenarie_blandet_resultat.aktieavance.aktieindkomst_kroner == 10000 && personskat_par32_scenarie_blandet_resultat.aktieavance.kapitalindkomst_kroner == -8000 && personskat_par32_scenarie_blandet_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 0
        samlet_fordeling_gyldig && første_kilde_gyldig && anden_kilde_gyldig && tredje_kilde_gyldig && indkomstklasser_bevaret
    }
    | IntetPar32Kontraktforløb -> Falskt
}
