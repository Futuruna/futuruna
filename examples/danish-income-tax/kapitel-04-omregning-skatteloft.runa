@ sprog da

@ importer ./pengebeloeb
@ importer ./skatteaar - parametre

-- Personskatteloven — omregning, skatteloft og regulering (§§ 14-20).
--
-- Kilde: Retsinformation, LBK nr. 1284 af 14/06/2021.
-- Officiel tekst: https://www.retsinformation.dk/eli/lta/2021/1284
-- XML: https://www.retsinformation.dk/eli/lta/2021/1284/dan/xml

----
§ 14. Hvis en person bliver skattepligtig, eller hvis en person ophører med at
være skattepligtig, jf. kildeskattelovens § 1, omregnes såvel den
skattepligtige indkomst som den personlige indkomst og kapitalindkomsten for det
år, hvor skattepligten indtræder eller ophører, således at beløbene kommer til
at svare til et helt års indkomster.
På grundlag af de opgjorte helårsindkomster beregnes helårsskat efter §§ 6-9.
Den beregnede helårsskat nedsættes efter forholdet mellem delårsbeløbene og
helårsbeløbene.

Stk. 2. En person kan vælge, at der ikke skal ske helårsomregning efter stk. 1.
I så fald skal personen opgøre sin skattepligtige indkomst, personlige indkomst
og kapitalindkomst for det pågældende år, som om vedkommende var skattepligtig
efter kildeskattelovens § 1 for hele året.
Den samlede indkomstskat nedsættes med det beløb, som forholdsmæssigt falder på
den del af indkomsten, som vedrører den periode, hvor personen ikke var
skattepligtig.
Valget skal træffes ved afgivelse af oplysninger til told- og skatteforvaltningen
efter skattekontrollovens § 2 for det år, hvor skattepligten ophører.
Valget kan omgøres, hvis tilkendegivelse herom sker til told- og
skatteforvaltningen senest den 30. juni i det andet kalenderår efter udløbet af
det pågældende indkomstår.

Stk. 3. For en person omfattet af § 10, stk. 6, omregnes såvel den
skattepligtige indkomst som den personlige indkomst og kapitalindkomsten for det
år, hvor den begrænsede skattepligt indtræder eller ophører, således at
beløbene kommer til at svare til et helt års indkomster.
På grundlag af de opgjorte helårsindkomster beregnes helårsskat efter §§ 6-9.
Den beregnede helårsskat nedsættes efter forholdet mellem delårsbeløbene og
helårsbeløbene.
----

----
Den juridiske vejledning 2026-1, C.F.1.6.2.1:
Eksemplet om helårsomregning viser, at løbende delårsbeløb omregnes til hele
året og afrundes til hele kroner, mens engangsbeløb ikke omregnes.
Samme vejledning beskriver oplysningsskema-valget for året, hvor skattepligten
ophører eller indtræder.
https://info.skat.dk/data.aspx?oid=1977388
----

# Par14Skattepligtsændring = FuldSkattepligtIndtræder | FuldSkattepligtOphører | BegrænsetSkattepligtPar10Stk6Indtræder | BegrænsetSkattepligtPar10Stk6Ophører | IngenSkattepligtsændring
# Par14Beløbsart = Par14LøbendeBeløb | Par14EngangsBeløb
# Par14Beløbspost(beløb_kroner: Heltal, art: Par14Beløbsart)
# Par14OmregningInput(delårs_skattepligtig_indkomst_kroner: Heltal, delårs_personlig_indkomst_kroner: Heltal, delårs_kapitalindkomst_kroner: Heltal, skattepligtsdage: Heltal)
# Par14Helårsindkomst(skattepligtig_indkomst_kroner: Heltal, personlig_indkomst_kroner: Heltal, kapitalindkomst_kroner: Heltal)
# Par14SkattenedsættelseInput(helårsskat_kroner: Heltal, delårsbeløb_kroner: Heltal, helårsbeløb_kroner: Heltal)
# Par14ValgInput(skatteår: Heltal, skattepligtsændring: Par14Skattepligtsændring, valg_afgivet_ved_oplysninger: Boolsk, omvalg_dato_yyyymmdd: Heltal)
# Par14ValgResultat(valg_muligt: Boolsk, valg_afgivet_ved_oplysninger: Boolsk, valg_gældende: Boolsk, omvalgsfrist_yyyymmdd: Heltal, omvalg_rettidigt: Boolsk, omvalg_gennemført: Boolsk, helårsomregning_skal_ske: Boolsk)
# Par14SkatteberegningInput(omregning: Par14OmregningInput, valg: Par14ValgResultat, helårsskat_efter_par6_til_par9_kroner: Heltal, samlet_indkomstskat_som_helårsskattepligtig_kroner: Heltal)
# Par14SkatteberegningResultat(helårsindkomst: Par14Helårsindkomst, helårsskat_efter_par6_til_par9_kroner: Heltal, stk1_eller_stk3_delårsskat_kroner: Heltal, stk2_skat_efter_periodenedsættelse_kroner: Heltal, helårsomregning_skal_ske: Boolsk, skat_efter_par14_kroner: Heltal)

| par14_helårsomregning_gælder(status: Par14Skattepligtsændring) -> status == FuldSkattepligtIndtræder || status == FuldSkattepligtOphører || status == BegrænsetSkattepligtPar10Stk6Indtræder || status == BegrænsetSkattepligtPar10Stk6Ophører
| par14_valg_uden_helårsomregning_muligt(status: Par14Skattepligtsændring) -> status == FuldSkattepligtIndtræder || status == FuldSkattepligtOphører
| par14_helt_kroner_afrundet(tæller: Heltal, nævner: Heltal) -> (tæller + nævner / 2) / nævner under tæller >= 0 && nævner > 0
| par14_helt_kroner_afrundet(tæller: Heltal, nævner: Heltal) -> 0 - ((0 - tæller + nævner / 2) / nævner) under tæller < 0 && nævner > 0
| par14_helårsbeløb(delårsbeløb_kroner: Heltal, skattepligtsdage: Heltal) -> par14_helt_kroner_afrundet(delårsbeløb_kroner * 365, skattepligtsdage) under skattepligtsdage > 0
| par14_helårsbeløb_for_post(post: Par14Beløbspost, skattepligtsdage: Heltal) -> par14_helårsbeløb(post.beløb_kroner, skattepligtsdage) under post.art == Par14LøbendeBeløb
| par14_helårsbeløb_for_post(post: Par14Beløbspost, skattepligtsdage: Heltal) -> post.beløb_kroner under post.art == Par14EngangsBeløb
| par14_helårsindkomst(input: Par14OmregningInput) -> Par14Helårsindkomst(
    skattepligtig_indkomst_kroner = par14_helårsbeløb(input.delårs_skattepligtig_indkomst_kroner, input.skattepligtsdage),
    personlig_indkomst_kroner = par14_helårsbeløb(input.delårs_personlig_indkomst_kroner, input.skattepligtsdage),
    kapitalindkomst_kroner = par14_helårsbeløb(input.delårs_kapitalindkomst_kroner, input.skattepligtsdage)
)
| par14_helårsskat_nedsat_for_delår(input: Par14SkattenedsættelseInput) -> input.helårsskat_kroner * input.delårsbeløb_kroner / input.helårsbeløb_kroner under input.helårsbeløb_kroner > 0
| par14_stk2_skat_efter_periodenedsættelse(samlet_indkomstskat_som_helårsskattepligtig_kroner: Heltal, skattepligtsdage: Heltal) -> samlet_indkomstskat_som_helårsskattepligtig_kroner * skattepligtsdage / 365 under skattepligtsdage > 0
| par14_valg_muligt(input: Par14ValgInput) -> par14_valg_uden_helårsomregning_muligt(input.skattepligtsændring)
| par14_valg_gældende(input: Par14ValgInput) -> par14_valg_muligt(input) && input.valg_afgivet_ved_oplysninger
| par14_omvalgsfrist_yyyymmdd(skatteår: Heltal) -> (skatteår + 2) * 10000 + 630
| par14_omvalg_rettidigt(input: Par14ValgInput) -> input.omvalg_dato_yyyymmdd > 0 && input.omvalg_dato_yyyymmdd <= par14_omvalgsfrist_yyyymmdd(input.skatteår)
| par14_omvalg_gennemført(input: Par14ValgInput) -> par14_valg_gældende(input) && par14_omvalg_rettidigt(input)
| par14_helårsomregning_skal_ske(input: Par14ValgInput) -> par14_helårsomregning_gælder(input.skattepligtsændring)
| exception par14_stk2_valg_uden_omvalg par14_helårsomregning_skal_ske(input: Par14ValgInput) -> Falskt under par14_valg_gældende(input) && par14_omvalg_gennemført(input) == Falskt
| exception par14_stk2_rettidigt_omvalg par14_helårsomregning_skal_ske(input: Par14ValgInput) -> Sandt under par14_omvalg_gennemført(input)
| par14_valg_resultat(input: Par14ValgInput) -> Par14ValgResultat(
    valg_muligt = par14_valg_muligt(input),
    valg_afgivet_ved_oplysninger = input.valg_afgivet_ved_oplysninger,
    valg_gældende = par14_valg_gældende(input),
    omvalgsfrist_yyyymmdd = par14_omvalgsfrist_yyyymmdd(input.skatteår),
    omvalg_rettidigt = par14_omvalg_rettidigt(input),
    omvalg_gennemført = par14_omvalg_gennemført(input),
    helårsomregning_skal_ske = par14_helårsomregning_skal_ske(input)
)

# Par14SkatteberegningSag(input: Par14SkatteberegningInput) {
    | helårsindkomst() -> par14_helårsindkomst(input.omregning)
    | stk1_eller_stk3_delårsskat_kroner() -> par14_helårsskat_nedsat_for_delår(Par14SkattenedsættelseInput(
        helårsskat_kroner = input.helårsskat_efter_par6_til_par9_kroner,
        delårsbeløb_kroner = input.omregning.delårs_skattepligtig_indkomst_kroner,
        helårsbeløb_kroner = helårsindkomst().skattepligtig_indkomst_kroner
    ))
    | stk2_skat_efter_periodenedsættelse_kroner() -> par14_stk2_skat_efter_periodenedsættelse(
        input.samlet_indkomstskat_som_helårsskattepligtig_kroner,
        input.omregning.skattepligtsdage
    )
    | skat_efter_par14_kroner() -> stk2_skat_efter_periodenedsættelse_kroner() under input.valg.helårsomregning_skal_ske == Falskt
    | exception par14_stk1_eller_stk3_helårsomregnet_skat skat_efter_par14_kroner() -> stk1_eller_stk3_delårsskat_kroner() under input.valg.helårsomregning_skal_ske
    | resultat() -> Par14SkatteberegningResultat(
        helårsindkomst = helårsindkomst(),
        helårsskat_efter_par6_til_par9_kroner = input.helårsskat_efter_par6_til_par9_kroner,
        stk1_eller_stk3_delårsskat_kroner = stk1_eller_stk3_delårsskat_kroner(),
        stk2_skat_efter_periodenedsættelse_kroner = stk2_skat_efter_periodenedsættelse_kroner(),
        helårsomregning_skal_ske = input.valg.helårsomregning_skal_ske,
        skat_efter_par14_kroner = skat_efter_par14_kroner()
    )
}
| par14_skatteberegning_sag(input: Par14SkatteberegningInput) -> Par14SkatteberegningSag(input)
| par14_skatteberegning_resultat(input: Par14SkatteberegningInput) -> par14_skatteberegning_sag(input).resultat()

= par14_fixture = par14_helårsindkomst(Par14OmregningInput(
    delårs_skattepligtig_indkomst_kroner = 180000,
    delårs_personlig_indkomst_kroner = 200000,
    delårs_kapitalindkomst_kroner = -20000,
    skattepligtsdage = 180
))
= par14_skattenedsættelse_fixture = par14_helårsskat_nedsat_for_delår(Par14SkattenedsættelseInput(
