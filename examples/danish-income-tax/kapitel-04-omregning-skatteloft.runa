| par20_reguleringstal_tiendedele_for_skatteår(skatteår: Heltal) -> 1373 under skatteår == 2026
| par20_reguleringstal_resultat(skatteår: Heltal) -> Par20ReguleringstalResultat(
    skatteår = skatteår,
    kilde = par20_reguleringstal_kilde(skatteår),
    reguleringstal_tiendedele = par20_reguleringstal_tiendedele_for_skatteår(skatteår)
)
| par20_reguleringstal_tiendedele(skatteår: Heltal) -> par20_reguleringstal_resultat(skatteår).reguleringstal_tiendedele
| par20_reguleringstal_2009_til_2013_tiendedele(skatteår: Heltal) -> par20_reguleringstal_tiendedele(skatteår) under skatteår >= 2009 && skatteår <= 2013
| par20_reguleret_før_afrunding_kroner(input: Par20ReguleringInput) -> input.grundbeløb_2010_niveau_kroner * input.reguleringstal_tiendedele / 1000
| par20_afrund_op_til_nærmeste_100_kroner(beløb_kroner: Heltal) -> beløb_kroner under beløb_kroner % 100 == 0
| par20_afrund_op_til_nærmeste_100_kroner(beløb_kroner: Heltal) -> (beløb_kroner / 100 + 1) * 100 under beløb_kroner % 100 != 0
