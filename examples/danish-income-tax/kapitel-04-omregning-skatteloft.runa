))
= par14_stk3_begrænset_ingen_valg_fixture = par14_valg_resultat(Par14ValgInput(
    skatteår = 2026,
    skattepligtsændring = BegrænsetSkattepligtPar10Stk6Indtræder,
    valg_afgivet_ved_oplysninger = Sandt,
    omvalg_dato_yyyymmdd = 20280630
))
= par14_stk1_skatteberegning_fixture = par14_skatteberegning_resultat(Par14SkatteberegningInput(
    omregning = Par14OmregningInput(
        delårs_skattepligtig_indkomst_kroner = 180000,
        delårs_personlig_indkomst_kroner = 200000,
        delårs_kapitalindkomst_kroner = -20000,
        skattepligtsdage = 180
    ),
    valg = par14_valg_resultat(Par14ValgInput(
        skatteår = 2026,
        skattepligtsændring = FuldSkattepligtIndtræder,
        valg_afgivet_ved_oplysninger = Falskt,
        omvalg_dato_yyyymmdd = 0
    )),
    helårsskat_efter_par6_til_par9_kroner = 100000,
    samlet_indkomstskat_som_helårsskattepligtig_kroner = 90000
))
= par14_stk2_skatteberegning_fixture = par14_skatteberegning_resultat(Par14SkatteberegningInput(
    omregning = Par14OmregningInput(
        delårs_skattepligtig_indkomst_kroner = 180000,
        delårs_personlig_indkomst_kroner = 200000,
        delårs_kapitalindkomst_kroner = -20000,
        skattepligtsdage = 180
    ),
    valg = par14_stk2_valg_fixture,
    helårsskat_efter_par6_til_par9_kroner = 100000,
    samlet_indkomstskat_som_helårsskattepligtig_kroner = 90000
))

| par14_helårsomregner_indkomster: par14_fixture -> par14_fixture.skattepligtig_indkomst_kroner == 365000 && par14_fixture.personlig_indkomst_kroner == 405556 && par14_fixture.kapitalindkomst_kroner == -40556
| par14_nedsætter_helårsskat_forholdsmæssigt: par14_skattenedsættelse_fixture -> par14_skattenedsættelse_fixture == 49315
| par14_engangsbeløb_omregnes_ikke: par14_engangsbeløb_fixture -> par14_engangsbeløb_fixture == 168232
| par14_fuld_skattepligt_kræver_omregning: par14_fuld_skattepligt_omregnes -> par14_fuld_skattepligt_omregnes == Sandt
| par14_stk2_valg_findes: par14_valg_muligt_fixture -> par14_valg_muligt_fixture == Sandt
| par14_stk2_valg_afskærer_helårsomregning: par14_stk2_valg_fixture -> par14_stk2_valg_fixture.valg_gældende == Sandt && par14_stk2_valg_fixture.helårsomregning_skal_ske == Falskt && par14_stk2_valg_fixture.omvalgsfrist_yyyymmdd == 20280630
| par14_stk2_rettidigt_omvalg_genindfører_helårsomregning: par14_stk2_omvalg_rettidigt_fixture -> par14_stk2_omvalg_rettidigt_fixture.omvalg_rettidigt == Sandt && par14_stk2_omvalg_rettidigt_fixture.omvalg_gennemført == Sandt && par14_stk2_omvalg_rettidigt_fixture.helårsomregning_skal_ske == Sandt
| par14_stk2_for_sent_omvalg_ændrer_ikke_valg: par14_stk2_omvalg_for_sent_fixture -> par14_stk2_omvalg_for_sent_fixture.omvalg_rettidigt == Falskt && par14_stk2_omvalg_for_sent_fixture.omvalg_gennemført == Falskt && par14_stk2_omvalg_for_sent_fixture.helårsomregning_skal_ske == Falskt
| par14_stk3_begrænset_skattelpligt_har_ikke_stk2_valg: par14_stk3_begrænset_ingen_valg_fixture -> par14_stk3_begrænset_ingen_valg_fixture.valg_muligt == Falskt && par14_stk3_begrænset_ingen_valg_fixture.valg_gældende == Falskt && par14_stk3_begrænset_ingen_valg_fixture.helårsomregning_skal_ske == Sandt
| par14_skatteberegning_stk1_bruger_helårsomregning: par14_stk1_skatteberegning_fixture -> par14_stk1_skatteberegning_fixture.helårsomregning_skal_ske == Sandt && par14_stk1_skatteberegning_fixture.stk1_eller_stk3_delårsskat_kroner == 49315 && par14_stk1_skatteberegning_fixture.skat_efter_par14_kroner == 49315
| par14_skatteberegning_stk2_bruger_periodenedsættelse: par14_stk2_skatteberegning_fixture -> par14_stk2_skatteberegning_fixture.helårsomregning_skal_ske == Falskt && par14_stk2_skatteberegning_fixture.stk2_skat_efter_periodenedsættelse_kroner == 44383 && par14_stk2_skatteberegning_fixture.skat_efter_par14_kroner == 44383

----
§§ 15-17. (Ophævet)
----

# OphævetPersonskatParagraf = Par15Til17 | Par18

| personskatteloven_paragraf_ophævet(paragraf: OphævetPersonskatParagraf) -> Sandt

= par15_17_ophævet = personskatteloven_paragraf_ophævet(Par15Til17)

| par15_17_er_ophævet: par15_17_ophævet -> par15_17_ophævet == Sandt

----
§ 18. (Ophævet)
----

= par18_ophævet = personskatteloven_paragraf_ophævet(Par18)

| par18_er_ophævet: par18_ophævet -> par18_ophævet == Sandt

----
§ 19. Hvis summen af skatteprocenterne efter §§ 6, 7 og 8 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger den procent, der er anført i 2.-6. pkt., beregnes et
nedslag i statsskatten svarende til, at skatteprocenten ved beregningen af
skatten efter § 7, stk. 3 og 7, blev nedsat med de overskydende procenter.
For indkomstårene 2015-2017 udgør procenten 51,95.
For indkomståret 2018 udgør procenten 52,02.
For indkomståret 2019 udgør procenten 52,05.
For indkomstårene 2020 og 2021 udgør procenten 52,06.
For indkomståret 2022 og efterfølgende indkomstår udgør procenten 52,07.

Stk. 2. Hvis summen af skatteprocenterne efter §§ 6, 7 og 8 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger 49,5 pct. for indkomståret 2010, 47,5 pct. for
indkomståret 2011, 45,5 pct. for indkomståret 2012, 43,5 pct. for indkomståret
2013 og 42,0 pct. for indkomståret 2014 og senere indkomstår, beregnes et
nedslag i statsskatten svarende til, at skatteprocenten ved beregningen af
skatten efter § 7, stk. 4, 8 og 9, blev nedsat med de overskydende procenter.
----

----
LOV nr. 482 af 22/05/2024, § 1, nr. 15.

§ 19 affattes således:

§ 19. Hvis summen af skatteprocenterne efter §§ 6 og 7 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger 44,57 pct., beregnes et nedslag i statsskatten, svarende
til at skatteprocenten ved beregningen af skatten efter § 7, stk. 3 og 7, blev
nedsat med de overskydende procenter.

Stk. 2. Hvis summen af skatteprocenterne efter §§ 6 og 7 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger 42,0 pct., beregnes et nedslag i statsskatten, svarende
til at skatteprocenten ved beregningen af skatten efter § 7, stk. 4 og 8-11, blev
nedsat med de overskydende procenter.
----

# Par19SkatteloftInput(skatteår: Heltal, bundskat_basispoint: Heltal, progressiv_statsskat_basispoint: Heltal, sundhedsbidrag_basispoint: Heltal, kommunal_eller_par8c_basispoint: Heltal, beregningsgrundlag_kroner: Heltal)
# Par19SkatteloftType = Par19PersonligtLoft | Par19PositivKapitalLoft
# Par19SkatteloftKilde = PersonskattelovenLbk1284Af2021Par19Stk1 | PersonskattelovenLbk1284Af2021Par19Stk2 | PersonskattelovenLov482Af2024Par1Nr15Stk1 | PersonskattelovenLov482Af2024Par1Nr15Stk2
# Par19SkatteloftResultat(skatteår: Heltal, lofttype: Par19SkatteloftType, kilde: Par19SkatteloftKilde, loft_basispoint: Heltal)
# Par19SkatteloftNedslagInput(lofttype: Par19SkatteloftType, skatteloft_input: Par19SkatteloftInput)
# Par19SkatteloftNedslagResultat(loft: Par19SkatteloftResultat, skatteloft_input: Par19SkatteloftInput, samlet_skatteprocent_basispoint: Heltal, overskydende_basispoint: Heltal, progressiv_skat_efter_loft_basispoint: Heltal, nedslag_kroner: Heltal)
# Par19SkatteloftKomponent = Par19Bundskat | Par19ProgressivStatsskat | Par19KommunalSkat | Par19Par8cSkat | Par19CfcSkat

| par19_skatteprocent_omfatter(komponent: Par19SkatteloftKomponent) -> Falskt
| exception par19_omfatter_bundskat par19_skatteprocent_omfatter(komponent: Par19SkatteloftKomponent) -> Sandt under komponent == Par19Bundskat
| exception par19_omfatter_progressiv_statsskat par19_skatteprocent_omfatter(komponent: Par19SkatteloftKomponent) -> Sandt under komponent == Par19ProgressivStatsskat
| exception par19_omfatter_kommunal_skat par19_skatteprocent_omfatter(komponent: Par19SkatteloftKomponent) -> Sandt under komponent == Par19KommunalSkat
| exception par19_omfatter_par8c_skat par19_skatteprocent_omfatter(komponent: Par19SkatteloftKomponent) -> Sandt under komponent == Par19Par8cSkat
