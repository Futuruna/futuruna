@ sprog da

@ importer ./pengebeloeb
@ importer ./skatteaar - parametre

-- Personskatteloven — omregning, skatteloft og regulering (§§ 14-20).
--
-- Kilde: Retsinformation, LBK nr. 1284 af 14/06/2021.
-- Officiel tekst: https://www.retsinformation.dk/eli/lta/2021/1284
-- XML: https://www.retsinformation.dk/eli/lta/2021/1284/dan/xml

----
§ 14. Hvis en person bliver skattepligtig, eller hvis en person ophører med at
være skattepligtig, jf. kildeskattelovens § 1, omregnes såvel den
skattepligtige indkomst som den personlige indkomst og kapitalindkomsten for det
år, hvor skattepligten indtræder eller ophører, således at beløbene kommer til
at svare til et helt års indkomster.
På grundlag af de opgjorte helårsindkomster beregnes helårsskat efter §§ 6-9.
Den beregnede helårsskat nedsættes efter forholdet mellem delårsbeløbene og
helårsbeløbene.

Stk. 2. En person kan vælge, at der ikke skal ske helårsomregning efter stk. 1.
I så fald skal personen opgøre sin skattepligtige indkomst, personlige indkomst
og kapitalindkomst for det pågældende år, som om vedkommende var skattepligtig
efter kildeskattelovens § 1 for hele året.
Den samlede indkomstskat nedsættes med det beløb, som forholdsmæssigt falder på
den del af indkomsten, som vedrører den periode, hvor personen ikke var
skattepligtig.
Valget skal træffes ved afgivelse af oplysninger til told- og skatteforvaltningen
efter skattekontrollovens § 2 for det år, hvor skattepligten ophører.
Valget kan omgøres, hvis tilkendegivelse herom sker til told- og
skatteforvaltningen senest den 30. juni i det andet kalenderår efter udløbet af
det pågældende indkomstår.

Stk. 3. For en person omfattet af § 10, stk. 6, omregnes såvel den
skattepligtige indkomst som den personlige indkomst og kapitalindkomsten for det
år, hvor den begrænsede skattepligt indtræder eller ophører, således at
beløbene kommer til at svare til et helt års indkomster.
På grundlag af de opgjorte helårsindkomster beregnes helårsskat efter §§ 6-9.
Den beregnede helårsskat nedsættes efter forholdet mellem delårsbeløbene og
helårsbeløbene.
----

# Par14Skattepligtsændring = FuldSkattepligtIndtræder | FuldSkattepligtOphører | BegrænsetSkattepligtPar10Stk6Indtræder | BegrænsetSkattepligtPar10Stk6Ophører | IngenSkattepligtsændring
# Par14OmregningInput(delårs_skattepligtig_indkomst_kroner: Heltal, delårs_personlig_indkomst_kroner: Heltal, delårs_kapitalindkomst_kroner: Heltal, skattepligtsdage: Heltal)
# Par14Helårsindkomst(skattepligtig_indkomst_kroner: Heltal, personlig_indkomst_kroner: Heltal, kapitalindkomst_kroner: Heltal)
# Par14SkattenedsættelseInput(helårsskat_kroner: Heltal, delårsbeløb_kroner: Heltal, helårsbeløb_kroner: Heltal)

| par14_helårsomregning_gælder(status: Par14Skattepligtsændring) -> status == FuldSkattepligtIndtræder || status == FuldSkattepligtOphører || status == BegrænsetSkattepligtPar10Stk6Indtræder || status == BegrænsetSkattepligtPar10Stk6Ophører
| par14_valg_uden_helårsomregning_muligt(status: Par14Skattepligtsændring) -> status == FuldSkattepligtIndtræder || status == FuldSkattepligtOphører
| par14_helårsbeløb(delårsbeløb_kroner: Heltal, skattepligtsdage: Heltal) -> delårsbeløb_kroner * 365 / skattepligtsdage under skattepligtsdage > 0
| par14_helårsindkomst(input: Par14OmregningInput) -> Par14Helårsindkomst(par14_helårsbeløb(input.delårs_skattepligtig_indkomst_kroner, input.skattepligtsdage), par14_helårsbeløb(input.delårs_personlig_indkomst_kroner, input.skattepligtsdage), par14_helårsbeløb(input.delårs_kapitalindkomst_kroner, input.skattepligtsdage))
| par14_helårsskat_beregnes_efter_par6_til_par9() -> Sandt
| par14_helårsskat_nedsat_for_delår(input: Par14SkattenedsættelseInput) -> input.helårsskat_kroner * input.delårsbeløb_kroner / input.helårsbeløb_kroner under input.helårsbeløb_kroner > 0
| par14_valg_træffes_ved_oplysninger_til_forvaltningen() -> Sandt
| par14_valg_kan_omgøres_senest_30_juni_i_andet_år() -> Sandt

= par14_fixture = par14_helårsindkomst(Par14OmregningInput(180000, 200000, -20000, 180))
= par14_skattenedsættelse_fixture = par14_helårsskat_nedsat_for_delår(Par14SkattenedsættelseInput(100000, 180000, par14_fixture.skattepligtig_indkomst_kroner))
= par14_fuld_skattepligt_omregnes = par14_helårsomregning_gælder(FuldSkattepligtIndtræder)
= par14_valg_muligt = par14_valg_uden_helårsomregning_muligt(FuldSkattepligtOphører)

| par14_helårsomregner_indkomster: par14_fixture -> par14_fixture.skattepligtig_indkomst_kroner == 365000 && par14_fixture.personlig_indkomst_kroner == 405555 && par14_fixture.kapitalindkomst_kroner == -40555
| par14_nedsætter_helårsskat_forholdsmæssigt: par14_skattenedsættelse_fixture -> par14_skattenedsættelse_fixture == 49315
| par14_fuld_skattepligt_kræver_omregning: par14_fuld_skattepligt_omregnes -> par14_fuld_skattepligt_omregnes == Sandt
| par14_stk2_valg_findes: par14_valg_muligt -> par14_valg_muligt == Sandt

