    reguleret_før_afrunding_kroner = par20_reguleret_før_afrunding_kroner(input),
    reguleret_og_afrundet_kroner = par20_afrund_op_til_nærmeste_100_kroner(par20_reguleret_før_afrunding_kroner(input))
)
| par20_reguleret_og_afrundet_kroner(input: Par20ReguleringInput) -> par20_regulering_resultat(input).reguleret_og_afrundet_kroner

= par20_basisår = par20_reguleringstal_tiendedele(2012)
