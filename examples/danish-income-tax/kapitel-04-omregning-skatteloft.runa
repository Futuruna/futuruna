))
= par14_stk2_omvalg_for_sent_fixture = par14_valg_resultat(Par14ValgInput(
    skatteår = 2026,
    skattepligtsændring = FuldSkattepligtIndtræder,
    valg_afgivet_ved_oplysninger = Sandt,
