    helårsbeløb_kroner = par14_fixture.skattepligtig_indkomst_kroner
))
= par14_engangsbeløb_fixture = par14_helårsbeløb_for_post(Par14Beløbspost(168232, Par14EngangsBeløb), 27)
= par14_fuld_skattepligt_omregnes = par14_helårsomregning_gælder(FuldSkattepligtIndtræder)
= par14_valg_muligt_fixture = par14_valg_uden_helårsomregning_muligt(FuldSkattepligtOphører)
