-- Small checked fixture for a query-owned rule-dispatch observer.
-- Both endpoint observations return True. Once isolated observer replay is
-- implemented, their traces can still differ because canonical rule dispatch
-- reaches and selects different checked candidates. This fixture currently
-- seals the transition and observation IR only; it is not a Personskat result.

# IncomeState = IncomeState(income: Int)
# IncomeContext = IncomeContext(step: Int)

| route(0) -> True
| route(value: Int) -> True

> observe_route(state: IncomeState, context: IncomeContext) -> Bool {
    route(state.income)
}

| is_declared_step(
    before: IncomeState,
    after: IncomeState,
    context: IncomeContext
) -> after.income == before.income + context.step

? explore rule_dispatch_mechanism_observation_smoke {
    over is_declared_step(before, after, context)
    find matches
    bounds {
        context.step = 1
        before.income in range(0, 3)
    }
    transition as IncomeState context IncomeContext {
        relative
        after.income = before.income + context.step
    }
    boundaries on before.income by context.step
    observe mechanisms with observe_route
    output {
        key [income = before.income]
        show [
            before_route = route(before.income),
            after_route = route(after.income)
        ]
        representative first
    }
}
