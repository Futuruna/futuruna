@ sprog da

@ importer ./ligningsloven - par10 - par11 - underhold

| underhold_scenarie_barn(fødselsdato: Dato, bopæl: Ligningslov10Og11BarnetsBopæl, offentlig_forsørgerpligt: Boolsk) -> Ligningslov10Og11BarnFakta(
    fødselsdato = fødselsdato,
    bopæl = bopæl,
    forsørger_eller_bidragspligt_over_for_det_offentlige = offentlig_forsørgerpligt
)

| underhold_scenarie_børnebidrag(identifikation: Tekst, indkomstår: Heltal, rolle: Ligningslov10Og11Bidragsrolle, retsgrundlag: Ligningslov10Og11Retsgrundlag, fastsættelse: Ligningslov10Og11Fastsættelse, bidragsart: Ligningslov10Og11Bidragsart, barn: Ligningslov10Og11BarnFakta, forfaldsdato: Dato, beløb_kroner: Heltal) -> Ligningslov10Og11BidragFakta(
    identifikation = identifikation,
    indkomstår = indkomstår,
    rolle = rolle,
    retsgrundlag = retsgrundlag,
    modtager_identifikation = "barn-a",
    modtager = Barn(fakta = barn),
    fastsættelse = fastsættelse,
    bidragsart = bidragsart,
    betalingsvej = BetaltTilDenBidragsberettigede,
    restancestatus = OrdinærBetaling,
    forfaldsdato = forfaldsdato,
    betalingsdato = forfaldsdato,
    beløb_kroner = beløb_kroner,
    betalt_af_bidragsyderen_selv = Sandt
)

| underhold_scenarie_ægtefællebidrag(identifikation: Tekst, rolle: Ligningslov10Og11Bidragsrolle, retsgrundlag: Ligningslov10Og11Retsgrundlag, fastsættelse: Ligningslov10Og11Fastsættelse, beløb_kroner: Heltal) -> Ligningslov10Og11BidragFakta(
    identifikation = identifikation,
    indkomstår = 2025,
    rolle = rolle,
    retsgrundlag = retsgrundlag,
    modtager_identifikation = "ægtefælle-a",
    modtager = ÆgtefælleEllerTidligereÆgtefælle(parterne_bor_sammen = Falskt),
    fastsættelse = fastsættelse,
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    betalingsvej = BetaltTilDenBidragsberettigede,
    restancestatus = OrdinærBetaling,
    forfaldsdato = Dato(år = 2025, måned = 12, dag = 1),
    betalingsdato = Dato(år = 2025, måned = 12, dag = 1),
    beløb_kroner = beløb_kroner,
    betalt_af_bidragsyderen_selv = Sandt
)

= underhold_barn_under_18 = underhold_scenarie_barn(
    fødselsdato = Dato(år = 2012, måned = 6, dag = 10),
    bopæl = HosDenAndenForælder,
    offentlig_forsørgerpligt = Sandt
)
= underhold_barn_fylder_18_i_april = underhold_scenarie_barn(
    fødselsdato = Dato(år = 2007, måned = 4, dag = 5),
    bopæl = HosDenAndenForælder,
    offentlig_forsørgerpligt = Sandt
)
= underhold_barn_hos_bidragsyder = underhold_scenarie_barn(
    fødselsdato = Dato(år = 2012, måned = 6, dag = 10),
    bopæl = HosBidragsyderen,
    offentlig_forsørgerpligt = Sandt
)
= underhold_barn_uden_offentlig_pligt = underhold_scenarie_barn(
    fødselsdato = Dato(år = 2012, måned = 6, dag = 10),
    bopæl = HosDenAndenForælder,
    offentlig_forsørgerpligt = Falskt
)
= underhold_skilsmisse_omfattet = Skilsmisse(fastsat_eller_ændret_efter_lovens_ikrafttrædelse = Sandt)
= underhold_separation_omfattet = Separation(fastsat_eller_ændret_efter_lovens_ikrafttrædelse = Sandt)

= underhold_ægtefælle_yder = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_ægtefællebidrag(
    identifikation = "ægtefælle-yder",
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IkkeRelevantForFradraget),
    beløb_kroner = 24000
)]))
= underhold_ægtefælle_modtager = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_ægtefællebidrag(
    identifikation = "ægtefælle-modtager",
    rolle = Bidragsmodtager,
    retsgrundlag = underhold_separation_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    beløb_kroner = 24000
)]))
= underhold_ægtefælle_historisk_ikke_omfattet = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_ægtefællebidrag(
    identifikation = "ægtefælle-historisk-ikke-omfattet",
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = Skilsmisse(fastsat_eller_ændret_efter_lovens_ikrafttrædelse = Falskt),
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IkkeRelevantForFradraget),
    beløb_kroner = 24000
)]))
= underhold_faktisk_adskillelse_godkendt = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_ægtefællebidrag(
    identifikation = "faktisk-adskillelse-godkendt",
    rolle = Bidragsmodtager,
    retsgrundlag = FaktiskAdskillelse(
        faktisk_adskillelse_dokumenteret = Sandt,
        ægtefællerne_ansat_selvstændigt_til_statsskat = Sandt
    ),
    fastsættelse = GodkendtAfOffentligMyndighed,
    beløb_kroner = 18000
)]))
= underhold_faktisk_adskillelse_uden_offentlig_godkendelse = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_ægtefællebidrag(
    identifikation = "faktisk-adskillelse-privat",
    rolle = Bidragsmodtager,
    retsgrundlag = FaktiskAdskillelse(
        faktisk_adskillelse_dokumenteret = Sandt,
        ægtefællerne_ansat_selvstændigt_til_statsskat = Sandt
    ),
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IkkeRelevantForFradraget),
    beløb_kroner = 18000
)]))

= underhold_barn_normalbidrag_yder = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-normal-yder",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_separation_omfattet,
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IndenForNormalbidragUdenYderligereVurdering),
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 3, dag = 1),
    beløb_kroner = 1603
)]))
= underhold_barn_forhøjet_modtager = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-forhøjet-modtager",
    indkomstår = 2025,
    rolle = Bidragsmodtager,
    retsgrundlag = BarnUdenForÆgteskab,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 3, dag = 1),
    beløb_kroner = 2000
)]))
= underhold_barn_fylder_18 = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-fylder-18",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_fylder_18_i_april,
    forfaldsdato = Dato(år = 2025, måned = 4, dag = 1),
    beløb_kroner = 1603
)]))
= underhold_barn_fylder_18_allerede_forholdsmæssigt = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-fylder-18-forholdsmæssigt",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = AlleredeForholdsmæssigtTil18Årsdagen),
    barn = underhold_barn_fylder_18_i_april,
    forfaldsdato = Dato(år = 2025, måned = 4, dag = 1),
    beløb_kroner = 267
)]))
= underhold_barn_ugyldig_forholdsmæssighed = ligningslov10_11_bidrag_resultat(underhold_scenarie_børnebidrag(
    identifikation = "barn-ugyldig-forholdsmæssighed",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = AlleredeForholdsmæssigtTil18Årsdagen),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 4, dag = 1),
    beløb_kroner = 267
))
= underhold_barn_over_18_modtager = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-over-18-modtager",
    indkomstår = 2025,
    rolle = Bidragsmodtager,
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_fylder_18_i_april,
    forfaldsdato = Dato(år = 2025, måned = 5, dag = 1),
    beløb_kroner = 1603
)]))
= underhold_uddannelsesbidrag_over_18_modtager = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "uddannelsesbidrag-over-18-modtager",
    indkomstår = 2025,
    rolle = Bidragsmodtager,
    retsgrundlag = BarnUdenForÆgteskab,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = UddannelsesbidragEfter18År(dokumenteret_uddannelsesformål = Sandt),
    barn = underhold_barn_fylder_18_i_april,
    forfaldsdato = Dato(år = 2025, måned = 5, dag = 1),
    beløb_kroner = 3000
)]))
= underhold_uddannelsesbidrag_over_18_yder = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "uddannelsesbidrag-over-18-yder",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = BarnUdenForÆgteskab,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = UddannelsesbidragEfter18År(dokumenteret_uddannelsesformål = Sandt),
    barn = underhold_barn_fylder_18_i_april,
    forfaldsdato = Dato(år = 2025, måned = 5, dag = 1),
    beløb_kroner = 3000
)]))
= underhold_privat_forhøjet_uden_vurdering = ligningslov10_11_bidrag_resultat(underhold_scenarie_børnebidrag(
    identifikation = "privat-forhøjet-uden-vurdering",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_separation_omfattet,
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IndenForNormalbidragUdenYderligereVurdering),
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 11, dag = 1),
    beløb_kroner = 5000
))
= underhold_privat_forhøjet_vejledende = ligningslov10_11_bidrag_resultat(underhold_scenarie_børnebidrag(
    identifikation = "privat-forhøjet-vejledende",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_separation_omfattet,
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = DokumenteretVejledendeMånedsbeløb(
        vejledende_månedsbeløb_kroner = 2500,
        dokumentreference = "Familieretshusets dokumenterede sammenligningsgrundlag"
    )),
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 11, dag = 1),
    beløb_kroner = 2000
))
= underhold_privat_konkret_begrænset = ligningslov10_11_bidrag_resultat(underhold_scenarie_børnebidrag(
    identifikation = "privat-konkret-begrænset",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_separation_omfattet,
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = KonkretSkattemæssigtAnerkendtBeløb(
        anerkendt_betalt_beløb_kroner = 2000,
        dokumentreference = "Konkret skattemæssig afgørelse"
    )),
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 11, dag = 1),
    beløb_kroner = 5000
))
= underhold_privat_forhøjet_modtager = ligningslov10_11_bidrag_resultat(underhold_scenarie_børnebidrag(
    identifikation = "privat-forhøjet-modtager",
    indkomstår = 2025,
    rolle = Bidragsmodtager,
    retsgrundlag = underhold_separation_omfattet,
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IkkeRelevantForFradraget),
    bidragsart = LøbendeUnderholdsbidrag(beløbsgrundlag = HeleForfaldsmånedensBidrag),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 11, dag = 1),
    beløb_kroner = 5000
))
= underhold_barn_dåb_modtager = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-dåb-modtager",
    indkomstår = 2025,
    rolle = Bidragsmodtager,
    retsgrundlag = BarnUdenForÆgteskab,
    fastsættelse = GodkendtAfOffentligMyndighed,
    bidragsart = DåbsEllerNavngivningsbidrag(dokumenteret_til_begivenhedsudgifter = Sandt),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 6, dag = 1),
    beløb_kroner = 2000
)]))
= underhold_barn_konfirmation_modtager = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-konfirmation-modtager",
    indkomstår = 2025,
    rolle = Bidragsmodtager,
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = KonfirmationsEllerNonfirmationsbidrag(dokumenteret_til_begivenhedsudgifter = Sandt),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 5, dag = 1),
    beløb_kroner = 5000
)]))
= underhold_barn_konfirmation_yder = ligningslov10_11_årsresultat(2025, Ligningslov10Og11Årsinput(bidrag = [underhold_scenarie_børnebidrag(
    identifikation = "barn-konfirmation-yder",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_skilsmisse_omfattet,
    fastsættelse = FastsatAfOffentligMyndighed,
    bidragsart = KonfirmationsEllerNonfirmationsbidrag(dokumenteret_til_begivenhedsudgifter = Sandt),
    barn = underhold_barn_under_18,
    forfaldsdato = Dato(år = 2025, måned = 5, dag = 1),
