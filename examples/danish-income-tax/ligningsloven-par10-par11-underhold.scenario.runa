))

= underhold_dubleret_måned_fakta = underhold_scenarie_børnebidrag(
    identifikation = "barn-måned-a",
    indkomstår = 2025,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_separation_omfattet,
