    )
]))

= underhold_tomt_ikke_understøttet_år = ligningslov10_11_årsresultat(2022, ligningslov10_11_tomt_årsinput())
= underhold_ikke_tomt_ikke_understøttet_år = ligningslov10_11_årsresultat(2022, Ligningslov10Og11Årsinput(bidrag = [Ligningslov10Og11BidragFakta(
    identifikation = "2022-ægtefælle",
    indkomstår = 2022,
    rolle = Bidragsyder(modtageridentitet_oplyst = Sandt),
    retsgrundlag = underhold_skilsmisse_omfattet,
    modtager_identifikation = "ægtefælle-2022",
    modtager = ÆgtefælleEllerTidligereÆgtefælle(parterne_bor_sammen = Falskt),
    fastsættelse = DokumenteretPrivatAftale(fradragsvurdering = IkkeRelevantForFradraget),
