@ sprog da

@ importer ./personskat.calculate

-- Kanoniske scenarier for den kildefaktabaserede pensionsgren. Lovtekst og
-- kildeankre ligger i pensionsbeskatningsloven.runa,
-- kapitel-01-indkomst.runa og ligningsloven_fradrag.runa.

| personskat_pension_betaling(beløb_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal) -> Pbl18Årsbetaling(
    beløb_kroner = beløb_kroner,
    forfaldsår = 2026,
    betalingsår = 2026,
    betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
    hidrører_fra_par22e_tilbagebetaling = Falskt,
    par15a_fradragsplacering = Pbl18IkkePar15APlacering,
    arbejdsmarkedsbidrag_kroner = arbejdsmarkedsbidrag_kroner
)
| personskat_pension_indbetaling(identifikation: Tekst, kilde: Pbl18Indbetalingskilde, beløb_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = identifikation,
    ordning = Pbl18Rateopsparing,
    indbetalingskilde = kilde,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = personskat_pension_betaling(beløb_kroner, arbejdsmarkedsbidrag_kroner),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = Pbl18Indeksvalg(fradragsvalgte_kontraktbidrag_kroner = []),
    forfaldne_ikke_tidligere_fratrukket_kroner = 0,
    særligt_ordningsmaksimum_kroner = 0,
    begrænsninger = Pbl18Begrænsninger(
        pbl54_personkreds_opfyldt = Sandt,
        afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
        udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Falskt
    )
)
| personskat_pensionsinput_med_aktiefradrag(indbetalinger: List(Pbl18Årsindbetaling), aktiepensionsfradrag_valg: PersonskatAktiepensionsfradragValg) -> PersonskatPensionsInput(
    pensionsalder_status = Ll9lMereEnd15ÅrFørFolkepension,
    pbl18_indbetalinger = indbetalinger,
    pbl18_selvstændig_overskud = personskat_intet_selvstændigt_pensionsoverskud(),
    pbl18_livrentevalg = Pbl18FordeltFradrag,
    aktiepensionsfradrag_valg = aktiepensionsfradrag_valg,
    pbl20_indkomstskattepligtig_udbetaling_kroner = 0,
    pbl20_udbetaling_status = Ll9lIngenPbl20Udbetaling
)
| personskat_pensionsinput(indbetalinger: List(Pbl18Årsindbetaling)) -> personskat_pensionsinput_med_aktiefradrag(indbetalinger, UdenAktiepensionsfradragIAktieindkomst)
| personskat_pension_lønmodtager(pension: PersonskatPensionsInput) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = pension,
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
| personskat_pension_input(pension: PersonskatPensionsInput) -> PersonskatInput(
    lønmodtager = personskat_pension_lønmodtager(pension),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_pension_input_med_aktieavance(pension: PersonskatPensionsInput, aktieavance: PersonskatAktieavanceInput) -> PersonskatInput(
    lønmodtager = personskat_pension_lønmodtager(pension),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = aktieavance,
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)

| personskat_par15a_indbetaling(identifikation: Tekst, beløb_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = identifikation,
    ordning = Pbl18Par15ARateordning,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = beløb_kroner,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18Par15AIndbetalingsår,
        arbejdsmarkedsbidrag_kroner = 0
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = Pbl18Indeksvalg(fradragsvalgte_kontraktbidrag_kroner = []),
    forfaldne_ikke_tidligere_fratrukket_kroner = 0,
    særligt_ordningsmaksimum_kroner = beløb_kroner,
    begrænsninger = Pbl18Begrænsninger(
        pbl54_personkreds_opfyldt = Sandt,
        afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
        udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Falskt
    )
)

| personskat_ugyldig_par15a_indbetaling(identifikation: Tekst, beløb_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = identifikation,
    ordning = Pbl18Par15ARateordning,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = beløb_kroner,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18Par15AIndbetalingsår,
        arbejdsmarkedsbidrag_kroner = 1000
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = Pbl18Indeksvalg(fradragsvalgte_kontraktbidrag_kroner = []),
    forfaldne_ikke_tidligere_fratrukket_kroner = 0,
    særligt_ordningsmaksimum_kroner = beløb_kroner,
    begrænsninger = Pbl18Begrænsninger(
        pbl54_personkreds_opfyldt = Sandt,
        afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
        udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Falskt
    )
)

= personskat_par15a_aktieposition = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-HOVEDAKTIONÆR-1",
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    anskaffelsessum_kroner = 20000
)
= personskat_par15a_aktieafståelse = AblOrdinærAfståelse(
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    afståelsessum_kroner = 100000,
    vilkår = AktieavanceOrdinærAfståelsesvilkår(
        markedsstatus = AblIkkeOptagetTilHandel,
        har_tidligere_været_optaget_til_handel = Falskt,
        hovedaktionæraktier = Sandt,
        afståede_aktiers_handelsværdi_kroner = 100000,
        beholdte_aktiers_handelsværdi_kroner = 0,
        oplysningsstatus = AblOplystRettidigt,
        boligret = AblUdenBoligret
    )
)
= personskat_par15a_aktieår = AktieavanceOrdinærPersonÅrsinput(
    indkomstår = 2026,
    hændelsesforløb = [
        AktieavanceOrdinærHændelsesforløbInput(
            position_primo = personskat_par15a_aktieposition,
            hændelser = [personskat_par15a_aktieafståelse]
        )
    ],
    investeringsbeviser = [],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
    ),
    gift_og_samlevende_ved_årets_udgang = Falskt
)
= personskat_par15a_aktieavance = PersonskatAktieavanceInput(
    ordinært_aktieår = MedOrdinærtAktieår(input = personskat_par15a_aktieår),
    særlige_aktiver = []
)

= personskat_uden_pension_resultat = beregn_personskat(personskat_pension_input(personskat_ingen_pension()))
= personskat_egen_ratepension_resultat = beregn_personskat(personskat_pension_input(personskat_pensionsinput([
    personskat_pension_indbetaling("egen-rate", Pbl18EgenIndbetaling, 100000, 0)
])))
= personskat_arbejdsgiverprioritet_resultat = beregn_personskat(personskat_pension_input(personskat_pensionsinput([
    personskat_pension_indbetaling("arbejdsgiver-rate", Pbl18Arbejdsgiverindbetaling, 40000, 3200),
    personskat_pension_indbetaling("egen-rate", Pbl18EgenIndbetaling, 50000, 0)
])))
= personskat_dobbelt_pensionsidentifikation_resultat = beregn_personskat(personskat_pension_input(personskat_pensionsinput([
    personskat_pension_indbetaling("samme-id", Pbl18EgenIndbetaling, 20000, 0),
    personskat_pension_indbetaling("samme-id", Pbl18EgenIndbetaling, 30000, 0)
])))
= personskat_par15a_aktiefradrag_resultat = beregn_personskat(personskat_pension_input_med_aktieavance(
    personskat_pensionsinput_med_aktiefradrag(
        [personskat_par15a_indbetaling("par15a-hovedaktionær", 100000)],
        MedAktiepensionsfradragIAktieindkomst(
            ønsket_fradrag_kroner = 70000,
            meddelelse_dato_yyyymmdd = 20270501,
            omgørelse_dato_yyyymmdd = 0
        )
    ),
    personskat_par15a_aktieavance
))
= personskat_ugyldig_par15a_aktiefradrag_resultat = beregn_personskat(personskat_pension_input_med_aktieavance(
    personskat_pensionsinput_med_aktiefradrag(
        [personskat_ugyldig_par15a_indbetaling("ugyldig-par15a", 100000)],
        MedAktiepensionsfradragIAktieindkomst(
            ønsket_fradrag_kroner = 70000,
            meddelelse_dato_yyyymmdd = 20270501,
            omgørelse_dato_yyyymmdd = 0
        )
    ),
    personskat_par15a_aktieavance
))

| personskat_egen_ratepension_afledes_fra_kildefakta: personskat_egen_ratepension_resultat -> personskat_egen_ratepension_resultat.pension.pbl18_årsinput.personlig_indkomst_før_pensionsfradrag_kroner == 552000 && personskat_egen_ratepension_resultat.pension.pbl18_årsresultat.input_gyldigt && personskat_egen_ratepension_resultat.pension.pbl18_årsresultat.rate_og_ophørende_fradrag_kroner == 68700 && personskat_egen_ratepension_resultat.pension.par3_stk2_nr3_resultat.fradrag_i_personlig_indkomst_kroner == 68700 && personskat_egen_ratepension_resultat.skat.personlig_indkomst_efter_am_kroner == 483300
| personskat_pensionsgrundlag_genbruges_i_ligningslov9l: personskat_egen_ratepension_resultat -> personskat_egen_ratepension_resultat.pension.lønmodtager_pensionsfradrag.pbl18_fradragsberettiget_indbetaling_kroner == 68700 && personskat_egen_ratepension_resultat.skat.ekstra_pensionsfradrag_kroner == 8244 && personskat_egen_ratepension_resultat.skat.samlet_inkl_am_efter_personfradrag_kroner < personskat_uden_pension_resultat.skat.samlet_inkl_am_efter_personfradrag_kroner
| personskat_arbejdsgiverindbetaling_har_prioritet: personskat_arbejdsgiverprioritet_resultat -> personskat_arbejdsgiverprioritet_resultat.pension.pbl18_årsresultat.input_gyldigt && personskat_arbejdsgiverprioritet_resultat.pension.pbl18_årsresultat.arbejdsgivergrundlag.rate_og_ophørende_brutto_kroner == 40000 && personskat_arbejdsgiverprioritet_resultat.pension.pbl18_årsresultat.arbejdsgivergrundlag.rate_og_ophørende_am_bidrag_kroner == 3200 && personskat_arbejdsgiverprioritet_resultat.pension.pbl18_årsresultat.rate_og_ophørende_fradragsloft_efter_arbejdsgiver_kroner == 31900 && personskat_arbejdsgiverprioritet_resultat.pension.pbl18_årsresultat.rate_og_ophørende_fradrag_kroner == 31900 && personskat_arbejdsgiverprioritet_resultat.pension.lønmodtager_pensionsfradrag.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner == 36800 && personskat_arbejdsgiverprioritet_resultat.skat.ekstra_pensionsfradrag_kroner == 8244
| personskat_dobbelte_pensionsidentifikationer_afvises: personskat_dobbelt_pensionsidentifikation_resultat -> personskat_dobbelt_pensionsidentifikation_resultat.pension.pbl18_årsresultat.input_gyldigt == Falskt && personskat_dobbelt_pensionsidentifikation_resultat.pension.pbl18_årsresultat.samlet_fradrag_i_skattepligtig_indkomst_kroner == 0 && personskat_dobbelt_pensionsidentifikation_resultat.pension.par3_stk2_nr3_resultat.fradrag_i_personlig_indkomst_kroner == 0 && personskat_dobbelt_pensionsidentifikation_resultat.pension.lønmodtager_pensionsfradrag.pbl18_fradragsberettiget_indbetaling_kroner == 0
| personskat_par15a_fradrag_fordeles_uden_dobbeltfradrag: personskat_par15a_aktiefradrag_resultat -> personskat_par15a_aktiefradrag_resultat.pension.pbl18_årsresultat.par15a_fradrag_kroner == 100000 && personskat_par15a_aktiefradrag_resultat.pension.aktiepensionsfradrag_resultat.fradrag_i_aktieindkomst_kroner == 70000 && personskat_par15a_aktiefradrag_resultat.pension.par3_stk2_nr3_resultat.fradrag_i_personlig_indkomst_kroner == 30000 && personskat_par15a_aktiefradrag_resultat.aktieavance.aktieindkomst_resultat.aktieindkomst_efter_stk1_og_2_kroner == 80000 && personskat_par15a_aktiefradrag_resultat.aktieavance.aktieindkomst_kroner == 10000 && personskat_par15a_aktiefradrag_resultat.skat.personlig_indkomst_efter_am_kroner == 522000
| personskat_ugyldig_par15a_kan_ikke_give_fradrag: personskat_ugyldig_par15a_aktiefradrag_resultat -> personskat_ugyldig_par15a_aktiefradrag_resultat.pension.pbl18_årsresultat.input_gyldigt == Falskt && personskat_ugyldig_par15a_aktiefradrag_resultat.pension.pbl18_årsresultat.par15a_fradrag_kroner == 0 && personskat_ugyldig_par15a_aktiefradrag_resultat.pension.aktiepensionsfradrag_resultat.fradrag_i_aktieindkomst_kroner == 0 && personskat_ugyldig_par15a_aktiefradrag_resultat.pension.par3_stk2_nr3_resultat.fradrag_i_personlig_indkomst_kroner == 0 && personskat_ugyldig_par15a_aktiefradrag_resultat.aktieavance.aktieindkomst_kroner == 80000

? personskat_egen_ratepension_afledes_fra_kildefakta
? personskat_pensionsgrundlag_genbruges_i_ligningslov9l
? personskat_arbejdsgiverindbetaling_har_prioritet
? personskat_dobbelte_pensionsidentifikationer_afvises
? personskat_par15a_fradrag_fordeles_uden_dobbeltfradrag
? personskat_ugyldig_par15a_kan_ikke_give_fradrag
