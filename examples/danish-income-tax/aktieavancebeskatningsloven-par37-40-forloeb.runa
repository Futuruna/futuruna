# AktieavancePar37Til40Opgørelseskilde = AblPar37Til40OpgørelseEfterPar23Til29Og46 | AblPar37Til40Tegningsretsvalg(udnyttelseskurs_pr_aktie_kroner: Heltal, markedskurs_pr_aktie_ved_ophør_kroner: Heltal)
# AktieavancePar37Til40Henstandsvalg = AblPar37Til40HenstandSøges | AblPar37Til40SkatBetalesStraks
# AktieavancePar37Til40AktiepostFakta(identifikation: Tekst, selskabsidentifikation: Tekst, aktieserie: Tekst, erhvervelsesdato: AktieavancePar23Dato, erhvervelsesrækkefølge: Heltal, antal: Heltal, handelsværdi_ved_ophør_kroner: Heltal, skattemæssig_anskaffelsessum_kroner: Heltal, beskatningsstatus: AktieavancePar38Beskatningsstatus, par44_status: AktieavancePar38Par44Status, egenskaber: List(AktieavancePar38Aktieegenskab), opgørelseskilde: AktieavancePar37Til40Opgørelseskilde, tabsstatus: AktieavancePar38Tabsstatus, princip: AktieavancePar23Princip, henstandsvalg: AktieavancePar37Til40Henstandsvalg)
# AktieavancePar37Til40Aktieindkomstkontekst(indkomstår: Heltal, øvrig_egen_aktieindkomst_kroner: Heltal, ægtefælles_aktieindkomst_kroner: Heltal, samlevende_med_ægtefælle_ved_indkomstårets_udløb: Boolsk)
# AktieavancePar37Til40Fraflytningsfakta(fraflytningsår: Heltal, ophørsgrund: AktieavancePar38Ophørsgrund, tilknytning: AktieavancePar38Tilknytning, aktier: List(AktieavancePar37Til40AktiepostFakta), aktieindkomstkontekst: AktieavancePar37Til40Aktieindkomstkontekst, indberetning: AktieavancePar39Indberetning, bopæl: AktieavancePar39Bopæl, sikkerhed: AktieavancePar39Sikkerhed)
# AktieavancePar37Til40Fraflytningsresultat(fakta: AktieavancePar37Til40Fraflytningsfakta, aktier: List(AktieavancePar38Aktie), par38_resultat: AktieavancePar38Resultat, effektivt_aktiegrundbeløb_kroner: Heltal, skat_uden_fraflyttergevinst_kroner: Heltal, skat_med_hele_fraflyttergevinsten_kroner: Heltal, beregnet_fraflytterskat_kroner: Heltal, henstandsvalgt_nettogevinst_kroner: Heltal, beregnet_henstandsskat_kroner: Heltal, par39_resultat: AktieavancePar39Resultat, beholdningsoversigt: List(AktieavancePar39ABeholdningsparti), tilstand_primo: AktieavancePar39ATilstand, input_gyldigt: Boolsk, skat_til_betaling_ved_fraflytning_kroner: Heltal, aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat)

| aktieavance_par37_til40_opgjort_nettogevinst_kroner(fakta: AktieavancePar37Til40AktiepostFakta) -> match fakta.opgørelseskilde {
    | AblPar37Til40OpgørelseEfterPar23Til29Og46 -> fakta.handelsværdi_ved_ophør_kroner - fakta.skattemæssig_anskaffelsessum_kroner
    | AblPar37Til40Tegningsretsvalg(udnyttelseskurs, markedskurs) -> fakta.antal * (markedskurs - udnyttelseskurs)
}
| aktieavance_par37_til40_opgørelseskilde_gyldig(fakta: AktieavancePar37Til40AktiepostFakta) -> match fakta.opgørelseskilde {
    | AblPar37Til40OpgørelseEfterPar23Til29Og46 -> Sandt
    | AblPar37Til40Tegningsretsvalg(udnyttelseskurs, markedskurs) -> udnyttelseskurs >= 0 && markedskurs >= 0 && fakta.handelsværdi_ved_ophør_kroner == fakta.antal * markedskurs
}
| aktieavance_par37_til40_par38_opgørelsesgrundlag(fakta: AktieavancePar37Til40AktiepostFakta) -> match fakta.opgørelseskilde {
    | AblPar37Til40OpgørelseEfterPar23Til29Og46 -> AblPar38OpgjortEfterPar23Til29Og46(nettogevinst_kroner = aktieavance_par37_til40_opgjort_nettogevinst_kroner(fakta))
    | AblPar37Til40Tegningsretsvalg(udnyttelseskurs, markedskurs) -> AblPar38TegningsretValgEfterStk4(antal_rettigheder = fakta.antal, udnyttelseskurs_pr_aktie_kroner = udnyttelseskurs, markedskurs_pr_aktie_ved_ophør_kroner = markedskurs)
}
| aktieavance_par37_til40_par38_aktie(fakta: AktieavancePar37Til40AktiepostFakta) -> AktieavancePar38Aktie(
    identifikation = fakta.identifikation,
    handelsværdi_ved_ophør_kroner = fakta.handelsværdi_ved_ophør_kroner,
    skattemæssig_anskaffelsessum_kroner = fakta.skattemæssig_anskaffelsessum_kroner,
    beskatningsstatus = fakta.beskatningsstatus,
    par44_status = fakta.par44_status,
    egenskaber = fakta.egenskaber,
    opgørelsesgrundlag = aktieavance_par37_til40_par38_opgørelsesgrundlag(fakta),
    tabsstatus = fakta.tabsstatus,
    princip = fakta.princip
)
| aktieavance_par37_til40_aktiepost_nøgle(fakta: AktieavancePar37Til40AktiepostFakta) -> aktieavance_par23_dato_nøgle(fakta.erhvervelsesdato) * 1000000 + fakta.erhvervelsesrækkefølge
| aktieavance_par37_til40_aktiepost_gyldig(fakta: AktieavancePar37Til40AktiepostFakta) -> fakta.identifikation != "" && fakta.selskabsidentifikation != "" && fakta.aktieserie != "" && aktieavance_par23_dato_gyldig(fakta.erhvervelsesdato) && fakta.erhvervelsesrækkefølge > 0 && fakta.erhvervelsesrækkefølge < 1000000 && fakta.antal > 0 && fakta.handelsværdi_ved_ophør_kroner >= 0 && aktieavance_par37_til40_opgørelseskilde_gyldig(fakta)
| aktieavance_par37_til40_aktiepost_identifikation_unik(aktier: List(AktieavancePar37Til40AktiepostFakta), fakta: AktieavancePar37Til40AktiepostFakta) -> foldl(aktier, 0, |antal: Heltal, anden: AktieavancePar37Til40AktiepostFakta| antal + hvis anden.identifikation == fakta.identifikation { 1 } ellers { 0 }) == 1
| aktieavance_par37_til40_aktieposter_sorteret_fra(aktier: List(AktieavancePar37Til40AktiepostFakta), forrige_nøgle: Heltal) -> hvis length(aktier) == 0 { Sandt } ellers { aktieavance_par37_til40_aktiepost_nøgle(head(aktier)) > forrige_nøgle && aktieavance_par37_til40_aktieposter_sorteret_fra(tail(aktier), aktieavance_par37_til40_aktiepost_nøgle(head(aktier))) }
| aktieavance_par37_til40_aktieposter_gyldige(aktier: List(AktieavancePar37Til40AktiepostFakta)) -> length(aktier) > 0 && aktieavance_par37_til40_aktieposter_sorteret_fra(aktier, 0) && all(aktier, |fakta: AktieavancePar37Til40AktiepostFakta| aktieavance_par37_til40_aktiepost_gyldig(fakta) && aktieavance_par37_til40_aktiepost_identifikation_unik(aktier, fakta))
| aktieavance_par37_til40_aktie_omfattet(fraflytning: AktieavancePar37Til40Fraflytningsfakta, par38_resultat: AktieavancePar38Resultat, fakta: AktieavancePar37Til40AktiepostFakta) -> par38_resultat.skattepligtsophør_efter_stk1 && par38_resultat.beholdningskrav_efter_stk2_opfyldt && fakta.beskatningsstatus == AblPar38AktieOmfattetAfDanskBeskatning && fakta.par44_status != AblPar38Par44AktieEjetUnderTreÅrVedOphør && (fraflytning.tilknytning == AblPar38MindstSyvÅrIndenForSenesteTiÅr || fraflytning.tilknytning == AblPar38Par39BNedsatHandelsværdiVedTilflytning || aktieavance_par38_stk3_særlig_aktie(aktieavance_par37_til40_par38_aktie(fakta)))
| aktieavance_par37_til40_aktie_henstandsvalgt(fraflytning: AktieavancePar37Til40Fraflytningsfakta, par38_resultat: AktieavancePar38Resultat, fakta: AktieavancePar37Til40AktiepostFakta) -> aktieavance_par37_til40_aktie_omfattet(fraflytning, par38_resultat, fakta) && fakta.princip == AblPar23Realisationsprincip && fakta.henstandsvalg == AblPar37Til40HenstandSøges
| aktieavance_par37_til40_par39a_par44_status(fakta: AktieavancePar37Til40AktiepostFakta) -> hvis fakta.par44_status == AblPar38Par44AktieEjetMindstTreÅrVedOphør { AblPar39AOmfattetAfPar44VedFraflytning } ellers { AblPar39AIkkeOmfattetAfPar44 }
| aktieavance_par37_til40_beholdningsparti(fakta: AktieavancePar37Til40AktiepostFakta, oprindeligt_nettotab_ved_fraflytning_kroner: Heltal) -> AktieavancePar39ABeholdningsparti(
    identifikation = fakta.identifikation,
    selskabsidentifikation = fakta.selskabsidentifikation,
    aktieserie = fakta.aktieserie,
    erhvervelsesdato = fakta.erhvervelsesdato,
    erhvervelsesrækkefølge = fakta.erhvervelsesrækkefølge,
    resterende_antal = fakta.antal,
    resterende_anskaffelsessum_efter_par38_kroner = fakta.skattemæssig_anskaffelsessum_kroner,
    resterende_værdi_ved_fraflytning_kroner = fakta.handelsværdi_ved_ophør_kroner,
    par44_status = aktieavance_par37_til40_par39a_par44_status(fakta),
    indgik_i_nettotab_ved_fraflytning = oprindeligt_nettotab_ved_fraflytning_kroner > 0 && aktieavance_par37_til40_opgjort_nettogevinst_kroner(fakta) < 0
)
| aktieavance_par37_til40_tomt_personskattelov_resultat(indkomstår: Heltal) -> AktieavancebeskatningslovResultat(
    indkomstår = indkomstår,
    effektiv_aktiv = AblUdenforDenneSlice,
    bruttogevinst_kroner = 0,
    bruttotab_kroner = 0,
    tab_afskåret_kroner = 0,
    skattepligtig_gevinst_kroner = 0,
    fradragsberettiget_tab_kroner = 0,
    netto_efter_aktieavancebeskatningsloven_kroner = 0,
    medregnes_i_skattepligtig_indkomst = Falskt,
    personskattelov_kategori = AblIkkeMedregnetISlice
)

# AktieavancePar37Til40FraflytningsSag(fakta: AktieavancePar37Til40Fraflytningsfakta) {
    | par38_aktier() -> map(fakta.aktier, aktieavance_par37_til40_par38_aktie)
    | par38_input() -> AktieavancePar38Input(ophørsgrund = fakta.ophørsgrund, tilknytning = fakta.tilknytning, aktier = par38_aktier())
    | par38_resultat() -> aktieavance_par38_resultat(par38_input())
    | aktieindkomstkontekst_gyldig() -> fakta.aktieindkomstkontekst.indkomstår == fakta.fraflytningsår && fakta.aktieindkomstkontekst.øvrig_egen_aktieindkomst_kroner >= 0 && fakta.aktieindkomstkontekst.ægtefælles_aktieindkomst_kroner >= 0 && skatteår_understøttet(fakta.fraflytningsår)
    | effektivt_aktiegrundbeløb_kroner() -> hvis aktieindkomstkontekst_gyldig() { aktieindkomst_effektivt_grundbeløb_for_person(AktieindkomstÆgtefælleGrundbeløbInput(skatteår = fakta.fraflytningsår, aktieindkomst_kroner = fakta.aktieindkomstkontekst.øvrig_egen_aktieindkomst_kroner, ægtefælle_aktieindkomst_kroner = fakta.aktieindkomstkontekst.ægtefælles_aktieindkomst_kroner, samlevende_ved_årets_udløb = fakta.aktieindkomstkontekst.samlevende_med_ægtefælle_ved_indkomstårets_udløb)) } ellers { 0 }
    | skat_af_aktieindkomst_kroner(aktieindkomst_kroner: Heltal) -> hvis aktieindkomstkontekst_gyldig() { aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(skatteår = fakta.fraflytningsår, aktieindkomst_kroner = penge_positivt_beløb(aktieindkomst_kroner), effektivt_grundbeløb_kroner = effektivt_aktiegrundbeløb_kroner())).samlet_skat_kroner } ellers { 0 }
    | øvrig_aktieindkomst_kroner() -> fakta.aktieindkomstkontekst.øvrig_egen_aktieindkomst_kroner
    | samlet_fraflyttergevinst_kroner() -> par38_resultat().nettogevinst_til_skatteberegning_efter_stk5_kroner
    | henstandsvalgt_nettogevinst_før_gulv_kroner() -> foldl(fakta.aktier, 0, |sum: Heltal, aktie: AktieavancePar37Til40AktiepostFakta| sum + hvis aktieavance_par37_til40_aktie_henstandsvalgt(fakta, par38_resultat(), aktie) { aktieavance_par37_til40_opgjort_nettogevinst_kroner(aktie) } ellers { 0 })
    | henstandsvalgt_nettogevinst_kroner() -> penge_positivt_beløb(henstandsvalgt_nettogevinst_før_gulv_kroner())
    | umiddelbart_nettogrundlag_kroner() -> penge_positivt_beløb(samlet_fraflyttergevinst_kroner() - henstandsvalgt_nettogevinst_kroner())
    | skat_uden_fraflyttergevinst_kroner() -> skat_af_aktieindkomst_kroner(øvrig_aktieindkomst_kroner())
    | skat_før_henstandsvalgt_gevinst_kroner() -> skat_af_aktieindkomst_kroner(øvrig_aktieindkomst_kroner() + umiddelbart_nettogrundlag_kroner())
    | skat_med_hele_fraflyttergevinsten_kroner() -> skat_af_aktieindkomst_kroner(øvrig_aktieindkomst_kroner() + samlet_fraflyttergevinst_kroner())
    | beregnet_fraflytterskat_kroner() -> penge_positivt_beløb(skat_med_hele_fraflyttergevinsten_kroner() - skat_uden_fraflyttergevinst_kroner())
    | beregnet_henstandsskat_kroner() -> penge_positivt_beløb(skat_med_hele_fraflyttergevinsten_kroner() - skat_før_henstandsvalgt_gevinst_kroner())
    | par39_input() -> AktieavancePar39Input(par38_resultat = par38_resultat(), beregnet_skat_for_realisationsopgjorte_poster_kroner = beregnet_henstandsskat_kroner(), indberetning = fakta.indberetning, bopæl = fakta.bopæl, sikkerhed = fakta.sikkerhed)
    | par39_resultat() -> aktieavance_par39_resultat(par39_input())
    | beholdningsoversigt() -> map(filter(fakta.aktier, |aktie: AktieavancePar37Til40AktiepostFakta| aktieavance_par37_til40_aktie_henstandsvalgt(fakta, par38_resultat(), aktie)), |aktie: AktieavancePar37Til40AktiepostFakta| aktieavance_par37_til40_beholdningsparti(aktie, par38_resultat().overskydende_tab_kroner))
    | tilstand_med_henstand() -> aktieavance_par39a_opret_tilstand(par39_resultat(), beholdningsoversigt())
    | beholdning_bevares_uden_henstand() -> par38_resultat().skattepligtsophør_efter_stk1 && beregnet_fraflytterskat_kroner() == 0 && length(beholdningsoversigt()) > 0
    | tilstand_primo() -> hvis par39_resultat().henstand_finder_anvendelse { tilstand_med_henstand() } ellers { hvis beholdning_bevares_uden_henstand() { aktieavance_par39a_tilstand_for_nettotab_uden_henstand(beholdningsoversigt()) } ellers { aktieavance_par39a_tilstand_for_nettotab_uden_henstand([]) } }
    | input_gyldigt() -> fakta.fraflytningsår > 0 && aktieavance_par37_til40_aktieposter_gyldige(fakta.aktier) && aktieindkomstkontekst_gyldig() && par38_resultat().input_gyldigt && par39_resultat().input_gyldigt && aktieavance_par39a_tilstand_gyldig(tilstand_primo())
    | skat_til_betaling_ved_fraflytning_kroner() -> hvis input_gyldigt() { beregnet_fraflytterskat_kroner() - par39_resultat().henstandsbeløb_kroner } ellers { 0 }
    | aktieavancebeskatningslov_resultat() -> hvis input_gyldigt() { AktieavancebeskatningslovResultat(indkomstår = fakta.fraflytningsår, effektiv_aktiv = AblOrdinærAktiePar12Til15, bruttogevinst_kroner = par38_resultat().samlede_gevinster_kroner, bruttotab_kroner = par38_resultat().fradragsberettigede_tab_kroner + par38_resultat().afskårne_tab_kroner, tab_afskåret_kroner = par38_resultat().afskårne_tab_kroner, skattepligtig_gevinst_kroner = par38_resultat().samlede_gevinster_kroner, fradragsberettiget_tab_kroner = penge_mindste_beløb(par38_resultat().fradragsberettigede_tab_kroner, par38_resultat().samlede_gevinster_kroner), netto_efter_aktieavancebeskatningsloven_kroner = par38_resultat().nettogevinst_til_skatteberegning_efter_stk5_kroner, medregnes_i_skattepligtig_indkomst = par38_resultat().nettogevinst_til_skatteberegning_efter_stk5_kroner > 0, personskattelov_kategori = hvis par38_resultat().nettogevinst_til_skatteberegning_efter_stk5_kroner > 0 { AblAktieindkomstEfterPslPar4a } ellers { AblIkkeMedregnetISlice }) } ellers { aktieavance_par37_til40_tomt_personskattelov_resultat(fakta.fraflytningsår) }
    | resultat() -> AktieavancePar37Til40Fraflytningsresultat(fakta = fakta, aktier = par38_aktier(), par38_resultat = par38_resultat(), effektivt_aktiegrundbeløb_kroner = effektivt_aktiegrundbeløb_kroner(), skat_uden_fraflyttergevinst_kroner = skat_uden_fraflyttergevinst_kroner(), skat_med_hele_fraflyttergevinsten_kroner = skat_med_hele_fraflyttergevinsten_kroner(), beregnet_fraflytterskat_kroner = beregnet_fraflytterskat_kroner(), henstandsvalgt_nettogevinst_kroner = henstandsvalgt_nettogevinst_kroner(), beregnet_henstandsskat_kroner = beregnet_henstandsskat_kroner(), par39_resultat = par39_resultat(), beholdningsoversigt = beholdningsoversigt(), tilstand_primo = tilstand_primo(), input_gyldigt = input_gyldigt(), skat_til_betaling_ved_fraflytning_kroner = skat_til_betaling_ved_fraflytning_kroner(), aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat())
}

| aktieavance_par37_til40_fraflytningsresultat(fakta: AktieavancePar37Til40Fraflytningsfakta) -> AktieavancePar37Til40FraflytningsSag(fakta).resultat()

# AktieavancePar37Til40Hændelsespost(identifikation: Tekst, indkomstår: Heltal, rækkefølge_i_indkomståret: Heltal, hændelse: AktieavancePar39AHændelse)
# AktieavancePar37Til40Hændelsespostresultat(post: AktieavancePar37Til40Hændelsespost, post_strukturelt_gyldig: Boolsk, hændelsesresultat: AktieavancePar39AHændelsesresultat, hændelse_gyldig: Boolsk, tilstand_før: AktieavancePar39ATilstand, tilstand_efter: AktieavancePar39ATilstand)
# AktieavancePar37Til40Forløbstilstand(tilstand: AktieavancePar39ATilstand, resultater: List(AktieavancePar37Til40Hændelsespostresultat), alle_hændelser_gyldige: Boolsk)
# AktieavancePar37Til40Tilflytning = IngenTilflytningEfterPar39B | TilflytningEfterPar39B(identifikation: Tekst, indkomstår: Heltal, rækkefølge_i_indkomståret: Heltal, tilflytningsværdier: List(AktieavancePar39BTilflytningsværdi), får_på_ny_skattemæssigt_hjemsted_i_danmark: Boolsk, samlevende_med_ægtefælle_ved_indkomstårets_udløb: Boolsk)
# AktieavancePar37Til40Forløbsinput(identifikation: Tekst, opgørelsesår: Heltal, fraflytning: AktieavancePar37Til40Fraflytningsfakta, hændelsesposter: List(AktieavancePar37Til40Hændelsespost), tilflytning: AktieavancePar37Til40Tilflytning)
# AktieavancePar37Til40Forløbsresultat(input: AktieavancePar37Til40Forløbsinput, fraflytningsresultat: AktieavancePar37Til40Fraflytningsresultat, hændelsesresultater: List(AktieavancePar37Til40Hændelsespostresultat), tilstand_før_tilflytning: AktieavancePar39ATilstand, tilflytningsresultat: Option(AktieavancePar39BResultat), input_gyldigt: Boolsk, årets_beregnede_fraflytterskat_kroner: Heltal, årets_nye_henstand_kroner: Heltal, årets_skat_til_betaling_ved_fraflytning_kroner: Heltal, årets_nye_forfald_kroner: Heltal, årets_betalte_fraflytterskat_kroner: Heltal, årets_straksnedskrivning_kroner: Heltal, årets_saldobortfald_kroner: Heltal, tilstand_ultimo: AktieavancePar39ATilstand, aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat)

| aktieavance_par37_til40_hændelse_matcher_post(post: AktieavancePar37Til40Hændelsespost) -> match post.hændelse {
    | AblPar39AAfståelse(data) -> data.hændelsesidentifikation == post.identifikation && data.skatteår == post.indkomstår
    | AblPar39ASkattefriOmstrukturering(data) -> data.hændelsesidentifikation == post.identifikation
    | AblPar39AUdbytte(data) -> data.hændelsesidentifikation == post.identifikation && data.skatteår == post.indkomstår
    | AblPar39AAndenUdlodningEllerDisposition(data, _, _, _) -> data.hændelsesidentifikation == post.identifikation && data.skatteår == post.indkomstår
    | AblPar39ALån(data) -> data.hændelsesidentifikation == post.identifikation && data.skatteår == post.indkomstår
    | AblPar39ADød(data) -> data.hændelsesidentifikation == post.identifikation && all(data.afståelser_til_markedsværdi, |afståelse: AktieavancePar39AAfståelsesdata| afståelse.skatteår == post.indkomstår)
    | AblPar39AÅrsoplysninger(data) -> data.hændelsesidentifikation == post.identifikation && data.indkomstår == post.indkomstår
    | AblPar39ADokumentation(data) -> data.hændelsesidentifikation == post.identifikation && data.indkomstår == post.indkomstår
    | AblPar39ABetaling(_) -> Sandt
    | AblPar39ATabsfremførselAfsluttet -> Sandt
    | AblPar40BetaltSkatVedLedelsessædefraflytning(_) -> Sandt
}
| aktieavance_par37_til40_hændelsesidentifikation_unik(poster: List(AktieavancePar37Til40Hændelsespost), post: AktieavancePar37Til40Hændelsespost) -> foldl(poster, 0, |antal: Heltal, anden: AktieavancePar37Til40Hændelsespost| antal + hvis anden.identifikation == post.identifikation { 1 } ellers { 0 }) == 1
| aktieavance_par37_til40_hændelsespost_efter(post: AktieavancePar37Til40Hændelsespost, forrige_indkomstår: Heltal, forrige_rækkefølge: Heltal) -> post.indkomstår > forrige_indkomstår || (post.indkomstår == forrige_indkomstår && post.rækkefølge_i_indkomståret > forrige_rækkefølge)
| aktieavance_par37_til40_hændelsesposter_sorteret_fra(poster: List(AktieavancePar37Til40Hændelsespost), forrige_indkomstår: Heltal, forrige_rækkefølge: Heltal) -> hvis length(poster) == 0 { Sandt } ellers { aktieavance_par37_til40_hændelsespost_efter(head(poster), forrige_indkomstår, forrige_rækkefølge) && aktieavance_par37_til40_hændelsesposter_sorteret_fra(tail(poster), head(poster).indkomstår, head(poster).rækkefølge_i_indkomståret) }
| aktieavance_par37_til40_hændelsespost_intrinsisk_gyldig(post: AktieavancePar37Til40Hændelsespost, fraflytningsår: Heltal, opgørelsesår: Heltal) -> post.identifikation != "" && post.indkomstår >= fraflytningsår && post.indkomstår <= opgørelsesår && post.rækkefølge_i_indkomståret > 0 && post.rækkefølge_i_indkomståret < 1000000 && aktieavance_par37_til40_hændelse_matcher_post(post)
| aktieavance_par37_til40_hændelsesposter_strukturelt_gyldige(poster: List(AktieavancePar37Til40Hændelsespost), fraflytningsår: Heltal, opgørelsesår: Heltal) -> aktieavance_par37_til40_hændelsesposter_sorteret_fra(poster, fraflytningsår - 1, 0) && all(poster, |post: AktieavancePar37Til40Hændelsespost| aktieavance_par37_til40_hændelsespost_intrinsisk_gyldig(post, fraflytningsår, opgørelsesår) && aktieavance_par37_til40_hændelsesidentifikation_unik(poster, post))
| aktieavance_par37_til40_hændelsespostresultat(tilstand: AktieavancePar39ATilstand, post: AktieavancePar37Til40Hændelsespost, forløb_strukturelt_gyldigt: Boolsk, fraflytningsår: Heltal, opgørelsesår: Heltal) -> {
    = post_strukturelt_gyldig = forløb_strukturelt_gyldigt && aktieavance_par37_til40_hændelsespost_intrinsisk_gyldig(post, fraflytningsår, opgørelsesår)
    = hændelsesresultat = aktieavance_par39a_hændelsesresultat(tilstand, post.hændelse)
    = hændelse_gyldig = post_strukturelt_gyldig && hændelsesresultat.hændelse_gyldig
    AktieavancePar37Til40Hændelsespostresultat(post = post, post_strukturelt_gyldig = post_strukturelt_gyldig, hændelsesresultat = hændelsesresultat, hændelse_gyldig = hændelse_gyldig, tilstand_før = tilstand, tilstand_efter = hvis hændelse_gyldig { hændelsesresultat.tilstand_efter } ellers { tilstand })
}
| aktieavance_par37_til40_forløbstrin(forløb: AktieavancePar37Til40Forløbstilstand, post: AktieavancePar37Til40Hændelsespost, forløb_strukturelt_gyldigt: Boolsk, fraflytningsår: Heltal, opgørelsesår: Heltal) -> {
    = resultat = aktieavance_par37_til40_hændelsespostresultat(forløb.tilstand, post, forløb_strukturelt_gyldigt, fraflytningsår, opgørelsesår)
    AktieavancePar37Til40Forløbstilstand(tilstand = resultat.tilstand_efter, resultater = concat(forløb.resultater, [resultat]), alle_hændelser_gyldige = forløb.alle_hændelser_gyldige && resultat.hændelse_gyldig)
}
| aktieavance_par37_til40_tilflytning_efter_hændelsespost(tilflytningsår: Heltal, tilflytningsrækkefølge: Heltal, post: AktieavancePar37Til40Hændelsespost) -> tilflytningsår > post.indkomstår || (tilflytningsår == post.indkomstår && tilflytningsrækkefølge > post.rækkefølge_i_indkomståret)
| aktieavance_par37_til40_tilflytningsresultat(tilflytning: AktieavancePar37Til40Tilflytning, tilstand: AktieavancePar39ATilstand, oprindeligt_nettotab_kroner: Heltal) -> match tilflytning {
    | IngenTilflytningEfterPar39B -> None
    | TilflytningEfterPar39B(_, indkomstår, _, tilflytningsværdier, får_hjemsted, samlevende) -> Some(aktieavance_par39b_resultat(AktieavancePar39BInput(tilstand_før_tilflytning = tilstand, tilflytningsværdier = tilflytningsværdier, skatteår = indkomstår, får_på_ny_skattemæssigt_hjemsted_i_danmark = får_hjemsted, samlevende_med_ægtefælle_ved_indkomstårets_udløb = samlevende, oprindeligt_nettotab_ved_fraflytning_kroner = oprindeligt_nettotab_kroner)))
}
| aktieavance_par37_til40_tilflytning_strukturelt_gyldig(tilflytning: AktieavancePar37Til40Tilflytning, poster: List(AktieavancePar37Til40Hændelsespost), fraflytningsår: Heltal, opgørelsesår: Heltal) -> match tilflytning {
    | IngenTilflytningEfterPar39B -> Sandt
    | TilflytningEfterPar39B(identifikation, indkomstår, rækkefølge, _, _, _) -> identifikation != "" && indkomstår >= fraflytningsår && indkomstår <= opgørelsesår && rækkefølge > 0 && rækkefølge < 1000000 && all(poster, |post: AktieavancePar37Til40Hændelsespost| post.identifikation != identifikation && aktieavance_par37_til40_tilflytning_efter_hændelsespost(indkomstår, rækkefølge, post))
}
| aktieavance_par37_til40_tilflytningsresultat_gyldigt(resultat: Option(AktieavancePar39BResultat)) -> match resultat { | None -> Sandt | Some(værdi) -> værdi.input_gyldigt }
| aktieavance_par37_til40_tilstand_efter_tilflytning(resultat: Option(AktieavancePar39BResultat), tilstand_før: AktieavancePar39ATilstand) -> match resultat { | None -> tilstand_før | Some(værdi) -> hvis værdi.input_gyldigt { værdi.tilstand_efter_tilflytning } ellers { tilstand_før } }

# AktieavancePar37Til40ForløbsSag(input: AktieavancePar37Til40Forløbsinput) {
    | fraflytningsresultat() -> aktieavance_par37_til40_fraflytningsresultat(input.fraflytning)
    | hændelsesforløb_strukturelt_gyldigt() -> aktieavance_par37_til40_hændelsesposter_strukturelt_gyldige(input.hændelsesposter, input.fraflytning.fraflytningsår, input.opgørelsesår)
    | initialt_forløb() -> AktieavancePar37Til40Forløbstilstand(tilstand = fraflytningsresultat().tilstand_primo, resultater = [], alle_hændelser_gyldige = hændelsesforløb_strukturelt_gyldigt())
    | slutforløb() -> foldl(input.hændelsesposter, initialt_forløb(), |forløb: AktieavancePar37Til40Forløbstilstand, post: AktieavancePar37Til40Hændelsespost| aktieavance_par37_til40_forløbstrin(forløb, post, hændelsesforløb_strukturelt_gyldigt(), input.fraflytning.fraflytningsår, input.opgørelsesår))
    | tilflytning_strukturelt_gyldig() -> aktieavance_par37_til40_tilflytning_strukturelt_gyldig(input.tilflytning, input.hændelsesposter, input.fraflytning.fraflytningsår, input.opgørelsesår)
    | tilflytningsresultat() -> aktieavance_par37_til40_tilflytningsresultat(input.tilflytning, slutforløb().tilstand, fraflytningsresultat().par38_resultat.overskydende_tab_kroner)
    | input_gyldigt() -> input.identifikation != "" && input.opgørelsesår >= input.fraflytning.fraflytningsår && fraflytningsresultat().input_gyldigt && slutforløb().alle_hændelser_gyldige && tilflytning_strukturelt_gyldig() && aktieavance_par37_til40_tilflytningsresultat_gyldigt(tilflytningsresultat())
    | årets_beregnede_fraflytterskat_kroner() -> hvis input_gyldigt() && input.opgørelsesår == input.fraflytning.fraflytningsår { fraflytningsresultat().beregnet_fraflytterskat_kroner } ellers { 0 }
    | årets_nye_henstand_kroner() -> hvis input_gyldigt() && input.opgørelsesår == input.fraflytning.fraflytningsår { fraflytningsresultat().par39_resultat.henstandsbeløb_kroner } ellers { 0 }
    | årets_skat_til_betaling_ved_fraflytning_kroner() -> hvis input_gyldigt() && input.opgørelsesår == input.fraflytning.fraflytningsår { fraflytningsresultat().skat_til_betaling_ved_fraflytning_kroner } ellers { 0 }
    | årets_nye_forfald_kroner() -> hvis input_gyldigt() { foldl(slutforløb().resultater, 0, |sum: Heltal, resultat: AktieavancePar37Til40Hændelsespostresultat| sum + hvis resultat.post.indkomstår == input.opgørelsesår { resultat.hændelsesresultat.nyt_forfald_kroner } ellers { 0 }) } ellers { 0 }
    | årets_betalte_fraflytterskat_kroner() -> hvis input_gyldigt() { foldl(slutforløb().resultater, 0, |sum: Heltal, resultat: AktieavancePar37Til40Hændelsespostresultat| sum + hvis resultat.post.indkomstår == input.opgørelsesår { resultat.hændelsesresultat.betalt_kroner } ellers { 0 }) } ellers { 0 }
    | årets_straksnedskrivning_kroner() -> hvis input_gyldigt() { foldl(slutforløb().resultater, 0, |sum: Heltal, resultat: AktieavancePar37Til40Hændelsespostresultat| sum + hvis resultat.post.indkomstår == input.opgørelsesår { resultat.hændelsesresultat.straksnedskrivning_kroner } ellers { 0 }) } ellers { 0 }
    | årets_hændelsessaldobortfald_kroner() -> hvis input_gyldigt() { foldl(slutforløb().resultater, 0, |sum: Heltal, resultat: AktieavancePar37Til40Hændelsespostresultat| sum + hvis resultat.post.indkomstår == input.opgørelsesår { resultat.hændelsesresultat.saldobortfald_efter_stk10_kroner } ellers { 0 }) } ellers { 0 }
    | årets_tilflytningssaldobortfald_kroner() -> match tilflytningsresultat() { | Some(værdi) -> hvis input_gyldigt() && værdi.input.skatteår == input.opgørelsesår { værdi.resterende_henstandssaldo_bortfalder_kroner } ellers { 0 } | None -> 0 }
    | årets_saldobortfald_kroner() -> årets_hændelsessaldobortfald_kroner() + årets_tilflytningssaldobortfald_kroner()
    | tilstand_ultimo() -> hvis input_gyldigt() { aktieavance_par37_til40_tilstand_efter_tilflytning(tilflytningsresultat(), slutforløb().tilstand) } ellers { fraflytningsresultat().tilstand_primo }
    | aktieavancebeskatningslov_resultat() -> hvis input_gyldigt() && input.opgørelsesår == input.fraflytning.fraflytningsår { fraflytningsresultat().aktieavancebeskatningslov_resultat } ellers { aktieavance_par37_til40_tomt_personskattelov_resultat(input.opgørelsesår) }
    | resultat() -> AktieavancePar37Til40Forløbsresultat(input = input, fraflytningsresultat = fraflytningsresultat(), hændelsesresultater = slutforløb().resultater, tilstand_før_tilflytning = slutforløb().tilstand, tilflytningsresultat = tilflytningsresultat(), input_gyldigt = input_gyldigt(), årets_beregnede_fraflytterskat_kroner = årets_beregnede_fraflytterskat_kroner(), årets_nye_henstand_kroner = årets_nye_henstand_kroner(), årets_skat_til_betaling_ved_fraflytning_kroner = årets_skat_til_betaling_ved_fraflytning_kroner(), årets_nye_forfald_kroner = årets_nye_forfald_kroner(), årets_betalte_fraflytterskat_kroner = årets_betalte_fraflytterskat_kroner(), årets_straksnedskrivning_kroner = årets_straksnedskrivning_kroner(), årets_saldobortfald_kroner = årets_saldobortfald_kroner(), tilstand_ultimo = tilstand_ultimo(), aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat())
}

| aktieavance_par37_til40_forløbsresultat(input: AktieavancePar37Til40Forløbsinput) -> AktieavancePar37Til40ForløbsSag(input).resultat()
