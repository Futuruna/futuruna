@ sprog da

@ importer ./metadata
@ importer ./ejendomsavancebeskatningsloven

= ebl_ordinær_genanbringelse_scenarier_metadata = Metadata(
    attachments = (
        Source(value = ebl_genanbringelse_lbk132),
        Guidance(value = ebl_par6a_vejledning_2026),
        Guidance(value = ebl_par6c_vejledning_2026),
    )
)

--@label:ebl_ordinær_genanbringelse_scenarier::meta:ebl_ordinær_genanbringelse_scenarier_metadata--
--@begin:ebl_ordinær_genanbringelse_scenarier--
| ebl_ordinær_scenarie_par6a_fakta(erhvervsfortjeneste_kroner: Heltal, erhvervsanvendelse: EblPar6AErhvervsanvendelse) -> EblPar6AFakta(
    oprindelig_fortjeneste = EblOprindeligErhvervsfortjeneste(
        afståelsesindkomstår = 2025,
        erhvervsfortjeneste_før_par6_stk2_kroner = erhvervsfortjeneste_kroner,
        regulering = EblGenanbragtFortjenesteregulering(
            tillæg_for_genanbragt_del_kroner = 0,
            nedslag_for_genanbragt_del_kroner = 0
        )
    ),
    afstået_ejendoms_erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
    investering = EblPar6AInvestering(
        indkomstår = 2026,
        erhvervsmæssigt_anskaffelsesgrundlag_kroner = 1000000,
        ejendomsstatus = EblPar6AEjendomOmfattetAfLovenIkkePar8,
        erhvervsanvendelse = erhvervsanvendelse,
        placering = EblPar6AEjendomIDanmark
    ),
    begæring = EblPar6ABegæringVedRettidigAfgivelseEfterSkattekontrollovensPar2,
    ejerskab = EblPar6ASammeSkattepligtige
)

| ebl_ordinær_scenarie_salg_med_par5_fakta(genanbringelse: EblGenanbringelse, par5_fakta: EblPar5Fakta, kontant_anskaffelsessum_kroner: Heltal, kontant_afståelsessum_kroner: Heltal) -> ejendomsavancebeskatningslov_resultat(EjendomsavancebeskatningslovInput(
    indkomstår = 2026,
    afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = kontant_anskaffelsessum_kroner,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = par5_fakta,
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = kontant_afståelsessum_kroner,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = EblAndenFastEjendom(genanbringelse = genanbringelse),
    par11_stk2_valg = EblPar11Stk2IngenNyGenanbringelse,
    par6d_valg = EblUdenPar6DValg
))
| ebl_ordinær_scenarie_salg(genanbringelse: EblGenanbringelse, kontant_anskaffelsessum_kroner: Heltal, kontant_afståelsessum_kroner: Heltal) -> ebl_ordinær_scenarie_salg_med_par5_fakta(
    genanbringelse = genanbringelse,
    par5_fakta = ebl_par5_standardfakta(
        anskaffelsesdato = EblDato(år = 2026, måned = 1, dag = 1),
        anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag
    ),
    kontant_anskaffelsessum_kroner = kontant_anskaffelsessum_kroner,
    kontant_afståelsessum_kroner = kontant_afståelsessum_kroner
)
| ebl_ordinær_scenarie_delafståelse(genanbringelse: EblGenanbringelse) -> ejendomsavancebeskatningslov_resultat(EjendomsavancebeskatningslovInput(
    indkomstår = 2026,
    afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = 250000,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = EblPar5Fakta(
        anskaffelsesdato = EblDato(år = 2026, måned = 1, dag = 1),
        anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag,
        fordeling = EblPar5Fordeling(
            ejerandel_promille = 1000,
            afståelsesomfang = EblPar5DelAfEjendommen(
                afstået_del_anskaffelsessum_før_par5_kroner = 250000,
                hele_ejendommens_anskaffelsessum_før_par5_kroner = 1000000,
                ikke_boligdelens_anskaffelsessum_før_par5_kroner = None
            )
        ),
        vedligeholdelses_og_forbedringsudgifter = [],
        nedsættelser = [],
        mælkekvoter = [],
        stk6_overførsel = EblPar5UdenStk6Overførsel,
        reguleringsvalg = EblPar5UdenIndeksering
    ),
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = 300000,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = EblAndenFastEjendom(genanbringelse = genanbringelse),
    par11_stk2_valg = EblPar11Stk2IngenNyGenanbringelse,
    par6d_valg = EblUdenPar6DValg
))

= ebl_ordinær_scenarie_aktiv_genanbringelse = ebl_ordinær_scenarie_salg(
    genanbringelse = EblMedGenanbringelseEfterPar6A(fakta = ebl_ordinær_scenarie_par6a_fakta(
        erhvervsfortjeneste_kroner = 200000,
        erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed
    )),
    kontant_anskaffelsessum_kroner = 1000000,
    kontant_afståelsessum_kroner = 1000000
)

= ebl_ordinær_scenarie_kontrolophør = ebl_ordinær_scenarie_salg(
    genanbringelse = EblMedGenanbringelseEfterPar6A(fakta = ebl_ordinær_scenarie_par6a_fakta(
        erhvervsfortjeneste_kroner = 200000,
        erhvervsanvendelse = EblPar6AUdlejetTilKontrolleretSelskab(
            kapitalandel_ved_genanbringelse_promille = 600,
            stemmeandel_ved_genanbringelse_promille = 400,
            selskabet_anvender_ejendommen_erhvervsmæssigt = Sandt,
            bestemmende_indflydelse_består = Falskt
        )
    )),
    kontant_anskaffelsessum_kroner = 1000000,
    kontant_afståelsessum_kroner = 1000000
)

| ebl_ordinær_scenarie_par6c_par5_fakta(nedslag_for_afstået_del_kroner: Heltal) -> EblPar5Fakta(
    anskaffelsesdato = EblDato(år = 2026, måned = 1, dag = 1),
    anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag,
    fordeling = EblPar5Fordeling(
        ejerandel_promille = 1000,
        afståelsesomfang = EblPar5HeleEjendommen
    ),
    vedligeholdelses_og_forbedringsudgifter = [
        EblPar5Udgift(
            afholdelsesdato = EblDato(år = 2026, måned = 6, dag = 1),
            fuldførelsesår = 2026,
            beløb_for_afstået_del_kroner = 1000000,
            status = EblPar5UdgiftMedGenanbragtFortjenesteEfterPar6C(
                nedslag_for_afstået_del_kroner = nedslag_for_afstået_del_kroner
            )
        )
    ],
    nedsættelser = [],
    mælkekvoter = [],
    stk6_overførsel = EblPar5UdenStk6Overførsel,
    reguleringsvalg = EblPar5UdenIndeksering
)

= ebl_ordinær_scenarie_par6c = ebl_ordinær_scenarie_salg_med_par5_fakta(
    genanbringelse = EblMedGenanbringelseEfterPar6C(fakta = EblPar6CFakta(
        par6a_fakta = ebl_ordinær_scenarie_par6a_fakta(
            erhvervsfortjeneste_kroner = 200000,
            erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed
        ),
        arbejdsart = EblPar6CNybygning,
        arbejde_påbegyndt = Sandt
    )),
    par5_fakta = ebl_ordinær_scenarie_par6c_par5_fakta(
        nedslag_for_afstået_del_kroner = 200000
    ),
    kontant_anskaffelsessum_kroner = 100000,
    kontant_afståelsessum_kroner = 1000000
)
= ebl_ordinær_scenarie_par6c_uafstemt_nedslag = ebl_ordinær_scenarie_salg_med_par5_fakta(
    genanbringelse = EblMedGenanbringelseEfterPar6C(fakta = EblPar6CFakta(
        par6a_fakta = ebl_ordinær_scenarie_par6a_fakta(
            erhvervsfortjeneste_kroner = 200000,
            erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed
        ),
        arbejdsart = EblPar6CNybygning,
        arbejde_påbegyndt = Sandt
    )),
    par5_fakta = ebl_ordinær_scenarie_par6c_par5_fakta(
        nedslag_for_afstået_del_kroner = 150000
    ),
    kontant_anskaffelsessum_kroner = 100000,
    kontant_afståelsessum_kroner = 1000000
)
= ebl_ordinær_scenarie_par6c_efter_kontrolophør = ebl_ordinær_scenarie_salg_med_par5_fakta(
    genanbringelse = EblMedGenanbringelseEfterPar6C(fakta = EblPar6CFakta(
        par6a_fakta = ebl_ordinær_scenarie_par6a_fakta(
            erhvervsfortjeneste_kroner = 200000,
            erhvervsanvendelse = EblPar6AUdlejetTilKontrolleretSelskab(
                kapitalandel_ved_genanbringelse_promille = 600,
                stemmeandel_ved_genanbringelse_promille = 400,
                selskabet_anvender_ejendommen_erhvervsmæssigt = Sandt,
                bestemmende_indflydelse_består = Falskt
            )
        ),
        arbejdsart = EblPar6CNybygning,
        arbejde_påbegyndt = Sandt
    )),
    par5_fakta = ebl_ordinær_scenarie_par6c_par5_fakta(
        nedslag_for_afstået_del_kroner = 200000
    ),
    kontant_anskaffelsessum_kroner = 100000,
    kontant_afståelsessum_kroner = 1000000
)
= ebl_ordinær_scenarie_delvis_afståelse = ebl_ordinær_scenarie_delafståelse(
    genanbringelse = EblMedGenanbringelseEfterPar6A(fakta = ebl_ordinær_scenarie_par6a_fakta(
        erhvervsfortjeneste_kroner = 200000,
        erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed
    ))
)

| ebl_ordinær_scenarie_anvender_aktivt_nedslag_før_par5: ebl_ordinær_scenarie_aktiv_genanbringelse -> ebl_ordinær_scenarie_aktiv_genanbringelse.input_gyldigt && ebl_ordinær_scenarie_aktiv_genanbringelse.regelgrundlag_understøttet && ebl_ordinær_scenarie_aktiv_genanbringelse.genanbringelsesresultat.aktivt_anskaffelsessumsnedslag_kroner == 200000 && ebl_ordinær_scenarie_aktiv_genanbringelse.aktivt_anskaffelsessumsnedslag_anvendt_før_par5_kroner == 200000 && ebl_ordinær_scenarie_aktiv_genanbringelse.anskaffelsessum_før_par5_efter_aktivt_genanbringelsesnedslag_kroner == 800000 && ebl_ordinær_scenarie_aktiv_genanbringelse.par5_resultat.reguleret_anskaffelsessum_kroner == 810000 && ebl_ordinær_scenarie_aktiv_genanbringelse.skattepligtig_fortjeneste_kroner == 190000
| ebl_ordinær_scenarie_beskatter_ikke_genanbringelsen_to_gange: ebl_ordinær_scenarie_aktiv_genanbringelse -> ebl_ordinær_scenarie_aktiv_genanbringelse.genanbringelsesresultat.skattepligtig_genanbragt_fortjeneste_ved_senere_afståelse_kroner == 200000 && ebl_ordinær_scenarie_aktiv_genanbringelse.skattepligtig_fortjeneste_kroner == ebl_ordinær_scenarie_aktiv_genanbringelse.afståelsessum_kontantværdi_kroner - ebl_ordinær_scenarie_aktiv_genanbringelse.reguleret_anskaffelsessum_kroner
| ebl_ordinær_scenarie_kontrolophør_fjerner_nedslaget: ebl_ordinær_scenarie_kontrolophør -> ebl_ordinær_scenarie_kontrolophør.genanbringelsesresultat.beskattet_ved_kontrolophør_kroner == 200000 && ebl_ordinær_scenarie_kontrolophør.genanbringelsesresultat.aktivt_anskaffelsessumsnedslag_kroner == 0 && ebl_ordinær_scenarie_kontrolophør.aktivt_anskaffelsessumsnedslag_anvendt_før_par5_kroner == 0 && ebl_ordinær_scenarie_kontrolophør.skattepligtig_fortjeneste_kroner == 0 && ebl_ordinær_scenarie_kontrolophør.tab_kroner == 10000
| ebl_ordinær_scenarie_par6c_nedsætter_byggeudgiften: ebl_ordinær_scenarie_par6c -> ebl_ordinær_scenarie_par6c.input_gyldigt && ebl_ordinær_scenarie_par6c.regelgrundlag_understøttet && ebl_ordinær_scenarie_par6c.genanbringelsesresultat.hjemmel == EblGenanbringelseEfterPar6C && ebl_ordinær_scenarie_par6c.aktivt_anskaffelsessumsnedslag_anvendt_før_par5_kroner == 0 && ebl_ordinær_scenarie_par6c.par6c_nedslag_modregnet_i_par5_udgifter_kroner == 200000 && ebl_ordinær_scenarie_par6c.anskaffelsessum_før_par5_efter_aktivt_genanbringelsesnedslag_kroner == 100000 && length(ebl_ordinær_scenarie_par6c.par5_resultat.årsudgift_resultater) == 1 && ebl_ordinær_scenarie_par6c.par5_resultat.årsudgift_resultater[0].medregningsberettigede_udgifter_kroner == 800000 && ebl_ordinær_scenarie_par6c.par5_resultat.reguleret_anskaffelsessum_kroner == 900000 && ebl_ordinær_scenarie_par6c.skattepligtig_fortjeneste_kroner == 100000
| ebl_ordinær_scenarie_par6c_kræver_afstemt_udgiftsnedslag: ebl_ordinær_scenarie_par6c_uafstemt_nedslag -> ebl_ordinær_scenarie_par6c_uafstemt_nedslag.genanbringelsesresultat.input_gyldigt && ebl_ordinær_scenarie_par6c_uafstemt_nedslag.par6c_nedslag_modregnet_i_par5_udgifter_kroner == 150000 && ebl_ordinær_scenarie_par6c_uafstemt_nedslag.input_gyldigt == Falskt
| ebl_ordinær_scenarie_par6c_kontrolophør_genopretter_byggeudgiften: ebl_ordinær_scenarie_par6c_efter_kontrolophør -> ebl_ordinær_scenarie_par6c_efter_kontrolophør.input_gyldigt && ebl_ordinær_scenarie_par6c_efter_kontrolophør.genanbringelsesresultat.genanbragt_fortjeneste_kroner == 200000 && ebl_ordinær_scenarie_par6c_efter_kontrolophør.genanbringelsesresultat.beskattet_ved_kontrolophør_kroner == 200000 && ebl_ordinær_scenarie_par6c_efter_kontrolophør.genanbringelsesresultat.aktivt_anskaffelsessumsnedslag_kroner == 0 && ebl_ordinær_scenarie_par6c_efter_kontrolophør.par6c_nedslag_modregnet_i_par5_udgifter_kroner == 0 && ebl_ordinær_scenarie_par6c_efter_kontrolophør.par5_resultat.årsudgift_resultater[0].medregningsberettigede_udgifter_kroner == 1000000 && ebl_ordinær_scenarie_par6c_efter_kontrolophør.par5_resultat.reguleret_anskaffelsessum_kroner == 1100000 && ebl_ordinær_scenarie_par6c_efter_kontrolophør.tab_kroner == 100000
| ebl_ordinær_scenarie_delafståelse_fordeler_det_aktive_nedslag: ebl_ordinær_scenarie_delvis_afståelse -> ebl_ordinær_scenarie_delvis_afståelse.input_gyldigt && ebl_ordinær_scenarie_delvis_afståelse.genanbringelsesresultat.aktivt_anskaffelsessumsnedslag_kroner == 200000 && ebl_ordinær_scenarie_delvis_afståelse.aktivt_anskaffelsessumsnedslag_anvendt_før_par5_kroner == 50000 && ebl_ordinær_scenarie_delvis_afståelse.anskaffelsessum_før_par5_efter_aktivt_genanbringelsesnedslag_kroner == 200000 && ebl_ordinær_scenarie_delvis_afståelse.par5_resultat.fast_tillæg_efter_stk1_kroner == 2500 && ebl_ordinær_scenarie_delvis_afståelse.skattepligtig_fortjeneste_kroner == 97500

? ebl_ordinær_scenarie_anvender_aktivt_nedslag_før_par5
? ebl_ordinær_scenarie_beskatter_ikke_genanbringelsen_to_gange
? ebl_ordinær_scenarie_kontrolophør_fjerner_nedslaget
? ebl_ordinær_scenarie_par6c_nedsætter_byggeudgiften
? ebl_ordinær_scenarie_par6c_kræver_afstemt_udgiftsnedslag
? ebl_ordinær_scenarie_par6c_kontrolophør_genopretter_byggeudgiften
? ebl_ordinær_scenarie_delafståelse_fordeler_det_aktive_nedslag

@ print("EBL ordinary reinvestment scenarios passed")
--@end:ebl_ordinær_genanbringelse_scenarier--
