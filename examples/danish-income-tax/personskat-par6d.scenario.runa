@ sprog da

@ importer ./personskat.calculate

--@label:personskat_par6d_scenarier::source:ebl_par6d_lov1578::dependency_source:kgl_sælgerpantebrev_lbk1176::guidance:kgl_ebl_par6d_vejledning_2026--
--@begin:personskat_par6d_scenarier--
| personskat_par6d_scenarie_afdragsplan() -> [
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 1, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 2, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 3, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 4, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 5, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 6, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 7, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 8, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 9, hovedstol_forfalder_kroner = 375000),
    EblPar6DAfdragsplanpost(år_efter_afståelsen = 10, hovedstol_forfalder_kroner = 375000)
]

| personskat_par6d_scenarie_valg(årsforhold: List(EblPar6DÅrsforhold)) -> EblMedPar6DValg(fakta = EblPar6DValgfakta(
    valgt_udskudt_fortjeneste_kroner = 3000000,
    årligt_beløb_kroner = 300000,
    fordelingsår = 10,
    erhververen_erhvervede_ejendommen_som_led_i_næring = Falskt,
    partrelation = EblPar6DPartrelationFakta(
        overdragerens_kapitalandel_i_erhververen_promille = 0,
        overdragerens_stemmeandel_i_erhververen_promille = 0,
        erhververens_kapitalandel_i_overdrageren_promille = 0,
        erhververens_stemmeandel_i_overdrageren_promille = 0,
        parterne_er_nærtstående_efter_ligningslovens_par2_stk2 = Falskt,
        parterne_har_aftale_om_fælles_bestemmende_indflydelse = Falskt,
        parterne_er_under_fælles_bestemmende_indflydelse = Falskt
    ),
    overdragerens_anvendelse = EblPar6DEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
    erhververens_anvendelse_ved_overdragelsen = EblPar6DEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
    sælgerpantebrev = EblPar6DSælgerpantebrev(
        identifikation = "Sælgerpantebrev 2025",
        fordring_mod_erhververen = Sandt,
        pant_i_den_overdragne_ejendom = Sandt,
        kontantværdi_kroner = 3000000,
        hovedstol_kroner = 3750000,
        løbetid_år = 10,
        afdragsplan = personskat_par6d_scenarie_afdragsplan()
    ),
    meddelelse = EblPar6DRettidigMeddelelse(indhold = EblPar6DMeddelelsesindhold(
        kopi_af_sælgerpantebrev_vedlagt = Sandt,
        oplyst_skattepligtig_fortjeneste_efter_par6_kroner = 4990000,
        oplyst_valgt_udskudt_fortjeneste_kroner = 3000000,
        oplyst_årligt_beløb_kroner = 300000,
        oplyst_antal_år = 10
    )),
    sælgers_skatteforhold = EblPar6DSælgerskatteforhold(
        skattepligtsstatus = EblPar6DFuldtSkattepligtigTilDanmark,
        hjemland_omfattet_af_nordisk_overenskomst_eller_eu_inddrivelsesdirektiv = Sandt,
        sikkerhed = EblPar6DIngenSikkerhed
    ),
    ejendomsplacering = EblPar6DEjendomIDanmark,
    afståelsesårets_hændelse = EblPar6DIngenFremrykningshændelse,
    efterfølgende_årsforhold = årsforhold
))

| personskat_par6d_scenarie_ejendom(afståelsesår: Heltal, årsforhold: List(EblPar6DÅrsforhold)) -> PersonskatEjendomsavanceFakta(
    identifikation = "Erhvervsejendom med sælgerpantebrev",
    afståelsesdato = EblDato(år = afståelsesår, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = 25000000,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = ebl_par5_standardfakta(
        anskaffelsesdato = EblDato(år = afståelsesår, måned = 1, dag = 1),
        anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag
    ),
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = 30000000,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = ebl_anden_fast_ejendom_uden_genanbringelse(),
    par11_stk2_valg = EblPar11Stk2IngenNyGenanbringelse,
    par6d_valg = personskat_par6d_scenarie_valg(årsforhold)
)

| personskat_par6d_scenarie_kursgevinst(skatteyder_identifikation: Tekst) -> MedKursgevinst(fakta = PersonskatKursgevinstÅrsfakta(
    skatteyder_identifikation = skatteyder_identifikation,
    sælgerpantebreve = [KglEblPar6DSælgerpantebrevsfakta(
        sælgerpantebrev_identifikation = "Sælgerpantebrev 2025",
        oprindelig_skatteyder_identifikation = "Sælger",
        skatteyderfakta = KglEblPar6DSkatteyderfakta(
            udøver_næring_ved_køb_og_salg_af_fordringer = Falskt,
            fordringen_erhvervet_uden_for_fordringsnæring = Falskt,
            fordringen_erhvervet_som_vederlag_for_leverede_varer_eller_tjenesteydelser = Falskt,
            fordringen_erhvervet_i_direkte_tilknytning_til_erhvervsmæssig_drift = Falskt,
            debitor_omfattet_af_tabsbegrænsningen_i_kgl_par14_stk2 = Falskt,
            renter_eller_gevinster_fritaget_efter_dobbeltbeskatningsoverenskomst = Falskt
        ),
        dispositioner_efter_ebl_forløbet = []
    )],
    øvrigt_netto_fordringer_valutagæld_og_obligationsbaserede_investeringsbeviser_kroner = 0
))

| personskat_par6d_scenarie_input(skatteår: Heltal, skatteyder_identifikation: Tekst, ejendommens_afståelsesår: Heltal, årsforhold: List(EblPar6DÅrsforhold)) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = skatteår,
        kommune = København,
        bruttoløn_kroner = 0,
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = PersonskatKapitalindkomstInput(
        renter = PersonskatRenteInput(
            renteindtægter_kroner = 0,
            renteudgifter_kroner = 0,
            næringsstatus = IkkeNæring,
            ligningslov6 = UdenLigningslov6Kurstab,
            ligningslov6a = UdenLigningslov6AFradrag
        ),
        ejendomsavance = MedEjendomsavance(fakta = PersonskatEjendomsavanceÅrsfakta(
            egne_afståelser = [personskat_par6d_scenarie_ejendom(ejendommens_afståelsesår, årsforhold)],
            eget_fremført_tab = UdenFremførtEjendomstab,
            ægtefælles_afståelser = [],
            ægtefælles_fremførte_tab = UdenFremførtEjendomstab,
            gift_samlevende_ved_indkomstårets_udgang = Falskt
        )),
        kursgevinst = personskat_par6d_scenarie_kursgevinst(skatteyder_identifikation),
        omkostninger = []
    ),
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)

| personskat_par6d_scenarie_betaling(fordringsdel_identifikation: Tekst, betalt_kroner: Heltal) -> EblPar6DOrdinærtHovedstolsafdrag(fordringsdel_identifikation = fordringsdel_identifikation, betalt_kroner = betalt_kroner)

= personskat_par6d_scenarie_2026_årsforhold = EblPar6DÅrsforhold(
    indkomstår = 2026,
    forløbsposter = [personskat_par6d_scenarie_betaling("Sælgerpantebrev 2025", 375000)]
)
= personskat_par6d_scenarie_resultat = beregn_personskat(personskat_par6d_scenarie_input(2026, "Sælger", 2025, [personskat_par6d_scenarie_2026_årsforhold]))
= personskat_par6d_scenarie_udækket_resultat = beregn_personskat(personskat_par6d_scenarie_input(2026, "Sælger", 2025, []))

= personskat_par6d_scenarie_ægtefællesuccession_resultat = beregn_personskat(personskat_par6d_scenarie_input(2026, "Ægtefælle", 2023, [
    EblPar6DÅrsforhold(
        indkomstår = 2024,
        forløbsposter = [personskat_par6d_scenarie_betaling("Sælgerpantebrev 2025", 375000)]
    ),
    EblPar6DÅrsforhold(
        indkomstår = 2025,
        forløbsposter = [
            personskat_par6d_scenarie_betaling("Sælgerpantebrev 2025", 375000),
            EblPar6DFremrykningshændelse(hændelse = EblPar6DPantebrevAfståetEllerIndfriet(
                berørt_fordringsdel_identifikation = "Sælgerpantebrev 2025",
                art = EblPar6DPantebrevAfstået,
                berørt_restgæld_kroner = 3000000,
                afståelses_eller_indfrielsesprovenu_kroner = 0,
                succession = EblPar6DÆgtefælleMedSuccessionEfterKildeskattelovensPar26B(
                    modtagers_fordringsdel_identifikation = "Ægtefællens pantebrev 2025",
                    modtagers_skatteyder_identifikation = "Ægtefælle",
                    overdrager_hjemmehørende_i_danmark = Sandt,
                    modtager_hjemmehørende_i_danmark = Sandt
                )
            ))
        ]
    ),
    EblPar6DÅrsforhold(
        indkomstår = 2026,
        forløbsposter = [personskat_par6d_scenarie_betaling("Ægtefællens pantebrev 2025", 375000)]
    )
]))

| personskat_par6d_scenarie_medregner_ebl_og_kgl: personskat_par6d_scenarie_resultat -> personskat_par6d_scenarie_resultat.kapitalindkomst.ejendomsavance_input_gyldigt && personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_input_gyldigt && personskat_par6d_scenarie_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 375000 && personskat_par6d_scenarie_resultat.skat.nettokapitalindkomst_kroner == 375000 && personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_resultat.årets_samlede_netto_efter_par14_kroner == 75000 && length(personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater) == 1 && head(personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater).netto_efter_kursgevinstloven_kroner == 75000 && match personskat_par6d_scenarie_resultat.kapitalindkomst.ejendomsavance_resultat {
    | BeregnetEjendomsavance(_, egne_resultater, _, eget_tabsår, _, _) -> head(egne_resultater).indkomstår == 2025 && head(egne_resultater).skattepligtig_fortjeneste_før_par6d_kroner == 4990000 && head(egne_resultater).skattepligtig_fortjeneste_kroner == 1990000 && ebl_par6d_medregnet_fortjeneste_i_indkomstår_kroner(head(egne_resultater).par6d_resultat, 2026) == 300000 && eget_tabsår.egne_skattepligtige_fortjenester_kroner == 300000
    | _ -> Falskt
}
| personskat_par6d_scenarie_afviser_udækket_skatteår: personskat_par6d_scenarie_udækket_resultat -> personskat_par6d_scenarie_udækket_resultat.kapitalindkomst.ejendomsavance_input_gyldigt == Falskt && match personskat_par6d_scenarie_udækket_resultat.kapitalindkomst.ejendomsavance_resultat {
    | UgyldigtEjendomsavancegrundlag(_, grundfakta_gyldige, fortjenesteafgrænsninger_understøttet, årsforløb_dækker_skatteår, fremførsler_gyldige, ægtefælledata_relevant) -> grundfakta_gyldige && fortjenesteafgrænsninger_understøttet && årsforløb_dækker_skatteår == Falskt && fremførsler_gyldige && ægtefælledata_relevant
    | _ -> Falskt
}
| personskat_par6d_scenarie_succederende_ægtefælle_får_kun_egne_kgl_beløb: personskat_par6d_scenarie_ægtefællesuccession_resultat -> personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.ejendomsavance_input_gyldigt && personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_input_gyldigt && personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.årets_samlede_netto_efter_par14_kroner == 75000 && length(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater) == 1 && head(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater).rolle == KglPersonEfterKildeskatteloven && head(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater).netto_efter_kursgevinstloven_kroner == 75000 && personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 375000 && last(head(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.sælgerpantebrevsresultater).kursgevinstresultat.dispositionsresultater).berørt_tranche_før.skatteyder.identifikation == "Ægtefælle"

? personskat_par6d_scenarie_medregner_ebl_og_kgl
? personskat_par6d_scenarie_afviser_udækket_skatteår
? personskat_par6d_scenarie_succederende_ægtefælle_får_kun_egne_kgl_beløb

@ print("Personskat EBL § 6 D scenarios passed")
--@end:personskat_par6d_scenarier--
