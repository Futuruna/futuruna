@ sprog da

@ importer ./metadata
@ importer ./personskat - par6d - fixtures

= personskat_par6d_scenarier_metadata = Metadata(
    attachments = (
        Source(value = ebl_par6d_lov1578),
        DependencySource(value = kgl_sælgerpantebrev_lbk1176),
        Guidance(value = kgl_ebl_par6d_vejledning_2026),
    )
)

--@label:personskat_par6d_scenarier::meta:personskat_par6d_scenarier_metadata--
--@begin:personskat_par6d_scenarier--
= personskat_par6d_scenarie_2026_årsforhold = EblPar6DÅrsforhold(
    indkomstår = 2026,
    forløbsposter = [personskat_par6d_scenarie_betaling("Sælgerpantebrev 2025", 375000)]
)
= personskat_par6d_scenarie_resultat = beregn_personskat(personskat_par6d_scenarie_input(2026, "Sælger", 2025, [personskat_par6d_scenarie_2026_årsforhold]))
= personskat_par6d_scenarie_udækket_resultat = beregn_personskat(personskat_par6d_scenarie_input(2026, "Sælger", 2025, []))

= personskat_par6d_scenarie_ægtefællesuccession_resultat = beregn_personskat(personskat_par6d_scenarie_input(2026, "Ægtefælle", 2023, [
    EblPar6DÅrsforhold(
        indkomstår = 2024,
        forløbsposter = [personskat_par6d_scenarie_betaling("Sælgerpantebrev 2025", 375000)]
    ),
    EblPar6DÅrsforhold(
        indkomstår = 2025,
        forløbsposter = [
            personskat_par6d_scenarie_betaling("Sælgerpantebrev 2025", 375000),
            EblPar6DFremrykningshændelse(hændelse = EblPar6DPantebrevAfståetEllerIndfriet(
                berørt_fordringsdel_identifikation = "Sælgerpantebrev 2025",
                art = EblPar6DPantebrevAfstået,
                berørt_restgæld_kroner = 3000000,
                afståelses_eller_indfrielsesprovenu_kroner = 0,
                succession = EblPar6DÆgtefælleMedSuccessionEfterKildeskattelovensPar26B(
                    modtagers_fordringsdel_identifikation = "Ægtefællens pantebrev 2025",
                    modtagers_skatteyder_identifikation = "Ægtefælle",
                    overdrager_hjemmehørende_i_danmark = Sandt,
                    modtager_hjemmehørende_i_danmark = Sandt
                )
            ))
        ]
    ),
    EblPar6DÅrsforhold(
        indkomstår = 2026,
        forløbsposter = [personskat_par6d_scenarie_betaling("Ægtefællens pantebrev 2025", 375000)]
    )
]))

| personskat_par6d_scenarie_medregner_ebl_og_kgl: personskat_par6d_scenarie_resultat -> personskat_par6d_scenarie_resultat.kapitalindkomst.ejendomsavance_input_gyldigt && personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_input_gyldigt && personskat_par6d_scenarie_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 375000 && personskat_par6d_scenarie_resultat.skat.nettokapitalindkomst_kroner == 375000 && personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_resultat.årets_samlede_netto_efter_par14_kroner == 75000 && length(personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater) == 1 && head(personskat_par6d_scenarie_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater).netto_efter_kursgevinstloven_kroner == 75000 && match personskat_par6d_scenarie_resultat.kapitalindkomst.ejendomsavance_resultat {
    | BeregnetEjendomsavance(_, egne_resultater, _, _, _, eget_tabsår, _, _) -> head(egne_resultater).indkomstår == 2025 && head(egne_resultater).skattepligtig_fortjeneste_før_par6d_kroner == 4990000 && head(egne_resultater).skattepligtig_fortjeneste_kroner == 1990000 && ebl_par6d_medregnet_fortjeneste_i_indkomstår_kroner(head(egne_resultater).par6d_resultat, 2026) == 300000 && eget_tabsår.egne_skattepligtige_fortjenester_kroner == 300000
    | _ -> Falskt
}
| personskat_par6d_scenarie_afviser_udækket_skatteår: personskat_par6d_scenarie_udækket_resultat -> personskat_par6d_scenarie_udækket_resultat.kapitalindkomst.ejendomsavance_input_gyldigt == Falskt && match personskat_par6d_scenarie_udækket_resultat.kapitalindkomst.ejendomsavance_resultat {
    | UgyldigtEjendomsavancegrundlag(_, grundfakta_gyldige, fortjenesteafgrænsninger_understøttet, årsforløb_dækker_skatteår, fremførsler_gyldige, ægtefælledata_relevant) -> grundfakta_gyldige && fortjenesteafgrænsninger_understøttet && årsforløb_dækker_skatteår == Falskt && fremførsler_gyldige && ægtefælledata_relevant
    | _ -> Falskt
}
| personskat_par6d_scenarie_succederende_ægtefælle_får_kun_egne_kgl_beløb: personskat_par6d_scenarie_ægtefællesuccession_resultat -> personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.ejendomsavance_input_gyldigt && personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_input_gyldigt && personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.årets_samlede_netto_efter_par14_kroner == 75000 && length(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater) == 1 && head(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater).rolle == KglPersonEfterKildeskatteloven && head(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.kursgevinstlov_resultater).netto_efter_kursgevinstloven_kroner == 75000 && personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 375000 && last(head(personskat_par6d_scenarie_ægtefællesuccession_resultat.kapitalindkomst.kursgevinst_resultat.sælgerpantebrevsresultater).kursgevinstresultat.dispositionsresultater).berørt_tranche_før.skatteyder.identifikation == "Ægtefælle"

? personskat_par6d_scenarie_medregner_ebl_og_kgl
? personskat_par6d_scenarie_afviser_udækket_skatteår
? personskat_par6d_scenarie_succederende_ægtefælle_får_kun_egne_kgl_beløb

@ print("Personskat EBL § 6 D scenarios passed")
--@end:personskat_par6d_scenarier--
