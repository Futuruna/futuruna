@ sprog da

@ importer ./kapitel - 01 - indkomst
@ importer ./aktieavancebeskatningsloven - par23 - 27

| abl_inv_par19_resultat(aktivmasse: AktieavanceInvesteringsaktivmasse, meddelelse: AktieavancePar19BMeddelelse, oplysninger: AktieavancePar19BOplysninger) -> aktieavance_par19b_par19c_resultat(AktieavancePar19BPar19CInput(
    indkomstår = 2026,
    meddelelse = meddelelse,
    aktivmasse = aktivmasse,
    oplysninger = oplysninger
))
| abl_inv_par21_resultat(aktivmasse: AktieavanceInvesteringsaktivmasse, oplysninger: AktieavancePar21Oplysninger) -> aktieavance_par21_par22_resultat(AktieavancePar21Par22Input(
    indkomstår = 2026,
    aktivmasse = aktivmasse,
    oplysninger = oplysninger
))
| abl_inv_generisk_input(aktiv: AktieavancebeskatningslovAktiv, klassifikation: AktieavanceInvesteringsklassifikation, par17_modprøve: AktieavancePar17Modprøve, afståelsessum_kroner: Heltal, anskaffelsessum_kroner: Heltal, årets_netto_med_kgl_par14_23_kroner: Heltal) -> AktieavancebeskatningslovInput(
    indkomstår = 2026,
    aktiv = aktiv,
    afståelsessum_kroner = afståelsessum_kroner,
    anskaffelsessum_kroner = anskaffelsessum_kroner,
    par17_modprøve = par17_modprøve,
    koncernintern_konvertibel_eller_tegningsret = Falskt,
    andelsforening_stiftet_før_22_maj_1987 = Falskt,
    afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
    investeringsklassifikation = klassifikation,
    årets_netto_med_kgl_par14_23_kroner = årets_netto_med_kgl_par14_23_kroner
)

= abl_inv_ingen_par17 = AktieavancePar17Modprøve(
    næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
    erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
)
= abl_inv_omfattet_af_par17 = AktieavancePar17Modprøve(
    næringsstatus = AblPar17UdøverNæringVedKøbOgSalgAfAktier,
    erhvervelsesstatus = AblPar17ErhvervetSomLedINæringsvej
)
= abl_inv_omfattet_af_par17_stk3 = AktieavancePar17Modprøve(
    næringsstatus = AblPar17UdøverNæringVedKøbOgSalgAfAktier,
    erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
)
= abl_inv_rettidig_ordinær_meddelelse = AblPar19BOrdinærMeddelelse(
    virkningsår = 2026,
    indsendelsesdato = AktieavanceInvesteringsdato(år = 2025, måned = 11, dag = 1)
)
= abl_inv_rettidige_par19b_oplysninger = AblPar19BOplysningerIndsendt(
    indsendelsesdato = AktieavanceInvesteringsdato(år = 2027, måned = 7, dag = 1)
)
= abl_inv_par21_oplysninger_rettidige = AblPar21OplysningerIndsendt(
    frist = AktieavanceInvesteringsdato(år = 2027, måned = 7, dag = 1),
    indsendelsesdato = AktieavanceInvesteringsdato(år = 2027, måned = 7, dag = 1)
)

= abl_inv_aktivmasse_præcis_50_med_værdipapirer = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [
        AblDirekteInvesteringsaktiv(art = AblKvalificerendeAktieaktiv, gennemsnitlig_værdi_kroner = 50000),
        AblDirekteInvesteringsaktiv(art = AblAndetVærdipapir, gennemsnitlig_værdi_kroner = 50000)
    ],
    ejerposter = []
)
= abl_inv_aktivmasse_præcis_50_med_andet_aktiv = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [
        AblDirekteInvesteringsaktiv(art = AblKvalificerendeAktieaktiv, gennemsnitlig_værdi_kroner = 50000),
        AblDirekteInvesteringsaktiv(art = AblAndetAktiv, gennemsnitlig_værdi_kroner = 50000)
    ],
    ejerposter = []
)
= abl_inv_aktivmasse_under_50 = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [
        AblDirekteInvesteringsaktiv(art = AblKvalificerendeAktieaktiv, gennemsnitlig_værdi_kroner = 49000),
        AblDirekteInvesteringsaktiv(art = AblAndetVærdipapir, gennemsnitlig_værdi_kroner = 51000)
    ],
    ejerposter = []
)
= abl_inv_aktivmasse_med_kgl_underliggende = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [
        AblKglPar29Til33Aktiv(underliggende_art = AblKvalificerendeAktieaktiv, underliggende_gennemsnitlig_værdi_kroner = 50000),
        AblDirekteInvesteringsaktiv(art = AblAndetVærdipapir, gennemsnitlig_værdi_kroner = 50000)
    ],
    ejerposter = []
)
= abl_inv_underliggende_par21_aktivmasse = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [
        AblDirekteInvesteringsaktiv(art = AblKvalificerendeAktieaktiv, gennemsnitlig_værdi_kroner = 50000),
        AblDirekteInvesteringsaktiv(art = AblAndetAktiv, gennemsnitlig_værdi_kroner = 50000)
    ],
    ejerposter = []
)
= abl_inv_underliggende_par21_resultat = abl_inv_par21_resultat(
    aktivmasse = abl_inv_underliggende_par21_aktivmasse,
    oplysninger = abl_inv_par21_oplysninger_rettidige
)
= abl_inv_underliggende_par22_resultat = abl_inv_par21_resultat(
    aktivmasse = abl_inv_aktivmasse_under_50,
    oplysninger = abl_inv_par21_oplysninger_rettidige
)
= abl_inv_ejerpost_under_25_pct = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [],
    ejerposter = [
        AblEjerpostIPar21(
            ejerandel = AktieavanceInvesteringsEjerandel(ejede_kapitalenheder = 2499, samlede_kapitalenheder = 10000),
            gennemsnitlig_markedsværdi_kroner = 100000,
            klassifikationsinput = abl_inv_underliggende_par21_resultat.input
        )
    ]
)
= abl_inv_ejerpost_præcis_25_pct = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [],
    ejerposter = [
        AblEjerpostIPar21(
            ejerandel = AktieavanceInvesteringsEjerandel(ejede_kapitalenheder = 1, samlede_kapitalenheder = 4),
            gennemsnitlig_markedsværdi_kroner = 1000000,
            klassifikationsinput = abl_inv_underliggende_par21_resultat.input
        )
    ]
)
= abl_inv_ejerpost_præcis_25_pct_med_par22_status = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2026,
    direkte_aktiver = [],
    ejerposter = [
        AblEjerpostIPar21(
            ejerandel = AktieavanceInvesteringsEjerandel(ejede_kapitalenheder = 1, samlede_kapitalenheder = 4),
            gennemsnitlig_markedsværdi_kroner = 100000,
            klassifikationsinput = abl_inv_underliggende_par22_resultat.input
        )
    ]
)
= abl_inv_ejerpost_fra_forkert_indkomstår = AktieavanceInvesteringsaktivmasse(
    indkomstår = 2027,
    direkte_aktiver = [],
    ejerposter = [
        AblEjerpostIPar21(
            ejerandel = AktieavanceInvesteringsEjerandel(ejede_kapitalenheder = 1, samlede_kapitalenheder = 5),
            gennemsnitlig_markedsværdi_kroner = 100000,
            klassifikationsinput = abl_inv_underliggende_par21_resultat.input
        )
    ]
)

= abl_inv_par19b_resultat = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_værdipapirer,
    meddelelse = abl_inv_rettidig_ordinær_meddelelse,
    oplysninger = abl_inv_rettidige_par19b_oplysninger
)
= abl_inv_par19c_på_grund_af_andet_aktiv = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_andet_aktiv,
    meddelelse = abl_inv_rettidig_ordinær_meddelelse,
    oplysninger = abl_inv_rettidige_par19b_oplysninger
)
= abl_inv_par19c_uden_meddelelse = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_værdipapirer,
    meddelelse = AblIngenPar19BMeddelelse,
    oplysninger = abl_inv_rettidige_par19b_oplysninger
)
= abl_inv_par19c_sen_ordinær_meddelelse = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_værdipapirer,
    meddelelse = AblPar19BOrdinærMeddelelse(
        virkningsår = 2026,
        indsendelsesdato = AktieavanceInvesteringsdato(år = 2025, måned = 11, dag = 2)
    ),
    oplysninger = abl_inv_rettidige_par19b_oplysninger
)
= abl_inv_par19b_nyoprettet_to_måneder = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_værdipapirer,
    meddelelse = AblPar19BNyoprettetMeddelelse(
        oprettelsesdato = AktieavanceInvesteringsdato(år = 2026, måned = 8, dag = 31),
        valg_truffet_samtidig_med_oprettelsen = Sandt,
        indsendelsesdato = AktieavanceInvesteringsdato(år = 2026, måned = 10, dag = 31)
    ),
    oplysninger = abl_inv_rettidige_par19b_oplysninger
)
= abl_inv_par19c_nyoprettet_efter_novemberfrist = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_værdipapirer,
    meddelelse = AblPar19BNyoprettetMeddelelse(
        oprettelsesdato = AktieavanceInvesteringsdato(år = 2026, måned = 10, dag = 1),
        valg_truffet_samtidig_med_oprettelsen = Sandt,
        indsendelsesdato = AktieavanceInvesteringsdato(år = 2026, måned = 11, dag = 2)
    ),
    oplysninger = abl_inv_rettidige_par19b_oplysninger
)
= abl_inv_par19c_sene_oplysninger = abl_inv_par19_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_værdipapirer,
    meddelelse = abl_inv_rettidig_ordinær_meddelelse,
    oplysninger = AblPar19BOplysningerIndsendt(
        indsendelsesdato = AktieavanceInvesteringsdato(år = 2027, måned = 7, dag = 2)
    )
)

= abl_inv_par21_trods_andet_aktiv_og_sene_oplysninger = abl_inv_par21_resultat(
    aktivmasse = abl_inv_aktivmasse_præcis_50_med_andet_aktiv,
    oplysninger = AblPar21OplysningerIndsendt(
        frist = AktieavanceInvesteringsdato(år = 2027, måned = 7, dag = 1),
        indsendelsesdato = AktieavanceInvesteringsdato(år = 2027, måned = 7, dag = 2)
    )
)
= abl_inv_par22_resultat = abl_inv_underliggende_par22_resultat
= abl_inv_forfalsket_par19b_resultat = AktieavancePar19BPar19CResultat(
    input = abl_inv_par19b_resultat.input,
    input_gyldigt = Sandt,
    aktivmasse_resultat = abl_inv_par19b_resultat.aktivmasse_resultat,
    meddelelse_rettidig = Sandt,
    anbringelsesbetingelser_efter_stk2_opfyldt = Sandt,
    oplysninger_rettidige_efter_stk6 = Sandt,
    aktiebaseret_efter_par19b_stk2 = Sandt,
    skift_til_par19c_på_grund_af_anbringelser = Falskt,
    skift_til_par19c_på_grund_af_oplysninger = Falskt,
    skal_offentliggøre_manglende_overholdelse = Falskt,
    effektiv_status = AblObligationsbaseretInvesteringsselskabEfterPar19C
)

= abl_inv_19b_aktieinput = abl_inv_generisk_input(
    aktiv = AblInvesteringsselskabPar19TilKlassifikation,
    klassifikation = AblPar19BPar19CKlassifikation(input = abl_inv_par19b_resultat.input),
    par17_modprøve = abl_inv_ingen_par17,
    afståelsessum_kroner = 50000,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 0
)
= abl_inv_19c_kapitalinput = abl_inv_generisk_input(
    aktiv = AblInvesteringsselskabPar19TilKlassifikation,
    klassifikation = AblPar19BPar19CKlassifikation(input = abl_inv_par19c_uden_meddelelse.input),
    par17_modprøve = abl_inv_ingen_par17,
    afståelsessum_kroner = 42000,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 0
)
= abl_inv_19b_personlig_input = abl_inv_generisk_input(
    aktiv = AblInvesteringsselskabPar19TilKlassifikation,
    klassifikation = AblPar19BPar19CKlassifikation(input = abl_inv_par19b_resultat.input),
    par17_modprøve = abl_inv_omfattet_af_par17,
    afståelsessum_kroner = 37000,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 0
)
= abl_inv_19c_personlig_input = abl_inv_generisk_input(
    aktiv = AblInvesteringsselskabPar19TilKlassifikation,
    klassifikation = AblPar19BPar19CKlassifikation(input = abl_inv_par19c_uden_meddelelse.input),
    par17_modprøve = abl_inv_omfattet_af_par17,
    afståelsessum_kroner = 37000,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 0
)
= abl_inv_21_aktieinput = abl_inv_generisk_input(
    aktiv = AblMinimumsinstitutTilKlassifikation,
    klassifikation = AblPar21Par22Klassifikation(input = abl_inv_par21_trods_andet_aktiv_og_sene_oplysninger.input),
    par17_modprøve = abl_inv_ingen_par17,
    afståelsessum_kroner = 40000,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 0
)
= abl_inv_21_personlig_input = abl_inv_generisk_input(
    aktiv = AblMinimumsinstitutTilKlassifikation,
    klassifikation = AblPar21Par22Klassifikation(input = abl_inv_par21_trods_andet_aktiv_og_sene_oplysninger.input),
    par17_modprøve = abl_inv_omfattet_af_par17,
    afståelsessum_kroner = 37000,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 0
)
= abl_inv_22_under_bagatel_input = abl_inv_generisk_input(
    aktiv = AblMinimumsinstitutTilKlassifikation,
    klassifikation = AblPar21Par22Klassifikation(input = abl_inv_par22_resultat.input),
    par17_modprøve = abl_inv_ingen_par17,
    afståelsessum_kroner = 31500,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 1500
)
= abl_inv_22_par17_input = abl_inv_generisk_input(
    aktiv = AblMinimumsinstitutTilKlassifikation,
    klassifikation = AblPar21Par22Klassifikation(input = abl_inv_par22_resultat.input),
    par17_modprøve = abl_inv_omfattet_af_par17_stk3,
    afståelsessum_kroner = 31500,
    anskaffelsessum_kroner = 30000,
    årets_netto_med_kgl_par14_23_kroner = 1500
)

= abl_inv_19b_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_19b_aktieinput)
= abl_inv_19c_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_19c_kapitalinput)
= abl_inv_19b_personlig_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_19b_personlig_input)
= abl_inv_19c_personlig_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_19c_personlig_input)
= abl_inv_21_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_21_aktieinput)
= abl_inv_21_personlig_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_21_personlig_input)
= abl_inv_22_under_bagatel_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_22_under_bagatel_input)
= abl_inv_22_par17_abl_resultat = aktieavancebeskatningslov_resultat(abl_inv_22_par17_input)

= abl_inv_19b_par4a_resultat = par4a_aktieavancebeskatningslov_resultat_fra_aktieavancebeskatningslov(abl_inv_19b_aktieinput)
= abl_inv_19c_par4_resultat = par4_stk1_nr5_resultat_fra_aktieavancebeskatningslov(abl_inv_19c_kapitalinput)
= abl_inv_19b_personlig_par4a_resultat = par4a_aktieavancebeskatningslov_resultat_fra_aktieavancebeskatningslov(abl_inv_19b_personlig_input)
= abl_inv_19c_personlig_par4_resultat = par4_stk1_nr5_resultat_fra_aktieavancebeskatningslov(abl_inv_19c_personlig_input)
= abl_inv_21_par4a_resultat = par4a_aktieavancebeskatningslov_resultat_fra_aktieavancebeskatningslov(abl_inv_21_aktieinput)
= abl_inv_21_personlig_par4a_resultat = par4a_aktieavancebeskatningslov_resultat_fra_aktieavancebeskatningslov(abl_inv_21_personlig_input)
= abl_inv_22_personlig_par4_resultat = par4_stk1_nr5_resultat_fra_aktieavancebeskatningslov(abl_inv_22_par17_input)

| abl_inv_par23_principinput(indkomstår: Heltal, aktiv: AktieavancePar23Aktiv, obligationslager: Boolsk) -> AktieavancePar23PrincipInput(
    indkomstår = indkomstår,
    opgørelsesdato = AktieavancePar23Dato(år = indkomstår, måned = 12, dag = 31),
    skattepligtsresultat = aktieavance_par7_person_efter_kildeskatteloven,
    aktiv = aktiv,
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblIntetPar23Stk6Valg,
    stk7_valg = AktieavancePar23Stk7Valg(
        selskabsidentifikation = "",
        første_optagelsesdato = AktieavancePar23Dato(år = 0, måned = 0, dag = 0),
        ejer_dage_før_første_optagelse = 0,
        valgmåde = AblIntetPar23Stk7Valg
    ),
    obligationsgevinst_opgøres_efter_lagerprincippet = obligationslager,
    indkomstår_forskelligt_fra_kalenderår = Falskt
)
| abl_inv_par23_investeringsselskabsaktiv(klassifikationsinput: AktieavancePar19BPar19CInput) -> AblInvesteringsselskabsaktiv(
    klassifikationsinput = klassifikationsinput,
    papirart = AblInvesteringsselskabsaktie,
    markedsstatus = AblOptagetTilHandelPåReguleretMarked,
    registreret_i_værdipapircentral = Sandt
)

= abl_inv_par23_19b_aktiv = abl_inv_par23_investeringsselskabsaktiv(abl_inv_par19b_resultat.input)
= abl_inv_par23_19c_aktiv = abl_inv_par23_investeringsselskabsaktiv(abl_inv_par19c_uden_meddelelse.input)
= abl_inv_par23_21_aktiv = AblMinimumsinstitutsbevis(klassifikationsinput = abl_inv_par21_trods_andet_aktiv_og_sene_oplysninger.input)
= abl_inv_par23_22_aktiv = AblMinimumsinstitutsbevis(klassifikationsinput = abl_inv_par22_resultat.input)
= abl_inv_par23_19b_princip = aktieavance_par23_princip_resultat(abl_inv_par23_principinput(2026, abl_inv_par23_19b_aktiv, Falskt))
= abl_inv_par23_19c_princip = aktieavance_par23_princip_resultat(abl_inv_par23_principinput(2026, abl_inv_par23_19c_aktiv, Falskt))
= abl_inv_par23_21_princip = aktieavance_par23_princip_resultat(abl_inv_par23_principinput(2026, abl_inv_par23_21_aktiv, Sandt))
= abl_inv_par23_22_princip = aktieavance_par23_princip_resultat(abl_inv_par23_principinput(2026, abl_inv_par23_22_aktiv, Sandt))
= abl_inv_par23_forkert_indkomstår_princip = aktieavance_par23_princip_resultat(abl_inv_par23_principinput(2027, abl_inv_par23_19b_aktiv, Falskt))
= abl_inv_par23_forfalsket_aktivklassifikation = AktieavancePar23AktivKlassifikation(
    input_gyldigt = Sandt,
    effektivt_abl_aktiv = AblInvesteringsselskab19C
)
= abl_inv_par23_forfalsket_princip = AktieavancePar23PrincipResultat(
    input = abl_inv_par23_19b_princip.input,
    input_gyldig = abl_inv_par23_19b_princip.input_gyldig,
    princip = abl_inv_par23_19b_princip.princip,
    grundlag = AblPar23Stk1Grundlag,
    valganmodning_gyldig = abl_inv_par23_19b_princip.valganmodning_gyldig,
    valg_bindende = abl_inv_par23_19b_princip.valg_bindende,
    opgøres_efter_kalenderår = abl_inv_par23_19b_princip.opgøres_efter_kalenderår
)
= abl_inv_par23_lager_med_forfalsket_princip = aktieavance_par23_lager_årsresultat(AktieavancePar23LagerÅrsinput(
    princip_resultat = abl_inv_par23_forfalsket_princip,
    værdi_primo_kroner = 10000,
    værdi_ultimo_kroner = 12000,
    anskaffelsessummer_i_perioden_kroner = 0,
    afståelsessummer_i_perioden_kroner = 0,
    afståelsessummer_omfattet_af_ll16b_stk1_kroner = 0,
    par17_modprøve = abl_inv_ingen_par17,
