@ sprog da

@ importer ./metadata
@ importer ./ligningsloven-par9-loenmodtagerudgifter
@ importer ./ligningsloven-kontingenter-gaver
@ importer ./pensionsbeskatningsloven-par49-49b

= personskat_ll13_felt_periode_fra_år = Beregningsfelt(path = refof(Ligningslov13Årsinput::kontingenter::periode::fra_dato::år), label = "Kontingentperiodens startdato (ISO 8601) - år", question = Some("I hvilket år begyndte den periode, som kontingentbetalingen dækker?"), help = None, unit = Some("år"))
= personskat_ll13_felt_periode_fra_måned = Beregningsfelt(path = refof(Ligningslov13Årsinput::kontingenter::periode::fra_dato::måned), label = "Kontingentperiodens startdato (ISO 8601) - måned", question = Some("I hvilken måned begyndte den periode, som kontingentbetalingen dækker?"), help = None, unit = Some("måned"))
= personskat_ll13_felt_periode_fra_dag = Beregningsfelt(path = refof(Ligningslov13Årsinput::kontingenter::periode::fra_dato::dag), label = "Kontingentperiodens startdato (ISO 8601) - dag", question = Some("På hvilken dag begyndte den periode, som kontingentbetalingen dækker?"), help = None, unit = Some("dag"))
= personskat_ll13_felt_periode_til_år = Beregningsfelt(path = refof(Ligningslov13Årsinput::kontingenter::periode::til_dato::år), label = "Kontingentperiodens slutdato (ISO 8601) - år", question = Some("I hvilket år sluttede den periode, som kontingentbetalingen dækker?"), help = None, unit = Some("år"))
= personskat_ll13_felt_periode_til_måned = Beregningsfelt(path = refof(Ligningslov13Årsinput::kontingenter::periode::til_dato::måned), label = "Kontingentperiodens slutdato (ISO 8601) - måned", question = Some("I hvilken måned sluttede den periode, som kontingentbetalingen dækker?"), help = None, unit = Some("måned"))
= personskat_ll13_felt_periode_til_dag = Beregningsfelt(path = refof(Ligningslov13Årsinput::kontingenter::periode::til_dato::dag), label = "Kontingentperiodens slutdato (ISO 8601) - dag", question = Some("På hvilken dag sluttede den periode, som kontingentbetalingen dækker?"), help = None, unit = Some("dag"))

= personskat_ll13_beregningsmeta = Beregningsmeta(
    felter = [
        personskat_ll13_felt_periode_fra_år,
        personskat_ll13_felt_periode_fra_måned,
        personskat_ll13_felt_periode_fra_dag,
        personskat_ll13_felt_periode_til_år,
        personskat_ll13_felt_periode_til_måned,
        personskat_ll13_felt_periode_til_dag
    ],
    attachments = (
        Source(value = ligningsloven_lbk1500_par13),
        Guidance(value = skat_fagforening_akasse_vejledning),
        Guidance(value = juridisk_vejledning_ligningslov13),
    )
)

@ meta(personskat_ll13_beregningsmeta) for Ligningslov13Årsinput
