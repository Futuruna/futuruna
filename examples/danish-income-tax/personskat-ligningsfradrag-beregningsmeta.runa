@ sprog da

@ importer ./metadata
@ importer ./ligningsloven - par9 - loenmodtagerudgifter
@ importer ./ligningsloven - kontingenter - gaver
@ importer ./pensionsbeskatningsloven - par49 - 49b

= personskat_ll9_stk1_felt_skatteyderstatus = TypetBeregningsfelt(
    path = refof(Ligningslov9Stk1Årsinput::skatteyderstatus::$variant),
    label = "Status for øvrige lønmodtagerudgifter",
    question = Some("Er personen lønmodtager for de oplyste udgifter?"),
    help = Some("Fradraget efter ligningslovens § 9, stk. 1, vedrører lønmodtagerens udgifter til det indtægtsgivende arbejde."),
    unit = None
)
= personskat_ll9_stk1_felt_udgifter = TypetBeregningsfelt(
    path = refof(Ligningslov9Stk1Årsinput::udgifter),
    label = "Øvrige lønmodtagerudgifter",
    question = Some("Hvilke dokumenterede udgifter havde personen i forbindelse med udførelsen af det indtægtsgivende arbejde?"),
    help = Some("Opret én række pr. udgift og pr. arbejdsforhold. Befordring efter § 9 B eller statsskattelovens § 6, litra a, skal ikke oplyses her."),
    unit = None
)
= personskat_ll9_stk1_felt_identifikation = TypetBeregningsfelt(
    path = refof(Ligningslov9Stk1Årsinput::udgifter::identifikation),
    label = "Lønmodtagerudgiftens identifikation",
    question = Some("Hvilken entydig identifikation har udgiften?"),
    help = Some("Brug en stabil bilags- eller postreference, så udgiften kan knyttes til det rette arbejdsforhold og ikke medregnes to gange."),
    unit = None
)
= personskat_ll9_stk1_felt_indkomstår = TypetBeregningsfelt(
    path = refof(Ligningslov9Stk1Årsinput::udgifter::indkomstår),
    label = "Lønmodtagerudgiftens indkomstår",
    question = Some("Hvilket indkomstår vedrører udgiften?"),
