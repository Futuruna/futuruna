    ))))
)
| psl3_erhvervspost_scenarie_al10(indkomstår: Heltal, anskaffelsessum_kroner: Heltal) -> psl3_erhvervspost_scenarie_fakta(
    "afskrivningslov-10-2026",
    PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Driftsmiddel(kilde = PsPar3Nr10Al5(input = Afskrivningslov5Input(
        indkomstår = 2026,
        aktivgrundlag = Al5Par10DokEllerBedding(input = Afskrivningslov10Input(
            indkomstår = indkomstår,
            skatteyder = AlSelvstændigErhvervsdrivendePerson,
            aktivart = Al10DokAnlæg,
            beregnet_til_bygning_og_reparation_af_skibe = Sandt,
            erhvervsmæssig_anvendelsesandel_basispoint = 10000,
            samlet_anskaffelsessum_i_indkomståret_kroner = anskaffelsessum_kroner,
