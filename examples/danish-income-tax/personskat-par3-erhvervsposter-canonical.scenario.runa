        )),
        saldoordning = AlPar5AlmindeligSaldo,
        saldoværdi_primo_kroner = 0,
        øvrige_anskaffelsessummer_i_året_kroner = 0,
        forbedringsudgifter_i_året_kroner = 0,
        salgssummer_i_året_kroner = 0,
        valg = Al5OrdinærAfskrivning(sats_basispoint = 2500)
    ))))
)
| psl3_erhvervspost_scenarie_al33_aktiv() -> AfskrivningslovPar1Par2Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    aktivart = AlSkib,
    erhvervsmæssig_anvendelsesandel_basispoint = 10000
)
| psl3_erhvervspost_scenarie_al33_aftale() -> AfskrivningslovForskudsAftale(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    aktiv_input = psl3_erhvervspost_scenarie_al33_aktiv(),
    saldoart = Al28Par5Saldo,
    aftaleform = Al28BindendeSkibsbygningsaftale,
    bestillings_eller_planlægningsdato = AfskrivningslovDato(år = 2023, måned = 1, dag = 15),
    virksomhedsidentifikation = "Rederiet-2023",
    planlagte_aktiver = [
        AfskrivningslovForskudsPlanlagtAktiv(identifikation = "skib-2026-a", planlagt_leverings_eller_færdiggørelsesår = 2026, aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_kroner = 2000000),
        AfskrivningslovForskudsPlanlagtAktiv(identifikation = "skib-2026-b", planlagt_leverings_eller_færdiggørelsesår = 2026, aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_kroner = 1000000),
    ],
    selskab_omfattet_af_selskabsskattelov1_stk1_nr1_2_eller_4 = Falskt,
    aktiver_erhverves_med_henblik_på_udlejning_eller_er_udlejet = Falskt,
    tilladelse_efter_par5_stk6 = Falskt
)
| psl3_erhvervspost_scenarie_al33_startposition() -> AfskrivningslovForskudsPosition(
    aftale = psl3_erhvervspost_scenarie_al33_aftale(),
    årsposter = [],
    anskaffelser = []
)
| psl3_erhvervspost_scenarie_al33_år(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> afskrivningslov32_årsresultat(Afskrivningslov32ÅrsInput(
    position = position,
    indkomstår = indkomstår,
    nye_anskaffelser = [],
    valgt_forskudsafskrivningssats_basispoint = 1000
))
= psl3_erhvervspost_scenarie_al33_2023 = psl3_erhvervspost_scenarie_al33_år(psl3_erhvervspost_scenarie_al33_startposition(), 2023)
= psl3_erhvervspost_scenarie_al33_2024 = psl3_erhvervspost_scenarie_al33_år(psl3_erhvervspost_scenarie_al33_2023.position_efter, 2024)
= psl3_erhvervspost_scenarie_al33_2025 = psl3_erhvervspost_scenarie_al33_år(psl3_erhvervspost_scenarie_al33_2024.position_efter, 2025)
| psl3_erhvervspost_scenarie_al33_anskaffelse(identifikation: Tekst, indkomstår: Heltal, anskaffelsessum_kroner: Heltal, forlods_afskrivning_kroner: Heltal) -> AfskrivningslovForskudsAnskaffelse(
    identifikation = identifikation,
    par3_input = Afskrivningslov3Input(
        anskaffelsesdato = AfskrivningslovDato(år = indkomstår, måned = 6, dag = 30),
        leveret_til_igangværende_virksomhed = Sandt,
        bestemt_til_virksomhedens_drift = Sandt,
        færdiggjort_til_at_indgå_i_driften = Sandt
    ),
    faktisk_anskaffelsessum_for_skatteyder_kroner = anskaffelsessum_kroner,
    forlods_afskrivning_efter_etableringskontoloven_kroner = forlods_afskrivning_kroner
)
| psl3_erhvervspost_scenarie_al33_input(andet_anskaffelsesår: Heltal) -> Afskrivningslov33Input(
    position_før_anskaffelser = psl3_erhvervspost_scenarie_al33_2025.position_efter,
    anskaffelser_i_indkomståret = [
        psl3_erhvervspost_scenarie_al33_anskaffelse("skib-2026-a", 2026, 2000000, 100000),
        psl3_erhvervspost_scenarie_al33_anskaffelse("skib-2026-b", andet_anskaffelsesår, 1000000, 0),
    ]
)
| psl3_erhvervspost_scenarie_al33_til_al5(indkomstår: Heltal, andet_anskaffelsesår: Heltal) -> psl3_erhvervspost_scenarie_fakta(
    "afskrivningslov-33-til-5-2026",
    PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Driftsmiddel(kilde = PsPar3Nr10Al5(input = Afskrivningslov5Input(
        indkomstår = indkomstår,
        aktivgrundlag = Al5Par33ForskudsafskrevneAktiver(input = psl3_erhvervspost_scenarie_al33_input(andet_anskaffelsesår)),
        saldoordning = AlPar5AlmindeligSaldo,
        saldoværdi_primo_kroner = 0,
        øvrige_anskaffelsessummer_i_året_kroner = 85950,
        forbedringsudgifter_i_året_kroner = 0,
        salgssummer_i_året_kroner = 0,
        valg = Al5OrdinærAfskrivning(sats_basispoint = 2500)
    ))))
)
| psl3_erhvervspost_scenarie_al19_bygning() -> Afskrivningslov14Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    anvendelse = Al14AndenErhvervsanvendelse,
    erhvervsmæssigt_benyttet = Sandt,
    postsortering_med_industrielt_præg = Falskt,
    tilknytning = Al14IkkeTilknyttet,
    tilknyttet_art = Al14BygningEllerLokale
)
| psl3_erhvervspost_scenarie_al19_historik(tidligere_år: Heltal) -> [
    Afskrivningslov19Interval(fra_kroner = 0, til_kroner = 500000, afskrivningsberettiget_forrige_indkomstår = Sandt, afskrivningsberettiget_i_indkomståret = Sandt, afskrivningsberettigede_indkomstår = tidligere_år, anvendt_afskrivningsprocent_basispoint = tidligere_år * 300, maksimalt_mulig_afskrivningsprocent_basispoint = tidligere_år * 300),
    Afskrivningslov19Interval(fra_kroner = 500000, til_kroner = 1000000, afskrivningsberettiget_forrige_indkomstår = Falskt, afskrivningsberettiget_i_indkomståret = Falskt, afskrivningsberettigede_indkomstår = 0, anvendt_afskrivningsprocent_basispoint = 0, maksimalt_mulig_afskrivningsprocent_basispoint = 0),
]
| psl3_erhvervspost_scenarie_al19_input(indkomstår: Heltal, afskrivningsberettiget_etageareal_kvadratmeter: Heltal, valg: List(Afskrivningslov17Par19Valg)) -> Afskrivningslov17Par19Input(
    indkomstår = indkomstår,
    par16_input = Afskrivningslov16Input(
        aktiv_identifikation = "hotel",
        aktiv = AlK3Bygning(input = psl3_erhvervspost_scenarie_al19_bygning()),
        hændelse = Al16Anskaffelse,
        indkomstår = 2023,
        erhvervet_eller_opført = Sandt,
        udgift_afholdt = Falskt,
        benyttes_erhvervsmæssigt = Sandt
    ),
    par19_input = Afskrivningslov19Input(
        aktiv_identifikation = "hotel",
        ejerbolig_identifikation = None,
        bygning_input = psl3_erhvervspost_scenarie_al19_bygning(),
        anskaffelsessum = Al19OplystAnskaffelsessum(samlet_anskaffelsessum_kroner = 1000000, ejerbolig_anskaffelsessum_kroner = 0),
        samlet_etageareal_kvadratmeter = 1000,
        afskrivningsberettiget_etageareal_kvadratmeter = afskrivningsberettiget_etageareal_kvadratmeter,
        ejerbolig_etageareal_kvadratmeter = 0,
        tidligere_afskrivningsberettigede_indkomstår_for_bygningen = indkomstår - 2023,
        tidligere_intervaller = psl3_erhvervspost_scenarie_al19_historik(indkomstår - 2023)
    ),
    par20_input = Afskrivningslov20Input(
        indkomstår = indkomstår,
        aktiv = AlK3Bygning(input = psl3_erhvervspost_scenarie_al19_bygning()),
        begivenhed = Al20FortsatErhvervsmæssigAnvendelse,
        erhvervsmæssigt_anvendt_i_indkomståret = Sandt
    ),
    antaget_levetid_år = 0,
    accessorisk_hovedbygning = Al17IngenAccessoriskHovedbygning,
    valg = valg
)
| psl3_erhvervspost_scenarie_al19(indkomstår: Heltal, afskrivningsberettiget_etageareal_kvadratmeter: Heltal, valg: List(Afskrivningslov17Par19Valg)) -> psl3_erhvervspost_scenarie_fakta(
    "afskrivningslov-17-19-2026",
    PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Bygning(kilde = PsPar3Nr10Al17Par19(input = psl3_erhvervspost_scenarie_al19_input(indkomstår, afskrivningsberettiget_etageareal_kvadratmeter, valg))))
)
| psl3_erhvervspost_scenarie_al44c_fortjeneste() -> psl3_erhvervspost_scenarie_fakta(
    "afskrivningslov-44c-2026",
    PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Særregel(kilde = PsPar3Nr10Al44C(input = Afskrivningslov44CInput(
        indkomstår = 2026,
        skatteyder = AlSelvstændigErhvervsdrivendePerson,
        genstand = Al44CRetEfterLeveringskontrakt,
        skib_eller_andet_driftsmiddel = Sandt,
        helt_eller_delvist_erhvervsmæssigt_bestemt = Sandt,
        kan_afskrives_efter_kapitel2_når_betingelserne_er_opfyldt = Sandt,
        sælges_eller_opgives_i_indkomståret = Sandt,
        leveret_til_igangværende_virksomhed = Falskt,
        bestemt_til_at_indgå_i_virksomhedens_drift = Sandt,
        færdiggjort_til_at_indgå_i_driften = Falskt,
        afståelsessum_kroner = 120000,
        anskaffelsessum_kroner = 100000,
        forbedringsudgifter_kroner = 0,
        forskudsafskrivninger_kroner = 0
    ))))
)

| psl3_erhvervspost_scenarie_alle() -> [
    psl3_erhvervspost_scenarie_husdyr(),
    psl3_erhvervspost_scenarie_varelager(),
    psl3_erhvervspost_scenarie_henlæggelse(),
    psl3_erhvervspost_scenarie_tilbagebetaling(2026),
    psl3_erhvervspost_scenarie_sl6_afskrivning(),
    psl3_erhvervspost_scenarie_al44c_fortjeneste(),
]
| psl3_erhvervspost_scenarie_virksomhed(poster: List(PersonskatPar3Erhvervspostfakta)) -> PersonskatOrdinærVirksomhedFakta(
    identifikation = "psl3-erhvervsposter-virksomhed",
    indkomstår = 2026,
    indtægter = [PersonskatVirksomhedsindtægtFakta(
        identifikation = "psl3-erhvervsposter-omsætning",
        art = OrdinærDriftsindtægt,
        beløb_kroner = 500000
    )],
    udgifter = [],
    ligningslovsfradrag_efter_par3_stk2_nr2 = [],
    erhvervsposter_efter_par3_stk2_nr4_til_10 = poster
)
| psl3_erhvervspost_scenarie_personlig_indkomst(poster: List(PersonskatPar3Erhvervspostfakta)) -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = [],
        personlige_arbejdsvederlag = [],
        virksomheder_uden_virksomhedsordning = [psl3_erhvervspost_scenarie_virksomhed(poster)],
        forenings_og_arbejdsløshedsydelser = []
    ),
    arbejdsudleje = [],
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| psl3_erhvervspost_scenarie_input(poster: List(PersonskatPar3Erhvervspostfakta)) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 0,
        personlig_indkomst = psl3_erhvervspost_scenarie_personlig_indkomst(poster),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| psl3_erhvervspost_scenarie_beregning(poster: List(PersonskatPar3Erhvervspostfakta)) -> beregn_personskat(psl3_erhvervspost_scenarie_input(poster))
| psl3_erhvervspost_scenarie_virksomhedsberegning(resultat: PersonskatBeregningResultat) -> match head(resultat.personlig_indkomst.ordinære_forhold.virksomheder_uden_virksomhedsordning) {
    | BeregnetOrdinærVirksomhed(beregning) -> Some(beregning)
    | _ -> None
}
| psl3_erhvervspost_scenarie_resultatantal(resultat: PersonskatBeregningResultat) -> match psl3_erhvervspost_scenarie_virksomhedsberegning(resultat) {
    | Some(beregning) -> length(beregning.par3_erhvervspost_resultater)
    | None -> 0
}
