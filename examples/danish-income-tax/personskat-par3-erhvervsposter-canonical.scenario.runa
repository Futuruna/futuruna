@ sprog da

@ importer ./personskat.calculate

----
Kanoniske scenarier for Personskattelovens § 3, stk. 2, nr. 4-5, 7 og 9-10.

Scenarierne fastholder, at de delegerede lovregler afledes fra typede
kildefakta under en konkret selvstændig virksomhed og når hele
beregn_personskat-kaskaden. Ugyldige relationer må ikke skabe indkomst eller
fradrag.
----

| psl3_erhvervspost_scenarie_fakta(identifikation: Tekst, kilde: PersonskatPar3Erhvervspostkilde) -> PersonskatPar3Erhvervspostfakta(
    identifikation = identifikation,
    indkomstår = 2026,
    kilde = kilde
)

| psl3_erhvervspost_scenarie_husdyr() -> psl3_erhvervspost_scenarie_fakta(
    "husdyr-2026",
    PsPar3Nr4Husdyr(
        par2_input = HusdyrPar2Input(
            indkomstår = 2026,
            skatteyder = HusdyrLandbrugerPerson,
            værdiansættelse = HusdyrNormalhandelsværdi(normalhandelsværdi_kroner = 200000),
            ønsket_nedskrivning_kroner = 50000
        ),
        par8_input = HusdyrPar8Input(
            indkomstår = 2026,
            rettighedshaver = HusdyrPar8Landbruger,
            grupper = [],
            indkomstår1981_forhold = HusdyrPar8IkkeIndkomstår1981
        )
    )
)
| psl3_erhvervspost_scenarie_varelager() -> psl3_erhvervspost_scenarie_fakta(
    "varelager-2026",
    PsPar3Nr5Varelager(input = VarelagerPar1Input(
        indkomstår = 2026,
        skatteyder = VarelagerNæringsdrivendePerson,
        varegrupper = [VarelagerPar1Post(
            art = VarelagerVarer,
            opgørelsesmåde = VarelagerFakturapris(
                indkøbspris_kroner = 100000,
                fragt_told_og_lignende_kroner = 10000
            ),
            fradragsberettiget_indgående_moms_kroner = 10000
        )],
        ønsket_nedskrivning_kroner = 20000
    ))
)
| psl3_erhvervspost_scenarie_oplysningsfrist() -> skattekontrollov_oplysningsfrist_resultat(SkattekontrollovOplysningsfristInput(
    indkomstår = 2026,
    kilde = SkattekontrollovenLbk12Af2024Par10Stk2,
    fristdag_dagen_før_eller_på_lørdag_søndag_helligdag = Falskt,
    førstkommende_hverdag_yyyymmdd = 0,
    handling_yyyymmdd = 20270701
))
| psl3_erhvervspost_scenarie_udligningskonto() -> VirksomhedsskattelovUdligningskontoInput(
    betegnelse = VslIndkomstudligningskonto,
    institution = VslDanskTilladtPengeinstitut,
    kontoform = VslKontantforrentetIndlånskonto,
    navn_påtegnet = Sandt,
    adresse_påtegnet = Sandt,
    personnummer_påtegnet = Sandt,
    virksomhedens_regnskabsår_påtegnet = Sandt,
    henlæggelsesår_påtegnet = Sandt,
    indsat_beløb_kroner = 7800,
    oplysningsfrist_resultat = psl3_erhvervspost_scenarie_oplysningsfrist()
)
| psl3_erhvervspost_scenarie_henlæggelse() -> psl3_erhvervspost_scenarie_fakta(
    "henlæggelse-2026",
    PsPar3Nr7Virksomhedsskattelov22D(input = Virksomhedsskattelov22DHenlæggelseInput(
        indkomstår = 2026,
        anvender_virksomhedsordningen_afsnit1 = Falskt,
        anvender_konjunkturudligningsordningen_par22b = Falskt,
        kunstnerindkomst = Virksomhedsskattelov22DKunstnerindkomstInput(
            litterært_eller_skabende_kunstnerisk_arbejde = Sandt,
            arbejdet_udført_af_skattepligtige = Sandt,
            udført_i_ansættelsesforhold = Falskt,
            indkomst_fra_legat_stipendium_eller_lignende = Falskt,
            indkomst_før_ligningslov7o_lempelse_kroner = 100000,
            ligningslov7o_stk1_nr4_lempelse_kroner = 0
        ),
        skattepligtig_indkomst_før_henlæggelse_kroner = 500000,
        ønsket_henlæggelse_kroner = 10000,
        samlede_tidligere_indskud_på_indkomstudligningskonto_kroner = 0,
        konto = psl3_erhvervspost_scenarie_udligningskonto()
    ))
)
| psl3_erhvervspost_scenarie_tilbagebetaling(indkomstår: Heltal) -> PersonskatPar3Erhvervspostfakta(
    identifikation = "tilbagebetaling-2026",
    indkomstår = 2026,
    kilde = PsPar3Nr9TilbagebetaltOffentligYdelse(input = Ligningslov8OInput(
        indkomstår = indkomstår,
        ydelsesgrundlag = Ll8OLabPar123,
        ydelsen_var_skattepligtig_ved_udbetaling = Sandt,
        oprindeligt_skattepligtigt_bruttobeløb_kroner = 100000,
        tidligere_tilbagebetalt_bruttobeløb_kroner = 0,
        tilbagebetalt_bruttobeløb_i_indkomståret_kroner = 30000,
        samme_beløb_tidligere_fradraget_i_udbetalingsåret = Falskt
    ))
)
| psl3_erhvervspost_scenarie_sl6_afskrivning() -> psl3_erhvervspost_scenarie_fakta(
    "statsskattelov-6a-2026",
    PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Statsskattelov6A(input = Statsskattelov6OrdinærAfskrivningInput(
        skatteyder = Sl6SelvstændigErhvervsdrivendePerson,
        udgift_eller_aktiv_anvendt_til_at_erhverve_sikre_og_vedligeholde_indkomsten = Sandt,
        ikke_omfattet_af_særlig_afskrivningslovgivning = Sandt,
        afskrivningsgrundlag_primo_kroner = 80000,
        dokumenteret_ordinær_værdiforringelse_i_året_kroner = 12000,
        ønsket_ordinær_afskrivning_kroner = 15000
    )))
)
| psl3_erhvervspost_scenarie_al5(sats_basispoint: Heltal) -> psl3_erhvervspost_scenarie_fakta(
    "afskrivningslov-5-2026",
    PsPar3Nr10Afskrivning(kilde = PsPar3Nr10Driftsmiddel(kilde = PsPar3Nr10Al5(input = Afskrivningslov5Input(
        indkomstår = 2026,
        aktivgrundlag = Al5Kapitel2Aktiv(input = AfskrivningslovPar1Par2Input(
            skatteyder = AlSelvstændigErhvervsdrivendePerson,
