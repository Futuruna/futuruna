)
= aktieavance_par9_samtidige_tabsbeholdninger_advarsel = AktieavancebeskatningslovDækningsgrænse(
    område = "Aktieavancebeskatningsloven § 9, stk. 3-6: samtidige tabsbeholdninger",
    beskrivelse = "Loven og LSF 28 beskriver hvert tabs modregningsgrundlag, men angiver ikke en indbyrdes rækkefølge, når både stk. 3-4-tab og stk. 5-6-tab kan rummes i samme realisationsgevinst. Modellen anvender den ældre og snævrere stk. 3-4-beholdning først og bevarer begge saldi særskilt.",
    status = "Fortolkningsvalg kræver administrativ bekræftelse"
)
--@label:aktieavancebeskatningsloven_par9::source:aktieavancebeskatningsloven_lbk1098_par9::dependency_source:aktieavancebeskatningsloven_lbk1098_par5a::amendment_source:aktieavancebeskatningsloven_lov1691_par3_nr6_par9_stk4_og_7::amendment_source:aktieavancebeskatningsloven_lov1755::amendment_source:aktieavancebeskatningsloven_lov615::guidance:aktieavancebeskatningsloven_juridisk_vejledning_par9::guidance:aktieavancebeskatningsloven_juridisk_vejledning_par23a::guidance:aktieavancebeskatningsloven_juridisk_vejledning_par9_par5a::warning:aktieavance_par9_samtidige_tabsbeholdninger_advarsel--
----
§ 9. Gevinst på aktier, der ikke er omfattet af § 8, medregnes ved opgørelsen
af den skattepligtige indkomst, jf. dog § 10.

Stk. 2. Tab på aktier omfattet af stk. 1, hvor den skattepligtige anvender
lagerprincippet, jf. § 23, stk. 5, fradrages ved opgørelsen af den
skattepligtige indkomst, jf. dog stk. 7 og § 10.

Stk. 3. Tab på aktier omfattet af stk. 1, hvor den skattepligtige anvender
realisationsprincippet, jf. § 23, stk. 6, kan fradrages i indkomstårets
gevinster på realisationsbeskattede aktier efter stk. 1, jf. dog stk. 7 og
§ 10.

Stk. 4. Tab, der ikke kan fradrages efter stk. 3, fradrages i de følgende
indkomstårs gevinster på realisationsbeskattede aktier efter stk. 1. Tab kan
kun overføres til fradrag i senere indkomstår, hvis det ikke kan rummes i
nettogevinster på realisationsbeskattede aktier omfattet af stk. 1 i et
tidligere indkomstår. Ved skifte til lagerprincippet kan fremførte tab
fradrages i nettogevinster omfattet af stk. 1.

Stk. 5. Tab på aktier omfattet af stk. 1, hvor den skattepligtige anvender
realisationsprincippet, jf. § 23, stk. 7, kan fradrages i indkomstårets
gevinster efter stk. 1, jf. dog stk. 7 og § 10.

Stk. 6. Tab, der ikke kan fradrages efter stk. 5, fradrages i de følgende
indkomstårs gevinster efter stk. 1. Tab kan kun overføres til fradrag i senere
indkomstår, hvis det ikke kan rummes i nettogevinster omfattet af stk. 1 i et
tidligere indkomstår. Ved skift til lagerprincippet kan fremførte tab fradrages
i nettogevinster omfattet af stk. 1.

Stk. 7. Uanset stk. 2, 3 og 5 kan tab ved afståelse af koncerninterne
konvertible obligationer og tegningsretter til sådanne konvertible obligationer
ikke fradrages ved opgørelsen af den skattepligtige indkomst. Ved
koncerninterne konvertible obligationer forstås obligationer i koncernforbundne
selskaber, jf. selskabsskattelovens § 31 C.
----

--@begin:aktieavancebeskatningsloven_par9--
# AktieavancePar9Aktivstatus = AblPar9SkattepligtigPorteføljeaktie | AblPar9AndenTegningsret | AblPar9AndenKonvertibelObligation | AblPar9AndenTegningsretTilKonvertibelObligation | AblPar9KoncerninternKonvertibelObligation | AblPar9TegningsretTilKoncerninternKonvertibelObligation | AblPar9DatterselskabsaktieEfterPar8 | AblPar9KoncernselskabsaktieEfterPar8 | AblPar9SkattefriPorteføljeaktieEfterPar8 | AblPar9EgenAktieEfterPar10
# AktieavancePar9Opgørelsesgrundlag = AblPar9Lagerårsopgørelse(resultat: AktieavancePar23LagerÅrsresultat) | AblPar9Par23AOpgørelse(princip_resultat: AktieavancePar23PrincipResultat, resultat: AktieavancePar23AResultat) | AblPar9RealiseretAfståelse(princip_resultat: AktieavancePar23PrincipResultat, afståelsessum_kroner: Heltal, anskaffelsessum_kroner: Heltal)
# AktieavancePar9PostInput(aktivstatus: AktieavancePar9Aktivstatus, opgørelsesgrundlag: AktieavancePar9Opgørelsesgrundlag, par5a_behandling: AktieavancePar5ABehandling)
# AktieavancePar9PostResultat(input: AktieavancePar9PostInput, input_gyldigt: Boolsk, omfattet_af_par6: Boolsk, undtaget_efter_par8: Boolsk, undtaget_efter_par10: Boolsk, omfattet_af_stk1: Boolsk, princip: AktieavancePar23Princip, principgrundlag: AktieavancePar23Principgrundlag, bruttogevinst_kroner: Heltal, bruttotab_kroner: Heltal, tabsreduktion_efter_par5a_kroner: Heltal, gevinst_efter_par5a_kroner: Heltal, tab_efter_par5a_kroner: Heltal, skattepligtig_gevinst_kroner: Heltal, direkte_lagerfradrag_efter_stk2_kroner: Heltal, tab_til_modregning_efter_stk3_kroner: Heltal, tab_til_modregning_efter_stk5_kroner: Heltal, tab_afskåret_efter_stk7_kroner: Heltal)
# AktieavancePar9Stk4Tabsanvendelse = AblPar9Stk4KunRealisationsbeskattedeGevinster | AblPar9Stk4AlleGevinsterEfterSkiftTilLagerprincip
# AktieavancePar9Tabsposition(indkomstår: Heltal, fremført_tab_efter_stk4_kroner: Heltal, stk4_tabsanvendelse: AktieavancePar9Stk4Tabsanvendelse, fremført_tab_efter_stk6_kroner: Heltal)
# AktieavancePar9Fremførsel = AblPar9IngenFremførsel | AblPar9FremførselFraForrigeIndkomstår(position: AktieavancePar9Tabsposition)
# AktieavancePar9Principovergang(forrige_princip_resultat: AktieavancePar23PrincipResultat, aktuelle_princip_resultat: AktieavancePar23PrincipResultat)
# AktieavancePar9Årsinput(indkomstår: Heltal, poster: List(AktieavancePar9PostResultat), fremførsel: AktieavancePar9Fremførsel, principovergange: List(AktieavancePar9Principovergang))
# AktieavancePar9Årsresultat(input: AktieavancePar9Årsinput, årsopgørelse_gyldig: Boolsk, stk6_porteføljevalg_sammenhængende: Boolsk, fremførsel_gyldig: Boolsk, afvist_fremført_tab_efter_stk4_kroner: Heltal, afvist_fremført_tab_efter_stk6_kroner: Heltal, skift_fra_stk6_realisation_til_lagerprincip: Boolsk, skift_fra_stk7_realisation_til_lagerprincip: Boolsk, bruttotab_før_par5a_kroner: Heltal, tabsreduktion_efter_par5a_kroner: Heltal, skattepligtige_gevinster_efter_stk1_kroner: Heltal, realisationsbeskattede_gevinster_efter_stk1_kroner: Heltal, direkte_lagerfradrag_efter_stk2_kroner: Heltal, årets_tab_efter_stk3_kroner: Heltal, tilgængeligt_tab_efter_stk4_kroner: Heltal, tab_modregnet_efter_stk3_og_stk4_kroner: Heltal, tab_fremført_efter_stk4_kroner: Heltal, stk4_tabsanvendelse_ultimo: AktieavancePar9Stk4Tabsanvendelse, årets_tab_efter_stk5_kroner: Heltal, tilgængeligt_tab_efter_stk6_kroner: Heltal, tab_modregnet_efter_stk5_og_stk6_kroner: Heltal, tab_fremført_efter_stk6_kroner: Heltal, tab_afskåret_efter_stk7_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal, netto_efter_par9_kroner: Heltal, position_ultimo: AktieavancePar9Tabsposition, aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat)

| aktieavance_par9_aktivstatus_undtaget_efter_par8(status: AktieavancePar9Aktivstatus) -> status == AblPar9DatterselskabsaktieEfterPar8 || status == AblPar9KoncernselskabsaktieEfterPar8 || status == AblPar9SkattefriPorteføljeaktieEfterPar8
| aktieavance_par9_aktivstatus_undtaget_efter_par10(status: AktieavancePar9Aktivstatus) -> status == AblPar9EgenAktieEfterPar10
| aktieavance_par9_aktivstatus_koncernintern_konvertibel(status: AktieavancePar9Aktivstatus) -> status == AblPar9KoncerninternKonvertibelObligation || status == AblPar9TegningsretTilKoncerninternKonvertibelObligation
| aktieavance_par9_aktivstatus_omfattet_af_stk1(status: AktieavancePar9Aktivstatus) -> aktieavance_par9_aktivstatus_undtaget_efter_par8(status) == Falskt && aktieavance_par9_aktivstatus_undtaget_efter_par10(status) == Falskt
| aktieavance_par9_princip_resultat(grundlag: AktieavancePar9Opgørelsesgrundlag) -> match grundlag { | AblPar9Lagerårsopgørelse(resultat) -> resultat.input.princip_resultat | AblPar9Par23AOpgørelse(princip_resultat, _) -> princip_resultat | AblPar9RealiseretAfståelse(princip_resultat, _, _) -> princip_resultat }
| aktieavance_par9_aktivstatus_matcher_principaktiv(status: AktieavancePar9Aktivstatus, aktiv: AktieavancePar23Aktiv) -> match status { | AblPar9SkattepligtigPorteføljeaktie -> match aktiv { | AblPar9Aktie(_, _) -> Sandt | _ -> Falskt } | AblPar9AndenTegningsret -> match aktiv { | AblPar9Tegningsret(_) -> Sandt | _ -> Falskt } | AblPar9AndenKonvertibelObligation -> match aktiv { | AblPar9KonvertibelObligation(_) -> Sandt | _ -> Falskt } | AblPar9AndenTegningsretTilKonvertibelObligation -> match aktiv { | AblPar9TegningsretTilKonvertibelObligation(_) -> Sandt | _ -> Falskt } | AblPar9KoncerninternKonvertibelObligation -> aktiv == AblPar23AKoncerninternKonvertibelObligation | AblPar9TegningsretTilKoncerninternKonvertibelObligation -> aktiv == AblPar23ATegningsretTilKoncerninternKonvertibelObligation | _ -> aktiv == AblAndenAktieEfterPar23 }
| aktieavance_par9_opgørelsesgrundlag_gyldigt(grundlag: AktieavancePar9Opgørelsesgrundlag) -> match grundlag { | AblPar9Lagerårsopgørelse(resultat) -> aktieavance_par23_lager_årsresultat_gyldigt(resultat) && resultat.opgørelse_gyldig && resultat.input.princip_resultat.princip == AblPar23Lagerprincip | AblPar9Par23AOpgørelse(princip_resultat, resultat) -> aktieavance_par23_princip_resultat_gyldigt(princip_resultat) && princip_resultat.input_gyldig && princip_resultat.valganmodning_gyldig && princip_resultat.princip == AblPar23Lagerprincip && princip_resultat.grundlag == AblPar23AGrundlag && aktieavance_par23a_resultat_gyldigt(resultat) && resultat.opgørelse_gyldig | AblPar9RealiseretAfståelse(princip_resultat, afståelsessum_kroner, anskaffelsessum_kroner) -> aktieavance_par23_princip_resultat_gyldigt(princip_resultat) && princip_resultat.input_gyldig && princip_resultat.valganmodning_gyldig && princip_resultat.princip == AblPar23Realisationsprincip && afståelsessum_kroner >= 0 && anskaffelsessum_kroner >= 0 }
| aktieavance_par9_bruttogevinst_kroner(grundlag: AktieavancePar9Opgørelsesgrundlag) -> match grundlag { | AblPar9Lagerårsopgørelse(resultat) -> resultat.bruttogevinst_kroner | AblPar9Par23AOpgørelse(_, resultat) -> resultat.bruttogevinst_kroner | AblPar9RealiseretAfståelse(_, afståelsessum_kroner, anskaffelsessum_kroner) -> penge_positivt_beløb(afståelsessum_kroner - anskaffelsessum_kroner) }
| aktieavance_par9_bruttotab_kroner(grundlag: AktieavancePar9Opgørelsesgrundlag) -> match grundlag { | AblPar9Lagerårsopgørelse(resultat) -> resultat.bruttotab_kroner | AblPar9Par23AOpgørelse(_, resultat) -> resultat.bruttotab_kroner | AblPar9RealiseretAfståelse(_, afståelsessum_kroner, anskaffelsessum_kroner) -> penge_positivt_beløb(anskaffelsessum_kroner - afståelsessum_kroner) }
| aktieavance_par9_opgørelsesgrundlag_er_afståelse(grundlag: AktieavancePar9Opgørelsesgrundlag) -> match grundlag { | AblPar9Lagerårsopgørelse(_) -> Falskt | AblPar9Par23AOpgørelse(_, resultat) -> match resultat.input.hændelse { | AblPar23ABeholdesVedÅretsSlutning(_) -> Falskt | AblPar23AAfståsIÅret(_) -> Sandt } | AblPar9RealiseretAfståelse(_, _, _) -> Sandt }
| aktieavance_par9_par5a_resultat_gyldigt(resultat: AktieavancePar5AResultat) -> aktieavance_par5a_resultat_gyldigt(resultat) && resultat.input.anvendelsesgrundlag != AblPar5AUndtagetEfterPar22Stk6
| aktieavance_par9_par5a_lagerresultat_matcher(afståelse: AktieavancePar23LagerAfståelse, lagerresultat: AktieavancePar5ALagerafståelsesresultat) -> afståelse.afståelsesidentifikation == lagerresultat.afståelsesidentifikation && lagerresultat.resultat.input.bruttotab_ved_afståelse_kroner == aktieavance_par23_lager_afståelse_bruttotab_kroner(afståelse)
| aktieavance_par9_par5a_matchende_lagerresultater(afståelse: AktieavancePar23LagerAfståelse, resultater: List(AktieavancePar5ALagerafståelsesresultat)) -> length(filter(resultater, |lagerresultat: AktieavancePar5ALagerafståelsesresultat| aktieavance_par9_par5a_lagerresultat_matcher(afståelse, lagerresultat)))
| aktieavance_par9_par5a_lagerresultater_gyldige(resultater: List(AktieavancePar5ALagerafståelsesresultat)) -> aktieavance_par5a_lagerresultater_gyldige(resultater) && all(resultater, |lagerresultat: AktieavancePar5ALagerafståelsesresultat| aktieavance_par9_par5a_resultat_gyldigt(lagerresultat.resultat))
| aktieavance_par9_par5a_lagerafståelse_kræver_behandling(afståelse: AktieavancePar23LagerAfståelse) -> afståelse.omfattet_af_ll16b_stk1 == Falskt && aktieavance_par23_lager_afståelse_bruttotab_kroner(afståelse) > 0
| aktieavance_par9_par5a_lagerresultat_matcher_afståelser(lagerresultat: AktieavancePar5ALagerafståelsesresultat, afståelser: List(AktieavancePar23LagerAfståelse)) -> length(filter(afståelser, |afståelse: AktieavancePar23LagerAfståelse| aktieavance_par9_par5a_lagerafståelse_kræver_behandling(afståelse) && aktieavance_par9_par5a_lagerresultat_matcher(afståelse, lagerresultat))) == 1
| aktieavance_par9_par5a_lagerbehandling_komplet(årsresultat: AktieavancePar23LagerÅrsresultat, resultater: List(AktieavancePar5ALagerafståelsesresultat)) -> aktieavance_par9_par5a_lagerresultater_gyldige(resultater) && all(årsresultat.input.afståelser_i_perioden, |afståelse: AktieavancePar23LagerAfståelse| hvis aktieavance_par9_par5a_lagerafståelse_kræver_behandling(afståelse) { aktieavance_par9_par5a_matchende_lagerresultater(afståelse, resultater) == 1 } ellers { aktieavance_par9_par5a_matchende_lagerresultater(afståelse, resultater) == 0 }) && all(resultater, |lagerresultat: AktieavancePar5ALagerafståelsesresultat| aktieavance_par9_par5a_lagerresultat_matcher_afståelser(lagerresultat, årsresultat.input.afståelser_i_perioden))
| aktieavance_par9_par5a_behandling_matcher(grundlag: AktieavancePar9Opgørelsesgrundlag, behandling: AktieavancePar5ABehandling) -> match grundlag {
    | AblPar9Lagerårsopgørelse(årsresultat) -> match behandling { | AblPar5ALagerafståelser(resultater) -> aktieavance_par9_par5a_lagerbehandling_komplet(årsresultat, resultater) | _ -> Falskt }
    | AblPar9Par23AOpgørelse(_, resultat) -> match resultat.input.hændelse {
        | AblPar23ABeholdesVedÅretsSlutning(_) -> match behandling { | AblPar5AUdenAfståelsestab -> Sandt | _ -> Falskt }
        | AblPar23AAfståsIÅret(_) -> match behandling { | AblPar5AEnkeltAfståelse(par5a_resultat) -> aktieavance_par9_par5a_resultat_gyldigt(par5a_resultat) && par5a_resultat.input.bruttotab_ved_afståelse_kroner == aktieavance_par9_bruttotab_kroner(grundlag) | _ -> Falskt }
    }
    | AblPar9RealiseretAfståelse(_, _, _) -> match behandling { | AblPar5AEnkeltAfståelse(resultat) -> aktieavance_par9_par5a_resultat_gyldigt(resultat) && resultat.input.bruttotab_ved_afståelse_kroner == aktieavance_par9_bruttotab_kroner(grundlag) | _ -> Falskt }
}

# AktieavancePar9PostSag(input: AktieavancePar9PostInput) {
    | princip_resultat() -> aktieavance_par9_princip_resultat(input.opgørelsesgrundlag)
    | omfattet_af_par6() -> aktieavance_par23_er_skattepligtig_efter_par6(princip_resultat().input.skattepligtsresultat)
    | undtaget_efter_par8() -> aktieavance_par9_aktivstatus_undtaget_efter_par8(input.aktivstatus)
    | undtaget_efter_par10() -> aktieavance_par9_aktivstatus_undtaget_efter_par10(input.aktivstatus)
    | status_omfattet_af_stk1() -> aktieavance_par9_aktivstatus_omfattet_af_stk1(input.aktivstatus)
    | princip_gyldigt_for_stk1() -> princip_resultat().princip == AblPar23Lagerprincip || princip_resultat().grundlag == AblPar23Stk6ValgtRealisation || princip_resultat().grundlag == AblPar23Stk7SyvårigtRealisationsvalg
    | input_gyldigt() -> princip_resultat().input_gyldig && princip_resultat().valganmodning_gyldig && aktieavance_par9_opgørelsesgrundlag_gyldigt(input.opgørelsesgrundlag) && aktieavance_par9_aktivstatus_matcher_principaktiv(input.aktivstatus, princip_resultat().input.aktiv) && aktieavance_par9_par5a_behandling_matcher(input.opgørelsesgrundlag, input.par5a_behandling) && hvis omfattet_af_par6() && status_omfattet_af_stk1() { princip_gyldigt_for_stk1() } ellers { Sandt }
    | omfattet_af_stk1() -> input_gyldigt() && omfattet_af_par6() && status_omfattet_af_stk1()
    | bruttogevinst_kroner() -> hvis input_gyldigt() { aktieavance_par9_bruttogevinst_kroner(input.opgørelsesgrundlag) } ellers { 0 }
    | bruttotab_kroner() -> hvis input_gyldigt() { aktieavance_par9_bruttotab_kroner(input.opgørelsesgrundlag) } ellers { 0 }
    | tabsreduktion_efter_par5a_kroner() -> hvis input_gyldigt() { aktieavance_par5a_behandling_tabsreduktion_kroner(input.par5a_behandling) } ellers { 0 }
    | netto_efter_par5a_kroner() -> bruttogevinst_kroner() - bruttotab_kroner() + tabsreduktion_efter_par5a_kroner()
    | gevinst_efter_par5a_kroner() -> penge_positivt_beløb(netto_efter_par5a_kroner())
    | tab_efter_par5a_kroner() -> penge_positivt_beløb(0 - netto_efter_par5a_kroner())
    | tab_afskåret_efter_stk7() -> omfattet_af_stk1() && aktieavance_par9_aktivstatus_koncernintern_konvertibel(input.aktivstatus) && aktieavance_par9_opgørelsesgrundlag_er_afståelse(input.opgørelsesgrundlag) && tab_efter_par5a_kroner() > 0
    | skattepligtig_gevinst_kroner() -> hvis omfattet_af_stk1() { gevinst_efter_par5a_kroner() } ellers { 0 }
    | direkte_lagerfradrag_efter_stk2_kroner() -> hvis omfattet_af_stk1() && princip_resultat().princip == AblPar23Lagerprincip && tab_afskåret_efter_stk7() == Falskt { tab_efter_par5a_kroner() } ellers { 0 }
    | tab_til_modregning_efter_stk3_kroner() -> hvis omfattet_af_stk1() && princip_resultat().grundlag == AblPar23Stk6ValgtRealisation && tab_afskåret_efter_stk7() == Falskt { tab_efter_par5a_kroner() } ellers { 0 }
    | tab_til_modregning_efter_stk5_kroner() -> hvis omfattet_af_stk1() && princip_resultat().grundlag == AblPar23Stk7SyvårigtRealisationsvalg && tab_afskåret_efter_stk7() == Falskt { tab_efter_par5a_kroner() } ellers { 0 }
    | tab_afskåret_efter_stk7_kroner() -> hvis tab_afskåret_efter_stk7() { tab_efter_par5a_kroner() } ellers { 0 }
    | resultat() -> AktieavancePar9PostResultat(
        input = input,
        input_gyldigt = input_gyldigt(),
        omfattet_af_par6 = omfattet_af_par6(),
        undtaget_efter_par8 = undtaget_efter_par8(),
        undtaget_efter_par10 = undtaget_efter_par10(),
        omfattet_af_stk1 = omfattet_af_stk1(),
        princip = princip_resultat().princip,
        principgrundlag = princip_resultat().grundlag,
        bruttogevinst_kroner = bruttogevinst_kroner(),
        bruttotab_kroner = bruttotab_kroner(),
        tabsreduktion_efter_par5a_kroner = tabsreduktion_efter_par5a_kroner(),
        gevinst_efter_par5a_kroner = gevinst_efter_par5a_kroner(),
        tab_efter_par5a_kroner = tab_efter_par5a_kroner(),
        skattepligtig_gevinst_kroner = skattepligtig_gevinst_kroner(),
        direkte_lagerfradrag_efter_stk2_kroner = direkte_lagerfradrag_efter_stk2_kroner(),
        tab_til_modregning_efter_stk3_kroner = tab_til_modregning_efter_stk3_kroner(),
        tab_til_modregning_efter_stk5_kroner = tab_til_modregning_efter_stk5_kroner(),
        tab_afskåret_efter_stk7_kroner = tab_afskåret_efter_stk7_kroner()
    )
}

| aktieavance_par9_post_resultat(input: AktieavancePar9PostInput) -> AktieavancePar9PostSag(input).resultat()
| aktieavance_par9_post_resultat_gyldigt(post: AktieavancePar9PostResultat) -> post == aktieavance_par9_post_resultat(post.input)
| aktieavance_par9_post_princip_resultat(post: AktieavancePar9PostResultat) -> aktieavance_par9_princip_resultat(post.input.opgørelsesgrundlag)
| aktieavance_par9_post_matcher_princip_resultat(post: AktieavancePar9PostResultat, princip_resultat: AktieavancePar23PrincipResultat) -> aktieavance_par9_post_princip_resultat(post) == princip_resultat
| aktieavance_par9_post_kan_vælge_stk6_realisation(post: AktieavancePar9PostResultat) -> aktieavance_par23_aktiv_kan_vælge_stk6_realisation(aktieavance_par9_post_princip_resultat(post).input.aktiv)
| aktieavance_par9_post_bruger_stk6_realisation(post: AktieavancePar9PostResultat) -> post.principgrundlag == AblPar23Stk6ValgtRealisation
| aktieavance_par9_principovergang_har_aktuel_post(overgang: AktieavancePar9Principovergang, poster: List(AktieavancePar9PostResultat)) -> foldl(poster, Falskt, |fundet: Boolsk, post: AktieavancePar9PostResultat| fundet || aktieavance_par9_post_matcher_princip_resultat(post, overgang.aktuelle_princip_resultat))
| aktieavance_par9_principovergang_gyldig(overgang: AktieavancePar9Principovergang, indkomstår: Heltal, poster: List(AktieavancePar9PostResultat)) -> overgang.forrige_princip_resultat.input_gyldig && overgang.forrige_princip_resultat.valganmodning_gyldig && overgang.aktuelle_princip_resultat.input_gyldig && overgang.aktuelle_princip_resultat.valganmodning_gyldig && overgang.forrige_princip_resultat.input.indkomstår + 1 == indkomstår && overgang.aktuelle_princip_resultat.input.indkomstår == indkomstår && overgang.forrige_princip_resultat.input.aktiv == overgang.aktuelle_princip_resultat.input.aktiv && aktieavance_par23_er_skattepligtig_efter_par6(overgang.forrige_princip_resultat.input.skattepligtsresultat) && aktieavance_par23_er_skattepligtig_efter_par6(overgang.aktuelle_princip_resultat.input.skattepligtsresultat) && overgang.forrige_princip_resultat.princip == AblPar23Realisationsprincip && overgang.aktuelle_princip_resultat.princip == AblPar23Lagerprincip && (overgang.forrige_princip_resultat.grundlag == AblPar23Stk6ValgtRealisation || overgang.forrige_princip_resultat.grundlag == AblPar23Stk7SyvårigtRealisationsvalg) && aktieavance_par9_principovergang_har_aktuel_post(overgang, poster)
| aktieavance_par9_principovergang_er_fra_stk6(overgang: AktieavancePar9Principovergang) -> overgang.forrige_princip_resultat.grundlag == AblPar23Stk6ValgtRealisation
| aktieavance_par9_principovergang_er_fra_stk7(overgang: AktieavancePar9Principovergang) -> overgang.forrige_princip_resultat.grundlag == AblPar23Stk7SyvårigtRealisationsvalg
| aktieavance_par9_fremført_position(fremførsel: AktieavancePar9Fremførsel, indkomstår: Heltal) -> match fremførsel { | AblPar9IngenFremførsel -> AktieavancePar9Tabsposition(indkomstår = indkomstår - 1, fremført_tab_efter_stk4_kroner = 0, stk4_tabsanvendelse = AblPar9Stk4KunRealisationsbeskattedeGevinster, fremført_tab_efter_stk6_kroner = 0) | AblPar9FremførselFraForrigeIndkomstår(position) -> position }
| aktieavance_par9_fremførsel_gyldig(fremførsel: AktieavancePar9Fremførsel, indkomstår: Heltal) -> match fremførsel { | AblPar9IngenFremførsel -> Sandt | AblPar9FremførselFraForrigeIndkomstår(position) -> position.indkomstår + 1 == indkomstår && position.fremført_tab_efter_stk4_kroner >= 0 && position.fremført_tab_efter_stk6_kroner >= 0 }

# AktieavancePar9Årssag(input: AktieavancePar9Årsinput) {
    | alle_poster_gyldige() -> foldl(input.poster, Sandt, |gyldige: Boolsk, post: AktieavancePar9PostResultat| gyldige && aktieavance_par9_post_resultat_gyldigt(post) && post.input_gyldigt && aktieavance_par9_post_princip_resultat(post).input.indkomstår == input.indkomstår)
    | nogen_post_bruger_stk6_realisation() -> foldl(input.poster, Falskt, |fundet: Boolsk, post: AktieavancePar9PostResultat| fundet || aktieavance_par9_post_bruger_stk6_realisation(post))
    | stk6_porteføljevalg_sammenhængende() -> hvis nogen_post_bruger_stk6_realisation() { foldl(input.poster, Sandt, |sammenhængende: Boolsk, post: AktieavancePar9PostResultat| sammenhængende && hvis aktieavance_par9_post_kan_vælge_stk6_realisation(post) { aktieavance_par9_post_bruger_stk6_realisation(post) } ellers { Sandt }) } ellers { Sandt }
    | alle_principovergange_gyldige() -> foldl(input.principovergange, Sandt, |gyldige: Boolsk, overgang: AktieavancePar9Principovergang| gyldige && aktieavance_par9_principovergang_gyldig(overgang, input.indkomstår, input.poster))
    | årsopgørelse_gyldig() -> input.indkomstår > 0 && alle_poster_gyldige() && stk6_porteføljevalg_sammenhængende() && alle_principovergange_gyldige()
    | position_før() -> aktieavance_par9_fremført_position(input.fremførsel, input.indkomstår)
    | fremførsel_gyldig() -> aktieavance_par9_fremførsel_gyldig(input.fremførsel, input.indkomstår)
    | gyldigt_fremført_tab_efter_stk4_kroner() -> hvis fremførsel_gyldig() { position_før().fremført_tab_efter_stk4_kroner } ellers { 0 }
    | gyldigt_fremført_tab_efter_stk6_kroner() -> hvis fremførsel_gyldig() { position_før().fremført_tab_efter_stk6_kroner } ellers { 0 }
    | afvist_fremført_tab_efter_stk4_kroner() -> hvis fremførsel_gyldig() { 0 } ellers { penge_positivt_beløb(position_før().fremført_tab_efter_stk4_kroner) }
    | afvist_fremført_tab_efter_stk6_kroner() -> hvis fremførsel_gyldig() { 0 } ellers { penge_positivt_beløb(position_før().fremført_tab_efter_stk6_kroner) }
    | skift_fra_stk6_realisation_til_lagerprincip() -> foldl(input.principovergange, Falskt, |fundet: Boolsk, overgang: AktieavancePar9Principovergang| fundet || aktieavance_par9_principovergang_gyldig(overgang, input.indkomstår, input.poster) && aktieavance_par9_principovergang_er_fra_stk6(overgang))
    | skift_fra_stk7_realisation_til_lagerprincip() -> foldl(input.principovergange, Falskt, |fundet: Boolsk, overgang: AktieavancePar9Principovergang| fundet || aktieavance_par9_principovergang_gyldig(overgang, input.indkomstår, input.poster) && aktieavance_par9_principovergang_er_fra_stk7(overgang))
    | bruttotab_før_par5a_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + hvis post.omfattet_af_stk1 { post.bruttotab_kroner } ellers { 0 }) } ellers { 0 }
    | tabsreduktion_efter_par5a_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + hvis post.omfattet_af_stk1 { post.tabsreduktion_efter_par5a_kroner } ellers { 0 }) } ellers { 0 }
    | skattepligtige_gevinster_efter_stk1_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + post.skattepligtig_gevinst_kroner) } ellers { 0 }
    | realisationsbeskattede_gevinster_efter_stk1_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + hvis post.princip == AblPar23Realisationsprincip { post.skattepligtig_gevinst_kroner } ellers { 0 }) } ellers { 0 }
    | direkte_lagerfradrag_efter_stk2_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + post.direkte_lagerfradrag_efter_stk2_kroner) } ellers { 0 }
    | årets_tab_efter_stk3_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + post.tab_til_modregning_efter_stk3_kroner) } ellers { 0 }
    | årets_tab_efter_stk5_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + post.tab_til_modregning_efter_stk5_kroner) } ellers { 0 }
    | tab_afskåret_efter_stk7_kroner() -> hvis årsopgørelse_gyldig() { foldl(input.poster, 0, |sum: Heltal, post: AktieavancePar9PostResultat| sum + post.tab_afskåret_efter_stk7_kroner) } ellers { 0 }
    | stk4_tabsanvendelse_primo() -> hvis fremførsel_gyldig() { position_før().stk4_tabsanvendelse } ellers { AblPar9Stk4KunRealisationsbeskattedeGevinster }
    | stk4_tabsanvendelse_ultimo() -> hvis stk4_tabsanvendelse_primo() == AblPar9Stk4AlleGevinsterEfterSkiftTilLagerprincip || skift_fra_stk6_realisation_til_lagerprincip() { AblPar9Stk4AlleGevinsterEfterSkiftTilLagerprincip } ellers { AblPar9Stk4KunRealisationsbeskattedeGevinster }
    | tilgængeligt_tab_efter_stk4_kroner() -> årets_tab_efter_stk3_kroner() + gyldigt_fremført_tab_efter_stk4_kroner()
    | modregningsgrundlag_efter_stk3_og_stk4_kroner() -> hvis stk4_tabsanvendelse_ultimo() == AblPar9Stk4AlleGevinsterEfterSkiftTilLagerprincip { skattepligtige_gevinster_efter_stk1_kroner() } ellers { realisationsbeskattede_gevinster_efter_stk1_kroner() }
    | tab_modregnet_efter_stk3_og_stk4_kroner() -> penge_mindste_beløb(tilgængeligt_tab_efter_stk4_kroner(), modregningsgrundlag_efter_stk3_og_stk4_kroner())
    | tab_fremført_efter_stk4_kroner() -> tilgængeligt_tab_efter_stk4_kroner() - tab_modregnet_efter_stk3_og_stk4_kroner()
    | gevinst_efter_stk3_og_stk4_kroner() -> skattepligtige_gevinster_efter_stk1_kroner() - tab_modregnet_efter_stk3_og_stk4_kroner()
    | tilgængeligt_tab_efter_stk6_kroner() -> årets_tab_efter_stk5_kroner() + gyldigt_fremført_tab_efter_stk6_kroner()
    | tab_modregnet_efter_stk5_og_stk6_kroner() -> penge_mindste_beløb(tilgængeligt_tab_efter_stk6_kroner(), gevinst_efter_stk3_og_stk4_kroner())
    | tab_fremført_efter_stk6_kroner() -> tilgængeligt_tab_efter_stk6_kroner() - tab_modregnet_efter_stk5_og_stk6_kroner()
    | samlet_fradrag_i_skattepligtig_indkomst_kroner() -> direkte_lagerfradrag_efter_stk2_kroner() + tab_modregnet_efter_stk3_og_stk4_kroner() + tab_modregnet_efter_stk5_og_stk6_kroner()
    | netto_efter_par9_kroner() -> skattepligtige_gevinster_efter_stk1_kroner() - samlet_fradrag_i_skattepligtig_indkomst_kroner()
    | beregnet_position_ultimo() -> AktieavancePar9Tabsposition(
        indkomstår = input.indkomstår,
        fremført_tab_efter_stk4_kroner = tab_fremført_efter_stk4_kroner(),
        stk4_tabsanvendelse = stk4_tabsanvendelse_ultimo(),
        fremført_tab_efter_stk6_kroner = tab_fremført_efter_stk6_kroner()
    )
    | position_ultimo() -> hvis årsopgørelse_gyldig() { beregnet_position_ultimo() } ellers { position_før() }
    | aktieavancebeskatningslov_resultat() -> AktieavancebeskatningslovResultat(
        indkomstår = input.indkomstår,
        effektiv_aktiv = hvis årsopgørelse_gyldig() { AblSkattepligtigPorteføljeaktiePar9 } ellers { AblUdenforDenneSlice },
        bruttogevinst_kroner = skattepligtige_gevinster_efter_stk1_kroner(),
        bruttotab_kroner = bruttotab_før_par5a_kroner(),
        tab_afskåret_kroner = tabsreduktion_efter_par5a_kroner() + tab_afskåret_efter_stk7_kroner(),
        skattepligtig_gevinst_kroner = skattepligtige_gevinster_efter_stk1_kroner(),
        fradragsberettiget_tab_kroner = samlet_fradrag_i_skattepligtig_indkomst_kroner(),
        netto_efter_aktieavancebeskatningsloven_kroner = netto_efter_par9_kroner(),
        medregnes_i_skattepligtig_indkomst = årsopgørelse_gyldig() && (skattepligtige_gevinster_efter_stk1_kroner() > 0 || samlet_fradrag_i_skattepligtig_indkomst_kroner() > 0),
        personskattelov_kategori = AblIkkeMedregnetISlice
    )
    | resultat() -> AktieavancePar9Årsresultat(
        input = input,
        årsopgørelse_gyldig = årsopgørelse_gyldig(),
        stk6_porteføljevalg_sammenhængende = stk6_porteføljevalg_sammenhængende(),
        fremførsel_gyldig = fremførsel_gyldig(),
        afvist_fremført_tab_efter_stk4_kroner = afvist_fremført_tab_efter_stk4_kroner(),
        afvist_fremført_tab_efter_stk6_kroner = afvist_fremført_tab_efter_stk6_kroner(),
        skift_fra_stk6_realisation_til_lagerprincip = skift_fra_stk6_realisation_til_lagerprincip(),
        skift_fra_stk7_realisation_til_lagerprincip = skift_fra_stk7_realisation_til_lagerprincip(),
        bruttotab_før_par5a_kroner = bruttotab_før_par5a_kroner(),
        tabsreduktion_efter_par5a_kroner = tabsreduktion_efter_par5a_kroner(),
        skattepligtige_gevinster_efter_stk1_kroner = skattepligtige_gevinster_efter_stk1_kroner(),
        realisationsbeskattede_gevinster_efter_stk1_kroner = realisationsbeskattede_gevinster_efter_stk1_kroner(),
        direkte_lagerfradrag_efter_stk2_kroner = direkte_lagerfradrag_efter_stk2_kroner(),
        årets_tab_efter_stk3_kroner = årets_tab_efter_stk3_kroner(),
        tilgængeligt_tab_efter_stk4_kroner = tilgængeligt_tab_efter_stk4_kroner(),
        tab_modregnet_efter_stk3_og_stk4_kroner = tab_modregnet_efter_stk3_og_stk4_kroner(),
        tab_fremført_efter_stk4_kroner = tab_fremført_efter_stk4_kroner(),
        stk4_tabsanvendelse_ultimo = stk4_tabsanvendelse_ultimo(),
        årets_tab_efter_stk5_kroner = årets_tab_efter_stk5_kroner(),
        tilgængeligt_tab_efter_stk6_kroner = tilgængeligt_tab_efter_stk6_kroner(),
        tab_modregnet_efter_stk5_og_stk6_kroner = tab_modregnet_efter_stk5_og_stk6_kroner(),
        tab_fremført_efter_stk6_kroner = tab_fremført_efter_stk6_kroner(),
        tab_afskåret_efter_stk7_kroner = tab_afskåret_efter_stk7_kroner(),
        samlet_fradrag_i_skattepligtig_indkomst_kroner = samlet_fradrag_i_skattepligtig_indkomst_kroner(),
        netto_efter_par9_kroner = netto_efter_par9_kroner(),
        position_ultimo = position_ultimo(),
        aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat()
    )
}

| aktieavance_par9_årsresultat(input: AktieavancePar9Årsinput) -> AktieavancePar9Årssag(input).resultat()
--@end:aktieavancebeskatningsloven_par9--
