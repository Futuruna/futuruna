= aktieavancebeskatningsloven_juridisk_vejledning_par23a = AktieavancebeskatningslovKildeInfo(
    url = "https://info.skat.dk/data.aspx?oid=1946354",
    identifier = "Den juridiske vejledning C.B.2.4.3.2: § 23 A begrænser lagerfradrag til tidligere beskattet gevinst",
