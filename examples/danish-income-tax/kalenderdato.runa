@ sprog da

# Dato(år: Heltal, måned: Heltal, dag: Heltal)
# Ugedag = Mandag | Tirsdag | Onsdag | Torsdag | Fredag | Lørdag | Søndag
# Datoperiodegrænser = EfterStartTilOgMedSlut | FraOgMedStartTilFørSlut | FraOgMedBeggeDatoer | UdenBeggeDatoer
# Kalenderdagskonvention = FaktiskeGregorianskeDage | TrediveDagesMåneder
# Årsdagskonvention = FaktiskeDageIReferenceåret | Fast365Dage | Fast360Dage
# Dagtællingspolitik(kalenderdage: Kalenderdagskonvention, periodegrænser: Datoperiodegrænser, årsdage: Årsdagskonvention)
# Dagtællingsresultat(fra_dato: Dato, til_dato: Dato, referenceår: Heltal, politik: Dagtællingspolitik, input_gyldigt: Boolsk, antal_dage: Heltal, årsgrundlag_dage: Heltal)

| dato_ugyldig() -> Dato(år = 0, måned = 0, dag = 0)
| dato_skudår(år: Heltal) -> år > 0 && (år % 400 == 0 || år % 4 == 0 && år % 100 != 0)
| dato_dage_i_år(år: Heltal) -> hvis dato_skudår(år) { 366 } ellers { 365 }
| dato_dage_i_måned(år: Heltal, måned: Heltal) -> match måned {
    | 1 -> 31
    | 2 -> hvis dato_skudår(år) { 29 } ellers { 28 }
    | 3 -> 31
    | 4 -> 30
    | 5 -> 31
    | 6 -> 30
    | 7 -> 31
    | 8 -> 31
    | 9 -> 30
    | 10 -> 31
    | 11 -> 30
    | 12 -> 31
    | _ -> 0
}
| dato_gyldig(dato: Dato) -> dato.år > 0 && dato.måned >= 1 && dato.måned <= 12 && dato.dag >= 1 && dato.dag <= dato_dage_i_måned(dato.år, dato.måned)
| dato_nøgle(dato: Dato) -> dato.år * 10000 + dato.måned * 100 + dato.dag
| dato_før(venstre: Dato, højre: Dato) -> dato_gyldig(venstre) && dato_gyldig(højre) && dato_nøgle(venstre) < dato_nøgle(højre)
| dato_før_eller_lig_med(venstre: Dato, højre: Dato) -> dato_gyldig(venstre) && dato_gyldig(højre) && dato_nøgle(venstre) <= dato_nøgle(højre)
| dato_efter(venstre: Dato, højre: Dato) -> dato_gyldig(venstre) && dato_gyldig(højre) && dato_nøgle(venstre) > dato_nøgle(højre)
| dato_efter_eller_lig_med(venstre: Dato, højre: Dato) -> dato_gyldig(venstre) && dato_gyldig(højre) && dato_nøgle(venstre) >= dato_nøgle(højre)
| dato_mindste_dag(dag: Heltal, højeste_dag: Heltal) -> hvis dag < højeste_dag { dag } ellers { højeste_dag }
| dato_månedsindeks(dato: Dato) -> (dato.år - 1) * 12 + dato.måned - 1
| dato_plus_måneder(dato: Dato, måneder: Heltal) -> {
    = nyt_månedsindeks = dato_månedsindeks(dato) + måneder
    = nyt_år = nyt_månedsindeks / 12 + 1
    = ny_måned = nyt_månedsindeks % 12 + 1
    hvis dato_gyldig(dato) && nyt_månedsindeks >= 0 {
        Dato(
            år = nyt_år,
            måned = ny_måned,
            dag = dato_mindste_dag(dato.dag, dato_dage_i_måned(nyt_år, ny_måned))
        )
    } ellers {
        dato_ugyldig()
    }
}
| dato_plus_år(dato: Dato, år: Heltal) -> dato_plus_måneder(dato, år * 12)
| dato_næste_dag(dato: Dato) -> hvis dato_gyldig(dato) == Falskt {
    dato_ugyldig()
} ellers hvis dato.dag < dato_dage_i_måned(dato.år, dato.måned) {
    Dato(år = dato.år, måned = dato.måned, dag = dato.dag + 1)
} ellers hvis dato.måned < 12 {
    Dato(år = dato.år, måned = dato.måned + 1, dag = 1)
} ellers {
    Dato(år = dato.år + 1, måned = 1, dag = 1)
}
| dato_plus_dage(dato: Dato, dage: Heltal) -> hvis dato_gyldig(dato) == Falskt || dage < 0 {
    dato_ugyldig()
} ellers hvis dage == 0 {
    dato
} ellers {
    dato_plus_dage(dato_næste_dag(dato), dage - 1)
}
| dato_ugedag(dato: Dato) -> hvis dato_gyldig(dato) {
    Some(match (dato_ordinal(dato) - 1) % 7 {
            | 0 -> Mandag
            | 1 -> Tirsdag
            | 2 -> Onsdag
            | 3 -> Torsdag
            | 4 -> Fredag
            | 5 -> Lørdag
            | _ -> Søndag
        })
} ellers {
    None
}
| dato_fristdag_efter_fredag_eller_weekend(dato: Dato) -> match dato_ugedag(dato) {
    | Some(Fredag) -> dato_plus_dage(dato, 3)
    | Some(Lørdag) -> dato_plus_dage(dato, 2)
    | Some(Søndag) -> dato_plus_dage(dato, 1)
    | Some(_) -> dato
    | None -> dato_ugyldig()
}
| dato_månedsstart_dagnummer(måned: Heltal) -> match måned {
    | 1 -> 0
    | 2 -> 31
    | 3 -> 59
    | 4 -> 90
    | 5 -> 120
    | 6 -> 151
    | 7 -> 181
    | 8 -> 212
    | 9 -> 243
    | 10 -> 273
    | 11 -> 304
    | 12 -> 334
    | _ -> 0
}
| dato_dagnummer_i_år(dato: Dato) -> hvis dato_gyldig(dato) {
    dato_månedsstart_dagnummer(dato.måned) + hvis dato_skudår(dato.år) && dato.måned > 2 { 1 } ellers { 0 } + dato.dag
} ellers {
    0
}
| dato_dage_før_år(år: Heltal) -> hvis år > 0 {
    = foregående_år = år - 1
    foregående_år * 365 + foregående_år / 4 - foregående_år / 100 + foregående_år / 400
} ellers {
    0
}
| dato_ordinal(dato: Dato) -> hvis dato_gyldig(dato) { dato_dage_før_år(dato.år) + dato_dagnummer_i_år(dato) } ellers { 0 }
| dato_faktiske_dage_mellem(fra_dato: Dato, til_dato: Dato) -> hvis dato_før_eller_lig_med(fra_dato, til_dato) { dato_ordinal(til_dato) - dato_ordinal(fra_dato) } ellers { 0 }
| dato_dage_efter_til_og_med(fra_dato: Dato, til_dato: Dato) -> dato_faktiske_dage_mellem(fra_dato, til_dato)
| dato_dage_fra_og_med_til_og_med(fra_dato: Dato, til_dato: Dato) -> hvis dato_før_eller_lig_med(fra_dato, til_dato) { dato_faktiske_dage_mellem(fra_dato, til_dato) + 1 } ellers { 0 }
| dato_tredive360_normaliseret_dag(dag: Heltal) -> hvis dag > 30 { 30 } ellers { dag }
| dato_tredive360_ordinal(dato: Dato) -> hvis dato_gyldig(dato) { (dato.år - 1) * 360 + (dato.måned - 1) * 30 + dato_tredive360_normaliseret_dag(dato.dag) } ellers { 0 }
| dato_tredive360_dage_mellem(fra_dato: Dato, til_dato: Dato) -> hvis dato_før_eller_lig_med(fra_dato, til_dato) { dato_tredive360_ordinal(til_dato) - dato_tredive360_ordinal(fra_dato) } ellers { 0 }
| dato_periodegrænsetillæg(grænser: Datoperiodegrænser) -> match grænser {
    | EfterStartTilOgMedSlut -> 0
    | FraOgMedStartTilFørSlut -> 0
    | FraOgMedBeggeDatoer -> 1
    | UdenBeggeDatoer -> -1
}
| dato_ikke_negativt_antal_dage(antal_dage: Heltal) -> hvis antal_dage > 0 { antal_dage } ellers { 0 }
| dato_dage_efter_konvention(fra_dato: Dato, til_dato: Dato, kalenderdage: Kalenderdagskonvention, grænser: Datoperiodegrænser) -> {
    = dage_mellem = match kalenderdage {
        | FaktiskeGregorianskeDage -> dato_faktiske_dage_mellem(fra_dato, til_dato)
        | TrediveDagesMåneder -> dato_tredive360_dage_mellem(fra_dato, til_dato)
    }
    dato_ikke_negativt_antal_dage(dage_mellem + dato_periodegrænsetillæg(grænser))
}
| dato_årsgrundlag_dage(referenceår: Heltal, konvention: Årsdagskonvention) -> match konvention {
    | FaktiskeDageIReferenceåret -> dato_dage_i_år(referenceår)
    | Fast365Dage -> 365
    | Fast360Dage -> 360
}
| dagtælling_resultat(fra_dato: Dato, til_dato: Dato, referenceår: Heltal, politik: Dagtællingspolitik) -> {
    = input_gyldigt = dato_før_eller_lig_med(fra_dato, til_dato) && referenceår > 0
    Dagtællingsresultat(
        fra_dato = fra_dato,
        til_dato = til_dato,
        referenceår = referenceår,
        politik = politik,
        input_gyldigt = input_gyldigt,
        antal_dage = hvis input_gyldigt { dato_dage_efter_konvention(fra_dato, til_dato, politik.kalenderdage, politik.periodegrænser) } ellers { 0 },
        årsgrundlag_dage = hvis input_gyldigt { dato_årsgrundlag_dage(referenceår, politik.årsdage) } ellers { 0 }
    )
}
