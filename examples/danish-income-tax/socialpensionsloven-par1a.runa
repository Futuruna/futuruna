--@label:socialpensionsloven_par1a_temporal::meta:socialpensionsloven_par1a_temporal_metadata--
----
§ 1 a. Folkepensionsalderen er:
1) 65 år for personer, der er født før den 1. januar 1954.
2) 65 1/2 år for personer, der er født i perioden fra den 1. januar 1954 til den 30. juni 1954.
3) 66 år for personer, der er født i perioden fra den 1. juli 1954 til den 31. december 1954.
4) 66 1/2 år for personer, der er født i perioden fra den 1. januar 1955 til den 30. juni 1955.
5) 67 år for personer, der er født i perioden fra den 1. juli 1955 til den 31. december 1962.
6) 68 år for personer, der er født i perioden fra den 1. januar 1963 til den 31. december 1966.
7) 69 år for personer, der er født efter den 31. december 1966.

Stk. 2. I 2015 og herefter hvert 5. år beregnes, jf. stk. 3, om folkepensionsalderen for personer født efter den 31. december 1962 skal reguleres.

Stk. 3. Folkepensionsalderen for personer født efter den 31. december 1962 forhøjes, hvis den gennemsnitlige levetid for 60-årige i de seneste 2 år på grundlag af Danmarks Statistiks opgørelse heraf overstiger levetiden i 2004-2005 på 81,4 år. Levetiden opgøres som et simpelt gennemsnit for mænd og kvinder. Folkepensionsalderen fastsættes af beskæftigelsesministeren til levetiden for 60-årige i de seneste 2 år tillagt en forudsat stigning i levetiden på 0,6 år og fratrukket en forudsat folkepensionsperiode på 14,5 år. Der afrundes til nærmeste halve år. Folkepensionsalderen reguleres med højst 1 år ad gangen. Folkepensionsalderen fastsættes med virkning pr. 1. januar i kalenderåret 15 år efter det år, hvori folkepensionsalderen reguleres.
----

----
§ 1

I lov om social pension, jf. lovbekendtgørelse nr. 10 af 12. januar 2015, som ændret senest ved § 8 i lov nr. 1000 af 30. august 2015, foretages følgende ændringer:

1. § 1 a, stk. 1, nr. 5, ophæves, og i stedet indsættes:
»5) 67 år for personer, der er født i perioden fra den 1. juli 1955 til den 31. december 1962.
6) 68 år for personer, der er født efter den 31. december 1962.«

§ 4

Loven træder i kraft den 29. december 2015.
----

----
§ 1

I lov om social pension, jf. lovbekendtgørelse nr. 983 af 23. september 2019, som ændret senest ved § 21 i lov nr. 869 af 14. juni 2020, foretages følgende ændringer:

1. § 1 a, stk. 1, nr. 6, ophæves, og i stedet indsættes:
»6) 68 år for personer, der er født i perioden fra den 1. januar 1963 til den 31. december 1966.
7) 69 år for personer, der er født efter den 31. december 1966.«

§ 3

Loven træder i kraft den 31. december 2020.
----

----
§ 1

I lov om social pension, jf. lovbekendtgørelse nr. 1123 af 21. oktober 2024, som ændret senest ved § 38 i lov nr. 469 af 14. maj 2025, foretages følgende ændringer:

1. § 1 a, stk. 1, nr. 7, ophæves, og i stedet indsættes:
»7) 69 år for personer, der er født i perioden fra den 1. januar 1967 til den 31. december 1970.
8) 70 år for personer, der er født efter den 31. december 1970.«

§ 4

Loven træder i kraft den 31. december 2025.
----

--@begin::socialpensionsloven_par1a_temporal--
# Socialpensionslov1ARegelversion = Socialpension1AIkkeUnderstøttet | Socialpension1AReglerFra2015 | Socialpension1AReglerFra2020 | Socialpension1AReglerFra2025
# Socialpensionslov1AResultat(fødselsdato: Dato, vurderingsdato: Dato, regelversion: Socialpensionslov1ARegelversion, input_gyldigt: Boolsk, folkepensionsalder_måneder: Heltal, folkepensionsdato: Dato, folkepension_opnåelsesår: Heltal)

| socialpensionslov1a_ikrafttrædelsesdato_2015() -> Dato(år = 2015, måned = 12, dag = 29)
| socialpensionslov1a_ikrafttrædelsesdato_2020() -> Dato(år = 2020, måned = 12, dag = 31)
| socialpensionslov1a_ikrafttrædelsesdato_2025() -> Dato(år = 2025, måned = 12, dag = 31)
| socialpensionslov1a_regelversion(vurderingsdato: Dato) -> hvis dato_gyldig(vurderingsdato) == Falskt || dato_før(vurderingsdato, socialpensionslov1a_ikrafttrædelsesdato_2015()) {
    Socialpension1AIkkeUnderstøttet
} ellers hvis dato_efter_eller_lig_med(vurderingsdato, socialpensionslov1a_ikrafttrædelsesdato_2025()) {
    Socialpension1AReglerFra2025
} ellers hvis dato_efter_eller_lig_med(vurderingsdato, socialpensionslov1a_ikrafttrædelsesdato_2020()) {
    Socialpension1AReglerFra2020
} ellers {
    Socialpension1AReglerFra2015
}
| socialpensionslov1a_fælles_alder_til_og_med_1962_måneder(fødselsdato: Dato) -> hvis dato_gyldig(fødselsdato) == Falskt {
    0
} ellers hvis dato_før(fødselsdato, Dato(år = 1954, måned = 1, dag = 1)) {
    780
} ellers hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1954, måned = 6, dag = 30)) {
    786
} ellers hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1954, måned = 12, dag = 31)) {
    792
} ellers hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1955, måned = 6, dag = 30)) {
    798
} ellers hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1962, måned = 12, dag = 31)) {
    804
} ellers {
    0
}
| socialpensionslov1a_alder_efter_1962_måneder(fødselsdato: Dato, regelversion: Socialpensionslov1ARegelversion) -> match regelversion {
    | Socialpension1AReglerFra2015 -> 816
    | Socialpension1AReglerFra2020 -> hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1966, måned = 12, dag = 31)) { 816 } ellers { 828 }
    | Socialpension1AReglerFra2025 -> hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1966, måned = 12, dag = 31)) { 816 } ellers hvis dato_før_eller_lig_med(fødselsdato, Dato(år = 1970, måned = 12, dag = 31)) { 828 } ellers { 840 }
    | Socialpension1AIkkeUnderstøttet -> 0
}
| socialpensionslov1a_folkepensionsalder_måneder(fødselsdato: Dato, regelversion: Socialpensionslov1ARegelversion) -> {
    = fælles_alder_måneder = socialpensionslov1a_fælles_alder_til_og_med_1962_måneder(fødselsdato)
    hvis fælles_alder_måneder > 0 {
        fælles_alder_måneder
    } ellers hvis dato_gyldig(fødselsdato) && dato_efter(fødselsdato, Dato(år = 1962, måned = 12, dag = 31)) {
        socialpensionslov1a_alder_efter_1962_måneder(fødselsdato, regelversion)
    } ellers {
        0
    }
}
| socialpensionslov1a_resultat(fødselsdato: Dato, vurderingsdato: Dato) -> {
    = regelversion = socialpensionslov1a_regelversion(vurderingsdato)
    = folkepensionsalder_måneder = socialpensionslov1a_folkepensionsalder_måneder(fødselsdato, regelversion)
    = input_gyldigt = dato_gyldig(fødselsdato) && dato_gyldig(vurderingsdato) && regelversion != Socialpension1AIkkeUnderstøttet && folkepensionsalder_måneder > 0
    = folkepensionsdato = hvis input_gyldigt { dato_plus_måneder(fødselsdato, folkepensionsalder_måneder) } ellers { dato_ugyldig() }
    Socialpensionslov1AResultat(
        fødselsdato = fødselsdato,
        vurderingsdato = vurderingsdato,
        regelversion = regelversion,
        input_gyldigt = input_gyldigt,
        folkepensionsalder_måneder = hvis input_gyldigt { folkepensionsalder_måneder } ellers { 0 },
        folkepensionsdato = folkepensionsdato,
        folkepension_opnåelsesår = hvis input_gyldigt { folkepensionsdato.år } ellers { 0 }
    )
}
| socialpensionslov1a_resultat_for_indkomstår(fødselsdato: Dato, indkomstår: Heltal) -> socialpensionslov1a_resultat(
    fødselsdato,
    Dato(år = indkomstår, måned = 1, dag = 1)
)
--@end::socialpensionsloven_par1a_temporal--
