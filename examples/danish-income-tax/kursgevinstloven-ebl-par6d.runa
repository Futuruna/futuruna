@ sprog da

@ importer ./metadata
@ importer ./kursgevinstloven - saelgerpantebrev
@ importer ./ejendomsavancebeskatningsloven - par6d

# KglEblPar6DKildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)

= kgl_ebl_par6d_vejledning_2026 = KglEblPar6DKildeInfo(
    url = "https://info.skat.dk/data.aspx?oid=2292757",
    identifier = "Den juridiske vejledning 2026-1, C.H.2.1.11.9: EBL § 6 D-sælgerpantebreve og kursgevinstloven",
    hentet_dato = "2026-07-18"
)

= kgl_ebl_par6d_samspil_vejledningsmeta = MetaAttachment(
    role = Guidance,
    value = kgl_ebl_par6d_vejledning_2026
)
--@label:kgl_ebl_par6d_samspil::meta:kgl_ebl_par6d_samspil_vejledningsmeta--
----
Udskydelse af beskatningen ved udstedelse af et sælgerpantebrev, der opfylder
betingelserne i EBL § 6 D, berøres ikke af beskatningen efter kursgevinstloven.

Ved en afståelse af sælgerpantebrevet i løbetiden, skal en eventuel resterende
udskudt fortjeneste medregnes ved opgørelsen af den skattepligtige indkomst som
ejendomsavance i afståelsesåret, og en gevinst eller et tab på pantebrevet vil
være henholdsvis skattepligtig og fradragsberettiget efter reglerne i
kursgevinstloven.

Det samme gælder ved en (ekstraordinær) indfrielse af sælgerpantebrevet.
----

--@begin:kgl_ebl_par6d_samspil--
# KglEblPar6DSkatteyderfakta(udøver_næring_ved_køb_og_salg_af_fordringer: Boolsk, fordringen_erhvervet_uden_for_fordringsnæring: Boolsk, fordringen_erhvervet_som_vederlag_for_leverede_varer_eller_tjenesteydelser: Boolsk, fordringen_erhvervet_i_direkte_tilknytning_til_erhvervsmæssig_drift: Boolsk, debitor_omfattet_af_tabsbegrænsningen_i_kgl_par14_stk2: Boolsk, renter_eller_gevinster_fritaget_efter_dobbeltbeskatningsoverenskomst: Boolsk)
# KglEblPar6DSælgerpantebrevsfakta(sælgerpantebrev_identifikation: Tekst, oprindelig_skatteyder_identifikation: Tekst, skatteyderfakta: KglEblPar6DSkatteyderfakta, dispositioner_efter_ebl_forløbet: List(KglSælgerpantebrevDisposition))
# KglEblPar6DFordringsdelejer(fordringsdel_identifikation: Tekst, skatteyder: KglSælgerpantebrevSkatteyder)
# KglEblPar6DFortjenestemedregning(medregning: EblPar6DFortjenestemedregning, skatteyder: KglSælgerpantebrevSkatteyder)
# KglEblPar6DSælgerpantebrevsresultat(fakta: KglEblPar6DSælgerpantebrevsfakta, par6d_resultat: EblPar6DResultat, identifikation_matcher: Boolsk, skatteyder_understøttet: Boolsk, tranchefordeling_entydig: Boolsk, fortjenestefordeling_entydig: Boolsk, efterfølgende_dispositioner_gyldige: Boolsk, ebl_kgl_realisering_sammenhæng_gyldig: Boolsk, input_gyldigt: Boolsk, skatteforhold: KglSælgerpantebrevSkatteforhold, fortjenestemedregninger: List(KglEblPar6DFortjenestemedregning), kursgevinstresultat: KglSælgerpantebrevResultat)
# KglEblPar6DPostdispositioner(dispositioner: List(KglSælgerpantebrevDisposition), forventede_realiseringer: List(Boolsk), identifikationer_entydige: Boolsk)
# KglEblPar6DDispositionsforløbstilstand(dispositioner: List(KglSælgerpantebrevDisposition), forventede_realiseringer: List(Boolsk), tranchefordeling_entydig: Boolsk)

| kgl_ebl_par6d_par17_fordring(fakta: KglEblPar6DSkatteyderfakta) -> fakta.fordringen_erhvervet_som_vederlag_for_leverede_varer_eller_tjenesteydelser || fakta.fordringen_erhvervet_i_direkte_tilknytning_til_erhvervsmæssig_drift
| kgl_ebl_par6d_tab_status(fakta: KglEblPar6DSkatteyderfakta) -> KglFordringTabAlmindelig
| exception kgl_ebl_par6d_kontrol_eller_nærtstående kgl_ebl_par6d_tab_status(fakta: KglEblPar6DSkatteyderfakta) -> KglFordringTabKontrolEllerNærtstående under fakta.debitor_omfattet_af_tabsbegrænsningen_i_kgl_par14_stk2 && kgl_ebl_par6d_par17_fordring(fakta) == Falskt
| exception kgl_ebl_par6d_par17_driftstilknytning kgl_ebl_par6d_tab_status(fakta: KglEblPar6DSkatteyderfakta) -> KglFordringTabPar17Statsskattelov6A under kgl_ebl_par6d_par17_fordring(fakta)
| kgl_ebl_par6d_skatteforhold(fakta: KglEblPar6DSkatteyderfakta) -> KglSælgerpantebrevSkatteforhold(
    tab_status = kgl_ebl_par6d_tab_status(fakta),
    udøver_fordringsnæring = fakta.udøver_næring_ved_køb_og_salg_af_fordringer,
    fordring_erhvervet_udenfor_næring = fakta.fordringen_erhvervet_uden_for_fordringsnæring
)
| kgl_ebl_par6d_skatteyderfakta_understøttet(fakta: KglEblPar6DSkatteyderfakta) -> fakta.renter_eller_gevinster_fritaget_efter_dobbeltbeskatningsoverenskomst == Falskt
| kgl_ebl_par6d_personskatteyder(identifikation: Tekst) -> KglSælgerpantebrevSkatteyder(
    identifikation = identifikation,
    rolle = KglPersonEfterKildeskatteloven
)
| kgl_ebl_par6d_pantebrev_dispositionstype(art: EblPar6DPantebrevshændelsesart) -> KglSælgerpantebrevAfståelse
| exception kgl_ebl_par6d_pantebrev_indfrielse kgl_ebl_par6d_pantebrev_dispositionstype(art: EblPar6DPantebrevshændelsesart) -> KglSælgerpantebrevIndfrielse under art == EblPar6DPantebrevIndfriet
| kgl_ebl_par6d_ægtefælle_ejerskiftegrundlag(succession: EblPar6DÆgtefællesuccession) -> match succession {
    | EblPar6DÆgtefælleMedSuccessionEfterKildeskattelovensPar26B(_, modtager, overdrager_i_danmark, modtager_i_danmark) -> KglSælgerpantebrevÆgtefælleEfterKildeskattelovensPar26B(
        modtagers_skatteyder_identifikation = modtager,
        overdrager_hjemmehørende_i_danmark = overdrager_i_danmark,
        modtager_hjemmehørende_i_danmark = modtager_i_danmark
    )
    | EblPar6DÆgtefælleMedSuccessionVedBodelingEfterSeparationEllerSkilsmisse(_, modtager, overdrager_i_danmark, modtager_i_danmark) -> KglSælgerpantebrevÆgtefælleVedBodelingEfterSeparationEllerSkilsmisse(
        modtagers_skatteyder_identifikation = modtager,
        overdrager_hjemmehørende_i_danmark = overdrager_i_danmark,
        modtager_hjemmehørende_i_danmark = modtager_i_danmark
    )
    | EblPar6DIngenÆgtefællesuccession -> KglSælgerpantebrevIkkeUnderstøttetEjerskifte(beskrivelse = "Ejerskifte mangler et ægtefællesuccessionsgrundlag")
}
| kgl_ebl_par6d_ægtefælle_modtagers_fordringsdel_identifikation(succession: EblPar6DÆgtefællesuccession) -> match succession {
    | EblPar6DÆgtefælleMedSuccessionEfterKildeskattelovensPar26B(modtagers_fordringsdel, _, _, _) -> modtagers_fordringsdel
    | EblPar6DÆgtefælleMedSuccessionVedBodelingEfterSeparationEllerSkilsmisse(modtagers_fordringsdel, _, _, _) -> modtagers_fordringsdel
    | EblPar6DIngenÆgtefællesuccession -> ""
}
| kgl_ebl_par6d_ejerskiftedisposition(indkomstår: Heltal, berørt_tranche_identifikation: Tekst, modtagers_tranche_identifikation: Tekst, berørt_hovedstol_kroner: Heltal, grundlag: KglSælgerpantebrevEjerskiftegrundlag) -> KglSælgerpantebrevDisposition(
    indkomstår = indkomstår,
    berørt_tranche_identifikation = berørt_tranche_identifikation,
    art = KglSælgerpantebrevEjerskifte(
        grundlag = grundlag,
        modtagers_tranche_identifikation = modtagers_tranche_identifikation
    ),
    berørt_hovedstol_kroner = berørt_hovedstol_kroner,
    afståelses_eller_indfrielsessum_kroner = 0
)
| kgl_ebl_par6d_dødsbodispositioner(indkomstår: Heltal, berørt_tranche_identifikation: Tekst, berørt_hovedstol_kroner: Heltal, overdragelse: EblPar6DDødsbooverdragelse) -> match overdragelse {
    | EblPar6DBoetOvertagerPantebrevet(boets_fordringsdel, bo) -> [kgl_ebl_par6d_ejerskiftedisposition(
        indkomstår,
        berørt_tranche_identifikation,
        boets_fordringsdel,
        berørt_hovedstol_kroner,
        KglSælgerpantebrevDødsboEfterDødsboskattelovensPar20(boets_skatteyder_identifikation = bo)
    )]
    | EblPar6DEfterlevendeÆgtefælleOvertagerIUskiftetBo(modtagers_fordringsdel, modtager) -> [kgl_ebl_par6d_ejerskiftedisposition(
        indkomstår,
        berørt_tranche_identifikation,
        modtagers_fordringsdel,
        berørt_hovedstol_kroner,
        KglSælgerpantebrevEfterlevendeÆgtefælleEfterDødsboskattelovensPar59(modtagers_skatteyder_identifikation = modtager)
    )]
    | EblPar6DUdlodningTilEfterlevendeÆgtefælle(boets_fordringsdel, bo, modtagers_fordringsdel, modtager, bo_ikke_fritaget, bo_har_valgt_salgsbeskatning, modtager_i_danmark, fortsat_dansk_beskatning, boopgørelsesværdi) -> [
        kgl_ebl_par6d_ejerskiftedisposition(
            indkomstår,
            berørt_tranche_identifikation,
            boets_fordringsdel,
            berørt_hovedstol_kroner,
            KglSælgerpantebrevDødsboEfterDødsboskattelovensPar20(boets_skatteyder_identifikation = bo)
        ),
        kgl_ebl_par6d_ejerskiftedisposition(
            indkomstår,
            boets_fordringsdel,
            modtagers_fordringsdel,
            berørt_hovedstol_kroner,
            KglSælgerpantebrevUdlodningTilEfterlevendeÆgtefælleEfterDødsboskattelovensPar35Til38(
                modtagers_skatteyder_identifikation = modtager,
                bo_ikke_fritaget_for_beskatning_efter_par6 = bo_ikke_fritaget,
                bo_har_valgt_salgsbeskatning_efter_par28_stk3 = bo_har_valgt_salgsbeskatning,
                modtager_hjemmehørende_i_danmark = modtager_i_danmark,
                fordringen_kan_fortsat_beskattes_i_danmark = fortsat_dansk_beskatning,
                værdi_i_boopgørelsen_kroner = boopgørelsesværdi
            )
        )
    ]
}
| kgl_ebl_par6d_dødsbo_forventede_realiseringer(postresultat: EblPar6DÅrsforløbspostresultat, berørt_hovedstol_kroner: Heltal, overdragelse: EblPar6DDødsbooverdragelse) -> match overdragelse {
    | EblPar6DBoetOvertagerPantebrevet(_, _) -> [Falskt]
    | EblPar6DEfterlevendeÆgtefælleOvertagerIUskiftetBo(_, _) -> [Falskt]
    | EblPar6DUdlodningTilEfterlevendeÆgtefælle(_, _, _, _, _, _, _, _, _) -> [
        Falskt,
        ebl_par6d_dødsbooverdragelse_undtager(postresultat.tilstand_før.sælgerpantebrev_restgæld_kroner, postresultat.tilstand_før.sælgerpantebrev_resterende_anskaffelsessum_kroner, berørt_hovedstol_kroner, overdragelse) == Falskt
    ]
}
| kgl_ebl_par6d_tomme_postdispositioner() -> KglEblPar6DPostdispositioner(dispositioner = [], forventede_realiseringer = [], identifikationer_entydige = Sandt)
| kgl_ebl_par6d_postdispositioner(indkomstår: Heltal, postresultat: EblPar6DÅrsforløbspostresultat) -> hvis postresultat.post_gyldig == Falskt { kgl_ebl_par6d_tomme_postdispositioner() } ellers { match postresultat.post {
    | EblPar6DOrdinærtHovedstolsafdrag(fordringsdel, betalt) -> KglEblPar6DPostdispositioner(
        dispositioner = [KglSælgerpantebrevDisposition(indkomstår = indkomstår, berørt_tranche_identifikation = fordringsdel, art = KglSælgerpantebrevAfdrag, berørt_hovedstol_kroner = betalt, afståelses_eller_indfrielsessum_kroner = betalt)],
        forventede_realiseringer = [Sandt],
        identifikationer_entydige = fordringsdel != ""
    )
    | EblPar6DFremrykningshændelse(EblPar6DPantebrevAfståetEllerIndfriet(fordringsdel, art, berørt, provenu, succession)) -> hvis ebl_par6d_ægtefællesuccession_undtager(succession) {
        = modtagers_fordringsdel = kgl_ebl_par6d_ægtefælle_modtagers_fordringsdel_identifikation(succession)
        KglEblPar6DPostdispositioner(
            dispositioner = [kgl_ebl_par6d_ejerskiftedisposition(indkomstår, fordringsdel, modtagers_fordringsdel, berørt, kgl_ebl_par6d_ægtefælle_ejerskiftegrundlag(succession))],
            forventede_realiseringer = [Falskt],
            identifikationer_entydige = fordringsdel != "" && modtagers_fordringsdel != "" && fordringsdel != modtagers_fordringsdel
        )
    } ellers { KglEblPar6DPostdispositioner(
        dispositioner = [KglSælgerpantebrevDisposition(indkomstår = indkomstår, berørt_tranche_identifikation = fordringsdel, art = kgl_ebl_par6d_pantebrev_dispositionstype(art), berørt_hovedstol_kroner = berørt, afståelses_eller_indfrielsessum_kroner = provenu)],
        forventede_realiseringer = [Sandt],
        identifikationer_entydige = fordringsdel != ""
    ) }
    | EblPar6DFremrykningshændelse(EblPar6DSælgerDød(fordringsdel, berørt, overdragelse)) -> KglEblPar6DPostdispositioner(
        dispositioner = kgl_ebl_par6d_dødsbodispositioner(indkomstår, fordringsdel, berørt, overdragelse),
        forventede_realiseringer = kgl_ebl_par6d_dødsbo_forventede_realiseringer(postresultat, berørt, overdragelse),
        identifikationer_entydige = fordringsdel != "" && ebl_par6d_dødsbooverdragelse_gyldig(overdragelse)
    )
    | _ -> kgl_ebl_par6d_tomme_postdispositioner()
} }
| kgl_ebl_par6d_postforløbstrin(indkomstår: Heltal, forløb: KglEblPar6DDispositionsforløbstilstand, postresultat: EblPar6DÅrsforløbspostresultat) -> {
    = postdispositioner = kgl_ebl_par6d_postdispositioner(indkomstår, postresultat)
    KglEblPar6DDispositionsforløbstilstand(
        dispositioner = concat(forløb.dispositioner, postdispositioner.dispositioner),
        forventede_realiseringer = concat(forløb.forventede_realiseringer, postdispositioner.forventede_realiseringer),
        tranchefordeling_entydig = forløb.tranchefordeling_entydig && postdispositioner.identifikationer_entydige
    )
}
| kgl_ebl_par6d_dispositionsforløbstrin(forløb: KglEblPar6DDispositionsforløbstilstand, årsresultat: EblPar6DÅrsresultat) -> hvis årsresultat.år_gyldigt { foldl(årsresultat.forløbspostresultater, forløb, |postforløb: KglEblPar6DDispositionsforløbstilstand, postresultat: EblPar6DÅrsforløbspostresultat| kgl_ebl_par6d_postforløbstrin(årsresultat.årsforhold.indkomstår, postforløb, postresultat)) } ellers { forløb }
| kgl_ebl_par6d_dispositionsforløb(resultat: EblPar6DResultat) -> foldl(resultat.årsresultater, KglEblPar6DDispositionsforløbstilstand(dispositioner = [], forventede_realiseringer = [], tranchefordeling_entydig = Sandt), kgl_ebl_par6d_dispositionsforløbstrin)
| kgl_ebl_par6d_dispositioner_i_forløb(resultat: EblPar6DResultat) -> kgl_ebl_par6d_dispositionsforløb(resultat).dispositioner
| kgl_ebl_par6d_efterfølgende_disposition_efter_forløbet(resultat: EblPar6DResultat, disposition: KglSælgerpantebrevDisposition) -> disposition.indkomstår > ebl_par6d_sidst_behandlede_indkomstår(resultat)
| kgl_ebl_par6d_efterfølgende_dispositioner_gyldige(resultat: EblPar6DResultat, dispositioner: List(KglSælgerpantebrevDisposition)) -> length(dispositioner) == 0 || (resultat.tilstand_ultimo.ordning_aktiv == Falskt && all(dispositioner, |disposition: KglSælgerpantebrevDisposition| kgl_ebl_par6d_efterfølgende_disposition_efter_forløbet(resultat, disposition)))
| kgl_ebl_par6d_sælgerpantebrev(resultat: EblPar6DResultat) -> match resultat.valg {
    | EblMedPar6DValg(fakta) -> fakta.sælgerpantebrev
    | EblUdenPar6DValg -> EblPar6DSælgerpantebrev(identifikation = "", fordring_mod_erhververen = Falskt, pant_i_den_overdragne_ejendom = Falskt, kontantværdi_kroner = 0, hovedstol_kroner = 0, løbetid_år = 0, afdragsplan = [])
}
| kgl_ebl_par6d_sælgers_skattepligtsstatus(resultat: EblPar6DResultat) -> match resultat.valg {
    | EblMedPar6DValg(fakta) -> fakta.sælgers_skatteforhold.skattepligtsstatus
    | EblUdenPar6DValg -> EblPar6DAndenSkattepligtsstatus
}
| kgl_ebl_par6d_personskatteyder_understøttet(resultat: EblPar6DResultat) -> kgl_ebl_par6d_sælgers_skattepligtsstatus(resultat) == EblPar6DFuldtSkattepligtigTilDanmark || kgl_ebl_par6d_sælgers_skattepligtsstatus(resultat) == EblPar6DBegrænsetSkattepligtigEfterKildeskattelovensPar2Stk1Nr5
| kgl_ebl_par6d_kursgevinstinput(resultat: EblPar6DResultat, oprindelig_skatteyder_identifikation: Tekst, efterfølgende_dispositioner: List(KglSælgerpantebrevDisposition)) -> {
    = pantebrev = kgl_ebl_par6d_sælgerpantebrev(resultat)
    KglSælgerpantebrevInput(
        identifikation = pantebrev.identifikation,
        oprindelig_skatteyder = kgl_ebl_par6d_personskatteyder(oprindelig_skatteyder_identifikation),
        erhvervelsesår = resultat.tilstand_ultimo.afståelsesår,
        hovedstol_kroner = pantebrev.hovedstol_kroner,
        kursværdi_ved_erhvervelsen_kroner = pantebrev.kontantværdi_kroner,
        dispositioner = concat(kgl_ebl_par6d_dispositioner_i_forløb(resultat), efterfølgende_dispositioner)
    )
}
| kgl_ebl_par6d_tom_skatteyder() -> KglSælgerpantebrevSkatteyder(identifikation = "", rolle = KglUdenforPersonkapitlet)
| kgl_ebl_par6d_nye_fordringsdelejere(dispositionsresultat: KglSælgerpantebrevDispositionsresultat) -> hvis dispositionsresultat.disposition_gyldig == Falskt { [] } ellers { match dispositionsresultat.disposition.art {
    | KglSælgerpantebrevEjerskifte(_, modtagers_tranche_identifikation) -> {
        = modtagertrancher = filter(dispositionsresultat.ændrede_trancher_efter, |tranche: KglSælgerpantebrevTranche| tranche.identifikation == modtagers_tranche_identifikation)
        hvis length(modtagertrancher) == 1 { [KglEblPar6DFordringsdelejer(fordringsdel_identifikation = modtagers_tranche_identifikation, skatteyder = head(modtagertrancher).skatteyder)] } ellers { [] }
    }
    | _ -> []
} }
| kgl_ebl_par6d_fordringsdelejere(fakta: KglEblPar6DSælgerpantebrevsfakta, kursgevinstresultat: KglSælgerpantebrevResultat) -> concat(
    [KglEblPar6DFordringsdelejer(fordringsdel_identifikation = fakta.sælgerpantebrev_identifikation, skatteyder = kgl_ebl_par6d_personskatteyder(fakta.oprindelig_skatteyder_identifikation))],
    flat_map(kursgevinstresultat.dispositionsresultater, kgl_ebl_par6d_nye_fordringsdelejere)
)
| kgl_ebl_par6d_matchende_fordringsdelejere(ejere: List(KglEblPar6DFordringsdelejer), fordringsdel_identifikation: Tekst) -> filter(ejere, |ejer: KglEblPar6DFordringsdelejer| ejer.fordringsdel_identifikation == fordringsdel_identifikation)
| kgl_ebl_par6d_fordringsdelejere_entydige(ejere: List(KglEblPar6DFordringsdelejer)) -> all(ejere, |ejer: KglEblPar6DFordringsdelejer| length(kgl_ebl_par6d_matchende_fordringsdelejere(ejere, ejer.fordringsdel_identifikation)) == 1)
| kgl_ebl_par6d_medregning_har_entydig_ejer(ejere: List(KglEblPar6DFordringsdelejer), medregning: EblPar6DFortjenestemedregning) -> length(kgl_ebl_par6d_matchende_fordringsdelejere(ejere, medregning.fordringsdel_identifikation)) == 1
| kgl_ebl_par6d_medregning_skatteyder(ejere: List(KglEblPar6DFordringsdelejer), medregning: EblPar6DFortjenestemedregning) -> hvis kgl_ebl_par6d_medregning_har_entydig_ejer(ejere, medregning) { head(kgl_ebl_par6d_matchende_fordringsdelejere(ejere, medregning.fordringsdel_identifikation)).skatteyder } ellers { kgl_ebl_par6d_tom_skatteyder() }
| kgl_ebl_par6d_fordelt_fortjenestemedregning(ejere: List(KglEblPar6DFordringsdelejer), medregning: EblPar6DFortjenestemedregning) -> KglEblPar6DFortjenestemedregning(medregning = medregning, skatteyder = kgl_ebl_par6d_medregning_skatteyder(ejere, medregning))
| kgl_ebl_par6d_fortjenestefordeling_entydig(ejere: List(KglEblPar6DFordringsdelejer), medregninger: List(EblPar6DFortjenestemedregning)) -> kgl_ebl_par6d_fordringsdelejere_entydige(ejere) && all(medregninger, |medregning: EblPar6DFortjenestemedregning| kgl_ebl_par6d_medregning_har_entydig_ejer(ejere, medregning))
| kgl_ebl_par6d_fordelte_fortjenestemedregninger(ejere: List(KglEblPar6DFordringsdelejer), medregninger: List(EblPar6DFortjenestemedregning)) -> map(medregninger, |medregning: EblPar6DFortjenestemedregning| kgl_ebl_par6d_fordelt_fortjenestemedregning(ejere, medregning))

# KglEblPar6DSag(fakta: KglEblPar6DSælgerpantebrevsfakta, par6d_resultat: EblPar6DResultat) {
    | pantebrev() -> kgl_ebl_par6d_sælgerpantebrev(par6d_resultat)
    | identifikation_matcher() -> fakta.sælgerpantebrev_identifikation != "" && fakta.sælgerpantebrev_identifikation == pantebrev().identifikation
    | skatteyder_understøttet() -> fakta.oprindelig_skatteyder_identifikation != "" && kgl_ebl_par6d_personskatteyder_understøttet(par6d_resultat) && kgl_ebl_par6d_skatteyderfakta_understøttet(fakta.skatteyderfakta)
    | tranchefordeling_entydig() -> kgl_ebl_par6d_dispositionsforløb(par6d_resultat).tranchefordeling_entydig
    | efterfølgende_dispositioner_gyldige() -> kgl_ebl_par6d_efterfølgende_dispositioner_gyldige(par6d_resultat, fakta.dispositioner_efter_ebl_forløbet)
    | skatteforhold() -> kgl_ebl_par6d_skatteforhold(fakta.skatteyderfakta)
    | kursgevinstresultat() -> kgl_sælgerpantebrev_resultat(kgl_ebl_par6d_kursgevinstinput(par6d_resultat, fakta.oprindelig_skatteyder_identifikation, fakta.dispositioner_efter_ebl_forløbet))
    | fordringsdelejere() -> kgl_ebl_par6d_fordringsdelejere(fakta, kursgevinstresultat())
    | ebl_fortjenestemedregninger() -> ebl_par6d_fortjenestemedregninger(par6d_resultat)
    | fortjenestefordeling_entydig() -> kgl_ebl_par6d_fortjenestefordeling_entydig(fordringsdelejere(), ebl_fortjenestemedregninger())
    | fortjenestemedregninger() -> hvis fortjenestefordeling_entydig() { kgl_ebl_par6d_fordelte_fortjenestemedregninger(fordringsdelejere(), ebl_fortjenestemedregninger()) } ellers { [] }
    | forventede_realiseringer() -> kgl_ebl_par6d_dispositionsforløb(par6d_resultat).forventede_realiseringer
    | faktiske_realiseringer_for_ebl_forløbet() -> collect(map(take(kursgevinstresultat().dispositionsresultater, length(forventede_realiseringer())), |resultat: KglSælgerpantebrevDispositionsresultat| resultat.realisering_sker))
    | ebl_kgl_realisering_sammenhæng_gyldig() -> length(kursgevinstresultat().dispositionsresultater) >= length(forventede_realiseringer()) && faktiske_realiseringer_for_ebl_forløbet() == forventede_realiseringer()
    | input_gyldigt() -> par6d_resultat.input_gyldigt && identifikation_matcher() && skatteyder_understøttet() && tranchefordeling_entydig() && fortjenestefordeling_entydig() && efterfølgende_dispositioner_gyldige() && kursgevinstresultat().input_gyldigt && ebl_kgl_realisering_sammenhæng_gyldig()
    | resultat() -> KglEblPar6DSælgerpantebrevsresultat(
        fakta = fakta,
        par6d_resultat = par6d_resultat,
        identifikation_matcher = identifikation_matcher(),
        skatteyder_understøttet = skatteyder_understøttet(),
        tranchefordeling_entydig = tranchefordeling_entydig(),
        fortjenestefordeling_entydig = fortjenestefordeling_entydig(),
        efterfølgende_dispositioner_gyldige = efterfølgende_dispositioner_gyldige(),
        ebl_kgl_realisering_sammenhæng_gyldig = ebl_kgl_realisering_sammenhæng_gyldig(),
        input_gyldigt = input_gyldigt(),
        skatteforhold = skatteforhold(),
        fortjenestemedregninger = fortjenestemedregninger(),
        kursgevinstresultat = kursgevinstresultat()
    )
}

| kgl_ebl_par6d_sag(fakta: KglEblPar6DSælgerpantebrevsfakta, par6d_resultat: EblPar6DResultat) -> KglEblPar6DSag(fakta, par6d_resultat)
| kgl_ebl_par6d_resultat(fakta: KglEblPar6DSælgerpantebrevsfakta, par6d_resultat: EblPar6DResultat) -> kgl_ebl_par6d_sag(fakta, par6d_resultat).resultat()
| kgl_ebl_par6d_medregnet_fortjeneste_for_skatteyder_i_indkomstår_kroner(resultat: KglEblPar6DSælgerpantebrevsresultat, indkomstår: Heltal, skatteyder_identifikation: Tekst) -> foldl(resultat.fortjenestemedregninger, 0, |sum: Heltal, medregning: KglEblPar6DFortjenestemedregning| sum + hvis medregning.medregning.indkomstår == indkomstår && medregning.skatteyder.identifikation == skatteyder_identifikation { medregning.medregning.beløb_kroner } ellers { 0 })
| kgl_ebl_par6d_samlet_fordelt_fortjeneste_kroner(resultat: KglEblPar6DSælgerpantebrevsresultat) -> foldl(resultat.fortjenestemedregninger, 0, |sum: Heltal, medregning: KglEblPar6DFortjenestemedregning| sum + medregning.medregning.beløb_kroner)
--@end:kgl_ebl_par6d_samspil--
