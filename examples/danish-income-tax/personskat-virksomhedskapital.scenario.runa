)
| personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder(kapitalindkomst: PersonskatKapitalindkomstInput, virksomheder: List(PersonskatOrdinærVirksomhedFakta)) -> personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder_og_ægtefælle(kapitalindkomst, virksomheder, UdenÆgtefælle)
| personskat_virksomhedskapital_scenarie_personskatinput(kapitalindkomst: PersonskatKapitalindkomstInput) -> personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder(kapitalindkomst, [])
| personskat_virksomhedskapital_scenarie_ægtefællefakta() -> personskat_hovedperson_fakta(personskat_virksomhedskapital_scenarie_personskatinput(personskat_ingen_kapitalindkomst()))
| personskat_virksomhedskapital_scenarie_ksl25a_stk8_fordeling() -> PersonskatKsl25AVirksomhedsfordelingFakta(
    virksomhedsidentifikation = "fælles-virksomhed",
    virksomhedens_kildeplacering = Ksl25AKildeHosHovedperson,
    virksomhedsdriver_før_samlivsophør = None,
    samlivsforløb = Ksl25AIntetSamlivsophør,
    virksomhedspostperioder = [],
    ordinær_ejer_efter_samlivsophør = None,
    fordeling = Ksl25AStk8LigeligResultatfordeling(
        begge_deltager_i_væsentligt_og_ligeligt_omfang = Sandt,
        hæfter_i_samme_omfang = Sandt,
        fordeling_anmodet = Sandt,
        fordeling_sagligt_begrundet_i_driften = Sandt,
        anden_ægtefælles_fordelingsandel_basispoint = 4000
    ),
    lønudgiftsidentifikation = None
)
| personskat_virksomhedskapital_scenarie_ægtefælleinput() -> MedÆgtefælle(
    fakta = personskat_virksomhedskapital_scenarie_ægtefællefakta(),
    samlevende_ved_indkomstårets_udløb = Sandt,
    kildeskat25a_fordelinger = [personskat_virksomhedskapital_scenarie_ksl25a_stk8_fordeling()]
)

= personskat_virksomhedskapital_scenarie_ordinær_virksomhed = personskat_virksomhedskapital_scenarie_virksomhed("fælles-virksomhed", 2026, 100000)
= personskat_virksomhedskapital_scenarie_vso_resultat = personskat_virksomhedskapital_resultat(
    personskat_virksomhedskapital_scenarie_vso_input(2026, 20270701),
    2026
)
= personskat_virksomhedskapital_scenarie_kao_resultat = personskat_virksomhedskapital_resultat_med_kontekst(
    personskat_virksomhedskapital_scenarie_kao_input(2026),
    2026,
    personskat_virksomhedskapital_scenarie_kao_kontekst(100000)
)
= personskat_virksomhedskapital_scenarie_kao_uden_kontekst = personskat_virksomhedskapital_resultat(
    personskat_virksomhedskapital_scenarie_kao_input(2026),
    2026
)
= personskat_virksomhedskapital_scenarie_sen_overførsel = personskat_virksomhedskapital_resultat(
    personskat_virksomhedskapital_scenarie_vso_input(2026, 20270702),
    2026
)
= personskat_virksomhedskapital_scenarie_forkert_år = personskat_virksomhedskapital_resultat_med_kontekst(
    personskat_virksomhedskapital_scenarie_kao_input(2025),
    2026,
    personskat_virksomhedskapital_scenarie_kao_kontekst(100000)
)
= personskat_virksomhedskapital_scenarie_personskat_vso = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput(
    personskat_virksomhedskapital_scenarie_kapitalindkomst(personskat_virksomhedskapital_scenarie_vso_input(2026, 20270701))
))
= personskat_virksomhedskapital_scenarie_personskat_kao = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder(
    personskat_virksomhedskapital_scenarie_kapitalindkomst(personskat_virksomhedskapital_scenarie_kao_input(2026)),
    [personskat_virksomhedskapital_scenarie_ordinær_virksomhed]
))
= personskat_virksomhedskapital_scenarie_personskat_kao_sammenligningsgrundlag = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder(
    personskat_virksomhedskapital_scenarie_kapitalindkomst(personskat_virksomhedskapital_scenarie_uden_kao_input(2026)),
    [personskat_virksomhedskapital_scenarie_ordinær_virksomhed]
))
= personskat_virksomhedskapital_scenarie_personskat_kao_uden_virksomhedsindkomst = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput(
    personskat_virksomhedskapital_scenarie_kapitalindkomst(personskat_virksomhedskapital_scenarie_kao_input(2026))
))
= personskat_virksomhedskapital_scenarie_personskat_kao_ægtefæller = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder_og_ægtefælle(
    personskat_virksomhedskapital_scenarie_kapitalindkomst(personskat_virksomhedskapital_scenarie_kao_input_med_ægtefælle(2026, MedÆgtefællegrundlagEfterVirksomhedsskattelov22A(grundlag = personskat_virksomhedskapital_scenarie_par22a_ægtefælleperson()))),
    [personskat_virksomhedskapital_scenarie_ordinær_virksomhed],
    personskat_virksomhedskapital_scenarie_ægtefælleinput()
))
= personskat_virksomhedskapital_scenarie_personskat_kao_modstridende_ægtefællegrundlag = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput_med_virksomheder(
    personskat_virksomhedskapital_scenarie_kapitalindkomst(personskat_virksomhedskapital_scenarie_kao_input_med_ægtefælle(2026, MedÆgtefællegrundlagEfterVirksomhedsskattelov22A(grundlag = personskat_virksomhedskapital_scenarie_par22a_ægtefælleperson()))),
    [personskat_virksomhedskapital_scenarie_ordinær_virksomhed]
))
= personskat_virksomhedskapital_scenarie_personskat_uden = beregn_personskat(personskat_virksomhedskapital_scenarie_personskatinput(
    personskat_ingen_kapitalindkomst()
))

| personskat_virksomhedskapital_scenarie_afledt_par22a_personlig_indkomst_kroner(resultat: PersonskatBeregningResultat) -> match resultat.kapitalindkomst.virksomhedskapital_resultat.kapitalafkastordning {
    | OpgjortKapitalafkastEfterVirksomhedsskattelov22A(beregning) -> beregning.afledt_par22a_input.skattepligtig.personlig_nettoindkomst_fra_selvstændig_erhvervsvirksomhed_kroner
    | IntetKapitalafkastEfterVirksomhedsskattelov22A -> 0
}
| personskat_virksomhedskapital_scenarie_afledt_par22a_ægtefælleindkomst_kroner(resultat: PersonskatBeregningResultat) -> match resultat.kapitalindkomst.virksomhedskapital_resultat.kapitalafkastordning {
    | OpgjortKapitalafkastEfterVirksomhedsskattelov22A(beregning) -> match beregning.afledt_par22a_input.ægtefælle {
        | Vsl22AGiftOgSamlevendeVedIndkomståretsUdgang(grundlag) -> grundlag.personlig_nettoindkomst_fra_selvstændig_erhvervsvirksomhed_kroner
        | Vsl22AIkkeGiftEllerIkkeSamlevendeVedIndkomståretsUdgang -> 0
    }
    | IntetKapitalafkastEfterVirksomhedsskattelov22A -> 0
}

