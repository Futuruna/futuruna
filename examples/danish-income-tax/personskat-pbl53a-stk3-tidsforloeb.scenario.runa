    | _ -> Falskt
}
| pbl53a_stk3_negativt_afkast_følger_stabil_ordning: pbl53a_stk3_gyldigt_resultat -> match pbl53a_stk3_gyldigt_resultat.ordningsresultater[4] {
    | BeregnetPbl53AOrdning(fakta, _, pensionsbeskatningslov_input, pensionsbeskatningslov_resultat, _, _, _, _, _, _, _, afkastforløbsresultat) -> fakta.identifikation == "negativt-flerår" && afkastforløbsresultat.ordningsidentifikation_stabil && pensionsbeskatningslov_input.metodehistorik == Pbl53ATidligerePalOpgørelse && pensionsbeskatningslov_input.fremført_negativt_afkast_primo_kroner == 10000 && pensionsbeskatningslov_resultat.fremført_negativt_afkast_anvendt_kroner == 6000 && pensionsbeskatningslov_resultat.skattepligtigt_afkast_kroner == 0 && afkastforløbsresultat.fremført_negativt_afkast_ultimo_kroner == 4000
    | _ -> Falskt
}
| pbl53a_stk3_afkastskattefrist_afledes_pr_udbetaling: pbl53a_stk3_gyldigt_resultat -> match pbl53a_stk3_gyldigt_resultat.ordningsresultater[5] {
    | BeregnetPbl53AOrdning(_, _, _, pensionsbeskatningslov_resultat, _, _, _, forløbsresultat, _, par3_resultat, _, _) -> forløbsresultat.personlig_indkomst_kroner == 5000 && pensionsbeskatningslov_resultat.udbetaling_til_afkastskat_medregnes_kroner == 5000 && par3_resultat.personlig_indkomst_kroner == 5000 && match forløbsresultat.hændelsesresultater[1] {
        | Pbl53AUdbetalingBeregnet(rettidig) -> rettidig.afkastskatteudbetaling_rettidig && rettidig.principal_fordelt_til_udbetalingen_kroner == 5000 && rettidig.principal_medregnet_før_75_procent_kroner == 0 && match forløbsresultat.hændelsesresultater[2] {
            | Pbl53AUdbetalingBeregnet(for_sen) -> for_sen.afkastskatteudbetaling_rettidig == Falskt && for_sen.principal_fordelt_til_udbetalingen_kroner == 5000 && for_sen.personlig_indkomst_kroner == 5000
            | _ -> Falskt
        }
        | _ -> Falskt
    }
    | _ -> Falskt
}
| pbl53a_stk3_gyldige_forløb_samles: pbl53a_stk3_gyldigt_resultat -> pbl53a_stk3_gyldigt_resultat.alle_input_gyldige && length(pbl53a_stk3_gyldigt_resultat.kapitalposter) == 5 && pbl53a_stk3_gyldigt_resultat.personlig_indkomst_kroner == 5000
| pbl53a_stk3_ikke_sammenhængende_perioder_fejler_lukket: pbl53a_stk3_ikke_sammenhængende_resultat -> pbl53a_stk3_ikke_sammenhængende_resultat.alle_input_gyldige == Falskt && length(pbl53a_stk3_ikke_sammenhængende_resultat.kapitalposter) == 0 && match pbl53a_stk3_ikke_sammenhængende_resultat.ordningsresultater[0] {
    | UgyldigtPbl53AGrundlag(_, _, _, _, _, _, _, _, _, afkastforløbsresultat) -> pbl53a_afkastårsresultat_for_indkomstår(afkastforløbsresultat, 2026).periode_resultat.periode_understøttet == Falskt
    | _ -> Falskt
}
| pbl53a_stk3_år_uden_skattepligt_beskatter_ikke_pal_afkast: pbl53a_stk3_uden_skattepligt_resultat -> pbl53a_stk3_uden_skattepligt_resultat.alle_input_gyldige && length(pbl53a_stk3_uden_skattepligt_resultat.kapitalposter) == 0 && match pbl53a_stk3_uden_skattepligt_resultat.ordningsresultater[0] {
