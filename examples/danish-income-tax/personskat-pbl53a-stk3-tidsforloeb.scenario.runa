    | _ -> Falskt
}
| pbl53a_stk3_udeladt_mellemår_fejler_lukket: pbl53a_stk3_årshul_resultat -> pbl53a_stk3_årshul_resultat.alle_input_gyldige == Falskt && length(pbl53a_stk3_årshul_resultat.kapitalposter) == 0 && match pbl53a_stk3_årshul_resultat.ordningsresultater[0] {
    | UgyldigtPbl53AGrundlag(_, _, _, _, _, _, _, _, _, afkastforløbsresultat) -> afkastforløbsresultat.år_kronologiske && afkastforløbsresultat.år_sammenhængende == Falskt && pbl53a_afkastårsresultat_for_indkomstår(afkastforløbsresultat, 2026).år_sammenhængende == Falskt
    | _ -> Falskt
}
| pbl53a_stk3_år_uden_skattepligt_bevarer_metode_og_tab: pbl53a_stk3_neutralt_mellemår_resultat -> pbl53a_stk3_neutralt_mellemår_resultat.alle_input_gyldige && length(pbl53a_stk3_neutralt_mellemår_resultat.kapitalposter) == 0 && match pbl53a_stk3_neutralt_mellemår_resultat.ordningsresultater[0] {
    | BeregnetPbl53AOrdning(_, _, pensionsbeskatningslov_input, pensionsbeskatningslov_resultat, _, _, _, _, _, _, _, afkastforløbsresultat) -> pensionsbeskatningslov_input.metodehistorik == Pbl53ATidligerePalOpgørelse && pensionsbeskatningslov_input.fremført_negativt_afkast_primo_kroner == 10000 && pensionsbeskatningslov_resultat.fremført_negativt_afkast_anvendt_kroner == 6000 && pensionsbeskatningslov_resultat.skattepligtigt_afkast_kroner == 0 && afkastforløbsresultat.metodetilstand_ultimo == Pbl53APalMetodeValgt && afkastforløbsresultat.fremført_negativt_afkast_ultimo_kroner == 4000
    | _ -> Falskt
