@ sprog da

@ importer ./personskat - income - cliffs.audit

-- Minimal exact-exhaustion probe for the experimental Explore runner.
-- The domain has six income points and therefore five eligible 1-DKK
-- transitions. The existing audit remains the independent result oracle.

| personskat_probe_overgang(indkomst_før_kroner: Heltal) -> personskat_indkomstklint_overgang(
    personskat_indkomstklint_københavn_60_profil,
    indkomst_før_kroner
)

| personskat_probe_er_indkomstklint(indkomst_før_kroner: Heltal, trin: Heltal) -> {
    = overgang = personskat_probe_overgang(indkomst_før_kroner)
    trin == 1 && overgang.ligningsfradrag_input_gyldige && overgang.netto_efter_øre < overgang.netto_før_øre
}

| personskat_probe_nettotab_øre(indkomst_før_kroner: Heltal) -> personskat_probe_overgang(indkomst_før_kroner).nettotab_øre

| personskat_probe_input_gyldige(indkomst_før_kroner: Heltal) -> personskat_probe_overgang(indkomst_før_kroner).ligningsfradrag_input_gyldige

? explore personskat_indkomstklint_minimal {
    over personskat_probe_er_indkomstklint(indkomst_før_kroner, trin)
    find matches
    bounds {
        indkomst_før_kroner in range(342495, 342501)
        trin = 1
    }
    boundaries on indkomst_før_kroner by trin
    output {
        key [
            kommunekode = 101,
            betaler_kirkeskat = Falskt,
            daglige_befordringskilometer = 60,
            indkomst_før_kroner
        ]
        show [
            indkomst_efter_kroner = indkomst_før_kroner + trin,
            nettotab_øre = personskat_probe_nettotab_øre(indkomst_før_kroner),
            ligningsfradrag_input_gyldige = personskat_probe_input_gyldige(indkomst_før_kroner)
        ]
        representative first
    }
}
