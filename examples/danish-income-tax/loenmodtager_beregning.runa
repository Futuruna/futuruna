@ sprog da

@ importer ./arbejdsmarkedsbidragsloven
@ importer ./kommuneskatteloven
@ importer ./folkekirkens - oekonomi
@ importer ./ligningsloven_fradrag
@ importer ./skatteaar - parametre
@ importer ./kapitel - 02 - statsskat
@ importer ./kapitel - 03 - personfradrag
@ importer ./kapitel - 04 - omregning - skatteloft
@ importer ./pengebeloeb

-- Personskatteloven — ordinær lønmodtagerberegning, første fixture-slice.
--
-- Kilder:
-- Personskatteloven, LBK nr. 1284 af 14/06/2021.
-- https://www.retsinformation.dk/eli/lta/2021/1284

----
§ 3, stk. 2. Ved opgørelsen af den personlige indkomst fradrages
6) arbejdsmarkedsbidrag og obligatoriske udenlandske sociale bidrag i samme
omfang som nævnt i ligningslovens § 8 M,
----

# LønmodtagerInput(skatteår: Heltal, kommune: Kommune, bruttoløn_kroner: Heltal, positiv_nettokapitalindkomst_kroner: Heltal, ligningsmæssige_fradrag_kroner: Heltal, personfradrag_alder_status: PersonfradragAlderStatus, betaler_kirkeskat: Boolsk)
# LønmodtagerSkatteloftResult(input: Par19SkatteloftInput, overskydende_basispoint: Heltal, nedslag_kroner: Heltal)
# LønmodtagerIndkomstgrundlag(skatteår: Heltal, kommune: Kommune, bruttoløn_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal, personlig_indkomst_efter_am_kroner: Heltal, positiv_nettokapitalindkomst_kroner: Heltal, almindelig_skattepligtig_indkomst_kroner: Heltal)
# LønmodtagerLigningsfradrag(beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, øvrige_ligningsmæssige_fradrag_kroner: Heltal, samlede_ligningsmæssige_fradrag_kroner: Heltal)
# LønmodtagerSkattekomponenter(bundskat_kroner: Heltal, mellemskat_kroner: Heltal, topskat_kroner: Heltal, toptopskat_kroner: Heltal, kommuneskat_kroner: Heltal, kirkeskat_kroner: Heltal, statslig_indkomstskat_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_kroner: Heltal, samlet_indkomstskat_kroner: Heltal, samlet_inkl_am_kroner: Heltal)
# LønmodtagerPersonfradragResultat(personfradrag_kroner: Heltal, statslig_skatteværdi_kroner: Heltal, kommunal_skatteværdi_kroner: Heltal, kirkelig_skatteværdi_kroner: Heltal)
# LønmodtagerSlutskat(personligt_skatteloft: LønmodtagerSkatteloftResult, positiv_kapital_skatteloft: LønmodtagerSkatteloftResult, samlet_skatteloftsnedslag_kroner: Heltal, statslig_indkomstskat_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_kroner: Heltal, samlet_indkomstskat_kroner: Heltal, samlet_inkl_am_kroner: Heltal)
# LønmodtagerBeregning(input: LønmodtagerInput, indkomstgrundlag: LønmodtagerIndkomstgrundlag, ligningsfradrag: LønmodtagerLigningsfradrag, før_personfradrag: LønmodtagerSkattekomponenter, personfradrag: LønmodtagerPersonfradragResultat, efter_personfradrag_før_skatteloft: LønmodtagerSkattekomponenter, slutskat: LønmodtagerSlutskat, personfradrag_anvendt_i_slutskat: Boolsk, kræver_par13_underskud: Boolsk)
# LønmodtagerBreakdown(skatteår: Heltal, kommune: Kommune, bruttoløn_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal, personlig_indkomst_efter_am_kroner: Heltal, beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, øvrige_ligningsmæssige_fradrag_kroner: Heltal, samlede_ligningsmæssige_fradrag_kroner: Heltal, almindelig_skattepligtig_indkomst_kroner: Heltal, bundskat_før_personfradrag_kroner: Heltal, mellemskat_før_personfradrag_kroner: Heltal, topskat_før_personfradrag_kroner: Heltal, toptopskat_før_personfradrag_kroner: Heltal, kommuneskat_før_personfradrag_kroner: Heltal, kirkeskat_før_personfradrag_kroner: Heltal, statslig_indkomstskat_før_personfradrag_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_før_personfradrag_kroner: Heltal, samlet_indkomstskat_før_personfradrag_kroner: Heltal, samlet_inkl_am_før_personfradrag_kroner: Heltal, personfradrag_kroner: Heltal, statslig_personfradrag_skatteværdi_kroner: Heltal, kommunal_personfradrag_skatteværdi_kroner: Heltal, kirkelig_personfradrag_skatteværdi_kroner: Heltal, personligt_skatteloft: LønmodtagerSkatteloftResult, positiv_kapital_skatteloft: LønmodtagerSkatteloftResult, statslig_indkomstskat_efter_personfradrag_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner: Heltal, samlet_indkomstskat_efter_personfradrag_kroner: Heltal, samlet_inkl_am_efter_personfradrag_kroner: Heltal, personfradrag_anvendt_i_slutskat: Boolsk, kræver_par13_underskud: Boolsk)

| skat_i_kroner(beløb_kroner: Heltal, sats_basispoint: Heltal) -> penge_beløb_gange_basispoint_kroner(beløb_kroner, sats_basispoint)
| positivt_beløb(beløb_kroner: Heltal) -> penge_positivt_beløb(beløb_kroner)
| arbejdsmarkedsbidrag_input_for(input: LønmodtagerInput) -> ArbejdsmarkedsbidragInput(input.bruttoløn_kroner, 0)
| arbejdsmarkedsbidrag_for(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_lønmodtager_kroner(arbejdsmarkedsbidrag_input_for(input))
| personlig_indkomst_efter_am(input: LønmodtagerInput) -> input.bruttoløn_kroner - arbejdsmarkedsbidrag_for(input)
| ligningslov_fradrag_input_for(input: LønmodtagerInput) -> LigningslovLønmodtagerFradragInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.bruttoløn_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = Falskt
)
| beskæftigelsesfradrag_for(input: LønmodtagerInput) -> ll_lønmodtager_beskæftigelsesfradrag_kroner(ligningslov_fradrag_input_for(input))
| jobfradrag_for(input: LønmodtagerInput) -> ll_lønmodtager_jobfradrag_kroner(ligningslov_fradrag_input_for(input))
| standard_ligningsmæssige_fradrag_for(input: LønmodtagerInput) -> ll_lønmodtager_standardfradrag_kroner(ligningslov_fradrag_input_for(input))
| samlede_ligningsmæssige_fradrag_for(input: LønmodtagerInput) -> standard_ligningsmæssige_fradrag_for(input) + input.ligningsmæssige_fradrag_kroner

----
§ 1. For personer, der er skattepligtige her til landet, opgøres den
skattepligtige almindelige indkomst efter skattelovgivningens almindelige
regler med de ændringer, der følger af denne lov.
----

| almindelig_skattepligtig_indkomst_fixture(input: LønmodtagerInput) -> personlig_indkomst_efter_am(input) + input.positiv_nettokapitalindkomst_kroner - samlede_ligningsmæssige_fradrag_for(input)

----
§ 6. Skatten efter § 5, nr. 1, beregnes med den procent, der anføres i stk. 2,
af den personlige indkomst med tillæg af positiv nettokapitalindkomst.
----

| bundskat_grundlag_fixture(input: LønmodtagerInput) -> personlig_indkomst_efter_am(input) + input.positiv_nettokapitalindkomst_kroner
| bundskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(bundskat_grundlag_fixture(input), nationalparametre_for(input.skatteår).bundskat_basispoint)

----
§ 7. Skatten efter § 5, nr. 2, udgør 15 pct. af den personlige indkomst med
tillæg af heri fradragne og ikke medregnede beløb omfattet af beløbsgrænsen i
pensionsbeskatningslovens § 16, stk. 1, 4. pkt., og med tillæg af positiv
nettokapitalindkomst, der overstiger et grundbeløb på 40.000 kr. (2010-niveau),
i det omfang det samlede beløb overstiger bundfradraget anført i stk. 2.
----

| topskat_personligt_overskud_fixture(input: LønmodtagerInput) -> positivt_beløb(personlig_indkomst_efter_am(input) - nationalparametre_for(input.skatteår).topskattegrænse_efter_am_kroner)
| progressiv_kapital_over_bundfradrag(input: LønmodtagerInput) -> positivt_beløb(input.positiv_nettokapitalindkomst_kroner - nationalparametre_for(input.skatteår).positiv_nettokapital_progressiv_bundfradrag_kroner)
| topskat_grundlag_med_kapital_fixture(input: LønmodtagerInput) -> positivt_beløb(personlig_indkomst_efter_am(input) + progressiv_kapital_over_bundfradrag(input) - nationalparametre_for(input.skatteår).topskattegrænse_efter_am_kroner)
| topskat_kapitalgrundlag_fixture(input: LønmodtagerInput) -> positivt_beløb(topskat_grundlag_med_kapital_fixture(input) - topskat_personligt_overskud_fixture(input))
| topskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(topskat_grundlag_med_kapital_fixture(input), nationalparametre_for(input.skatteår).topskat_basispoint)
| exception topskat_2026_kun_personlig topskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(topskat_personligt_overskud_fixture(input), nationalparametre_for(input.skatteår).topskat_basispoint) under input.skatteår >= 2026

----
LOV nr. 482 af 22/05/2024 ændrer fra og med indkomståret 2026 statsskatten til
bundskat, mellemskat, topskat og toptopskat. Skattestyrelsens 2026-satser
angiver mellemskattegrænse efter am-bidrag 641.200 kr., topskattegrænse
777.900 kr., toptopskattegrænse 2.592.700 kr. og bundfradrag i positiv
nettokapitalindkomst i mellemskattegrundlaget 55.000 kr.
----

| mellemskat_input_for(input: LønmodtagerInput) -> MellemskatKapitalInput(personlig_indkomst_efter_am(input), input.positiv_nettokapitalindkomst_kroner, nationalparametre_for(input.skatteår).positiv_nettokapital_progressiv_bundfradrag_kroner, nationalparametre_for(input.skatteår).mellemskattegrænse_efter_am_kroner, nationalparametre_for(input.skatteår).mellemskat_basispoint)
| mellemskat_personligt_grundlag_for(input: LønmodtagerInput) -> progressiv_personlig_overskud_kroner(reform_statskat_input(MellemskatLag, input.skatteår, personlig_indkomst_efter_am(input)))
| mellemskat_kapitalgrundlag_for(input: LønmodtagerInput) -> positivt_beløb(mellemskat_grundlag_med_kapital_kroner(mellemskat_input_for(input)) - mellemskat_personligt_grundlag_for(input))
| mellemskat_før_personfradrag(input: LønmodtagerInput) -> 0
| exception mellemskat_2026 mellemskat_før_personfradrag(input: LønmodtagerInput) -> mellemskat_med_kapital_kroner(mellemskat_input_for(input)) under input.skatteår == 2026
| toptopskat_personligt_overskud_fixture(input: LønmodtagerInput) -> 0
| exception toptopskat_2026 toptopskat_personligt_overskud_fixture(input: LønmodtagerInput) -> positivt_beløb(personlig_indkomst_efter_am(input) - nationalparametre_for(input.skatteår).toptopskattegrænse_efter_am_kroner) under input.skatteår == 2026
| toptopskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(toptopskat_personligt_overskud_fixture(input), nationalparametre_for(input.skatteår).toptopskat_basispoint)

----
Skatteministeriet, "Oversigt over kommuneskatter"
Tabelkolonner: Kommunenavn, År, Kommuneskat, Kirkeskat, Sundhedsbidrag,
Bundskat, I alt, Skatteloftsnedslag, Grundskyldspromille (Kommune).
----

| kommuneskat_input_for(input: LønmodtagerInput) -> KommunalIndkomstskatInput(
    skattepligtig_indkomst_kroner = almindelig_skattepligtig_indkomst_fixture(input),
    udskrivningsprocent_basispoint = kommunale_parametre_for(input.skatteår, input.kommune).kommuneskat_basispoint
)
| kirkeskat_input_for(input: LønmodtagerInput) -> KirkeskatInput(
    skattepligtig_indkomst_kroner = almindelig_skattepligtig_indkomst_fixture(input),
    kirkelig_ligningsprocent_basispoint = kommunale_parametre_for(input.skatteår, input.kommune).kirkeskat_basispoint,
    folkekirkemedlem = input.betaler_kirkeskat
)
| kirkeskat_sats_for(input: LønmodtagerInput) -> kirkeskat_sats_basispoint(kirkeskat_input_for(input))
| kommuneskat_før_personfradrag(input: LønmodtagerInput) -> kommunal_indkomstskat_før_personfradrag_kroner(kommuneskat_input_for(input))
| kirkeskat_før_personfradrag(input: LønmodtagerInput) -> kirkeskat_før_personfradrag_kroner(kirkeskat_input_for(input))

----
§ 9. Indkomstskatten efter §§ 6, 7, 7 a og 8 og § 8 a, stk. 2, til staten skal,
efter at skattebeløbene er reguleret efter § 13, nedsættes med skatteværdien af
personfradrag. Personfradrag opgøres efter § 10 og skatteværdien heraf efter
§ 12.
----

| personfradrag_for(input: LønmodtagerInput) -> personfradrag_beløb_for(input.skatteår, input.personfradrag_alder_status)
| personfradrag_skatteværdi_input(input: LønmodtagerInput) -> PersonfradragSkatteværdiInput(personfradrag_for(input), nationalparametre_for(input.skatteår).bundskat_basispoint, kommunale_parametre_for(input.skatteår, input.kommune).sundhedsbidrag_basispoint, kommunale_parametre_for(input.skatteår, input.kommune).kommuneskat_basispoint, kirkeskat_sats_for(input), 0)
| statslig_personfradrag_skatteværdi_for(input: LønmodtagerInput) -> personfradrag_statslig_skatteværdi(personfradrag_skatteværdi_input(input))
| kommunal_personfradrag_skatteværdi_for(input: LønmodtagerInput) -> personfradrag_kommunal_skatteværdi(personfradrag_skatteværdi_input(input))
| kirkelig_personfradrag_skatteværdi_for(input: LønmodtagerInput) -> personfradrag_kirkelig_skatteværdi(personfradrag_skatteværdi_input(input))
| statslig_indkomstskat_før_personfradrag(input: LønmodtagerInput) -> bundskat_før_personfradrag(input) + mellemskat_før_personfradrag(input) + topskat_før_personfradrag(input) + toptopskat_før_personfradrag(input)
| kommunal_og_kirkelig_indkomstskat_før_personfradrag(input: LønmodtagerInput) -> kommuneskat_før_personfradrag(input) + kirkeskat_før_personfradrag(input)
| samlet_indkomstskat_før_personfradrag(input: LønmodtagerInput) -> statslig_indkomstskat_før_personfradrag(input) + kommunal_og_kirkelig_indkomstskat_før_personfradrag(input)
| samlet_inkl_am_før_personfradrag(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_for(input) + samlet_indkomstskat_før_personfradrag(input)
| bundskat_efter_personfradrag(input: LønmodtagerInput) -> skat_efter_nedsættelse(bundskat_før_personfradrag(input), statslig_personfradrag_skatteværdi_for(input))
| kommuneskat_efter_personfradrag(input: LønmodtagerInput) -> skat_efter_nedsættelse(kommuneskat_før_personfradrag(input), kommunal_personfradrag_skatteværdi_for(input))
| kirkeskat_efter_personfradrag(input: LønmodtagerInput) -> skat_efter_nedsættelse(kirkeskat_før_personfradrag(input), kirkelig_personfradrag_skatteværdi_for(input))
| statslig_indkomstskat_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> bundskat_efter_personfradrag(input) + mellemskat_før_personfradrag(input) + topskat_før_personfradrag(input) + toptopskat_før_personfradrag(input)
| kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input: LønmodtagerInput) -> kommuneskat_efter_personfradrag(input) + kirkeskat_efter_personfradrag(input)
| samlet_indkomstskat_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> statslig_indkomstskat_efter_personfradrag_før_skatteloft(input) + kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input)
| samlet_inkl_am_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_for(input) + samlet_indkomstskat_efter_personfradrag_før_skatteloft(input)

----
§ 19. Hvis summen af skatteprocenterne efter §§ 6, 7 og 8 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger den procent, der er anført i 2.-6. pkt., beregnes et
nedslag i statsskatten svarende til, at skatteprocenten ved beregningen af
skatten efter § 7, stk. 3 og 7, blev nedsat med de overskydende procenter.
For indkomstårene 2015-2017 udgør procenten 51,95.
For indkomståret 2018 udgør procenten 52,02.
For indkomståret 2019 udgør procenten 52,05.
For indkomstårene 2020 og 2021 udgør procenten 52,06.
For indkomståret 2022 og efterfølgende indkomstår udgør procenten 52,07.

LOV nr. 482 af 22/05/2024, § 1, nr. 15.

§ 19 affattes således:

§ 19. Hvis summen af skatteprocenterne efter §§ 6 og 7 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger 44,57 pct., beregnes et nedslag i statsskatten, svarende
til at skatteprocenten ved beregningen af skatten efter § 7, stk. 3 og 7, blev
nedsat med de overskydende procenter.

Stk. 2. Hvis summen af skatteprocenterne efter §§ 6 og 7 tillagt den
skattepligtiges kommunale indkomstskatteprocent henholdsvis skatteprocenten
efter § 8 c overstiger 42,0 pct., beregnes et nedslag i statsskatten, svarende
til at skatteprocenten ved beregningen af skatten efter § 7, stk. 4 og 8-11, blev
nedsat med de overskydende procenter.
----

| lønmodtager_personligt_skatteloft_beregningsgrundlag(input: LønmodtagerInput) -> topskat_personligt_overskud_fixture(input) under input.skatteår < 2026
| exception reform_mellemskat_personligt_skatteloftgrundlag lønmodtager_personligt_skatteloft_beregningsgrundlag(input: LønmodtagerInput) -> progressiv_personlig_overskud_kroner(reform_statskat_input(MellemskatLag, input.skatteår, personlig_indkomst_efter_am(input))) under input.skatteår >= 2026
| lønmodtager_personligt_skatteloft_input_for(input: LønmodtagerInput) -> par19_personlig_skatteloft_input_for(input.skatteår, input.kommune, lønmodtager_personligt_skatteloft_beregningsgrundlag(input))
| lønmodtager_personligt_skatteloft_overskydende_basispoint(input: LønmodtagerInput) -> par19_personlig_overskydende_basispoint(lønmodtager_personligt_skatteloft_input_for(input))
| lønmodtager_personligt_skatteloft_nedslag_kroner(input: LønmodtagerInput) -> par19_skatteloftsnedslag_kroner(lønmodtager_personligt_skatteloft_input_for(input), lønmodtager_personligt_skatteloft_overskydende_basispoint(input))
| lønmodtager_personligt_skatteloft_resultat(input: LønmodtagerInput) -> LønmodtagerSkatteloftResult(
    input = lønmodtager_personligt_skatteloft_input_for(input),
    overskydende_basispoint = lønmodtager_personligt_skatteloft_overskydende_basispoint(input),
    nedslag_kroner = lønmodtager_personligt_skatteloft_nedslag_kroner(input)
)
| lønmodtager_positiv_kapital_skatteloft_beregningsgrundlag(input: LønmodtagerInput) -> topskat_kapitalgrundlag_fixture(input) under input.skatteår < 2026
| exception reform_mellemskat_positiv_kapital_skatteloftgrundlag lønmodtager_positiv_kapital_skatteloft_beregningsgrundlag(input: LønmodtagerInput) -> mellemskat_kapitalgrundlag_for(input) under input.skatteår >= 2026
| lønmodtager_positiv_kapital_skatteloft_input_for(input: LønmodtagerInput) -> par19_positiv_kapital_skatteloft_input_for(input.skatteår, input.kommune, lønmodtager_positiv_kapital_skatteloft_beregningsgrundlag(input))
| lønmodtager_positiv_kapital_skatteloft_overskydende_basispoint(input: LønmodtagerInput) -> par19_positiv_kapital_overskydende_basispoint(lønmodtager_positiv_kapital_skatteloft_input_for(input))
| lønmodtager_positiv_kapital_skatteloft_nedslag_kroner(input: LønmodtagerInput) -> par19_skatteloftsnedslag_kroner(lønmodtager_positiv_kapital_skatteloft_input_for(input), lønmodtager_positiv_kapital_skatteloft_overskydende_basispoint(input))
| lønmodtager_positiv_kapital_skatteloft_resultat(input: LønmodtagerInput) -> LønmodtagerSkatteloftResult(
    input = lønmodtager_positiv_kapital_skatteloft_input_for(input),
    overskydende_basispoint = lønmodtager_positiv_kapital_skatteloft_overskydende_basispoint(input),
    nedslag_kroner = lønmodtager_positiv_kapital_skatteloft_nedslag_kroner(input)
)
| statslig_indkomstskat_efter_personfradrag(input: LønmodtagerInput) -> positivt_beløb(statslig_indkomstskat_efter_personfradrag_før_skatteloft(input) - lønmodtager_personligt_skatteloft_nedslag_kroner(input) - lønmodtager_positiv_kapital_skatteloft_nedslag_kroner(input))
| samlet_indkomstskat_efter_personfradrag(input: LønmodtagerInput) -> statslig_indkomstskat_efter_personfradrag(input) + kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input)
| samlet_inkl_am_efter_personfradrag(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_for(input) + samlet_indkomstskat_efter_personfradrag(input)
| par13_underskud_input_for(input: LønmodtagerInput) -> Par13UnderskudInput(
    skattepligtig_indkomst_kroner = almindelig_skattepligtig_indkomst_fixture(input),
    personlig_indkomst_kroner = personlig_indkomst_efter_am(input),
    positiv_kapitalindkomst_kroner = input.positiv_nettokapitalindkomst_kroner,
    gift_samlevende_ved_årets_udløb = Falskt
)
| kræver_par13_underskud_fixture(input: LønmodtagerInput) -> par13_kræver_underskudsbehandling(par13_underskud_input_for(input))
| personfradrag_anvendt_i_slutskat_fixture(input: LønmodtagerInput) -> kræver_par13_underskud_fixture(input) == Falskt
| lønmodtager_indkomstgrundlag(input: LønmodtagerInput) -> LønmodtagerIndkomstgrundlag(
    skatteår = input.skatteår,
    kommune = input.kommune,
    bruttoløn_kroner = input.bruttoløn_kroner,
    arbejdsmarkedsbidrag_kroner = arbejdsmarkedsbidrag_for(input),
    personlig_indkomst_efter_am_kroner = personlig_indkomst_efter_am(input),
    positiv_nettokapitalindkomst_kroner = input.positiv_nettokapitalindkomst_kroner,
    almindelig_skattepligtig_indkomst_kroner = almindelig_skattepligtig_indkomst_fixture(input)
)
| lønmodtager_ligningsfradrag(input: LønmodtagerInput) -> LønmodtagerLigningsfradrag(
    beskæftigelsesfradrag_kroner = beskæftigelsesfradrag_for(input),
    jobfradrag_kroner = jobfradrag_for(input),
    øvrige_ligningsmæssige_fradrag_kroner = input.ligningsmæssige_fradrag_kroner,
    samlede_ligningsmæssige_fradrag_kroner = samlede_ligningsmæssige_fradrag_for(input)
)
| lønmodtager_skat_før_personfradrag(input: LønmodtagerInput) -> LønmodtagerSkattekomponenter(
    bundskat_kroner = bundskat_før_personfradrag(input),
    mellemskat_kroner = mellemskat_før_personfradrag(input),
    topskat_kroner = topskat_før_personfradrag(input),
    toptopskat_kroner = toptopskat_før_personfradrag(input),
    kommuneskat_kroner = kommuneskat_før_personfradrag(input),
    kirkeskat_kroner = kirkeskat_før_personfradrag(input),
    statslig_indkomstskat_kroner = statslig_indkomstskat_før_personfradrag(input),
    kommunal_og_kirkelig_indkomstskat_kroner = kommunal_og_kirkelig_indkomstskat_før_personfradrag(input),
    samlet_indkomstskat_kroner = samlet_indkomstskat_før_personfradrag(input),
    samlet_inkl_am_kroner = samlet_inkl_am_før_personfradrag(input)
)
| lønmodtager_personfradrag_resultat(input: LønmodtagerInput) -> LønmodtagerPersonfradragResultat(
    personfradrag_kroner = personfradrag_for(input),
    statslig_skatteværdi_kroner = statslig_personfradrag_skatteværdi_for(input),
    kommunal_skatteværdi_kroner = kommunal_personfradrag_skatteværdi_for(input),
    kirkelig_skatteværdi_kroner = kirkelig_personfradrag_skatteværdi_for(input)
)
| lønmodtager_skat_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> LønmodtagerSkattekomponenter(
    bundskat_kroner = bundskat_efter_personfradrag(input),
    mellemskat_kroner = mellemskat_før_personfradrag(input),
    topskat_kroner = topskat_før_personfradrag(input),
    toptopskat_kroner = toptopskat_før_personfradrag(input),
    kommuneskat_kroner = kommuneskat_efter_personfradrag(input),
    kirkeskat_kroner = kirkeskat_efter_personfradrag(input),
    statslig_indkomstskat_kroner = statslig_indkomstskat_efter_personfradrag_før_skatteloft(input),
    kommunal_og_kirkelig_indkomstskat_kroner = kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input),
    samlet_indkomstskat_kroner = samlet_indkomstskat_efter_personfradrag_før_skatteloft(input),
    samlet_inkl_am_kroner = samlet_inkl_am_efter_personfradrag_før_skatteloft(input)
)
| lønmodtager_skatteloftsnedslag_i_alt(input: LønmodtagerInput) -> lønmodtager_personligt_skatteloft_nedslag_kroner(input) + lønmodtager_positiv_kapital_skatteloft_nedslag_kroner(input)
| lønmodtager_slutskat(input: LønmodtagerInput) -> LønmodtagerSlutskat(
    personligt_skatteloft = lønmodtager_personligt_skatteloft_resultat(input),
    positiv_kapital_skatteloft = lønmodtager_positiv_kapital_skatteloft_resultat(input),
    samlet_skatteloftsnedslag_kroner = lønmodtager_skatteloftsnedslag_i_alt(input),
    statslig_indkomstskat_kroner = statslig_indkomstskat_efter_personfradrag(input),
    kommunal_og_kirkelig_indkomstskat_kroner = kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input),
    samlet_indkomstskat_kroner = samlet_indkomstskat_efter_personfradrag(input),
    samlet_inkl_am_kroner = samlet_inkl_am_efter_personfradrag(input)
)
| beregn_lønmodtager_model(input: LønmodtagerInput) -> LønmodtagerBeregning(
    input = input,
    indkomstgrundlag = lønmodtager_indkomstgrundlag(input),
    ligningsfradrag = lønmodtager_ligningsfradrag(input),
    før_personfradrag = lønmodtager_skat_før_personfradrag(input),
    personfradrag = lønmodtager_personfradrag_resultat(input),
    efter_personfradrag_før_skatteloft = lønmodtager_skat_efter_personfradrag_før_skatteloft(input),
    slutskat = lønmodtager_slutskat(input),
    personfradrag_anvendt_i_slutskat = personfradrag_anvendt_i_slutskat_fixture(input),
    kræver_par13_underskud = kræver_par13_underskud_fixture(input)
)
| lønmodtager_breakdown_fra_model(model: LønmodtagerBeregning) -> LønmodtagerBreakdown(
    skatteår = model.input.skatteår,
    kommune = model.input.kommune,
    bruttoløn_kroner = model.input.bruttoløn_kroner,
    arbejdsmarkedsbidrag_kroner = model.indkomstgrundlag.arbejdsmarkedsbidrag_kroner,
    personlig_indkomst_efter_am_kroner = model.indkomstgrundlag.personlig_indkomst_efter_am_kroner,
    beskæftigelsesfradrag_kroner = model.ligningsfradrag.beskæftigelsesfradrag_kroner,
    jobfradrag_kroner = model.ligningsfradrag.jobfradrag_kroner,
    øvrige_ligningsmæssige_fradrag_kroner = model.ligningsfradrag.øvrige_ligningsmæssige_fradrag_kroner,
    samlede_ligningsmæssige_fradrag_kroner = model.ligningsfradrag.samlede_ligningsmæssige_fradrag_kroner,
    almindelig_skattepligtig_indkomst_kroner = model.indkomstgrundlag.almindelig_skattepligtig_indkomst_kroner,
    bundskat_før_personfradrag_kroner = model.før_personfradrag.bundskat_kroner,
    mellemskat_før_personfradrag_kroner = model.før_personfradrag.mellemskat_kroner,
    topskat_før_personfradrag_kroner = model.før_personfradrag.topskat_kroner,
    toptopskat_før_personfradrag_kroner = model.før_personfradrag.toptopskat_kroner,
    kommuneskat_før_personfradrag_kroner = model.før_personfradrag.kommuneskat_kroner,
    kirkeskat_før_personfradrag_kroner = model.før_personfradrag.kirkeskat_kroner,
    statslig_indkomstskat_før_personfradrag_kroner = model.før_personfradrag.statslig_indkomstskat_kroner,
    kommunal_og_kirkelig_indkomstskat_før_personfradrag_kroner = model.før_personfradrag.kommunal_og_kirkelig_indkomstskat_kroner,
    samlet_indkomstskat_før_personfradrag_kroner = model.før_personfradrag.samlet_indkomstskat_kroner,
    samlet_inkl_am_før_personfradrag_kroner = model.før_personfradrag.samlet_inkl_am_kroner,
    personfradrag_kroner = model.personfradrag.personfradrag_kroner,
    statslig_personfradrag_skatteværdi_kroner = model.personfradrag.statslig_skatteværdi_kroner,
    kommunal_personfradrag_skatteværdi_kroner = model.personfradrag.kommunal_skatteværdi_kroner,
    kirkelig_personfradrag_skatteværdi_kroner = model.personfradrag.kirkelig_skatteværdi_kroner,
    personligt_skatteloft = model.slutskat.personligt_skatteloft,
    positiv_kapital_skatteloft = model.slutskat.positiv_kapital_skatteloft,
    statslig_indkomstskat_efter_personfradrag_kroner = model.slutskat.statslig_indkomstskat_kroner,
    kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner = model.slutskat.kommunal_og_kirkelig_indkomstskat_kroner,
    samlet_indkomstskat_efter_personfradrag_kroner = model.slutskat.samlet_indkomstskat_kroner,
    samlet_inkl_am_efter_personfradrag_kroner = model.slutskat.samlet_inkl_am_kroner,
    personfradrag_anvendt_i_slutskat = model.personfradrag_anvendt_i_slutskat,
    kræver_par13_underskud = model.kræver_par13_underskud
)
| beregn_lønmodtager(input: LønmodtagerInput) -> lønmodtager_breakdown_fra_model(beregn_lønmodtager_model(input))

----
§ 13. Hvis den skattepligtige indkomst udviser underskud, beregnes
skatteværdien af underskuddet med beskatningsprocenten for kommunal
indkomstskat og kirkeskat.

Stk. 4. I det omfang underskuddet ikke kan modregnes efter stk. 2 eller 3,
fradrages det i den anden ægtefælles skattepligtige indkomst.

Stk. 5. Den del af underskuddet, der svarer til en positiv personlig indkomst,
som beskattes i udlandet og ikke her i landet, kan ikke overføres til
ægtefællen. Den del af underskuddet, der svarer til udgifter, som den
skattepligtige får fradrag for i udlandet, kan ikke overføres til ægtefællen.

Stk. 6. Underskud i skattepligtig almindelig indkomst fra en virksomhed som
nævnt i § 4, stk. 1, nr. 9 eller 11, kan ikke fratrækkes i den skattepligtiges
øvrige skattepligtige indkomst, men fremføres til modregning i positiv
skattepligtig indkomst i et senere indkomstår fra samme virksomhed.
----

# Par13KompleksIndkomstgrundlag(skatteår: Heltal, skattepligtigt_underskud_kroner: Heltal, personlig_indkomst_kroner: Heltal, positiv_kapitalindkomst_kroner: Heltal)
# Par13KompleksSkatteværdiSatser(sundhedsbidrag_basispoint: Heltal, kommuneskat_basispoint: Heltal, kirkeskat_basispoint: Heltal, par8c_basispoint: Heltal, betaler_par8c: Boolsk)
# Par13KompleksModregningsskatter(par6_skat_kroner: Heltal, par7_skat_kroner: Heltal, par7a_skat_kroner: Heltal, par8a_stk2_skat_kroner: Heltal)
# Par13KompleksÆgtefælleforhold(ægtefælle_skattepligtig_indkomst_kroner: Heltal, gift_samlevende_ved_årets_udløb: Boolsk, ønsket_ægtefælleoverførsel_kroner: Heltal)
# Par13KompleksStk5Begrænsning(udenlandsk_beskattet_personlig_indkomst_kroner: Heltal, fradragsberettigede_udgifter_vedrørende_udlandsindkomst_kroner: Heltal, udgifter_fradraget_i_udlandet_kroner: Heltal, pbl16_beløb_kroner: Heltal, overførsel_efter_stk4: Boolsk, lempelsesgrundlag: Par13Stk5Lempelsesgrundlag)
# Par13KompleksVirksomhedsunderskud(virksomhedsunderskud_kroner: Heltal, positiv_indkomst_samme_virksomhed_kroner: Heltal, virksomhedsstatus: Par13VirksomhedsUnderskudStatus)
# Par13KompleksBeregningInput(indkomstgrundlag: Par13KompleksIndkomstgrundlag, skatteværdi_satser: Par13KompleksSkatteværdiSatser, modregningsskatter: Par13KompleksModregningsskatter, ægtefælleforhold: Par13KompleksÆgtefælleforhold, stk5_begrænsning: Par13KompleksStk5Begrænsning, virksomhedsunderskud: Par13KompleksVirksomhedsunderskud)
# Par13KompleksBeregningResult(skatteår: Heltal, kræver_underskudsbehandling: Boolsk, underskud_skatteværdi_kroner: Heltal, modregning: Par13ModregningResult, negativ_personlig_rest_kroner: Heltal, ægtefælleoverførsel: Par13ÆgtefælleOverførselResult, stk5_overførsel: Par13Stk5OverførselResult, virksomhedsunderskud: Par13VirksomhedsUnderskudResult)

| par13_calculator_underskud_input(input: Par13KompleksBeregningInput) -> Par13UnderskudInput(
    skattepligtig_indkomst_kroner = 0 - par13_positivt_beløb(input.indkomstgrundlag.skattepligtigt_underskud_kroner),
    personlig_indkomst_kroner = input.indkomstgrundlag.personlig_indkomst_kroner,
    positiv_kapitalindkomst_kroner = input.indkomstgrundlag.positiv_kapitalindkomst_kroner,
    gift_samlevende_ved_årets_udløb = input.ægtefælleforhold.gift_samlevende_ved_årets_udløb
)
| par13_calculator_skatteværdi_input(input: Par13KompleksBeregningInput) -> Par13UnderskudSkatteværdiInput(
    underskud_kroner = par13_positivt_beløb(input.indkomstgrundlag.skattepligtigt_underskud_kroner),
    sundhedsbidrag_basispoint = input.skatteværdi_satser.sundhedsbidrag_basispoint,
    kommuneskat_basispoint = input.skatteværdi_satser.kommuneskat_basispoint,
    kirkeskat_basispoint = input.skatteværdi_satser.kirkeskat_basispoint,
    par8c_basispoint = input.skatteværdi_satser.par8c_basispoint,
    betaler_par8c = input.skatteværdi_satser.betaler_par8c
)
| par13_calculator_modregning_input(input: Par13KompleksBeregningInput) -> Par13ModregningInput(
    skatteværdi_kroner = par13_underskud_skatteværdi_kroner(par13_calculator_skatteværdi_input(input)),
    par6_skat_kroner = input.modregningsskatter.par6_skat_kroner,
    par7_skat_kroner = input.modregningsskatter.par7_skat_kroner,
    par7a_skat_kroner = input.modregningsskatter.par7a_skat_kroner,
    par8a_stk2_skat_kroner = input.modregningsskatter.par8a_stk2_skat_kroner
)
| par13_calculator_negativ_personlig_input(input: Par13KompleksBeregningInput) -> Par13NegativPersonligInput(
    personlig_indkomst_kroner = input.indkomstgrundlag.personlig_indkomst_kroner,
    positiv_kapitalindkomst_kroner = input.indkomstgrundlag.positiv_kapitalindkomst_kroner
)
| par13_calculator_ægtefælle_input(input: Par13KompleksBeregningInput) -> Par13ÆgtefælleOverførselInput(
    ubenyttet_underskud_kroner = input.ægtefælleforhold.ønsket_ægtefælleoverførsel_kroner,
    ægtefælle_skattepligtig_indkomst_kroner = input.ægtefælleforhold.ægtefælle_skattepligtig_indkomst_kroner,
    gift_samlevende_ved_årets_udløb = input.ægtefælleforhold.gift_samlevende_ved_årets_udløb
)
| par13_calculator_stk5_input(input: Par13KompleksBeregningInput) -> Par13Stk5OverførselInput(
    skatteår = input.indkomstgrundlag.skatteår,
    ønsket_overførsel_kroner = input.ægtefælleforhold.ønsket_ægtefælleoverførsel_kroner,
    udenlandsk_beskattet_personlig_indkomst_kroner = input.stk5_begrænsning.udenlandsk_beskattet_personlig_indkomst_kroner,
    fradragsberettigede_udgifter_vedrørende_udlandsindkomst_kroner = input.stk5_begrænsning.fradragsberettigede_udgifter_vedrørende_udlandsindkomst_kroner,
    udgifter_fradraget_i_udlandet_kroner = input.stk5_begrænsning.udgifter_fradraget_i_udlandet_kroner,
    pbl16_beløb_kroner = input.stk5_begrænsning.pbl16_beløb_kroner,
    overførsel_efter_stk4 = input.stk5_begrænsning.overførsel_efter_stk4,
    lempelsesgrundlag = input.stk5_begrænsning.lempelsesgrundlag
)
| par13_calculator_virksomhed_input(input: Par13KompleksBeregningInput) -> Par13VirksomhedsUnderskudInput(
    underskud_kroner = input.virksomhedsunderskud.virksomhedsunderskud_kroner,
    positiv_indkomst_samme_virksomhed_kroner = input.virksomhedsunderskud.positiv_indkomst_samme_virksomhed_kroner,
    status = input.virksomhedsunderskud.virksomhedsstatus
)
| beregn_par13_kompleks(input: Par13KompleksBeregningInput) -> Par13KompleksBeregningResult(
    skatteår = input.indkomstgrundlag.skatteår,
    kræver_underskudsbehandling = par13_kræver_underskudsbehandling(par13_calculator_underskud_input(input)),
    underskud_skatteværdi_kroner = par13_underskud_skatteværdi_kroner(par13_calculator_skatteværdi_input(input)),
    modregning = par13_modregning_resultat(par13_calculator_modregning_input(input)),
    negativ_personlig_rest_kroner = par13_negativ_personlig_rest_kroner(par13_calculator_negativ_personlig_input(input)),
    ægtefælleoverførsel = par13_ægtefælleoverførsel_resultat(par13_calculator_ægtefælle_input(input)),
    stk5_overførsel = par13_stk5_overførsel_resultat(par13_calculator_stk5_input(input)),
    virksomhedsunderskud = par13_virksomhedsunderskud_beløbsresultat(par13_calculator_virksomhed_input(input))
)

----
§ 14. Hvis en person bliver skattepligtig, eller hvis en person ophører med at
være skattepligtig, jf. kildeskattelovens § 1, omregnes såvel den
skattepligtige indkomst som den personlige indkomst og kapitalindkomsten for det
år, hvor skattepligten indtræder eller ophører, således at beløbene kommer til
at svare til et helt års indkomster.
På grundlag af de opgjorte helårsindkomster beregnes helårsskat efter §§ 6-9.
Den beregnede helårsskat nedsættes efter forholdet mellem delårsbeløbene og
helårsbeløbene.

Stk. 3. For en person omfattet af § 10, stk. 6, omregnes såvel den
skattepligtige indkomst som den personlige indkomst og kapitalindkomsten for det
år, hvor den begrænsede skattepligt indtræder eller ophører, således at
beløbene kommer til at svare til et helt års indkomster.
På grundlag af de opgjorte helårsindkomster beregnes helårsskat efter §§ 6-9.
Den beregnede helårsskat nedsættes efter forholdet mellem delårsbeløbene og
helårsbeløbene.
----

# LønmodtagerPar14Input(skattepligtsændring: Par14Skattepligtsændring, delårs_input: LønmodtagerInput, skattepligtsdage: Heltal)
# LønmodtagerPar14Result(delår: LønmodtagerBreakdown, helår: LønmodtagerBreakdown, helårsindkomst: Par14Helårsindkomst, helårsskat_efter_par6_til_par9_kroner: Heltal, delårsskat_efter_par6_til_par9_kroner: Heltal)

| lønmodtager_par14_omregning_gælder(input: LønmodtagerPar14Input) -> par14_helårsomregning_gælder(input.skattepligtsændring)
| lønmodtager_par14_omregningsinput(input: LønmodtagerPar14Input) -> Par14OmregningInput(
    delårs_skattepligtig_indkomst_kroner = almindelig_skattepligtig_indkomst_fixture(input.delårs_input),
    delårs_personlig_indkomst_kroner = personlig_indkomst_efter_am(input.delårs_input),
    delårs_kapitalindkomst_kroner = input.delårs_input.positiv_nettokapitalindkomst_kroner,
    skattepligtsdage = input.skattepligtsdage
) under lønmodtager_par14_omregning_gælder(input)
| lønmodtager_par14_helårsindkomst(input: LønmodtagerPar14Input) -> par14_helårsindkomst(lønmodtager_par14_omregningsinput(input)) under lønmodtager_par14_omregning_gælder(input)
| lønmodtager_par14_helårs_input(input: LønmodtagerPar14Input) -> LønmodtagerInput(
    skatteår = input.delårs_input.skatteår,
    kommune = input.delårs_input.kommune,
    bruttoløn_kroner = par14_helårsbeløb(input.delårs_input.bruttoløn_kroner, input.skattepligtsdage),
    positiv_nettokapitalindkomst_kroner = lønmodtager_par14_helårsindkomst(input).kapitalindkomst_kroner,
    ligningsmæssige_fradrag_kroner = par14_helårsbeløb(input.delårs_input.ligningsmæssige_fradrag_kroner, input.skattepligtsdage),
    personfradrag_alder_status = input.delårs_input.personfradrag_alder_status,
    betaler_kirkeskat = input.delårs_input.betaler_kirkeskat
) under lønmodtager_par14_omregning_gælder(input)
| lønmodtager_par14_helårsskat_efter_par6_til_par9(input: LønmodtagerPar14Input) -> statslig_indkomstskat_efter_personfradrag(lønmodtager_par14_helårs_input(input)) under lønmodtager_par14_omregning_gælder(input)
| lønmodtager_par14_delårsskat_efter_par6_til_par9(input: LønmodtagerPar14Input) -> par14_helårsskat_nedsat_for_delår(Par14SkattenedsættelseInput(
    helårsskat_kroner = lønmodtager_par14_helårsskat_efter_par6_til_par9(input),
    delårsbeløb_kroner = almindelig_skattepligtig_indkomst_fixture(input.delårs_input),
    helårsbeløb_kroner = lønmodtager_par14_helårsindkomst(input).skattepligtig_indkomst_kroner
)) under lønmodtager_par14_omregning_gælder(input)
| beregn_lønmodtager_par14(input: LønmodtagerPar14Input) -> LønmodtagerPar14Result(
    delår = beregn_lønmodtager(input.delårs_input),
    helår = beregn_lønmodtager(lønmodtager_par14_helårs_input(input)),
    helårsindkomst = lønmodtager_par14_helårsindkomst(input),
    helårsskat_efter_par6_til_par9_kroner = lønmodtager_par14_helårsskat_efter_par6_til_par9(input),
    delårsskat_efter_par6_til_par9_kroner = lønmodtager_par14_delårsskat_efter_par6_til_par9(input)
) under lønmodtager_par14_omregning_gælder(input)
