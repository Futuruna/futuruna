@ importer ./arbejdsmarkedsbidragsloven
@ importer ./kommuneskatteloven
@ importer ./folkekirkens - oekonomi
@ importer ./ligningsloven_fradrag
@ importer ./skatteaar - parametre
@ importer ./kapitel - 02 - statsskat
@ importer ./kapitel - 03 - personfradrag
@ importer ./kapitel - 04 - omregning - skatteloft
@ importer ./pengebeloeb

-- Personskatteloven — ordinær lønmodtagerberegning, første fixture-slice.
--
-- Kilder:
-- Personskatteloven, LBK nr. 1284 af 14/06/2021.
-- https://www.retsinformation.dk/eli/lta/2021/1284
-- Personskattereform, LOV nr. 482 af 22/05/2024.
-- https://www.retsinformation.dk/eli/lta/2024/482

----
§ 3, stk. 2. Ved opgørelsen af den personlige indkomst fradrages
6) arbejdsmarkedsbidrag og obligatoriske udenlandske sociale bidrag i samme
omfang som nævnt i ligningslovens § 8 M,
----

# LønmodtagerInput(skatteår: Heltal, kommune: Kommune, bruttoløn_kroner: Heltal, positiv_nettokapitalindkomst_kroner: Heltal, ligningsmæssige_fradrag_kroner: Heltal, personfradrag_alder_status: PersonfradragAlderStatus, betaler_kirkeskat: Boolsk)
# LønmodtagerSkatteloftResult(input: Par19SkatteloftInput, overskydende_basispoint: Heltal, nedslag_kroner: Heltal)
# LønmodtagerIndkomstgrundlag(skatteår: Heltal, kommune: Kommune, bruttoløn_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal, personlig_indkomst_efter_am_kroner: Heltal, positiv_nettokapitalindkomst_kroner: Heltal, almindelig_skattepligtig_indkomst_kroner: Heltal)
# LønmodtagerLigningsfradrag(beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, øvrige_ligningsmæssige_fradrag_kroner: Heltal, samlede_ligningsmæssige_fradrag_kroner: Heltal)
# LønmodtagerSkattekomponenter(bundskat_kroner: Heltal, mellemskat_kroner: Heltal, topskat_kroner: Heltal, toptopskat_kroner: Heltal, kommuneskat_kroner: Heltal, kirkeskat_kroner: Heltal, statslig_indkomstskat_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_kroner: Heltal, samlet_indkomstskat_kroner: Heltal, samlet_inkl_am_kroner: Heltal)
# LønmodtagerPersonfradragResultat(personfradrag_kroner: Heltal, statslig_skatteværdi_kroner: Heltal, kommunal_skatteværdi_kroner: Heltal, kirkelig_skatteværdi_kroner: Heltal)
# LønmodtagerPar13Forhold(ægtefælle_skattepligtig_indkomst_kroner: Heltal, gift_samlevende_ved_årets_udløb: Boolsk, ikke_rummet_i_tidligere_indkomst_eller_skat: Boolsk)
# LønmodtagerPar13UnderskudResult(kræver_behandling: Boolsk, skattepligtigt_underskud_kroner: Heltal, skatteværdi_sats_basispoint: Heltal, skatteværdi_kroner: Heltal, modregning: Par13ModregningResult, statsskat_efter_par13_kroner: Heltal, ubenyttet_skatteværdi_kroner: Heltal, udnyttet_skatteværdi_kroner: Heltal, stk1_fremførsel: Par13Stk1FremførselResult, ægtefælleoverførsel: Par13ÆgtefælleOverførselResult, fremført_efter_ægtefælle_kroner: Heltal)
# LønmodtagerSlutskat(personligt_skatteloft: LønmodtagerSkatteloftResult, positiv_kapital_skatteloft: LønmodtagerSkatteloftResult, samlet_skatteloftsnedslag_kroner: Heltal, statslig_indkomstskat_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_kroner: Heltal, samlet_indkomstskat_kroner: Heltal, samlet_inkl_am_kroner: Heltal)
# LønmodtagerBeregning(input: LønmodtagerInput, indkomstgrundlag: LønmodtagerIndkomstgrundlag, ligningsfradrag: LønmodtagerLigningsfradrag, før_personfradrag: LønmodtagerSkattekomponenter, statsskat_før_personfradrag: Par5StatsskatResultat, par13_underskud: LønmodtagerPar13UnderskudResult, personfradrag: LønmodtagerPersonfradragResultat, efter_personfradrag_før_skatteloft: LønmodtagerSkattekomponenter, slutskat: LønmodtagerSlutskat, personfradrag_anvendt_i_slutskat: Boolsk, kræver_par13_underskud: Boolsk)
# LønmodtagerBreakdown(skatteår: Heltal, kommune: Kommune, bruttoløn_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal, personlig_indkomst_efter_am_kroner: Heltal, beskæftigelsesfradrag_kroner: Heltal, jobfradrag_kroner: Heltal, øvrige_ligningsmæssige_fradrag_kroner: Heltal, samlede_ligningsmæssige_fradrag_kroner: Heltal, almindelig_skattepligtig_indkomst_kroner: Heltal, bundskat_før_personfradrag_kroner: Heltal, mellemskat_før_personfradrag_kroner: Heltal, topskat_før_personfradrag_kroner: Heltal, toptopskat_før_personfradrag_kroner: Heltal, kommuneskat_før_personfradrag_kroner: Heltal, kirkeskat_før_personfradrag_kroner: Heltal, statslig_indkomstskat_før_personfradrag_kroner: Heltal, par13_skattepligtigt_underskud_kroner: Heltal, par13_underskud_skatteværdi_kroner: Heltal, par13_ubenyttet_skatteværdi_kroner: Heltal, par13_dækket_underskud_ved_skattemodregning_kroner: Heltal, par13_resterende_underskud_efter_skattemodregning_kroner: Heltal, par13_ægtefælle_fradrag_kroner: Heltal, par13_fremført_underskud_kroner: Heltal, statslig_indkomstskat_efter_par13_før_personfradrag_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_før_personfradrag_kroner: Heltal, samlet_indkomstskat_før_personfradrag_kroner: Heltal, samlet_inkl_am_før_personfradrag_kroner: Heltal, personfradrag_kroner: Heltal, statslig_personfradrag_skatteværdi_kroner: Heltal, kommunal_personfradrag_skatteværdi_kroner: Heltal, kirkelig_personfradrag_skatteværdi_kroner: Heltal, personligt_skatteloft: LønmodtagerSkatteloftResult, positiv_kapital_skatteloft: LønmodtagerSkatteloftResult, statslig_indkomstskat_efter_personfradrag_kroner: Heltal, kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner: Heltal, samlet_indkomstskat_efter_personfradrag_kroner: Heltal, samlet_inkl_am_efter_personfradrag_kroner: Heltal, personfradrag_anvendt_i_slutskat: Boolsk, kræver_par13_underskud: Boolsk)

| skat_i_kroner(beløb_kroner: Heltal, sats_basispoint: Heltal) -> penge_beløb_gange_basispoint_kroner(beløb_kroner, sats_basispoint)
| positivt_beløb(beløb_kroner: Heltal) -> penge_positivt_beløb(beløb_kroner)
| arbejdsmarkedsbidrag_input_for(input: LønmodtagerInput) -> ArbejdsmarkedsbidragInput(
    lønvederlag_kroner = input.bruttoløn_kroner,
    naturalieværdi_kroner = 0
)
| arbejdsmarkedsbidrag_for(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_lønmodtager_kroner(arbejdsmarkedsbidrag_input_for(input))
| personlig_indkomst_efter_am(input: LønmodtagerInput) -> input.bruttoløn_kroner - arbejdsmarkedsbidrag_for(input)
| ligningslov_fradrag_input_for(input: LønmodtagerInput) -> LigningslovLønmodtagerFradragInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.bruttoløn_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = Falskt
)
| beskæftigelsesfradrag_for(input: LønmodtagerInput) -> ll_lønmodtager_beskæftigelsesfradrag_kroner(ligningslov_fradrag_input_for(input))
| jobfradrag_for(input: LønmodtagerInput) -> ll_lønmodtager_jobfradrag_kroner(ligningslov_fradrag_input_for(input))
| standard_ligningsmæssige_fradrag_for(input: LønmodtagerInput) -> ll_lønmodtager_standardfradrag_kroner(ligningslov_fradrag_input_for(input))
| samlede_ligningsmæssige_fradrag_for(input: LønmodtagerInput) -> standard_ligningsmæssige_fradrag_for(input) + input.ligningsmæssige_fradrag_kroner

----
§ 1. For personer, der er skattepligtige her til landet, opgøres den
skattepligtige almindelige indkomst efter skattelovgivningens almindelige
regler med de ændringer, der følger af denne lov.
----

| almindelig_skattepligtig_indkomst_fixture(input: LønmodtagerInput) -> personlig_indkomst_efter_am(input) + input.positiv_nettokapitalindkomst_kroner - samlede_ligningsmæssige_fradrag_for(input)

----
§ 13. Hvis den skattepligtige indkomst udviser underskud, beregnes
skatteværdien af underskuddet med beskatningsprocenten for sundhedsbidrag, jf.
§ 8, og beskatningsprocenterne for kommunal indkomstskat og kirkeskat
henholdsvis med beskatningsprocenten efter § 8 c. Skatteværdien af underskuddet
modregnes i den nævnte rækkefølge i skatterne efter §§ 6, 7 og 7 a og § 8 a,
stk. 2. Et herefter resterende underskud fremføres til fradrag i den
skattepligtige indkomst for de følgende indkomstår.

Stk. 2. Hvis en gift persons skattepligtige indkomst udviser underskud, og
ægtefællerne er samlevende ved indkomstårets udløb, skal underskud, der ikke er
modregnet efter stk. 1, 2. pkt., i størst muligt omfang fradrages i den anden
ægtefælles skattepligtige indkomst. Modregning sker, før ægtefællens egne
uudnyttede underskud fra tidligere indkomstår fremføres efter 4.-6. pkt.

LOV nr. 482 af 22/05/2024, § 1:

9. I § 13, stk. 1, 1. pkt., udgår »beskatningsprocenten for sundhedsbidrag,
jf. § 8, og«.

10. I § 13, stk. 1, 2. og 4. pkt., og i stk. 2, 2. pkt., ændres »§§ 6, 7 og
7 a og § 8 a, stk. 2« til: »§§ 6, 7, 7 a og 8 og § 8 a, stk. 2«.

LOV nr. 482 af 22/05/2024, § 10, stk. 4:

§ 1, § 2, nr. 2 og 4, og §§ 4-6 har virkning fra og med indkomståret 2026.
----

| lønmodtager_indkomstskat_grundlag(input: LønmodtagerInput) -> positivt_beløb(almindelig_skattepligtig_indkomst_fixture(input))

----
§ 5. Indkomstskatten til staten opgøres som summen af
1) bundskat efter § 6,
2) topskat efter § 7,
3) udligningsskat efter § 7 a,
4) sundhedsbidrag efter § 8,
5) skat af aktieindkomst efter § 8 a,
6) skat af CFC-indkomst efter § 8 b og
7) skat svarende til kommunal indkomstskat efter § 8 c.
----

----
LOV nr. 482 af 22/05/2024, § 1, nr. 1.
Officiel tekst: https://www.retsinformation.dk/eli/lta/2024/482

§ 5 affattes således:

§ 5. Indkomstskatten til staten opgøres som summen af
1) bundskat efter § 6,
2) mellemskat efter § 7,
3) topskat efter § 7 a,
4) toptopskat efter § 8,
5) skat af aktieindkomst efter § 8 a,
6) skat af CFC-indkomst efter § 8 b og
7) skat svarende til kommunal indkomstskat efter § 8 c.

LOV nr. 482 af 22/05/2024, § 8, stk. 4.

§ 1, § 2, nr. 2 og 4, og §§ 4-6 har virkning fra og med indkomståret 2026.
----

| lønmodtager_statsskat_før_personfradrag_input(input: LønmodtagerInput) -> Par5StatsskatInput(
    skatteår = input.skatteår,
    poster = [
        Par5StatsskatPost(komponent = Bundskat, beløb_kroner = bundskat_før_personfradrag(input)),
        Par5StatsskatPost(komponent = Mellemskat, beløb_kroner = mellemskat_før_personfradrag(input)),
        Par5StatsskatPost(komponent = Topskat, beløb_kroner = topskat_før_personfradrag(input)),
        Par5StatsskatPost(komponent = Toptopskat, beløb_kroner = toptopskat_før_personfradrag(input))
    ]
)
| lønmodtager_statsskat_før_personfradrag_resultat(input: LønmodtagerInput) -> par5_statsskat_resultat(lønmodtager_statsskat_før_personfradrag_input(input))
| statslig_indkomstskat_før_personfradrag(input: LønmodtagerInput) -> lønmodtager_statsskat_før_personfradrag_resultat(input).samlet_statsskat_kroner

----
§ 6. Skatten efter § 5, nr. 1, beregnes med den procent, der anføres i stk. 2,
af den personlige indkomst med tillæg af positiv nettokapitalindkomst.
----

| bundskat_grundlag_fixture(input: LønmodtagerInput) -> personlig_indkomst_efter_am(input) + input.positiv_nettokapitalindkomst_kroner
| bundskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(bundskat_grundlag_fixture(input), nationalparametre_for(input.skatteår).bundskat_basispoint)

----
§ 7. Skatten efter § 5, nr. 2, udgør 15 pct. af den personlige indkomst med
tillæg af heri fradragne og ikke medregnede beløb omfattet af beløbsgrænsen i
pensionsbeskatningslovens § 16, stk. 1, 4. pkt., og med tillæg af positiv
nettokapitalindkomst, der overstiger et grundbeløb på 40.000 kr. (2010-niveau),
i det omfang det samlede beløb overstiger bundfradraget anført i stk. 2.
----

| topskat_personligt_overskud_fixture(input: LønmodtagerInput) -> positivt_beløb(personlig_indkomst_efter_am(input) - nationalparametre_for(input.skatteår).topskattegrænse_efter_am_kroner)
| progressiv_kapital_over_bundfradrag(input: LønmodtagerInput) -> positivt_beløb(input.positiv_nettokapitalindkomst_kroner - nationalparametre_for(input.skatteår).positiv_nettokapital_progressiv_bundfradrag_kroner)
| topskat_grundlag_med_kapital_fixture(input: LønmodtagerInput) -> positivt_beløb(personlig_indkomst_efter_am(input) + progressiv_kapital_over_bundfradrag(input) - nationalparametre_for(input.skatteår).topskattegrænse_efter_am_kroner)
| topskat_kapitalgrundlag_fixture(input: LønmodtagerInput) -> positivt_beløb(topskat_grundlag_med_kapital_fixture(input) - topskat_personligt_overskud_fixture(input))
| topskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(topskat_grundlag_med_kapital_fixture(input), nationalparametre_for(input.skatteår).topskat_basispoint)
| exception topskat_2026_kun_personlig topskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(topskat_personligt_overskud_fixture(input), nationalparametre_for(input.skatteår).topskat_basispoint) under input.skatteår >= 2026

----
LOV nr. 482 af 22/05/2024 ændrer fra og med indkomståret 2026 statsskatten til
bundskat, mellemskat, topskat og toptopskat. Skattestyrelsens 2026-satser
angiver mellemskattegrænse efter am-bidrag 641.200 kr., topskattegrænse
777.900 kr., toptopskattegrænse 2.592.700 kr. og bundfradrag i positiv
nettokapitalindkomst i mellemskattegrundlaget 55.000 kr.
----

| mellemskat_input_for(input: LønmodtagerInput) -> MellemskatKapitalInput(
    personlig_indkomst_efter_am_kroner = personlig_indkomst_efter_am(input),
    positiv_nettokapitalindkomst_kroner = input.positiv_nettokapitalindkomst_kroner,
    kapital_bundfradrag_kroner = nationalparametre_for(input.skatteår).positiv_nettokapital_progressiv_bundfradrag_kroner,
    mellemskattegrænse_efter_am_kroner = nationalparametre_for(input.skatteår).mellemskattegrænse_efter_am_kroner,
    sats_basispoint = nationalparametre_for(input.skatteår).mellemskat_basispoint
)
| mellemskat_personligt_grundlag_for(input: LønmodtagerInput) -> progressiv_personlig_overskud_kroner(reform_statskat_input(MellemskatLag, input.skatteår, personlig_indkomst_efter_am(input)))
| mellemskat_kapitalgrundlag_for(input: LønmodtagerInput) -> positivt_beløb(mellemskat_grundlag_med_kapital_kroner(mellemskat_input_for(input)) - mellemskat_personligt_grundlag_for(input))
| mellemskat_før_personfradrag(input: LønmodtagerInput) -> 0
| exception mellemskat_2026 mellemskat_før_personfradrag(input: LønmodtagerInput) -> mellemskat_med_kapital_kroner(mellemskat_input_for(input)) under input.skatteår == 2026
| toptopskat_personligt_overskud_fixture(input: LønmodtagerInput) -> 0
| exception toptopskat_2026 toptopskat_personligt_overskud_fixture(input: LønmodtagerInput) -> positivt_beløb(personlig_indkomst_efter_am(input) - nationalparametre_for(input.skatteår).toptopskattegrænse_efter_am_kroner) under input.skatteår == 2026
| toptopskat_før_personfradrag(input: LønmodtagerInput) -> skat_i_kroner(toptopskat_personligt_overskud_fixture(input), nationalparametre_for(input.skatteår).toptopskat_basispoint)

----
Skatteministeriet, "Oversigt over kommuneskatter"
Tabelkolonner: Kommunenavn, År, Kommuneskat, Kirkeskat, Sundhedsbidrag,
Bundskat, I alt, Skatteloftsnedslag, Grundskyldspromille (Kommune).
----

| kommuneskat_input_for(input: LønmodtagerInput) -> KommunalIndkomstskatInput(
    skattepligtig_indkomst_kroner = lønmodtager_indkomstskat_grundlag(input),
    udskrivningsprocent_basispoint = kommunale_parametre_for(input.skatteår, input.kommune).kommuneskat_basispoint
)
| kirkeskat_input_for(input: LønmodtagerInput) -> KirkeskatInput(
    skattepligtig_indkomst_kroner = lønmodtager_indkomstskat_grundlag(input),
    kirkelig_ligningsprocent_basispoint = kommunale_parametre_for(input.skatteår, input.kommune).kirkeskat_basispoint,
    folkekirkemedlem = input.betaler_kirkeskat
)
| kirkeskat_sats_for(input: LønmodtagerInput) -> kirkeskat_sats_basispoint(kirkeskat_input_for(input))
| kommuneskat_før_personfradrag(input: LønmodtagerInput) -> kommunal_indkomstskat_før_personfradrag_kroner(kommuneskat_input_for(input))
| kirkeskat_før_personfradrag(input: LønmodtagerInput) -> kirkeskat_før_personfradrag_kroner(kirkeskat_input_for(input))

----
§ 9. Indkomstskatten efter §§ 6, 7, 7 a og 8 og § 8 a, stk. 2, til staten skal,
efter at skattebeløbene er reguleret efter § 13, nedsættes med skatteværdien af
personfradrag. Personfradrag opgøres efter § 10 og skatteværdien heraf efter
§ 12.
----

| personfradrag_for(input: LønmodtagerInput) -> personfradrag_beløb_for(input.skatteår, input.personfradrag_alder_status)
| personfradrag_skatteværdi_input(input: LønmodtagerInput) -> PersonfradragSkatteværdiInput(
    fradrag_kroner = personfradrag_for(input),
    bundskat_basispoint = nationalparametre_for(input.skatteår).bundskat_basispoint,
    sundhedsbidrag_basispoint = kommunale_parametre_for(input.skatteår, input.kommune).sundhedsbidrag_basispoint,
    kommuneskat_basispoint = kommunale_parametre_for(input.skatteår, input.kommune).kommuneskat_basispoint,
    kirkeskat_basispoint = kirkeskat_sats_for(input),
    par8c_basispoint = 0
)
| statslig_personfradrag_skatteværdi_for(input: LønmodtagerInput) -> personfradrag_statslig_skatteværdi(personfradrag_skatteværdi_input(input))
| kommunal_personfradrag_skatteværdi_for(input: LønmodtagerInput) -> personfradrag_kommunal_skatteværdi(personfradrag_skatteværdi_input(input))
| kirkelig_personfradrag_skatteværdi_for(input: LønmodtagerInput) -> personfradrag_kirkelig_skatteværdi(personfradrag_skatteværdi_input(input))
| kommunal_og_kirkelig_indkomstskat_før_personfradrag(input: LønmodtagerInput) -> kommuneskat_før_personfradrag(input) + kirkeskat_før_personfradrag(input)
| samlet_indkomstskat_før_personfradrag(input: LønmodtagerInput) -> statslig_indkomstskat_før_personfradrag(input) + kommunal_og_kirkelig_indkomstskat_før_personfradrag(input)
| samlet_inkl_am_før_personfradrag(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_for(input) + samlet_indkomstskat_før_personfradrag(input)
| lønmodtager_par7_skat_før_personfradrag(input: LønmodtagerInput) -> topskat_før_personfradrag(input) under input.skatteår < 2026
| exception reform_par7_er_mellemskat lønmodtager_par7_skat_før_personfradrag(input: LønmodtagerInput) -> mellemskat_før_personfradrag(input) under input.skatteår >= 2026
| lønmodtager_par7a_skat_før_personfradrag(input: LønmodtagerInput) -> 0 under input.skatteår < 2026
| exception reform_par7a_er_topskat lønmodtager_par7a_skat_før_personfradrag(input: LønmodtagerInput) -> topskat_før_personfradrag(input) under input.skatteår >= 2026
| lønmodtager_par8_skat_før_personfradrag(input: LønmodtagerInput) -> 0 under input.skatteår < 2026
| exception reform_par8_er_toptopskat lønmodtager_par8_skat_før_personfradrag(input: LønmodtagerInput) -> toptopskat_før_personfradrag(input) under input.skatteår >= 2026
| par13_underskud_input_for(input: LønmodtagerInput) -> Par13UnderskudInput(
    skattepligtig_indkomst_kroner = almindelig_skattepligtig_indkomst_fixture(input),
    personlig_indkomst_kroner = personlig_indkomst_efter_am(input),
    positiv_kapitalindkomst_kroner = input.positiv_nettokapitalindkomst_kroner,
    gift_samlevende_ved_årets_udløb = Falskt
)
| kræver_par13_underskud_fixture(input: LønmodtagerInput) -> par13_kræver_underskudsbehandling(par13_underskud_input_for(input))
| personfradrag_anvendt_i_slutskat_fixture(input: LønmodtagerInput) -> kræver_par13_underskud_fixture(input) == Falskt
| lønmodtager_par13_standard_forhold() -> LønmodtagerPar13Forhold(
    ægtefælle_skattepligtig_indkomst_kroner = 0,
    gift_samlevende_ved_årets_udløb = Falskt,
    ikke_rummet_i_tidligere_indkomst_eller_skat = Sandt
)
# LønmodtagerPar13Sag(input: LønmodtagerInput, forhold: LønmodtagerPar13Forhold) {
    | skattepligtigt_underskud_kroner() -> par13_absolut_underskud(almindelig_skattepligtig_indkomst_fixture(input))
    | sundhedsbidrag_basispoint() -> kommunale_parametre_for(input.skatteår, input.kommune).sundhedsbidrag_basispoint
    | kommuneskat_basispoint() -> kommunale_parametre_for(input.skatteår, input.kommune).kommuneskat_basispoint
    | kirkeskat_basispoint() -> kirkeskat_sats_for(input)
    | skatteværdi_input() -> Par13UnderskudSkatteværdiInput(
        underskud_kroner = skattepligtigt_underskud_kroner(),
        sundhedsbidrag_basispoint = sundhedsbidrag_basispoint(),
        kommuneskat_basispoint = kommuneskat_basispoint(),
        kirkeskat_basispoint = kirkeskat_basispoint(),
        par8c_basispoint = 0,
        betaler_par8c = Falskt
    )
    | skatteværdi_sats_basispoint() -> par13_skatteværdi_sats_basispoint(skatteværdi_input())
    | skatteværdi_kroner() -> par13_underskud_skatteværdi_kroner(skatteværdi_input())
    | par6_skat_før_personfradrag_kroner() -> bundskat_før_personfradrag(input)
    | par7_skat_før_personfradrag_kroner() -> lønmodtager_par7_skat_før_personfradrag(input)
    | par7a_skat_før_personfradrag_kroner() -> lønmodtager_par7a_skat_før_personfradrag(input)
    | par8_skat_før_personfradrag_kroner() -> lønmodtager_par8_skat_før_personfradrag(input)
    | modregning_input() -> Par13ModregningInput(
        skatteværdi_kroner = skatteværdi_kroner(),
        par6_skat_kroner = par6_skat_før_personfradrag_kroner(),
        par7_skat_kroner = par7_skat_før_personfradrag_kroner(),
        par7a_skat_kroner = par7a_skat_før_personfradrag_kroner(),
        par8_skat_kroner = par8_skat_før_personfradrag_kroner(),
        par8a_stk2_skat_kroner = 0
    )
    | modregning() -> par13_modregning_resultat(modregning_input())
    | statsskat_efter_par13_før_personfradrag() -> modregning().par6_efter_kroner + modregning().par7_efter_kroner + modregning().par7a_efter_kroner + modregning().par8_efter_kroner + modregning().par8a_stk2_efter_kroner
    | udnyttet_skatteværdi_kroner() -> par13_udnyttet_skatteværdi_kroner(skatteværdi_kroner(), modregning().ubrugt_skatteværdi_kroner)
    | stk1_fremførsel_input() -> Par13Stk1FremførselInput(
        underskud_kroner = skattepligtigt_underskud_kroner(),
        skatteværdi_sats_basispoint = skatteværdi_sats_basispoint(),
        udnyttet_skatteværdi_kroner = udnyttet_skatteværdi_kroner(),
        ikke_rummet_i_tidligere_indkomst_eller_skat = forhold.ikke_rummet_i_tidligere_indkomst_eller_skat
    )
    | stk1_fremførsel() -> par13_stk1_fremførsel_resultat(stk1_fremførsel_input())
    | ægtefælle_skattepligtig_indkomst_til_overførsel_kroner() -> par13_positivt_beløb(forhold.ægtefælle_skattepligtig_indkomst_kroner)
    | ægtefælle_input() -> Par13ÆgtefælleOverførselInput(
        ubenyttet_underskud_kroner = stk1_fremførsel().resterende_underskud_kroner,
        ægtefælle_skattepligtig_indkomst_kroner = ægtefælle_skattepligtig_indkomst_til_overførsel_kroner(),
        gift_samlevende_ved_årets_udløb = forhold.gift_samlevende_ved_årets_udløb
    )
    | ægtefælleoverførsel() -> par13_ægtefælleoverførsel_resultat(ægtefælle_input())
    | fremført_efter_ægtefælle_kroner() -> 0
    | exception fremfør_rest_efter_ægtefælle fremført_efter_ægtefælle_kroner() -> ægtefælleoverførsel().resterende_underskud_kroner under forhold.ikke_rummet_i_tidligere_indkomst_eller_skat
    | resultat() -> LønmodtagerPar13UnderskudResult(
        kræver_behandling = kræver_par13_underskud_fixture(input),
        skattepligtigt_underskud_kroner = skattepligtigt_underskud_kroner(),
        skatteværdi_sats_basispoint = skatteværdi_sats_basispoint(),
        skatteværdi_kroner = skatteværdi_kroner(),
        modregning = modregning(),
        statsskat_efter_par13_kroner = statsskat_efter_par13_før_personfradrag(),
        ubenyttet_skatteværdi_kroner = modregning().ubrugt_skatteværdi_kroner,
        udnyttet_skatteværdi_kroner = udnyttet_skatteværdi_kroner(),
        stk1_fremførsel = stk1_fremførsel(),
        ægtefælleoverførsel = ægtefælleoverførsel(),
        fremført_efter_ægtefælle_kroner = fremført_efter_ægtefælle_kroner()
    )
}
| lønmodtager_par13_sag(input: LønmodtagerInput, forhold: LønmodtagerPar13Forhold) -> LønmodtagerPar13Sag(input, forhold)
| lønmodtager_par13_standard_sag(input: LønmodtagerInput) -> lønmodtager_par13_sag(input, lønmodtager_par13_standard_forhold())
| lønmodtager_par13_skatteværdi_input(input: LønmodtagerInput) -> lønmodtager_par13_standard_sag(input).skatteværdi_input()
| lønmodtager_par13_skatteværdi_kroner(input: LønmodtagerInput) -> lønmodtager_par13_standard_sag(input).skatteværdi_kroner()
| lønmodtager_par13_modregning_input(input: LønmodtagerInput) -> lønmodtager_par13_standard_sag(input).modregning_input()
| lønmodtager_par13_modregning_resultat(input: LønmodtagerInput) -> lønmodtager_par13_standard_sag(input).modregning()
| lønmodtager_statsskat_efter_par13_før_personfradrag(input: LønmodtagerInput) -> lønmodtager_par13_standard_sag(input).statsskat_efter_par13_før_personfradrag()
| lønmodtager_par13_underskud_resultat(input: LønmodtagerInput) -> lønmodtager_par13_standard_sag(input).resultat()
| lønmodtager_par13_underskud_resultat_med_forhold(input: LønmodtagerInput, forhold: LønmodtagerPar13Forhold) -> lønmodtager_par13_sag(input, forhold).resultat()
| lønmodtager_statsskat_personfradrag_input(input: LønmodtagerInput) -> PersonfradragStatsskatNedsættelseInput(
    par6_skat_kroner = lønmodtager_par13_modregning_resultat(input).par6_efter_kroner,
    par7_skat_kroner = lønmodtager_par13_modregning_resultat(input).par7_efter_kroner,
    par7a_skat_kroner = lønmodtager_par13_modregning_resultat(input).par7a_efter_kroner,
    par8_skat_kroner = lønmodtager_par13_modregning_resultat(input).par8_efter_kroner,
    par8a_stk2_skat_kroner = lønmodtager_par13_modregning_resultat(input).par8a_stk2_efter_kroner,
    statslig_skatteværdi_kroner = statslig_personfradrag_skatteværdi_for(input)
)
| lønmodtager_statsskat_personfradrag_nedsættelse(input: LønmodtagerInput) -> personfradrag_statsskat_nedsættelse_resultat(lønmodtager_statsskat_personfradrag_input(input))
| bundskat_efter_personfradrag(input: LønmodtagerInput) -> lønmodtager_statsskat_personfradrag_nedsættelse(input).par6_efter_kroner
| mellemskat_efter_personfradrag(input: LønmodtagerInput) -> 0 under input.skatteår < 2026
| exception reform_mellemskat_efter_personfradrag mellemskat_efter_personfradrag(input: LønmodtagerInput) -> lønmodtager_statsskat_personfradrag_nedsættelse(input).par7_efter_kroner under input.skatteår >= 2026
| topskat_efter_personfradrag(input: LønmodtagerInput) -> lønmodtager_statsskat_personfradrag_nedsættelse(input).par7_efter_kroner under input.skatteår < 2026
| exception reform_topskat_efter_personfradrag topskat_efter_personfradrag(input: LønmodtagerInput) -> lønmodtager_statsskat_personfradrag_nedsættelse(input).par7a_efter_kroner under input.skatteår >= 2026
| toptopskat_efter_personfradrag(input: LønmodtagerInput) -> 0 under input.skatteår < 2026
| exception reform_toptopskat_efter_personfradrag toptopskat_efter_personfradrag(input: LønmodtagerInput) -> lønmodtager_statsskat_personfradrag_nedsættelse(input).par8_efter_kroner under input.skatteår >= 2026
| kommuneskat_efter_personfradrag(input: LønmodtagerInput) -> skat_efter_nedsættelse(kommuneskat_før_personfradrag(input), kommunal_personfradrag_skatteværdi_for(input))
| kirkeskat_efter_personfradrag(input: LønmodtagerInput) -> skat_efter_nedsættelse(kirkeskat_før_personfradrag(input), kirkelig_personfradrag_skatteværdi_for(input))
| statslig_indkomstskat_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> bundskat_efter_personfradrag(input) + mellemskat_efter_personfradrag(input) + topskat_efter_personfradrag(input) + toptopskat_efter_personfradrag(input)
| kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input: LønmodtagerInput) -> kommuneskat_efter_personfradrag(input) + kirkeskat_efter_personfradrag(input)
| samlet_indkomstskat_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> statslig_indkomstskat_efter_personfradrag_før_skatteloft(input) + kommunal_og_kirkelig_indkomstskat_efter_personfradrag(input)
| samlet_inkl_am_efter_personfradrag_før_skatteloft(input: LønmodtagerInput) -> arbejdsmarkedsbidrag_for(input) + samlet_indkomstskat_efter_personfradrag_før_skatteloft(input)

