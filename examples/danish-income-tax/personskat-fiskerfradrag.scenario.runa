@ sprog da

@ importer ./personskat.calculate

| personskat_fiskerfradrag_tidspunkt(dag: Heltal, time: Heltal) -> DatoTidspunkt(
    dato = Dato(år = 2026, måned = 6, dag = dag),
    klokkeslæt = Klokkeslæt(time = time, minut = 0)
)
| personskat_fiskerfradrag_arbejdsforhold(identifikation: Tekst, erhvervsform: Ligningslov9GErhvervsform) -> Ligningslov9GArbejdsforhold(
    identifikation = identifikation,
    erhvervsform = erhvervsform,
    fra_dato = Dato(år = 2026, måned = 1, dag = 1),
    til_dato = Dato(år = 2026, måned = 12, dag = 31)
)
| personskat_fiskerfradrag_tilknytning(kilde: Ligningslov9GFradragskilde, arbejdstilknytning: Ligningslov9GArbejdstilknytning) -> Ligningslov9GKildetilknytning(
    kilde = kilde,
    arbejdstilknytning = arbejdstilknytning
)
| personskat_fiskerfradrag_lønmodtagerudgift(identifikation: Tekst, arbejdsforhold_identifikation: Tekst) -> Ligningslov9Stk1Udgiftsfakta(
    identifikation = identifikation,
    indkomstår = 2026,
    arbejdsforhold_identifikation = arbejdsforhold_identifikation,
    udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
    afholdt_eller_beregnet_beløb_kroner = 10000,
    arbejdsgiver_refunderet_efter_regning_kroner = 0,
    dokumentation = Ll9Stk1DokumenteretMedBilag
)
| personskat_fiskerfradrag_kontingent(identifikation: Tekst) -> Ligningslov13KontingentFakta(
    identifikation = identifikation,
    indkomstår = 2026,
    foreningsart = Ll13Fagforening,
    betalt_kontingent_kroner = 6000,
    foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner = 6000,
    foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser = Sandt,
    skatteyder_hører_til_erhvervsgruppen = Sandt,
    indberetningsstatus = Ll13IndberettetEfterSkatteindberetningslov31
)
| personskat_fiskerfradrag_akasse(identifikation: Tekst, beløb_kroner: Heltal) -> Pbl49Til49BBidragsfakta(
    identifikation = identifikation,
    indkomstår = 2026,
    betalt_beløb_kroner = beløb_kroner,
    art = Pbl49Akassekontingent(
        arbejdsløshedskasse = Pbl49DanskAnerkendtArbejdsløshedskasse,
        skatteyderen_er_medlem_og_forsikret = Sandt
    )
)
| personskat_fiskerfradrag_virksomhedsudgift(identifikation: Tekst, beløb_kroner: Heltal) -> PersonskatVirksomhedsudgiftFakta(
    identifikation = identifikation,
    afgrænsning = SelvstændigErhvervsindkomstUdgift,
    beløb_kroner = beløb_kroner
)
| personskat_fiskerfradrag_virksomhed(identifikation: Tekst, omsætning_kroner: Heltal, udgifter: List(PersonskatVirksomhedsudgiftFakta)) -> PersonskatOrdinærVirksomhedFakta(
    identifikation = identifikation,
    indkomstår = 2026,
    indtægter = [PersonskatVirksomhedsindtægtFakta(
        identifikation = identifikation + "-omsætning",
        art = OrdinærDriftsindtægt,
        beløb_kroner = omsætning_kroner
    )],
    udgifter = udgifter
)

= personskat_fiskerfradrag_kildetilknytninger = [
    personskat_fiskerfradrag_tilknytning(
        Ll9GLigningslov9Stk1Udgift(kildeidentifikation = "fisker-telefon"),
        Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation = "ansat-fisker")
    ),
    personskat_fiskerfradrag_tilknytning(
        Ll9GLigningslov9Stk1Udgift(kildeidentifikation = "andet-job-telefon"),
        Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation = "andet-job")
    ),
    personskat_fiskerfradrag_tilknytning(
        Ll9GLigningslov13Kontingent(kildeidentifikation = "fiskerforbund"),
        Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation = "ansat-fisker")
    ),
    personskat_fiskerfradrag_tilknytning(
        Ll9GLigningslov13Kontingent(kildeidentifikation = "andet-forbund"),
        Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation = "andet-job")
    ),
    personskat_fiskerfradrag_tilknytning(
        Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = "fisker-akasse"),
        Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation = "ansat-fisker")
    ),
    personskat_fiskerfradrag_tilknytning(
        Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = "andet-akasse"),
        Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation = "andet-job")
    ),
    personskat_fiskerfradrag_tilknytning(
        Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation = "fiskeri", kildeidentifikation = "telefon-og-arbejdstøj"),
        Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation = "fiskeri")
    )
]
= personskat_fiskerfradrag_selvstændige_udgiftsvurderinger = [
    Ligningslov9GSelvstændigUdgiftsvurdering(
        virksomhedsidentifikation = "fiskeri",
        kildeidentifikation = "telefon-og-arbejdstøj",
        sammenlignelighed = Ll9GSidstillesMedLønmodtagerudgift
    ),
    Ligningslov9GSelvstændigUdgiftsvurdering(
        virksomhedsidentifikation = "fiskeri",
        kildeidentifikation = "brændstof",
        sammenlignelighed = Ll9GSidstillesIkkeMedLønmodtagerudgift
    )
]

| personskat_fiskerfradrag_par9g(kildetilknytninger: List(Ligningslov9GKildetilknytning), selvstændige_udgiftsvurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering)) -> Ligningslov9GÅrsinput(
    valg = Ll9GVælgFiskerfradrag,
    registreringer = [Ligningslov9GRegistreringsperiode(
        identifikation = "a-status-2026",
        status = Ll9GErhvervsfiskerMedAStatus,
        fra_dato = Dato(år = 2026, måned = 1, dag = 1),
        til_dato = Dato(år = 2026, måned = 12, dag = 31)
    )],
    arbejdsforhold = [
        personskat_fiskerfradrag_arbejdsforhold("ansat-fisker", Ll9GAnsatFisker),
        personskat_fiskerfradrag_arbejdsforhold("fiskeri", Ll9GSelvstændigFisker)
    ],
    fangstture = [Ligningslov9GFangsttur(
        identifikation = "fangsttur-24-timer",
        arbejdsforhold_identifikation = "ansat-fisker",
        afgang_fra_havn = personskat_fiskerfradrag_tidspunkt(1, 6),
        ankomst_til_havn = personskat_fiskerfradrag_tidspunkt(2, 6)
    )],
    selvstændige_udgiftsvurderinger = selvstændige_udgiftsvurderinger,
    kildetilknytninger = kildetilknytninger
)
| personskat_fiskerfradrag_ligningsfradrag_med_sømandsregler(
    kildetilknytninger: List(Ligningslov9GKildetilknytning),
    selvstændige_udgiftsvurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering),
    sømandsfradrag: Sømandsbeskatningslov3Årsinput,
    sømandsbeskatningslov4: Sømandsbeskatningslov4Årsinput
) -> PersonskatLigningsfradragInput(
    sømandsfradrag = sømandsfradrag,
    sømandsbeskatningslov4 = sømandsbeskatningslov4,
    fiskerfradrag = personskat_fiskerfradrag_par9g(kildetilknytninger, selvstændige_udgiftsvurderinger),
    øvrige_lønmodtagerudgifter = Ligningslov9Stk1Årsinput(
        skatteyderstatus = Ll9Stk1Lønmodtager,
        udgifter = [
            personskat_fiskerfradrag_lønmodtagerudgift("fisker-telefon", "ansat-fisker"),
            personskat_fiskerfradrag_lønmodtagerudgift("andet-job-telefon", "andet-job")
        ]
    ),
    befordring = UdenBefordringsfradrag,
    rejser = ligningslov9a_intet_årsinput(),
    faglige_kontingenter = Ligningslov13Årsinput(
        skatteyderstatus = Ll13Lønmodtager,
        kontingenter = [
            personskat_fiskerfradrag_kontingent("fiskerforbund"),
            personskat_fiskerfradrag_kontingent("andet-forbund")
        ]
    ),
    arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(
        skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark,
        bidrag = [
            personskat_fiskerfradrag_akasse("fisker-akasse", 2000),
            personskat_fiskerfradrag_akasse("andet-akasse", 2500),
            Pbl49Til49BBidragsfakta(
                identifikation = "efterløn",
                indkomstår = 2026,
                betalt_beløb_kroner = 1000,
                art = Pbl49AEfterlønsbidrag(
                    arbejdsløshedskasse = Pbl49DanskAnerkendtArbejdsløshedskasse,
                    medlem_af_arbejdsløshedskasse = Sandt,
                    bidrag_efter_arbejdsløshedsforsikringslov77_stk4 = Sandt
                )
            )
        ]
    ),
    gaver = LigningslovGaveÅrsinput(gaver = [])
)
| personskat_fiskerfradrag_ligningsfradrag(kildetilknytninger: List(Ligningslov9GKildetilknytning), selvstændige_udgiftsvurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering)) -> personskat_fiskerfradrag_ligningsfradrag_med_sømandsregler(
    kildetilknytninger = kildetilknytninger,
    selvstændige_udgiftsvurderinger = selvstændige_udgiftsvurderinger,
    sømandsfradrag = sømandsbeskatningslov3_intet_årsinput(),
    sømandsbeskatningslov4 = sømandsbeskatningslov4_intet_årsinput()
)
| personskat_fiskerfradrag_personlig_indkomst() -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = [],
        virksomheder_uden_virksomhedsordning = [
            personskat_fiskerfradrag_virksomhed("fiskeri", 100000, [
                personskat_fiskerfradrag_virksomhedsudgift("telefon-og-arbejdstøj", 20000),
                personskat_fiskerfradrag_virksomhedsudgift("brændstof", 30000)
            ]),
            personskat_fiskerfradrag_virksomhed("konsulent", 50000, [
                personskat_fiskerfradrag_virksomhedsudgift("driftsudgift", 10000)
            ])
        ],
        forenings_og_arbejdsløshedsydelser = []
    ),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| personskat_fiskerfradrag_input_med_ligningsfradrag(ligningsfradrag: PersonskatLigningsfradragInput) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 600000,
        personlig_indkomst = personskat_fiskerfradrag_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = ligningsfradrag,
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_fiskerfradrag_input(kildetilknytninger: List(Ligningslov9GKildetilknytning), selvstændige_udgiftsvurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering)) -> personskat_fiskerfradrag_input_med_ligningsfradrag(
    personskat_fiskerfradrag_ligningsfradrag(kildetilknytninger, selvstændige_udgiftsvurderinger)
)
| personskat_fiskerfradrag_søbl4_tilknytning(kilde: Sømandsbeskatningslov4Fradragskilde, arbejdsforhold_identifikation: Tekst) -> Sømandsbeskatningslov4Kildetilknytning(
    kilde = kilde,
    arbejdstilknytning = Søbl4AndetArbejdsforhold(arbejdsforhold_identifikation = arbejdsforhold_identifikation)
)

= personskat_fiskerfradrag_sømandsfradrag = Sømandsbeskatningslov3Årsinput(
    valg = AnvendSømandsfradrag,
    beskæftigelser = [Sømandsbeskatningslov3Beskæftigelsesfakta(
        identifikation = "sømandsarbejde",
        indkomstår = 2026,
        ansættelsesforhold_startdato = Dato(år = 2026, måned = 1, dag = 1),
        arbejdssted = ArbejdePåSkib(bruttotonnage = 500, anvendelse = ErhvervsmæssigBefordringAfGods),
        fart = UdenForBegrænsetFart,
        hjemsted = RegistreretMedHjemstedIDanmark,
        flag = FlagFraEUEØSStat,
        forhyringsvilkår = SædvanligeForhyringsvilkårForSøfolk,
        fuldtidsomregnede_sødage_hundrededele = 18250
    )]
)
= personskat_fiskerfradrag_søbl4_kildetilknytninger = [
    personskat_fiskerfradrag_søbl4_tilknytning(Søbl4Ligningslov9Stk1Lønmodtagerudgift(kildeidentifikation = "fisker-telefon"), "ansat-fisker"),
    personskat_fiskerfradrag_søbl4_tilknytning(Søbl4Ligningslov9Stk1Lønmodtagerudgift(kildeidentifikation = "andet-job-telefon"), "andet-job"),
    personskat_fiskerfradrag_søbl4_tilknytning(Søbl4Ligningslov13Årsfradrag, "andet-job"),
    personskat_fiskerfradrag_søbl4_tilknytning(Søbl4Pensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = "fisker-akasse"), "ansat-fisker"),
    personskat_fiskerfradrag_søbl4_tilknytning(Søbl4Pensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = "andet-akasse"), "andet-job")
]

= personskat_fiskerfradrag_kanonisk = beregn_personskat(personskat_fiskerfradrag_input(personskat_fiskerfradrag_kildetilknytninger, personskat_fiskerfradrag_selvstændige_udgiftsvurderinger))
= personskat_fiskerfradrag_og_sømandsfradrag = beregn_personskat(personskat_fiskerfradrag_input_med_ligningsfradrag(
    personskat_fiskerfradrag_ligningsfradrag_med_sømandsregler(
        kildetilknytninger = personskat_fiskerfradrag_kildetilknytninger,
        selvstændige_udgiftsvurderinger = personskat_fiskerfradrag_selvstændige_udgiftsvurderinger,
        sømandsfradrag = personskat_fiskerfradrag_sømandsfradrag,
        sømandsbeskatningslov4 = Sømandsbeskatningslov4Årsinput(kildetilknytninger = personskat_fiskerfradrag_søbl4_kildetilknytninger)
    )
))
= personskat_fiskerfradrag_manglende_tilknytning = beregn_personskat(personskat_fiskerfradrag_input(
    filter(
        personskat_fiskerfradrag_kildetilknytninger,
        |tilknytning: Ligningslov9GKildetilknytning| tilknytning.kilde != Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = "andet-akasse")
    ),
    personskat_fiskerfradrag_selvstændige_udgiftsvurderinger
))
= personskat_fiskerfradrag_manglende_udgiftsvurdering = beregn_personskat(personskat_fiskerfradrag_input(
    personskat_fiskerfradrag_kildetilknytninger,
    filter(
        personskat_fiskerfradrag_selvstændige_udgiftsvurderinger,
        |vurdering: Ligningslov9GSelvstændigUdgiftsvurdering| vurdering.kildeidentifikation != "brændstof"
    )
))

| personskat_fiskerfradrag_kanonisk_samordning: personskat_fiskerfradrag_kanonisk -> personskat_fiskerfradrag_kanonisk.ligningsfradrag.alle_input_gyldige && personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.samordning_gyldig && length(personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.påkrævede_kilder) == 7 && length(personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.påkrævede_selvstændige_udgiftsvurderinger) == 2 && personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.fiskerfradrag.samlet_fradrag_kroner == 190
| personskat_fiskerfradrag_bevarer_andet_arbejdes_fradrag: personskat_fiskerfradrag_kanonisk -> personskat_fiskerfradrag_kanonisk.ligningsfradrag.øvrige_lønmodtagerudgifter.samlet_fradrag_kroner == 2400 && personskat_fiskerfradrag_kanonisk.ligningsfradrag.faglige_kontingenter.samlet_fradrag_kroner == 6000 && personskat_fiskerfradrag_kanonisk.ligningsfradrag.pbl49_stk1_fradrag_anvendt_kroner == 2500 && personskat_fiskerfradrag_kanonisk.ligningsfradrag.pbl49a_og_49b_fradrag_anvendt_kroner == 1000
| personskat_fiskerfradrag_samlet_ligningsfradrag: personskat_fiskerfradrag_kanonisk -> personskat_fiskerfradrag_kanonisk.ligningsfradrag.samlet_afskåret_efter_ligningslov9g_kroner == 13000 && personskat_fiskerfradrag_kanonisk.ligningsfradrag.samlet_ligningsfradrag_kroner == 12090
| personskat_fiskerfradrag_selvstændig_udgift_afskæres_før_am: personskat_fiskerfradrag_kanonisk -> personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.selvstændige_driftsudgifter_afskåret_kroner == 20000 && personskat_fiskerfradrag_kanonisk.personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner == 110000
| personskat_fiskerfradrag_ordinær_fiskeridriftsudgift_bevares: personskat_fiskerfradrag_kanonisk -> personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.selvstændige_udgiftsvurderinger_gyldige && personskat_fiskerfradrag_kanonisk.ligningsfradrag.fiskerfradragssamordning.påkrævede_selvstændige_udgifter_vurderet
| personskat_fiskerfradrag_og_sømandsfradrag_samordnes: personskat_fiskerfradrag_og_sømandsfradrag -> personskat_fiskerfradrag_og_sømandsfradrag.ligningsfradrag.alle_input_gyldige && personskat_fiskerfradrag_og_sømandsfradrag.ligningsfradrag.fiskerfradragssamordning.samordning_gyldig && personskat_fiskerfradrag_og_sømandsfradrag.ligningsfradrag.sømandsbeskatningslov4_kildetilknytninger_gyldige && personskat_fiskerfradrag_og_sømandsfradrag.ligningsfradrag.sømandsbeskatningslov4_påkrævede_kilder_tilknyttet && personskat_fiskerfradrag_og_sømandsfradrag.ligningsfradrag.sømandsfradrag.samlet_fradrag_kroner == 52500 && personskat_fiskerfradrag_og_sømandsfradrag.ligningsfradrag.samlet_ligningsfradrag_kroner == 64590
| personskat_fiskerfradrag_manglende_kilde_fejler_lukket: personskat_fiskerfradrag_manglende_tilknytning -> personskat_fiskerfradrag_manglende_tilknytning.ligningsfradrag.fiskerfradragssamordning.påkrævede_kilder_tilknyttet == Falskt && personskat_fiskerfradrag_manglende_tilknytning.ligningsfradrag.alle_input_gyldige == Falskt && personskat_fiskerfradrag_manglende_tilknytning.ligningsfradrag.samlet_ligningsfradrag_kroner == 0 && personskat_fiskerfradrag_manglende_tilknytning.personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner == 90000
| personskat_fiskerfradrag_manglende_udgiftsvurdering_fejler_lukket: personskat_fiskerfradrag_manglende_udgiftsvurdering -> personskat_fiskerfradrag_manglende_udgiftsvurdering.ligningsfradrag.fiskerfradragssamordning.påkrævede_selvstændige_udgifter_vurderet == Falskt && personskat_fiskerfradrag_manglende_udgiftsvurdering.ligningsfradrag.alle_input_gyldige == Falskt && personskat_fiskerfradrag_manglende_udgiftsvurdering.personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner == 90000

? personskat_fiskerfradrag_kanonisk_samordning
? personskat_fiskerfradrag_bevarer_andet_arbejdes_fradrag
? personskat_fiskerfradrag_samlet_ligningsfradrag
? personskat_fiskerfradrag_selvstændig_udgift_afskæres_før_am
? personskat_fiskerfradrag_ordinær_fiskeridriftsudgift_bevares
? personskat_fiskerfradrag_og_sømandsfradrag_samordnes
? personskat_fiskerfradrag_manglende_kilde_fejler_lukket
? personskat_fiskerfradrag_manglende_udgiftsvurdering_fejler_lukket

@ print("LL § 9 G er sammensat kanonisk med kildeafgrænsede fradrag")
