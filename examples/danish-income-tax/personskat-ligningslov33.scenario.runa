@ sprog da

@ importer ./metadata
@ importer ./personskat.calculate

= personskat_ligningslov33_scenarier_metadata = Metadata(
    attachments = (
        Source(value = ligningsloven_lbk1500_par33),
        Source(value = ligningsloven_lbk1500_par33a),
        Guidance(value = ligningsloven_vejledning_par33_personberegning),
        Guidance(value = ligningsloven_vejledning_par33a_beregning),
    )
)

--@label:personskat_ligningslov33_scenarier::meta:personskat_ligningslov33_scenarier_metadata--
----
Scenarierne er ikke lovtekst. De fastholder den kanoniske kæde fra en persons
udenlandske indkomst og skat gennem de særskilte danske skattekomponenter til
nedslaget i personens slutskat.
----

--@begin:personskat_ligningslov33_scenarier--

| personskat_ligningslov33_scenarie_lønmodtager(bruttoløn_kroner: Heltal) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = bruttoløn_kroner,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Sandt
)
| personskat_ligningslov33_scenarie_person(bruttoløn_kroner: Heltal) -> PersonskatPersonFakta(
    lønmodtager = personskat_ligningslov33_scenarie_lønmodtager(bruttoløn_kroner),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta()
)
| personskat_ligningslov33_scenarie_input_med_kapitalindkomst(kapitalindkomst: PersonskatKapitalindkomstInput, ægtefælle: PersonskatÆgtefælleInput, ligningslov33: PersonskatLigningslov33ParInput) -> PersonskatInput(
    lønmodtager = personskat_ligningslov33_scenarie_lønmodtager(600000),
    kapitalindkomst = kapitalindkomst,
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = ægtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = ligningslov33,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_ligningslov33_scenarie_input(ægtefælle: PersonskatÆgtefælleInput, ligningslov33: PersonskatLigningslov33ParInput) -> personskat_ligningslov33_scenarie_input_med_kapitalindkomst(
    personskat_ingen_kapitalindkomst(),
    ægtefælle,
    ligningslov33
)
| personskat_ligningslov33_scenarie_kreditgruppe(identifikation: Tekst, udenlandsk_bruttoløn_kroner: Heltal, betalt_udenlandsk_skat_øre: Heltal, lønlempelsesstatus: Ligningslov33Lønlempelsesstatus) -> Ligningslov33PersonKreditgruppe(
    identifikation = identifikation,
    grupperingsgrundlag = Ll33SamletIndkomstFraSkatteområdet,
    indkomstfakta = Ligningslov33Indkomstfakta(
        område = Ll33FremmedStat("SE"),
        udenlandsk_bruttoindkomst_kroner = udenlandsk_bruttoløn_kroner,
        direkte_henførbare_udgifter_kroner = 0
    ),
    skattebetalinger = [Ligningslov33Skattebetaling(
        opkrævningsmåde = Ll33DirektePåligning,
        betalt_udenlandsk_skat_øre = betalt_udenlandsk_skat_øre,
        skatteart = Ll33Indkomstskat,
        betalingsdokumentreference = identifikation,
        overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst
    )],
    udenlandsk_indkomst_efter_danske_regler = Ligningslov33UdenlandskIndkomstEfterDanskeRegler(
        skattepligtig_nettoindkomst_efter_par33f_kroner = udenlandsk_bruttoløn_kroner * 92 / 100,
        personlig_nettoindkomst_efter_par33f_kroner = udenlandsk_bruttoløn_kroner * 92 / 100,
        positiv_kapitalnettoindkomst_efter_par33f_kroner = 0,
        aktienettoindkomst_efter_par33f_kroner = 0,
        cfc_nettoindkomst_efter_par33f_kroner = 0,
        arbejdsmarkedsbidragsgrundlag_kroner = udenlandsk_bruttoløn_kroner
    ),
    lønlempelsesstatus = lønlempelsesstatus
)
| personskat_ligningslov33_scenarie_årsinput(dansk_bruttoindkomst_kroner: Heltal, gruppe: Ligningslov33PersonKreditgruppe) -> Ligningslov33PersonÅrsinput(
    indkomstår = 2026,
    dansk_bruttoindkomst_kroner = dansk_bruttoindkomst_kroner,
    ikke_henførbare_udgifter_kroner = 0,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
    kreditgrupper = [gruppe],
    par6_kreditter = [],
    fragtskat_åbningssaldi = []
)
| personskat_ligningslov33a_scenarie_ansættelsesforhold(identifikation: Tekst, udenlandsk_bruttoløn_kroner: Heltal) -> Ligningslov33AAnsættelsesforhold(
    identifikation = identifikation,
    subjekt = Ll33APerson,
    ophold = Ligningslov33AOphold(
        fra_dato = Dato(år = 2026, måned = 1, dag = 1),
        til_dato = Dato(år = 2026, måned = 6, dag = 30),
        danske_opholdsdage = [],
        arbejdsgiverforbindelse = Ll33AUdlandsopholdBegrundetIArbejdsgiverensForhold(dokumentreference = identifikation),
        tjenesteforhold = Ll33APersonligtArbejdeITjenesteforhold,
        skattepligt = Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet,
        covidvalg = Ll33AUdenCovidvalg,
        dokumentreference = identifikation
    ),
    arbejdsgivergrundlag = Ll33AIkkeDanskOffentligArbejdsgiver,
    beskatningsret = Ll33AIngenDobbeltbeskatningsoverenskomst,
    indkomstgrundlag = Ll33ASamletIndkomstForUafbrudtLempelsesperiode(
        fordeling = Ligningslov33AIndkomstfordeling(
            samlet_lønindkomst_efter_danske_regler = Ligningslov33ALønindkomstEfterDanskeRegler(
                skattepligtig_nettoindkomst_kroner = udenlandsk_bruttoløn_kroner * 92 / 100,
                personlig_nettoindkomst_kroner = udenlandsk_bruttoløn_kroner * 92 / 100,
                arbejdsmarkedsbidragsgrundlag_kroner = udenlandsk_bruttoløn_kroner
            ),
            heraf_arbejde_i_riget_efter_danske_regler = ligningslov33a_tom_lønindkomst()
        )
    ),
    henstand = Ll33AIngenHenstand
)
| personskat_ligningslov33a_scenarie_årsinput(identifikation: Tekst, udenlandsk_bruttoløn_kroner: Heltal) -> Ligningslov33AÅrsinput(
    indkomstår = 2026,
    ansættelsesforhold = [personskat_ligningslov33a_scenarie_ansættelsesforhold(identifikation, udenlandsk_bruttoløn_kroner)]
)
| personskat_ligningslov33_scenarie_fragtskattegruppe() -> Ligningslov33PersonKreditgruppe(
    identifikation = "norsk-fragtskat-2026",
    grupperingsgrundlag = Ll33SamletIndkomstFraSkatteområdet,
    indkomstfakta = Ligningslov33Indkomstfakta(
        område = Ll33FremmedStat(landekode = "NO"),
        udenlandsk_bruttoindkomst_kroner = 100000,
        direkte_henførbare_udgifter_kroner = 0
    ),
    skattebetalinger = [Ligningslov33Skattebetaling(
        opkrævningsmåde = Ll33DirektePåligning,
        betalt_udenlandsk_skat_øre = 100000,
        skatteart = Ll33FragtskatPåBruttofortjenesteVedInternationalSkibstrafik,
        betalingsdokumentreference = "Norsk fragtskattebilag 2026",
        overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst
    )],
    udenlandsk_indkomst_efter_danske_regler = Ligningslov33UdenlandskIndkomstEfterDanskeRegler(
        skattepligtig_nettoindkomst_efter_par33f_kroner = 100000,
        personlig_nettoindkomst_efter_par33f_kroner = 0,
        positiv_kapitalnettoindkomst_efter_par33f_kroner = 0,
        aktienettoindkomst_efter_par33f_kroner = 0,
        cfc_nettoindkomst_efter_par33f_kroner = 0,
        arbejdsmarkedsbidragsgrundlag_kroner = 0
    ),
    lønlempelsesstatus = Ll33IngenLønindkomst
)
| personskat_ligningslov33_scenarie_fragtskat_årsinput(indkomstår: Heltal) -> Ligningslov33PersonÅrsinput(
    indkomstår = indkomstår,
    dansk_bruttoindkomst_kroner = 600000,
    ikke_henførbare_udgifter_kroner = 0,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
    kreditgrupper = [personskat_ligningslov33_scenarie_fragtskattegruppe()],
    par6_kreditter = [],
    fragtskat_åbningssaldi = [Ligningslov33FragtskatSaldo(
        område = Ll33FremmedStat(landekode = "NO"),
        indkomstår = 2025,
        saldo_øre = 100000,
        dokumentreferencer = ["Futuruna-fragtskattesaldo 2025"]
    )]
)
| personskat_ligningslov33_scenarie_fast_ejendom() -> PersonskatEjendomsavanceFakta(
    identifikation = "udenlandsk-fast-ejendom",
    afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = 1100000,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = ebl_par5_standardfakta(
        EblDato(år = 2026, måned = 1, dag = 1),
        EblPar4AlmindeligtAnskaffelsesgrundlag
    ),
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = 1200000,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = ebl_anden_fast_ejendom_uden_genanbringelse(),
    par11_stk2_valg = EblPar11Stk2IngenNyGenanbringelse,
    par6d_valg = EblUdenPar6DValg
)
| personskat_ligningslov33_scenarie_kapitalindkomst_med_fast_ejendom() -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = MedEjendomsavance(fakta = PersonskatEjendomsavanceÅrsfakta(
        egne_afståelser = [personskat_ligningslov33_scenarie_fast_ejendom()],
        egne_skadegenopførelser = [],
        eget_fremført_tab = UdenFremførtEjendomstab,
        ægtefælles_afståelser = [],
        ægtefælles_skadegenopførelser = [],
        ægtefælles_fremførte_tab = UdenFremførtEjendomstab,
        gift_samlevende_ved_indkomstårets_udgang = Falskt
    )),
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    omkostninger = []
)
| personskat_ligningslov33_scenarie_par6_årsinput(handelsværdi_kroner: Heltal) -> Ligningslov33PersonÅrsinput(
    indkomstår = 2026,
    dansk_bruttoindkomst_kroner = 600000,
    ikke_henførbare_udgifter_kroner = 0,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
    kreditgrupper = [],
    par6_kreditter = [Ligningslov33Par6Kreditfakta(
        grundlag = Ligningslov33Par6Kreditgrundlag(
            kildeskat10_aktivfakta = Kildeskat10Aktivfakta(
                identifikation = "udenlandsk-fast-ejendom",
                grænsehændelse = Ksl10FuldSkattepligtEfterPar1Ophører(dato = Dato(år = 2026, måned = 12, dag = 31)),
                dansk_beskatningsstatus_efter_hændelsen = Ksl10AktivIkkeLængereOmfattetAfDanskBeskatning,
                særregel = Ksl10IngenSærregel,
                handelsværdi_på_grænsetidspunktet_kroner = handelsværdi_kroner
            ),
            aktivgrundlag = Ll33Par6FastEjendomEfterEjendomsavancebeskatningsloven,
            udenlandsk_skat_som_kunne_være_pålignet_øre = 4000000,
            dokumentreference = "Udenlandsk skatteberegning XX-2026"
        ),
        identifikation = "par6-udenlandsk-fast-ejendom",
        grupperingsgrundlag = Ll33SamletIndkomstFraSkatteområdet,
        område = Ll33FremmedStat(landekode = "XX"),
        udenlandsk_bruttoindkomst_kroner = 90000,
        direkte_henførbare_udgifter_kroner = 0,
        overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst,
        udenlandsk_indkomst_efter_danske_regler = Ligningslov33UdenlandskIndkomstEfterDanskeRegler(
            skattepligtig_nettoindkomst_efter_par33f_kroner = 90000,
            personlig_nettoindkomst_efter_par33f_kroner = 0,
            positiv_kapitalnettoindkomst_efter_par33f_kroner = 90000,
            aktienettoindkomst_efter_par33f_kroner = 0,
            cfc_nettoindkomst_efter_par33f_kroner = 0,
            arbejdsmarkedsbidragsgrundlag_kroner = 0
        ),
        lønlempelsesstatus = Ll33IngenLønindkomst
    )],
    fragtskat_åbningssaldi = []
)
| personskat_ligningslov33_scenarie_komponent(gruppe: Ligningslov33PersonKreditgrupperesultat, art: Ligningslov33PersonSkattekomponentart) -> head(filter(
    gruppe.komponenter,
    |resultat: Ligningslov33PersonKomponentresultat| resultat.komponent.art == art
))

= personskat_ligningslov33_ordinær_løngruppe = personskat_ligningslov33_scenarie_kreditgruppe(
    "svensk-løn",
    120000,
    5000000,
    Ll33OrdinærCreditlempetLønindkomst
)
= personskat_ligningslov33_ordinær_løninput = PersonskatLigningslov33ParInput(
    hovedperson = MedLigningslov33(input = personskat_ligningslov33_scenarie_årsinput(480000, personskat_ligningslov33_ordinær_løngruppe)),
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
= personskat_ligningslov33_ordinær_lønresultat = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    personskat_ligningslov33_ordinær_løninput
))
= personskat_ligningslov33_ordinær_lønneutral = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    personskat_uden_ligningslov33()
))

= personskat_ligningslov33_par33a_input = PersonskatLigningslov33ParInput(
    hovedperson = MedLigningslov33(input = personskat_ligningslov33_scenarie_årsinput(
        480000,
        personskat_ligningslov33_scenarie_kreditgruppe("løn-efter-par33a", 120000, 5000000, Ll33LønindkomstOmfattetAfPar33A)
    )),
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
= personskat_ligningslov33_par33a_resultat = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    personskat_ligningslov33_par33a_input
))

= personskat_ligningslov33a_kanonisk_input = PersonskatLigningslov33ParInput(
    hovedperson = UdenLigningslov33,
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = MedLigningslov33A(input = personskat_ligningslov33a_scenarie_årsinput("kanonisk-par33a", 120000)),
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
= personskat_ligningslov33a_kanonisk_resultat = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    personskat_ligningslov33a_kanonisk_input
))

= personskat_ligningslov33_ægtefælle = MedÆgtefælle(
    fakta = personskat_ligningslov33_scenarie_person(300000),
    samlevende_ved_indkomstårets_udløb = Sandt
)
= personskat_ligningslov33_ægtefælleinput = PersonskatLigningslov33ParInput(
    hovedperson = UdenLigningslov33,
    ægtefælle = MedLigningslov33(input = personskat_ligningslov33_scenarie_årsinput(
        240000,
        personskat_ligningslov33_scenarie_kreditgruppe("ægtefælles-svenske-løn", 60000, 2000000, Ll33OrdinærCreditlempetLønindkomst)
    )),
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
= personskat_ligningslov33_ægtefælle_beregning = beregn_personskat(personskat_ligningslov33_scenarie_input(
    personskat_ligningslov33_ægtefælle,
    personskat_ligningslov33_ægtefælleinput
))
= personskat_ligningslov33_ægtefælleneutral = beregn_personskat(personskat_ligningslov33_scenarie_input(
    personskat_ligningslov33_ægtefælle,
    personskat_uden_ligningslov33()
))

= personskat_ligningslov33a_ægtefælleinput = PersonskatLigningslov33ParInput(
    hovedperson = UdenLigningslov33,
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = MedLigningslov33A(input = personskat_ligningslov33a_scenarie_årsinput("ægtefælles-par33a", 60000))
)
= personskat_ligningslov33a_ægtefælle_beregning = beregn_personskat(personskat_ligningslov33_scenarie_input(
    personskat_ligningslov33_ægtefælle,
    personskat_ligningslov33a_ægtefælleinput
))

= personskat_ligningslov33_par6_kapitalindkomst = personskat_ligningslov33_scenarie_kapitalindkomst_med_fast_ejendom()
= personskat_ligningslov33_par6_input = PersonskatLigningslov33ParInput(
    hovedperson = MedLigningslov33(input = personskat_ligningslov33_scenarie_par6_årsinput(1200000)),
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
= personskat_ligningslov33_par6_resultat = beregn_personskat(personskat_ligningslov33_scenarie_input_med_kapitalindkomst(
    personskat_ligningslov33_par6_kapitalindkomst,
    UdenÆgtefælle,
    personskat_ligningslov33_par6_input
))
= personskat_ligningslov33_par6_neutral = beregn_personskat(personskat_ligningslov33_scenarie_input_med_kapitalindkomst(
    personskat_ligningslov33_par6_kapitalindkomst,
    UdenÆgtefælle,
    personskat_uden_ligningslov33()
))
= personskat_ligningslov33_par6_uafstemt_handelsværdi = beregn_personskat(personskat_ligningslov33_scenarie_input_med_kapitalindkomst(
    personskat_ligningslov33_par6_kapitalindkomst,
    UdenÆgtefælle,
    PersonskatLigningslov33ParInput(
        hovedperson = MedLigningslov33(input = personskat_ligningslov33_scenarie_par6_årsinput(1200001)),
        ægtefælle = UdenLigningslov33,
        ligningslov33a_hovedperson = UdenLigningslov33A,
        ligningslov33a_ægtefælle = UdenLigningslov33A
    )
))
= personskat_ligningslov33_fragtskat_input = PersonskatLigningslov33ParInput(
    hovedperson = MedLigningslov33(input = personskat_ligningslov33_scenarie_fragtskat_årsinput(2026)),
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
= personskat_ligningslov33_fragtskat_resultat = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    personskat_ligningslov33_fragtskat_input
))
= personskat_ligningslov33_fragtskat_neutral = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    personskat_uden_ligningslov33()
))
= personskat_ligningslov33_fragtskat_forkert_indkomstår = beregn_personskat(personskat_ligningslov33_scenarie_input(
    UdenÆgtefælle,
    PersonskatLigningslov33ParInput(
        hovedperson = MedLigningslov33(input = personskat_ligningslov33_scenarie_fragtskat_årsinput(2025)),
        ægtefælle = UdenLigningslov33,
        ligningslov33a_hovedperson = UdenLigningslov33A,
        ligningslov33a_ægtefælle = UdenLigningslov33A
    )
