@ print("scenarie1 mand årlig skat inkl. AM efter personfradrag: " + vis(scenarie1_mand.samlet_inkl_am_efter_personfradrag_kroner))
@ print("scenarie1 mand månedlig skat afrundet ned i kroner: " + vis(scenarie1_mand.samlet_inkl_am_efter_personfradrag_kroner / 12))
@ print("scenarie1 mand månedlig netto afrundet ned i kroner: " + vis((scenarie1_mand.bruttoløn_kroner - scenarie1_mand.samlet_inkl_am_efter_personfradrag_kroner) / 12))
@ print("scenarie1 husholdning samlet månedlig netto afrundet ned i kroner: " + vis(scenarie1_husholdning.samlet_netto_månedligt_kroner))
@ print("scenarie1 husholdning efter husleje afrundet ned i kroner: " + vis(scenarie1_husholdning.efter_husleje_månedligt_kroner))
@ print("scenarie1 mand månedlig A-skat med oplyst e-skattekort: " + vis(scenarie1_mand_skattekort_a_skat))
@ print("scenarie1 husholdning lønudbetaling efter AM og A-skat med oplyst e-skattekort: " + vis(scenarie1_indeholdelse.samlet_lønudbetaling_månedligt_kroner))
@ print("scenarie1 husholdning lønudbetaling efter husleje med oplyst e-skattekort: " + vis(scenarie1_indeholdelse.efter_husleje_lønudbetaling_månedligt_kroner))
@ print("scenarie1 mand afledt uafrundet indeholdelsesprocent: " + vis(scenarie1_mand_afledt_indeholdelsesprocent))
@ print("scenarie1 mand genereret månedsfradrag fra forskudsskat: " + vis(scenarie1_mand_genereret_skattekort.månedsfradrag_kroner))
@ print("scenarie1 mand månedlig A-skat med genereret e-skattekort: " + vis(scenarie1_mand_genereret_skattekort_a_skat))
@ print("scenarie1 husholdning lønudbetaling efter husleje med genereret e-skattekort: " + vis(scenarie1_genereret_indeholdelse.efter_husleje_lønudbetaling_månedligt_kroner))
@ print("scenarie1 mand A-skat hvis intet e-skattekort er modtaget: " + vis(scenarie1_mand_manglende_skattekort_a_skat))
