@ sprog da

@ importer ./loenmodtager_beregning
@ importer ./kildeskatteloven
@ importer ./kildeskattebekendtgoerelsen
@ importer ./forskudsregistrering_2026

-- Personskatteloven — executable fictional household scenarios.
--
-- This file is deliberately a scenario/audit fixture, not a legal source
-- translation. Legal text remains in the law modules; this file records
-- assumptions and checks whether the current executable model can answer a
-- normal household question.

----
Scenario 1
Skatteår: 2026
Kommune: København
Mandens bruttoløn: 50.000 kr. pr. måned, 600.000 kr. pr. år.
Ægtefællens bruttoløn: 20.000 kr. pr. måned, 240.000 kr. pr. år.
Bolig: leje 10.000 kr. pr. måned.
Børn: 3 børn på 2, 7 og 10 år.
Kirkeskat: nej for begge ægtefæller.
Positiv nettokapitalindkomst: 0 kr.
Øvrige ligningsmæssige fradrag ud over Ligningsloven §§ 9 J og 9 K: 0 kr.

Illustrative e-skattekort input:
Mandens skattekort: 12.000 kr. månedsfradrag, 38 pct. trækprocent.
Ægtefællens skattekort: 7.000 kr. månedsfradrag, 37 pct. trækprocent.

Generated forskudsopgørelse-to-e-skattekort input:
Mandens forskudsskat til A-skat: slutskat inkl. AM minus AM-bidrag.
Ægtefællens forskudsskat til A-skat: slutskat inkl. AM minus AM-bidrag.
Uafrundet indeholdelsesprocent afledes efter BEK nr. 1094/2025 § 6 og forhøjes
til nærmeste hele procent efter BEK nr. 839/2025 § 12, stk. 3.

Current model scope: ordinary wage tax under Personskatteloven with AM-bidrag,
municipal tax, church-tax membership switch, personfradrag, 2026 state-tax
thresholds, ordinary Ligningsloven §§ 9 J and 9 K wage-earner deductions, and
Kildeskatteloven monthly A-skat from provided e-skattekort inputs or generated
BEK 2025/839 card values using BEK 2025/1094 withholding percentages. Rent is
subtracted as a cash-flow scenario fact.
Child benefits, housing support, other deduction discovery, social-benefit
rules, and payroll settlement are not encoded in this slice.
----

# HusholdningScenarieResult(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown, samlet_skat_årligt_kroner: Heltal, samlet_netto_årligt_kroner: Heltal, samlet_netto_månedligt_kroner: Heltal, husleje_månedligt_kroner: Heltal, efter_husleje_månedligt_kroner: Heltal)
# HusholdningIndeholdelseScenarieResult(mand_a_skat_månedligt_kroner: Heltal, ægtefælle_a_skat_månedligt_kroner: Heltal, mand_lønudbetaling_månedligt_kroner: Heltal, ægtefælle_lønudbetaling_månedligt_kroner: Heltal, samlet_lønudbetaling_månedligt_kroner: Heltal, efter_husleje_lønudbetaling_månedligt_kroner: Heltal)

| husholdning_samlet_skat_årligt(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown) -> mand.samlet_inkl_am_efter_personfradrag_kroner + ægtefælle.samlet_inkl_am_efter_personfradrag_kroner
| husholdning_samlet_netto_årligt(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown) -> mand.bruttoløn_kroner + ægtefælle.bruttoløn_kroner - husholdning_samlet_skat_årligt(mand, ægtefælle)
| husholdning_samlet_netto_månedligt(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown) -> husholdning_samlet_netto_årligt(mand, ægtefælle) / 12
| husholdning_efter_husleje_månedligt(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown, husleje_månedligt_kroner: Heltal) -> husholdning_samlet_netto_månedligt(mand, ægtefælle) - husleje_månedligt_kroner
| beregn_husholdning_scenarie(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown, husleje_månedligt_kroner: Heltal) -> HusholdningScenarieResult(mand, ægtefælle, husholdning_samlet_skat_årligt(mand, ægtefælle), husholdning_samlet_netto_årligt(mand, ægtefælle), husholdning_samlet_netto_månedligt(mand, ægtefælle), husleje_månedligt_kroner, husholdning_efter_husleje_månedligt(mand, ægtefælle, husleje_månedligt_kroner))
| lønmodtager_bruttoløn_månedligt(person: LønmodtagerBreakdown) -> person.bruttoløn_kroner / 12
| lønmodtager_am_månedligt(person: LønmodtagerBreakdown) -> person.arbejdsmarkedsbidrag_kroner / 12
| lønmodtager_lønudbetaling_månedligt(person: LønmodtagerBreakdown, a_skat_månedligt_kroner: Heltal) -> lønmodtager_bruttoløn_månedligt(person) - lønmodtager_am_månedligt(person) - a_skat_månedligt_kroner
| husholdning_lønudbetaling_månedligt(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown, mand_a_skat_månedligt_kroner: Heltal, ægtefælle_a_skat_månedligt_kroner: Heltal) -> lønmodtager_lønudbetaling_månedligt(mand, mand_a_skat_månedligt_kroner) + lønmodtager_lønudbetaling_månedligt(ægtefælle, ægtefælle_a_skat_månedligt_kroner)
| beregn_husholdning_indeholdelse_scenarie(mand: LønmodtagerBreakdown, ægtefælle: LønmodtagerBreakdown, mand_a_skat_månedligt_kroner: Heltal, ægtefælle_a_skat_månedligt_kroner: Heltal, husleje_månedligt_kroner: Heltal) -> HusholdningIndeholdelseScenarieResult(mand_a_skat_månedligt_kroner, ægtefælle_a_skat_månedligt_kroner, lønmodtager_lønudbetaling_månedligt(mand, mand_a_skat_månedligt_kroner), lønmodtager_lønudbetaling_månedligt(ægtefælle, ægtefælle_a_skat_månedligt_kroner), husholdning_lønudbetaling_månedligt(mand, ægtefælle, mand_a_skat_månedligt_kroner, ægtefælle_a_skat_månedligt_kroner), husholdning_lønudbetaling_månedligt(mand, ægtefælle, mand_a_skat_månedligt_kroner, ægtefælle_a_skat_månedligt_kroner) - husleje_månedligt_kroner)

= scenarie1_mand_input = LønmodtagerInput(2026, København, 600000, 0, 0, Fyldt18EllerGift, Falskt)
= scenarie1_ægtefælle_input = LønmodtagerInput(2026, København, 240000, 0, 0, Fyldt18EllerGift, Falskt)
= scenarie1_mand = beregn_lønmodtager(scenarie1_mand_input)
= scenarie1_ægtefælle = beregn_lønmodtager(scenarie1_ægtefælle_input)
= scenarie1_husholdning = beregn_husholdning_scenarie(scenarie1_mand, scenarie1_ægtefælle, 10000)
= scenarie1_mand_månedsløn_a_indkomst = kildeskat_a_indkomst_beløb_kroner(KildeskatAIndkomstInput(50000, 0, Sandt, Falskt, Falskt))
= scenarie1_ægtefælle_månedsløn_a_indkomst = kildeskat_a_indkomst_beløb_kroner(KildeskatAIndkomstInput(20000, 0, Sandt, Falskt, Falskt))
= scenarie1_mand_a_skat_indeholdelsespligt = kildeskat_a_skat_skal_indeholdes(KildeskatIndeholdelsespligtInput(scenarie1_mand_månedsløn_a_indkomst, Sandt, 0))
= scenarie1_mand_manglende_skattekort_a_skat = kildeskat_a_skat_kroner(KildeskatSkattekortInput(scenarie1_mand_månedsløn_a_indkomst, 0, 0, IntetESkattekort))
= scenarie1_mand_skattekort_input = KildeskatESkattekortInput(scenarie1_mand_månedsløn_a_indkomst, 12000, 6000, 3000, 600, 3800, 0, Skattekort, Måned, Sandt)
= scenarie1_ægtefælle_skattekort_input = KildeskatESkattekortInput(scenarie1_ægtefælle_månedsløn_a_indkomst, 7000, 3500, 1750, 350, 3700, 0, Skattekort, Måned, Sandt)
= scenarie1_mand_skattekort_a_skat = kildeskat_a_skat_med_eskattekort_kroner(scenarie1_mand_skattekort_input)
= scenarie1_ægtefælle_skattekort_a_skat = kildeskat_a_skat_med_eskattekort_kroner(scenarie1_ægtefælle_skattekort_input)
= scenarie1_indeholdelse = beregn_husholdning_indeholdelse_scenarie(scenarie1_mand, scenarie1_ægtefælle, scenarie1_mand_skattekort_a_skat, scenarie1_ægtefælle_skattekort_a_skat, 10000)
= scenarie1_mand_forskudsskat_til_a_skat = scenarie1_mand.samlet_inkl_am_efter_personfradrag_kroner - scenarie1_mand.arbejdsmarkedsbidrag_kroner
= scenarie1_ægtefælle_forskudsskat_til_a_skat = scenarie1_ægtefælle.samlet_inkl_am_efter_personfradrag_kroner - scenarie1_ægtefælle.arbejdsmarkedsbidrag_kroner
= scenarie1_mand_forskudsprocent_input = Forskudsregistrering2026IndeholdelsesprocentInput(forskudsregistrering_2026_skattekommune_for(2026, København, Falskt), Forskudsregistrering2026Progressionsgrundlag(scenarie1_mand.personlig_indkomst_efter_am_kroner, 0), Forskudsregistrering2026Progressionsskatter(scenarie1_mand.mellemskat_før_personfradrag_kroner, scenarie1_mand.topskat_før_personfradrag_kroner, scenarie1_mand.toptopskat_før_personfradrag_kroner))
= scenarie1_ægtefælle_forskudsprocent_input = Forskudsregistrering2026IndeholdelsesprocentInput(forskudsregistrering_2026_skattekommune_for(2026, København, Falskt), Forskudsregistrering2026Progressionsgrundlag(scenarie1_ægtefælle.personlig_indkomst_efter_am_kroner, 0), Forskudsregistrering2026Progressionsskatter(scenarie1_ægtefælle.mellemskat_før_personfradrag_kroner, scenarie1_ægtefælle.topskat_før_personfradrag_kroner, scenarie1_ægtefælle.toptopskat_før_personfradrag_kroner))
= scenarie1_mand_afledt_indeholdelsesprocent = forskudsregistrering_2026_indeholdelsesprocent_basispoint(scenarie1_mand_forskudsprocent_input)
= scenarie1_ægtefælle_afledt_indeholdelsesprocent = forskudsregistrering_2026_indeholdelsesprocent_basispoint(scenarie1_ægtefælle_forskudsprocent_input)
= scenarie1_mand_genereret_skattekort_indkomstgrundlag = KildeskattebekendtgørelseForskudskortIndkomstgrundlag(scenarie1_mand.personlig_indkomst_efter_am_kroner, scenarie1_mand.personlig_indkomst_efter_am_kroner / 12, 0)
= scenarie1_ægtefælle_genereret_skattekort_indkomstgrundlag = KildeskattebekendtgørelseForskudskortIndkomstgrundlag(scenarie1_ægtefælle.personlig_indkomst_efter_am_kroner, scenarie1_ægtefælle.personlig_indkomst_efter_am_kroner / 12, 0)
= scenarie1_mand_genereret_skattekort = kildeskattebekendtgørelse_skattekort_resultat(KildeskattebekendtgørelseForskudskortInput(2026, scenarie1_mand_genereret_skattekort_indkomstgrundlag, scenarie1_mand_forskudsskat_til_a_skat, scenarie1_mand_afledt_indeholdelsesprocent, 5200, 0, Sandt, Sandt, Måned, Sandt))
= scenarie1_ægtefælle_genereret_skattekort = kildeskattebekendtgørelse_skattekort_resultat(KildeskattebekendtgørelseForskudskortInput(2026, scenarie1_ægtefælle_genereret_skattekort_indkomstgrundlag, scenarie1_ægtefælle_forskudsskat_til_a_skat, scenarie1_ægtefælle_afledt_indeholdelsesprocent, 5200, 0, Sandt, Sandt, Måned, Sandt))
= scenarie1_mand_genereret_skattekort_a_skat = kildeskat_a_skat_med_eskattekort_kroner(scenarie1_mand_genereret_skattekort.eskattekort)
= scenarie1_ægtefælle_genereret_skattekort_a_skat = kildeskat_a_skat_med_eskattekort_kroner(scenarie1_ægtefælle_genereret_skattekort.eskattekort)
= scenarie1_genereret_indeholdelse = beregn_husholdning_indeholdelse_scenarie(scenarie1_mand, scenarie1_ægtefælle, scenarie1_mand_genereret_skattekort_a_skat, scenarie1_ægtefælle_genereret_skattekort_a_skat, 10000)

