--@label:søbl5_til8_par5::meta:søbl5_til8_par5_metadata--
----
§ 5. Har en person, der er skattepligtig efter kildeskattelovens § 1, erhvervet lønindkomst ved arbejde om bord på et dansk skib, som er registreret i Dansk Internationalt Skibsregister, og som udelukkende anvendes til formål, som vil kunne omfattes af tonnageskatteloven, nedsættes den samlede indkomstskat med det beløb, der forholdsmæssigt falder på denne indkomst. 1. pkt. finder tilsvarende anvendelse på dødsboer omfattet af dødsboskattelovens § 1, stk. 2. Gratialer og fratrædelsesgodtgørelser m.v., jf. ligningslovens § 7 U, er omfattet af 1. pkt., når den pågældende ydelse har direkte tilknytning til arbejde udført om bord på skib som nævnt i 1. pkt.

Stk. 2. Personer, som er skattepligtige efter kildeskattelovens § 2, stk. 2, svarer ikke skat af lønindkomst erhvervet ved arbejde om bord på et dansk skib, som er registreret i Dansk Internationalt Skibsregister, og som udelukkende anvendes til formål, som vil kunne omfattes af tonnageskatteloven. Stk. 1, 3. pkt., finder tilsvarende anvendelse.

Stk. 3. Stk. 1 og 2 og § 3 gælder også ved arbejde om bord på et specialfartøj, når fartøjet er registreret i Dansk Internationalt Skibsregister og udelukkende udfører aktiviteter, der vil kunne omfattes af tonnageskattelovens § 6 eller § 8 a, nr. 1 eller 2 eller nr. 3, 1. pkt., hvor betingelsen i 2. pkt. ikke finder tilsvarende anvendelse, eller nr. 4-6.

Stk. 4. Skattefritagelse efter stk. 1-3 er betinget af, at løn og godtgørelser m.v. er fastsat under hensyn til skattefritagelsen.

Stk. 5. Personer, som kan anvende stk. 1-3, er ikke omfattet af ligningslovens § 9 A, stk. 1-9.

§ 5 a. (Ophævet)
----

--@begin::søbl5_til8_par5--
# Søbl5Til8Skattepligt = SøblFuldtSkattepligtigEfterKsl1 | SøblBegrænsetSkattepligtigEfterKsl2Stk2 | SøblDødsboEfterDødsboskattelov1Stk2 | SøblKulbrinteskattepligtigEfterPar21Stk2 | SøblAndenSkattepligtsposition
# Søbl5Til8Skattepligtskategori = SøblIngenSkattepligtskategori | SøblFuldSkattepligtKategori | SøblBegrænsetSkattepligtKategori | SøblDødsboSkattepligtKategori | SøblKulbrinteSkattepligtKategori | SøblAndenSkattepligtKategori
# Søbl5Til8Statsborgerskab = SøblStatsborgerIEUEØS | SøblStatsborgerISchweiz | SøblBritiskStatsborgerOmfattetAfUdtrædelsesaftalen | SøblAndetStatsborgerskab
# Søbl5Til8Flag = SøblEUEØSFlag | SøblFlagUdenForEUEØS
# Søbl5Til8Registrering = SøblDanskSkibRegistreretIDIS | SøblDanskSkibRegistreretIDAS | SøblUdenlandskSkibRegistreretIEUEØS(flag: Søbl5Til8Flag) | SøblSkibRegistreretUdenForEUEØS(flag: Søbl5Til8Flag)
# Søbl5Til8Arbejdsgiverstatus = SøblDanskArbejdsgiver | SøblUdenlandskArbejdsgiverGodkendtEfterPar11A | SøblUdenlandskArbejdsgiverIkkeGodkendtEfterPar11A
# Søbl5Til8Skibsfakta(identifikation: Tekst, registrering: Søbl5Til8Registrering, bruttotonnage: Heltal, arbejdsgiverstatus: Søbl5Til8Arbejdsgiverstatus)
# Søbl5Til8Arbejdsområde = SøblArbejdeIndenForEUEØS | SøblArbejdeUdenForEUEØS
# Søbl5Til8Passagerrute = SøblIngenPassagersejlads | SøblIkkeRegelmæssigPassagersejladsMellemEUEØSHavne | SøblRegelmæssigPassagersejladsMellemEUEØSHavne | SøblRegelmæssigPassagersejladsMellemDanskeHavne | SøblPassagersejladsMellemDanskeHavneTilFraHavanlæg | SøblAndenPassagersejladsMellemDanskeHavne
# Søbl6Driftstid(søtransport_minutter: Heltal, mobilisering_til_søs_minutter: Heltal, andre_aktiviteter_minutter: Heltal, ventetid_minutter: Heltal)
# Søbl6Skibsårsdriftfakta(skibsidentifikation: Tekst, indkomstår: Heltal, driftstid: Søbl6Driftstid)
# Søbl5Til8Aktivitet = SøblTransportAfGodsMellemForskelligeDestinationer | SøblTransportAfPassagererMellemForskelligeDestinationer | SøblVagttjeneste | SøblStøtteOgServicefunktion | SøblBygningReparationEllerNedtagningAfHavanlæg | SøblRørledningEllerKabelPåHavbunden | SøblIshåndtering | SøblHusningVedOffshorearbejde | SøblBugseringOgBjærgning | SøblStenfiskeriEllerSandsugning | SøblAndenSkibsaktivitet
# Søbl5Til8Anvendelsesforløb = SøblUdelukkendeAnvendtTil(aktivitet: Søbl5Til8Aktivitet) | SøblPeriodeMedFlereEllerUoplysteAnvendelser
# Søbl5Til8Indkomsttype = SøblLønVedArbejdeOmBord | SøblLigningslov7UYdelseMedDirekteTilknytning | SøblLigningslov7UYdelseUdenDirekteTilknytning | SøblAndenIndkomsttype
# Søbl5Til8Løngrundlag = SøblSkattefriNettolønFastsatUnderHensynTilFritagelsen | SøblOrdinærBruttoløn | SøblNettolønUdenDokumenteretFastsættelse
# Søbl5Til8Lønfakta(indkomsttype: Søbl5Til8Indkomsttype, løngrundlag: Søbl5Til8Løngrundlag, beløb_kroner: Heltal)
# Søbl5Til8AndenLigningslov7UIndkomstfakta(identifikation: Tekst, beløb_kroner: Heltal)
# Søbl8Beskatningsvalg = SøblAnvendPar8DIS | SøblAnvendPar10RefusionEllerAlmindeligBeskatning
# Søbl5Til8Personfakta(skattepligt: Søbl5Til8Skattepligt, statsborgerskab: Søbl5Til8Statsborgerskab, relation: Søbl5Til8Personrelation)
# Søbl5Til8Arbejdsfakta(anvendelse: Søbl5Til8Anvendelsesforløb, arbejdsområde: Søbl5Til8Arbejdsområde, passagerrute: Søbl5Til8Passagerrute, arbejdsrolle: Søbl5Til8Arbejdsrolle, par8_valg: Søbl8Beskatningsvalg)
# Søbl5Til8Indkomstfakta(identifikation: Tekst, indkomstår: Heltal, person: Søbl5Til8Personfakta, skib: Søbl5Til8Skibsfakta, arbejde: Søbl5Til8Arbejdsfakta, løn: Søbl5Til8Lønfakta)
# Søbl5Dødsboskattegrundlag = Søbl5IntetDødsboskattegrundlag | Søbl5Dødsboskattegrundlag(input: Dødsboskattelov30Input)
# Søbl5BKulbrinteskattegrundlag = Søbl5BIntetKulbrinteskattegrundlag | Søbl5BKulbrinteskattegrundlag(kildefakta: Kulbrinteskattelov21Stk2Kildefakta)
# Søbl5Til8Årsinput(indkomster: List(Søbl5Til8Indkomstfakta), skibsårsdrifter: List(Søbl6Skibsårsdriftfakta), andre_ligningslov7u_indkomster: List(Søbl5Til8AndenLigningslov7UIndkomstfakta), dødsboskattegrundlag: Søbl5Dødsboskattegrundlag, kulbrinteskattegrundlag: Søbl5BKulbrinteskattegrundlag)
# Søbl5Til8Beskatningsvirkning = SøblIngenDISVirkning | SøblNedsættelseAfSamletIndkomstskat | SøblNedsættelseAfDødsboskat | SøblIngenDanskSkatEfterPar5Stk2 | SøblKulbrinteskattelov21Stk2Virkning
# Søbl5Til8Retsgrundlag = SøblIntetRetsgrundlag | SøblPar5Stk1 | SøblPar5Stk1Dødsbo | SøblPar5Stk2 | SøblPar5B | SøblPar6 | SøblPar7 | SøblPar8
# Søbl6Skibsårsdriftresultat(fakta: Søbl6Skibsårsdriftfakta, input_gyldigt: Boolsk, søtransportminutter_før_ventetid: Heltal, aktive_minutter_før_ventetid: Heltal, ventetid_til_søtransport_tæller: Heltal, ventetid_til_andre_aktiviteter_tæller: Heltal, ventetidsfordeling_nævner: Heltal, søtransport_inkl_fordelt_ventetid_tæller: Heltal, samlet_driftstid_tæller: Heltal, samlet_driftstid_minutter: Heltal, søtransportandel_mindst_halvdelen: Boolsk)
# Søbl6IndkomstÅrsdriftsrelation = Søbl6ÅrsdriftIkkePåkrævet | Søbl6ÅrsdriftMangler | Søbl6ÅrsdriftFlertydig | Søbl6ÅrsdriftUgyldig(resultat: Søbl6Skibsårsdriftresultat) | Søbl6ÅrsdriftTilknyttet(resultat: Søbl6Skibsårsdriftresultat)
# Søbl6Årsdriftsgrundlagsresultat(indkomstår: Heltal, resultater: List(Søbl6Skibsårsdriftresultat), identifikationer_entydige: Boolsk, alle_input_gyldige: Boolsk, alle_fakta_anvendt: Boolsk, skibsfakta_konsistente: Boolsk, alle_bugserindkomster_tilknyttet: Boolsk, input_gyldigt: Boolsk)
# Søbl5Til8Indkomstresultat(fakta: Søbl5Til8Indkomstfakta, årsdriftsrelation: Søbl6IndkomstÅrsdriftsrelation, input_gyldigt: Boolsk, arbejdsrolle_omfattet: Boolsk, aflønningsbetingelse_opfyldt: Boolsk, indkomsttype_omfattet: Boolsk, nettolønsbetingelse_opfyldt: Boolsk, tonnageskatteaktivitet_opfyldt: Boolsk, par5_opfyldt: Boolsk, par5b_opfyldt: Boolsk, par6_opfyldt: Boolsk, par7_opfyldt: Boolsk, par8_opfyldt: Boolsk, kan_anvende_par5_til8: Boolsk, retsgrundlag: Søbl5Til8Retsgrundlag, beskatningsvirkning: Søbl5Til8Beskatningsvirkning, dis_personlig_indkomst_kroner: Heltal, ordinær_bruttoløn_kroner: Heltal, uafklaret_nettoløn_kroner: Heltal, arbejdsmarkedsbidrag_af_dis_indkomst_kroner: Heltal, ligningslov9a_stk1_til9_afskåret: Boolsk)
# Søbl5Til8Ligningslov7UBundfradragsresultat(indkomstår: Heltal, andre_indkomster: List(Søbl5Til8AndenLigningslov7UIndkomstfakta), input_gyldigt: Boolsk, andre_indkomstidentifikationer_entydige: Boolsk, direkte_dis_nettoløn_før_bundfradrag_kroner: Heltal, anden_indkomst_før_bundfradrag_kroner: Heltal, samlet_indkomst_før_bundfradrag_kroner: Heltal, fuldt_bundfradrag_kroner: Heltal, anvendt_bundfradrag_kroner: Heltal, bundfradrag_fordelt_til_dis_kroner: Heltal, bundfradrag_fordelt_til_anden_indkomst_kroner: Heltal, direkte_dis_nettoløn_efter_bundfradrag_kroner: Heltal, anden_indkomst_efter_bundfradrag_kroner: Heltal)
# Søbl5DødsboLempelsesresultat(relevant: Boolsk, grundlag_tilstede: Boolsk, input_gyldigt: Boolsk, beregningsklar: Boolsk, dødsboskat_før_søbl5: Option(Dødsboskattelov30Resultat), dis_nettoløn_før_bundfradrag_kroner: Heltal, bundfradrag_fordelt_til_dis_kroner: Heltal, dis_nettoløn_efter_bundfradrag_kroner: Heltal, dis_nettoløn_i_forholdsmæssigt_grundlag_kroner: Heltal, forholdsmæssig_lempelse_kroner: Heltal, dødsboskat_efter_søbl5_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal)
# Søbl5BegrænsetSkattefritagelsesresultat(relevant: Boolsk, input_gyldigt: Boolsk, beregningsklar: Boolsk, løn_før_bundfradrag_kroner: Heltal, bundfradrag_fordelt_til_dis_kroner: Heltal, løn_uden_dansk_skat_kroner: Heltal, dansk_indkomstskat_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal)
# Søbl5BKulbrinteLempelsesresultat(relevant: Boolsk, grundlag_tilstede: Boolsk, input_gyldigt: Boolsk, beregningsklar: Boolsk, kulbrinteskat_før_søbl5b: Option(Kulbrinteskattelov21Stk2Resultat), løn_før_bundfradrag_kroner: Heltal, bundfradrag_fordelt_til_dis_kroner: Heltal, løn_efter_bundfradrag_kroner: Heltal, indkomstskattenedsættelse_kroner: Heltal, arbejdsmarkedsbidragsfritagelse_kroner: Heltal, samlet_skat_efter_søbl5b_kroner: Heltal)
# Søbl5Til8Årsresultat(indkomstår: Heltal, input: Søbl5Til8Årsinput, årsdriftsgrundlag: Søbl6Årsdriftsgrundlagsresultat, indkomstresultater: List(Søbl5Til8Indkomstresultat), ligningslov7u_bundfradrag: Søbl5Til8Ligningslov7UBundfradragsresultat, skattepligtskategori: Søbl5Til8Skattepligtskategori, skattepligtskategorier_konsistente: Boolsk, dødsbo_lempelse: Søbl5DødsboLempelsesresultat, begrænset_skattefritagelse: Søbl5BegrænsetSkattefritagelsesresultat, kulbrinte_lempelse: Søbl5BKulbrinteLempelsesresultat, ikke_standard_beregningsklar: Boolsk, skatteår_understøttet: Boolsk, identifikationer_entydige: Boolsk, alle_input_gyldige: Boolsk, beregningsklar: Boolsk, kanonisk_fuld_skattepligt_understøttet: Boolsk, kan_anvende_par5_til8: Boolsk, samlet_dis_personlig_indkomst_før_ligningslov7u_bundfradrag_kroner: Heltal, samlet_dis_personlig_indkomst_kroner: Heltal, samlet_ordinær_bruttoløn_kroner: Heltal, samlet_anden_ligningslov7u_indkomst_efter_bundfradrag_kroner: Heltal, samlet_uafklaret_nettoløn_kroner: Heltal, samlet_arbejdsmarkedsbidrag_af_dis_indkomst_kroner: Heltal, ligningslov9a_stk1_til9_afskåret: Boolsk, par13_stk5_lempelsesgrundlag: Par13Stk5Lempelsesgrundlag)

| søbl5_til8_intet_årsinput() -> Søbl5Til8Årsinput(indkomster = [], skibsårsdrifter = [], andre_ligningslov7u_indkomster = [], dødsboskattegrundlag = Søbl5IntetDødsboskattegrundlag, kulbrinteskattegrundlag = Søbl5BIntetKulbrinteskattegrundlag)
| søbl5_til8_skatteår_understøttet(indkomstår: Heltal) -> indkomstår == 2025 || indkomstår == 2026
| søbl5_til8_skattepligtskategori(skattepligt: Søbl5Til8Skattepligt) -> match skattepligt {
    | SøblFuldtSkattepligtigEfterKsl1 -> SøblFuldSkattepligtKategori
    | SøblBegrænsetSkattepligtigEfterKsl2Stk2 -> SøblBegrænsetSkattepligtKategori
    | SøblDødsboEfterDødsboskattelov1Stk2 -> SøblDødsboSkattepligtKategori
    | SøblKulbrinteskattepligtigEfterPar21Stk2 -> SøblKulbrinteSkattepligtKategori
    | SøblAndenSkattepligtsposition -> SøblAndenSkattepligtKategori
}
| søbl5_til8_årsinput_skattepligtskategorier(input: Søbl5Til8Årsinput) -> distinct(map(input.indkomster, |fakta: Søbl5Til8Indkomstfakta| søbl5_til8_skattepligtskategori(fakta.person.skattepligt)))
| søbl5_til8_skattepligtskategorier_konsistente(input: Søbl5Til8Årsinput) -> length(søbl5_til8_årsinput_skattepligtskategorier(input)) <= 1
| søbl5_til8_årsinput_skattepligtskategori(input: Søbl5Til8Årsinput) -> hvis length(søbl5_til8_årsinput_skattepligtskategorier(input)) == 1 { head(søbl5_til8_årsinput_skattepligtskategorier(input)) } ellers { SøblIngenSkattepligtskategori }
| søbl5_til8_par5_skattepligt_opfyldt(skattepligt: Søbl5Til8Skattepligt) -> match søbl5_til8_skattepligtskategori(skattepligt) {
    | SøblFuldSkattepligtKategori -> Sandt
    | SøblBegrænsetSkattepligtKategori -> Sandt
    | SøblDødsboSkattepligtKategori -> Sandt
    | _ -> Falskt
}
| søbl5_til8_identifikationer_entydige(indkomster: List(Søbl5Til8Indkomstfakta)) -> length(distinct(map(indkomster, |fakta: Søbl5Til8Indkomstfakta| fakta.identifikation))) == length(indkomster) && all(indkomster, |fakta: Søbl5Til8Indkomstfakta| fakta.identifikation != "")
| søbl5_til8_registrering_har_eu_eøs_hjemsted(registrering: Søbl5Til8Registrering) -> match registrering {
    | SøblDanskSkibRegistreretIDIS -> Sandt
    | SøblDanskSkibRegistreretIDAS -> Sandt
    | SøblUdenlandskSkibRegistreretIEUEØS(_) -> Sandt
    | _ -> Falskt
}
| søbl5_til8_registrering_har_eu_eøs_flag(registrering: Søbl5Til8Registrering) -> match registrering {
    | SøblDanskSkibRegistreretIDIS -> Sandt
    | SøblDanskSkibRegistreretIDAS -> Sandt
    | SøblUdenlandskSkibRegistreretIEUEØS(flag) -> flag == SøblEUEØSFlag
    | SøblSkibRegistreretUdenForEUEØS(flag) -> flag == SøblEUEØSFlag
}
| søbl5_til8_dansk_dis_skib(skib: Søbl5Til8Skibsfakta) -> skib.registrering == SøblDanskSkibRegistreretIDIS && skib.bruttotonnage >= 20
| søbl5_til8_udenlandsk_eu_eøs_skib(skib: Søbl5Til8Skibsfakta) -> match skib.registrering {
    | SøblUdenlandskSkibRegistreretIEUEØS(flag) -> skib.bruttotonnage >= 20 && flag == SøblEUEØSFlag
    | _ -> Falskt
}
| søbl5_til8_indkomsttype_omfattet(indkomsttype: Søbl5Til8Indkomsttype) -> indkomsttype == SøblLønVedArbejdeOmBord || indkomsttype == SøblLigningslov7UYdelseMedDirekteTilknytning
| søbl5_til8_nettolønsbetingelse_opfyldt(løngrundlag: Søbl5Til8Løngrundlag) -> løngrundlag == SøblSkattefriNettolønFastsatUnderHensynTilFritagelsen
| søbl5_til8_passagerrute_forenelig(aktivitet: Søbl5Til8Aktivitet, passagerrute: Søbl5Til8Passagerrute) -> hvis aktivitet == SøblTransportAfPassagererMellemForskelligeDestinationer { passagerrute != SøblIngenPassagersejlads } ellers { passagerrute == SøblIngenPassagersejlads }
| søbl5_til8_driftstid_gyldig(driftstid: Søbl6Driftstid) -> driftstid.søtransport_minutter >= 0 && driftstid.mobilisering_til_søs_minutter >= 0 && driftstid.andre_aktiviteter_minutter >= 0 && driftstid.ventetid_minutter >= 0 && driftstid.søtransport_minutter + driftstid.mobilisering_til_søs_minutter + driftstid.andre_aktiviteter_minutter > 0
| søbl5_til8_fakta_gyldige(fakta: Søbl5Til8Indkomstfakta) -> fakta.identifikation != "" && fakta.indkomstår >= 1900 && fakta.skib.identifikation != "" && fakta.skib.bruttotonnage >= 0 && fakta.løn.beløb_kroner >= 0 && søbl5_til8_arbejdsrolle_input_gyldig(fakta.arbejde.arbejdsrolle) && match fakta.arbejde.anvendelse {
    | SøblUdelukkendeAnvendtTil(SøblBugseringOgBjærgning) -> søbl5_til8_passagerrute_forenelig(SøblBugseringOgBjærgning, fakta.arbejde.passagerrute)
    | SøblUdelukkendeAnvendtTil(aktivitet) -> søbl5_til8_passagerrute_forenelig(aktivitet, fakta.arbejde.passagerrute)
    | SøblPeriodeMedFlereEllerUoplysteAnvendelser -> fakta.arbejde.passagerrute == SøblIngenPassagersejlads
}
| søbl5_til8_aktivitet_kan_omfattes_af_tonnageskatteloven(aktivitet: Søbl5Til8Aktivitet, årsdriftsrelation: Søbl6IndkomstÅrsdriftsrelation) -> match aktivitet {
    | SøblTransportAfGodsMellemForskelligeDestinationer -> Sandt
    | SøblTransportAfPassagererMellemForskelligeDestinationer -> Sandt
    | SøblVagttjeneste -> Sandt
    | SøblStøtteOgServicefunktion -> Sandt
    | SøblBygningReparationEllerNedtagningAfHavanlæg -> Sandt
    | SøblRørledningEllerKabelPåHavbunden -> Sandt
    | SøblIshåndtering -> Sandt
    | SøblHusningVedOffshorearbejde -> Sandt
    | SøblBugseringOgBjærgning -> søbl6_årsdriftsrelation_opfylder_halvdelskravet(årsdriftsrelation)
    | _ -> Falskt
}
| søbl5_til8_tonnageskatteaktivitet_opfyldt(arbejde: Søbl5Til8Arbejdsfakta, årsdriftsrelation: Søbl6IndkomstÅrsdriftsrelation) -> match arbejde.anvendelse {
    | SøblUdelukkendeAnvendtTil(aktivitet) -> søbl5_til8_aktivitet_kan_omfattes_af_tonnageskatteloven(aktivitet, årsdriftsrelation)
    | SøblPeriodeMedFlereEllerUoplysteAnvendelser -> Falskt
}
| søbl5_til8_fuldt_eller_begrænset_skattepligtig(skattepligt: Søbl5Til8Skattepligt) -> {
    = kategori = søbl5_til8_skattepligtskategori(skattepligt)
    kategori == SøblFuldSkattepligtKategori || kategori == SøblBegrænsetSkattepligtKategori
}
--@end::søbl5_til8_par5--

--@label:søbl5_til8_par5b::meta:søbl5_til8_par5_metadata--
----
§ 5 b. § 5 finder tilsvarende anvendelse for personer, der er skattepligtige efter kildeskattelovens § 1 eller § 2, stk. 2, eller kulbrinteskattelovens § 21, stk. 2, og som erhverver lønindkomst ved arbejde om bord på et udenlandsk skib, der er registreret med hjemsted i en EU- eller EØS-medlemsstat og sejler under et flag fra en EU- eller EØS-medlemsstat, såfremt skibet udelukkende anvendes til formål, der vil kunne omfattes af tonnageskattelovens § 6 eller § 8 a, nr. 1 eller 2 eller nr. 3, 1. pkt., hvor betingelsen i 2. pkt. ikke finder tilsvarende anvendelse, eller nr. 4-6.

Stk. 2. Skattefritagelse efter stk. 1 er betinget af, at arbejdsgiveren er godkendt af told- og skatteforvaltningen efter § 11 a. Det er endvidere en betingelse, at skibet ikke anvendes til sejlads med passagerer mellem danske havne. 2. pkt. gælder dog ikke ved fart til og fra havanlæg.
----

--@begin::søbl5_til8_par5b--
| søbl5b_skattepligt_opfyldt(skattepligt: Søbl5Til8Skattepligt) -> match skattepligt {
    | SøblFuldtSkattepligtigEfterKsl1 -> Sandt
    | SøblBegrænsetSkattepligtigEfterKsl2Stk2 -> Sandt
    | SøblKulbrinteskattepligtigEfterPar21Stk2 -> Sandt
    | _ -> Falskt
}
| søbl5b_passagerbetingelse_opfyldt(passagerrute: Søbl5Til8Passagerrute) -> passagerrute != SøblRegelmæssigPassagersejladsMellemDanskeHavne && passagerrute != SøblAndenPassagersejladsMellemDanskeHavne
| søbl5b_skibs_og_arbejdsgiverbetingelser_opfyldt(skib: Søbl5Til8Skibsfakta, passagerrute: Søbl5Til8Passagerrute) -> søbl5_til8_udenlandsk_eu_eøs_skib(skib) && skib.arbejdsgiverstatus == SøblUdenlandskArbejdsgiverGodkendtEfterPar11A && søbl5b_passagerbetingelse_opfyldt(passagerrute)
--@end::søbl5_til8_par5b--

= søbl5_til8_par6_metadata = Metadata(
    attachments = (
        Source(value = søbl5_til8_lbk1181),
        DependencySource(value = søbl5_til8_bek940),
        DependencySource(value = søbl5_til8_tonnageskattelov),
    )
)

--@label:søbl5_til8_par6::meta:søbl5_til8_par6_metadata--
----
§ 6. Ved arbejde om bord på skib, som anvendes som bugser- og bjærgningsfartøj inden for EU/EØS, finder § 5 udelukkende anvendelse i tilfælde, hvor skibet udfører virksomhed med karakter af søtransport i mindst 50 pct. af den tid, skibet i løbet af et indkomstår er i drift. Det er en betingelse, at fartøjet har hjemsted i en EU- eller EØS-medlemsstat.

Stk. 2. Ved anvendelsen af stk. 1 fordeles ventetid forholdsmæssigt mellem den tid, der er medgået til bugser- og bjærgningsaktiviteter til søs, og den tid, der er anvendt til andre aktiviteter.
----

--@begin::søbl5_til8_par6--
| søbl6_søtransportminutter_før_ventetid(driftstid: Søbl6Driftstid) -> driftstid.søtransport_minutter + driftstid.mobilisering_til_søs_minutter
| søbl6_aktive_minutter_før_ventetid(driftstid: Søbl6Driftstid) -> søbl6_søtransportminutter_før_ventetid(driftstid) + driftstid.andre_aktiviteter_minutter
| søbl6_ventetid_til_søtransport_tæller(driftstid: Søbl6Driftstid) -> driftstid.ventetid_minutter * søbl6_søtransportminutter_før_ventetid(driftstid)
| søbl6_ventetid_til_andre_aktiviteter_tæller(driftstid: Søbl6Driftstid) -> driftstid.ventetid_minutter * driftstid.andre_aktiviteter_minutter
| søbl6_søtransport_inkl_fordelt_ventetid_tæller(driftstid: Søbl6Driftstid) -> søbl6_søtransportminutter_før_ventetid(driftstid) * søbl6_aktive_minutter_før_ventetid(driftstid) + søbl6_ventetid_til_søtransport_tæller(driftstid)
| søbl6_samlet_driftstid_tæller(driftstid: Søbl6Driftstid) -> (søbl6_aktive_minutter_før_ventetid(driftstid) + driftstid.ventetid_minutter) * søbl6_aktive_minutter_før_ventetid(driftstid)
| søbl6_søtransportandel_mindst_halvdelen(driftstid: Søbl6Driftstid) -> søbl5_til8_driftstid_gyldig(driftstid) && søbl6_søtransport_inkl_fordelt_ventetid_tæller(driftstid) * 2 >= søbl6_samlet_driftstid_tæller(driftstid)
| søbl6_skibsårsdriftresultat(fakta: Søbl6Skibsårsdriftfakta) -> {
    = søtransportminutter_før_ventetid = søbl6_søtransportminutter_før_ventetid(fakta.driftstid)
    = aktive_minutter_før_ventetid = søbl6_aktive_minutter_før_ventetid(fakta.driftstid)
    = input_gyldigt = fakta.skibsidentifikation != "" && fakta.indkomstår >= 1900 && søbl5_til8_driftstid_gyldig(fakta.driftstid)
    Søbl6Skibsårsdriftresultat(
        fakta = fakta,
        input_gyldigt = input_gyldigt,
        søtransportminutter_før_ventetid = søtransportminutter_før_ventetid,
        aktive_minutter_før_ventetid = aktive_minutter_før_ventetid,
        ventetid_til_søtransport_tæller = søbl6_ventetid_til_søtransport_tæller(fakta.driftstid),
        ventetid_til_andre_aktiviteter_tæller = søbl6_ventetid_til_andre_aktiviteter_tæller(fakta.driftstid),
        ventetidsfordeling_nævner = aktive_minutter_før_ventetid,
        søtransport_inkl_fordelt_ventetid_tæller = søbl6_søtransport_inkl_fordelt_ventetid_tæller(fakta.driftstid),
        samlet_driftstid_tæller = søbl6_samlet_driftstid_tæller(fakta.driftstid),
        samlet_driftstid_minutter = aktive_minutter_før_ventetid + fakta.driftstid.ventetid_minutter,
        søtransportandel_mindst_halvdelen = input_gyldigt && søbl6_søtransportandel_mindst_halvdelen(fakta.driftstid)
    )
}
| søbl6_indkomst_kræver_årsdrift(fakta: Søbl5Til8Indkomstfakta) -> match fakta.arbejde.anvendelse {
    | SøblUdelukkendeAnvendtTil(SøblBugseringOgBjærgning) -> Sandt
    | _ -> Falskt
}
| søbl6_indkomst_årsdriftsrelation(fakta: Søbl5Til8Indkomstfakta, resultater: List(Søbl6Skibsårsdriftresultat)) -> hvis søbl6_indkomst_kræver_årsdrift(fakta) == Falskt {
    Søbl6ÅrsdriftIkkePåkrævet
} ellers {
    = matchende = filter(resultater, |resultat: Søbl6Skibsårsdriftresultat| resultat.fakta.skibsidentifikation == fakta.skib.identifikation && resultat.fakta.indkomstår == fakta.indkomstår)
    hvis length(matchende) == 0 {
        Søbl6ÅrsdriftMangler
    } ellers hvis length(matchende) > 1 {
        Søbl6ÅrsdriftFlertydig
    } ellers hvis head(matchende).input_gyldigt {
        Søbl6ÅrsdriftTilknyttet(resultat = head(matchende))
    } ellers {
        Søbl6ÅrsdriftUgyldig(resultat = head(matchende))
    }
}
| søbl6_årsdriftsrelation_gyldig(relation: Søbl6IndkomstÅrsdriftsrelation) -> match relation {
    | Søbl6ÅrsdriftIkkePåkrævet -> Sandt
    | Søbl6ÅrsdriftTilknyttet(_) -> Sandt
    | _ -> Falskt
}
| søbl6_årsdriftsrelation_opfylder_halvdelskravet(relation: Søbl6IndkomstÅrsdriftsrelation) -> match relation {
    | Søbl6ÅrsdriftTilknyttet(resultat) -> resultat.input_gyldigt && resultat.søtransportandel_mindst_halvdelen
    | _ -> Falskt
}
| søbl6_skibsidentitet_svarer_til_hinanden(a: Søbl5Til8Skibsfakta, b: Søbl5Til8Skibsfakta) -> a.identifikation == b.identifikation && a.registrering == b.registrering && a.bruttotonnage == b.bruttotonnage
| søbl6_skibsfakta_konsistente(indkomster: List(Søbl5Til8Indkomstfakta)) -> all(indkomster, |fakta: Søbl5Til8Indkomstfakta| all(indkomster, |anden: Søbl5Til8Indkomstfakta| fakta.skib.identifikation != anden.skib.identifikation || søbl6_skibsidentitet_svarer_til_hinanden(fakta.skib, anden.skib)))
| søbl6_årsdriftsidentifikationer_entydige(indkomstår: Heltal, resultater: List(Søbl6Skibsårsdriftresultat)) -> all(resultater, |resultat: Søbl6Skibsårsdriftresultat| resultat.fakta.skibsidentifikation != "" && resultat.fakta.indkomstår == indkomstår && length(filter(resultater, |andet: Søbl6Skibsårsdriftresultat| andet.fakta.skibsidentifikation == resultat.fakta.skibsidentifikation && andet.fakta.indkomstår == resultat.fakta.indkomstår)) == 1)
| søbl6_alle_årsdriftsfakta_anvendt(indkomster: List(Søbl5Til8Indkomstfakta), resultater: List(Søbl6Skibsårsdriftresultat)) -> all(resultater, |resultat: Søbl6Skibsårsdriftresultat| any(indkomster, |fakta: Søbl5Til8Indkomstfakta| søbl6_indkomst_kræver_årsdrift(fakta) && fakta.skib.identifikation == resultat.fakta.skibsidentifikation && fakta.indkomstår == resultat.fakta.indkomstår))
| søbl6_årsdriftsgrundlagsresultat(indkomstår: Heltal, indkomster: List(Søbl5Til8Indkomstfakta), skibsårsdrifter: List(Søbl6Skibsårsdriftfakta)) -> {
    = resultater = map(skibsårsdrifter, søbl6_skibsårsdriftresultat)
    = identifikationer_entydige = søbl6_årsdriftsidentifikationer_entydige(indkomstår, resultater)
    = alle_input_gyldige = all(resultater, |resultat: Søbl6Skibsårsdriftresultat| resultat.input_gyldigt)
    = alle_fakta_anvendt = søbl6_alle_årsdriftsfakta_anvendt(indkomster, resultater)
    = skibsfakta_konsistente = søbl6_skibsfakta_konsistente(indkomster)
    = alle_bugserindkomster_tilknyttet = all(indkomster, |fakta: Søbl5Til8Indkomstfakta| søbl6_årsdriftsrelation_gyldig(søbl6_indkomst_årsdriftsrelation(fakta, resultater)))
    Søbl6Årsdriftsgrundlagsresultat(
        indkomstår = indkomstår,
        resultater = resultater,
        identifikationer_entydige = identifikationer_entydige,
        alle_input_gyldige = alle_input_gyldige,
        alle_fakta_anvendt = alle_fakta_anvendt,
        skibsfakta_konsistente = skibsfakta_konsistente,
        alle_bugserindkomster_tilknyttet = alle_bugserindkomster_tilknyttet,
        input_gyldigt = identifikationer_entydige && alle_input_gyldige && alle_fakta_anvendt && skibsfakta_konsistente && alle_bugserindkomster_tilknyttet
    )
}
| søbl6_finder_anvendelse(arbejde: Søbl5Til8Arbejdsfakta) -> arbejde.arbejdsområde == SøblArbejdeIndenForEUEØS && match arbejde.anvendelse {
    | SøblUdelukkendeAnvendtTil(SøblBugseringOgBjærgning) -> Sandt
    | _ -> Falskt
}
| søbl6_betingelser_opfyldt(skib: Søbl5Til8Skibsfakta, arbejde: Søbl5Til8Arbejdsfakta, årsdriftsrelation: Søbl6IndkomstÅrsdriftsrelation) -> hvis søbl6_finder_anvendelse(arbejde) { søbl5_til8_registrering_har_eu_eøs_hjemsted(skib.registrering) && søbl6_årsdriftsrelation_opfylder_halvdelskravet(årsdriftsrelation) } ellers { Sandt }
--@end::søbl5_til8_par6--

= søbl5_til8_par7_metadata = Metadata(
    attachments = (
        Source(value = søbl5_til8_lbk1181),
        Guidance(value = søbl5_til8_juridisk_vejledning),
    )
)

--@label:søbl5_til8_par7::meta:søbl5_til8_par7_metadata--
----
§ 7. Ved arbejde om bord på et skib, som sejler i regelmæssig passagersejlads mellem havne i EU- eller EØS-medlemsstater, finder § 5 kun anvendelse på personer, der er skattepligtige efter kildeskattelovens § 1 eller § 2, stk. 2, og som er statsborgere i en EU- eller EØS-medlemsstat eller i Schweiz. Med personer, som er statsborgere i en EU-medlemsstat, sidestilles personer, der er statsborgere i Det Forenede Kongerige, og som er omfattet af anden del, afsnit II, kapitel 2, i Aftale om Det Forenede Kongerige Storbritannien og Nordirlands udtræden af Den Europæiske Union og Det Europæiske Atomenergifællesskab (2019/C 384 I/01).

Stk. 2. Ved anvendelsen af stk. 1 er det en betingelse, at skibet er registreret med hjemsted i en EU- eller EØS-medlemsstat og sejler under et flag fra en EU- eller EØS-medlemsstat.
----

--@begin::søbl5_til8_par7--
| søbl7_regelmæssig_passagersejlads(passagerrute: Søbl5Til8Passagerrute) -> passagerrute == SøblRegelmæssigPassagersejladsMellemEUEØSHavne || passagerrute == SøblRegelmæssigPassagersejladsMellemDanskeHavne || passagerrute == SøblPassagersejladsMellemDanskeHavneTilFraHavanlæg
| søbl7_statsborgerskab_opfyldt(statsborgerskab: Søbl5Til8Statsborgerskab) -> statsborgerskab == SøblStatsborgerIEUEØS || statsborgerskab == SøblStatsborgerISchweiz || statsborgerskab == SøblBritiskStatsborgerOmfattetAfUdtrædelsesaftalen
| søbl7_betingelser_opfyldt(person: Søbl5Til8Personfakta, skib: Søbl5Til8Skibsfakta, passagerrute: Søbl5Til8Passagerrute) -> hvis søbl7_regelmæssig_passagersejlads(passagerrute) { søbl5_til8_fuldt_eller_begrænset_skattepligtig(person.skattepligt) && søbl7_statsborgerskab_opfyldt(person.statsborgerskab) && søbl5_til8_registrering_har_eu_eøs_hjemsted(skib.registrering) && søbl5_til8_registrering_har_eu_eøs_flag(skib.registrering) } ellers { Sandt }
--@end::søbl5_til8_par7--

= søbl5_til8_par8_metadata = Metadata(
    attachments = (
        Source(value = søbl5_til8_lbk1181),
        DependencySource(value = søbl5_til8_bek940),
        Guidance(value = søbl5_til8_juridisk_vejledning),
    )
)

--@label:søbl5_til8_par8::meta:søbl5_til8_par8_metadata--
----
§ 8. § 5 finder uanset tonnageskattelovens bestemmelser tilsvarende anvendelse ved arbejde uden for EU/EØS om bord på stenfiskerfartøjer, herunder sandsugere, som nævnt i § 10, stk. 1.
----

--@begin::søbl5_til8_par8--
| søbl8_skib_omfattet_af_par10_stk1(skib: Søbl5Til8Skibsfakta) -> skib.bruttotonnage >= 20 && match skib.registrering {
    | SøblDanskSkibRegistreretIDIS -> Sandt
    | SøblDanskSkibRegistreretIDAS -> Sandt
    | SøblUdenlandskSkibRegistreretIEUEØS(flag) -> flag == SøblEUEØSFlag
    | _ -> Falskt
}
| søbl8_betingelser_opfyldt(skib: Søbl5Til8Skibsfakta, arbejde: Søbl5Til8Arbejdsfakta) -> arbejde.arbejdsområde == SøblArbejdeUdenForEUEØS && arbejde.par8_valg == SøblAnvendPar8DIS && søbl8_skib_omfattet_af_par10_stk1(skib) && match arbejde.anvendelse {
    | SøblUdelukkendeAnvendtTil(SøblStenfiskeriEllerSandsugning) -> Sandt
    | _ -> Falskt
}
--@end::søbl5_til8_par8--

= søbl5_til8_bek940_metadata = Metadata(
    attachments = (
        Source(value = søbl5_til8_bek940),
        DependencySource(value = søbl5_til8_lbk1181),
        DependencySource(value = søbl5_til8_ligningslov7u_lbk1500),
    )
)

--@label:søbl5_til8_bek940_par4_til7::meta:søbl5_til8_bek940_metadata--
----
§ 4. Lønindkomst kan beskattes efter sømandsbeskatningslovens §§ 5-8 i samme omfang som nævnt i § 1, når skibet er et dansk skib registreret i Dansk Internationalt Skibsregister eller et udenlandsk skib registreret i et skibsregister i en anden EU- eller EØS-medlemsstat, når skibet udelukkende anvendes til formål, der ville kunne omfattes af tonnageskattelovens § 6 eller § 8 a, nr. 1 eller 2 eller nr. 3, 1. pkt., hvor betingelsen i 2. pkt. ikke finder tilsvarende anvendelse, eller nr. 4-6. Ved tilsynsopgaver som omhandlet i § 1, stk. 2, nr. 1, er det en betingelse, at skibet efter færdiggørelsen opfylder betingelserne for anvendelse af sømandsbeskatningslovens §§ 5-8.

Stk. 2. Når løn, godtgørelser og gratialer m.v. fastsættes under hensyn til skattenedsættelsen, jf. sømandsbeskatningslovens § 5, stk. 4, er det for godtgørelser og gratialer m.v. omfattet af ligningslovens § 7 U en betingelse, at der ved opgørelsen af såvel den skattefri nettoløn, der skal medregnes ved opgørelsen af den skattepligtige indkomst, som ved opgørelsen af den lempelsesberettigede skattefri nettoløn ses bort fra det bundfradrag på 8.000 kr., som er omhandlet i ligningslovens § 7 U. Det beløb, der ses bort fra, kan dog højst udgøre skattefri nettoløn efter ligningslovens § 7 U. Hvis en person for samme indkomstår har modtaget såvel skattefri nettoløn som anden indkomst omfattet af ligningslovens § 7 U, fordeles bundfradraget forholdsmæssigt mellem den skattefri nettoløn og den anden indkomst.

Stk. 3. Arbejdsgiveren skal over for Skatteforvaltningen kunne godtgøre, hvordan løn, godtgørelser og gratialer m.v. omfattet af sømandsbeskatningslovens §§ 5-8 er beregnet.

§ 5. Ved beregningen af søtransportens omfang for bugser- og bjærgningsfartøjer, jf. sømandsbeskatningslovens § 6, anses mobilisering til søs mellem opgaver – svarende til lastskibes sejlads i ballast – som søtransport.

§ 6. Når et dansk eller udenlandsk skib, jf. sømandsbeskatningslovens § 2, stk. 1, nr. 1 og 2, periodevis anvendes til andre formål end angivet i sømandsbeskatningslovens §§ 2 eller 5, kan der i sådanne perioder ikke opnås sømandsfradrag efter sømandsbeskatningslovens § 3, stk. 1. Tilsvarende gælder, når et stenfiskerfartøj, herunder en sandsuger, anvendes til andre formål end stenfiskeri, sandsugning eller de formål, der er nævnt i sømandsbeskatningslovens § 2, stk. 1, nr. 1.

§ 7. Ved anvendelsen af sømandsbeskatningsloven forstås ved EU eller EØS medlemsstaternes geografiske territorier, herunder medlemsstaternes territorialfarvand, samt de havområder, som i overensstemmelse med folkeretten til enhver tid betegnes som medlemsstaternes eksklusive økonomiske zoner, jf. kapitel 5 i De Forenede Nationers havretskonvention af 10. december 1982.

Stk. 2. Når der uden for EU eller EØS udføres arbejde om bord på stenfiskerfartøjer, herunder sandsugere, som omhandlet i sømandsbeskatningslovens § 10, stk. 1, kan der vælges anvendt samme beskatningsregler som for personer omfattet af sømandsbeskatningslovens § 5, jf. § 8.

Stk. 3. Når indkomst som omhandlet i stk. 2 vælges beskattet efter reglerne i sømandsbeskatningslovens § 5, indberettes indkomsten af arbejdsgiveren til Skatteforvaltningen som skattefri nettoløn.

Stk. 4. § 4, stk. 2 og 3, finder tilsvarende anvendelse.

Stk. 5. Virksomhederne kan ved arbejde uden for EU/EØS vælge at anvende refusionsordningen for sandsugere i sømandsbeskatningslovens § 10 i stedet for DIS-ordningen i sømandsbeskatningslovens § 5, jf. § 8.
----

--@begin::søbl5_til8_bek940_par4_til7--
| søbl5_til8_ligningslov7u_bundfradrag_kroner(indkomstår: Heltal) -> 0
| exception søbl5_til8_ligningslov7u_bundfradrag_2025 søbl5_til8_ligningslov7u_bundfradrag_kroner(indkomstår: Heltal) -> 8000 under indkomstår == 2025
| exception søbl5_til8_ligningslov7u_bundfradrag_2026 søbl5_til8_ligningslov7u_bundfradrag_kroner(indkomstår: Heltal) -> 8000 under indkomstår == 2026
| søbl5_til8_mindste_beløb(a_kroner: Heltal, b_kroner: Heltal) -> hvis a_kroner < b_kroner { a_kroner } ellers { b_kroner }

# Søbl5Til8Indkomstsag(indkomstår: Heltal, fakta: Søbl5Til8Indkomstfakta, årsdriftsresultater: List(Søbl6Skibsårsdriftresultat)) {
    | årsdriftsrelation() -> søbl6_indkomst_årsdriftsrelation(fakta, årsdriftsresultater)
    | input_gyldigt() -> fakta.indkomstår == indkomstår && søbl5_til8_fakta_gyldige(fakta) && søbl6_årsdriftsrelation_gyldig(årsdriftsrelation())
    | arbejdsrolle_omfattet() -> søbl5_til8_arbejdsrolle_omfattet(fakta.arbejde.arbejdsrolle)
    | aflønningsbetingelse_opfyldt() -> søbl5_til8_aflønningsbetingelse_opfyldt(fakta.person.relation)
    | indkomsttype_omfattet() -> søbl5_til8_indkomsttype_omfattet(fakta.løn.indkomsttype)
    | nettolønsbetingelse_opfyldt() -> søbl5_til8_nettolønsbetingelse_opfyldt(fakta.løn.løngrundlag)
    | tonnageskatteaktivitet_opfyldt() -> søbl5_til8_tonnageskatteaktivitet_opfyldt(fakta.arbejde, årsdriftsrelation())
    | par6_opfyldt() -> søbl6_finder_anvendelse(fakta.arbejde) && søbl6_betingelser_opfyldt(fakta.skib, fakta.arbejde, årsdriftsrelation())
    | par7_opfyldt() -> søbl7_regelmæssig_passagersejlads(fakta.arbejde.passagerrute) && søbl7_betingelser_opfyldt(fakta.person, fakta.skib, fakta.arbejde.passagerrute)
    | par8_opfyldt() -> søbl8_betingelser_opfyldt(fakta.skib, fakta.arbejde)
    | fælles_betingelser_opfyldt() -> input_gyldigt() && arbejdsrolle_omfattet() && aflønningsbetingelse_opfyldt() && indkomsttype_omfattet() && nettolønsbetingelse_opfyldt() && søbl6_betingelser_opfyldt(fakta.skib, fakta.arbejde, årsdriftsrelation()) && søbl7_betingelser_opfyldt(fakta.person, fakta.skib, fakta.arbejde.passagerrute)
    | par5_opfyldt() -> fælles_betingelser_opfyldt() && søbl5_til8_par5_skattepligt_opfyldt(fakta.person.skattepligt) && søbl5_til8_dansk_dis_skib(fakta.skib) && tonnageskatteaktivitet_opfyldt()
    | par5b_opfyldt() -> fælles_betingelser_opfyldt() && søbl5b_skattepligt_opfyldt(fakta.person.skattepligt) && søbl5b_skibs_og_arbejdsgiverbetingelser_opfyldt(fakta.skib, fakta.arbejde.passagerrute) && tonnageskatteaktivitet_opfyldt()
    | kan_anvende_par5_til8() -> par5_opfyldt() || par5b_opfyldt() || fælles_betingelser_opfyldt() && par8_opfyldt() && søbl5_til8_par5_skattepligt_opfyldt(fakta.person.skattepligt)
    | retsgrundlag() -> SøblIntetRetsgrundlag
    | exception søbl8_retsgrundlag retsgrundlag() -> SøblPar8 under kan_anvende_par5_til8() && par8_opfyldt()
    | exception søbl7_retsgrundlag retsgrundlag() -> SøblPar7 under kan_anvende_par5_til8() && par7_opfyldt() && par8_opfyldt() == Falskt
    | exception søbl6_retsgrundlag retsgrundlag() -> SøblPar6 under kan_anvende_par5_til8() && par6_opfyldt() && par7_opfyldt() == Falskt && par8_opfyldt() == Falskt
    | exception søbl5b_retsgrundlag retsgrundlag() -> SøblPar5B under par5b_opfyldt() && par6_opfyldt() == Falskt && par7_opfyldt() == Falskt && par8_opfyldt() == Falskt
    | exception søbl5_stk1_retsgrundlag retsgrundlag() -> SøblPar5Stk1 under par5_opfyldt() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblFuldSkattepligtKategori && par6_opfyldt() == Falskt && par7_opfyldt() == Falskt && par8_opfyldt() == Falskt
    | exception søbl5_dødsbo_retsgrundlag retsgrundlag() -> SøblPar5Stk1Dødsbo under par5_opfyldt() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblDødsboSkattepligtKategori && par6_opfyldt() == Falskt && par7_opfyldt() == Falskt && par8_opfyldt() == Falskt
    | exception søbl5_stk2_retsgrundlag retsgrundlag() -> SøblPar5Stk2 under par5_opfyldt() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblBegrænsetSkattepligtKategori && par6_opfyldt() == Falskt && par7_opfyldt() == Falskt && par8_opfyldt() == Falskt
    | beskatningsvirkning() -> SøblIngenDISVirkning
    | exception søbl5_fuld_skattepligt_virkning beskatningsvirkning() -> SøblNedsættelseAfSamletIndkomstskat under kan_anvende_par5_til8() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblFuldSkattepligtKategori
    | exception søbl5_dødsboskat_virkning beskatningsvirkning() -> SøblNedsættelseAfDødsboskat under kan_anvende_par5_til8() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblDødsboSkattepligtKategori
    | exception søbl5_begrænset_skattepligt_virkning beskatningsvirkning() -> SøblIngenDanskSkatEfterPar5Stk2 under kan_anvende_par5_til8() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblBegrænsetSkattepligtKategori
    | exception søbl5_kulbrinteskat_virkning beskatningsvirkning() -> SøblKulbrinteskattelov21Stk2Virkning under kan_anvende_par5_til8() && søbl5_til8_skattepligtskategori(fakta.person.skattepligt) == SøblKulbrinteSkattepligtKategori
    | dis_personlig_indkomst_kroner() -> hvis beskatningsvirkning() == SøblNedsættelseAfSamletIndkomstskat { fakta.løn.beløb_kroner } ellers { 0 }
    | ordinær_bruttoløn_kroner() -> hvis fakta.løn.løngrundlag == SøblOrdinærBruttoløn { fakta.løn.beløb_kroner } ellers { 0 }
    | uafklaret_nettoløn_kroner() -> hvis fakta.løn.løngrundlag != SøblOrdinærBruttoløn && kan_anvende_par5_til8() == Falskt { fakta.løn.beløb_kroner } ellers { 0 }
    | resultat() -> Søbl5Til8Indkomstresultat(
        fakta = fakta,
        årsdriftsrelation = årsdriftsrelation(),
        input_gyldigt = input_gyldigt(),
        arbejdsrolle_omfattet = arbejdsrolle_omfattet(),
        aflønningsbetingelse_opfyldt = aflønningsbetingelse_opfyldt(),
        indkomsttype_omfattet = indkomsttype_omfattet(),
        nettolønsbetingelse_opfyldt = nettolønsbetingelse_opfyldt(),
        tonnageskatteaktivitet_opfyldt = tonnageskatteaktivitet_opfyldt(),
        par5_opfyldt = par5_opfyldt(),
        par5b_opfyldt = par5b_opfyldt(),
        par6_opfyldt = par6_opfyldt(),
        par7_opfyldt = par7_opfyldt(),
        par8_opfyldt = par8_opfyldt(),
        kan_anvende_par5_til8 = kan_anvende_par5_til8(),
        retsgrundlag = retsgrundlag(),
        beskatningsvirkning = beskatningsvirkning(),
        dis_personlig_indkomst_kroner = dis_personlig_indkomst_kroner(),
        ordinær_bruttoløn_kroner = ordinær_bruttoløn_kroner(),
        uafklaret_nettoløn_kroner = uafklaret_nettoløn_kroner(),
        arbejdsmarkedsbidrag_af_dis_indkomst_kroner = 0,
        ligningslov9a_stk1_til9_afskåret = kan_anvende_par5_til8()
    )
}

| søbl5_til8_indkomstresultat_med_årsdrifter(indkomstår: Heltal, fakta: Søbl5Til8Indkomstfakta, årsdriftsresultater: List(Søbl6Skibsårsdriftresultat)) -> Søbl5Til8Indkomstsag(indkomstår = indkomstår, fakta = fakta, årsdriftsresultater = årsdriftsresultater).resultat()
| søbl5_til8_indkomstresultat(indkomstår: Heltal, fakta: Søbl5Til8Indkomstfakta) -> søbl5_til8_indkomstresultat_med_årsdrifter(indkomstår = indkomstår, fakta = fakta, årsdriftsresultater = [])
| søbl5_til8_sum(resultater: List(Søbl5Til8Indkomstresultat), udtræk: Søbl5Til8Indkomstresultat -> Heltal) -> foldl(resultater, 0, |sum_kroner: Heltal, resultat: Søbl5Til8Indkomstresultat| sum_kroner + udtræk(resultat))
| søbl5_til8_beskatningsvirkning_er_skattefritagelse(virkning: Søbl5Til8Beskatningsvirkning) -> virkning == SøblNedsættelseAfSamletIndkomstskat || virkning == SøblNedsættelseAfDødsboskat || virkning == SøblIngenDanskSkatEfterPar5Stk2 || virkning == SøblKulbrinteskattelov21Stk2Virkning
| søbl5_til8_direkte_ligningslov7u_dis_nettoløn_kroner(resultat: Søbl5Til8Indkomstresultat) -> hvis resultat.input_gyldigt && søbl5_til8_beskatningsvirkning_er_skattefritagelse(resultat.beskatningsvirkning) && resultat.fakta.løn.indkomsttype == SøblLigningslov7UYdelseMedDirekteTilknytning { resultat.fakta.løn.beløb_kroner } ellers { 0 }
| søbl5_til8_nettoløn_for_beskatningsvirkning_kroner(resultat: Søbl5Til8Indkomstresultat, virkning: Søbl5Til8Beskatningsvirkning) -> hvis resultat.input_gyldigt && resultat.beskatningsvirkning == virkning { resultat.fakta.løn.beløb_kroner } ellers { 0 }
| søbl5_til8_sum_nettoløn_for_beskatningsvirkning_kroner(resultater: List(Søbl5Til8Indkomstresultat), virkning: Søbl5Til8Beskatningsvirkning) -> foldl(resultater, 0, |sum_kroner: Heltal, resultat: Søbl5Til8Indkomstresultat| sum_kroner + søbl5_til8_nettoløn_for_beskatningsvirkning_kroner(resultat, virkning))
| søbl5_til8_andre_ligningslov7u_identifikationer_entydige(indkomster: List(Søbl5Til8AndenLigningslov7UIndkomstfakta)) -> length(distinct(map(indkomster, |fakta: Søbl5Til8AndenLigningslov7UIndkomstfakta| fakta.identifikation))) == length(indkomster) && all(indkomster, |fakta: Søbl5Til8AndenLigningslov7UIndkomstfakta| fakta.identifikation != "")
| søbl5_til8_andre_ligningslov7u_input_gyldige(indkomster: List(Søbl5Til8AndenLigningslov7UIndkomstfakta)) -> søbl5_til8_andre_ligningslov7u_identifikationer_entydige(indkomster) && all(indkomster, |fakta: Søbl5Til8AndenLigningslov7UIndkomstfakta| fakta.beløb_kroner >= 0)
| søbl5_til8_alle_årsidentifikationer_entydige(input: Søbl5Til8Årsinput) -> {
    = indkomstidentifikationer = concat(
        map(input.indkomster, |fakta: Søbl5Til8Indkomstfakta| fakta.identifikation),
        map(input.andre_ligningslov7u_indkomster, |fakta: Søbl5Til8AndenLigningslov7UIndkomstfakta| fakta.identifikation)
    )
    length(distinct(indkomstidentifikationer)) == length(indkomstidentifikationer) && all(indkomstidentifikationer, |identifikation: Tekst| identifikation != "")
}

# Søbl5Til8Ligningslov7UBundfradragssag(indkomstår: Heltal, indkomstresultater: List(Søbl5Til8Indkomstresultat), andre_indkomster: List(Søbl5Til8AndenLigningslov7UIndkomstfakta)) {
    | direkte_dis_nettoløn_før_bundfradrag_kroner() -> søbl5_til8_sum(indkomstresultater, søbl5_til8_direkte_ligningslov7u_dis_nettoløn_kroner)
    | anden_indkomst_før_bundfradrag_kroner() -> foldl(andre_indkomster, 0, |sum_kroner: Heltal, fakta: Søbl5Til8AndenLigningslov7UIndkomstfakta| sum_kroner + fakta.beløb_kroner)
    | samlet_indkomst_før_bundfradrag_kroner() -> direkte_dis_nettoløn_før_bundfradrag_kroner() + anden_indkomst_før_bundfradrag_kroner()
    | fuldt_bundfradrag_kroner() -> søbl5_til8_ligningslov7u_bundfradrag_kroner(indkomstår)
    | anvendt_bundfradrag_kroner() -> søbl5_til8_mindste_beløb(fuldt_bundfradrag_kroner(), samlet_indkomst_før_bundfradrag_kroner())
    | bundfradrag_fordelt_til_dis_kroner() -> hvis samlet_indkomst_før_bundfradrag_kroner() > 0 { anvendt_bundfradrag_kroner() * direkte_dis_nettoløn_før_bundfradrag_kroner() / samlet_indkomst_før_bundfradrag_kroner() } ellers { 0 }
    | bundfradrag_fordelt_til_anden_indkomst_kroner() -> anvendt_bundfradrag_kroner() - bundfradrag_fordelt_til_dis_kroner()
    | andre_indkomstidentifikationer_entydige() -> søbl5_til8_andre_ligningslov7u_identifikationer_entydige(andre_indkomster)
    | input_gyldigt() -> (samlet_indkomst_før_bundfradrag_kroner() == 0 || søbl5_til8_skatteår_understøttet(indkomstår)) && søbl5_til8_andre_ligningslov7u_input_gyldige(andre_indkomster)
    | direkte_dis_nettoløn_efter_bundfradrag_kroner() -> hvis input_gyldigt() { direkte_dis_nettoløn_før_bundfradrag_kroner() - bundfradrag_fordelt_til_dis_kroner() } ellers { 0 }
    | anden_indkomst_efter_bundfradrag_kroner() -> hvis input_gyldigt() { anden_indkomst_før_bundfradrag_kroner() - bundfradrag_fordelt_til_anden_indkomst_kroner() } ellers { 0 }
    | resultat() -> Søbl5Til8Ligningslov7UBundfradragsresultat(
        indkomstår = indkomstår,
        andre_indkomster = andre_indkomster,
        input_gyldigt = input_gyldigt(),
        andre_indkomstidentifikationer_entydige = andre_indkomstidentifikationer_entydige(),
        direkte_dis_nettoløn_før_bundfradrag_kroner = direkte_dis_nettoløn_før_bundfradrag_kroner(),
        anden_indkomst_før_bundfradrag_kroner = anden_indkomst_før_bundfradrag_kroner(),
        samlet_indkomst_før_bundfradrag_kroner = samlet_indkomst_før_bundfradrag_kroner(),
        fuldt_bundfradrag_kroner = fuldt_bundfradrag_kroner(),
        anvendt_bundfradrag_kroner = anvendt_bundfradrag_kroner(),
        bundfradrag_fordelt_til_dis_kroner = bundfradrag_fordelt_til_dis_kroner(),
        bundfradrag_fordelt_til_anden_indkomst_kroner = bundfradrag_fordelt_til_anden_indkomst_kroner(),
        direkte_dis_nettoløn_efter_bundfradrag_kroner = direkte_dis_nettoløn_efter_bundfradrag_kroner(),
        anden_indkomst_efter_bundfradrag_kroner = anden_indkomst_efter_bundfradrag_kroner()
    )
}

| søbl5_til8_ligningslov7u_bundfradragsresultat(indkomstår: Heltal, indkomstresultater: List(Søbl5Til8Indkomstresultat), andre_indkomster: List(Søbl5Til8AndenLigningslov7UIndkomstfakta)) -> Søbl5Til8Ligningslov7UBundfradragssag(
    indkomstår = indkomstår,
    indkomstresultater = indkomstresultater,
    andre_indkomster = andre_indkomster
).resultat()
| søbl5_til8_bundfradrag_for_kategori_kroner(kategori: Søbl5Til8Skattepligtskategori, forventet_kategori: Søbl5Til8Skattepligtskategori, ligningslov7u_bundfradrag: Søbl5Til8Ligningslov7UBundfradragsresultat) -> hvis kategori == forventet_kategori { ligningslov7u_bundfradrag.bundfradrag_fordelt_til_dis_kroner } ellers { 0 }
| søbl5_dødsbo_lempelsesresultat(indkomstår: Heltal, kategori: Søbl5Til8Skattepligtskategori, grundlag: Søbl5Dødsboskattegrundlag, indkomstresultater: List(Søbl5Til8Indkomstresultat), ligningslov7u_bundfradrag: Søbl5Til8Ligningslov7UBundfradragsresultat) -> {
    = relevant = kategori == SøblDødsboSkattepligtKategori
    = dis_nettoløn_før_bundfradrag_kroner = hvis relevant { søbl5_til8_sum_nettoløn_for_beskatningsvirkning_kroner(indkomstresultater, SøblNedsættelseAfDødsboskat) } ellers { 0 }
    = bundfradrag_fordelt_til_dis_kroner = søbl5_til8_bundfradrag_for_kategori_kroner(kategori, SøblDødsboSkattepligtKategori, ligningslov7u_bundfradrag)
    = dis_nettoløn_efter_bundfradrag_kroner = penge_positivt_beløb(dis_nettoløn_før_bundfradrag_kroner - bundfradrag_fordelt_til_dis_kroner)
    match grundlag {
        | Søbl5IntetDødsboskattegrundlag -> Søbl5DødsboLempelsesresultat(
            relevant = relevant,
            grundlag_tilstede = Falskt,
            input_gyldigt = relevant == Falskt,
            beregningsklar = relevant == Falskt,
            dødsboskat_før_søbl5 = None,
            dis_nettoløn_før_bundfradrag_kroner = dis_nettoløn_før_bundfradrag_kroner,
            bundfradrag_fordelt_til_dis_kroner = bundfradrag_fordelt_til_dis_kroner,
            dis_nettoløn_efter_bundfradrag_kroner = dis_nettoløn_efter_bundfradrag_kroner,
            dis_nettoløn_i_forholdsmæssigt_grundlag_kroner = 0,
            forholdsmæssig_lempelse_kroner = 0,
            dødsboskat_efter_søbl5_kroner = 0,
            arbejdsmarkedsbidrag_kroner = 0
        )
        | Søbl5Dødsboskattegrundlag(dødsboskatteinput) -> {
            = dødsboskat = dødsboskattelov30_resultat(dødsboskatteinput)
            = input_gyldigt = relevant && dødsboskatteinput.indkomstår == indkomstår && dødsboskat.input_gyldigt && dødsboskat.skattepligtigt_dødsbo_efter_par1_stk2
            = beregningsklar = input_gyldigt && dødsboskat.beregningsklar
            = dis_nettoløn_i_forholdsmæssigt_grundlag_kroner = hvis beregningsklar { søbl5_til8_mindste_beløb(dis_nettoløn_efter_bundfradrag_kroner, dødsboskat.bobeskatningsindkomstgrundlag_kroner) } ellers { 0 }
            = forholdsmæssig_lempelse_kroner = hvis beregningsklar && dødsboskat.bobeskatningsindkomstgrundlag_kroner > 0 { dødsboskat.dødsboskat_efter_fradrag_kroner * dis_nettoløn_i_forholdsmæssigt_grundlag_kroner / dødsboskat.bobeskatningsindkomstgrundlag_kroner } ellers { 0 }
            Søbl5DødsboLempelsesresultat(
                relevant = relevant,
                grundlag_tilstede = Sandt,
                input_gyldigt = input_gyldigt,
                beregningsklar = beregningsklar,
                dødsboskat_før_søbl5 = Some(dødsboskat),
                dis_nettoløn_før_bundfradrag_kroner = dis_nettoløn_før_bundfradrag_kroner,
                bundfradrag_fordelt_til_dis_kroner = bundfradrag_fordelt_til_dis_kroner,
                dis_nettoløn_efter_bundfradrag_kroner = dis_nettoløn_efter_bundfradrag_kroner,
                dis_nettoløn_i_forholdsmæssigt_grundlag_kroner = dis_nettoløn_i_forholdsmæssigt_grundlag_kroner,
                forholdsmæssig_lempelse_kroner = forholdsmæssig_lempelse_kroner,
                dødsboskat_efter_søbl5_kroner = hvis beregningsklar { dødsboskat.dødsboskat_efter_fradrag_kroner - forholdsmæssig_lempelse_kroner } ellers { 0 },
                arbejdsmarkedsbidrag_kroner = 0
            )
        }
    }
}
| søbl5_begrænset_skattefritagelsesresultat(kategori: Søbl5Til8Skattepligtskategori, indkomstresultater: List(Søbl5Til8Indkomstresultat), ligningslov7u_bundfradrag: Søbl5Til8Ligningslov7UBundfradragsresultat) -> {
    = relevant = kategori == SøblBegrænsetSkattepligtKategori
    = løn_før_bundfradrag_kroner = hvis relevant { søbl5_til8_sum_nettoløn_for_beskatningsvirkning_kroner(indkomstresultater, SøblIngenDanskSkatEfterPar5Stk2) } ellers { 0 }
    = bundfradrag_fordelt_til_dis_kroner = søbl5_til8_bundfradrag_for_kategori_kroner(kategori, SøblBegrænsetSkattepligtKategori, ligningslov7u_bundfradrag)
    Søbl5BegrænsetSkattefritagelsesresultat(
        relevant = relevant,
        input_gyldigt = Sandt,
        beregningsklar = Sandt,
        løn_før_bundfradrag_kroner = løn_før_bundfradrag_kroner,
        bundfradrag_fordelt_til_dis_kroner = bundfradrag_fordelt_til_dis_kroner,
        løn_uden_dansk_skat_kroner = penge_positivt_beløb(løn_før_bundfradrag_kroner - bundfradrag_fordelt_til_dis_kroner),
        dansk_indkomstskat_kroner = 0,
        arbejdsmarkedsbidrag_kroner = 0
    )
}
| søbl5b_kulbrinte_lempelsesresultat(indkomstår: Heltal, kategori: Søbl5Til8Skattepligtskategori, grundlag: Søbl5BKulbrinteskattegrundlag, indkomstresultater: List(Søbl5Til8Indkomstresultat), ligningslov7u_bundfradrag: Søbl5Til8Ligningslov7UBundfradragsresultat) -> {
    = relevant = kategori == SøblKulbrinteSkattepligtKategori
    = løn_før_bundfradrag_kroner = hvis relevant { søbl5_til8_sum_nettoløn_for_beskatningsvirkning_kroner(indkomstresultater, SøblKulbrinteskattelov21Stk2Virkning) } ellers { 0 }
    = bundfradrag_fordelt_til_dis_kroner = søbl5_til8_bundfradrag_for_kategori_kroner(kategori, SøblKulbrinteSkattepligtKategori, ligningslov7u_bundfradrag)
    = løn_efter_bundfradrag_kroner = penge_positivt_beløb(løn_før_bundfradrag_kroner - bundfradrag_fordelt_til_dis_kroner)
    match grundlag {
        | Søbl5BIntetKulbrinteskattegrundlag -> Søbl5BKulbrinteLempelsesresultat(
            relevant = relevant,
            grundlag_tilstede = Falskt,
            input_gyldigt = relevant == Falskt,
            beregningsklar = relevant == Falskt,
            kulbrinteskat_før_søbl5b = None,
            løn_før_bundfradrag_kroner = løn_før_bundfradrag_kroner,
            bundfradrag_fordelt_til_dis_kroner = bundfradrag_fordelt_til_dis_kroner,
            løn_efter_bundfradrag_kroner = løn_efter_bundfradrag_kroner,
            indkomstskattenedsættelse_kroner = 0,
            arbejdsmarkedsbidragsfritagelse_kroner = 0,
            samlet_skat_efter_søbl5b_kroner = 0
        )
        | Søbl5BKulbrinteskattegrundlag(kildefakta) -> {
            = kulbrinteskat = kulbrinteskattelov21_stk2_resultat(Kulbrinteskattelov21Stk2Input(indkomstår = indkomstår, bruttoindtægt_kroner = løn_efter_bundfradrag_kroner, kildefakta = kildefakta))
            = input_gyldigt = relevant && kulbrinteskat.input_gyldigt && kulbrinteskat.grundbetingelser_opfyldt
            = beregningsklar = input_gyldigt && kulbrinteskat.beregningsklar
            = indkomstskattenedsættelse_kroner = hvis beregningsklar { kulbrinteskat.endelig_indkomstskat_kroner } ellers { 0 }
            = arbejdsmarkedsbidragsfritagelse_kroner = hvis beregningsklar { kulbrinteskat.arbejdsmarkedsbidrag_kroner } ellers { 0 }
            Søbl5BKulbrinteLempelsesresultat(
                relevant = relevant,
                grundlag_tilstede = Sandt,
                input_gyldigt = input_gyldigt,
                beregningsklar = beregningsklar,
                kulbrinteskat_før_søbl5b = Some(kulbrinteskat),
                løn_før_bundfradrag_kroner = løn_før_bundfradrag_kroner,
                bundfradrag_fordelt_til_dis_kroner = bundfradrag_fordelt_til_dis_kroner,
                løn_efter_bundfradrag_kroner = løn_efter_bundfradrag_kroner,
                indkomstskattenedsættelse_kroner = indkomstskattenedsættelse_kroner,
                arbejdsmarkedsbidragsfritagelse_kroner = arbejdsmarkedsbidragsfritagelse_kroner,
                samlet_skat_efter_søbl5b_kroner = hvis beregningsklar { kulbrinteskat.samlet_skat_kroner - indkomstskattenedsættelse_kroner - arbejdsmarkedsbidragsfritagelse_kroner } ellers { 0 }
            )
        }
    }
