@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Personskatteloven § 4 a — audit for pensionsfradrag i aktieindkomst.

----
Audit probe source:

Personskatteloven § 4 a, stk. 4:
Retsinformation, LBK nr. 1284 af 14/06/2021.
https://www.retsinformation.dk/eli/lta/2021/1284

The source text is copied verbatim in kapitel-01-indkomst.runa. This audit keeps
the executable amount probes out of the source-law sequence.
----

# Par4aPensionAuditSignal = FradragLoftesTilPositivAktieindkomst | MeddelelseKravAfskærerFradrag | DobbeltFradragAfskæres | IkkePositivAktieindkomstAfskærerFradrag

| par4a_pension_audit_signal(signal: Par4aPensionAuditSignal) -> Sandt

= audit_par4a_pension_loftet_input = AktiePensionsFradragInput(
    aktieindkomst_efter_stk1_og_2_kroner = 80000,
    ønsket_fradrag_kroner = 120000,
    meddelt_forvaltning = Sandt,
    fradraget_i_personlig_indkomst = Falskt
)
= audit_par4a_pension_loftet_resultat = par4a_pensionsfradrag_resultat(audit_par4a_pension_loftet_input)

= audit_par4a_pension_uden_meddelelse_input = AktiePensionsFradragInput(
    aktieindkomst_efter_stk1_og_2_kroner = 80000,
    ønsket_fradrag_kroner = 50000,
    meddelt_forvaltning = Falskt,
    fradraget_i_personlig_indkomst = Falskt
)
= audit_par4a_pension_uden_meddelelse_resultat = par4a_pensionsfradrag_resultat(audit_par4a_pension_uden_meddelelse_input)

= audit_par4a_pension_dobbeltfradrag_input = AktiePensionsFradragInput(
    aktieindkomst_efter_stk1_og_2_kroner = 80000,
    ønsket_fradrag_kroner = 50000,
    meddelt_forvaltning = Sandt,
    fradraget_i_personlig_indkomst = Sandt
)
= audit_par4a_pension_dobbeltfradrag_resultat = par4a_pensionsfradrag_resultat(audit_par4a_pension_dobbeltfradrag_input)

= audit_par4a_pension_negativ_aktieindkomst_input = AktiePensionsFradragInput(
    aktieindkomst_efter_stk1_og_2_kroner = -10000,
    ønsket_fradrag_kroner = 50000,
    meddelt_forvaltning = Sandt,
    fradraget_i_personlig_indkomst = Falskt
)
= audit_par4a_pension_negativ_aktieindkomst_resultat = par4a_pensionsfradrag_resultat(audit_par4a_pension_negativ_aktieindkomst_input)

| audit_par4a_pension_fradrag_loftes_til_aktieindkomst: audit_par4a_pension_loftet_resultat -> audit_par4a_pension_loftet_resultat.fradrag_i_aktieindkomst_kroner == 80000 && audit_par4a_pension_loftet_resultat.aktieindkomst_efter_fradrag_kroner == 0 && audit_par4a_pension_loftet_resultat.afskåret_fradrag_kroner == 40000
| audit_par4a_pension_loft_signal: par4a_pension_audit_signal(FradragLoftesTilPositivAktieindkomst) -> par4a_pension_audit_signal(FradragLoftesTilPositivAktieindkomst) == Sandt

| audit_par4a_pension_meddelelse_kræves: audit_par4a_pension_uden_meddelelse_resultat -> audit_par4a_pension_uden_meddelelse_resultat.fradrag_i_aktieindkomst_kroner == 0 && audit_par4a_pension_uden_meddelelse_resultat.afskåret_fradrag_kroner == 50000
| audit_par4a_pension_meddelelse_signal: par4a_pension_audit_signal(MeddelelseKravAfskærerFradrag) -> par4a_pension_audit_signal(MeddelelseKravAfskærerFradrag) == Sandt

| audit_par4a_pension_dobbeltfradrag_afskæres: audit_par4a_pension_dobbeltfradrag_resultat -> audit_par4a_pension_dobbeltfradrag_resultat.fradrag_i_aktieindkomst_kroner == 0 && audit_par4a_pension_dobbeltfradrag_resultat.dobbeltfradrag_afskåret == Sandt
| audit_par4a_pension_dobbeltfradrag_signal: par4a_pension_audit_signal(DobbeltFradragAfskæres) -> par4a_pension_audit_signal(DobbeltFradragAfskæres) == Sandt

| audit_par4a_pension_kræver_positiv_aktieindkomst: audit_par4a_pension_negativ_aktieindkomst_resultat -> audit_par4a_pension_negativ_aktieindkomst_resultat.fradrag_i_aktieindkomst_kroner == 0 && audit_par4a_pension_negativ_aktieindkomst_resultat.aktieindkomst_efter_fradrag_kroner == 0
| audit_par4a_pension_positiv_aktieindkomst_signal: par4a_pension_audit_signal(IkkePositivAktieindkomstAfskærerFradrag) -> par4a_pension_audit_signal(IkkePositivAktieindkomstAfskærerFradrag) == Sandt

| audit_par4a_pensionsfradrag_samlet() -> audit_par4a_pension_loftet_resultat.fradrag_i_aktieindkomst_kroner == 80000 && audit_par4a_pension_uden_meddelelse_resultat.fradrag_i_aktieindkomst_kroner == 0 && audit_par4a_pension_dobbeltfradrag_resultat.dobbeltfradrag_afskåret == Sandt && audit_par4a_pension_negativ_aktieindkomst_resultat.fradrag_i_aktieindkomst_kroner == 0

? audit_par4a_pension_fradrag_loftes_til_aktieindkomst
? audit_par4a_pension_loft_signal
? audit_par4a_pension_meddelelse_kræves
? audit_par4a_pension_meddelelse_signal
? audit_par4a_pension_dobbeltfradrag_afskæres
? audit_par4a_pension_dobbeltfradrag_signal
? audit_par4a_pension_kræver_positiv_aktieindkomst
? audit_par4a_pension_positiv_aktieindkomst_signal
? audit_par4a_pensionsfradrag_samlet

@ print("audit §4a pensionsfradrag loftet til aktieindkomst: " + vis(audit_par4a_pension_loftet_resultat.fradrag_i_aktieindkomst_kroner))
@ print("audit §4a pensionsfradrag afskåret ved manglende meddelelse: " + vis(audit_par4a_pension_uden_meddelelse_resultat.afskåret_fradrag_kroner))
@ print("audit §4a dobbeltfradrag afskåret: " + vis(audit_par4a_pension_dobbeltfradrag_resultat.dobbeltfradrag_afskåret))
