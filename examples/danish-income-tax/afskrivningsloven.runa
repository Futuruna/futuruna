----
Officiel XML-metadata for 2025/1222, kontrolleret 2026-07-18:
DocumentTitle: Bekendtgørelse af lov om skattemæssige afskrivninger
(afskrivningsloven)
PopularTitle: Afskrivningsloven
Status: Valid
DiesSigni: 2025-10-13
StartDate: 2025-10-16
EndDate: 2026-07-01

Den aktuelle kildepostur er LBK 1222/2025 sammenholdt med LOV 749/2025,
§ 2 og § 5, stk. 2 og 4, der fra 1. januar 2026 ophæver § 40, stk. 7, lader
stk. 8 blive stk. 7 og afgrænser overgangen efter aftaledato.
Ændringen og dens aftaleovergang er modelleret særskilt under § 40; §§ 1-39 og
§ 40 C berøres ikke.
----

--@label:afskrivningsloven_par1_par2::source:afskrivningsloven_lbk1222--
----
§ 1. Efter reglerne i denne lov kan skattemæssig afskrivning foretages
på udgifter til anskaffelse og forbedring af aktiver, der benyttes
erhvervsmæssigt af den skattepligtige, samt på visse andre udgifter.

§ 2. Maskiner, inventar og andre driftsmidler samt skibe afskrives efter
reglerne i dette kapitel, såfremt de udelukkende eller delvis benyttes
erhvervsmæssigt.

Stk. 2. Udgifter til anskaffelse af software afskrives efter reglerne i
dette kapitel, uanset om der er tale om erhvervelse af en tidsubegrænset
brugsrettighed i henhold til en softwarelicensaftale eller lignende.

Stk. 3. Antikviteter og andre aktiver, der efter deres art og anvendelse
normalt ikke udsættes for værdiforringelse, kan ikke afskrives.
Kunstværker kan dog afskrives efter §§ 44 A og 44 B.
----

--@begin:afskrivningsloven_par1_par2--
# AfskrivningslovSkatteyder = AlSelvstændigErhvervsdrivendePerson | AlSelskabEllerForening | AlAndenFysiskPerson
# AfskrivningslovAktivart = AlMaskine | AlInventar | AlAndetDriftsmiddel | AlSkib | AlSoftware | AlAntikvitetEllerAndetVærdifastAktiv | AlKunstværk
# AfskrivningslovPar1Par2Input(skatteyder: AfskrivningslovSkatteyder, aktivart: AfskrivningslovAktivart, erhvervsmæssig_anvendelsesandel_basispoint: Heltal)
# AfskrivningslovPar1Par2Resultat(skatteyder: AfskrivningslovSkatteyder, aktivart: AfskrivningslovAktivart, erhvervsmæssig_anvendelsesandel_basispoint: Heltal, erhvervsmæssigt_benyttet: Boolsk, udelukkende_erhvervsmæssigt_benyttet: Boolsk, aktivart_omfattet_af_kapitel2: Boolsk, omfattet_af_kapitel2: Boolsk)

| afskrivningslov_par1_par2_aktivart_omfattet(aktivart: AfskrivningslovAktivart) -> match aktivart {
    | AlMaskine -> Sandt
    | AlInventar -> Sandt
    | AlAndetDriftsmiddel -> Sandt
    | AlSkib -> Sandt
    | AlSoftware -> Sandt
    | AlAntikvitetEllerAndetVærdifastAktiv -> Falskt
    | AlKunstværk -> Falskt
}
| afskrivningslov_par1_par2_erhvervsmæssigt_benyttet(input: AfskrivningslovPar1Par2Input) -> input.erhvervsmæssig_anvendelsesandel_basispoint > 0 && input.erhvervsmæssig_anvendelsesandel_basispoint <= 10000
| afskrivningslov_par1_par2_resultat(input: AfskrivningslovPar1Par2Input) -> AfskrivningslovPar1Par2Resultat(
    skatteyder = input.skatteyder,
    aktivart = input.aktivart,
    erhvervsmæssig_anvendelsesandel_basispoint = input.erhvervsmæssig_anvendelsesandel_basispoint,
    erhvervsmæssigt_benyttet = afskrivningslov_par1_par2_erhvervsmæssigt_benyttet(input),
    udelukkende_erhvervsmæssigt_benyttet = input.erhvervsmæssig_anvendelsesandel_basispoint == 10000,
    aktivart_omfattet_af_kapitel2 = afskrivningslov_par1_par2_aktivart_omfattet(input.aktivart),
    omfattet_af_kapitel2 = afskrivningslov_par1_par2_erhvervsmæssigt_benyttet(input) && afskrivningslov_par1_par2_aktivart_omfattet(input.aktivart)
)
--@end:afskrivningsloven_par1_par2--

--@label:afskrivningsloven_par3::source:afskrivningsloven_lbk1222--
----
§ 3. Driftsmidler og skibe anses for anskaffet, når driftsmidlet eller skibet er

1) leveret til en igangværende virksomhed,

2) bestemt til at indgå i virksomhedens drift og

3) færdiggjort i et sådant omfang, at det kan indgå i driften.
----

--@begin:afskrivningsloven_par3--
# AfskrivningslovDato(år: Heltal, måned: Heltal, dag: Heltal)
# Afskrivningslov3Input(anskaffelsesdato: AfskrivningslovDato, leveret_til_igangværende_virksomhed: Boolsk, bestemt_til_virksomhedens_drift: Boolsk, færdiggjort_til_at_indgå_i_driften: Boolsk)
# Afskrivningslov3Resultat(anskaffelsesdato: AfskrivningslovDato, dato_gyldig: Boolsk, leveret_til_igangværende_virksomhed: Boolsk, bestemt_til_virksomhedens_drift: Boolsk, færdiggjort_til_at_indgå_i_driften: Boolsk, anskaffet_efter_par3: Boolsk)

| afskrivningslov_skudår(år: Heltal) -> år % 400 == 0 || (år % 4 == 0 && år % 100 != 0)
| afskrivningslov_dage_i_måned(dato: AfskrivningslovDato) -> match dato.måned {
    | 1 -> 31
    | 2 -> if afskrivningslov_skudår(dato.år) { 29 } else { 28 }
    | 3 -> 31
    | 4 -> 30
    | 5 -> 31
    | 6 -> 30
    | 7 -> 31
    | 8 -> 31
    | 9 -> 30
    | 10 -> 31
    | 11 -> 30
    | 12 -> 31
    | _ -> 0
}
| afskrivningslov_dato_gyldig(dato: AfskrivningslovDato) -> dato.år > 0 && dato.dag >= 1 && dato.dag <= afskrivningslov_dage_i_måned(dato)
| afskrivningslov_dato_yyyymmdd(dato: AfskrivningslovDato) -> dato.år * 10000 + dato.måned * 100 + dato.dag
| afskrivningslov_dato_mellem_inklusive(dato: AfskrivningslovDato, første_dato: AfskrivningslovDato, sidste_dato: AfskrivningslovDato) -> afskrivningslov_dato_gyldig(dato) && afskrivningslov_dato_yyyymmdd(dato) >= afskrivningslov_dato_yyyymmdd(første_dato) && afskrivningslov_dato_yyyymmdd(dato) <= afskrivningslov_dato_yyyymmdd(sidste_dato)
| afskrivningslov3_anskaffet(input: Afskrivningslov3Input) -> afskrivningslov_dato_gyldig(input.anskaffelsesdato) && input.leveret_til_igangværende_virksomhed && input.bestemt_til_virksomhedens_drift && input.færdiggjort_til_at_indgå_i_driften
| afskrivningslov3_resultat(input: Afskrivningslov3Input) -> Afskrivningslov3Resultat(
    anskaffelsesdato = input.anskaffelsesdato,
    dato_gyldig = afskrivningslov_dato_gyldig(input.anskaffelsesdato),
    leveret_til_igangværende_virksomhed = input.leveret_til_igangværende_virksomhed,
    bestemt_til_virksomhedens_drift = input.bestemt_til_virksomhedens_drift,
    færdiggjort_til_at_indgå_i_driften = input.færdiggjort_til_at_indgå_i_driften,
    anskaffet_efter_par3 = afskrivningslov3_anskaffet(input)
)
--@end:afskrivningsloven_par3--

--@label:afskrivningsloven_par4::source:afskrivningsloven_lbk1222--
----
§ 4. Ændrer en skattepligtig benyttelsen af driftsmidler eller skibe fra
udelukkende erhvervsmæssig benyttelse til privat benyttelse eller omvendt,
behandles dette som salg henholdsvis køb af de pågældende aktiver. Det samme
gælder ved ændring fra eller til delvis erhvervsmæssig benyttelse. Som salgssum
eller købesum anvendes handelsværdien på det tidspunkt, hvor benyttelsen ændres.
Beskattes den skattepligtige af fri elbil eller pluginhybridbil i en
sammenhængende periode på mindst 6 måneder, jf. ligningslovens § 16, stk. 4,
ansættes værdien af ladestanderen til 0, hvis ladestanderen overgår til privat
brug.

Stk. 2. Overfører en skattepligtig, der anvender virksomhedsordningen, jf.
virksomhedsskattelovens afsnit 1, en bil, en telefon eller en computer med
tilbehør, der benyttes både til erhvervsmæssige og private formål, fra
virksomheden til den skattepligtige, behandles dette efter denne lov som et salg
af bilen, telefonen eller computeren med tilbehør. Som salgssum anvendes
handelsværdien på det tidspunkt, hvor bilen, telefonen eller computeren med
tilbehør tages ud af virksomhedsordningen.
----

--@begin:afskrivningsloven_par4--
# Afskrivningslov4Benyttelsesændring = Al4IngenÆndring | Al4ErhvervTilPrivat | Al4PrivatTilErhverv | Al4ErhvervTilDelvis | Al4DelvisTilErhverv | Al4PrivatTilDelvis | Al4DelvisTilPrivat
# Afskrivningslov4Aktivart = Al4Bil | Al4Telefon | Al4ComputerMedTilbehør | Al4Ladestander | Al4AndetDriftsmiddelEllerSkib
# Afskrivningslov4Input(skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov4Aktivart, benyttelsesændring: Afskrivningslov4Benyttelsesændring, handelsværdi_kroner: Heltal, overføres_fra_virksomhedsordningen_til_skattepligtige: Boolsk, blandet_benyttet_før_virksomhedsordningsoverførsel: Boolsk, fri_elbil_eller_pluginhybrid_beskattet_måneder: Heltal)
# Afskrivningslov4Resultat(skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov4Aktivart, benyttelsesændring: Afskrivningslov4Benyttelsesændring, behandles_som_salg: Boolsk, behandles_som_køb: Boolsk, virksomhedsordningsoverførsel_omfattet_af_stk2: Boolsk, ladestander_værdi_ansat_til_nul: Boolsk, anvendt_handelsværdi_kroner: Heltal, salgssum_kroner: Heltal, købesum_kroner: Heltal)

| afskrivningslov4_benyttelsesændring_er_salg(ændring: Afskrivningslov4Benyttelsesændring) -> ændring == Al4ErhvervTilPrivat || ændring == Al4ErhvervTilDelvis || ændring == Al4DelvisTilPrivat
| afskrivningslov4_benyttelsesændring_er_køb(ændring: Afskrivningslov4Benyttelsesændring) -> ændring == Al4PrivatTilErhverv || ændring == Al4DelvisTilErhverv || ændring == Al4PrivatTilDelvis
| afskrivningslov4_stk2_aktiv_omfattet(aktivart: Afskrivningslov4Aktivart) -> aktivart == Al4Bil || aktivart == Al4Telefon || aktivart == Al4ComputerMedTilbehør
| afskrivningslov4_virksomhedsordningsoverførsel_omfattet(input: Afskrivningslov4Input) -> input.overføres_fra_virksomhedsordningen_til_skattepligtige && input.blandet_benyttet_før_virksomhedsordningsoverførsel && afskrivningslov4_stk2_aktiv_omfattet(input.aktivart)
| afskrivningslov4_behandles_som_salg(input: Afskrivningslov4Input) -> afskrivningslov4_benyttelsesændring_er_salg(input.benyttelsesændring) || afskrivningslov4_virksomhedsordningsoverførsel_omfattet(input)
| afskrivningslov4_behandles_som_køb(input: Afskrivningslov4Input) -> afskrivningslov4_benyttelsesændring_er_køb(input.benyttelsesændring) && afskrivningslov4_virksomhedsordningsoverførsel_omfattet(input) == Falskt
| afskrivningslov4_ladestander_værdi_nul(input: Afskrivningslov4Input) -> input.aktivart == Al4Ladestander && afskrivningslov4_behandles_som_salg(input) && input.fri_elbil_eller_pluginhybrid_beskattet_måneder >= 6
| afskrivningslov4_anvendt_handelsværdi_kroner(input: Afskrivningslov4Input) -> penge_positivt_beløb(input.handelsværdi_kroner)
| exception al4_ladestander_nulværdi afskrivningslov4_anvendt_handelsværdi_kroner(input: Afskrivningslov4Input) -> 0 under afskrivningslov4_ladestander_værdi_nul(input)
| afskrivningslov4_salgssum_kroner(input: Afskrivningslov4Input) -> 0
| exception al4_fiktivt_salg afskrivningslov4_salgssum_kroner(input: Afskrivningslov4Input) -> afskrivningslov4_anvendt_handelsværdi_kroner(input) under afskrivningslov4_behandles_som_salg(input)
| afskrivningslov4_købesum_kroner(input: Afskrivningslov4Input) -> 0
| exception al4_fiktivt_køb afskrivningslov4_købesum_kroner(input: Afskrivningslov4Input) -> afskrivningslov4_anvendt_handelsværdi_kroner(input) under afskrivningslov4_behandles_som_køb(input)
| afskrivningslov4_resultat(input: Afskrivningslov4Input) -> Afskrivningslov4Resultat(
    skatteyder = input.skatteyder,
    aktivart = input.aktivart,
    benyttelsesændring = input.benyttelsesændring,
    behandles_som_salg = afskrivningslov4_behandles_som_salg(input),
    behandles_som_køb = afskrivningslov4_behandles_som_køb(input),
    virksomhedsordningsoverførsel_omfattet_af_stk2 = afskrivningslov4_virksomhedsordningsoverførsel_omfattet(input),
    ladestander_værdi_ansat_til_nul = afskrivningslov4_ladestander_værdi_nul(input),
    anvendt_handelsværdi_kroner = afskrivningslov4_anvendt_handelsværdi_kroner(input),
    salgssum_kroner = afskrivningslov4_salgssum_kroner(input),
    købesum_kroner = afskrivningslov4_købesum_kroner(input)
)
--@end:afskrivningsloven_par4--

--@label:afskrivningsloven_2026_parametre::source:afskrivningsloven_lbk1222::parameter_source:afskrivningsloven_2026_satser--
----
Skatteministeriets offentliggjorte 2026-satser til afskrivningsloven:

Småsaldigrænse (§ 5): 36.000 kr.
Småaktivgrænse (§ 6): 36.000 kr.
Småaktivgrænse for delvist erhvervsmæssigt benyttede aktiver (§ 11):
16.900 kr.
Minimumsanskaffelsessum for dok- og beddingsanlæg (§ 10): 965.800 kr.
Loft over forhøjet afskrivningsgrundlag for udgifter til forsknings- og
forsøgsvirksomhed (§ 6, stk. 1): 1.088,8 mio. kr.
----

--@begin:afskrivningsloven_2026_parametre--
# AfskrivningslovÅrsparameterKilde = AlSkatteministerietSatser2026
# AfskrivningslovÅrsparametre(indkomstår: Heltal, kilde: AfskrivningslovÅrsparameterKilde, småsaldigrænse_kroner: Heltal, småaktivgrænse_kroner: Heltal, blandet_småaktivgrænse_kroner: Heltal, dok_og_bedding_minimum_kroner: Heltal, forskningsloft_kroner: Heltal, højeste_ordinære_sats_basispoint: Heltal, par5b_højeste_sats_basispoint: Heltal, par5b_nybygget_førsteårs_sats_basispoint: Heltal, par5c_stk1_højeste_sats_basispoint: Heltal, par5c_stk2_højeste_sats_basispoint: Heltal, forskning_sats_under_loft_basispoint: Heltal, forskning_sats_over_loft_basispoint: Heltal)

| afskrivningslov_årsparametre(indkomstår: Heltal) -> AfskrivningslovÅrsparametre(
    indkomstår = indkomstår,
    kilde = AlSkatteministerietSatser2026,
    småsaldigrænse_kroner = 36000,
    småaktivgrænse_kroner = 36000,
    blandet_småaktivgrænse_kroner = 16900,
    dok_og_bedding_minimum_kroner = 965800,
    forskningsloft_kroner = 1088800000,
    højeste_ordinære_sats_basispoint = 2500,
    par5b_højeste_sats_basispoint = 1200,
    par5b_nybygget_førsteårs_sats_basispoint = 2000,
    par5c_stk1_højeste_sats_basispoint = 1500,
    par5c_stk2_højeste_sats_basispoint = 700,
    forskning_sats_under_loft_basispoint = 11400,
    forskning_sats_over_loft_basispoint = 11000
) under indkomstår == 2026
--@end:afskrivningsloven_2026_parametre--

--@label:afskrivningsloven_par5::source:afskrivningsloven_lbk1222::parameter_source:afskrivningsloven_2026_satser--
----
§ 5. Driftsmidler og skibe, som en skattepligtig udelukkende benytter
erhvervsmæssigt, skal afskrives på en samlet saldo for den enkelte
virksomhed, jf. dog § 5 B.

Stk. 2. Indkomstårets afskrivninger foretages på grundlag af den
afskrivningsberettigede saldoværdi ved indkomstårets udgang. Denne værdi
opgøres som saldoværdien ved indkomstårets begyndelse med tillæg af
anskaffelsessummen for driftsmidler og skibe, der er anskaffet i
indkomståret, og med fradrag af salgssummen for driftsmidler og skibe,
der er solgt og leveret i indkomstårets løb. Udgifter til forbedring
behandles på samme måde som anskaffelsessummer. Saldoværdien ved
indkomstårets begyndelse udgør det beløb, hvortil driftsmidler og skibe
anskaffet i tidligere indkomstår er nedbragt ved afskrivninger.
Driftsmidler og skibe, der anvendes til forsøgs- og
forskningsvirksomhed, indgår i afskrivningssaldoen med det beløb, der
kan fradrages efter § 6, stk. 1, nr. 3.

Stk. 3. Afskrivning kan højst udgøre 25 pct. af den
afskrivningsberettigede saldoværdi efter stk. 2. Udgør den
afskrivningsberettigede saldoværdi før indkomstårets afskrivning et
grundbeløb på 26.200 kr. (2010-niveau) eller derunder, kan beløbet
fradrages fuldt ud i den skattepligtige indkomst.

Stk. 4. For selskaber og foreninger omfattet af selskabsskattelovens § 1,
stk. 1, nr. 1, 2 og 4, indgår anskaffelsessummen for driftsmidler og skibe
omfattet af stk. 1, som enten erhverves med henblik på udlejning, eller som
allerede ved erhvervelsen er udlejet, ikke i den afskrivningsberettigede
saldoværdi for anskaffelsesåret eller indkomståret efter anskaffelsesåret. For
indkomståret efter anskaffelsesåret kan der særskilt afskrives indtil 50 pct. af
anskaffelsessummen for udlejningsdriftsmidlet eller -skibet. Den del af
anskaffelsessummen, der ikke er afskrevet, tillægges den
afskrivningsberettigede saldoværdi for det andet indkomstår efter
anskaffelsesåret.

Stk. 5. Sælges et udlejningsdriftsmiddel eller -skib omfattet af stk. 4 i
anskaffelsesåret eller indkomståret efter anskaffelsesåret, fradrages
henholdsvis medregnes fortjeneste eller tab i den afskrivningsberettigede
saldoværdi for det indkomstår, hvori salget finder sted, jf. dog § 9.
Bestemmelserne i stk. 4, 2. og 3. pkt., finder ikke anvendelse.

Stk. 6. Told- og skatteforvaltningen kan tillade, at bestemmelsen i stk. 4 ikke
skal finde anvendelse, når det efter forvaltningens skøn må anses for godtgjort,
at anskaffelsen af aktiver til udlejning er et led i normal forretningsmæssigt
drevet udlejningsvirksomhed og i det væsentlige ikke har til formål at opnå
adgang til at foretage skattemæssige afskrivninger på de anskaffede aktiver. Er
der givet tilladelse efter 1. pkt. for et indkomstår, kan reglerne om udskydelse
af selskabers og foreningers førsteårsafskrivninger på udlejningsaktiver ikke
finde anvendelse for efterfølgende indkomstår for udlejningsaktiver omfattet af
tilladelsen, medmindre tilladelsen bortfalder efter 3. pkt. En tilladelse efter
1. pkt. bortfalder med virkning for det pågældende og efterfølgende indkomstår
ved væsentlige ændringer i de forudsætninger, der har været afgørende for
tilladelsen.
----

--@begin:afskrivningsloven_par5--
# AfskrivningslovSaldoordning = AlPar5AlmindeligSaldo | AlPar5BSkibssaldo | AlPar5CInfrastruktursaldo | AlPar5DMidlertidig116Saldo | AlPar5EMidlertidig108Saldo
# Afskrivningslov5Valg = Al5IngenAfskrivning | Al5OrdinærAfskrivning(sats_basispoint: Heltal) | Al5FuldRestsaldo
# Afskrivningslov5Input(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, saldoordning: AfskrivningslovSaldoordning, saldoværdi_primo_kroner: Heltal, anskaffelsessummer_i_året_kroner: Heltal, forbedringsudgifter_i_året_kroner: Heltal, salgssummer_i_året_kroner: Heltal, valg: Afskrivningslov5Valg)
# Afskrivningslov5Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, saldoordning: AfskrivningslovSaldoordning, omfattet_af_par5: Boolsk, valg: Afskrivningslov5Valg, valg_gyldigt: Boolsk, saldoværdi_før_afskrivning_kroner: Heltal, afskrivningsberettiget_saldoværdi_kroner: Heltal, højeste_ordinære_afskrivning_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, saldoværdi_efter_afskrivning_kroner: Heltal)
# Afskrivningslov5UdlejningsSkatteyderStatus = Al5SelskabPar1Stk1Nr1Nr2EllerNr4 | Al5AndenSkatteyder
# Afskrivningslov5UdlejningsTilladelse = Al5IngenUdlejningstilladelse | Al5UdlejningstilladelseGældende | Al5UdlejningstilladelseBortfaldet
# Afskrivningslov5UdlejningsaktivInput(skatteyder_status: Afskrivningslov5UdlejningsSkatteyderStatus, anskaffelsesår: Heltal, indkomstår: Heltal, anskaffelsessum_kroner: Heltal, erhvervet_med_henblik_på_udlejning_eller_udlejet_ved_erhvervelsen: Boolsk, tilladelse: Afskrivningslov5UdlejningsTilladelse, valgt_særskilt_afskrivning_basispoint: Heltal, solgt_i_indkomståret: Boolsk, salgssum_kroner: Heltal)
# Afskrivningslov5UdlejningsaktivResultat(anskaffelsesår: Heltal, indkomstår: Heltal, omfattet_af_stk4: Boolsk, udskydelse_gælder: Boolsk, år_efter_anskaffelsen: Heltal, valgt_særskilt_afskrivning_basispoint: Heltal, valgt_særskilt_afskrivning_gyldig: Boolsk, andet_indkomstårs_afskrivning_kroner: Heltal, særskilt_afskrivning_i_indkomståret_kroner: Heltal, uafskrevet_anskaffelsessum_kroner: Heltal, beløb_til_afskrivningssaldo_kroner: Heltal, tidligt_salg_omfattet_af_stk5: Boolsk, fortjeneste_kroner: Heltal, tab_kroner: Heltal, saldoændring_ved_tidligt_salg_kroner: Heltal)

| afskrivningslov5_omfattet(input: Afskrivningslov5Input) -> input.aktiv_resultat.omfattet_af_kapitel2 && input.aktiv_resultat.udelukkende_erhvervsmæssigt_benyttet && input.saldoordning == AlPar5AlmindeligSaldo
| afskrivningslov5_saldoværdi_før_afskrivning_kroner(input: Afskrivningslov5Input) -> input.saldoværdi_primo_kroner + penge_positivt_beløb(input.anskaffelsessummer_i_året_kroner) + penge_positivt_beløb(input.forbedringsudgifter_i_året_kroner) - penge_positivt_beløb(input.salgssummer_i_året_kroner)
| afskrivningslov5_valgt_ordinær_sats_basispoint(valg: Afskrivningslov5Valg) -> match valg {
    | Al5OrdinærAfskrivning(sats_basispoint) -> penge_positivt_beløb(sats_basispoint)
    | _ -> 0
}
| afskrivningslov5_årsparametre_matcher(input: Afskrivningslov5Input, parametre: AfskrivningslovÅrsparametre) -> input.indkomstår == parametre.indkomstår
| afskrivningslov5_valg_gyldigt(input: Afskrivningslov5Input, parametre: AfskrivningslovÅrsparametre) -> match input.valg {
    | Al5IngenAfskrivning -> afskrivningslov5_omfattet(input) && afskrivningslov5_årsparametre_matcher(input, parametre)
    | Al5OrdinærAfskrivning(sats_basispoint) -> afskrivningslov5_omfattet(input) && afskrivningslov5_årsparametre_matcher(input, parametre) && sats_basispoint >= 0 && sats_basispoint <= parametre.højeste_ordinære_sats_basispoint
    | Al5FuldRestsaldo -> afskrivningslov5_omfattet(input) && afskrivningslov5_årsparametre_matcher(input, parametre) && penge_positivt_beløb(afskrivningslov5_saldoværdi_før_afskrivning_kroner(input)) > 0 && penge_positivt_beløb(afskrivningslov5_saldoværdi_før_afskrivning_kroner(input)) <= parametre.småsaldigrænse_kroner
}
| afskrivningslov5_fradrag_kroner(input: Afskrivningslov5Input, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al5_ordinær_saldoafskrivning afskrivningslov5_fradrag_kroner(input: Afskrivningslov5Input, parametre: AfskrivningslovÅrsparametre) -> penge_beløb_gange_basispoint_kroner(
    penge_positivt_beløb(afskrivningslov5_saldoværdi_før_afskrivning_kroner(input)),
    afskrivningslov5_valgt_ordinær_sats_basispoint(input.valg)
) under afskrivningslov5_valg_gyldigt(input, parametre) && afskrivningslov5_valgt_ordinær_sats_basispoint(input.valg) > 0
| exception al5_fuld_småsaldofradrag afskrivningslov5_fradrag_kroner(input: Afskrivningslov5Input, parametre: AfskrivningslovÅrsparametre) -> penge_positivt_beløb(afskrivningslov5_saldoværdi_før_afskrivning_kroner(input)) under afskrivningslov5_valg_gyldigt(input, parametre) && input.valg == Al5FuldRestsaldo
| afskrivningslov5_resultat(input: Afskrivningslov5Input, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov5Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    saldoordning = input.saldoordning,
    omfattet_af_par5 = afskrivningslov5_omfattet(input),
    valg = input.valg,
    valg_gyldigt = afskrivningslov5_valg_gyldigt(input, parametre),
    saldoværdi_før_afskrivning_kroner = afskrivningslov5_saldoværdi_før_afskrivning_kroner(input),
    afskrivningsberettiget_saldoværdi_kroner = penge_positivt_beløb(afskrivningslov5_saldoværdi_før_afskrivning_kroner(input)),
    højeste_ordinære_afskrivning_kroner = penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(afskrivningslov5_saldoværdi_før_afskrivning_kroner(input)), parametre.højeste_ordinære_sats_basispoint),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov5_fradrag_kroner(input, parametre),
    saldoværdi_efter_afskrivning_kroner = afskrivningslov5_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov5_fradrag_kroner(input, parametre)
)
| afskrivningslov5_udlejningsaktiv_omfattet(input: Afskrivningslov5UdlejningsaktivInput) -> input.skatteyder_status == Al5SelskabPar1Stk1Nr1Nr2EllerNr4 && input.erhvervet_med_henblik_på_udlejning_eller_udlejet_ved_erhvervelsen
| afskrivningslov5_udlejningstilladelse_gældende(input: Afskrivningslov5UdlejningsaktivInput) -> input.tilladelse == Al5UdlejningstilladelseGældende
| afskrivningslov5_udlejningsudskydelse_gælder(input: Afskrivningslov5UdlejningsaktivInput) -> afskrivningslov5_udlejningsaktiv_omfattet(input) && afskrivningslov5_udlejningstilladelse_gældende(input) == Falskt
| afskrivningslov5_udlejningsår_efter_anskaffelsen(input: Afskrivningslov5UdlejningsaktivInput) -> input.indkomstår - input.anskaffelsesår
| afskrivningslov5_tidligt_udlejningssalg(input: Afskrivningslov5UdlejningsaktivInput) -> afskrivningslov5_udlejningsudskydelse_gælder(input) && input.solgt_i_indkomståret && afskrivningslov5_udlejningsår_efter_anskaffelsen(input) >= 0 && afskrivningslov5_udlejningsår_efter_anskaffelsen(input) <= 1
| afskrivningslov5_andet_indkomstårs_afskrivning_gyldig(input: Afskrivningslov5UdlejningsaktivInput) -> afskrivningslov5_udlejningsudskydelse_gælder(input) && afskrivningslov5_udlejningsår_efter_anskaffelsen(input) >= 1 && afskrivningslov5_tidligt_udlejningssalg(input) == Falskt && input.valgt_særskilt_afskrivning_basispoint >= 0 && input.valgt_særskilt_afskrivning_basispoint <= 5000
| afskrivningslov5_andet_indkomstårs_afskrivning_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> 0
| exception al5_udlejningsaktiv_andetårsgrundlag afskrivningslov5_andet_indkomstårs_afskrivning_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(input.anskaffelsessum_kroner), input.valgt_særskilt_afskrivning_basispoint) under afskrivningslov5_andet_indkomstårs_afskrivning_gyldig(input)
| afskrivningslov5_udlejningsafskrivning_gyldig(input: Afskrivningslov5UdlejningsaktivInput) -> afskrivningslov5_andet_indkomstårs_afskrivning_gyldig(input) && afskrivningslov5_udlejningsår_efter_anskaffelsen(input) == 1
| afskrivningslov5_udlejningsafskrivning_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> 0
| exception al5_udlejningsaktiv_andetårsafskrivning afskrivningslov5_udlejningsafskrivning_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> afskrivningslov5_andet_indkomstårs_afskrivning_kroner(input) under afskrivningslov5_udlejningsafskrivning_gyldig(input)
| afskrivningslov5_udlejnings_uafskrevet_anskaffelsessum_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> penge_positivt_beløb(input.anskaffelsessum_kroner) - afskrivningslov5_andet_indkomstårs_afskrivning_kroner(input)
| afskrivningslov5_udlejning_til_saldo_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> 0
| exception al5_udlejningstilladelse_normal_saldo afskrivningslov5_udlejning_til_saldo_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> penge_positivt_beløb(input.anskaffelsessum_kroner) under afskrivningslov5_udlejningsaktiv_omfattet(input) && afskrivningslov5_udlejningstilladelse_gældende(input) && afskrivningslov5_udlejningsår_efter_anskaffelsen(input) == 0
| exception al5_udlejningsrest_til_saldo_tredje_år afskrivningslov5_udlejning_til_saldo_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> afskrivningslov5_udlejnings_uafskrevet_anskaffelsessum_kroner(input) under afskrivningslov5_udlejningsudskydelse_gælder(input) && afskrivningslov5_udlejningsår_efter_anskaffelsen(input) == 2 && input.solgt_i_indkomståret == Falskt
| afskrivningslov5_udlejningssalg_fortjeneste_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> 0
| exception al5_tidligt_udlejningssalg_fortjeneste afskrivningslov5_udlejningssalg_fortjeneste_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> penge_positivt_beløb(penge_positivt_beløb(input.salgssum_kroner) - penge_positivt_beløb(input.anskaffelsessum_kroner)) under afskrivningslov5_tidligt_udlejningssalg(input)
| afskrivningslov5_udlejningssalg_tab_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> 0
| exception al5_tidligt_udlejningssalg_tab afskrivningslov5_udlejningssalg_tab_kroner(input: Afskrivningslov5UdlejningsaktivInput) -> penge_positivt_beløb(penge_positivt_beløb(input.anskaffelsessum_kroner) - penge_positivt_beløb(input.salgssum_kroner)) under afskrivningslov5_tidligt_udlejningssalg(input)
| afskrivningslov5_udlejningsaktiv_resultat(input: Afskrivningslov5UdlejningsaktivInput) -> Afskrivningslov5UdlejningsaktivResultat(
    anskaffelsesår = input.anskaffelsesår,
    indkomstår = input.indkomstår,
    omfattet_af_stk4 = afskrivningslov5_udlejningsaktiv_omfattet(input),
    udskydelse_gælder = afskrivningslov5_udlejningsudskydelse_gælder(input),
    år_efter_anskaffelsen = afskrivningslov5_udlejningsår_efter_anskaffelsen(input),
    valgt_særskilt_afskrivning_basispoint = input.valgt_særskilt_afskrivning_basispoint,
    valgt_særskilt_afskrivning_gyldig = afskrivningslov5_udlejningsafskrivning_gyldig(input),
    andet_indkomstårs_afskrivning_kroner = afskrivningslov5_andet_indkomstårs_afskrivning_kroner(input),
    særskilt_afskrivning_i_indkomståret_kroner = afskrivningslov5_udlejningsafskrivning_kroner(input),
    uafskrevet_anskaffelsessum_kroner = afskrivningslov5_udlejnings_uafskrevet_anskaffelsessum_kroner(input),
    beløb_til_afskrivningssaldo_kroner = afskrivningslov5_udlejning_til_saldo_kroner(input),
    tidligt_salg_omfattet_af_stk5 = afskrivningslov5_tidligt_udlejningssalg(input),
    fortjeneste_kroner = afskrivningslov5_udlejningssalg_fortjeneste_kroner(input),
    tab_kroner = afskrivningslov5_udlejningssalg_tab_kroner(input),
    saldoændring_ved_tidligt_salg_kroner = afskrivningslov5_udlejningssalg_tab_kroner(input) - afskrivningslov5_udlejningssalg_fortjeneste_kroner(input)
)
--@end:afskrivningsloven_par5--

--@label:afskrivningsloven_par5a::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par5a_juridisk_vejledning--
----
§ 5 A. Har en skattepligtig solgt et driftsmiddel eller et skib omfattet
af dette kapitel til et beløb, der er mindre end anskaffelsessummen med
fradrag af samtlige foretagne afskrivninger, kan tabet fradrages i det
indkomstår, hvori driftsmidlet eller skibet er solgt. Opgørelsen af
foretagne afskrivninger sker med den procentsats, som den skattepligtige
har anvendt efter § 5, stk. 3. Skrotning og lignende sidestilles med
salg. Vælger den skattepligtige at fradrage tabet, kan der ikke
afskrives på det pågældende aktiv i salgsåret. Saldoværdien efter § 5
ved indkomstårets begyndelse skal i dette tilfælde formindskes med den
uafskrevne del af anskaffelsessummen for aktivet. Den skattepligtige kan
kun opnå fradrag for tab, i det omfang formindskelsen med den uafskrevne
del af anskaffelsessummen efter 5. pkt. ikke fører til en negativ saldo
efter § 5.
----

--@begin:afskrivningsloven_par5a--
# Afskrivningslov5AInput(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, saldoordning: AfskrivningslovSaldoordning, saldoværdi_primo_kroner: Heltal, anskaffelsessum_kroner: Heltal, samtlige_foretagne_afskrivninger_kroner: Heltal, salgssum_kroner: Heltal, vælger_tabsfradrag: Boolsk)
# Afskrivningslov5AResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, saldoordning: AfskrivningslovSaldoordning, omfattet_af_par5a_modellen: Boolsk, vælger_tabsfradrag: Boolsk, uafskrevet_anskaffelsessum_kroner: Heltal, beregnet_tab_kroner: Heltal, saldoformindskelse_fører_til_negativ_saldo: Boolsk, saldoformindskelse_kroner: Heltal, tab_afskåret_af_saldogrænsen_kroner: Heltal, tabsvalg_gyldigt: Boolsk, afskrivning_i_salgsåret_afskåret: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal, saldoværdi_efter_formindskelse_kroner: Heltal)

| afskrivningslov5a_saldoordning_omfattet(saldoordning: AfskrivningslovSaldoordning) -> saldoordning != AlPar5CInfrastruktursaldo
| afskrivningslov5a_omfattet_af_modellen(input: Afskrivningslov5AInput) -> input.aktiv_resultat.omfattet_af_kapitel2 && input.aktiv_resultat.udelukkende_erhvervsmæssigt_benyttet && afskrivningslov5a_saldoordning_omfattet(input.saldoordning)
| afskrivningslov5a_uafskrevet_anskaffelsessum_kroner(input: Afskrivningslov5AInput) -> penge_positivt_beløb(penge_positivt_beløb(input.anskaffelsessum_kroner) - penge_positivt_beløb(input.samtlige_foretagne_afskrivninger_kroner))
| afskrivningslov5a_beregnet_tab_kroner(input: Afskrivningslov5AInput) -> penge_positivt_beløb(afskrivningslov5a_uafskrevet_anskaffelsessum_kroner(input) - penge_positivt_beløb(input.salgssum_kroner))
| afskrivningslov5a_saldoformindskelse_fører_til_negativ_saldo(input: Afskrivningslov5AInput) -> input.saldoværdi_primo_kroner - afskrivningslov5a_uafskrevet_anskaffelsessum_kroner(input) < 0
| afskrivningslov5a_saldoformindskelse_kroner(input: Afskrivningslov5AInput) -> penge_mindste_beløb(afskrivningslov5a_uafskrevet_anskaffelsessum_kroner(input), penge_positivt_beløb(input.saldoværdi_primo_kroner))
| afskrivningslov5a_fradragsberettiget_tab_kroner(input: Afskrivningslov5AInput) -> penge_positivt_beløb(afskrivningslov5a_saldoformindskelse_kroner(input) - penge_positivt_beløb(input.salgssum_kroner))
| afskrivningslov5a_tabsvalg_gyldigt(input: Afskrivningslov5AInput) -> input.vælger_tabsfradrag && afskrivningslov5a_omfattet_af_modellen(input) && afskrivningslov5a_fradragsberettiget_tab_kroner(input) > 0
| afskrivningslov5a_fradrag_kroner(input: Afskrivningslov5AInput) -> 0
| exception al5a_valgt_tab afskrivningslov5a_fradrag_kroner(input: Afskrivningslov5AInput) -> afskrivningslov5a_fradragsberettiget_tab_kroner(input) under afskrivningslov5a_tabsvalg_gyldigt(input)
| afskrivningslov5a_saldoværdi_efter_formindskelse_kroner(input: Afskrivningslov5AInput) -> input.saldoværdi_primo_kroner
| exception al5a_uafskrevet_del_fjernes_fra_saldo afskrivningslov5a_saldoværdi_efter_formindskelse_kroner(input: Afskrivningslov5AInput) -> input.saldoværdi_primo_kroner - afskrivningslov5a_saldoformindskelse_kroner(input) under afskrivningslov5a_tabsvalg_gyldigt(input)
| afskrivningslov5a_resultat(input: Afskrivningslov5AInput) -> Afskrivningslov5AResultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    saldoordning = input.saldoordning,
    omfattet_af_par5a_modellen = afskrivningslov5a_omfattet_af_modellen(input),
    vælger_tabsfradrag = input.vælger_tabsfradrag,
    uafskrevet_anskaffelsessum_kroner = afskrivningslov5a_uafskrevet_anskaffelsessum_kroner(input),
    beregnet_tab_kroner = afskrivningslov5a_beregnet_tab_kroner(input),
    saldoformindskelse_fører_til_negativ_saldo = afskrivningslov5a_saldoformindskelse_fører_til_negativ_saldo(input),
    saldoformindskelse_kroner = afskrivningslov5a_saldoformindskelse_kroner(input),
    tab_afskåret_af_saldogrænsen_kroner = afskrivningslov5a_beregnet_tab_kroner(input) - afskrivningslov5a_fradrag_kroner(input),
    tabsvalg_gyldigt = afskrivningslov5a_tabsvalg_gyldigt(input),
    afskrivning_i_salgsåret_afskåret = afskrivningslov5a_tabsvalg_gyldigt(input),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov5a_fradrag_kroner(input),
    saldoværdi_efter_formindskelse_kroner = afskrivningslov5a_saldoværdi_efter_formindskelse_kroner(input)
)
--@end:afskrivningsloven_par5a--

--@label:afskrivningsloven_par5b::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par5b_sats_juridisk_vejledning--
----
§ 5 B. Skibe med en bruttotonnage på 20 t eller derover, der anvendes til
erhvervsmæssig transport af passagerer eller gods, afskrives på en særskilt
saldo, når

1) den skattepligtige er omfattet af selskabsskattelovens § 1, stk. 1, nr. 1 og
2, eller stk. 6,

2) den skattepligtige er omfattet af selskabsskattelovens § 2, stk. 1, litra a,
og er hjemmehørende i en anden EU-medlemsstat, eller

3) skibet udlejes uden besætning (bareboat) eller erhverves med henblik på sådan
udlejning.

Stk. 2. Afskrivning kan højst udgøre 12 pct. af den afskrivningsberettigede
saldoværdi. For nybyggede skibe, som alene er omfattet af stk. 1, nr. 1 og 2, og
som ikke undergives beskatning efter tonnageskatteloven, kan afskrivning det
første år, hvori der kan foretages afskrivninger, dog udgøre indtil 20 pct. af
anskaffelsessummen, hvorefter den resterende del af anskaffelsessummen tillægges
den afskrivningsberettigede saldoværdi for det efterfølgende indkomstår. § 5 A
finder tilsvarende anvendelse. § 5, stk. 4-6, og § 6 finder ikke anvendelse.

Stk. 3. For skibe, som er omfattet af § 5, og som bliver omfattet af stk. 1 og
2, beregnes saldoen efter disse stykker ved en forholdsmæssig fordeling af den
eksisterende saldo på grundlag af den regnskabsmæssige værdi af de pågældende
skibe og den regnskabsmæssige værdi af øvrige aktiver. Reglerne i 1. pkt. finder
tilsvarende anvendelse, når skibe omfattet af stk. 1 og 2 bliver omfattet af § 5.
----

--@begin:afskrivningsloven_par5b--
# Afskrivningslov5BSkatteydergrundlag = Al5BSelskabPar1Stk1Nr1Nr2EllerStk6 | Al5BBegrænsetSkattepligtigEuPar2Stk1LitraA | Al5BIntetSkatteydergrundlag
# Afskrivningslov5BInput(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, bruttotonnage: Heltal, erhvervsmæssig_transport_af_passagerer_eller_gods: Boolsk, skatteydergrundlag: Afskrivningslov5BSkatteydergrundlag, bareboat_udlejet_eller_erhvervet_til_bareboat: Boolsk, saldoværdi_primo_kroner: Heltal, øvrige_anskaffelsessummer_i_året_kroner: Heltal, forbedringsudgifter_i_året_kroner: Heltal, salgssummer_i_året_kroner: Heltal, valgt_saldosats_basispoint: Heltal, nybygget_førsteårs_anskaffelsessum_kroner: Heltal, nybygget_skib: Boolsk, første_afskrivningsår: Boolsk, undergivet_tonnageskat: Boolsk, valgt_nybygget_førsteårs_sats_basispoint: Heltal)
# Afskrivningslov5BResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, omfattet_af_par5b: Boolsk, alene_omfattet_af_stk1_nr1_eller_nr2: Boolsk, valgt_saldosats_basispoint: Heltal, saldovalg_gyldigt: Boolsk, afskrivningsberettiget_saldoværdi_kroner: Heltal, saldoafskrivning_kroner: Heltal, nybygget_førsteårsvalg_gyldigt: Boolsk, nybygget_førsteårsafskrivning_kroner: Heltal, nybygget_rest_til_næste_års_saldo_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal, saldoværdi_efter_afskrivning_kroner: Heltal, saldoværdi_til_næste_indkomstår_kroner: Heltal)
# Afskrivningslov5BSaldooverførselRetning = Al5SaldoTil5BSaldo | Al5BSaldoTil5Saldo
# Afskrivningslov5BSaldooverførselInput(retning: Afskrivningslov5BSaldooverførselRetning, eksisterende_kildesaldo_kroner: Heltal, regnskabsmæssig_værdi_berørte_skibe_kroner: Heltal, regnskabsmæssig_værdi_øvrige_aktiver_kroner: Heltal)
# Afskrivningslov5BSaldooverførselResultat(retning: Afskrivningslov5BSaldooverførselRetning, grundlag_gyldigt: Boolsk, eksisterende_kildesaldo_kroner: Heltal, overført_saldoværdi_kroner: Heltal, resterende_kildesaldo_kroner: Heltal, tillæg_til_modtagersaldo_kroner: Heltal)

| afskrivningslov5b_skatteydergrundlag_omfattet(grundlag: Afskrivningslov5BSkatteydergrundlag) -> grundlag != Al5BIntetSkatteydergrundlag
| afskrivningslov5b_skatteydergrundlag_matcher(input: Afskrivningslov5BInput) -> afskrivningslov5b_skatteydergrundlag_omfattet(input.skatteydergrundlag) && input.aktiv_resultat.skatteyder == AlSelskabEllerForening
| afskrivningslov5b_omfattet(input: Afskrivningslov5BInput) -> input.aktiv_resultat.omfattet_af_kapitel2 && input.aktiv_resultat.udelukkende_erhvervsmæssigt_benyttet && input.aktiv_resultat.aktivart == AlSkib && input.bruttotonnage >= 20 && input.erhvervsmæssig_transport_af_passagerer_eller_gods && (afskrivningslov5b_skatteydergrundlag_matcher(input) || input.bareboat_udlejet_eller_erhvervet_til_bareboat)
| afskrivningslov5b_alene_nr1_eller_nr2(input: Afskrivningslov5BInput) -> afskrivningslov5b_skatteydergrundlag_matcher(input) && input.bareboat_udlejet_eller_erhvervet_til_bareboat == Falskt
| afskrivningslov5b_saldoværdi_før_afskrivning_kroner(input: Afskrivningslov5BInput) -> input.saldoværdi_primo_kroner + penge_positivt_beløb(input.øvrige_anskaffelsessummer_i_året_kroner) + penge_positivt_beløb(input.forbedringsudgifter_i_året_kroner) - penge_positivt_beløb(input.salgssummer_i_året_kroner)
| afskrivningslov5b_saldovalg_gyldigt(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov5b_omfattet(input) && input.indkomstår == parametre.indkomstår && input.valgt_saldosats_basispoint >= 0 && input.valgt_saldosats_basispoint <= parametre.par5b_højeste_sats_basispoint
| afskrivningslov5b_saldoafskrivning_kroner(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al5b_saldoafskrivning afskrivningslov5b_saldoafskrivning_kroner(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(afskrivningslov5b_saldoværdi_før_afskrivning_kroner(input)), input.valgt_saldosats_basispoint) under afskrivningslov5b_saldovalg_gyldigt(input, parametre)
| afskrivningslov5b_nybygget_førsteårsvalg_gyldigt(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov5b_omfattet(input) && input.indkomstår == parametre.indkomstår && afskrivningslov5b_alene_nr1_eller_nr2(input) && input.nybygget_skib && input.første_afskrivningsår && input.undergivet_tonnageskat == Falskt && input.nybygget_førsteårs_anskaffelsessum_kroner > 0 && input.valgt_nybygget_førsteårs_sats_basispoint >= 0 && input.valgt_nybygget_førsteårs_sats_basispoint <= parametre.par5b_nybygget_førsteårs_sats_basispoint
| afskrivningslov5b_nybygget_førsteårsafskrivning_kroner(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al5b_nybygget_førsteårsafskrivning afskrivningslov5b_nybygget_førsteårsafskrivning_kroner(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(input.nybygget_førsteårs_anskaffelsessum_kroner), input.valgt_nybygget_førsteårs_sats_basispoint) under afskrivningslov5b_nybygget_førsteårsvalg_gyldigt(input, parametre)
| afskrivningslov5b_nybygget_rest_til_næste_år_kroner(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al5b_nybygget_rest_til_næste_saldo afskrivningslov5b_nybygget_rest_til_næste_år_kroner(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> penge_positivt_beløb(input.nybygget_førsteårs_anskaffelsessum_kroner) - afskrivningslov5b_nybygget_førsteårsafskrivning_kroner(input, parametre) under afskrivningslov5b_nybygget_førsteårsvalg_gyldigt(input, parametre)
| afskrivningslov5b_resultat(input: Afskrivningslov5BInput, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov5BResultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    omfattet_af_par5b = afskrivningslov5b_omfattet(input),
    alene_omfattet_af_stk1_nr1_eller_nr2 = afskrivningslov5b_alene_nr1_eller_nr2(input),
    valgt_saldosats_basispoint = input.valgt_saldosats_basispoint,
    saldovalg_gyldigt = afskrivningslov5b_saldovalg_gyldigt(input, parametre),
    afskrivningsberettiget_saldoværdi_kroner = penge_positivt_beløb(afskrivningslov5b_saldoværdi_før_afskrivning_kroner(input)),
    saldoafskrivning_kroner = afskrivningslov5b_saldoafskrivning_kroner(input, parametre),
    nybygget_førsteårsvalg_gyldigt = afskrivningslov5b_nybygget_førsteårsvalg_gyldigt(input, parametre),
    nybygget_førsteårsafskrivning_kroner = afskrivningslov5b_nybygget_førsteårsafskrivning_kroner(input, parametre),
    nybygget_rest_til_næste_års_saldo_kroner = afskrivningslov5b_nybygget_rest_til_næste_år_kroner(input, parametre),
    samlet_fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov5b_saldoafskrivning_kroner(input, parametre) + afskrivningslov5b_nybygget_førsteårsafskrivning_kroner(input, parametre),
    saldoværdi_efter_afskrivning_kroner = afskrivningslov5b_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov5b_saldoafskrivning_kroner(input, parametre),
    saldoværdi_til_næste_indkomstår_kroner = afskrivningslov5b_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov5b_saldoafskrivning_kroner(input, parametre) + afskrivningslov5b_nybygget_rest_til_næste_år_kroner(input, parametre)
)
| afskrivningslov5b_saldooverførsel_gyldig(input: Afskrivningslov5BSaldooverførselInput) -> input.eksisterende_kildesaldo_kroner >= 0 && input.regnskabsmæssig_værdi_berørte_skibe_kroner > 0 && input.regnskabsmæssig_værdi_øvrige_aktiver_kroner >= 0
| afskrivningslov5b_overført_saldoværdi_kroner(input: Afskrivningslov5BSaldooverførselInput) -> 0
| exception al5b_forholdsmæssig_saldooverførsel afskrivningslov5b_overført_saldoværdi_kroner(input: Afskrivningslov5BSaldooverførselInput) -> (input.eksisterende_kildesaldo_kroner * input.regnskabsmæssig_værdi_berørte_skibe_kroner + (input.regnskabsmæssig_værdi_berørte_skibe_kroner + input.regnskabsmæssig_værdi_øvrige_aktiver_kroner) / 2) / (input.regnskabsmæssig_værdi_berørte_skibe_kroner + input.regnskabsmæssig_værdi_øvrige_aktiver_kroner) under afskrivningslov5b_saldooverførsel_gyldig(input)
| afskrivningslov5b_saldooverførsel_resultat(input: Afskrivningslov5BSaldooverførselInput) -> Afskrivningslov5BSaldooverførselResultat(
    retning = input.retning,
    grundlag_gyldigt = afskrivningslov5b_saldooverførsel_gyldig(input),
    eksisterende_kildesaldo_kroner = input.eksisterende_kildesaldo_kroner,
    overført_saldoværdi_kroner = afskrivningslov5b_overført_saldoværdi_kroner(input),
    resterende_kildesaldo_kroner = input.eksisterende_kildesaldo_kroner - afskrivningslov5b_overført_saldoværdi_kroner(input),
    tillæg_til_modtagersaldo_kroner = afskrivningslov5b_overført_saldoværdi_kroner(input)
)
--@end:afskrivningsloven_par5b--

--@label:afskrivningsloven_par5c::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par5c_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 5 C. Følgende driftsmidler afskrives på en særskilt saldo:

1) Skibe med en bruttotonnage på 20 t eller derover, der anvendes til
erhvervsmæssig transport af passagerer eller gods, og som ikke er omfattet af
§ 5 B.

2) Luftfartøjer og rullende jernbanemateriel.

3) Borerigge, produktionsplatforme og andre anlæg til forundersøgelse,
efterforskning, indvinding og raffinering af olie og gas.

4) Faste anlæg til fremstilling af varme og el med en kapacitet på over 1 MW og
anlæg til indvinding af vand til almene vandforsyninger, jf.
vandforsyningslovens § 3, stk. 3.

5) Spildevandsanlæg.

Stk. 2. Følgende infrastrukturanlæg afskrives på en særskilt saldo:

1) Anlæg til transport, lagring og distribution m.v. af el, vand, varme, olie,
gas og spildevand.

2) Anlæg til transmission af radio-, tv- og telekommunikation.

3) Fast jernbanemateriel.

Stk. 3. Stk. 1 og 2 gælder ikke for aktiver, i det omfang disse afskrives efter
kapitel 3. Stk. 1 og 2 finder ikke anvendelse på den del af anlæggene m.v., som
udgøres af software og hardware.

Stk. 4. Afskrivning på aktiver omfattet af stk. 1 kan højst udgøre 15 pct. af
den afskrivningsberettigede saldoværdi. Afskrivning på aktiver omfattet af stk.
2 kan højst udgøre 7 pct. af den afskrivningsberettigede saldoværdi. Reglerne
for driftsmidler omfattet af § 5, bortset fra § 5, stk. 4-6, § 5 A og § 6 finder
tilsvarende anvendelse.

Stk. 5. Stk. 1, nr. 4, finder ikke anvendelse på vindmøller, der er anskaffet i
indkomstår, der udløber før indkomstår, der begynder den 1. januar 2013 eller
senere.
----

--@begin:afskrivningsloven_par5c--
# Afskrivningslov5CSaldoart = Al5CStk1LangLevetid | Al5CStk2Infrastruktur
# Afskrivningslov5CAktivkategori = Al5CSkib20TIkkePar5B | Al5CLuftfartøj | Al5CRullendeJernbanemateriel | Al5COlieGasAnlæg | Al5CVarmeElOver1MW | Al5CVandindvindingsanlæg | Al5CSpildevandsanlæg | Al5CTransportLagringDistribution | Al5CTransmission | Al5CFastJernbanemateriel | Al5CVindmølleOver1MW | Al5CAndetAktiv
# Afskrivningslov5CValg = Al5CIngenAfskrivning | Al5COrdinærAfskrivning(sats_basispoint: Heltal) | Al5CFuldRestsaldo
# Afskrivningslov5CInput(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, saldoart: Afskrivningslov5CSaldoart, aktivkategori: Afskrivningslov5CAktivkategori, afskrives_efter_kapitel3: Boolsk, software_eller_hardware_del: Boolsk, saldoværdi_primo_kroner: Heltal, anskaffelsessummer_i_året_kroner: Heltal, forbedringsudgifter_i_året_kroner: Heltal, salgssummer_i_året_kroner: Heltal, valg: Afskrivningslov5CValg)
# Afskrivningslov5CResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, saldoart: Afskrivningslov5CSaldoart, aktivkategori: Afskrivningslov5CAktivkategori, aktivkategori_matcher_saldo: Boolsk, omfattet_af_par5c: Boolsk, valg: Afskrivningslov5CValg, valg_gyldigt: Boolsk, højeste_sats_basispoint: Heltal, afskrivningsberettiget_saldoværdi_kroner: Heltal, højeste_ordinære_afskrivning_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, saldoværdi_efter_afskrivning_kroner: Heltal)

| afskrivningslov5c_stk1_kategori(kategori: Afskrivningslov5CAktivkategori, indkomstår: Heltal) -> match kategori {
    | Al5CSkib20TIkkePar5B -> Sandt
    | Al5CLuftfartøj -> Sandt
    | Al5CRullendeJernbanemateriel -> Sandt
    | Al5COlieGasAnlæg -> Sandt
    | Al5CVarmeElOver1MW -> Sandt
    | Al5CVandindvindingsanlæg -> Sandt
    | Al5CSpildevandsanlæg -> Sandt
    | Al5CVindmølleOver1MW -> indkomstår >= 2013
    | _ -> Falskt
}
| afskrivningslov5c_stk2_kategori(kategori: Afskrivningslov5CAktivkategori) -> kategori == Al5CTransportLagringDistribution || kategori == Al5CTransmission || kategori == Al5CFastJernbanemateriel
| afskrivningslov5c_kategori_matcher_saldo(input: Afskrivningslov5CInput) -> match input.saldoart {
    | Al5CStk1LangLevetid -> afskrivningslov5c_stk1_kategori(input.aktivkategori, input.indkomstår)
    | Al5CStk2Infrastruktur -> afskrivningslov5c_stk2_kategori(input.aktivkategori)
}
| afskrivningslov5c_omfattet(input: Afskrivningslov5CInput) -> input.aktiv_resultat.omfattet_af_kapitel2 && input.aktiv_resultat.udelukkende_erhvervsmæssigt_benyttet && afskrivningslov5c_kategori_matcher_saldo(input) && input.afskrives_efter_kapitel3 == Falskt && input.software_eller_hardware_del == Falskt
| afskrivningslov5c_højeste_sats_basispoint(saldoart: Afskrivningslov5CSaldoart, parametre: AfskrivningslovÅrsparametre) -> match saldoart {
    | Al5CStk1LangLevetid -> parametre.par5c_stk1_højeste_sats_basispoint
    | Al5CStk2Infrastruktur -> parametre.par5c_stk2_højeste_sats_basispoint
}
| afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input: Afskrivningslov5CInput) -> input.saldoværdi_primo_kroner + penge_positivt_beløb(input.anskaffelsessummer_i_året_kroner) + penge_positivt_beløb(input.forbedringsudgifter_i_året_kroner) - penge_positivt_beløb(input.salgssummer_i_året_kroner)
| afskrivningslov5c_valgt_sats_basispoint(valg: Afskrivningslov5CValg) -> match valg {
    | Al5COrdinærAfskrivning(sats_basispoint) -> penge_positivt_beløb(sats_basispoint)
    | _ -> 0
}
| afskrivningslov5c_valg_gyldigt(input: Afskrivningslov5CInput, parametre: AfskrivningslovÅrsparametre) -> match input.valg {
    | Al5CIngenAfskrivning -> afskrivningslov5c_omfattet(input) && input.indkomstår == parametre.indkomstår
    | Al5COrdinærAfskrivning(sats_basispoint) -> afskrivningslov5c_omfattet(input) && input.indkomstår == parametre.indkomstår && sats_basispoint >= 0 && sats_basispoint <= afskrivningslov5c_højeste_sats_basispoint(input.saldoart, parametre)
    | Al5CFuldRestsaldo -> afskrivningslov5c_omfattet(input) && input.indkomstår == parametre.indkomstår && afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input) > 0 && afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input) <= parametre.småsaldigrænse_kroner
}
| afskrivningslov5c_fradrag_kroner(input: Afskrivningslov5CInput, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al5c_ordinær_saldoafskrivning afskrivningslov5c_fradrag_kroner(input: Afskrivningslov5CInput, parametre: AfskrivningslovÅrsparametre) -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input)), afskrivningslov5c_valgt_sats_basispoint(input.valg)) under afskrivningslov5c_valg_gyldigt(input, parametre) && afskrivningslov5c_valgt_sats_basispoint(input.valg) > 0
| exception al5c_fuld_småsaldofradrag afskrivningslov5c_fradrag_kroner(input: Afskrivningslov5CInput, parametre: AfskrivningslovÅrsparametre) -> penge_positivt_beløb(afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input)) under afskrivningslov5c_valg_gyldigt(input, parametre) && input.valg == Al5CFuldRestsaldo
| afskrivningslov5c_resultat(input: Afskrivningslov5CInput, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov5CResultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    saldoart = input.saldoart,
    aktivkategori = input.aktivkategori,
    aktivkategori_matcher_saldo = afskrivningslov5c_kategori_matcher_saldo(input),
    omfattet_af_par5c = afskrivningslov5c_omfattet(input),
    valg = input.valg,
    valg_gyldigt = afskrivningslov5c_valg_gyldigt(input, parametre),
    højeste_sats_basispoint = afskrivningslov5c_højeste_sats_basispoint(input.saldoart, parametre),
    afskrivningsberettiget_saldoværdi_kroner = penge_positivt_beløb(afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input)),
    højeste_ordinære_afskrivning_kroner = penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input)), afskrivningslov5c_højeste_sats_basispoint(input.saldoart, parametre)),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov5c_fradrag_kroner(input, parametre),
    saldoværdi_efter_afskrivning_kroner = afskrivningslov5c_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov5c_fradrag_kroner(input, parametre)
)
--@end:afskrivningsloven_par5c--

--@label:afskrivningsloven_par5d_par5e::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_saldoprincip_juridisk_vejledning--
----
§ 5 D. Den skattepligtige kan i stedet for at afskrive efter § 5 vælge at
afskrive udgifter til anskaffelse af nye driftsmidler, som udelukkende benyttes
erhvervsmæssigt, på en særskilt saldo, hvor anskaffelsessummen indgår med 116
pct., jf. dog stk. 2, 3, 5 og 7. Ved nye driftsmidler forstås driftsmidler, der
anskaffes af den skattepligtige som fabriksnye.

Stk. 2. Det er en betingelse for afskrivning efter stk. 1, at anskaffelsessummen
som nævnt i stk. 1 ikke fradrages (straksafskrives) efter § 6, stk. 1.

Stk. 3. Stk. 1 finder ikke anvendelse for udgifter til anskaffelse af
personbiler og skibe eller for udgifter til anskaffelse af maskiner, der via
egen energiforsyning drives eller kan drives af fossile brændsler. Stk. 1 finder
dog anvendelse for andre køretøjer end personbiler, når køretøjet registreres i
Køretøjsregisteret efter § 2, stk. 1, i lov om registrering af køretøjer eller
der er tale om en traktor eller blokvogn, der uden registrering anvendes til
transporter efter § 4 i den nævnte lov, når køretøjet inden udgangen af det
indkomstår, hvor anskaffelsen sker, eller senest 3 måneder efter anskaffelsen er
forsynet med nummerplader.

Stk. 4. Indkomstårets afskrivninger efter stk. 1 foretages på grundlag af den
afskrivningsberettigede saldoværdi ved indkomstårets udgang. Denne værdi opgøres
som saldoværdien ved indkomstårets begyndelse med tillæg af 116 pct. af
anskaffelsessummen for driftsmidler, der er anskaffet i indkomståret, jf. dog
stk. 7, og med fradrag af 116 pct. af salgssummen for driftsmidler, der er solgt
og leveret i indkomstårets løb, og som indgik på den særskilte saldo med 116
pct. af anskaffelsessummen. Saldoværdien ved indkomstårets begyndelse udgør det
beløb, hvortil driftsmidler anskaffet i tidligere indkomstår er nedbragt ved
afskrivninger efter stk. 1.

Stk. 5. Afskrivning efter stk. 1 kan højst udgøre 25 pct. af den
afskrivningsberettigede saldoværdi efter stk. 4.

Stk. 6. § 5, stk. 4-6, og § 5 A finder tilsvarende anvendelse for driftsmidler
omfattet af stk. 1.

Stk. 7. Stk. 1 finder alene anvendelse for driftsmidler, der er anskaffet i
perioden fra og med den 23. november 2020 til og med den 31. december 2022. Den
afskrivningsberettigede saldoværdi efter stk. 4 lægges sammen med saldoværdien
efter § 5 ved udgangen af indkomståret 2026. Den derved fremkomne samlede
saldoværdi behandles fra og med indkomståret 2027 efter § 5.
----

--@label:afskrivningsloven_par5d_par5e::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_saldoprincip_juridisk_vejledning--
----
§ 5 E. Den skattepligtige kan i stedet for at afskrive efter § 5 vælge at
afskrive udgifter til anskaffelse af nye driftsmidler, som udelukkende benyttes
erhvervsmæssigt, på en særskilt saldo, hvor anskaffelsessummen indgår med 108
pct., jf. dog stk. 2, 3, 5 og 7. Ved nye driftsmidler forstås driftsmidler, der
anskaffes af den skattepligtige som fabriksnye.

Stk. 2. Det er en betingelse for afskrivning efter stk. 1, at anskaffelsessummen
som nævnt i stk. 1 ikke fradrages (straksafskrives) efter § 6, stk. 1.

Stk. 3. Stk. 1 finder ikke anvendelse for udgifter til anskaffelse af
personbiler, skibe og software eller for udgifter til anskaffelse af
driftsmidler, der via egen energiforsyning drives eller kan drives af fossile
brændsler.

Stk. 4. Indkomstårets afskrivninger efter stk. 1 foretages på grundlag af den
afskrivningsberettigede saldoværdi ved indkomstårets udgang. Denne værdi opgøres
som saldoværdien ved indkomstårets begyndelse med tillæg af 108 pct. af
anskaffelsessummen for driftsmidler, der er anskaffet i indkomståret, jf. dog
stk. 7, og med fradrag af 108 pct. af salgssummen for driftsmidler, der er solgt
og leveret i indkomstårets løb, og som indgik på den særskilte saldo med 108
pct. af anskaffelsessummen. Saldoværdien ved indkomstårets begyndelse udgør det
beløb, hvortil driftsmidler anskaffet i tidligere indkomstår er nedbragt ved
afskrivninger efter stk. 1.

Stk. 5. Afskrivning efter stk. 1 kan højst udgøre 25 pct. af den
afskrivningsberettigede saldoværdi efter stk. 4.

Stk. 6. § 5, stk. 4-6, og § 5 A finder tilsvarende anvendelse for driftsmidler
omfattet af stk. 1.

Stk. 7. Stk. 1 finder alene anvendelse for driftsmidler, der er anskaffet i
perioden fra og med den 1. januar 2025 til og med den 31. december 2026. Den
afskrivningsberettigede saldoværdi efter stk. 4 lægges sammen med saldoværdien
efter § 5 ved udgangen af indkomståret 2030. Den derved fremkomne samlede
saldoværdi behandles fra og med indkomståret 2031 efter § 5.
----

--@begin:afskrivningsloven_par5d_par5e--
# AfskrivningslovForhøjetAktivkategori = AlForhøjetPersonbil | AlForhøjetSkib | AlForhøjetSoftware | AlForhøjetFossildrevetMaskine | AlForhøjetFossildrevetAndetDriftsmiddel | AlForhøjetAndetKøretøj | AlForhøjetAndetDriftsmiddel
# AfskrivningslovForhøjetAnskaffelse(par3_resultat: Afskrivningslov3Resultat, anskaffelsessum_kroner: Heltal, fabriksnyt: Boolsk, udelukkende_erhvervsmæssigt_benyttet: Boolsk, straksafskrevet_efter_par6_stk1: Boolsk, aktivkategori: AfskrivningslovForhøjetAktivkategori, nummerpladevilkår_opfyldt: Boolsk)
# AfskrivningslovForhøjetSalg(salgssum_kroner: Heltal)
# AfskrivningslovForhøjetSaldoValg = AlForhøjetIngenAfskrivning | AlForhøjetOrdinærAfskrivning(sats_basispoint: Heltal)
# AfskrivningslovForhøjetSaldoInput(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, saldoordning: AfskrivningslovSaldoordning, saldoværdi_primo_kroner: Heltal, anskaffelser: List(AfskrivningslovForhøjetAnskaffelse), salg: List(AfskrivningslovForhøjetSalg), valg: AfskrivningslovForhøjetSaldoValg)
# AfskrivningslovForhøjetSaldoResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, saldoordning: AfskrivningslovSaldoordning, saldoordning_aktiv_i_indkomståret: Boolsk, forhøjelsesprocent_basispoint: Heltal, gyldige_anskaffelsessummer_kroner: Heltal, afskårne_anskaffelsessummer_kroner: Heltal, forhøjede_anskaffelsessummer_kroner: Heltal, salgssummer_kroner: Heltal, forhøjede_salgssummer_kroner: Heltal, valg: AfskrivningslovForhøjetSaldoValg, valg_gyldigt: Boolsk, afskrivningsberettiget_saldoværdi_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, saldoværdi_efter_afskrivning_kroner: Heltal, sammenlægges_med_par5_ved_årets_udgang: Boolsk, saldo_til_par5_næste_indkomstår_kroner: Heltal, særskilt_saldo_til_næste_indkomstår_kroner: Heltal)

| afskrivningslov_forhøjet_saldoordning(saldoordning: AfskrivningslovSaldoordning) -> saldoordning == AlPar5DMidlertidig116Saldo || saldoordning == AlPar5EMidlertidig108Saldo
| afskrivningslov_forhøjet_procent_basispoint(saldoordning: AfskrivningslovSaldoordning) -> match saldoordning {
    | AlPar5DMidlertidig116Saldo -> 11600
    | AlPar5EMidlertidig108Saldo -> 10800
    | _ -> 0
}
| afskrivningslov_forhøjet_sammenlægningsår(saldoordning: AfskrivningslovSaldoordning) -> match saldoordning {
    | AlPar5DMidlertidig116Saldo -> 2026
    | AlPar5EMidlertidig108Saldo -> 2030
    | _ -> 0
}
| afskrivningslov_forhøjet_saldo_aktiv_i_år(saldoordning: AfskrivningslovSaldoordning, indkomstår: Heltal) -> afskrivningslov_forhøjet_saldoordning(saldoordning) && indkomstår <= afskrivningslov_forhøjet_sammenlægningsår(saldoordning)
| afskrivningslov_forhøjet_anskaffelsesdato_i_vindue(saldoordning: AfskrivningslovSaldoordning, dato: AfskrivningslovDato) -> match saldoordning {
    | AlPar5DMidlertidig116Saldo -> afskrivningslov_dato_mellem_inklusive(dato, AfskrivningslovDato(år = 2020, måned = 11, dag = 23), AfskrivningslovDato(år = 2022, måned = 12, dag = 31))
    | AlPar5EMidlertidig108Saldo -> afskrivningslov_dato_mellem_inklusive(dato, AfskrivningslovDato(år = 2025, måned = 1, dag = 1), AfskrivningslovDato(år = 2026, måned = 12, dag = 31))
    | _ -> Falskt
}
| afskrivningslov5d_aktivkategori_tilladt(anskaffelse: AfskrivningslovForhøjetAnskaffelse) -> match anskaffelse.aktivkategori {
    | AlForhøjetPersonbil -> Falskt
    | AlForhøjetSkib -> Falskt
    | AlForhøjetFossildrevetMaskine -> Falskt
    | AlForhøjetAndetKøretøj -> anskaffelse.nummerpladevilkår_opfyldt
    | _ -> Sandt
}
| afskrivningslov5e_aktivkategori_tilladt(anskaffelse: AfskrivningslovForhøjetAnskaffelse) -> match anskaffelse.aktivkategori {
    | AlForhøjetPersonbil -> Falskt
    | AlForhøjetSkib -> Falskt
    | AlForhøjetSoftware -> Falskt
    | AlForhøjetFossildrevetMaskine -> Falskt
    | AlForhøjetFossildrevetAndetDriftsmiddel -> Falskt
    | _ -> Sandt
}
| afskrivningslov_forhøjet_aktivkategori_tilladt(saldoordning: AfskrivningslovSaldoordning, anskaffelse: AfskrivningslovForhøjetAnskaffelse) -> match saldoordning {
    | AlPar5DMidlertidig116Saldo -> afskrivningslov5d_aktivkategori_tilladt(anskaffelse)
    | AlPar5EMidlertidig108Saldo -> afskrivningslov5e_aktivkategori_tilladt(anskaffelse)
    | _ -> Falskt
}
| afskrivningslov_forhøjet_anskaffelse_gyldig(input: AfskrivningslovForhøjetSaldoInput, anskaffelse: AfskrivningslovForhøjetAnskaffelse) -> afskrivningslov_forhøjet_saldo_aktiv_i_år(input.saldoordning, input.indkomstår) && anskaffelse.par3_resultat.anskaffet_efter_par3 && anskaffelse.par3_resultat.anskaffelsesdato.år == input.indkomstår && afskrivningslov_forhøjet_anskaffelsesdato_i_vindue(input.saldoordning, anskaffelse.par3_resultat.anskaffelsesdato) && anskaffelse.fabriksnyt && anskaffelse.udelukkende_erhvervsmæssigt_benyttet && anskaffelse.straksafskrevet_efter_par6_stk1 == Falskt && afskrivningslov_forhøjet_aktivkategori_tilladt(input.saldoordning, anskaffelse)
| afskrivningslov_forhøjet_gyldige_anskaffelser_kroner(input: AfskrivningslovForhøjetSaldoInput) -> foldl(input.anskaffelser, 0, |sum, anskaffelse| sum + if afskrivningslov_forhøjet_anskaffelse_gyldig(input, anskaffelse) { penge_positivt_beløb(anskaffelse.anskaffelsessum_kroner) } else { 0 })
| afskrivningslov_forhøjet_afskårne_anskaffelser_kroner(input: AfskrivningslovForhøjetSaldoInput) -> foldl(input.anskaffelser, 0, |sum, anskaffelse| sum + if afskrivningslov_forhøjet_anskaffelse_gyldig(input, anskaffelse) { 0 } else { penge_positivt_beløb(anskaffelse.anskaffelsessum_kroner) })
| afskrivningslov_forhøjet_salgssummer_kroner(input: AfskrivningslovForhøjetSaldoInput) -> foldl(input.salg, 0, |sum, salgspost| sum + penge_positivt_beløb(salgspost.salgssum_kroner))
| afskrivningslov_forhøjet_beløb_kroner(beløb_kroner: Heltal, saldoordning: AfskrivningslovSaldoordning) -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(beløb_kroner), afskrivningslov_forhøjet_procent_basispoint(saldoordning))
| afskrivningslov_forhøjet_saldoværdi_før_afskrivning_kroner(input: AfskrivningslovForhøjetSaldoInput) -> input.saldoværdi_primo_kroner + afskrivningslov_forhøjet_beløb_kroner(afskrivningslov_forhøjet_gyldige_anskaffelser_kroner(input), input.saldoordning) - afskrivningslov_forhøjet_beløb_kroner(afskrivningslov_forhøjet_salgssummer_kroner(input), input.saldoordning)
| afskrivningslov_forhøjet_valgt_sats_basispoint(valg: AfskrivningslovForhøjetSaldoValg) -> match valg {
    | AlForhøjetOrdinærAfskrivning(sats_basispoint) -> penge_positivt_beløb(sats_basispoint)
    | _ -> 0
}
| afskrivningslov_forhøjet_valg_gyldigt(input: AfskrivningslovForhøjetSaldoInput) -> afskrivningslov_forhøjet_saldo_aktiv_i_år(input.saldoordning, input.indkomstår) && match input.valg {
    | AlForhøjetIngenAfskrivning -> Sandt
    | AlForhøjetOrdinærAfskrivning(sats_basispoint) -> sats_basispoint >= 0 && sats_basispoint <= 2500
}
| afskrivningslov_forhøjet_fradrag_kroner(input: AfskrivningslovForhøjetSaldoInput) -> 0
| exception al_forhøjet_saldoafskrivning afskrivningslov_forhøjet_fradrag_kroner(input: AfskrivningslovForhøjetSaldoInput) -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(afskrivningslov_forhøjet_saldoværdi_før_afskrivning_kroner(input)), afskrivningslov_forhøjet_valgt_sats_basispoint(input.valg)) under afskrivningslov_forhøjet_valg_gyldigt(input) && afskrivningslov_forhøjet_valgt_sats_basispoint(input.valg) > 0
| afskrivningslov_forhøjet_sammenlægges(input: AfskrivningslovForhøjetSaldoInput) -> afskrivningslov_forhøjet_saldo_aktiv_i_år(input.saldoordning, input.indkomstår) && input.indkomstår == afskrivningslov_forhøjet_sammenlægningsår(input.saldoordning)
| afskrivningslov_forhøjet_saldo_resultat(input: AfskrivningslovForhøjetSaldoInput) -> AfskrivningslovForhøjetSaldoResultat(
    indkomstår = input.indkomstår,
    skatteyder = input.skatteyder,
    saldoordning = input.saldoordning,
    saldoordning_aktiv_i_indkomståret = afskrivningslov_forhøjet_saldo_aktiv_i_år(input.saldoordning, input.indkomstår),
    forhøjelsesprocent_basispoint = afskrivningslov_forhøjet_procent_basispoint(input.saldoordning),
    gyldige_anskaffelsessummer_kroner = afskrivningslov_forhøjet_gyldige_anskaffelser_kroner(input),
    afskårne_anskaffelsessummer_kroner = afskrivningslov_forhøjet_afskårne_anskaffelser_kroner(input),
    forhøjede_anskaffelsessummer_kroner = afskrivningslov_forhøjet_beløb_kroner(afskrivningslov_forhøjet_gyldige_anskaffelser_kroner(input), input.saldoordning),
    salgssummer_kroner = afskrivningslov_forhøjet_salgssummer_kroner(input),
    forhøjede_salgssummer_kroner = afskrivningslov_forhøjet_beløb_kroner(afskrivningslov_forhøjet_salgssummer_kroner(input), input.saldoordning),
    valg = input.valg,
    valg_gyldigt = afskrivningslov_forhøjet_valg_gyldigt(input),
    afskrivningsberettiget_saldoværdi_kroner = penge_positivt_beløb(afskrivningslov_forhøjet_saldoværdi_før_afskrivning_kroner(input)),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov_forhøjet_fradrag_kroner(input),
    saldoværdi_efter_afskrivning_kroner = afskrivningslov_forhøjet_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov_forhøjet_fradrag_kroner(input),
    sammenlægges_med_par5_ved_årets_udgang = afskrivningslov_forhøjet_sammenlægges(input),
    saldo_til_par5_næste_indkomstår_kroner = if afskrivningslov_forhøjet_sammenlægges(input) { afskrivningslov_forhøjet_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov_forhøjet_fradrag_kroner(input) } else { 0 },
    særskilt_saldo_til_næste_indkomstår_kroner = if afskrivningslov_forhøjet_sammenlægges(input) { 0 } else { afskrivningslov_forhøjet_saldoværdi_før_afskrivning_kroner(input) - afskrivningslov_forhøjet_fradrag_kroner(input) }
)
--@end:afskrivningsloven_par5d_par5e--

--@label:afskrivningsloven_par6::source:afskrivningsloven_lbk1222::guidance_source:afskrivningsloven_par6_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 6. Den skattepligtige kan i stedet for at afskrive efter § 5 vælge at
fradrage (straksafskrive) hele anskaffelsessummen for nedennævnte
driftsmidler m.v. i den skattepligtige indkomst for det indkomstår,
hvori anskaffelsen finder sted, jf. dog stk. 3:

1) Driftsmidler, hvis fysiske levealder må antages ikke at overstige 3
år.

2) Driftsmidler med en anskaffelsessum på et grundbeløb på 26.200 kr.
(2010-niveau) eller derunder. Aktiver i et samlesæt eller lignende samt
aktiver, der er bestemt til at fungere samlet, anses for ét
driftsmiddel. Aktiver, der er bestemt til at fungere sammen med allerede
anskaffede aktiver, kan ikke straksafskrives, såfremt den samlede
anskaffelsessum overstiger grundbeløbet. Forbedringsudgifter sidestilles
med udgifter til anskaffelse af aktiver, der er bestemt til at fungere
sammen med allerede anskaffede aktiver.

3) Driftsmidler og skibe til forsøgs- og forskningsvirksomhed bortset
fra driftsmidler og skibe, der anvendes til efterforskning efter
råstoffer. Fradrag af anskaffelsessummen som nævnt i 1. pkt. kan for
indkomstårene 2018 og 2019 foretages med et beløb svarende til 101,5
pct. af anskaffelsessummen, for indkomståret 2020 med 103 pct., for
indkomstårene 2021 og 2022 med 105 pct. og for indkomstårene 2023-2025
med 108 pct. For indkomstårene 2020-2022 kan der ud over fradrag efter
2. pkt. foretages fradrag på henholdsvis 27 pct. af anskaffelsessummen
for indkomståret 2020 og 25 pct. af anskaffelsessummen for indkomstårene
2021 og 2022. Fradrag af anskaffelsessummen som nævnt i 1. pkt. kan for
indkomståret 2026 foretages med et beløb svarende til 114 pct. af
anskaffelsessummen, for indkomståret 2027 med et beløb svarende til 116
pct. af anskaffelsessummen og fra og med indkomståret 2028 med et beløb
svarende til 120 pct. af anskaffelsessummen. Fradrag efter 3. pkt. og
fradrag eller afskrivning efter ligningslovens § 8 B, stk. 4, 2. pkt.,
kan højst foretages for samlede udgifter på 845 mio. kr. i indkomståret
2020 og 910 mio. kr. i indkomstårene 2021 og 2022. Fradrag efter 4. pkt.
og fradrag eller afskrivning efter ligningslovens § 8 B, stk. 4, 3.
pkt., kan højst foretages for samlede udgifter på 793 mio. kr.
(2010-niveau). Udgifter over loftet i 6. pkt. kan fra og med
indkomståret 2026 fradrages med 110 pct. Begrænsningerne efter 5. og 6.
pkt. gælder samlet for sambeskattede selskaber i samme koncern, idet den
samlede begrænsning fordeles forholdsmæssigt mellem de sambeskattede
selskabers udgifter omfattet af 5. og 6. pkt. Grundbeløbet i 6. pkt.
reguleres efter personskattelovens § 20, dog således at det regulerede
beløb afrundes opad til nærmeste kronebeløb, der kan deles med 100.000.

Stk. 2. Sælges et aktiv, hvis anskaffelsessum efter stk. 1 fuldt ud er
fradraget i den skattepligtige indkomst for anskaffelsesåret, skal
salgssummen medregnes i den skattepligtige indkomst for det indkomstår,
hvori leveringen finder sted, jf. dog § 9.

Stk. 3. Selskaber og foreninger omfattet af selskabsskattelovens § 1,
stk. 1, nr. 1, 2 og 4, kan først fradrage udgifter til anskaffelse af
aktiver omfattet af stk. 1, nr. 1 og 2, som erhverves med henblik på
udlejning, eller som allerede ved erhvervelsen er udlejet, i den
skattepligtige indkomst for indkomståret efter anskaffelsesåret. Told- og
skatteforvaltningen kan efter reglerne i § 5, stk. 6, tillade, at 1. pkt.
ikke skal finde anvendelse.

Stk. 4. Sælges et aktiv omfattet af stk. 3, skal salgssummen med fradrag af
en eventuel anskaffelsessum, der ikke fuldt ud er fradraget i den
skattepligtige indkomst, medregnes i den skattepligtige indkomst for det
indkomstår, hvori leveringen finder sted, jf. dog § 9.
----

--@begin:afskrivningsloven_par6--
# Afskrivningslov6Valg = Al6IngenStraksafskrivning | Al6KortFysiskLevetid | Al6Småaktiv | Al6ForsøgsOgForskningsaktiv
# Afskrivningslov6Aktivgrundlag(aktiv_resultat: AfskrivningslovPar1Par2Resultat, anskaffelsesresultat: Afskrivningslov3Resultat, anskaffelsessum_kroner: Heltal, samlet_anskaffelsessum_for_funktionsenhed_kroner: Heltal, fysisk_levetid_år: Heltal, anvendes_til_forsøgs_og_forskningsvirksomhed: Boolsk, anvendes_til_råstofefterforskning: Boolsk, forskningsudgifter_omfattet_af_loftet_før_dette_aktiv_kroner: Heltal)
# Afskrivningslov6Udlejningsforhold(skatteyder_status: Afskrivningslov5UdlejningsSkatteyderStatus, erhvervet_med_henblik_på_udlejning_eller_udlejet_ved_erhvervelsen: Boolsk, tilladelse_i_anskaffelsesåret: Afskrivningslov5UdlejningsTilladelse)
# Afskrivningslov6Input(indkomstår: Heltal, aktivgrundlag: Afskrivningslov6Aktivgrundlag, udlejningsforhold: Afskrivningslov6Udlejningsforhold, valg: Afskrivningslov6Valg)
# Afskrivningslov6Resultat(indkomstår: Heltal, anskaffelsesår: Heltal, skatteyder: AfskrivningslovSkatteyder, valg: Afskrivningslov6Valg, omfattet_af_par6_stk1_modellen: Boolsk, kort_levetid_betingelse_opfyldt: Boolsk, småaktiv_betingelse_opfyldt: Boolsk, forskning_betingelse_opfyldt: Boolsk, valg_hjemmel_opfyldt: Boolsk, omfattet_af_stk3: Boolsk, udskydelse_efter_stk3_gælder: Boolsk, første_mulige_fradragsår: Heltal, fradragsår_opfyldt: Boolsk, valg_gyldigt: Boolsk, forskningsudgift_under_loft_kroner: Heltal, forskningsudgift_over_loft_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, anskaffelsessum_fradraget_senest_i_indkomståret_kroner: Heltal, ufradraget_anskaffelsessum_kroner: Heltal)
# Afskrivningslov6SalgInput(straksafskrivningsresultat: Afskrivningslov6Resultat, salgssum_kroner: Heltal, leveret_i_indkomståret: Boolsk, virksomhed_sælges_eller_ophører_i_indkomståret: Boolsk)
# Afskrivningslov6SalgResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, omfattet_af_stk2: Boolsk, omfattet_af_stk4: Boolsk, behandles_efter_par9: Boolsk, salgssum_kroner: Heltal, ufradraget_anskaffelsessum_kroner: Heltal, netto_beløb_til_skattepligtig_indkomst_kroner: Heltal, skattepligtig_indtægtsføring_kroner: Heltal, fradragsberettiget_negativt_beløb_kroner: Heltal)

| afskrivningslov6_anskaffelsesår(input: Afskrivningslov6Input) -> input.aktivgrundlag.anskaffelsesresultat.anskaffelsesdato.år
| afskrivningslov6_omfattet_af_modellen(input: Afskrivningslov6Input) -> input.aktivgrundlag.aktiv_resultat.omfattet_af_kapitel2 && input.aktivgrundlag.aktiv_resultat.udelukkende_erhvervsmæssigt_benyttet && input.aktivgrundlag.anskaffelsesresultat.anskaffet_efter_par3 && input.indkomstår >= afskrivningslov6_anskaffelsesår(input)
| afskrivningslov6_aktiv_er_driftsmiddel(aktivart: AfskrivningslovAktivart) -> match aktivart {
    | AlMaskine -> Sandt
    | AlInventar -> Sandt
    | AlAndetDriftsmiddel -> Sandt
    | AlSoftware -> Sandt
    | _ -> Falskt
}
| afskrivningslov6_kort_levetid_betingelse(input: Afskrivningslov6Input) -> afskrivningslov6_omfattet_af_modellen(input) && afskrivningslov6_aktiv_er_driftsmiddel(input.aktivgrundlag.aktiv_resultat.aktivart) && input.aktivgrundlag.aktiv_resultat.aktivart != AlSoftware && input.aktivgrundlag.fysisk_levetid_år > 0 && input.aktivgrundlag.fysisk_levetid_år <= 3
| afskrivningslov6_småaktiv_betingelse(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_omfattet_af_modellen(input) && afskrivningslov6_aktiv_er_driftsmiddel(input.aktivgrundlag.aktiv_resultat.aktivart) && penge_positivt_beløb(input.aktivgrundlag.samlet_anskaffelsessum_for_funktionsenhed_kroner) > 0 && penge_positivt_beløb(input.aktivgrundlag.samlet_anskaffelsessum_for_funktionsenhed_kroner) <= parametre.småaktivgrænse_kroner
| afskrivningslov6_forskning_betingelse(input: Afskrivningslov6Input) -> afskrivningslov6_omfattet_af_modellen(input) && input.aktivgrundlag.anvendes_til_forsøgs_og_forskningsvirksomhed && input.aktivgrundlag.anvendes_til_råstofefterforskning == Falskt
| afskrivningslov6_årsparametre_matcher_anskaffelsen(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_anskaffelsesår(input) == parametre.indkomstår
| afskrivningslov6_valg_hjemmel_opfyldt(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> match input.valg {
    | Al6IngenStraksafskrivning -> afskrivningslov6_omfattet_af_modellen(input) && afskrivningslov6_årsparametre_matcher_anskaffelsen(input, parametre)
    | Al6KortFysiskLevetid -> afskrivningslov6_kort_levetid_betingelse(input) && afskrivningslov6_årsparametre_matcher_anskaffelsen(input, parametre)
    | Al6Småaktiv -> afskrivningslov6_småaktiv_betingelse(input, parametre) && afskrivningslov6_årsparametre_matcher_anskaffelsen(input, parametre)
    | Al6ForsøgsOgForskningsaktiv -> afskrivningslov6_forskning_betingelse(input) && afskrivningslov6_årsparametre_matcher_anskaffelsen(input, parametre)
}
| afskrivningslov6_stk3_valg_hjemmel_opfyldt(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> match input.valg {
    | Al6KortFysiskLevetid -> afskrivningslov6_kort_levetid_betingelse(input) && afskrivningslov6_årsparametre_matcher_anskaffelsen(input, parametre)
    | Al6Småaktiv -> afskrivningslov6_småaktiv_betingelse(input, parametre) && afskrivningslov6_årsparametre_matcher_anskaffelsen(input, parametre)
    | _ -> Falskt
}
| afskrivningslov6_stk3_skatteyder(input: Afskrivningslov6Input) -> input.aktivgrundlag.aktiv_resultat.skatteyder == AlSelskabEllerForening && input.udlejningsforhold.skatteyder_status == Al5SelskabPar1Stk1Nr1Nr2EllerNr4
| afskrivningslov6_omfattet_af_stk3(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_stk3_skatteyder(input) && afskrivningslov6_stk3_valg_hjemmel_opfyldt(input, parametre) && input.udlejningsforhold.erhvervet_med_henblik_på_udlejning_eller_udlejet_ved_erhvervelsen
| afskrivningslov6_udskydelse_efter_stk3_gælder(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_omfattet_af_stk3(input, parametre) && input.udlejningsforhold.tilladelse_i_anskaffelsesåret != Al5UdlejningstilladelseGældende
| afskrivningslov6_første_mulige_fradragsår(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_anskaffelsesår(input) + if afskrivningslov6_udskydelse_efter_stk3_gælder(input, parametre) { 1 } else { 0 }
| afskrivningslov6_fradragsår_opfyldt(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> input.indkomstår == afskrivningslov6_første_mulige_fradragsår(input, parametre)
| afskrivningslov6_valg_gyldigt(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_valg_hjemmel_opfyldt(input, parametre) && afskrivningslov6_fradragsår_opfyldt(input, parametre)
| afskrivningslov6_forskningsudgift_under_loft_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> penge_mindste_beløb(
    penge_positivt_beløb(input.aktivgrundlag.anskaffelsessum_kroner),
    penge_positivt_beløb(parametre.forskningsloft_kroner - penge_positivt_beløb(input.aktivgrundlag.forskningsudgifter_omfattet_af_loftet_før_dette_aktiv_kroner))
)
| afskrivningslov6_forskningsudgift_over_loft_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> penge_positivt_beløb(input.aktivgrundlag.anskaffelsessum_kroner) - afskrivningslov6_forskningsudgift_under_loft_kroner(input, parametre)
| afskrivningslov6_beregnet_fradrag_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> match input.valg {
    | Al6IngenStraksafskrivning -> 0
    | Al6KortFysiskLevetid -> penge_positivt_beløb(input.aktivgrundlag.anskaffelsessum_kroner)
    | Al6Småaktiv -> penge_positivt_beløb(input.aktivgrundlag.anskaffelsessum_kroner)
    | Al6ForsøgsOgForskningsaktiv -> penge_beløb_gange_basispoint_kroner(afskrivningslov6_forskningsudgift_under_loft_kroner(input, parametre), parametre.forskning_sats_under_loft_basispoint) + penge_beløb_gange_basispoint_kroner(afskrivningslov6_forskningsudgift_over_loft_kroner(input, parametre), parametre.forskning_sats_over_loft_basispoint)
}
| afskrivningslov6_fradrag_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al6_valgt_straksafskrivning afskrivningslov6_fradrag_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov6_beregnet_fradrag_kroner(input, parametre) under afskrivningslov6_valg_gyldigt(input, parametre)
| afskrivningslov6_anskaffelsessum_fradraget_senest_i_indkomståret_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al6_valgt_anskaffelsessum_fuldt_fradraget afskrivningslov6_anskaffelsessum_fradraget_senest_i_indkomståret_kroner(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> penge_positivt_beløb(input.aktivgrundlag.anskaffelsessum_kroner) under input.valg != Al6IngenStraksafskrivning && afskrivningslov6_valg_hjemmel_opfyldt(input, parametre) && input.indkomstår >= afskrivningslov6_første_mulige_fradragsår(input, parametre)
| afskrivningslov6_resultat(input: Afskrivningslov6Input, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov6Resultat(
    indkomstår = input.indkomstår,
    anskaffelsesår = afskrivningslov6_anskaffelsesår(input),
    skatteyder = input.aktivgrundlag.aktiv_resultat.skatteyder,
    valg = input.valg,
    omfattet_af_par6_stk1_modellen = afskrivningslov6_omfattet_af_modellen(input),
    kort_levetid_betingelse_opfyldt = afskrivningslov6_kort_levetid_betingelse(input),
    småaktiv_betingelse_opfyldt = afskrivningslov6_småaktiv_betingelse(input, parametre),
    forskning_betingelse_opfyldt = afskrivningslov6_forskning_betingelse(input),
    valg_hjemmel_opfyldt = afskrivningslov6_valg_hjemmel_opfyldt(input, parametre),
    omfattet_af_stk3 = afskrivningslov6_omfattet_af_stk3(input, parametre),
    udskydelse_efter_stk3_gælder = afskrivningslov6_udskydelse_efter_stk3_gælder(input, parametre),
    første_mulige_fradragsår = afskrivningslov6_første_mulige_fradragsår(input, parametre),
    fradragsår_opfyldt = afskrivningslov6_fradragsår_opfyldt(input, parametre),
    valg_gyldigt = afskrivningslov6_valg_gyldigt(input, parametre),
    forskningsudgift_under_loft_kroner = afskrivningslov6_forskningsudgift_under_loft_kroner(input, parametre),
    forskningsudgift_over_loft_kroner = afskrivningslov6_forskningsudgift_over_loft_kroner(input, parametre),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov6_fradrag_kroner(input, parametre),
    anskaffelsessum_fradraget_senest_i_indkomståret_kroner = afskrivningslov6_anskaffelsessum_fradraget_senest_i_indkomståret_kroner(input, parametre),
    ufradraget_anskaffelsessum_kroner = penge_positivt_beløb(input.aktivgrundlag.anskaffelsessum_kroner) - afskrivningslov6_anskaffelsessum_fradraget_senest_i_indkomståret_kroner(input, parametre)
)

| afskrivningslov6_salg_omfattet_af_stk2(input: Afskrivningslov6SalgInput) -> input.leveret_i_indkomståret && input.straksafskrivningsresultat.omfattet_af_stk3 == Falskt && input.straksafskrivningsresultat.valg != Al6IngenStraksafskrivning && input.straksafskrivningsresultat.anskaffelsessum_fradraget_senest_i_indkomståret_kroner > 0 && input.straksafskrivningsresultat.ufradraget_anskaffelsessum_kroner == 0
| afskrivningslov6_salg_omfattet_af_stk4(input: Afskrivningslov6SalgInput) -> input.leveret_i_indkomståret && input.straksafskrivningsresultat.omfattet_af_stk3 && input.straksafskrivningsresultat.valg_hjemmel_opfyldt && input.straksafskrivningsresultat.valg != Al6IngenStraksafskrivning
| afskrivningslov6_salg_behandles_efter_par9(input: Afskrivningslov6SalgInput) -> input.virksomhed_sælges_eller_ophører_i_indkomståret && (afskrivningslov6_salg_omfattet_af_stk2(input) || afskrivningslov6_salg_omfattet_af_stk4(input))
| afskrivningslov6_salg_netto_beløb_kroner(input: Afskrivningslov6SalgInput) -> 0
| exception al6_stk2_salgssum afskrivningslov6_salg_netto_beløb_kroner(input: Afskrivningslov6SalgInput) -> penge_positivt_beløb(input.salgssum_kroner) under afskrivningslov6_salg_omfattet_af_stk2(input) && afskrivningslov6_salg_behandles_efter_par9(input) == Falskt
| exception al6_stk4_salgssum_efter_ufradraget_anskaffelsessum afskrivningslov6_salg_netto_beløb_kroner(input: Afskrivningslov6SalgInput) -> penge_positivt_beløb(input.salgssum_kroner) - input.straksafskrivningsresultat.ufradraget_anskaffelsessum_kroner under afskrivningslov6_salg_omfattet_af_stk4(input) && afskrivningslov6_salg_behandles_efter_par9(input) == Falskt
| afskrivningslov6_salg_resultat(input: Afskrivningslov6SalgInput) -> Afskrivningslov6SalgResultat(
    indkomstår = input.straksafskrivningsresultat.indkomstår,
    skatteyder = input.straksafskrivningsresultat.skatteyder,
    omfattet_af_stk2 = afskrivningslov6_salg_omfattet_af_stk2(input),
    omfattet_af_stk4 = afskrivningslov6_salg_omfattet_af_stk4(input),
    behandles_efter_par9 = afskrivningslov6_salg_behandles_efter_par9(input),
    salgssum_kroner = penge_positivt_beløb(input.salgssum_kroner),
    ufradraget_anskaffelsessum_kroner = input.straksafskrivningsresultat.ufradraget_anskaffelsessum_kroner,
    netto_beløb_til_skattepligtig_indkomst_kroner = afskrivningslov6_salg_netto_beløb_kroner(input),
    skattepligtig_indtægtsføring_kroner = penge_positivt_beløb(afskrivningslov6_salg_netto_beløb_kroner(input)),
    fradragsberettiget_negativt_beløb_kroner = penge_positivt_beløb(0 - afskrivningslov6_salg_netto_beløb_kroner(input))
)
--@end:afskrivningsloven_par6--

--@label:afskrivningsloven_par7::source:afskrivningsloven_lbk1222--
----
§ 7. Udgift til reparation af et skadelidt driftsmiddel eller skib fradrages i
den skattepligtige indkomst for det indkomstår, hvori reparationen foretages.

Stk. 2. Er der udbetalt en forsikring eller erstatning i anledning af skaden,
udgør fradraget dog kun det beløb, hvormed reparationsudgiften overstiger
forsikrings- eller erstatningssummen. Hvis forsikrings- eller erstatningssummen
er større end reparationsudgiften, skal det overskydende beløb fradrages i
saldoværdien efter § 5.

Stk. 3. Som reparationsudgifter betragtes udgifter, der medgår til at sætte
aktivet i den stand, det var i ved skadens indtræden.
----

--@begin:afskrivningsloven_par7--
# Afskrivningslov7Input(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, saldoordning: AfskrivningslovSaldoordning, reparationsudgifter_kroner: Heltal, forsikrings_eller_erstatningssum_kroner: Heltal, udgifter_sætter_aktivet_i_stand_som_ved_skaden: Boolsk)
# Afskrivningslov7Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, saldoordning: AfskrivningslovSaldoordning, omfattet_af_par7: Boolsk, reparationsudgifter_kroner: Heltal, forsikrings_eller_erstatningssum_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, reduktion_af_saldoværdi_kroner: Heltal)

| afskrivningslov7_omfattet(input: Afskrivningslov7Input) -> input.aktiv_resultat.omfattet_af_kapitel2 && input.aktiv_resultat.udelukkende_erhvervsmæssigt_benyttet && input.udgifter_sætter_aktivet_i_stand_som_ved_skaden
| afskrivningslov7_reparationsfradrag_kroner(input: Afskrivningslov7Input) -> 0
| exception al7_reparation_over_erstatning afskrivningslov7_reparationsfradrag_kroner(input: Afskrivningslov7Input) -> penge_positivt_beløb(input.reparationsudgifter_kroner - input.forsikrings_eller_erstatningssum_kroner) under afskrivningslov7_omfattet(input)
| afskrivningslov7_saldoreduktion_kroner(input: Afskrivningslov7Input) -> 0
| exception al7_erstatning_over_reparation afskrivningslov7_saldoreduktion_kroner(input: Afskrivningslov7Input) -> penge_positivt_beløb(input.forsikrings_eller_erstatningssum_kroner - input.reparationsudgifter_kroner) under afskrivningslov7_omfattet(input)
| afskrivningslov7_resultat(input: Afskrivningslov7Input) -> Afskrivningslov7Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    saldoordning = input.saldoordning,
    omfattet_af_par7 = afskrivningslov7_omfattet(input),
    reparationsudgifter_kroner = penge_positivt_beløb(input.reparationsudgifter_kroner),
    forsikrings_eller_erstatningssum_kroner = penge_positivt_beløb(input.forsikrings_eller_erstatningssum_kroner),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov7_reparationsfradrag_kroner(input),
    reduktion_af_saldoværdi_kroner = afskrivningslov7_saldoreduktion_kroner(input)
)
--@end:afskrivningsloven_par7--

--@label:afskrivningsloven_par8::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_negativ_saldo_juridisk_vejledning--
----
§ 8. I det omfang en negativ saldo, der er fremkommet som følge af, at
salgssummer m.v. skal fradrages i afskrivningsgrundlaget, jf. § 5, stk. 2, § 5
D, stk. 4, og § 5 E, stk. 4, ikke medregnes ved opgørelsen af den
skattepligtige indkomst for det indkomstår, hvori den er opstået, skal den
udlignes ved anskaffelser eller medregnes ved opgørelsen af den skattepligtige
indkomst for det følgende indkomstår.

Stk. 2. Ved opgørelsen af saldoen som nævnt i stk. 1 kan den skattepligtige
vælge at foretage opgørelsen på grundlag af summen af saldiene efter § 5, stk.
2, § 5 D, stk. 4, og § 5 E, stk. 4.

Stk. 3. Fristen for udligning af et negativt saldobeløb kan efter tilladelse fra
told- og skatteforvaltningen forlænges, når der er indgået aftale om bestilling
af aktiver til levering inden udløbet af fristen efter stk. 1 og anskaffelsen af
disse aktiver kan udligne den negative saldo. Tilladelse gives, såfremt
aktiverne på grund af leverandørens forhold først kan leveres efter fristens
udløb og den skattepligtige ikke har kunnet forudse eller afværge en
overskridelse af fristen efter stk. 1. Tilladelsen kan gøres betinget af, at der
stilles sikkerhed for skattebetalingen.
----

--@begin:afskrivningsloven_par8--
# AfskrivningslovSaldoTreklang(par5_saldo_kroner: Heltal, par5d_saldo_kroner: Heltal, par5e_saldo_kroner: Heltal)
# Afskrivningslov8Opgørelsesvalg = Al8SeparateSaldi | Al8SumPar5Par5DPar5E
# Afskrivningslov8Fristforlængelse = Al8IngenFristforlængelse | Al8ForlængetFrist(til_indkomstår: Heltal, bestillingsaftale_indgået_før_ordinær_frist: Boolsk, bestilte_aktiver_kan_udligne_saldo: Boolsk, forsinkelse_skyldes_leverandøren: Boolsk, overskridelse_ikke_forudset_eller_afværgelig: Boolsk, sikkerhed_påkrævet: Boolsk, sikkerhed_stillet: Boolsk)
# Afskrivningslov8Input(skatteyder: AfskrivningslovSkatteyder, negativ_saldo_opståelsesår: Heltal, indkomstår: Heltal, saldi_før_udligning: AfskrivningslovSaldoTreklang, udlignende_anskaffelser: AfskrivningslovSaldoTreklang, opgørelsesvalg: Afskrivningslov8Opgørelsesvalg, medregnes_i_opståelsesåret: Boolsk, fristforlængelse: Afskrivningslov8Fristforlængelse)
# Afskrivningslov8Resultat(skatteyder: AfskrivningslovSkatteyder, negativ_saldo_opståelsesår: Heltal, indkomstår: Heltal, opgørelsesvalg: Afskrivningslov8Opgørelsesvalg, negativ_saldo_før_udligning_kroner: Heltal, udlignende_anskaffelser_kroner: Heltal, negativ_saldo_efter_udligning_kroner: Heltal, fristforlængelse_gyldig: Boolsk, seneste_udligningsår: Heltal, indtægtsføring_i_opståelsesåret_kroner: Heltal, indtægtsføring_ved_udløbet_af_frist_kroner: Heltal, samlet_skattepligtig_indtægtsføring_kroner: Heltal, negativ_saldo_fremføres_kroner: Heltal)

| afskrivningslov_negativt_saldobeløb_kroner(saldo_kroner: Heltal) -> penge_positivt_beløb(0 - saldo_kroner)
| afskrivningslov8_separat_negativ_saldo_kroner(saldi: AfskrivningslovSaldoTreklang) -> afskrivningslov_negativt_saldobeløb_kroner(saldi.par5_saldo_kroner) + afskrivningslov_negativt_saldobeløb_kroner(saldi.par5d_saldo_kroner) + afskrivningslov_negativt_saldobeløb_kroner(saldi.par5e_saldo_kroner)
| afskrivningslov8_sammenlagt_negativ_saldo_kroner(saldi: AfskrivningslovSaldoTreklang) -> afskrivningslov_negativt_saldobeløb_kroner(saldi.par5_saldo_kroner + saldi.par5d_saldo_kroner + saldi.par5e_saldo_kroner)
| afskrivningslov8_negativ_saldo_kroner(saldi: AfskrivningslovSaldoTreklang, valg: Afskrivningslov8Opgørelsesvalg) -> match valg {
    | Al8SeparateSaldi -> afskrivningslov8_separat_negativ_saldo_kroner(saldi)
    | Al8SumPar5Par5DPar5E -> afskrivningslov8_sammenlagt_negativ_saldo_kroner(saldi)
}
| afskrivningslov8_saldi_efter_udligning(saldi: AfskrivningslovSaldoTreklang, anskaffelser: AfskrivningslovSaldoTreklang) -> AfskrivningslovSaldoTreklang(
    par5_saldo_kroner = saldi.par5_saldo_kroner + penge_positivt_beløb(anskaffelser.par5_saldo_kroner),
    par5d_saldo_kroner = saldi.par5d_saldo_kroner + penge_positivt_beløb(anskaffelser.par5d_saldo_kroner),
    par5e_saldo_kroner = saldi.par5e_saldo_kroner + penge_positivt_beløb(anskaffelser.par5e_saldo_kroner)
)
| afskrivningslov8_udlignende_anskaffelser_kroner(anskaffelser: AfskrivningslovSaldoTreklang) -> penge_positivt_beløb(anskaffelser.par5_saldo_kroner) + penge_positivt_beløb(anskaffelser.par5d_saldo_kroner) + penge_positivt_beløb(anskaffelser.par5e_saldo_kroner)
| afskrivningslov8_fristforlængelse_gyldig(input: Afskrivningslov8Input) -> match input.fristforlængelse {
    | Al8IngenFristforlængelse -> Falskt
    | Al8ForlængetFrist(til_indkomstår, bestillingsaftale, kan_udligne, leverandørforhold, ikke_forudset_eller_afværgelig, sikkerhed_påkrævet, sikkerhed_stillet) -> til_indkomstår > input.negativ_saldo_opståelsesår + 1 && bestillingsaftale && kan_udligne && leverandørforhold && ikke_forudset_eller_afværgelig && (sikkerhed_påkrævet == Falskt || sikkerhed_stillet)
}
| afskrivningslov8_seneste_udligningsår(input: Afskrivningslov8Input) -> input.negativ_saldo_opståelsesår + 1
| exception al8_forlænget_udligningsfrist afskrivningslov8_seneste_udligningsår(input: Afskrivningslov8Input) -> match input.fristforlængelse { | Al8ForlængetFrist(til_indkomstår, _, _, _, _, _, _) -> til_indkomstår | _ -> input.negativ_saldo_opståelsesår + 1 } under afskrivningslov8_fristforlængelse_gyldig(input)
| afskrivningslov8_indtægtsføring_i_opståelsesåret_kroner(input: Afskrivningslov8Input) -> 0
| exception al8_frivillig_indtægtsføring_i_opståelsesåret afskrivningslov8_indtægtsføring_i_opståelsesåret_kroner(input: Afskrivningslov8Input) -> afskrivningslov8_negativ_saldo_kroner(input.saldi_før_udligning, input.opgørelsesvalg) under input.indkomstår == input.negativ_saldo_opståelsesår && input.medregnes_i_opståelsesåret
| afskrivningslov8_indtægtsføring_ved_frist_kroner(input: Afskrivningslov8Input) -> 0
| exception al8_pligtig_indtægtsføring_ved_frist afskrivningslov8_indtægtsføring_ved_frist_kroner(input: Afskrivningslov8Input) -> afskrivningslov8_negativ_saldo_kroner(afskrivningslov8_saldi_efter_udligning(input.saldi_før_udligning, input.udlignende_anskaffelser), input.opgørelsesvalg) under input.medregnes_i_opståelsesåret == Falskt && input.indkomstår >= afskrivningslov8_seneste_udligningsår(input)
| afskrivningslov8_fremført_negativ_saldo_kroner(input: Afskrivningslov8Input) -> 0
| exception al8_negativ_saldo_fremføres afskrivningslov8_fremført_negativ_saldo_kroner(input: Afskrivningslov8Input) -> afskrivningslov8_negativ_saldo_kroner(afskrivningslov8_saldi_efter_udligning(input.saldi_før_udligning, input.udlignende_anskaffelser), input.opgørelsesvalg) under input.medregnes_i_opståelsesåret == Falskt && input.indkomstår < afskrivningslov8_seneste_udligningsår(input)
| afskrivningslov8_resultat(input: Afskrivningslov8Input) -> Afskrivningslov8Resultat(
    skatteyder = input.skatteyder,
    negativ_saldo_opståelsesår = input.negativ_saldo_opståelsesår,
    indkomstår = input.indkomstår,
    opgørelsesvalg = input.opgørelsesvalg,
    negativ_saldo_før_udligning_kroner = afskrivningslov8_negativ_saldo_kroner(input.saldi_før_udligning, input.opgørelsesvalg),
    udlignende_anskaffelser_kroner = afskrivningslov8_udlignende_anskaffelser_kroner(input.udlignende_anskaffelser),
    negativ_saldo_efter_udligning_kroner = afskrivningslov8_negativ_saldo_kroner(afskrivningslov8_saldi_efter_udligning(input.saldi_før_udligning, input.udlignende_anskaffelser), input.opgørelsesvalg),
    fristforlængelse_gyldig = afskrivningslov8_fristforlængelse_gyldig(input),
    seneste_udligningsår = afskrivningslov8_seneste_udligningsår(input),
    indtægtsføring_i_opståelsesåret_kroner = afskrivningslov8_indtægtsføring_i_opståelsesåret_kroner(input),
    indtægtsføring_ved_udløbet_af_frist_kroner = afskrivningslov8_indtægtsføring_ved_frist_kroner(input),
    samlet_skattepligtig_indtægtsføring_kroner = afskrivningslov8_indtægtsføring_i_opståelsesåret_kroner(input) + afskrivningslov8_indtægtsføring_ved_frist_kroner(input),
    negativ_saldo_fremføres_kroner = afskrivningslov8_fremført_negativ_saldo_kroner(input)
)
--@end:afskrivningsloven_par8--

--@label:afskrivningsloven_par9::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_ophør_juridisk_vejledning--
----
§ 9. I det indkomstår, hvori en virksomhed sælges eller i øvrigt ophører
(ophørsåret), kan der ikke afskrives eller straksafskrives på driftsmidler eller
skibe omfattet af dette kapitel. Fortjeneste eller tab medregnes ved opgørelsen
af den skattepligtige indkomst for ophørsåret og opgøres som forskellen mellem
på den ene side salgssummen for de i ophørsåret solgte driftsmidler og skibe,
herunder salgssummen for straksafskrevne driftsmidler og skibe, og på den anden
side saldoværdien ved ophørsårets begyndelse med tillæg af beløb, der i
ophørsåret er anvendt til nyanskaffelser. Såfremt saldoværdien ved ophørsårets
begyndelse er negativ, opgøres fortjeneste eller tab som forskellen mellem på
den ene side salgssummerne med tillæg af et positivt beløb lig den negative
saldo og på den anden side udgifterne til nyanskaffelser i ophørsåret. Ved
opgørelsen af saldoværdien som nævnt i 2. og 3. pkt. kan den skattepligtige
vælge at foretage opgørelsen på grundlag af summen af saldoværdierne efter § 5,
stk. 2, § 5 D, stk. 4, og § 5 E, stk. 4.

Stk. 2. Såfremt saldoværdien ved ophørsårets udgang er positiv og der fortsat
er driftsmidler eller skibe, der ikke er solgt, videreføres den positive saldo
for efterfølgende indkomstår. Salgssummen for driftsmidler og skibe, der sælges
efter ophørsåret, fradrages i saldoværdien. Tab kan først fradrages i den
skattepligtige indkomst for det indkomstår, hvori det sidste driftsmiddel eller
skib er solgt.

Stk. 3. I de i stk. 1 nævnte salgssummer fradrages eventuelle
anskaffelsessummer, der som følge af reglerne i § 5, stk. 4, jf. § 5 D, stk. 6,
§ 5 E, stk. 6, og § 6, stk. 3, ikke fuldt ud er fradraget i den skattepligtige
indkomst, og som ikke i forvejen er medregnet i saldoen.

Stk. 4. Sælges et driftsmiddel eller skib efter ophørsåret ud over de i stk. 2
nævnte tilfælde, medregnes salgssummen fuldt ud i den skattepligtige indkomst
for det indkomstår, hvori salget finder sted.
----

--@begin:afskrivningsloven_par9--
# Afskrivningslov9Opgørelsesvalg = Al9SeparateSaldi | Al9SammenlægPar5Par5DPar5E
# Afskrivningslov9SaldoPost(saldoordning: AfskrivningslovSaldoordning, saldoværdi_primo_kroner: Heltal, salgssummer_inkl_straksafskrevne_aktiver_kroner: Heltal, nyanskaffelser_i_ophørsåret_kroner: Heltal, ikke_fradragne_anskaffelsessummer_uden_for_saldo_kroner: Heltal, alle_aktiver_på_saldoen_solgt: Boolsk)
# Afskrivningslov9Input(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, virksomhed_solgt_eller_ophørt: Boolsk, opgørelsesvalg: Afskrivningslov9Opgørelsesvalg, saldoposter: List(Afskrivningslov9SaldoPost))
# Afskrivningslov9Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, virksomhed_solgt_eller_ophørt: Boolsk, afskrivning_og_straksafskrivning_afskåret: Boolsk, opgørelsesvalg: Afskrivningslov9Opgørelsesvalg, antal_saldoposter: Heltal, korrigerede_salgssummer_kroner: Heltal, nyanskaffelser_i_ophørsåret_kroner: Heltal, brutto_fortjeneste_kroner: Heltal, brutto_tab_før_udskydelse_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, tab_udskudt_til_sidste_aktiv_kroner: Heltal, positiv_saldo_videreført_kroner: Heltal)
# Afskrivningslov9EfterfølgendeSalgInput(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, salg_omfattet_af_stk2: Boolsk, videreført_positiv_saldo_primo_kroner: Heltal, salgssum_kroner: Heltal, sidste_driftsmiddel_eller_skib_solgt: Boolsk)
# Afskrivningslov9EfterfølgendeSalgResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, salg_omfattet_af_stk2: Boolsk, salgssum_kroner: Heltal, saldo_nedbragt_kroner: Heltal, resterende_saldo_kroner: Heltal, skattepligtig_salgssum_eller_overskud_kroner: Heltal, fradragsberettiget_endeligt_tab_kroner: Heltal)

| afskrivningslov9_sammenlægningssaldo(saldoordning: AfskrivningslovSaldoordning) -> saldoordning == AlPar5AlmindeligSaldo || saldoordning == AlPar5DMidlertidig116Saldo || saldoordning == AlPar5EMidlertidig108Saldo
| afskrivningslov9_korrigeret_salgssum_kroner(post: Afskrivningslov9SaldoPost) -> penge_positivt_beløb(penge_positivt_beløb(post.salgssummer_inkl_straksafskrevne_aktiver_kroner) - penge_positivt_beløb(post.ikke_fradragne_anskaffelsessummer_uden_for_saldo_kroner))
| afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post: Afskrivningslov9SaldoPost) -> afskrivningslov9_korrigeret_salgssum_kroner(post) - post.saldoværdi_primo_kroner - penge_positivt_beløb(post.nyanskaffelser_i_ophørsåret_kroner)
| afskrivningslov9_sammenlagt_netto_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if afskrivningslov9_sammenlægningssaldo(post.saldoordning) { afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post) } else { 0 })
| afskrivningslov9_sammenlagte_saldi_alle_solgt(poster: List(Afskrivningslov9SaldoPost)) -> all(poster, |post: Afskrivningslov9SaldoPost| if afskrivningslov9_sammenlægningssaldo(post.saldoordning) { post.alle_aktiver_på_saldoen_solgt } else { Sandt })
| afskrivningslov9_separat_fortjeneste_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + penge_positivt_beløb(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)))
| afskrivningslov9_separat_brutto_tab_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)))
| afskrivningslov9_separat_fradragsberettiget_tab_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if post.alle_aktiver_på_saldoen_solgt { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)) } else { 0 })
| afskrivningslov9_separat_udskudt_tab_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if post.alle_aktiver_på_saldoen_solgt { 0 } else { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)) })
| afskrivningslov9_øvrig_fortjeneste_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if afskrivningslov9_sammenlægningssaldo(post.saldoordning) { 0 } else { penge_positivt_beløb(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)) })
| afskrivningslov9_øvrigt_brutto_tab_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if afskrivningslov9_sammenlægningssaldo(post.saldoordning) { 0 } else { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)) })
| afskrivningslov9_øvrigt_fradrag_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if afskrivningslov9_sammenlægningssaldo(post.saldoordning) || post.alle_aktiver_på_saldoen_solgt == Falskt { 0 } else { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)) })
| afskrivningslov9_øvrigt_udskudt_tab_kroner(poster: List(Afskrivningslov9SaldoPost)) -> foldl(poster, 0, |sum, post| sum + if afskrivningslov9_sammenlægningssaldo(post.saldoordning) || post.alle_aktiver_på_saldoen_solgt { 0 } else { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_netto_fortjeneste_eller_tab_kroner(post)) })
| afskrivningslov9_fortjeneste_kroner(input: Afskrivningslov9Input) -> match input.opgørelsesvalg {
    | Al9SeparateSaldi -> afskrivningslov9_separat_fortjeneste_kroner(input.saldoposter)
    | Al9SammenlægPar5Par5DPar5E -> penge_positivt_beløb(afskrivningslov9_sammenlagt_netto_kroner(input.saldoposter)) + afskrivningslov9_øvrig_fortjeneste_kroner(input.saldoposter)
}
| afskrivningslov9_brutto_tab_kroner(input: Afskrivningslov9Input) -> match input.opgørelsesvalg {
    | Al9SeparateSaldi -> afskrivningslov9_separat_brutto_tab_kroner(input.saldoposter)
    | Al9SammenlægPar5Par5DPar5E -> afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_sammenlagt_netto_kroner(input.saldoposter)) + afskrivningslov9_øvrigt_brutto_tab_kroner(input.saldoposter)
}
| afskrivningslov9_fradragsberettiget_tab_kroner(input: Afskrivningslov9Input) -> match input.opgørelsesvalg {
    | Al9SeparateSaldi -> afskrivningslov9_separat_fradragsberettiget_tab_kroner(input.saldoposter)
    | Al9SammenlægPar5Par5DPar5E -> (if afskrivningslov9_sammenlagte_saldi_alle_solgt(input.saldoposter) { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_sammenlagt_netto_kroner(input.saldoposter)) } else { 0 }) + afskrivningslov9_øvrigt_fradrag_kroner(input.saldoposter)
}
| afskrivningslov9_udskudt_tab_kroner(input: Afskrivningslov9Input) -> match input.opgørelsesvalg {
    | Al9SeparateSaldi -> afskrivningslov9_separat_udskudt_tab_kroner(input.saldoposter)
    | Al9SammenlægPar5Par5DPar5E -> (if afskrivningslov9_sammenlagte_saldi_alle_solgt(input.saldoposter) { 0 } else { afskrivningslov_negativt_saldobeløb_kroner(afskrivningslov9_sammenlagt_netto_kroner(input.saldoposter)) }) + afskrivningslov9_øvrigt_udskudt_tab_kroner(input.saldoposter)
}
| afskrivningslov9_resultat(input: Afskrivningslov9Input) -> Afskrivningslov9Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.skatteyder,
    virksomhed_solgt_eller_ophørt = input.virksomhed_solgt_eller_ophørt,
    afskrivning_og_straksafskrivning_afskåret = input.virksomhed_solgt_eller_ophørt,
    opgørelsesvalg = input.opgørelsesvalg,
    antal_saldoposter = length(input.saldoposter),
    korrigerede_salgssummer_kroner = if input.virksomhed_solgt_eller_ophørt { foldl(input.saldoposter, 0, |sum, post| sum + afskrivningslov9_korrigeret_salgssum_kroner(post)) } else { 0 },
    nyanskaffelser_i_ophørsåret_kroner = if input.virksomhed_solgt_eller_ophørt { foldl(input.saldoposter, 0, |sum, post| sum + penge_positivt_beløb(post.nyanskaffelser_i_ophørsåret_kroner)) } else { 0 },
    brutto_fortjeneste_kroner = if input.virksomhed_solgt_eller_ophørt { afskrivningslov9_fortjeneste_kroner(input) } else { 0 },
    brutto_tab_før_udskydelse_kroner = if input.virksomhed_solgt_eller_ophørt { afskrivningslov9_brutto_tab_kroner(input) } else { 0 },
    skattepligtig_fortjeneste_kroner = if input.virksomhed_solgt_eller_ophørt { afskrivningslov9_fortjeneste_kroner(input) } else { 0 },
    fradragsberettiget_tab_kroner = if input.virksomhed_solgt_eller_ophørt { afskrivningslov9_fradragsberettiget_tab_kroner(input) } else { 0 },
    tab_udskudt_til_sidste_aktiv_kroner = if input.virksomhed_solgt_eller_ophørt { afskrivningslov9_udskudt_tab_kroner(input) } else { 0 },
    positiv_saldo_videreført_kroner = if input.virksomhed_solgt_eller_ophørt { afskrivningslov9_udskudt_tab_kroner(input) } else { 0 }
)
| afskrivningslov9_efterfølgende_saldo_nedbragt_kroner(input: Afskrivningslov9EfterfølgendeSalgInput) -> 0
| exception al9_stk2_salg_nedbringer_saldo afskrivningslov9_efterfølgende_saldo_nedbragt_kroner(input: Afskrivningslov9EfterfølgendeSalgInput) -> penge_mindste_beløb(penge_positivt_beløb(input.videreført_positiv_saldo_primo_kroner), penge_positivt_beløb(input.salgssum_kroner)) under input.salg_omfattet_af_stk2
| afskrivningslov9_efterfølgende_skattepligtigt_kroner(input: Afskrivningslov9EfterfølgendeSalgInput) -> penge_positivt_beløb(input.salgssum_kroner)
| exception al9_stk2_kun_saldooverskud_skattepligtigt afskrivningslov9_efterfølgende_skattepligtigt_kroner(input: Afskrivningslov9EfterfølgendeSalgInput) -> penge_positivt_beløb(penge_positivt_beløb(input.salgssum_kroner) - penge_positivt_beløb(input.videreført_positiv_saldo_primo_kroner)) under input.salg_omfattet_af_stk2
| afskrivningslov9_efterfølgende_endeligt_tab_kroner(input: Afskrivningslov9EfterfølgendeSalgInput) -> 0
| exception al9_sidste_aktiv_udløser_resttab afskrivningslov9_efterfølgende_endeligt_tab_kroner(input: Afskrivningslov9EfterfølgendeSalgInput) -> penge_positivt_beløb(penge_positivt_beløb(input.videreført_positiv_saldo_primo_kroner) - penge_positivt_beløb(input.salgssum_kroner)) under input.salg_omfattet_af_stk2 && input.sidste_driftsmiddel_eller_skib_solgt
| afskrivningslov9_efterfølgende_salg_resultat(input: Afskrivningslov9EfterfølgendeSalgInput) -> Afskrivningslov9EfterfølgendeSalgResultat(
    indkomstår = input.indkomstår,
    skatteyder = input.skatteyder,
    salg_omfattet_af_stk2 = input.salg_omfattet_af_stk2,
    salgssum_kroner = penge_positivt_beløb(input.salgssum_kroner),
    saldo_nedbragt_kroner = afskrivningslov9_efterfølgende_saldo_nedbragt_kroner(input),
    resterende_saldo_kroner = if input.salg_omfattet_af_stk2 && input.sidste_driftsmiddel_eller_skib_solgt == Falskt { penge_positivt_beløb(penge_positivt_beløb(input.videreført_positiv_saldo_primo_kroner) - penge_positivt_beløb(input.salgssum_kroner)) } else { 0 },
    skattepligtig_salgssum_eller_overskud_kroner = afskrivningslov9_efterfølgende_skattepligtigt_kroner(input),
    fradragsberettiget_endeligt_tab_kroner = afskrivningslov9_efterfølgende_endeligt_tab_kroner(input)
)
--@end:afskrivningsloven_par9--

--@label:afskrivningsloven_par10::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_dok_bedding_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 10. Afskrivningsreglerne i §§ 5-9 kan anvendes på dok- og beddingsanlæg, der
er beregnet til bygning og reparation af skibe, samt på de bygninger,
installationer og lignende, der hører til selve dokken eller beddingen.
Anvendelsen af reglerne er betinget af, at der i et indkomstår anskaffes aktiver
som nævnt i 1. pkt. til en samlet anskaffelsessum af et grundbeløb på mindst
703.400 kr. (2010-niveau) og af, at fortjeneste m.v. på de pågældende aktiver
også behandles efter de nævnte regler.
----

--@begin:afskrivningsloven_par10--
# Afskrivningslov10Aktivart = Al10DokAnlæg | Al10Beddingsanlæg | Al10TilhørendeBygning | Al10TilhørendeInstallation | Al10AndetTilhørendeAktiv | Al10AndetAktiv
# Afskrivningslov10Input(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov10Aktivart, beregnet_til_bygning_og_reparation_af_skibe: Boolsk, samlet_anskaffelsessum_i_indkomståret_kroner: Heltal, vælger_par5_til_par9: Boolsk, fortjeneste_mv_behandles_efter_par5_til_par9: Boolsk)
# Afskrivningslov10Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov10Aktivart, aktiv_omfattet: Boolsk, samlet_anskaffelsessum_i_indkomståret_kroner: Heltal, minimumsanskaffelsessum_kroner: Heltal, minimum_opfyldt: Boolsk, valg_gyldigt: Boolsk, anskaffelsessum_til_par5_saldo_kroner: Heltal)

| afskrivningslov10_aktiv_omfattet(input: Afskrivningslov10Input) -> input.beregnet_til_bygning_og_reparation_af_skibe && input.aktivart != Al10AndetAktiv
| afskrivningslov10_minimum_opfyldt(input: Afskrivningslov10Input, parametre: AfskrivningslovÅrsparametre) -> input.indkomstår == parametre.indkomstår && penge_positivt_beløb(input.samlet_anskaffelsessum_i_indkomståret_kroner) >= parametre.dok_og_bedding_minimum_kroner
| afskrivningslov10_valg_gyldigt(input: Afskrivningslov10Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov10_aktiv_omfattet(input) && afskrivningslov10_minimum_opfyldt(input, parametre) && input.vælger_par5_til_par9 && input.fortjeneste_mv_behandles_efter_par5_til_par9
| afskrivningslov10_til_par5_saldo_kroner(input: Afskrivningslov10Input, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al10_dok_bedding_til_par5_saldo afskrivningslov10_til_par5_saldo_kroner(input: Afskrivningslov10Input, parametre: AfskrivningslovÅrsparametre) -> penge_positivt_beløb(input.samlet_anskaffelsessum_i_indkomståret_kroner) under afskrivningslov10_valg_gyldigt(input, parametre)
| afskrivningslov10_resultat(input: Afskrivningslov10Input, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov10Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.skatteyder,
    aktivart = input.aktivart,
    aktiv_omfattet = afskrivningslov10_aktiv_omfattet(input),
    samlet_anskaffelsessum_i_indkomståret_kroner = penge_positivt_beløb(input.samlet_anskaffelsessum_i_indkomståret_kroner),
    minimumsanskaffelsessum_kroner = parametre.dok_og_bedding_minimum_kroner,
    minimum_opfyldt = afskrivningslov10_minimum_opfyldt(input, parametre),
    valg_gyldigt = afskrivningslov10_valg_gyldigt(input, parametre),
    anskaffelsessum_til_par5_saldo_kroner = afskrivningslov10_til_par5_saldo_kroner(input, parametre)
)
--@end:afskrivningsloven_par10--

--@label:afskrivningsloven_par11::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par11_par13_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 11. Driftsmidler og skibe, som en skattepligtig benytter både til
erhvervsmæssige og til private formål, skal afskrives særskilt for hvert
enkelt driftsmiddel eller skib.

Stk. 2. Afskrivning kan i anskaffelsesåret beregnes med indtil 25 pct. af
anskaffelsessummen for driftsmidler omfattet af § 5, stk. 1, indtil 15 pct.
af anskaffelsessummen for driftsmidler og skibe omfattet af § 5 C, stk. 1,
og indtil 7 pct. af anskaffelsessummen for infrastrukturanlæg omfattet af
§ 5 C, stk. 2. For hvert af de følgende indkomstår kan afskrivning beregnes
efter 1. pkt. af det beløb, der henstår uafskrevet ved indkomstårets
begyndelse. Af den således beregnede afskrivning kan fradrages et beløb,
der svarer til den erhvervsmæssige benyttelse i det pågældende indkomstår.

Stk. 3. Udgør anskaffelsessummen, eller er den inden afskrivning nedbragt
til et grundbeløb på 12.300 kr. (2010-niveau) eller derunder, kan det beløb,
der svarer til den erhvervsmæssige benyttelse, fradrages fuldt ud i den
skattepligtige indkomst.

Stk. 4. Forbedringsudgifter vedrørende driftsmidler eller skibe som nævnt i
stk. 1 behandles som anskaffelsessummer og afskrives på samme måde og sammen
med det driftsmiddel eller skib, som udgiften vedrører.

Stk. 5. For driftsmidler med en anskaffelsessum på et grundbeløb på 12.300
kr. (2010-niveau) eller derunder, finder § 6, stk. 1, nr. 2, 2.-4. pkt.,
tilsvarende anvendelse.
----

--@begin:afskrivningsloven_par11--
# AfskrivningslovBenyttelse(erhvervsmæssig_benyttelse_enheder: Heltal, samlet_benyttelse_enheder: Heltal)
# Afskrivningslov11Afskrivningskategori = Al11Par5Stk1 | Al11Par5CStk1 | Al11Par5CStk2
# Afskrivningslov11Valg = Al11IngenAfskrivning | Al11OrdinærAfskrivning(sats_basispoint: Heltal) | Al11FuldRestfradrag
# Afskrivningslov11Input(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, afskrivningskategori: Afskrivningslov11Afskrivningskategori, uafskrevet_beløb_primo_kroner: Heltal, anskaffelsessum_i_året_kroner: Heltal, forbedringsudgifter_i_året_kroner: Heltal, årets_benyttelse: AfskrivningslovBenyttelse, valg: Afskrivningslov11Valg)
# Afskrivningslov11Årsopgørelse(indkomstår: Heltal, benyttelse: AfskrivningslovBenyttelse, beregnet_afskrivning_før_erhvervsandel_kroner: Heltal, fradraget_afskrivning_kroner: Heltal)
# Afskrivningslov11Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktivart: AfskrivningslovAktivart, afskrivningskategori: Afskrivningslov11Afskrivningskategori, blandet_benyttet: Boolsk, valg: Afskrivningslov11Valg, valg_gyldigt: Boolsk, højeste_sats_basispoint: Heltal, afskrivningsgrundlag_før_årets_afskrivning_kroner: Heltal, beregnet_afskrivning_før_erhvervsandel_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, uafskrevet_beløb_ultimo_kroner: Heltal, årsopgørelse: Afskrivningslov11Årsopgørelse)

| afskrivningslov_benyttelse_gyldig(benyttelse: AfskrivningslovBenyttelse) -> benyttelse.samlet_benyttelse_enheder > 0 && benyttelse.erhvervsmæssig_benyttelse_enheder >= 0 && benyttelse.erhvervsmæssig_benyttelse_enheder <= benyttelse.samlet_benyttelse_enheder
| afskrivningslov_benyttelse_er_blandet(benyttelse: AfskrivningslovBenyttelse) -> afskrivningslov_benyttelse_gyldig(benyttelse) && benyttelse.erhvervsmæssig_benyttelse_enheder > 0 && benyttelse.erhvervsmæssig_benyttelse_enheder < benyttelse.samlet_benyttelse_enheder
| afskrivningslov_benyttelse_erhvervsandel_basispoint(benyttelse: AfskrivningslovBenyttelse) -> 0
| exception al_benyttelse_gyldig_andel afskrivningslov_benyttelse_erhvervsandel_basispoint(benyttelse: AfskrivningslovBenyttelse) -> benyttelse.erhvervsmæssig_benyttelse_enheder * 10000 / benyttelse.samlet_benyttelse_enheder under afskrivningslov_benyttelse_gyldig(benyttelse)
| afskrivningslov_beløb_gange_forhold_afrundet_kroner(beløb_kroner: Heltal, tæller: Heltal, nævner: Heltal) -> 0
| exception al_positivt_gyldigt_forhold afskrivningslov_beløb_gange_forhold_afrundet_kroner(beløb_kroner: Heltal, tæller: Heltal, nævner: Heltal) -> (penge_positivt_beløb(beløb_kroner) * tæller + nævner / 2) / nævner under beløb_kroner > 0 && tæller > 0 && nævner > 0 && tæller <= nævner
| afskrivningslov_beløb_efter_benyttelse_kroner(beløb_kroner: Heltal, benyttelse: AfskrivningslovBenyttelse) -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(beløb_kroner, benyttelse.erhvervsmæssig_benyttelse_enheder, benyttelse.samlet_benyttelse_enheder)
| afskrivningslov11_aktiv_resultat_matcher_benyttelse(input: Afskrivningslov11Input) -> input.aktiv_resultat.erhvervsmæssig_anvendelsesandel_basispoint == afskrivningslov_benyttelse_erhvervsandel_basispoint(input.årets_benyttelse)
| afskrivningslov11_omfattet(input: Afskrivningslov11Input) -> input.aktiv_resultat.omfattet_af_kapitel2 && afskrivningslov_benyttelse_er_blandet(input.årets_benyttelse) && afskrivningslov11_aktiv_resultat_matcher_benyttelse(input)
| afskrivningslov11_højeste_sats_basispoint(kategori: Afskrivningslov11Afskrivningskategori, parametre: AfskrivningslovÅrsparametre) -> match kategori {
    | Al11Par5Stk1 -> parametre.højeste_ordinære_sats_basispoint
    | Al11Par5CStk1 -> parametre.par5c_stk1_højeste_sats_basispoint
    | Al11Par5CStk2 -> parametre.par5c_stk2_højeste_sats_basispoint
}
| afskrivningslov11_afskrivningsgrundlag_kroner(input: Afskrivningslov11Input) -> penge_positivt_beløb(input.uafskrevet_beløb_primo_kroner) + penge_positivt_beløb(input.anskaffelsessum_i_året_kroner) + penge_positivt_beløb(input.forbedringsudgifter_i_året_kroner)
| afskrivningslov11_valgt_sats_basispoint(valg: Afskrivningslov11Valg) -> match valg {
    | Al11OrdinærAfskrivning(sats_basispoint) -> penge_positivt_beløb(sats_basispoint)
    | _ -> 0
}
| afskrivningslov11_årsparametre_matcher(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> input.indkomstår == parametre.indkomstår
| afskrivningslov11_valg_gyldigt(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> match input.valg {
    | Al11IngenAfskrivning -> afskrivningslov11_omfattet(input) && afskrivningslov11_årsparametre_matcher(input, parametre)
    | Al11OrdinærAfskrivning(sats_basispoint) -> afskrivningslov11_omfattet(input) && afskrivningslov11_årsparametre_matcher(input, parametre) && sats_basispoint >= 0 && sats_basispoint <= afskrivningslov11_højeste_sats_basispoint(input.afskrivningskategori, parametre)
    | Al11FuldRestfradrag -> afskrivningslov11_omfattet(input) && afskrivningslov11_årsparametre_matcher(input, parametre) && afskrivningslov11_afskrivningsgrundlag_kroner(input) > 0 && afskrivningslov11_afskrivningsgrundlag_kroner(input) <= parametre.blandet_småaktivgrænse_kroner
}
| afskrivningslov11_beregnet_afskrivning_kroner(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> 0
| exception al11_ordinær_beregnet_afskrivning afskrivningslov11_beregnet_afskrivning_kroner(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> penge_beløb_gange_basispoint_kroner(afskrivningslov11_afskrivningsgrundlag_kroner(input), afskrivningslov11_valgt_sats_basispoint(input.valg)) under afskrivningslov11_valg_gyldigt(input, parametre) && afskrivningslov11_valgt_sats_basispoint(input.valg) > 0
| exception al11_fuldt_restfradrag afskrivningslov11_beregnet_afskrivning_kroner(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov11_afskrivningsgrundlag_kroner(input) under afskrivningslov11_valg_gyldigt(input, parametre) && input.valg == Al11FuldRestfradrag
| afskrivningslov11_fradrag_kroner(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> afskrivningslov_beløb_efter_benyttelse_kroner(afskrivningslov11_beregnet_afskrivning_kroner(input, parametre), input.årets_benyttelse)
| afskrivningslov11_årsopgørelse(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov11Årsopgørelse(
    indkomstår = input.indkomstår,
    benyttelse = input.årets_benyttelse,
    beregnet_afskrivning_før_erhvervsandel_kroner = afskrivningslov11_beregnet_afskrivning_kroner(input, parametre),
    fradraget_afskrivning_kroner = afskrivningslov11_fradrag_kroner(input, parametre)
)
| afskrivningslov11_resultat(input: Afskrivningslov11Input, parametre: AfskrivningslovÅrsparametre) -> Afskrivningslov11Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    aktivart = input.aktiv_resultat.aktivart,
    afskrivningskategori = input.afskrivningskategori,
    blandet_benyttet = afskrivningslov11_omfattet(input),
    valg = input.valg,
    valg_gyldigt = afskrivningslov11_valg_gyldigt(input, parametre),
    højeste_sats_basispoint = afskrivningslov11_højeste_sats_basispoint(input.afskrivningskategori, parametre),
    afskrivningsgrundlag_før_årets_afskrivning_kroner = afskrivningslov11_afskrivningsgrundlag_kroner(input),
    beregnet_afskrivning_før_erhvervsandel_kroner = afskrivningslov11_beregnet_afskrivning_kroner(input, parametre),
    fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov11_fradrag_kroner(input, parametre),
    uafskrevet_beløb_ultimo_kroner = afskrivningslov11_afskrivningsgrundlag_kroner(input) - afskrivningslov11_beregnet_afskrivning_kroner(input, parametre),
    årsopgørelse = afskrivningslov11_årsopgørelse(input, parametre)
)
| afskrivningslov11_årsopgørelse_gyldig(årsopgørelse: Afskrivningslov11Årsopgørelse) -> afskrivningslov_benyttelse_er_blandet(årsopgørelse.benyttelse) && årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner >= 0 && årsopgørelse.fradraget_afskrivning_kroner >= 0 && årsopgørelse.fradraget_afskrivning_kroner <= årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner
--@end:afskrivningsloven_par11--

--@label:afskrivningsloven_par12::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par11_par13_juridisk_vejledning--
----
§ 12. Sælges et driftsmiddel eller skib som nævnt i § 11, kan der ikke for
salgsåret beregnes afskrivning på det solgte driftsmiddel eller skib.
Fortjeneste eller tab opgøres som forskellen mellem salgssummen og det
uafskrevne beløb ved salgsårets begyndelse forhøjet med eventuelle
forbedringsudgifter afholdt i salgsåret. Ved beregningen af det uafskrevne
beløb ved salgsårets begyndelse fragår de afskrivninger, der er beregnet for
de enkelte indkomstår. Fortjeneste eller tab medregnes ved opgørelsen af den
skattepligtige indkomst for salgsåret med så stor en del, som svarer til
forholdet mellem den erhvervsmæssige benyttelse for indkomstårene forud for
salgsåret og den samlede benyttelse for disse indkomstår.
----

--@label:afskrivningsloven_par12::guidance:afskrivningsloven_par11_par13_juridisk_vejledning--
----
Den juridiske vejledning, afsnit "Anskaffelse og afhændelse i samme
indkomstår":

Hvis et driftsmiddel med blandet benyttelse anskaffes og afhændes inden for
det samme indkomstår med fortjeneste, skal den del af fortjenesten, der svarer
til den erhvervsmæssige andel af benyttelsen af driftsmidlet, regnes med ved
opgørelsen af den skattepligtige indkomst.

Hvis afhændelsen sker med tab, kan der trækkes en tilsvarende del af tabet fra.
----

--@begin:afskrivningsloven_par12--
# Afskrivningslov12Benyttelsesgrundlag = Al12TidligereÅr(årsopgørelser: List(Afskrivningslov11Årsopgørelse)) | Al12SammeIndkomstår(benyttelse: AfskrivningslovBenyttelse)
# Afskrivningslov12Input(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, anskaffelsessum_kroner: Heltal, forbedringsudgifter_før_salgsåret_kroner: Heltal, forbedringsudgifter_i_salgsåret_kroner: Heltal, salgssum_kroner: Heltal, benyttelsesgrundlag: Afskrivningslov12Benyttelsesgrundlag)
# Afskrivningslov12Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktivart: AfskrivningslovAktivart, omfattet_af_par12: Boolsk, afskrivning_i_salgsåret_afskåret: Boolsk, beregnede_afskrivninger_før_salgsåret_kroner: Heltal, uafskrevet_beløb_primo_i_salgsåret_kroner: Heltal, forbedringsudgifter_i_salgsåret_kroner: Heltal, salgssum_kroner: Heltal, erhvervsmæssig_benyttelse_enheder: Heltal, samlet_benyttelse_enheder: Heltal, erhvervsmæssig_andel_basispoint: Heltal, fortjeneste_før_erhvervsandel_kroner: Heltal, tab_før_erhvervsandel_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal)

| afskrivningslov12_benyttelsesgrundlag_gyldigt(grundlag: Afskrivningslov12Benyttelsesgrundlag) -> match grundlag {
    | Al12TidligereÅr(årsopgørelser) -> length(årsopgørelser) > 0 && all(årsopgørelser, |årsopgørelse: Afskrivningslov11Årsopgørelse| afskrivningslov11_årsopgørelse_gyldig(årsopgørelse))
    | Al12SammeIndkomstår(benyttelse) -> afskrivningslov_benyttelse_er_blandet(benyttelse)
}
| afskrivningslov12_beregnede_afskrivninger_kroner(grundlag: Afskrivningslov12Benyttelsesgrundlag) -> match grundlag {
    | Al12TidligereÅr(årsopgørelser) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner)
    | Al12SammeIndkomstår(_) -> 0
}
| afskrivningslov12_erhvervsmæssig_benyttelse_enheder(grundlag: Afskrivningslov12Benyttelsesgrundlag) -> match grundlag {
    | Al12TidligereÅr(årsopgørelser) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.benyttelse.erhvervsmæssig_benyttelse_enheder)
    | Al12SammeIndkomstår(benyttelse) -> benyttelse.erhvervsmæssig_benyttelse_enheder
}
| afskrivningslov12_samlet_benyttelse_enheder(grundlag: Afskrivningslov12Benyttelsesgrundlag) -> match grundlag {
    | Al12TidligereÅr(årsopgørelser) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.benyttelse.samlet_benyttelse_enheder)
    | Al12SammeIndkomstår(benyttelse) -> benyttelse.samlet_benyttelse_enheder
}
| afskrivningslov12_erhvervsandel_basispoint(grundlag: Afskrivningslov12Benyttelsesgrundlag) -> 0
| exception al12_gyldigt_benyttelsesgrundlag afskrivningslov12_erhvervsandel_basispoint(grundlag: Afskrivningslov12Benyttelsesgrundlag) -> afskrivningslov12_erhvervsmæssig_benyttelse_enheder(grundlag) * 10000 / afskrivningslov12_samlet_benyttelse_enheder(grundlag) under afskrivningslov12_benyttelsesgrundlag_gyldigt(grundlag)
| afskrivningslov12_omfattet(input: Afskrivningslov12Input) -> input.aktiv_resultat.omfattet_af_kapitel2 && afskrivningslov12_benyttelsesgrundlag_gyldigt(input.benyttelsesgrundlag)
| afskrivningslov12_uafskrevet_beløb_primo_kroner(input: Afskrivningslov12Input) -> penge_positivt_beløb(penge_positivt_beløb(input.anskaffelsessum_kroner) + penge_positivt_beløb(input.forbedringsudgifter_før_salgsåret_kroner) - afskrivningslov12_beregnede_afskrivninger_kroner(input.benyttelsesgrundlag))
| afskrivningslov12_skattemæssig_restværdi_i_salgsåret_kroner(input: Afskrivningslov12Input) -> afskrivningslov12_uafskrevet_beløb_primo_kroner(input) + penge_positivt_beløb(input.forbedringsudgifter_i_salgsåret_kroner)
| afskrivningslov12_fortjeneste_før_andel_kroner(input: Afskrivningslov12Input) -> penge_positivt_beløb(penge_positivt_beløb(input.salgssum_kroner) - afskrivningslov12_skattemæssig_restværdi_i_salgsåret_kroner(input))
| afskrivningslov12_tab_før_andel_kroner(input: Afskrivningslov12Input) -> penge_positivt_beløb(afskrivningslov12_skattemæssig_restværdi_i_salgsåret_kroner(input) - penge_positivt_beløb(input.salgssum_kroner))
| afskrivningslov12_beløb_efter_erhvervsandel_kroner(input: Afskrivningslov12Input, beløb_kroner: Heltal) -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(beløb_kroner, afskrivningslov12_erhvervsmæssig_benyttelse_enheder(input.benyttelsesgrundlag), afskrivningslov12_samlet_benyttelse_enheder(input.benyttelsesgrundlag))
| afskrivningslov12_skattepligtig_fortjeneste_kroner(input: Afskrivningslov12Input) -> 0
| exception al12_fortjeneste_efter_erhvervsandel afskrivningslov12_skattepligtig_fortjeneste_kroner(input: Afskrivningslov12Input) -> afskrivningslov12_beløb_efter_erhvervsandel_kroner(input, afskrivningslov12_fortjeneste_før_andel_kroner(input)) under afskrivningslov12_omfattet(input)
| afskrivningslov12_fradragsberettiget_tab_kroner(input: Afskrivningslov12Input) -> 0
| exception al12_tab_efter_erhvervsandel afskrivningslov12_fradragsberettiget_tab_kroner(input: Afskrivningslov12Input) -> afskrivningslov12_beløb_efter_erhvervsandel_kroner(input, afskrivningslov12_tab_før_andel_kroner(input)) under afskrivningslov12_omfattet(input)
| afskrivningslov12_resultat(input: Afskrivningslov12Input) -> Afskrivningslov12Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    aktivart = input.aktiv_resultat.aktivart,
    omfattet_af_par12 = afskrivningslov12_omfattet(input),
    afskrivning_i_salgsåret_afskåret = afskrivningslov12_omfattet(input),
    beregnede_afskrivninger_før_salgsåret_kroner = afskrivningslov12_beregnede_afskrivninger_kroner(input.benyttelsesgrundlag),
    uafskrevet_beløb_primo_i_salgsåret_kroner = afskrivningslov12_uafskrevet_beløb_primo_kroner(input),
    forbedringsudgifter_i_salgsåret_kroner = penge_positivt_beløb(input.forbedringsudgifter_i_salgsåret_kroner),
    salgssum_kroner = penge_positivt_beløb(input.salgssum_kroner),
    erhvervsmæssig_benyttelse_enheder = afskrivningslov12_erhvervsmæssig_benyttelse_enheder(input.benyttelsesgrundlag),
    samlet_benyttelse_enheder = afskrivningslov12_samlet_benyttelse_enheder(input.benyttelsesgrundlag),
    erhvervsmæssig_andel_basispoint = afskrivningslov12_erhvervsandel_basispoint(input.benyttelsesgrundlag),
    fortjeneste_før_erhvervsandel_kroner = afskrivningslov12_fortjeneste_før_andel_kroner(input),
    tab_før_erhvervsandel_kroner = afskrivningslov12_tab_før_andel_kroner(input),
    skattepligtig_fortjeneste_kroner = afskrivningslov12_skattepligtig_fortjeneste_kroner(input),
    fradragsberettiget_tab_kroner = afskrivningslov12_fradragsberettiget_tab_kroner(input)
)
--@end:afskrivningsloven_par12--

--@label:afskrivningsloven_par13::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par11_par13_juridisk_vejledning--
----
§ 13. Udgår et driftsmiddel eller skib som nævnt i § 11 af driften på grund
af en skade, kan der ikke afskrives på driftsmidlet eller skibet i det
indkomstår, hvori skaden er indtruffet. For dette indkomstår behandles
driftsmidlet eller skibet, som om det er solgt. Fortjeneste eller tab, jf.
§ 48, opgøres efter § 12.

Stk. 2. Såfremt der til reparation af et skadelidt driftsmiddel eller skib
afholdes udgifter, der overstiger en i anledning af skaden udbetalt
forsikrings- eller erstatningssum, kan den del af det overskydende beløb, der
svarer til den erhvervsmæssige andel i driftsmidlets eller skibets benyttelse
i det pågældende indkomstår, fradrages i den skattepligtige indkomst.
Overstiger forsikrings- eller erstatningssummen reparationsudgifterne, skal en
så stor del af det overskydende beløb, som svarer til forholdet mellem de for
tidligere indkomstår foretagne afskrivninger og de samlede beregnede
afskrivninger på driftsmidlet eller skibet for disse indkomstår, medregnes i
den skattepligtige indkomst.
----

--@begin:afskrivningsloven_par13--
# Afskrivningslov13Behandling = Al13UdgårAfDriften | Al13RepareresOgFortsætter
# Afskrivningslov13UdgangInput(par12_resultat: Afskrivningslov12Resultat)
# Afskrivningslov13ReparationInput(indkomstår: Heltal, aktiv_resultat: AfskrivningslovPar1Par2Resultat, årets_benyttelse: AfskrivningslovBenyttelse, reparationsudgifter_kroner: Heltal, forsikrings_eller_erstatningssum_kroner: Heltal, tidligere_årsopgørelser: List(Afskrivningslov11Årsopgørelse))
# Afskrivningslov13Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktivart: AfskrivningslovAktivart, behandling: Afskrivningslov13Behandling, omfattet_af_par13: Boolsk, afskrivning_i_skadeåret_afskåret: Boolsk, skattepligtig_fortjeneste_eller_forsikringsoverskud_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, fradragsberettiget_reparationsoverskud_kroner: Heltal, samlet_skattepligtigt_beløb_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal)

| afskrivningslov13_tidligere_årsopgørelser_gyldige(årsopgørelser: List(Afskrivningslov11Årsopgørelse)) -> all(årsopgørelser, |årsopgørelse: Afskrivningslov11Årsopgørelse| afskrivningslov11_årsopgørelse_gyldig(årsopgørelse))
| afskrivningslov13_beregnede_afskrivninger_kroner(årsopgørelser: List(Afskrivningslov11Årsopgørelse)) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner)
| afskrivningslov13_foretagne_afskrivninger_kroner(årsopgørelser: List(Afskrivningslov11Årsopgørelse)) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.fradraget_afskrivning_kroner)
| afskrivningslov13_reparation_omfattet(input: Afskrivningslov13ReparationInput) -> input.aktiv_resultat.omfattet_af_kapitel2 && afskrivningslov_benyttelse_er_blandet(input.årets_benyttelse) && afskrivningslov13_tidligere_årsopgørelser_gyldige(input.tidligere_årsopgørelser)
| afskrivningslov13_reparationsoverskud_fradrag_kroner(input: Afskrivningslov13ReparationInput) -> 0
| exception al13_reparationsudgift_over_erstatning afskrivningslov13_reparationsoverskud_fradrag_kroner(input: Afskrivningslov13ReparationInput) -> afskrivningslov_beløb_efter_benyttelse_kroner(penge_positivt_beløb(input.reparationsudgifter_kroner - input.forsikrings_eller_erstatningssum_kroner), input.årets_benyttelse) under afskrivningslov13_reparation_omfattet(input) && input.reparationsudgifter_kroner > input.forsikrings_eller_erstatningssum_kroner
| afskrivningslov13_forsikringsoverskud_skattepligtigt_kroner(input: Afskrivningslov13ReparationInput) -> 0
| exception al13_erstatning_over_reparationsudgift afskrivningslov13_forsikringsoverskud_skattepligtigt_kroner(input: Afskrivningslov13ReparationInput) -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(
    penge_positivt_beløb(input.forsikrings_eller_erstatningssum_kroner - input.reparationsudgifter_kroner),
    afskrivningslov13_foretagne_afskrivninger_kroner(input.tidligere_årsopgørelser),
    afskrivningslov13_beregnede_afskrivninger_kroner(input.tidligere_årsopgørelser)
) under afskrivningslov13_reparation_omfattet(input) && input.forsikrings_eller_erstatningssum_kroner > input.reparationsudgifter_kroner
| afskrivningslov13_resultat_ved_udgang(input: Afskrivningslov13UdgangInput) -> Afskrivningslov13Resultat(
    indkomstår = input.par12_resultat.indkomstår,
    skatteyder = input.par12_resultat.skatteyder,
    aktivart = input.par12_resultat.aktivart,
    behandling = Al13UdgårAfDriften,
    omfattet_af_par13 = input.par12_resultat.omfattet_af_par12,
    afskrivning_i_skadeåret_afskåret = input.par12_resultat.omfattet_af_par12,
    skattepligtig_fortjeneste_eller_forsikringsoverskud_kroner = input.par12_resultat.skattepligtig_fortjeneste_kroner,
    fradragsberettiget_tab_kroner = input.par12_resultat.fradragsberettiget_tab_kroner,
    fradragsberettiget_reparationsoverskud_kroner = 0,
    samlet_skattepligtigt_beløb_kroner = input.par12_resultat.skattepligtig_fortjeneste_kroner,
    samlet_fradrag_i_skattepligtig_indkomst_kroner = input.par12_resultat.fradragsberettiget_tab_kroner
)
| afskrivningslov13_resultat_ved_reparation(input: Afskrivningslov13ReparationInput) -> Afskrivningslov13Resultat(
    indkomstår = input.indkomstår,
    skatteyder = input.aktiv_resultat.skatteyder,
    aktivart = input.aktiv_resultat.aktivart,
    behandling = Al13RepareresOgFortsætter,
    omfattet_af_par13 = afskrivningslov13_reparation_omfattet(input),
    afskrivning_i_skadeåret_afskåret = Falskt,
    skattepligtig_fortjeneste_eller_forsikringsoverskud_kroner = afskrivningslov13_forsikringsoverskud_skattepligtigt_kroner(input),
    fradragsberettiget_tab_kroner = 0,
    fradragsberettiget_reparationsoverskud_kroner = afskrivningslov13_reparationsoverskud_fradrag_kroner(input),
    samlet_skattepligtigt_beløb_kroner = afskrivningslov13_forsikringsoverskud_skattepligtigt_kroner(input),
    samlet_fradrag_i_skattepligtig_indkomst_kroner = afskrivningslov13_reparationsoverskud_fradrag_kroner(input)
)
--@end:afskrivningsloven_par13--

--@label:afskrivningsloven_par14::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par14_juridisk_vejledning--
----
§ 14. Erhvervsmæssigt benyttede bygninger afskrives særskilt for hver enkelt
bygning efter reglerne i dette kapitel.

Stk. 2. Uanset bestemmelsen i stk. 1 kan afskrivning ikke foretages på
bygninger, der anvendes til

1) kontor,

2) virksomhed som pengeinstitut, realkreditinstitut, kreditinstitut,
garantifond, forsikringsselskab, værdipapircentral, reguleret marked,
fondsmæglerselskab samt lignende virksomhed inden for den finansielle sektor,
herunder betalingsformidling,

3) drift af postvirksomhed, bortset fra bygninger, hvori der sker postsortering
med industrielt præg,

4) beboelse eller hertil knyttede formål, bortset fra hoteller og campinghytter
samt døgninstitutioner og bygninger, der er omfattet af lov om social service
eller barnets lov, og som udsættes for et tilsvarende slid, jf. dog nr. 5,

5) hoteller og plejehjem, der er opdelt i ejerlejligheder, eller

6) hospitaler, fødeklinikker, lægeklinikker og -huse, tandlægeklinikker,
klinikker for fysioterapi samt anden virksomhed med sygdomsbehandling.

Stk. 3. Uanset stk. 2, nr. 1-3, kan bygninger eller lokaler, der er beliggende
i tilknytning til erhvervsmæssigt benyttede bygninger afskrives, når de
pågældende bygninger eller lokaler tjener driften af den virksomhed, hvortil de
afskrivningsberettigede bygninger anvendes. Under samme betingelser omfatter
bestemmelsen i 1. pkt. også udgravninger, veje, gårdspladser,
parkeringspladser, hegn eller lignende, dog ikke udgifter til erhvervelse af
grund. Uanset stk. 1 kan bygninger eller lokaler, dog bortset fra garager og
laboratorier, der er beliggende i tilknytning til erhvervsmæssigt benyttede
bygninger, hvorpå der ikke kan afskrives efter stk. 2, heller ikke afskrives,
når de pågældende bygninger eller lokaler tjener driften af den virksomhed,
hvortil de ikkeafskrivningsberettigede bygninger anvendes. Under samme
betingelser omfatter bestemmelsen i 3. pkt. også udgravninger, veje,
gårdspladser, parkeringspladser, hegn eller lignende.
----

--@begin:afskrivningsloven_par14--
# Afskrivningslov14Bygningsanvendelse = Al14Kontor | Al14FinansielVirksomhed | Al14Postvirksomhed | Al14Beboelse | Al14HotelEllerCampinghytte | Al14DøgninstitutionMedTilsvarendeSlid | Al14HotelEllerPlejehjemOpdeltIEjerlejligheder | Al14Sygdomsbehandling | Al14AndenErhvervsanvendelse
# Afskrivningslov14Tilknytning = Al14IkkeTilknyttet | Al14TilknyttetAfskrivningsberettigetHovedbygning | Al14TilknyttetIkkeAfskrivningsberettigetHovedbygning
# Afskrivningslov14TilknyttetArt = Al14BygningEllerLokale | Al14Garage | Al14Laboratorium | Al14UdgravningVejGårdspladsParkeringHegnEllerLignende | Al14Grund
# Afskrivningslov14Input(skatteyder: AfskrivningslovSkatteyder, anvendelse: Afskrivningslov14Bygningsanvendelse, erhvervsmæssigt_benyttet: Boolsk, postsortering_med_industrielt_præg: Boolsk, tilknytning: Afskrivningslov14Tilknytning, tilknyttet_art: Afskrivningslov14TilknyttetArt)
# Afskrivningslov14Resultat(skatteyder: AfskrivningslovSkatteyder, anvendelse: Afskrivningslov14Bygningsanvendelse, erhvervsmæssigt_benyttet: Boolsk, tilknytning: Afskrivningslov14Tilknytning, tilknyttet_art: Afskrivningslov14TilknyttetArt, afskrivningsberettiget_efter_stk1_og_stk2: Boolsk, udelukket_efter_stk2: Boolsk, afskrivningsberettiget_efter_stk3: Boolsk, afskåret_ved_tilknytning_til_ikkeafskrivningsberettiget_hovedbygning: Boolsk, grund_udelukket: Boolsk, omfattet_af_par14: Boolsk)

| afskrivningslov14_anvendelse_udelukket_efter_stk2(input: Afskrivningslov14Input) -> match input.anvendelse {
    | Al14Kontor -> Sandt
    | Al14FinansielVirksomhed -> Sandt
    | Al14Postvirksomhed -> input.postsortering_med_industrielt_præg == Falskt
    | Al14Beboelse -> Sandt
    | Al14HotelEllerCampinghytte -> Falskt
    | Al14DøgninstitutionMedTilsvarendeSlid -> Falskt
    | Al14HotelEllerPlejehjemOpdeltIEjerlejligheder -> Sandt
    | Al14Sygdomsbehandling -> Sandt
    | Al14AndenErhvervsanvendelse -> Falskt
}
| afskrivningslov14_anvendelse_omfattet_af_stk3_positiv_kreds(anvendelse: Afskrivningslov14Bygningsanvendelse) -> match anvendelse {
    | Al14Kontor -> Sandt
    | Al14FinansielVirksomhed -> Sandt
    | Al14Postvirksomhed -> Sandt
    | _ -> Falskt
}

# Afskrivningslov14Sag(input: Afskrivningslov14Input) {
    | grund_udelukket() -> input.tilknyttet_art == Al14Grund
    | afskrivningsberettiget_efter_stk1_og_stk2() -> input.erhvervsmæssigt_benyttet && afskrivningslov14_anvendelse_udelukket_efter_stk2(input) == Falskt && grund_udelukket() == Falskt
    | afskrivningsberettiget_efter_stk3() -> input.erhvervsmæssigt_benyttet && input.tilknytning == Al14TilknyttetAfskrivningsberettigetHovedbygning && afskrivningslov14_anvendelse_omfattet_af_stk3_positiv_kreds(input.anvendelse) && grund_udelukket() == Falskt
    | garage_eller_laboratorium() -> input.tilknyttet_art == Al14Garage || input.tilknyttet_art == Al14Laboratorium
    | afskåret_ved_negativ_tilknytning() -> input.erhvervsmæssigt_benyttet && input.tilknytning == Al14TilknyttetIkkeAfskrivningsberettigetHovedbygning && garage_eller_laboratorium() == Falskt
    | omfattet_af_par14() -> input.erhvervsmæssigt_benyttet && grund_udelukket() == Falskt && afskåret_ved_negativ_tilknytning() == Falskt && (afskrivningsberettiget_efter_stk1_og_stk2() || afskrivningsberettiget_efter_stk3())
    | resultat() -> Afskrivningslov14Resultat(
        skatteyder = input.skatteyder,
        anvendelse = input.anvendelse,
        erhvervsmæssigt_benyttet = input.erhvervsmæssigt_benyttet,
        tilknytning = input.tilknytning,
        tilknyttet_art = input.tilknyttet_art,
        afskrivningsberettiget_efter_stk1_og_stk2 = afskrivningsberettiget_efter_stk1_og_stk2(),
        udelukket_efter_stk2 = afskrivningslov14_anvendelse_udelukket_efter_stk2(input),
        afskrivningsberettiget_efter_stk3 = afskrivningsberettiget_efter_stk3(),
        afskåret_ved_tilknytning_til_ikkeafskrivningsberettiget_hovedbygning = afskåret_ved_negativ_tilknytning(),
        grund_udelukket = grund_udelukket(),
        omfattet_af_par14 = omfattet_af_par14()
    )
}
| afskrivningslov14_sag(input: Afskrivningslov14Input) -> Afskrivningslov14Sag(input)
| afskrivningslov14_resultat(input: Afskrivningslov14Input) -> afskrivningslov14_sag(input).resultat()
--@end:afskrivningsloven_par14--

--@label:afskrivningsloven_par15::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par15_juridisk_vejledning--
----
§ 15. Installationer, der udelukkende tjener bygninger, hvorpå der kan
afskrives efter § 14, behandles og afskrives som de nævnte bygninger. Det gælder
dog ikke installationer, hvorpå der har kunnet afskrives efter stk. 2 eller 3.

Stk. 2. Installationer, der udelukkende benyttes erhvervsmæssigt, og som ikke
er omfattet af stk. 1, afskrives særskilt for hver enkelt installation efter
reglerne i dette kapitel. Såfremt flere installationer vedrørende en bygning er
anskaffet i samme indkomstår, kan de pågældende installationer dog afskrives
under ét.

Stk. 3. Installationer, der benyttes til både erhvervsmæssige og private
formål, afskrives særskilt. Afskrivning beregnes af den samlede
anskaffelsessum. Af den beregnede afskrivning kan ved opgørelsen af den
skattepligtige indkomst fradrages et beløb, der svarer til den erhvervsmæssige
benyttelse i det pågældende indkomstår.

Stk. 4. Der kan ikke afskrives på installationer i beboelsesejendomme med en
eller to selvstændige lejligheder (en- eller tofamilieshuse). Ejere af
ejerlejligheder, der benyttes til beboelse, kan ikke afskrive på installationer
i den bygning, hvori ejerlejligheden findes.
----

--@begin:afskrivningsloven_par15--
# Afskrivningslov15Anvendelse = Al15TjenerUdelukkendeBygning | Al15AndenUdelukkendeErhverv | Al15BlandetErhvervOgPrivat
# Afskrivningslov15Behandling = Al15SomBygning | Al15SærskiltUdelukkendeErhverv | Al15SærskiltBlandet | Al15IkkeAfskrivningsberettiget
# Afskrivningslov15Input(skatteyder: AfskrivningslovSkatteyder, anvendelse: Afskrivningslov15Anvendelse, bygning_resultat: Afskrivningslov14Resultat, har_kunnet_afskrives_efter_stk2_eller_stk3: Boolsk, flere_ved_samme_bygning_anskaffet_samme_indkomstår: Boolsk, benyttelse: AfskrivningslovBenyttelse, i_en_eller_tofamilieshus: Boolsk, ejer_af_ejerlejlighed_benyttet_til_beboelse: Boolsk)
# Afskrivningslov15Resultat(skatteyder: AfskrivningslovSkatteyder, anvendelse: Afskrivningslov15Anvendelse, behandling: Afskrivningslov15Behandling, benyttelse: AfskrivningslovBenyttelse, omfattet_af_stk1: Boolsk, omfattet_af_stk2: Boolsk, omfattet_af_stk3: Boolsk, kan_afskrives_under_et_efter_stk2: Boolsk, blandet_benyttet: Boolsk, udelukket_efter_stk4: Boolsk, omfattet_af_par15: Boolsk)

# Afskrivningslov15Sag(input: Afskrivningslov15Input) {
    | benyttelse_gyldig() -> afskrivningslov_benyttelse_gyldig(input.benyttelse)
    | udelukket_efter_stk4() -> input.i_en_eller_tofamilieshus || input.ejer_af_ejerlejlighed_benyttet_til_beboelse
    | udelukkende_erhvervsmæssigt_benyttet() -> benyttelse_gyldig() && input.benyttelse.erhvervsmæssig_benyttelse_enheder == input.benyttelse.samlet_benyttelse_enheder
    | blandet_benyttet() -> afskrivningslov_benyttelse_er_blandet(input.benyttelse)
    | omfattet_af_stk1() -> input.anvendelse == Al15TjenerUdelukkendeBygning && input.bygning_resultat.omfattet_af_par14 && input.har_kunnet_afskrives_efter_stk2_eller_stk3 == Falskt && udelukket_efter_stk4() == Falskt
    | omfattet_af_stk2() -> omfattet_af_stk1() == Falskt && udelukkende_erhvervsmæssigt_benyttet() && udelukket_efter_stk4() == Falskt
    | omfattet_af_stk3() -> omfattet_af_stk1() == Falskt && blandet_benyttet() && udelukket_efter_stk4() == Falskt
    | behandling() -> Al15IkkeAfskrivningsberettiget
    | exception al15_installation_som_bygning behandling() -> Al15SomBygning under omfattet_af_stk1()
    | exception al15_særskilt_erhvervsinstallation behandling() -> Al15SærskiltUdelukkendeErhverv under omfattet_af_stk2()
    | exception al15_særskilt_blandet_installation behandling() -> Al15SærskiltBlandet under omfattet_af_stk3()
    | omfattet_af_par15() -> omfattet_af_stk1() || omfattet_af_stk2() || omfattet_af_stk3()
    | resultat() -> Afskrivningslov15Resultat(
        skatteyder = input.skatteyder,
        anvendelse = input.anvendelse,
        behandling = behandling(),
        benyttelse = input.benyttelse,
        omfattet_af_stk1 = omfattet_af_stk1(),
        omfattet_af_stk2 = omfattet_af_stk2(),
        omfattet_af_stk3 = omfattet_af_stk3(),
        kan_afskrives_under_et_efter_stk2 = omfattet_af_stk2() && input.flere_ved_samme_bygning_anskaffet_samme_indkomstår,
        blandet_benyttet = omfattet_af_stk3(),
        udelukket_efter_stk4 = udelukket_efter_stk4(),
        omfattet_af_par15 = omfattet_af_par15()
    )
}
| afskrivningslov15_sag(input: Afskrivningslov15Input) -> Afskrivningslov15Sag(input)
| afskrivningslov15_resultat(input: Afskrivningslov15Input) -> afskrivningslov15_sag(input).resultat()
--@end:afskrivningsloven_par15--

--@label:afskrivningsloven_par16::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par16_par20_juridisk_vejledning--
----
§ 16. En bygning eller en installation anses for anskaffet i det indkomstår,
hvori bygningen eller installationen erhverves eller opføres og benyttes
erhvervsmæssigt. Udgift til ombygning og forbedring er
afskrivningsberettiget fra og med det indkomstår, hvori udgiften er afholdt,
og ombygningen eller forbedringen benyttes erhvervsmæssigt.
----

--@begin:afskrivningsloven_par16--
# AfskrivningslovKapitel3Aktiv = AlK3Bygning(resultat: Afskrivningslov14Resultat) | AlK3Installation(resultat: Afskrivningslov15Resultat)
# Afskrivningslov16Hændelse = Al16Anskaffelse | Al16OmbygningEllerForbedring
# Afskrivningslov16Input(aktiv: AfskrivningslovKapitel3Aktiv, hændelse: Afskrivningslov16Hændelse, indkomstår: Heltal, erhvervet_eller_opført: Boolsk, udgift_afholdt: Boolsk, benyttes_erhvervsmæssigt: Boolsk)
# Afskrivningslov16Resultat(aktiv: AfskrivningslovKapitel3Aktiv, skatteyder: AfskrivningslovSkatteyder, hændelse: Afskrivningslov16Hændelse, indkomstår: Heltal, aktiv_omfattet_af_kapitel3: Boolsk, erhvervet_eller_opført: Boolsk, udgift_afholdt: Boolsk, benyttes_erhvervsmæssigt: Boolsk, betingelser_opfyldt: Boolsk, afskrivningsberettiget_fra_indkomstår: Heltal)

| afskrivningslov_kapitel3_aktiv_skatteyder(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Bygning(resultat) -> resultat.skatteyder
    | AlK3Installation(resultat) -> resultat.skatteyder
}
| afskrivningslov_kapitel3_aktiv_omfattet(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Bygning(resultat) -> resultat.omfattet_af_par14
    | AlK3Installation(resultat) -> resultat.omfattet_af_par15
}
| afskrivningslov_kapitel3_aktiv_er_blandet_installation(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Installation(resultat) -> resultat.omfattet_af_stk3
    | _ -> Falskt
}
| afskrivningslov_kapitel3_aktiv_benyttelse(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Installation(resultat) -> resultat.benyttelse
    | AlK3Bygning(_) -> AfskrivningslovBenyttelse(erhvervsmæssig_benyttelse_enheder = 1, samlet_benyttelse_enheder = 1)
}

# Afskrivningslov16Sag(input: Afskrivningslov16Input) {
    | aktiv_omfattet_af_kapitel3() -> afskrivningslov_kapitel3_aktiv_omfattet(input.aktiv)
    | betingelser_opfyldt() -> match input.hændelse {
        | Al16Anskaffelse -> aktiv_omfattet_af_kapitel3() && input.erhvervet_eller_opført && input.benyttes_erhvervsmæssigt
        | Al16OmbygningEllerForbedring -> aktiv_omfattet_af_kapitel3() && input.udgift_afholdt && input.benyttes_erhvervsmæssigt
    }
    | afskrivningsberettiget_fra_indkomstår() -> 0
    | exception al16_betingelser_fastlægger_første_år afskrivningsberettiget_fra_indkomstår() -> input.indkomstår under betingelser_opfyldt()
    | resultat() -> Afskrivningslov16Resultat(
        aktiv = input.aktiv,
        skatteyder = afskrivningslov_kapitel3_aktiv_skatteyder(input.aktiv),
        hændelse = input.hændelse,
        indkomstår = input.indkomstår,
        aktiv_omfattet_af_kapitel3 = aktiv_omfattet_af_kapitel3(),
        erhvervet_eller_opført = input.erhvervet_eller_opført,
        udgift_afholdt = input.udgift_afholdt,
        benyttes_erhvervsmæssigt = input.benyttes_erhvervsmæssigt,
        betingelser_opfyldt = betingelser_opfyldt(),
        afskrivningsberettiget_fra_indkomstår = afskrivningsberettiget_fra_indkomstår()
    )
}
| afskrivningslov16_sag(input: Afskrivningslov16Input) -> Afskrivningslov16Sag(input)
| afskrivningslov16_resultat(input: Afskrivningslov16Input) -> afskrivningslov16_sag(input).resultat()
--@end:afskrivningsloven_par16--

--@label:afskrivningsloven_par17::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par16_par20_juridisk_vejledning--
----
§ 17. Afskrivning på bygninger efter § 14 og installationer efter § 15, stk. 1
og 2, kan fra og med anskaffelsesåret foretages med indtil 3 pct. årligt af
anskaffelsessummen, jf. dog 3. pkt. Afskrivning på installationer omfattet af
§ 15, stk. 3, beregnes med indtil 3 pct. af anskaffelsessummen, jf. dog 3. pkt.
Afskrivning efter 1. og 2. pkt. på bygninger og installationer, der er erhvervet
før den 1. januar 2023, kan foretages med indtil 4 pct. årligt af
anskaffelsessummen.

Stk. 2. Den i stk. 1, 1. og 2. pkt., nævnte afskrivningssats forhøjes, når det
må antages, at bygningen eller installationen er udsat for en sådan fysisk
forringelse, at den trods normal vedligeholdelse vil have mistet sin værdi
senest 33 år efter opførelsen. Afskrivningssatsen forhøjes til en sats, der
svarer til, at bygningen eller installationen afskrives med lige store årlige
beløb over den antagne levetid.

Stk. 3. Den i stk. 1, 3. pkt., nævnte afskrivningssats forhøjes, når det må
antages, at bygningen eller installationen er udsat for en sådan fysisk
forringelse, at den trods normal vedligeholdelse vil have mistet sin værdi
senest 25 år efter opførelsen. Afskrivningssatsen forhøjes til en sats lig med
summen af 3 pct. og en sats, der svarer til, at bygningen eller installationen
afskrives med lige store årlige beløb over den antagne levetid.

Stk. 4. Såfremt en bygning, hvorpå der kan afskrives efter § 14, stk. 3,
knytter sig til en bygning, for hvilken afskrivningssatsen forhøjes efter stk. 2
eller 3, gælder den forhøjede sats efter stk. 2 også for den tilknyttede
bygning, jf. dog stk. 5.

Stk. 5. Såfremt en bygning, der er erhvervet før den 1. januar 2023, og hvorpå
der kan afskrives efter § 14, stk. 3, knytter sig til en bygning, for hvilken
afskrivningssatsen forhøjes efter bestemmelsen, gælder den forhøjede sats også
for den tilknyttede bygning.

Stk. 6. Ved afståelse af en ideel andel af en bygning eller installation, hvor
den skattepligtige ejer en ideel andel, der er erhvervet før den 1. januar 2023,
og en ideel andel, der er erhvervet den 1. januar 2023 eller senere, anses den
først erhvervede ideelle andel for den først afståede.
----

--@begin:afskrivningsloven_par17--
# Afskrivningslov17Valg = Al17IngenAfskrivning | Al17ValgtAfskrivning(beregnet_afskrivning_før_erhvervsandel_kroner: Heltal)
# Afskrivningslov17AccessoriskHovedbygning = Al17IngenAccessoriskHovedbygning | Al17HovedbygningEfterStk2(anskaffelsesår: Heltal, antaget_levetid_år: Heltal) | Al17HovedbygningEfterStk3(anskaffelsesår: Heltal, antaget_levetid_år: Heltal)
# Afskrivningslov17Årsopgørelse(indkomstår: Heltal, beregnet_afskrivning_før_erhvervsandel_kroner: Heltal, fradraget_afskrivning_kroner: Heltal)
# Afskrivningslov17Input(indkomstår: Heltal, par16_resultat: Afskrivningslov16Resultat, par20_resultat: Afskrivningslov20Resultat, afskrivningsgrundlag_kroner: Heltal, tidligere_årsopgørelser: List(Afskrivningslov17Årsopgørelse), antaget_levetid_år: Heltal, accessorisk_hovedbygning: Afskrivningslov17AccessoriskHovedbygning, valg: Afskrivningslov17Valg)
# Afskrivningslov17Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktiv: AfskrivningslovKapitel3Aktiv, anskaffelsesår: Heltal, afskrivningsgrundlag_kroner: Heltal, aktiv_omfattet: Boolsk, kan_afskrives_i_indkomståret: Boolsk, forhøjet_sats_gælder: Boolsk, højeste_sats_basispoint: Heltal, højeste_afskrivning_før_erhvervsandel_kroner: Heltal, valg: Afskrivningslov17Valg, valg_gyldigt: Boolsk, beregnet_afskrivning_før_erhvervsandel_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, samlede_beregnede_afskrivninger_kroner: Heltal, samlede_fradragne_afskrivninger_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal, årsopgørelse: Afskrivningslov17Årsopgørelse)
# Afskrivningslov17IdeelAndelResultat(ejer_andel_erhvervet_før_2023: Boolsk, ejer_andel_erhvervet_2023_eller_senere: Boolsk, afstår_ideel_andel: Boolsk, først_erhvervede_andel_anses_først_afstået: Boolsk)

| afskrivningslov17_årsopgørelse_gyldig(årsopgørelse: Afskrivningslov17Årsopgørelse) -> årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner >= 0 && årsopgørelse.fradraget_afskrivning_kroner >= 0 && årsopgørelse.fradraget_afskrivning_kroner <= årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner
| afskrivningslov17_tidligere_beregnede_afskrivninger_kroner(årsopgørelser: List(Afskrivningslov17Årsopgørelse)) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner)
| afskrivningslov17_tidligere_fradragne_afskrivninger_kroner(årsopgørelser: List(Afskrivningslov17Årsopgørelse)) -> foldl(årsopgørelser, 0, |sum, årsopgørelse| sum + årsopgørelse.fradraget_afskrivning_kroner)
| afskrivningslov17_valgt_beregnet_afskrivning_kroner(valg: Afskrivningslov17Valg) -> match valg {
    | Al17IngenAfskrivning -> 0
    | Al17ValgtAfskrivning(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
}
| afskrivningslov17_accessorisk_hovedbygnings_anskaffelsesår(hovedbygning: Afskrivningslov17AccessoriskHovedbygning) -> match hovedbygning {
    | Al17HovedbygningEfterStk2(anskaffelsesår, _) -> anskaffelsesår
    | Al17HovedbygningEfterStk3(anskaffelsesår, _) -> anskaffelsesår
    | Al17IngenAccessoriskHovedbygning -> 0
}
| afskrivningslov17_accessorisk_hovedbygnings_levetid_år(hovedbygning: Afskrivningslov17AccessoriskHovedbygning) -> match hovedbygning {
    | Al17HovedbygningEfterStk2(_, antaget_levetid_år) -> antaget_levetid_år
    | Al17HovedbygningEfterStk3(_, antaget_levetid_år) -> antaget_levetid_år
    | Al17IngenAccessoriskHovedbygning -> 0
}
| afskrivningslov17_aktiv_er_accessorisk_bygning(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Bygning(resultat) -> resultat.afskrivningsberettiget_efter_stk3
    | _ -> Falskt
}

# Afskrivningslov17Sag(input: Afskrivningslov17Input) {
    | afskrivningsgrundlag_kroner() -> penge_positivt_beløb(input.afskrivningsgrundlag_kroner)
    | anskaffelsesår() -> input.par16_resultat.afskrivningsberettiget_fra_indkomstår
    | erhvervet_før_2023() -> anskaffelsesår() > 0 && anskaffelsesår() < 2023
    | tidligere_historik_gyldig() -> all(input.tidligere_årsopgørelser, |årsopgørelse: Afskrivningslov17Årsopgørelse| afskrivningslov17_årsopgørelse_gyldig(årsopgørelse)) && afskrivningslov17_tidligere_beregnede_afskrivninger_kroner(input.tidligere_årsopgørelser) <= afskrivningsgrundlag_kroner()
    | egen_levetid_udløser_forhøjelse() -> hvis erhvervet_før_2023() { input.antaget_levetid_år > 0 && input.antaget_levetid_år <= 25 } ellers { input.antaget_levetid_år > 0 && input.antaget_levetid_år <= 33 }
    | accessorisk_forhøjelse_gælder() -> afskrivningslov17_aktiv_er_accessorisk_bygning(input.par16_resultat.aktiv) && afskrivningslov17_accessorisk_hovedbygnings_levetid_år(input.accessorisk_hovedbygning) > 0 && input.accessorisk_hovedbygning != Al17IngenAccessoriskHovedbygning
    | forhøjet_sats_gælder() -> egen_levetid_udløser_forhøjelse() || accessorisk_forhøjelse_gælder()
    | forhøjelseslevetid_år() -> 0
    | exception al17_egen_levetid_forhøjer_sats forhøjelseslevetid_år() -> input.antaget_levetid_år under egen_levetid_udløser_forhøjelse()
    | exception al17_accessorisk_hovedbygnings_levetid forhøjelseslevetid_år() -> afskrivningslov17_accessorisk_hovedbygnings_levetid_år(input.accessorisk_hovedbygning) under egen_levetid_udløser_forhøjelse() == Falskt && accessorisk_forhøjelse_gælder()
    | gammel_stk3_forhøjelse_gælder() -> erhvervet_før_2023() && (egen_levetid_udløser_forhøjelse() || (input.accessorisk_hovedbygning != Al17IngenAccessoriskHovedbygning && afskrivningslov17_accessorisk_hovedbygnings_anskaffelsesår(input.accessorisk_hovedbygning) < 2023 && match input.accessorisk_hovedbygning { | Al17HovedbygningEfterStk3(_, _) -> Sandt | _ -> Falskt }))
    | ordinær_højeste_sats_basispoint() -> hvis erhvervet_før_2023() { 400 } ellers { 300 }
    | højeste_sats_basispoint() -> ordinær_højeste_sats_basispoint()
    | exception al17_stk2_lige_store_årlige_beløb højeste_sats_basispoint() -> 10000 / forhøjelseslevetid_år() under forhøjet_sats_gælder() && gammel_stk3_forhøjelse_gælder() == Falskt
    | exception al17_stk3_tre_procent_plus_levetid højeste_sats_basispoint() -> 300 + 10000 / forhøjelseslevetid_år() under forhøjet_sats_gælder() && gammel_stk3_forhøjelse_gælder()
    | højeste_før_historik_kroner() -> penge_beløb_gange_basispoint_kroner(afskrivningsgrundlag_kroner(), ordinær_højeste_sats_basispoint())
    | exception al17_stk2_højeste_beløb højeste_før_historik_kroner() -> afskrivningsgrundlag_kroner() / forhøjelseslevetid_år() under forhøjet_sats_gælder() && gammel_stk3_forhøjelse_gælder() == Falskt
    | exception al17_stk3_højeste_beløb højeste_før_historik_kroner() -> penge_beløb_gange_basispoint_kroner(afskrivningsgrundlag_kroner(), 300) + afskrivningsgrundlag_kroner() / forhøjelseslevetid_år() under forhøjet_sats_gælder() && gammel_stk3_forhøjelse_gælder()
    | resterende_før_året_kroner() -> penge_positivt_beløb(afskrivningsgrundlag_kroner() - afskrivningslov17_tidligere_beregnede_afskrivninger_kroner(input.tidligere_årsopgørelser))
    | højeste_afskrivning_kroner() -> penge_mindste_beløb(højeste_før_historik_kroner(), resterende_før_året_kroner())
    | aktiv_omfattet() -> input.par16_resultat.betingelser_opfyldt && afskrivningsgrundlag_kroner() > 0 && tidligere_historik_gyldig()
    | kan_afskrives_i_indkomståret() -> aktiv_omfattet() && input.indkomstår >= anskaffelsesår() && input.par20_resultat.indkomstår == input.indkomstår && input.par20_resultat.aktiv == input.par16_resultat.aktiv && input.par20_resultat.kan_afskrives_i_indkomståret
    | valg_gyldigt() -> match input.valg {
        | Al17IngenAfskrivning -> kan_afskrives_i_indkomståret()
        | Al17ValgtAfskrivning(beløb_kroner) -> kan_afskrives_i_indkomståret() && beløb_kroner >= 0 && beløb_kroner <= højeste_afskrivning_kroner()
    }
    | beregnet_afskrivning_kroner() -> 0
    | exception al17_gyldigt_valgt_afskrivningsbeløb beregnet_afskrivning_kroner() -> afskrivningslov17_valgt_beregnet_afskrivning_kroner(input.valg) under valg_gyldigt()
    | fradrag_kroner() -> hvis afskrivningslov_kapitel3_aktiv_er_blandet_installation(input.par16_resultat.aktiv) { afskrivningslov_beløb_efter_benyttelse_kroner(beregnet_afskrivning_kroner(), afskrivningslov_kapitel3_aktiv_benyttelse(input.par16_resultat.aktiv)) } ellers { beregnet_afskrivning_kroner() }
    | samlede_beregnede_afskrivninger_kroner() -> afskrivningslov17_tidligere_beregnede_afskrivninger_kroner(input.tidligere_årsopgørelser) + beregnet_afskrivning_kroner()
    | samlede_fradragne_afskrivninger_kroner() -> afskrivningslov17_tidligere_fradragne_afskrivninger_kroner(input.tidligere_årsopgørelser) + fradrag_kroner()
    | årsopgørelse() -> Afskrivningslov17Årsopgørelse(
        indkomstår = input.indkomstår,
        beregnet_afskrivning_før_erhvervsandel_kroner = beregnet_afskrivning_kroner(),
        fradraget_afskrivning_kroner = fradrag_kroner()
    )
    | resultat() -> Afskrivningslov17Resultat(
        indkomstår = input.indkomstår,
        skatteyder = input.par16_resultat.skatteyder,
        aktiv = input.par16_resultat.aktiv,
        anskaffelsesår = anskaffelsesår(),
        afskrivningsgrundlag_kroner = afskrivningsgrundlag_kroner(),
        aktiv_omfattet = aktiv_omfattet(),
        kan_afskrives_i_indkomståret = kan_afskrives_i_indkomståret(),
        forhøjet_sats_gælder = forhøjet_sats_gælder(),
        højeste_sats_basispoint = højeste_sats_basispoint(),
        højeste_afskrivning_før_erhvervsandel_kroner = højeste_afskrivning_kroner(),
        valg = input.valg,
        valg_gyldigt = valg_gyldigt(),
        beregnet_afskrivning_før_erhvervsandel_kroner = beregnet_afskrivning_kroner(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_kroner(),
        samlede_beregnede_afskrivninger_kroner = samlede_beregnede_afskrivninger_kroner(),
        samlede_fradragne_afskrivninger_kroner = samlede_fradragne_afskrivninger_kroner(),
        resterende_afskrivningsgrundlag_kroner = penge_positivt_beløb(afskrivningsgrundlag_kroner() - samlede_beregnede_afskrivninger_kroner()),
        årsopgørelse = årsopgørelse()
    )
}
| afskrivningslov17_sag(input: Afskrivningslov17Input) -> Afskrivningslov17Sag(input)
| afskrivningslov17_resultat(input: Afskrivningslov17Input) -> afskrivningslov17_sag(input).resultat()
| afskrivningslov17_ideel_andel_resultat(ejer_andel_erhvervet_før_2023: Boolsk, ejer_andel_erhvervet_2023_eller_senere: Boolsk, afstår_ideel_andel: Boolsk) -> Afskrivningslov17IdeelAndelResultat(
    ejer_andel_erhvervet_før_2023 = ejer_andel_erhvervet_før_2023,
    ejer_andel_erhvervet_2023_eller_senere = ejer_andel_erhvervet_2023_eller_senere,
    afstår_ideel_andel = afstår_ideel_andel,
    først_erhvervede_andel_anses_først_afstået = ejer_andel_erhvervet_før_2023 && ejer_andel_erhvervet_2023_eller_senere && afstår_ideel_andel
)
--@end:afskrivningsloven_par17--

--@label:afskrivningsloven_par18::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par16_par20_juridisk_vejledning--
----
§ 18. Udgifter til ombygning eller forbedring afskrives særskilt, jf. § 17.
Såfremt udgifterne er afholdt i samme indkomstår, kan afskrivning dog foretages
under ét.

Stk. 2. Udgifter til ombygning eller forbedring af afskrivningsberettigede
bygninger og installationer omfattet af § ‍15, stk. 2 eller 3, kan i stedet
fradrages straks, i det omfang indkomstårets udgift til vedligeholdelse,
ombygning og forbedring ikke overstiger 5 pct. af afskrivningsgrundlaget for den
bygning eller installation, som udgifterne vedrører, for året før det
indkomstår, hvori udgiften kan fradrages. Ved opgørelsen af, om udgifterne
overstiger 5 pct. af afskrivningsgrundlaget, medregnes først udgift til
vedligeholdelse. Udgifter til tilbygning behandles kun som ombygnings- eller
forbedringsudgifter, når tilbygningen udgør en naturlig del af den eksisterende
bygning. Ved ombygning eller forbedring af installationer omfattet af § 15,
stk. 3, fradrages alene den del af det opgjorte beløb efter 1. og 2. pkt., der
svarer til den erhvervsmæssige benyttelse i det pågældende indkomstår.

Stk. 3. Fradrag efter stk. 2 foretages i det indkomstår, hvori udgiften
afholdes, uanset om ombygningen eller forbedringen endnu ikke benyttes
erhvervsmæssigt efter § 16, 2. pkt. Fradraget kan dog ikke foretages i
indkomstår, hvori der ikke kan afskrives på bygningen eller installationen, jf.
§ 20, eller i det indkomstår, hvori bygningen eller installationen anskaffes,
jf. § 16, 1. pkt.

Stk. 4. Udgifter, der er fratrukket efter stk. 2, anses ikke som afskrivninger
og medregnes ikke til anskaffelsessummen ved opgørelsen af skattepligtig
fortjeneste eller tab efter § 21. Ved ombygning eller forbedring af
installationer omfattet af § 15, stk. 3, finder 1. pkt. anvendelse på det beløb,
der er opgjort efter stk. 2, 1. og 2. pkt.

Stk. 5. I det omfang udgift til ombygning eller forbedring modsvares af en
forsikrings- eller erstatningssum, kan udgiften ikke fradrages efter reglen i
stk. 2.
----

--@begin:afskrivningsloven_par18--
# Afskrivningslov18Fordeling = Al18Fuld | Al18BlandetInstallation(benyttelse: AfskrivningslovBenyttelse) | Al18DelvisBygningDirekte | Al18DelvisBygningFælles(afskrivningsberettiget_etageareal: Heltal, samlet_etageareal: Heltal) | Al18IkkeAfskrivningsberettigetDel
# Afskrivningslov18Valg = Al18IntetStraksfradrag | Al18ValgtStraksfradrag(beløb_før_fordeling_kroner: Heltal)
# Afskrivningslov18Input(indkomstår: Heltal, aktivets_par16_resultat: Afskrivningslov16Resultat, par20_resultat: Afskrivningslov20Resultat, afskrivningsgrundlag_forrige_indkomstår_kroner: Heltal, vedligeholdelsesudgifter_kroner: Heltal, ombygnings_og_forbedringsudgifter_kroner: Heltal, forsikrings_eller_erstatningssum_kroner: Heltal, udgiften_er_tilbygning: Boolsk, tilbygning_er_naturlig_del: Boolsk, fordeling: Afskrivningslov18Fordeling, valg: Afskrivningslov18Valg)
# Afskrivningslov18Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktiv: AfskrivningslovKapitel3Aktiv, aktivets_anskaffelsesår: Heltal, fem_procent_grænse_kroner: Heltal, vedligeholdelse_forbruger_grænse_først_kroner: Heltal, forbedringsudgift_efter_forsikring_kroner: Heltal, kan_straksfradrage: Boolsk, højeste_straksfradrag_før_fordeling_kroner: Heltal, valg: Afskrivningslov18Valg, valg_gyldigt: Boolsk, straksfradrag_før_fordeling_kroner: Heltal, straksfradrag_i_skattepligtig_indkomst_kroner: Heltal, rest_til_særskilt_afskrivning_efter_par17_kroner: Heltal, straksfradrag_anses_ikke_som_afskrivning: Boolsk, straksfradrag_medregnes_ikke_til_anskaffelsessum_efter_par21: Boolsk)

| afskrivningslov18_fordeling_gyldig(aktiv: AfskrivningslovKapitel3Aktiv, fordeling: Afskrivningslov18Fordeling) -> match fordeling {
    | Al18Fuld -> afskrivningslov_kapitel3_aktiv_er_blandet_installation(aktiv) == Falskt
    | Al18BlandetInstallation(benyttelse) -> afskrivningslov_kapitel3_aktiv_er_blandet_installation(aktiv) && afskrivningslov_benyttelse_er_blandet(benyttelse) && benyttelse == afskrivningslov_kapitel3_aktiv_benyttelse(aktiv)
    | Al18DelvisBygningDirekte -> afskrivningslov20_aktiv_behandles_som_bygning(aktiv)
    | Al18DelvisBygningFælles(afskrivningsberettiget_etageareal, samlet_etageareal) -> afskrivningslov20_aktiv_behandles_som_bygning(aktiv) && afskrivningsberettiget_etageareal > 0 && samlet_etageareal > 0 && afskrivningsberettiget_etageareal <= samlet_etageareal
    | Al18IkkeAfskrivningsberettigetDel -> Sandt
}
| afskrivningslov18_beløb_efter_fordeling_kroner(beløb_kroner: Heltal, fordeling: Afskrivningslov18Fordeling) -> match fordeling {
    | Al18Fuld -> penge_positivt_beløb(beløb_kroner)
    | Al18BlandetInstallation(benyttelse) -> afskrivningslov_beløb_efter_benyttelse_kroner(beløb_kroner, benyttelse)
    | Al18DelvisBygningDirekte -> penge_positivt_beløb(beløb_kroner)
    | Al18DelvisBygningFælles(afskrivningsberettiget_etageareal, samlet_etageareal) -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(beløb_kroner, afskrivningsberettiget_etageareal, samlet_etageareal)
    | Al18IkkeAfskrivningsberettigetDel -> 0
}
| afskrivningslov18_aktiv_kan_straksfradrages(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Bygning(resultat) -> resultat.tilknyttet_art != Al14UdgravningVejGårdspladsParkeringHegnEllerLignende
    | AlK3Installation(_) -> Sandt
}
| afskrivningslov18_valgt_straksfradrag_før_fordeling_kroner(valg: Afskrivningslov18Valg) -> match valg {
    | Al18IntetStraksfradrag -> 0
    | Al18ValgtStraksfradrag(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
}

# Afskrivningslov18Sag(input: Afskrivningslov18Input) {
    | aktivets_anskaffelsesår() -> input.aktivets_par16_resultat.afskrivningsberettiget_fra_indkomstår
    | fem_procent_grænse_kroner() -> penge_beløb_gange_basispoint_kroner(penge_positivt_beløb(input.afskrivningsgrundlag_forrige_indkomstår_kroner), 500)
    | vedligeholdelse_kroner() -> penge_positivt_beløb(input.vedligeholdelsesudgifter_kroner)
    | forbedringsudgift_efter_forsikring_kroner() -> penge_positivt_beløb(input.ombygnings_og_forbedringsudgifter_kroner - penge_positivt_beløb(input.forsikrings_eller_erstatningssum_kroner))
    | forbedringsudgift_omfattet() -> input.udgiften_er_tilbygning == Falskt || input.tilbygning_er_naturlig_del
    | resterende_fem_procent_grænse_kroner() -> penge_positivt_beløb(fem_procent_grænse_kroner() - vedligeholdelse_kroner())
    | kan_straksfradrage() -> input.aktivets_par16_resultat.aktiv_omfattet_af_kapitel3 && afskrivningslov18_aktiv_kan_straksfradrages(input.aktivets_par16_resultat.aktiv) && input.indkomstår != aktivets_anskaffelsesår() && input.par20_resultat.indkomstår == input.indkomstår && input.par20_resultat.aktiv == input.aktivets_par16_resultat.aktiv && input.par20_resultat.kan_afskrives_i_indkomståret && afskrivningslov18_fordeling_gyldig(input.aktivets_par16_resultat.aktiv, input.fordeling) && forbedringsudgift_omfattet()
    | højeste_straksfradrag_før_fordeling_kroner() -> 0
    | exception al18_fem_procent_efter_vedligeholdelse højeste_straksfradrag_før_fordeling_kroner() -> penge_mindste_beløb(forbedringsudgift_efter_forsikring_kroner(), resterende_fem_procent_grænse_kroner()) under kan_straksfradrage()
    | valg_gyldigt() -> match input.valg {
        | Al18IntetStraksfradrag -> Sandt
        | Al18ValgtStraksfradrag(beløb_kroner) -> kan_straksfradrage() && beløb_kroner >= 0 && beløb_kroner <= højeste_straksfradrag_før_fordeling_kroner()
    }
    | straksfradrag_før_fordeling_kroner() -> 0
    | exception al18_gyldigt_valgt_straksfradrag straksfradrag_før_fordeling_kroner() -> afskrivningslov18_valgt_straksfradrag_før_fordeling_kroner(input.valg) under valg_gyldigt()
    | straksfradrag_kroner() -> afskrivningslov18_beløb_efter_fordeling_kroner(straksfradrag_før_fordeling_kroner(), input.fordeling)
    | rest_før_fordeling_kroner() -> 0
    | exception al18_omfattet_forbedringsrest rest_før_fordeling_kroner() -> penge_positivt_beløb(forbedringsudgift_efter_forsikring_kroner() - straksfradrag_før_fordeling_kroner()) under input.aktivets_par16_resultat.aktiv_omfattet_af_kapitel3 && forbedringsudgift_omfattet() && afskrivningslov18_fordeling_gyldig(input.aktivets_par16_resultat.aktiv, input.fordeling)
    | rest_til_særskilt_afskrivning_kroner() -> match input.fordeling {
        | Al18BlandetInstallation(_) -> rest_før_fordeling_kroner()
        | _ -> afskrivningslov18_beløb_efter_fordeling_kroner(rest_før_fordeling_kroner(), input.fordeling)
    }
    | resultat() -> Afskrivningslov18Resultat(
        indkomstår = input.indkomstår,
        skatteyder = input.aktivets_par16_resultat.skatteyder,
        aktiv = input.aktivets_par16_resultat.aktiv,
        aktivets_anskaffelsesår = aktivets_anskaffelsesår(),
        fem_procent_grænse_kroner = fem_procent_grænse_kroner(),
        vedligeholdelse_forbruger_grænse_først_kroner = penge_mindste_beløb(vedligeholdelse_kroner(), fem_procent_grænse_kroner()),
        forbedringsudgift_efter_forsikring_kroner = forbedringsudgift_efter_forsikring_kroner(),
        kan_straksfradrage = kan_straksfradrage(),
        højeste_straksfradrag_før_fordeling_kroner = højeste_straksfradrag_før_fordeling_kroner(),
        valg = input.valg,
        valg_gyldigt = valg_gyldigt(),
        straksfradrag_før_fordeling_kroner = straksfradrag_før_fordeling_kroner(),
        straksfradrag_i_skattepligtig_indkomst_kroner = straksfradrag_kroner(),
        rest_til_særskilt_afskrivning_efter_par17_kroner = rest_til_særskilt_afskrivning_kroner(),
        straksfradrag_anses_ikke_som_afskrivning = straksfradrag_før_fordeling_kroner() > 0,
        straksfradrag_medregnes_ikke_til_anskaffelsessum_efter_par21 = straksfradrag_før_fordeling_kroner() > 0
    )
}
| afskrivningslov18_sag(input: Afskrivningslov18Input) -> Afskrivningslov18Sag(input)
| afskrivningslov18_resultat(input: Afskrivningslov18Input) -> afskrivningslov18_sag(input).resultat()
--@end:afskrivningsloven_par18--

--@label:afskrivningsloven_par19::source:afskrivningsloven_lbk1222::basis_guidance:afskrivningsloven_bygningsgrundlag_juridisk_vejledning::interval_guidance:afskrivningsloven_par16_par20_juridisk_vejledning--
----
§ 19. Anvendes kun en del af en bygning til formål, der berettiger til
afskrivning efter § 14, kan der kun afskrives på den del af anskaffelsessummen,
der forholdsmæssigt svarer til den nævnte bygningsdels etageareal. Ved en
forøgelse af den del af den samlede anskaffelsessum, der berettiger til
afskrivning efter 1. pkt., udgør den del af anskaffelsessummen, der før
ændringen var afskrivningsberettiget, og den del af anskaffelsessummen, hvormed
den afskrivningsberettigede del af anskaffelsessummen forøges, særskilte
afskrivningsgrundlag. Ved en reduktion af den del af den samlede
anskaffelsessum, der berettiger til afskrivning efter 1. pkt., udgør den
reducerede afskrivningsberettigede del af anskaffelsessummen et særskilt
afskrivningsgrundlag. Den del af anskaffelsessummen, som der herefter ikke kan
afskrives på, udgør et særskilt grundlag. Summen af de anvendte
afskrivningsprocenter for hver enkelt særskilte afskrivningsgrundlag kan ikke
overstige 100.

Stk. 2. Udgifter til ombygning og forbedring kan afskrives efter § 18, når
udgiften direkte vedrører den afskrivningsberettigede del af bygningen.

Stk. 3. Udgifter til ombygning og forbedring, som ikke direkte kan henføres til
den afskrivningsberettigede eller den ikkeafskrivningsberettigede del af
bygningen, kan afskrives efter § 18 efter forholdet mellem den
afskrivningsberettigede bygningsdels etageareal og bygningens samlede
etageareal.

Stk. 4. Anvendes under 25 pct. af bygningens etageareal til
afskrivningsberettiget formål, herunder afskrivning efter § 14, stk. 3, kan der
dog kun afskrives på bygningen, såfremt det nævnte etageareal udgør mindst 300
kvadratmeter.

Stk. 5. Er den del af bygningens samlede anskaffelsessum, der kan henføres til
bolig, fastsat efter § 45, indgår denne del ikke i den del af
anskaffelsessummen, der berettiger til afskrivning efter stk. 1. I andre
tilfælde indgår i anskaffelsessummen efter stk. 1 ikke den del, der kan henføres
til ejerboligen. Tilsvarende medregnes etagearealet af denne bygningsdel ikke
efter stk. 1.
----

--@label:afskrivningsloven_par19_ikrafttraedelsesnote::source:afskrivningsloven_lbk1222--
----
1) § 19, stk. 5, 2. pkt., har i denne affattelse virkning for bygninger, der
anskaffes den 1. januar 2026 eller senere, jf. § 17, stk. 8, i lov nr. 562 af
27. maj 2025.
----

--@begin:afskrivningsloven_par19--
# Afskrivningslov19Interval(fra_kroner: Heltal, til_kroner: Heltal, afskrivningsberettiget_forrige_indkomstår: Boolsk, afskrivningsberettiget_i_indkomståret: Boolsk, afskrivningsberettigede_indkomstår: Heltal, anvendt_afskrivningsprocent_basispoint: Heltal, maksimalt_mulig_afskrivningsprocent_basispoint: Heltal)
# Afskrivningslov19IntervalKontrol(næste_fra_kroner: Heltal, gyldig: Boolsk)
# Afskrivningslov19Historik(skatteyder: AfskrivningslovSkatteyder, samlet_anskaffelsessum_kroner: Heltal, afskrivningsberettigede_indkomstår_for_bygningen: Heltal, intervaller: List(Afskrivningslov19Interval), gyldig: Boolsk)
# Afskrivningslov19Input(bygning_resultat: Afskrivningslov14Resultat, samlet_anskaffelsessum_kroner: Heltal, samlet_etageareal_kvadratmeter: Heltal, afskrivningsberettiget_etageareal_kvadratmeter: Heltal, ejerbolig_anskaffelsessum_kroner: Heltal, ejerbolig_etageareal_kvadratmeter: Heltal, tidligere_afskrivningsberettigede_indkomstår_for_bygningen: Heltal, tidligere_intervaller: List(Afskrivningslov19Interval))
# Afskrivningslov19Resultat(skatteyder: AfskrivningslovSkatteyder, omfattet_af_par19: Boolsk, afskrivning_tilladt_i_indkomståret: Boolsk, afskrivningsberettigede_indkomstår_for_bygningen: Heltal, etageareal_efter_ejerbolig_kvadratmeter: Heltal, afskrivningsberettiget_etageareal_kvadratmeter: Heltal, afskrivningsberettiget_etageareal_basispoint: Heltal, under_25_procent: Boolsk, mindst_300_kvadratmeter_opfyldt: Boolsk, anskaffelsessum_efter_ejerbolig_kroner: Heltal, aktuelt_afskrivningsberettiget_grundlag_kroner: Heltal, tidligere_afskrivningsberettiget_grundlag_kroner: Heltal, videreført_tidligere_grundlag_kroner: Heltal, forøgelse_som_særskilt_grundlag_kroner: Heltal, reduktion_fra_tidligere_grundlag_kroner: Heltal, ikkeafskrivningsberettiget_særskilt_grundlag_kroner: Heltal, intervaller_gyldige: Boolsk, intervaller: List(Afskrivningslov19Interval), samlede_foretagne_afskrivninger_kroner: Heltal, samlede_maksimalt_mulige_afskrivninger_kroner: Heltal)

| afskrivningslov19_interval_beløb_kroner(interval: Afskrivningslov19Interval) -> penge_positivt_beløb(interval.til_kroner - interval.fra_kroner)
| afskrivningslov19_interval_gyldigt(interval: Afskrivningslov19Interval, afskrivningsberettigede_indkomstår_for_bygningen: Heltal) -> interval.fra_kroner >= 0 && interval.til_kroner > interval.fra_kroner && interval.afskrivningsberettigede_indkomstår >= 0 && interval.afskrivningsberettigede_indkomstår <= afskrivningsberettigede_indkomstår_for_bygningen && interval.anvendt_afskrivningsprocent_basispoint >= 0 && interval.anvendt_afskrivningsprocent_basispoint <= interval.maksimalt_mulig_afskrivningsprocent_basispoint && interval.maksimalt_mulig_afskrivningsprocent_basispoint <= 10000
| afskrivningslov19_intervaller_gyldige(intervaller: List(Afskrivningslov19Interval), samlet_anskaffelsessum_kroner: Heltal, afskrivningsberettigede_indkomstår_for_bygningen: Heltal) -> hvis length(intervaller) == 0 { afskrivningsberettigede_indkomstår_for_bygningen == 0 } ellers {
    = kontrol = foldl(intervaller, Afskrivningslov19IntervalKontrol(næste_fra_kroner = 0, gyldig = Sandt), |tilstand: Afskrivningslov19IntervalKontrol, interval: Afskrivningslov19Interval| Afskrivningslov19IntervalKontrol(
        næste_fra_kroner = interval.til_kroner,
        gyldig = tilstand.gyldig && afskrivningslov19_interval_gyldigt(interval, afskrivningsberettigede_indkomstår_for_bygningen) && interval.fra_kroner == tilstand.næste_fra_kroner
    ))
    kontrol.gyldig && kontrol.næste_fra_kroner == samlet_anskaffelsessum_kroner
}
| afskrivningslov19_første_intervaller(samlet_anskaffelsessum_kroner: Heltal, afskrivningsberettiget_grænse_kroner: Heltal) -> hvis samlet_anskaffelsessum_kroner <= 0 { [] } ellers hvis afskrivningsberettiget_grænse_kroner <= 0 {
    [Afskrivningslov19Interval(fra_kroner = 0, til_kroner = samlet_anskaffelsessum_kroner, afskrivningsberettiget_forrige_indkomstår = Falskt, afskrivningsberettiget_i_indkomståret = Falskt, afskrivningsberettigede_indkomstår = 0, anvendt_afskrivningsprocent_basispoint = 0, maksimalt_mulig_afskrivningsprocent_basispoint = 0)]
} ellers hvis afskrivningsberettiget_grænse_kroner >= samlet_anskaffelsessum_kroner {
    [Afskrivningslov19Interval(fra_kroner = 0, til_kroner = samlet_anskaffelsessum_kroner, afskrivningsberettiget_forrige_indkomstår = Falskt, afskrivningsberettiget_i_indkomståret = Sandt, afskrivningsberettigede_indkomstår = 1, anvendt_afskrivningsprocent_basispoint = 0, maksimalt_mulig_afskrivningsprocent_basispoint = 0)]
} ellers {
    [
        Afskrivningslov19Interval(fra_kroner = 0, til_kroner = afskrivningsberettiget_grænse_kroner, afskrivningsberettiget_forrige_indkomstår = Falskt, afskrivningsberettiget_i_indkomståret = Sandt, afskrivningsberettigede_indkomstår = 1, anvendt_afskrivningsprocent_basispoint = 0, maksimalt_mulig_afskrivningsprocent_basispoint = 0),
        Afskrivningslov19Interval(fra_kroner = afskrivningsberettiget_grænse_kroner, til_kroner = samlet_anskaffelsessum_kroner, afskrivningsberettiget_forrige_indkomstår = Falskt, afskrivningsberettiget_i_indkomståret = Falskt, afskrivningsberettigede_indkomstår = 0, anvendt_afskrivningsprocent_basispoint = 0, maksimalt_mulig_afskrivningsprocent_basispoint = 0)
    ]
}
| afskrivningslov19_interval_ved_ny_grænse(interval: Afskrivningslov19Interval, afskrivningsberettiget_grænse_kroner: Heltal) -> hvis interval.til_kroner <= afskrivningsberettiget_grænse_kroner {
    [Afskrivningslov19Interval(fra_kroner = interval.fra_kroner, til_kroner = interval.til_kroner, afskrivningsberettiget_forrige_indkomstår = interval.afskrivningsberettiget_i_indkomståret, afskrivningsberettiget_i_indkomståret = Sandt, afskrivningsberettigede_indkomstår = interval.afskrivningsberettigede_indkomstår + 1, anvendt_afskrivningsprocent_basispoint = interval.anvendt_afskrivningsprocent_basispoint, maksimalt_mulig_afskrivningsprocent_basispoint = interval.maksimalt_mulig_afskrivningsprocent_basispoint)]
} ellers hvis interval.fra_kroner >= afskrivningsberettiget_grænse_kroner {
    [Afskrivningslov19Interval(fra_kroner = interval.fra_kroner, til_kroner = interval.til_kroner, afskrivningsberettiget_forrige_indkomstår = interval.afskrivningsberettiget_i_indkomståret, afskrivningsberettiget_i_indkomståret = Falskt, afskrivningsberettigede_indkomstår = interval.afskrivningsberettigede_indkomstår, anvendt_afskrivningsprocent_basispoint = interval.anvendt_afskrivningsprocent_basispoint, maksimalt_mulig_afskrivningsprocent_basispoint = interval.maksimalt_mulig_afskrivningsprocent_basispoint)]
} ellers {
    [
        Afskrivningslov19Interval(fra_kroner = interval.fra_kroner, til_kroner = afskrivningsberettiget_grænse_kroner, afskrivningsberettiget_forrige_indkomstår = interval.afskrivningsberettiget_i_indkomståret, afskrivningsberettiget_i_indkomståret = Sandt, afskrivningsberettigede_indkomstår = interval.afskrivningsberettigede_indkomstår + 1, anvendt_afskrivningsprocent_basispoint = interval.anvendt_afskrivningsprocent_basispoint, maksimalt_mulig_afskrivningsprocent_basispoint = interval.maksimalt_mulig_afskrivningsprocent_basispoint),
        Afskrivningslov19Interval(fra_kroner = afskrivningsberettiget_grænse_kroner, til_kroner = interval.til_kroner, afskrivningsberettiget_forrige_indkomstår = interval.afskrivningsberettiget_i_indkomståret, afskrivningsberettiget_i_indkomståret = Falskt, afskrivningsberettigede_indkomstår = interval.afskrivningsberettigede_indkomstår, anvendt_afskrivningsprocent_basispoint = interval.anvendt_afskrivningsprocent_basispoint, maksimalt_mulig_afskrivningsprocent_basispoint = interval.maksimalt_mulig_afskrivningsprocent_basispoint)
    ]
}
| afskrivningslov19_intervaller_ved_ny_grænse(tidligere_intervaller: List(Afskrivningslov19Interval), samlet_anskaffelsessum_kroner: Heltal, afskrivningsberettiget_grænse_kroner: Heltal) -> hvis length(tidligere_intervaller) == 0 { afskrivningslov19_første_intervaller(samlet_anskaffelsessum_kroner, afskrivningsberettiget_grænse_kroner) } ellers { flat_map(tidligere_intervaller, |interval: Afskrivningslov19Interval| afskrivningslov19_interval_ved_ny_grænse(interval, afskrivningsberettiget_grænse_kroner)) }
| afskrivningslov19_intervalgrundlag_kroner(intervaller: List(Afskrivningslov19Interval), medregn: Afskrivningslov19Interval -> Boolsk) -> foldl(intervaller, 0, |sum: Heltal, interval: Afskrivningslov19Interval| sum + hvis medregn(interval) { afskrivningslov19_interval_beløb_kroner(interval) } ellers { 0 })
| afskrivningslov19_foretagne_afskrivninger_kroner(intervaller: List(Afskrivningslov19Interval)) -> foldl(intervaller, 0, |sum: Heltal, interval: Afskrivningslov19Interval| sum + penge_beløb_gange_basispoint_kroner(afskrivningslov19_interval_beløb_kroner(interval), interval.anvendt_afskrivningsprocent_basispoint))
| afskrivningslov19_maksimalt_mulige_afskrivninger_kroner(intervaller: List(Afskrivningslov19Interval)) -> foldl(intervaller, 0, |sum: Heltal, interval: Afskrivningslov19Interval| sum + penge_beløb_gange_basispoint_kroner(afskrivningslov19_interval_beløb_kroner(interval), interval.maksimalt_mulig_afskrivningsprocent_basispoint))
| afskrivningslov19_historik(skatteyder: AfskrivningslovSkatteyder, samlet_anskaffelsessum_kroner: Heltal, afskrivningsberettigede_indkomstår_for_bygningen: Heltal, intervaller: List(Afskrivningslov19Interval)) -> Afskrivningslov19Historik(
    skatteyder = skatteyder,
    samlet_anskaffelsessum_kroner = penge_positivt_beløb(samlet_anskaffelsessum_kroner),
    afskrivningsberettigede_indkomstår_for_bygningen = penge_positivt_beløb(afskrivningsberettigede_indkomstår_for_bygningen),
    intervaller = intervaller,
    gyldig = afskrivningslov19_intervaller_gyldige(intervaller, penge_positivt_beløb(samlet_anskaffelsessum_kroner), penge_positivt_beløb(afskrivningsberettigede_indkomstår_for_bygningen))
)

# Afskrivningslov19Sag(input: Afskrivningslov19Input) {
    | samlet_etageareal_kvadratmeter() -> penge_positivt_beløb(input.samlet_etageareal_kvadratmeter)
    | ejerbolig_etageareal_kvadratmeter() -> penge_mindste_beløb(penge_positivt_beløb(input.ejerbolig_etageareal_kvadratmeter), samlet_etageareal_kvadratmeter())
    | etageareal_efter_ejerbolig_kvadratmeter() -> penge_positivt_beløb(samlet_etageareal_kvadratmeter() - ejerbolig_etageareal_kvadratmeter())
    | afskrivningsberettiget_etageareal_kvadratmeter() -> penge_positivt_beløb(input.afskrivningsberettiget_etageareal_kvadratmeter)
    | etageareal_gyldigt() -> etageareal_efter_ejerbolig_kvadratmeter() > 0 && afskrivningsberettiget_etageareal_kvadratmeter() <= etageareal_efter_ejerbolig_kvadratmeter()
    | afskrivningsberettiget_etageareal_basispoint() -> 0
    | exception al19_gyldigt_etageareal_forhold afskrivningsberettiget_etageareal_basispoint() -> afskrivningsberettiget_etageareal_kvadratmeter() * 10000 / etageareal_efter_ejerbolig_kvadratmeter() under etageareal_gyldigt()
    | under_25_procent() -> afskrivningsberettiget_etageareal_basispoint() > 0 && afskrivningsberettiget_etageareal_basispoint() < 2500
    | mindst_300_kvadratmeter_opfyldt() -> afskrivningsberettiget_etageareal_kvadratmeter() >= 300
    | arealkrav_opfyldt() -> under_25_procent() == Falskt || mindst_300_kvadratmeter_opfyldt()
    | anskaffelsessum_efter_ejerbolig_kroner() -> penge_positivt_beløb(penge_positivt_beløb(input.samlet_anskaffelsessum_kroner) - penge_positivt_beløb(input.ejerbolig_anskaffelsessum_kroner))
    | afskrivning_tilladt_i_indkomståret() -> input.bygning_resultat.omfattet_af_par14 && etageareal_gyldigt() && afskrivningsberettiget_etageareal_kvadratmeter() > 0 && arealkrav_opfyldt()
    | afskrivningsberettigede_indkomstår_for_bygningen() -> penge_positivt_beløb(input.tidligere_afskrivningsberettigede_indkomstår_for_bygningen) + hvis afskrivning_tilladt_i_indkomståret() { 1 } ellers { 0 }
    | omfattet_af_par19() -> afskrivning_tilladt_i_indkomståret() && afskrivningsberettiget_etageareal_kvadratmeter() < etageareal_efter_ejerbolig_kvadratmeter()
    | forholdsmæssigt_grundlag_kroner() -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(anskaffelsessum_efter_ejerbolig_kroner(), afskrivningsberettiget_etageareal_kvadratmeter(), etageareal_efter_ejerbolig_kvadratmeter())
    | effektiv_intervalgrænse_kroner() -> hvis afskrivning_tilladt_i_indkomståret() { forholdsmæssigt_grundlag_kroner() } ellers { 0 }
    | tidligere_intervaller_gyldige() -> afskrivningslov19_intervaller_gyldige(input.tidligere_intervaller, anskaffelsessum_efter_ejerbolig_kroner(), penge_positivt_beløb(input.tidligere_afskrivningsberettigede_indkomstår_for_bygningen))
    | intervaller() -> hvis tidligere_intervaller_gyldige() { afskrivningslov19_intervaller_ved_ny_grænse(input.tidligere_intervaller, anskaffelsessum_efter_ejerbolig_kroner(), effektiv_intervalgrænse_kroner()) } ellers { [] }
    | intervaller_gyldige() -> tidligere_intervaller_gyldige() && afskrivningslov19_intervaller_gyldige(intervaller(), anskaffelsessum_efter_ejerbolig_kroner(), afskrivningsberettigede_indkomstår_for_bygningen())
    | aktuelt_grundlag_kroner() -> afskrivningslov19_intervalgrundlag_kroner(intervaller(), |interval: Afskrivningslov19Interval| interval.afskrivningsberettiget_i_indkomståret)
    | tidligere_grundlag_kroner() -> afskrivningslov19_intervalgrundlag_kroner(intervaller(), |interval: Afskrivningslov19Interval| interval.afskrivningsberettiget_forrige_indkomstår)
    | videreført_tidligere_grundlag_kroner() -> afskrivningslov19_intervalgrundlag_kroner(intervaller(), |interval: Afskrivningslov19Interval| interval.afskrivningsberettiget_forrige_indkomstår && interval.afskrivningsberettiget_i_indkomståret)
    | forøgelse_kroner() -> afskrivningslov19_intervalgrundlag_kroner(intervaller(), |interval: Afskrivningslov19Interval| interval.afskrivningsberettiget_forrige_indkomstår == Falskt && interval.afskrivningsberettiget_i_indkomståret)
    | reduktion_kroner() -> afskrivningslov19_intervalgrundlag_kroner(intervaller(), |interval: Afskrivningslov19Interval| interval.afskrivningsberettiget_forrige_indkomstår && interval.afskrivningsberettiget_i_indkomståret == Falskt)
    | ikkeafskrivningsberettiget_grundlag_kroner() -> afskrivningslov19_intervalgrundlag_kroner(intervaller(), |interval: Afskrivningslov19Interval| interval.afskrivningsberettiget_i_indkomståret == Falskt)
    | resultat() -> Afskrivningslov19Resultat(
        skatteyder = input.bygning_resultat.skatteyder,
        omfattet_af_par19 = omfattet_af_par19(),
        afskrivning_tilladt_i_indkomståret = afskrivning_tilladt_i_indkomståret(),
        afskrivningsberettigede_indkomstår_for_bygningen = afskrivningsberettigede_indkomstår_for_bygningen(),
        etageareal_efter_ejerbolig_kvadratmeter = etageareal_efter_ejerbolig_kvadratmeter(),
        afskrivningsberettiget_etageareal_kvadratmeter = afskrivningsberettiget_etageareal_kvadratmeter(),
        afskrivningsberettiget_etageareal_basispoint = afskrivningsberettiget_etageareal_basispoint(),
        under_25_procent = under_25_procent(),
        mindst_300_kvadratmeter_opfyldt = mindst_300_kvadratmeter_opfyldt(),
        anskaffelsessum_efter_ejerbolig_kroner = anskaffelsessum_efter_ejerbolig_kroner(),
        aktuelt_afskrivningsberettiget_grundlag_kroner = aktuelt_grundlag_kroner(),
        tidligere_afskrivningsberettiget_grundlag_kroner = tidligere_grundlag_kroner(),
        videreført_tidligere_grundlag_kroner = videreført_tidligere_grundlag_kroner(),
        forøgelse_som_særskilt_grundlag_kroner = forøgelse_kroner(),
        reduktion_fra_tidligere_grundlag_kroner = reduktion_kroner(),
        ikkeafskrivningsberettiget_særskilt_grundlag_kroner = ikkeafskrivningsberettiget_grundlag_kroner(),
        intervaller_gyldige = intervaller_gyldige(),
        intervaller = intervaller(),
        samlede_foretagne_afskrivninger_kroner = afskrivningslov19_foretagne_afskrivninger_kroner(intervaller()),
        samlede_maksimalt_mulige_afskrivninger_kroner = afskrivningslov19_maksimalt_mulige_afskrivninger_kroner(intervaller())
    )
}
| afskrivningslov19_sag(input: Afskrivningslov19Input) -> Afskrivningslov19Sag(input)
| afskrivningslov19_resultat(input: Afskrivningslov19Input) -> afskrivningslov19_sag(input).resultat()
| afskrivningslov19_historik_fra_resultat(resultat: Afskrivningslov19Resultat) -> afskrivningslov19_historik(resultat.skatteyder, resultat.anskaffelsessum_efter_ejerbolig_kroner, resultat.afskrivningsberettigede_indkomstår_for_bygningen, resultat.intervaller)
--@end:afskrivningsloven_par19--

--@label:afskrivningsloven_par20::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par16_par20_juridisk_vejledning--
----
§ 20. Afskrivning kan ikke foretages i det indkomstår, hvori bygningen sælges
eller nedrives. Det samme gælder, når en installation omfattet af § 15, stk. 2
eller 3, sælges, udskiftes eller nedtages endeligt.

Stk. 2. Ophører den skattepligtige med at anvende bygningen eller installationen
erhvervsmæssigt, kan bygningen eller installationen ikke afskrives i de
indkomstår, hvori sådan anvendelse ikke har fundet sted.
----

--@begin:afskrivningsloven_par20--
# Afskrivningslov20Begivenhed = Al20FortsatErhvervsmæssigAnvendelse | Al20BygningSolgt | Al20BygningNedrevet | Al20InstallationSolgt | Al20InstallationUdskiftet | Al20InstallationEndeligtNedtaget | Al20ErhvervsmæssigAnvendelseOphørt
# Afskrivningslov20Input(indkomstår: Heltal, aktiv: AfskrivningslovKapitel3Aktiv, begivenhed: Afskrivningslov20Begivenhed, erhvervsmæssigt_anvendt_i_indkomståret: Boolsk)
# Afskrivningslov20Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktiv: AfskrivningslovKapitel3Aktiv, begivenhed: Afskrivningslov20Begivenhed, begivenhed_matcher_aktiv: Boolsk, aktiv_omfattet_af_kapitel3: Boolsk, afskrivning_afskåret_efter_stk1: Boolsk, afskrivning_afskåret_efter_stk2: Boolsk, kan_afskrives_i_indkomståret: Boolsk)

| afskrivningslov20_aktiv_behandles_som_bygning(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Bygning(_) -> Sandt
    | AlK3Installation(resultat) -> resultat.omfattet_af_stk1
    | _ -> Falskt
}
| afskrivningslov20_aktiv_er_installation_stk2_eller_stk3(aktiv: AfskrivningslovKapitel3Aktiv) -> match aktiv {
    | AlK3Installation(resultat) -> resultat.omfattet_af_stk2 || resultat.omfattet_af_stk3
    | _ -> Falskt
}
| afskrivningslov20_begivenhed_matcher_aktiv(input: Afskrivningslov20Input) -> match input.begivenhed {
    | Al20FortsatErhvervsmæssigAnvendelse -> Sandt
    | Al20BygningSolgt -> afskrivningslov20_aktiv_behandles_som_bygning(input.aktiv)
    | Al20BygningNedrevet -> afskrivningslov20_aktiv_behandles_som_bygning(input.aktiv)
    | Al20InstallationSolgt -> afskrivningslov20_aktiv_er_installation_stk2_eller_stk3(input.aktiv)
    | Al20InstallationUdskiftet -> afskrivningslov20_aktiv_er_installation_stk2_eller_stk3(input.aktiv)
    | Al20InstallationEndeligtNedtaget -> afskrivningslov20_aktiv_er_installation_stk2_eller_stk3(input.aktiv)
    | Al20ErhvervsmæssigAnvendelseOphørt -> input.erhvervsmæssigt_anvendt_i_indkomståret == Falskt
}
| afskrivningslov20_stk1_stopbegivenhed(begivenhed: Afskrivningslov20Begivenhed) -> match begivenhed {
    | Al20BygningSolgt -> Sandt
    | Al20BygningNedrevet -> Sandt
    | Al20InstallationSolgt -> Sandt
    | Al20InstallationUdskiftet -> Sandt
    | Al20InstallationEndeligtNedtaget -> Sandt
    | _ -> Falskt
}
| afskrivningslov20_resultat(input: Afskrivningslov20Input) -> Afskrivningslov20Resultat(
    indkomstår = input.indkomstår,
    skatteyder = afskrivningslov_kapitel3_aktiv_skatteyder(input.aktiv),
    aktiv = input.aktiv,
    begivenhed = input.begivenhed,
    begivenhed_matcher_aktiv = afskrivningslov20_begivenhed_matcher_aktiv(input),
    aktiv_omfattet_af_kapitel3 = afskrivningslov_kapitel3_aktiv_omfattet(input.aktiv),
    afskrivning_afskåret_efter_stk1 = afskrivningslov20_begivenhed_matcher_aktiv(input) && afskrivningslov20_stk1_stopbegivenhed(input.begivenhed),
    afskrivning_afskåret_efter_stk2 = afskrivningslov20_begivenhed_matcher_aktiv(input) && input.erhvervsmæssigt_anvendt_i_indkomståret == Falskt,
    kan_afskrives_i_indkomståret = afskrivningslov_kapitel3_aktiv_omfattet(input.aktiv) && afskrivningslov20_begivenhed_matcher_aktiv(input) && input.begivenhed == Al20FortsatErhvervsmæssigAnvendelse && input.erhvervsmæssigt_anvendt_i_indkomståret
)
--@end:afskrivningsloven_par20--

--@label:afskrivningsloven_par21::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par21_juridisk_vejledning--
----
§ 21. Genvundne afskrivninger eller tab ved salg af bygninger eller
installationer, hvorpå der er afskrevet efter § 14 eller § 15, medregnes i den
skattepligtige indkomst for salgsåret efter reglerne i stk. 2-6, medmindre § 24
finder anvendelse.

Stk. 2. Fortjenesten opgøres for hver bygning eller installation omfattet af §
15, stk. 2, som forskellen mellem salgssummen og den nedskrevne værdi.
Sidstnævnte værdi opgøres som de afskrivningsberettigede udgifter til
anskaffelse, forbedringer m.v. med fradrag af samtlige foretagne afskrivninger,
herunder forlods afskrivninger og forskudsafskrivninger. For bygninger som nævnt
i § 19 opgøres den gennemsnitlige andel af den samlede anskaffelsessum, som de
afskrivningsberettigede udgifter til anskaffelse og forbedringer m.v. udgør. Den
gennemsnitlige andel kan dog altid fastsættes til mindst det beløb, der kunne
være afskrevet, såfremt der var foretaget maksimale afskrivninger på bygningen i
den periode, hvor bygningen har været afskrivningsberettiget. Den andel af den
samlede salgssum, der skal indgå ved opgørelsen efter 1. pkt. og stk. 3, udgøres
af den andel, der er opgjort efter 3. og 4. pkt. Som genvundne afskrivninger
medregnes højst de foretagne afskrivninger, herunder forlods afskrivninger og
forskudsafskrivninger, på det solgte aktiv.

Stk. 3. Tab opgøres for hver bygning eller installation omfattet af § 15, stk.
2, som forskellen mellem den nedskrevne værdi og salgssummen.

Stk. 4. For installationer, der er afskrevet efter § 15, stk. 3, opgøres
fortjeneste eller tab som forskellen mellem salgssummen og den nedskrevne værdi
ved salgsårets begyndelse forhøjet med eventuelle forbedringsudgifter afholdt i
salgsåret. Ved opgørelsen af den nedskrevne værdi ved salgsårets begyndelse
fragår de afskrivninger, der er beregnet for de enkelte indkomstår. Fortjeneste
eller tab medregnes ved opgørelsen af den skattepligtige indkomst for salgsåret
med en så stor del, som svarer til forholdet mellem de ved indkomstopgørelsen i
alt fratrukne afskrivninger og de samlede beregnede afskrivninger. Som genvundne
afskrivninger beskattes i alt højst de fratrukne afskrivninger.

Stk. 5. Sælges en bygning eller installation ejet af en eller flere personer til
et selskab m.v., og har sælgerne bestemmende indflydelse på selskabets handlemåde
på grund af aktiebesiddelse, anden form for ejerskab, vedtægtsbestemmelse, aftale
eller fælles ledelse, kan tab efter stk. 3 eller 4 ikke fradrages. Ved
bestemmende indflydelse på grund af aktiebesiddelse forstås ejerskab eller
rådighed over stemmerettigheder, således at der direkte eller indirekte ejes
mere end 50 pct. af aktiekapitalen eller rådes over mere end 50 pct. af
stemmerne. I øvrige tilfælde foreligger der bestemmende indflydelse ved
ejerskab, såfremt der direkte eller indirekte ejes mere end 50 pct. i ejerandel.

Stk. 6. Ved salg af en bygning, hvorpå den skattepligtige før erhvervelsen af
bygningen har afskrevet efter reglerne i § 39, medregnes til anskaffelsessummen
ved opgørelsen af fortjeneste eller tab tillige den del af de afholdte udgifter
til ombygning af lejede lokaler, der svarer til de i lejeperioden foretagne
afskrivninger. Ved opgørelsen af samtlige foretagne afskrivninger medregnes de
efter § 39, stk. 1 og 2, foretagne afskrivninger.
----

--@begin:afskrivningsloven_par21--
# Afskrivningslov21Afskrivningspost(beregnede_afskrivninger_kroner: Heltal, fratrukne_afskrivninger_kroner: Heltal)
# Afskrivningslov21Par19Delgrundlag(samlede_anskaffelses_og_forbedringsudgifter_kroner: Heltal, straksfradrag_som_ikke_medregnes_kroner: Heltal, afskrivningsberettigede_indkomstår_for_grundlaget: Heltal, intervaller: List(Afskrivningslov19Interval))
# Afskrivningslov21Grundlag = Al21OrdinærtGrundlag(samlede_anskaffelses_og_forbedringsudgifter_kroner: Heltal, straksfradrag_som_ikke_medregnes_kroner: Heltal, afskrivningsposter: List(Afskrivningslov21Afskrivningspost)) | Al21Par19Grundlag(bygningshistorik: Afskrivningslov19Historik, forbedringsgrundlag: List(Afskrivningslov21Par19Delgrundlag)) | Al21BlandetInstallation(samlede_anskaffelses_og_forbedringsudgifter_før_salgsåret_kroner: Heltal, straksfradrag_før_salgsåret_som_ikke_medregnes_kroner: Heltal, forbedringsudgifter_i_salgsåret_kroner: Heltal, straksfradrag_i_salgsåret_som_ikke_medregnes_kroner: Heltal, afskrivningsposter: List(Afskrivningslov21Afskrivningspost))
# Afskrivningslov21Par39Historik(afholdte_ombygningsudgifter_kroner: Heltal, foretagne_afskrivninger_kroner: Heltal)
# Afskrivningslov21NedskrevetVærdiInput(aktiv: AfskrivningslovKapitel3Aktiv, grundlag: Afskrivningslov21Grundlag, par39_historik: Afskrivningslov21Par39Historik)
# Afskrivningslov21NedskrevetVærdiResultat(skatteyder: AfskrivningslovSkatteyder, aktiv: AfskrivningslovKapitel3Aktiv, grundlag: Afskrivningslov21Grundlag, grundlag_gyldigt: Boolsk, blandet_installation_efter_par15_stk3: Boolsk, samlede_anskaffelses_og_forbedringsudgifter_kroner: Heltal, afskrivningsberettiget_anskaffelsesgrundlag_kroner: Heltal, samlede_beregnede_afskrivninger_kroner: Heltal, samlede_foretagne_afskrivninger_kroner: Heltal, samlede_maksimalt_mulige_afskrivninger_kroner: Heltal, nedskrevet_værdi_kroner: Heltal)
# Afskrivningslov21Kontrol(sælgerne_er_en_eller_flere_personer: Boolsk, køber_er_selskab_mv: Boolsk, kapitalandel_basispoint: Heltal, stemmerettigheder_basispoint: Heltal, anden_bestemmende_indflydelse: Boolsk)
# Afskrivningslov21Input(indkomstår: Heltal, nedskrevet_værdi_resultat: Afskrivningslov21NedskrevetVærdiResultat, salg_gennemført: Boolsk, samlet_salgssum_kroner: Heltal, par24_finder_anvendelse: Boolsk, kontrol: Afskrivningslov21Kontrol)
# Afskrivningslov21Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, omfattet_af_par21: Boolsk, par24_finder_anvendelse: Boolsk, grundlag_gyldigt: Boolsk, blandet_installation_efter_par15_stk3: Boolsk, samlede_anskaffelses_og_forbedringsudgifter_kroner: Heltal, afskrivningsberettiget_anskaffelsesgrundlag_kroner: Heltal, samlet_salgssum_kroner: Heltal, salgssum_til_par21_kroner: Heltal, samlede_beregnede_afskrivninger_kroner: Heltal, samlede_foretagne_afskrivninger_kroner: Heltal, samlede_maksimalt_mulige_afskrivninger_kroner: Heltal, nedskrevet_værdi_kroner: Heltal, rå_fortjeneste_kroner: Heltal, rå_tab_kroner: Heltal, beregnede_genvundne_afskrivninger_før_par24_kroner: Heltal, beregnet_tab_før_par24_og_kontrol_kroner: Heltal, bestemmende_indflydelse: Boolsk, tab_afskåret_efter_stk5_kroner: Heltal, skattepligtige_genvundne_afskrivninger_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal)

| afskrivningslov21_afskrivningspost_gyldig(post: Afskrivningslov21Afskrivningspost) -> post.beregnede_afskrivninger_kroner >= 0 && post.fratrukne_afskrivninger_kroner >= 0 && post.fratrukne_afskrivninger_kroner <= post.beregnede_afskrivninger_kroner
| afskrivningslov21_afskrivningsposter_fra_årsopgørelser(årsopgørelser: List(Afskrivningslov17Årsopgørelse)) -> map(årsopgørelser, |årsopgørelse: Afskrivningslov17Årsopgørelse| Afskrivningslov21Afskrivningspost(beregnede_afskrivninger_kroner = årsopgørelse.beregnet_afskrivning_før_erhvervsandel_kroner, fratrukne_afskrivninger_kroner = årsopgørelse.fradraget_afskrivning_kroner))
| afskrivningslov21_beregnede_afskrivninger_kroner(poster: List(Afskrivningslov21Afskrivningspost)) -> foldl(poster, 0, |sum: Heltal, post: Afskrivningslov21Afskrivningspost| sum + penge_positivt_beløb(post.beregnede_afskrivninger_kroner))
| afskrivningslov21_fratrukne_afskrivninger_kroner(poster: List(Afskrivningslov21Afskrivningspost)) -> foldl(poster, 0, |sum: Heltal, post: Afskrivningslov21Afskrivningspost| sum + penge_positivt_beløb(post.fratrukne_afskrivninger_kroner))
| afskrivningslov21_netto_anskaffelsesudgift_kroner(samlede_udgifter_kroner: Heltal, straksfradrag_kroner: Heltal) -> penge_positivt_beløb(penge_positivt_beløb(samlede_udgifter_kroner) - penge_positivt_beløb(straksfradrag_kroner))
| afskrivningslov21_par19_delgrundlag_fra_historik(historik: Afskrivningslov19Historik) -> Afskrivningslov21Par19Delgrundlag(
    samlede_anskaffelses_og_forbedringsudgifter_kroner = historik.samlet_anskaffelsessum_kroner,
    straksfradrag_som_ikke_medregnes_kroner = 0,
    afskrivningsberettigede_indkomstår_for_grundlaget = historik.afskrivningsberettigede_indkomstår_for_bygningen,
    intervaller = historik.intervaller
)
| afskrivningslov21_par19_delgrundlag_netto_kroner(grundlag: Afskrivningslov21Par19Delgrundlag) -> afskrivningslov21_netto_anskaffelsesudgift_kroner(grundlag.samlede_anskaffelses_og_forbedringsudgifter_kroner, grundlag.straksfradrag_som_ikke_medregnes_kroner)
| afskrivningslov21_par19_delgrundlag_gyldigt(grundlag: Afskrivningslov21Par19Delgrundlag) -> grundlag.afskrivningsberettigede_indkomstår_for_grundlaget > 0 && afskrivningslov19_intervaller_gyldige(grundlag.intervaller, afskrivningslov21_par19_delgrundlag_netto_kroner(grundlag), grundlag.afskrivningsberettigede_indkomstår_for_grundlaget)
| afskrivningslov21_par19_vægtet_anskaffelsessum_tæller(grundlag: Afskrivningslov21Par19Delgrundlag) -> foldl(grundlag.intervaller, 0, |sum: Heltal, interval: Afskrivningslov19Interval| sum + afskrivningslov19_interval_beløb_kroner(interval) * interval.afskrivningsberettigede_indkomstår)
| afskrivningslov21_par19_gennemsnitligt_grundlag_før_minimum_kroner(grundlag: Afskrivningslov21Par19Delgrundlag) -> hvis afskrivningslov21_par19_delgrundlag_gyldigt(grundlag) { (afskrivningslov21_par19_vægtet_anskaffelsessum_tæller(grundlag) + grundlag.afskrivningsberettigede_indkomstår_for_grundlaget / 2) / grundlag.afskrivningsberettigede_indkomstår_for_grundlaget } ellers { 0 }
| afskrivningslov21_par19_foretagne_afskrivninger_kroner(grundlag: Afskrivningslov21Par19Delgrundlag) -> afskrivningslov19_foretagne_afskrivninger_kroner(grundlag.intervaller)
| afskrivningslov21_par19_maksimalt_mulige_afskrivninger_kroner(grundlag: Afskrivningslov21Par19Delgrundlag) -> afskrivningslov19_maksimalt_mulige_afskrivninger_kroner(grundlag.intervaller)
| afskrivningslov21_par19_gennemsnitligt_grundlag_kroner(grundlag: Afskrivningslov21Par19Delgrundlag) -> penge_mindste_beløb(afskrivningslov21_par19_delgrundlag_netto_kroner(grundlag), penge_største_beløb(afskrivningslov21_par19_gennemsnitligt_grundlag_før_minimum_kroner(grundlag), afskrivningslov21_par19_maksimalt_mulige_afskrivninger_kroner(grundlag)))
| afskrivningslov21_par19_grundlagsposter(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21Par19Grundlag(bygningshistorik, forbedringsgrundlag) -> concat([afskrivningslov21_par19_delgrundlag_fra_historik(bygningshistorik)], forbedringsgrundlag)
    | _ -> []
}
| afskrivningslov21_par19_samlet_netto_anskaffelsessum_kroner(grundlag: Afskrivningslov21Grundlag) -> foldl(afskrivningslov21_par19_grundlagsposter(grundlag), 0, |sum: Heltal, delgrundlag: Afskrivningslov21Par19Delgrundlag| sum + afskrivningslov21_par19_delgrundlag_netto_kroner(delgrundlag))
| afskrivningslov21_par19_samlet_gennemsnitligt_grundlag_kroner(grundlag: Afskrivningslov21Grundlag) -> foldl(afskrivningslov21_par19_grundlagsposter(grundlag), 0, |sum: Heltal, delgrundlag: Afskrivningslov21Par19Delgrundlag| sum + afskrivningslov21_par19_gennemsnitligt_grundlag_kroner(delgrundlag))
| afskrivningslov21_par19_samlede_foretagne_afskrivninger_kroner(grundlag: Afskrivningslov21Grundlag) -> foldl(afskrivningslov21_par19_grundlagsposter(grundlag), 0, |sum: Heltal, delgrundlag: Afskrivningslov21Par19Delgrundlag| sum + afskrivningslov21_par19_foretagne_afskrivninger_kroner(delgrundlag))
| afskrivningslov21_par19_samlede_maksimalt_mulige_afskrivninger_kroner(grundlag: Afskrivningslov21Grundlag) -> foldl(afskrivningslov21_par19_grundlagsposter(grundlag), 0, |sum: Heltal, delgrundlag: Afskrivningslov21Par19Delgrundlag| sum + afskrivningslov21_par19_maksimalt_mulige_afskrivninger_kroner(delgrundlag))
| afskrivningslov21_par39_gyldig(historik: Afskrivningslov21Par39Historik) -> historik.afholdte_ombygningsudgifter_kroner >= 0 && historik.foretagne_afskrivninger_kroner >= 0 && historik.foretagne_afskrivninger_kroner <= historik.afholdte_ombygningsudgifter_kroner
| afskrivningslov21_grundlag_matcher_aktiv(aktiv: AfskrivningslovKapitel3Aktiv, grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21OrdinærtGrundlag(_, _, _) -> match aktiv {
        | AlK3Bygning(_) -> Sandt
        | AlK3Installation(resultat) -> resultat.omfattet_af_stk2
        | _ -> Falskt
    }
    | Al21Par19Grundlag(bygningshistorik, _) -> match aktiv {
        | AlK3Bygning(resultat) -> resultat.omfattet_af_par14 && bygningshistorik.gyldig && resultat.skatteyder == bygningshistorik.skatteyder
        | _ -> Falskt
    }
    | Al21BlandetInstallation(_, _, _, _, _) -> match aktiv {
        | AlK3Installation(resultat) -> resultat.omfattet_af_stk3
        | _ -> Falskt
    }
}
| afskrivningslov21_grundlag_gyldigt(aktiv: AfskrivningslovKapitel3Aktiv, grundlag: Afskrivningslov21Grundlag) -> afskrivningslov21_grundlag_matcher_aktiv(aktiv, grundlag) && match grundlag {
    | Al21OrdinærtGrundlag(samlede_udgifter, straksfradrag, poster) -> straksfradrag >= 0 && straksfradrag <= samlede_udgifter && all(poster, |post: Afskrivningslov21Afskrivningspost| afskrivningslov21_afskrivningspost_gyldig(post)) && afskrivningslov21_fratrukne_afskrivninger_kroner(poster) <= afskrivningslov21_netto_anskaffelsesudgift_kroner(samlede_udgifter, straksfradrag)
    | Al21Par19Grundlag(bygningshistorik, _) -> bygningshistorik.gyldig && all(afskrivningslov21_par19_grundlagsposter(grundlag), |delgrundlag: Afskrivningslov21Par19Delgrundlag| afskrivningslov21_par19_delgrundlag_gyldigt(delgrundlag)) && afskrivningslov21_par19_samlede_foretagne_afskrivninger_kroner(grundlag) <= afskrivningslov21_par19_samlet_gennemsnitligt_grundlag_kroner(grundlag)
    | Al21BlandetInstallation(samlede_udgifter, straksfradrag, forbedringer_i_salgsåret, straksfradrag_i_salgsåret, poster) -> straksfradrag >= 0 && straksfradrag <= samlede_udgifter && straksfradrag_i_salgsåret >= 0 && straksfradrag_i_salgsåret <= forbedringer_i_salgsåret && all(poster, |post: Afskrivningslov21Afskrivningspost| afskrivningslov21_afskrivningspost_gyldig(post)) && afskrivningslov21_beregnede_afskrivninger_kroner(poster) <= afskrivningslov21_netto_anskaffelsesudgift_kroner(samlede_udgifter, straksfradrag)
}
| afskrivningslov21_samlede_anskaffelsesudgifter_kroner(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21OrdinærtGrundlag(samlede_udgifter, straksfradrag, _) -> afskrivningslov21_netto_anskaffelsesudgift_kroner(samlede_udgifter, straksfradrag)
    | Al21Par19Grundlag(_, _) -> afskrivningslov21_par19_samlet_netto_anskaffelsessum_kroner(grundlag)
    | Al21BlandetInstallation(samlede_udgifter, straksfradrag, forbedringer_i_salgsåret, straksfradrag_i_salgsåret, _) -> afskrivningslov21_netto_anskaffelsesudgift_kroner(samlede_udgifter, straksfradrag) + afskrivningslov21_netto_anskaffelsesudgift_kroner(forbedringer_i_salgsåret, straksfradrag_i_salgsåret)
}
| afskrivningslov21_afskrivningsberettiget_anskaffelsesgrundlag_kroner(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21Par19Grundlag(_, _) -> afskrivningslov21_par19_samlet_gennemsnitligt_grundlag_kroner(grundlag)
    | _ -> afskrivningslov21_samlede_anskaffelsesudgifter_kroner(grundlag)
}
| afskrivningslov21_grundlag_beregnede_afskrivninger_kroner(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21OrdinærtGrundlag(_, _, poster) -> afskrivningslov21_fratrukne_afskrivninger_kroner(poster)
    | Al21Par19Grundlag(_, _) -> afskrivningslov21_par19_samlede_foretagne_afskrivninger_kroner(grundlag)
    | Al21BlandetInstallation(_, _, _, _, poster) -> afskrivningslov21_beregnede_afskrivninger_kroner(poster)
}
| afskrivningslov21_grundlag_foretagne_afskrivninger_kroner(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21OrdinærtGrundlag(_, _, poster) -> afskrivningslov21_fratrukne_afskrivninger_kroner(poster)
    | Al21Par19Grundlag(_, _) -> afskrivningslov21_par19_samlede_foretagne_afskrivninger_kroner(grundlag)
    | Al21BlandetInstallation(_, _, _, _, poster) -> afskrivningslov21_fratrukne_afskrivninger_kroner(poster)
}
| afskrivningslov21_grundlag_maksimalt_mulige_afskrivninger_kroner(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21Par19Grundlag(_, _) -> afskrivningslov21_par19_samlede_maksimalt_mulige_afskrivninger_kroner(grundlag)
    | _ -> afskrivningslov21_grundlag_beregnede_afskrivninger_kroner(grundlag)
}
| afskrivningslov21_blandet_installation(grundlag: Afskrivningslov21Grundlag) -> match grundlag {
    | Al21BlandetInstallation(_, _, _, _, _) -> Sandt
    | _ -> Falskt
}

# Afskrivningslov21NedskrevetVærdiSag(input: Afskrivningslov21NedskrevetVærdiInput) {
    | grundlag_gyldigt() -> afskrivningslov21_par39_gyldig(input.par39_historik) && afskrivningslov21_grundlag_gyldigt(input.aktiv, input.grundlag)
    | par39_afskrivninger_kroner() -> hvis grundlag_gyldigt() { penge_positivt_beløb(input.par39_historik.foretagne_afskrivninger_kroner) } ellers { 0 }
    | samlede_anskaffelsesudgifter_kroner() -> hvis grundlag_gyldigt() { afskrivningslov21_samlede_anskaffelsesudgifter_kroner(input.grundlag) + par39_afskrivninger_kroner() } ellers { 0 }
    | afskrivningsberettiget_anskaffelsesgrundlag_kroner() -> hvis grundlag_gyldigt() { afskrivningslov21_afskrivningsberettiget_anskaffelsesgrundlag_kroner(input.grundlag) + par39_afskrivninger_kroner() } ellers { 0 }
    | beregnede_afskrivninger_kroner() -> hvis grundlag_gyldigt() { afskrivningslov21_grundlag_beregnede_afskrivninger_kroner(input.grundlag) + par39_afskrivninger_kroner() } ellers { 0 }
    | foretagne_afskrivninger_kroner() -> hvis grundlag_gyldigt() { afskrivningslov21_grundlag_foretagne_afskrivninger_kroner(input.grundlag) + par39_afskrivninger_kroner() } ellers { 0 }
    | maksimalt_mulige_afskrivninger_kroner() -> hvis grundlag_gyldigt() { afskrivningslov21_grundlag_maksimalt_mulige_afskrivninger_kroner(input.grundlag) + par39_afskrivninger_kroner() } ellers { 0 }
    | nedskrevet_værdi_kroner() -> penge_positivt_beløb(afskrivningsberettiget_anskaffelsesgrundlag_kroner() - beregnede_afskrivninger_kroner())
    | resultat() -> Afskrivningslov21NedskrevetVærdiResultat(
        skatteyder = afskrivningslov_kapitel3_aktiv_skatteyder(input.aktiv),
        aktiv = input.aktiv,
        grundlag = input.grundlag,
        grundlag_gyldigt = grundlag_gyldigt(),
        blandet_installation_efter_par15_stk3 = afskrivningslov21_blandet_installation(input.grundlag),
        samlede_anskaffelses_og_forbedringsudgifter_kroner = samlede_anskaffelsesudgifter_kroner(),
        afskrivningsberettiget_anskaffelsesgrundlag_kroner = afskrivningsberettiget_anskaffelsesgrundlag_kroner(),
        samlede_beregnede_afskrivninger_kroner = beregnede_afskrivninger_kroner(),
        samlede_foretagne_afskrivninger_kroner = foretagne_afskrivninger_kroner(),
        samlede_maksimalt_mulige_afskrivninger_kroner = maksimalt_mulige_afskrivninger_kroner(),
        nedskrevet_værdi_kroner = nedskrevet_værdi_kroner()
    )
}
| afskrivningslov21_nedskrevet_værdi_sag(input: Afskrivningslov21NedskrevetVærdiInput) -> Afskrivningslov21NedskrevetVærdiSag(input)
| afskrivningslov21_nedskrevet_værdi_resultat(input: Afskrivningslov21NedskrevetVærdiInput) -> afskrivningslov21_nedskrevet_værdi_sag(input).resultat()
| afskrivningslov21_bestemmende_indflydelse(kontrol: Afskrivningslov21Kontrol) -> kontrol.sælgerne_er_en_eller_flere_personer && kontrol.køber_er_selskab_mv && (kontrol.kapitalandel_basispoint > 5000 || kontrol.stemmerettigheder_basispoint > 5000 || kontrol.anden_bestemmende_indflydelse)

# Afskrivningslov21Sag(input: Afskrivningslov21Input) {
    | værdi() -> input.nedskrevet_værdi_resultat
    | omfattet_af_par21() -> input.salg_gennemført && værdi().grundlag_gyldigt
    | samlet_salgssum_kroner() -> penge_positivt_beløb(input.samlet_salgssum_kroner)
    | salgssum_til_par21_kroner() -> samlet_salgssum_kroner()
    | exception al21_par19_forholdsmæssig_salgssum salgssum_til_par21_kroner() -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(samlet_salgssum_kroner(), værdi().afskrivningsberettiget_anskaffelsesgrundlag_kroner, værdi().samlede_anskaffelses_og_forbedringsudgifter_kroner) under omfattet_af_par21() && match værdi().grundlag { | Al21Par19Grundlag(_, _) -> Sandt | _ -> Falskt }
    | rå_fortjeneste_kroner() -> hvis omfattet_af_par21() { penge_positivt_beløb(salgssum_til_par21_kroner() - værdi().nedskrevet_værdi_kroner) } ellers { 0 }
    | rå_tab_kroner() -> hvis omfattet_af_par21() { penge_positivt_beløb(værdi().nedskrevet_værdi_kroner - salgssum_til_par21_kroner()) } ellers { 0 }
    | forholdsmæssig_fortjeneste_kroner() -> rå_fortjeneste_kroner()
    | exception al21_stk4_blandet_fortjeneste forholdsmæssig_fortjeneste_kroner() -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(rå_fortjeneste_kroner(), værdi().samlede_foretagne_afskrivninger_kroner, værdi().samlede_beregnede_afskrivninger_kroner) under værdi().blandet_installation_efter_par15_stk3 && værdi().samlede_beregnede_afskrivninger_kroner > 0
    | forholdsmæssigt_tab_kroner() -> rå_tab_kroner()
    | exception al21_stk4_blandet_tab forholdsmæssigt_tab_kroner() -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(rå_tab_kroner(), værdi().samlede_foretagne_afskrivninger_kroner, værdi().samlede_beregnede_afskrivninger_kroner) under værdi().blandet_installation_efter_par15_stk3 && værdi().samlede_beregnede_afskrivninger_kroner > 0
    | beregnede_genvundne_afskrivninger_før_par24_kroner() -> penge_mindste_beløb(værdi().samlede_foretagne_afskrivninger_kroner, forholdsmæssig_fortjeneste_kroner())
    | beregnet_tab_før_par24_og_kontrol_kroner() -> forholdsmæssigt_tab_kroner()
    | bestemmende_indflydelse() -> afskrivningslov21_bestemmende_indflydelse(input.kontrol)
    | tab_afskåret_efter_stk5_kroner() -> hvis bestemmende_indflydelse() { beregnet_tab_før_par24_og_kontrol_kroner() } ellers { 0 }
    | skattepligtige_genvundne_afskrivninger_kroner() -> hvis omfattet_af_par21() && input.par24_finder_anvendelse == Falskt { beregnede_genvundne_afskrivninger_før_par24_kroner() } ellers { 0 }
    | fradragsberettiget_tab_kroner() -> hvis omfattet_af_par21() && input.par24_finder_anvendelse == Falskt && bestemmende_indflydelse() == Falskt { beregnet_tab_før_par24_og_kontrol_kroner() } ellers { 0 }
    | resultat() -> Afskrivningslov21Resultat(
        indkomstår = input.indkomstår,
        skatteyder = værdi().skatteyder,
        omfattet_af_par21 = omfattet_af_par21(),
        par24_finder_anvendelse = input.par24_finder_anvendelse,
        grundlag_gyldigt = værdi().grundlag_gyldigt,
        blandet_installation_efter_par15_stk3 = værdi().blandet_installation_efter_par15_stk3,
        samlede_anskaffelses_og_forbedringsudgifter_kroner = værdi().samlede_anskaffelses_og_forbedringsudgifter_kroner,
        afskrivningsberettiget_anskaffelsesgrundlag_kroner = værdi().afskrivningsberettiget_anskaffelsesgrundlag_kroner,
        samlet_salgssum_kroner = samlet_salgssum_kroner(),
        salgssum_til_par21_kroner = salgssum_til_par21_kroner(),
        samlede_beregnede_afskrivninger_kroner = værdi().samlede_beregnede_afskrivninger_kroner,
        samlede_foretagne_afskrivninger_kroner = værdi().samlede_foretagne_afskrivninger_kroner,
        samlede_maksimalt_mulige_afskrivninger_kroner = værdi().samlede_maksimalt_mulige_afskrivninger_kroner,
        nedskrevet_værdi_kroner = værdi().nedskrevet_værdi_kroner,
        rå_fortjeneste_kroner = rå_fortjeneste_kroner(),
        rå_tab_kroner = rå_tab_kroner(),
        beregnede_genvundne_afskrivninger_før_par24_kroner = beregnede_genvundne_afskrivninger_før_par24_kroner(),
        beregnet_tab_før_par24_og_kontrol_kroner = beregnet_tab_før_par24_og_kontrol_kroner(),
        bestemmende_indflydelse = bestemmende_indflydelse(),
        tab_afskåret_efter_stk5_kroner = tab_afskåret_efter_stk5_kroner(),
        skattepligtige_genvundne_afskrivninger_kroner = skattepligtige_genvundne_afskrivninger_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner()
    )
}
| afskrivningslov21_sag(input: Afskrivningslov21Input) -> Afskrivningslov21Sag(input)
| afskrivningslov21_resultat(input: Afskrivningslov21Input) -> afskrivningslov21_sag(input).resultat()
--@end:afskrivningsloven_par21--

--@label:afskrivningsloven_par22::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par22_juridisk_vejledning--
----
§ 22. Når en bygning, hvorpå der er afskrevet efter § 14, nedrives, kan der
foretages et fradrag i den skattepligtige indkomst for det indkomstår, hvori
nedrivningen sker. Fradraget opgøres som bygningens nedskrevne værdi efter § 21,
stk. 2, nedsat med den eventuelle salgssum for bygninger eller materialer m.v.
Det samme gælder, når en installation, hvorpå der er afskrevet efter § 15, stk.
2 eller 3, udskiftes eller nedtages endeligt. For installationer, hvorpå der er
afskrevet efter § 15, stk. 3, opgøres fradraget som den del af den nedskrevne
værdi efter § 21, stk. 4, nedsat med en eventuel salgssum, som svarer til
forholdet mellem de afskrivninger, der i alt er fratrukket ved opgørelsen af den
skattepligtige indkomst, og de samlede beregnede afskrivninger. Fradrag efter 1.
pkt. kan dog kun foretages, når den skattepligtige i mindst 5 år før nedrivningen
har ejet bygningen eller installationen og i en periode af mindst samme længde,
mens den skattepligtige har ejet bygningen eller installationen, har anvendt den
til et afskrivningsberettiget formål.

Stk. 2. Hvis betingelsen i stk. 1, 5. pkt., ikke er opfyldt, kan tabet fradrages
i det indkomstår, hvori ejendommen eller den del af ejendommen, hvor bygningen
eller installationer var beliggende, sælges. Tabet opgøres som bygningens eller
installationens nedskrevne værdi på tidspunktet for nedrivningen nedsat med den
eventuelle salgssum for bygninger, installationer eller materialer m.v.
----

--@begin:afskrivningsloven_par22--
# Afskrivningslov22Begivenhed = Al22BygningNedrevet | Al22InstallationUdskiftet | Al22InstallationEndeligtNedtaget
# Afskrivningslov22Input(indkomstår: Heltal, nedskrevet_værdi_resultat: Afskrivningslov21NedskrevetVærdiResultat, begivenhed: Afskrivningslov22Begivenhed, salgssum_for_bygning_installation_eller_materialer_kroner: Heltal, ejertid_før_nedrivning_år: Heltal, afskrivningsberettiget_anvendelse_i_ejertiden_år: Heltal, ejendommen_eller_den_relevante_del_solgt_i_indkomståret: Boolsk)
# Afskrivningslov22Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, omfattet_af_par22: Boolsk, begivenhed_matcher_aktiv: Boolsk, femårs_ejertid_opfyldt: Boolsk, femårs_afskrivningsberettiget_anvendelse_opfyldt: Boolsk, nedskrevet_værdi_kroner: Heltal, salgssum_for_bygning_installation_eller_materialer_kroner: Heltal, beregnet_nedrivningstab_kroner: Heltal, fradrag_i_nedrivningsåret_kroner: Heltal, udskudt_tab_efter_stk2_kroner: Heltal, fradrag_ved_senere_ejendomssalg_kroner: Heltal)

| afskrivningslov22_begivenhed_matcher_aktiv(aktiv: AfskrivningslovKapitel3Aktiv, begivenhed: Afskrivningslov22Begivenhed) -> match begivenhed {
    | Al22BygningNedrevet -> afskrivningslov20_aktiv_behandles_som_bygning(aktiv)
    | Al22InstallationUdskiftet -> afskrivningslov20_aktiv_er_installation_stk2_eller_stk3(aktiv)
    | Al22InstallationEndeligtNedtaget -> afskrivningslov20_aktiv_er_installation_stk2_eller_stk3(aktiv)
}

# Afskrivningslov22Sag(input: Afskrivningslov22Input) {
    | værdi() -> input.nedskrevet_værdi_resultat
    | begivenhed_matcher_aktiv() -> afskrivningslov22_begivenhed_matcher_aktiv(værdi().aktiv, input.begivenhed)
    | omfattet_af_par22() -> værdi().grundlag_gyldigt && begivenhed_matcher_aktiv()
    | salgssum_kroner() -> penge_positivt_beløb(input.salgssum_for_bygning_installation_eller_materialer_kroner)
    | tab_før_blandet_forhold_kroner() -> hvis omfattet_af_par22() { penge_positivt_beløb(værdi().nedskrevet_værdi_kroner - salgssum_kroner()) } ellers { 0 }
    | beregnet_nedrivningstab_kroner() -> tab_før_blandet_forhold_kroner()
    | exception al22_stk1_blandet_installation beregnet_nedrivningstab_kroner() -> afskrivningslov_beløb_gange_forhold_afrundet_kroner(tab_før_blandet_forhold_kroner(), værdi().samlede_foretagne_afskrivninger_kroner, værdi().samlede_beregnede_afskrivninger_kroner) under værdi().blandet_installation_efter_par15_stk3 && værdi().samlede_beregnede_afskrivninger_kroner > 0
    | femårs_ejertid_opfyldt() -> input.ejertid_før_nedrivning_år >= 5
    | femårs_afskrivningsberettiget_anvendelse_opfyldt() -> input.afskrivningsberettiget_anvendelse_i_ejertiden_år >= 5
    | fradrag_i_nedrivningsåret_kroner() -> hvis omfattet_af_par22() && femårs_ejertid_opfyldt() && femårs_afskrivningsberettiget_anvendelse_opfyldt() { beregnet_nedrivningstab_kroner() } ellers { 0 }
    | udskudt_tab_efter_stk2_kroner() -> hvis omfattet_af_par22() && (femårs_ejertid_opfyldt() == Falskt || femårs_afskrivningsberettiget_anvendelse_opfyldt() == Falskt) { beregnet_nedrivningstab_kroner() } ellers { 0 }
    | fradrag_ved_senere_ejendomssalg_kroner() -> hvis input.ejendommen_eller_den_relevante_del_solgt_i_indkomståret { udskudt_tab_efter_stk2_kroner() } ellers { 0 }
    | resultat() -> Afskrivningslov22Resultat(
        indkomstår = input.indkomstår,
        skatteyder = værdi().skatteyder,
        omfattet_af_par22 = omfattet_af_par22(),
        begivenhed_matcher_aktiv = begivenhed_matcher_aktiv(),
        femårs_ejertid_opfyldt = femårs_ejertid_opfyldt(),
        femårs_afskrivningsberettiget_anvendelse_opfyldt = femårs_afskrivningsberettiget_anvendelse_opfyldt(),
        nedskrevet_værdi_kroner = værdi().nedskrevet_værdi_kroner,
        salgssum_for_bygning_installation_eller_materialer_kroner = salgssum_kroner(),
        beregnet_nedrivningstab_kroner = beregnet_nedrivningstab_kroner(),
        fradrag_i_nedrivningsåret_kroner = fradrag_i_nedrivningsåret_kroner(),
        udskudt_tab_efter_stk2_kroner = udskudt_tab_efter_stk2_kroner(),
        fradrag_ved_senere_ejendomssalg_kroner = fradrag_ved_senere_ejendomssalg_kroner()
    )
}
| afskrivningslov22_sag(input: Afskrivningslov22Input) -> Afskrivningslov22Sag(input)
| afskrivningslov22_resultat(input: Afskrivningslov22Input) -> afskrivningslov22_sag(input).resultat()
--@end:afskrivningsloven_par22--

--@label:afskrivningsloven_par23::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par23_par24_juridisk_vejledning--
----
§ 23. Hvis der på en bygning eller installation sker en skade, der ikke kan
udbedres ved normal vedligeholdelse, kan afskrivning fra og med det indkomstår,
hvori skaden indtræffer, kun beregnes af den del af anskaffelsessummen, som
svarer til forholdet mellem bygningens eller installationens værdi efter skadens
indtræden og værdien umiddelbart forinden. Den værdiforringelse, der er sket som
følge af en skade, kan fradrages i det indkomstår, hvori skaden er sket. Med
hensyn til udgifter, der anvendes til udbedring af en sådan skade, finder § 18,
stk. 1, anvendelse.
----

--@begin:afskrivningsloven_par23--
# Afskrivningslov23Input(indkomstår: Heltal, nedskrevet_værdi_resultat: Afskrivningslov21NedskrevetVærdiResultat, skade_som_ikke_kan_udbedres_ved_normal_vedligeholdelse: Boolsk, værdi_umiddelbart_før_skaden_kroner: Heltal, værdi_efter_skaden_kroner: Heltal, udgift_til_udbedring_kroner: Heltal)
# Afskrivningslov23Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, omfattet_af_par23: Boolsk, værdiforhold_basispoint: Heltal, afskrivningsgrundlag_før_skade_kroner: Heltal, afskrivningsgrundlag_efter_skade_kroner: Heltal, nedskrevet_værdi_før_skade_kroner: Heltal, nedskrevet_værdi_efter_skade_kroner: Heltal, fradragsberettiget_værdiforringelse_kroner: Heltal, udgift_til_udbedring_kroner: Heltal, udbedringsudgift_henvises_til_par18_stk1: Boolsk, par19_grundlag_efter_skade: List(Afskrivningslov21Par19Delgrundlag))

| afskrivningslov23_interval_efter_skade(interval: Afskrivningslov19Interval, værdi_efter_skaden_kroner: Heltal, værdi_før_skaden_kroner: Heltal) -> Afskrivningslov19Interval(
    fra_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(interval.fra_kroner, værdi_efter_skaden_kroner, værdi_før_skaden_kroner),
    til_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(interval.til_kroner, værdi_efter_skaden_kroner, værdi_før_skaden_kroner),
    afskrivningsberettiget_forrige_indkomstår = interval.afskrivningsberettiget_forrige_indkomstår,
    afskrivningsberettiget_i_indkomståret = interval.afskrivningsberettiget_i_indkomståret,
    afskrivningsberettigede_indkomstår = interval.afskrivningsberettigede_indkomstår,
    anvendt_afskrivningsprocent_basispoint = interval.anvendt_afskrivningsprocent_basispoint,
    maksimalt_mulig_afskrivningsprocent_basispoint = interval.maksimalt_mulig_afskrivningsprocent_basispoint
)
| afskrivningslov23_par19_delgrundlag_efter_skade(grundlag: Afskrivningslov21Par19Delgrundlag, værdi_efter_skaden_kroner: Heltal, værdi_før_skaden_kroner: Heltal) -> Afskrivningslov21Par19Delgrundlag(
    samlede_anskaffelses_og_forbedringsudgifter_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(afskrivningslov21_par19_delgrundlag_netto_kroner(grundlag), værdi_efter_skaden_kroner, værdi_før_skaden_kroner),
    straksfradrag_som_ikke_medregnes_kroner = 0,
    afskrivningsberettigede_indkomstår_for_grundlaget = grundlag.afskrivningsberettigede_indkomstår_for_grundlaget,
    intervaller = map(grundlag.intervaller, |interval: Afskrivningslov19Interval| afskrivningslov23_interval_efter_skade(interval, værdi_efter_skaden_kroner, værdi_før_skaden_kroner))
)

# Afskrivningslov23Sag(input: Afskrivningslov23Input) {
    | værdi() -> input.nedskrevet_værdi_resultat
    | værdier_gyldige() -> input.værdi_umiddelbart_før_skaden_kroner > 0 && input.værdi_efter_skaden_kroner >= 0 && input.værdi_efter_skaden_kroner < input.værdi_umiddelbart_før_skaden_kroner
    | omfattet_af_par23() -> værdi().grundlag_gyldigt && input.skade_som_ikke_kan_udbedres_ved_normal_vedligeholdelse && værdier_gyldige()
    | værdiforhold_basispoint() -> hvis omfattet_af_par23() { input.værdi_efter_skaden_kroner * 10000 / input.værdi_umiddelbart_før_skaden_kroner } ellers { 0 }
    | afskrivningsgrundlag_efter_skade_kroner() -> hvis omfattet_af_par23() { afskrivningslov_beløb_gange_forhold_afrundet_kroner(værdi().afskrivningsberettiget_anskaffelsesgrundlag_kroner, input.værdi_efter_skaden_kroner, input.værdi_umiddelbart_før_skaden_kroner) } ellers { 0 }
    | nedskrevet_værdi_efter_skade_kroner() -> hvis omfattet_af_par23() { afskrivningslov_beløb_gange_forhold_afrundet_kroner(værdi().nedskrevet_værdi_kroner, input.værdi_efter_skaden_kroner, input.værdi_umiddelbart_før_skaden_kroner) } ellers { 0 }
    | fradragsberettiget_værdiforringelse_kroner() -> hvis omfattet_af_par23() { penge_positivt_beløb(værdi().nedskrevet_værdi_kroner - nedskrevet_værdi_efter_skade_kroner()) } ellers { 0 }
    | udgift_til_udbedring_kroner() -> penge_positivt_beløb(input.udgift_til_udbedring_kroner)
    | udbedringsudgift_henvises_til_par18_stk1() -> omfattet_af_par23() && udgift_til_udbedring_kroner() > 0
    | par19_grundlag_efter_skade() -> hvis omfattet_af_par23() { map(afskrivningslov21_par19_grundlagsposter(værdi().grundlag), |grundlag: Afskrivningslov21Par19Delgrundlag| afskrivningslov23_par19_delgrundlag_efter_skade(grundlag, input.værdi_efter_skaden_kroner, input.værdi_umiddelbart_før_skaden_kroner)) } ellers { [] }
    | resultat() -> Afskrivningslov23Resultat(
        indkomstår = input.indkomstår,
        skatteyder = værdi().skatteyder,
        omfattet_af_par23 = omfattet_af_par23(),
        værdiforhold_basispoint = værdiforhold_basispoint(),
        afskrivningsgrundlag_før_skade_kroner = værdi().afskrivningsberettiget_anskaffelsesgrundlag_kroner,
        afskrivningsgrundlag_efter_skade_kroner = afskrivningsgrundlag_efter_skade_kroner(),
        nedskrevet_værdi_før_skade_kroner = værdi().nedskrevet_værdi_kroner,
        nedskrevet_værdi_efter_skade_kroner = nedskrevet_værdi_efter_skade_kroner(),
        fradragsberettiget_værdiforringelse_kroner = fradragsberettiget_værdiforringelse_kroner(),
        udgift_til_udbedring_kroner = udgift_til_udbedring_kroner(),
        udbedringsudgift_henvises_til_par18_stk1 = udbedringsudgift_henvises_til_par18_stk1(),
        par19_grundlag_efter_skade = par19_grundlag_efter_skade()
    )
}
| afskrivningslov23_sag(input: Afskrivningslov23Input) -> Afskrivningslov23Sag(input)
| afskrivningslov23_resultat(input: Afskrivningslov23Input) -> afskrivningslov23_sag(input).resultat()
--@end:afskrivningsloven_par23--

--@label:afskrivningsloven_par24::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par23_par24_juridisk_vejledning--
----
§ 24. Såfremt en skattepligtig ved en skade på sin ejendom har modtaget en
erstatnings- eller forsikringssum og foretager genopførelse eller ombygning af
den skadelidte bygning, anvendes reglerne i stk. 2-11, når

1) de genopførte bygninger m.v. findes på den samme ejendom som de skaderamte
bygninger, jf. dog stk. 6, og

2) genopførelsen m.v. sker enten i det indkomstår, hvori skaden indtræffer,
eller i det nærmest følgende indkomstår, idet fristen for genopførelse dog
tidligst udløber med det førstkommende indkomstår efter det indkomstår, hvori
erstatningssummen er fastsat endeligt.

Stk. 2. Når særlige omstændigheder taler derfor, kan fristerne i stk. 1 forlænges
efter tilladelse fra told- og skatteforvaltningen.

Stk. 3. Afskrivningerne og afskrivningsgrundlaget videreføres uanset den skete
skade og påvirkes ikke af de udgifter, der afholdes til genopførelsen m.v., eller
af erstatnings- eller forsikringssummen, såfremt de afholdte udgifter svarer til
den modtagne erstatnings- eller forsikringssum.

Stk. 4. Er det beløb, der anvendes til genopførelse m.v., større end
forsikrings- eller erstatningssummen, kan den skattepligtige ud over de i stk. 3
nævnte afskrivninger foretage afskrivninger på den del af det overskydende
beløb, der kan anses for anvendt på afskrivningsberettigede bygninger eller
installationer. Afskrivningerne på det overskydende beløb foretages efter
reglerne i § 18, stk. 1, om afskrivning på ombygnings- og forbedringsudgifter.

Stk. 5. Er det beløb, der anvendes til genopførelse m.v., mindre end
forsikrings- eller erstatningssummen, fragår forskelsbeløbet i
afskrivningsgrundlaget efter stk. 3. Ved senere salg af bygningen anses beløbet
som en foretagen afskrivning ved opgørelse af genvundne afskrivninger eller tab
efter § 21. Overstiger forskelsbeløbet den nedskrevne værdi på tidspunktet for
skadens indtræden, medregnes den overskydende del af forskelsbeløbet i den
skattepligtige indkomst for det indkomstår, hvori genopførelsen senest skal være
sket, jf. stk. 1, nr. 2, og stk. 2.

Stk. 6. Uanset bestemmelsen i stk. 1, nr. 1, ikke er opfyldt, finder stk. 2-5
anvendelse, såfremt

1) en lov eller en offentlig myndigheds bestemmelse hindrer, at genopførelse
sker på den ejendom, hvor de skaderamte bygninger m.v. fandtes, eller

2) skaden har ramt en eller flere erhvervsejendomme, der tilhører samme ejer og
udgør en driftsenhed, og ejeren ønsker at foretage genopførelse på en anden af
disse ejendomme end den skaderamte.

Stk. 7. Bestemmelsen i stk. 6 gælder dog kun, såfremt den skattepligtige inden
for fristerne efter stk. 1, nr. 2, og stk. 2, foretager genopførelse for et
beløb, der mindst svarer til erstatnings- eller forsikringssummen.

Stk. 8. Overstiger de samlede udgifter ved en genopførelse på en anden ejendom
end den ejendom, hvor de skaderamte bygninger fandtes, erstatnings- eller
forsikringssummen, tillægges det overskydende beløb afskrivningsgrundlaget for
den genopførte bygning m.v. Sker genopførelse af flere bygninger m.v., fordeles
det overskydende beløb til afskrivningsgrundlagene for de genopførte bygninger
m.v. efter andelen af de samlede udgifter til genopførelse af de enkelte
bygninger m.v.

Stk. 9. Ved genopførelse af bygninger m.v. på en anden ejendom end den ejendom,
hvor de skaderamte bygninger m.v. fandtes, overføres den del af
afskrivningsgrundlaget for og de foretagne afskrivninger på bygninger m.v. på
den skaderamte ejendom, der kan henføres til det skaderamte. Sker genopførelse
af flere bygninger m.v., fordeles den del af afskrivningsgrundlaget og de
foretagne afskrivninger, der kan henføres til det skaderamte, efter andelen af
de samlede udgifter til genopførelse af de enkelte bygninger m.v.

Stk. 10. Ved anvendelse af reglerne i stk. 2-9, skal reglerne i
ejendomsavancebeskatningslovens § 10 samtidig anvendes.

Stk. 11. Finder genopførelse eller genanskaffelse ikke sted inden for de i stk.
1 og 2 nævnte frister, skal de genvundne afskrivninger, jf. § 21, med tillæg af
5 pct. for hvert år fra udløbet af det indkomstår, hvori de genvundne
afskrivninger konstateres, og indtil udløbet af det indkomstår, hvori
genopførelsen senest skulle være sket, medregnes i den skattepligtige indkomst
for sidstnævnte indkomstår.
----

--@begin:afskrivningsloven_par24--
# Afskrivningslov24Placering = Al24SammeEjendom | Al24AndenEjendomHindretAfLovEllerMyndighed | Al24AndenEjendomISammeDriftsenhed | Al24AndenEjendomUdenUndtagelse
# Afskrivningslov24Frist = Al24OrdinærFrist | Al24ForlængetFrist(seneste_genopførelsesår: Heltal)
# Afskrivningslov24GenopførtAktiv(identifikation: Tekst, genopførelsesudgift_kroner: Heltal)
# Afskrivningslov24Fordeling(identifikation: Tekst, genopførelsesudgift_kroner: Heltal, videreført_afskrivningsgrundlag_kroner: Heltal, videreførte_foretagne_afskrivninger_kroner: Heltal, nyt_afskrivningsgrundlag_for_overskydende_genopførelsesudgift_kroner: Heltal)
# Afskrivningslov24Input(par21_forsikringsresultat: Afskrivningslov21Resultat, modtaget_erstatnings_eller_forsikringssum_kroner: Heltal, genopførelse_eller_ombygning_foretages: Boolsk, genopførelsesudgifter_kroner: Heltal, genopførte_aktiver: List(Afskrivningslov24GenopførtAktiv), placering: Afskrivningslov24Placering, skadeår: Heltal, erstatningssum_endeligt_fastsat_år: Heltal, genopførelsesår: Heltal, opgørelsesår: Heltal, frist: Afskrivningslov24Frist, ejendomsavancebeskatningslov10_anvendes_samtidig: Boolsk)
# Afskrivningslov24Resultat(skatteyder: AfskrivningslovSkatteyder, par21_forsikringsresultat_matcher: Boolsk, ordinært_seneste_genopførelsesår: Heltal, seneste_genopførelsesår: Heltal, rettidig_genopførelse: Boolsk, placering_omfattet: Boolsk, anden_ejendom: Boolsk, genopførelsesudgifter_mindst_forsikringssum_ved_anden_ejendom: Boolsk, ejendomsavancebeskatningslov10_anvendes_samtidig: Boolsk, par24_finder_anvendelse: Boolsk, genvundne_afskrivninger_udskudt_kroner: Heltal, forskelsbeløb_forsikringssum_over_genopførelsesudgift_kroner: Heltal, forskelsbeløb_fragår_i_afskrivningsgrundlaget_kroner: Heltal, forskelsbeløb_anses_som_foretaget_afskrivning_kroner: Heltal, skattepligtigt_overskydende_forskelsbeløb_kroner: Heltal, overskydende_genopførelsesudgift_kroner: Heltal, nyt_afskrivningsgrundlag_efter_stk4_eller_stk8_kroner: Heltal, videreført_afskrivningsgrundlag_kroner: Heltal, videreførte_foretagne_afskrivninger_kroner: Heltal, samlet_afskrivningsgrundlag_efter_genopførelse_kroner: Heltal, fordelinger: List(Afskrivningslov24Fordeling), fristsvigt_efter_stk11: Boolsk, antal_tillægsår: Heltal, fem_procent_tillæg_kroner: Heltal, skattepligtige_genvundne_afskrivninger_ved_fristsvigt_kroner: Heltal, samlet_skattepligtigt_beløb_kroner: Heltal)

| afskrivningslov24_anden_ejendom(placering: Afskrivningslov24Placering) -> placering != Al24SammeEjendom
| afskrivningslov24_placering_omfattet(placering: Afskrivningslov24Placering) -> placering == Al24SammeEjendom || placering == Al24AndenEjendomHindretAfLovEllerMyndighed || placering == Al24AndenEjendomISammeDriftsenhed
| afskrivningslov24_ordinært_seneste_genopførelsesår(skadeår: Heltal, erstatningssum_endeligt_fastsat_år: Heltal) -> penge_største_beløb(skadeår + 1, erstatningssum_endeligt_fastsat_år + 1)
| afskrivningslov24_seneste_genopførelsesår(input: Afskrivningslov24Input) -> match input.frist {
    | Al24OrdinærFrist -> afskrivningslov24_ordinært_seneste_genopførelsesår(input.skadeår, input.erstatningssum_endeligt_fastsat_år)
    | Al24ForlængetFrist(seneste_genopførelsesår) -> penge_største_beløb(afskrivningslov24_ordinært_seneste_genopførelsesår(input.skadeår, input.erstatningssum_endeligt_fastsat_år), seneste_genopførelsesår)
}
| afskrivningslov24_genopførelsesudgifter_i_liste_kroner(aktiver: List(Afskrivningslov24GenopførtAktiv)) -> foldl(aktiver, 0, |sum: Heltal, aktiv: Afskrivningslov24GenopførtAktiv| sum + penge_positivt_beløb(aktiv.genopførelsesudgift_kroner))
| afskrivningslov24_genopførte_aktiver_gyldige(input: Afskrivningslov24Input) -> length(input.genopførte_aktiver) > 0 && all(input.genopførte_aktiver, |aktiv: Afskrivningslov24GenopførtAktiv| aktiv.genopførelsesudgift_kroner > 0) && afskrivningslov24_genopførelsesudgifter_i_liste_kroner(input.genopførte_aktiver) == penge_positivt_beløb(input.genopførelsesudgifter_kroner)
| afskrivningslov24_par21_forsikringsresultat_matcher(input: Afskrivningslov24Input) -> input.par21_forsikringsresultat.omfattet_af_par21 && input.par21_forsikringsresultat.par24_finder_anvendelse && input.par21_forsikringsresultat.samlet_salgssum_kroner == penge_positivt_beløb(input.modtaget_erstatnings_eller_forsikringssum_kroner)
| afskrivningslov24_rettidig_genopførelse(input: Afskrivningslov24Input) -> input.genopførelse_eller_ombygning_foretages && input.genopførelsesår >= input.skadeår && input.genopførelsesår <= afskrivningslov24_seneste_genopførelsesår(input) && afskrivningslov24_genopførte_aktiver_gyldige(input)
| afskrivningslov24_anden_ejendom_mindst_forsikringssum(input: Afskrivningslov24Input) -> afskrivningslov24_anden_ejendom(input.placering) == Falskt || penge_positivt_beløb(input.genopførelsesudgifter_kroner) >= penge_positivt_beløb(input.modtaget_erstatnings_eller_forsikringssum_kroner)
| afskrivningslov24_finder_anvendelse(input: Afskrivningslov24Input) -> afskrivningslov24_par21_forsikringsresultat_matcher(input) && afskrivningslov24_rettidig_genopførelse(input) && afskrivningslov24_placering_omfattet(input.placering) && afskrivningslov24_anden_ejendom_mindst_forsikringssum(input) && input.ejendomsavancebeskatningslov10_anvendes_samtidig
| afskrivningslov24_forskelsbeløb_kroner(input: Afskrivningslov24Input) -> penge_positivt_beløb(penge_positivt_beløb(input.modtaget_erstatnings_eller_forsikringssum_kroner) - penge_positivt_beløb(input.genopførelsesudgifter_kroner))
| afskrivningslov24_overskydende_genopførelsesudgift_kroner(input: Afskrivningslov24Input) -> penge_positivt_beløb(penge_positivt_beløb(input.genopførelsesudgifter_kroner) - penge_positivt_beløb(input.modtaget_erstatnings_eller_forsikringssum_kroner))
| afskrivningslov24_fordeling(aktiv: Afskrivningslov24GenopførtAktiv, samlet_genopførelsesudgift_kroner: Heltal, videreført_afskrivningsgrundlag_kroner: Heltal, videreførte_foretagne_afskrivninger_kroner: Heltal, nyt_afskrivningsgrundlag_kroner: Heltal) -> Afskrivningslov24Fordeling(
    identifikation = aktiv.identifikation,
    genopførelsesudgift_kroner = aktiv.genopførelsesudgift_kroner,
    videreført_afskrivningsgrundlag_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(videreført_afskrivningsgrundlag_kroner, aktiv.genopførelsesudgift_kroner, samlet_genopførelsesudgift_kroner),
    videreførte_foretagne_afskrivninger_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(videreførte_foretagne_afskrivninger_kroner, aktiv.genopførelsesudgift_kroner, samlet_genopførelsesudgift_kroner),
    nyt_afskrivningsgrundlag_for_overskydende_genopførelsesudgift_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(nyt_afskrivningsgrundlag_kroner, aktiv.genopførelsesudgift_kroner, samlet_genopførelsesudgift_kroner)
)

# Afskrivningslov24Sag(input: Afskrivningslov24Input) {
    | par21() -> input.par21_forsikringsresultat
    | par21_forsikringsresultat_matcher() -> afskrivningslov24_par21_forsikringsresultat_matcher(input)
    | ordinært_seneste_genopførelsesår() -> afskrivningslov24_ordinært_seneste_genopførelsesår(input.skadeår, input.erstatningssum_endeligt_fastsat_år)
    | seneste_genopførelsesår() -> afskrivningslov24_seneste_genopførelsesår(input)
    | rettidig_genopførelse() -> afskrivningslov24_rettidig_genopførelse(input)
    | placering_omfattet() -> afskrivningslov24_placering_omfattet(input.placering)
    | anden_ejendom() -> afskrivningslov24_anden_ejendom(input.placering)
    | anden_ejendom_mindst_forsikringssum() -> afskrivningslov24_anden_ejendom_mindst_forsikringssum(input)
    | par24_finder_anvendelse() -> afskrivningslov24_finder_anvendelse(input)
    | genvundne_afskrivninger_udskudt_kroner() -> hvis par24_finder_anvendelse() { par21().beregnede_genvundne_afskrivninger_før_par24_kroner } ellers { 0 }
    | forskelsbeløb_kroner() -> hvis par24_finder_anvendelse() { afskrivningslov24_forskelsbeløb_kroner(input) } ellers { 0 }
    | overskydende_genopførelsesudgift_kroner() -> hvis par24_finder_anvendelse() { afskrivningslov24_overskydende_genopførelsesudgift_kroner(input) } ellers { 0 }
    | skattepligtigt_overskydende_forskelsbeløb_kroner() -> hvis par24_finder_anvendelse() { penge_positivt_beløb(forskelsbeløb_kroner() - par21().nedskrevet_værdi_kroner) } ellers { 0 }
    | videreført_afskrivningsgrundlag_kroner() -> hvis par24_finder_anvendelse() { penge_positivt_beløb(par21().afskrivningsberettiget_anskaffelsesgrundlag_kroner - forskelsbeløb_kroner()) } ellers { 0 }
    | videreførte_foretagne_afskrivninger_kroner() -> hvis par24_finder_anvendelse() { par21().samlede_foretagne_afskrivninger_kroner } ellers { 0 }
    | samlet_afskrivningsgrundlag_efter_genopførelse_kroner() -> videreført_afskrivningsgrundlag_kroner() + overskydende_genopførelsesudgift_kroner()
    | fordelinger() -> hvis par24_finder_anvendelse() { map(input.genopførte_aktiver, |aktiv: Afskrivningslov24GenopførtAktiv| afskrivningslov24_fordeling(aktiv, penge_positivt_beløb(input.genopførelsesudgifter_kroner), videreført_afskrivningsgrundlag_kroner(), videreførte_foretagne_afskrivninger_kroner(), overskydende_genopførelsesudgift_kroner())) } ellers { [] }
    | fristsvigt_efter_stk11() -> par21_forsikringsresultat_matcher() && placering_omfattet() && input.ejendomsavancebeskatningslov10_anvendes_samtidig && rettidig_genopførelse() == Falskt && input.opgørelsesår == seneste_genopførelsesår()
    | antal_tillægsår() -> hvis fristsvigt_efter_stk11() { penge_positivt_beløb(seneste_genopførelsesår() - par21().indkomstår) } ellers { 0 }
    | fem_procent_tillæg_kroner() -> hvis fristsvigt_efter_stk11() { par21().beregnede_genvundne_afskrivninger_før_par24_kroner * 5 * antal_tillægsår() / 100 } ellers { 0 }
    | skattepligtige_genvundne_afskrivninger_ved_fristsvigt_kroner() -> hvis fristsvigt_efter_stk11() { par21().beregnede_genvundne_afskrivninger_før_par24_kroner + fem_procent_tillæg_kroner() } ellers { 0 }
    | samlet_skattepligtigt_beløb_kroner() -> skattepligtigt_overskydende_forskelsbeløb_kroner() + skattepligtige_genvundne_afskrivninger_ved_fristsvigt_kroner()
    | resultat() -> Afskrivningslov24Resultat(
        skatteyder = par21().skatteyder,
        par21_forsikringsresultat_matcher = par21_forsikringsresultat_matcher(),
        ordinært_seneste_genopførelsesår = ordinært_seneste_genopførelsesår(),
        seneste_genopførelsesår = seneste_genopførelsesår(),
        rettidig_genopførelse = rettidig_genopførelse(),
        placering_omfattet = placering_omfattet(),
        anden_ejendom = anden_ejendom(),
        genopførelsesudgifter_mindst_forsikringssum_ved_anden_ejendom = anden_ejendom_mindst_forsikringssum(),
        ejendomsavancebeskatningslov10_anvendes_samtidig = input.ejendomsavancebeskatningslov10_anvendes_samtidig,
        par24_finder_anvendelse = par24_finder_anvendelse(),
        genvundne_afskrivninger_udskudt_kroner = genvundne_afskrivninger_udskudt_kroner(),
        forskelsbeløb_forsikringssum_over_genopførelsesudgift_kroner = forskelsbeløb_kroner(),
        forskelsbeløb_fragår_i_afskrivningsgrundlaget_kroner = forskelsbeløb_kroner(),
        forskelsbeløb_anses_som_foretaget_afskrivning_kroner = forskelsbeløb_kroner(),
        skattepligtigt_overskydende_forskelsbeløb_kroner = skattepligtigt_overskydende_forskelsbeløb_kroner(),
        overskydende_genopførelsesudgift_kroner = overskydende_genopførelsesudgift_kroner(),
        nyt_afskrivningsgrundlag_efter_stk4_eller_stk8_kroner = overskydende_genopførelsesudgift_kroner(),
        videreført_afskrivningsgrundlag_kroner = videreført_afskrivningsgrundlag_kroner(),
        videreførte_foretagne_afskrivninger_kroner = videreførte_foretagne_afskrivninger_kroner(),
        samlet_afskrivningsgrundlag_efter_genopførelse_kroner = samlet_afskrivningsgrundlag_efter_genopførelse_kroner(),
        fordelinger = fordelinger(),
        fristsvigt_efter_stk11 = fristsvigt_efter_stk11(),
        antal_tillægsår = antal_tillægsår(),
        fem_procent_tillæg_kroner = fem_procent_tillæg_kroner(),
        skattepligtige_genvundne_afskrivninger_ved_fristsvigt_kroner = skattepligtige_genvundne_afskrivninger_ved_fristsvigt_kroner(),
        samlet_skattepligtigt_beløb_kroner = samlet_skattepligtigt_beløb_kroner()
    )
}
| afskrivningslov24_sag(input: Afskrivningslov24Input) -> Afskrivningslov24Sag(input)
| afskrivningslov24_resultat(input: Afskrivningslov24Input) -> afskrivningslov24_sag(input).resultat()
--@end:afskrivningsloven_par24--

--@label:afskrivningsloven_par25::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par25_par26_juridisk_vejledning::scale_source:afskrivningsloven_par25_hjemfaldsbekendtgørelse--
----
§ 25. Udgifter til anskaffelse og forbedring af bygninger, som ikke opfylder
betingelserne for afskrivning i § 14, kan afskrives, såfremt bygningen er opført
på lejet grund, bortset fra bygninger, der anvendes til beboelse eller
ikkeerhvervsmæssige formål. Afskrivningen kan fra og med anskaffelsesåret eller
året for forbedringen foretages med indtil 3 pct. årligt af anskaffelsessummen
eller forbedringsudgiften, jf. dog 3. pkt. Afskrivning efter 1. og 2. pkt. på
udgifter til erhvervelse eller forbedring af bygninger, der er afholdt før den
1. januar 2023, kan foretages med indtil 4 pct. årligt af anskaffelsessummen
eller forbedringsudgiften. Den årlige afskrivning kan dog ikke overstige et
beløb svarende til, at afskrivning sker med lige store årlige beløb over
lejeperioden, hvis lejemålet er indgået for et bestemt tidsrum eller over en
periode, hvori lejeren er sikret uopsigelighed. Såfremt der ved lejemålets ophør
ydes erstatning for bygningerne med et beløb, der er fastsat på forhånd,
reduceres afskrivningsgrundlaget med dette beløb.

Stk. 2. For fast ejendom, hvorpå der hviler en nedlæggelses- eller
nedrivningsklausul, og som ikke opfylder betingelserne for afskrivning i § 14,
finder reglerne i stk. 1 tilsvarende anvendelse.

Stk. 3. Anskaffelsessummen for fast ejendom, hvorpå der hviler en
hjemfaldsforpligtelse eller anden forpligtelse af lignende art, jf. dog stk. 2,
kan fra og med anskaffelsesåret afskrives over antallet af år indtil det
tidspunkt, hvor hjemfaldsretten kan gøres gældende, bortset fra fast ejendom,
der anvendes til beboelse eller ikkeerhvervsmæssige formål. Såfremt ejendommens
bygninger opfylder betingelserne for afskrivning i § 14, skal
anskaffelsessummen for bygningerne afskrives efter den nævnte bestemmelse.
Afskrivningen efter 1. pkt. sker efter en progressivt stigende skala, der
fastsættes af Skatterådet. Hvis der ved hjemfaldet skal ske tilbagebetaling
eller ydes erstatning med et på forhånd fastsat beløb, reduceres
afskrivningsgrundlaget med beløbet.

Stk. 4. Anvendes en væsentlig del af en ejendom, der omfattes af stk. 1, 2 eller
3, erhvervsmæssigt til andre formål end beboelse, kan der foretages afskrivning
på så stor en del af anskaffelsessummen, som forholdsmæssigt svarer til denne
del af ejendommen.

Stk. 5. Installationer, der udelukkende tjener bygninger, hvorpå der kan
afskrives efter stk. 1, 2 eller 3, behandles og afskrives som de nævnte
bygninger.

Stk. 6. Der kan ikke afskrives efter stk. 1 eller 2 i det indkomstår, hvori
lejemålet er ophørt eller nedlæggelsen eller nedrivningen er sket. Der kan
heller ikke afskrives i det indkomstår, hvori en nedlæggelsesklausul,
nedrivningsklausul eller hjemfaldsforpligtelse opgives. Ligeledes kan der ikke
afskrives i det indkomstår, hvori en bygning eller ejendom omfattet af stk. 1,
2 eller 3 sælges.

Stk. 7. Der kan ikke afskrives efter stk. 1 eller 2, hvis der som følge af, at
den ene part har bestemmende indflydelse på den anden parts handlemåde eller ved
lejemål mellem nærtstående, ikke består en reel risiko for opsigelse af
lejemålet. Endvidere kan der ikke afskrives ved lejemål, hvor lejemålet er
indgået mellem selskaber eller mellem personer og selskaber, i det omfang
nærtstående har bestemmende indflydelse i det eller de selskaber, der er part i
lejemålet. Bestemmende indflydelse vil altid foreligge, såfremt en eller flere
personer på grund af ejerskab eller rådighed over stemmerettigheder direkte
eller indirekte ejer mere end 50 pct. af aktiekapitalen eller råder over mere
end 50 pct. af stemmerne i et selskab, der er part i lejemålet. I øvrige
tilfælde foreligger der bestemmende indflydelse, såfremt der direkte eller
indirekte ejes mere end 50 pct. i ejerandel. Som nærtstående anses den
skattepligtiges ægtefælle, forældre og bedsteforældre samt børn og børnebørn og
disses ægtefæller eller dødsboer efter de nævnte personer. Stedbarns- og
adoptivforhold sidestilles med ægte slægtskabsforhold. Tilsvarende kan der ikke
afskrives, hvis der ikke består en reel risiko for, at en nedlæggelses- eller
nedrivningsklausul vil blive gjort gældende. Der kan ikke afskrives, hvis der
ydes erstatning efter vurdering for bygninger eller ejendom omfattet af stk. 1,
2 eller 3, eller hvis lejeren er tillagt en køberet til den lejede grund ved
lejeperiodens udløb på vilkår, der afviger fra markedsvilkår.
----

--@label:afskrivningsloven_par25_hjemfaldsskala::source:afskrivningsloven_par25_hjemfaldsbekendtgørelse--
----
§ 1. Efterstående tabel skal anvendes ved afskrivning på ejendomme med
hjemfaldsforpligtelse eller anden forpligtelse af lignende art.

§ 2. Det beløb, der årligt kan afskrives på ejendomme, hvorpå der hviler en
hjemfaldsforpligtelse eller anden forpligtelse af lignende art, beregnes
således: Først foretages en beløbsmæssig opgørelse af hjemfaldsbyrden. Dette
sker ved, at ejerens faktiske erhvervelsessum (købesum tillagt evt. byggesum)
nedsættes med det beløb, der tilbagebetales ved hjemfald, ligesom der foretages
fradrag for beløb, der er afskrevet efter de tidligere regler om ekstraordinære
afskrivninger, samt for anskaffelsessummer for installationer, der afskrives
særskilt. Dernæst opgøres antallet af år fra anskaffelsestidspunktet til
hjemfaldstidspunktet. Hjemfaldsbyrden multipliceres herefter med den faktor i
tabellens kolonne d, som står ud for det tal i kolonne c, der angiver antallet
af år fra anskaffelsestidspunktet til hjemfaldstidspunktet. Herved beregnes den
korrigerede hjemfaldsbyrde. Derpå opgøres antallet af år fra henholdsvis
indkomstårets begyndelse og indkomstårets afslutning til hjemfaldstidspunktet.
Det beløb, der kan afskrives pr. 10.000 kr. korrigeret hjemfaldsbyrde, kan
herefter aflæses i kolonne b mellem de to tal i kolonne a, der angiver antallet
af år fra henholdsvis indkomstårets begyndelse og indkomstårets afslutning til
hjemfaldstidspunktet.
----

--@begin:afskrivningsloven_par25--
# Afskrivningslov25Aktivart = Al25BygningPåLejetGrund | Al25EjendomMedNedlæggelsesEllerNedrivningsklausul | Al25EjendomMedHjemfaldsforpligtelse | Al25InstallationPåLejetGrund | Al25InstallationVedNedlæggelsesEllerNedrivningsklausul | Al25InstallationVedHjemfaldsforpligtelse
# Afskrivningslov25Hjemmel = Al25Stk1LejetGrund | Al25Stk2NedlæggelsesEllerNedrivningsklausul | Al25Stk3Hjemfaldsforpligtelse
# Afskrivningslov25Hændelse = Al25FortsatAnvendelse | Al25LejemålOphørt | Al25NedlæggelseSket | Al25NedrivningSket | Al25NedlæggelsesEllerNedrivningsklausulOpgivet | Al25HjemfaldsforpligtelseOpgivet | Al25AktivSolgt
# Afskrivningslov25NærtståendeRelation = Al25IkkeNærtstående | Al25Ægtefælle | Al25ForælderEllerBedsteforælder | Al25BarnEllerBarnebarn | Al25ÆgtefælleTilBarnEllerBarnebarn | Al25DødsboEfterNærtstående | Al25StedbarnsEllerAdoptivforhold
# Afskrivningslov25Kontrol(part_kapitalandel_basispoint: Heltal, part_stemmerettigheder_basispoint: Heltal, part_anden_bestemmende_indflydelse: Boolsk, relation_mellem_udlejer_og_lejer: Afskrivningslov25NærtståendeRelation, nærtstående_kapitalandel_basispoint: Heltal, nærtstående_stemmerettigheder_basispoint: Heltal, nærtstående_anden_bestemmende_indflydelse: Boolsk, reel_risiko_for_opsigelse_af_lejemålet: Boolsk, reel_risiko_for_at_klausul_gøres_gældende: Boolsk, erstatning_ydes_efter_vurdering: Boolsk, køberet_til_lejet_grund_afviger_fra_markedsvilkår: Boolsk)
# Afskrivningslov25Grundlag(skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov25Aktivart, anskaffelses_eller_forbedringsår: Heltal, anskaffelses_eller_forbedringsudgift_kroner: Heltal, beløb_henført_til_par14_bygninger_kroner: Heltal, fast_tilbagebetaling_eller_erstatning_kroner: Heltal, tidligere_ekstraordinære_afskrivninger_kroner: Heltal, særskilt_afskrevne_installationers_anskaffelsessum_kroner: Heltal, samlet_anvendelse_enheder: Heltal, erhvervsmæssig_anvendelse_enheder: Heltal, væsentlig_erhvervsmæssig_del_efter_konkret_vurdering: Boolsk, leje_eller_uopsigelighedsperiode_år: Heltal, hjemfaldsår: Heltal, bygning_opfylder_par14: Boolsk, udelukkende_beboelse_eller_ikkeerhvervsmæssigt_formål: Boolsk, installation_tjener_udelukkende_omfattet_bygning: Boolsk, kontrol: Afskrivningslov25Kontrol)
# Afskrivningslov25Input(indkomstår: Heltal, grundlag: Afskrivningslov25Grundlag, tidligere_foretagne_afskrivninger_kroner: Heltal, valgt_afskrivning_kroner: Heltal, hændelse: Afskrivningslov25Hændelse)
# Afskrivningslov25Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov25Aktivart, hjemmel: Afskrivningslov25Hjemmel, hændelse: Afskrivningslov25Hændelse, omfattet_af_par25: Boolsk, grundlag_gyldigt: Boolsk, afskrivning_afskåret_efter_stk6: Boolsk, afskrivning_afskåret_efter_stk7: Boolsk, afskrivningsgrundlag_før_erhvervsandel_kroner: Heltal, erhvervsandel_basispoint: Heltal, afskrivningsgrundlag_kroner: Heltal, højeste_ordinære_sats_basispoint: Heltal, lineært_lejeperiodemaksimum_kroner: Heltal, hjemfald_multiplikationsfaktor_millital: Heltal, hjemfald_fradrag_pr_10000_kroner: Heltal, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal, samlede_foretagne_afskrivninger_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal)

| afskrivningslov25_hjemmel(aktivart: Afskrivningslov25Aktivart) -> match aktivart {
    | Al25BygningPåLejetGrund -> Al25Stk1LejetGrund
    | Al25InstallationPåLejetGrund -> Al25Stk1LejetGrund
    | Al25EjendomMedNedlæggelsesEllerNedrivningsklausul -> Al25Stk2NedlæggelsesEllerNedrivningsklausul
    | Al25InstallationVedNedlæggelsesEllerNedrivningsklausul -> Al25Stk2NedlæggelsesEllerNedrivningsklausul
    | Al25EjendomMedHjemfaldsforpligtelse -> Al25Stk3Hjemfaldsforpligtelse
    | Al25InstallationVedHjemfaldsforpligtelse -> Al25Stk3Hjemfaldsforpligtelse
}
| afskrivningslov25_er_installation(aktivart: Afskrivningslov25Aktivart) -> aktivart == Al25InstallationPåLejetGrund || aktivart == Al25InstallationVedNedlæggelsesEllerNedrivningsklausul || aktivart == Al25InstallationVedHjemfaldsforpligtelse
| afskrivningslov25_er_stk1_eller_stk2(hjemmel: Afskrivningslov25Hjemmel) -> hjemmel == Al25Stk1LejetGrund || hjemmel == Al25Stk2NedlæggelsesEllerNedrivningsklausul
| afskrivningslov25_er_klausul(hjemmel: Afskrivningslov25Hjemmel) -> hjemmel == Al25Stk2NedlæggelsesEllerNedrivningsklausul
| afskrivningslov25_er_hjemfald(hjemmel: Afskrivningslov25Hjemmel) -> hjemmel == Al25Stk3Hjemfaldsforpligtelse
| afskrivningslov25_erhvervsandel_basispoint(grundlag: Afskrivningslov25Grundlag) -> hvis grundlag.samlet_anvendelse_enheder <= 0 || grundlag.erhvervsmæssig_anvendelse_enheder <= 0 || grundlag.erhvervsmæssig_anvendelse_enheder > grundlag.samlet_anvendelse_enheder { 0 } ellers hvis grundlag.erhvervsmæssig_anvendelse_enheder == grundlag.samlet_anvendelse_enheder { 10000 } ellers hvis grundlag.væsentlig_erhvervsmæssig_del_efter_konkret_vurdering { grundlag.erhvervsmæssig_anvendelse_enheder * 10000 / grundlag.samlet_anvendelse_enheder } ellers { 0 }
| afskrivningslov25_basispoint_gyldige(basispoint: Heltal) -> basispoint >= 0 && basispoint <= 10000
| afskrivningslov25_kontrol_gyldig(kontrol: Afskrivningslov25Kontrol) -> afskrivningslov25_basispoint_gyldige(kontrol.part_kapitalandel_basispoint) && afskrivningslov25_basispoint_gyldige(kontrol.part_stemmerettigheder_basispoint) && afskrivningslov25_basispoint_gyldige(kontrol.nærtstående_kapitalandel_basispoint) && afskrivningslov25_basispoint_gyldige(kontrol.nærtstående_stemmerettigheder_basispoint)
| afskrivningslov25_bestemmende_indflydelse(kapitalandel_basispoint: Heltal, stemmerettigheder_basispoint: Heltal, anden_bestemmende_indflydelse: Boolsk) -> kapitalandel_basispoint > 5000 || stemmerettigheder_basispoint > 5000 || anden_bestemmende_indflydelse
| afskrivningslov25_part_har_bestemmende_indflydelse(kontrol: Afskrivningslov25Kontrol) -> afskrivningslov25_bestemmende_indflydelse(kontrol.part_kapitalandel_basispoint, kontrol.part_stemmerettigheder_basispoint, kontrol.part_anden_bestemmende_indflydelse)
| afskrivningslov25_nærtstående_har_bestemmende_indflydelse(kontrol: Afskrivningslov25Kontrol) -> afskrivningslov25_bestemmende_indflydelse(kontrol.nærtstående_kapitalandel_basispoint, kontrol.nærtstående_stemmerettigheder_basispoint, kontrol.nærtstående_anden_bestemmende_indflydelse)
| afskrivningslov25_er_nærtstående(relation: Afskrivningslov25NærtståendeRelation) -> relation != Al25IkkeNærtstående
| afskrivningslov25_opsigelsesrisiko_afskærer(kontrol: Afskrivningslov25Kontrol) -> (afskrivningslov25_part_har_bestemmende_indflydelse(kontrol) || afskrivningslov25_er_nærtstående(kontrol.relation_mellem_udlejer_og_lejer)) && kontrol.reel_risiko_for_opsigelse_af_lejemålet == Falskt
| afskrivningslov25_klausulrisiko_afskærer(grundlag: Afskrivningslov25Grundlag) -> afskrivningslov25_er_klausul(afskrivningslov25_hjemmel(grundlag.aktivart)) && grundlag.kontrol.reel_risiko_for_at_klausul_gøres_gældende == Falskt
| afskrivningslov25_stk7_afskærer(grundlag: Afskrivningslov25Grundlag) -> grundlag.kontrol.erstatning_ydes_efter_vurdering || grundlag.kontrol.køberet_til_lejet_grund_afviger_fra_markedsvilkår || (afskrivningslov25_er_stk1_eller_stk2(afskrivningslov25_hjemmel(grundlag.aktivart)) && (afskrivningslov25_opsigelsesrisiko_afskærer(grundlag.kontrol) || afskrivningslov25_nærtstående_har_bestemmende_indflydelse(grundlag.kontrol))) || afskrivningslov25_klausulrisiko_afskærer(grundlag)
| afskrivningslov25_stk6_afskærer(hjemmel: Afskrivningslov25Hjemmel, hændelse: Afskrivningslov25Hændelse) -> hændelse == Al25AktivSolgt || hændelse == Al25NedlæggelsesEllerNedrivningsklausulOpgivet || hændelse == Al25HjemfaldsforpligtelseOpgivet || (afskrivningslov25_er_stk1_eller_stk2(hjemmel) && (hændelse == Al25LejemålOphørt || hændelse == Al25NedlæggelseSket || hændelse == Al25NedrivningSket))
| afskrivningslov25_par14_fordeling_gyldig(hjemmel: Afskrivningslov25Hjemmel, bygning_opfylder_par14: Boolsk, beløb_henført_til_par14_bygninger_kroner: Heltal, samlet_anskaffelsesudgift_kroner: Heltal) -> hvis afskrivningslov25_er_hjemfald(hjemmel) { beløb_henført_til_par14_bygninger_kroner >= 0 && beløb_henført_til_par14_bygninger_kroner <= samlet_anskaffelsesudgift_kroner && bygning_opfylder_par14 == (beløb_henført_til_par14_bygninger_kroner > 0) } ellers { bygning_opfylder_par14 == Falskt && beløb_henført_til_par14_bygninger_kroner == 0 }
| afskrivningslov25_hjemfald_multiplikationsfaktor_millital(år_fra_anskaffelse_til_hjemfald: Heltal) -> hvis år_fra_anskaffelse_til_hjemfald > 0 { round(1000.0 / (1.0 - 1.0 / pow(1.04, år_fra_anskaffelse_til_hjemfald))) } ellers { 0 }
| afskrivningslov25_hjemfald_fradrag_pr_10000_kroner(år_til_hjemfald_ved_indkomstårets_begyndelse: Heltal) -> hvis år_til_hjemfald_ved_indkomstårets_begyndelse > 0 { round(10000.0 / pow(1.04, år_til_hjemfald_ved_indkomstårets_begyndelse - 1) - 10000.0 / pow(1.04, år_til_hjemfald_ved_indkomstårets_begyndelse)) } ellers { 0 }
| afskrivningslov25_hjemfald_årets_maksimum_kroner(afskrivningsgrundlag_kroner: Heltal, anskaffelsesår: Heltal, indkomstår: Heltal, hjemfaldsår: Heltal) -> hvis afskrivningsgrundlag_kroner > 0 && hjemfaldsår > indkomstår && hjemfaldsår > anskaffelsesår {
    = faktor_millital = afskrivningslov25_hjemfald_multiplikationsfaktor_millital(hjemfaldsår - anskaffelsesår)
    = korrigeret_hjemfaldsbyrde_kroner = (afskrivningsgrundlag_kroner * faktor_millital + 500) / 1000
    = fradrag_pr_10000_kroner = afskrivningslov25_hjemfald_fradrag_pr_10000_kroner(hjemfaldsår - indkomstår)
    (korrigeret_hjemfaldsbyrde_kroner * fradrag_pr_10000_kroner + 5000) / 10000
} ellers { 0 }

# Afskrivningslov25Sag(input: Afskrivningslov25Input) {
    | hjemmel() -> afskrivningslov25_hjemmel(input.grundlag.aktivart)
    | installation_gyldig() -> afskrivningslov25_er_installation(input.grundlag.aktivart) == Falskt || input.grundlag.installation_tjener_udelukkende_omfattet_bygning
    | art_og_par14_gyldig() -> afskrivningslov25_par14_fordeling_gyldig(hjemmel(), input.grundlag.bygning_opfylder_par14, input.grundlag.beløb_henført_til_par14_bygninger_kroner, input.grundlag.anskaffelses_eller_forbedringsudgift_kroner)
    | grundbeløb_før_erhvervsandel_kroner() -> penge_positivt_beløb(input.grundlag.anskaffelses_eller_forbedringsudgift_kroner - input.grundlag.beløb_henført_til_par14_bygninger_kroner - input.grundlag.fast_tilbagebetaling_eller_erstatning_kroner - hvis afskrivningslov25_er_hjemfald(hjemmel()) { input.grundlag.tidligere_ekstraordinære_afskrivninger_kroner + input.grundlag.særskilt_afskrevne_installationers_anskaffelsessum_kroner } ellers { 0 })
    | erhvervsandel_basispoint() -> afskrivningslov25_erhvervsandel_basispoint(input.grundlag)
    | afskrivningsgrundlag_kroner() -> penge_beløb_gange_basispoint_afrundet_kroner(grundbeløb_før_erhvervsandel_kroner(), erhvervsandel_basispoint())
    | grundlag_gyldigt() -> input.grundlag.anskaffelses_eller_forbedringsår > 0 && input.indkomstår >= input.grundlag.anskaffelses_eller_forbedringsår && input.grundlag.anskaffelses_eller_forbedringsudgift_kroner > 0 && input.grundlag.beløb_henført_til_par14_bygninger_kroner >= 0 && input.grundlag.fast_tilbagebetaling_eller_erstatning_kroner >= 0 && input.grundlag.tidligere_ekstraordinære_afskrivninger_kroner >= 0 && input.grundlag.særskilt_afskrevne_installationers_anskaffelsessum_kroner >= 0 && input.tidligere_foretagne_afskrivninger_kroner >= 0 && input.grundlag.udelukkende_beboelse_eller_ikkeerhvervsmæssigt_formål == Falskt && afskrivningslov25_kontrol_gyldig(input.grundlag.kontrol) && installation_gyldig() && art_og_par14_gyldig() && afskrivningsgrundlag_kroner() > 0 && input.tidligere_foretagne_afskrivninger_kroner <= afskrivningsgrundlag_kroner() && (afskrivningslov25_er_hjemfald(hjemmel()) == Falskt || input.grundlag.hjemfaldsår > input.grundlag.anskaffelses_eller_forbedringsår)
    | afskrivning_afskåret_efter_stk6() -> afskrivningslov25_stk6_afskærer(hjemmel(), input.hændelse)
    | afskrivning_afskåret_efter_stk7() -> afskrivningslov25_stk7_afskærer(input.grundlag)
    | omfattet_af_par25() -> grundlag_gyldigt() && afskrivning_afskåret_efter_stk6() == Falskt && afskrivning_afskåret_efter_stk7() == Falskt
    | højeste_ordinære_sats_basispoint() -> hvis afskrivningslov25_er_hjemfald(hjemmel()) { 0 } ellers hvis input.grundlag.anskaffelses_eller_forbedringsår < 2023 { 400 } ellers { 300 }
    | ordinært_satsmaksimum_kroner() -> penge_beløb_gange_basispoint_afrundet_kroner(afskrivningsgrundlag_kroner(), højeste_ordinære_sats_basispoint())
    | lineært_lejeperiodemaksimum_kroner() -> hvis input.grundlag.leje_eller_uopsigelighedsperiode_år > 0 { (afskrivningsgrundlag_kroner() + input.grundlag.leje_eller_uopsigelighedsperiode_år / 2) / input.grundlag.leje_eller_uopsigelighedsperiode_år } ellers { ordinært_satsmaksimum_kroner() }
    | hjemfald_multiplikationsfaktor_millital() -> hvis afskrivningslov25_er_hjemfald(hjemmel()) { afskrivningslov25_hjemfald_multiplikationsfaktor_millital(input.grundlag.hjemfaldsår - input.grundlag.anskaffelses_eller_forbedringsår) } ellers { 0 }
    | hjemfald_fradrag_pr_10000_kroner() -> hvis afskrivningslov25_er_hjemfald(hjemmel()) { afskrivningslov25_hjemfald_fradrag_pr_10000_kroner(input.grundlag.hjemfaldsår - input.indkomstår) } ellers { 0 }
    | maksimum_før_rest_kroner() -> hvis afskrivningslov25_er_hjemfald(hjemmel()) { afskrivningslov25_hjemfald_årets_maksimum_kroner(afskrivningsgrundlag_kroner(), input.grundlag.anskaffelses_eller_forbedringsår, input.indkomstår, input.grundlag.hjemfaldsår) } ellers { penge_mindste_beløb(ordinært_satsmaksimum_kroner(), lineært_lejeperiodemaksimum_kroner()) }
    | rest_før_årets_afskrivning_kroner() -> penge_positivt_beløb(afskrivningsgrundlag_kroner() - input.tidligere_foretagne_afskrivninger_kroner)
    | højeste_afskrivning_kroner() -> hvis omfattet_af_par25() { penge_mindste_beløb(rest_før_årets_afskrivning_kroner(), maksimum_før_rest_kroner()) } ellers { 0 }
    | valg_gyldigt() -> input.valgt_afskrivning_kroner >= 0 && input.valgt_afskrivning_kroner <= højeste_afskrivning_kroner()
    | fradrag_i_skattepligtig_indkomst_kroner() -> hvis valg_gyldigt() { input.valgt_afskrivning_kroner } ellers { 0 }
    | samlede_foretagne_afskrivninger_kroner() -> input.tidligere_foretagne_afskrivninger_kroner + fradrag_i_skattepligtig_indkomst_kroner()
    | resterende_afskrivningsgrundlag_kroner() -> penge_positivt_beløb(afskrivningsgrundlag_kroner() - samlede_foretagne_afskrivninger_kroner())
    | resultat() -> Afskrivningslov25Resultat(
        indkomstår = input.indkomstår,
        skatteyder = input.grundlag.skatteyder,
        aktivart = input.grundlag.aktivart,
        hjemmel = hjemmel(),
        hændelse = input.hændelse,
        omfattet_af_par25 = omfattet_af_par25(),
        grundlag_gyldigt = grundlag_gyldigt(),
        afskrivning_afskåret_efter_stk6 = afskrivning_afskåret_efter_stk6(),
        afskrivning_afskåret_efter_stk7 = afskrivning_afskåret_efter_stk7(),
        afskrivningsgrundlag_før_erhvervsandel_kroner = grundbeløb_før_erhvervsandel_kroner(),
        erhvervsandel_basispoint = erhvervsandel_basispoint(),
        afskrivningsgrundlag_kroner = afskrivningsgrundlag_kroner(),
        højeste_ordinære_sats_basispoint = højeste_ordinære_sats_basispoint(),
        lineært_lejeperiodemaksimum_kroner = lineært_lejeperiodemaksimum_kroner(),
        hjemfald_multiplikationsfaktor_millital = hjemfald_multiplikationsfaktor_millital(),
        hjemfald_fradrag_pr_10000_kroner = hjemfald_fradrag_pr_10000_kroner(),
        højeste_afskrivning_kroner = højeste_afskrivning_kroner(),
        valgt_afskrivning_kroner = input.valgt_afskrivning_kroner,
        valg_gyldigt = valg_gyldigt(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        samlede_foretagne_afskrivninger_kroner = samlede_foretagne_afskrivninger_kroner(),
        resterende_afskrivningsgrundlag_kroner = resterende_afskrivningsgrundlag_kroner()
    )
}
| afskrivningslov25_sag(input: Afskrivningslov25Input) -> Afskrivningslov25Sag(input)
| afskrivningslov25_resultat(input: Afskrivningslov25Input) -> afskrivningslov25_sag(input).resultat()
--@end:afskrivningsloven_par25--

--@label:afskrivningsloven_par26::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par25_par26_juridisk_vejledning--
----
§ 26. Ved ophør af lejemålet eller nedlæggelse af en lejlighed m.v., inden der
er foretaget fuld afskrivning af anskaffelsessummen for bygningerne m.v. efter
§ 25, stk. 1 eller 2, kan det uafskrevne beløb fradrages i den skattepligtige
indkomst i det indkomstår, hvori lejemålet ophører eller nedlæggelsen sker.
Dette gælder dog ikke, hvis lejemålet ophører som følge af, at lejeren køber
grunden.

Stk. 2. Bestemmelserne i § 21 finder tilsvarende anvendelse ved salg af
bygninger og ejendomme, hvorpå der er afskrevet efter § 25, stk. 1-3. Tab kan
dog ikke fradrages.

Stk. 3. Nedrives en bygning, der er afskrevet, som følge af, at den er opført på
lejet grund, eller der påhviler ejendommen en hjemfaldsforpligtelse eller anden
forpligtelse af lignende art, kan der i den skattepligtige indkomst for det
indkomstår, hvori nedrivning sker, foretages et nedrivningsfradrag. Fradraget
udgør det uafskrevne beløb nedsat med eventuelle salgssummer for materialer
m.v. For bygninger omfattet af § 25, stk. 4, beregnes det uafskrevne beløb på
grundlag af den gennemsnitlige andel af anskaffelsessummen, som de
afskrivningsberettigede udgifter til anskaffelse og forbedring udgør.
----

--@begin:afskrivningsloven_par26--
# Afskrivningslov26Input(par25_resultat: Afskrivningslov25Resultat, hændelse: Afskrivningslov25Hændelse, lejer_køber_grunden: Boolsk, salgssum_for_aktiv_kroner: Heltal, salgssum_for_materialer_kroner: Heltal, gennemsnitlig_afskrivningsberettiget_andel_basispoint: Heltal)
# Afskrivningslov26Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, hjemmel: Afskrivningslov25Hjemmel, hændelse_matcher: Boolsk, uafskrevet_beløb_kroner: Heltal, gennemsnitlig_afskrivningsberettiget_andel_basispoint: Heltal, uafskrevet_beløb_efter_gennemsnitlig_andel_kroner: Heltal, fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner: Heltal, beregnede_genvundne_afskrivninger_kroner: Heltal, skattepligtige_genvundne_afskrivninger_kroner: Heltal, råt_tab_ved_salg_kroner: Heltal, fradragsberettiget_tab_ved_salg_kroner: Heltal, nedrivningsfradrag_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal)

| afskrivningslov26_hændelse_er_omfattet(hændelse: Afskrivningslov25Hændelse) -> hændelse == Al25LejemålOphørt || hændelse == Al25NedlæggelseSket || hændelse == Al25NedrivningSket || hændelse == Al25AktivSolgt
| afskrivningslov26_hændelse_matcher(input: Afskrivningslov26Input) -> input.par25_resultat.grundlag_gyldigt && input.par25_resultat.afskrivning_afskåret_efter_stk6 && input.par25_resultat.indkomstår > 0 && afskrivningslov26_hændelse_er_omfattet(input.hændelse) && input.hændelse == input.par25_resultat.hændelse
| afskrivningslov26_nedrivning_omfattet(aktivart: Afskrivningslov25Aktivart) -> aktivart == Al25BygningPåLejetGrund || aktivart == Al25InstallationPåLejetGrund || aktivart == Al25EjendomMedHjemfaldsforpligtelse || aktivart == Al25InstallationVedHjemfaldsforpligtelse

# Afskrivningslov26Sag(input: Afskrivningslov26Input) {
    | par25() -> input.par25_resultat
    | hændelse_matcher() -> afskrivningslov26_hændelse_matcher(input)
    | uafskrevet_beløb_kroner() -> par25().resterende_afskrivningsgrundlag_kroner
    | gennemsnitlig_andel_gyldig() -> afskrivningslov25_basispoint_gyldige(input.gennemsnitlig_afskrivningsberettiget_andel_basispoint)
    | uafskrevet_beløb_efter_gennemsnitlig_andel_kroner() -> hvis par25().erhvervsandel_basispoint < 10000 && gennemsnitlig_andel_gyldig() { penge_positivt_beløb(penge_beløb_gange_basispoint_afrundet_kroner(par25().afskrivningsgrundlag_før_erhvervsandel_kroner, input.gennemsnitlig_afskrivningsberettiget_andel_basispoint) - par25().samlede_foretagne_afskrivninger_kroner) } ellers { uafskrevet_beløb_kroner() }
    | fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner() -> hvis hændelse_matcher() && afskrivningslov25_er_stk1_eller_stk2(par25().hjemmel) && (input.hændelse == Al25LejemålOphørt || input.hændelse == Al25NedlæggelseSket) && input.lejer_køber_grunden == Falskt { uafskrevet_beløb_kroner() } ellers { 0 }
    | rå_fortjeneste_ved_salg_kroner() -> hvis hændelse_matcher() && input.hændelse == Al25AktivSolgt { penge_positivt_beløb(penge_positivt_beløb(input.salgssum_for_aktiv_kroner) - uafskrevet_beløb_kroner()) } ellers { 0 }
    | beregnede_genvundne_afskrivninger_kroner() -> penge_mindste_beløb(par25().samlede_foretagne_afskrivninger_kroner, rå_fortjeneste_ved_salg_kroner())
    | råt_tab_ved_salg_kroner() -> hvis hændelse_matcher() && input.hændelse == Al25AktivSolgt { penge_positivt_beløb(uafskrevet_beløb_kroner() - penge_positivt_beløb(input.salgssum_for_aktiv_kroner)) } ellers { 0 }
    | nedrivningsfradrag_kroner() -> hvis hændelse_matcher() && input.hændelse == Al25NedrivningSket && afskrivningslov26_nedrivning_omfattet(par25().aktivart) && gennemsnitlig_andel_gyldig() { penge_positivt_beløb(uafskrevet_beløb_efter_gennemsnitlig_andel_kroner() - penge_positivt_beløb(input.salgssum_for_materialer_kroner)) } ellers { 0 }
    | samlet_fradrag_i_skattepligtig_indkomst_kroner() -> fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner() + nedrivningsfradrag_kroner()
    | resultat() -> Afskrivningslov26Resultat(
        indkomstår = par25().indkomstår,
        skatteyder = par25().skatteyder,
        hjemmel = par25().hjemmel,
        hændelse_matcher = hændelse_matcher(),
        uafskrevet_beløb_kroner = uafskrevet_beløb_kroner(),
        gennemsnitlig_afskrivningsberettiget_andel_basispoint = input.gennemsnitlig_afskrivningsberettiget_andel_basispoint,
        uafskrevet_beløb_efter_gennemsnitlig_andel_kroner = uafskrevet_beløb_efter_gennemsnitlig_andel_kroner(),
        fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner = fradrag_ved_lejemålsophør_eller_nedlæggelse_kroner(),
        beregnede_genvundne_afskrivninger_kroner = beregnede_genvundne_afskrivninger_kroner(),
        skattepligtige_genvundne_afskrivninger_kroner = beregnede_genvundne_afskrivninger_kroner(),
        råt_tab_ved_salg_kroner = råt_tab_ved_salg_kroner(),
        fradragsberettiget_tab_ved_salg_kroner = 0,
        nedrivningsfradrag_kroner = nedrivningsfradrag_kroner(),
        samlet_fradrag_i_skattepligtig_indkomst_kroner = samlet_fradrag_i_skattepligtig_indkomst_kroner()
    )
}
| afskrivningslov26_sag(input: Afskrivningslov26Input) -> Afskrivningslov26Sag(input)
| afskrivningslov26_resultat(input: Afskrivningslov26Input) -> afskrivningslov26_sag(input).resultat()
--@end:afskrivningsloven_par26--

--@label:afskrivningsloven_par27::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par27_juridisk_vejledning--
----
§ 27. Udgifter afholdt til opførelse af dræningsanlæg og jordfaste dele af
markvandingsanlæg på jordbrugsbedrifter afskrives med indtil 20 pct. årligt i
den skattepligtige indkomst fra og med det indkomstår, hvori anlægget er
færdiggjort og benyttes erhvervsmæssigt. Det er en betingelse, at anlægget og
den bedrift, som anlægget skal tjene, har samme ejer, jf. dog stk. 2.

Stk. 2. Afholdes udgiften til opførelse af et dræningsanlæg eller jordfaste
dele af et markvandingsanlæg af forpagteren af den bedrift, som anlægget skal
tjene, kan forpagteren afskrive udgiften efter reglerne i stk. 1, 1. pkt.

Stk. 3. Ved salg af den ejendom, hvor anlægget findes, inden udgiften er
afskrevet fuldt ud, indtræder erhververen i overdragerens skattemæssige stilling
vedrørende afskrivningen.

Stk. 4. Ved ophør af forpagtningsaftalen, inden forpagteren har afskrevet
udgiften fuldt ud, indtræder ejeren i forpagterens skattemæssige stilling
vedrørende afskrivningen. I tilfælde, hvor der er sket videreforpagtning fra en
forpagter til en anden forpagter, indtræder den anden forpagter i den første
forpagters skattemæssige stilling vedrørende afskrivningen.
----

--@begin:afskrivningsloven_par27--
# Afskrivningslov27Anlægsart = Al27Dræningsanlæg | Al27JordfastDelAfMarkvandingsanlæg
# Afskrivningslov27Rettighedshaver = Al27Ejer | Al27Forpagter | Al27Videreforpagter
# Afskrivningslov27Position(skatteyder: AfskrivningslovSkatteyder, rettighedshaver: Afskrivningslov27Rettighedshaver, anlægsart: Afskrivningslov27Anlægsart, oprindelig_udgift_kroner: Heltal, samlede_foretagne_afskrivninger_kroner: Heltal)
# Afskrivningslov27Overdragelse(efterfølger_skatteyder: AfskrivningslovSkatteyder, efterfølger_rettighedshaver: Afskrivningslov27Rettighedshaver)
# Afskrivningslov27Hændelse = Al27FortsatRettighed | Al27EjendomSolgt(overdragelse: Afskrivningslov27Overdragelse) | Al27ForpagtningsaftaleOphørt(overdragelse: Afskrivningslov27Overdragelse) | Al27Videreforpagtning(overdragelse: Afskrivningslov27Overdragelse)
# Afskrivningslov27Input(indkomstår: Heltal, position: Afskrivningslov27Position, færdiggjort_år: Heltal, benyttes_erhvervsmæssigt: Boolsk, anlæg_på_jordbrugsbedrift: Boolsk, anlæg_og_bedrift_har_samme_ejer: Boolsk, forpagter_har_afholdt_udgiften: Boolsk, valgt_afskrivning_kroner: Heltal, hændelse: Afskrivningslov27Hændelse)
# Afskrivningslov27Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, rettighedshaver_før: Afskrivningslov27Rettighedshaver, anlægsart: Afskrivningslov27Anlægsart, omfattet_af_par27: Boolsk, position_gyldig: Boolsk, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal, overdragelse_gyldig: Boolsk, succession_sker: Boolsk, genvundne_afskrivninger_ved_overdragelse_kroner: Heltal, position_efter: Afskrivningslov27Position)

| afskrivningslov27_position(skatteyder: AfskrivningslovSkatteyder, rettighedshaver: Afskrivningslov27Rettighedshaver, anlægsart: Afskrivningslov27Anlægsart, oprindelig_udgift_kroner: Heltal, samlede_foretagne_afskrivninger_kroner: Heltal) -> Afskrivningslov27Position(skatteyder = skatteyder, rettighedshaver = rettighedshaver, anlægsart = anlægsart, oprindelig_udgift_kroner = oprindelig_udgift_kroner, samlede_foretagne_afskrivninger_kroner = samlede_foretagne_afskrivninger_kroner)
| afskrivningslov27_overdragelse(input: Afskrivningslov27Input) -> match input.hændelse {
    | Al27FortsatRettighed -> Afskrivningslov27Overdragelse(efterfølger_skatteyder = input.position.skatteyder, efterfølger_rettighedshaver = input.position.rettighedshaver)
    | Al27EjendomSolgt(overdragelse) -> overdragelse
    | Al27ForpagtningsaftaleOphørt(overdragelse) -> overdragelse
    | Al27Videreforpagtning(overdragelse) -> overdragelse
}
| afskrivningslov27_overdragelse_gyldig(input: Afskrivningslov27Input) -> match input.hændelse {
    | Al27FortsatRettighed -> Sandt
    | Al27EjendomSolgt(overdragelse) -> input.position.rettighedshaver == Al27Ejer && overdragelse.efterfølger_rettighedshaver == Al27Ejer
    | Al27ForpagtningsaftaleOphørt(overdragelse) -> (input.position.rettighedshaver == Al27Forpagter || input.position.rettighedshaver == Al27Videreforpagter) && overdragelse.efterfølger_rettighedshaver == Al27Ejer
    | Al27Videreforpagtning(overdragelse) -> (input.position.rettighedshaver == Al27Forpagter || input.position.rettighedshaver == Al27Videreforpagter) && (overdragelse.efterfølger_rettighedshaver == Al27Forpagter || overdragelse.efterfølger_rettighedshaver == Al27Videreforpagter)
}
| afskrivningslov27_er_overdragelse(hændelse: Afskrivningslov27Hændelse) -> hændelse != Al27FortsatRettighed

# Afskrivningslov27Sag(input: Afskrivningslov27Input) {
    | position_gyldig() -> input.position.oprindelig_udgift_kroner > 0 && input.position.samlede_foretagne_afskrivninger_kroner >= 0 && input.position.samlede_foretagne_afskrivninger_kroner <= input.position.oprindelig_udgift_kroner
    | rettighedshaver_opfylder_betingelser() -> hvis input.position.rettighedshaver == Al27Ejer { input.anlæg_og_bedrift_har_samme_ejer } ellers { input.forpagter_har_afholdt_udgiften }
    | omfattet_af_par27() -> position_gyldig() && input.indkomstår >= input.færdiggjort_år && input.færdiggjort_år > 0 && input.benyttes_erhvervsmæssigt && input.anlæg_på_jordbrugsbedrift && rettighedshaver_opfylder_betingelser()
    | rest_før_årets_afskrivning_kroner() -> penge_positivt_beløb(input.position.oprindelig_udgift_kroner - input.position.samlede_foretagne_afskrivninger_kroner)
    | højeste_afskrivning_kroner() -> hvis omfattet_af_par27() { penge_mindste_beløb(rest_før_årets_afskrivning_kroner(), penge_beløb_gange_basispoint_afrundet_kroner(input.position.oprindelig_udgift_kroner, 2000)) } ellers { 0 }
    | valg_gyldigt() -> input.valgt_afskrivning_kroner >= 0 && input.valgt_afskrivning_kroner <= højeste_afskrivning_kroner()
    | fradrag_i_skattepligtig_indkomst_kroner() -> hvis valg_gyldigt() { input.valgt_afskrivning_kroner } ellers { 0 }
    | samlede_foretagne_afskrivninger_kroner() -> input.position.samlede_foretagne_afskrivninger_kroner + fradrag_i_skattepligtig_indkomst_kroner()
    | resterende_afskrivningsgrundlag_kroner() -> penge_positivt_beløb(input.position.oprindelig_udgift_kroner - samlede_foretagne_afskrivninger_kroner())
    | overdragelse_gyldig() -> position_gyldig() && afskrivningslov27_overdragelse_gyldig(input)
    | succession_sker() -> overdragelse_gyldig() && afskrivningslov27_er_overdragelse(input.hændelse) && resterende_afskrivningsgrundlag_kroner() > 0
    | overdragelse() -> afskrivningslov27_overdragelse(input)
    | opdateret_position_før_succession() -> afskrivningslov27_position(skatteyder = input.position.skatteyder, rettighedshaver = input.position.rettighedshaver, anlægsart = input.position.anlægsart, oprindelig_udgift_kroner = input.position.oprindelig_udgift_kroner, samlede_foretagne_afskrivninger_kroner = samlede_foretagne_afskrivninger_kroner())
    | position_efter() -> hvis succession_sker() { afskrivningslov27_position(skatteyder = overdragelse().efterfølger_skatteyder, rettighedshaver = overdragelse().efterfølger_rettighedshaver, anlægsart = input.position.anlægsart, oprindelig_udgift_kroner = input.position.oprindelig_udgift_kroner, samlede_foretagne_afskrivninger_kroner = samlede_foretagne_afskrivninger_kroner()) } ellers { opdateret_position_før_succession() }
    | resultat() -> Afskrivningslov27Resultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.skatteyder,
        rettighedshaver_før = input.position.rettighedshaver,
        anlægsart = input.position.anlægsart,
        omfattet_af_par27 = omfattet_af_par27(),
        position_gyldig = position_gyldig(),
        højeste_afskrivning_kroner = højeste_afskrivning_kroner(),
        valgt_afskrivning_kroner = input.valgt_afskrivning_kroner,
        valg_gyldigt = valg_gyldigt(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        resterende_afskrivningsgrundlag_kroner = resterende_afskrivningsgrundlag_kroner(),
        overdragelse_gyldig = overdragelse_gyldig(),
        succession_sker = succession_sker(),
        genvundne_afskrivninger_ved_overdragelse_kroner = 0,
        position_efter = position_efter()
    )
}
| afskrivningslov27_sag(input: Afskrivningslov27Input) -> Afskrivningslov27Sag(input)
| afskrivningslov27_resultat(input: Afskrivningslov27Input) -> afskrivningslov27_sag(input).resultat()
--@end:afskrivningsloven_par27--

--@label:afskrivningsloven_par28::source:afskrivningsloven_lbk1222::chapter_guidance:afskrivningsloven_forskudsafskrivning_juridisk_vejledning::guidance:afskrivningsloven_par28_juridisk_vejledning--
----
§ 28. Forskudsafskrivning kan foretages efter reglerne i dette kapitel på
driftsmidler og skibe, der udelukkende skal benyttes erhvervsmæssigt, og hvorpå
der kan afskrives efter kapitel 2.

Stk. 2. Forskudsafskrivning på driftsmidler kan alene foretages, når den
skattepligtige senest den 3. oktober 2000 har indgået bindende aftale om levering
af driftsmidler, eller når den skattepligtige senest den 3. oktober 2000 har
planlagt fremstilling af et sådant aktiv i egen virksomhed.

Stk. 3. Der kan ikke foretages forskudsafskrivninger på aktiver, som er omfattet
af §§ 5 B og 5 C.
----

--@begin:afskrivningsloven_par28--
# AfskrivningslovForskudsAftaleform = Al28BindendeLeveringsaftale | Al28BindendeSkibsbygningsaftale | Al28EgenFremstillingsplan
# AfskrivningslovForskudsSaldoart = Al28Par5Saldo | Al28Par5BSaldo | Al28Par5CSaldo
# AfskrivningslovForskudsPlanlagtAktiv(identifikation: Tekst, planlagt_leverings_eller_færdiggørelsesår: Heltal, aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_kroner: Heltal)
# AfskrivningslovForskudsAftale(skatteyder: AfskrivningslovSkatteyder, par1_par2_resultat: AfskrivningslovPar1Par2Resultat, saldoart: AfskrivningslovForskudsSaldoart, aftaleform: AfskrivningslovForskudsAftaleform, bestillings_eller_planlægningsdato: AfskrivningslovDato, virksomhedsidentifikation: Tekst, planlagte_aktiver: List(AfskrivningslovForskudsPlanlagtAktiv), selskab_omfattet_af_selskabsskattelov1_stk1_nr1_2_eller_4: Boolsk, aktiver_erhverves_med_henblik_på_udlejning_eller_er_udlejet: Boolsk, tilladelse_efter_par5_stk6: Boolsk)
# Afskrivningslov28Resultat(skatteyder: AfskrivningslovSkatteyder, aktivart: AfskrivningslovAktivart, udelukkende_erhvervsmæssigt_benyttet: Boolsk, afskrivningsberettiget_efter_kapitel2: Boolsk, driftsmiddel_eller_skib: Boolsk, aftaleform_matcher_aktiv: Boolsk, driftsmiddelaftale_indgået_rettidigt: Boolsk, saldo_omfattet: Boolsk, omfattet_af_par28: Boolsk)
# Afskrivningslov29GrundbeløbResultat(indkomstår: Heltal, grundbeløb_2010_niveau_kroner: Heltal, reguleringstal_tiendedele: Heltal, reguleret_grundbeløb_kroner: Heltal)
# AfskrivningslovForskudsAnskaffelse(identifikation: Tekst, par3_resultat: Afskrivningslov3Resultat, faktisk_anskaffelsessum_for_skatteyder_kroner: Heltal, forlods_afskrivning_efter_etableringskontoloven_kroner: Heltal)
# AfskrivningslovForskudsÅrspost(indkomstår: Heltal, resterende_forskudsafskrivningsgrundlag_ved_årets_udløb_kroner: Heltal, anvendt_forskudsafskrivningssats_basispoint: Heltal, forskudsafskrivning_kroner: Heltal)
# AfskrivningslovForskudsPosition(aftale: AfskrivningslovForskudsAftale, grundbeløb_resultat: Afskrivningslov29GrundbeløbResultat, årsposter: List(AfskrivningslovForskudsÅrspost), anskaffelser: List(AfskrivningslovForskudsAnskaffelse))

| afskrivningslov28_driftsmiddel(aktivart: AfskrivningslovAktivart) -> aktivart == AlMaskine || aktivart == AlInventar || aktivart == AlAndetDriftsmiddel
| afskrivningslov28_skib(aktivart: AfskrivningslovAktivart) -> aktivart == AlSkib
| afskrivningslov28_driftsmiddel_eller_skib(aktivart: AfskrivningslovAktivart) -> afskrivningslov28_driftsmiddel(aktivart) || afskrivningslov28_skib(aktivart)
| afskrivningslov28_aftaleform_matcher_aktiv(aftale: AfskrivningslovForskudsAftale) -> match aftale.aftaleform {
    | Al28BindendeLeveringsaftale -> afskrivningslov28_driftsmiddel(aftale.par1_par2_resultat.aktivart)
    | Al28BindendeSkibsbygningsaftale -> afskrivningslov28_skib(aftale.par1_par2_resultat.aktivart)
    | Al28EgenFremstillingsplan -> afskrivningslov28_driftsmiddel_eller_skib(aftale.par1_par2_resultat.aktivart)
}
| afskrivningslov28_driftsmiddelaftale_indgået_rettidigt(aftale: AfskrivningslovForskudsAftale) -> afskrivningslov28_skib(aftale.par1_par2_resultat.aktivart) || afskrivningslov_dato_mellem_inklusive(aftale.bestillings_eller_planlægningsdato, AfskrivningslovDato(år = 1, måned = 1, dag = 1), AfskrivningslovDato(år = 2000, måned = 10, dag = 3))
| afskrivningslov28_saldo_omfattet(saldoart: AfskrivningslovForskudsSaldoart) -> saldoart == Al28Par5Saldo

# Afskrivningslov28Sag(aftale: AfskrivningslovForskudsAftale) {
    | par1_par2_matcher_skatteyder() -> aftale.par1_par2_resultat.skatteyder == aftale.skatteyder
    | udelukkende_erhvervsmæssigt_benyttet() -> aftale.par1_par2_resultat.udelukkende_erhvervsmæssigt_benyttet
    | afskrivningsberettiget_efter_kapitel2() -> aftale.par1_par2_resultat.omfattet_af_kapitel2
    | driftsmiddel_eller_skib() -> afskrivningslov28_driftsmiddel_eller_skib(aftale.par1_par2_resultat.aktivart)
    | aftaleform_matcher_aktiv() -> afskrivningslov28_aftaleform_matcher_aktiv(aftale)
    | driftsmiddelaftale_indgået_rettidigt() -> afskrivningslov28_driftsmiddelaftale_indgået_rettidigt(aftale)
    | saldo_omfattet() -> afskrivningslov28_saldo_omfattet(aftale.saldoart)
    | omfattet_af_par28() -> par1_par2_matcher_skatteyder() && udelukkende_erhvervsmæssigt_benyttet() && afskrivningsberettiget_efter_kapitel2() && driftsmiddel_eller_skib() && aftaleform_matcher_aktiv() && driftsmiddelaftale_indgået_rettidigt() && saldo_omfattet()
    | resultat() -> Afskrivningslov28Resultat(
        skatteyder = aftale.skatteyder,
        aktivart = aftale.par1_par2_resultat.aktivart,
        udelukkende_erhvervsmæssigt_benyttet = udelukkende_erhvervsmæssigt_benyttet(),
        afskrivningsberettiget_efter_kapitel2 = afskrivningsberettiget_efter_kapitel2(),
        driftsmiddel_eller_skib = driftsmiddel_eller_skib(),
        aftaleform_matcher_aktiv = aftaleform_matcher_aktiv(),
        driftsmiddelaftale_indgået_rettidigt = driftsmiddelaftale_indgået_rettidigt(),
        saldo_omfattet = saldo_omfattet(),
        omfattet_af_par28 = omfattet_af_par28()
    )
}
| afskrivningslov28_sag(aftale: AfskrivningslovForskudsAftale) -> Afskrivningslov28Sag(aftale)
| afskrivningslov28_resultat(aftale: AfskrivningslovForskudsAftale) -> afskrivningslov28_sag(aftale).resultat()
--@end:afskrivningsloven_par28--

--@label:afskrivningsloven_par29::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par29_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 29. Forskudsafskrivning kan foretages, når

1) den skattepligtige enten har truffet bindende aftale om levering af
driftsmidlerne eller bygning af skibet eller har planlagt at fremstille dem i
egen virksomhed,

2) levering eller færdiggørelse af driftsmidlerne eller skibene ifølge aftalen
eller planerne tidligst skal ske i det første og senest i det fjerde indkomstår
efter bestillings- eller planlægningsåret og

3) den samlede aftalte anskaffelsessum eller, hvis aktiverne skal fremstilles i
egen virksomhed, den beregnede anskaffelsessum for aktiver med samme
bestillings- eller planlægningsår overstiger et grundbeløb på 1.406.800 kr.
(2010-niveau).

Stk. 2. Tilkommer retten til afskrivning på aktiverne flere skattepligtige, kan
den enkelte skattepligtige kun forskudsafskrive, hvis den enkeltes andel i den
aftalte eller beregnede anskaffelsessum for aktiver med samme bestillings- eller
planlægningsår overstiger grundbeløbet efter stk. 1, nr. 3. Skal aktiverne
benyttes i forskellige virksomheder, kan den skattepligtige kun
forskudsafskrive, når anskaffelsessummen for aktiverne for hver enkelt
virksomhed overstiger grundbeløbet.
----

--@begin:afskrivningsloven_par29--
# Afskrivningslov29Resultat(aftale: AfskrivningslovForskudsAftale, par28_resultat: Afskrivningslov28Resultat, grundbeløb_resultat: Afskrivningslov29GrundbeløbResultat, bestillings_eller_planlægningsår: Heltal, planlagte_aktiver_gyldige: Boolsk, identifikationer_entydige: Boolsk, levering_eller_færdiggørelse_i_første_til_fjerde_år: Boolsk, samlet_aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_og_virksomhed_kroner: Heltal, grundbeløb_matcher_indkomståret: Boolsk, grundbeløb_oversteget: Boolsk, omfattet_af_par29: Boolsk)

| afskrivningslov29_grundbeløb_resultat(indkomstår: Heltal) -> Afskrivningslov29GrundbeløbResultat(
    indkomstår = indkomstår,
    grundbeløb_2010_niveau_kroner = 1406800,
    reguleringstal_tiendedele = par20_reguleringstal_tiendedele(indkomstår),
    reguleret_grundbeløb_kroner = par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
        grundbeløb_2010_niveau_kroner = 1406800,
        reguleringstal_tiendedele = par20_reguleringstal_tiendedele(indkomstår)
    ))
) under indkomstår >= 2009 && indkomstår <= 2026
| afskrivningslov29_planlagte_identifikationer(aftale: AfskrivningslovForskudsAftale) -> map(aftale.planlagte_aktiver, |aktiv: AfskrivningslovForskudsPlanlagtAktiv| aktiv.identifikation)
| afskrivningslov29_identifikationer_entydige(aftale: AfskrivningslovForskudsAftale) -> length(afskrivningslov29_planlagte_identifikationer(aftale)) == length(distinct(afskrivningslov29_planlagte_identifikationer(aftale)))
| afskrivningslov29_planlagte_aktiver_gyldige(aftale: AfskrivningslovForskudsAftale) -> length(aftale.planlagte_aktiver) > 0 && aftale.virksomhedsidentifikation != "" && all(aftale.planlagte_aktiver, |aktiv: AfskrivningslovForskudsPlanlagtAktiv| aktiv.identifikation != "" && aktiv.aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_kroner > 0) && afskrivningslov29_identifikationer_entydige(aftale)
| afskrivningslov29_selskabsstatus_gyldig(aftale: AfskrivningslovForskudsAftale) -> aftale.selskab_omfattet_af_selskabsskattelov1_stk1_nr1_2_eller_4 == Falskt || aftale.skatteyder == AlSelskabEllerForening
| afskrivningslov29_levering_i_første_til_fjerde_år(aftale: AfskrivningslovForskudsAftale) -> all(aftale.planlagte_aktiver, |aktiv: AfskrivningslovForskudsPlanlagtAktiv| aktiv.planlagt_leverings_eller_færdiggørelsesår >= aftale.bestillings_eller_planlægningsdato.år + 1 && aktiv.planlagt_leverings_eller_færdiggørelsesår <= aftale.bestillings_eller_planlægningsdato.år + 4)
| afskrivningslov29_samlet_anskaffelsessum_kroner(aftale: AfskrivningslovForskudsAftale) -> foldl(aftale.planlagte_aktiver, 0, |sum: Heltal, aktiv: AfskrivningslovForskudsPlanlagtAktiv| sum + penge_positivt_beløb(aktiv.aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_kroner))
| afskrivningslov29_grundbeløb_matcher(aftale: AfskrivningslovForskudsAftale, grundbeløb: Afskrivningslov29GrundbeløbResultat) -> grundbeløb.indkomstår == aftale.bestillings_eller_planlægningsdato.år && grundbeløb.indkomstår >= 2009 && grundbeløb.indkomstår <= 2026 && grundbeløb == afskrivningslov29_grundbeløb_resultat(grundbeløb.indkomstår)

# Afskrivningslov29Sag(aftale: AfskrivningslovForskudsAftale, grundbeløb: Afskrivningslov29GrundbeløbResultat) {
    | par28() -> afskrivningslov28_resultat(aftale)
    | planlagte_aktiver_gyldige() -> afskrivningslov29_planlagte_aktiver_gyldige(aftale)
    | levering_i_første_til_fjerde_år() -> afskrivningslov29_levering_i_første_til_fjerde_år(aftale)
    | samlet_anskaffelsessum_kroner() -> afskrivningslov29_samlet_anskaffelsessum_kroner(aftale)
    | grundbeløb_matcher() -> afskrivningslov29_grundbeløb_matcher(aftale, grundbeløb)
    | grundbeløb_oversteget() -> grundbeløb_matcher() && samlet_anskaffelsessum_kroner() > grundbeløb.reguleret_grundbeløb_kroner
    | omfattet_af_par29() -> par28().omfattet_af_par28 && planlagte_aktiver_gyldige() && afskrivningslov29_selskabsstatus_gyldig(aftale) && levering_i_første_til_fjerde_år() && grundbeløb_oversteget()
    | resultat() -> Afskrivningslov29Resultat(
        aftale = aftale,
        par28_resultat = par28(),
        grundbeløb_resultat = grundbeløb,
        bestillings_eller_planlægningsår = aftale.bestillings_eller_planlægningsdato.år,
        planlagte_aktiver_gyldige = planlagte_aktiver_gyldige(),
        identifikationer_entydige = afskrivningslov29_identifikationer_entydige(aftale),
        levering_eller_færdiggørelse_i_første_til_fjerde_år = levering_i_første_til_fjerde_år(),
        samlet_aftalt_eller_beregnet_anskaffelsessum_for_skatteyder_og_virksomhed_kroner = samlet_anskaffelsessum_kroner(),
        grundbeløb_matcher_indkomståret = grundbeløb_matcher(),
        grundbeløb_oversteget = grundbeløb_oversteget(),
        omfattet_af_par29 = omfattet_af_par29()
    )
}
| afskrivningslov29_sag(aftale: AfskrivningslovForskudsAftale, grundbeløb: Afskrivningslov29GrundbeløbResultat) -> Afskrivningslov29Sag(aftale, grundbeløb)
| afskrivningslov29_resultat(aftale: AfskrivningslovForskudsAftale, grundbeløb: Afskrivningslov29GrundbeløbResultat) -> afskrivningslov29_sag(aftale, grundbeløb).resultat()
--@end:afskrivningsloven_par29--

--@label:afskrivningsloven_par30::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par30_juridisk_vejledning--
----
§ 30. Forskudsafskrivning kan første gang foretages ved opgørelsen af den
skattepligtige indkomst for bestillings- eller planlægningsåret og sidste gang
ved indkomstopgørelsen for det tredje indkomstår efter bestillings- eller
planlægningsåret. Selskaber og foreninger omfattet af selskabsskattelovens § 1,
stk. 1, nr. 1, 2 eller 4, kan dog tidligst forskudsafskrive på driftsmidler og
skibe, der erhverves med henblik på udlejning, eller som ved indgåelse af
bindende aftale om levering er udlejet, i året efter det indkomstår, hvori
bestilling eller planlægning er sket. Told- og skatteforvaltningen kan efter
reglerne i § 5, stk. 6, tillade, at 2. pkt. ikke skal finde anvendelse.

Stk. 2. Forskudsafskrivning kan kun foretages på aktiver, der ved indkomstårets
udløb endnu ikke opfylder betingelserne i § 3 for at kunne afskrives.
----

--@begin:afskrivningsloven_par30--
# Afskrivningslov30Resultat(indkomstår: Heltal, første_forskudsafskrivningsår: Heltal, sidste_forskudsafskrivningsår: Heltal, selskabsudlejning_udskyder_første_år: Boolsk, inden_for_forskudsafskrivningsperioden: Boolsk, antal_aktiver_der_endnu_ikke_opfylder_par3: Heltal, kan_forskudsafskrive_i_indkomståret: Boolsk)

| afskrivningslov30_selskabsudlejning_udskyder(aftale: AfskrivningslovForskudsAftale) -> aftale.selskab_omfattet_af_selskabsskattelov1_stk1_nr1_2_eller_4 && aftale.skatteyder == AlSelskabEllerForening && aftale.aktiver_erhverves_med_henblik_på_udlejning_eller_er_udlejet && aftale.tilladelse_efter_par5_stk6 == Falskt
| afskrivningslov30_første_forskudsafskrivningsår(aftale: AfskrivningslovForskudsAftale) -> aftale.bestillings_eller_planlægningsdato.år + hvis afskrivningslov30_selskabsudlejning_udskyder(aftale) { 1 } ellers { 0 }
| afskrivningslov30_sidste_forskudsafskrivningsår(aftale: AfskrivningslovForskudsAftale) -> aftale.bestillings_eller_planlægningsdato.år + 3

# Afskrivningslov30Sag(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) {
    | første_år() -> afskrivningslov30_første_forskudsafskrivningsår(position.aftale)
    | sidste_år() -> afskrivningslov30_sidste_forskudsafskrivningsår(position.aftale)
    | inden_for_perioden() -> indkomstår >= første_år() && indkomstår <= sidste_år()
    | resterende_aktiver() -> afskrivningslov32_resterende_planlagte_aktiver_i_år(position, indkomstår)
    | resultat() -> Afskrivningslov30Resultat(
        indkomstår = indkomstår,
        første_forskudsafskrivningsår = første_år(),
        sidste_forskudsafskrivningsår = sidste_år(),
        selskabsudlejning_udskyder_første_år = afskrivningslov30_selskabsudlejning_udskyder(position.aftale),
        inden_for_forskudsafskrivningsperioden = inden_for_perioden(),
        antal_aktiver_der_endnu_ikke_opfylder_par3 = length(resterende_aktiver()),
        kan_forskudsafskrive_i_indkomståret = inden_for_perioden() && length(resterende_aktiver()) > 0
    )
}
| afskrivningslov30_sag(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> Afskrivningslov30Sag(position, indkomstår)
| afskrivningslov30_resultat(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> afskrivningslov30_sag(position, indkomstår).resultat()
--@end:afskrivningsloven_par30--

--@label:afskrivningsloven_par31::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par31_par32_juridisk_vejledning::rate_guidance:afskrivningsloven_par31_sats_juridisk_vejledning--
----
§ 31. Forskudsafskrivning foretages på grundlag af den del af den samlede
aftalte eller beregnede anskaffelsessum, der overstiger grundbeløbet efter § 29,
stk. 1, nr. 3 (forskudsafskrivningsgrundlaget), dog kun i det omfang,
anskaffelsessummen kan afskrives efter denne lov. Eventuelle senere
prisstigninger indgår ikke i forskudsafskrivningsgrundlaget.

Stk. 2. Forskudsafskrivningen kan foretages med indtil 15 pct. årligt af
forskudsafskrivningsgrundlaget. Forskudsafskrivningen kan dog i alt højst udgøre
30 pct. af det nævnte grundlag.
----

--@begin:afskrivningsloven_par31--
# Afskrivningslov31Resultat(oprindeligt_forskudsafskrivningsgrundlag_kroner: Heltal, hidtil_anvendt_forskudsafskrivningssats_basispoint: Heltal, højeste_årlige_sats_basispoint: Heltal, højeste_samlede_sats_basispoint: Heltal, resterende_satsrum_basispoint: Heltal)

| afskrivningslov31_oprindeligt_forskudsafskrivningsgrundlag_kroner(position: AfskrivningslovForskudsPosition) -> penge_positivt_beløb(afskrivningslov29_samlet_anskaffelsessum_kroner(position.aftale) - position.grundbeløb_resultat.reguleret_grundbeløb_kroner)
| afskrivningslov31_hidtil_anvendt_sats_basispoint(position: AfskrivningslovForskudsPosition) -> foldl(position.årsposter, 0, |sum: Heltal, årspost: AfskrivningslovForskudsÅrspost| sum + årspost.anvendt_forskudsafskrivningssats_basispoint)
| afskrivningslov31_resterende_satsrum_basispoint(position: AfskrivningslovForskudsPosition) -> penge_positivt_beløb(3000 - afskrivningslov31_hidtil_anvendt_sats_basispoint(position))
| afskrivningslov31_resultat(position: AfskrivningslovForskudsPosition) -> Afskrivningslov31Resultat(
    oprindeligt_forskudsafskrivningsgrundlag_kroner = afskrivningslov31_oprindeligt_forskudsafskrivningsgrundlag_kroner(position),
    hidtil_anvendt_forskudsafskrivningssats_basispoint = afskrivningslov31_hidtil_anvendt_sats_basispoint(position),
    højeste_årlige_sats_basispoint = 1500,
    højeste_samlede_sats_basispoint = 3000,
    resterende_satsrum_basispoint = afskrivningslov31_resterende_satsrum_basispoint(position)
)
--@end:afskrivningsloven_par31--

--@label:afskrivningsloven_par32::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par31_par32_juridisk_vejledning::allocation_guidance:afskrivningsloven_par32_par33_juridisk_vejledning--
----
§ 32. Når driftsmidler eller skibe, hvorpå der er forskudsafskrevet, bliver
afskrivningsberettigede efter § 5, fragår aktivernes faktiske anskaffelsessum i
den samlede aftalte eller beregnede anskaffelsessum, efterhånden som aktiverne
anskaffes. Anskaffelsessummen fragår først i grundbeløbet, jf. § 29, stk. 1, nr.
3. Herefter fragår den overskydende del af anskaffelsessummen i
forskudsafskrivningsgrundlaget, jf. § 31, stk. 1. Der kan i det enkelte
indkomstår alene forskudsafskrives på den del af forskudsafskrivningsgrundlaget,
der resterer ved indkomstårets udløb.
----

--@begin:afskrivningsloven_par32--
# Afskrivningslov32ÅrsInput(position: AfskrivningslovForskudsPosition, indkomstår: Heltal, nye_anskaffelser: List(AfskrivningslovForskudsAnskaffelse), valgt_forskudsafskrivningssats_basispoint: Heltal)
# Afskrivningslov32ÅrsResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, position_gyldig_før: Boolsk, nye_anskaffelser_gyldige: Boolsk, kan_forskudsafskrive_i_indkomståret: Boolsk, resterende_grundbeløb_ved_årets_udløb_kroner: Heltal, resterende_forskudsafskrivningsgrundlag_ved_årets_udløb_kroner: Heltal, hidtil_anvendt_sats_basispoint: Heltal, valgt_sats_basispoint: Heltal, valg_gyldigt: Boolsk, forskudsafskrivning_kroner: Heltal, behandling_gyldig: Boolsk, position_efter: AfskrivningslovForskudsPosition)

| afskrivningslov32_anskaffelsesår(anskaffelse: AfskrivningslovForskudsAnskaffelse) -> anskaffelse.par3_resultat.anskaffelsesdato.år
| afskrivningslov32_planlagt_aktiv_findes(aftale: AfskrivningslovForskudsAftale, identifikation: Tekst) -> any(aftale.planlagte_aktiver, |aktiv: AfskrivningslovForskudsPlanlagtAktiv| aktiv.identifikation == identifikation)
| afskrivningslov32_anskaffelse_gyldig(aftale: AfskrivningslovForskudsAftale, anskaffelse: AfskrivningslovForskudsAnskaffelse) -> anskaffelse.identifikation != "" && afskrivningslov32_planlagt_aktiv_findes(aftale, anskaffelse.identifikation) && anskaffelse.par3_resultat.anskaffet_efter_par3 && anskaffelse.faktisk_anskaffelsessum_for_skatteyder_kroner > 0 && anskaffelse.forlods_afskrivning_efter_etableringskontoloven_kroner >= 0 && anskaffelse.forlods_afskrivning_efter_etableringskontoloven_kroner <= anskaffelse.faktisk_anskaffelsessum_for_skatteyder_kroner
| afskrivningslov32_anskaffelsesidentifikationer(anskaffelser: List(AfskrivningslovForskudsAnskaffelse)) -> map(anskaffelser, |anskaffelse: AfskrivningslovForskudsAnskaffelse| anskaffelse.identifikation)
| afskrivningslov32_anskaffelser_entydige(anskaffelser: List(AfskrivningslovForskudsAnskaffelse)) -> length(afskrivningslov32_anskaffelsesidentifikationer(anskaffelser)) == length(distinct(afskrivningslov32_anskaffelsesidentifikationer(anskaffelser)))
| afskrivningslov32_anskaffelser_gyldige(aftale: AfskrivningslovForskudsAftale, anskaffelser: List(AfskrivningslovForskudsAnskaffelse)) -> afskrivningslov32_anskaffelser_entydige(anskaffelser) && all(anskaffelser, |anskaffelse: AfskrivningslovForskudsAnskaffelse| afskrivningslov32_anskaffelse_gyldig(aftale, anskaffelse))
| afskrivningslov32_anskaffelser_i_eller_før_år(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> filter(position.anskaffelser, |anskaffelse: AfskrivningslovForskudsAnskaffelse| afskrivningslov32_anskaffelsesår(anskaffelse) <= indkomstår)
| afskrivningslov32_samlet_faktisk_anskaffelsessum_kroner(anskaffelser: List(AfskrivningslovForskudsAnskaffelse)) -> foldl(anskaffelser, 0, |sum: Heltal, anskaffelse: AfskrivningslovForskudsAnskaffelse| sum + penge_positivt_beløb(anskaffelse.faktisk_anskaffelsessum_for_skatteyder_kroner))
| afskrivningslov32_resterende_grundbeløb_i_år_kroner(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> penge_positivt_beløb(position.grundbeløb_resultat.reguleret_grundbeløb_kroner - afskrivningslov32_samlet_faktisk_anskaffelsessum_kroner(afskrivningslov32_anskaffelser_i_eller_før_år(position, indkomstår)))
| afskrivningslov32_reduktion_af_forskudsgrundlag_i_år_kroner(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> penge_mindste_beløb(afskrivningslov31_oprindeligt_forskudsafskrivningsgrundlag_kroner(position), penge_positivt_beløb(afskrivningslov32_samlet_faktisk_anskaffelsessum_kroner(afskrivningslov32_anskaffelser_i_eller_før_år(position, indkomstår)) - position.grundbeløb_resultat.reguleret_grundbeløb_kroner))
| afskrivningslov32_resterende_forskudsgrundlag_i_år_kroner(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> penge_positivt_beløb(afskrivningslov31_oprindeligt_forskudsafskrivningsgrundlag_kroner(position) - afskrivningslov32_reduktion_af_forskudsgrundlag_i_år_kroner(position, indkomstår))
| afskrivningslov32_aktiv_anskaffet_i_eller_før_år(position: AfskrivningslovForskudsPosition, identifikation: Tekst, indkomstår: Heltal) -> any(position.anskaffelser, |anskaffelse: AfskrivningslovForskudsAnskaffelse| anskaffelse.identifikation == identifikation && afskrivningslov32_anskaffelsesår(anskaffelse) <= indkomstår)
| afskrivningslov32_resterende_planlagte_aktiver_i_år(position: AfskrivningslovForskudsPosition, indkomstår: Heltal) -> filter(position.aftale.planlagte_aktiver, |aktiv: AfskrivningslovForskudsPlanlagtAktiv| afskrivningslov32_aktiv_anskaffet_i_eller_før_år(position, aktiv.identifikation, indkomstår) == Falskt)
| afskrivningslov32_årsposter_entydige(årsposter: List(AfskrivningslovForskudsÅrspost)) -> length(map(årsposter, |årspost: AfskrivningslovForskudsÅrspost| årspost.indkomstår)) == length(distinct(map(årsposter, |årspost: AfskrivningslovForskudsÅrspost| årspost.indkomstår)))
| afskrivningslov32_årspost_gyldig(position: AfskrivningslovForskudsPosition, årspost: AfskrivningslovForskudsÅrspost) -> årspost.anvendt_forskudsafskrivningssats_basispoint >= 0 && årspost.anvendt_forskudsafskrivningssats_basispoint <= 1500 && afskrivningslov30_resultat(position, årspost.indkomstår).kan_forskudsafskrive_i_indkomståret && årspost.resterende_forskudsafskrivningsgrundlag_ved_årets_udløb_kroner == afskrivningslov32_resterende_forskudsgrundlag_i_år_kroner(position, årspost.indkomstår) && årspost.forskudsafskrivning_kroner == penge_beløb_gange_basispoint_kroner(årspost.resterende_forskudsafskrivningsgrundlag_ved_årets_udløb_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint)
| afskrivningslov32_position_gyldig(position: AfskrivningslovForskudsPosition) -> afskrivningslov29_resultat(position.aftale, position.grundbeløb_resultat).omfattet_af_par29 && afskrivningslov32_anskaffelser_gyldige(position.aftale, position.anskaffelser) && afskrivningslov32_årsposter_entydige(position.årsposter) && all(position.årsposter, |årspost: AfskrivningslovForskudsÅrspost| afskrivningslov32_årspost_gyldig(position, årspost)) && afskrivningslov31_hidtil_anvendt_sats_basispoint(position) <= 3000
| afskrivningslov32_nye_anskaffelser_gyldige(input: Afskrivningslov32ÅrsInput) -> afskrivningslov32_anskaffelser_gyldige(input.position.aftale, input.nye_anskaffelser) && all(input.nye_anskaffelser, |anskaffelse: AfskrivningslovForskudsAnskaffelse| afskrivningslov32_anskaffelsesår(anskaffelse) == input.indkomstår) && afskrivningslov32_anskaffelser_entydige(concat(input.position.anskaffelser, input.nye_anskaffelser))
| afskrivningslov32_position_med_nye_anskaffelser(input: Afskrivningslov32ÅrsInput) -> AfskrivningslovForskudsPosition(
    aftale = input.position.aftale,
    grundbeløb_resultat = input.position.grundbeløb_resultat,
    årsposter = input.position.årsposter,
    anskaffelser = concat(input.position.anskaffelser, input.nye_anskaffelser)
)

# Afskrivningslov32ÅrsSag(input: Afskrivningslov32ÅrsInput) {
    | position_gyldig_før() -> afskrivningslov32_position_gyldig(input.position)
    | nye_anskaffelser_gyldige() -> afskrivningslov32_nye_anskaffelser_gyldige(input)
    | position_efter_anskaffelser() -> hvis position_gyldig_før() && nye_anskaffelser_gyldige() { afskrivningslov32_position_med_nye_anskaffelser(input) } ellers { input.position }
    | tidsrum() -> afskrivningslov30_resultat(position_efter_anskaffelser(), input.indkomstår)
    | resterende_grundbeløb_kroner() -> afskrivningslov32_resterende_grundbeløb_i_år_kroner(position_efter_anskaffelser(), input.indkomstår)
    | resterende_forskudsgrundlag_kroner() -> afskrivningslov32_resterende_forskudsgrundlag_i_år_kroner(position_efter_anskaffelser(), input.indkomstår)
    | hidtil_anvendt_sats_basispoint() -> afskrivningslov31_hidtil_anvendt_sats_basispoint(input.position)
    | kan_forskudsafskrive() -> position_gyldig_før() && nye_anskaffelser_gyldige() && tidsrum().kan_forskudsafskrive_i_indkomståret && resterende_forskudsgrundlag_kroner() > 0
    | valg_gyldigt() -> hvis kan_forskudsafskrive() { input.valgt_forskudsafskrivningssats_basispoint >= 0 && input.valgt_forskudsafskrivningssats_basispoint <= 1500 && hidtil_anvendt_sats_basispoint() + input.valgt_forskudsafskrivningssats_basispoint <= 3000 } ellers { input.valgt_forskudsafskrivningssats_basispoint == 0 }
    | forskudsafskrivning_kroner() -> hvis kan_forskudsafskrive() && valg_gyldigt() { penge_beløb_gange_basispoint_kroner(resterende_forskudsgrundlag_kroner(), input.valgt_forskudsafskrivningssats_basispoint) } ellers { 0 }
    | behandling_gyldig() -> position_gyldig_før() && nye_anskaffelser_gyldige() && valg_gyldigt()
    | ny_årspost() -> AfskrivningslovForskudsÅrspost(
        indkomstår = input.indkomstår,
        resterende_forskudsafskrivningsgrundlag_ved_årets_udløb_kroner = resterende_forskudsgrundlag_kroner(),
        anvendt_forskudsafskrivningssats_basispoint = input.valgt_forskudsafskrivningssats_basispoint,
        forskudsafskrivning_kroner = forskudsafskrivning_kroner()
    )
    | position_efter() -> hvis behandling_gyldig() && kan_forskudsafskrive() { AfskrivningslovForskudsPosition(
        aftale = position_efter_anskaffelser().aftale,
        grundbeløb_resultat = position_efter_anskaffelser().grundbeløb_resultat,
        årsposter = concat(position_efter_anskaffelser().årsposter, [ny_årspost()]),
        anskaffelser = position_efter_anskaffelser().anskaffelser
    ) } ellers { position_efter_anskaffelser() }
    | resultat() -> Afskrivningslov32ÅrsResultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.aftale.skatteyder,
        position_gyldig_før = position_gyldig_før(),
        nye_anskaffelser_gyldige = nye_anskaffelser_gyldige(),
        kan_forskudsafskrive_i_indkomståret = kan_forskudsafskrive(),
        resterende_grundbeløb_ved_årets_udløb_kroner = resterende_grundbeløb_kroner(),
        resterende_forskudsafskrivningsgrundlag_ved_årets_udløb_kroner = resterende_forskudsgrundlag_kroner(),
        hidtil_anvendt_sats_basispoint = hidtil_anvendt_sats_basispoint(),
        valgt_sats_basispoint = input.valgt_forskudsafskrivningssats_basispoint,
        valg_gyldigt = valg_gyldigt(),
        forskudsafskrivning_kroner = forskudsafskrivning_kroner(),
        behandling_gyldig = behandling_gyldig(),
        position_efter = position_efter()
    )
}
| afskrivningslov32_års_sag(input: Afskrivningslov32ÅrsInput) -> Afskrivningslov32ÅrsSag(input)
| afskrivningslov32_årsresultat(input: Afskrivningslov32ÅrsInput) -> afskrivningslov32_års_sag(input).resultat()
--@end:afskrivningsloven_par32--

--@label:afskrivningsloven_par33::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par32_par33_juridisk_vejledning--
----
§ 33. I det omfang et aktivs anskaffelsessum efter bestemmelsen i § 32 fragår i
forskudsafskrivningsgrundlaget, opgøres de forskudsafskrivninger, der er
foretaget på aktivet. Forskudsafskrivningerne for det enkelte aktiv beregnes ved
at gange den samlede forskudsafskrivningsprocent med den del af den faktiske
anskaffelsessum, der fragår i forskudsafskrivningsgrundlaget. Såfremt flere
aktiver bliver afskrivningsberettigede i samme indkomstår, fordeles den del af
den faktiske anskaffelsessum, der fragår i forskudsafskrivningsgrundlaget,
forholdsmæssigt på aktiverne.

Stk. 2. De forskudsafskrivninger, der efter stk. 1 er foretaget på det enkelte
aktiv, fratrækkes i aktivets afskrivningsberettigede anskaffelsessum. Den
resterende anskaffelsessum behandles efter reglerne i § 5, stk. 1-3.
----

--@begin:afskrivningsloven_par33--
# Afskrivningslov33Input(position_før_anskaffelser: AfskrivningslovForskudsPosition, anskaffelser_i_indkomståret: List(AfskrivningslovForskudsAnskaffelse))
# Afskrivningslov33AktivResultat(identifikation: Tekst, faktisk_anskaffelsessum_kroner: Heltal, del_der_fragår_i_forskudsafskrivningsgrundlaget_kroner: Heltal, samlet_forskudsafskrivningsprocent_basispoint: Heltal, forskudsafskrivning_henført_til_aktivet_kroner: Heltal, forlods_afskrivning_efter_etableringskontoloven_kroner: Heltal, resterende_anskaffelsessum_til_par5_kroner: Heltal)
# Afskrivningslov33Resultat(skatteyder: AfskrivningslovSkatteyder, input_gyldigt: Boolsk, samlet_faktisk_anskaffelsessum_i_indkomståret_kroner: Heltal, samlet_del_der_fragår_i_forskudsafskrivningsgrundlaget_kroner: Heltal, samlet_forskudsafskrivningsprocent_basispoint: Heltal, samlede_forskudsafskrivninger_henført_til_aktiver_kroner: Heltal, aktiv_resultater: List(Afskrivningslov33AktivResultat))

| afskrivningslov33_reduktion_før_kroner(position: AfskrivningslovForskudsPosition) -> afskrivningslov32_reduktion_af_forskudsgrundlag_i_år_kroner(position, 9999)
| afskrivningslov33_position_med_anskaffelser(input: Afskrivningslov33Input) -> AfskrivningslovForskudsPosition(
    aftale = input.position_før_anskaffelser.aftale,
    grundbeløb_resultat = input.position_før_anskaffelser.grundbeløb_resultat,
    årsposter = input.position_før_anskaffelser.årsposter,
    anskaffelser = concat(input.position_før_anskaffelser.anskaffelser, input.anskaffelser_i_indkomståret)
)
| afskrivningslov33_samlet_reduktion_i_indkomståret_kroner(input: Afskrivningslov33Input) -> penge_positivt_beløb(afskrivningslov33_reduktion_før_kroner(afskrivningslov33_position_med_anskaffelser(input)) - afskrivningslov33_reduktion_før_kroner(input.position_før_anskaffelser))
| afskrivningslov33_forholdsmæssig_del_kroner(samlet_beløb_kroner: Heltal, aktivets_anskaffelsessum_kroner: Heltal, resterende_anskaffelsessummer_kroner: Heltal) -> hvis resterende_anskaffelsessummer_kroner > 0 { samlet_beløb_kroner * aktivets_anskaffelsessum_kroner / resterende_anskaffelsessummer_kroner } ellers { 0 }
| afskrivningslov33_aktiv_resultat(anskaffelse: AfskrivningslovForskudsAnskaffelse, grundlagsreduktion_kroner: Heltal, forskudsafskrivning_kroner: Heltal, samlet_sats_basispoint: Heltal) -> Afskrivningslov33AktivResultat(
    identifikation = anskaffelse.identifikation,
    faktisk_anskaffelsessum_kroner = anskaffelse.faktisk_anskaffelsessum_for_skatteyder_kroner,
    del_der_fragår_i_forskudsafskrivningsgrundlaget_kroner = grundlagsreduktion_kroner,
    samlet_forskudsafskrivningsprocent_basispoint = samlet_sats_basispoint,
    forskudsafskrivning_henført_til_aktivet_kroner = forskudsafskrivning_kroner,
    forlods_afskrivning_efter_etableringskontoloven_kroner = anskaffelse.forlods_afskrivning_efter_etableringskontoloven_kroner,
    resterende_anskaffelsessum_til_par5_kroner = penge_positivt_beløb(anskaffelse.faktisk_anskaffelsessum_for_skatteyder_kroner - anskaffelse.forlods_afskrivning_efter_etableringskontoloven_kroner - forskudsafskrivning_kroner)
)
| afskrivningslov33_fordel_aktiver(anskaffelser: List(AfskrivningslovForskudsAnskaffelse), resterende_grundlagsreduktion_kroner: Heltal, resterende_forskudsafskrivning_kroner: Heltal, resterende_anskaffelsessummer_kroner: Heltal, samlet_sats_basispoint: Heltal) -> hvis length(anskaffelser) == 0 { [] } ellers { hvis length(anskaffelser) == 1 {
    [afskrivningslov33_aktiv_resultat(head(anskaffelser), resterende_grundlagsreduktion_kroner, resterende_forskudsafskrivning_kroner, samlet_sats_basispoint)]
} ellers {
    concat(
        [afskrivningslov33_aktiv_resultat(
            head(anskaffelser),
            afskrivningslov33_forholdsmæssig_del_kroner(resterende_grundlagsreduktion_kroner, head(anskaffelser).faktisk_anskaffelsessum_for_skatteyder_kroner, resterende_anskaffelsessummer_kroner),
            afskrivningslov33_forholdsmæssig_del_kroner(resterende_forskudsafskrivning_kroner, head(anskaffelser).faktisk_anskaffelsessum_for_skatteyder_kroner, resterende_anskaffelsessummer_kroner),
            samlet_sats_basispoint
        )],
        afskrivningslov33_fordel_aktiver(
            tail(anskaffelser),
            resterende_grundlagsreduktion_kroner - afskrivningslov33_forholdsmæssig_del_kroner(resterende_grundlagsreduktion_kroner, head(anskaffelser).faktisk_anskaffelsessum_for_skatteyder_kroner, resterende_anskaffelsessummer_kroner),
            resterende_forskudsafskrivning_kroner - afskrivningslov33_forholdsmæssig_del_kroner(resterende_forskudsafskrivning_kroner, head(anskaffelser).faktisk_anskaffelsessum_for_skatteyder_kroner, resterende_anskaffelsessummer_kroner),
            resterende_anskaffelsessummer_kroner - head(anskaffelser).faktisk_anskaffelsessum_for_skatteyder_kroner,
            samlet_sats_basispoint
        )
    )
} }

# Afskrivningslov33Sag(input: Afskrivningslov33Input) {
    | position_gyldig() -> afskrivningslov32_position_gyldig(input.position_før_anskaffelser)
    | anskaffelser_gyldige() -> afskrivningslov32_anskaffelser_gyldige(input.position_før_anskaffelser.aftale, input.anskaffelser_i_indkomståret) && afskrivningslov32_anskaffelser_entydige(concat(input.position_før_anskaffelser.anskaffelser, input.anskaffelser_i_indkomståret))
    | samme_indkomstår() -> length(input.anskaffelser_i_indkomståret) == 0 || all(input.anskaffelser_i_indkomståret, |anskaffelse: AfskrivningslovForskudsAnskaffelse| afskrivningslov32_anskaffelsesår(anskaffelse) == afskrivningslov32_anskaffelsesår(head(input.anskaffelser_i_indkomståret)))
    | input_gyldigt() -> position_gyldig() && anskaffelser_gyldige() && samme_indkomstår()
    | samlet_anskaffelsessum_kroner() -> afskrivningslov32_samlet_faktisk_anskaffelsessum_kroner(input.anskaffelser_i_indkomståret)
    | grundlagsreduktion_kroner() -> hvis input_gyldigt() { afskrivningslov33_samlet_reduktion_i_indkomståret_kroner(input) } ellers { 0 }
    | samlet_sats_basispoint() -> afskrivningslov31_hidtil_anvendt_sats_basispoint(input.position_før_anskaffelser)
    | forskudsafskrivning_henført_kroner() -> penge_beløb_gange_basispoint_kroner(grundlagsreduktion_kroner(), samlet_sats_basispoint())
    | aktiv_resultater() -> hvis input_gyldigt() { afskrivningslov33_fordel_aktiver(input.anskaffelser_i_indkomståret, grundlagsreduktion_kroner(), forskudsafskrivning_henført_kroner(), samlet_anskaffelsessum_kroner(), samlet_sats_basispoint()) } ellers { [] }
    | resultat() -> Afskrivningslov33Resultat(
        skatteyder = input.position_før_anskaffelser.aftale.skatteyder,
        input_gyldigt = input_gyldigt(),
        samlet_faktisk_anskaffelsessum_i_indkomståret_kroner = samlet_anskaffelsessum_kroner(),
        samlet_del_der_fragår_i_forskudsafskrivningsgrundlaget_kroner = grundlagsreduktion_kroner(),
        samlet_forskudsafskrivningsprocent_basispoint = samlet_sats_basispoint(),
        samlede_forskudsafskrivninger_henført_til_aktiver_kroner = forskudsafskrivning_henført_kroner(),
        aktiv_resultater = aktiv_resultater()
    )
}
| afskrivningslov33_sag(input: Afskrivningslov33Input) -> Afskrivningslov33Sag(input)
| afskrivningslov33_resultat(input: Afskrivningslov33Input) -> afskrivningslov33_sag(input).resultat()
--@end:afskrivningsloven_par33--

--@label:afskrivningsloven_par34::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par34_juridisk_vejledning::event_guidance:afskrivningsloven_par34_par35_juridisk_vejledning--
----
§ 34. Opfyldes forudsætningerne for forskudsafskrivning ikke, forhøjes den
skattepligtige indkomst for det indkomstår, hvori dette viser sig, dog senest
ved udløbet af det fjerde indkomstår efter bestillings- eller planlægningsåret.
Forhøjelsen foretages med tillæg efter reglerne i stk. 2.

Stk. 2. Såfremt der ved udløbet af den i stk. 1, 1. pkt., nævnte frist resterer
en del af eller hele forskudsafskrivningsgrundlaget efter § 32, jf. § 31, stk.
1, ganges for hvert enkelt forskudsafskrivningsår det resterende
forskudsafskrivningsgrundlag med den forskudsafskrivningssats, der er anvendt i
vedkommende forskudsafskrivningsår. Hvert af de fremkomne beløb tillægges 5 pct.
for hvert år fra udløbet af vedkommende forskudsafskrivningsår og indtil udløbet
af den i stk. 1, 1. pkt., nævnte frist. Forhøjelsen med tillæg udgør summen af
de nævnte beløb.

Stk. 3. Reglerne i stk. 1 og 2 anvendes tilsvarende for aktiver, der omfattes af
skattepligt her i landet, når denne skattepligt ophører af anden grund end den
skattepligtiges død. Når en person eller et selskab m.v., som er fuldt
skattepligtig i Danmark, efter bestemmelserne i en dobbeltbeskatningsoverenskomst
indgået mellem Danmark og en fremmed stat, Færøerne eller Grønland bliver
hjemmehørende uden for Danmark, sidestilles dette med ophør af skattepligt.
----

--@begin:afskrivningsloven_par34--
# Afskrivningslov34Hændelse = Al34ForudsætningerIkkeOpfyldt | Al34AftaleEllerPlanAnnulleret | Al34FristUdløbet | Al34SkattepligtOphørt(aktiver_forbliver_under_dansk_skattepligt: Boolsk) | Al34DobbeltbeskatningHjemmehørendeUdenForDanmark(aktiver_forbliver_under_dansk_skattepligt: Boolsk)
# Afskrivningslov34Input(position: AfskrivningslovForskudsPosition, hændelse: Afskrivningslov34Hændelse, hændelsesår: Heltal, fristforlængelse_resultat: Afskrivningslov36Resultat)
# Afskrivningslov34Årsforhøjelse(forskudsafskrivningsår: Heltal, resterende_forskudsafskrivningsgrundlag_kroner: Heltal, anvendt_sats_basispoint: Heltal, tilbageført_forskudsafskrivning_kroner: Heltal, antal_tillægsår: Heltal, fem_procent_tillæg_kroner: Heltal, forhøjelse_med_tillæg_kroner: Heltal)
# Afskrivningslov34Resultat(skatteyder: AfskrivningslovSkatteyder, position_gyldig: Boolsk, fristforlængelse_matcher_position: Boolsk, ordinært_seneste_forhøjelsesår: Heltal, seneste_forhøjelsesår: Heltal, forhøjelsesår: Heltal, hændelse_udløser_forhøjelse: Boolsk, resterende_forskudsafskrivningsgrundlag_kroner: Heltal, årsforhøjelser: List(Afskrivningslov34Årsforhøjelse), forhøjelse_af_skattepligtig_indkomst_kroner: Heltal)

| afskrivningslov34_ordinært_seneste_forhøjelsesår(position: AfskrivningslovForskudsPosition) -> position.aftale.bestillings_eller_planlægningsdato.år + 4
| afskrivningslov34_fristforlængelse_matcher(position: AfskrivningslovForskudsPosition, frist: Afskrivningslov36Resultat) -> frist.bestillings_eller_planlægningsår == position.aftale.bestillings_eller_planlægningsdato.år && frist.ordinært_seneste_forhøjelsesår == afskrivningslov34_ordinært_seneste_forhøjelsesår(position)
| afskrivningslov34_hændelse_udløser(hændelse: Afskrivningslov34Hændelse) -> match hændelse {
    | Al34ForudsætningerIkkeOpfyldt -> Sandt
    | Al34AftaleEllerPlanAnnulleret -> Sandt
    | Al34FristUdløbet -> Sandt
    | Al34SkattepligtOphørt(aktiver_forbliver_under_dansk_skattepligt) -> aktiver_forbliver_under_dansk_skattepligt == Falskt
    | Al34DobbeltbeskatningHjemmehørendeUdenForDanmark(aktiver_forbliver_under_dansk_skattepligt) -> aktiver_forbliver_under_dansk_skattepligt == Falskt
}
| afskrivningslov34_årsforhøjelse(årspost: AfskrivningslovForskudsÅrspost, resterende_forskudsgrundlag_kroner: Heltal, forhøjelsesår: Heltal) -> Afskrivningslov34Årsforhøjelse(
    forskudsafskrivningsår = årspost.indkomstår,
    resterende_forskudsafskrivningsgrundlag_kroner = resterende_forskudsgrundlag_kroner,
    anvendt_sats_basispoint = årspost.anvendt_forskudsafskrivningssats_basispoint,
    tilbageført_forskudsafskrivning_kroner = penge_beløb_gange_basispoint_kroner(resterende_forskudsgrundlag_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint),
    antal_tillægsår = penge_positivt_beløb(forhøjelsesår - årspost.indkomstår),
    fem_procent_tillæg_kroner = penge_beløb_gange_basispoint_kroner(resterende_forskudsgrundlag_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint) * 5 * penge_positivt_beløb(forhøjelsesår - årspost.indkomstår) / 100,
    forhøjelse_med_tillæg_kroner = penge_beløb_gange_basispoint_kroner(resterende_forskudsgrundlag_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint) + penge_beløb_gange_basispoint_kroner(resterende_forskudsgrundlag_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint) * 5 * penge_positivt_beløb(forhøjelsesår - årspost.indkomstår) / 100
)

# Afskrivningslov34Sag(input: Afskrivningslov34Input) {
    | position_gyldig() -> afskrivningslov32_position_gyldig(input.position)
    | frist_matcher() -> afskrivningslov34_fristforlængelse_matcher(input.position, input.fristforlængelse_resultat)
    | seneste_forhøjelsesår() -> afskrivningslov34_ordinært_seneste_forhøjelsesår(input.position) + hvis input.fristforlængelse_resultat.gyldig_fristforlængelse { input.fristforlængelse_resultat.forlængelse_år } ellers { 0 }
    | forhøjelsesår() -> hvis input.hændelse == Al34FristUdløbet { seneste_forhøjelsesår() } ellers { penge_mindste_beløb(input.hændelsesår, seneste_forhøjelsesår()) }
    | hændelse_udløser() -> afskrivningslov34_hændelse_udløser(input.hændelse) && input.hændelsesår >= input.position.aftale.bestillings_eller_planlægningsdato.år
    | resterende_forskudsgrundlag_kroner() -> afskrivningslov32_resterende_forskudsgrundlag_i_år_kroner(input.position, forhøjelsesår())
    | relevante_årsposter() -> filter(input.position.årsposter, |årspost: AfskrivningslovForskudsÅrspost| årspost.indkomstår <= forhøjelsesår() && årspost.anvendt_forskudsafskrivningssats_basispoint > 0)
    | årsforhøjelser() -> hvis position_gyldig() && frist_matcher() && hændelse_udløser() && resterende_forskudsgrundlag_kroner() > 0 { map(relevante_årsposter(), |årspost: AfskrivningslovForskudsÅrspost| afskrivningslov34_årsforhøjelse(årspost, resterende_forskudsgrundlag_kroner(), forhøjelsesår())) } ellers { [] }
    | samlet_forhøjelse_kroner() -> foldl(årsforhøjelser(), 0, |sum: Heltal, forhøjelse: Afskrivningslov34Årsforhøjelse| sum + forhøjelse.forhøjelse_med_tillæg_kroner)
    | resultat() -> Afskrivningslov34Resultat(
        skatteyder = input.position.aftale.skatteyder,
        position_gyldig = position_gyldig(),
        fristforlængelse_matcher_position = frist_matcher(),
        ordinært_seneste_forhøjelsesår = afskrivningslov34_ordinært_seneste_forhøjelsesår(input.position),
        seneste_forhøjelsesår = seneste_forhøjelsesår(),
        forhøjelsesår = forhøjelsesår(),
        hændelse_udløser_forhøjelse = hændelse_udløser(),
        resterende_forskudsafskrivningsgrundlag_kroner = resterende_forskudsgrundlag_kroner(),
        årsforhøjelser = årsforhøjelser(),
        forhøjelse_af_skattepligtig_indkomst_kroner = samlet_forhøjelse_kroner()
    )
}
| afskrivningslov34_sag(input: Afskrivningslov34Input) -> Afskrivningslov34Sag(input)
| afskrivningslov34_resultat(input: Afskrivningslov34Input) -> afskrivningslov34_sag(input).resultat()
--@end:afskrivningsloven_par34--

--@label:afskrivningsloven_par35::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par34_par35_juridisk_vejledning--
----
§ 35. Såfremt den skattepligtige dør eller går konkurs og der resterer en del af
eller hele forskudsafskrivningsgrundlaget efter § 32, jf. § 31, stk. 1, forhøjes
den skattepligtige indkomst for de indkomstår, hvori der er forskudsafskrevet,
uanset fristen i skatteforvaltningslovens § 26, stk. 1. Forhøjelsen beregnes for
hvert enkelt forskudsafskrivningsår som den resterende del af
forskudsafskrivningsgrundlaget ganget med den forskudsafskrivningssats, der er
anvendt i vedkommende forskudsafskrivningsår med tillæg af 5 pct. for hvert år
fra forskudsafskrivningsårets udløb til udløbet af døds- eller konkursåret.

Stk. 2. Reglerne i stk. 1 anvendes tilsvarende for en virksomhed, der ophører
eller sælges.

Stk. 3. Stk. 1 finder ikke anvendelse, i det omfang forskudsafskrivningerne
overtages efter dødsboskattelovens § 39, stk. 1, eller § 45, stk. 1, eller en
længstlevende ægtefælle indtræder i afdødes skattemæssige stilling efter
dødsboskattelovens § 59, stk. 1, jf. dog § 59, stk. 2, nr. 1.
----

--@begin:afskrivningsloven_par35--
# Afskrivningslov35Hændelse = Al35SkattepligtigDør | Al35SkattepligtigGårKonkurs | Al35VirksomhedOphører | Al35VirksomhedSælges
# Afskrivningslov35Input(position: AfskrivningslovForskudsPosition, hændelse: Afskrivningslov35Hændelse, hændelsesår: Heltal, forskudsafskrivningsgrundlag_overtaget_ved_dødsbosuccession_kroner: Heltal)
# Afskrivningslov35Årsforhøjelse(forskudsafskrivningsår: Heltal, tilbageført_forskudsafskrivning_kroner: Heltal, antal_tillægsår: Heltal, fem_procent_tillæg_kroner: Heltal, forhøjelse_af_det_tidligere_indkomstår_kroner: Heltal)
# Afskrivningslov35Resultat(skatteyder: AfskrivningslovSkatteyder, position_gyldig: Boolsk, succession_gyldig: Boolsk, resterende_forskudsafskrivningsgrundlag_før_succession_kroner: Heltal, overtaget_ved_dødsbosuccession_kroner: Heltal, grundlag_til_forhøjelse_kroner: Heltal, genåbner_tidligere_indkomstår: Boolsk, årsforhøjelser: List(Afskrivningslov35Årsforhøjelse), samlet_forhøjelse_af_tidligere_indkomstår_kroner: Heltal)

| afskrivningslov35_død(hændelse: Afskrivningslov35Hændelse) -> hændelse == Al35SkattepligtigDør
| afskrivningslov35_årsforhøjelse(årspost: AfskrivningslovForskudsÅrspost, grundlag_til_forhøjelse_kroner: Heltal, hændelsesår: Heltal) -> Afskrivningslov35Årsforhøjelse(
    forskudsafskrivningsår = årspost.indkomstår,
    tilbageført_forskudsafskrivning_kroner = penge_beløb_gange_basispoint_kroner(grundlag_til_forhøjelse_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint),
    antal_tillægsår = penge_positivt_beløb(hændelsesår - årspost.indkomstår),
    fem_procent_tillæg_kroner = penge_beløb_gange_basispoint_kroner(grundlag_til_forhøjelse_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint) * 5 * penge_positivt_beløb(hændelsesår - årspost.indkomstår) / 100,
    forhøjelse_af_det_tidligere_indkomstår_kroner = penge_beløb_gange_basispoint_kroner(grundlag_til_forhøjelse_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint) + penge_beløb_gange_basispoint_kroner(grundlag_til_forhøjelse_kroner, årspost.anvendt_forskudsafskrivningssats_basispoint) * 5 * penge_positivt_beløb(hændelsesår - årspost.indkomstår) / 100
)

# Afskrivningslov35Sag(input: Afskrivningslov35Input) {
    | position_gyldig() -> afskrivningslov32_position_gyldig(input.position)
    | resterende_forskudsgrundlag_kroner() -> afskrivningslov32_resterende_forskudsgrundlag_i_år_kroner(input.position, input.hændelsesår)
    | succession_gyldig() -> input.forskudsafskrivningsgrundlag_overtaget_ved_dødsbosuccession_kroner >= 0 && input.forskudsafskrivningsgrundlag_overtaget_ved_dødsbosuccession_kroner <= resterende_forskudsgrundlag_kroner() && (afskrivningslov35_død(input.hændelse) || input.forskudsafskrivningsgrundlag_overtaget_ved_dødsbosuccession_kroner == 0)
    | grundlag_til_forhøjelse_kroner() -> hvis succession_gyldig() { resterende_forskudsgrundlag_kroner() - input.forskudsafskrivningsgrundlag_overtaget_ved_dødsbosuccession_kroner } ellers { 0 }
    | genåbner_tidligere_indkomstår() -> position_gyldig() && succession_gyldig() && input.hændelsesår >= input.position.aftale.bestillings_eller_planlægningsdato.år && grundlag_til_forhøjelse_kroner() > 0
    | relevante_årsposter() -> filter(input.position.årsposter, |årspost: AfskrivningslovForskudsÅrspost| årspost.indkomstår <= input.hændelsesår && årspost.anvendt_forskudsafskrivningssats_basispoint > 0)
    | årsforhøjelser() -> hvis genåbner_tidligere_indkomstår() { map(relevante_årsposter(), |årspost: AfskrivningslovForskudsÅrspost| afskrivningslov35_årsforhøjelse(årspost, grundlag_til_forhøjelse_kroner(), input.hændelsesår)) } ellers { [] }
    | samlet_forhøjelse_kroner() -> foldl(årsforhøjelser(), 0, |sum: Heltal, forhøjelse: Afskrivningslov35Årsforhøjelse| sum + forhøjelse.forhøjelse_af_det_tidligere_indkomstår_kroner)
    | resultat() -> Afskrivningslov35Resultat(
        skatteyder = input.position.aftale.skatteyder,
        position_gyldig = position_gyldig(),
        succession_gyldig = succession_gyldig(),
        resterende_forskudsafskrivningsgrundlag_før_succession_kroner = resterende_forskudsgrundlag_kroner(),
        overtaget_ved_dødsbosuccession_kroner = hvis succession_gyldig() { input.forskudsafskrivningsgrundlag_overtaget_ved_dødsbosuccession_kroner } ellers { 0 },
        grundlag_til_forhøjelse_kroner = grundlag_til_forhøjelse_kroner(),
        genåbner_tidligere_indkomstår = genåbner_tidligere_indkomstår(),
        årsforhøjelser = årsforhøjelser(),
        samlet_forhøjelse_af_tidligere_indkomstår_kroner = samlet_forhøjelse_kroner()
    )
}
| afskrivningslov35_sag(input: Afskrivningslov35Input) -> Afskrivningslov35Sag(input)
| afskrivningslov35_resultat(input: Afskrivningslov35Input) -> afskrivningslov35_sag(input).resultat()
--@end:afskrivningsloven_par35--

--@label:afskrivningsloven_par36::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par36_juridisk_vejledning--
----
§ 36. Fristen for forhøjelse af den skattepligtige indkomst efter § 34 kan efter
tilladelse fra told- og skatteforvaltningen forlænges med indtil 3 år, hvis
aktiverne ikke er blevet afskrivningsberettigede inden udløbet af det fjerde
indkomstår efter bestillings- eller planlægningsåret, når forsinkelsen skyldes
tekniske forhold eller leverandørens konkurs og den skattepligtige ikke har
kunnet forudse eller afværge forsinkelsen eller forsinkelsen skyldes told- og
skatteforvaltningens eller andre myndigheders egne forhold.
----

--@begin:afskrivningsloven_par36--
# Afskrivningslov36Forsinkelsesgrund = Al36TekniskeForhold | Al36LeverandørensKonkurs | Al36SkatteforvaltningensEllerAndreMyndighedersEgneForhold | Al36AndenForsinkelse
# Afskrivningslov36Input(position: AfskrivningslovForskudsPosition, tilladelse_givet: Boolsk, ansøgt_forlængelse_år: Heltal, forsinkelsesgrund: Afskrivningslov36Forsinkelsesgrund, forsinkelsen_kunne_ikke_forudses_eller_afværges: Boolsk)
# Afskrivningslov36Resultat(bestillings_eller_planlægningsår: Heltal, ordinært_seneste_forhøjelsesår: Heltal, aktiver_ikke_afskrivningsberettigede_ved_ordinær_frist: Boolsk, forsinkelsesgrund_omfattet: Boolsk, tilladelse_givet: Boolsk, gyldig_fristforlængelse: Boolsk, forlængelse_år: Heltal, seneste_forhøjelsesår: Heltal)

| afskrivningslov36_forsinkelsesgrund_omfattet(input: Afskrivningslov36Input) -> match input.forsinkelsesgrund {
    | Al36TekniskeForhold -> input.forsinkelsen_kunne_ikke_forudses_eller_afværges
    | Al36LeverandørensKonkurs -> input.forsinkelsen_kunne_ikke_forudses_eller_afværges
    | Al36SkatteforvaltningensEllerAndreMyndighedersEgneForhold -> Sandt
    | Al36AndenForsinkelse -> Falskt
}

# Afskrivningslov36Sag(input: Afskrivningslov36Input) {
    | bestillingsår() -> input.position.aftale.bestillings_eller_planlægningsdato.år
    | ordinær_frist() -> bestillingsår() + 4
    | aktiver_ikke_afskrivningsberettigede() -> length(afskrivningslov32_resterende_planlagte_aktiver_i_år(input.position, ordinær_frist())) > 0
    | grund_omfattet() -> afskrivningslov36_forsinkelsesgrund_omfattet(input)
    | gyldig_fristforlængelse() -> afskrivningslov32_position_gyldig(input.position) && input.tilladelse_givet && aktiver_ikke_afskrivningsberettigede() && grund_omfattet() && input.ansøgt_forlængelse_år >= 1 && input.ansøgt_forlængelse_år <= 3
    | forlængelse_år() -> hvis gyldig_fristforlængelse() { input.ansøgt_forlængelse_år } ellers { 0 }
    | resultat() -> Afskrivningslov36Resultat(
        bestillings_eller_planlægningsår = bestillingsår(),
        ordinært_seneste_forhøjelsesår = ordinær_frist(),
        aktiver_ikke_afskrivningsberettigede_ved_ordinær_frist = aktiver_ikke_afskrivningsberettigede(),
        forsinkelsesgrund_omfattet = grund_omfattet(),
        tilladelse_givet = input.tilladelse_givet,
        gyldig_fristforlængelse = gyldig_fristforlængelse(),
        forlængelse_år = forlængelse_år(),
        seneste_forhøjelsesår = ordinær_frist() + forlængelse_år()
    )
}
| afskrivningslov36_sag(input: Afskrivningslov36Input) -> Afskrivningslov36Sag(input)
| afskrivningslov36_resultat(input: Afskrivningslov36Input) -> afskrivningslov36_sag(input).resultat()
| afskrivningslov36_ingen_fristforlængelse(position: AfskrivningslovForskudsPosition) -> afskrivningslov36_resultat(Afskrivningslov36Input(
    position = position,
    tilladelse_givet = Falskt,
    ansøgt_forlængelse_år = 0,
    forsinkelsesgrund = Al36AndenForsinkelse,
    forsinkelsen_kunne_ikke_forudses_eller_afværges = Falskt
))
--@end:afskrivningsloven_par36--

--@label:afskrivningsloven_par37::source:afskrivningsloven_lbk1222--
----
§ 37. (Ophævet)
----

--@begin:afskrivningsloven_par37--
# Afskrivningslov37Status = Al37Ophævet

| afskrivningslov37_status() -> Al37Ophævet
--@end:afskrivningsloven_par37--

--@label:afskrivningsloven_par38::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par38_juridisk_vejledning--
----
§ 38. På ejendomme med forekomster af grus, ler, kalk m.v. kan ejeren afskrive
den værdiforringelse af ejendommen, der sker som følge af udnyttelsen af disse
forekomster. Værdiforringelsen udgør den del af anskaffelsessummen, der kan
henføres til forekomsterne. Afskrivningen sker i takt med værdiforringelsen.
----

--@begin:afskrivningsloven_par38--
# Afskrivningslov38Forekomst = Al38Grus | Al38Ler | Al38Kalk | Al38Moler | Al38Tørv | Al38Brunkul | Al38AndenJordforekomst
# Afskrivningslov38Position(skatteyder: AfskrivningslovSkatteyder, forekomst: Afskrivningslov38Forekomst, ejer_af_ejendommen: Boolsk, del_af_anskaffelsessummen_henført_til_forekomsten_kroner: Heltal, tidligere_foretagne_afskrivninger_kroner: Heltal)
# Afskrivningslov38Input(indkomstår: Heltal, position: Afskrivningslov38Position, dokumenteret_værdiforringelse_som_følge_af_årets_udnyttelse_kroner: Heltal, valgt_afskrivning_kroner: Heltal)
# Afskrivningslov38Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, forekomst: Afskrivningslov38Forekomst, position_gyldig: Boolsk, omfattet_af_par38: Boolsk, afskrivningsgrundlag_kroner: Heltal, resterende_afskrivningsgrundlag_før_året_kroner: Heltal, dokumenteret_værdiforringelse_i_året_kroner: Heltal, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, fradrag_i_skattepligtig_indkomst_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal, position_efter: Afskrivningslov38Position)

# Afskrivningslov38Sag(input: Afskrivningslov38Input) {
    | afskrivningsgrundlag_kroner() -> penge_positivt_beløb(input.position.del_af_anskaffelsessummen_henført_til_forekomsten_kroner)
    | position_gyldig() -> input.position.del_af_anskaffelsessummen_henført_til_forekomsten_kroner > 0 && input.position.tidligere_foretagne_afskrivninger_kroner >= 0 && input.position.tidligere_foretagne_afskrivninger_kroner <= afskrivningsgrundlag_kroner()
    | omfattet_af_par38() -> position_gyldig() && input.position.ejer_af_ejendommen
    | resterende_før_året_kroner() -> penge_positivt_beløb(afskrivningsgrundlag_kroner() - input.position.tidligere_foretagne_afskrivninger_kroner)
    | dokumenteret_værdiforringelse_kroner() -> penge_positivt_beløb(input.dokumenteret_værdiforringelse_som_følge_af_årets_udnyttelse_kroner)
    | højeste_afskrivning_kroner() -> hvis omfattet_af_par38() { penge_mindste_beløb(resterende_før_året_kroner(), dokumenteret_værdiforringelse_kroner()) } ellers { 0 }
    | valg_gyldigt() -> omfattet_af_par38() && input.valgt_afskrivning_kroner >= 0 && input.valgt_afskrivning_kroner <= højeste_afskrivning_kroner()
    | fradrag_kroner() -> hvis valg_gyldigt() { input.valgt_afskrivning_kroner } ellers { 0 }
    | resterende_grundlag_kroner() -> penge_positivt_beløb(resterende_før_året_kroner() - fradrag_kroner())
    | position_efter() -> Afskrivningslov38Position(
        skatteyder = input.position.skatteyder,
        forekomst = input.position.forekomst,
        ejer_af_ejendommen = input.position.ejer_af_ejendommen,
        del_af_anskaffelsessummen_henført_til_forekomsten_kroner = afskrivningsgrundlag_kroner(),
        tidligere_foretagne_afskrivninger_kroner = input.position.tidligere_foretagne_afskrivninger_kroner + fradrag_kroner()
    )
    | resultat() -> Afskrivningslov38Resultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.skatteyder,
        forekomst = input.position.forekomst,
        position_gyldig = position_gyldig(),
        omfattet_af_par38 = omfattet_af_par38(),
        afskrivningsgrundlag_kroner = afskrivningsgrundlag_kroner(),
        resterende_afskrivningsgrundlag_før_året_kroner = resterende_før_året_kroner(),
        dokumenteret_værdiforringelse_i_året_kroner = dokumenteret_værdiforringelse_kroner(),
        højeste_afskrivning_kroner = højeste_afskrivning_kroner(),
        valgt_afskrivning_kroner = input.valgt_afskrivning_kroner,
        valg_gyldigt = valg_gyldigt(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_kroner(),
        resterende_afskrivningsgrundlag_kroner = resterende_grundlag_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov38_sag(input: Afskrivningslov38Input) -> Afskrivningslov38Sag(input)
| afskrivningslov38_resultat(input: Afskrivningslov38Input) -> afskrivningslov38_sag(input).resultat()
--@end:afskrivningsloven_par38--

--@label:afskrivningsloven_par39::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par39_juridisk_vejledning--
----
§ 39. Udgifter til ombygning, forbedring eller indretning af lejede lokaler, der
anvendes erhvervsmæssigt til andet formål end beboelse, afskrives med indtil 20
pct. årligt. Hvis lejemålet er indgået for et bestemt tidsrum, kan den årlige
afskrivning dog ikke overstige et beløb svarende til, at afskrivning sker med
lige store årlige beløb over lejeperioden. Hvis lejemålet er uopsigeligt fra
udlejers side i en forud fastsat periode, kan den årlige afskrivning ikke
overstige et beløb svarende til, at afskrivning sker med lige store årlige
beløb over uopsigelighedsperioden. Hvis lejemålet er uopsigeligt fra udlejers
side uden tidsmæssig begrænsning, kan der afskrives med de i § 17 nævnte satser.

Stk. 2. Ved lejemål, hvor der som følge af, at den ene part har en bestemmende
indflydelse på den anden parts handlemåde eller ved lejemål mellem nærtstående,
ikke er en reel risiko for opsigelse, kan der ikke afskrives. Endvidere kan der
ikke afskrives ved lejemål, hvor lejemålet er indgået mellem selskaber eller
mellem personer og selskaber, i det omfang nærtstående har bestemmende
indflydelse i det eller de selskaber, der er part i lejemålet. Bestemmende
indflydelse vil altid foreligge, såfremt en eller flere personer på grund af
ejerskab eller rådighed over stemmerettigheder direkte eller indirekte ejer
mere end 50 pct. af aktiekapitalen eller råder over mere end 50 pct. af
stemmerne i et selskab, der er part i lejemålet. I øvrige tilfælde foreligger
der bestemmende indflydelse, såfremt der direkte eller indirekte ejes mere end
50 pct. i ejerandel. Som nærtstående anses den skattepligtiges ægtefælle,
forældre og bedsteforældre samt børn og børnebørn og disses ægtefæller eller
dødsboer efter de nævnte personer. Stedbarns- og adoptivforhold sidestilles med
ægte slægtskabsforhold. Der kan ligeledes ikke afskrives, hvis lejeren er
tillagt en køberet til de lejede lokaler ved lejeperiodens udløb på vilkår, der
afviger fra markedsvilkår. Er lokalerne efter deres anvendelse omfattet af § 14,
kan lejeren dog afskrive med de i § 17 nævnte satser.

Stk. 3. Der kan ikke afskrives i det indkomstår, hvori lejemålet er ophørt.

Stk. 4. I tilfælde af nedrivning, inden udgifterne er afskrevet fuldt ud, kan
restbeløbet fradrages i nedrivningsåret. Dette gælder dog ikke for lejemål
omfattet af stk. 2.

Stk. 5. Hvis lejer erhverver den bygning, hvori de lejede lokaler befinder sig,
kan et uafskrevet restbeløb på udgifter til ombygning af lejede lokaler, der
ikke indgår i købesummen for bygningen, tillægges anskaffelsessummen for
bygningen og afskrives sammen med denne med de i § 17 nævnte satser.

Stk. 6. Ved afståelse af lejede lokaler medregnes fortjeneste eller tab på
ombygnings- og forbedringsudgifter, indretninger m.v. ved opgørelsen af den
skattepligtige indkomst. Fortjenesten eller tabet opgøres som forskellen mellem
på den ene side afståelsessummen og på den anden side de afskrivningsberettigede
udgifter til anskaffelse, forbedring m.v. med fradrag af samtlige foretagne
afskrivninger.
----

--@begin:afskrivningsloven_par39--
# Afskrivningslov39Lejevilkår = Al39LøbendeLejemål | Al39BestemtTidsrum(antal_år: Heltal) | Al39UdlejerUopsigeligFastPeriode(antal_år: Heltal) | Al39UdlejerUopsigeligUdenTidsbegrænsning
# Afskrivningslov39NærtståendeRelation = Al39IkkeNærtstående | Al39Ægtefælle | Al39ForælderEllerBedsteforælder | Al39BarnEllerBarnebarn | Al39ÆgtefælleTilBarnEllerBarnebarn | Al39DødsboEfterNærtstående | Al39StedbarnsEllerAdoptivforhold
# Afskrivningslov39Kontrol(part_kapitalandel_basispoint: Heltal, part_stemmerettigheder_basispoint: Heltal, part_ejerandel_basispoint: Heltal, part_anden_bestemmende_indflydelse: Boolsk, relation_mellem_udlejer_og_lejer: Afskrivningslov39NærtståendeRelation, lejemål_mellem_selskaber_eller_mellem_person_og_selskab: Boolsk, nærtstående_kapitalandel_basispoint: Heltal, nærtstående_stemmerettigheder_basispoint: Heltal, nærtstående_ejerandel_basispoint: Heltal, nærtstående_anden_bestemmende_indflydelse: Boolsk, reel_risiko_for_opsigelse: Boolsk, køberet_til_lokalerne_afviger_fra_markedsvilkår: Boolsk)
# Afskrivningslov39Par14Status = Al39LokalerIkkeOmfattetAfPar14 | Al39LokalerOmfattetAfPar14(resultat: Afskrivningslov14Resultat)
# Afskrivningslov39Position(skatteyder: AfskrivningslovSkatteyder, anskaffelses_eller_forbedringsår: Heltal, afskrivningsberettigede_udgifter_kroner: Heltal, tidligere_foretagne_afskrivninger_kroner: Heltal, lokaler_anvendes_erhvervsmæssigt: Boolsk, lokaler_anvendes_til_andet_end_beboelse: Boolsk, lejevilkår: Afskrivningslov39Lejevilkår, kontrol: Afskrivningslov39Kontrol, par14_status: Afskrivningslov39Par14Status)
# Afskrivningslov39Hændelse = Al39FortsatLejemål | Al39LejemålOphørt(afståelsessum_kroner: Heltal) | Al39LokalerNedrevet | Al39LejerErhververBygning(restbeløb_indgår_i_købesummen: Boolsk) | Al39LejedeLokalerAfstået(afståelsessum_kroner: Heltal)
# Afskrivningslov39Input(indkomstår: Heltal, position: Afskrivningslov39Position, hændelse: Afskrivningslov39Hændelse, valgt_afskrivning_kroner: Heltal)
# Afskrivningslov39Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, hændelse: Afskrivningslov39Hændelse, position_gyldig: Boolsk, omfattet_af_par39: Boolsk, bestemmende_indflydelse: Boolsk, nærtstående_bestemmende_indflydelse: Boolsk, lejemål_omfattet_af_stk2: Boolsk, par14_undtagelse_anvendes: Boolsk, højeste_sats_basispoint: Heltal, lineært_periodemaksimum_kroner: Heltal, resterende_afskrivningsgrundlag_før_året_kroner: Heltal, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, afskrivning_i_skattepligtig_indkomst_kroner: Heltal, nedrivningsfradrag_kroner: Heltal, restbeløb_til_bygningens_anskaffelsessum_kroner: Heltal, afståelsessum_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal, position_efter: Afskrivningslov39Position)

| afskrivningslov39_nærtstående(relation: Afskrivningslov39NærtståendeRelation) -> relation != Al39IkkeNærtstående
| afskrivningslov39_kontrol_gyldig(kontrol: Afskrivningslov39Kontrol) -> kontrol.part_kapitalandel_basispoint >= 0 && kontrol.part_kapitalandel_basispoint <= 10000 && kontrol.part_stemmerettigheder_basispoint >= 0 && kontrol.part_stemmerettigheder_basispoint <= 10000 && kontrol.part_ejerandel_basispoint >= 0 && kontrol.part_ejerandel_basispoint <= 10000 && kontrol.nærtstående_kapitalandel_basispoint >= 0 && kontrol.nærtstående_kapitalandel_basispoint <= 10000 && kontrol.nærtstående_stemmerettigheder_basispoint >= 0 && kontrol.nærtstående_stemmerettigheder_basispoint <= 10000 && kontrol.nærtstående_ejerandel_basispoint >= 0 && kontrol.nærtstående_ejerandel_basispoint <= 10000
| afskrivningslov39_bestemmende_indflydelse(kontrol: Afskrivningslov39Kontrol) -> kontrol.part_kapitalandel_basispoint > 5000 || kontrol.part_stemmerettigheder_basispoint > 5000 || kontrol.part_ejerandel_basispoint > 5000 || kontrol.part_anden_bestemmende_indflydelse
| afskrivningslov39_nærtstående_bestemmende_indflydelse(kontrol: Afskrivningslov39Kontrol) -> kontrol.nærtstående_kapitalandel_basispoint > 5000 || kontrol.nærtstående_stemmerettigheder_basispoint > 5000 || kontrol.nærtstående_ejerandel_basispoint > 5000 || kontrol.nærtstående_anden_bestemmende_indflydelse
| afskrivningslov39_lejemål_omfattet_af_stk2(kontrol: Afskrivningslov39Kontrol) -> ((afskrivningslov39_bestemmende_indflydelse(kontrol) || afskrivningslov39_nærtstående(kontrol.relation_mellem_udlejer_og_lejer)) && kontrol.reel_risiko_for_opsigelse == Falskt) || (kontrol.lejemål_mellem_selskaber_eller_mellem_person_og_selskab && afskrivningslov39_nærtstående_bestemmende_indflydelse(kontrol)) || kontrol.køberet_til_lokalerne_afviger_fra_markedsvilkår
| afskrivningslov39_par14_resultat(status: Afskrivningslov39Par14Status) -> match status {
    | Al39LokalerIkkeOmfattetAfPar14 -> Falskt
    | Al39LokalerOmfattetAfPar14(resultat) -> resultat.omfattet_af_par14
}
| afskrivningslov39_par14_skatteyder_matcher(position: Afskrivningslov39Position) -> match position.par14_status {
    | Al39LokalerIkkeOmfattetAfPar14 -> Sandt
    | Al39LokalerOmfattetAfPar14(resultat) -> resultat.skatteyder == position.skatteyder
}
| afskrivningslov39_lejeperiode_år(lejevilkår: Afskrivningslov39Lejevilkår) -> match lejevilkår {
    | Al39BestemtTidsrum(antal_år) -> antal_år
    | Al39UdlejerUopsigeligFastPeriode(antal_år) -> antal_år
    | _ -> 0
}
| afskrivningslov39_par17_sats_basispoint(anskaffelses_eller_forbedringsår: Heltal) -> hvis anskaffelses_eller_forbedringsår > 0 && anskaffelses_eller_forbedringsår < 2023 { 400 } ellers { 300 }
| afskrivningslov39_afståelsessum_kroner(hændelse: Afskrivningslov39Hændelse) -> match hændelse {
    | Al39LejemålOphørt(afståelsessum_kroner) -> penge_positivt_beløb(afståelsessum_kroner)
    | Al39LejedeLokalerAfstået(afståelsessum_kroner) -> penge_positivt_beløb(afståelsessum_kroner)
    | _ -> 0
}
| afskrivningslov39_afståelse(hændelse: Afskrivningslov39Hændelse) -> match hændelse {
    | Al39LejemålOphørt(_) -> Sandt
    | Al39LejedeLokalerAfstået(_) -> Sandt
    | _ -> Falskt
}

# Afskrivningslov39Sag(input: Afskrivningslov39Input) {
    | afskrivningsgrundlag_kroner() -> penge_positivt_beløb(input.position.afskrivningsberettigede_udgifter_kroner)
    | position_gyldig() -> input.position.anskaffelses_eller_forbedringsår > 0 && input.position.afskrivningsberettigede_udgifter_kroner > 0 && input.position.tidligere_foretagne_afskrivninger_kroner >= 0 && input.position.tidligere_foretagne_afskrivninger_kroner <= afskrivningsgrundlag_kroner() && afskrivningslov39_kontrol_gyldig(input.position.kontrol) && afskrivningslov39_par14_skatteyder_matcher(input.position) && (afskrivningslov39_lejeperiode_år(input.position.lejevilkår) > 0 || match input.position.lejevilkår { | Al39LøbendeLejemål -> Sandt | Al39UdlejerUopsigeligUdenTidsbegrænsning -> Sandt | _ -> Falskt })
    | omfattet_af_par39() -> position_gyldig() && input.position.lokaler_anvendes_erhvervsmæssigt && input.position.lokaler_anvendes_til_andet_end_beboelse
    | stk2_lejemål() -> afskrivningslov39_lejemål_omfattet_af_stk2(input.position.kontrol)
    | par14_undtagelse() -> stk2_lejemål() && afskrivningslov39_par14_resultat(input.position.par14_status)
    | afskrivningsberettiget() -> omfattet_af_par39() && (stk2_lejemål() == Falskt || par14_undtagelse())
    | resterende_før_året_kroner() -> penge_positivt_beløb(afskrivningsgrundlag_kroner() - input.position.tidligere_foretagne_afskrivninger_kroner)
    | bruger_par17_sats() -> par14_undtagelse() || input.position.lejevilkår == Al39UdlejerUopsigeligUdenTidsbegrænsning
    | højeste_sats_basispoint() -> hvis bruger_par17_sats() { afskrivningslov39_par17_sats_basispoint(input.position.anskaffelses_eller_forbedringsår) } ellers { 2000 }
    | lineært_periodemaksimum_kroner() -> hvis afskrivningslov39_lejeperiode_år(input.position.lejevilkår) > 0 { afskrivningsgrundlag_kroner() / afskrivningslov39_lejeperiode_år(input.position.lejevilkår) } ellers { 0 }
    | satsmaksimum_kroner() -> penge_beløb_gange_basispoint_kroner(afskrivningsgrundlag_kroner(), højeste_sats_basispoint())
    | højeste_før_rest_kroner() -> hvis lineært_periodemaksimum_kroner() > 0 { penge_mindste_beløb(satsmaksimum_kroner(), lineært_periodemaksimum_kroner()) } ellers { satsmaksimum_kroner() }
    | almindelig_årsafskrivning_mulig() -> input.hændelse == Al39FortsatLejemål && afskrivningsberettiget() && input.indkomstår >= input.position.anskaffelses_eller_forbedringsår
    | højeste_afskrivning_kroner() -> hvis almindelig_årsafskrivning_mulig() { penge_mindste_beløb(resterende_før_året_kroner(), højeste_før_rest_kroner()) } ellers { 0 }
    | valg_gyldigt() -> hvis almindelig_årsafskrivning_mulig() { input.valgt_afskrivning_kroner >= 0 && input.valgt_afskrivning_kroner <= højeste_afskrivning_kroner() } ellers { position_gyldig() && input.valgt_afskrivning_kroner == 0 }
    | afskrivning_kroner() -> hvis valg_gyldigt() && almindelig_årsafskrivning_mulig() { input.valgt_afskrivning_kroner } ellers { 0 }
    | rest_efter_årsafskrivning_kroner() -> penge_positivt_beløb(resterende_før_året_kroner() - afskrivning_kroner())
    | nedrivningsfradrag_kroner() -> hvis input.hændelse == Al39LokalerNedrevet && omfattet_af_par39() && stk2_lejemål() == Falskt { rest_efter_årsafskrivning_kroner() } ellers { 0 }
    | rest_til_bygning_kroner() -> match input.hændelse {
        | Al39LejerErhververBygning(restbeløb_indgår_i_købesummen) -> hvis afskrivningsberettiget() && restbeløb_indgår_i_købesummen == Falskt { rest_efter_årsafskrivning_kroner() } ellers { 0 }
        | _ -> 0
    }
    | afståelsessum_kroner() -> afskrivningslov39_afståelsessum_kroner(input.hændelse)
    | afståelsesresultat_kroner() -> hvis afskrivningslov39_afståelse(input.hændelse) && afskrivningsberettiget() { afståelsessum_kroner() - rest_efter_årsafskrivning_kroner() } ellers { 0 }
    | skattepligtig_fortjeneste_kroner() -> penge_positivt_beløb(afståelsesresultat_kroner())
    | fradragsberettiget_tab_kroner() -> hvis stk2_lejemål() { 0 } ellers { penge_positivt_beløb(0 - afståelsesresultat_kroner()) }
    | samlet_fradrag_kroner() -> afskrivning_kroner() + nedrivningsfradrag_kroner() + fradragsberettiget_tab_kroner()
    | resterende_grundlag_kroner() -> hvis input.hændelse == Al39FortsatLejemål { rest_efter_årsafskrivning_kroner() } ellers { 0 }
    | position_efter() -> Afskrivningslov39Position(
        skatteyder = input.position.skatteyder,
        anskaffelses_eller_forbedringsår = input.position.anskaffelses_eller_forbedringsår,
        afskrivningsberettigede_udgifter_kroner = afskrivningsgrundlag_kroner(),
        tidligere_foretagne_afskrivninger_kroner = input.position.tidligere_foretagne_afskrivninger_kroner + afskrivning_kroner(),
        lokaler_anvendes_erhvervsmæssigt = input.position.lokaler_anvendes_erhvervsmæssigt,
        lokaler_anvendes_til_andet_end_beboelse = input.position.lokaler_anvendes_til_andet_end_beboelse,
        lejevilkår = input.position.lejevilkår,
        kontrol = input.position.kontrol,
        par14_status = input.position.par14_status
    )
    | resultat() -> Afskrivningslov39Resultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.skatteyder,
        hændelse = input.hændelse,
        position_gyldig = position_gyldig(),
        omfattet_af_par39 = omfattet_af_par39(),
        bestemmende_indflydelse = afskrivningslov39_bestemmende_indflydelse(input.position.kontrol),
        nærtstående_bestemmende_indflydelse = afskrivningslov39_nærtstående_bestemmende_indflydelse(input.position.kontrol),
        lejemål_omfattet_af_stk2 = stk2_lejemål(),
        par14_undtagelse_anvendes = par14_undtagelse(),
        højeste_sats_basispoint = højeste_sats_basispoint(),
        lineært_periodemaksimum_kroner = lineært_periodemaksimum_kroner(),
        resterende_afskrivningsgrundlag_før_året_kroner = resterende_før_året_kroner(),
        højeste_afskrivning_kroner = højeste_afskrivning_kroner(),
        valgt_afskrivning_kroner = input.valgt_afskrivning_kroner,
        valg_gyldigt = valg_gyldigt(),
        afskrivning_i_skattepligtig_indkomst_kroner = afskrivning_kroner(),
        nedrivningsfradrag_kroner = nedrivningsfradrag_kroner(),
        restbeløb_til_bygningens_anskaffelsessum_kroner = rest_til_bygning_kroner(),
        afståelsessum_kroner = afståelsessum_kroner(),
        skattepligtig_fortjeneste_kroner = skattepligtig_fortjeneste_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        samlet_fradrag_i_skattepligtig_indkomst_kroner = samlet_fradrag_kroner(),
        resterende_afskrivningsgrundlag_kroner = resterende_grundlag_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov39_sag(input: Afskrivningslov39Input) -> Afskrivningslov39Sag(input)
| afskrivningslov39_resultat(input: Afskrivningslov39Input) -> afskrivningslov39_sag(input).resultat()
--@end:afskrivningsloven_par39--

--@label:afskrivningsloven_par40::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par40_juridisk_vejledning--
----
§ 40. Ved erhvervelse af goodwill kan erhververen fra og med det indkomstår,
hvori der er indgået endelig aftale om overdragelsen, afskrive anskaffelsessummen
i sin skattepligtige indkomst med indtil 1/7 årligt. Det gælder dog ikke
goodwill, der er erhvervet fra et selskab m.v. omfattet af selskabsskattelovens
§ 3, stk. 1, nr. 9 eller 18.

Stk. 2. Ved erhvervelse af andre immaterielle aktiver såsom særlig
fremstillingsmetode eller lignende (knowhow), patentret, forfatter- og
kunstnerret og ret til mønster eller varemærke eller ved erhvervelse af retten
ifølge en udbytte-, forpagtnings- eller lejekontrakt kan erhververen fra og med
det indkomstår, hvori der er indgået endelig aftale om overdragelsen, afskrive
anskaffelsessummen i sin skattepligtige indkomst med indtil 1/7 årligt.
Anskaffelsessummen for bevilling, tilladelse eller rettighed til forundersøgelse,
efterforskning og indvinding af kulbrinter afskrives dog med lige store årlige
beløb over rettighedsperioden. Er overdragelsen af en udbytteret omfattet af
ligningslovens § 12 B, stk. 7, kan erhververen ikke afskrive efter 1. pkt. Ved
erhvervelse af rettigheder, der er beskyttet efter anden lovgivning, og hvor
beskyttelsesperioden på aftaletidspunktet er mindre end 7 år, erstattes den
sats, der er nævnt i 1. pkt., med en sats, der svarer til, at
anskaffelsessummen afskrives med lige store årlige beløb over
beskyttelsesperioden.

Stk. 3. Godtgørelse i anledning af opgivelse af agentur eller lignende,
vederlag for påtagelse af indskrænkninger i adgangen til fri erhvervsudøvelse
(konkurrenceklausuler), når vederlaget ydes én gang for alle, samt vederlag for
afløsning af pensionstilsagn, der ikke er afdækket i et pensionsinstitut,
afskrives i yderens skattepligtige indkomst med indtil 1/7 årligt. Udgør ydelser
af denne art tilsammen mindre end 5 pct. af den samlede lønudgift i yderens
virksomhed i det pågældende indkomstår, fradrages de dog fuldt ud ved opgørelsen
af den skattepligtige indkomst for dette indkomstår.

Stk. 4. Der kan ikke foretages afskrivning i det indkomstår, hvori et aktiv som
nævnt i stk. 1 og 2 sælges eller opgives.

Stk. 5. Ved overdragelse mellem en person og et selskab m.v. eller mellem
selskaber m.v. indbyrdes, hvor den ene af parterne i overdragelsen på grund af
aktiebesiddelse, vedtægtsbestemmelse, aftale eller fælles ledelse har
bestemmende indflydelse på den anden parts handlemåde, nedsættes erhververens
afskrivningsgrundlag efter stk. 1 med et beløb svarende til den
ikkeafskrivningsberettigede del af overdragerens anskaffelsessum. Ved
bestemmende indflydelse på grund af aktiebesiddelse forstås ejerskab eller
rådighed over stemmerettigheder, således at der direkte eller indirekte ejes
mere end 50 pct. af aktiekapitalen eller rådes over mere end 50 pct. af
stemmerne. I øvrige tilfælde foreligger der bestemmende indflydelse ved
ejerskab, såfremt der direkte eller indirekte ejes mere end 50 pct. i
ejerandel.

Stk. 6. Ved salg eller opgivelse af aktiver omfattet af stk. 1 og 2 medregnes
fortjeneste eller tab ved opgørelsen af den skattepligtige indkomst. Fortjeneste
eller tab opgøres som forskellen mellem afståelsessummen og anskaffelsessummen
med fradrag for samtlige foretagne afskrivninger, herunder forlods
afskrivninger. Er aftalen om salg eller opgivelsen af en udbytteret omfattet af
ligningslovens § 12 B, stk. 6, finder 1. og 2. pkt. ikke anvendelse.

Stk. 7. Told- og skatteforvaltningen giver efter den skattepligtiges begæring
rentefri henstand med betaling af skatten af fortjenesten efter stk. 6, 1. og 2.
pkt., såfremt vederlaget udgøres af en løbende ydelse som omfattet af
ligningslovens § 12 B, stk. 1-5. Udgøres vederlaget for et aktiv omfattet af
stk. 1 og 2 kun delvis af en sådan løbende ydelse, kan der gives henstand for
den del af skatten af fortjenesten, som svarer til forholdet mellem den
kapitaliserede værdi af den løbende ydelse og afståelsessummen for det
pågældende aktiv. I det indkomstår, hvor fortjenesten medregnes til den
skattepligtige indkomst, fragår henstandsbeløbet i den slutskat, der indgår ved
opgørelsen af restskat og overskydende skat efter kildeskattelovens §§ 60-62,
jf. § 62 A, eller selskabsskattelovens § 29 B, stk. 4 og 5. Der kan i samme
omfang gives henstand med arbejdsmarkedsbidrag efter §§ 4 og 5 i lov om
arbejdsmarkedsbidrag. Det er en betingelse for opnåelse af henstand, at
begæringen indsendes inden udløbet af oplysningsfristen efter
skattekontrollovens §§ 10-13 for aftaleåret. De modtagne ydelser skal betales
som afdrag på henstandsbeløbet. Beløbet forfalder til betaling den 1. i måneden
efter modtagelsen af ydelsen med sidste rettidige betalingsdag den 10. i
forfaldsmåneden. Betales beløbet ikke rettidigt, skal der betales rente i
henhold til § 7, stk. 2, i lov om opkrævning af skatter og afgifter m.v. med
tillæg af 0,4 procentpoint for hver påbegyndt måned fra forfaldsdagen at regne,
dog mindst 25 kr. Renten kan ikke fratrækkes ved opgørelsen af den
skattepligtige indkomst. Der betales et rykkergebyr på 65 kr. for
erindringsskrivelser vedrørende manglende betaling af afdrag på
henstandsbeløbet. Grov og gentagen misligholdelse af henstandsordningen
medfører, at det resterende henstandsbeløb forfalder til betaling efter påkrav.
Er hele henstandsbeløbet ikke betalt senest 7 år efter indgåelsen af
overdragelsesaftalen, forfalder restbeløbet til betaling ved udløbet af dette
indkomstår, med sidste rettidige betalingsdag den 10. i den efterfølgende
måned. Såfremt de løbende ydelser endeligt ophører inden 7 år, uden at
modtageren fra yderen har opnået et tilstrækkeligt beløb til dækning af
henstandsbeløbet, frafaldes kravet på det ikke betalte henstandsbeløb. Uanset
eventuel henstand skal de kommunale andele af skatten af fortjenesten efter stk.
6, 1. og 2. pkt., afregnes i indkomståret efter reglerne i lov om kommunal
indkomstskat og statens afregning af grundskyld og dækningsafgift til
kommunerne.

Stk. 8. Godtgørelser og vederlag omfattet af stk. 3 medregnes ved opgørelsen af
den skattepligtige indkomst.
----

--@begin:afskrivningsloven_par40--
# Afskrivningslov40Aktivart = Al40Goodwill | Al40Knowhow | Al40Patentret | Al40ForfatterEllerKunstnerret | Al40MønsterEllerVaremærkeret | Al40Udbytteret | Al40Forpagtningsret | Al40Lejeret | Al40KulbrintebevillingTilladelseEllerRettighed | Al40AndenLovbeskyttetRettighed | Al40AgenturOpgivelsesgodtgørelse | Al40KonkurrenceklausulVederlag | Al40PensionstilsagnAfløsning
# Afskrivningslov40Kontrol(overdragelse_mellem_person_og_selskab_eller_mellem_selskaber: Boolsk, kapitalandel_basispoint: Heltal, stemmerettigheder_basispoint: Heltal, ejerandel_basispoint: Heltal, bestemmende_indflydelse_ved_vedtægt_aftale_eller_fælles_ledelse: Boolsk, ikkeafskrivningsberettiget_del_af_overdragerens_anskaffelsessum_kroner: Heltal)
# Afskrivningslov40Grundlag = Al40ErhvervetAktiv(erhverver: AfskrivningslovSkatteyder, aktivart: Afskrivningslov40Aktivart, endelig_aftaledato: AfskrivningslovDato, anskaffelsessum_kroner: Heltal, beskyttelses_eller_rettighedsperiode_år: Heltal, goodwill_erhvervet_fra_selskabsskattelov3_stk1_nr9_eller_nr18: Boolsk, udbytteret_omfattet_af_ligningslov12b_stk7: Boolsk, kontrol: Afskrivningslov40Kontrol) | Al40YdetGodtgørelseEllerVederlag(yder: AfskrivningslovSkatteyder, modtager: AfskrivningslovSkatteyder, aktivart: Afskrivningslov40Aktivart, endelig_aftaledato: AfskrivningslovDato, ydet_beløb_kroner: Heltal, samlede_ydelser_af_stk3_art_i_indkomståret_kroner: Heltal, samlet_lønudgift_i_indkomståret_kroner: Heltal)
# Afskrivningslov40Position(grundlag: Afskrivningslov40Grundlag, tidligere_foretagne_afskrivninger_og_fradrag_kroner: Heltal, forlods_afskrivninger_kroner: Heltal)
# Afskrivningslov40Hændelse = Al40FortsatEjerskabEllerForpligtelse | Al40AktivSolgt(afståelsessum_kroner: Heltal, udbytteretsaftale_omfattet_af_ligningslov12b_stk6: Boolsk) | Al40AktivOpgivet(afståelsessum_kroner: Heltal, udbytteretsopgivelse_omfattet_af_ligningslov12b_stk6: Boolsk)
# Afskrivningslov40Input(indkomstår: Heltal, position: Afskrivningslov40Position, hændelse: Afskrivningslov40Hændelse, valgt_afskrivning_kroner: Heltal)
# Afskrivningslov40Resultat(indkomstår: Heltal, fradragsberettiget_skatteyder: AfskrivningslovSkatteyder, skattepligtig_modtager: AfskrivningslovSkatteyder, aktivart: Afskrivningslov40Aktivart, hændelse: Afskrivningslov40Hændelse, position_gyldig: Boolsk, omfattet_af_par40: Boolsk, bestemmende_indflydelse: Boolsk, oprindelig_anskaffelsessum_eller_ydelse_kroner: Heltal, nedsættelse_af_goodwillgrundlag_kroner: Heltal, afskrivningsgrundlag_kroner: Heltal, resterende_afskrivningsgrundlag_før_året_kroner: Heltal, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, årlig_afskrivning_kroner: Heltal, straksfradrag_efter_fem_procent_reglen_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal, afståelsessum_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, godtgørelse_eller_vederlag_skattepligtigt_hos_modtager_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal, position_efter: Afskrivningslov40Position)
# Afskrivningslov40SkatteyderResultat(skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov40Aktivart, årlig_afskrivning_kroner: Heltal, straksfradrag_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, samlet_fradrag_i_skattepligtig_indkomst_kroner: Heltal)
# Afskrivningslov40ModtagerResultat(skatteyder: AfskrivningslovSkatteyder, aktivart: Afskrivningslov40Aktivart, godtgørelse_eller_vederlag_i_skattepligtig_indkomst_kroner: Heltal)

| afskrivningslov40_stk1_aktiv(aktivart: Afskrivningslov40Aktivart) -> aktivart == Al40Goodwill
| afskrivningslov40_stk2_aktiv(aktivart: Afskrivningslov40Aktivart) -> aktivart == Al40Knowhow || aktivart == Al40Patentret || aktivart == Al40ForfatterEllerKunstnerret || aktivart == Al40MønsterEllerVaremærkeret || aktivart == Al40Udbytteret || aktivart == Al40Forpagtningsret || aktivart == Al40Lejeret || aktivart == Al40KulbrintebevillingTilladelseEllerRettighed || aktivart == Al40AndenLovbeskyttetRettighed
| afskrivningslov40_stk3_ydelse(aktivart: Afskrivningslov40Aktivart) -> aktivart == Al40AgenturOpgivelsesgodtgørelse || aktivart == Al40KonkurrenceklausulVederlag || aktivart == Al40PensionstilsagnAfløsning
| afskrivningslov40_fradragsberettiget_skatteyder(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(erhverver, _, _, _, _, _, _, _) -> erhverver
    | Al40YdetGodtgørelseEllerVederlag(yder, _, _, _, _, _, _) -> yder
}
| afskrivningslov40_modtager(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(erhverver, _, _, _, _, _, _, _) -> erhverver
    | Al40YdetGodtgørelseEllerVederlag(_, modtager, _, _, _, _, _) -> modtager
}
| afskrivningslov40_aktivart(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, aktivart, _, _, _, _, _, _) -> aktivart
    | Al40YdetGodtgørelseEllerVederlag(_, _, aktivart, _, _, _, _) -> aktivart
}
| afskrivningslov40_aftaledato(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, _, dato, _, _, _, _, _) -> dato
    | Al40YdetGodtgørelseEllerVederlag(_, _, _, dato, _, _, _) -> dato
}
| afskrivningslov40_oprindeligt_beløb_kroner(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, _, _, anskaffelsessum_kroner, _, _, _, _) -> penge_positivt_beløb(anskaffelsessum_kroner)
    | Al40YdetGodtgørelseEllerVederlag(_, _, _, _, ydet_beløb_kroner, _, _) -> penge_positivt_beløb(ydet_beløb_kroner)
}
| afskrivningslov40_periode_år(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, _, _, _, periode_år, _, _, _) -> periode_år
    | Al40YdetGodtgørelseEllerVederlag(_, _, _, _, _, _, _) -> 0
}
| afskrivningslov40_kontrol_gyldig(kontrol: Afskrivningslov40Kontrol) -> kontrol.kapitalandel_basispoint >= 0 && kontrol.kapitalandel_basispoint <= 10000 && kontrol.stemmerettigheder_basispoint >= 0 && kontrol.stemmerettigheder_basispoint <= 10000 && kontrol.ejerandel_basispoint >= 0 && kontrol.ejerandel_basispoint <= 10000 && kontrol.ikkeafskrivningsberettiget_del_af_overdragerens_anskaffelsessum_kroner >= 0
| afskrivningslov40_bestemmende_indflydelse(kontrol: Afskrivningslov40Kontrol) -> kontrol.overdragelse_mellem_person_og_selskab_eller_mellem_selskaber && (kontrol.kapitalandel_basispoint > 5000 || kontrol.stemmerettigheder_basispoint > 5000 || kontrol.ejerandel_basispoint > 5000 || kontrol.bestemmende_indflydelse_ved_vedtægt_aftale_eller_fælles_ledelse)
| afskrivningslov40_kontrol(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, _, _, _, _, _, _, kontrol) -> kontrol
    | Al40YdetGodtgørelseEllerVederlag(_, _, _, _, _, _, _) -> Afskrivningslov40Kontrol(
        overdragelse_mellem_person_og_selskab_eller_mellem_selskaber = Falskt,
        kapitalandel_basispoint = 0,
        stemmerettigheder_basispoint = 0,
        ejerandel_basispoint = 0,
        bestemmende_indflydelse_ved_vedtægt_aftale_eller_fælles_ledelse = Falskt,
        ikkeafskrivningsberettiget_del_af_overdragerens_anskaffelsessum_kroner = 0
    )
}
| afskrivningslov40_goodwill_udelukket(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, Al40Goodwill, _, _, _, erhvervet_fra_udelukket_selskab, _, _) -> erhvervet_fra_udelukket_selskab
    | _ -> Falskt
}
| afskrivningslov40_udbytteret_udelukket(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40ErhvervetAktiv(_, Al40Udbytteret, _, _, _, _, omfattet_af_ll12b_stk7, _) -> omfattet_af_ll12b_stk7
    | _ -> Falskt
}
| afskrivningslov40_stk3_samlede_ydelser_kroner(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40YdetGodtgørelseEllerVederlag(_, _, _, _, _, samlede_ydelser_kroner, _) -> penge_positivt_beløb(samlede_ydelser_kroner)
    | _ -> 0
}
| afskrivningslov40_stk3_lønudgift_kroner(grundlag: Afskrivningslov40Grundlag) -> match grundlag {
    | Al40YdetGodtgørelseEllerVederlag(_, _, _, _, _, _, lønudgift_kroner) -> penge_positivt_beløb(lønudgift_kroner)
    | _ -> 0
}
| afskrivningslov40_disposition(hændelse: Afskrivningslov40Hændelse) -> hændelse != Al40FortsatEjerskabEllerForpligtelse
| afskrivningslov40_afståelsessum_kroner(hændelse: Afskrivningslov40Hændelse) -> match hændelse {
    | Al40AktivSolgt(afståelsessum_kroner, _) -> penge_positivt_beløb(afståelsessum_kroner)
    | Al40AktivOpgivet(afståelsessum_kroner, _) -> penge_positivt_beløb(afståelsessum_kroner)
    | Al40FortsatEjerskabEllerForpligtelse -> 0
}
| afskrivningslov40_disposition_omfattet_af_ll12b_stk6(hændelse: Afskrivningslov40Hændelse) -> match hændelse {
    | Al40AktivSolgt(_, omfattet) -> omfattet
    | Al40AktivOpgivet(_, omfattet) -> omfattet
    | Al40FortsatEjerskabEllerForpligtelse -> Falskt
}

# Afskrivningslov40Sag(input: Afskrivningslov40Input) {
    | aktivart() -> afskrivningslov40_aktivart(input.position.grundlag)
    | oprindeligt_beløb_kroner() -> afskrivningslov40_oprindeligt_beløb_kroner(input.position.grundlag)
    | aftaledato_gyldig() -> afskrivningslov_dato_gyldig(afskrivningslov40_aftaledato(input.position.grundlag))
    | bestemmende_indflydelse() -> afskrivningslov40_bestemmende_indflydelse(afskrivningslov40_kontrol(input.position.grundlag))
    | goodwillgrundlag_nedsættelse_kroner() -> hvis afskrivningslov40_stk1_aktiv(aktivart()) && bestemmende_indflydelse() { penge_mindste_beløb(oprindeligt_beløb_kroner(), penge_positivt_beløb(afskrivningslov40_kontrol(input.position.grundlag).ikkeafskrivningsberettiget_del_af_overdragerens_anskaffelsessum_kroner)) } ellers { 0 }
    | afskrivningsgrundlag_kroner() -> penge_positivt_beløb(oprindeligt_beløb_kroner() - goodwillgrundlag_nedsættelse_kroner())
    | grundlagstype_gyldig() -> match input.position.grundlag {
        | Al40ErhvervetAktiv(_, aktivart, _, _, periode_år, _, _, _) -> (afskrivningslov40_stk1_aktiv(aktivart) || afskrivningslov40_stk2_aktiv(aktivart)) && hvis aktivart == Al40KulbrintebevillingTilladelseEllerRettighed { periode_år > 0 } ellers { hvis aktivart == Al40AndenLovbeskyttetRettighed { periode_år > 0 } ellers { Sandt } }
        | Al40YdetGodtgørelseEllerVederlag(_, _, aktivart, _, ydet_beløb_kroner, samlede_ydelser_kroner, _) -> afskrivningslov40_stk3_ydelse(aktivart) && ydet_beløb_kroner > 0 && samlede_ydelser_kroner >= ydet_beløb_kroner
    }
    | forlods_afskrivninger_gyldige() -> match input.position.grundlag {
        | Al40ErhvervetAktiv(_, _, _, _, _, _, _, _) -> input.position.forlods_afskrivninger_kroner >= 0
        | Al40YdetGodtgørelseEllerVederlag(_, _, _, _, _, _, _) -> input.position.forlods_afskrivninger_kroner == 0
    }
    | position_gyldig() -> aftaledato_gyldig() && oprindeligt_beløb_kroner() > 0 && grundlagstype_gyldig() && afskrivningslov40_kontrol_gyldig(afskrivningslov40_kontrol(input.position.grundlag)) && input.position.tidligere_foretagne_afskrivninger_og_fradrag_kroner >= 0 && forlods_afskrivninger_gyldige() && input.position.tidligere_foretagne_afskrivninger_og_fradrag_kroner + input.position.forlods_afskrivninger_kroner <= afskrivningsgrundlag_kroner()
    | omfattet_af_par40() -> position_gyldig() && afskrivningslov40_goodwill_udelukket(input.position.grundlag) == Falskt && afskrivningslov40_udbytteret_udelukket(input.position.grundlag) == Falskt
    | resterende_før_året_kroner() -> penge_positivt_beløb(afskrivningsgrundlag_kroner() - input.position.tidligere_foretagne_afskrivninger_og_fradrag_kroner - input.position.forlods_afskrivninger_kroner)
    | fem_procent_grænse_kroner() -> penge_beløb_gange_basispoint_kroner(afskrivningslov40_stk3_lønudgift_kroner(input.position.grundlag), 500)
    | straksfradrag_gælder() -> omfattet_af_par40() && afskrivningslov40_stk3_ydelse(aktivart()) && input.indkomstår == afskrivningslov40_aftaledato(input.position.grundlag).år && afskrivningslov40_stk3_samlede_ydelser_kroner(input.position.grundlag) < fem_procent_grænse_kroner()
    | lineær_periode_år() -> hvis aktivart() == Al40KulbrintebevillingTilladelseEllerRettighed || (aktivart() == Al40AndenLovbeskyttetRettighed && afskrivningslov40_periode_år(input.position.grundlag) < 7) { afskrivningslov40_periode_år(input.position.grundlag) } ellers { 7 }
    | årligt_maksimum_før_rest_kroner() -> hvis lineær_periode_år() > 0 { afskrivningsgrundlag_kroner() / lineær_periode_år() } ellers { 0 }
    | årlig_afskrivning_mulig() -> omfattet_af_par40() && straksfradrag_gælder() == Falskt && input.hændelse == Al40FortsatEjerskabEllerForpligtelse && input.indkomstår >= afskrivningslov40_aftaledato(input.position.grundlag).år
    | højeste_afskrivning_kroner() -> hvis årlig_afskrivning_mulig() { penge_mindste_beløb(resterende_før_året_kroner(), årligt_maksimum_før_rest_kroner()) } ellers { 0 }
    | valg_gyldigt() -> hvis årlig_afskrivning_mulig() { input.valgt_afskrivning_kroner >= 0 && input.valgt_afskrivning_kroner <= højeste_afskrivning_kroner() } ellers { position_gyldig() && input.valgt_afskrivning_kroner == 0 }
    | årlig_afskrivning_kroner() -> hvis valg_gyldigt() && årlig_afskrivning_mulig() { input.valgt_afskrivning_kroner } ellers { 0 }
    | straksfradrag_kroner() -> hvis straksfradrag_gælder() { resterende_før_året_kroner() } ellers { 0 }
    | samlet_fradrag_kroner() -> årlig_afskrivning_kroner() + straksfradrag_kroner()
    | afståelsessum_kroner() -> afskrivningslov40_afståelsessum_kroner(input.hændelse)
    | afståelsesgrundlag_kroner() -> penge_positivt_beløb(oprindeligt_beløb_kroner() - input.position.tidligere_foretagne_afskrivninger_og_fradrag_kroner - input.position.forlods_afskrivninger_kroner)
    | disposition_omfattet() -> omfattet_af_par40() && (afskrivningslov40_stk1_aktiv(aktivart()) || afskrivningslov40_stk2_aktiv(aktivart())) && afskrivningslov40_disposition(input.hændelse) && afskrivningslov40_disposition_omfattet_af_ll12b_stk6(input.hændelse) == Falskt
    | afståelsesresultat_kroner() -> hvis disposition_omfattet() { afståelsessum_kroner() - afståelsesgrundlag_kroner() } ellers { 0 }
    | skattepligtig_fortjeneste_kroner() -> penge_positivt_beløb(afståelsesresultat_kroner())
    | fradragsberettiget_tab_kroner() -> penge_positivt_beløb(0 - afståelsesresultat_kroner())
    | modtager_skattepligtigt_kroner() -> hvis omfattet_af_par40() && afskrivningslov40_stk3_ydelse(aktivart()) && input.indkomstår == afskrivningslov40_aftaledato(input.position.grundlag).år { oprindeligt_beløb_kroner() } ellers { 0 }
    | resterende_grundlag_kroner() -> hvis input.hændelse == Al40FortsatEjerskabEllerForpligtelse { penge_positivt_beløb(resterende_før_året_kroner() - samlet_fradrag_kroner()) } ellers { 0 }
    | position_efter() -> Afskrivningslov40Position(
        grundlag = input.position.grundlag,
        tidligere_foretagne_afskrivninger_og_fradrag_kroner = input.position.tidligere_foretagne_afskrivninger_og_fradrag_kroner + samlet_fradrag_kroner(),
        forlods_afskrivninger_kroner = input.position.forlods_afskrivninger_kroner
    )
    | resultat() -> Afskrivningslov40Resultat(
        indkomstår = input.indkomstår,
        fradragsberettiget_skatteyder = afskrivningslov40_fradragsberettiget_skatteyder(input.position.grundlag),
        skattepligtig_modtager = afskrivningslov40_modtager(input.position.grundlag),
        aktivart = aktivart(),
        hændelse = input.hændelse,
        position_gyldig = position_gyldig(),
        omfattet_af_par40 = omfattet_af_par40(),
        bestemmende_indflydelse = bestemmende_indflydelse(),
        oprindelig_anskaffelsessum_eller_ydelse_kroner = oprindeligt_beløb_kroner(),
        nedsættelse_af_goodwillgrundlag_kroner = goodwillgrundlag_nedsættelse_kroner(),
        afskrivningsgrundlag_kroner = afskrivningsgrundlag_kroner(),
        resterende_afskrivningsgrundlag_før_året_kroner = resterende_før_året_kroner(),
        højeste_afskrivning_kroner = højeste_afskrivning_kroner(),
        valgt_afskrivning_kroner = input.valgt_afskrivning_kroner,
        valg_gyldigt = valg_gyldigt(),
        årlig_afskrivning_kroner = årlig_afskrivning_kroner(),
        straksfradrag_efter_fem_procent_reglen_kroner = straksfradrag_kroner(),
        samlet_fradrag_i_skattepligtig_indkomst_kroner = samlet_fradrag_kroner(),
        afståelsessum_kroner = afståelsessum_kroner(),
        skattepligtig_fortjeneste_kroner = skattepligtig_fortjeneste_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        godtgørelse_eller_vederlag_skattepligtigt_hos_modtager_kroner = modtager_skattepligtigt_kroner(),
        resterende_afskrivningsgrundlag_kroner = resterende_grundlag_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov40_sag(input: Afskrivningslov40Input) -> Afskrivningslov40Sag(input)
| afskrivningslov40_resultat(input: Afskrivningslov40Input) -> afskrivningslov40_sag(input).resultat()
| afskrivningslov40_skatteyder_resultat(resultat: Afskrivningslov40Resultat) -> Afskrivningslov40SkatteyderResultat(
    skatteyder = resultat.fradragsberettiget_skatteyder,
    aktivart = resultat.aktivart,
    årlig_afskrivning_kroner = resultat.årlig_afskrivning_kroner,
    straksfradrag_kroner = resultat.straksfradrag_efter_fem_procent_reglen_kroner,
    skattepligtig_fortjeneste_kroner = resultat.skattepligtig_fortjeneste_kroner,
    fradragsberettiget_tab_kroner = resultat.fradragsberettiget_tab_kroner,
    samlet_fradrag_i_skattepligtig_indkomst_kroner = resultat.samlet_fradrag_i_skattepligtig_indkomst_kroner
)
| afskrivningslov40_modtager_resultat(resultat: Afskrivningslov40Resultat) -> Afskrivningslov40ModtagerResultat(
    skatteyder = resultat.skattepligtig_modtager,
    aktivart = resultat.aktivart,
    godtgørelse_eller_vederlag_i_skattepligtig_indkomst_kroner = resultat.godtgørelse_eller_vederlag_skattepligtigt_hos_modtager_kroner
)
--@end:afskrivningsloven_par40--

--@label:afskrivningsloven_par40_2026_overgang::amendment_source:afskrivningsloven_lov749::transition_guidance:afskrivningsloven_par40_henstand_juridisk_vejledning::dependency_source:afskrivningsloven_lov749--
----
LOV nr. 749 af 20. juni 2025:

§ 2

I afskrivningsloven, jf. lovbekendtgørelse nr. 242 af 18. februar 2021, som
ændret bl.a. ved § 4 i lov nr. 679 af 3. juni 2023 og senest ved § 3 i lov nr.
562 af 27. maj 2025, foretages følgende ændring:

1. § 40, stk. 7, ophæves.

Stk. 8 bliver herefter stk. 7.

§ 5, stk. 2. § 1, nr. 1, 2, 8 og 13-16, og §§ 2-4 træder i kraft den 1. januar
2026.

§ 5, stk. 4. § 1, nr. 1, 2, 8 og 13-15, og §§ 2 og 3 finder anvendelse for
gensidigt bebyrdende aftaler om overdragelse af et eller flere aktiver, der er
indgået den 1. januar 2026 eller senere.
----

--@begin:afskrivningsloven_par40_2026_overgang--
# Afskrivningslov40Henstandsregime = Al40TidligereStk7 | Al40Ligningslov12BHenstandFra2026 | Al40IngenHenstandsordning
# Afskrivningslov40HenstandsovergangInput(aftaledato: AfskrivningslovDato, gensidigt_bebyrdende_aftale: Boolsk, aktiv_omfattet_af_par40_stk1_eller_stk2: Boolsk, vederlag_helt_eller_delvis_løbende_ydelse_efter_ligningslov12b_stk1_til_stk5: Boolsk)
# Afskrivningslov40HenstandsovergangResultat(aftaledato_gyldig: Boolsk, aftale_indgået_før_1_januar_2026: Boolsk, tidligere_afskrivningslov40_stk7_fortsætter: Boolsk, henvises_til_ligningslov12b_fra_2026: Boolsk, regime: Afskrivningslov40Henstandsregime)

| afskrivningslov40_aftale_før_2026(dato: AfskrivningslovDato) -> afskrivningslov_dato_gyldig(dato) && afskrivningslov_dato_yyyymmdd(dato) < 20260101
| afskrivningslov40_henstandsovergang_resultat(input: Afskrivningslov40HenstandsovergangInput) -> Afskrivningslov40HenstandsovergangResultat(
    aftaledato_gyldig = afskrivningslov_dato_gyldig(input.aftaledato),
    aftale_indgået_før_1_januar_2026 = afskrivningslov40_aftale_før_2026(input.aftaledato),
    tidligere_afskrivningslov40_stk7_fortsætter = afskrivningslov40_aftale_før_2026(input.aftaledato) && input.gensidigt_bebyrdende_aftale && input.aktiv_omfattet_af_par40_stk1_eller_stk2 && input.vederlag_helt_eller_delvis_løbende_ydelse_efter_ligningslov12b_stk1_til_stk5,
    henvises_til_ligningslov12b_fra_2026 = afskrivningslov_dato_gyldig(input.aftaledato) && afskrivningslov_dato_yyyymmdd(input.aftaledato) >= 20260101 && input.gensidigt_bebyrdende_aftale && input.vederlag_helt_eller_delvis_løbende_ydelse_efter_ligningslov12b_stk1_til_stk5,
    regime = hvis afskrivningslov40_aftale_før_2026(input.aftaledato) && input.gensidigt_bebyrdende_aftale && input.aktiv_omfattet_af_par40_stk1_eller_stk2 && input.vederlag_helt_eller_delvis_løbende_ydelse_efter_ligningslov12b_stk1_til_stk5 { Al40TidligereStk7 } ellers { hvis afskrivningslov_dato_gyldig(input.aftaledato) && afskrivningslov_dato_yyyymmdd(input.aftaledato) >= 20260101 && input.gensidigt_bebyrdende_aftale && input.vederlag_helt_eller_delvis_løbende_ydelse_efter_ligningslov12b_stk1_til_stk5 { Al40Ligningslov12BHenstandFra2026 } ellers { Al40IngenHenstandsordning } }
)
--@end:afskrivningsloven_par40_2026_overgang--

--@label:afskrivningsloven_par40a::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_kvoter_juridisk_vejledning::practice:afskrivningsloven_par40a_skm2022_474--
----
§ 40 A. Ved opgørelsen af den skattepligtige indkomst kan anskaffelsessummen
til erhvervelse af en kvote, der giver ret til at producere, levere, anvende,
udnytte eller fange en bestemt mængde af et produkt eller en ressource eller at
udlede en bestemt mængde af produkter eller ressourcer, herunder forurenende
affaldsprodukter, og som kun kan bruges én gang (en engangskvote), fradrages i
det indkomstår, hvori kvoten er anvendt i produktionen. Reglerne i 1. pkt.
finder tilsvarende anvendelse på andele af engangskvoter, der er anvendt i
produktionen.

Stk. 2. Fortjeneste eller tab ved salg eller udløb af en engangskvote eller en
andel heraf medregnes ved opgørelsen af den skattepligtige indkomst for det
indkomstår, hvori kvoten eller en andel heraf sælges eller udløber uden at være
anvendt i produktionen. Fortjeneste eller tab opgøres som forskellen mellem
afståelsessummen og anskaffelsessummen.

Stk. 3. Anskaffelsessummen som nævnt i stk. 1 og 2 sættes til nul for en
engangskvote eller en andel heraf, der er tildelt vederlagsfrit.
Anskaffelsessummen for en købt engangskvote eller en andel heraf sættes til
købssummen.

Stk. 4. Afståelsessummen som nævnt i stk. 2 sættes til nul for en engangskvote
eller en andel heraf, der er anvendt i produktionen. Afståelsessummen for en
engangskvote eller en andel heraf, der udløber uden at være anvendt i
produktionen, sættes ligeledes til nul.

Stk. 5. Hvis en skattepligtig ejer engangskvoter eller andele af engangskvoter
med samme rettigheder, men erhvervet på forskellige tidspunkter, anses de først
erhvervede kvoter eller andele af kvoter for de først afståede.

Stk. 6. Rettigheder, der er knyttet til andelsbeviser m.v. i foreninger
omfattet af selskabsskattelovens § 1, stk. 1, nr. 3 og 4, er ikke omfattet af
stk. 1-5.
----

--@begin:afskrivningsloven_par40a--
# AfskrivningslovKvoteAnskaffelse = AlKvoteKøbt(købssum_kroner: Heltal) | AlKvoteVederlagsfritTildelt
# AfskrivningslovKvoteTilknytning = AlKvoteSelvstændigRettighed | AlKvoteKnyttetTilAndelsbevisSelPar1Stk1Nr3 | AlKvoteKnyttetTilAndelsbevisSelPar1Stk1Nr4
# AfskrivningslovKvoteLot(lot_id: Tekst, rettighedsnøgle: Tekst, erhvervelsesdato: AfskrivningslovDato, erhvervelsesrækkefølge: Heltal, resterende_enheder: Heltal)
# Afskrivningslov40APosition(skatteyder: AfskrivningslovSkatteyder, lot: AfskrivningslovKvoteLot, tilknytning: AfskrivningslovKvoteTilknytning, anskaffelse: AfskrivningslovKvoteAnskaffelse, resterende_anskaffelsessum_kroner: Heltal)
# Afskrivningslov40AHændelse = Al40AAnvendtIProduktion(anvendte_enheder: Heltal) | Al40ASolgt(solgte_enheder: Heltal, afståelsessum_kroner: Heltal) | Al40AUdløbetUdenAnvendelse(udløbne_enheder: Heltal)
# Afskrivningslov40AInput(indkomstår: Heltal, position: Afskrivningslov40APosition, lager: List(AfskrivningslovKvoteLot), hændelse: Afskrivningslov40AHændelse)
# Afskrivningslov40AResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, hændelse: Afskrivningslov40AHændelse, position_gyldig: Boolsk, lager_gyldigt: Boolsk, omfattet_af_par40a: Boolsk, fifo_betingelse_opfyldt: Boolsk, hændelse_gyldig: Boolsk, anskaffelsessum_henført_til_hændelsen_kroner: Heltal, fradrag_for_anvendelse_i_produktionen_kroner: Heltal, afståelsessum_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, resterende_enheder: Heltal, resterende_anskaffelsessum_kroner: Heltal, position_efter: Afskrivningslov40APosition)

| afskrivningslov_kvote_anskaffelsessum_kroner(anskaffelse: AfskrivningslovKvoteAnskaffelse) -> match anskaffelse {
    | AlKvoteKøbt(købssum_kroner) -> købssum_kroner
    | AlKvoteVederlagsfritTildelt -> 0
}
| afskrivningslov_kvote_tilknytning_udelukket(tilknytning: AfskrivningslovKvoteTilknytning) -> tilknytning == AlKvoteKnyttetTilAndelsbevisSelPar1Stk1Nr3 || tilknytning == AlKvoteKnyttetTilAndelsbevisSelPar1Stk1Nr4
| afskrivningslov_kvote_lot_gyldigt(lot: AfskrivningslovKvoteLot) -> afskrivningslov_dato_gyldig(lot.erhvervelsesdato) && lot.erhvervelsesrækkefølge > 0 && lot.resterende_enheder >= 0
| afskrivningslov_kvote_lot_før(venstre: AfskrivningslovKvoteLot, højre: AfskrivningslovKvoteLot) -> venstre.rettighedsnøgle == højre.rettighedsnøgle && (afskrivningslov_dato_yyyymmdd(venstre.erhvervelsesdato) < afskrivningslov_dato_yyyymmdd(højre.erhvervelsesdato) || afskrivningslov_dato_yyyymmdd(venstre.erhvervelsesdato) == afskrivningslov_dato_yyyymmdd(højre.erhvervelsesdato) && venstre.erhvervelsesrækkefølge < højre.erhvervelsesrækkefølge)
| afskrivningslov_kvote_lot_samme_fifo_plads(venstre: AfskrivningslovKvoteLot, højre: AfskrivningslovKvoteLot) -> venstre.rettighedsnøgle == højre.rettighedsnøgle && afskrivningslov_dato_yyyymmdd(venstre.erhvervelsesdato) == afskrivningslov_dato_yyyymmdd(højre.erhvervelsesdato) && venstre.erhvervelsesrækkefølge == højre.erhvervelsesrækkefølge
| afskrivningslov_kvote_lot_med_resterende_enheder(lot: AfskrivningslovKvoteLot, resterende_enheder: Heltal) -> AfskrivningslovKvoteLot(
    lot_id = lot.lot_id,
    rettighedsnøgle = lot.rettighedsnøgle,
    erhvervelsesdato = lot.erhvervelsesdato,
    erhvervelsesrækkefølge = lot.erhvervelsesrækkefølge,
    resterende_enheder = resterende_enheder
)
| afskrivningslov_kvote_lot_unikt_i_lager(lager: List(AfskrivningslovKvoteLot), lot: AfskrivningslovKvoteLot) -> foldl(lager, 0, |antal, andet_lot| antal + hvis andet_lot.lot_id == lot.lot_id { 1 } ellers { 0 }) == 1 && foldl(lager, 0, |antal, andet_lot| antal + hvis afskrivningslov_kvote_lot_samme_fifo_plads(andet_lot, lot) { 1 } ellers { 0 }) == 1
| afskrivningslov_kvote_lager_gyldigt(lager: List(AfskrivningslovKvoteLot), lot: AfskrivningslovKvoteLot) -> foldl(lager, Sandt, |alle_gyldige, andet_lot| alle_gyldige && afskrivningslov_kvote_lot_gyldigt(andet_lot) && afskrivningslov_kvote_lot_unikt_i_lager(lager, andet_lot)) && foldl(lager, 0, |antal, andet_lot| antal + hvis andet_lot == lot { 1 } ellers { 0 }) == 1
| afskrivningslov_kvote_har_tidligere_resterende_lot(lager: List(AfskrivningslovKvoteLot), lot: AfskrivningslovKvoteLot) -> foldl(lager, Falskt, |fundet, andet_lot| fundet || andet_lot.resterende_enheder > 0 && afskrivningslov_kvote_lot_før(andet_lot, lot))
| afskrivningslov_kvote_fifo_betingelse_opfyldt(lager: List(AfskrivningslovKvoteLot), lot: AfskrivningslovKvoteLot) -> afskrivningslov_kvote_lager_gyldigt(lager, lot) && afskrivningslov_kvote_har_tidligere_resterende_lot(lager, lot) == Falskt
| afskrivningslov40a_hændelsesenheder(hændelse: Afskrivningslov40AHændelse) -> match hændelse {
    | Al40AAnvendtIProduktion(anvendte_enheder) -> anvendte_enheder
    | Al40ASolgt(solgte_enheder, _) -> solgte_enheder
    | Al40AUdløbetUdenAnvendelse(udløbne_enheder) -> udløbne_enheder
}
| afskrivningslov40a_anvendt_i_produktionen(hændelse: Afskrivningslov40AHændelse) -> match hændelse { | Al40AAnvendtIProduktion(_) -> Sandt | _ -> Falskt }
| afskrivningslov40a_solgt(hændelse: Afskrivningslov40AHændelse) -> match hændelse { | Al40ASolgt(_, _) -> Sandt | _ -> Falskt }
| afskrivningslov40a_udløbet(hændelse: Afskrivningslov40AHændelse) -> match hændelse { | Al40AUdløbetUdenAnvendelse(_) -> Sandt | _ -> Falskt }
| afskrivningslov40a_hændelsesbeløb_gyldigt(hændelse: Afskrivningslov40AHændelse) -> match hændelse { | Al40ASolgt(_, afståelsessum_kroner) -> afståelsessum_kroner >= 0 | _ -> Sandt }
| afskrivningslov40a_afståelsessum_kroner(hændelse: Afskrivningslov40AHændelse) -> match hændelse { | Al40ASolgt(_, afståelsessum_kroner) -> penge_positivt_beløb(afståelsessum_kroner) | _ -> 0 }

# Afskrivningslov40ASag(input: Afskrivningslov40AInput) {
    | anskaffelsessum_kroner() -> afskrivningslov_kvote_anskaffelsessum_kroner(input.position.anskaffelse)
    | position_gyldig() -> afskrivningslov_kvote_lot_gyldigt(input.position.lot) && input.position.lot.resterende_enheder > 0 && match input.position.anskaffelse {
        | AlKvoteKøbt(købssum_kroner) -> købssum_kroner > 0 && input.position.resterende_anskaffelsessum_kroner >= 0 && input.position.resterende_anskaffelsessum_kroner <= købssum_kroner
        | AlKvoteVederlagsfritTildelt -> input.position.resterende_anskaffelsessum_kroner == 0
    }
    | lager_gyldigt() -> afskrivningslov_kvote_lager_gyldigt(input.lager, input.position.lot)
    | omfattet_af_par40a() -> position_gyldig() && afskrivningslov_kvote_tilknytning_udelukket(input.position.tilknytning) == Falskt
    | hændelsesenheder() -> afskrivningslov40a_hændelsesenheder(input.hændelse)
    | hændelse_gyldig() -> input.indkomstår >= input.position.lot.erhvervelsesdato.år && hændelsesenheder() > 0 && hændelsesenheder() <= input.position.lot.resterende_enheder && afskrivningslov40a_hændelsesbeløb_gyldigt(input.hændelse)
    | fifo_betingelse_opfyldt() -> afskrivningslov40a_solgt(input.hændelse) == Falskt || afskrivningslov_kvote_fifo_betingelse_opfyldt(input.lager, input.position.lot)
    | hændelse_behandles() -> omfattet_af_par40a() && lager_gyldigt() && hændelse_gyldig() && fifo_betingelse_opfyldt()
    | anskaffelsessum_henført_til_hændelsen_kroner() -> hvis hændelse_behandles() { hvis hændelsesenheder() == input.position.lot.resterende_enheder { input.position.resterende_anskaffelsessum_kroner } ellers { input.position.resterende_anskaffelsessum_kroner * hændelsesenheder() / input.position.lot.resterende_enheder } } ellers { 0 }
    | fradrag_for_anvendelse_i_produktionen_kroner() -> hvis hændelse_behandles() && afskrivningslov40a_anvendt_i_produktionen(input.hændelse) { anskaffelsessum_henført_til_hændelsen_kroner() } ellers { 0 }
    | afståelsessum_kroner() -> hvis hændelse_behandles() { afskrivningslov40a_afståelsessum_kroner(input.hændelse) } ellers { 0 }
    | afståelsesresultat_kroner() -> hvis hændelse_behandles() && (afskrivningslov40a_solgt(input.hændelse) || afskrivningslov40a_udløbet(input.hændelse)) { afståelsessum_kroner() - anskaffelsessum_henført_til_hændelsen_kroner() } ellers { 0 }
    | skattepligtig_fortjeneste_kroner() -> penge_positivt_beløb(afståelsesresultat_kroner())
    | fradragsberettiget_tab_kroner() -> penge_positivt_beløb(0 - afståelsesresultat_kroner())
    | resterende_enheder() -> hvis hændelse_behandles() { input.position.lot.resterende_enheder - hændelsesenheder() } ellers { input.position.lot.resterende_enheder }
    | resterende_anskaffelsessum_kroner() -> hvis hændelse_behandles() { input.position.resterende_anskaffelsessum_kroner - anskaffelsessum_henført_til_hændelsen_kroner() } ellers { input.position.resterende_anskaffelsessum_kroner }
    | position_efter() -> Afskrivningslov40APosition(
        skatteyder = input.position.skatteyder,
        lot = afskrivningslov_kvote_lot_med_resterende_enheder(input.position.lot, resterende_enheder()),
        tilknytning = input.position.tilknytning,
        anskaffelse = input.position.anskaffelse,
        resterende_anskaffelsessum_kroner = resterende_anskaffelsessum_kroner()
    )
    | resultat() -> Afskrivningslov40AResultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.skatteyder,
        hændelse = input.hændelse,
        position_gyldig = position_gyldig(),
        lager_gyldigt = lager_gyldigt(),
        omfattet_af_par40a = omfattet_af_par40a(),
        fifo_betingelse_opfyldt = fifo_betingelse_opfyldt(),
        hændelse_gyldig = hændelse_gyldig(),
        anskaffelsessum_henført_til_hændelsen_kroner = anskaffelsessum_henført_til_hændelsen_kroner(),
        fradrag_for_anvendelse_i_produktionen_kroner = fradrag_for_anvendelse_i_produktionen_kroner(),
        afståelsessum_kroner = afståelsessum_kroner(),
        skattepligtig_fortjeneste_kroner = skattepligtig_fortjeneste_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        resterende_enheder = resterende_enheder(),
        resterende_anskaffelsessum_kroner = resterende_anskaffelsessum_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov40a_sag(input: Afskrivningslov40AInput) -> Afskrivningslov40ASag(input)
| afskrivningslov40a_resultat(input: Afskrivningslov40AInput) -> afskrivningslov40a_sag(input).resultat()
--@end:afskrivningsloven_par40a--

--@label:afskrivningsloven_par40b::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_kvoter_juridisk_vejledning--
----
§ 40 B. Ved opgørelsen af den skattepligtige indkomst kan anskaffelsessummen
til erhvervelse af en kvote, der giver ret til løbende i nærmere afgrænsede
perioder at producere, levere, anvende, udnytte eller fange en bestemt mængde
af et produkt eller en ressource eller at udlede en bestemt mængde af produkter
eller ressourcer, herunder forurenende affaldsprodukter, pr. periode (en løbende
kvote), fra og med det indkomstår, hvori der er indgået aftale om overdragelsen
(aftaleåret), afskrives med indtil 1/7 årligt. Reglerne i 1. pkt. finder
tilsvarende anvendelse på andele af løbende kvoter.

Stk. 2. Ved erhvervelse af en løbende kvote, hvor den periode, som kvoten kan
udnyttes i, på aftaletidspunktet er mindre end 7 år, erstattes den sats, der er
nævnt i stk. 1, med en sats, der svarer til, at anskaffelsessummen afskrives
med lige store årlige beløb over den periode, som kvoten kan udnyttes i, regnet
fra og med aftaleåret. Reglerne i 1. pkt. finder tilsvarende anvendelse på
andele af løbende kvoter.

Stk. 3. Fortjeneste eller tab ved salg eller udløb af en løbende kvote eller en
andel af en løbende kvote medregnes ved opgørelsen af den skattepligtige
indkomst for det indkomstår, hvori kvoten eller en andel heraf sælges eller
udløber. Fortjeneste eller tab opgøres som forskellen mellem afståelsessummen
og den nedskrevne værdi. Sidstnævnte værdi opgøres som anskaffelsessummen med
fradrag af samtlige foretagne afskrivninger.

Stk. 4. Anskaffelsessummen som nævnt i stk. 1-3 sættes til nul for en løbende
kvote eller en andel af en løbende kvote, der er tildelt vederlagsfrit.

Stk. 5. Afståelsessummen som nævnt i stk. 3 sættes til nul for en løbende kvote
eller en andel af en løbende kvote, der er udløbet.

Stk. 6. Hvis en skattepligtig ejer løbende kvoter eller andele af løbende
kvoter med samme rettigheder, men erhvervet på forskellige tidspunkter, anses
de først erhvervede kvoter eller andele af kvoter for de først afståede.

Stk. 7. Mælkekvoter og leveringsrettigheder for sukkerroer er ikke omfattet af
stk. 1-6. Rettigheder, der er knyttet til andelsbeviser m.v. i foreninger
omfattet af selskabsskattelovens § 1, stk. 1, nr. 3 og 4, er heller ikke
omfattet af stk. 1-6.
----

--@begin:afskrivningsloven_par40b--
# Afskrivningslov40BKvoteart = Al40BAndenLøbendeKvote | Al40BMælkekvote | Al40BLeveringsrettighedForSukkerroer
# Afskrivningslov40BPosition(skatteyder: AfskrivningslovSkatteyder, lot: AfskrivningslovKvoteLot, tilknytning: AfskrivningslovKvoteTilknytning, kvoteart: Afskrivningslov40BKvoteart, anskaffelse: AfskrivningslovKvoteAnskaffelse, resterende_anskaffelsessum_kroner: Heltal, aftaledato: AfskrivningslovDato, udnyttelsesperiode_år: Heltal, tidligere_afskrivninger_kroner: Heltal)
# Afskrivningslov40BHændelse = Al40BFortsatRettighed(valgt_afskrivning_kroner: Heltal) | Al40BSolgt(solgte_enheder: Heltal, afståelsessum_kroner: Heltal) | Al40BUdløbet(udløbne_enheder: Heltal)
# Afskrivningslov40BInput(indkomstår: Heltal, position: Afskrivningslov40BPosition, lager: List(AfskrivningslovKvoteLot), hændelse: Afskrivningslov40BHændelse)
# Afskrivningslov40BResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, hændelse: Afskrivningslov40BHændelse, position_gyldig: Boolsk, lager_gyldigt: Boolsk, omfattet_af_par40b: Boolsk, fifo_betingelse_opfyldt: Boolsk, afskrivningsperiode_år: Heltal, år_i_afskrivningsforløbet: Heltal, anskaffelsessum_kroner: Heltal, nedskrevet_værdi_før_året_kroner: Heltal, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, årlig_afskrivning_kroner: Heltal, disponerede_enheder: Heltal, anskaffelsessum_henført_til_disposition_kroner: Heltal, tidligere_afskrivninger_henført_til_disposition_kroner: Heltal, nedskrevet_værdi_henført_til_disposition_kroner: Heltal, afståelsessum_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, resterende_enheder: Heltal, resterende_anskaffelsessum_kroner: Heltal, nedskrevet_værdi_efter_året_kroner: Heltal, position_efter: Afskrivningslov40BPosition)

| afskrivningslov40b_fortsat_rettighed(hændelse: Afskrivningslov40BHændelse) -> match hændelse { | Al40BFortsatRettighed(_) -> Sandt | _ -> Falskt }
| afskrivningslov40b_solgt(hændelse: Afskrivningslov40BHændelse) -> match hændelse { | Al40BSolgt(_, _) -> Sandt | _ -> Falskt }
| afskrivningslov40b_udløbet(hændelse: Afskrivningslov40BHændelse) -> match hændelse { | Al40BUdløbet(_) -> Sandt | _ -> Falskt }
| afskrivningslov40b_valgt_afskrivning_kroner(hændelse: Afskrivningslov40BHændelse) -> match hændelse { | Al40BFortsatRettighed(valgt_afskrivning_kroner) -> valgt_afskrivning_kroner | _ -> 0 }
| afskrivningslov40b_disponerede_enheder(hændelse: Afskrivningslov40BHændelse) -> match hændelse { | Al40BFortsatRettighed(_) -> 0 | Al40BSolgt(solgte_enheder, _) -> solgte_enheder | Al40BUdløbet(udløbne_enheder) -> udløbne_enheder }
| afskrivningslov40b_afståelsessum_kroner(hændelse: Afskrivningslov40BHændelse) -> match hændelse { | Al40BSolgt(_, afståelsessum_kroner) -> penge_positivt_beløb(afståelsessum_kroner) | _ -> 0 }
| afskrivningslov40b_kvoteart_udelukket(kvoteart: Afskrivningslov40BKvoteart) -> kvoteart == Al40BMælkekvote || kvoteart == Al40BLeveringsrettighedForSukkerroer

# Afskrivningslov40BSag(input: Afskrivningslov40BInput) {
    | anskaffelsessum_kroner() -> input.position.resterende_anskaffelsessum_kroner
    | position_gyldig() -> afskrivningslov_kvote_lot_gyldigt(input.position.lot) && input.position.lot.resterende_enheder > 0 && afskrivningslov_dato_gyldig(input.position.aftaledato) && afskrivningslov_dato_yyyymmdd(input.position.lot.erhvervelsesdato) == afskrivningslov_dato_yyyymmdd(input.position.aftaledato) && input.position.udnyttelsesperiode_år > 0 && input.position.resterende_anskaffelsessum_kroner >= 0 && input.position.tidligere_afskrivninger_kroner >= 0 && input.position.tidligere_afskrivninger_kroner <= anskaffelsessum_kroner() && match input.position.anskaffelse {
        | AlKvoteKøbt(købssum_kroner) -> købssum_kroner > 0 && input.position.resterende_anskaffelsessum_kroner <= købssum_kroner
        | AlKvoteVederlagsfritTildelt -> input.position.resterende_anskaffelsessum_kroner == 0 && input.position.tidligere_afskrivninger_kroner == 0
    }
    | lager_gyldigt() -> afskrivningslov_kvote_lager_gyldigt(input.lager, input.position.lot)
    | omfattet_af_par40b() -> position_gyldig() && afskrivningslov40b_kvoteart_udelukket(input.position.kvoteart) == Falskt && afskrivningslov_kvote_tilknytning_udelukket(input.position.tilknytning) == Falskt
    | disponerede_enheder() -> afskrivningslov40b_disponerede_enheder(input.hændelse)
    | hændelse_gyldig() -> input.indkomstår >= input.position.aftaledato.år && match input.hændelse {
        | Al40BFortsatRettighed(valgt_afskrivning_kroner) -> valgt_afskrivning_kroner >= 0
        | Al40BSolgt(solgte_enheder, afståelsessum_kroner) -> solgte_enheder > 0 && solgte_enheder <= input.position.lot.resterende_enheder && afståelsessum_kroner >= 0
        | Al40BUdløbet(udløbne_enheder) -> udløbne_enheder > 0 && udløbne_enheder <= input.position.lot.resterende_enheder
    }
    | fifo_betingelse_opfyldt() -> afskrivningslov40b_solgt(input.hændelse) == Falskt || afskrivningslov_kvote_fifo_betingelse_opfyldt(input.lager, input.position.lot)
    | hændelse_behandles() -> omfattet_af_par40b() && lager_gyldigt() && hændelse_gyldig() && fifo_betingelse_opfyldt()
    | afskrivningsperiode_år() -> hvis input.position.udnyttelsesperiode_år < 7 { input.position.udnyttelsesperiode_år } ellers { 7 }
    | år_i_afskrivningsforløbet() -> input.indkomstår - input.position.aftaledato.år + 1
    | nedskrevet_værdi_før_året_kroner() -> penge_positivt_beløb(anskaffelsessum_kroner() - input.position.tidligere_afskrivninger_kroner)
    | afskrivning_mulig() -> hændelse_behandles() && afskrivningslov40b_fortsat_rettighed(input.hændelse) && år_i_afskrivningsforløbet() >= 1 && år_i_afskrivningsforløbet() <= afskrivningsperiode_år()
    | årligt_standardbeløb_kroner() -> hvis afskrivningsperiode_år() > 0 { anskaffelsessum_kroner() / afskrivningsperiode_år() } ellers { 0 }
    | afrundingsrest_kroner() -> hvis afskrivningsperiode_år() > 0 { anskaffelsessum_kroner() - årligt_standardbeløb_kroner() * afskrivningsperiode_år() } ellers { 0 }
    | årlig_satsbeløb_kroner() -> årligt_standardbeløb_kroner() + hvis år_i_afskrivningsforløbet() == afskrivningsperiode_år() { afrundingsrest_kroner() } ellers { 0 }
    | højeste_afskrivning_kroner() -> hvis afskrivning_mulig() { penge_mindste_beløb(nedskrevet_værdi_før_året_kroner(), årlig_satsbeløb_kroner()) } ellers { 0 }
    | valgt_afskrivning_kroner() -> afskrivningslov40b_valgt_afskrivning_kroner(input.hændelse)
    | valg_gyldigt() -> hvis afskrivningslov40b_fortsat_rettighed(input.hændelse) { hændelse_behandles() && valgt_afskrivning_kroner() <= højeste_afskrivning_kroner() } ellers { hændelse_behandles() }
    | årlig_afskrivning_kroner() -> hvis valg_gyldigt() && afskrivning_mulig() { valgt_afskrivning_kroner() } ellers { 0 }
    | disposition_omfattet() -> hændelse_behandles() && (afskrivningslov40b_solgt(input.hændelse) || afskrivningslov40b_udløbet(input.hændelse))
    | anskaffelsessum_henført_til_disposition_kroner() -> hvis disposition_omfattet() { hvis disponerede_enheder() == input.position.lot.resterende_enheder { anskaffelsessum_kroner() } ellers { anskaffelsessum_kroner() * disponerede_enheder() / input.position.lot.resterende_enheder } } ellers { 0 }
    | tidligere_afskrivninger_henført_til_disposition_kroner() -> hvis disposition_omfattet() { hvis disponerede_enheder() == input.position.lot.resterende_enheder { input.position.tidligere_afskrivninger_kroner } ellers { input.position.tidligere_afskrivninger_kroner * disponerede_enheder() / input.position.lot.resterende_enheder } } ellers { 0 }
    | nedskrevet_værdi_henført_til_disposition_kroner() -> penge_positivt_beløb(anskaffelsessum_henført_til_disposition_kroner() - tidligere_afskrivninger_henført_til_disposition_kroner())
    | afståelsessum_kroner() -> hvis disposition_omfattet() { afskrivningslov40b_afståelsessum_kroner(input.hændelse) } ellers { 0 }
    | afståelsesresultat_kroner() -> hvis disposition_omfattet() { afståelsessum_kroner() - nedskrevet_værdi_henført_til_disposition_kroner() } ellers { 0 }
    | skattepligtig_fortjeneste_kroner() -> penge_positivt_beløb(afståelsesresultat_kroner())
    | fradragsberettiget_tab_kroner() -> penge_positivt_beløb(0 - afståelsesresultat_kroner())
    | resterende_enheder() -> hvis disposition_omfattet() { input.position.lot.resterende_enheder - disponerede_enheder() } ellers { input.position.lot.resterende_enheder }
    | resterende_anskaffelsessum_kroner() -> hvis disposition_omfattet() { anskaffelsessum_kroner() - anskaffelsessum_henført_til_disposition_kroner() } ellers { anskaffelsessum_kroner() }
    | tidligere_afskrivninger_efter_året_kroner() -> hvis disposition_omfattet() { input.position.tidligere_afskrivninger_kroner - tidligere_afskrivninger_henført_til_disposition_kroner() } ellers { input.position.tidligere_afskrivninger_kroner + årlig_afskrivning_kroner() }
    | nedskrevet_værdi_efter_året_kroner() -> penge_positivt_beløb(resterende_anskaffelsessum_kroner() - tidligere_afskrivninger_efter_året_kroner())
    | position_efter() -> Afskrivningslov40BPosition(
        skatteyder = input.position.skatteyder,
        lot = afskrivningslov_kvote_lot_med_resterende_enheder(input.position.lot, resterende_enheder()),
        tilknytning = input.position.tilknytning,
        kvoteart = input.position.kvoteart,
        anskaffelse = input.position.anskaffelse,
        resterende_anskaffelsessum_kroner = resterende_anskaffelsessum_kroner(),
        aftaledato = input.position.aftaledato,
        udnyttelsesperiode_år = input.position.udnyttelsesperiode_år,
        tidligere_afskrivninger_kroner = tidligere_afskrivninger_efter_året_kroner()
    )
    | resultat() -> Afskrivningslov40BResultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.skatteyder,
        hændelse = input.hændelse,
        position_gyldig = position_gyldig(),
        lager_gyldigt = lager_gyldigt(),
        omfattet_af_par40b = omfattet_af_par40b(),
        fifo_betingelse_opfyldt = fifo_betingelse_opfyldt(),
        afskrivningsperiode_år = afskrivningsperiode_år(),
        år_i_afskrivningsforløbet = år_i_afskrivningsforløbet(),
        anskaffelsessum_kroner = anskaffelsessum_kroner(),
        nedskrevet_værdi_før_året_kroner = nedskrevet_værdi_før_året_kroner(),
        højeste_afskrivning_kroner = højeste_afskrivning_kroner(),
        valgt_afskrivning_kroner = valgt_afskrivning_kroner(),
        valg_gyldigt = valg_gyldigt(),
        årlig_afskrivning_kroner = årlig_afskrivning_kroner(),
        disponerede_enheder = disponerede_enheder(),
        anskaffelsessum_henført_til_disposition_kroner = anskaffelsessum_henført_til_disposition_kroner(),
        tidligere_afskrivninger_henført_til_disposition_kroner = tidligere_afskrivninger_henført_til_disposition_kroner(),
        nedskrevet_værdi_henført_til_disposition_kroner = nedskrevet_værdi_henført_til_disposition_kroner(),
        afståelsessum_kroner = afståelsessum_kroner(),
        skattepligtig_fortjeneste_kroner = skattepligtig_fortjeneste_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        resterende_enheder = resterende_enheder(),
        resterende_anskaffelsessum_kroner = resterende_anskaffelsessum_kroner(),
        nedskrevet_værdi_efter_året_kroner = nedskrevet_værdi_efter_året_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov40b_sag(input: Afskrivningslov40BInput) -> Afskrivningslov40BSag(input)
| afskrivningslov40b_resultat(input: Afskrivningslov40BInput) -> afskrivningslov40b_sag(input).resultat()
--@end:afskrivningsloven_par40b--

--@label:afskrivningsloven_par40c::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_kvoter_juridisk_vejledning::warning:afskrivningsloven_par40c_historisk_advarsel--
----
§ 40 C. Anskaffelsessummen ved erhvervelse og afståelsessummen ved afståelse af
en betalingsrettighed efter EU-landbrugsstøtteordningen skal indgå på en samlet
saldo, som føres af den skattepligtige.

Stk. 2. På saldoen som nævnt i stk. 1 skal tillige indgå anskaffelsessummen og
afståelsessummen for en mælkekvote, der erhverves den 1. januar 2005 eller
senere. Hvis der ved afståelse af en mælkekvote, der er erhvervet eller tildelt
inden den 1. januar 2005, ikke efter reglerne i ejendomsavancebeskatningsloven
skal ske regulering af anskaffelsessummen for en fast ejendom med henholdsvis
anskaffelses- og afståelsessummen for mælkekvoten, skal mælkekvotens
anskaffelses- og afståelsessum i stedet indgå på den i stk. 1 nævnte saldo i
det indkomstår, hvori den pågældende mælkekvote afstås. Hvis den
skattepligtige er blevet beskattet af mælkekvotens værdi ved tildelingen, kan
det beskattede beløb tillægges. Reglerne i 2. og 3. pkt. finder kun anvendelse
for mælkekvoter, hvis mælkekvoten er købt eller tildelt den 19. maj 1993 eller
senere.

Stk. 3. På saldoen som nævnt i stk. 1 skal også indgå anskaffelsessummen for
leveringsrettigheder for sukkerroer, som den skattepligtige ejer eller erhverver
den 4. oktober 2006 eller senere. Hvis anskaffelsessummen ikke er opgjort
særskilt for leveringsrettigheder, som den skattepligtige ejer den 4. oktober
2006, benyttes i stedet enten en anskaffelsessum, som fastsættes skønsmæssigt
på grundlag af den samlede anskaffelsessum for leveringsrettigheden og jorden
eller ejendommen, eller en værdi på 2.500 kr. pr. ton polsukker. På saldoen som
nævnt i stk. 1 skal også indgå afståelsessummen for leveringsrettigheder for
sukkerroer, som den skattepligtige afstår den 4. oktober 2006 eller senere.

Stk. 4. Anskaffelsessummen for en vederlagsfrit tildelt betalingsrettighed som
nævnt i stk. 1, en vederlagsfrit tildelt mælkekvote som nævnt i stk. 2 og en
vederlagsfrit tildelt leveringsrettighed for sukkerroer som nævnt i stk. 3
indgår på saldoen med værdien nul. Hvis en forpagter overdrager en
betalingsrettighed vederlagsfrit til bortforpagteren efter reglerne i
ligningslovens § 7 Y, stk. 2, indgår værdien heraf på forpagterens saldo med en
afståelsessum på nul og på bortforpagterens saldo med en anskaffelsessum på nul.
Betalingsrettigheder, mælkekvoter og leveringsrettigheder for sukkerroer
omfattet af stk. 1-3, der er udløbet, indgår på saldoen med en afståelsessum på
nul.

Stk. 5. Saldoværdien opgøres ved udgangen af indkomståret. Denne værdi opgøres
som saldoværdien ved indkomstårets begyndelse med tillæg af anskaffelsessummer
og fradrag af afståelsessummer, der i indkomstårets løb er indgået på saldoen
efter reglerne i stk. 1-4. Saldoværdien ved indkomstårets begyndelse udgør
tidligere indkomstårs anskaffelsessummer med fradrag af tidligere indkomstårs
afståelsessummer reguleret i tidligere indkomstår efter reglerne i stk. 6-11.

Stk. 6. Er saldoværdien positiv ved indkomstårets udgang, kan beløbet hverken
fradrages eller afskrives ved opgørelsen af den skattepligtige indkomst.

Stk. 7. Er saldoværdien negativ ved indkomstårets udgang, indtægtsføres et
positivt beløb lig den negative saldo, hvorpå saldoen sættes til nul. Det
indtægtsførte beløb som nævnt i 1. pkt. medregnes ved opgørelsen af
indkomstårets skattepligtige indkomst.

Stk. 8. Hvis der opgjort efter reglerne i ejendomsavancebeskatningsloven
fremkommer et fradragsberettiget tab ved afståelse af en ejendom, der på
afståelsestidspunktet helt eller delvis efter ejendomsvurderingsloven anses for
landbrugs- eller skovejendom, modregnes summen af et indtægtsført beløb for det
indkomstår, hvori ejendommen sælges, og de foregående indkomstårs indtægtsførte
beløb som nævnt i stk. 7 i tabet på ejendommen, i det omfang summen kan rummes i
tabet på ejendommen. Skatteværdien, der beregnes med 22 pct. af det beløb, som
modregnes i tabet på ejendommen efter reglerne i 1. pkt., anses for indbetalt
acontoskat vedrørende det indkomstår, hvori tabet på ejendommen realiseres, jf.
stk. 9 og 10.

Stk. 9. Ved skatteberegningen for det indkomstår, hvori tabet på ejendommen
realiseres, fradrages beløb, der anses for indbetalt acontoskat efter stk. 8, i
den skattepligtiges slutskat med tillæg af eventuel restskat m.v. Et herefter
resterende beløb, som ikke kan rummes i årets slutskat m.v., udbetales kontant,
jf. dog stk. 10.

Stk. 10. Overdrages ejendommen efter reglerne i kildeskattelovens § 33 C eller
dødsboskattelovens § 39, skal et resterende beløb, der anses for indbetalt
acontoskat efter stk. 8, fradrages i en ægtefælles slutskat m.v., hvis den
skattepligtige var gift og samlevende med ægtefællen ved udgangen af
indkomståret forud for overdragelsen. Beløb, der anses for indbetalt acontoskat,
og som herefter resterer, fremføres til fradrag i den beregnede slutskat m.v. i
de følgende indkomstår.

Stk. 11. I det indkomstår, hvori det sidste af saldoens underliggende aktiver
afstås eller udløber (afståelsesåret), medregnes fortjeneste eller tab ved
opgørelsen af den skattepligtige indkomst for afståelsesåret. Fortjeneste eller
tab opgøres som forskellen mellem på den ene side afståelsessummen for de
aktiver, der er afstået i afståelsesåret, og på den anden side saldoværdien ved
afståelsesårets begyndelse med tillæg af beløb, der i afståelsesåret er anvendt
til nyanskaffelser af betalingsrettigheder og mælkekvoter.

Stk. 12. Hvis en skattepligtig ejer mælkekvoter eller andele af mælkekvoter
anskaffet inden den 1. januar 2005 og mælkekvoter eller andele af mælkekvoter
anskaffet den 1. januar 2005 eller senere, anses de først erhvervede kvoter
eller andele af kvoter for de først afståede.
----

--@begin:afskrivningsloven_par40c--
# Afskrivningslov40CKvoteart = Al40CBetalingsrettighed | Al40CMælkekvote | Al40CLeveringsrettighedForSukkerroer
# Afskrivningslov40CSaldostatus = Al40CSaldoOmfattet | Al40CUdenForSaldo
# Afskrivningslov40CSaldobevægelse = Al40CAnskaffelse(kvoteart: Afskrivningslov40CKvoteart, anskaffelsessum_kroner: Heltal) | Al40CAfståelse(kvoteart: Afskrivningslov40CKvoteart, afståelsessum_kroner: Heltal) | Al40CIngenSaldobevægelse
# Afskrivningslov40CBegivenhed = Al40CÅrligSaldoopgørelse | Al40CSidsteAktivAfståetEllerUdløbet
# Afskrivningslov40CInput(indkomstår: Heltal, begivenhed: Afskrivningslov40CBegivenhed, saldo_status: Afskrivningslov40CSaldostatus, saldo_primo_kroner: Heltal, bevægelser_i_året: List(Afskrivningslov40CSaldobevægelse))
# Afskrivningslov40CResultat(indkomstår: Heltal, begivenhed: Afskrivningslov40CBegivenhed, saldo_status: Afskrivningslov40CSaldostatus, input_gyldigt: Boolsk, omfattet_af_par40c: Boolsk, anskaffelsessummer_i_året_kroner: Heltal, afståelsessummer_i_året_kroner: Heltal, afståelsesårets_nyanskaffelser_kroner: Heltal, saldoværdi_ultimo_før_regulering_kroner: Heltal, positiv_saldo_uden_fradrag_kroner: Heltal, negativ_saldo_indtægtsført_kroner: Heltal, saldo_efter_regulering_kroner: Heltal, afståelsesår_fortjeneste_kroner: Heltal, afståelsesår_tab_kroner: Heltal, skattepligtigt_beløb_kroner: Heltal, fradragsberettiget_beløb_kroner: Heltal, netto_skattepligtigt_eller_fradragsberettiget_kroner: Heltal)

# Afskrivningslov40CAnskaffelsesgrundlag = Al40CSærskiltAnskaffelsessum(anskaffelsessum_kroner: Heltal) | Al40CVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner: Heltal) | Al40CSkønsmæssigAndelAfSamletAnskaffelsessum(anskaffelsessum_kroner: Heltal) | Al40CPolsukkerStandard(polsukker_ton: Heltal)
# Afskrivningslov40CAktivgrundlag = Al40CBetalingsrettighedsgrundlag(anskaffelsesgrundlag: Afskrivningslov40CAnskaffelsesgrundlag) | Al40CMælkekvotegrundlag(anskaffelsesgrundlag: Afskrivningslov40CAnskaffelsesgrundlag) | Al40CSukkerroegrundlag(anskaffelsesgrundlag: Afskrivningslov40CAnskaffelsesgrundlag)
# Afskrivningslov40CMælkekvoteEjendomsforløb = Al40CMælkEjendomsforløbIkkeRelevant | Al40CMælkEjendomIkkeAfstået | Al40CMælkAfståetFørEllerSammenMedEjendom | Al40CMælkAfståetEfterEjendomUdenEblRegulering
# Afskrivningslov40CPosition(skatteyder: AfskrivningslovSkatteyder, lot: AfskrivningslovKvoteLot, aktivgrundlag: Afskrivningslov40CAktivgrundlag, resterende_anskaffelsesgrundlag_kroner: Heltal)
# Afskrivningslov40CAktivhændelse = Al40CAnskaffelsePåSaldo | Al40CAktivAfstået(hændelsesdato: AfskrivningslovDato, afståede_enheder: Heltal, afståelsessum_kroner: Heltal, mælkekvote_ejendomsforløb: Afskrivningslov40CMælkekvoteEjendomsforløb) | Al40CAktivUdløbet(hændelsesdato: AfskrivningslovDato, udløbne_enheder: Heltal, mælkekvote_ejendomsforløb: Afskrivningslov40CMælkekvoteEjendomsforløb) | Al40CForpagterAfgiverVederlagsfrit(hændelsesdato: AfskrivningslovDato, afgivne_enheder: Heltal) | Al40CBortforpagterModtagerVederlagsfrit
# Afskrivningslov40CAktivInput(indkomstår: Heltal, position: Afskrivningslov40CPosition, lager: List(Afskrivningslov40CPosition), hændelse: Afskrivningslov40CAktivhændelse)
# Afskrivningslov40CAktivResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, kvoteart: Afskrivningslov40CKvoteart, hændelse: Afskrivningslov40CAktivhændelse, position_gyldig: Boolsk, lager_gyldigt: Boolsk, omfattet_af_par40c: Boolsk, hændelse_gyldig: Boolsk, fifo_betingelse_opfyldt: Boolsk, gammel_mælkekvote_indgår_ved_afståelsen: Boolsk, forpagterregel_anvendt: Boolsk, disponerede_enheder: Heltal, anskaffelsessum_henført_til_hændelsen_kroner: Heltal, afståelsessum_kroner: Heltal, bevægelser_i_året: List(Afskrivningslov40CSaldobevægelse), resterende_enheder: Heltal, resterende_anskaffelsesgrundlag_kroner: Heltal, position_efter: Afskrivningslov40CPosition)

| afskrivningslov40c_mælkekvote_startdato() -> AfskrivningslovDato(år = 1993, måned = 5, dag = 19)
| afskrivningslov40c_mælkekvote_ny_saldodato() -> AfskrivningslovDato(år = 2005, måned = 1, dag = 1)
| afskrivningslov40c_sukkerroe_saldodato() -> AfskrivningslovDato(år = 2006, måned = 10, dag = 4)
| afskrivningslov40c_aktivart(aktivgrundlag: Afskrivningslov40CAktivgrundlag) -> match aktivgrundlag {
    | Al40CBetalingsrettighedsgrundlag(_) -> Al40CBetalingsrettighed
    | Al40CMælkekvotegrundlag(_) -> Al40CMælkekvote
    | Al40CSukkerroegrundlag(_) -> Al40CLeveringsrettighedForSukkerroer
}
| afskrivningslov40c_anskaffelsesgrundlag(aktivgrundlag: Afskrivningslov40CAktivgrundlag) -> match aktivgrundlag {
    | Al40CBetalingsrettighedsgrundlag(grundlag) -> grundlag
    | Al40CMælkekvotegrundlag(grundlag) -> grundlag
    | Al40CSukkerroegrundlag(grundlag) -> grundlag
}
| afskrivningslov40c_anskaffelsesgrundlag_kroner(grundlag: Afskrivningslov40CAnskaffelsesgrundlag) -> match grundlag {
    | Al40CSærskiltAnskaffelsessum(anskaffelsessum_kroner) -> penge_positivt_beløb(anskaffelsessum_kroner)
    | Al40CVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner) -> penge_positivt_beløb(beskattet_værdi_ved_tildeling_kroner)
    | Al40CSkønsmæssigAndelAfSamletAnskaffelsessum(anskaffelsessum_kroner) -> penge_positivt_beløb(anskaffelsessum_kroner)
    | Al40CPolsukkerStandard(polsukker_ton) -> penge_positivt_beløb(polsukker_ton) * 2500
}
| afskrivningslov40c_anskaffelsesgrundlag_gyldigt(grundlag: Afskrivningslov40CAnskaffelsesgrundlag) -> match grundlag {
    | Al40CSærskiltAnskaffelsessum(anskaffelsessum_kroner) -> anskaffelsessum_kroner > 0
    | Al40CVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner) -> beskattet_værdi_ved_tildeling_kroner >= 0
    | Al40CSkønsmæssigAndelAfSamletAnskaffelsessum(anskaffelsessum_kroner) -> anskaffelsessum_kroner > 0
    | Al40CPolsukkerStandard(polsukker_ton) -> polsukker_ton > 0
}
| afskrivningslov40c_særskilt_eller_vederlagsfrit(grundlag: Afskrivningslov40CAnskaffelsesgrundlag) -> match grundlag { | Al40CSærskiltAnskaffelsessum(_) -> Sandt | Al40CVederlagsfritTildelt(_) -> Sandt | _ -> Falskt }
| afskrivningslov40c_vederlagsfrit_tildelt(grundlag: Afskrivningslov40CAnskaffelsesgrundlag) -> match grundlag { | Al40CVederlagsfritTildelt(_) -> Sandt | _ -> Falskt }
| afskrivningslov40c_vederlagsfri_beskattet_værdi_kroner(grundlag: Afskrivningslov40CAnskaffelsesgrundlag) -> match grundlag { | Al40CVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner) -> penge_positivt_beløb(beskattet_værdi_ved_tildeling_kroner) | _ -> 0 }
| afskrivningslov40c_mælkekvote(aktivgrundlag: Afskrivningslov40CAktivgrundlag) -> afskrivningslov40c_aktivart(aktivgrundlag) == Al40CMælkekvote
| afskrivningslov40c_sukkerroerettighed(aktivgrundlag: Afskrivningslov40CAktivgrundlag) -> afskrivningslov40c_aktivart(aktivgrundlag) == Al40CLeveringsrettighedForSukkerroer
| afskrivningslov40c_mælkekvote_før_startdato(position: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote(position.aktivgrundlag) && afskrivningslov_dato_yyyymmdd(position.lot.erhvervelsesdato) < afskrivningslov_dato_yyyymmdd(afskrivningslov40c_mælkekvote_startdato())
| afskrivningslov40c_mælkekvote_1993_2004(position: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote(position.aktivgrundlag) && afskrivningslov_dato_yyyymmdd(position.lot.erhvervelsesdato) >= afskrivningslov_dato_yyyymmdd(afskrivningslov40c_mælkekvote_startdato()) && afskrivningslov_dato_yyyymmdd(position.lot.erhvervelsesdato) < afskrivningslov_dato_yyyymmdd(afskrivningslov40c_mælkekvote_ny_saldodato())
| afskrivningslov40c_mælkekvote_fra_2005(position: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote(position.aktivgrundlag) && afskrivningslov_dato_yyyymmdd(position.lot.erhvervelsesdato) >= afskrivningslov_dato_yyyymmdd(afskrivningslov40c_mælkekvote_ny_saldodato())
| afskrivningslov40c_sukkerroe_før_saldodato(position: Afskrivningslov40CPosition) -> afskrivningslov40c_sukkerroerettighed(position.aktivgrundlag) && afskrivningslov_dato_yyyymmdd(position.lot.erhvervelsesdato) < afskrivningslov_dato_yyyymmdd(afskrivningslov40c_sukkerroe_saldodato())
| afskrivningslov40c_position_gyldig(position: Afskrivningslov40CPosition) -> afskrivningslov_kvote_lot_gyldigt(position.lot) && (position.lot.resterende_enheder > 0 || position.resterende_anskaffelsesgrundlag_kroner == 0) && afskrivningslov40c_anskaffelsesgrundlag_gyldigt(afskrivningslov40c_anskaffelsesgrundlag(position.aktivgrundlag)) && position.resterende_anskaffelsesgrundlag_kroner >= 0 && position.resterende_anskaffelsesgrundlag_kroner <= afskrivningslov40c_anskaffelsesgrundlag_kroner(afskrivningslov40c_anskaffelsesgrundlag(position.aktivgrundlag)) && match position.aktivgrundlag {
    | Al40CBetalingsrettighedsgrundlag(grundlag) -> afskrivningslov40c_særskilt_eller_vederlagsfrit(grundlag) && afskrivningslov40c_vederlagsfri_beskattet_værdi_kroner(grundlag) == 0
    | Al40CMælkekvotegrundlag(grundlag) -> afskrivningslov40c_særskilt_eller_vederlagsfrit(grundlag) && (afskrivningslov40c_mælkekvote_1993_2004(position) || afskrivningslov40c_vederlagsfri_beskattet_værdi_kroner(grundlag) == 0)
    | Al40CSukkerroegrundlag(grundlag) -> hvis afskrivningslov40c_sukkerroe_før_saldodato(position) { afskrivningslov40c_vederlagsfrit_tildelt(grundlag) == Falskt || afskrivningslov40c_vederlagsfri_beskattet_værdi_kroner(grundlag) == 0 } ellers { afskrivningslov40c_særskilt_eller_vederlagsfrit(grundlag) && afskrivningslov40c_vederlagsfri_beskattet_værdi_kroner(grundlag) == 0 }
}
| afskrivningslov40c_position_samme_fifo_plads(venstre: Afskrivningslov40CPosition, højre: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote(venstre.aktivgrundlag) && afskrivningslov40c_mælkekvote(højre.aktivgrundlag) && afskrivningslov_dato_yyyymmdd(venstre.lot.erhvervelsesdato) == afskrivningslov_dato_yyyymmdd(højre.lot.erhvervelsesdato) && venstre.lot.erhvervelsesrækkefølge == højre.lot.erhvervelsesrækkefølge
| afskrivningslov40c_position_unik_i_lager(lager: List(Afskrivningslov40CPosition), position: Afskrivningslov40CPosition) -> foldl(lager, 0, |antal, anden_position| antal + hvis anden_position.lot.lot_id == position.lot.lot_id { 1 } ellers { 0 }) == 1 && (afskrivningslov40c_mælkekvote(position.aktivgrundlag) == Falskt || foldl(lager, 0, |antal, anden_position| antal + hvis afskrivningslov40c_position_samme_fifo_plads(anden_position, position) { 1 } ellers { 0 }) == 1)
| afskrivningslov40c_lager_gyldigt(lager: List(Afskrivningslov40CPosition), position: Afskrivningslov40CPosition) -> foldl(lager, Sandt, |alle_gyldige, anden_position| alle_gyldige && anden_position.skatteyder == position.skatteyder && afskrivningslov40c_position_gyldig(anden_position) && afskrivningslov40c_position_unik_i_lager(lager, anden_position)) && foldl(lager, 0, |antal, anden_position| antal + hvis anden_position == position { 1 } ellers { 0 }) == 1
| afskrivningslov40c_aktiv_mælkekvote_før_2005(position: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote(position.aktivgrundlag) && position.lot.resterende_enheder > 0 && afskrivningslov_dato_yyyymmdd(position.lot.erhvervelsesdato) < afskrivningslov_dato_yyyymmdd(afskrivningslov40c_mælkekvote_ny_saldodato())
| afskrivningslov40c_aktiv_mælkekvote_fra_2005(position: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote_fra_2005(position) && position.lot.resterende_enheder > 0
| afskrivningslov40c_blandet_mælkelager(lager: List(Afskrivningslov40CPosition)) -> foldl(lager, Falskt, |fundet, position| fundet || afskrivningslov40c_aktiv_mælkekvote_før_2005(position)) && foldl(lager, Falskt, |fundet, position| fundet || afskrivningslov40c_aktiv_mælkekvote_fra_2005(position))
| afskrivningslov40c_mælkeposition_før(venstre: Afskrivningslov40CPosition, højre: Afskrivningslov40CPosition) -> afskrivningslov40c_mælkekvote(venstre.aktivgrundlag) && afskrivningslov40c_mælkekvote(højre.aktivgrundlag) && (afskrivningslov_dato_yyyymmdd(venstre.lot.erhvervelsesdato) < afskrivningslov_dato_yyyymmdd(højre.lot.erhvervelsesdato) || afskrivningslov_dato_yyyymmdd(venstre.lot.erhvervelsesdato) == afskrivningslov_dato_yyyymmdd(højre.lot.erhvervelsesdato) && venstre.lot.erhvervelsesrækkefølge < højre.lot.erhvervelsesrækkefølge)
| afskrivningslov40c_har_tidligere_mælkeposition(lager: List(Afskrivningslov40CPosition), position: Afskrivningslov40CPosition) -> foldl(lager, Falskt, |fundet, anden_position| fundet || anden_position.lot.resterende_enheder > 0 && afskrivningslov40c_mælkeposition_før(anden_position, position))
| afskrivningslov40c_aktiv_afstået(hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CAktivAfstået(_, _, _, _) -> Sandt | _ -> Falskt }
| afskrivningslov40c_aktiv_udløbet(hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CAktivUdløbet(_, _, _) -> Sandt | _ -> Falskt }
| afskrivningslov40c_forpagter_afgiver(hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CForpagterAfgiverVederlagsfrit(_, _) -> Sandt | _ -> Falskt }
| afskrivningslov40c_bortforpagter_modtager(hændelse: Afskrivningslov40CAktivhændelse) -> hændelse == Al40CBortforpagterModtagerVederlagsfrit
| afskrivningslov40c_disposition(hændelse: Afskrivningslov40CAktivhændelse) -> afskrivningslov40c_aktiv_afstået(hændelse) || afskrivningslov40c_aktiv_udløbet(hændelse) || afskrivningslov40c_forpagter_afgiver(hændelse)
| afskrivningslov40c_disponerede_enheder(hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CAktivAfstået(_, afståede_enheder, _, _) -> afståede_enheder | Al40CAktivUdløbet(_, udløbne_enheder, _) -> udløbne_enheder | Al40CForpagterAfgiverVederlagsfrit(_, afgivne_enheder) -> afgivne_enheder | _ -> 0 }
| afskrivningslov40c_hændelses_afståelsessum_kroner(hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CAktivAfstået(_, _, afståelsessum_kroner, _) -> penge_positivt_beløb(afståelsessum_kroner) | _ -> 0 }
| afskrivningslov40c_mælkekvote_ejendomsforløb(hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CAktivAfstået(_, _, _, ejendomsforløb) -> ejendomsforløb | Al40CAktivUdløbet(_, _, ejendomsforløb) -> ejendomsforløb | _ -> Al40CMælkEjendomsforløbIkkeRelevant }
| afskrivningslov40c_indgangsdato(position: Afskrivningslov40CPosition) -> hvis afskrivningslov40c_sukkerroe_før_saldodato(position) { afskrivningslov40c_sukkerroe_saldodato() } ellers { position.lot.erhvervelsesdato }
| afskrivningslov40c_aktivhændelsesdato(position: Afskrivningslov40CPosition, hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse { | Al40CAnskaffelsePåSaldo -> afskrivningslov40c_indgangsdato(position) | Al40CAktivAfstået(hændelsesdato, _, _, _) -> hændelsesdato | Al40CAktivUdløbet(hændelsesdato, _, _) -> hændelsesdato | Al40CForpagterAfgiverVederlagsfrit(hændelsesdato, _) -> hændelsesdato | Al40CBortforpagterModtagerVederlagsfrit -> position.lot.erhvervelsesdato }
| afskrivningslov40c_mælkekvote_ejendomsforløb_gyldigt(position: Afskrivningslov40CPosition, ejendomsforløb: Afskrivningslov40CMælkekvoteEjendomsforløb) -> hvis afskrivningslov40c_mælkekvote(position.aktivgrundlag) { hvis afskrivningslov40c_mælkekvote_fra_2005(position) { ejendomsforløb == Al40CMælkEjendomsforløbIkkeRelevant } ellers { ejendomsforløb != Al40CMælkEjendomsforløbIkkeRelevant } } ellers { ejendomsforløb == Al40CMælkEjendomsforløbIkkeRelevant }
| afskrivningslov40c_hændelsesart_gyldig(position: Afskrivningslov40CPosition, hændelse: Afskrivningslov40CAktivhændelse) -> match hændelse {
    | Al40CAktivAfstået(_, _, _, ejendomsforløb) -> afskrivningslov40c_mælkekvote_ejendomsforløb_gyldigt(position, ejendomsforløb)
    | Al40CAktivUdløbet(_, _, ejendomsforløb) -> afskrivningslov40c_mælkekvote_ejendomsforløb_gyldigt(position, ejendomsforløb)
    | Al40CForpagterAfgiverVederlagsfrit(_, _) -> afskrivningslov40c_aktivart(position.aktivgrundlag) == Al40CBetalingsrettighed
    | Al40CBortforpagterModtagerVederlagsfrit -> afskrivningslov40c_aktivart(position.aktivgrundlag) == Al40CBetalingsrettighed && afskrivningslov40c_vederlagsfrit_tildelt(afskrivningslov40c_anskaffelsesgrundlag(position.aktivgrundlag))
    | _ -> Sandt
}
| afskrivningslov40c_gammel_mælkekvote_indgår(position: Afskrivningslov40CPosition, hændelse: Afskrivningslov40CAktivhændelse) -> afskrivningslov40c_mælkekvote_1993_2004(position) && (afskrivningslov40c_aktiv_afstået(hændelse) || afskrivningslov40c_aktiv_udløbet(hændelse)) && afskrivningslov40c_mælkekvote_ejendomsforløb(hændelse) == Al40CMælkAfståetEfterEjendomUdenEblRegulering
| afskrivningslov40c_aktiv_omfattet(position: Afskrivningslov40CPosition, hændelse: Afskrivningslov40CAktivhændelse) -> match position.aktivgrundlag {
    | Al40CBetalingsrettighedsgrundlag(_) -> Sandt
    | Al40CMælkekvotegrundlag(_) -> afskrivningslov40c_mælkekvote_fra_2005(position) || afskrivningslov40c_gammel_mælkekvote_indgår(position, hændelse)
    | Al40CSukkerroegrundlag(_) -> afskrivningslov_dato_yyyymmdd(afskrivningslov40c_aktivhændelsesdato(position, hændelse)) >= afskrivningslov_dato_yyyymmdd(afskrivningslov40c_sukkerroe_saldodato())
}

# Afskrivningslov40CAktivSag(input: Afskrivningslov40CAktivInput) {
    | kvoteart() -> afskrivningslov40c_aktivart(input.position.aktivgrundlag)
    | oprindeligt_anskaffelsesgrundlag_kroner() -> afskrivningslov40c_anskaffelsesgrundlag_kroner(afskrivningslov40c_anskaffelsesgrundlag(input.position.aktivgrundlag))
    | position_gyldig() -> afskrivningslov40c_position_gyldig(input.position)
    | lager_gyldigt() -> afskrivningslov40c_lager_gyldigt(input.lager, input.position)
    | omfattet_af_par40c() -> afskrivningslov40c_aktiv_omfattet(input.position, input.hændelse)
    | hændelsesdato() -> afskrivningslov40c_aktivhændelsesdato(input.position, input.hændelse)
    | disponerede_enheder() -> afskrivningslov40c_disponerede_enheder(input.hændelse)
    | hændelse_gyldig() -> afskrivningslov_dato_gyldig(hændelsesdato()) && input.indkomstår == hændelsesdato().år && afskrivningslov_dato_yyyymmdd(hændelsesdato()) >= afskrivningslov_dato_yyyymmdd(input.position.lot.erhvervelsesdato) && afskrivningslov40c_hændelsesart_gyldig(input.position, input.hændelse) && match input.hændelse {
        | Al40CAnskaffelsePåSaldo -> input.position.lot.resterende_enheder > 0 && input.position.resterende_anskaffelsesgrundlag_kroner == oprindeligt_anskaffelsesgrundlag_kroner()
        | Al40CBortforpagterModtagerVederlagsfrit -> input.position.lot.resterende_enheder > 0 && input.position.resterende_anskaffelsesgrundlag_kroner == 0
        | Al40CAktivAfstået(_, _, afståelsessum_kroner, _) -> disponerede_enheder() > 0 && disponerede_enheder() <= input.position.lot.resterende_enheder && afståelsessum_kroner >= 0
        | _ -> disponerede_enheder() > 0 && disponerede_enheder() <= input.position.lot.resterende_enheder
    }
    | fifo_betingelse_opfyldt() -> afskrivningslov40c_aktiv_afstået(input.hændelse) == Falskt || afskrivningslov40c_mælkekvote(input.position.aktivgrundlag) == Falskt || afskrivningslov40c_blandet_mælkelager(input.lager) == Falskt || afskrivningslov40c_har_tidligere_mælkeposition(input.lager, input.position) == Falskt
    | hændelse_behandles() -> position_gyldig() && lager_gyldigt() && omfattet_af_par40c() && hændelse_gyldig() && fifo_betingelse_opfyldt()
    | disposition_opdaterer_position() -> position_gyldig() && lager_gyldigt() && hændelse_gyldig() && fifo_betingelse_opfyldt() && afskrivningslov40c_disposition(input.hændelse)
    | gammel_mælkekvote_indgår_ved_afståelsen() -> hændelse_behandles() && afskrivningslov40c_gammel_mælkekvote_indgår(input.position, input.hændelse)
    | forpagterregel_anvendt() -> hændelse_behandles() && (afskrivningslov40c_forpagter_afgiver(input.hændelse) || afskrivningslov40c_bortforpagter_modtager(input.hændelse))
    | anskaffelsesgrundlag_henført_til_disposition_kroner() -> hvis disposition_opdaterer_position() { hvis disponerede_enheder() == input.position.lot.resterende_enheder { input.position.resterende_anskaffelsesgrundlag_kroner } ellers { input.position.resterende_anskaffelsesgrundlag_kroner * disponerede_enheder() / input.position.lot.resterende_enheder } } ellers { 0 }
    | anskaffelsessum_henført_til_hændelsen_kroner() -> hvis hændelse_behandles() && (input.hændelse == Al40CAnskaffelsePåSaldo || afskrivningslov40c_bortforpagter_modtager(input.hændelse)) { input.position.resterende_anskaffelsesgrundlag_kroner } ellers { hvis gammel_mælkekvote_indgår_ved_afståelsen() { anskaffelsesgrundlag_henført_til_disposition_kroner() } ellers { 0 } }
    | afståelsessum_kroner() -> hvis hændelse_behandles() { afskrivningslov40c_hændelses_afståelsessum_kroner(input.hændelse) } ellers { 0 }
    | bevægelser_i_året() -> hvis hændelse_behandles() { hvis gammel_mælkekvote_indgår_ved_afståelsen() { [Al40CAnskaffelse(kvoteart = kvoteart(), anskaffelsessum_kroner = anskaffelsessum_henført_til_hændelsen_kroner()), Al40CAfståelse(kvoteart = kvoteart(), afståelsessum_kroner = afståelsessum_kroner())] } ellers { hvis input.hændelse == Al40CAnskaffelsePåSaldo || afskrivningslov40c_bortforpagter_modtager(input.hændelse) { [Al40CAnskaffelse(kvoteart = kvoteart(), anskaffelsessum_kroner = anskaffelsessum_henført_til_hændelsen_kroner())] } ellers { [Al40CAfståelse(kvoteart = kvoteart(), afståelsessum_kroner = afståelsessum_kroner())] } } } ellers { [Al40CIngenSaldobevægelse] }
    | resterende_enheder() -> hvis disposition_opdaterer_position() { input.position.lot.resterende_enheder - disponerede_enheder() } ellers { input.position.lot.resterende_enheder }
    | resterende_anskaffelsesgrundlag_kroner() -> hvis disposition_opdaterer_position() { input.position.resterende_anskaffelsesgrundlag_kroner - anskaffelsesgrundlag_henført_til_disposition_kroner() } ellers { input.position.resterende_anskaffelsesgrundlag_kroner }
    | position_efter() -> Afskrivningslov40CPosition(
        skatteyder = input.position.skatteyder,
        lot = afskrivningslov_kvote_lot_med_resterende_enheder(input.position.lot, resterende_enheder()),
        aktivgrundlag = input.position.aktivgrundlag,
        resterende_anskaffelsesgrundlag_kroner = resterende_anskaffelsesgrundlag_kroner()
    )
    | resultat() -> Afskrivningslov40CAktivResultat(
        indkomstår = input.indkomstår,
        skatteyder = input.position.skatteyder,
        kvoteart = kvoteart(),
        hændelse = input.hændelse,
        position_gyldig = position_gyldig(),
        lager_gyldigt = lager_gyldigt(),
        omfattet_af_par40c = omfattet_af_par40c(),
        hændelse_gyldig = hændelse_gyldig(),
        fifo_betingelse_opfyldt = fifo_betingelse_opfyldt(),
        gammel_mælkekvote_indgår_ved_afståelsen = gammel_mælkekvote_indgår_ved_afståelsen(),
        forpagterregel_anvendt = forpagterregel_anvendt(),
        disponerede_enheder = disponerede_enheder(),
        anskaffelsessum_henført_til_hændelsen_kroner = anskaffelsessum_henført_til_hændelsen_kroner(),
        afståelsessum_kroner = afståelsessum_kroner(),
        bevægelser_i_året = bevægelser_i_året(),
        resterende_enheder = resterende_enheder(),
        resterende_anskaffelsesgrundlag_kroner = resterende_anskaffelsesgrundlag_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov40c_aktiv_sag(input: Afskrivningslov40CAktivInput) -> Afskrivningslov40CAktivSag(input)
| afskrivningslov40c_aktiv_resultat(input: Afskrivningslov40CAktivInput) -> afskrivningslov40c_aktiv_sag(input).resultat()

| afskrivningslov40c_årlig_saldoopgørelse(begivenhed: Afskrivningslov40CBegivenhed) -> begivenhed == Al40CÅrligSaldoopgørelse
| afskrivningslov40c_afståelsesår(begivenhed: Afskrivningslov40CBegivenhed) -> begivenhed == Al40CSidsteAktivAfståetEllerUdløbet
| afskrivningslov40c_saldobevægelse_gyldig(bevægelse: Afskrivningslov40CSaldobevægelse) -> match bevægelse {
    | Al40CAnskaffelse(_, anskaffelsessum_kroner) -> anskaffelsessum_kroner >= 0
    | Al40CAfståelse(_, afståelsessum_kroner) -> afståelsessum_kroner >= 0
    | Al40CIngenSaldobevægelse -> Sandt
}
| afskrivningslov40c_anskaffelsessum_kroner(bevægelse: Afskrivningslov40CSaldobevægelse) -> match bevægelse { | Al40CAnskaffelse(_, anskaffelsessum_kroner) -> penge_positivt_beløb(anskaffelsessum_kroner) | _ -> 0 }
| afskrivningslov40c_afståelsessum_kroner(bevægelse: Afskrivningslov40CSaldobevægelse) -> match bevægelse { | Al40CAfståelse(_, afståelsessum_kroner) -> penge_positivt_beløb(afståelsessum_kroner) | _ -> 0 }
| afskrivningslov40c_afståelsesårets_nyanskaffelse_kroner(bevægelse: Afskrivningslov40CSaldobevægelse) -> match bevægelse {
    | Al40CAnskaffelse(Al40CBetalingsrettighed, anskaffelsessum_kroner) -> penge_positivt_beløb(anskaffelsessum_kroner)
    | Al40CAnskaffelse(Al40CMælkekvote, anskaffelsessum_kroner) -> penge_positivt_beløb(anskaffelsessum_kroner)
    | _ -> 0
}

# Afskrivningslov40CSag(input: Afskrivningslov40CInput) {
    | input_gyldigt() -> input.indkomstår > 0 && input.saldo_primo_kroner >= 0 && foldl(input.bevægelser_i_året, Sandt, |alle_gyldige, bevægelse| alle_gyldige && afskrivningslov40c_saldobevægelse_gyldig(bevægelse))
    | omfattet_af_par40c() -> input_gyldigt() && input.saldo_status == Al40CSaldoOmfattet
    | anskaffelsessummer_i_året_kroner() -> foldl(input.bevægelser_i_året, 0, |sum, bevægelse| sum + afskrivningslov40c_anskaffelsessum_kroner(bevægelse))
    | afståelsessummer_i_året_kroner() -> foldl(input.bevægelser_i_året, 0, |sum, bevægelse| sum + afskrivningslov40c_afståelsessum_kroner(bevægelse))
    | afståelsesårets_nyanskaffelser_kroner() -> foldl(input.bevægelser_i_året, 0, |sum, bevægelse| sum + afskrivningslov40c_afståelsesårets_nyanskaffelse_kroner(bevægelse))
    | saldoværdi_ultimo_før_regulering_kroner() -> 0
    | exception al40c_saldo_opgøres saldoværdi_ultimo_før_regulering_kroner() -> input.saldo_primo_kroner + anskaffelsessummer_i_året_kroner() - afståelsessummer_i_året_kroner() under omfattet_af_par40c()
    | positiv_saldo_uden_fradrag_kroner() -> 0
    | exception al40c_positiv_saldo_hverken_fradrages_eller_afskrives positiv_saldo_uden_fradrag_kroner() -> saldoværdi_ultimo_før_regulering_kroner() under omfattet_af_par40c() && afskrivningslov40c_årlig_saldoopgørelse(input.begivenhed) && saldoværdi_ultimo_før_regulering_kroner() > 0
    | negativ_saldo_indtægtsført_kroner() -> 0
    | exception al40c_negativ_saldo_indtægtsføres negativ_saldo_indtægtsført_kroner() -> 0 - saldoværdi_ultimo_før_regulering_kroner() under omfattet_af_par40c() && afskrivningslov40c_årlig_saldoopgørelse(input.begivenhed) && saldoværdi_ultimo_før_regulering_kroner() < 0
    | saldo_efter_regulering_kroner() -> 0
    | exception al40c_positiv_saldo_videreføres saldo_efter_regulering_kroner() -> saldoværdi_ultimo_før_regulering_kroner() under omfattet_af_par40c() && afskrivningslov40c_årlig_saldoopgørelse(input.begivenhed) && saldoværdi_ultimo_før_regulering_kroner() > 0
    | afståelsesår_resultat_kroner() -> 0
    | exception al40c_sidste_aktiv_resultat afståelsesår_resultat_kroner() -> afståelsessummer_i_året_kroner() - (input.saldo_primo_kroner + afståelsesårets_nyanskaffelser_kroner()) under omfattet_af_par40c() && afskrivningslov40c_afståelsesår(input.begivenhed)
    | afståelsesår_fortjeneste_kroner() -> penge_positivt_beløb(afståelsesår_resultat_kroner())
    | afståelsesår_tab_kroner() -> penge_positivt_beløb(0 - afståelsesår_resultat_kroner())
    | skattepligtigt_beløb_kroner() -> negativ_saldo_indtægtsført_kroner() + afståelsesår_fortjeneste_kroner()
    | fradragsberettiget_beløb_kroner() -> afståelsesår_tab_kroner()
    | netto_skattepligtigt_eller_fradragsberettiget_kroner() -> skattepligtigt_beløb_kroner() - fradragsberettiget_beløb_kroner()
    | resultat() -> Afskrivningslov40CResultat(
        indkomstår = input.indkomstår,
        begivenhed = input.begivenhed,
        saldo_status = input.saldo_status,
        input_gyldigt = input_gyldigt(),
        omfattet_af_par40c = omfattet_af_par40c(),
        anskaffelsessummer_i_året_kroner = anskaffelsessummer_i_året_kroner(),
        afståelsessummer_i_året_kroner = afståelsessummer_i_året_kroner(),
        afståelsesårets_nyanskaffelser_kroner = afståelsesårets_nyanskaffelser_kroner(),
        saldoværdi_ultimo_før_regulering_kroner = saldoværdi_ultimo_før_regulering_kroner(),
        positiv_saldo_uden_fradrag_kroner = positiv_saldo_uden_fradrag_kroner(),
        negativ_saldo_indtægtsført_kroner = negativ_saldo_indtægtsført_kroner(),
        saldo_efter_regulering_kroner = saldo_efter_regulering_kroner(),
        afståelsesår_fortjeneste_kroner = afståelsesår_fortjeneste_kroner(),
        afståelsesår_tab_kroner = afståelsesår_tab_kroner(),
        skattepligtigt_beløb_kroner = skattepligtigt_beløb_kroner(),
        fradragsberettiget_beløb_kroner = fradragsberettiget_beløb_kroner(),
        netto_skattepligtigt_eller_fradragsberettiget_kroner = netto_skattepligtigt_eller_fradragsberettiget_kroner()
    )
}
| afskrivningslov40c_sag(input: Afskrivningslov40CInput) -> Afskrivningslov40CSag(input)
| afskrivningslov40c_resultat(input: Afskrivningslov40CInput) -> afskrivningslov40c_sag(input).resultat()

# Afskrivningslov40CEjendomskategori = Al40CLandbrugsEllerSkovejendom | Al40CAndenEjendom
# Afskrivningslov40CNegativSaldoIndtægtsføring(indkomstår: Heltal, indtægtsført_kroner: Heltal)
# Afskrivningslov40CEjendomstabInput(indkomstår: Heltal, ejendomskategori: Afskrivningslov40CEjendomskategori, fradragsberettiget_tab_efter_ejendomsavancebeskatningsloven_kroner: Heltal, negativ_saldo_historik: List(Afskrivningslov40CNegativSaldoIndtægtsføring))
# Afskrivningslov40CEjendomstabResultat(indkomstår: Heltal, ejendomskategori: Afskrivningslov40CEjendomskategori, input_gyldigt: Boolsk, omfattet_af_stk8: Boolsk, dokumenterede_indtægtsførte_negative_saldi_kroner: Heltal, ejendomstab_før_modregning_kroner: Heltal, modregnet_i_ejendomstab_kroner: Heltal, ejendomstab_efter_modregning_kroner: Heltal, acontoskat_sats_basispoint: Heltal, anset_indbetalt_acontoskat_kroner: Heltal)

| afskrivningslov40c_negativ_saldo_indtægtsføring_fra_resultat(resultat: Afskrivningslov40CResultat) -> Afskrivningslov40CNegativSaldoIndtægtsføring(indkomstår = resultat.indkomstår, indtægtsført_kroner = resultat.negativ_saldo_indtægtsført_kroner)
| afskrivningslov40c_negativ_saldo_post_gyldig(post: Afskrivningslov40CNegativSaldoIndtægtsføring, indkomstår: Heltal) -> post.indkomstår > 0 && post.indkomstår <= indkomstår && post.indtægtsført_kroner >= 0
| afskrivningslov40c_negativ_saldo_post_unik(historik: List(Afskrivningslov40CNegativSaldoIndtægtsføring), post: Afskrivningslov40CNegativSaldoIndtægtsføring) -> foldl(historik, 0, |antal, anden_post| antal + hvis anden_post.indkomstår == post.indkomstår { 1 } ellers { 0 }) == 1

# Afskrivningslov40CEjendomstabSag(input: Afskrivningslov40CEjendomstabInput) {
    | input_gyldigt() -> input.indkomstår > 0 && input.fradragsberettiget_tab_efter_ejendomsavancebeskatningsloven_kroner >= 0 && foldl(input.negativ_saldo_historik, Sandt, |alle_gyldige, post| alle_gyldige && afskrivningslov40c_negativ_saldo_post_gyldig(post, input.indkomstår) && afskrivningslov40c_negativ_saldo_post_unik(input.negativ_saldo_historik, post))
    | omfattet_af_stk8() -> input_gyldigt() && input.ejendomskategori == Al40CLandbrugsEllerSkovejendom && input.fradragsberettiget_tab_efter_ejendomsavancebeskatningsloven_kroner > 0
    | dokumenterede_indtægtsførte_negative_saldi_kroner() -> hvis input_gyldigt() { foldl(input.negativ_saldo_historik, 0, |sum, post| sum + post.indtægtsført_kroner) } ellers { 0 }
    | ejendomstab_før_modregning_kroner() -> hvis input_gyldigt() { input.fradragsberettiget_tab_efter_ejendomsavancebeskatningsloven_kroner } ellers { 0 }
    | modregnet_i_ejendomstab_kroner() -> hvis omfattet_af_stk8() { penge_mindste_beløb(ejendomstab_før_modregning_kroner(), dokumenterede_indtægtsførte_negative_saldi_kroner()) } ellers { 0 }
    | ejendomstab_efter_modregning_kroner() -> ejendomstab_før_modregning_kroner() - modregnet_i_ejendomstab_kroner()
    | acontoskat_sats_basispoint() -> 2200
    | anset_indbetalt_acontoskat_kroner() -> penge_beløb_gange_basispoint_kroner(modregnet_i_ejendomstab_kroner(), acontoskat_sats_basispoint())
    | resultat() -> Afskrivningslov40CEjendomstabResultat(
        indkomstår = input.indkomstår,
        ejendomskategori = input.ejendomskategori,
        input_gyldigt = input_gyldigt(),
        omfattet_af_stk8 = omfattet_af_stk8(),
        dokumenterede_indtægtsførte_negative_saldi_kroner = dokumenterede_indtægtsførte_negative_saldi_kroner(),
        ejendomstab_før_modregning_kroner = ejendomstab_før_modregning_kroner(),
        modregnet_i_ejendomstab_kroner = modregnet_i_ejendomstab_kroner(),
        ejendomstab_efter_modregning_kroner = ejendomstab_efter_modregning_kroner(),
        acontoskat_sats_basispoint = acontoskat_sats_basispoint(),
        anset_indbetalt_acontoskat_kroner = anset_indbetalt_acontoskat_kroner()
    )
}
| afskrivningslov40c_ejendomstab_sag(input: Afskrivningslov40CEjendomstabInput) -> Afskrivningslov40CEjendomstabSag(input)
| afskrivningslov40c_ejendomstab_resultat(input: Afskrivningslov40CEjendomstabInput) -> afskrivningslov40c_ejendomstab_sag(input).resultat()

# Afskrivningslov40CAcontoskatPosition(oprindelsesår: Heltal, resterende_fremført_acontoskat_kroner: Heltal)
# Afskrivningslov40CAcontoskatGrundlag = Al40CNytAcontoskattebeløb(ejendomstab_resultat: Afskrivningslov40CEjendomstabResultat) | Al40CFremførtAcontoskattebeløb(position: Afskrivningslov40CAcontoskatPosition)
# Afskrivningslov40CAcontoskatOverdragelse = Al40CIngenSuccession | Al40CSuccessionEfterKildeskattelov33C | Al40CSuccessionEfterDødsboskattelov39
# Afskrivningslov40CAcontoskatInput(indkomstår: Heltal, grundlag: Afskrivningslov40CAcontoskatGrundlag, egen_slutskat_med_restskat_mv_før_al40c_kroner: Heltal, overdragelse: Afskrivningslov40CAcontoskatOverdragelse, gift_og_samlevende_ved_udgangen_af_året_før_overdragelsen: Boolsk, ægtefælles_slutskat_mv_kroner: Heltal)
# Afskrivningslov40CAcontoskatResultat(indkomstår: Heltal, grundlag_gyldigt: Boolsk, input_gyldigt: Boolsk, tilgængelig_acontoskat_kroner: Heltal, egen_slutskat_før_kroner: Heltal, fradrag_i_egen_slutskat_kroner: Heltal, egen_slutskat_efter_kroner: Heltal, succession_stk10: Boolsk, ægtefælles_slutskat_før_kroner: Heltal, fradrag_i_ægtefælles_slutskat_kroner: Heltal, ægtefælles_slutskat_efter_kroner: Heltal, kontant_udbetaling_kroner: Heltal, fremført_til_følgende_indkomstår_kroner: Heltal, kredit_til_egen_kildeskat_slutopgørelse_kroner: Heltal, kredit_til_ægtefælles_kildeskat_slutopgørelse_kroner: Heltal, position_efter: Afskrivningslov40CAcontoskatPosition)

| afskrivningslov40c_nyt_acontoskattebeløb(grundlag: Afskrivningslov40CAcontoskatGrundlag) -> match grundlag { | Al40CNytAcontoskattebeløb(_) -> Sandt | _ -> Falskt }
| afskrivningslov40c_acontoskat_position_før(grundlag: Afskrivningslov40CAcontoskatGrundlag) -> match grundlag {
    | Al40CNytAcontoskattebeløb(ejendomstab_resultat) -> Afskrivningslov40CAcontoskatPosition(oprindelsesår = ejendomstab_resultat.indkomstår, resterende_fremført_acontoskat_kroner = ejendomstab_resultat.anset_indbetalt_acontoskat_kroner)
    | Al40CFremførtAcontoskattebeløb(position) -> position
}
| afskrivningslov40c_acontoskat_grundlag_gyldigt(indkomstår: Heltal, grundlag: Afskrivningslov40CAcontoskatGrundlag) -> match grundlag {
    | Al40CNytAcontoskattebeløb(ejendomstab_resultat) -> ejendomstab_resultat.input_gyldigt && ejendomstab_resultat.omfattet_af_stk8 && ejendomstab_resultat.indkomstår == indkomstår && ejendomstab_resultat.anset_indbetalt_acontoskat_kroner >= 0
    | Al40CFremførtAcontoskattebeløb(position) -> position.oprindelsesår > 0 && indkomstår > position.oprindelsesår && position.resterende_fremført_acontoskat_kroner >= 0
}
| afskrivningslov40c_acontoskat_succession(overdragelse: Afskrivningslov40CAcontoskatOverdragelse) -> overdragelse == Al40CSuccessionEfterKildeskattelov33C || overdragelse == Al40CSuccessionEfterDødsboskattelov39

# Afskrivningslov40CAcontoskatSag(input: Afskrivningslov40CAcontoskatInput) {
    | position_før() -> afskrivningslov40c_acontoskat_position_før(input.grundlag)
    | grundlag_gyldigt() -> afskrivningslov40c_acontoskat_grundlag_gyldigt(input.indkomstår, input.grundlag)
    | input_gyldigt() -> grundlag_gyldigt() && input.egen_slutskat_med_restskat_mv_før_al40c_kroner >= 0 && input.ægtefælles_slutskat_mv_kroner >= 0 && (afskrivningslov40c_nyt_acontoskattebeløb(input.grundlag) || input.overdragelse == Al40CIngenSuccession)
    | tilgængelig_acontoskat_kroner() -> hvis input_gyldigt() { position_før().resterende_fremført_acontoskat_kroner } ellers { 0 }
    | egen_slutskat_før_kroner() -> hvis input_gyldigt() { input.egen_slutskat_med_restskat_mv_før_al40c_kroner } ellers { 0 }
    | fradrag_i_egen_slutskat_kroner() -> penge_mindste_beløb(tilgængelig_acontoskat_kroner(), egen_slutskat_før_kroner())
    | egen_slutskat_efter_kroner() -> egen_slutskat_før_kroner() - fradrag_i_egen_slutskat_kroner()
    | rest_efter_egen_slutskat_kroner() -> tilgængelig_acontoskat_kroner() - fradrag_i_egen_slutskat_kroner()
    | succession_stk10() -> input_gyldigt() && afskrivningslov40c_nyt_acontoskattebeløb(input.grundlag) && afskrivningslov40c_acontoskat_succession(input.overdragelse)
    | ægtefælles_slutskat_før_kroner() -> hvis input_gyldigt() { input.ægtefælles_slutskat_mv_kroner } ellers { 0 }
    | fradrag_i_ægtefælles_slutskat_kroner() -> 0
    | exception al40c_stk10_ægtefælles_slutskat fradrag_i_ægtefælles_slutskat_kroner() -> penge_mindste_beløb(rest_efter_egen_slutskat_kroner(), ægtefælles_slutskat_før_kroner()) under succession_stk10() && input.gift_og_samlevende_ved_udgangen_af_året_før_overdragelsen
    | ægtefælles_slutskat_efter_kroner() -> ægtefælles_slutskat_før_kroner() - fradrag_i_ægtefælles_slutskat_kroner()
    | kontant_udbetaling_kroner() -> 0
    | exception al40c_stk9_resterende_udbetales_kontant kontant_udbetaling_kroner() -> rest_efter_egen_slutskat_kroner() under input_gyldigt() && afskrivningslov40c_nyt_acontoskattebeløb(input.grundlag) && succession_stk10() == Falskt
    | fremført_til_følgende_indkomstår_kroner() -> 0
    | exception al40c_stk10_resterende_fremføres fremført_til_følgende_indkomstår_kroner() -> rest_efter_egen_slutskat_kroner() - fradrag_i_ægtefælles_slutskat_kroner() under input_gyldigt() && (succession_stk10() || afskrivningslov40c_nyt_acontoskattebeløb(input.grundlag) == Falskt)
    | kredit_til_egen_kildeskat_slutopgørelse_kroner() -> hvis input_gyldigt() && afskrivningslov40c_nyt_acontoskattebeløb(input.grundlag) && succession_stk10() == Falskt { tilgængelig_acontoskat_kroner() } ellers { fradrag_i_egen_slutskat_kroner() }
    | kredit_til_ægtefælles_kildeskat_slutopgørelse_kroner() -> fradrag_i_ægtefælles_slutskat_kroner()
    | position_efter() -> hvis input_gyldigt() { Afskrivningslov40CAcontoskatPosition(oprindelsesår = position_før().oprindelsesår, resterende_fremført_acontoskat_kroner = fremført_til_følgende_indkomstår_kroner()) } ellers { position_før() }
    | resultat() -> Afskrivningslov40CAcontoskatResultat(
        indkomstår = input.indkomstår,
        grundlag_gyldigt = grundlag_gyldigt(),
        input_gyldigt = input_gyldigt(),
        tilgængelig_acontoskat_kroner = tilgængelig_acontoskat_kroner(),
        egen_slutskat_før_kroner = egen_slutskat_før_kroner(),
        fradrag_i_egen_slutskat_kroner = fradrag_i_egen_slutskat_kroner(),
        egen_slutskat_efter_kroner = egen_slutskat_efter_kroner(),
        succession_stk10 = succession_stk10(),
        ægtefælles_slutskat_før_kroner = ægtefælles_slutskat_før_kroner(),
        fradrag_i_ægtefælles_slutskat_kroner = fradrag_i_ægtefælles_slutskat_kroner(),
        ægtefælles_slutskat_efter_kroner = ægtefælles_slutskat_efter_kroner(),
        kontant_udbetaling_kroner = kontant_udbetaling_kroner(),
        fremført_til_følgende_indkomstår_kroner = fremført_til_følgende_indkomstår_kroner(),
        kredit_til_egen_kildeskat_slutopgørelse_kroner = kredit_til_egen_kildeskat_slutopgørelse_kroner(),
        kredit_til_ægtefælles_kildeskat_slutopgørelse_kroner = kredit_til_ægtefælles_kildeskat_slutopgørelse_kroner(),
        position_efter = position_efter()
    )
}
| afskrivningslov40c_acontoskat_sag(input: Afskrivningslov40CAcontoskatInput) -> Afskrivningslov40CAcontoskatSag(input)
| afskrivningslov40c_acontoskat_resultat(input: Afskrivningslov40CAcontoskatInput) -> afskrivningslov40c_acontoskat_sag(input).resultat()
--@end:afskrivningsloven_par40c--

--@label:afskrivningsloven_par40d::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_kvoter_juridisk_vejledning--
----
§ 40 D. En betalingsrettighed, mælkekvote eller leveringsrettighed for
sukkerroer, der bliver omfattet af skattepligt her i landet, og som ikke i
forvejen er omfattet af skattepligt her i landet, indgår på saldoen som nævnt i
§ 40 C med en anskaffelsessum, der opgøres til handelsværdien på
tilflytningstidspunktet, jf. selskabsskattelovens § 4 A og kildeskattelovens §
9. Når en person eller et selskab m.v. efter bestemmelserne i en
dobbeltbeskatningsoverenskomst indgået mellem Danmark og en fremmed stat,
Færøerne eller Grønland bliver hjemmehørende i Danmark, sidestilles dette ved
anvendelsen af reglen i 1. pkt. med indtræden af skattepligt her i landet.
----

--@begin:afskrivningsloven_par40d--
# Afskrivningslov40DSkattepligtsindtræden = Al40DSelskabsskattelovPar4A | Al40DKildeskattelovPar9 | Al40DHjemmehørendeEfterDobbeltbeskatningsoverenskomst
# Afskrivningslov40DInput(skatteyder: AfskrivningslovSkatteyder, kvoteart: Afskrivningslov40CKvoteart, skattepligtsindtræden: Afskrivningslov40DSkattepligtsindtræden, tilflytningstidspunkt: AfskrivningslovDato, ikke_i_forvejen_omfattet_af_skattepligt_her_i_landet: Boolsk, handelsværdi_på_tilflytningstidspunktet_kroner: Heltal)
# Afskrivningslov40DResultat(skatteyder: AfskrivningslovSkatteyder, kvoteart: Afskrivningslov40CKvoteart, skattepligtsindtræden: Afskrivningslov40DSkattepligtsindtræden, tilflytningstidspunkt: AfskrivningslovDato, input_gyldigt: Boolsk, dobbeltbeskatningsoverenskomst_sidestilles_med_skattepligtsindtræden: Boolsk, omfattet_af_par40d: Boolsk, anskaffelsessum_til_par40c_saldo_kroner: Heltal, par40c_saldobevægelse: Afskrivningslov40CSaldobevægelse)
# Afskrivningslov40DPar40COverførsel(indkomstår: Heltal, begivenhed: Afskrivningslov40CBegivenhed, saldo_primo_kroner: Heltal, par40d_resultat: Afskrivningslov40DResultat, øvrige_bevægelser_i_året: List(Afskrivningslov40CSaldobevægelse))

| afskrivningslov40d_dbo_hjemmehørende(indtræden: Afskrivningslov40DSkattepligtsindtræden) -> indtræden == Al40DHjemmehørendeEfterDobbeltbeskatningsoverenskomst
| afskrivningslov40d_resultat(input: Afskrivningslov40DInput) -> Afskrivningslov40DResultat(
    skatteyder = input.skatteyder,
    kvoteart = input.kvoteart,
    skattepligtsindtræden = input.skattepligtsindtræden,
    tilflytningstidspunkt = input.tilflytningstidspunkt,
    input_gyldigt = afskrivningslov_dato_gyldig(input.tilflytningstidspunkt) && input.handelsværdi_på_tilflytningstidspunktet_kroner >= 0,
    dobbeltbeskatningsoverenskomst_sidestilles_med_skattepligtsindtræden = afskrivningslov40d_dbo_hjemmehørende(input.skattepligtsindtræden),
    omfattet_af_par40d = afskrivningslov_dato_gyldig(input.tilflytningstidspunkt) && input.handelsværdi_på_tilflytningstidspunktet_kroner >= 0 && input.ikke_i_forvejen_omfattet_af_skattepligt_her_i_landet,
    anskaffelsessum_til_par40c_saldo_kroner = hvis afskrivningslov_dato_gyldig(input.tilflytningstidspunkt) && input.handelsværdi_på_tilflytningstidspunktet_kroner >= 0 && input.ikke_i_forvejen_omfattet_af_skattepligt_her_i_landet { input.handelsværdi_på_tilflytningstidspunktet_kroner } ellers { 0 },
    par40c_saldobevægelse = hvis afskrivningslov_dato_gyldig(input.tilflytningstidspunkt) && input.handelsværdi_på_tilflytningstidspunktet_kroner >= 0 && input.ikke_i_forvejen_omfattet_af_skattepligt_her_i_landet { Al40CAnskaffelse(kvoteart = input.kvoteart, anskaffelsessum_kroner = input.handelsværdi_på_tilflytningstidspunktet_kroner) } ellers { Al40CIngenSaldobevægelse }
)
| afskrivningslov40d_overførsel_i_tilflytningsåret(overførsel: Afskrivningslov40DPar40COverførsel) -> overførsel.indkomstår == overførsel.par40d_resultat.tilflytningstidspunkt.år
| afskrivningslov40d_saldobevægelse_til_par40c(overførsel: Afskrivningslov40DPar40COverførsel) -> hvis afskrivningslov40d_overførsel_i_tilflytningsåret(overførsel) && overførsel.par40d_resultat.omfattet_af_par40d { Al40CAnskaffelse(kvoteart = overførsel.par40d_resultat.kvoteart, anskaffelsessum_kroner = overførsel.par40d_resultat.anskaffelsessum_til_par40c_saldo_kroner) } ellers { Al40CIngenSaldobevægelse }
| afskrivningslov40d_til_par40c_input(overførsel: Afskrivningslov40DPar40COverførsel) -> Afskrivningslov40CInput(
    indkomstår = overførsel.indkomstår,
    begivenhed = overførsel.begivenhed,
    saldo_status = Al40CSaldoOmfattet,
    saldo_primo_kroner = overførsel.saldo_primo_kroner,
    bevægelser_i_året = concat([afskrivningslov40d_saldobevægelse_til_par40c(overførsel)], overførsel.øvrige_bevægelser_i_året)
)
| afskrivningslov40d_til_par40c_resultat(overførsel: Afskrivningslov40DPar40COverførsel) -> afskrivningslov40c_resultat(afskrivningslov40d_til_par40c_input(overførsel))
--@end:afskrivningsloven_par40d--

--@label:afskrivningsloven_par41::source:afskrivningsloven_lbk1222--
----
§ 41. (Ophævet)
----

--@begin:afskrivningsloven_par41--
# Afskrivningslov41Status = Al41Ophævet

| afskrivningslov41_status() -> Al41Ophævet
--@end:afskrivningsloven_par41--

--@label:afskrivningsloven_par42::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par42_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 42. Udgifter afholdt til ombygning og forbedring i eksisterende bygninger i
landbrugsejendomme af værelser, der anvendes til udlejning til turister, kan
afskrives med indtil 20 pct. årligt efter stk. 2-5. Afholdes udgiften af en
forpagter, kan forpagteren afskrive med indtil 20 pct. årligt efter stk. 2-5.

Stk. 2. Udgør udgiften et grundbeløb på 12.300 kr. (2010-niveau) eller
derunder, kan den skattepligtige vælge at fradrage (straksafskrive) hele
udgiften i den skattepligtige indkomst i det indkomstår, hvori udgiften
afholdes.

Stk. 3. Afskrivning kan kun foretages, såfremt udlejningen er afgiftspligtig
efter merværdiafgiftsloven.

Stk. 4. Afskrivningerne kan ikke overstige årets skattepligtige indtægter fra
udlejningen.

Stk. 5. Ved afståelse af værelser som nævnt i stk. 1 medregnes fortjeneste
eller tab på ombygnings- og forbedringsudgifter ved opgørelsen af den
skattepligtige indkomst. Fortjenesten eller tabet opgøres som forskellen
mellem på den ene side afståelsessummen og på den anden side de
afskrivningsberettigede udgifter til ombygning og forbedring med fradrag af
samtlige foretagne afskrivninger. Som genvundne afskrivninger medregnes højst
de foretagne afskrivninger, herunder forlods afskrivninger.
----

--@begin:afskrivningsloven_par42--
# AfskrivningslovÅrsafskrivning(indkomstår: Heltal, afskrivning_kroner: Heltal)
# AfskrivningslovSærligtAfskrivningsvalg = AlSærligIngenAfskrivning | AlSærligOrdinærAfskrivning(valgt_beløb_kroner: Heltal) | AlSærligStraksafskrivning
# Afskrivningslov42Rettighed = Al42Ejer | Al42Forpagter
# Afskrivningslov42Position(skatteyder: AfskrivningslovSkatteyder, afholdelsesår: Heltal, rettighed: Afskrivningslov42Rettighed, ombygnings_og_forbedringsudgift_kroner: Heltal, eksisterende_bygning_i_landbrugsejendom: Boolsk, værelser_anvendes_til_turistudlejning: Boolsk, landbrugsejendommen_er_erhvervsmæssigt_drevet: Boolsk, momspligtig_udlejning: Boolsk, tidligere_afskrivninger: List(AfskrivningslovÅrsafskrivning))
# Afskrivningslov42ÅrsInput(indkomstår: Heltal, position: Afskrivningslov42Position, årets_skattepligtige_udlejningsindtægt_kroner: Heltal, valg: AfskrivningslovSærligtAfskrivningsvalg)
# Afskrivningslov42ÅrsResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, rettighed: Afskrivningslov42Rettighed, position_gyldig: Boolsk, omfattet_af_par42: Boolsk, resterende_afskrivningsgrundlag_før_året_kroner: Heltal, reguleret_straksafskrivningsgrænse_kroner: Heltal, højeste_ordinære_afskrivning_før_indtægtsloft_kroner: Heltal, årets_skattepligtige_udlejningsindtægt_kroner: Heltal, højeste_afskrivning_efter_indtægtsloft_kroner: Heltal, valg: AfskrivningslovSærligtAfskrivningsvalg, valg_gyldigt: Boolsk, afskrivning_i_skattepligtig_indkomst_kroner: Heltal, position_efter: Afskrivningslov42Position)
# Afskrivningslov42AfståelsesInput(indkomstår: Heltal, position: Afskrivningslov42Position, afståelsessum_henført_til_ombygning_og_forbedring_kroner: Heltal, forlods_afskrivninger_kroner: Heltal)
# Afskrivningslov42AfståelsesResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, position_gyldig: Boolsk, omfattet_af_par42_stk5: Boolsk, afståelsessum_kroner: Heltal, samtlige_ordinære_afskrivninger_kroner: Heltal, forlods_afskrivninger_kroner: Heltal, samtlige_foretagne_afskrivninger_kroner: Heltal, nedskrevet_udgift_kroner: Heltal, beregnet_fortjeneste_kroner: Heltal, skattepligtige_genvundne_afskrivninger_kroner: Heltal, fortjeneste_ud_over_genvundne_afskrivninger_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal)

| afskrivningslov_årsafskrivning_gyldig(post: AfskrivningslovÅrsafskrivning, første_indkomstår: Heltal, før_indkomstår: Heltal) -> post.indkomstår >= første_indkomstår && post.indkomstår < før_indkomstår && post.afskrivning_kroner > 0
| afskrivningslov_årsafskrivning_unik(historik: List(AfskrivningslovÅrsafskrivning), post: AfskrivningslovÅrsafskrivning) -> foldl(historik, 0, |antal, anden_post| antal + hvis anden_post.indkomstår == post.indkomstår { 1 } ellers { 0 }) == 1
| afskrivningslov_årsafskrivninger_gyldige(historik: List(AfskrivningslovÅrsafskrivning), første_indkomstår: Heltal, før_indkomstår: Heltal) -> all(historik, |post: AfskrivningslovÅrsafskrivning| afskrivningslov_årsafskrivning_gyldig(post, første_indkomstår, før_indkomstår) && afskrivningslov_årsafskrivning_unik(historik, post))
| afskrivningslov_samlede_årsafskrivninger_kroner(historik: List(AfskrivningslovÅrsafskrivning)) -> foldl(historik, 0, |sum, post: AfskrivningslovÅrsafskrivning| sum + penge_positivt_beløb(post.afskrivning_kroner))
| afskrivningslov_reguleret_12300_grænse_kroner(indkomstår: Heltal) -> hvis indkomstår >= 2009 && indkomstår <= 2026 { par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(grundbeløb_2010_niveau_kroner = 12300, reguleringstal_tiendedele = par20_reguleringstal_tiendedele(indkomstår))) } ellers { 0 }
| afskrivningslov_særligt_valgt_beløb_kroner(valg: AfskrivningslovSærligtAfskrivningsvalg, fuldt_beløb_kroner: Heltal) -> match valg {
    | AlSærligIngenAfskrivning -> 0
    | AlSærligOrdinærAfskrivning(valgt_beløb_kroner) -> penge_positivt_beløb(valgt_beløb_kroner)
    | AlSærligStraksafskrivning -> penge_positivt_beløb(fuldt_beløb_kroner)
}

# Afskrivningslov42ÅrsSag(input: Afskrivningslov42ÅrsInput) {
    | position() -> input.position
    | udgift_kroner() -> penge_positivt_beløb(position().ombygnings_og_forbedringsudgift_kroner)
    | tidligere_afskrivninger_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | historik_gyldig() -> afskrivningslov_årsafskrivninger_gyldige(position().tidligere_afskrivninger, position().afholdelsesår, input.indkomstår) && tidligere_afskrivninger_kroner() <= udgift_kroner()
    | position_gyldig() -> input.indkomstår >= position().afholdelsesår && position().afholdelsesår > 0 && position().ombygnings_og_forbedringsudgift_kroner > 0 && historik_gyldig()
    | omfattet_af_par42() -> position_gyldig() && position().eksisterende_bygning_i_landbrugsejendom && position().værelser_anvendes_til_turistudlejning && position().landbrugsejendommen_er_erhvervsmæssigt_drevet && position().momspligtig_udlejning
    | resterende_afskrivningsgrundlag_kroner() -> hvis position_gyldig() { penge_positivt_beløb(udgift_kroner() - tidligere_afskrivninger_kroner()) } ellers { 0 }
    | straksafskrivningsgrænse_kroner() -> afskrivningslov_reguleret_12300_grænse_kroner(input.indkomstår)
    | højeste_ordinære_før_indtægtsloft_kroner() -> penge_mindste_beløb(resterende_afskrivningsgrundlag_kroner(), penge_beløb_gange_basispoint_kroner(udgift_kroner(), 2000))
    | udlejningsindtægt_kroner() -> penge_positivt_beløb(input.årets_skattepligtige_udlejningsindtægt_kroner)
    | højeste_efter_indtægtsloft_kroner() -> penge_mindste_beløb(højeste_ordinære_før_indtægtsloft_kroner(), udlejningsindtægt_kroner())
    | valgt_beløb_kroner() -> afskrivningslov_særligt_valgt_beløb_kroner(input.valg, resterende_afskrivningsgrundlag_kroner())
    | valg_gyldigt() -> match input.valg {
        | AlSærligIngenAfskrivning -> omfattet_af_par42()
        | AlSærligOrdinærAfskrivning(valgt_beløb_kroner) -> omfattet_af_par42() && valgt_beløb_kroner >= 0 && valgt_beløb_kroner <= højeste_efter_indtægtsloft_kroner()
        | AlSærligStraksafskrivning -> omfattet_af_par42() && input.indkomstår == position().afholdelsesår && udgift_kroner() <= straksafskrivningsgrænse_kroner() && resterende_afskrivningsgrundlag_kroner() == udgift_kroner() && udgift_kroner() <= udlejningsindtægt_kroner()
    }
    | afskrivning_kroner() -> hvis valg_gyldigt() { valgt_beløb_kroner() } ellers { 0 }
    | position_efter() -> hvis afskrivning_kroner() > 0 { Afskrivningslov42Position(skatteyder = position().skatteyder, afholdelsesår = position().afholdelsesår, rettighed = position().rettighed, ombygnings_og_forbedringsudgift_kroner = position().ombygnings_og_forbedringsudgift_kroner, eksisterende_bygning_i_landbrugsejendom = position().eksisterende_bygning_i_landbrugsejendom, værelser_anvendes_til_turistudlejning = position().værelser_anvendes_til_turistudlejning, landbrugsejendommen_er_erhvervsmæssigt_drevet = position().landbrugsejendommen_er_erhvervsmæssigt_drevet, momspligtig_udlejning = position().momspligtig_udlejning, tidligere_afskrivninger = concat(position().tidligere_afskrivninger, [AfskrivningslovÅrsafskrivning(indkomstår = input.indkomstår, afskrivning_kroner = afskrivning_kroner())])) } ellers { position() }
    | resultat() -> Afskrivningslov42ÅrsResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, rettighed = position().rettighed, position_gyldig = position_gyldig(), omfattet_af_par42 = omfattet_af_par42(), resterende_afskrivningsgrundlag_før_året_kroner = resterende_afskrivningsgrundlag_kroner(), reguleret_straksafskrivningsgrænse_kroner = straksafskrivningsgrænse_kroner(), højeste_ordinære_afskrivning_før_indtægtsloft_kroner = højeste_ordinære_før_indtægtsloft_kroner(), årets_skattepligtige_udlejningsindtægt_kroner = udlejningsindtægt_kroner(), højeste_afskrivning_efter_indtægtsloft_kroner = højeste_efter_indtægtsloft_kroner(), valg = input.valg, valg_gyldigt = valg_gyldigt(), afskrivning_i_skattepligtig_indkomst_kroner = afskrivning_kroner(), position_efter = position_efter())
}
| afskrivningslov42_års_sag(input: Afskrivningslov42ÅrsInput) -> Afskrivningslov42ÅrsSag(input)
| afskrivningslov42_års_resultat(input: Afskrivningslov42ÅrsInput) -> afskrivningslov42_års_sag(input).resultat()

# Afskrivningslov42AfståelsesSag(input: Afskrivningslov42AfståelsesInput) {
    | position() -> input.position
    | udgift_kroner() -> penge_positivt_beløb(position().ombygnings_og_forbedringsudgift_kroner)
    | ordinære_afskrivninger_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | forlods_afskrivninger_kroner() -> penge_positivt_beløb(input.forlods_afskrivninger_kroner)
    | samtlige_afskrivninger_kroner() -> ordinære_afskrivninger_kroner() + forlods_afskrivninger_kroner()
    | position_gyldig() -> input.indkomstår >= position().afholdelsesår && position().afholdelsesår > 0 && position().ombygnings_og_forbedringsudgift_kroner > 0 && afskrivningslov_årsafskrivninger_gyldige(position().tidligere_afskrivninger, position().afholdelsesår, input.indkomstår) && samtlige_afskrivninger_kroner() <= udgift_kroner()
    | omfattet_af_par42_stk5() -> position_gyldig() && position().eksisterende_bygning_i_landbrugsejendom && position().værelser_anvendes_til_turistudlejning && position().landbrugsejendommen_er_erhvervsmæssigt_drevet
    | afståelsessum_kroner() -> penge_positivt_beløb(input.afståelsessum_henført_til_ombygning_og_forbedring_kroner)
    | nedskrevet_udgift_kroner() -> hvis position_gyldig() { penge_positivt_beløb(udgift_kroner() - samtlige_afskrivninger_kroner()) } ellers { 0 }
    | beregnet_fortjeneste_kroner() -> hvis omfattet_af_par42_stk5() { penge_positivt_beløb(afståelsessum_kroner() - nedskrevet_udgift_kroner()) } ellers { 0 }
    | genvundne_afskrivninger_kroner() -> penge_mindste_beløb(beregnet_fortjeneste_kroner(), samtlige_afskrivninger_kroner())
    | fortjeneste_ud_over_genvundne_kroner() -> penge_positivt_beløb(beregnet_fortjeneste_kroner() - genvundne_afskrivninger_kroner())
    | tab_kroner() -> hvis omfattet_af_par42_stk5() { penge_positivt_beløb(nedskrevet_udgift_kroner() - afståelsessum_kroner()) } ellers { 0 }
    | resultat() -> Afskrivningslov42AfståelsesResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, position_gyldig = position_gyldig(), omfattet_af_par42_stk5 = omfattet_af_par42_stk5(), afståelsessum_kroner = afståelsessum_kroner(), samtlige_ordinære_afskrivninger_kroner = ordinære_afskrivninger_kroner(), forlods_afskrivninger_kroner = forlods_afskrivninger_kroner(), samtlige_foretagne_afskrivninger_kroner = samtlige_afskrivninger_kroner(), nedskrevet_udgift_kroner = nedskrevet_udgift_kroner(), beregnet_fortjeneste_kroner = beregnet_fortjeneste_kroner(), skattepligtige_genvundne_afskrivninger_kroner = genvundne_afskrivninger_kroner(), fortjeneste_ud_over_genvundne_afskrivninger_kroner = fortjeneste_ud_over_genvundne_kroner(), fradragsberettiget_tab_kroner = tab_kroner())
}
| afskrivningslov42_afståelses_sag(input: Afskrivningslov42AfståelsesInput) -> Afskrivningslov42AfståelsesSag(input)
| afskrivningslov42_afståelses_resultat(input: Afskrivningslov42AfståelsesInput) -> afskrivningslov42_afståelses_sag(input).resultat()
--@end:afskrivningsloven_par42--

--@label:afskrivningsloven_par43::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par43_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 43. Afgifter, der afholdes i anledning af en virksomheds tilslutning til
offentligt eller privat ejede anlæg, som har erhvervsmæssig betydning for
virksomheden, herunder anlæg, der tjener til forebyggelse eller bekæmpelse af
forurening eller støjulemper, afskrives med indtil 20 pct. årligt.

Stk. 2. Udgør tilslutningsafgiften et grundbeløb på 12.300 kr. (2010-niveau)
eller derunder, kan den skattepligtige vælge at fradrage (straksafskrive) hele
afgiften i den skattepligtige indkomst i det indkomstår, hvori afgiften
afholdes.

Stk. 3. Tilslutningsafgiften anses for afholdt efter stk. 1 og 2, når den er
forfalden til betaling.

Stk. 4. I tilfælde af, at det aktiv, som er blevet tilsluttet anlægget, sælges,
inden afgiften er afskrevet fuldt ud, kan den skattepligtige fradrage
restbeløbet i den skattepligtige indkomst i det indkomstår, hvori salget sker.

Stk. 5. Afgifter, der er afskrevet efter stk. 1 eller 2, medregnes ikke til
anskaffelsessummen ved opgørelsen af skattepligtig fortjeneste eller tab ved et
salg, der omfatter tilslutningen til anlægget.

Stk. 6. Anses en del af en afståelsessum som betaling for værdien af
tilslutning som nævnt i stk. 1 skal denne del medregnes til afståelsessummen for
det aktiv, der er blevet tilsluttet anlægget, ved opgørelsen af den
skattepligtige indkomst for det indkomstår, hvori salget finder sted.
----

--@begin:afskrivningsloven_par43--
# Afskrivningslov43Position(skatteyder: AfskrivningslovSkatteyder, forfaldsår: Heltal, tilslutningsafgift_kroner: Heltal, engangsudgift: Boolsk, fysisk_tilslutning: Boolsk, offentligt_anlæg_eller_privatanlæg_ejet_af_andre: Boolsk, erhvervsmæssig_anvendelsesandel_basispoint: Heltal, tidligere_afskrivninger: List(AfskrivningslovÅrsafskrivning))
# Afskrivningslov43ÅrsInput(indkomstår: Heltal, position: Afskrivningslov43Position, valg: AfskrivningslovSærligtAfskrivningsvalg)
# Afskrivningslov43ÅrsResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, position_gyldig: Boolsk, omfattet_af_par43: Boolsk, erhvervsmæssigt_afskrivningsgrundlag_kroner: Heltal, resterende_afskrivningsgrundlag_før_året_kroner: Heltal, reguleret_straksafskrivningsgrænse_kroner: Heltal, højeste_ordinære_afskrivning_kroner: Heltal, valg: AfskrivningslovSærligtAfskrivningsvalg, valg_gyldigt: Boolsk, afskrivning_i_skattepligtig_indkomst_kroner: Heltal, position_efter: Afskrivningslov43Position)
# Afskrivningslov43SalgInput(indkomstår: Heltal, position: Afskrivningslov43Position, tilsluttet_aktiv_solgt: Boolsk, samlet_afståelsessum_for_aktivet_før_tilslutningsværdi_kroner: Heltal, del_af_afståelsessum_henført_til_tilslutningsværdi_kroner: Heltal)
# Afskrivningslov43SalgResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, position_gyldig: Boolsk, tilsluttet_aktiv_solgt: Boolsk, resterende_afskrivningsgrundlag_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, afskrevne_tilslutningsafgifter_udelades_fra_aktivets_anskaffelsessum: Boolsk, del_henført_til_tilslutningsværdi_kroner: Heltal, samlet_afståelsessum_for_tilsluttet_aktiv_kroner: Heltal, særskilt_genvundne_afskrivninger_eller_tab_kroner: Heltal)

| afskrivningslov43_erhvervsmæssigt_grundlag_kroner(position: Afskrivningslov43Position) -> penge_beløb_gange_basispoint_afrundet_kroner(penge_positivt_beløb(position.tilslutningsafgift_kroner), position.erhvervsmæssig_anvendelsesandel_basispoint)
| afskrivningslov43_position_gyldig(position: Afskrivningslov43Position, før_indkomstår: Heltal) -> position.forfaldsår > 0 && position.forfaldsår <= før_indkomstår && position.tilslutningsafgift_kroner > 0 && position.erhvervsmæssig_anvendelsesandel_basispoint > 0 && position.erhvervsmæssig_anvendelsesandel_basispoint <= 10000 && afskrivningslov_årsafskrivninger_gyldige(position.tidligere_afskrivninger, position.forfaldsår, før_indkomstår) && afskrivningslov_samlede_årsafskrivninger_kroner(position.tidligere_afskrivninger) <= afskrivningslov43_erhvervsmæssigt_grundlag_kroner(position)
| afskrivningslov43_omfattet(position: Afskrivningslov43Position, før_indkomstår: Heltal) -> afskrivningslov43_position_gyldig(position, før_indkomstår) && position.engangsudgift && position.fysisk_tilslutning && position.offentligt_anlæg_eller_privatanlæg_ejet_af_andre

# Afskrivningslov43ÅrsSag(input: Afskrivningslov43ÅrsInput) {
    | position() -> input.position
    | position_gyldig() -> afskrivningslov43_position_gyldig(position(), input.indkomstår)
    | omfattet_af_par43() -> afskrivningslov43_omfattet(position(), input.indkomstår)
    | grundlag_kroner() -> afskrivningslov43_erhvervsmæssigt_grundlag_kroner(position())
    | tidligere_afskrivninger_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | resterende_kroner() -> hvis position_gyldig() { penge_positivt_beløb(grundlag_kroner() - tidligere_afskrivninger_kroner()) } ellers { 0 }
    | straksafskrivningsgrænse_kroner() -> afskrivningslov_reguleret_12300_grænse_kroner(input.indkomstår)
    | højeste_ordinære_kroner() -> penge_mindste_beløb(resterende_kroner(), penge_beløb_gange_basispoint_kroner(grundlag_kroner(), 2000))
    | valgt_beløb_kroner() -> afskrivningslov_særligt_valgt_beløb_kroner(input.valg, resterende_kroner())
    | valg_gyldigt() -> match input.valg {
        | AlSærligIngenAfskrivning -> omfattet_af_par43()
        | AlSærligOrdinærAfskrivning(valgt_beløb_kroner) -> omfattet_af_par43() && valgt_beløb_kroner >= 0 && valgt_beløb_kroner <= højeste_ordinære_kroner()
        | AlSærligStraksafskrivning -> omfattet_af_par43() && input.indkomstår == position().forfaldsår && grundlag_kroner() <= straksafskrivningsgrænse_kroner() && resterende_kroner() == grundlag_kroner()
    }
    | afskrivning_kroner() -> hvis valg_gyldigt() { valgt_beløb_kroner() } ellers { 0 }
    | position_efter() -> hvis afskrivning_kroner() > 0 { Afskrivningslov43Position(skatteyder = position().skatteyder, forfaldsår = position().forfaldsår, tilslutningsafgift_kroner = position().tilslutningsafgift_kroner, engangsudgift = position().engangsudgift, fysisk_tilslutning = position().fysisk_tilslutning, offentligt_anlæg_eller_privatanlæg_ejet_af_andre = position().offentligt_anlæg_eller_privatanlæg_ejet_af_andre, erhvervsmæssig_anvendelsesandel_basispoint = position().erhvervsmæssig_anvendelsesandel_basispoint, tidligere_afskrivninger = concat(position().tidligere_afskrivninger, [AfskrivningslovÅrsafskrivning(indkomstår = input.indkomstår, afskrivning_kroner = afskrivning_kroner())])) } ellers { position() }
    | resultat() -> Afskrivningslov43ÅrsResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, position_gyldig = position_gyldig(), omfattet_af_par43 = omfattet_af_par43(), erhvervsmæssigt_afskrivningsgrundlag_kroner = grundlag_kroner(), resterende_afskrivningsgrundlag_før_året_kroner = resterende_kroner(), reguleret_straksafskrivningsgrænse_kroner = straksafskrivningsgrænse_kroner(), højeste_ordinære_afskrivning_kroner = højeste_ordinære_kroner(), valg = input.valg, valg_gyldigt = valg_gyldigt(), afskrivning_i_skattepligtig_indkomst_kroner = afskrivning_kroner(), position_efter = position_efter())
}
| afskrivningslov43_års_sag(input: Afskrivningslov43ÅrsInput) -> Afskrivningslov43ÅrsSag(input)
| afskrivningslov43_års_resultat(input: Afskrivningslov43ÅrsInput) -> afskrivningslov43_års_sag(input).resultat()

# Afskrivningslov43SalgSag(input: Afskrivningslov43SalgInput) {
    | position() -> input.position
    | position_gyldig() -> afskrivningslov43_position_gyldig(position(), input.indkomstår)
    | omfattet_af_par43() -> afskrivningslov43_omfattet(position(), input.indkomstår)
    | grundlag_kroner() -> afskrivningslov43_erhvervsmæssigt_grundlag_kroner(position())
    | tidligere_afskrivninger_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | resterende_kroner() -> hvis position_gyldig() { penge_positivt_beløb(grundlag_kroner() - tidligere_afskrivninger_kroner()) } ellers { 0 }
    | salg_omfattet() -> omfattet_af_par43() && input.tilsluttet_aktiv_solgt
    | fradrag_kroner() -> hvis salg_omfattet() { resterende_kroner() } ellers { 0 }
    | tilslutningsværdi_kroner() -> penge_positivt_beløb(input.del_af_afståelsessum_henført_til_tilslutningsværdi_kroner)
    | samlet_afståelsessum_kroner() -> hvis salg_omfattet() { penge_positivt_beløb(input.samlet_afståelsessum_for_aktivet_før_tilslutningsværdi_kroner) + tilslutningsværdi_kroner() } ellers { 0 }
    | resultat() -> Afskrivningslov43SalgResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, position_gyldig = position_gyldig(), tilsluttet_aktiv_solgt = salg_omfattet(), resterende_afskrivningsgrundlag_kroner = resterende_kroner(), fradrag_i_skattepligtig_indkomst_kroner = fradrag_kroner(), afskrevne_tilslutningsafgifter_udelades_fra_aktivets_anskaffelsessum = salg_omfattet() && tidligere_afskrivninger_kroner() > 0, del_henført_til_tilslutningsværdi_kroner = tilslutningsværdi_kroner(), samlet_afståelsessum_for_tilsluttet_aktiv_kroner = samlet_afståelsessum_kroner(), særskilt_genvundne_afskrivninger_eller_tab_kroner = 0)
}
| afskrivningslov43_salg_sag(input: Afskrivningslov43SalgInput) -> Afskrivningslov43SalgSag(input)
| afskrivningslov43_salg_resultat(input: Afskrivningslov43SalgInput) -> afskrivningslov43_salg_sag(input).resultat()
--@end:afskrivningsloven_par43--

--@label:afskrivningsloven_par44::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par44_juridisk_vejledning--
----
§ 44. Reglerne i denne bestemmelse gælder for anskaffelse af
afskrivningsberettigede aktiver, når udgiften helt eller delvis er betalt ved et
eller flere af følgende tilskud m.v.:

1) Projekt- og saneringsstøtte, der er ydet af Medienævnet til trykte
nyhedsmedier og til skrevne internetbaserede nyhedsmedier.

2) Tilskud, der er ydet efter lov om Hav- og Fiskerifonden. Det gælder dog ikke
tilskud, der er ydet efter lovens bestemmelser om støtte til fiskerfartøjers
endelige ophør i dansk erhvervsfiskeri.

3) Tilskud, der er ydet efter fiskeriudviklingsloven. Det gælder dog ikke
tilskud, der er ydet efter lovens bestemmelser om støtte til fiskerfartøjers
endelige ophør i dansk erhvervsfiskeri.

4) Tilskud fra EU's strukturfonde under målet om regional konkurrenceevne og
beskæftigelse og under målet om europæisk territorialt samarbejde samt
tilhørende national medfinansiering.

5) Tilskud, der er ydet efter lov om Landdistriktsfonden.

6) Tilskud, der er ydet efter landdistriktsloven.

7) Tilskud, der er ydet til forbedring af forarbejdningen og afsætningen af
jordbrugs- og skovbrugsprodukter (strukturprojekter) efter lov om visse
landdistriktsrelaterede tilskudsordninger m.v.

8) Tilskud, der er ydet til fremme af tilpasningen og udviklingen af
landdistrikterne (artikel 33-ordningen) efter lov om visse
landdistriktsrelaterede tilskudsordninger m.v.

Stk. 2. Udgifter til anskaffelse af afskrivningsberettigede aktiver kan uanset
reglerne i denne lov straksafskrives i den skattepligtige indkomst for
anskaffelsesåret, i det omfang udgiften er betalt ved tilskud som nævnt i stk.
1.

Stk. 3. De straksafskrivninger, der er foretaget efter stk. 2, behandles som
afskrivninger.

Stk. 4. Når der er foretaget straksafskrivning på anskaffelsessummen for et
aktiv efter stk. 2, kan afskrivning på dette aktiv kun foretages på
anskaffelsessummen med fradrag af det straksafskrevne beløb.
----

--@begin:afskrivningsloven_par44--
# Afskrivningslov44Tilskudskategori = Al44MedienævnetProjektEllerSanering | Al44HavOgFiskerifonden | Al44HavOgFiskerifondenEndeligtFartøjsophør | Al44Fiskeriudviklingsloven | Al44FiskeriudviklingslovenEndeligtFartøjsophør | Al44EuStrukturfondeOgNationalMedfinansiering | Al44Landdistriktsfonden | Al44Landdistriktsloven | Al44JordbrugsOgSkovbrugsStrukturprojekt | Al44Artikel33Landdistriktsordning | Al44AndetTilskud
# Afskrivningslov44Tilskudsbetaling(kategori: Afskrivningslov44Tilskudskategori, betalt_til_anskaffelsesudgiften_kroner: Heltal)
# Afskrivningslov44Input(indkomstår: Heltal, anskaffelsesår: Heltal, skatteyder: AfskrivningslovSkatteyder, afskrivningsberettiget_aktiv: Boolsk, anskaffelsesudgift_kroner: Heltal, tilskudsbetalinger: List(Afskrivningslov44Tilskudsbetaling), valgt_straksafskrivning_kroner: Heltal)
# Afskrivningslov44Resultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, input_gyldigt: Boolsk, afskrivningsberettiget_aktiv: Boolsk, kvalificerende_tilskudsbetalinger_kroner: Heltal, højeste_straksafskrivning_kroner: Heltal, valgt_straksafskrivning_kroner: Heltal, valg_gyldigt: Boolsk, straksafskrivning_i_skattepligtig_indkomst_kroner: Heltal, straksafskrivning_behandles_som_afskrivning_kroner: Heltal, resterende_afskrivningsgrundlag_kroner: Heltal)

| afskrivningslov44_tilskud_omfattet(kategori: Afskrivningslov44Tilskudskategori) -> match kategori {
    | Al44MedienævnetProjektEllerSanering -> Sandt
    | Al44HavOgFiskerifonden -> Sandt
    | Al44HavOgFiskerifondenEndeligtFartøjsophør -> Falskt
    | Al44Fiskeriudviklingsloven -> Sandt
    | Al44FiskeriudviklingslovenEndeligtFartøjsophør -> Falskt
    | Al44EuStrukturfondeOgNationalMedfinansiering -> Sandt
    | Al44Landdistriktsfonden -> Sandt
    | Al44Landdistriktsloven -> Sandt
    | Al44JordbrugsOgSkovbrugsStrukturprojekt -> Sandt
    | Al44Artikel33Landdistriktsordning -> Sandt
    | Al44AndetTilskud -> Falskt
}
| afskrivningslov44_tilskudsbetaling_gyldig(betaling: Afskrivningslov44Tilskudsbetaling) -> betaling.betalt_til_anskaffelsesudgiften_kroner >= 0
| afskrivningslov44_kvalificerende_tilskud_kroner(betalinger: List(Afskrivningslov44Tilskudsbetaling)) -> foldl(betalinger, 0, |sum, betaling: Afskrivningslov44Tilskudsbetaling| sum + hvis afskrivningslov44_tilskud_omfattet(betaling.kategori) { penge_positivt_beløb(betaling.betalt_til_anskaffelsesudgiften_kroner) } ellers { 0 })

# Afskrivningslov44Sag(input: Afskrivningslov44Input) {
    | anskaffelsesudgift_kroner() -> penge_positivt_beløb(input.anskaffelsesudgift_kroner)
    | tilskudsbetalinger_gyldige() -> all(input.tilskudsbetalinger, |betaling: Afskrivningslov44Tilskudsbetaling| afskrivningslov44_tilskudsbetaling_gyldig(betaling))
    | kvalificerende_tilskud_kroner() -> afskrivningslov44_kvalificerende_tilskud_kroner(input.tilskudsbetalinger)
    | input_gyldigt() -> input.indkomstår == input.anskaffelsesår && input.anskaffelsesår > 0 && input.anskaffelsesudgift_kroner > 0 && tilskudsbetalinger_gyldige()
    | højeste_straksafskrivning_kroner() -> hvis input_gyldigt() && input.afskrivningsberettiget_aktiv { penge_mindste_beløb(anskaffelsesudgift_kroner(), kvalificerende_tilskud_kroner()) } ellers { 0 }
    | valg_gyldigt() -> input_gyldigt() && input.afskrivningsberettiget_aktiv && input.valgt_straksafskrivning_kroner >= 0 && input.valgt_straksafskrivning_kroner <= højeste_straksafskrivning_kroner()
    | straksafskrivning_kroner() -> hvis valg_gyldigt() { input.valgt_straksafskrivning_kroner } ellers { 0 }
    | resterende_afskrivningsgrundlag_kroner() -> hvis input_gyldigt() { penge_positivt_beløb(anskaffelsesudgift_kroner() - straksafskrivning_kroner()) } ellers { 0 }
    | resultat() -> Afskrivningslov44Resultat(indkomstår = input.indkomstår, skatteyder = input.skatteyder, input_gyldigt = input_gyldigt(), afskrivningsberettiget_aktiv = input.afskrivningsberettiget_aktiv, kvalificerende_tilskudsbetalinger_kroner = kvalificerende_tilskud_kroner(), højeste_straksafskrivning_kroner = højeste_straksafskrivning_kroner(), valgt_straksafskrivning_kroner = input.valgt_straksafskrivning_kroner, valg_gyldigt = valg_gyldigt(), straksafskrivning_i_skattepligtig_indkomst_kroner = straksafskrivning_kroner(), straksafskrivning_behandles_som_afskrivning_kroner = straksafskrivning_kroner(), resterende_afskrivningsgrundlag_kroner = resterende_afskrivningsgrundlag_kroner())
}
| afskrivningslov44_sag(input: Afskrivningslov44Input) -> Afskrivningslov44Sag(input)
| afskrivningslov44_resultat(input: Afskrivningslov44Input) -> afskrivningslov44_sag(input).resultat()
--@end:afskrivningsloven_par44--

--@label:afskrivningsloven_par44a::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par44a_par44b_juridisk_vejledning--
----
§ 44 A. Udgifter afholdt til kunstnerisk udsmykning af erhvervsmæssigt
benyttede bygninger, bortset fra en- eller tofamiliehuse og bortset fra den del
af en bygning, der anvendes til beboelse, jf. § 14, stk. 2, nr. 4, kan fra og
med anskaffelsesåret afskrives med indtil 3 pct. årligt af anskaffelsessummen
for den kunstneriske udsmykning. Hvis den kunstneriske udsmykning er anskaffet
før den 1. januar 2023, kan afskrivning efter 1. pkt. dog ske med indtil 4 pct.
årligt af anskaffelsessummen. Det er en betingelse for afskrivningsretten, at
den kunstneriske udsmykning indføjes i bygningen eller dens nære omgivelser.
Afskrivningsretten kan ikke udnyttes af skattepligtige, der på købstidspunktet
er nærtstående til kunstneren, eller af selskaber, som kunstneren selv eller
kunstnerens nærtstående udøver en bestemmende indflydelse over, jf.
ligningslovens § 2, stk. 2. Som nærtstående anses ægtefælle, forældre og
bedsteforældre samt børn og børnebørn og disses ægtefæller eller dødsboer efter
disse personer. Stedbarns- og adoptivforhold sidestilles med naturligt
slægtskabsforhold.

Stk. 2. Udgifter til kunstnerisk udsmykning, der kan afskrives efter andre
bestemmelser i denne lov, kan ikke afskrives efter stk. 1.

Stk. 3. Afskrivning efter stk. 1 kan alene ske for førstegangskøb af original
billedkunst. I tilfælde af tvivl om, hvorvidt den kunstneriske udsmykning kan
kvalificeres som kunst, indhenter told- og skatteforvaltningen en vurdering af
den kunstneriske udsmykning fra Akademiraadet.

Stk. 4. Udgifterne til kunstnerisk udsmykning afskrives særskilt for den enkelte
kunstneriske udsmykning.

Stk. 5. Såfremt den kunstneriske udsmykning fjernes fra den bygning, den er
indføjet i eller knytter sig til efter stk. 1, 3. pkt., sidestilles dette med
salg efter stk. 9.

Stk. 6. Afskrivninger kan ikke foretages i det indkomstår, hvor den
kunstneriske udsmykning sælges, nedrives eller bortskaffes på anden vis. Ophører
bygningen, den kunstneriske udsmykning er indføjet i eller knytter sig til efter
stk. 1, 3. pkt., med udelukkende at være anvendt erhvervsmæssigt, bortfalder
afskrivningsretten, fra og med det indkomstår, hvor den rent erhvervsmæssige
benyttelse ophører.

Stk. 7. Hvis der sker en skade på den kunstneriske udsmykning, der ikke kan
udbedres ved normal vedligeholdelse, reguleres afskrivningen af den kunstneriske
udsmykning efter reglerne i § 23.

Stk. 8. Såfremt den skattepligtige ved en skade på den kunstneriske udsmykning
har modtaget en erstatnings- eller forsikringssum og foretager genopførelse af
den kunstneriske udsmykning anvendes reglerne i § 24, stk. 1-5.

Stk. 9. Fortjeneste eller tab ved salg af den kunstneriske udsmykning medregnes
i den skattepligtige indkomst for salgsåret efter reglerne i § 21, stk. 2, 1.
og 2. pkt., og stk. 3 og 5. Nedrivning af bygningen, hvor den kunstneriske
udsmykning indgår, og ophør med udelukkende erhvervsmæssig anvendelse af
bygningen samt andre former for ophør af den kunstneriske udsmykning
sidestilles med salg efter 1. pkt.

Stk. 10. Ved køb af en kunstnerisk udsmykning, der kan afskrives efter stk. 1,
kan køber afskrive på anskaffelsessummen for den kunstneriske udsmykning efter
denne bestemmelse, såfremt den kunstneriske udsmykning købes sammen med den
bygning, den kunstneriske udsmykning er indføjet i eller knytter sig til efter
stk. 1, 3. pkt.
----

--@begin:afskrivningsloven_par44a--
# Afskrivningslov44ABygningsdel = Al44AErhvervsbygning | Al44AEnEllerTofamiliehus | Al44ABeboelsesdel
# Afskrivningslov44APlacering = Al44AIndføjetIBygningen | Al44AIndføjetINæreOmgivelser | Al44AIkkeIndføjet
# Afskrivningslov44AAnskaffelsesmåde = Al44AFørstegangskøbAfOriginalBilledkunst | Al44AKøbtSammenMedBygningen | Al44AAndetKøb
# Afskrivningslov44AKunststatus = Al44AKunstKvalificeret | Al44AKunstGodkendtAfAkademiraadet | Al44AKunstAfvistAfAkademiraadet | Al44AKunstUafklaret
# Afskrivningslov44APosition(skatteyder: AfskrivningslovSkatteyder, identifikation: Tekst, anskaffelsesår: Heltal, anskaffelsessum_kroner: Heltal, afskrivningsgrundlag_kroner: Heltal, bygningsdel: Afskrivningslov44ABygningsdel, placering: Afskrivningslov44APlacering, anskaffelsesmåde: Afskrivningslov44AAnskaffelsesmåde, kunststatus: Afskrivningslov44AKunststatus, skatteyder_nærtstående_til_kunstneren: Boolsk, kunstner_eller_nærtstående_har_bestemmende_indflydelse: Boolsk, kan_afskrives_efter_anden_bestemmelse: Boolsk, tidligere_afskrivninger: List(AfskrivningslovÅrsafskrivning))
# Afskrivningslov44AÅrsInput(indkomstår: Heltal, position: Afskrivningslov44APosition, bygningen_udelukkende_erhvervsmæssigt_benyttet_i_året: Boolsk, afståelse_nedrivning_eller_anden_bortskaffelse_i_året: Boolsk, valgt_afskrivning_kroner: Heltal)
# Afskrivningslov44AÅrsResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, identifikation: Tekst, position_gyldig: Boolsk, omfattet_af_par44a: Boolsk, højeste_sats_basispoint: Heltal, resterende_afskrivningsgrundlag_før_året_kroner: Heltal, højeste_afskrivning_kroner: Heltal, valgt_afskrivning_kroner: Heltal, valg_gyldigt: Boolsk, afskrivning_i_skattepligtig_indkomst_kroner: Heltal, afskrivningsret_bortfaldet_i_året: Boolsk, position_efter: Afskrivningslov44APosition)
# Afskrivningslov44AAfståelseshændelse = Al44AOrdinærtSalg | Al44AFjernetFraBygningEllerNæreOmgivelser | Al44ABygningNedrevet | Al44AOphørMedUdelukkendeErhvervsmæssigAnvendelse | Al44AAndenBortskaffelse
# Afskrivningslov44AAfståelsesInput(indkomstår: Heltal, position: Afskrivningslov44APosition, hændelse: Afskrivningslov44AAfståelseshændelse, afståelsessum_eller_handelsværdi_kroner: Heltal, kontrol: Afskrivningslov21Kontrol)
# Afskrivningslov44AAfståelsesResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, identifikation: Tekst, hændelse: Afskrivningslov44AAfståelseshændelse, position_gyldig: Boolsk, sidestillet_med_salg: Boolsk, afskrivning_i_afståelsesåret_afskåret: Boolsk, afståelsessum_kroner: Heltal, afskrivningsgrundlag_kroner: Heltal, samlede_foretagne_afskrivninger_kroner: Heltal, nedskrevet_værdi_kroner: Heltal, beregnet_fortjeneste_kroner: Heltal, skattepligtige_genvundne_afskrivninger_kroner: Heltal, beregnet_tab_kroner: Heltal, bestemmende_indflydelse: Boolsk, tab_afskåret_efter_par21_stk5_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal)

| afskrivningslov44a_bygningsdel_omfattet(bygningsdel: Afskrivningslov44ABygningsdel) -> bygningsdel == Al44AErhvervsbygning
| afskrivningslov44a_placering_omfattet(placering: Afskrivningslov44APlacering) -> placering == Al44AIndføjetIBygningen || placering == Al44AIndføjetINæreOmgivelser
| afskrivningslov44a_anskaffelsesmåde_omfattet(måde: Afskrivningslov44AAnskaffelsesmåde) -> måde == Al44AFørstegangskøbAfOriginalBilledkunst || måde == Al44AKøbtSammenMedBygningen
| afskrivningslov44a_kunst_kvalificeret(status: Afskrivningslov44AKunststatus) -> status == Al44AKunstKvalificeret || status == Al44AKunstGodkendtAfAkademiraadet
| afskrivningslov44a_højeste_sats_basispoint(anskaffelsesår: Heltal) -> hvis anskaffelsesår < 2023 { 400 } ellers { 300 }
| afskrivningslov44a_position_gyldig(position: Afskrivningslov44APosition, før_indkomstår: Heltal) -> position.identifikation != "" && position.anskaffelsesår > 0 && position.anskaffelsesår <= før_indkomstår && position.anskaffelsessum_kroner > 0 && position.afskrivningsgrundlag_kroner > 0 && position.afskrivningsgrundlag_kroner <= position.anskaffelsessum_kroner && afskrivningslov_årsafskrivninger_gyldige(position.tidligere_afskrivninger, position.anskaffelsesår, før_indkomstår) && afskrivningslov_samlede_årsafskrivninger_kroner(position.tidligere_afskrivninger) <= position.afskrivningsgrundlag_kroner
| afskrivningslov44a_omfattet(position: Afskrivningslov44APosition, før_indkomstår: Heltal) -> afskrivningslov44a_position_gyldig(position, før_indkomstår) && afskrivningslov44a_bygningsdel_omfattet(position.bygningsdel) && afskrivningslov44a_placering_omfattet(position.placering) && afskrivningslov44a_anskaffelsesmåde_omfattet(position.anskaffelsesmåde) && afskrivningslov44a_kunst_kvalificeret(position.kunststatus) && position.skatteyder_nærtstående_til_kunstneren == Falskt && position.kunstner_eller_nærtstående_har_bestemmende_indflydelse == Falskt && position.kan_afskrives_efter_anden_bestemmelse == Falskt

# Afskrivningslov44AÅrsSag(input: Afskrivningslov44AÅrsInput) {
    | position() -> input.position
    | position_gyldig() -> afskrivningslov44a_position_gyldig(position(), input.indkomstår)
    | grundbetingelser_opfyldt() -> afskrivningslov44a_omfattet(position(), input.indkomstår)
    | afskrivningsret_bortfaldet_i_året() -> input.afståelse_nedrivning_eller_anden_bortskaffelse_i_året || input.bygningen_udelukkende_erhvervsmæssigt_benyttet_i_året == Falskt
    | omfattet_af_par44a() -> grundbetingelser_opfyldt() && afskrivningsret_bortfaldet_i_året() == Falskt
    | tidligere_afskrivninger_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | resterende_kroner() -> hvis position_gyldig() { penge_positivt_beløb(position().afskrivningsgrundlag_kroner - tidligere_afskrivninger_kroner()) } ellers { 0 }
    | højeste_sats_basispoint() -> afskrivningslov44a_højeste_sats_basispoint(position().anskaffelsesår)
    | højeste_afskrivning_kroner() -> hvis omfattet_af_par44a() { penge_mindste_beløb(resterende_kroner(), penge_beløb_gange_basispoint_kroner(position().afskrivningsgrundlag_kroner, højeste_sats_basispoint())) } ellers { 0 }
    | valg_gyldigt() -> omfattet_af_par44a() && input.valgt_afskrivning_kroner >= 0 && input.valgt_afskrivning_kroner <= højeste_afskrivning_kroner()
    | afskrivning_kroner() -> hvis valg_gyldigt() { input.valgt_afskrivning_kroner } ellers { 0 }
    | position_efter() -> hvis afskrivning_kroner() > 0 { Afskrivningslov44APosition(skatteyder = position().skatteyder, identifikation = position().identifikation, anskaffelsesår = position().anskaffelsesår, anskaffelsessum_kroner = position().anskaffelsessum_kroner, afskrivningsgrundlag_kroner = position().afskrivningsgrundlag_kroner, bygningsdel = position().bygningsdel, placering = position().placering, anskaffelsesmåde = position().anskaffelsesmåde, kunststatus = position().kunststatus, skatteyder_nærtstående_til_kunstneren = position().skatteyder_nærtstående_til_kunstneren, kunstner_eller_nærtstående_har_bestemmende_indflydelse = position().kunstner_eller_nærtstående_har_bestemmende_indflydelse, kan_afskrives_efter_anden_bestemmelse = position().kan_afskrives_efter_anden_bestemmelse, tidligere_afskrivninger = concat(position().tidligere_afskrivninger, [AfskrivningslovÅrsafskrivning(indkomstår = input.indkomstår, afskrivning_kroner = afskrivning_kroner())])) } ellers { position() }
    | resultat() -> Afskrivningslov44AÅrsResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, identifikation = position().identifikation, position_gyldig = position_gyldig(), omfattet_af_par44a = omfattet_af_par44a(), højeste_sats_basispoint = højeste_sats_basispoint(), resterende_afskrivningsgrundlag_før_året_kroner = resterende_kroner(), højeste_afskrivning_kroner = højeste_afskrivning_kroner(), valgt_afskrivning_kroner = input.valgt_afskrivning_kroner, valg_gyldigt = valg_gyldigt(), afskrivning_i_skattepligtig_indkomst_kroner = afskrivning_kroner(), afskrivningsret_bortfaldet_i_året = afskrivningsret_bortfaldet_i_året(), position_efter = position_efter())
}
| afskrivningslov44a_års_sag(input: Afskrivningslov44AÅrsInput) -> Afskrivningslov44AÅrsSag(input)
| afskrivningslov44a_års_resultat(input: Afskrivningslov44AÅrsInput) -> afskrivningslov44a_års_sag(input).resultat()

# Afskrivningslov44AAfståelsesSag(input: Afskrivningslov44AAfståelsesInput) {
    | position() -> input.position
    | position_gyldig() -> afskrivningslov44a_position_gyldig(position(), input.indkomstår)
    | omfattet_af_par44a() -> afskrivningslov44a_omfattet(position(), input.indkomstår)
    | afståelsessum_kroner() -> penge_positivt_beløb(input.afståelsessum_eller_handelsværdi_kroner)
    | foretagne_afskrivninger_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | nedskrevet_værdi_kroner() -> hvis position_gyldig() { penge_positivt_beløb(position().afskrivningsgrundlag_kroner - foretagne_afskrivninger_kroner()) } ellers { 0 }
    | fortjeneste_kroner() -> hvis omfattet_af_par44a() { penge_positivt_beløb(afståelsessum_kroner() - nedskrevet_værdi_kroner()) } ellers { 0 }
    | genvundne_afskrivninger_kroner() -> penge_mindste_beløb(fortjeneste_kroner(), foretagne_afskrivninger_kroner())
    | tab_før_kontrol_kroner() -> hvis omfattet_af_par44a() { penge_positivt_beløb(nedskrevet_værdi_kroner() - afståelsessum_kroner()) } ellers { 0 }
    | bestemmende_indflydelse() -> afskrivningslov21_bestemmende_indflydelse(input.kontrol)
    | tab_afskåret_kroner() -> hvis bestemmende_indflydelse() { tab_før_kontrol_kroner() } ellers { 0 }
    | fradragsberettiget_tab_kroner() -> hvis bestemmende_indflydelse() { 0 } ellers { tab_før_kontrol_kroner() }
    | resultat() -> Afskrivningslov44AAfståelsesResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, identifikation = position().identifikation, hændelse = input.hændelse, position_gyldig = position_gyldig(), sidestillet_med_salg = omfattet_af_par44a(), afskrivning_i_afståelsesåret_afskåret = omfattet_af_par44a(), afståelsessum_kroner = afståelsessum_kroner(), afskrivningsgrundlag_kroner = position().afskrivningsgrundlag_kroner, samlede_foretagne_afskrivninger_kroner = foretagne_afskrivninger_kroner(), nedskrevet_værdi_kroner = nedskrevet_værdi_kroner(), beregnet_fortjeneste_kroner = fortjeneste_kroner(), skattepligtige_genvundne_afskrivninger_kroner = genvundne_afskrivninger_kroner(), beregnet_tab_kroner = tab_før_kontrol_kroner(), bestemmende_indflydelse = bestemmende_indflydelse(), tab_afskåret_efter_par21_stk5_kroner = tab_afskåret_kroner(), fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner())
}
| afskrivningslov44a_afståelses_sag(input: Afskrivningslov44AAfståelsesInput) -> Afskrivningslov44AAfståelsesSag(input)
| afskrivningslov44a_afståelses_resultat(input: Afskrivningslov44AAfståelsesInput) -> afskrivningslov44a_afståelses_sag(input).resultat()

# Afskrivningslov44ASkadeInput(indkomstår: Heltal, position: Afskrivningslov44APosition, skade_som_ikke_kan_udbedres_ved_normal_vedligeholdelse: Boolsk, værdi_umiddelbart_før_skaden_kroner: Heltal, værdi_efter_skaden_kroner: Heltal, udgift_til_udbedring_kroner: Heltal)
# Afskrivningslov44ASkadeResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, identifikation: Tekst, position_gyldig: Boolsk, par23_finder_anvendelse: Boolsk, værdiforhold_basispoint: Heltal, afskrivningsgrundlag_før_skade_kroner: Heltal, afskrivningsgrundlag_efter_skade_kroner: Heltal, nedskrevet_værdi_før_skade_kroner: Heltal, nedskrevet_værdi_efter_skade_kroner: Heltal, fradragsberettiget_værdiforringelse_kroner: Heltal, udgift_til_udbedring_kroner: Heltal, udbedringsudgift_henvises_til_par18_stk1: Boolsk, position_efter: Afskrivningslov44APosition)
# Afskrivningslov44AGenopførelseInput(position_før_skade: Afskrivningslov44APosition, par44a_forsikringsafståelse: Afskrivningslov44AAfståelsesResultat, modtaget_erstatnings_eller_forsikringssum_kroner: Heltal, genopførelse_foretages: Boolsk, genopførelsesudgift_kroner: Heltal, skadeår: Heltal, erstatningssum_endeligt_fastsat_år: Heltal, genopførelsesår: Heltal, frist: Afskrivningslov24Frist)
# Afskrivningslov44AGenopførelseResultat(skatteyder: AfskrivningslovSkatteyder, identifikation: Tekst, forsikringsafståelse_matcher: Boolsk, seneste_genopførelsesår: Heltal, rettidig_genopførelse: Boolsk, par24_stk1_til_stk5_finder_anvendelse: Boolsk, genvundne_afskrivninger_udskudt_kroner: Heltal, forskelsbeløb_forsikringssum_over_genopførelsesudgift_kroner: Heltal, forskelsbeløb_fragår_i_afskrivningsgrundlaget_kroner: Heltal, forskelsbeløb_anses_som_foretaget_afskrivning_kroner: Heltal, skattepligtigt_overskydende_forskelsbeløb_kroner: Heltal, overskydende_genopførelsesudgift_kroner: Heltal, videreført_afskrivningsgrundlag_kroner: Heltal, videreførte_foretagne_afskrivninger_kroner: Heltal, samlet_afskrivningsgrundlag_efter_genopførelse_kroner: Heltal)

| afskrivningslov44a_skaleret_årsafskrivning(post: AfskrivningslovÅrsafskrivning, værdi_efter_skaden_kroner: Heltal, værdi_før_skaden_kroner: Heltal) -> AfskrivningslovÅrsafskrivning(indkomstår = post.indkomstår, afskrivning_kroner = afskrivningslov_beløb_gange_forhold_afrundet_kroner(post.afskrivning_kroner, værdi_efter_skaden_kroner, værdi_før_skaden_kroner))

# Afskrivningslov44ASkadeSag(input: Afskrivningslov44ASkadeInput) {
    | position() -> input.position
    | position_gyldig() -> afskrivningslov44a_position_gyldig(position(), input.indkomstår)
    | værdier_gyldige() -> input.værdi_umiddelbart_før_skaden_kroner > 0 && input.værdi_efter_skaden_kroner >= 0 && input.værdi_efter_skaden_kroner < input.værdi_umiddelbart_før_skaden_kroner
    | par23_finder_anvendelse() -> afskrivningslov44a_omfattet(position(), input.indkomstår) && input.skade_som_ikke_kan_udbedres_ved_normal_vedligeholdelse && værdier_gyldige()
    | foretagne_afskrivninger_før_kroner() -> afskrivningslov_samlede_årsafskrivninger_kroner(position().tidligere_afskrivninger)
    | nedskrevet_værdi_før_kroner() -> hvis position_gyldig() { penge_positivt_beløb(position().afskrivningsgrundlag_kroner - foretagne_afskrivninger_før_kroner()) } ellers { 0 }
    | værdiforhold_basispoint() -> hvis par23_finder_anvendelse() { input.værdi_efter_skaden_kroner * 10000 / input.værdi_umiddelbart_før_skaden_kroner } ellers { 0 }
    | afskrivningsgrundlag_efter_kroner() -> hvis par23_finder_anvendelse() { afskrivningslov_beløb_gange_forhold_afrundet_kroner(position().afskrivningsgrundlag_kroner, input.værdi_efter_skaden_kroner, input.værdi_umiddelbart_før_skaden_kroner) } ellers { 0 }
    | nedskrevet_værdi_efter_kroner() -> hvis par23_finder_anvendelse() { afskrivningslov_beløb_gange_forhold_afrundet_kroner(nedskrevet_værdi_før_kroner(), input.værdi_efter_skaden_kroner, input.værdi_umiddelbart_før_skaden_kroner) } ellers { 0 }
    | fradragsberettiget_værdiforringelse_kroner() -> hvis par23_finder_anvendelse() { penge_positivt_beløb(nedskrevet_værdi_før_kroner() - nedskrevet_værdi_efter_kroner()) } ellers { 0 }
    | skaleret_historik() -> hvis par23_finder_anvendelse() { map(position().tidligere_afskrivninger, |post: AfskrivningslovÅrsafskrivning| afskrivningslov44a_skaleret_årsafskrivning(post, input.værdi_efter_skaden_kroner, input.værdi_umiddelbart_før_skaden_kroner)) } ellers { position().tidligere_afskrivninger }
    | position_efter() -> hvis par23_finder_anvendelse() { Afskrivningslov44APosition(skatteyder = position().skatteyder, identifikation = position().identifikation, anskaffelsesår = position().anskaffelsesår, anskaffelsessum_kroner = position().anskaffelsessum_kroner, afskrivningsgrundlag_kroner = afskrivningsgrundlag_efter_kroner(), bygningsdel = position().bygningsdel, placering = position().placering, anskaffelsesmåde = position().anskaffelsesmåde, kunststatus = position().kunststatus, skatteyder_nærtstående_til_kunstneren = position().skatteyder_nærtstående_til_kunstneren, kunstner_eller_nærtstående_har_bestemmende_indflydelse = position().kunstner_eller_nærtstående_har_bestemmende_indflydelse, kan_afskrives_efter_anden_bestemmelse = position().kan_afskrives_efter_anden_bestemmelse, tidligere_afskrivninger = skaleret_historik()) } ellers { position() }
    | resultat() -> Afskrivningslov44ASkadeResultat(indkomstår = input.indkomstår, skatteyder = position().skatteyder, identifikation = position().identifikation, position_gyldig = position_gyldig(), par23_finder_anvendelse = par23_finder_anvendelse(), værdiforhold_basispoint = værdiforhold_basispoint(), afskrivningsgrundlag_før_skade_kroner = position().afskrivningsgrundlag_kroner, afskrivningsgrundlag_efter_skade_kroner = afskrivningsgrundlag_efter_kroner(), nedskrevet_værdi_før_skade_kroner = nedskrevet_værdi_før_kroner(), nedskrevet_værdi_efter_skade_kroner = nedskrevet_værdi_efter_kroner(), fradragsberettiget_værdiforringelse_kroner = fradragsberettiget_værdiforringelse_kroner(), udgift_til_udbedring_kroner = penge_positivt_beløb(input.udgift_til_udbedring_kroner), udbedringsudgift_henvises_til_par18_stk1 = par23_finder_anvendelse() && input.udgift_til_udbedring_kroner > 0, position_efter = position_efter())
}
| afskrivningslov44a_skade_sag(input: Afskrivningslov44ASkadeInput) -> Afskrivningslov44ASkadeSag(input)
| afskrivningslov44a_skade_resultat(input: Afskrivningslov44ASkadeInput) -> afskrivningslov44a_skade_sag(input).resultat()

# Afskrivningslov44AGenopførelseSag(input: Afskrivningslov44AGenopførelseInput) {
    | position() -> input.position_før_skade
    | afståelse() -> input.par44a_forsikringsafståelse
    | forsikringssum_kroner() -> penge_positivt_beløb(input.modtaget_erstatnings_eller_forsikringssum_kroner)
    | genopførelsesudgift_kroner() -> penge_positivt_beløb(input.genopførelsesudgift_kroner)
    | forsikringsafståelse_matcher() -> afståelse().position_gyldig && afståelse().skatteyder == position().skatteyder && afståelse().identifikation == position().identifikation && afståelse().indkomstår == input.skadeår && afståelse().afståelsessum_kroner == forsikringssum_kroner()
    | seneste_genopførelsesår() -> match input.frist {
        | Al24OrdinærFrist -> afskrivningslov24_ordinært_seneste_genopførelsesår(input.skadeår, input.erstatningssum_endeligt_fastsat_år)
        | Al24ForlængetFrist(seneste_genopførelsesår) -> penge_største_beløb(afskrivningslov24_ordinært_seneste_genopførelsesår(input.skadeår, input.erstatningssum_endeligt_fastsat_år), seneste_genopførelsesår)
    }
    | rettidig_genopførelse() -> input.genopførelse_foretages && genopførelsesudgift_kroner() > 0 && input.genopførelsesår >= input.skadeår && input.genopførelsesår <= seneste_genopførelsesår()
    | par24_finder_anvendelse() -> forsikringsafståelse_matcher() && rettidig_genopførelse()
    | forskelsbeløb_kroner() -> hvis par24_finder_anvendelse() { penge_positivt_beløb(forsikringssum_kroner() - genopførelsesudgift_kroner()) } ellers { 0 }
    | overskydende_genopførelsesudgift_kroner() -> hvis par24_finder_anvendelse() { penge_positivt_beløb(genopførelsesudgift_kroner() - forsikringssum_kroner()) } ellers { 0 }
    | skattepligtigt_overskydende_forskelsbeløb_kroner() -> hvis par24_finder_anvendelse() { penge_positivt_beløb(forskelsbeløb_kroner() - afståelse().nedskrevet_værdi_kroner) } ellers { 0 }
    | videreført_afskrivningsgrundlag_kroner() -> hvis par24_finder_anvendelse() { penge_positivt_beløb(position().afskrivningsgrundlag_kroner - forskelsbeløb_kroner()) } ellers { 0 }
    | samlet_afskrivningsgrundlag_kroner() -> videreført_afskrivningsgrundlag_kroner() + overskydende_genopførelsesudgift_kroner()
    | resultat() -> Afskrivningslov44AGenopførelseResultat(skatteyder = position().skatteyder, identifikation = position().identifikation, forsikringsafståelse_matcher = forsikringsafståelse_matcher(), seneste_genopførelsesår = seneste_genopførelsesår(), rettidig_genopførelse = rettidig_genopførelse(), par24_stk1_til_stk5_finder_anvendelse = par24_finder_anvendelse(), genvundne_afskrivninger_udskudt_kroner = hvis par24_finder_anvendelse() { afståelse().skattepligtige_genvundne_afskrivninger_kroner } ellers { 0 }, forskelsbeløb_forsikringssum_over_genopførelsesudgift_kroner = forskelsbeløb_kroner(), forskelsbeløb_fragår_i_afskrivningsgrundlaget_kroner = forskelsbeløb_kroner(), forskelsbeløb_anses_som_foretaget_afskrivning_kroner = forskelsbeløb_kroner(), skattepligtigt_overskydende_forskelsbeløb_kroner = skattepligtigt_overskydende_forskelsbeløb_kroner(), overskydende_genopførelsesudgift_kroner = overskydende_genopførelsesudgift_kroner(), videreført_afskrivningsgrundlag_kroner = videreført_afskrivningsgrundlag_kroner(), videreførte_foretagne_afskrivninger_kroner = afståelse().samlede_foretagne_afskrivninger_kroner, samlet_afskrivningsgrundlag_efter_genopførelse_kroner = samlet_afskrivningsgrundlag_kroner())
}
| afskrivningslov44a_genopførelse_sag(input: Afskrivningslov44AGenopførelseInput) -> Afskrivningslov44AGenopførelseSag(input)
| afskrivningslov44a_genopførelse_resultat(input: Afskrivningslov44AGenopførelseInput) -> afskrivningslov44a_genopførelse_sag(input).resultat()
--@end:afskrivningsloven_par44a--

--@label:afskrivningsloven_par44b::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par44a_par44b_juridisk_vejledning::parameter_source:afskrivningsloven_2026_satser--
----
§ 44 B. Udgifter afholdt til kunstnerisk udsmykning, der ophænges eller
opstilles i erhvervsmæssigt benyttede bygninger, bortset fra en- eller
tofamiliehuse og bortset fra den del af en bygning, der anvendes til beboelse,
jf. § 14, stk. 2, nr. 4, kan afskrives efter reglerne i kapitel 2. Dog finder
reglerne om delvis erhvervsmæssigt benyttede driftsmidler og skibe i §§ 11-13
ikke anvendelse. Udgifterne skal endvidere afskrives på en særskilt saldo.
Afskrivningsretten kan ikke udnyttes af skattepligtige, der er nærtstående til
kunstneren, eller af selskaber, som kunstneren selv eller kunstnerens
nærtstående udøver en bestemmende indflydelse over, jf. ligningslovens § 2,
stk. 2. Som nærtstående anses ægtefælle, forældre og bedsteforældre samt børn og
børnebørn og disses ægtefæller eller dødsboer efter disse personer. Stedbarns-
og adoptivforhold sidestilles med naturligt slægtskabsforhold.

Stk. 2. Udgifter til kunstnerisk udsmykning, der kan afskrives efter andre
bestemmelser i denne lov, kan ikke afskrives efter stk. 1.

Stk. 3. Afskrivning efter stk. 1 kan alene ske for førstegangskøb af original
billedkunst. I tilfælde af tvivl om, hvorvidt den kunstneriske udsmykning kan
kvalificeres som kunst, indhenter told- og skatteforvaltningen en vurdering af
den kunstneriske udsmykning fra Akademiraadet.

Stk. 4. Ophører bygningen, hvori den kunstneriske udsmykning er ophængt eller
opstillet, med at være anvendt erhvervsmæssigt, anses den kunstneriske
udsmykning for at være solgt.
----

--@begin:afskrivningsloven_par44b--
# Afskrivningslov44BHændelse = Al44BOrdinærtIndkomstår | Al44BOrdinærtSalg(salgssum_kroner: Heltal) | Al44BBygningOphørerMedErhvervsmæssigAnvendelse(handelsværdi_kroner: Heltal)
# Afskrivningslov44BInput(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, bygningsdel: Afskrivningslov44ABygningsdel, kunststatus: Afskrivningslov44AKunststatus, førstegangskøb_af_original_billedkunst: Boolsk, ophængt_eller_opstillet_i_erhvervsmæssigt_benyttet_bygning: Boolsk, skatteyder_nærtstående_til_kunstneren: Boolsk, kunstner_eller_nærtstående_har_bestemmende_indflydelse: Boolsk, kan_afskrives_efter_anden_bestemmelse: Boolsk, særskilt_saldoværdi_primo_kroner: Heltal, anskaffelsessummer_i_året_kroner: Heltal, hændelse: Afskrivningslov44BHændelse, valg: Afskrivningslov5Valg, årsparametre: AfskrivningslovÅrsparametre, negativ_saldo_medregnes_i_indkomståret: Boolsk)
# Afskrivningslov44BResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, omfattet_af_par44b: Boolsk, kapitel2_finder_anvendelse: Boolsk, par11_til_par13_finder_ikke_anvendelse: Boolsk, særskilt_saldo: Boolsk, bygningens_erhvervsophør_sidestilles_med_salg: Boolsk, salgssum_eller_handelsværdi_kroner: Heltal, saldoværdi_før_afskrivning_kroner: Heltal, afskrivningsberettiget_saldoværdi_kroner: Heltal, højeste_ordinære_afskrivning_kroner: Heltal, valg: Afskrivningslov5Valg, valg_gyldigt: Boolsk, afskrivning_i_skattepligtig_indkomst_kroner: Heltal, negativ_saldo_kroner: Heltal, skattepligtig_negativ_saldo_i_indkomståret_kroner: Heltal, negativ_saldo_til_udligning_eller_næste_indkomstår_kroner: Heltal, særskilt_saldoværdi_efter_kroner: Heltal)

| afskrivningslov44b_hændelsessalg_kroner(hændelse: Afskrivningslov44BHændelse) -> match hændelse {
    | Al44BOrdinærtIndkomstår -> 0
    | Al44BOrdinærtSalg(salgssum_kroner) -> penge_positivt_beløb(salgssum_kroner)
    | Al44BBygningOphørerMedErhvervsmæssigAnvendelse(handelsværdi_kroner) -> penge_positivt_beløb(handelsværdi_kroner)
}
| afskrivningslov44b_er_bygningsophør(hændelse: Afskrivningslov44BHændelse) -> match hændelse {
    | Al44BBygningOphørerMedErhvervsmæssigAnvendelse(_) -> Sandt
    | _ -> Falskt
}

# Afskrivningslov44BSag(input: Afskrivningslov44BInput) {
    | årsparametre_matcher() -> input.indkomstår == input.årsparametre.indkomstår
    | grundbetingelser_opfyldt() -> input.indkomstår > 0 && input.særskilt_saldoværdi_primo_kroner >= 0 && input.anskaffelsessummer_i_året_kroner >= 0 && afskrivningslov44a_bygningsdel_omfattet(input.bygningsdel) && input.ophængt_eller_opstillet_i_erhvervsmæssigt_benyttet_bygning && input.førstegangskøb_af_original_billedkunst && afskrivningslov44a_kunst_kvalificeret(input.kunststatus) && input.skatteyder_nærtstående_til_kunstneren == Falskt && input.kunstner_eller_nærtstående_har_bestemmende_indflydelse == Falskt && input.kan_afskrives_efter_anden_bestemmelse == Falskt
    | omfattet_af_par44b() -> grundbetingelser_opfyldt() && årsparametre_matcher()
    | salgssum_kroner() -> afskrivningslov44b_hændelsessalg_kroner(input.hændelse)
    | saldoværdi_før_afskrivning_kroner() -> input.særskilt_saldoværdi_primo_kroner + penge_positivt_beløb(input.anskaffelsessummer_i_året_kroner) - salgssum_kroner()
    | positiv_saldo_kroner() -> penge_positivt_beløb(saldoværdi_før_afskrivning_kroner())
    | valgt_sats_basispoint() -> afskrivningslov5_valgt_ordinær_sats_basispoint(input.valg)
    | valg_gyldigt() -> match input.valg {
        | Al5IngenAfskrivning -> omfattet_af_par44b()
        | Al5OrdinærAfskrivning(sats_basispoint) -> omfattet_af_par44b() && sats_basispoint >= 0 && sats_basispoint <= input.årsparametre.højeste_ordinære_sats_basispoint
        | Al5FuldRestsaldo -> omfattet_af_par44b() && positiv_saldo_kroner() > 0 && positiv_saldo_kroner() <= input.årsparametre.småsaldigrænse_kroner
    }
    | afskrivning_kroner() -> 0
    | exception al44b_kapitel2_ordinær_saldoafskrivning afskrivning_kroner() -> penge_beløb_gange_basispoint_kroner(positiv_saldo_kroner(), valgt_sats_basispoint()) under valg_gyldigt() && valgt_sats_basispoint() > 0
    | exception al44b_kapitel2_fuld_småsaldofradrag afskrivning_kroner() -> positiv_saldo_kroner() under valg_gyldigt() && input.valg == Al5FuldRestsaldo
    | negativ_saldo_kroner() -> hvis omfattet_af_par44b() { afskrivningslov_negativt_saldobeløb_kroner(saldoværdi_før_afskrivning_kroner()) } ellers { 0 }
    | skattepligtig_negativ_saldo_kroner() -> hvis input.negativ_saldo_medregnes_i_indkomståret { negativ_saldo_kroner() } ellers { 0 }
    | negativ_saldo_til_næste_år_kroner() -> hvis input.negativ_saldo_medregnes_i_indkomståret { 0 } ellers { negativ_saldo_kroner() }
    | saldo_efter_kroner() -> hvis negativ_saldo_kroner() > 0 { 0 - negativ_saldo_til_næste_år_kroner() } ellers { positiv_saldo_kroner() - afskrivning_kroner() }
    | resultat() -> Afskrivningslov44BResultat(indkomstår = input.indkomstår, skatteyder = input.skatteyder, omfattet_af_par44b = omfattet_af_par44b(), kapitel2_finder_anvendelse = omfattet_af_par44b(), par11_til_par13_finder_ikke_anvendelse = omfattet_af_par44b(), særskilt_saldo = omfattet_af_par44b(), bygningens_erhvervsophør_sidestilles_med_salg = omfattet_af_par44b() && afskrivningslov44b_er_bygningsophør(input.hændelse), salgssum_eller_handelsværdi_kroner = salgssum_kroner(), saldoværdi_før_afskrivning_kroner = saldoværdi_før_afskrivning_kroner(), afskrivningsberettiget_saldoværdi_kroner = positiv_saldo_kroner(), højeste_ordinære_afskrivning_kroner = penge_beløb_gange_basispoint_kroner(positiv_saldo_kroner(), input.årsparametre.højeste_ordinære_sats_basispoint), valg = input.valg, valg_gyldigt = valg_gyldigt(), afskrivning_i_skattepligtig_indkomst_kroner = afskrivning_kroner(), negativ_saldo_kroner = negativ_saldo_kroner(), skattepligtig_negativ_saldo_i_indkomståret_kroner = skattepligtig_negativ_saldo_kroner(), negativ_saldo_til_udligning_eller_næste_indkomstår_kroner = negativ_saldo_til_næste_år_kroner(), særskilt_saldoværdi_efter_kroner = saldo_efter_kroner())
}
| afskrivningslov44b_sag(input: Afskrivningslov44BInput) -> Afskrivningslov44BSag(input)
| afskrivningslov44b_resultat(input: Afskrivningslov44BInput) -> afskrivningslov44b_sag(input).resultat()
--@end:afskrivningsloven_par44b--

--@label:afskrivningsloven_par44c::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par44c_juridisk_vejledning--
----
§ 44 C. Sælges eller opgives retten i henhold til en kontrakt om levering af
et skib eller et andet driftsmiddel, der udelukkende eller delvis skal benyttes
erhvervsmæssigt, og hvorpå der, når betingelserne for afskrivning er opfyldt,
kan afskrives efter kapitel 2, medregnes fortjeneste eller tab herved ved
opgørelsen af sælgerens skattepligtige indkomst for det indkomstår, hvori
salget sker. Fortjeneste eller tab opgøres som forskellen mellem
afståelsessummen for retten i henhold til kontrakten og anskaffelsessummen for
denne. Fortjeneste eller tab opgøres uden hensyn til eventuel
forskudsafskrivning på skibet eller driftsmidlet.

Stk. 2. Sælges et skib eller et andet driftsmiddel, der udelukkende eller
delvis skal benyttes erhvervsmæssigt, og hvorpå der, når betingelserne for
afskrivning er opfyldt, kan afskrives efter kapitel 2, men som endnu ikke er
færdiggjort i et sådant omfang, at det kan indgå i driften af sælgerens
virksomhed, medregnes fortjeneste eller tab ved opgørelsen af sælgerens
skattepligtige indkomst for det indkomstår, hvori salget sker. Fortjeneste
eller tab opgøres som forskellen mellem afståelsessummen og anskaffelsessummen
tillagt udgifter til forbedringer. Fortjeneste eller tab opgøres uden hensyn
til eventuel forskudsafskrivning på skibet eller driftsmidlet.
----

--@begin:afskrivningsloven_par44c--
# Afskrivningslov44CGenstand = Al44CRetEfterLeveringskontrakt | Al44CLeveretMenIkkeDriftsklartAktiv
# Afskrivningslov44CInput(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, genstand: Afskrivningslov44CGenstand, skib_eller_andet_driftsmiddel: Boolsk, helt_eller_delvist_erhvervsmæssigt_bestemt: Boolsk, kan_afskrives_efter_kapitel2_når_betingelserne_er_opfyldt: Boolsk, sælges_eller_opgives_i_indkomståret: Boolsk, leveret_til_igangværende_virksomhed: Boolsk, bestemt_til_at_indgå_i_virksomhedens_drift: Boolsk, færdiggjort_til_at_indgå_i_driften: Boolsk, afståelsessum_kroner: Heltal, anskaffelsessum_kroner: Heltal, forbedringsudgifter_kroner: Heltal, forskudsafskrivninger_kroner: Heltal)
# Afskrivningslov44CResultat(indkomstår: Heltal, skatteyder: AfskrivningslovSkatteyder, genstand: Afskrivningslov44CGenstand, input_gyldigt: Boolsk, omfattet_af_par44c: Boolsk, stk2_aktiv_leveret_og_bestemt_men_ikke_driftsklart: Boolsk, afståelsessum_kroner: Heltal, anskaffelsessum_inkl_forbedringer_kroner: Heltal, forskudsafskrivninger_uden_betydning_kroner: Heltal, skattepligtig_fortjeneste_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal)

| afskrivningslov44c_stk2_betingelser(input: Afskrivningslov44CInput) -> input.genstand == Al44CLeveretMenIkkeDriftsklartAktiv && input.leveret_til_igangværende_virksomhed && input.bestemt_til_at_indgå_i_virksomhedens_drift && input.færdiggjort_til_at_indgå_i_driften == Falskt
| afskrivningslov44c_genstandsbetingelser(input: Afskrivningslov44CInput) -> match input.genstand {
    | Al44CRetEfterLeveringskontrakt -> Sandt
    | Al44CLeveretMenIkkeDriftsklartAktiv -> afskrivningslov44c_stk2_betingelser(input)
}
| afskrivningslov44c_anskaffelsessum_inkl_forbedringer_kroner(input: Afskrivningslov44CInput) -> penge_positivt_beløb(input.anskaffelsessum_kroner) + hvis input.genstand == Al44CLeveretMenIkkeDriftsklartAktiv { penge_positivt_beløb(input.forbedringsudgifter_kroner) } ellers { 0 }
| afskrivningslov44c_omfattet(input: Afskrivningslov44CInput) -> input.indkomstår > 0 && input.skib_eller_andet_driftsmiddel && input.helt_eller_delvist_erhvervsmæssigt_bestemt && input.kan_afskrives_efter_kapitel2_når_betingelserne_er_opfyldt && input.sælges_eller_opgives_i_indkomståret && input.afståelsessum_kroner >= 0 && input.anskaffelsessum_kroner >= 0 && input.forbedringsudgifter_kroner >= 0 && input.forskudsafskrivninger_kroner >= 0 && afskrivningslov44c_genstandsbetingelser(input)
| afskrivningslov44c_resultat(input: Afskrivningslov44CInput) -> Afskrivningslov44CResultat(
    indkomstår = input.indkomstår,
    skatteyder = input.skatteyder,
    genstand = input.genstand,
    input_gyldigt = input.indkomstår > 0 && input.afståelsessum_kroner >= 0 && input.anskaffelsessum_kroner >= 0 && input.forbedringsudgifter_kroner >= 0 && input.forskudsafskrivninger_kroner >= 0,
    omfattet_af_par44c = afskrivningslov44c_omfattet(input),
    stk2_aktiv_leveret_og_bestemt_men_ikke_driftsklart = afskrivningslov44c_stk2_betingelser(input),
    afståelsessum_kroner = penge_positivt_beløb(input.afståelsessum_kroner),
    anskaffelsessum_inkl_forbedringer_kroner = afskrivningslov44c_anskaffelsessum_inkl_forbedringer_kroner(input),
    forskudsafskrivninger_uden_betydning_kroner = penge_positivt_beløb(input.forskudsafskrivninger_kroner),
    skattepligtig_fortjeneste_kroner = hvis afskrivningslov44c_omfattet(input) { penge_positivt_beløb(input.afståelsessum_kroner - afskrivningslov44c_anskaffelsessum_inkl_forbedringer_kroner(input)) } ellers { 0 },
    fradragsberettiget_tab_kroner = hvis afskrivningslov44c_omfattet(input) { penge_positivt_beløb(afskrivningslov44c_anskaffelsessum_inkl_forbedringer_kroner(input) - input.afståelsessum_kroner) } ellers { 0 }
)
--@end:afskrivningsloven_par44c--

--@label:afskrivningsloven_par45::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par45_juridisk_vejledning::allocation_guidance:afskrivningsloven_par45_fordeling_juridisk_vejledning--
----
§ 45. Anskaffelses- og salgssummer samt godtgørelser og vederlag for aktiver
omfattet af denne lov omregnes til kontantværdi, der beregnes ved, at den
kontante del af anskaffelsessummen henholdsvis salgssummen lægges sammen med
kursværdien af aktivets gældsposter. Afskrivninger foretages på grundlag af den
således omregnede anskaffelsessum m.v. Medmindre kursen på afståelsestidspunktet
er under 100, omregnes inkonverterbare lån for fiskerfartøjer, der af sælger er
stiftet eller overtaget før den 19. maj 1993, til kurs 100, såfremt lånet er
stiftet eller overtaget til en kurs på 100 eller derunder.

Stk. 2. Ved salg af aktiver omfattet af denne lov skal sælger og køber i
købsaftale, skøde eller på anden skriftlig måde foretage en fordeling af den
samlede kontantomregnede salgssum på de aktiver, der er omfattet af
overdragelsen. Fordelingen skal foretages for driftsmidler, bygninger,
installationer, kunstnerisk udsmykning, goodwill og andre immaterielle aktiver.
For driftsmidler og skibe foretages fordelingen under ét og for øvrige aktiver
på hvert enkelt aktiv. Omfatter overdragelsen grund, bolig, kvote,
betalingsrettighed eller beholdninger, skal fordelingen tillige omfatte disse
aktiver.

Stk. 3. Såvel den samlede kontantomregnede salgssum som den fordeling på aktiver
efter stk. 2, som parterne har aftalt, er undergivet told- og
skatteforvaltningens prøvelse. Afgørelsen er bindende for både sælger og køber.

Stk. 4. Ved enhver ændring af sælgers salgssum for et aktiv som følge af en
ændret skatteansættelse skal købers anskaffelsessum for det pågældende aktiv
ændres tilsvarende. Ved enhver ændring af købers anskaffelsessum for et aktiv,
skal sælgers salgssum for det pågældende aktiv ændres tilsvarende.
----

--@begin:afskrivningsloven_par45--
# Afskrivningslov45Gældspost(identifikation: Tekst, nominelt_beløb_kroner: Heltal, kurs_på_opgørelsestidspunktet_basispoint: Heltal, inkonverterbart_lån_for_fiskerfartøj: Boolsk, stiftet_eller_overtaget_af_sælger_før_1993_05_19: Boolsk, kurs_ved_stiftelse_eller_overtagelse_basispoint: Heltal)
# Afskrivningslov45OmregnetGældspost(identifikation: Tekst, nominelt_beløb_kroner: Heltal, oplyst_kurs_basispoint: Heltal, anvendt_kurs_basispoint: Heltal, særregel_kurs_100_anvendt: Boolsk, kursværdi_kroner: Heltal)
# Afskrivningslov45KontantomregningInput(kontant_del_kroner: Heltal, gældsposter: List(Afskrivningslov45Gældspost), afståelsessituation: Boolsk)
# Afskrivningslov45KontantomregningResultat(input_gyldigt: Boolsk, kontant_del_kroner: Heltal, gældsposter: List(Afskrivningslov45OmregnetGældspost), samlet_kursværdi_af_gældsposter_kroner: Heltal, kontantomregnet_anskaffelses_eller_salgssum_kroner: Heltal, afskrivningsgrundlag_kroner: Heltal)

| afskrivningslov45_gældspost_gyldig(post: Afskrivningslov45Gældspost) -> post.identifikation != "" && post.nominelt_beløb_kroner >= 0 && post.kurs_på_opgørelsestidspunktet_basispoint > 0 && post.kurs_ved_stiftelse_eller_overtagelse_basispoint > 0
| afskrivningslov45_gældspost_unik(poster: List(Afskrivningslov45Gældspost), post: Afskrivningslov45Gældspost) -> foldl(poster, 0, |antal, anden_post| antal + hvis anden_post.identifikation == post.identifikation { 1 } ellers { 0 }) == 1
| afskrivningslov45_fiskerfartøj_kurs100_særregel(input: Afskrivningslov45KontantomregningInput, post: Afskrivningslov45Gældspost) -> input.afståelsessituation && post.inkonverterbart_lån_for_fiskerfartøj && post.stiftet_eller_overtaget_af_sælger_før_1993_05_19 && post.kurs_ved_stiftelse_eller_overtagelse_basispoint <= 10000 && post.kurs_på_opgørelsestidspunktet_basispoint >= 10000
| afskrivningslov45_anvendt_kurs_basispoint(input: Afskrivningslov45KontantomregningInput, post: Afskrivningslov45Gældspost) -> hvis afskrivningslov45_fiskerfartøj_kurs100_særregel(input, post) { 10000 } ellers { post.kurs_på_opgørelsestidspunktet_basispoint }
| afskrivningslov45_omregnet_gældspost(input: Afskrivningslov45KontantomregningInput, post: Afskrivningslov45Gældspost) -> Afskrivningslov45OmregnetGældspost(identifikation = post.identifikation, nominelt_beløb_kroner = post.nominelt_beløb_kroner, oplyst_kurs_basispoint = post.kurs_på_opgørelsestidspunktet_basispoint, anvendt_kurs_basispoint = afskrivningslov45_anvendt_kurs_basispoint(input, post), særregel_kurs_100_anvendt = afskrivningslov45_fiskerfartøj_kurs100_særregel(input, post), kursværdi_kroner = penge_beløb_gange_basispoint_afrundet_kroner(post.nominelt_beløb_kroner, afskrivningslov45_anvendt_kurs_basispoint(input, post)))
| afskrivningslov45_kursværdi_sum_kroner(poster: List(Afskrivningslov45OmregnetGældspost)) -> foldl(poster, 0, |sum, post: Afskrivningslov45OmregnetGældspost| sum + penge_positivt_beløb(post.kursværdi_kroner))
| afskrivningslov45_kontantomregning_resultat(input: Afskrivningslov45KontantomregningInput) -> Afskrivningslov45KontantomregningResultat(
    input_gyldigt = input.kontant_del_kroner >= 0 && all(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_gældspost_gyldig(post) && afskrivningslov45_gældspost_unik(input.gældsposter, post)),
    kontant_del_kroner = penge_positivt_beløb(input.kontant_del_kroner),
    gældsposter = map(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_omregnet_gældspost(input, post)),
    samlet_kursværdi_af_gældsposter_kroner = afskrivningslov45_kursværdi_sum_kroner(map(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_omregnet_gældspost(input, post))),
    kontantomregnet_anskaffelses_eller_salgssum_kroner = hvis input.kontant_del_kroner >= 0 && all(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_gældspost_gyldig(post) && afskrivningslov45_gældspost_unik(input.gældsposter, post)) { input.kontant_del_kroner + afskrivningslov45_kursværdi_sum_kroner(map(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_omregnet_gældspost(input, post))) } ellers { 0 },
    afskrivningsgrundlag_kroner = hvis input.kontant_del_kroner >= 0 && all(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_gældspost_gyldig(post) && afskrivningslov45_gældspost_unik(input.gældsposter, post)) { input.kontant_del_kroner + afskrivningslov45_kursværdi_sum_kroner(map(input.gældsposter, |post: Afskrivningslov45Gældspost| afskrivningslov45_omregnet_gældspost(input, post))) } ellers { 0 }
)

# Afskrivningslov45Aktivkategori = Al45DriftsmidlerOgSkibe | Al45Bygning | Al45Installation | Al45KunstneriskUdsmykning | Al45Goodwill | Al45AndetImmaterieltAktiv | Al45Grund | Al45Bolig | Al45Kvote | Al45Betalingsrettighed | Al45Beholdning
# Afskrivningslov45OverdragetAktiv(kategori: Afskrivningslov45Aktivkategori, identifikation: Tekst)
# Afskrivningslov45Fordelingsnøgle = Al45DriftsmidlerOgSkibeUnderEt | Al45IndividueltAktiv(identifikation: Tekst)
# Afskrivningslov45Fordelingspost(kategori: Afskrivningslov45Aktivkategori, nøgle: Afskrivningslov45Fordelingsnøgle, fordelt_kontantværdi_kroner: Heltal)
# Afskrivningslov45FordelingsInput(kontantomregning: Afskrivningslov45KontantomregningResultat, overdragne_aktiver: List(Afskrivningslov45OverdragetAktiv), fordelingsposter: List(Afskrivningslov45Fordelingspost), skriftligt_aftalt_af_sælger_og_køber: Boolsk)
# Afskrivningslov45FordelingsResultat(kontantomregning_gyldig: Boolsk, overdragne_aktiver_gyldige: Boolsk, fordelingsposter_gyldige: Boolsk, skriftligt_aftalt_af_sælger_og_køber: Boolsk, driftsmidler_og_skibe_fordelt_under_et: Boolsk, øvrige_aktiver_fordelt_individuelt: Boolsk, fordelt_sum_kroner: Heltal, samlet_kontantomregnet_salgssum_kroner: Heltal, fordeling_gyldig: Boolsk, undergivet_told_og_skatteforvaltningens_prøvelse: Boolsk, bindende_for_sælger_og_køber: Boolsk, fordelingsposter: List(Afskrivningslov45Fordelingspost))

| afskrivningslov45_overdraget_aktiv_unikt(aktiver: List(Afskrivningslov45OverdragetAktiv), aktiv: Afskrivningslov45OverdragetAktiv) -> foldl(aktiver, 0, |antal, andet_aktiv| antal + hvis andet_aktiv.kategori == aktiv.kategori && andet_aktiv.identifikation == aktiv.identifikation { 1 } ellers { 0 }) == 1
| afskrivningslov45_overdraget_aktiv_gyldigt(aktiver: List(Afskrivningslov45OverdragetAktiv), aktiv: Afskrivningslov45OverdragetAktiv) -> aktiv.identifikation != "" && afskrivningslov45_overdraget_aktiv_unikt(aktiver, aktiv)
| afskrivningslov45_fordelingsnøgle_gyldig(kategori: Afskrivningslov45Aktivkategori, nøgle: Afskrivningslov45Fordelingsnøgle) -> match nøgle {
    | Al45DriftsmidlerOgSkibeUnderEt -> kategori == Al45DriftsmidlerOgSkibe
    | Al45IndividueltAktiv(identifikation) -> kategori != Al45DriftsmidlerOgSkibe && identifikation != ""
}
| afskrivningslov45_fordelingspost_unik(poster: List(Afskrivningslov45Fordelingspost), post: Afskrivningslov45Fordelingspost) -> foldl(poster, 0, |antal, anden_post| antal + hvis anden_post.kategori == post.kategori && anden_post.nøgle == post.nøgle { 1 } ellers { 0 }) == 1
| afskrivningslov45_fordelingspost_grundgyldig(poster: List(Afskrivningslov45Fordelingspost), post: Afskrivningslov45Fordelingspost) -> afskrivningslov45_fordelingsnøgle_gyldig(post.kategori, post.nøgle) && post.fordelt_kontantværdi_kroner >= 0 && afskrivningslov45_fordelingspost_unik(poster, post)
| afskrivningslov45_antal_aktiver_i_kategori(aktiver: List(Afskrivningslov45OverdragetAktiv), kategori: Afskrivningslov45Aktivkategori) -> foldl(aktiver, 0, |antal, aktiv| antal + hvis aktiv.kategori == kategori { 1 } ellers { 0 })
| afskrivningslov45_antal_poster_i_kategori(poster: List(Afskrivningslov45Fordelingspost), kategori: Afskrivningslov45Aktivkategori) -> foldl(poster, 0, |antal, post| antal + hvis post.kategori == kategori { 1 } ellers { 0 })
| afskrivningslov45_post_matcher_aktiv(post: Afskrivningslov45Fordelingspost, aktiv: Afskrivningslov45OverdragetAktiv) -> match post.nøgle {
    | Al45IndividueltAktiv(identifikation) -> post.kategori == aktiv.kategori && identifikation == aktiv.identifikation
    | _ -> Falskt
}
| afskrivningslov45_antal_poster_for_aktiv(poster: List(Afskrivningslov45Fordelingspost), aktiv: Afskrivningslov45OverdragetAktiv) -> foldl(poster, 0, |antal, post| antal + hvis afskrivningslov45_post_matcher_aktiv(post, aktiv) { 1 } ellers { 0 })
| afskrivningslov45_driftsmidler_og_skibe_under_et(aktiver: List(Afskrivningslov45OverdragetAktiv), poster: List(Afskrivningslov45Fordelingspost)) -> hvis afskrivningslov45_antal_aktiver_i_kategori(aktiver, Al45DriftsmidlerOgSkibe) > 0 { afskrivningslov45_antal_poster_i_kategori(poster, Al45DriftsmidlerOgSkibe) == 1 && any(poster, |post: Afskrivningslov45Fordelingspost| post.kategori == Al45DriftsmidlerOgSkibe && post.nøgle == Al45DriftsmidlerOgSkibeUnderEt) } ellers { afskrivningslov45_antal_poster_i_kategori(poster, Al45DriftsmidlerOgSkibe) == 0 }
| afskrivningslov45_øvrige_aktiver_individuelt(aktiver: List(Afskrivningslov45OverdragetAktiv), poster: List(Afskrivningslov45Fordelingspost)) -> all(aktiver, |aktiv: Afskrivningslov45OverdragetAktiv| aktiv.kategori == Al45DriftsmidlerOgSkibe || afskrivningslov45_antal_poster_for_aktiv(poster, aktiv) == 1)
| afskrivningslov45_post_har_aktiv(aktiver: List(Afskrivningslov45OverdragetAktiv), post: Afskrivningslov45Fordelingspost) -> match post.nøgle {
    | Al45DriftsmidlerOgSkibeUnderEt -> post.kategori == Al45DriftsmidlerOgSkibe && afskrivningslov45_antal_aktiver_i_kategori(aktiver, Al45DriftsmidlerOgSkibe) > 0
    | Al45IndividueltAktiv(identifikation) -> any(aktiver, |aktiv: Afskrivningslov45OverdragetAktiv| aktiv.kategori == post.kategori && aktiv.identifikation == identifikation)
}
| afskrivningslov45_fordelt_sum_kroner(poster: List(Afskrivningslov45Fordelingspost)) -> foldl(poster, 0, |sum, post: Afskrivningslov45Fordelingspost| sum + penge_positivt_beløb(post.fordelt_kontantværdi_kroner))

# Afskrivningslov45FordelingsSag(input: Afskrivningslov45FordelingsInput) {
    | overdragne_aktiver_gyldige() -> length(input.overdragne_aktiver) > 0 && all(input.overdragne_aktiver, |aktiv: Afskrivningslov45OverdragetAktiv| afskrivningslov45_overdraget_aktiv_gyldigt(input.overdragne_aktiver, aktiv))
    | poster_grundgyldige() -> length(input.fordelingsposter) > 0 && all(input.fordelingsposter, |post: Afskrivningslov45Fordelingspost| afskrivningslov45_fordelingspost_grundgyldig(input.fordelingsposter, post) && afskrivningslov45_post_har_aktiv(input.overdragne_aktiver, post))
    | driftsmidler_og_skibe_under_et() -> afskrivningslov45_driftsmidler_og_skibe_under_et(input.overdragne_aktiver, input.fordelingsposter)
    | øvrige_aktiver_individuelt() -> afskrivningslov45_øvrige_aktiver_individuelt(input.overdragne_aktiver, input.fordelingsposter)
    | fordelt_sum_kroner() -> afskrivningslov45_fordelt_sum_kroner(input.fordelingsposter)
    | fordeling_gyldig() -> input.kontantomregning.input_gyldigt && overdragne_aktiver_gyldige() && poster_grundgyldige() && driftsmidler_og_skibe_under_et() && øvrige_aktiver_individuelt() && input.skriftligt_aftalt_af_sælger_og_køber && fordelt_sum_kroner() == input.kontantomregning.kontantomregnet_anskaffelses_eller_salgssum_kroner
    | resultat() -> Afskrivningslov45FordelingsResultat(kontantomregning_gyldig = input.kontantomregning.input_gyldigt, overdragne_aktiver_gyldige = overdragne_aktiver_gyldige(), fordelingsposter_gyldige = poster_grundgyldige(), skriftligt_aftalt_af_sælger_og_køber = input.skriftligt_aftalt_af_sælger_og_køber, driftsmidler_og_skibe_fordelt_under_et = driftsmidler_og_skibe_under_et(), øvrige_aktiver_fordelt_individuelt = øvrige_aktiver_individuelt(), fordelt_sum_kroner = fordelt_sum_kroner(), samlet_kontantomregnet_salgssum_kroner = input.kontantomregning.kontantomregnet_anskaffelses_eller_salgssum_kroner, fordeling_gyldig = fordeling_gyldig(), undergivet_told_og_skatteforvaltningens_prøvelse = fordeling_gyldig(), bindende_for_sælger_og_køber = fordeling_gyldig(), fordelingsposter = input.fordelingsposter)
}
| afskrivningslov45_fordelings_sag(input: Afskrivningslov45FordelingsInput) -> Afskrivningslov45FordelingsSag(input)
| afskrivningslov45_fordelings_resultat(input: Afskrivningslov45FordelingsInput) -> afskrivningslov45_fordelings_sag(input).resultat()

# Afskrivningslov45Ansættelsesside = Al45SælgersSalgssum | Al45KøbersAnskaffelsessum
# Afskrivningslov45AnsættelsesændringInput(kategori: Afskrivningslov45Aktivkategori, identifikation: Tekst, ændret_side: Afskrivningslov45Ansættelsesside, tidligere_beløb_kroner: Heltal, ændret_beløb_kroner: Heltal, ændret_skatteansættelse: Boolsk)
# Afskrivningslov45AnsættelsesændringResultat(kategori: Afskrivningslov45Aktivkategori, identifikation: Tekst, input_gyldigt: Boolsk, ændret_side: Afskrivningslov45Ansættelsesside, ændring_kroner: Heltal, sælgers_salgssum_efter_kroner: Heltal, købers_anskaffelsessum_efter_kroner: Heltal, korresponderende_ændring_bindende: Boolsk)

| afskrivningslov45_ansættelsesændring_resultat(input: Afskrivningslov45AnsættelsesændringInput) -> Afskrivningslov45AnsættelsesændringResultat(
    kategori = input.kategori,
    identifikation = input.identifikation,
    input_gyldigt = input.identifikation != "" && input.tidligere_beløb_kroner >= 0 && input.ændret_beløb_kroner >= 0 && input.ændret_skatteansættelse,
    ændret_side = input.ændret_side,
    ændring_kroner = hvis input.identifikation != "" && input.tidligere_beløb_kroner >= 0 && input.ændret_beløb_kroner >= 0 && input.ændret_skatteansættelse { input.ændret_beløb_kroner - input.tidligere_beløb_kroner } ellers { 0 },
    sælgers_salgssum_efter_kroner = hvis input.identifikation != "" && input.tidligere_beløb_kroner >= 0 && input.ændret_beløb_kroner >= 0 && input.ændret_skatteansættelse { input.ændret_beløb_kroner } ellers { input.tidligere_beløb_kroner },
    købers_anskaffelsessum_efter_kroner = hvis input.identifikation != "" && input.tidligere_beløb_kroner >= 0 && input.ændret_beløb_kroner >= 0 && input.ændret_skatteansættelse { input.ændret_beløb_kroner } ellers { input.tidligere_beløb_kroner },
    korresponderende_ændring_bindende = input.identifikation != "" && input.tidligere_beløb_kroner >= 0 && input.ændret_beløb_kroner >= 0 && input.ændret_skatteansættelse
)
--@end:afskrivningsloven_par45--

--@label:afskrivningsloven_par46::source:afskrivningsloven_lbk1222::parameter_source:afskrivningsloven_2026_satser--
----
§ 46. Grundbeløbene i § 5, stk. 3, § 6, stk. 1, nr. 2, § 10, § 11, stk. 3 og
5, § 29, stk. 1, nr. 3, § 42, stk. 2, og § 43, stk. 2, reguleres efter
personskattelovens § 20.
----

--@begin:afskrivningsloven_par46--
# Afskrivningslov46Grundbeløb = Al46Par5Stk3 | Al46Par6Stk1Nr2 | Al46Par10 | Al46Par11Stk3 | Al46Par11Stk5 | Al46Par29Stk1Nr3 | Al46Par42Stk2 | Al46Par43Stk2
# Afskrivningslov46GrundbeløbResultat(indkomstår: Heltal, hjemmel: Afskrivningslov46Grundbeløb, grundbeløb_2010_niveau_kroner: Heltal, reguleringstal_tiendedele: Heltal, reguleret_og_oprundet_beløb_kroner: Heltal, reguleret_efter_personskattelovens_par20: Boolsk)

| afskrivningslov46_grundbeløb_2010_niveau_kroner(hjemmel: Afskrivningslov46Grundbeløb) -> match hjemmel {
    | Al46Par5Stk3 -> 26200
    | Al46Par6Stk1Nr2 -> 26200
    | Al46Par10 -> 703400
    | Al46Par11Stk3 -> 12300
    | Al46Par11Stk5 -> 12300
    | Al46Par29Stk1Nr3 -> 1406800
    | Al46Par42Stk2 -> 12300
    | Al46Par43Stk2 -> 12300
}
| afskrivningslov46_grundbeløb_resultat(indkomstår: Heltal, hjemmel: Afskrivningslov46Grundbeløb) -> Afskrivningslov46GrundbeløbResultat(
    indkomstår = indkomstår,
    hjemmel = hjemmel,
    grundbeløb_2010_niveau_kroner = afskrivningslov46_grundbeløb_2010_niveau_kroner(hjemmel),
    reguleringstal_tiendedele = hvis indkomstår >= 2009 && indkomstår <= 2026 { par20_reguleringstal_tiendedele(indkomstår) } ellers { 0 },
    reguleret_og_oprundet_beløb_kroner = hvis indkomstår >= 2009 && indkomstår <= 2026 { par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(grundbeløb_2010_niveau_kroner = afskrivningslov46_grundbeløb_2010_niveau_kroner(hjemmel), reguleringstal_tiendedele = par20_reguleringstal_tiendedele(indkomstår))) } ellers { 0 },
    reguleret_efter_personskattelovens_par20 = indkomstår >= 2009 && indkomstår <= 2026
)
--@end:afskrivningsloven_par46--

--@label:afskrivningsloven_par47::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par47_par49_juridisk_vejledning--
----
§ 47. Med salg sidestilles i denne lov andre former for afhændelse og
afståelse.
----

--@begin:afskrivningsloven_par47--
# Afskrivningslov47Afståelsesform = Al47OrdinærtSalg | Al47AndenAfhændelse | Al47AndenAfståelse
# Afskrivningslov47Resultat(afståelsesform: Afskrivningslov47Afståelsesform, salg_efter_afskrivningsloven: Boolsk)

| afskrivningslov47_resultat(afståelsesform: Afskrivningslov47Afståelsesform) -> Afskrivningslov47Resultat(afståelsesform = afståelsesform, salg_efter_afskrivningsloven = Sandt)
--@end:afskrivningsloven_par47--

--@label:afskrivningsloven_par48::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par47_par49_juridisk_vejledning--
----
§ 48. Hvor andet ikke er særskilt fastsat, behandles forsikrings- og
erstatningssummer, herunder ekspropriationserstatninger, som salgssummer.
----

--@begin:afskrivningsloven_par48--
# Afskrivningslov48Beløbsart = Al48Forsikringssum | Al48Erstatningssum | Al48Ekspropriationserstatning
# Afskrivningslov48Særregel = Al48IngenSærregel | Al48ReparationEfterPar7 | Al48SkadeOgGenopførelseEfterPar24 | Al48AndenSærregel
# Afskrivningslov48Input(beløbsart: Afskrivningslov48Beløbsart, beløb_kroner: Heltal, særregel: Afskrivningslov48Særregel)
# Afskrivningslov48Resultat(input_gyldigt: Boolsk, beløbsart: Afskrivningslov48Beløbsart, særregel: Afskrivningslov48Særregel, behandles_som_salgssum: Boolsk, salgssum_kroner: Heltal, beløb_til_særregel_kroner: Heltal)

| afskrivningslov48_resultat(input: Afskrivningslov48Input) -> Afskrivningslov48Resultat(
    input_gyldigt = input.beløb_kroner >= 0,
    beløbsart = input.beløbsart,
    særregel = input.særregel,
    behandles_som_salgssum = input.beløb_kroner >= 0 && input.særregel == Al48IngenSærregel,
    salgssum_kroner = hvis input.beløb_kroner >= 0 && input.særregel == Al48IngenSærregel { input.beløb_kroner } ellers { 0 },
    beløb_til_særregel_kroner = hvis input.beløb_kroner >= 0 && input.særregel != Al48IngenSærregel { input.beløb_kroner } ellers { 0 }
)
--@end:afskrivningsloven_par48--

--@label:afskrivningsloven_par49::source:afskrivningsloven_lbk1222::guidance:afskrivningsloven_par47_par49_juridisk_vejledning--
----
§ 49. Erhvervelse og afståelse af aktiver ved gave, arv eller arveforskud
sidestilles i denne lov med køb henholdsvis salg. Som anskaffelsessum eller
salgssum betragtes i disse tilfælde det beløb, der er lagt til grund ved
beregningen af gaveafgift, boafgift eller indkomstskat af den pågældende
erhvervelse. Har denne ikke været afgifts- eller indkomstskattepligtig, eller er
værdiansættelsen foretaget efter boafgiftslovens § 12 a, betragtes som
anskaffelsessum eller salgssum det pågældende aktivs handelsværdi på
overdragelsestidspunktet. Reglerne i 1.-3. pkt. gælder ikke i det omfang,
erhververen efter skattelovgivningens regler herom indtræder i overdragerens
skattemæssige stilling.
----

--@begin:afskrivningsloven_par49--
# Afskrivningslov49Overdragelsesform = Al49Gave | Al49Arv | Al49Arveforskud
# Afskrivningslov49Retning = Al49Erhvervelse | Al49Afståelse
# Afskrivningslov49Værdiansættelse = Al49AfgiftsEllerIndkomstskattegrundlag(beløb_kroner: Heltal) | Al49IkkeAfgiftsEllerIndkomstskattepligtig(handelsværdi_kroner: Heltal) | Al49VærdiansatEfterBoafgiftslovensPar12A(handelsværdi_kroner: Heltal) | Al49IngenVærdiansættelseVedSkattesuccession
# Afskrivningslov49Succession = Al49IngenSkattesuccession | Al49Skattesuccession(overdragerens_anskaffelsessum_kroner: Heltal, overdragerens_samlede_foretagne_afskrivninger_kroner: Heltal)
# Afskrivningslov49Input(overdragelsesform: Afskrivningslov49Overdragelsesform, retning: Afskrivningslov49Retning, værdiansættelse: Afskrivningslov49Værdiansættelse, succession: Afskrivningslov49Succession)
# Afskrivningslov49Resultat(overdragelsesform: Afskrivningslov49Overdragelsesform, retning: Afskrivningslov49Retning, input_gyldigt: Boolsk, skattesuccession: Boolsk, sidestillet_med_køb: Boolsk, sidestillet_med_salg: Boolsk, anvender_afgifts_eller_indkomstskattegrundlag: Boolsk, anvender_handelsværdi: Boolsk, anskaffelsessum_kroner: Heltal, salgssum_kroner: Heltal, videreført_anskaffelsessum_kroner: Heltal, videreførte_foretagne_afskrivninger_kroner: Heltal)

| afskrivningslov49_værdi_kroner(værdiansættelse: Afskrivningslov49Værdiansættelse) -> match værdiansættelse {
    | Al49AfgiftsEllerIndkomstskattegrundlag(beløb_kroner) -> penge_positivt_beløb(beløb_kroner)
    | Al49IkkeAfgiftsEllerIndkomstskattepligtig(handelsværdi_kroner) -> penge_positivt_beløb(handelsværdi_kroner)
    | Al49VærdiansatEfterBoafgiftslovensPar12A(handelsværdi_kroner) -> penge_positivt_beløb(handelsværdi_kroner)
    | Al49IngenVærdiansættelseVedSkattesuccession -> 0
}
| afskrivningslov49_værdi_gyldig(værdiansættelse: Afskrivningslov49Værdiansættelse) -> match værdiansættelse {
    | Al49AfgiftsEllerIndkomstskattegrundlag(beløb_kroner) -> beløb_kroner >= 0
    | Al49IkkeAfgiftsEllerIndkomstskattepligtig(handelsværdi_kroner) -> handelsværdi_kroner >= 0
    | Al49VærdiansatEfterBoafgiftslovensPar12A(handelsværdi_kroner) -> handelsværdi_kroner >= 0
    | Al49IngenVærdiansættelseVedSkattesuccession -> Falskt
}
| afskrivningslov49_anvender_handelsværdi(værdiansættelse: Afskrivningslov49Værdiansættelse) -> match værdiansættelse {
    | Al49AfgiftsEllerIndkomstskattegrundlag(_) -> Falskt
    | Al49IkkeAfgiftsEllerIndkomstskattepligtig(_) -> Sandt
    | Al49VærdiansatEfterBoafgiftslovensPar12A(_) -> Sandt
    | Al49IngenVærdiansættelseVedSkattesuccession -> Falskt
}
| afskrivningslov49_succession_gyldig(succession: Afskrivningslov49Succession) -> match succession {
    | Al49IngenSkattesuccession -> Sandt
    | Al49Skattesuccession(anskaffelsessum_kroner, afskrivninger_kroner) -> anskaffelsessum_kroner >= 0 && afskrivninger_kroner >= 0 && afskrivninger_kroner <= anskaffelsessum_kroner
}
| afskrivningslov49_er_succession(succession: Afskrivningslov49Succession) -> match succession {
    | Al49IngenSkattesuccession -> Falskt
    | Al49Skattesuccession(_, _) -> Sandt
}
| afskrivningslov49_værdiansættelse_matcher_succession(værdiansættelse: Afskrivningslov49Værdiansættelse, succession: Afskrivningslov49Succession) -> hvis afskrivningslov49_er_succession(succession) { værdiansættelse == Al49IngenVærdiansættelseVedSkattesuccession } ellers { afskrivningslov49_værdi_gyldig(værdiansættelse) }
| afskrivningslov49_videreført_anskaffelsessum_kroner(succession: Afskrivningslov49Succession) -> match succession {
    | Al49Skattesuccession(anskaffelsessum_kroner, _) -> penge_positivt_beløb(anskaffelsessum_kroner)
    | _ -> 0
}
| afskrivningslov49_videreførte_afskrivninger_kroner(succession: Afskrivningslov49Succession) -> match succession {
    | Al49Skattesuccession(_, afskrivninger_kroner) -> penge_positivt_beløb(afskrivninger_kroner)
    | _ -> 0
}
| afskrivningslov49_input_gyldigt(input: Afskrivningslov49Input) -> afskrivningslov49_succession_gyldig(input.succession) && afskrivningslov49_værdiansættelse_matcher_succession(input.værdiansættelse, input.succession)
| afskrivningslov49_resultat(input: Afskrivningslov49Input) -> Afskrivningslov49Resultat(
    overdragelsesform = input.overdragelsesform,
    retning = input.retning,
    input_gyldigt = afskrivningslov49_input_gyldigt(input),
    skattesuccession = afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession),
    sidestillet_med_køb = afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) == Falskt && input.retning == Al49Erhvervelse,
    sidestillet_med_salg = afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) == Falskt && input.retning == Al49Afståelse,
    anvender_afgifts_eller_indkomstskattegrundlag = afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) == Falskt && afskrivningslov49_anvender_handelsværdi(input.værdiansættelse) == Falskt,
    anvender_handelsværdi = afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) == Falskt && afskrivningslov49_anvender_handelsværdi(input.værdiansættelse),
    anskaffelsessum_kroner = hvis afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) == Falskt && input.retning == Al49Erhvervelse { afskrivningslov49_værdi_kroner(input.værdiansættelse) } ellers { 0 },
    salgssum_kroner = hvis afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) == Falskt && input.retning == Al49Afståelse { afskrivningslov49_værdi_kroner(input.værdiansættelse) } ellers { 0 },
    videreført_anskaffelsessum_kroner = hvis afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) { afskrivningslov49_videreført_anskaffelsessum_kroner(input.succession) } ellers { 0 },
    videreførte_foretagne_afskrivninger_kroner = hvis afskrivningslov49_input_gyldigt(input) && afskrivningslov49_er_succession(input.succession) { afskrivningslov49_videreførte_afskrivninger_kroner(input.succession) } ellers { 0 }
)
--@end:afskrivningsloven_par49--
