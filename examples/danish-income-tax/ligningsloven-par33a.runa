--@label:ligningsloven_par33a_stk1::meta:ligningsloven_par33a_metadata--
----
§ 33 A. Har en person, der er skattepligtig efter kildeskattelovens § 1,
under ophold uden for riget i mindst 6 måneder uden andre afbrydelser af
opholdet end nødvendigt arbejde her i riget i direkte forbindelse med
udlandsopholdet, ferie el.lign. af en sammenlagt varighed på højst 42 dage
erhvervet lønindkomst ved personligt arbejde i tjenesteforhold, nedsættes den
samlede indkomstskat med det beløb, der forholdsmæssigt falder på den
udenlandske indkomst. Nedsættelsen omfatter ikke den del af lønindkomsten, der
kan henføres til arbejde her i landet. Ved opgørelsen af den nævnte
6-månedersperiode anses ophold om bord på et dansk skib, der er registreret i
Dansk Internationalt Skibsregister, jf. lov om beskatning af søfolk, for at
være ophold uden for riget. Ophører skattepligten efter kildeskattelovens § 1
inden udløbet af 6-månedersperioden, finder reglerne i denne bestemmelse
tilsvarende anvendelse på lønindkomst erhvervet i den periode, hvor
skattepligten bestod, såfremt betingelserne i 1. pkt. i øvrigt er opfyldt.
----

--@begin:ligningsloven_par33a_stk1--

# Ligningslov33ADanskOpholdsart = Ll33ANødvendigtArbejdeMedDirekteForbindelseTilUdlandsopholdet | Ll33AFerieEllerLignende | Ll33AArbejdeIRigetUdenNødvendigDirekteForbindelseTilUdlandsopholdet | Ll33AModtogArbejdsløshedsdagpengeUnderOpholdIRiget
# Ligningslov33ADanskOpholdsdag(dato: Dato, art: Ligningslov33ADanskOpholdsart)
# Ligningslov33AArbejdsgiverforbindelse = Ll33AUdlandsopholdBegrundetIArbejdsgiverensForhold(dokumentreference: Tekst) | Ll33AUdlandsopholdIkkeBegrundetIArbejdsgiverensForhold | Ll33AArbejdsgiverforbindelseIkkeDokumenteret
# Ligningslov33ATjenesteforholdsstatus = Ll33APersonligtArbejdeITjenesteforhold | Ll33AIkkePersonligtArbejdeITjenesteforhold
# Ligningslov33ASkattepligtsstatus = Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet | Ll33ASkattepligtEfterKildeskattelovensPar1OphørteUnderOpholdet(første_dato_uden_skattepligt: Dato) | Ll33AIkkeSkattepligtigEfterKildeskattelovensPar1
# Ligningslov33ALønindkomstEfterDanskeRegler(skattepligtig_nettoindkomst_kroner: Heltal, personlig_nettoindkomst_kroner: Heltal, arbejdsmarkedsbidragsgrundlag_kroner: Heltal)

| ligningslov33a_arbejdsgiverforbindelse_input_gyldig(forbindelse: Ligningslov33AArbejdsgiverforbindelse) -> match forbindelse {
    | Ll33AUdlandsopholdBegrundetIArbejdsgiverensForhold(dokumentreference) -> dokumentreference != ""
    | _ -> Sandt
}
| ligningslov33a_arbejdsgiverforbindelse_opfyldt(forbindelse: Ligningslov33AArbejdsgiverforbindelse) -> match forbindelse {
    | Ll33AUdlandsopholdBegrundetIArbejdsgiverensForhold(_) -> Sandt
    | _ -> Falskt
}
| ligningslov33a_tjenesteforhold_omfattet(status: Ligningslov33ATjenesteforholdsstatus) -> status == Ll33APersonligtArbejdeITjenesteforhold
| ligningslov33a_lønindkomst_gyldig(indkomst: Ligningslov33ALønindkomstEfterDanskeRegler) -> indkomst.skattepligtig_nettoindkomst_kroner >= 0 && indkomst.personlig_nettoindkomst_kroner >= 0 && indkomst.arbejdsmarkedsbidragsgrundlag_kroner >= 0
| ligningslov33a_dis_ophold_anses_som_udlandsophold() -> Sandt

--@end:ligningsloven_par33a_stk1--

--@label:ligningsloven_par33a_stk2::meta:ligningsloven_par33a_metadata--
----
§ 33 A.

Stk. 2. Stk. 1 finder ikke anvendelse for lønindkomst ved tjeneste uden for
riget for den danske stat eller anden dansk offentlig myndighed, såfremt
erhververen af den nævnte lønindkomst modtager ydelser efter § 7, nr. 15,
eller § 9 A. Tilsvarende finder stk. 1 ikke anvendelse for lønindkomst
erhvervet fra den danske stat eller anden offentlig myndighed, hvis lønnen er
fastsat i henhold til en kollektiv aftale og det ikke udtrykkeligt fremgår af
denne aftale, at lønnen er fastsat under hensyn til lempelse efter stk. 1.
----

--@begin:ligningsloven_par33a_stk2--

# Ligningslov33AOffentligYdelsesstatus = Ll33AIngenYdelseEfterPar7Nr15EllerPar9A | Ll33AYdelseEfterPar7Nr15 | Ll33AYdelseEfterPar9A | Ll33AYdelseEfterPar7Nr15OgPar9A
# Ligningslov33AOffentligLønfastsættelse = Ll33AIndividuelOffentligLønaftale | Ll33AKollektivAftaleMedUdtrykkeligtLempelseshensyn | Ll33AKollektivAftaleUdenUdtrykkeligtLempelseshensyn
# Ligningslov33ASystemeksportstatus = Ll33AIkkeSystemeksport | Ll33ASystemeksportForDanskOffentligMyndighed(dokumentreference: Tekst)
# Ligningslov33AArbejdsgivergrundlag = Ll33AIkkeDanskOffentligArbejdsgiver | Ll33ADanskStatEllerOffentligMyndighed(ydelser: Ligningslov33AOffentligYdelsesstatus, lønfastsættelse: Ligningslov33AOffentligLønfastsættelse, systemeksport: Ligningslov33ASystemeksportstatus)

| ligningslov33a_systemeksport_input_gyldig(status: Ligningslov33ASystemeksportstatus) -> match status {
    | Ll33AIkkeSystemeksport -> Sandt
    | Ll33ASystemeksportForDanskOffentligMyndighed(dokumentreference) -> dokumentreference != ""
}
| ligningslov33a_offentligt_arbejdsgivergrundlag_input_gyldigt(grundlag: Ligningslov33AArbejdsgivergrundlag) -> match grundlag {
    | Ll33AIkkeDanskOffentligArbejdsgiver -> Sandt
    | Ll33ADanskStatEllerOffentligMyndighed(_, _, systemeksport) -> ligningslov33a_systemeksport_input_gyldig(systemeksport)
}
| ligningslov33a_offentlig_ydelse_udelukker(ydelser: Ligningslov33AOffentligYdelsesstatus) -> ydelser != Ll33AIngenYdelseEfterPar7Nr15EllerPar9A
| ligningslov33a_offentlig_lønfastsættelse_udelukker(lønfastsættelse: Ligningslov33AOffentligLønfastsættelse) -> lønfastsættelse == Ll33AKollektivAftaleUdenUdtrykkeligtLempelseshensyn
| ligningslov33a_stk2_udelukker(grundlag: Ligningslov33AArbejdsgivergrundlag) -> match grundlag {
    | Ll33AIkkeDanskOffentligArbejdsgiver -> Falskt
    | Ll33ADanskStatEllerOffentligMyndighed(ydelser, lønfastsættelse, _) -> ligningslov33a_offentlig_ydelse_udelukker(ydelser) || ligningslov33a_offentlig_lønfastsættelse_udelukker(lønfastsættelse)
}

--@end:ligningsloven_par33a_stk2--

--@label:ligningsloven_par33a_stk3::meta:ligningsloven_par33a_metadata--
----
§ 33 A.

Stk. 3. Har en dobbeltbeskatningsoverenskomst for en person, der ikke er
udsendt af den danske stat eller en anden offentlig myndighed, tillagt Danmark
beskatningsretten til indkomsten, nedsættes den samlede indkomstskat med
halvdelen af det beløb, der forholdsmæssigt falder på den udenlandske
indkomst. Tilsvarende gælder for personer udsendt til udførelse af
systemeksport for den danske stat eller anden dansk offentlig myndighed.
----

--@begin:ligningsloven_par33a_stk3--

# Ligningslov33ABeskatningsret = Ll33AIngenDobbeltbeskatningsoverenskomst | Ll33AArbejdslandetHarBeskatningsrettenEfterOverenskomst(dokumentreference: Tekst) | Ll33ADanmarkHarBeskatningsrettenEfterOverenskomst(dokumentreference: Tekst)

| ligningslov33a_beskatningsret_input_gyldig(beskatningsret: Ligningslov33ABeskatningsret) -> match beskatningsret {
    | Ll33AIngenDobbeltbeskatningsoverenskomst -> Sandt
    | Ll33AArbejdslandetHarBeskatningsrettenEfterOverenskomst(dokumentreference) -> dokumentreference != ""
    | Ll33ADanmarkHarBeskatningsrettenEfterOverenskomst(dokumentreference) -> dokumentreference != ""
}
| ligningslov33a_offentlig_systemeksport(grundlag: Ligningslov33AArbejdsgivergrundlag) -> match grundlag {
    | Ll33ADanskStatEllerOffentligMyndighed(_, _, Ll33ASystemeksportForDanskOffentligMyndighed(_)) -> Sandt
    | _ -> Falskt
}
| ligningslov33a_offentlig_uden_systemeksport(grundlag: Ligningslov33AArbejdsgivergrundlag) -> match grundlag {
    | Ll33ADanskStatEllerOffentligMyndighed(_, _, Ll33AIkkeSystemeksport) -> Sandt
    | _ -> Falskt
}
| ligningslov33a_lempelsesandel_basispoint(grundlag: Ligningslov33AArbejdsgivergrundlag, beskatningsret: Ligningslov33ABeskatningsret) -> hvis ligningslov33a_offentlig_uden_systemeksport(grundlag) {
    10000
} ellers hvis ligningslov33a_offentlig_systemeksport(grundlag) {
    match beskatningsret {
        | Ll33AArbejdslandetHarBeskatningsrettenEfterOverenskomst(_) -> 10000
        | _ -> 5000
    }
} ellers {
    match beskatningsret {
        | Ll33ADanmarkHarBeskatningsrettenEfterOverenskomst(_) -> 5000
        | _ -> 10000
    }
}

--@end:ligningsloven_par33a_stk3--

--@label:ligningsloven_par33a_stk4::meta:ligningsloven_par33a_metadata--
----
§ 33 A.

Stk. 4. Skatteministeren kan fastsætte regler om henstand med opkrævning af
skatten.
----

--@begin:ligningsloven_par33a_stk4--

# Ligningslov33AHenstandsstatus = Ll33AIngenHenstand | Ll33AHenstandEfterSkatteministerensRegler(dokumentreference: Tekst)

| ligningslov33a_henstandsstatus_input_gyldig(status: Ligningslov33AHenstandsstatus) -> match status {
    | Ll33AIngenHenstand -> Sandt
    | Ll33AHenstandEfterSkatteministerensRegler(dokumentreference) -> dokumentreference != ""
}

--@end:ligningsloven_par33a_stk4--

--@label:ligningsloven_par33a_stk5::meta:ligningsloven_par33a_metadata--
----
§ 33 A.

Stk. 5. Stk. 1-4 finder tilsvarende anvendelse på dødsboer omfattet af
dødsboskattelovens § 1, stk. 2.
----

--@begin:ligningsloven_par33a_stk5--

# Ligningslov33ASkattesubjekt = Ll33APerson | Ll33ADødsboOmfattetAfDødsboskattelovensPar1Stk2

| ligningslov33a_subjekt_omfattet(subjekt: Ligningslov33ASkattesubjekt) -> match subjekt {
    | Ll33APerson -> Sandt
    | Ll33ADødsboOmfattetAfDødsboskattelovensPar1Stk2 -> Sandt
}

--@end:ligningsloven_par33a_stk5--

--@label:ligningsloven_par33a_stk6::meta:ligningsloven_par33a_metadata--
----
§ 33 A.

Stk. 6. Ved anvendelse af stk. 1 kan personen vælge at se bort fra ophold her
i riget fra og med den 9. marts 2020 til det tidspunkt, hvor arbejdet
genoptages i det land, hvor arbejdet normalt udføres, dog senest til og med den
30. juni 2020. Valget medfører, at arbejde her i riget, der ikke er nødvendigt
arbejde i direkte forbindelse med udlandsopholdet, ikke afbryder
udlandsopholdet. Nedsættelsen af den samlede indkomstskat efter stk. 1 og 3
omfatter ikke den del af lønindkomsten, der kan henføres til den angivne
periode. Valget skal træffes senest den 1. maj 2021 og kan omgøres til og med
den 30. juni 2022.
----

--@begin:ligningsloven_par33a_stk6--

# Ligningslov33ACovidvalg = Ll33AUdenCovidvalg | Ll33ACovidvalgAnvendt(arbejde_genoptaget_i_arbejdslandet_dato: Option(Dato), valgdato: Dato) | Ll33ACovidvalgOmgjort(omgørelsesdato: Dato)

| ligningslov33a_covidperiodestart() -> Dato(år = 2020, måned = 3, dag = 9)
| ligningslov33a_covidperiodens_seneste_slut() -> Dato(år = 2020, måned = 6, dag = 30)
| ligningslov33a_covidvalgets_seneste_dato() -> Dato(år = 2021, måned = 5, dag = 1)
| ligningslov33a_covidomgørelsens_seneste_dato() -> Dato(år = 2022, måned = 6, dag = 30)
| ligningslov33a_covid_genoptagelsesdato_gyldig(dato: Option(Dato)) -> match dato {
    | None -> Sandt
    | Some(genoptagelsesdato) -> dato_efter_eller_lig_med(genoptagelsesdato, ligningslov33a_covidperiodestart()) && dato_før_eller_lig_med(genoptagelsesdato, ligningslov33a_covidperiodens_seneste_slut())
}
| ligningslov33a_covidvalg_input_gyldigt(valg: Ligningslov33ACovidvalg) -> match valg {
    | Ll33AUdenCovidvalg -> Sandt
    | Ll33ACovidvalgAnvendt(genoptagelsesdato, valgdato) -> dato_gyldig(valgdato) && dato_før_eller_lig_med(valgdato, ligningslov33a_covidvalgets_seneste_dato()) && ligningslov33a_covid_genoptagelsesdato_gyldig(genoptagelsesdato)
    | Ll33ACovidvalgOmgjort(omgørelsesdato) -> dato_gyldig(omgørelsesdato) && dato_før_eller_lig_med(omgørelsesdato, ligningslov33a_covidomgørelsens_seneste_dato())
}
| ligningslov33a_covidvalg_slutdato(valg: Ligningslov33ACovidvalg) -> match valg {
    | Ll33ACovidvalgAnvendt(Some(genoptagelsesdato), _) -> genoptagelsesdato
    | Ll33ACovidvalgAnvendt(None, _) -> ligningslov33a_covidperiodens_seneste_slut()
    | _ -> ligningslov33a_covidperiodestart()
}
| ligningslov33a_dansk_opholdsdag_ignoreres_efter_stk6(dag: Ligningslov33ADanskOpholdsdag, valg: Ligningslov33ACovidvalg) -> match valg {
    | Ll33ACovidvalgAnvendt(_, _) -> dato_efter_eller_lig_med(dag.dato, ligningslov33a_covidperiodestart()) && dato_før_eller_lig_med(dag.dato, ligningslov33a_covidvalg_slutdato(valg))
    | _ -> Falskt
}

--@end:ligningsloven_par33a_stk6--

--@label:ligningsloven_par33a_aarsberegning::meta:ligningsloven_par33a_metadata--
----
Den juridiske vejledning 2026-1, C.F.4.2.2.4:
"Udlandsopholdet anses for at være afbrudt ved starten af det ferieophold mv.,
i hvilket de 42 dage bliver overskredet."

Den juridiske vejledning 2026-1, C.F.4.2.2.2:
"Udlandsopholdet anses for afbrudt, hvis en person modtager
arbejdsløshedsdagpenge under et ophold i Danmark."

Den juridiske vejledning 2026-1, C.F.4.2.2.3:
"Hvis en lønmodtager i en periode opfylder betingelserne for skattelempelse
efter LL § 33 A, vælger lønmodtageren selv, om perioden omfattet af
skattelempelse efter LL § 33 A skal starte ved første udrejse eller eventuelt
først ved en senere udrejse."

SKM2009.638.SKAT fastslår, at en faktisk udrejsedato kan vælges som periodens
start, mens periodens slutning følger af, hvornår betingelserne ophører.
SKM2004.15.TSS bekræfter, at et senere seksmånedersinterval kan kvalificere,
selv om et tidligere interval under samme faktiske udlandsophold blev afbrudt.
SKM2019.201.LSR fastslår, at en periode uden ansættelse ikke i sig selv
afbryder udlandsopholdet, når opholdet i Danmark har karakter af ferie el.lign.
----

--@begin:ligningsloven_par33a_aarsberegning--

# Ligningslov33AOphold(fra_dato: Dato, til_dato: Dato, danske_opholdsdage: List(Ligningslov33ADanskOpholdsdag), arbejdsgiverforbindelse: Ligningslov33AArbejdsgiverforbindelse, tjenesteforhold: Ligningslov33ATjenesteforholdsstatus, skattepligt: Ligningslov33ASkattepligtsstatus, covidvalg: Ligningslov33ACovidvalg, dokumentreference: Tekst)
# Ligningslov33AIndkomstfordeling(samlet_lønindkomst_efter_danske_regler: Ligningslov33ALønindkomstEfterDanskeRegler, heraf_arbejde_i_riget_efter_danske_regler: Ligningslov33ALønindkomstEfterDanskeRegler)
# Ligningslov33ADateretIndkomstfordeling(identifikation: Tekst, fra_dato: Dato, til_dato: Dato, fordeling: Ligningslov33AIndkomstfordeling, dokumentreference: Tekst)
# Ligningslov33AIndkomstgrundlag = Ll33ASamletIndkomstForUafbrudtLempelsesperiode(fordeling: Ligningslov33AIndkomstfordeling) | Ll33ADateredeIndkomstfordelinger(perioder: List(Ligningslov33ADateretIndkomstfordeling))
# Ligningslov33AAfbrydelsesårsag = Ll33AOverskridelseAf42DagesGrænsen(første_overskridelsesdato: Dato) | Ll33AArbejdeIRigetUdenNødvendigDirekteForbindelse(arbejdsdato: Dato) | Ll33AModtagelseAfArbejdsløshedsdagpengeUnderOpholdIRiget(dagpengedato: Dato)
# Ligningslov33AAfbrydelse(årsag: Ligningslov33AAfbrydelsesårsag, afbrydelsesdato: Dato, ny_udrejsedato: Dato)
# Ligningslov33APeriodeudfald = Ll33ALempelsesberettigetPeriode | Ll33AAfvistPeriode
# Ligningslov33APeriodevurdering(kandidatstart_dato: Dato, vurderet_ophold: Ligningslov33AOphold, afbrydelse: Option(Ligningslov33AAfbrydelse), mindst_seks_måneders_udlandsophold: Boolsk, danske_opholdsdage_lovlige: Boolsk, alle_seksmånedersvinduer_overholder_42_dage: Boolsk, samlet_dagegrænse_overholdt: Boolsk, betingelser_opfyldt: Boolsk, udfald: Ligningslov33APeriodeudfald)
# Ligningslov33APeriodevalg(valgte_udrejsedatoer: List(Dato))
# Ligningslov33AIndkomstperiodeudfald = Ll33ALempelsesberettigetIndkomstperiode | Ll33AIkkeLempelsesberettigetIndkomstperiode | Ll33AUgyldigtAfgrænsetIndkomstperiode
# Ligningslov33AIndkomstperiodevurdering(periode: Ligningslov33ADateretIndkomstfordeling, afgrænset_entydigt: Boolsk, inden_for_skattepligtig_periode: Boolsk, indeholdt_i_lempelsesberettiget_periode: Boolsk, udfald: Ligningslov33AIndkomstperiodeudfald)
# Ligningslov33AAnsættelsesforhold(identifikation: Tekst, subjekt: Ligningslov33ASkattesubjekt, ophold: Ligningslov33AOphold, periodevalg: Ligningslov33APeriodevalg, arbejdsgivergrundlag: Ligningslov33AArbejdsgivergrundlag, beskatningsret: Ligningslov33ABeskatningsret, indkomstgrundlag: Ligningslov33AIndkomstgrundlag, henstand: Ligningslov33AHenstandsstatus)
# Ligningslov33AÅrsinput(indkomstår: Heltal, ansættelsesforhold: List(Ligningslov33AAnsættelsesforhold))
# Ligningslov33AForholdsresultat(fakta: Ligningslov33AAnsættelsesforhold, periodevurderinger: List(Ligningslov33APeriodevurdering), valgte_periodevurderinger: List(Ligningslov33APeriodevurdering), indkomstperiodevurderinger: List(Ligningslov33AIndkomstperiodevurdering), input_gyldigt: Boolsk, mindst_en_kandidatperiode_på_seks_måneder: Boolsk, oprindeligt_opholds_danske_opholdsdage_lovlige: Boolsk, oprindeligt_opholds_højeste_antal_danske_dage_i_afsluttet_seksmånedersperiode: Heltal, oprindeligt_opholds_samlet_antal_medregnede_danske_dage: Heltal, oprindeligt_opholds_samlet_tilladt_antal_danske_dage: Heltal, oprindeligt_opholds_samlet_dagegrænse_overholdt: Boolsk, arbejdsgiverforbindelse_opfyldt: Boolsk, tjenesteforhold_omfattet: Boolsk, skattepligt_omfattet: Boolsk, stk2_udelukker: Boolsk, betingelser_opfyldt: Boolsk, lempelsesandel_basispoint: Heltal, lempelsesberettiget_indkomst_efter_danske_regler: Ligningslov33ALønindkomstEfterDanskeRegler)
# Ligningslov33AKomponentresultat(komponent: Ligningslov33DanskSkattekomponent, fuldt_lempelsesberettiget_indkomst_kroner: Heltal, halvt_lempelsesberettiget_indkomst_kroner: Heltal, forholdsmæssig_beregning: PengeØreBeregning, nedslag_øre: Heltal)
# Ligningslov33AÅrsresultat(input: Ligningslov33AÅrsinput, dansk_skattekreds: Ligningslov33PersonDanskSkattekreds, forholdsresultater: List(Ligningslov33AForholdsresultat), fuldt_lempelsesberettiget_indkomst: Ligningslov33ALønindkomstEfterDanskeRegler, halvt_lempelsesberettiget_indkomst: Ligningslov33ALønindkomstEfterDanskeRegler, komponenter: List(Ligningslov33AKomponentresultat), input_gyldigt: Boolsk, alle_forhold_lempelsesberettigede: Boolsk, samlet_nedslag_før_skattecap_øre: Heltal, samlet_nedslag_øre: Heltal)

| ligningslov33a_tom_lønindkomst() -> Ligningslov33ALønindkomstEfterDanskeRegler(
    skattepligtig_nettoindkomst_kroner = 0,
    personlig_nettoindkomst_kroner = 0,
    arbejdsmarkedsbidragsgrundlag_kroner = 0
)
| ligningslov33a_lønindkomst_læg_sammen(venstre: Ligningslov33ALønindkomstEfterDanskeRegler, højre: Ligningslov33ALønindkomstEfterDanskeRegler) -> Ligningslov33ALønindkomstEfterDanskeRegler(
    skattepligtig_nettoindkomst_kroner = venstre.skattepligtig_nettoindkomst_kroner + højre.skattepligtig_nettoindkomst_kroner,
    personlig_nettoindkomst_kroner = venstre.personlig_nettoindkomst_kroner + højre.personlig_nettoindkomst_kroner,
    arbejdsmarkedsbidragsgrundlag_kroner = venstre.arbejdsmarkedsbidragsgrundlag_kroner + højre.arbejdsmarkedsbidragsgrundlag_kroner
)
| ligningslov33a_lønindkomst_træk_fra(samlet: Ligningslov33ALønindkomstEfterDanskeRegler, fradrag: Ligningslov33ALønindkomstEfterDanskeRegler) -> Ligningslov33ALønindkomstEfterDanskeRegler(
    skattepligtig_nettoindkomst_kroner = samlet.skattepligtig_nettoindkomst_kroner - fradrag.skattepligtig_nettoindkomst_kroner,
    personlig_nettoindkomst_kroner = samlet.personlig_nettoindkomst_kroner - fradrag.personlig_nettoindkomst_kroner,
    arbejdsmarkedsbidragsgrundlag_kroner = samlet.arbejdsmarkedsbidragsgrundlag_kroner - fradrag.arbejdsmarkedsbidragsgrundlag_kroner
)
| ligningslov33a_indkomstfordeling_input_gyldig(fordeling: Ligningslov33AIndkomstfordeling) -> {
    = samlet = fordeling.samlet_lønindkomst_efter_danske_regler
    = dansk_arbejde = fordeling.heraf_arbejde_i_riget_efter_danske_regler
    ligningslov33a_lønindkomst_gyldig(samlet) && ligningslov33a_lønindkomst_gyldig(dansk_arbejde) && dansk_arbejde.skattepligtig_nettoindkomst_kroner <= samlet.skattepligtig_nettoindkomst_kroner && dansk_arbejde.personlig_nettoindkomst_kroner <= samlet.personlig_nettoindkomst_kroner && dansk_arbejde.arbejdsmarkedsbidragsgrundlag_kroner <= samlet.arbejdsmarkedsbidragsgrundlag_kroner
}
| ligningslov33a_lempelsesberettiget_indkomst(fordeling: Ligningslov33AIndkomstfordeling) -> hvis ligningslov33a_indkomstfordeling_input_gyldig(fordeling) {
    ligningslov33a_lønindkomst_træk_fra(fordeling.samlet_lønindkomst_efter_danske_regler, fordeling.heraf_arbejde_i_riget_efter_danske_regler)
} ellers {
    ligningslov33a_tom_lønindkomst()
}
| ligningslov33a_dato_i_lukket_periode(dato: Dato, fra_dato: Dato, til_dato: Dato) -> dato_efter_eller_lig_med(dato, fra_dato) && dato_før_eller_lig_med(dato, til_dato)
| ligningslov33a_dato_i_halvåben_periode(dato: Dato, fra_dato: Dato, til_dato_eksklusiv: Dato) -> dato_efter_eller_lig_med(dato, fra_dato) && dato_før(dato, til_dato_eksklusiv)
| ligningslov33a_dansk_opholdsdag_antal(dage: List(Ligningslov33ADanskOpholdsdag), dato: Dato) -> foldl(dage, 0, |antal: Heltal, dag: Ligningslov33ADanskOpholdsdag| antal + hvis dag.dato == dato { 1 } ellers { 0 })
| ligningslov33a_danske_opholdsdage_entydige(dage: List(Ligningslov33ADanskOpholdsdag)) -> all(dage, |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_dansk_opholdsdag_antal(dage, dag.dato) == 1)
| ligningslov33a_dansk_opholdsdag_input_gyldig(dag: Ligningslov33ADanskOpholdsdag, ophold: Ligningslov33AOphold) -> dato_gyldig(dag.dato) && ligningslov33a_dato_i_lukket_periode(dag.dato, ophold.fra_dato, ophold.til_dato)
| ligningslov33a_skattepligtsstatus_input_gyldig(status: Ligningslov33ASkattepligtsstatus, ophold: Ligningslov33AOphold) -> match status {
    | Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet -> Sandt
    | Ll33ASkattepligtEfterKildeskattelovensPar1OphørteUnderOpholdet(første_dato_uden_skattepligt) -> dato_gyldig(første_dato_uden_skattepligt) && dato_efter(første_dato_uden_skattepligt, ophold.fra_dato) && dato_før_eller_lig_med(første_dato_uden_skattepligt, ophold.til_dato)
    | Ll33AIkkeSkattepligtigEfterKildeskattelovensPar1 -> Sandt
}
| ligningslov33a_skattepligt_omfattet(status: Ligningslov33ASkattepligtsstatus) -> status != Ll33AIkkeSkattepligtigEfterKildeskattelovensPar1
| ligningslov33a_ophold_slut_eksklusiv(ophold: Ligningslov33AOphold) -> dato_næste_dag(ophold.til_dato)
| ligningslov33a_ophold_fulde_måneder(ophold: Ligningslov33AOphold) -> dato_fulde_måneder_mellem(ophold.fra_dato, ligningslov33a_ophold_slut_eksklusiv(ophold))
| ligningslov33a_mindst_seks_måneders_udlandsophold(ophold: Ligningslov33AOphold) -> ligningslov33a_ophold_fulde_måneder(ophold) >= 6
| ligningslov33a_rejsedag_ved_udlandsopholdets_start_eller_slut(dag: Ligningslov33ADanskOpholdsdag, ophold: Ligningslov33AOphold) -> dag.dato == ophold.fra_dato || dag.dato == ophold.til_dato
| ligningslov33a_dansk_opholdsart_afbryder(art: Ligningslov33ADanskOpholdsart) -> match art {
    | Ll33AArbejdeIRigetUdenNødvendigDirekteForbindelseTilUdlandsopholdet -> Sandt
    | Ll33AModtogArbejdsløshedsdagpengeUnderOpholdIRiget -> Sandt
    | _ -> Falskt
}
| ligningslov33a_dansk_opholdsdag_lovlig(dag: Ligningslov33ADanskOpholdsdag, ophold: Ligningslov33AOphold) -> ligningslov33a_rejsedag_ved_udlandsopholdets_start_eller_slut(dag, ophold) || ligningslov33a_dansk_opholdsdag_ignoreres_efter_stk6(dag, ophold.covidvalg) || ligningslov33a_dansk_opholdsart_afbryder(dag.art) == Falskt
| ligningslov33a_danske_opholdsdage_lovlige(ophold: Ligningslov33AOphold) -> all(ophold.danske_opholdsdage, |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_dansk_opholdsdag_lovlig(dag, ophold))
| ligningslov33a_dansk_opholdsdag_medregnes(dag: Ligningslov33ADanskOpholdsdag, ophold: Ligningslov33AOphold) -> ligningslov33a_rejsedag_ved_udlandsopholdets_start_eller_slut(dag, ophold) == Falskt && ligningslov33a_dansk_opholdsdag_ignoreres_efter_stk6(dag, ophold.covidvalg) == Falskt
| ligningslov33a_medregnede_danske_opholdsdage(ophold: Ligningslov33AOphold) -> filter(ophold.danske_opholdsdage, |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_dansk_opholdsdag_medregnes(dag, ophold))
| ligningslov33a_seksmåneders_vinduestarter(ophold: Ligningslov33AOphold) -> {
    = antal_dage = dato_dage_fra_og_med_til_og_med(ophold.fra_dato, ophold.til_dato)
    = alle_startdatoer = map(range(0, antal_dage), |forskydning: Heltal| dato_plus_dage(ophold.fra_dato, forskydning))
    = opholdsslut_eksklusiv = ligningslov33a_ophold_slut_eksklusiv(ophold)
    filter(alle_startdatoer, |startdato: Dato| dato_før_eller_lig_med(dato_plus_måneder(startdato, 6), opholdsslut_eksklusiv))
}
| ligningslov33a_danske_dage_i_seksmånedersvindue(ophold: Ligningslov33AOphold, startdato: Dato) -> {
    = slutdato_eksklusiv = dato_plus_måneder(startdato, 6)
    foldl(ligningslov33a_medregnede_danske_opholdsdage(ophold), 0, |antal: Heltal, dag: Ligningslov33ADanskOpholdsdag| antal + hvis ligningslov33a_dato_i_halvåben_periode(dag.dato, startdato, slutdato_eksklusiv) { 1 } ellers { 0 })
}
| ligningslov33a_medregnede_danske_opholdsdage_sorteret(ophold: Ligningslov33AOphold) -> sort_by(ligningslov33a_medregnede_danske_opholdsdage(ophold), |dag: Ligningslov33ADanskOpholdsdag| dato_nøgle(dag.dato))
| ligningslov33a_seneste_seksmånedersperiode_fra_dato(slutdato: Dato) -> dato_næste_dag(dato_plus_måneder(slutdato, -6))
| ligningslov33a_danske_dage_i_seneste_seks_måneder_til_og_med(ophold: Ligningslov33AOphold, slutdato: Dato) -> foldl(
    ligningslov33a_medregnede_danske_opholdsdage(ophold),
    0,
    |antal: Heltal, dag: Ligningslov33ADanskOpholdsdag| antal + hvis ligningslov33a_dato_i_lukket_periode(dag.dato, ligningslov33a_seneste_seksmånedersperiode_fra_dato(slutdato), slutdato) { 1 } ellers { 0 }
)
| ligningslov33a_første_overskridelsesdato(ophold: Ligningslov33AOphold) -> hvis length(ligningslov33a_medregnede_danske_opholdsdage(ophold)) <= 42 {
    None
} ellers {
    match find(
        ligningslov33a_medregnede_danske_opholdsdage_sorteret(ophold),
        |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_danske_dage_i_seneste_seks_måneder_til_og_med(ophold, dag.dato) > 42
    ) {
        | Some(dag) -> Some(dag.dato)
        | None -> None
    }
}
| ligningslov33a_dansk_opholdsdag_er_besøgsstart(dag: Ligningslov33ADanskOpholdsdag, dage: List(Ligningslov33ADanskOpholdsdag)) -> all(
    dage,
    |tidligere_dag: Ligningslov33ADanskOpholdsdag| dato_ordinal(tidligere_dag.dato) + 1 != dato_ordinal(dag.dato)
)
| ligningslov33a_afbrydelsesdato_for_overskridelse(ophold: Ligningslov33AOphold, overskridelsesdato: Dato) -> {
    = besøgsstarter = sort_by(
        filter(
            ophold.danske_opholdsdage,
            |dag: Ligningslov33ADanskOpholdsdag| dato_før_eller_lig_med(dag.dato, overskridelsesdato) && ligningslov33a_dansk_opholdsdag_er_besøgsstart(dag, ophold.danske_opholdsdage)
        ),
        |dag: Ligningslov33ADanskOpholdsdag| dato_nøgle(dag.dato)
    )
    last(besøgsstarter).dato
}
| ligningslov33a_dansk_opholdsdag_er_besøgsslut(dag: Ligningslov33ADanskOpholdsdag, dage: List(Ligningslov33ADanskOpholdsdag)) -> all(
    dage,
    |senere_dag: Ligningslov33ADanskOpholdsdag| dato_ordinal(dag.dato) + 1 != dato_ordinal(senere_dag.dato)
)
| ligningslov33a_besøgsslut_for_dato(ophold: Ligningslov33AOphold, dato: Dato) -> {
    = mulige_besøgsslutninger = sort_by(
        filter(
            ophold.danske_opholdsdage,
            |dag: Ligningslov33ADanskOpholdsdag| dato_efter_eller_lig_med(dag.dato, dato) && ligningslov33a_dansk_opholdsdag_er_besøgsslut(dag, ophold.danske_opholdsdage)
        ),
        |dag: Ligningslov33ADanskOpholdsdag| dato_nøgle(dag.dato)
    )
    head(mulige_besøgsslutninger).dato
}
| ligningslov33a_første_arbejdsdag_uden_nødvendig_direkte_forbindelse(ophold: Ligningslov33AOphold) -> match find(
    ligningslov33a_medregnede_danske_opholdsdage_sorteret(ophold),
    |dag: Ligningslov33ADanskOpholdsdag| dag.art == Ll33AArbejdeIRigetUdenNødvendigDirekteForbindelseTilUdlandsopholdet
) {
    | Some(dag) -> Some(dag.dato)
    | None -> None
}
| ligningslov33a_første_dag_med_arbejdsløshedsdagpenge_under_ophold_i_riget(ophold: Ligningslov33AOphold) -> match find(
    ligningslov33a_medregnede_danske_opholdsdage_sorteret(ophold),
    |dag: Ligningslov33ADanskOpholdsdag| dag.art == Ll33AModtogArbejdsløshedsdagpengeUnderOpholdIRiget
) {
    | Some(dag) -> Some(dag.dato)
    | None -> None
}
| ligningslov33a_42_dages_afbrydelse(ophold: Ligningslov33AOphold) -> match ligningslov33a_første_overskridelsesdato(ophold) {
    | None -> None
    | Some(overskridelsesdato) -> Some(Ligningslov33AAfbrydelse(
        årsag = Ll33AOverskridelseAf42DagesGrænsen(første_overskridelsesdato = overskridelsesdato),
        afbrydelsesdato = ligningslov33a_afbrydelsesdato_for_overskridelse(ophold, overskridelsesdato),
        ny_udrejsedato = ligningslov33a_besøgsslut_for_dato(ophold, overskridelsesdato)
    ))
}
| ligningslov33a_arbejdsafbrydelse(ophold: Ligningslov33AOphold) -> match ligningslov33a_første_arbejdsdag_uden_nødvendig_direkte_forbindelse(ophold) {
    | None -> None
    | Some(arbejdsdato) -> Some(Ligningslov33AAfbrydelse(
        årsag = Ll33AArbejdeIRigetUdenNødvendigDirekteForbindelse(arbejdsdato = arbejdsdato),
        afbrydelsesdato = arbejdsdato,
        ny_udrejsedato = ligningslov33a_besøgsslut_for_dato(ophold, arbejdsdato)
    ))
}
| ligningslov33a_dagpengeafbrydelse(ophold: Ligningslov33AOphold) -> match ligningslov33a_første_dag_med_arbejdsløshedsdagpenge_under_ophold_i_riget(ophold) {
    | None -> None
    | Some(dagpengedato) -> Some(Ligningslov33AAfbrydelse(
        årsag = Ll33AModtagelseAfArbejdsløshedsdagpengeUnderOpholdIRiget(dagpengedato = dagpengedato),
        afbrydelsesdato = dagpengedato,
        ny_udrejsedato = ligningslov33a_besøgsslut_for_dato(ophold, dagpengedato)
    ))
}
| ligningslov33a_afbrydelse_som_liste(afbrydelse: Option(Ligningslov33AAfbrydelse)) -> match afbrydelse {
    | Some(værdi) -> [værdi]
    | None -> []
}
| ligningslov33a_afbrydelse_prioritet(årsag: Ligningslov33AAfbrydelsesårsag) -> match årsag {
    | Ll33AArbejdeIRigetUdenNødvendigDirekteForbindelse(_) -> 0
    | Ll33AModtagelseAfArbejdsløshedsdagpengeUnderOpholdIRiget(_) -> 1
    | Ll33AOverskridelseAf42DagesGrænsen(_) -> 2
}
| ligningslov33a_afbrydelse_sorteringsnøgle(afbrydelse: Ligningslov33AAfbrydelse) -> dato_nøgle(afbrydelse.afbrydelsesdato) * 10 + ligningslov33a_afbrydelse_prioritet(afbrydelse.årsag)
| ligningslov33a_første_afbrydelse(ophold: Ligningslov33AOphold) -> find(
    sort_by(
        concat(
            ligningslov33a_afbrydelse_som_liste(ligningslov33a_42_dages_afbrydelse(ophold)),
            concat(
                ligningslov33a_afbrydelse_som_liste(ligningslov33a_arbejdsafbrydelse(ophold)),
                ligningslov33a_afbrydelse_som_liste(ligningslov33a_dagpengeafbrydelse(ophold))
            )
        ),
        |afbrydelse: Ligningslov33AAfbrydelse| ligningslov33a_afbrydelse_sorteringsnøgle(afbrydelse)
    ),
    |afbrydelse: Ligningslov33AAfbrydelse| dato_gyldig(afbrydelse.afbrydelsesdato)
)
| ligningslov33a_ophold_afgrænset_fra_og_med_til_og_med(ophold: Ligningslov33AOphold, fra_dato: Dato, til_dato: Dato) -> Ligningslov33AOphold(
    fra_dato = fra_dato,
    til_dato = til_dato,
    danske_opholdsdage = filter(ophold.danske_opholdsdage, |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_dato_i_lukket_periode(dag.dato, fra_dato, til_dato)),
    arbejdsgiverforbindelse = ophold.arbejdsgiverforbindelse,
    tjenesteforhold = ophold.tjenesteforhold,
    skattepligt = ophold.skattepligt,
    covidvalg = ophold.covidvalg,
    dokumentreference = ophold.dokumentreference
)
| ligningslov33a_kandidatstartdatoer(ophold: Ligningslov33AOphold) -> sort_by(
    distinct(concat(
        [ophold.fra_dato],
        map(
            filter(
                ophold.danske_opholdsdage,
                |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_dansk_opholdsdag_er_besøgsslut(dag, ophold.danske_opholdsdage)
            ),
            |dag: Ligningslov33ADanskOpholdsdag| dag.dato
        )
    )),
    |dato: Dato| dato_nøgle(dato)
)
| ligningslov33a_periodevurdering(ophold: Ligningslov33AOphold, kandidatstart_dato: Dato) -> {
    = resterende_ophold = ligningslov33a_ophold_afgrænset_fra_og_med_til_og_med(ophold, kandidatstart_dato, ophold.til_dato)
    = afbrydelse = ligningslov33a_første_afbrydelse(resterende_ophold)
    = vurderet_ophold = match afbrydelse {
        | None -> resterende_ophold
        | Some(hændelse) -> ligningslov33a_ophold_afgrænset_fra_og_med_til_og_med(resterende_ophold, kandidatstart_dato, hændelse.afbrydelsesdato)
    }
    = mindst_seks_måneder = ligningslov33a_mindst_seks_måneders_udlandsophold(vurderet_ophold)
    = danske_dage_lovlige = ligningslov33a_danske_opholdsdage_lovlige(vurderet_ophold)
    = seksmånedersvinduer_lovlige = ligningslov33a_alle_seksmånedersvinduer_overholder_42_dage(vurderet_ophold)
    = samlet_dagegrænse_lovlig = ligningslov33a_samlet_dagegrænse_overholdt(vurderet_ophold)
    = betingelser_opfyldt = ligningslov33a_ophold_input_gyldigt(ophold) && mindst_seks_måneder && danske_dage_lovlige && seksmånedersvinduer_lovlige && samlet_dagegrænse_lovlig && ligningslov33a_arbejdsgiverforbindelse_opfyldt(ophold.arbejdsgiverforbindelse) && ligningslov33a_tjenesteforhold_omfattet(ophold.tjenesteforhold) && ligningslov33a_skattepligt_omfattet(ophold.skattepligt)
    Ligningslov33APeriodevurdering(
        kandidatstart_dato = kandidatstart_dato,
        vurderet_ophold = vurderet_ophold,
        afbrydelse = afbrydelse,
        mindst_seks_måneders_udlandsophold = mindst_seks_måneder,
        danske_opholdsdage_lovlige = danske_dage_lovlige,
        alle_seksmånedersvinduer_overholder_42_dage = seksmånedersvinduer_lovlige,
        samlet_dagegrænse_overholdt = samlet_dagegrænse_lovlig,
        betingelser_opfyldt = betingelser_opfyldt,
        udfald = hvis betingelser_opfyldt { Ll33ALempelsesberettigetPeriode } ellers { Ll33AAfvistPeriode }
    )
}
| ligningslov33a_periodevurderinger(ophold: Ligningslov33AOphold) -> map(
    ligningslov33a_kandidatstartdatoer(ophold),
    |kandidatstart_dato: Dato| ligningslov33a_periodevurdering(ophold, kandidatstart_dato)
)
| ligningslov33a_udrejsedato_valgt_antal(valgte_udrejsedatoer: List(Dato), udrejsedato: Dato) -> foldl(valgte_udrejsedatoer, 0, |antal: Heltal, valgt: Dato| antal + hvis valgt == udrejsedato { 1 } ellers { 0 })
| ligningslov33a_valgte_udrejsedatoer_entydige(valgte_udrejsedatoer: List(Dato)) -> all(valgte_udrejsedatoer, |udrejsedato: Dato| ligningslov33a_udrejsedato_valgt_antal(valgte_udrejsedatoer, udrejsedato) == 1)
| ligningslov33a_udrejsedato_er_kandidat(udrejsedato: Dato, periodevurderinger: List(Ligningslov33APeriodevurdering)) -> any(periodevurderinger, |vurdering: Ligningslov33APeriodevurdering| vurdering.kandidatstart_dato == udrejsedato)
| ligningslov33a_periodevalg_kandidatdatoer_gyldige(valg: Ligningslov33APeriodevalg, periodevurderinger: List(Ligningslov33APeriodevurdering)) -> length(valg.valgte_udrejsedatoer) > 0 && ligningslov33a_valgte_udrejsedatoer_entydige(valg.valgte_udrejsedatoer) && valg.valgte_udrejsedatoer == sort_by(valg.valgte_udrejsedatoer, |udrejsedato: Dato| dato_nøgle(udrejsedato)) && all(valg.valgte_udrejsedatoer, |udrejsedato: Dato| ligningslov33a_udrejsedato_er_kandidat(udrejsedato, periodevurderinger))
| ligningslov33a_valgte_periodevurderinger(ophold: Ligningslov33AOphold, valg: Ligningslov33APeriodevalg, periodevurderinger: List(Ligningslov33APeriodevurdering)) -> hvis ligningslov33a_periodevalg_kandidatdatoer_gyldige(valg, periodevurderinger) {
    map(valg.valgte_udrejsedatoer, |udrejsedato: Dato| ligningslov33a_periodevurdering(ophold, udrejsedato))
} ellers {
    []
}
| ligningslov33a_periodevurdering_kan_følges_af(første: Ligningslov33APeriodevurdering, næste: Ligningslov33APeriodevurdering) -> dato_før(første.vurderet_ophold.til_dato, næste.vurderet_ophold.fra_dato) || match første.afbrydelse {
    | Some(afbrydelse) -> første.vurderet_ophold.til_dato == næste.vurderet_ophold.fra_dato && afbrydelse.ny_udrejsedato == næste.kandidatstart_dato
    | None -> Falskt
}
| ligningslov33a_valgte_periodevurderinger_uden_overlap(vurderinger: List(Ligningslov33APeriodevurdering)) -> all(
    vurderinger,
    |vurdering: Ligningslov33APeriodevurdering| all(
        vurderinger,
        |anden: Ligningslov33APeriodevurdering| vurdering.kandidatstart_dato == anden.kandidatstart_dato || hvis dato_før(vurdering.kandidatstart_dato, anden.kandidatstart_dato) {
            ligningslov33a_periodevurdering_kan_følges_af(vurdering, anden)
        } ellers {
            ligningslov33a_periodevurdering_kan_følges_af(anden, vurdering)
        }
    )
)
| ligningslov33a_periodevalg_input_gyldigt(valg: Ligningslov33APeriodevalg, periodevurderinger: List(Ligningslov33APeriodevurdering), valgte_periodevurderinger: List(Ligningslov33APeriodevurdering)) -> ligningslov33a_periodevalg_kandidatdatoer_gyldige(valg, periodevurderinger) && length(valgte_periodevurderinger) == length(valg.valgte_udrejsedatoer) && ligningslov33a_valgte_periodevurderinger_uden_overlap(valgte_periodevurderinger)
| ligningslov33a_højeste_antal_danske_dage_i_seksmånedersvindue(ophold: Ligningslov33AOphold) -> foldl(ligningslov33a_seksmåneders_vinduestarter(ophold), 0, |højeste: Heltal, startdato: Dato| penge_største_beløb(højeste, ligningslov33a_danske_dage_i_seksmånedersvindue(ophold, startdato)))
| ligningslov33a_alle_seksmånedersvinduer_overholder_42_dage(ophold: Ligningslov33AOphold) -> all(ligningslov33a_seksmåneders_vinduestarter(ophold), |startdato: Dato| ligningslov33a_danske_dage_i_seksmånedersvindue(ophold, startdato) <= 42)
| ligningslov33a_fulde_ekstra_opholdsmåneder(ophold: Ligningslov33AOphold) -> penge_positivt_beløb(ligningslov33a_ophold_fulde_måneder(ophold) - 6)
| ligningslov33a_forholdsmæssigt_tillæg_for_delmåned(ophold: Ligningslov33AOphold) -> {
    = fulde_opholdsmåneder = ligningslov33a_ophold_fulde_måneder(ophold)
    = delmåned_start = dato_plus_måneder(ophold.fra_dato, fulde_opholdsmåneder)
    = næste_opholdsmåneds_slut_eksklusiv = dato_plus_måneder(ophold.fra_dato, fulde_opholdsmåneder + 1)
    = delmåned_dage = dato_faktiske_dage_mellem(delmåned_start, ligningslov33a_ophold_slut_eksklusiv(ophold))
    = hel_opholdsmåned_dage = dato_faktiske_dage_mellem(delmåned_start, næste_opholdsmåneds_slut_eksklusiv)
    hvis fulde_opholdsmåneder >= 6 && hel_opholdsmåned_dage > 0 {
        delmåned_dage * 7 / hel_opholdsmåned_dage
    } ellers {
        0
    }
}
| ligningslov33a_samlet_tilladt_antal_danske_dage(ophold: Ligningslov33AOphold) -> 42 + ligningslov33a_fulde_ekstra_opholdsmåneder(ophold) * 7 + ligningslov33a_forholdsmæssigt_tillæg_for_delmåned(ophold)
| ligningslov33a_samlet_dagegrænse_overholdt(ophold: Ligningslov33AOphold) -> length(ligningslov33a_medregnede_danske_opholdsdage(ophold)) <= ligningslov33a_samlet_tilladt_antal_danske_dage(ophold)
| ligningslov33a_ophold_input_gyldigt(ophold: Ligningslov33AOphold) -> dato_gyldig(ophold.fra_dato) && dato_gyldig(ophold.til_dato) && dato_før_eller_lig_med(ophold.fra_dato, ophold.til_dato) && ophold.dokumentreference != "" && ligningslov33a_arbejdsgiverforbindelse_input_gyldig(ophold.arbejdsgiverforbindelse) && ligningslov33a_skattepligtsstatus_input_gyldig(ophold.skattepligt, ophold) && ligningslov33a_covidvalg_input_gyldigt(ophold.covidvalg) && ligningslov33a_danske_opholdsdage_entydige(ophold.danske_opholdsdage) && all(ophold.danske_opholdsdage, |dag: Ligningslov33ADanskOpholdsdag| ligningslov33a_dansk_opholdsdag_input_gyldig(dag, ophold))
| ligningslov33a_ophold_betingelser_opfyldt(ophold: Ligningslov33AOphold) -> ligningslov33a_ophold_input_gyldigt(ophold) && ligningslov33a_mindst_seks_måneders_udlandsophold(ophold) && ligningslov33a_danske_opholdsdage_lovlige(ophold) && ligningslov33a_alle_seksmånedersvinduer_overholder_42_dage(ophold) && ligningslov33a_samlet_dagegrænse_overholdt(ophold) && ligningslov33a_arbejdsgiverforbindelse_opfyldt(ophold.arbejdsgiverforbindelse) && ligningslov33a_tjenesteforhold_omfattet(ophold.tjenesteforhold) && ligningslov33a_skattepligt_omfattet(ophold.skattepligt)
| ligningslov33a_daterede_indkomstperioder_overlapper(venstre: Ligningslov33ADateretIndkomstfordeling, højre: Ligningslov33ADateretIndkomstfordeling) -> dato_før_eller_lig_med(venstre.fra_dato, højre.til_dato) && dato_før_eller_lig_med(højre.fra_dato, venstre.til_dato)
| ligningslov33a_dateret_indkomstidentifikation_antal(perioder: List(Ligningslov33ADateretIndkomstfordeling), identifikation: Tekst) -> foldl(perioder, 0, |antal: Heltal, periode: Ligningslov33ADateretIndkomstfordeling| antal + hvis periode.identifikation == identifikation { 1 } ellers { 0 })
| ligningslov33a_daterede_indkomstidentifikationer_entydige(perioder: List(Ligningslov33ADateretIndkomstfordeling)) -> all(perioder, |periode: Ligningslov33ADateretIndkomstfordeling| ligningslov33a_dateret_indkomstidentifikation_antal(perioder, periode.identifikation) == 1)
| ligningslov33a_daterede_indkomstperioder_uden_overlap(perioder: List(Ligningslov33ADateretIndkomstfordeling)) -> all(
    perioder,
    |periode: Ligningslov33ADateretIndkomstfordeling| all(
        perioder,
        |anden: Ligningslov33ADateretIndkomstfordeling| periode.identifikation == anden.identifikation || ligningslov33a_daterede_indkomstperioder_overlapper(periode, anden) == Falskt
    )
)
| ligningslov33a_dateret_indkomstperiode_ligger_i_ophold_og_indkomstår(periode: Ligningslov33ADateretIndkomstfordeling, ophold: Ligningslov33AOphold, indkomstår: Heltal) -> periode.fra_dato.år == indkomstår && periode.til_dato.år == indkomstår && ligningslov33a_dato_i_lukket_periode(periode.fra_dato, ophold.fra_dato, ophold.til_dato) && ligningslov33a_dato_i_lukket_periode(periode.til_dato, ophold.fra_dato, ophold.til_dato)
| ligningslov33a_lempelsesberettigede_periodevurderinger(vurderinger: List(Ligningslov33APeriodevurdering)) -> filter(vurderinger, |vurdering: Ligningslov33APeriodevurdering| vurdering.betingelser_opfyldt)
| ligningslov33a_dateret_indkomstperiode_indeholdt_i_vurderet_ophold(periode: Ligningslov33ADateretIndkomstfordeling, vurdering: Ligningslov33APeriodevurdering) -> dato_efter_eller_lig_med(periode.fra_dato, vurdering.vurderet_ophold.fra_dato) && dato_før_eller_lig_med(periode.til_dato, vurdering.vurderet_ophold.til_dato)
| ligningslov33a_dateret_indkomstperiode_overlapper_vurderet_ophold(periode: Ligningslov33ADateretIndkomstfordeling, vurdering: Ligningslov33APeriodevurdering) -> dato_før_eller_lig_med(periode.fra_dato, vurdering.vurderet_ophold.til_dato) && dato_før_eller_lig_med(vurdering.vurderet_ophold.fra_dato, periode.til_dato)
| ligningslov33a_dateret_indkomstperiode_indeholdt_i_lempelsesperiode(periode: Ligningslov33ADateretIndkomstfordeling, vurderinger: List(Ligningslov33APeriodevurdering)) -> any(
    ligningslov33a_lempelsesberettigede_periodevurderinger(vurderinger),
    |vurdering: Ligningslov33APeriodevurdering| ligningslov33a_dateret_indkomstperiode_indeholdt_i_vurderet_ophold(periode, vurdering)
)
| ligningslov33a_dateret_indkomstperiode_overlapper_lempelsesperiode(periode: Ligningslov33ADateretIndkomstfordeling, vurderinger: List(Ligningslov33APeriodevurdering)) -> any(
    ligningslov33a_lempelsesberettigede_periodevurderinger(vurderinger),
    |vurdering: Ligningslov33APeriodevurdering| ligningslov33a_dateret_indkomstperiode_overlapper_vurderet_ophold(periode, vurdering)
)
| ligningslov33a_dateret_indkomstperiode_afgrænset_mod_skattepligt(periode: Ligningslov33ADateretIndkomstfordeling, skattepligt: Ligningslov33ASkattepligtsstatus) -> match skattepligt {
    | Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet -> Sandt
    | Ll33ASkattepligtEfterKildeskattelovensPar1OphørteUnderOpholdet(første_dato_uden_skattepligt) -> dato_før(periode.til_dato, første_dato_uden_skattepligt) || dato_efter_eller_lig_med(periode.fra_dato, første_dato_uden_skattepligt)
    | Ll33AIkkeSkattepligtigEfterKildeskattelovensPar1 -> Sandt
}
| ligningslov33a_dateret_indkomstperiode_inden_for_skattepligt(periode: Ligningslov33ADateretIndkomstfordeling, skattepligt: Ligningslov33ASkattepligtsstatus) -> match skattepligt {
    | Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet -> Sandt
    | Ll33ASkattepligtEfterKildeskattelovensPar1OphørteUnderOpholdet(første_dato_uden_skattepligt) -> dato_før(periode.til_dato, første_dato_uden_skattepligt)
    | Ll33AIkkeSkattepligtigEfterKildeskattelovensPar1 -> Falskt
}
| ligningslov33a_dateret_indkomstperiode_afgrænset_entydigt(periode: Ligningslov33ADateretIndkomstfordeling, vurderinger: List(Ligningslov33APeriodevurdering), skattepligt: Ligningslov33ASkattepligtsstatus) -> {
    = indeholdt = ligningslov33a_dateret_indkomstperiode_indeholdt_i_lempelsesperiode(periode, vurderinger)
    = overlapper = ligningslov33a_dateret_indkomstperiode_overlapper_lempelsesperiode(periode, vurderinger)
    ligningslov33a_dateret_indkomstperiode_afgrænset_mod_skattepligt(periode, skattepligt) && (indeholdt || overlapper == Falskt)
}
| ligningslov33a_indkomstperiodevurdering(periode: Ligningslov33ADateretIndkomstfordeling, vurderinger: List(Ligningslov33APeriodevurdering), skattepligt: Ligningslov33ASkattepligtsstatus) -> {
    = afgrænset_entydigt = ligningslov33a_dateret_indkomstperiode_afgrænset_entydigt(periode, vurderinger, skattepligt)
    = inden_for_skattepligtig_periode = ligningslov33a_dateret_indkomstperiode_inden_for_skattepligt(periode, skattepligt)
    = indeholdt_i_lempelsesperiode = ligningslov33a_dateret_indkomstperiode_indeholdt_i_lempelsesperiode(periode, vurderinger)
    Ligningslov33AIndkomstperiodevurdering(
        periode = periode,
        afgrænset_entydigt = afgrænset_entydigt,
        inden_for_skattepligtig_periode = inden_for_skattepligtig_periode,
        indeholdt_i_lempelsesberettiget_periode = indeholdt_i_lempelsesperiode,
        udfald = hvis afgrænset_entydigt == Falskt {
            Ll33AUgyldigtAfgrænsetIndkomstperiode
        } ellers hvis inden_for_skattepligtig_periode && indeholdt_i_lempelsesperiode {
            Ll33ALempelsesberettigetIndkomstperiode
        } ellers {
            Ll33AIkkeLempelsesberettigetIndkomstperiode
        }
    )
}
| ligningslov33a_indkomstperiodevurderinger(grundlag: Ligningslov33AIndkomstgrundlag, vurderinger: List(Ligningslov33APeriodevurdering), skattepligt: Ligningslov33ASkattepligtsstatus) -> match grundlag {
    | Ll33ASamletIndkomstForUafbrudtLempelsesperiode(_) -> []
