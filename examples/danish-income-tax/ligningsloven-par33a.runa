        sort_by(perioder, |periode: Ligningslov33ADateretIndkomstfordeling| dato_nøgle(periode.fra_dato)),
        |periode: Ligningslov33ADateretIndkomstfordeling| ligningslov33a_indkomstperiodevurdering(periode, vurderinger, skattepligt)
    )
}
| ligningslov33a_dateret_indkomstperiode_input_gyldig(periode: Ligningslov33ADateretIndkomstfordeling, ophold: Ligningslov33AOphold, indkomstår: Heltal, vurderinger: List(Ligningslov33APeriodevurdering)) -> periode.identifikation != "" && periode.dokumentreference != "" && dato_gyldig(periode.fra_dato) && dato_gyldig(periode.til_dato) && dato_før_eller_lig_med(periode.fra_dato, periode.til_dato) && ligningslov33a_dateret_indkomstperiode_ligger_i_ophold_og_indkomstår(periode, ophold, indkomstår) && ligningslov33a_indkomstfordeling_input_gyldig(periode.fordeling) && ligningslov33a_dateret_indkomstperiode_afgrænset_entydigt(periode, vurderinger, ophold.skattepligt)
| ligningslov33a_daterede_indkomstperioder_input_gyldige(perioder: List(Ligningslov33ADateretIndkomstfordeling), ophold: Ligningslov33AOphold, indkomstår: Heltal, vurderinger: List(Ligningslov33APeriodevurdering)) -> length(perioder) > 0 && ligningslov33a_daterede_indkomstidentifikationer_entydige(perioder) && ligningslov33a_daterede_indkomstperioder_uden_overlap(perioder) && all(perioder, |periode: Ligningslov33ADateretIndkomstfordeling| ligningslov33a_dateret_indkomstperiode_input_gyldig(periode, ophold, indkomstår, vurderinger))
| ligningslov33a_periodevurdering_dækker_hele_opholdet(vurdering: Ligningslov33APeriodevurdering, ophold: Ligningslov33AOphold) -> vurdering.betingelser_opfyldt && vurdering.afbrydelse == None && vurdering.vurderet_ophold.fra_dato == ophold.fra_dato && vurdering.vurderet_ophold.til_dato == ophold.til_dato
| ligningslov33a_skattepligt_dækker_hele_opholdet(skattepligt: Ligningslov33ASkattepligtsstatus) -> skattepligt == Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet
| ligningslov33a_aggregeret_indkomst_kan_afgrænses(ophold: Ligningslov33AOphold, vurderinger: List(Ligningslov33APeriodevurdering)) -> {
    = lempelsesberettigede_vurderinger = ligningslov33a_lempelsesberettigede_periodevurderinger(vurderinger)
    length(lempelsesberettigede_vurderinger) == 0 || (ligningslov33a_periodevurdering_dækker_hele_opholdet(head(vurderinger), ophold) && ligningslov33a_skattepligt_dækker_hele_opholdet(ophold.skattepligt))
}
| ligningslov33a_indkomstgrundlag_input_gyldigt(grundlag: Ligningslov33AIndkomstgrundlag, ophold: Ligningslov33AOphold, indkomstår: Heltal, vurderinger: List(Ligningslov33APeriodevurdering)) -> match grundlag {
    | Ll33ASamletIndkomstForUafbrudtLempelsesperiode(fordeling) -> ligningslov33a_indkomstfordeling_input_gyldig(fordeling) && ligningslov33a_aggregeret_indkomst_kan_afgrænses(ophold, vurderinger)
    | Ll33ADateredeIndkomstfordelinger(perioder) -> ligningslov33a_daterede_indkomstperioder_input_gyldige(perioder, ophold, indkomstår, vurderinger)
}
| ligningslov33a_dateret_indkomstperiode_lempelsesberettiget(periode: Ligningslov33ADateretIndkomstfordeling, vurderinger: List(Ligningslov33APeriodevurdering), skattepligt: Ligningslov33ASkattepligtsstatus) -> ligningslov33a_dateret_indkomstperiode_afgrænset_entydigt(periode, vurderinger, skattepligt) && ligningslov33a_dateret_indkomstperiode_inden_for_skattepligt(periode, skattepligt) && ligningslov33a_dateret_indkomstperiode_indeholdt_i_lempelsesperiode(periode, vurderinger)
| ligningslov33a_dateret_lempelsesberettiget_indkomst(perioder: List(Ligningslov33ADateretIndkomstfordeling), vurderinger: List(Ligningslov33APeriodevurdering), skattepligt: Ligningslov33ASkattepligtsstatus) -> foldl(
    perioder,
    ligningslov33a_tom_lønindkomst(),
    |sum: Ligningslov33ALønindkomstEfterDanskeRegler, periode: Ligningslov33ADateretIndkomstfordeling| ligningslov33a_lønindkomst_læg_sammen(
        sum,
        hvis ligningslov33a_dateret_indkomstperiode_lempelsesberettiget(periode, vurderinger, skattepligt) {
            ligningslov33a_lempelsesberettiget_indkomst(periode.fordeling)
        } ellers {
            ligningslov33a_tom_lønindkomst()
        }
    )
)
| ligningslov33a_indkomstgrundlag_lempelsesberettiget_indkomst(grundlag: Ligningslov33AIndkomstgrundlag, vurderinger: List(Ligningslov33APeriodevurdering), skattepligt: Ligningslov33ASkattepligtsstatus) -> match grundlag {
    | Ll33ASamletIndkomstForUafbrudtLempelsesperiode(fordeling) -> ligningslov33a_lempelsesberettiget_indkomst(fordeling)
    | Ll33ADateredeIndkomstfordelinger(perioder) -> ligningslov33a_dateret_lempelsesberettiget_indkomst(perioder, vurderinger, skattepligt)
}
| ligningslov33a_ansættelsesforhold_overlapper_indkomstår(fakta: Ligningslov33AAnsættelsesforhold, indkomstår: Heltal) -> fakta.ophold.fra_dato.år <= indkomstår && fakta.ophold.til_dato.år >= indkomstår
| ligningslov33a_ansættelsesforhold_input_gyldigt_med_periodevalg(fakta: Ligningslov33AAnsættelsesforhold, indkomstår: Heltal, periodevurderinger: List(Ligningslov33APeriodevurdering), valgte_periodevurderinger: List(Ligningslov33APeriodevurdering)) -> fakta.identifikation != "" && indkomstår > 0 && ligningslov33a_subjekt_omfattet(fakta.subjekt) && ligningslov33a_ophold_input_gyldigt(fakta.ophold) && ligningslov33a_periodevalg_input_gyldigt(fakta.periodevalg, periodevurderinger, valgte_periodevurderinger) && ligningslov33a_ansættelsesforhold_overlapper_indkomstår(fakta, indkomstår) && ligningslov33a_offentligt_arbejdsgivergrundlag_input_gyldigt(fakta.arbejdsgivergrundlag) && ligningslov33a_beskatningsret_input_gyldig(fakta.beskatningsret) && ligningslov33a_indkomstgrundlag_input_gyldigt(fakta.indkomstgrundlag, fakta.ophold, indkomstår, valgte_periodevurderinger) && ligningslov33a_henstandsstatus_input_gyldig(fakta.henstand)
| ligningslov33a_ansættelsesforhold_input_gyldigt(fakta: Ligningslov33AAnsættelsesforhold, indkomstår: Heltal) -> {
    = periodevurderinger = ligningslov33a_periodevurderinger(fakta.ophold)
    = valgte_periodevurderinger = ligningslov33a_valgte_periodevurderinger(fakta.ophold, fakta.periodevalg, periodevurderinger)
    ligningslov33a_ansættelsesforhold_input_gyldigt_med_periodevalg(fakta, indkomstår, periodevurderinger, valgte_periodevurderinger)
}
| ligningslov33a_ansættelsesforhold_betingelser_opfyldt_med_periodevalg(fakta: Ligningslov33AAnsættelsesforhold, valgte_periodevurderinger: List(Ligningslov33APeriodevurdering), input_gyldigt: Boolsk) -> input_gyldigt && any(valgte_periodevurderinger, |vurdering: Ligningslov33APeriodevurdering| vurdering.betingelser_opfyldt) && ligningslov33a_stk2_udelukker(fakta.arbejdsgivergrundlag) == Falskt
| ligningslov33a_ansættelsesforhold_betingelser_opfyldt(fakta: Ligningslov33AAnsættelsesforhold, indkomstår: Heltal) -> {
    = periodevurderinger = ligningslov33a_periodevurderinger(fakta.ophold)
    = valgte_periodevurderinger = ligningslov33a_valgte_periodevurderinger(fakta.ophold, fakta.periodevalg, periodevurderinger)
    = input_gyldigt = ligningslov33a_ansættelsesforhold_input_gyldigt_med_periodevalg(fakta, indkomstår, periodevurderinger, valgte_periodevurderinger)
    ligningslov33a_ansættelsesforhold_betingelser_opfyldt_med_periodevalg(fakta, valgte_periodevurderinger, input_gyldigt)
}
| ligningslov33a_forholdsresultat(fakta: Ligningslov33AAnsættelsesforhold, indkomstår: Heltal) -> {
    = periodevurderinger = ligningslov33a_periodevurderinger(fakta.ophold)
    = valgte_periodevurderinger = ligningslov33a_valgte_periodevurderinger(fakta.ophold, fakta.periodevalg, periodevurderinger)
    = indkomstperiodevurderinger = ligningslov33a_indkomstperiodevurderinger(fakta.indkomstgrundlag, valgte_periodevurderinger, fakta.ophold.skattepligt)
    = input_gyldigt = ligningslov33a_ansættelsesforhold_input_gyldigt_med_periodevalg(fakta, indkomstår, periodevurderinger, valgte_periodevurderinger)
    = betingelser_opfyldt = ligningslov33a_ansættelsesforhold_betingelser_opfyldt_med_periodevalg(fakta, valgte_periodevurderinger, input_gyldigt)
    Ligningslov33AForholdsresultat(
        fakta = fakta,
        periodevurderinger = periodevurderinger,
        valgte_periodevurderinger = valgte_periodevurderinger,
        indkomstperiodevurderinger = indkomstperiodevurderinger,
        input_gyldigt = input_gyldigt,
        mindst_en_kandidatperiode_på_seks_måneder = any(periodevurderinger, |vurdering: Ligningslov33APeriodevurdering| vurdering.mindst_seks_måneders_udlandsophold),
        oprindeligt_opholds_danske_opholdsdage_lovlige = ligningslov33a_danske_opholdsdage_lovlige(fakta.ophold),
        oprindeligt_opholds_højeste_antal_danske_dage_i_afsluttet_seksmånedersperiode = ligningslov33a_højeste_antal_danske_dage_i_seksmånedersvindue(fakta.ophold),
        oprindeligt_opholds_samlet_antal_medregnede_danske_dage = length(ligningslov33a_medregnede_danske_opholdsdage(fakta.ophold)),
        oprindeligt_opholds_samlet_tilladt_antal_danske_dage = ligningslov33a_samlet_tilladt_antal_danske_dage(fakta.ophold),
        oprindeligt_opholds_samlet_dagegrænse_overholdt = ligningslov33a_samlet_dagegrænse_overholdt(fakta.ophold),
        arbejdsgiverforbindelse_opfyldt = ligningslov33a_arbejdsgiverforbindelse_opfyldt(fakta.ophold.arbejdsgiverforbindelse),
        tjenesteforhold_omfattet = ligningslov33a_tjenesteforhold_omfattet(fakta.ophold.tjenesteforhold),
        skattepligt_omfattet = ligningslov33a_skattepligt_omfattet(fakta.ophold.skattepligt),
        stk2_udelukker = ligningslov33a_stk2_udelukker(fakta.arbejdsgivergrundlag),
        betingelser_opfyldt = betingelser_opfyldt,
        lempelsesandel_basispoint = hvis betingelser_opfyldt { ligningslov33a_lempelsesandel_basispoint(fakta.arbejdsgivergrundlag, fakta.beskatningsret) } ellers { 0 },
        lempelsesberettiget_indkomst_efter_danske_regler = hvis betingelser_opfyldt { ligningslov33a_indkomstgrundlag_lempelsesberettiget_indkomst(fakta.indkomstgrundlag, valgte_periodevurderinger, fakta.ophold.skattepligt) } ellers { ligningslov33a_tom_lønindkomst() }
    )
}
| ligningslov33a_forholdsresultater(input: Ligningslov33AÅrsinput) -> map(input.ansættelsesforhold, |fakta: Ligningslov33AAnsættelsesforhold| ligningslov33a_forholdsresultat(fakta, input.indkomstår))
| ligningslov33a_ansættelsesidentifikation_antal(forhold: List(Ligningslov33AAnsættelsesforhold), identifikation: Tekst) -> foldl(forhold, 0, |antal: Heltal, fakta: Ligningslov33AAnsættelsesforhold| antal + hvis fakta.identifikation == identifikation { 1 } ellers { 0 })
| ligningslov33a_ansættelsesidentifikationer_entydige(forhold: List(Ligningslov33AAnsættelsesforhold)) -> all(forhold, |fakta: Ligningslov33AAnsættelsesforhold| ligningslov33a_ansættelsesidentifikation_antal(forhold, fakta.identifikation) == 1)
| ligningslov33a_aggregeret_indkomst(resultater: List(Ligningslov33AForholdsresultat), lempelsesandel_basispoint: Heltal) -> foldl(
    resultater,
    ligningslov33a_tom_lønindkomst(),
    |sum: Ligningslov33ALønindkomstEfterDanskeRegler, resultat: Ligningslov33AForholdsresultat| ligningslov33a_lønindkomst_læg_sammen(sum, hvis resultat.lempelsesandel_basispoint == lempelsesandel_basispoint { resultat.lempelsesberettiget_indkomst_efter_danske_regler } ellers { ligningslov33a_tom_lønindkomst() })
)
| ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(grundlag: Ligningslov33DanskBeregningsgrundlag, indkomst: Ligningslov33ALønindkomstEfterDanskeRegler) -> match grundlag {
    | Ll33SkattepligtigIndkomst(_) -> indkomst.skattepligtig_nettoindkomst_kroner
    | Ll33PersonligIndkomst(_) -> indkomst.personlig_nettoindkomst_kroner
    | Ll33PersonligOgPositivKapitalindkomst(_) -> indkomst.personlig_nettoindkomst_kroner
    | Ll33Aktieindkomst(_) -> 0
    | Ll33CfcIndkomst(_) -> 0
    | Ll33Arbejdsmarkedsbidragsgrundlag(_) -> indkomst.arbejdsmarkedsbidragsgrundlag_kroner
}
| ligningslov33a_komponent_indkomstgrundlag_gyldigt(komponent: Ligningslov33DanskSkattekomponent, fuld: Ligningslov33ALønindkomstEfterDanskeRegler, halv: Ligningslov33ALønindkomstEfterDanskeRegler) -> ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, fuld) + ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, halv) <= ligningslov33_dansk_beregningsgrundlag_kroner(komponent.beregningsgrundlag)
| ligningslov33a_komponent_beregning(komponent: Ligningslov33DanskSkattekomponent, fuld: Ligningslov33ALønindkomstEfterDanskeRegler, halv: Ligningslov33ALønindkomstEfterDanskeRegler, input_gyldigt: Boolsk) -> {
    = samlet_indkomst_kroner = ligningslov33_dansk_beregningsgrundlag_kroner(komponent.beregningsgrundlag)
    = fuldt_lempelsesberettiget_indkomst_kroner = ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, fuld)
    = halvt_lempelsesberettiget_indkomst_kroner = ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, halv)
    hvis input_gyldigt && samlet_indkomst_kroner > 0 && fuldt_lempelsesberettiget_indkomst_kroner + halvt_lempelsesberettiget_indkomst_kroner > 0 {
        penge_øre_beregning(
            komponent.dansk_skat_før_personfradrag_øre * (fuldt_lempelsesberettiget_indkomst_kroner * 10000 + halvt_lempelsesberettiget_indkomst_kroner * 5000),
            samlet_indkomst_kroner * 10000
        )
    } ellers {
        penge_øre_beregning(0, 1)
    }
}
| ligningslov33a_komponentresultat(komponent: Ligningslov33DanskSkattekomponent, fuld: Ligningslov33ALønindkomstEfterDanskeRegler, halv: Ligningslov33ALønindkomstEfterDanskeRegler, input_gyldigt: Boolsk) -> {
    = beregning = ligningslov33a_komponent_beregning(komponent, fuld, halv, input_gyldigt)
    Ligningslov33AKomponentresultat(
        komponent = komponent,
        fuldt_lempelsesberettiget_indkomst_kroner = hvis input_gyldigt { ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, fuld) } ellers { 0 },
        halvt_lempelsesberettiget_indkomst_kroner = hvis input_gyldigt { ligningslov33a_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, halv) } ellers { 0 },
        forholdsmæssig_beregning = beregning,
        nedslag_øre = beregning.øre_nedrundet
    )
}
| ligningslov33a_komponentresultater(skattekreds: Ligningslov33PersonDanskSkattekreds, fuld: Ligningslov33ALønindkomstEfterDanskeRegler, halv: Ligningslov33ALønindkomstEfterDanskeRegler, input_gyldigt: Boolsk) -> map(skattekreds.komponenter, |komponent: Ligningslov33DanskSkattekomponent| ligningslov33a_komponentresultat(komponent, fuld, halv, input_gyldigt))
| ligningslov33a_samlet_komponentnedslag_øre(komponenter: List(Ligningslov33AKomponentresultat)) -> foldl(komponenter, 0, |sum_øre: Heltal, komponent: Ligningslov33AKomponentresultat| sum_øre + komponent.nedslag_øre)
| ligningslov33a_årsresultat(input: Ligningslov33AÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds) -> {
    = forholdsresultater = ligningslov33a_forholdsresultater(input)
    = fuld = ligningslov33a_aggregeret_indkomst(forholdsresultater, 10000)
    = halv = ligningslov33a_aggregeret_indkomst(forholdsresultater, 5000)
    = grundinput_gyldigt = input.indkomstår > 0 && ligningslov33a_ansættelsesidentifikationer_entydige(input.ansættelsesforhold) && all(forholdsresultater, |resultat: Ligningslov33AForholdsresultat| resultat.input_gyldigt) && ligningslov33_person_dansk_skattekreds_gyldig(skattekreds)
    = komponentgrundlag_gyldigt = all(skattekreds.komponenter, |komponent: Ligningslov33DanskSkattekomponent| ligningslov33a_komponent_indkomstgrundlag_gyldigt(komponent, fuld, halv))
    = input_gyldigt = grundinput_gyldigt && komponentgrundlag_gyldigt
    = komponenter = ligningslov33a_komponentresultater(skattekreds, fuld, halv, input_gyldigt)
    = samlet_nedslag_før_skattecap_øre = hvis input_gyldigt { ligningslov33a_samlet_komponentnedslag_øre(komponenter) } ellers { 0 }
    Ligningslov33AÅrsresultat(
        input = input,
        dansk_skattekreds = skattekreds,
        forholdsresultater = forholdsresultater,
        fuldt_lempelsesberettiget_indkomst = fuld,
        halvt_lempelsesberettiget_indkomst = halv,
        komponenter = komponenter,
        input_gyldigt = input_gyldigt,
        alle_forhold_lempelsesberettigede = all(forholdsresultater, |resultat: Ligningslov33AForholdsresultat| resultat.betingelser_opfyldt),
        samlet_nedslag_før_skattecap_øre = samlet_nedslag_før_skattecap_øre,
        samlet_nedslag_øre = penge_mindste_beløb(samlet_nedslag_før_skattecap_øre, skattekreds.samlet_dansk_indkomstskat_tilgængelig_øre)
    )
}

--@end:ligningsloven_par33a_aarsberegning--
