@ sprog da

@ importer ./ligningsloven - par33
@ importer ./metadata

= ligningslov33_fragtskat_scenarier_metadata = Metadata(
    attachments = (
        Source(value = ligningsloven_lbk1500_par33),
        AmendmentSource(value = ligningsloven_lov487_1996_par33_fragtskat),
        AmendmentSource(value = ligningsloven_lov313_2002_par33_fragtskat),
        Guidance(value = ligningsloven_vejledning_par33_credit),
        Guidance(value = ligningsloven_vejledning_par33_personberegning),
    )
)

--@label:ligningslov33_fragtskat_scenarier::meta:ligningslov33_fragtskat_scenarier_metadata--
----
Scenarierne er ikke lovtekst. De fastholder den årsopdelte saldo for fragtskat
efter ligningslovens § 33, stk. 9, uden at indføre en udløbsfrist eller en
anvendelsesrækkefølge, som ikke findes i den gældende bestemmelse.
----

--@begin:ligningslov33_fragtskat_scenarier--

| ll33_fragtskat_scenarie_indkomst() -> Ligningslov33UdenlandskIndkomstEfterDanskeRegler(
    skattepligtig_nettoindkomst_efter_par33f_kroner = 100000,
    personlig_nettoindkomst_efter_par33f_kroner = 0,
    positiv_kapitalnettoindkomst_efter_par33f_kroner = 0,
    aktienettoindkomst_efter_par33f_kroner = 0,
    cfc_nettoindkomst_efter_par33f_kroner = 0,
    arbejdsmarkedsbidragsgrundlag_kroner = 0
)
| ll33_fragtskat_scenarie_gruppe(identifikation: Tekst, område: Ligningslov33Skatteområde, skatteart: Ligningslov33UdenlandskSkatteart, betalt_skat_øre: Heltal, overenskomstgrundlag: Ligningslov33Overenskomstgrundlag) -> Ligningslov33PersonKreditgruppe(
    identifikation = identifikation,
    grupperingsgrundlag = Ll33SamletIndkomstFraSkatteområdet,
    fakta = Ligningslov33LandelinjeFakta(
        område = område,
        opkrævningsmåde = Ll33DirektePåligning,
        udenlandsk_bruttoindkomst_kroner = 100000,
        direkte_henførbare_udgifter_kroner = 0,
        betalt_udenlandsk_skat_øre = betalt_skat_øre,
        skatteart = skatteart,
        betalingsdokumentreference = "Fragtskattebilag " + identifikation,
        overenskomstgrundlag = overenskomstgrundlag
    ),
    udenlandsk_indkomst_efter_danske_regler = ll33_fragtskat_scenarie_indkomst(),
    lønlempelsesstatus = Ll33IngenLønindkomst
)
| ll33_fragtskat_scenarie_fragtskattegruppe(identifikation: Tekst, landekode: Tekst, betalt_fragtskat_øre: Heltal, overenskomstgrundlag: Ligningslov33Overenskomstgrundlag) -> ll33_fragtskat_scenarie_gruppe(
    identifikation,
    Ll33FremmedStat(landekode = landekode),
    Ll33FragtskatPåBruttofortjenesteVedInternationalSkibstrafik,
    betalt_fragtskat_øre,
    overenskomstgrundlag
)
| ll33_fragtskat_scenarie_skattekreds(dansk_skatteloft_øre: Heltal) -> Ligningslov33PersonDanskSkattekreds(
    komponenter = [Ligningslov33DanskSkattekomponent(
        art = Ll33KommunalIndkomstskat,
        beregningsgrundlag = Ll33SkattepligtigIndkomst(samlet_indkomst_kroner = 100000),
        dansk_skat_før_personfradrag_øre = dansk_skatteloft_øre
    )],
    samlet_dansk_indkomstskat_tilgængelig_øre = dansk_skatteloft_øre
)
| ll33_fragtskat_scenarie_årsinput(indkomstår: Heltal, kreditgrupper: List(Ligningslov33PersonKreditgruppe), åbningssaldi: List(Ligningslov33FragtskatSaldo)) -> Ligningslov33PersonÅrsinput(
    indkomstår = indkomstår,
    dansk_bruttoindkomst_kroner = 0,
    ikke_henførbare_udgifter_kroner = 0,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
    kreditgrupper = kreditgrupper,
    par6_kreditter = [],
    fragtskat_åbningssaldi = åbningssaldi
)
| ll33_fragtskat_scenarie_resultat(indkomstår: Heltal, kreditgrupper: List(Ligningslov33PersonKreditgruppe), åbningssaldi: List(Ligningslov33FragtskatSaldo), dansk_skatteloft_øre: Heltal) -> ligningslov33_person_årsresultat(
    ll33_fragtskat_scenarie_årsinput(indkomstår, kreditgrupper, åbningssaldi),
    ll33_fragtskat_scenarie_skattekreds(dansk_skatteloft_øre)
)
| ll33_fragtskat_scenarie_første_områderesultat(resultat: Ligningslov33PersonÅrsresultat) -> head(resultat.fragtskat_resultater)
| ll33_fragtskat_scenarie_første_ultimosaldo(resultat: Ligningslov33PersonÅrsresultat) -> head(resultat.fragtskat_ultimosaldi)

= ll33_fragtskat_scenarie_2025 = ll33_fragtskat_scenarie_resultat(
    2025,
    [ll33_fragtskat_scenarie_fragtskattegruppe("NO-2025", "NO", 4000000, Ll33IngenDobbeltbeskatningsoverenskomst)],
    [],
    2500000
)
= ll33_fragtskat_scenarie_2026 = ll33_fragtskat_scenarie_resultat(
    2026,
    [ll33_fragtskat_scenarie_fragtskattegruppe("NO-2026", "NO", 1000000, Ll33IngenDobbeltbeskatningsoverenskomst)],
    ll33_fragtskat_scenarie_2025.fragtskat_ultimosaldi,
    2500000
)
= ll33_fragtskat_scenarie_delvis_anvendelse = ll33_fragtskat_scenarie_resultat(
    2026,
    [ll33_fragtskat_scenarie_fragtskattegruppe("NO-delvis-2026", "NO", 1000000, Ll33IngenDobbeltbeskatningsoverenskomst)],
    ll33_fragtskat_scenarie_2025.fragtskat_ultimosaldi,
    1800000
)
= ll33_fragtskat_scenarie_uden_årets_fragtskat = ll33_fragtskat_scenarie_resultat(
    2026,
    [],
    ll33_fragtskat_scenarie_2025.fragtskat_ultimosaldi,
    0
)
= ll33_fragtskat_scenarie_2027_uden_årets_fragtskat = ll33_fragtskat_scenarie_resultat(2027, [], ll33_fragtskat_scenarie_uden_årets_fragtskat.fragtskat_ultimosaldi, 0)
= ll33_fragtskat_scenarie_2028_uden_årets_fragtskat = ll33_fragtskat_scenarie_resultat(2028, [], ll33_fragtskat_scenarie_2027_uden_årets_fragtskat.fragtskat_ultimosaldi, 0)
= ll33_fragtskat_scenarie_2029_uden_årets_fragtskat = ll33_fragtskat_scenarie_resultat(2029, [], ll33_fragtskat_scenarie_2028_uden_årets_fragtskat.fragtskat_ultimosaldi, 0)
= ll33_fragtskat_scenarie_2030_uden_årets_fragtskat = ll33_fragtskat_scenarie_resultat(2030, [], ll33_fragtskat_scenarie_2029_uden_årets_fragtskat.fragtskat_ultimosaldi, 0)
= ll33_fragtskat_scenarie_2031_uden_årets_fragtskat = ll33_fragtskat_scenarie_resultat(2031, [], ll33_fragtskat_scenarie_2030_uden_årets_fragtskat.fragtskat_ultimosaldi, 0)
= ll33_fragtskat_scenarie_forkert_saldoår = ll33_fragtskat_scenarie_resultat(
    2027,
    [],
    ll33_fragtskat_scenarie_2025.fragtskat_ultimosaldi,
    0
)
= ll33_fragtskat_scenarie_dobbelt_åbningssaldo = ll33_fragtskat_scenarie_resultat(
    2026,
    [],
    concat(
        ll33_fragtskat_scenarie_2025.fragtskat_ultimosaldi,
        [Ligningslov33FragtskatSaldo(
            område = Ll33FremmedStat(landekode = "NO"),
            indkomstår = 2025,
            saldo_øre = 100,
            dokumentreferencer = ["Andet fragtskattebilag"]
        )]
    ),
    0
)
= ll33_fragtskat_scenarie_grønland = ll33_fragtskat_scenarie_resultat(
    2026,
    [ll33_fragtskat_scenarie_gruppe(
        "GL-2026",
        Ll33Grønland,
        Ll33FragtskatPåBruttofortjenesteVedInternationalSkibstrafik,
        4000000,
        Ll33IngenDobbeltbeskatningsoverenskomst
    )],
    [],
    2500000
)
= ll33_fragtskat_scenarie_almindelig_indkomstskat = ll33_fragtskat_scenarie_resultat(
    2026,
    [ll33_fragtskat_scenarie_gruppe(
        "NO-indkomstskat-2026",
        Ll33FremmedStat(landekode = "NO"),
        Ll33Indkomstskat,
        4000000,
        Ll33IngenDobbeltbeskatningsoverenskomst
    )],
    [],
    2500000
)
= ll33_fragtskat_scenarie_overenskomstloft = ll33_fragtskat_scenarie_resultat(
    2026,
    [ll33_fragtskat_scenarie_fragtskattegruppe(
        "NO-overenskomst-2026",
        "NO",
        4000000,
        Ll33OverenskomstensUbetingedeKrav(
            maksimal_skat_øre = 2000000,
            dokumentreference = "Overenskomstloft NO-2026"
        )
    )],
    [],
    2500000
)

| ll33_fragtskat_scenarie_overskydende_fragtskat_fremføres: ll33_fragtskat_scenarie_2025 -> {
    = område = ll33_fragtskat_scenarie_første_områderesultat(ll33_fragtskat_scenarie_2025)
    = saldo = ll33_fragtskat_scenarie_første_ultimosaldo(ll33_fragtskat_scenarie_2025)
    ll33_fragtskat_scenarie_2025.input_gyldigt && område.årets_fragtskattenedslag_øre == 2500000 && område.årets_nye_fremførsel_øre == 1500000 && område.anvendt_fremført_fragtskat_øre == 0 && område.samlet_fragtskattenedslag_øre == 2500000 && ll33_fragtskat_scenarie_2025.samlet_nedslag_øre == 2500000 && saldo.område == Ll33FremmedStat(landekode = "NO") && saldo.indkomstår == 2025 && saldo.saldo_øre == 1500000 && saldo.dokumentreferencer == ["Fragtskattebilag NO-2025"]
}
| ll33_fragtskat_scenarie_fremført_saldo_udnyttes_efter_årets_fragtskat: ll33_fragtskat_scenarie_2026 -> {
    = område = ll33_fragtskat_scenarie_første_områderesultat(ll33_fragtskat_scenarie_2026)
    ll33_fragtskat_scenarie_2026.input_gyldigt && område.årets_fragtskattenedslag_øre == 1000000 && område.anvendt_fremført_fragtskat_øre == 1500000 && område.årets_nye_fremførsel_øre == 0 && område.samlet_fragtskattenedslag_øre == 2500000 && ll33_fragtskat_scenarie_2026.samlet_nedslag_øre == 2500000 && length(ll33_fragtskat_scenarie_2026.fragtskat_ultimosaldi) == 0
}
| ll33_fragtskat_scenarie_resterende_saldo_bevares: ll33_fragtskat_scenarie_delvis_anvendelse -> {
    = område = ll33_fragtskat_scenarie_første_områderesultat(ll33_fragtskat_scenarie_delvis_anvendelse)
    = saldo = ll33_fragtskat_scenarie_første_ultimosaldo(ll33_fragtskat_scenarie_delvis_anvendelse)
    ll33_fragtskat_scenarie_delvis_anvendelse.input_gyldigt && område.anvendt_fremført_fragtskat_øre == 800000 && område.samlet_fragtskattenedslag_øre == 1800000 && saldo.indkomstår == 2026 && saldo.saldo_øre == 700000 && saldo.dokumentreferencer == ["Fragtskattebilag NO-2025"]
}
| ll33_fragtskat_scenarie_saldo_bevares_uden_årets_fragtskat: ll33_fragtskat_scenarie_uden_årets_fragtskat -> {
    = område = ll33_fragtskat_scenarie_første_områderesultat(ll33_fragtskat_scenarie_uden_årets_fragtskat)
    = saldo = ll33_fragtskat_scenarie_første_ultimosaldo(ll33_fragtskat_scenarie_uden_årets_fragtskat)
    ll33_fragtskat_scenarie_uden_årets_fragtskat.input_gyldigt && område.kreditgruppe_identifikation == None && område.anvendt_fremført_fragtskat_øre == 0 && saldo.indkomstår == 2026 && saldo.saldo_øre == 1500000
}
| ll33_fragtskat_scenarie_saldo_udløber_ikke_efter_fem_år: ll33_fragtskat_scenarie_2031_uden_årets_fragtskat -> {
    = saldo = ll33_fragtskat_scenarie_første_ultimosaldo(ll33_fragtskat_scenarie_2031_uden_årets_fragtskat)
    ll33_fragtskat_scenarie_2031_uden_årets_fragtskat.input_gyldigt && saldo.indkomstår == 2031 && saldo.saldo_øre == 1500000 && saldo.dokumentreferencer == ["Fragtskattebilag NO-2025"]
}
| ll33_fragtskat_scenarie_saldo_skal_komme_fra_forrige_år: ll33_fragtskat_scenarie_forkert_saldoår -> ll33_fragtskat_scenarie_forkert_saldoår.input_gyldigt == Falskt && ll33_fragtskat_scenarie_forkert_saldoår.samlet_nedslag_øre == 0 && length(ll33_fragtskat_scenarie_forkert_saldoår.fragtskat_ultimosaldi) == 0
| ll33_fragtskat_scenarie_åbningssaldo_er_entydig_pr_stat: ll33_fragtskat_scenarie_dobbelt_åbningssaldo -> ll33_fragtskat_scenarie_dobbelt_åbningssaldo.input_gyldigt == Falskt && ll33_fragtskat_scenarie_dobbelt_åbningssaldo.samlet_nedslag_øre == 0 && length(ll33_fragtskat_scenarie_dobbelt_åbningssaldo.fragtskat_ultimosaldi) == 0
| ll33_fragtskat_scenarie_gælder_kun_fremmed_stat: ll33_fragtskat_scenarie_grønland -> ll33_fragtskat_scenarie_grønland.input_gyldigt == Falskt && ll33_fragtskat_scenarie_grønland.samlet_nedslag_øre == 0 && length(ll33_fragtskat_scenarie_grønland.fragtskat_ultimosaldi) == 0
| ll33_fragtskat_scenarie_almindelig_indkomstskat_fremføres_ikke: ll33_fragtskat_scenarie_almindelig_indkomstskat -> ll33_fragtskat_scenarie_almindelig_indkomstskat.input_gyldigt && ll33_fragtskat_scenarie_almindelig_indkomstskat.samlet_nedslag_øre == 2500000 && length(ll33_fragtskat_scenarie_almindelig_indkomstskat.fragtskat_resultater) == 0 && length(ll33_fragtskat_scenarie_almindelig_indkomstskat.fragtskat_ultimosaldi) == 0
| ll33_fragtskat_scenarie_overenskomstloft_skaber_ikke_saldo: ll33_fragtskat_scenarie_overenskomstloft -> {
    = område = ll33_fragtskat_scenarie_første_områderesultat(ll33_fragtskat_scenarie_overenskomstloft)
    ll33_fragtskat_scenarie_overenskomstloft.input_gyldigt && område.betalt_fragtskat_efter_overenskomst_øre == 2000000 && område.årets_fragtskattenedslag_øre == 2000000 && område.årets_nye_fremførsel_øre == 0 && length(ll33_fragtskat_scenarie_overenskomstloft.fragtskat_ultimosaldi) == 0
}

? ll33_fragtskat_scenarie_overskydende_fragtskat_fremføres
? ll33_fragtskat_scenarie_fremført_saldo_udnyttes_efter_årets_fragtskat
? ll33_fragtskat_scenarie_resterende_saldo_bevares
? ll33_fragtskat_scenarie_saldo_bevares_uden_årets_fragtskat
? ll33_fragtskat_scenarie_saldo_udløber_ikke_efter_fem_år
? ll33_fragtskat_scenarie_saldo_skal_komme_fra_forrige_år
? ll33_fragtskat_scenarie_åbningssaldo_er_entydig_pr_stat
? ll33_fragtskat_scenarie_gælder_kun_fremmed_stat
? ll33_fragtskat_scenarie_almindelig_indkomstskat_fremføres_ikke
? ll33_fragtskat_scenarie_overenskomstloft_skaber_ikke_saldo

--@end:ligningslov33_fragtskat_scenarier--
