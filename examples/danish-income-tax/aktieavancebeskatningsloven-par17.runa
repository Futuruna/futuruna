@ sprog da

@ importer ./metadata
@ importer ./aktieavancebeskatningsloven
@ importer ./aktieavancebeskatningsloven - par23 - 27
@ importer ./kursgevinstloven - par32
@ importer ./pengebeloeb

= aktieavancebeskatningsloven_lbk1098_par17_klassifikation = AktieavancebeskatningslovKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1098",
    identifier = "Aktieavancebeskatningsloven § 17",
    hentet_dato = "2026-07-18"
)

= abl_par17_klassifikation_kildemeta = Source(
    value = aktieavancebeskatningsloven_lbk1098_par17_klassifikation
)
--@label:aktieavancebeskatningsloven_par17_klassifikation::meta:abl_par17_klassifikation_kildemeta--
----
§ 17. Hvis den skattepligtige udøver næring ved køb og salg af aktier,
medregnes gevinst og tab ved afståelse af aktier, som er erhvervet som led i
denne næringsvej, ved opgørelsen af den skattepligtige indkomst.

Stk. 2. Uanset stk. 1 kan tab ved afståelse af koncerninterne konvertible
obligationer og tegningsretter til sådanne konvertible obligationer ikke
fradrages ved opgørelsen af den skattepligtige indkomst. Ved koncerninterne
konvertible obligationer forstås obligationer i koncernforbundne selskaber, jf.
selskabsskattelovens § 31 C.

Stk. 3. Såfremt den skattepligtige omfattes af stk. 1, medregnes gevinst eller
tab på alle den skattepligtiges investeringsbeviser i investeringsinstitutter
med minimumsbeskatning, jf. ligningslovens § 16 C, stk. 1, ved opgørelsen af den
skattepligtige indkomst.

Stk. 4. I tilfælde, der er omfattet af stk. 1 eller 3, finder reglerne i §§ 8,
9, 12-14, 22 og 44 ikke anvendelse. Stk. 1 og 3 finder ikke anvendelse i de i
§§ 10 og 15, § 16, stk. 1, og §§ 18 og 19 A-19 C nævnte tilfælde.
----

--@begin:aktieavancebeskatningsloven_par17_klassifikation--
# AktieavancePar17Instrument = AblPar17AlmindeligAktie | AblPar17KoncerninternKonvertibelObligation | AblPar17TegningsretTilKoncerninternKonvertibelObligation | AblPar17InvesteringsbevisIMinimumsinstitut | AblPar17UndtagetEfterPar10 | AblPar17UndtagetEfterPar15 | AblPar17UndtagetEfterPar16Stk1 | AblPar17UndtagetEfterPar18 | AblPar17UndtagetEfterPar19A | AblPar17UndtagetEfterPar19B | AblPar17UndtagetEfterPar19C
# AktieavancePar17FortrængtRegel = AblPar17FortrængerPar8 | AblPar17FortrængerPar9 | AblPar17FortrængerPar12 | AblPar17FortrængerPar13 | AblPar17FortrængerPar14 | AblPar17FortrængerPar22 | AblPar17FortrængerPar44
# AktieavancePar17Skatteyder(skattepligtsresultat: AktieavancePar6Par7Resultat, næringsstatus: AktieavancePar17Næringsstatus)
# AktieavancePar17Input(indkomstår: Heltal, skatteyder: AktieavancePar17Skatteyder, instrument: AktieavancePar17Instrument, erhvervelsesstatus: AktieavancePar17Erhvervelsesstatus, afståelsessum_kroner: Heltal, anskaffelsessum_kroner: Heltal)
# AktieavancePar17Par23Bro = AblPar17IngenPar23Bro | AblPar17Par23Bro(skattepligtsresultat: AktieavancePar6Par7Resultat, aktiv: AktieavancePar23Aktiv)
# AktieavancePar17Resultat(input: AktieavancePar17Input, input_gyldigt: Boolsk, aktienæringsdrivende: Boolsk, omfattet_af_stk1: Boolsk, tab_afskåret_efter_stk2: Boolsk, omfattet_af_stk3: Boolsk, undtaget_efter_stk4: Boolsk, fortrængte_regler_efter_stk4: List(AktieavancePar17FortrængtRegel), ville_være_omfattet_uden_investeringsstatus: Boolsk, reglen_finder_anvendelse: Boolsk, kgl_par32_kontraktrelation: KursgevinstPar32Kontraktrelation, par23_bro: AktieavancePar17Par23Bro, bruttogevinst_kroner: Heltal, bruttotab_kroner: Heltal, skattepligtig_gevinst_kroner: Heltal, fradragsberettiget_tab_kroner: Heltal, tab_afskåret_kroner: Heltal, aktieavancebeskatningslov_resultat: AktieavancebeskatningslovResultat)

| aktieavance_par17_er_aktienæringsdrivende(skatteyder: AktieavancePar17Skatteyder) -> skatteyder.næringsstatus == AblPar17UdøverNæringVedKøbOgSalgAfAktier
| aktieavance_par17_er_person(skatteyder: AktieavancePar17Skatteyder) -> skatteyder.skattepligtsresultat.omfattet_af_par7
| aktieavance_par17_er_erhvervet_som_led_i_næringsvej(status: AktieavancePar17Erhvervelsesstatus) -> status == AblPar17ErhvervetSomLedINæringsvej
| aktieavance_par17_instrument_kan_være_omfattet_af_stk1(instrument: AktieavancePar17Instrument) -> match instrument {
    | AblPar17AlmindeligAktie -> Sandt
    | AblPar17KoncerninternKonvertibelObligation -> Sandt
    | AblPar17TegningsretTilKoncerninternKonvertibelObligation -> Sandt
    | _ -> Falskt
}
| aktieavance_par17_instrument_er_koncerninternt_konvertibelt(instrument: AktieavancePar17Instrument) -> instrument == AblPar17KoncerninternKonvertibelObligation || instrument == AblPar17TegningsretTilKoncerninternKonvertibelObligation
| aktieavance_par17_instrument_er_minimumsbevis(instrument: AktieavancePar17Instrument) -> instrument == AblPar17InvesteringsbevisIMinimumsinstitut
| aktieavance_par17_instrument_er_investeringsselskab(instrument: AktieavancePar17Instrument) -> instrument == AblPar17UndtagetEfterPar19A || instrument == AblPar17UndtagetEfterPar19B || instrument == AblPar17UndtagetEfterPar19C
| aktieavance_par17_instrument_undtaget_efter_stk4(instrument: AktieavancePar17Instrument) -> match instrument {
    | AblPar17UndtagetEfterPar10 -> Sandt
    | AblPar17UndtagetEfterPar15 -> Sandt
    | AblPar17UndtagetEfterPar16Stk1 -> Sandt
    | AblPar17UndtagetEfterPar18 -> Sandt
    | AblPar17UndtagetEfterPar19A -> Sandt
    | AblPar17UndtagetEfterPar19B -> Sandt
    | AblPar17UndtagetEfterPar19C -> Sandt
    | _ -> Falskt
}
| aktieavance_par17_kgl_par32_kontraktrelation(skatteyder: AktieavancePar17Skatteyder) -> hvis aktieavance_par17_er_aktienæringsdrivende(skatteyder) { KglPar32AktiekontraktEfterAbl17 } ellers { KglPar32AlmindeligKontrakt }
| aktieavance_par17_kgl_par32_kontraktpost(skatteyder: AktieavancePar17Skatteyder, resultat: KursgevinstlovResultat, aktiegrundlag: KursgevinstPar32Aktiegrundlag) -> KursgevinstPar32Kontraktpost(
    resultat = resultat,
    relation = aktieavance_par17_kgl_par32_kontraktrelation(skatteyder),
    aktiegrundlag = aktiegrundlag
)

# AktieavancePar17Sag(input: AktieavancePar17Input) {
    | input_gyldigt() -> input.indkomstår > 0 && input.afståelsessum_kroner >= 0 && input.anskaffelsessum_kroner >= 0 && aktieavance_par6_par7_resultat_gyldigt(input.skatteyder.skattepligtsresultat) && (input.skatteyder.skattepligtsresultat.omfattet_af_par6 || input.skatteyder.skattepligtsresultat.omfattet_af_par7)
    | aktienæringsdrivende() -> aktieavance_par17_er_aktienæringsdrivende(input.skatteyder)
    | erhvervet_som_led_i_næringsvej() -> aktieavance_par17_er_erhvervet_som_led_i_næringsvej(input.erhvervelsesstatus)
    | undtaget_efter_stk4() -> aktieavance_par17_instrument_undtaget_efter_stk4(input.instrument)
    | omfattet_af_stk1() -> input_gyldigt() && aktienæringsdrivende() && erhvervet_som_led_i_næringsvej() && aktieavance_par17_instrument_kan_være_omfattet_af_stk1(input.instrument) && undtaget_efter_stk4() == Falskt
    | omfattet_af_stk3() -> input_gyldigt() && aktienæringsdrivende() && aktieavance_par17_instrument_er_minimumsbevis(input.instrument) && undtaget_efter_stk4() == Falskt
    | ville_være_omfattet_uden_investeringsstatus() -> input_gyldigt() && aktienæringsdrivende() && erhvervet_som_led_i_næringsvej() && aktieavance_par17_instrument_er_investeringsselskab(input.instrument)
    | reglen_finder_anvendelse() -> omfattet_af_stk1() || omfattet_af_stk3()
    | fortrængte_regler_efter_stk4() -> hvis reglen_finder_anvendelse() { [AblPar17FortrængerPar8, AblPar17FortrængerPar9, AblPar17FortrængerPar12, AblPar17FortrængerPar13, AblPar17FortrængerPar14, AblPar17FortrængerPar22, AblPar17FortrængerPar44] } ellers { [] }
    | rå_nettoavance_kroner() -> hvis input_gyldigt() { input.afståelsessum_kroner - input.anskaffelsessum_kroner } ellers { 0 }
    | bruttogevinst_kroner() -> penge_positivt_beløb(rå_nettoavance_kroner())
    | bruttotab_kroner() -> penge_positivt_beløb(0 - rå_nettoavance_kroner())
    | tab_afskåret_efter_stk2() -> reglen_finder_anvendelse() && aktieavance_par17_instrument_er_koncerninternt_konvertibelt(input.instrument) && bruttotab_kroner() > 0
    | skattepligtig_gevinst_kroner() -> hvis reglen_finder_anvendelse() { bruttogevinst_kroner() } ellers { 0 }
    | fradragsberettiget_tab_kroner() -> hvis reglen_finder_anvendelse() && tab_afskåret_efter_stk2() == Falskt { bruttotab_kroner() } ellers { 0 }
    | tab_afskåret_kroner() -> hvis tab_afskåret_efter_stk2() { bruttotab_kroner() } ellers { 0 }
    | kgl_par32_kontraktrelation() -> aktieavance_par17_kgl_par32_kontraktrelation(input.skatteyder)
    | par23_bro() -> hvis omfattet_af_stk3() { AblPar17Par23Bro(skattepligtsresultat = input.skatteyder.skattepligtsresultat, aktiv = AblPar17Stk3Investeringsbevis) } ellers { hvis omfattet_af_stk1() { AblPar17Par23Bro(skattepligtsresultat = input.skatteyder.skattepligtsresultat, aktiv = AblPar17Næringsaktiv) } ellers { AblPar17IngenPar23Bro } }
    | personskattelov_kategori() -> hvis reglen_finder_anvendelse() && aktieavance_par17_er_person(input.skatteyder) { AblPersonligIndkomstEfterPslUndtagelse } ellers { AblIkkeMedregnetISlice }
    | aktieavancebeskatningslov_resultat() -> AktieavancebeskatningslovResultat(
        indkomstår = input.indkomstår,
        effektiv_aktiv = hvis reglen_finder_anvendelse() { AblNæringsaktiePar17 } ellers { AblUdenforDenneSlice },
        bruttogevinst_kroner = bruttogevinst_kroner(),
        bruttotab_kroner = bruttotab_kroner(),
        tab_afskåret_kroner = tab_afskåret_kroner(),
        skattepligtig_gevinst_kroner = skattepligtig_gevinst_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        netto_efter_aktieavancebeskatningsloven_kroner = skattepligtig_gevinst_kroner() - fradragsberettiget_tab_kroner(),
        medregnes_i_skattepligtig_indkomst = reglen_finder_anvendelse(),
        personskattelov_kategori = personskattelov_kategori()
    )
    | resultat() -> AktieavancePar17Resultat(
        input = input,
        input_gyldigt = input_gyldigt(),
        aktienæringsdrivende = aktienæringsdrivende(),
        omfattet_af_stk1 = omfattet_af_stk1(),
        tab_afskåret_efter_stk2 = tab_afskåret_efter_stk2(),
        omfattet_af_stk3 = omfattet_af_stk3(),
        undtaget_efter_stk4 = undtaget_efter_stk4(),
        fortrængte_regler_efter_stk4 = fortrængte_regler_efter_stk4(),
        ville_være_omfattet_uden_investeringsstatus = ville_være_omfattet_uden_investeringsstatus(),
        reglen_finder_anvendelse = reglen_finder_anvendelse(),
        kgl_par32_kontraktrelation = kgl_par32_kontraktrelation(),
        par23_bro = par23_bro(),
        bruttogevinst_kroner = bruttogevinst_kroner(),
        bruttotab_kroner = bruttotab_kroner(),
        skattepligtig_gevinst_kroner = skattepligtig_gevinst_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        tab_afskåret_kroner = tab_afskåret_kroner(),
        aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat()
    )
}

| aktieavance_par17_resultat(input: AktieavancePar17Input) -> AktieavancePar17Sag(input).resultat()
--@end:aktieavancebeskatningsloven_par17_klassifikation--
