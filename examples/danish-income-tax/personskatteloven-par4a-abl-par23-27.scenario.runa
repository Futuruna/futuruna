@ sprog da

@ importer ./aktieavancebeskatningsloven - par23 - 27
@ importer ./kapitel - 01 - indkomst

-- Fokusscenarier for Aktieavancebeskatningsloven §§ 23-27.

= abl_par23_intet_stk7_valg = AktieavancePar23Stk7Valg(
    selskabsidentifikation = "",
    første_optagelsesdato = AktieavancePar23Dato(år = 0, måned = 0, dag = 0),
    ejer_dage_før_første_optagelse = 0,
    valgmåde = AblIntetPar23Stk7Valg
)

= abl_par23_person_standard_input = AktieavancePar23PrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtig = AblSkattepligtigEfterPar7,
    aktiv = AblAndenAktieEfterPar23,
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblIntetPar23Stk6Valg,
    stk7_valg = abl_par23_intet_stk7_valg,
    obligationsgevinst_opgøres_efter_lagerprincippet = Falskt,
    indkomstår_forskelligt_fra_kalenderår = Falskt
)
= abl_par23_person_standard = aktieavance_par23_princip_resultat(abl_par23_person_standard_input)

= abl_par23_naeringslager_input = AktieavancePar23PrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtig = AblSkattepligtigEfterPar7,
    aktiv = AblPar17Næringsaktiv,
    stk2_valg = AblLagerValgtEnGangForAlleEfterPar23Stk2,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblIntetPar23Stk6Valg,
    stk7_valg = abl_par23_intet_stk7_valg,
    obligationsgevinst_opgøres_efter_lagerprincippet = Falskt,
    indkomstår_forskelligt_fra_kalenderår = Falskt
)
= abl_par23_naeringslager = aktieavance_par23_princip_resultat(abl_par23_naeringslager_input)

= abl_par23_stk4_obligationsbevis_input = AktieavancePar23PrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtig = AblSkattepligtigEfterPar7,
    aktiv = AblPar22Investeringsbevis,
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblIntetPar23Stk6Valg,
    stk7_valg = abl_par23_intet_stk7_valg,
    obligationsgevinst_opgøres_efter_lagerprincippet = Sandt,
    indkomstår_forskelligt_fra_kalenderår = Falskt
)
= abl_par23_stk4_obligationsbevis = aktieavance_par23_princip_resultat(abl_par23_stk4_obligationsbevis_input)

= abl_par23_stk6_realisationsvalg_input = AktieavancePar23PrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtig = AblSkattepligtigEfterPar6,
    aktiv = AblPar9Aktie(selskabsidentifikation = "DK-P9-U", markedsstatus = AblIkkeOptagetTilHandel),
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblRealisationsprincipForAlleUnoteredePar9Aktier(
        har_tidligere_anvendt_lagerprincip = Falskt
    ),
    stk7_valg = abl_par23_intet_stk7_valg,
    obligationsgevinst_opgøres_efter_lagerprincippet = Falskt,
    indkomstår_forskelligt_fra_kalenderår = Falskt
)
= abl_par23_stk6_realisationsvalg = aktieavance_par23_princip_resultat(abl_par23_stk6_realisationsvalg_input)

= abl_par23_stk6_ugyldigt_genvalg_input = AktieavancePar23PrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtig = AblSkattepligtigEfterPar6,
    aktiv = AblPar9Aktie(selskabsidentifikation = "DK-P9-U", markedsstatus = AblIkkeOptagetTilHandel),
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblRealisationsprincipForAlleUnoteredePar9Aktier(
