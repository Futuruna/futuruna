    indkomstår_forskelligt_fra_kalenderår = Falskt
)
= abl_par23_stk6_ugyldigt_genvalg = aktieavance_par23_princip_resultat(abl_par23_stk6_ugyldigt_genvalg_input)

= abl_par23_stk7_historisk_valg = AktieavancePar23Stk7Valg(
    selskabsidentifikation = "DK-P9-L",
    første_optagelsesdato = AktieavancePar23Dato(år = 2020, måned = 5, dag = 15),
    ejer_dage_før_første_optagelse = 45,
    valgmåde = AblHistoriskGenoptagelsesvalg(
