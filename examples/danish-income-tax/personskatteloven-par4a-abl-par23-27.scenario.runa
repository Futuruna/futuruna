| scenarie_abl_par26_stk6_holder_ll7n_adskilt: abl_par26_stk6_ll7n_salg -> abl_par26_stk6_ll7n_salg.hændelse_gyldig && abl_par26_stk6_ll7n_salg.valgt_hændelsesresultat.bruttogevinst_kroner == 7500 && aktieavance_ordinaer_position_antal_aktier(abl_par26_stk6_ll7n_salg.beholdning_efter.ll7n_position) == 5 && aktieavance_ordinaer_position_antal_aktier(abl_par26_stk6_ll7n_salg.beholdning_efter.anden_position) == 10 && abl_par26_stk6_ll7n_salg.beholdning_efter.anden_position.anskaffelsessum_kroner == 10000
