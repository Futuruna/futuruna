= årsopgørelse2023_kilde = HistoriskÅrsopgørelseKilde(
    indkomstår = 2023,
    kommune = Frederiksberg,
    personlig = HistoriskPersonligIndkomstKilde(
        løn_før_am_kroner = 834156,
        gruppeliv_efter_indeholdt_am_kroner = 1074,
        arbejdsgiveradministreret_samlepost_før_indeholdt_am_kroner = 261,
        arbejdsgiveradministreret_samlepost_efter_indeholdt_am_kroner = 240,
        privat_livrente_kroner = 810,
        arbejdsgiver_ratepension_før_am_kroner = 117332,
        arbejdsgiver_ratepension_efter_am_kroner = 107945,
        virksomhedsindtægt_kroner = 0,
        virksomhedsudgift_kroner = 0
    ),
    kapital_og_aktie = HistoriskKapitalOgAktieKilde(
        renteindtægt_kroner = 0,
        renteudgift_kroner = 26717,
        ikke_aktiebaseret_investeringsselskabsgevinst_kroner = 558,
        almindeligt_aktieudbytte_kroner = 829,
        aktiebaseret_investeringsselskabsgevinst_kroner = 29
    ),
    ligningsfradrag = HistoriskLigningsfradragKilde(
        fagforening_kroner = 420,
        a_kasse_kroner = 0,
        gaver_kroner = 2040
    ),
    ægtefælle = HistoriskÆgtefælleKilde(
        renteudgift_kroner = 22735,
        samlevende_ved_indkomstårets_udløb = Sandt
    ),
    forudbetaling = HistoriskForudbetalingKilde(
        indeholdt_am_kroner = 66732,
        a_skat_kroner = 272610,
        udbytteskat_øre = 22392
    )
)
= årsopgørelse2023_kontrol = HistoriskÅrsopgørelseKontrol(
    personlig_indkomst_kroner = 767928,
    nettokapitalindkomst_kroner = 0 - 26159,
    aktieindkomst_kroner = 858,
    ligningsfradrag_kroner = 60108,
    overført_ægtefælleunderskud_kroner = 22735,
    skattepligtig_indkomst_kroner = 658926,
    beregnet_am_kroner = 66732,
    slutskat_øre = 30605958,
    overskydende_skat_øre = 3350634,
    procentgodtgørelse_øre = 26805,
    udbetales_kroner = 33774,
