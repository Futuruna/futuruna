)
--@end:årsopgørelse2023_anonymiseret--

= årsopgørelse2024_privat_kilde = HistoriskPrivatKildeInfo(
    dokumenttype = "Privat årsopgørelse",
    indkomstår = 2024,
    persondata_udeladt = Sandt
)
= årsopgørelse2024_metadata = Metadata(attachments = (Source(value = årsopgørelse2024_privat_kilde),))

--@label:årsopgørelse2024_anonymiseret::meta:årsopgørelse2024_metadata--
----
Anonymiserede kildelinjer fra årsopgørelsen for 2024, beløb i kroner medmindre
andet er angivet:

Løn før AM-bidrag 996.754; gruppeliv mv. efter indeholdt AM-bidrag 298;
arbejdsgiveradministreret samlepost før/efter indeholdt AM-bidrag 1.540/1.416;
privat livrente 834; arbejdsgiver-ratepension før/efter AM-bidrag
109.470/100.712; virksomhedsindtægt 4.875 og virksomhedsudgift 8.601.

Renteindtægt 285; ikke-aktiebaseret investeringsselskabsgevinst 1.129;
renteudgift 24.667; almindeligt aktieudbytte 1.271;
aktiebaseret investeringsselskabsgevinst 114.

Fagforening 2.928; A-kasse 1.202; gaver 2.070; ægtefællens renteudgift 20.301.
Indeholdt AM-bidrag 79.738; A-skat 319.935; udbytteskat 343,54.

Årsopgørelsens kontrolresultater: personlig indkomst 914.168;
nettokapitalindkomst -23.253; aktieindkomst 1.385; ligningsfradrag 63.772;
overført ægtefælleunderskud 20.301; skattepligtig indkomst 806.842;
beregnet AM-bidrag 79.740; slutskat 397.091,95; overskydende skat 2.924,59;
procentgodtgørelse 17,54; udbetaling 2.942 hele kroner og 13 øre ikke udbetalt.
----

--@begin:årsopgørelse2024_anonymiseret--
= årsopgørelse2024_kilde = HistoriskÅrsopgørelseKilde(
    indkomstår = 2024,
    kommune = Frederiksberg,
    personlig = HistoriskPersonligIndkomstKilde(
        løn_før_am_kroner = 996754,
        gruppeliv_efter_indeholdt_am_kroner = 298,
        arbejdsgiveradministreret_samlepost_før_indeholdt_am_kroner = 1540,
        arbejdsgiveradministreret_samlepost_efter_indeholdt_am_kroner = 1416,
        privat_livrente_kroner = 834,
        arbejdsgiver_ratepension_før_am_kroner = 109470,
        arbejdsgiver_ratepension_efter_am_kroner = 100712,
        virksomhedsindtægt_kroner = 4875,
        virksomhedsudgift_kroner = 8601
    ),
    kapital_og_aktie = HistoriskKapitalOgAktieKilde(
        renteindtægt_kroner = 285,
        renteudgift_kroner = 24667,
        ikke_aktiebaseret_investeringsselskabsgevinst_kroner = 1129,
        almindeligt_aktieudbytte_kroner = 1271,
        aktiebaseret_investeringsselskabsgevinst_kroner = 114
    ),
    ligningsfradrag = HistoriskLigningsfradragKilde(
        fagforening_kroner = 2928,
        a_kasse_kroner = 1202,
        gaver_kroner = 2070
    ),
    ægtefælle = HistoriskÆgtefælleKilde(
        renteudgift_kroner = 20301,
        samlevende_ved_indkomstårets_udløb = Sandt
    ),
    forudbetaling = HistoriskForudbetalingKilde(
        indeholdt_am_kroner = 79738,
        a_skat_kroner = 319935,
        udbytteskat_øre = 34354
    )
)
= årsopgørelse2024_kontrol = HistoriskÅrsopgørelseKontrol(
    personlig_indkomst_kroner = 914168,
    nettokapitalindkomst_kroner = 0 - 23253,
    aktieindkomst_kroner = 1385,
    ligningsfradrag_kroner = 63772,
    overført_ægtefælleunderskud_kroner = 20301,
    skattepligtig_indkomst_kroner = 806842,
    beregnet_am_kroner = 79740,
    slutskat_øre = 39709195,
    overskydende_skat_øre = 292459,
    procentgodtgørelse_øre = 1754,
    udbetales_kroner = 2942,
    ikke_udbetalt_øre = 13
)
--@end:årsopgørelse2024_anonymiseret--

----
Årsopgørelserne dokumenterer de skattemæssige kategorier og årets nettogevinst
for investeringsselskaber, men ikke aktivmassen, meddelelsesforløbet eller
værdierne ved årets begyndelse og slutning. Scenariet bruger derfor en minimal
lovligt sammenhængende rekonstruktion af § 19 B- og § 19 C-status. De
rekonstruerede fakta påvirker kategorien og den dokumenterede nettogevinst, men
myndighedens beregnede skattebeløb bruges ikke som input.
----

| historisk_identifikation(kilde: HistoriskÅrsopgørelseKilde, art: Tekst) -> "anonymiseret-" + vis(kilde.indkomstår) + "-" + art

| historisk_arbejdsgiverydelse(kilde: HistoriskÅrsopgørelseKilde, art: Tekst, ydelse: PersonskatArbejdsgiverydelse) -> PersonskatArbejdsgiverydelseFakta(
    identifikation = historisk_identifikation(kilde, art),
    indkomstår = kilde.indkomstår,
    ydelse = ydelse
)

| historisk_virksomheder(kilde: HistoriskÅrsopgørelseKilde) -> []
| exception historisk_dokumenteret_virksomhed historisk_virksomheder(kilde: HistoriskÅrsopgørelseKilde) -> [PersonskatOrdinærVirksomhedFakta(
    identifikation = historisk_identifikation(kilde, "virksomhed"),
    indkomstår = kilde.indkomstår,
    indtægter = [PersonskatVirksomhedsindtægtFakta(
        identifikation = historisk_identifikation(kilde, "virksomhedsindtægt"),
        art = OrdinærDriftsindtægt,
        beløb_kroner = kilde.personlig.virksomhedsindtægt_kroner
    )],
    udgifter = [PersonskatVirksomhedsudgiftFakta(
        identifikation = historisk_identifikation(kilde, "virksomhedsudgift"),
        afgrænsning = SelvstændigErhvervsindkomstUdgift,
        beløb_kroner = kilde.personlig.virksomhedsudgift_kroner
    )]
)] under kilde.personlig.virksomhedsindtægt_kroner > 0 || kilde.personlig.virksomhedsudgift_kroner > 0

| historisk_personlig_indkomstinput(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = [
            historisk_arbejdsgiverydelse(
                kilde,
                "gruppeliv",
                GruppelivSomUadskiltDelAfPbl19Ordning(
                    personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner = kilde.personlig.gruppeliv_efter_indeholdt_am_kroner
                )
            ),
            historisk_arbejdsgiverydelse(
                kilde,
                "arbejdsgiveradministreret-samlepost",
                ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(
                    indberettet_beløb_før_indeholdt_arbejdsmarkedsbidrag_kroner = Some(kilde.personlig.arbejdsgiveradministreret_samlepost_før_indeholdt_am_kroner),
                    indberettet_beløb_efter_indeholdt_arbejdsmarkedsbidrag_kroner = kilde.personlig.arbejdsgiveradministreret_samlepost_efter_indeholdt_am_kroner
                )
            )
        ],
        personlige_arbejdsvederlag = [],
        virksomheder_uden_virksomhedsordning = historisk_virksomheder(kilde),
        forenings_og_arbejdsløshedsydelser = []
    ),
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)

| historisk_pbl18_indbetaling(kilde: HistoriskÅrsopgørelseKilde, art: Tekst, ordning: Pbl18Ordning, indbetalingskilde: Pbl18Indbetalingskilde, beløb_før_am_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = historisk_identifikation(kilde, art),
    ordning = ordning,
    indbetalingskilde = indbetalingskilde,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = beløb_før_am_kroner,
        forfaldsår = kilde.indkomstår,
        betalingsår = kilde.indkomstår,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsmarkedsbidrag_kroner = arbejdsmarkedsbidrag_kroner
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = Pbl18Indeksvalg(fradragsvalgte_kontraktbidrag_kroner = []),
    indeksordningsgrundlag = Pbl18IkkeIndeksordning,
    forfaldne_ikke_tidligere_fratrukket_kroner = beløb_før_am_kroner,
    særligt_ordningsgrundlag = Pbl18IntetSærligtOrdningsgrundlag,
    begrænsninger = Pbl18Begrænsninger(
        pbl54_personkreds_opfyldt = Sandt,
        afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
        udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Falskt
    )
)

| historisk_pensionsinput(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatPensionsInput(
    fødselsdato = Dato(år = 1990, måned = 1, dag = 1),
    pbl18_indbetalinger = [
        historisk_pbl18_indbetaling(
            kilde = kilde,
            art = "privat-livrente",
            ordning = Pbl18LivsvarigLivrente,
            indbetalingskilde = Pbl18EgenIndbetaling,
            beløb_før_am_kroner = kilde.personlig.privat_livrente_kroner,
            arbejdsmarkedsbidrag_kroner = 0
        ),
        historisk_pbl18_indbetaling(
            kilde = kilde,
            art = "arbejdsgiver-ratepension",
            ordning = Pbl18Rateopsparing,
            indbetalingskilde = Pbl18Arbejdsgiverindbetaling,
            beløb_før_am_kroner = kilde.personlig.arbejdsgiver_ratepension_før_am_kroner,
            arbejdsmarkedsbidrag_kroner = kilde.personlig.arbejdsgiver_ratepension_før_am_kroner - kilde.personlig.arbejdsgiver_ratepension_efter_am_kroner
        )
    ],
    pbl18_selvstændig_overskud = personskat_intet_selvstændigt_pensionsoverskud(),
    pbl18_livrentevalg = Pbl18FordeltFradrag,
    pbl14b_årsgrundlag = pbl14b_tomt_årsgrundlag(),
    pbl15a_årsgrundlag = Pbl15AÅrsgrundlag(afståelser = [], ordninger = [], kvalifikationsår = [], tidligere_indbetalinger = []),
    pbl15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    øvrige_pbl20_årsgrundlag = pbl20_tomt_årsgrundlag(),
    aktiepensionsfradrag_valg = UdenAktiepensionsfradragIAktieindkomst
)

| historisk_investeringsaktivmasse(indkomstår: Heltal, kvalificerende_aktiver_kroner: Heltal, øvrige_værdipapirer_kroner: Heltal) -> AktieavanceInvesteringsaktivmasse(
    indkomstår = indkomstår,
    direkte_aktiver = [
        AblDirekteInvesteringsaktiv(art = AblKvalificerendeAktieaktiv, gennemsnitlig_værdi_kroner = kvalificerende_aktiver_kroner),
        AblDirekteInvesteringsaktiv(art = AblAndetVærdipapir, gennemsnitlig_værdi_kroner = øvrige_værdipapirer_kroner)
    ],
    ejerposter = []
)

| historisk_abl19b_klassifikation(indkomstår: Heltal) -> AktieavancePar19BPar19CInput(
    indkomstår = indkomstår,
    meddelelse = AblPar19BOrdinærMeddelelse(
        virkningsår = indkomstår,
        indsendelsesdato = AktieavanceInvesteringsdato(år = indkomstår - 1, måned = 11, dag = 1)
    ),
    aktivmasse = historisk_investeringsaktivmasse(indkomstår, 60000, 40000),
    oplysninger = AblPar19BOplysningerIndsendt(
        indsendelsesdato = AktieavanceInvesteringsdato(år = indkomstår + 1, måned = 7, dag = 1)
    )
)

| historisk_abl19c_klassifikation(indkomstår: Heltal) -> AktieavancePar19BPar19CInput(
    indkomstår = indkomstår,
    meddelelse = AblIngenPar19BMeddelelse,
    aktivmasse = historisk_investeringsaktivmasse(indkomstår, 20000, 80000),
    oplysninger = AblPar19BOplysningerIkkeIndsendt
)

| historisk_investeringsselskabsgevinst(kilde: HistoriskÅrsopgørelseKilde, art: Tekst, gevinst_kroner: Heltal, klassifikation: AktieavancePar19BPar19CInput, par17_instrument: AktieavancePar17Instrument) -> PersonskatSærligtAktieaktivFakta(
    identifikation = historisk_identifikation(kilde, art),
    kilde = PersonskatØvrigtAktieaktiv(
        input = PersonskatØvrigtSærligtAktieaktivInput(
            indkomstår = kilde.indkomstår,
            aktiv = AblInvesteringsselskabPar19TilKlassifikation,
            afståelsessum_kroner = 100000 + gevinst_kroner,
            anskaffelsessum_kroner = 100000,
            koncernintern_konvertibel_eller_tegningsret = Falskt,
            andelsforening_stiftet_før_22_maj_1987 = Falskt,
            afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
            investeringsklassifikation = AblPar19BPar19CKlassifikation(input = klassifikation)
        ),
        par17_modprøvekilde = MedPar17Modprøvekilde(fakta = PersonskatPar17Kildefakta(
            indkomstår = kilde.indkomstår,
            skattepligtsgrundlag = AblPar7PersonEfterKildeskatteloven,
            næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
            instrument = par17_instrument,
            erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej,
            afståelsessum_kroner = 100000 + gevinst_kroner,
            anskaffelsessum_kroner = 100000
        ))
    ),
    markedsstatus = AblIkkeOptagetTilHandel
)

| historisk_almindeligt_udbytte(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatUdbytteFakta(
    identifikation = historisk_identifikation(kilde, "almindeligt-aktieudbytte"),
    udlodder = Ll16AAlmindeligtSelskab,
    modtager = Ll16AAktuelAktionær,
    aktiv = PersonskatAlmindeligAktie,
    beløb_kroner = kilde.kapital_og_aktie.almindeligt_aktieudbytte_kroner,
    par13a_kildefakta = AblPar13AUdbytteUdenForModregningsgrundlag
)

| historisk_aktieavanceinput(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatAktieavanceInput(
    ordinært_aktieår = UdenOrdinærtAktieår,
    særlige_aktiver = [
        historisk_investeringsselskabsgevinst(
            kilde,
            "ikke-aktiebaseret-investeringsselskab",
            kilde.kapital_og_aktie.ikke_aktiebaseret_investeringsselskabsgevinst_kroner,
            historisk_abl19c_klassifikation(kilde.indkomstår),
            AblPar17UndtagetEfterPar19C
        ),
        historisk_investeringsselskabsgevinst(
            kilde,
            "aktiebaseret-investeringsselskab",
            kilde.kapital_og_aktie.aktiebaseret_investeringsselskabsgevinst_kroner,
            historisk_abl19b_klassifikation(kilde.indkomstår),
            AblPar17UndtagetEfterPar19B
        )
    ],
    udbytter = [historisk_almindeligt_udbytte(kilde)]
)

| historisk_kapitalindkomstinput(kilde: HistoriskÅrsopgørelseKilde, renteudgift_kroner: Heltal, renteindtægt_kroner: Heltal) -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = renteindtægt_kroner,
        renteudgifter_kroner = renteudgift_kroner,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    omkostninger = []
)

| historisk_fagforeningsbidrag(kilde: HistoriskÅrsopgørelseKilde) -> Ligningslov13KontingentFakta(
    identifikation = historisk_identifikation(kilde, "fagforening"),
    forening_identifikation = historisk_identifikation(kilde, "anonymiseret-fagforening"),
    indkomstår = kilde.indkomstår,
    periode = Ligningslov13Kontingentperiode(
        fra_dato = Dato(år = kilde.indkomstår, måned = 1, dag = 1),
        til_dato = Dato(år = kilde.indkomstår, måned = 12, dag = 31)
    ),
    foreningsart = Ll13Fagforening,
    betalt_kontingent_kroner = kilde.ligningsfradrag.fagforening_kroner,
    foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner = kilde.ligningsfradrag.fagforening_kroner,
    foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser = Sandt,
    skatteyder_hører_til_erhvervsgruppen = Sandt,
    indberetningsstatus = Ll13IndberettetEfterSkatteindberetningslov31
)

| historisk_a_kasse_bidrag(kilde: HistoriskÅrsopgørelseKilde) -> []
| exception historisk_dokumenteret_a_kasse historisk_a_kasse_bidrag(kilde: HistoriskÅrsopgørelseKilde) -> [Pbl49Til49BBidragsfakta(
    identifikation = historisk_identifikation(kilde, "a-kasse"),
    indkomstår = kilde.indkomstår,
    betalt_beløb_kroner = kilde.ligningsfradrag.a_kasse_kroner,
    art = Pbl49Akassekontingent(
        arbejdsløshedskasse = Pbl49DanskAnerkendtArbejdsløshedskasse,
        skatteyderen_er_medlem_og_forsikret = Sandt
    )
)] under kilde.ligningsfradrag.a_kasse_kroner > 0

| historisk_gavemodtager(kilde: HistoriskÅrsopgørelseKilde) -> LigningslovGavemodtagerFakta(
    identifikation = historisk_identifikation(kilde, "anonymiseret-gavemodtager"),
    hjemsted = LlGaveDanmark,
    formål = LlGaveAlmennyttigtTilStørreKreds,
    godkendelse = LlGaveGodkendtEfterPar8A(godkendelsesår = kilde.indkomstår),
    likvidationsprovenu_til_anden_velgørende_forening = Sandt
)

| historisk_ligningsfradragsinput(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatLigningsfradragInput(
    sømandsfradrag = sømandsbeskatningslov3_intet_årsinput(),
    sømandsbeskatningslov4 = sømandsbeskatningslov4_intet_årsinput(),
    fiskerfradrag = ligningslov9g_intet_årsinput(),
    øvrige_lønmodtagerudgifter = ligningslov9_stk1_intet_årsinput(),
    befordring = personskat_ingen_befordringsfradrag(),
    rejser = ligningslov9a_intet_årsinput(),
    faglige_kontingenter = Ligningslov13Årsinput(
        skatteyderstatus = Ll13Lønmodtager,
        kontingenter = [historisk_fagforeningsbidrag(kilde)]
    ),
    arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(
        skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark,
        bidrag = historisk_a_kasse_bidrag(kilde)
    ),
    gaver = LigningslovGaveÅrsinput(gaver = [LigningslovGaveFakta(
        identifikation = historisk_identifikation(kilde, "gave"),
        indkomstår = kilde.indkomstår,
        betalt_beløb_kroner = kilde.ligningsfradrag.gaver_kroner,
        modtager = historisk_gavemodtager(kilde),
        indberettet_efter_skatteindberetningslov26 = Sandt,
        art = Ll8AAlmindeligGave(fradraget_efter_par8s = Falskt)
    )])
)

| historisk_lønmodtagerinput(kilde: HistoriskÅrsopgørelseKilde, personlig_indkomst: PersonskatPersonligIndkomstInput, ligningsfradrag: PersonskatLigningsfradragInput, pension: PersonskatPensionsInput, bruttoløn_kroner: Heltal) -> PersonskatLønmodtagerInput(
    skatteår = kilde.indkomstår,
    kommune = kilde.kommune,
    bruttoløn_kroner = bruttoløn_kroner,
    personlig_indkomst = personlig_indkomst,
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = ligningsfradrag,
    pension = pension,
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)

| historisk_ægtefælle_personfakta(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatPersonFakta(
    lønmodtager = historisk_lønmodtagerinput(
        kilde,
        personskat_ingen_personlig_indkomst(),
        personskat_ingen_ligningsfradrag(),
        personskat_ingen_pension(),
        0
    ),
    kapitalindkomst = historisk_kapitalindkomstinput(kilde, kilde.ægtefælle.renteudgift_kroner, 0),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta()
)

| historisk_par60_kreditter(kilde: HistoriskÅrsopgørelseKilde) -> KildeskatPar60KreditterØre(
    a_skat_og_am_indeholdt_øre = (kilde.forudbetaling.a_skat_kroner + kilde.forudbetaling.indeholdt_am_kroner) * 100,
    par68_indbetalt_øre = 0,
    b_skat_betalt_øre = 0,
    udbytteskat_modregningsberettiget_øre = kilde.forudbetaling.udbytteskat_øre,
    frivillig_indbetaling_par59_øre = 0,
    virksomhedsordning_beløb_øre = 0,
    personskattelov_par8a_stk5_beløb_øre = 0,
    afskrivningslov_acontoskat_øre = 0,
    am_lov_par6_beløb_øre = 0,
    seniornedslag_øre = 0,
    energiafgiftskompensation_øre = 0,
    tilbagebetalt_par55_øre = 0
)

| historisk_afregningsfakta(kilde: HistoriskÅrsopgørelseKilde) -> KildeskatOverskydendeAfregningEksaktFakta(
    indkomstår = kilde.indkomstår,
    modsvarer_par59_indbetaling_øre = 0,
    tilbagebetalt_rente_par59_øre = 0,
    modsvarer_seniornedslag_øre = 0,
    modsvarer_energiafgiftskompensation_øre = 0,
    restancer_personlig_skat_med_morarenter_øre = 0,
    tilbagebetaling_efter_1_september = Falskt,
    påbegyndte_måneder_efter_1_september = 0
)

| historisk_personskatinput(kilde: HistoriskÅrsopgørelseKilde) -> PersonskatInput(
    lønmodtager = historisk_lønmodtagerinput(
        kilde,
        historisk_personlig_indkomstinput(kilde),
        historisk_ligningsfradragsinput(kilde),
        historisk_pensionsinput(kilde),
        kilde.personlig.løn_før_am_kroner
    ),
    kapitalindkomst = historisk_kapitalindkomstinput(
        kilde,
        kilde.kapital_og_aktie.renteudgift_kroner,
        kilde.kapital_og_aktie.renteindtægt_kroner
    ),
    aktieavance = historisk_aktieavanceinput(kilde),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = MedÆgtefælle(
        fakta = historisk_ægtefælle_personfakta(kilde),
        samlevende_ved_indkomstårets_udløb = kilde.ægtefælle.samlevende_ved_indkomstårets_udløb,
        kildeskat25a_fordelinger = []
    ),
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = MedEksaktÅrsopgørelse(
        overført_restskat_mv_øre = 0,
        øvrig_pensionsbeskatningsafgift_øre = 0,
        kreditter = historisk_par60_kreditter(kilde),
        afregningsfakta = AfregnOverskydendeSkat(fakta = historisk_afregningsfakta(kilde))
    )
)

# HistoriskÅrsopgørelseArbejdsbogskilde = AnonymiseretÅrsopgørelse2023 | AnonymiseretÅrsopgørelse2024

@ calculate("Anonymiserede 2023-2024-kildefakta til Personskat-arbejdsbog")
| historiske_kanoniske_kildefakta_til_arbejdsbog(kilde: HistoriskÅrsopgørelseArbejdsbogskilde) -> match kilde {
    | AnonymiseretÅrsopgørelse2023 -> historisk_personskatinput(årsopgørelse2023_kilde)
    | AnonymiseretÅrsopgørelse2024 -> historisk_personskatinput(årsopgørelse2024_kilde)
}

= årsopgørelse2023_resultat = beregn_personskat(historisk_personskatinput(årsopgørelse2023_kilde))
= årsopgørelse2024_resultat = beregn_personskat(historisk_personskatinput(årsopgørelse2024_kilde))

| historisk_indkomstgrundlag_matcher(resultat: PersonskatBeregningResultat, kontrol: HistoriskÅrsopgørelseKontrol) -> resultat.personlig_indkomst.alle_input_gyldige && resultat.kapitalindkomst.alle_input_gyldige && resultat.aktieavance.alle_input_gyldige && resultat.skat.arbejdsmarkedsbidrag_kroner == kontrol.beregnet_am_kroner && resultat.skat.personlig_indkomst_efter_am_kroner == kontrol.personlig_indkomst_kroner && resultat.skat.nettokapitalindkomst_kroner == kontrol.nettokapitalindkomst_kroner && resultat.aktieavance.aktieindkomst_kroner == kontrol.aktieindkomst_kroner
| historisk_fradrag_og_ægtefælle_matcher(resultat: PersonskatBeregningResultat, kontrol: HistoriskÅrsopgørelseKontrol) -> resultat.skat.samlede_ligningsmæssige_fradrag_kroner == kontrol.ligningsfradrag_kroner && resultat.indgående_ægtefælle.par13_indkomstfradrag_kroner == kontrol.overført_ægtefælleunderskud_kroner && resultat.skat.almindelig_skattepligtig_indkomst_kroner == kontrol.skattepligtig_indkomst_kroner
| historisk_slutskat_matcher(resultat: PersonskatBeregningResultat, kontrol: HistoriskÅrsopgørelseKontrol) -> resultat.ejendomsskatter.alle_input_gyldige && resultat.ejendomsskatter.regelgrundlag_understøttet && resultat.ejendomsskatter.samlet_ejendomsskat_øre == 0 && resultat.slutskat_øre == kontrol.slutskat_øre
| historisk_afregning_matcher(resultat: PersonskatBeregningResultat, kontrol: HistoriskÅrsopgørelseKontrol) -> match resultat.årsopgørelse {
    | BeregnetÅrsopgørelse(_, slutopgørelse, afregning) -> slutopgørelse.overskydende_skat_øre == kontrol.overskydende_skat_øre && slutopgørelse.art == OverskydendeSkat && match afregning {
        | OverskydendeSkatAfregnet(afregningsresultat) -> afregningsresultat.input_gyldigt && afregningsresultat.godtgørelse_øre == kontrol.procentgodtgørelse_øre && afregningsresultat.udbetales_kroner == kontrol.udbetales_kroner && afregningsresultat.ikke_udbetalt_øre == kontrol.ikke_udbetalt_øre
        | _ -> Falskt
    }
    | _ -> Falskt
}

| årsopgørelse2023_indkomstgrundlag_matcher: Sandt -> historisk_indkomstgrundlag_matcher(årsopgørelse2023_resultat, årsopgørelse2023_kontrol)
| årsopgørelse2023_fagforeningsfradrag_matcher: Sandt -> årsopgørelse2023_resultat.ligningsfradrag.faglige_kontingenter.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.faglige_kontingenter.årsloft_kroner == 6000 && årsopgørelse2023_resultat.ligningsfradrag.faglige_kontingenter.samlet_fradrag_kroner == årsopgørelse2023_kilde.ligningsfradrag.fagforening_kroner
| årsopgørelse2023_pbl49_kildekæde_matcher: Sandt -> årsopgørelse2023_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.lovversion == Pbl49Lbk1327MedÆndringerTilOgMed2023 && årsopgørelse2023_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.privat_forsikringsminimum_version == Pbl49Stk3IkkeAnvendeligFør2024 && årsopgørelse2023_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.samlet_fradrag_kroner == 0
| årsopgørelse2023_gavefradrag_matcher: Sandt -> årsopgørelse2023_resultat.ligningsfradrag.gaver.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.gaver.par8a_årsloft_kroner == 17700 && årsopgørelse2023_resultat.ligningsfradrag.gaver.samlet_fradrag_kroner == årsopgørelse2023_kilde.ligningsfradrag.gaver_kroner
| årsopgørelse2023_tomme_valgfrie_fradragsdomæner_er_neutrale: Sandt -> årsopgørelse2023_resultat.ligningsfradrag.sømandsfradrag.lovversion == Søbl3Og4Lbk1181Af2023MedSenereÆndringer && årsopgørelse2023_resultat.ligningsfradrag.sømandsfradrag.skatteår_understøttet && årsopgørelse2023_resultat.ligningsfradrag.sømandsfradrag.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.øvrige_lønmodtagerudgifter.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.befordring_før_ligningslov9g.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.befordring.alle_input_gyldige && årsopgørelse2023_resultat.ligningsfradrag.befordring_efter_sømandsbeskatningslov4.alle_input_gyldige
| årsopgørelse2023_tom_dis_er_kildebelagt_og_neutral: Sandt -> årsopgørelse2023_resultat.personlig_indkomst.sømandsbeskatning.lovversion == Søbl5Til8Lbk1181Af2023MedSenereÆndringer && årsopgørelse2023_resultat.personlig_indkomst.sømandsbeskatning.ligningslov7u_lovversion == Søbl5Til8Ll7ULbk42Af2023MedSenereÆndringer && årsopgørelse2023_resultat.personlig_indkomst.sømandsbeskatning.alle_input_gyldige && årsopgørelse2023_resultat.personlig_indkomst.sømandsbeskatning.samlet_dis_personlig_indkomst_kroner == 0
| årsopgørelse2023_ligningsfradrag_er_beregningsklart: Sandt -> årsopgørelse2023_resultat.ligningsfradrag.alle_input_gyldige
| årsopgørelse2023_ligningsfradrag_matcher: Sandt -> årsopgørelse2023_resultat.skat.samlede_ligningsmæssige_fradrag_kroner == årsopgørelse2023_kontrol.ligningsfradrag_kroner
| årsopgørelse2023_ægtefælleoverførsel_matcher: Sandt -> årsopgørelse2023_resultat.indgående_ægtefælle.par13_indkomstfradrag_kroner == årsopgørelse2023_kontrol.overført_ægtefælleunderskud_kroner
| årsopgørelse2023_skattepligtig_indkomst_matcher: Sandt -> årsopgørelse2023_resultat.skat.almindelig_skattepligtig_indkomst_kroner == årsopgørelse2023_kontrol.skattepligtig_indkomst_kroner
| årsopgørelse2023_fradrag_og_ægtefælle_matcher: Sandt -> historisk_fradrag_og_ægtefælle_matcher(årsopgørelse2023_resultat, årsopgørelse2023_kontrol)
| årsopgørelse2023_slutskat_matcher: Sandt -> historisk_slutskat_matcher(årsopgørelse2023_resultat, årsopgørelse2023_kontrol)
| årsopgørelse2023_afregning_matcher: Sandt -> historisk_afregning_matcher(årsopgørelse2023_resultat, årsopgørelse2023_kontrol) && kildeskat_årsopgørelsessatser(2023).overskydende_skat_godtgørelse_basispoint == 80

| årsopgørelse2024_indkomstgrundlag_matcher: Sandt -> historisk_indkomstgrundlag_matcher(årsopgørelse2024_resultat, årsopgørelse2024_kontrol) && årsopgørelse2024_kilde.forudbetaling.indeholdt_am_kroner != årsopgørelse2024_kontrol.beregnet_am_kroner
| årsopgørelse2024_pbl49_kildekæde_matcher: Sandt -> årsopgørelse2024_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.alle_input_gyldige && årsopgørelse2024_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.lovversion == Pbl49Lbk1243MedSenereÆndringer && årsopgørelse2024_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.privat_forsikringsminimum_version == Pbl49Stk3Minimum1300Fra2024 && årsopgørelse2024_resultat.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.samlet_fradrag_kroner == årsopgørelse2024_kilde.ligningsfradrag.a_kasse_kroner
| årsopgørelse2024_tomt_sømandsfradrag_er_kildebelagt_og_neutralt: Sandt -> årsopgørelse2024_resultat.ligningsfradrag.sømandsfradrag.lovversion == Søbl3Og4Lbk1181Af2023MedSenereÆndringer && årsopgørelse2024_resultat.ligningsfradrag.sømandsfradrag.skatteår_understøttet && årsopgørelse2024_resultat.ligningsfradrag.sømandsfradrag.alle_input_gyldige && årsopgørelse2024_resultat.ligningsfradrag.sømandsfradrag.samlet_fradrag_kroner == 0
| årsopgørelse2024_tom_dis_er_kildebelagt_og_neutral: Sandt -> årsopgørelse2024_resultat.personlig_indkomst.sømandsbeskatning.lovversion == Søbl5Til8Lbk1181Af2023MedSenereÆndringer && årsopgørelse2024_resultat.personlig_indkomst.sømandsbeskatning.ligningslov7u_lovversion == Søbl5Til8Ll7ULbk42Af2023MedSenereÆndringer && årsopgørelse2024_resultat.personlig_indkomst.sømandsbeskatning.alle_input_gyldige && årsopgørelse2024_resultat.personlig_indkomst.sømandsbeskatning.samlet_dis_personlig_indkomst_kroner == 0
| årsopgørelse2024_fradrag_og_ægtefælle_matcher: Sandt -> historisk_fradrag_og_ægtefælle_matcher(årsopgørelse2024_resultat, årsopgørelse2024_kontrol)
| årsopgørelse2024_slutskat_matcher: Sandt -> historisk_slutskat_matcher(årsopgørelse2024_resultat, årsopgørelse2024_kontrol)
| årsopgørelse2024_afregning_matcher: Sandt -> historisk_afregning_matcher(årsopgørelse2024_resultat, årsopgørelse2024_kontrol) && kildeskat_årsopgørelsessatser(2024).overskydende_skat_godtgørelse_basispoint == 60

? årsopgørelse2023_indkomstgrundlag_matcher
? årsopgørelse2023_fagforeningsfradrag_matcher
? årsopgørelse2023_pbl49_kildekæde_matcher
? årsopgørelse2023_gavefradrag_matcher
? årsopgørelse2023_tomme_valgfrie_fradragsdomæner_er_neutrale
? årsopgørelse2023_tom_dis_er_kildebelagt_og_neutral
? årsopgørelse2023_ligningsfradrag_er_beregningsklart
? årsopgørelse2023_ligningsfradrag_matcher
? årsopgørelse2023_ægtefælleoverførsel_matcher
? årsopgørelse2023_skattepligtig_indkomst_matcher
? årsopgørelse2023_fradrag_og_ægtefælle_matcher
? årsopgørelse2023_slutskat_matcher
? årsopgørelse2023_afregning_matcher
? årsopgørelse2024_indkomstgrundlag_matcher
? årsopgørelse2024_pbl49_kildekæde_matcher
? årsopgørelse2024_tomt_sømandsfradrag_er_kildebelagt_og_neutralt
? årsopgørelse2024_tom_dis_er_kildebelagt_og_neutral
? årsopgørelse2024_fradrag_og_ægtefælle_matcher
? årsopgørelse2024_slutskat_matcher
? årsopgørelse2024_afregning_matcher

@ print("2023 årsopgørelse: Futuruna-slutskat i øre = " + vis(årsopgørelse2023_resultat.slutskat_øre))
@ print("2024 årsopgørelse: Futuruna-slutskat i øre = " + vis(årsopgørelse2024_resultat.slutskat_øre))
