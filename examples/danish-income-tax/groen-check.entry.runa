@ sprog da
@ importer ./groen-check

= grøn_check_beregningsmeta = Beregningsmeta(
    felter = [
        Beregningsfelt(path = refof(GrønCheckInput::børneforhold::$variant), label = "Børneforhold", question = Some("Kendes alle børn og deres børne-/ungeydelse?"), help = Some("Uoplyste børneforhold er ikke nul børn. En tom liste kræver udtrykkelig fuldstændighed og kilde. Børne-/ungeydelse er ikke det ekstra børnetilskud til enlige forsørgere."), unit = None),
        Beregningsfelt(path = refof(GrønCheckInput::børneforhold::GrønCheckOplysteBørn::børn::børneydelse_ved_årets_udløb), label = "Din ret til børne-/ungeydelsen ved årets udløb", question = Some("Har du ret til ingen, halv, hele eller resten af ydelsen, når en del går til barnet selv?"), help = Some("Ret efter børne- og ungeydelseslovens § 4, ikke blot et modtaget nettobeløb. Halv ydelse giver 120 kr.; hel ydelse giver 240 kr. før loft og indkomstaftrapning. RestEfterYdelseTilBarnet gælder fra 2026 for forældremyndighedsindehaveren, som modtager resten efter Udbetaling Danmarks afgørelse. Den giver dobbelt enkeltbeløb; beregningen tilbageholdes, hvis den uafklarede loftsforhøjelse kan ændre beløbet. Modtager barnet hele ydelsen, har forælderen ingen ydelse for det barn."), unit = None)
    ],
    attachments = (
        Source(value = grøn_check_kilder),
        Warning(value = "Kompakt delberegning; ændrer ikke Personskats årsopgørelse eller den betingede rapportafstemning automatisk.")
    )
)

@ meta(grøn_check_beregningsmeta)
@ entry("Grøn check — kildefakta, aftrapning og rapportkontrol")
> vurder_grøn_check(input: GrønCheckInput) -> GrønCheckResultat {
    vurder_grøn_check_input(input)
}
