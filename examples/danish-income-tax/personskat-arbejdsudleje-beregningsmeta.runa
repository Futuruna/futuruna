@ sprog da

@ importer ./kildeskatteloven - arbejdsudleje
@ importer ./metadata
@ importer ./personskat - personlig - indkomst - kildefakta

= personskat_arbejdsudleje_felt_samling = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje),
    label = "Arbejdsudlejede personer",
    question = Some("Hvilke vederlag vedrører personer, som en udenlandsk arbejdsgiver har stillet til rådighed for en dansk virksomhed?"),
    help = Some("Opret én række pr. arbejdsudlejeforhold. Futuruna afgrænser selv KSL § 2, stk. 1, nr. 3 og beregner enten den endelige skat eller den ordinære Personskat-gren."),
    unit = None
)
= personskat_arbejdsudleje_felt_identifikation = TypetBeregningsfelt(
