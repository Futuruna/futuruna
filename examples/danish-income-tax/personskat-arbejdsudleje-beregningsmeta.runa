@ sprog da

@ importer ./kildeskatteloven-arbejdsudleje
@ importer ./metadata
@ importer ./personskat-personlig-indkomst-kildefakta

= personskat_arbejdsudleje_felt_valgår = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::beskatningsvalg::ValgtOrdinærBeskatningEfterPar2Stk1Nr1::valgdato::år),
    label = "Valgdato for ordinær beskatning (ISO 8601) - år",
    question = Some("I hvilket år blev ordinær beskatning valgt?"),
    help = Some("Valget skal være truffet senest 1. maj året efter indkomståret."),
    unit = Some("år")
)
= personskat_arbejdsudleje_felt_valgmåned = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::beskatningsvalg::ValgtOrdinærBeskatningEfterPar2Stk1Nr1::valgdato::måned),
    label = "Valgdato for ordinær beskatning (ISO 8601) - måned",
    question = Some("I hvilken måned blev ordinær beskatning valgt?"),
    help = None,
    unit = Some("måned")
)
= personskat_arbejdsudleje_felt_valgdag = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::beskatningsvalg::ValgtOrdinærBeskatningEfterPar2Stk1Nr1::valgdato::dag),
    label = "Valgdato for ordinær beskatning (ISO 8601) - dag",
    question = Some("På hvilken dag blev ordinær beskatning valgt?"),
    help = None,
    unit = Some("dag")
)
= personskat_arbejdsudleje_felt_arbejdsgiverbidrag = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::udenlandsk_arbejdsgiverbidrag::bidrag_kroner),
    label = "Udenlandsk obligatorisk socialt arbejdsgiverbidrag",
    question = Some("Hvor stort udenlandsk socialt arbejdsgiverbidrag påhviler efter aftale lønmodtageren?"),
    help = Some("Et kvalificeret bidrag fradrages efter LL § 8 M før beregningen af KSL § 48 B-skatten eller i personlig indkomst ved ordinært valg."),
    unit = Some("kr./år")
)
= personskat_arbejdsudleje_felt_arbejdsgiverbidragsår = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::udenlandsk_arbejdsgiverbidrag::bidrag_vedrører_indkomstår),
    label = "Indkomstår for det udenlandske arbejdsgiverbidrag",
    question = Some("Hvilket indkomstår vedrører det udenlandske arbejdsgiverbidrag?"),
    help = Some("Et positivt bidrag skal vedrøre samme indkomstår som arbejdsudlejevederlaget."),
    unit = Some("år")
)
= personskat_arbejdsudleje_felt_arbejdsgiverbidrag_obligatorisk = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::udenlandsk_arbejdsgiverbidrag::obligatorisk),
    label = "Arbejdsgiverbidraget er obligatorisk",
    question = Some("Er det udenlandske sociale arbejdsgiverbidrag obligatorisk?"),
    help = None,
    unit = None
)
= personskat_arbejdsudleje_felt_arbejdsgiverbidrag_eu = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::udenlandsk_arbejdsgiverbidrag::omfattet_af_eu_socialsikringsforordning),
    label = "Arbejdsgiverbidraget er omfattet af EU's socialsikringsforordning",
    question = Some("Er bidraget omfattet af EU's forordninger om social sikring?"),
    help = None,
    unit = None
)
= personskat_arbejdsudleje_felt_arbejdsgiverbidrag_aftale = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::arbejdsudleje::udenlandsk_arbejdsgiverbidrag::aftale_om_at_bidrag_påhviler_lønmodtageren),
    label = "Aftale om at arbejdsgiverbidraget påhviler lønmodtageren",
    question = Some("Er det aftalt, at arbejdsgiverbidraget økonomisk påhviler lønmodtageren?"),
    help = Some("Fradraget efter LL § 8 M kræver, at bidraget efter aftale påhviler lønmodtageren."),
    unit = None
)

= personskat_arbejdsudleje_beregningsmeta = Beregningsmeta(
    felter = [
        personskat_arbejdsudleje_felt_valgår,
        personskat_arbejdsudleje_felt_valgmåned,
        personskat_arbejdsudleje_felt_valgdag,
        personskat_arbejdsudleje_felt_arbejdsgiverbidrag,
        personskat_arbejdsudleje_felt_arbejdsgiverbidragsår,
        personskat_arbejdsudleje_felt_arbejdsgiverbidrag_obligatorisk,
        personskat_arbejdsudleje_felt_arbejdsgiverbidrag_eu,
        personskat_arbejdsudleje_felt_arbejdsgiverbidrag_aftale
    ],
    attachments = (
        Source(value = kildeskattelov_arbejdsudleje_lbk460),
        HistoricalSource(value = kildeskattelov_arbejdsudleje_lbk1330),
        AmendmentSource(value = kildeskattelov_arbejdsudleje_lov710),
        AmendmentSource(value = kildeskattelov_arbejdsudleje_unges_am),
        DependencySource(value = arbejdsmarkedsbidragsloven_lbk121_par2),
        DependencySource(value = ligningsloven_lbk1500_par8m),
        Guidance(value = kildeskattelov_arbejdsudleje_vejledning),
        Guidance(value = kildeskattelov_arbejdsudleje_am_vejledning),
        Guidance(value = kildeskattelov_arbejdsudleje_skat_dk),
        Warning(value = kildeskattelov_arbejdsudleje_par48b_henvisningsadvarsel),
    )
)

@ meta(personskat_arbejdsudleje_beregningsmeta) for PersonskatPersonligIndkomstInput
