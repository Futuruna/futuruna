    question = Some("Er arbejdsgiveren indeholdelsespligtig for arbejdsmarkedsbidrag af lønnen?"),
    help = Some("Futuruna afleder selve arbejdsmarkedsbidraget af lønnen og sikrer, at det ikke fradrages to gange."),
    unit = None
)
= personskat_socialbidrag_felt_udenlandsk_beløb = Beregningsfelt(
