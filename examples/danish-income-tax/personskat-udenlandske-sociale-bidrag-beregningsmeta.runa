@ sprog da

@ importer ./metadata
@ importer ./personskat-udenlandske-sociale-bidrag-kildefakta

= personskat_socialbidrag_felt_art = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::$variant),
    label = "Udenlandske sociale bidrag",
    question = Some("Har du betalt udenlandske sociale bidrag, som skal vurderes efter ligningslovens § 8 M?"),
    help = Some("Arbejdsmarkedsbidrag af den almindelige løn beregnes allerede af Futuruna. Her oplyses kun fakta om udenlandske sociale bidrag."),
    unit = None
)
= personskat_socialbidrag_felt_udenlandsk_beløb = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::MedUdenlandskeSocialeBidragEfterLigningslov8M::fakta::udenlandsk_socialt_bidrag::bidrag_kroner),
    label = "Udenlandsk socialt bidrag",
    question = Some("Hvor meget har du betalt i obligatorisk udenlandsk socialt bidrag?"),
    help = None,
    unit = Some("kr.")
)
= personskat_socialbidrag_felt_arbejdsgiver_beløb = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::MedUdenlandskeSocialeBidragEfterLigningslov8M::fakta::udenlandsk_arbejdsgiverbidrag::bidrag_kroner),
    label = "Udenlandsk socialt arbejdsgiverbidrag",
    question = Some("Hvor meget udgør det udenlandske obligatoriske sociale arbejdsgiverbidrag?"),
    help = None,
    unit = Some("kr.")
)
= personskat_socialbidrag_felt_arbejdsgiver_år = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::MedUdenlandskeSocialeBidragEfterLigningslov8M::fakta::udenlandsk_arbejdsgiverbidrag::bidrag_vedrører_indkomstår),
    label = "Indkomstår for arbejdsgiverbidrag",
    question = Some("Hvilket indkomstår vedrører det udenlandske arbejdsgiverbidrag?"),
    help = None,
    unit = Some("år")
)
= personskat_socialbidrag_felt_arbejdsgiver_obligatorisk = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::MedUdenlandskeSocialeBidragEfterLigningslov8M::fakta::udenlandsk_arbejdsgiverbidrag::obligatorisk),
    label = "Arbejdsgiverbidraget er obligatorisk",
    question = Some("Er det udenlandske sociale arbejdsgiverbidrag obligatorisk?"),
    help = None,
    unit = None
)
= personskat_socialbidrag_felt_arbejdsgiver_eu = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::MedUdenlandskeSocialeBidragEfterLigningslov8M::fakta::udenlandsk_arbejdsgiverbidrag::omfattet_af_eu_socialsikringsforordning),
    label = "Arbejdsgiverbidrag efter EU-socialsikring",
    question = Some("Er arbejdsgiverbidraget omfattet af EU's socialsikringsforordning?"),
    help = None,
    unit = None
)
= personskat_socialbidrag_felt_arbejdsgiver_aftale = Beregningsfelt(
    path = refof(PersonskatInput::udenlandske_sociale_bidrag::MedUdenlandskeSocialeBidragEfterLigningslov8M::fakta::udenlandsk_arbejdsgiverbidrag::aftale_om_at_bidrag_påhviler_lønmodtageren),
    label = "Aftale om at bidraget påhviler lønmodtageren",
    question = Some("Er der indgået en aftale efter EU-reglerne om, at arbejdsgiverbidraget påhviler lønmodtageren?"),
    help = None,
    unit = None
)

= personskat_udenlandske_sociale_bidrag_beregningsmeta = Beregningsmeta(
    felter = [
        personskat_socialbidrag_felt_art,
        personskat_socialbidrag_felt_udenlandsk_beløb,
        personskat_socialbidrag_felt_arbejdsgiver_beløb,
        personskat_socialbidrag_felt_arbejdsgiver_år,
        personskat_socialbidrag_felt_arbejdsgiver_obligatorisk,
        personskat_socialbidrag_felt_arbejdsgiver_eu,
        personskat_socialbidrag_felt_arbejdsgiver_aftale
    ],
    attachments = (
        Source(value = ligningsloven_2025_1500),
        DependencySource(value = personskatteloven_2021_1284),
    )
)

@ meta(personskat_udenlandske_sociale_bidrag_beregningsmeta) for beregn_personskat
