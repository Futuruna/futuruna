@ sprog da

@ importer ./metadata
@ importer ./personskat - udenlandske - sociale - bidrag - kildefakta

= personskat_socialbidrag_felt_art = Beregningsfelt(
    path = "udenlandske_sociale_bidrag.$variant",
    label = "Udenlandske sociale bidrag",
    question = Some("Har du betalt udenlandske sociale bidrag, som skal vurderes efter ligningslovens § 8 M?"),
    help = Some("Arbejdsmarkedsbidrag af den almindelige løn beregnes allerede af Futuruna. Her oplyses kun fakta om udenlandske sociale bidrag."),
    unit = None
)
= personskat_socialbidrag_felt_kildeskattepligt = Beregningsfelt(
    path = "udenlandske_sociale_bidrag.MedUdenlandskeSocialeBidragEfterLigningslov8M.fakta.kildeskattepligt",
    label = "Skattepligt efter kildeskatteloven",
    question = Some("Hvilken skattepligt efter kildeskatteloven gælder for personen?"),
    help = Some("Fuld skattepligt efter § 1 og begrænset skattepligt efter § 2 har forskellige fradragsgrene i ligningslovens § 8 M."),
    unit = None
)
