    question = Some("Hvor meget har du betalt i obligatorisk udenlandsk socialt bidrag?"),
    help = None,
    unit = Some("kr.")
)
= personskat_socialbidrag_felt_udenlandsk_år = Beregningsfelt(
    path = "udenlandske_sociale_bidrag.MedUdenlandskeSocialeBidragEfterLigningslov8M.fakta.udenlandsk_socialt_bidrag.bidrag_vedrører_indkomstår",
