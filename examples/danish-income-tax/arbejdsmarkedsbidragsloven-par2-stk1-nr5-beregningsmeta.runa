@ sprog da

@ importer ./metadata
@ importer ./arbejdsmarkedsbidragsloven - par2 - stk1 - nr5

= ambl_par2_nr5_felt_indbetalinger = TypetBeregningsfelt(
    path = refof(AmblPar2Nr5Årsgrundlag::indbetalinger),
    label = "Arbejdsgiverindbetalinger til udenlandske pensionsordninger",
    question = Some("Hvilke arbejdsgiverindbetalinger til udenlandske pensionsordninger skal vurderes efter en dobbeltbeskatningsoverenskomst?"),
    help = Some("Tilføj én række pr. indbetaling. Futuruna udleder den ikke-skattepligtige del, den skattepligtige del og hvert arbejdsmarkedsbidragsgrundlag fra de dokumenterede kildefakta. Rækkefølgen afgør kun, hvilken række der bærer et eventuelt beløb over en delt årsramme; årssummerne er uændrede."),
    unit = None
)
