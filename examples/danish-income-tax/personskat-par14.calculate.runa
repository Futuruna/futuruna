        Guidance(value = personskat_par14_beregningscirkulære),
    )
)

--@label:beregn_personskat_delår::meta:personskat_par14_beregningsmeta--

| personskat_par14_kilder_for_felt(kilder: List(PersonskatPar14Kilde), felt: PersonskatPar14Beregningsfelt) -> filter(kilder, |kilde: PersonskatPar14Kilde| kilde.beregningsfelt == felt)
| personskat_par14_delårsbeløb_for_felt(kilder: List(PersonskatPar14Kilde), felt: PersonskatPar14Beregningsfelt) -> foldl(
    personskat_par14_kilder_for_felt(kilder, felt),
    0,
    |sum: Heltal, kilde: PersonskatPar14Kilde| sum + kilde.delårsbeløb_kroner
)
| personskat_par14_omregnet_helårsbeløb_for_kilde(kilde: PersonskatPar14Kilde, skattepligtsdage: Heltal, skatteår: Heltal) -> par14_helårsbeløb_for_post(Par14Beløbspost(
    identifikation = kilde.identifikation,
    delårsbeløb_kroner = kilde.delårsbeløb_kroner,
    metode = kilde.omregningsmetode
    ), skattepligtsdage, skatteår)
| personskat_par14_omregnet_helårsbeløb_for_felt(kilder: List(PersonskatPar14Kilde), felt: PersonskatPar14Beregningsfelt, skattepligtsdage: Heltal, skatteår: Heltal) -> foldl(
    personskat_par14_kilder_for_felt(kilder, felt),
    0,
    |sum: Heltal, kilde: PersonskatPar14Kilde| sum + personskat_par14_omregnet_helårsbeløb_for_kilde(kilde, skattepligtsdage, skatteår)
)
| personskat_par14_faktisk_helårsbeløb_for_kilde(kilde: PersonskatPar14Kilde) -> match kilde.faktisk_helårsbeløb_kroner {
    | Some(beløb_kroner) -> beløb_kroner
    | None -> 0
}
| personskat_par14_faktisk_helårsbeløb_for_felt(kilder: List(PersonskatPar14Kilde), felt: PersonskatPar14Beregningsfelt) -> foldl(
    personskat_par14_kilder_for_felt(kilder, felt),
    0,
    |sum: Heltal, kilde: PersonskatPar14Kilde| sum + personskat_par14_faktisk_helårsbeløb_for_kilde(kilde)
)
| personskat_par14_valgt_helårsbeløb_for_felt(kilder: List(PersonskatPar14Kilde), felt: PersonskatPar14Beregningsfelt, skattepligtsdage: Heltal, skatteår: Heltal, valg: Par14ValgResultat) -> hvis valg.helårsomregning_skal_ske {
    personskat_par14_omregnet_helårsbeløb_for_felt(kilder, felt, skattepligtsdage, skatteår)
} ellers {
    personskat_par14_faktisk_helårsbeløb_for_felt(kilder, felt)
}
| personskat_par14_kilde_gyldig(kilde: PersonskatPar14Kilde) -> kilde.identifikation != ""
| personskat_par14_kildeidentifikationer_entydige(kilder: List(PersonskatPar14Kilde)) -> length(distinct(map(kilder, |kilde: PersonskatPar14Kilde| kilde.identifikation))) == length(kilder)
| personskat_par14_faktiske_helårsbeløb_oplyst(kilder: List(PersonskatPar14Kilde)) -> all(kilder, |kilde: PersonskatPar14Kilde| match kilde.faktisk_helårsbeløb_kroner { | Some(_) -> Sandt | None -> Falskt })
| personskat_par14_kilder_gyldige(kilder: List(PersonskatPar14Kilde), valg: Par14ValgResultat) -> length(kilder) > 0 && personskat_par14_kildeidentifikationer_entydige(kilder) && all(kilder, personskat_par14_kilde_gyldig) && (valg.helårsomregning_skal_ske || personskat_par14_faktiske_helårsbeløb_oplyst(kilder))

| personskat_par14_skattepligtsdage(periode: PersonskatPar14Skattepligtsperiode) -> dato_dage_fra_og_med_til_og_med(periode.fra_dato, periode.til_dato)
| personskat_par14_periodegrænser_matcher(status: Par14Skattepligtsændring, periode: PersonskatPar14Skattepligtsperiode, skatteår: Heltal) -> match status {
    | FuldSkattepligtIndtræder -> periode.til_dato == Dato(år = skatteår, måned = 12, dag = 31) && periode.fra_dato != Dato(år = skatteår, måned = 1, dag = 1)
    | FuldSkattepligtOphører -> periode.fra_dato == Dato(år = skatteår, måned = 1, dag = 1) && periode.til_dato != Dato(år = skatteår, måned = 12, dag = 31)
    | BegrænsetSkattepligtPar10Stk6Indtræder -> periode.til_dato == Dato(år = skatteår, måned = 12, dag = 31) && periode.fra_dato != Dato(år = skatteår, måned = 1, dag = 1)
    | BegrænsetSkattepligtPar10Stk6Ophører -> periode.fra_dato == Dato(år = skatteår, måned = 1, dag = 1) && periode.til_dato != Dato(år = skatteår, måned = 12, dag = 31)
    | BegrænsetSkattepligtPar10Stk5Indtræder -> periode.til_dato == Dato(år = skatteår, måned = 12, dag = 31) && periode.fra_dato != Dato(år = skatteår, måned = 1, dag = 1)
    | BegrænsetSkattepligtPar10Stk5Ophører -> periode.fra_dato == Dato(år = skatteår, måned = 1, dag = 1) && periode.til_dato != Dato(år = skatteår, måned = 12, dag = 31)
    | IngenSkattepligtsændring -> Falskt
}
| personskat_par14_periode_gyldig(status: Par14Skattepligtsændring, periode: PersonskatPar14Skattepligtsperiode, skatteår: Heltal) -> dato_gyldig(periode.fra_dato) && dato_gyldig(periode.til_dato) && periode.fra_dato.år == skatteår && periode.til_dato.år == skatteår && dato_før_eller_lig_med(periode.fra_dato, periode.til_dato) && par14_skattepligtsdage_gyldige(skatteår, personskat_par14_skattepligtsdage(periode)) && par14_helårsomregning_gælder_for_skatteår(status, skatteår) && personskat_par14_periodegrænser_matcher(status, periode, skatteår)
| personskat_par14_skattepligt_forenelig(status: Par14Skattepligtsændring, forhold: LønmodtagerSkatteforhold) -> match status {
    | FuldSkattepligtIndtræder -> forhold.personfradrag_skattepligt == FuldtSkattepligtigHerILandet
    | FuldSkattepligtOphører -> forhold.personfradrag_skattepligt == FuldtSkattepligtigHerILandet
    | BegrænsetSkattepligtPar10Stk6Indtræder -> forhold.personfradrag_skattepligt == KildeskattelovPar2DelårValgtRelevantIndtægt
    | BegrænsetSkattepligtPar10Stk6Ophører -> forhold.personfradrag_skattepligt == KildeskattelovPar2DelårValgtRelevantIndtægt
    | BegrænsetSkattepligtPar10Stk5Indtræder -> forhold.personfradrag_skattepligt == KildeskattelovPar2DelårValgtRelevantIndtægt
    | BegrænsetSkattepligtPar10Stk5Ophører -> forhold.personfradrag_skattepligt == KildeskattelovPar2DelårValgtRelevantIndtægt
    | IngenSkattepligtsændring -> Falskt
}
| personskat_par14_helårsstruktur_forenelig(delårsinput: LønmodtagerInput, helårsinput: LønmodtagerInput, delårsforhold: LønmodtagerSkatteforhold, helårsforhold: LønmodtagerSkatteforhold) -> delårsinput.skatteår == helårsinput.skatteår && delårsinput.kommune == helårsinput.kommune && delårsinput.personfradrag_alder_status == helårsinput.personfradrag_alder_status && delårsinput.betaler_kirkeskat == helårsinput.betaler_kirkeskat && delårsforhold.par8c_status == helårsforhold.par8c_status && delårsforhold.personfradrag_skattepligt == helårsforhold.personfradrag_skattepligt && delårsforhold.personfradrag_valg_dato_yyyymmdd == helårsforhold.personfradrag_valg_dato_yyyymmdd && delårsforhold.personfradrag_omvalg_dato_yyyymmdd == helårsforhold.personfradrag_omvalg_dato_yyyymmdd

| personskat_par14_delårsinput(resultat: PersonskatBeregningResultat, input: PersonskatInput) -> LønmodtagerInput(
    skatteår = input.lønmodtager.skatteår,
    kommune = input.lønmodtager.kommune,
    bruttoløn_kroner = resultat.skat.bruttoløn_kroner,
    øvrig_personlig_indkomst_kroner = resultat.skat.øvrig_personlig_indkomst_kroner,
    nettokapitalindkomst_kroner = resultat.skat.nettokapitalindkomst_kroner,
    ligningsmæssige_fradrag_kroner = resultat.skat.øvrige_ligningsmæssige_fradrag_kroner,
    pensionsfradrag = resultat.pension.lønmodtager_pensionsfradrag,
    personfradrag_alder_status = input.lønmodtager.personfradrag_alder_status,
    betaler_kirkeskat = input.lønmodtager.betaler_kirkeskat
)
| personskat_par14_helårspensionsfradrag(delårsfradrag: LønmodtagerPensionsfradrag, kilder: List(PersonskatPar14Kilde), skattepligtsdage: Heltal, skatteår: Heltal, valg: Par14ValgResultat) -> LønmodtagerPensionsfradrag(
    fødselsdato = delårsfradrag.fødselsdato,
    pbl18_fradragsberettiget_indbetaling_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl18FradragsberettigetIndbetaling, skattepligtsdage, skatteår, valg),
    pbl19_rate_ophørende_bortseelsesret_før_am_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl19RateOgOphørendeFørArbejdsmarkedsbidrag, skattepligtsdage, skatteår, valg),
    pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl19RateOgOphørendeEfterArbejdsmarkedsbidrag, skattepligtsdage, skatteår, valg),
    pbl19_øvrige_indbetalinger_efter_am_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl19ØvrigeIndbetalingerEfterArbejdsmarkedsbidrag, skattepligtsdage, skatteår, valg),
    øvrigt_arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14ØvrigtArbejdsmarkedsbidragsgrundlagMedIndeholdtBidrag, skattepligtsdage, skatteår, valg),
    ambl_par2_stk1_nr5_arbejdsmarkedsbidragsgrundlag_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14AmblPar2Stk1Nr5Arbejdsmarkedsbidragsgrundlag, skattepligtsdage, skatteår, valg),
    pbl20_indkomstskattepligtig_udbetaling_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl20IndkomstskattepligtigUdbetaling, skattepligtsdage, skatteår, valg),
    pbl20_udbetaling_status = delårsfradrag.pbl20_udbetaling_status
)
| personskat_par14_helårsinput(delårsinput: LønmodtagerInput, kilder: List(PersonskatPar14Kilde), skattepligtsdage: Heltal, valg: Par14ValgResultat) -> LønmodtagerInput(
    skatteår = delårsinput.skatteår,
    kommune = delårsinput.kommune,
    bruttoløn_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Bruttoløn, skattepligtsdage, delårsinput.skatteår, valg),
    øvrig_personlig_indkomst_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14ØvrigPersonligIndkomst, skattepligtsdage, delårsinput.skatteår, valg),
    nettokapitalindkomst_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Nettokapitalindkomst, skattepligtsdage, delårsinput.skatteår, valg),
    ligningsmæssige_fradrag_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14ØvrigeLigningsmæssigeFradrag, skattepligtsdage, delårsinput.skatteår, valg),
    pensionsfradrag = personskat_par14_helårspensionsfradrag(delårsinput.pensionsfradrag, kilder, skattepligtsdage, delårsinput.skatteår, valg),
    personfradrag_alder_status = delårsinput.personfradrag_alder_status,
    betaler_kirkeskat = delårsinput.betaler_kirkeskat
)
| personskat_par14_kilder_afstemt_med_delårsinput(kilder: List(PersonskatPar14Kilde), delårsinput: LønmodtagerInput, skatteforhold: LønmodtagerSkatteforhold) -> personskat_par14_delårsbeløb_for_felt(kilder, Par14Bruttoløn) == delårsinput.bruttoløn_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14ØvrigPersonligIndkomst) == delårsinput.øvrig_personlig_indkomst_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Nettokapitalindkomst) == delårsinput.nettokapitalindkomst_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14ØvrigeLigningsmæssigeFradrag) == delårsinput.ligningsmæssige_fradrag_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Pbl18FradragsberettigetIndbetaling) == delårsinput.pensionsfradrag.pbl18_fradragsberettiget_indbetaling_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Pbl19RateOgOphørendeFørArbejdsmarkedsbidrag) == delårsinput.pensionsfradrag.pbl19_rate_ophørende_bortseelsesret_før_am_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Pbl19RateOgOphørendeEfterArbejdsmarkedsbidrag) == delårsinput.pensionsfradrag.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Pbl19ØvrigeIndbetalingerEfterArbejdsmarkedsbidrag) == delårsinput.pensionsfradrag.pbl19_øvrige_indbetalinger_efter_am_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14ØvrigtArbejdsmarkedsbidragsgrundlagMedIndeholdtBidrag) == delårsinput.pensionsfradrag.øvrigt_arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14AmblPar2Stk1Nr5Arbejdsmarkedsbidragsgrundlag) == delårsinput.pensionsfradrag.ambl_par2_stk1_nr5_arbejdsmarkedsbidragsgrundlag_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Pbl20IndkomstskattepligtigUdbetaling) == delårsinput.pensionsfradrag.pbl20_indkomstskattepligtig_udbetaling_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14Aktieindkomst) == skatteforhold.aktieindkomst_kroner && personskat_par14_delårsbeløb_for_felt(kilder, Par14CfcIndkomst) == skatteforhold.cfc_indkomst_kroner
| personskat_par14_kilder_afstemt_med_valgt_helår(kilder: List(PersonskatPar14Kilde), helårsinput: LønmodtagerInput, skatteforhold: LønmodtagerSkatteforhold, skattepligtsdage: Heltal, valg: Par14ValgResultat) -> personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Bruttoløn, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.bruttoløn_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14ØvrigPersonligIndkomst, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.øvrig_personlig_indkomst_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Nettokapitalindkomst, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.nettokapitalindkomst_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14ØvrigeLigningsmæssigeFradrag, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.ligningsmæssige_fradrag_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl18FradragsberettigetIndbetaling, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.pbl18_fradragsberettiget_indbetaling_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl19RateOgOphørendeFørArbejdsmarkedsbidrag, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.pbl19_rate_ophørende_bortseelsesret_før_am_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl19RateOgOphørendeEfterArbejdsmarkedsbidrag, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl19ØvrigeIndbetalingerEfterArbejdsmarkedsbidrag, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.pbl19_øvrige_indbetalinger_efter_am_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14ØvrigtArbejdsmarkedsbidragsgrundlagMedIndeholdtBidrag, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.øvrigt_arbejdsmarkedsbidragsgrundlag_med_indeholdt_bidrag_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14AmblPar2Stk1Nr5Arbejdsmarkedsbidragsgrundlag, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.ambl_par2_stk1_nr5_arbejdsmarkedsbidragsgrundlag_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Pbl20IndkomstskattepligtigUdbetaling, skattepligtsdage, helårsinput.skatteår, valg) == helårsinput.pensionsfradrag.pbl20_indkomstskattepligtig_udbetaling_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Aktieindkomst, skattepligtsdage, helårsinput.skatteår, valg) == skatteforhold.aktieindkomst_kroner && personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14CfcIndkomst, skattepligtsdage, helårsinput.skatteår, valg) == skatteforhold.cfc_indkomst_kroner
| personskat_par14_skatteforhold_med_valgte_helårsbeløb(forhold: LønmodtagerSkatteforhold, kilder: List(PersonskatPar14Kilde), skattepligtsdage: Heltal, skatteår: Heltal, valg: Par14ValgResultat) -> LønmodtagerSkatteforhold(
    aktieindkomst_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14Aktieindkomst, skattepligtsdage, skatteår, valg),
    ægtefælle_aktieindkomst_kroner = forhold.ægtefælle_aktieindkomst_kroner,
    aktieindkomst_ægtefæller_samlevende_ved_årets_udløb = forhold.aktieindkomst_ægtefæller_samlevende_ved_årets_udløb,
    ægtefælle_nettokapitalindkomst_kroner = forhold.ægtefælle_nettokapitalindkomst_kroner,
    kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb = forhold.kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb,
    cfc_indkomst_kroner = personskat_par14_valgt_helårsbeløb_for_felt(kilder, Par14CfcIndkomst, skattepligtsdage, skatteår, valg),
    par8c_status = forhold.par8c_status,
    personfradrag_skattepligt = forhold.personfradrag_skattepligt,
    personfradrag_valg_dato_yyyymmdd = forhold.personfradrag_valg_dato_yyyymmdd,
    personfradrag_omvalg_dato_yyyymmdd = forhold.personfradrag_omvalg_dato_yyyymmdd
)
| personskat_par14_uden_ægtefælle(input: PersonskatÆgtefælleInput) -> match input { | UdenÆgtefælle -> Sandt | _ -> Falskt }
| personskat_par14_standardunderskud(input: PersonskatUnderskudsforholdInput) -> match input { | StandardUnderskudsforhold -> Sandt | _ -> Falskt }
| personskat_par14_udenlandske_sociale_bidrag_gyldige(resultat: PersonskatUdenlandskeSocialeBidragResultat) -> match resultat {
    | IngenUdenlandskeSocialeBidragEfterLigningslov8M -> Sandt
    | BeregnetUdenlandskSocialbidragsfradrag(_, _, _, _, _, _) -> Sandt
    | UgyldigtUdenlandskSocialbidragsgrundlag(_, _, _) -> Falskt
}
| personskat_par14_kursgevinst_par32_gyldig(resultat: PersonskatKursgevinstPar32ParResultat) -> match resultat {
    | IntetPar32Kontraktforløb -> Sandt
    | BeregnetPar32Kontraktforløb(_, _, _, _, input_gyldigt) -> input_gyldigt
}
| personskat_par14_pension_gyldig(resultat: PersonskatPensionsResultat) -> resultat.pensionsalder_resultat.input_gyldigt && resultat.pbl18_årsresultat.input_gyldigt && resultat.ambl_par2_stk1_nr5_resultat.input_gyldigt && resultat.udbetalingsresultat.aktuelle_input_gyldige && resultat.udbetalingsresultat.foregående_input_gyldige
| personskat_par14_resultatgrundlag_gyldigt(resultat: PersonskatBeregningResultat) -> resultat.personlig_indkomst.alle_input_gyldige && resultat.erhvervsbefordring.alle_input_gyldige && resultat.ligningsfradrag.alle_input_gyldige && resultat.kapitalindkomst.alle_input_gyldige && resultat.aktieavance.alle_input_gyldige && resultat.cfc.alle_input_gyldige && personskat_par14_pension_gyldig(resultat.pension) && personskat_par14_udenlandske_sociale_bidrag_gyldige(resultat.udenlandske_sociale_bidrag) && personskat_par14_kursgevinst_par32_gyldig(resultat.kursgevinst_par32) && resultat.kildeskat25a.alle_input_gyldige && resultat.underskudsår.alle_åbningsgrundlag_gyldige && resultat.personskattelov13a.alle_kildegrundlag_gyldige && resultat.personskattelov13a.stk2_nedsættelser_stabile && resultat.aktieindkomst_parår.input_gyldigt && resultat.negativ_aktieskat_fremførselsår.alle_åbningsgrundlag_gyldige && resultat.ejendomsskatter.alle_input_gyldige && resultat.ejendomsskatter.regelgrundlag_understøttet && resultat.ligningslov33.input_gyldigt && resultat.ligningslov33a.input_gyldigt && resultat.kildeskat_par8a_kredit_input_gyldigt && resultat.kildeskat_ambl_par6_kredit_input_gyldigt && resultat.kildeskat_al40c_acontoskat_input_gyldigt && resultat.afskrivningslov40c_acontoskat.kildefakta_gyldige
| personskat_par14_resultat_uden_senere_særregimer(resultat: PersonskatBeregningResultat) -> resultat.sømandsbeskatning.input_gyldigt && resultat.sømandsbeskatning_eksakt.input_gyldigt && resultat.sømandsbeskatning.dis_personlig_indkomst_kroner == 0 && resultat.personlig_indkomst.samlet_endelig_arbejdsudlejebeskatning_kroner == 0 && resultat.hovedpersons_ligningslov33_og_33a_nedslag_øre == 0 && resultat.personskattelov_par8a_stk5_kredit_øre == 0 && resultat.arbejdsmarkedsbidragslov_par6_kredit_øre == 0 && resultat.afskrivningslov40c_acontoskat_kredit_øre == 0 && resultat.skat.kræver_par13_underskud == Falskt && resultat.skat.par11_nedslag_kroner == 0 && resultat.hovedskat_eksakt.samlet_inkl_am_øre == resultat.eksakt_ordinær_skat_efter_dis_øre
| personskat_par14_personligt_grundlag_kroner(input: LønmodtagerInput) -> penge_positivt_beløb(personlig_indkomst_efter_am(input))
| personskat_par14_positivt_kapitalgrundlag_kroner(input: LønmodtagerInput) -> penge_positivt_beløb(input.nettokapitalindkomst_kroner)
| personskat_par14_bundskattegrundlag_kroner(input: LønmodtagerInput) -> penge_positivt_beløb(bundskat_grundlag_fixture(input))
| personskat_par14_skattepligtigt_grundlag_kroner(input: LønmodtagerInput) -> penge_positivt_beløb(almindelig_skattepligtig_indkomst_fixture(input))
| personskat_par14_skattepligtigt_resultatgrundlag_kroner(resultat: LønmodtagerBreakdown) -> penge_positivt_beløb(resultat.almindelig_skattepligtig_indkomst_kroner)
| personskat_par14_positiv_aktieindkomst_kroner(forhold: LønmodtagerSkatteforhold) -> penge_positivt_beløb(forhold.aktieindkomst_kroner)
| personskat_par14_positiv_cfc_indkomst_kroner(forhold: LønmodtagerSkatteforhold) -> penge_positivt_beløb(forhold.cfc_indkomst_kroner)
| personskat_par14_par8_grundlag_kroner(input: LønmodtagerInput) -> personskat_par14_skattepligtigt_grundlag_kroner(input) under input.skatteår < 2026
| exception personskat_par14_toptopskat_personligt_grundlag personskat_par14_par8_grundlag_kroner(input: LønmodtagerInput) -> personskat_par14_personligt_grundlag_kroner(input) under input.skatteår >= 2026
| personskat_par14_par7_personlig_helårsskat_øre(input: LønmodtagerInput) -> {
    = resultat = lønmodtager_par7_topskat_resultat(input)
    penge_beløb_gange_basispoint_øre(resultat.personlig_over_bundfradrag_kroner, nationalparametre_for(input.skatteår).topskat_basispoint)
} under input.skatteår < 2026
| exception personskat_par14_reform_mellemskat_personlig personskat_par14_par7_personlig_helårsskat_øre(input: LønmodtagerInput) -> {
    = resultat = lønmodtager_par7_reform_mellemskat_resultat(input)
    penge_beløb_gange_basispoint_øre(resultat.personlig_over_bundfradrag_kroner, resultat.sats_basispoint)
} under input.skatteår >= 2026
| personskat_par14_par7_kapital_helårsskat_øre(input: LønmodtagerInput) -> {
    = resultat = lønmodtager_par7_topskat_resultat(input)
    penge_beløb_gange_basispoint_øre(resultat.kapitalgrundlag_kroner, nationalparametre_for(input.skatteår).topskat_basispoint)
} under input.skatteår < 2026
| exception personskat_par14_reform_mellemskat_kapital personskat_par14_par7_kapital_helårsskat_øre(input: LønmodtagerInput) -> {
    = resultat = lønmodtager_par7_reform_mellemskat_resultat(input)
    penge_beløb_gange_basispoint_øre(resultat.kapitalgrundlag_kroner, resultat.sats_basispoint)
} under input.skatteår >= 2026
| personskat_par14_progressive_skatter_opdelbare(input: LønmodtagerInput, beregning: LønmodtagerEksaktBeregning) -> beregning.efter_par11.par7_skat_øre == personskat_par14_par7_personlig_helårsskat_øre(input) + personskat_par14_par7_kapital_helårsskat_øre(input) && beregning.efter_par11.par7a_skat_øre == beregning.før_nedsættelser.par7a_skat_øre && beregning.efter_par11.par8_skat_øre == beregning.før_nedsættelser.par8_skat_øre
| personskat_par14_skattekomponent(art: Par14Skattekomponentart, helårsskat_øre: Heltal, delårsgrundlag_kroner: Heltal, helårsgrundlag_kroner: Heltal) -> par14_skattekomponent_resultat(Par14SkattekomponentInput(
    art = art,
    helårsskat_øre = helårsskat_øre,
    delårsgrundlag_kroner = delårsgrundlag_kroner,
    helårsgrundlag_kroner = helårsgrundlag_kroner
))

# PersonskatPar14BeregningSag(input: PersonskatPar14Input) {
    | skatteår() -> input.personskat.lønmodtager.skatteår
    | delårsresultat() -> beregn_personskat(input.personskat)
    | skatteforhold() -> personskat_skatteforhold(input.personskat.skatteforhold, delårsresultat().personlig_indkomst, delårsresultat().aktieavance, delårsresultat().cfc)
    | delårsinput() -> personskat_par14_delårsinput(delårsresultat(), input.personskat)
    | delårsberegning_eksakt() -> delårsresultat().hovedskat_eksakt
    | skattepligtsdage() -> personskat_par14_skattepligtsdage(input.skattepligtsperiode)
    | periode_gyldig() -> personskat_par14_periode_gyldig(input.skattepligtsændring, input.skattepligtsperiode, skatteår())
    | valg() -> par14_valg_resultat(Par14ValgInput(
        skatteår = skatteår(),
        skattepligtsændring = input.skattepligtsændring,
        valg_afgivet_ved_oplysninger = input.valg_afgivet_ved_oplysninger,
        omvalg_dato = input.omvalg_dato
    ))
    | kilder_gyldige() -> personskat_par14_kilder_gyldige(input.kilder, valg())
    | kilder_afstemt_med_personskat() -> personskat_par14_kilder_afstemt_med_delårsinput(input.kilder, delårsinput(), skatteforhold())
    | bruger_dokumenteret_helårsgrundlag() -> match input.helårsgrundlag {
        | AfledtFraIdentificeredeKilder -> Falskt
        | DokumenteretHelårsPersonskat(_) -> Sandt
    }
    | dokumenteret_helårspersonskat() -> match input.helårsgrundlag {
        | AfledtFraIdentificeredeKilder -> input.personskat
        | DokumenteretHelårsPersonskat(personskat) -> personskat
    }
    | helårsresultat() -> beregn_personskat(dokumenteret_helårspersonskat())
    | helårsinput() -> match input.helårsgrundlag {
        | AfledtFraIdentificeredeKilder -> personskat_par14_helårsinput(delårsinput(), input.kilder, skattepligtsdage(), valg())
        | DokumenteretHelårsPersonskat(personskat) -> personskat_par14_delårsinput(helårsresultat(), personskat)
    }
    | helårsskatteforhold() -> match input.helårsgrundlag {
        | AfledtFraIdentificeredeKilder -> personskat_par14_skatteforhold_med_valgte_helårsbeløb(skatteforhold(), input.kilder, skattepligtsdage(), skatteår(), valg())
        | DokumenteretHelårsPersonskat(personskat) -> personskat_skatteforhold(personskat.skatteforhold, helårsresultat().personlig_indkomst, helårsresultat().aktieavance, helårsresultat().cfc)
    }
    | helårsberegning() -> match input.helårsgrundlag {
        | AfledtFraIdentificeredeKilder -> beregn_lønmodtager_med_skatteforhold(helårsinput(), helårsskatteforhold())
        | DokumenteretHelårsPersonskat(_) -> helårsresultat().skat
    }
    | helårsberegning_eksakt() -> match input.helårsgrundlag {
        | AfledtFraIdentificeredeKilder -> beregn_lønmodtager_eksakt(helårsinput(), helårsskatteforhold(), lønmodtager_par13_standard_forhold())
        | DokumenteretHelårsPersonskat(_) -> helårsresultat().hovedskat_eksakt
    }
    | helårsgrundlag_gyldigt() -> {
        = grundstruktur_forenelig = personskat_par14_helårsstruktur_forenelig(delårsinput(), helårsinput(), skatteforhold(), helårsskatteforhold())
        = kilder_afstemt = personskat_par14_kilder_afstemt_med_valgt_helår(input.kilder, helårsinput(), helårsskatteforhold(), skattepligtsdage(), valg())
        = dokumenteret_resultat_gyldigt = match input.helårsgrundlag {
            | AfledtFraIdentificeredeKilder -> Sandt
            | DokumenteretHelårsPersonskat(_) -> personskat_par14_resultatgrundlag_gyldigt(helårsresultat()) && personskat_par14_resultat_uden_senere_særregimer(helårsresultat())
        }
        grundstruktur_forenelig && kilder_afstemt && dokumenteret_resultat_gyldigt
    }
    | kanonisk_beregning_understøttet() -> {
        = resultat = delårsresultat()
        = grundstruktur_understøttet = (bruger_dokumenteret_helårsgrundlag() || (personskat_par14_uden_ægtefælle(input.personskat.ægtefælle) && personskat_par14_standardunderskud(input.personskat.underskudsforhold))) && personskat_par14_skattepligt_forenelig(input.skattepligtsændring, skatteforhold())
        grundstruktur_understøttet && personskat_par14_resultatgrundlag_gyldigt(resultat) && personskat_par14_resultat_uden_senere_særregimer(resultat) && helårsgrundlag_gyldigt() && personskat_par14_progressive_skatter_opdelbare(helårsinput(), helårsberegning_eksakt())
    }
    | omregning() -> Par14OmregningInput(
        skatteår = skatteår(),
        delårs_skattepligtig_indkomst_kroner = delårsresultat().skat.almindelig_skattepligtig_indkomst_kroner,
        delårs_personlig_indkomst_kroner = delårsresultat().skat.personlig_indkomst_efter_am_kroner,
        delårs_kapitalindkomst_kroner = delårsresultat().skat.nettokapitalindkomst_kroner,
        skattepligtsdage = skattepligtsdage(),
        skattepligtige_indkomstposter = [Par14Beløbspost(
            identifikation = "kanonisk-skattepligtig-indkomst",
            delårsbeløb_kroner = delårsresultat().skat.almindelig_skattepligtig_indkomst_kroner,
            metode = Par14DokumenteretRetvisendeHelårsbeløb(helårsbeløb_kroner = helårsberegning().almindelig_skattepligtig_indkomst_kroner)
        )],
        personlige_indkomstposter = [Par14Beløbspost(
            identifikation = "kanonisk-personlig-indkomst",
            delårsbeløb_kroner = delårsresultat().skat.personlig_indkomst_efter_am_kroner,
            metode = Par14DokumenteretRetvisendeHelårsbeløb(helårsbeløb_kroner = helårsberegning().personlig_indkomst_efter_am_kroner)
        )],
        kapitalindkomstposter = [Par14Beløbspost(
            identifikation = "kanonisk-kapitalindkomst",
            delårsbeløb_kroner = delårsresultat().skat.nettokapitalindkomst_kroner,
            metode = Par14DokumenteretRetvisendeHelårsbeløb(helårsbeløb_kroner = helårsberegning().nettokapitalindkomst_kroner)
        )]
    )
    | helårspositiv_aktieindkomstskat() -> personskat_positiv_aktieindkomstskat(skatteår(), helårsskatteforhold())
    | helårsendelig_aktieindkomstskat_øre() -> personskat_endelig_aktieindkomstskat_øre(skatteår(), helårspositiv_aktieindkomstskat())
    | statslige_skattekomponenter() -> [
        personskat_par14_skattekomponent(Par14Bundskat, helårsberegning_eksakt().efter_par11.par6_skat_øre, personskat_par14_bundskattegrundlag_kroner(delårsinput()), personskat_par14_bundskattegrundlag_kroner(helårsinput())),
        personskat_par14_skattekomponent(Par14Par7PersonligSkat, personskat_par14_par7_personlig_helårsskat_øre(helårsinput()), personskat_par14_personligt_grundlag_kroner(delårsinput()), personskat_par14_personligt_grundlag_kroner(helårsinput())),
        personskat_par14_skattekomponent(Par14Par7Kapitalskat, personskat_par14_par7_kapital_helårsskat_øre(helårsinput()), personskat_par14_positivt_kapitalgrundlag_kroner(delårsinput()), personskat_par14_positivt_kapitalgrundlag_kroner(helårsinput())),
        personskat_par14_skattekomponent(Par14Par7ASkat, helårsberegning_eksakt().efter_par11.par7a_skat_øre, personskat_par14_personligt_grundlag_kroner(delårsinput()), personskat_par14_personligt_grundlag_kroner(helårsinput())),
        personskat_par14_skattekomponent(Par14Par8Skat, helårsberegning_eksakt().efter_par11.par8_skat_øre, personskat_par14_par8_grundlag_kroner(delårsinput()), personskat_par14_par8_grundlag_kroner(helårsinput())),
        personskat_par14_skattekomponent(Par14Par8AStk2Skat, helårsberegning_eksakt().efter_par11.par8a_stk2_skat_øre, personskat_par14_positiv_aktieindkomst_kroner(skatteforhold()), personskat_par14_positiv_aktieindkomst_kroner(helårsskatteforhold())),
        personskat_par14_skattekomponent(Par14CfcIndkomstskat, helårsberegning_eksakt().efter_par11.cfc_indkomstskat_øre, personskat_par14_positiv_cfc_indkomst_kroner(skatteforhold()), personskat_par14_positiv_cfc_indkomst_kroner(helårsskatteforhold())),
        personskat_par14_skattekomponent(Par14Par8CBegrænsetSkat, helårsberegning_eksakt().efter_par11.par8c_skat_øre, personskat_par14_skattepligtigt_resultatgrundlag_kroner(delårsresultat().skat), personskat_par14_skattepligtigt_resultatgrundlag_kroner(helårsberegning())),
        personskat_par14_skattekomponent(Par14EndeligAktieindkomstskat, helårsendelig_aktieindkomstskat_øre(), personskat_par14_positiv_aktieindkomst_kroner(skatteforhold()), personskat_par14_positiv_aktieindkomst_kroner(helårsskatteforhold()))
    ]
    | kommunale_og_kirkelige_skattekomponenter() -> [
        personskat_par14_skattekomponent(Par14Kommuneskat, helårsberegning_eksakt().efter_par11.kommuneskat_øre, personskat_par14_skattepligtigt_resultatgrundlag_kroner(delårsresultat().skat), personskat_par14_skattepligtigt_resultatgrundlag_kroner(helårsberegning())),
        personskat_par14_skattekomponent(Par14Kirkeskat, helårsberegning_eksakt().efter_par11.kirkeskat_øre, personskat_par14_skattepligtigt_resultatgrundlag_kroner(delårsresultat().skat), personskat_par14_skattepligtigt_resultatgrundlag_kroner(helårsberegning()))
    ]
    | skatteloftsnedslag() -> [
        personskat_par14_skattekomponent(Par14PersonligtSkatteloftsnedslag, helårsberegning_eksakt().skatteloft.personligt_nedslag_øre, personskat_par14_personligt_grundlag_kroner(delårsinput()), personskat_par14_personligt_grundlag_kroner(helårsinput())),
        personskat_par14_skattekomponent(Par14PositivKapitalSkatteloftsnedslag, helårsberegning_eksakt().skatteloft.positiv_kapital_nedslag_øre, personskat_par14_positivt_kapitalgrundlag_kroner(delårsinput()), personskat_par14_positivt_kapitalgrundlag_kroner(helårsinput()))
    ]
    | statslig_skat_før_skatteloftsnedslag_øre() -> par14_samlet_delårsskat_for_komponenter_øre(statslige_skattekomponenter())
    | samlet_skatteloftsnedslag_øre() -> par14_samlet_delårsskat_for_komponenter_øre(skatteloftsnedslag())
    | helårsskattekomponenter_afstemt() -> par14_samlet_helårsskat_for_komponenter_øre(statslige_skattekomponenter()) - par14_samlet_helårsskat_for_komponenter_øre(skatteloftsnedslag()) == helårsberegning_eksakt().statslig_indkomstskat_øre + helårsendelig_aktieindkomstskat_øre() && par14_samlet_helårsskat_for_komponenter_øre(kommunale_og_kirkelige_skattekomponenter()) == helårsberegning_eksakt().kommunal_og_kirkelig_indkomstskat_øre
    | input_gyldigt() -> periode_gyldig() && valg().input_gyldigt && kilder_gyldige() && kilder_afstemt_med_personskat() && helårsgrundlag_gyldigt() && kanonisk_beregning_understøttet() && par14_omregningsinput_gyldigt(omregning()) && par14_skattekomponenter_gyldige(statslige_skattekomponenter()) && par14_skattekomponenter_gyldige(kommunale_og_kirkelige_skattekomponenter()) && par14_skattekomponenter_gyldige(skatteloftsnedslag()) && samlet_skatteloftsnedslag_øre() <= statslig_skat_før_skatteloftsnedslag_øre() && helårsskattekomponenter_afstemt()
    | statslig_indkomstskat_efter_par14_øre() -> hvis input_gyldigt() { statslig_skat_før_skatteloftsnedslag_øre() - samlet_skatteloftsnedslag_øre() } ellers { 0 }
    | kommunal_og_kirkelig_indkomstskat_efter_par14_øre() -> hvis input_gyldigt() { par14_samlet_delårsskat_for_komponenter_øre(kommunale_og_kirkelige_skattekomponenter()) } ellers { 0 }
    | arbejdsmarkedsbidrag_for_delåret_øre() -> delårsberegning_eksakt().arbejdsmarkedsbidrag_øre
    | ejendomsskatter_øre() -> delårsresultat().ejendomsskatter.samlet_ejendomsskat_øre
    | slutskat_efter_par14_øre() -> hvis input_gyldigt() { statslig_indkomstskat_efter_par14_øre() + kommunal_og_kirkelig_indkomstskat_efter_par14_øre() + arbejdsmarkedsbidrag_for_delåret_øre() + ejendomsskatter_øre() } ellers { 0 }
    | årsopgørelse() -> personskat_årsopgørelse(input.personskat.årsopgørelse, skatteår(), slutskat_efter_par14_øre(), delårsresultat().pension, 0, 0, 0)
    | resultat() -> PersonskatPar14BeregningResultat(
        input_gyldigt = input_gyldigt(),
        periode_gyldig = periode_gyldig(),
        kilder_gyldige = kilder_gyldige(),
        kilder_afstemt_med_personskat = kilder_afstemt_med_personskat(),
        helårsgrundlag_gyldigt = helårsgrundlag_gyldigt(),
        kanonisk_beregning_understøttet = kanonisk_beregning_understøttet(),
        helårsskattekomponenter_afstemt = helårsskattekomponenter_afstemt(),
        skattepligtsdage = skattepligtsdage(),
        valg = valg(),
        delårsresultat = delårsresultat(),
        delårsinput = delårsinput(),
        helårsinput = helårsinput(),
        helårsberegning = helårsberegning(),
        helårsberegning_eksakt = helårsberegning_eksakt(),
        statslige_skattekomponenter = statslige_skattekomponenter(),
        kommunale_og_kirkelige_skattekomponenter = kommunale_og_kirkelige_skattekomponenter(),
        skatteloftsnedslag = skatteloftsnedslag(),
        statslig_indkomstskat_efter_par14_øre = statslig_indkomstskat_efter_par14_øre(),
        kommunal_og_kirkelig_indkomstskat_efter_par14_øre = kommunal_og_kirkelig_indkomstskat_efter_par14_øre(),
        arbejdsmarkedsbidrag_for_delåret_øre = arbejdsmarkedsbidrag_for_delåret_øre(),
        ejendomsskatter_øre = ejendomsskatter_øre(),
        slutskat_efter_par14_øre = slutskat_efter_par14_øre(),
        slutskat_efter_par14_kroner = slutskat_efter_par14_øre() / 100,
        årsopgørelse = årsopgørelse()
    )
}

| personskat_par14_beregningssag(input: PersonskatPar14Input) -> PersonskatPar14BeregningSag(input)

@ calculate("Dansk personskat ved delårsskattepligt")
| beregn_personskat_delår(input: PersonskatPar14Input) -> personskat_par14_beregningssag(input).resultat()
