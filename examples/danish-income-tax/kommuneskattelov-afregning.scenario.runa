@ sprog da

@ importer ./kommuneskatteloven

-- Scenarie for Kommuneskatteloven §§ 7, 15, 16 og 16 a.
--
-- Lovteksten ligger i kommuneskatteloven.runa. Dette scenarie holder beløbene
-- delelige med 3, så § 16, stk. 2's tredjedelsbetalinger kan valideres i hele
-- kroner.

= kommunal_afregning_par7_eget_skøn_fixture = kommunal_par7_afregningsvalg_resultat(KommunalEgetSkøn)
= kommunal_afregning_par7_statsgaranti_fixture = kommunal_par7_afregningsvalg_resultat(KommunalStatsgaranteretUdskrivningsgrundlag)
= kommunal_afregning_par7_statsgaranti_grundlag_fixture = kommunal_par7_statsgaranti_resultat(KommunalPar7StatsgarantiInput(
    beregningsår = 2026,
    opgjort_udskrivningsgrundlag_to_år_forud_kroner = 50000000000,
    fremskrivningsprocent_basispoint = 420,
    social_indenrigsminister_fremskrivningsgrundlag_fastlagt = Sandt,
    meddelt_senest_foerste_juli_året_før = Sandt,
    finansminister_med_finansudvalg_tilslutning = Sandt
))

= kommunal_afregning_par15_input = KommunalPar15ForeløbigAfregningInput(
    årsbudget_indkomstskat_og_kirkeskat_personer_kroner = 1200000
)
= kommunal_afregning_par15_resultat_fixture = kommunal_par15_foreløbig_afregning_resultat(kommunal_afregning_par15_input)

= kommunal_afregning_par16_eget_skøn_input = KommunalPar16EfterreguleringInput(
    budgetvalg = KommunalEgetSkøn,
    kalenderår = 2026,
    slutskat_kommunal_indkomstskat_og_kirkeskat_kroner = 1206000,
    tilgang_ændrede_skatteansættelser_kroner = 6000,
    afgang_ændrede_skatteansættelser_kroner = 3000,
    udbetalt_efter_par15_kroner = kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner,
    korrektionsbeløb_efter_par16a_kroner = 0
)
= kommunal_afregning_par16_resultat_fixture = kommunal_par16_efterregulering_resultat(kommunal_afregning_par16_eget_skøn_input)

= kommunal_afregning_par16_statsgaranti_input = KommunalPar16EfterreguleringInput(
    budgetvalg = KommunalStatsgaranteretUdskrivningsgrundlag,
    kalenderår = 2026,
    slutskat_kommunal_indkomstskat_og_kirkeskat_kroner = 1206000,
    tilgang_ændrede_skatteansættelser_kroner = 6000,
    afgang_ændrede_skatteansættelser_kroner = 3000,
    udbetalt_efter_par15_kroner = kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner,
    korrektionsbeløb_efter_par16a_kroner = 0
)
= kommunal_afregning_statsgaranti_resultat_fixture = kommunal_par16_efterregulering_resultat(kommunal_afregning_par16_statsgaranti_input)

= kommunal_afregning_par16_stor_positiv_input = KommunalPar16EfterreguleringInput(
    budgetvalg = KommunalEgetSkøn,
    kalenderår = 2026,
    slutskat_kommunal_indkomstskat_og_kirkeskat_kroner = 1280000,
    tilgang_ændrede_skatteansættelser_kroner = 0,
    afgang_ændrede_skatteansættelser_kroner = 0,
    udbetalt_efter_par15_kroner = kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner,
    korrektionsbeløb_efter_par16a_kroner = 0
)
= kommunal_afregning_par16_stor_positiv_resultat = kommunal_par16_efterregulering_resultat(kommunal_afregning_par16_stor_positiv_input)
= kommunal_afregning_par16_stk3_positiv_fixture = kommunal_par16_stk3_tillæg_resultat(KommunalPar16Stk3TillægInput(
    efterreguleringsbeløb_kroner = kommunal_afregning_par16_stor_positiv_resultat.efterreguleringsbeløb_kroner,
    udligning_efterreguleringsbeløb_kroner = 0,
    udbetalt_efter_par15_kroner = kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner,
    nationalbank_diskonto_basispoint = 350
))

= kommunal_afregning_par16_stor_negativ_input = KommunalPar16EfterreguleringInput(
    budgetvalg = KommunalEgetSkøn,
    kalenderår = 2026,
    slutskat_kommunal_indkomstskat_og_kirkeskat_kroner = 1120000,
    tilgang_ændrede_skatteansættelser_kroner = 0,
    afgang_ændrede_skatteansættelser_kroner = 0,
    udbetalt_efter_par15_kroner = kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner,
    korrektionsbeløb_efter_par16a_kroner = 0
)
= kommunal_afregning_par16_stor_negativ_resultat = kommunal_par16_efterregulering_resultat(kommunal_afregning_par16_stor_negativ_input)
= kommunal_afregning_par16_stk3_negativ_fixture = kommunal_par16_stk3_tillæg_resultat(KommunalPar16Stk3TillægInput(
    efterreguleringsbeløb_kroner = kommunal_afregning_par16_stor_negativ_resultat.efterreguleringsbeløb_kroner,
    udligning_efterreguleringsbeløb_kroner = 0,
    udbetalt_efter_par15_kroner = kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner,
    nationalbank_diskonto_basispoint = 350
))

= kommunal_afregning_par16_stk4_input = KommunalPar16Stk4VirksomhedsskatInput(
    kommunal_og_kirke_udskrivningsprocent_basispoint = 2430,
    virksomhedsskatteprocent_basispoint = 2200,
    vsl10_stk2_overskud_hvoraf_virksomhedsskat_betales_kroner = 200000,
    vsl10_stk3_og_par13_fradragsgrundlag_i_slutskat_kroner = 50000,
    vsl22b_konjunkturudligningsskat_indbetalingsgrundlag_kroner = 12000,
    vsl22d_indkomstudligning_indbetalingsgrundlag_kroner = 18000,
    vsl22b_konjunkturudligningsskat_fradragsgrundlag_i_slutskat_kroner = 9000,
    vsl22d_indkomstudligning_fradragsgrundlag_i_slutskat_kroner = 11000,
    afskrivningslov40c_acontoskat_fradragsgrundlag_kroner = 10000
)
= kommunal_afregning_par16_stk4_fixture = kommunal_par16_stk4_virksomhedsskat_resultat(kommunal_afregning_par16_stk4_input)

= kommunal_afregning_par16a_kommune_fixture = KommunalPar16aStk1Input(
    kommunal_indkomstskat_efter_par16_stk1_kroner = 121000000,
    tilskuds_og_udligningsbeløb_til_efterregulering_kroner = 29000000,
    indtægt_ved_statsgaranteret_udskrivningsgrundlag_kroner = 100000000,
    statsgaranterede_tilskuds_og_udligningsbeløb_kroner = 20000000
)
= kommunal_afregning_par16a_national_2026_fixture = KommunalPar16aNationalInput(
    kalenderår = 2026,
    samlede_stk1_beløb_kroner = 1650000000,
    samlede_positive_stk1_beløb_kroner = 3000000000,
    forrige_års_korrektionsramme_kroner = 0,
    udvikling_i_statsgaranteret_udskrivningsgrundlag_basispoint = 0
)
= kommunal_afregning_par16a_2026_resultat_fixture = kommunal_par16a_resultat(KommunalPar16aInput(
    budgetvalg = KommunalEgetSkøn,
    kommune = kommunal_afregning_par16a_kommune_fixture,
    nationalt = kommunal_afregning_par16a_national_2026_fixture
))
= kommunal_afregning_par16a_integreret_input = KommunalPar16EfterreguleringInput(
    budgetvalg = KommunalEgetSkøn,
    kalenderår = 2026,
    slutskat_kommunal_indkomstskat_og_kirkeskat_kroner = 121000000,
    tilgang_ændrede_skatteansættelser_kroner = 0,
    afgang_ændrede_skatteansættelser_kroner = 0,
    udbetalt_efter_par15_kroner = 100000000,
    korrektionsbeløb_efter_par16a_kroner = kommunal_afregning_par16a_2026_resultat_fixture.kommunens_korrektionsbeløb_kroner
)
= kommunal_afregning_par16a_integreret_resultat_fixture = kommunal_par16_efterregulering_resultat(kommunal_afregning_par16a_integreret_input)

= kommunal_afregning_par16a_national_2027_fixture = KommunalPar16aNationalInput(
    kalenderår = 2027,
    samlede_stk1_beløb_kroner = 1650000000,
    samlede_positive_stk1_beløb_kroner = 3000000000,
    forrige_års_korrektionsramme_kroner = 1500000000,
    udvikling_i_statsgaranteret_udskrivningsgrundlag_basispoint = 800
)
= kommunal_afregning_par16a_2027_resultat_fixture = kommunal_par16a_resultat(KommunalPar16aInput(
    budgetvalg = KommunalEgetSkøn,
    kommune = kommunal_afregning_par16a_kommune_fixture,
    nationalt = kommunal_afregning_par16a_national_2027_fixture
))
= kommunal_afregning_par16a_statsgaranti_resultat_fixture = kommunal_par16a_resultat(KommunalPar16aInput(
    budgetvalg = KommunalStatsgaranteretUdskrivningsgrundlag,
    kommune = kommunal_afregning_par16a_kommune_fixture,
    nationalt = kommunal_afregning_par16a_national_2026_fixture
))
= kommunal_afregning_par16a_negativ_kommune_resultat_fixture = kommunal_par16a_resultat(KommunalPar16aInput(
    budgetvalg = KommunalEgetSkøn,
    kommune = KommunalPar16aStk1Input(
        kommunal_indkomstskat_efter_par16_stk1_kroner = 90000000,
        tilskuds_og_udligningsbeløb_til_efterregulering_kroner = 20000000,
        indtægt_ved_statsgaranteret_udskrivningsgrundlag_kroner = 100000000,
        statsgaranterede_tilskuds_og_udligningsbeløb_kroner = 20000000
    ),
    nationalt = kommunal_afregning_par16a_national_2026_fixture
))

| kommunal_afregning_par7_eget_skøn_omfang: kommunal_afregning_par7_eget_skøn_fixture -> kommunal_afregning_par7_eget_skøn_fixture.omfang == AfregningEfterPar15OgPar16Stk1Til4 && kommunal_afregning_par7_eget_skøn_fixture.efterregulering_stk1_til_4_gælder == Sandt
| kommunal_afregning_par7_statsgaranti_omfang: kommunal_afregning_par7_statsgaranti_fixture -> kommunal_afregning_par7_statsgaranti_fixture.omfang == AfregningEfterPar15OgPar16Stk4 && kommunal_afregning_par7_statsgaranti_fixture.efterregulering_stk1_til_4_gælder == Falskt
| kommunal_afregning_par7_statsgaranti_grundlag: kommunal_afregning_par7_statsgaranti_grundlag_fixture -> kommunal_afregning_par7_statsgaranti_grundlag_fixture.grundlagsår == 2024 && kommunal_afregning_par7_statsgaranti_grundlag_fixture.fremskrevet_tillæg_kroner == 2100000000 && kommunal_afregning_par7_statsgaranti_grundlag_fixture.statsgaranteret_udskrivningsgrundlag_kroner == 52100000000 && kommunal_afregning_par7_statsgaranti_grundlag_fixture.fremskrivningsgrundlag_fastlagt == Sandt && kommunal_afregning_par7_statsgaranti_grundlag_fixture.procent_fastsat_med_finansudvalg_tilslutning == Sandt
| kommunal_afregning_par15_tolvtedel: kommunal_afregning_par15_resultat_fixture -> kommunal_afregning_par15_resultat_fixture.månedlig_udbetaling_kroner == 100000 && kommunal_afregning_par15_resultat_fixture.samlet_årlig_udbetaling_kroner == 1200000
| kommunal_afregning_par16_eget_skøn_tredjedele: kommunal_afregning_par16_resultat_fixture -> kommunal_afregning_par16_resultat_fixture.omfattes_af_efterregulering == Sandt && kommunal_afregning_par16_resultat_fixture.endelig_skat_inkl_ændringer_kroner == 1209000 && kommunal_afregning_par16_resultat_fixture.efterreguleringsbeløb_kroner == 9000 && kommunal_afregning_par16_resultat_fixture.afregningsår == 2029 && kommunal_afregning_par16_resultat_fixture.januar_kroner == 3000 && kommunal_afregning_par16_resultat_fixture.februar_kroner == 3000 && kommunal_afregning_par16_resultat_fixture.marts_kroner == 3000
| kommunal_afregning_par16_statsgaranti_uden_stk2: kommunal_afregning_statsgaranti_resultat_fixture -> kommunal_afregning_statsgaranti_resultat_fixture.omfattes_af_efterregulering == Falskt && kommunal_afregning_statsgaranti_resultat_fixture.efterreguleringsbeløb_kroner == 0 && kommunal_afregning_statsgaranti_resultat_fixture.januar_kroner == 0
| kommunal_afregning_par16_stk3_positivt_tillæg: kommunal_afregning_par16_stk3_positiv_fixture -> kommunal_afregning_par16_stk3_positiv_fixture.samlet_efterreguleringsbeløb_kroner == 80000 && kommunal_afregning_par16_stk3_positiv_fixture.tærskel_3pct_kroner == 36000 && kommunal_afregning_par16_stk3_positiv_fixture.overskydende_del_kroner == 44000 && kommunal_afregning_par16_stk3_positiv_fixture.tillægssats_basispoint == 1050 && kommunal_afregning_par16_stk3_positiv_fixture.tillæg_abs_kroner == 4620 && kommunal_afregning_par16_stk3_positiv_fixture.samlet_med_tillæg_kroner == 84620
| kommunal_afregning_par16_stk3_negativt_tillæg: kommunal_afregning_par16_stk3_negativ_fixture -> kommunal_afregning_par16_stk3_negativ_fixture.samlet_efterreguleringsbeløb_kroner == -80000 && kommunal_afregning_par16_stk3_negativ_fixture.samlet_efterreguleringsbeløb_abs_kroner == 80000 && kommunal_afregning_par16_stk3_negativ_fixture.tillæg_abs_kroner == 4620 && kommunal_afregning_par16_stk3_negativ_fixture.tillæg_med_fortegn_kroner == -4620 && kommunal_afregning_par16_stk3_negativ_fixture.samlet_med_tillæg_kroner == -84620
| kommunal_afregning_par16_stk4_virksomhedsskat: kommunal_afregning_par16_stk4_fixture -> kommunal_afregning_par16_stk4_fixture.virksomhedsskatteprocent_lavere_end_kommunal_og_kirke == Sandt && kommunal_afregning_par16_stk4_fixture.grundlag_staten_afregner_til_kommune_kroner == 230000 && kommunal_afregning_par16_stk4_fixture.grundlag_kommune_betaler_staten_kroner == 80000 && kommunal_afregning_par16_stk4_fixture.staten_afregner_til_kommune_kroner == 55890 && kommunal_afregning_par16_stk4_fixture.kommune_betaler_staten_kroner == 19440 && kommunal_afregning_par16_stk4_fixture.netto_afregning_til_kommune_kroner == 36450
| kommunal_afregning_par16a_2026_fordeling: kommunal_afregning_par16a_2026_resultat_fixture -> kommunal_afregning_par16a_2026_resultat_fixture.omfattet == Sandt && kommunal_afregning_par16a_2026_resultat_fixture.stk1_beløb_kroner == 30000000 && kommunal_afregning_par16a_2026_resultat_fixture.korrektionsramme_kroner == 1500000000 && kommunal_afregning_par16a_2026_resultat_fixture.samlet_korrektionsbeløb_kroner == 150000000 && kommunal_afregning_par16a_2026_resultat_fixture.kommunens_positive_stk1_beløb_kroner == 30000000 && kommunal_afregning_par16a_2026_resultat_fixture.kommunens_korrektionsbeløb_kroner == 1500000
| kommunal_afregning_par16a_fratrækkes_efterregulering: kommunal_afregning_par16a_integreret_resultat_fixture -> kommunal_afregning_par16a_integreret_resultat_fixture.efterreguleringsbeløb_før_par16a_kroner == 21000000 && kommunal_afregning_par16a_integreret_resultat_fixture.korrektionsbeløb_efter_par16a_kroner == 1500000 && kommunal_afregning_par16a_integreret_resultat_fixture.efterreguleringsbeløb_kroner == 19500000 && kommunal_afregning_par16a_integreret_resultat_fixture.januar_kroner == 6500000 && kommunal_afregning_par16a_integreret_resultat_fixture.februar_kroner == 6500000 && kommunal_afregning_par16a_integreret_resultat_fixture.marts_kroner == 6500000
| kommunal_afregning_par16a_2027_rammeloft: kommunal_afregning_par16a_2027_resultat_fixture -> kommunal_afregning_par16a_2027_resultat_fixture.ramme_regulering_basispoint == 500 && kommunal_afregning_par16a_2027_resultat_fixture.korrektionsramme_kroner == 1575000000 && kommunal_afregning_par16a_2027_resultat_fixture.samlet_korrektionsbeløb_kroner == 75000000 && kommunal_afregning_par16a_2027_resultat_fixture.kommunens_korrektionsbeløb_kroner == 750000
| kommunal_afregning_par16a_statsgaranti_uden_korrektion: kommunal_afregning_par16a_statsgaranti_resultat_fixture -> kommunal_afregning_par16a_statsgaranti_resultat_fixture.omfattet == Falskt && kommunal_afregning_par16a_statsgaranti_resultat_fixture.stk1_beløb_kroner == 0 && kommunal_afregning_par16a_statsgaranti_resultat_fixture.samlet_korrektionsbeløb_kroner == 150000000 && kommunal_afregning_par16a_statsgaranti_resultat_fixture.kommunens_korrektionsbeløb_kroner == 0
| kommunal_afregning_par16a_negativ_kommune_uden_korrektion: kommunal_afregning_par16a_negativ_kommune_resultat_fixture -> kommunal_afregning_par16a_negativ_kommune_resultat_fixture.omfattet == Sandt && kommunal_afregning_par16a_negativ_kommune_resultat_fixture.stk1_beløb_kroner == -10000000 && kommunal_afregning_par16a_negativ_kommune_resultat_fixture.kommunens_positive_stk1_beløb_kroner == 0 && kommunal_afregning_par16a_negativ_kommune_resultat_fixture.kommunens_korrektionsbeløb_kroner == 0

? kommunal_afregning_par7_eget_skøn_omfang
? kommunal_afregning_par7_statsgaranti_omfang
? kommunal_afregning_par7_statsgaranti_grundlag
? kommunal_afregning_par15_tolvtedel
? kommunal_afregning_par16_eget_skøn_tredjedele
? kommunal_afregning_par16_statsgaranti_uden_stk2
? kommunal_afregning_par16_stk3_positivt_tillæg
? kommunal_afregning_par16_stk3_negativt_tillæg
? kommunal_afregning_par16_stk4_virksomhedsskat
? kommunal_afregning_par16a_2026_fordeling
? kommunal_afregning_par16a_fratrækkes_efterregulering
? kommunal_afregning_par16a_2027_rammeloft
? kommunal_afregning_par16a_statsgaranti_uden_korrektion
? kommunal_afregning_par16a_negativ_kommune_uden_korrektion
