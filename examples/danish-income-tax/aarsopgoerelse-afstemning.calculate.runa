@ sprog da

@ importer ./skatteaar - parametre
@ importer ./personskatteloven - par11 - parametre
@ importer ./pengebeloeb

-- Rapportkontrol, ikke en alternativ beregning af personskat.
-- Observationer fra en årsopgørelse og afledte nødvendige betingelser holdes
-- adskilt. Ingen af de afledte beløb indsættes som kildefakta i PersonskatInput.
-- PSL §§ 10, 11 og 13: https://www.retsinformation.dk/eli/lta/2021/1284
-- KSL §§ 60–62 A: https://www.retsinformation.dk/eli/lta/2024/460
-- Satser og beløbsgrænser genbruges fra de importerede lovmodeller.

# RapportBeløb(navn: Tekst, beløb_øre: Heltal)
# RapportIndkomstBro(personlig_indkomst_kroner: Heltal, kapitalindkomst_kroner: Heltal, ligningsmæssige_fradrag_kroner: Heltal, skattepligtig_indkomst_kroner: Heltal, øvrige_indkomstreguleringer_kroner: Heltal, oplyst_ægtefælleunderskud_kroner: Heltal?)
# RapportÆgtefællenedslag(statsligt_personfradrag_øre: Heltal?, kommunalt_personfradrag_øre: Heltal?, kirkeligt_personfradrag_øre: Heltal?, kommunalt_og_kirkeligt_personfradrag_øre: Heltal?, negativ_kapitalindkomst_øre: Heltal?, eget_negativ_kapitalindkomstnedslag_øre: Heltal?)
# RapportSkat(poster_uden_ægtefællenedslag: List(RapportBeløb), poster_uden_ægtefællenedslag_komplette: Boolsk, oplyst_beregnet_skat_øre: Heltal?)
# RapportRestskat(oplyst_restskat_øre: Heltal?)
# RapportBetaling(oplyst_forskudsskat_øre: Heltal?, oplyst_beregnet_skat_øre: Heltal?, tillæg_til_slutskat: List(RapportBeløb), tillæg_til_slutskat_komplette: Boolsk, oplyst_overskydende_skat_øre: Heltal?, korrektioner_til_udbetaling: List(RapportBeløb), korrektioner_komplette: Boolsk, oplyst_udbetaling_kroner: Heltal?, restskat: RapportRestskat?)
# ÅrsopgørelseAfstemningsinput(skatteår: Heltal, kommune: Kommune, betaler_kirkeskat: Boolsk, ægtefællens_kommune: Kommune?, gift_samlevende_ved_årets_udløb: Boolsk?, indkomstbro: RapportIndkomstBro?, ægtefællenedslag: RapportÆgtefællenedslag, skat: RapportSkat, betaling: RapportBetaling)

# AfstemningsKontrolStatus = Stemmer | Afviger | IkkeOplyst
# AfstemningsKontrol(navn: Tekst, enhed: Tekst, forventet: Heltal?, oplyst: Heltal?, difference: Heltal?, status: AfstemningsKontrolStatus)
# AfstemningsForudsætning(navn: Tekst, enhed: Tekst, nødvendigt_beløb: Heltal, mindst: Heltal, højst: Heltal?, inden_for_kontrollerede_grænser: Boolsk, forklaring: Tekst)
# AfstemningsStatus = BetingetAfstemt | Modstrid | Ufuldstændig | UgyldigtRapportinput | IkkeUnderstøttetÅrEllerKommune
# ÅrsopgørelseAfstemningsresultat(status: AfstemningsStatus, uafhængig_skatteberegning_udført: Boolsk, kontroller: List(AfstemningsKontrol), nødvendige_forudsætninger: List(AfstemningsForudsætning), uafklaret: List(Tekst))

# RapportAfstemningskilde(url: Tekst, identifier: Tekst)
= rapport_afstemningsmetadata = Beregningsmeta(
    felter = [
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::skatteår), label = "Årsopgørelsens indkomstår", question = Some("Hvilket indkomstår gælder rapporten?"), help = Some("2023–2026. Brug indkomståret, ikke udskriftsåret."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::kommune), label = "Rapportens skattekommune", question = Some("Hvilken skattekommune står i rapporten?"), help = Some("Oplys rapportens kommune for indkomståret, ikke automatisk din nuværende bopælskommune. Afstemningen efterprøver ikke selv bopælsfakta eller valget efter kommuneskattelovens § 2."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaler_kirkeskat), label = "Kirkeskat i rapporten", question = Some("Er personen omfattet af kirkeskat?"), help = Some("Et kirkeligt personfradrag kan ikke bruges uden kirkeskat."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællens_kommune), label = "Ægtefællens skattekommune, hvis kendt", question = Some("Kendes ægtefællens skattekommune for året?"), help = Some("Valgfri rapportoplysning; null hvis ukendt. Overførselslofter beregnes med modtagers kommune og kirkeskat, ikke afsenders. Feltet bevares for eksisterende input."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::gift_samlevende_ved_årets_udløb), label = "Gift og skattemæssigt samlevende ved årets udløb", question = Some("Er denne overførselsbetingelse kendt?"), help = Some("null hvis ukendt; false kun hvis betingelsen vides ikke at være opfyldt. Rapportens civilstand alene dokumenterer ikke samliv."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::indkomstbro), label = "Rapportens indkomstbro", question = Some("Kendes de samlede indkomsttal og øvrige reguleringer?"), help = Some("JSON med personlig indkomst, kapitalindkomst, ligningsmæssige fradrag, skattepligtig indkomst og øvrige indkomstreguleringer, alle i hele DKK. null hvis broen er ukomplet. Oplyst ægtefælleunderskud kan være null; det nødvendige beløb beregnes stadig."), unit = Some("DKK")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællenedslag::statsligt_personfradrag_øre), label = "Overført personfradragsværdi, stat", question = None, help = Some("Positivt nedslag fra rapporten i øre. null er ukendt; 0 er kendt intet nedslag."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællenedslag::kommunalt_personfradrag_øre), label = "Overført personfradragsværdi, kun kommune", question = None, help = Some("Positivt særskilt kommunalt nedslag, ikke personfradragets indkomstgrundlag. null hvis det samlede kommune-/kirkefelt bruges."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællenedslag::kirkeligt_personfradrag_øre), label = "Overført personfradragsværdi, kun kirke", question = None, help = Some("Positivt særskilt kirkeligt nedslag. Brug kun 0 når fraværet er kendt; null hvis det samlede kommune-/kirkefelt bruges."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællenedslag::kommunalt_og_kirkeligt_personfradrag_øre), label = "Overført personfradragsværdi, kommune og kirke samlet", question = Some("Viser rapporten kommune og kirke som ét overført nedslag?"), help = Some("Positivt samlet beløb i øre. En linje benævnt kommuneskat kan bruge kommune- og kirkesatsen tilsammen. Brug dette felt til den samlede observation og lad begge særskilte felter være null, også når summen er 0. Opfind ikke en fordeling. null vælger de særskilte felter."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællenedslag::negativ_kapitalindkomst_øre), label = "Overført nedslag for negativ kapitalindkomst", question = None, help = Some("Positiv overført skatteværdi efter PSL § 11, ikke renteudgiften."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::ægtefællenedslag::eget_negativ_kapitalindkomstnedslag_øre), label = "Eget nedslag for negativ kapitalindkomst", question = None, help = Some("Eget positive nedslag fra rapporten. Reducerer den mulige plads til ægtefællens overførte nedslag."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::skat::poster_uden_ægtefællenedslag), label = "Skatteposter uden ægtefællenedslagene", question = Some("Hvilke øvrige poster indgår i beregnet skat?"), help = Some("Skatter positive, egne fradragsværdier og lempelser negative. Ingen subtotaler, forskudsskat eller tilbagebetaling her. Udelad de særskilt registrerede ægtefællenedslag; kommune og kirke kan stå samlet."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::skat::poster_uden_ægtefællenedslag_komplette), label = "Alle øvrige skatteposter er med", question = Some("Er alle poster, bortset fra de særskilt registrerede ægtefællenedslag, transskriberet?"), help = Some("false hvis ukendt. true kun efter gennemgang, også når afsnittet faktisk ikke har nogen poster. En bekræftet tom liste summerer til nul; tilføj ikke en opdigtet nulpost. En manglende post må ikke fortolkes som ægtefælleoverførsel."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::skat::oplyst_beregnet_skat_øre), label = "Beregnet skat ifølge skatteberegningen", question = None, help = Some("Rapportobservation til afstemning; aldrig kildefaktum til en uafhængig skatteberegning."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::oplyst_forskudsskat_øre), label = "Samlet forskudsskat ifølge rapporten", question = None, help = None, unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::oplyst_beregnet_skat_øre), label = "Beregnet skat ifølge betalingsopgørelsen", question = None, help = Some("Kontrolleres også mod samme beløb i skatteberegningen."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::tillæg_til_slutskat), label = "Tillæg før overskydende skat eller restskat", question = Some("Viser rapporten særskilt overført restskat mv. eller afgift efter pensionsbeskatningslovens § 25 A, stk. 5–9?"), help = Some("Positive ørebeløb med entydige navne. Kun tillæg efter KSL §§ 61–62, stk. 1, der ikke allerede indgår i beregnet skat. Gælder både tilbagebetaling og restskat. Ikke renter eller procenttillæg på årets restskat, tidligere udbetalinger eller modregning efter beregning af overskydende skat. Opfind ikke en post ud fra en difference."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::tillæg_til_slutskat_komplette), label = "Alle tillæg til slutskat er med", question = Some("Er tillæggene gennemgået, også hvis der ingen er?"), help = Some("false hvis ukendt; en tom liste og true betyder kendt ingen tillæg. Ved false beregnes hverken overskydende skat, restskat eller udbetaling."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::oplyst_overskydende_skat_øre), label = "Overskydende skat før korrektioner", question = None, help = Some("Før godtgørelse og fradrag for tidligere tilbagebetaling."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::korrektioner_til_udbetaling), label = "Korrektioner fra overskydende skat til udbetaling", question = Some("Hvilke renter, godtgørelser og tidligere udbetalinger står i rapporten?"), help = Some("Tillæg positive, tidligere udbetalinger og modregninger negative. Oplyste beløb afstemmes, men deres retmæssighed genberegnes ikke."), unit = Some("øre")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::korrektioner_komplette), label = "Alle betalingskorrektioner er med", question = None, help = Some("false hvis ukendt; en tom liste og true betyder kendt ingen korrektioner."), unit = None),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::oplyst_udbetaling_kroner), label = "Rapportens beløb til udbetaling", question = None, help = Some("Hele DKK, ikke øre. På en ændret årsopgørelse er tidligere udbetaling allerede modregnet."), unit = Some("DKK")),
        Beregningsfelt(path = pathof(ÅrsopgørelseAfstemningsinput::betaling::restskat), label = "Afstem restskat i stedet for tilbagebetaling", question = Some("Viser rapporten restskat før renter og procenttillæg?"), help = Some("null vælger tilbagebetalingskontrollen. Ellers JSON med oplyst_restskat_øre (ikke-negativt beløb eller null). Tillæg og deres fuldstændighed angives direkte under betaling i begge spor. Udbetalingsbeløb skal være null og korrektioner_til_udbetaling tom. Dette kontrollerer ikke opkrævningen eller raterne."), unit = Some("øre"))
    ],
    spørgsmål = [],
    beløbsfelter = [],
    attachments = (
        Source(value = RapportAfstemningskilde(url = "https://www.retsinformation.dk/eli/lta/2021/1284", identifier = "PSL §§ 9–13; betingede overførsler, ikke rekonstruktion af kildefakta")),
        Source(value = RapportAfstemningskilde(url = "https://www.retsinformation.dk/eli/mt/1994/129", identifier = "CIR nr. 129 af 04/07/1994, 11.1.1–11.1.2: modtagers egne skatteprocenter; kontrolleret mod anonym 2025-beregner 2026-09-25")),
        Source(value = RapportAfstemningskilde(url = "https://www.retsinformation.dk/eli/lta/2024/460", identifier = "KSL §§ 60–62 A; restskat før renter/procenttillæg og afstemning af rapportens oplyste beløb")),
        Warning(value = "Betinget afstemning er ikke uafhængig skatteberegning eller bevis for lovlig samlet husstand.")
    )
)

--@label:afstem_årsopgørelse::meta:rapport_afstemningsmetadata--

| rapport_beløb_afgrænset(beløb: Heltal) -> beløb >= -1000000000000 && beløb <= 1000000000000
| rapport_option_afgrænset(beløb: Heltal?) -> match beløb { | None -> Sandt | Some(værdi) -> rapport_beløb_afgrænset(værdi) }
| rapport_poster_gyldige(poster: List(RapportBeløb)) -> length(poster) <= 1000 && all(poster, |post: RapportBeløb| trim(post.navn) != "" && rapport_beløb_afgrænset(post.beløb_øre) && length(filter(poster, |anden: RapportBeløb| trim(anden.navn) == trim(post.navn))) == 1)
| rapport_sum(poster: List(RapportBeløb)) -> foldl(poster, 0, |sum: Heltal, post: RapportBeløb| sum + post.beløb_øre)
| rapport_restskatinput_gyldigt(b: RapportBetaling) -> match b.restskat {
    | None -> Sandt
    | Some(r) -> rapport_option_afgrænset(r.oplyst_restskat_øre) && (match r.oplyst_restskat_øre { | None -> Sandt | Some(beløb) -> beløb >= 0 }) && b.oplyst_overskydende_skat_øre == None && b.oplyst_udbetaling_kroner == None && length(b.korrektioner_til_udbetaling) == 0
}
| rapport_indkomstbro_gyldig(bro: RapportIndkomstBro?) -> match bro {
    | None -> Sandt
    | Some(b) -> rapport_beløb_afgrænset(b.personlig_indkomst_kroner) && rapport_beløb_afgrænset(b.kapitalindkomst_kroner) && rapport_beløb_afgrænset(b.ligningsmæssige_fradrag_kroner) && b.ligningsmæssige_fradrag_kroner >= 0 && rapport_beløb_afgrænset(b.skattepligtig_indkomst_kroner) && rapport_beløb_afgrænset(b.øvrige_indkomstreguleringer_kroner) && rapport_option_afgrænset(b.oplyst_ægtefælleunderskud_kroner)
}
| rapport_lokalt_nedslag_entydigt(n: RapportÆgtefællenedslag) -> match n.kommunalt_og_kirkeligt_personfradrag_øre {
    | None -> Sandt
    | Some(_) -> match n.kommunalt_personfradrag_øre {
        | Some(_) -> Falskt
        | None -> match n.kirkeligt_personfradrag_øre { | None -> Sandt | Some(_) -> Falskt }
    }
}
| rapport_input_gyldigt(input: ÅrsopgørelseAfstemningsinput) -> rapport_lokalt_nedslag_entydigt(input.ægtefællenedslag) && rapport_restskatinput_gyldigt(input.betaling) && rapport_indkomstbro_gyldig(input.indkomstbro) && rapport_poster_gyldige(input.skat.poster_uden_ægtefællenedslag) && rapport_poster_gyldige(input.betaling.tillæg_til_slutskat) && all(input.betaling.tillæg_til_slutskat, |post: RapportBeløb| post.beløb_øre >= 0) && rapport_poster_gyldige(input.betaling.korrektioner_til_udbetaling) && all([
    input.ægtefællenedslag.statsligt_personfradrag_øre,
    input.ægtefællenedslag.kommunalt_personfradrag_øre,
    input.ægtefællenedslag.kirkeligt_personfradrag_øre,
    input.ægtefællenedslag.kommunalt_og_kirkeligt_personfradrag_øre,
    input.ægtefællenedslag.negativ_kapitalindkomst_øre,
    input.ægtefællenedslag.eget_negativ_kapitalindkomstnedslag_øre,
    input.skat.oplyst_beregnet_skat_øre,
    input.betaling.oplyst_forskudsskat_øre,
    input.betaling.oplyst_beregnet_skat_øre,
    input.betaling.oplyst_overskydende_skat_øre,
    input.betaling.oplyst_udbetaling_kroner
    ], |beløb: Heltal?| rapport_option_afgrænset(beløb))

| rapport_option_difference(a: Heltal?, b: Heltal?) -> match a {
    | None -> None
    | Some(x) -> match b { | None -> None | Some(y) -> Some(x - y) }
}
| rapport_option_plus(a: Heltal?, b: Heltal?) -> match a {
    | None -> None
    | Some(x) -> match b { | None -> None | Some(y) -> Some(x + y) }
}
| rapport_kontrol(navn: Tekst, enhed: Tekst, forventet: Heltal?, oplyst: Heltal?) -> {
    = difference = rapport_option_difference(oplyst, forventet)
    AfstemningsKontrol(navn = navn, enhed = enhed, forventet = forventet, oplyst = oplyst, difference = difference, status = match difference { | None -> IkkeOplyst | Some(d) -> hvis d == 0 { Stemmer } ellers { Afviger } })
}
| rapport_nødvendigt_underskud(b: RapportIndkomstBro) -> b.personlig_indkomst_kroner + b.kapitalindkomst_kroner - b.ligningsmæssige_fradrag_kroner + b.øvrige_indkomstreguleringer_kroner - b.skattepligtig_indkomst_kroner
| rapport_indkomstkontroller(bro: RapportIndkomstBro?) -> match bro {
    | None -> [rapport_kontrol("Indkomstbro og ægtefælleunderskud", "DKK", None, None)]
    | Some(b) -> [rapport_kontrol("Indkomstbro og ægtefælleunderskud", "DKK", Some(rapport_nødvendigt_underskud(b)), b.oplyst_ægtefælleunderskud_kroner)]
}
| rapport_ægtefælle_mulig(status: Boolsk?) -> match status { | Some(værdi) -> værdi | None -> Sandt }
| rapport_forudsætning(navn: Tekst, enhed: Tekst, beløb: Heltal, maksimum: Heltal?, ægtefælle_mulig: Boolsk, forklaring: Tekst) -> AfstemningsForudsætning(
    navn = navn,
    enhed = enhed,
    nødvendigt_beløb = beløb,
    mindst = 0,
    højst = maksimum,
    inden_for_kontrollerede_grænser = beløb >= 0 && (ægtefælle_mulig || beløb == 0) && match maksimum { | None -> Sandt | Some(maks) -> beløb <= maks },
    forklaring = forklaring
)
| rapport_underskudsforudsætning(bro: RapportIndkomstBro?, ægtefælle_mulig: Boolsk) -> match bro {
    | None -> []
    | Some(b) -> [rapport_forudsætning("Nødvendigt indkomstfradrag fra ægtefælle", "DKK", rapport_nødvendigt_underskud(b), Some(penge_positivt_beløb(b.personlig_indkomst_kroner + b.kapitalindkomst_kroner - b.ligningsmæssige_fradrag_kroner + b.øvrige_indkomstreguleringer_kroner)), ægtefælle_mulig, "Afledt af indkomstbroen efter oplyste øvrige reguleringer. Kræver et overførbart restunderskud efter PSL § 13 og prioriterede egne modregninger. Kan ikke overstige modtagers positive indkomst før overførslen. Det er ikke ægtefællens dokumenterede indkomst eller oprindelige underskud.")]
}
| rapport_nedslagsforudsætning(navn: Tekst, beløb: Heltal?, maksimum: Heltal?, ægtefælle_mulig: Boolsk) -> match beløb {
    | None -> []
    | Some(værdi) -> [rapport_forudsætning(navn, "øre", værdi, maksimum, ægtefælle_mulig, "Denne ubrugte skatteværdi skal kunne overføres. Et kontrolleret loft er kun en nødvendig betingelse; null betyder ukendt loft, ikke ubegrænset ret. Ægtefællens egen anvendelse og overførselsbetingelser er ikke dokumenteret.")]
}
| rapport_lokalt_nedslag(n: RapportÆgtefællenedslag) -> match n.kommunalt_og_kirkeligt_personfradrag_øre {
    | None -> rapport_option_plus(n.kommunalt_personfradrag_øre, n.kirkeligt_personfradrag_øre)
    | Some(beløb) -> Some(beløb)
}
| rapport_samlet_ægtefællenedslag(n: RapportÆgtefællenedslag) -> rapport_option_plus(rapport_option_plus(n.statsligt_personfradrag_øre, rapport_lokalt_nedslag(n)), n.negativ_kapitalindkomst_øre)
-- Bekræftet tomhed har summen nul; kun fuldstændighedsmarkeringen afgør,
-- om posterne kan bruges. Ukendte beløb forbliver valgfrie.
| rapport_nødvendigt_skattenedslag(skat: RapportSkat) -> hvis skat.poster_uden_ægtefællenedslag_komplette {
    match skat.oplyst_beregnet_skat_øre { | None -> None | Some(beløb) -> Some(rapport_sum(skat.poster_uden_ægtefællenedslag) - beløb) }
} ellers { None }
| rapport_nødvendigt_nedslag_forudsætning(skat: RapportSkat, maksimum: Heltal?, ægtefælle_mulig: Boolsk) -> match rapport_nødvendigt_skattenedslag(skat) {
    | None -> []
    | Some(beløb) -> [rapport_forudsætning("Nødvendig samlet skattenedsættelse fra ægtefælle", "øre", beløb, maksimum, ægtefælle_mulig, "Residual mellem alle oplyste øvrige skatteposter og rapportens beregnede skat. Identificerer kun summen, ikke fordelingen eller ægtefællens faktiske forhold. Forudsætter at ingen andre skatteposter mangler.")]
}
-- En delvist oplyst sum kan stadig være umulig: alle overførte nedslag
-- er ikke-negative skatteværdier efter PSL §§ 9–11. Træk kun observationer
-- fra residualet; udfyld aldrig en manglende observation med det afledte krav.
# RapportNedslagMedLoft(oplyst: Heltal?, loft: Heltal?)
| rapport_uoplyste_nedslag_forudsætning(skat: RapportSkat, nedslag: List(RapportNedslagMedLoft), ægtefælle_mulig: Boolsk) -> match rapport_nødvendigt_skattenedslag(skat) {
    | None -> []
    | Some(samlet) -> {
        = uoplyste = filter(nedslag, |n: RapportNedslagMedLoft| n.oplyst == None)
        = oplyst_sum = foldl(nedslag, 0, |sum: Heltal, n: RapportNedslagMedLoft| match n.oplyst { | None -> sum | Some(beløb) -> sum + beløb })
        = maksimum = foldl(uoplyste, Some(0), |sum: Heltal?, n: RapportNedslagMedLoft| rapport_option_plus(sum, n.loft))
        hvis length(uoplyste) == 0 { [] } ellers {
            [rapport_forudsætning("Nødvendig sum af ikke-oplyste ægtefællenedslag", "øre", samlet - oplyst_sum, maksimum, ægtefælle_mulig, "Nødvendigt samlet nedslag minus summen af de oplyste overførsler. Beløbet skal kunne dækkes af netop de manglende poster og deres kontrollerede lofter. Et negativt restbeløb viser, at de kendte overførsler allerede er for store. Ved én manglende post er beløbet nødvendigt for netop den post; ved flere er fordelingen ukendt. Afledt betingelse, ikke observation eller dokumenteret fradragsret.")]
        }
    }
}
| rapport_resterende_kapitalloft(n: RapportÆgtefællenedslag, fælles_maksimum_øre: Heltal) -> match n.eget_negativ_kapitalindkomstnedslag_øre { | None -> fælles_maksimum_øre | Some(eget) -> fælles_maksimum_øre - eget }
| rapport_egen_kapital_forudsætning(n: RapportÆgtefællenedslag, maksimum_øre: Heltal) -> match n.eget_negativ_kapitalindkomstnedslag_øre {
    | None -> []
    | Some(eget) -> [rapport_forudsætning("Eget negativ-kapitalindkomstnedslag inden for PSL § 11-loftet", "øre", eget, Some(maksimum_øre), Sandt, "Eget oplyst nedslag begrænser pladsen til overført nedslag. Uden dokumenteret samliv kan den fælles grænse kun bruges som en betinget øvre grænse.")]
}
| rapport_negativ_kapital_forudsætning(n: RapportÆgtefællenedslag, fælles_maksimum_øre: Heltal, sats_basispoint: Heltal, ægtefælle_mulig: Boolsk) -> match n.negativ_kapitalindkomst_øre {
    | None -> []
    | Some(beløb) -> {
        = resterende_loft = rapport_resterende_kapitalloft(n, fælles_maksimum_øre)
        = mindst_grundlag = hvis beløb > 0 { (beløb * 100 + sats_basispoint - 1) / sats_basispoint } ellers { 0 }
        concat(rapport_nedslagsforudsætning("Ubrugt negativ-kapitalindkomstnedslag fra ægtefælle", Some(beløb), Some(resterende_loft), ægtefælle_mulig), [rapport_forudsætning("Mindste grundlag bag ægtefællens overførte kapitalnedslag", "DKK", mindst_grundlag, Some(par11_beløbsgrænse_kroner() * 2), ægtefælle_mulig, "Nedre grænse udledt af PSL § 11-satsen. Ægtefællens egen udnyttelse kan kræve et større grundlag. Beløbet er ikke en entydig rekonstruktion af renteudgifter eller nettoindkomst.")])
    }
}
-- KSL § 62, stk. 1, LBK 460/2024 og Den juridiske vejledning
-- A.B.4.1.2.2.3, https://info.skat.dk/data.aspx?oid=2169091,
-- kontrolleret 25. september 2026. Begge spor bruger samme slutskat
-- med tillæg; udbetalingskorrektioner kommer først efter denne balance.
----
slutskatten med tillæg af eventuel overført restskat m.v.
----
| rapport_skat_med_tillæg(b: RapportBetaling) -> hvis b.tillæg_til_slutskat_komplette {
    rapport_option_plus(b.oplyst_beregnet_skat_øre, Some(rapport_sum(b.tillæg_til_slutskat)))
} ellers { None }
| rapport_overskydende(b: RapportBetaling) -> rapport_option_difference(b.oplyst_forskudsskat_øre, rapport_skat_med_tillæg(b))
-- KSL § 61, stk. 1, kontrolleret i officiel LBK 460/2024, s. 20,
-- den 22. september 2026. Reglen afstemmer rapportobservationer; den
-- klassificerer ikke tillæg og beviser ikke deres retmæssighed.
----
Beløbet benævnes »restskat«.
----
| rapport_restskat(b: RapportBetaling) -> rapport_option_difference(rapport_skat_med_tillæg(b), b.oplyst_forskudsskat_øre)
| rapport_restskatforudsætninger(b: RapportBetaling) -> match b.restskat {
    | None -> []
    | Some(_) -> match rapport_restskat(b) {
        | None -> []
        | Some(beløb) -> [rapport_forudsætning("Ikke-negativ restskat før renter og procenttillæg", "øre", beløb, None, Sandt, "Slutskat med oplyste tillæg efter KSL § 61, stk. 1, minus forskudsskat. Et negativt beløb hører ikke til restskatssporet. Det beregnede beløb er ikke et krav om betaling nu.")]
    }
}
| rapport_udbetaling(b: RapportBetaling) -> hvis b.korrektioner_komplette {
    match rapport_overskydende(b) {
        | Some(overskud) -> hvis overskud >= 0 && overskud + rapport_sum(b.korrektioner_til_udbetaling) >= 0 { Some((overskud + rapport_sum(b.korrektioner_til_udbetaling)) / 100) } ellers { None }
        | None -> None
    }
} ellers { None }
| rapport_betalingskontroller(b: RapportBetaling) -> match b.restskat {
    | None -> [
        rapport_kontrol("Overskydende skat før godtgørelse og tidligere udbetaling", "øre", rapport_overskydende(b), b.oplyst_overskydende_skat_øre),
        rapport_kontrol("Udbetaling efter oplyste korrektioner og hele kroner", "DKK", rapport_udbetaling(b), b.oplyst_udbetaling_kroner)
    ]
    | Some(r) -> [rapport_kontrol("Restskat før renter og procenttillæg", "øre", rapport_restskat(b), r.oplyst_restskat_øre)]
}

| rapport_ægtefællekommune_understøttet(skatteår: Heltal, kommune: Kommune?) -> match kommune {
    | None -> Sandt
    | Some(k) -> kommune_indkomstskat_understøttet_i_år(skatteår, k)
}
-- CIR 129/1994, 11.1.1. PSL §§ 10 og 12; modtagers satser, ikke afsenders.
-- Samme beregningsretning observeret i Skattestyrelsens anonyme 2025-beregner
-- den 25. september 2026 med udelukkende fiktive fakta; se ledsagende vejledning.
----
Her beregnes skatteværdierne med ægtefællens egne skatteprocenter
----
| rapport_kommunalt_personfradragsloft(input: ÅrsopgørelseAfstemningsinput, personfradrag: Heltal) -> Some(penge_beløb_gange_basispoint_øre(personfradrag, kommunale_indkomstskatteparametre_for(input.skatteår, input.kommune).kommuneskat_basispoint))
| rapport_kirkeligt_personfradragsloft(input: ÅrsopgørelseAfstemningsinput, personfradrag: Heltal) -> hvis input.betaler_kirkeskat {
    Some(penge_beløb_gange_basispoint_øre(personfradrag, kommunale_indkomstskatteparametre_for(input.skatteår, input.kommune).kirkeskat_basispoint))
} ellers { Some(0) }
| rapport_lokale_nedslagsforudsætninger(n: RapportÆgtefællenedslag, kommunemaks: Heltal?, kirkemaks: Heltal?, ægtefælle_mulig: Boolsk) -> match n.kommunalt_og_kirkeligt_personfradrag_øre {
    | None -> concat(rapport_nedslagsforudsætning("Ubrugt kommunal personfradragsværdi fra ægtefælle", n.kommunalt_personfradrag_øre, kommunemaks, ægtefælle_mulig), rapport_nedslagsforudsætning("Ubrugt kirkelig personfradragsværdi fra ægtefælle", n.kirkeligt_personfradrag_øre, kirkemaks, ægtefælle_mulig))
    | Some(beløb) -> rapport_nedslagsforudsætning("Ubrugt kommunal og kirkelig personfradragsværdi fra ægtefælle samlet", Some(beløb), rapport_option_plus(kommunemaks, kirkemaks), ægtefælle_mulig)
}
| rapport_lokale_nedslag_med_loft(n: RapportÆgtefællenedslag, kommunemaks: Heltal?, kirkemaks: Heltal?) -> match n.kommunalt_og_kirkeligt_personfradrag_øre {
    | None -> [RapportNedslagMedLoft(n.kommunalt_personfradrag_øre, kommunemaks), RapportNedslagMedLoft(n.kirkeligt_personfradrag_øre, kirkemaks)]
    | Some(beløb) -> [RapportNedslagMedLoft(Some(beløb), rapport_option_plus(kommunemaks, kirkemaks))]
}
| rapport_afstem_med_parametre(input: ÅrsopgørelseAfstemningsinput) -> {
    = nationale = nationalparametre_for(input.skatteår)
    = ægtefælle_mulig = rapport_ægtefælle_mulig(input.gift_samlevende_ved_årets_udløb)
    = statsmaks = penge_beløb_gange_basispoint_øre(nationale.personfradrag_voksen_kroner, nationale.bundskat_basispoint)
    = kommunemaks = rapport_kommunalt_personfradragsloft(input, nationale.personfradrag_voksen_kroner)
    = kirkemaks = rapport_kirkeligt_personfradragsloft(input, nationale.personfradrag_voksen_kroner)
    = kapitalsats = negativ_kapital_nedslag_sats_basispoint(input.skatteår)
    = kapitalmaks = penge_beløb_gange_basispoint_øre(par11_beløbsgrænse_kroner() * hvis ægtefælle_mulig { 2 } ellers { 1 }, kapitalsats)
    = kontroller = concat(rapport_indkomstkontroller(input.indkomstbro), concat([
        rapport_kontrol("Samlet ægtefællenedslag i beregnet skat", "øre", rapport_nødvendigt_skattenedslag(input.skat), rapport_samlet_ægtefællenedslag(input.ægtefællenedslag)),
        rapport_kontrol("Samme beregnede skat i skatteberegning og betaling", "øre", input.skat.oplyst_beregnet_skat_øre, input.betaling.oplyst_beregnet_skat_øre)
        ], rapport_betalingskontroller(input.betaling)))
    = forudsætninger = flat_map([
        rapport_restskatforudsætninger(input.betaling),
        rapport_underskudsforudsætning(input.indkomstbro, ægtefælle_mulig),
        rapport_nedslagsforudsætning("Ubrugt statslig personfradragsværdi fra ægtefælle", input.ægtefællenedslag.statsligt_personfradrag_øre, Some(statsmaks), ægtefælle_mulig),
        rapport_lokale_nedslagsforudsætninger(input.ægtefællenedslag, kommunemaks, kirkemaks, ægtefælle_mulig),
        rapport_negativ_kapital_forudsætning(input.ægtefællenedslag, kapitalmaks, kapitalsats, ægtefælle_mulig),
        rapport_egen_kapital_forudsætning(input.ægtefællenedslag, kapitalmaks),
        rapport_nødvendigt_nedslag_forudsætning(input.skat, rapport_option_plus(Some(statsmaks + rapport_resterende_kapitalloft(input.ægtefællenedslag, kapitalmaks)), rapport_option_plus(kommunemaks, kirkemaks)), ægtefælle_mulig),
        rapport_uoplyste_nedslag_forudsætning(input.skat, concat([
            RapportNedslagMedLoft(input.ægtefællenedslag.statsligt_personfradrag_øre, Some(statsmaks)),
            RapportNedslagMedLoft(input.ægtefællenedslag.negativ_kapitalindkomst_øre, Some(rapport_resterende_kapitalloft(input.ægtefællenedslag, kapitalmaks)))
            ], rapport_lokale_nedslag_med_loft(input.ægtefællenedslag, kommunemaks, kirkemaks)), ægtefælle_mulig)
        ], |krav: List(AfstemningsForudsætning)| krav)
    = modstrid = any(kontroller, |k: AfstemningsKontrol| k.status == Afviger) || any(forudsætninger, |f: AfstemningsForudsætning| f.inden_for_kontrollerede_grænser == Falskt)
    = ufuldstændig = any(kontroller, |k: AfstemningsKontrol| k.status == IkkeOplyst)
    ÅrsopgørelseAfstemningsresultat(
        status = hvis modstrid { Modstrid } ellers { hvis ufuldstændig { Ufuldstændig } ellers { BetingetAfstemt } },
        uafhængig_skatteberegning_udført = Falskt,
        kontroller = kontroller,
        nødvendige_forudsætninger = forudsætninger,
        uafklaret = [
            "Rapportens kildefakta, fradragsret og alle enkelte skatteposter er ikke uafhængigt genberegnet.",
            "Ægtefællens faktiske indkomst, egne modregninger og overførselsbetingelser er ukendte; nødvendige betingelser er ikke et eksistensbevis for en lovlig samlet husstand.",
            "Kommunale og kirkelige overførselslofter bygger på modtagers kommune og kirkeskat. Ægtefællens kommune kræves ikke til disse lofter. Et samlet rapportbeløb opdeles ikke i opdigtede kommune- og kirkebeløb.",
            "Godtgørelse, renter, tidligere udbetaling og modregning er rapportobservationer, ikke selvstændigt fastslået ret til udbetaling.",
            "Tillæg til slutskat indgår før både overskydende skat og restskat; deres retmæssighed er ikke kontrolleret. Ukendt fuldstændighed tilbageholder betalingsberegningen. Samme tillæg må ikke indgå igen i beregnet skat eller udbetalingskorrektioner.",
            match input.betaling.restskat {
                | None -> "Tilbagebetalingskontrollen dækker ikke restskat eller et negativt beløb efter korrektioner. Brug det særskilte restskatsspor til restskat før renter og procenttillæg."
                | Some(r) -> "Kun restskat før renter og procenttillæg afstemmes. Tillæggenes retmæssighed, renter, procenttillæg, tidligere betalinger, opkrævning, rater og betalingsfrister er ikke kontrolleret. BetingetAfstemt godkender kun de viste sammenligninger, ikke betaling af beløbet."
            },
            "Ingen ukendt værdi er erstattet med nul. Afledte krav må ikke genbruges som verificerede kildefakta."
        ]
    )
}

@ calculate("Afstem årsopgørelse uden ægtefællens rapport")
| afstem_årsopgørelse(input: ÅrsopgørelseAfstemningsinput) -> hvis skatteår_understøttet(input.skatteår) && kommune_indkomstskat_understøttet_i_år(input.skatteår, input.kommune) && rapport_ægtefællekommune_understøttet(input.skatteår, input.ægtefællens_kommune) {
    hvis rapport_input_gyldigt(input) { rapport_afstem_med_parametre(input) } ellers {
        ÅrsopgørelseAfstemningsresultat(status = UgyldigtRapportinput, uafhængig_skatteberegning_udført = Falskt, kontroller = [], nødvendige_forudsætninger = [], uafklaret = ["Kontrollér beløbsenheder, beløbsgrænser, ikke-negative fradrag/restskat/tillæg og entydige postnavne. Samlet kommune-/kirkenedslag kræver null i begge særskilte felter; brug ikke begge repræsentationer. Restskatssporet må ikke samtidig indeholde udbetalingsbeløb eller udbetalingskorrektioner. Ingen afstemning udført."])
    }
} ellers {
    ÅrsopgørelseAfstemningsresultat(status = IkkeUnderstøttetÅrEllerKommune, uafhængig_skatteberegning_udført = Falskt, kontroller = [], nødvendige_forudsætninger = [], uafklaret = ["År eller kommune mangler understøttede parametre. Ingen afstemning udført."])
}
