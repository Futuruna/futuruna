@ sprog da

@ importer ./personskat - par14.scenario

----
Dette kompatibilitetsscenarie genbruger den kanoniske § 14-beregning. Den
tidligere forenklede lønmodtagergren samlede statsskatter med forskellige
indkomstgrundlag før delårsnedsættelsen og er derfor udgået.
----

= delaar1_par14 = personskat_par14_stk1
= delaar1_par14_bundskat = personskat_par14_scenarie_statslig_komponent(delaar1_par14, Par14Bundskat)
= delaar1_par14_kommuneskat = personskat_par14_scenarie_kommunal_komponent(delaar1_par14, Par14Kommuneskat)

| delaar1_helårs_bruttoløn: delaar1_par14 -> delaar1_par14.input_gyldigt && delaar1_par14.skattepligtsdage == 184 && delaar1_par14.helårsinput.bruttoløn_kroner == 595109
| delaar1_helårs_skattepligtig_indkomst: delaar1_par14 -> delaar1_par14.helårsberegning.almindelig_skattepligtig_indkomst_kroner > delaar1_par14.delårsresultat.skat.almindelig_skattepligtig_indkomst_kroner
| delaar1_par14_bruger_komponentvis_skatteberegning: delaar1_par14_bundskat -> delaar1_par14.helårsskattekomponenter_afstemt && delaar1_par14_bundskat.input_gyldigt && delaar1_par14_kommuneskat.input_gyldigt && delaar1_par14_bundskat.nedsættelsesfaktor_tæller_kroner * delaar1_par14_kommuneskat.nedsættelsesfaktor_nævner_kroner != delaar1_par14_kommuneskat.nedsættelsesfaktor_tæller_kroner * delaar1_par14_bundskat.nedsættelsesfaktor_nævner_kroner
| delaar1_par14_bruger_lovens_helårsomregning: delaar1_par14 -> delaar1_par14.valg.helårsomregning_skal_ske && delaar1_par14.statslig_indkomstskat_efter_par14_øre > 0 && delaar1_par14.kommunal_og_kirkelig_indkomstskat_efter_par14_øre > 0
| delaar1_delårs_am_udenfor_par14_helårsskat: delaar1_par14 -> delaar1_par14.arbejdsmarkedsbidrag_for_delåret_øre == 2400000

? delaar1_helårs_bruttoløn
? delaar1_helårs_skattepligtig_indkomst
? delaar1_par14_bruger_komponentvis_skatteberegning
? delaar1_par14_bruger_lovens_helårsomregning
? delaar1_delårs_am_udenfor_par14_helårsskat

@ print("delår scenarie 1 helårs bruttoløn: " + vis(delaar1_par14.helårsinput.bruttoløn_kroner))
@ print("delår scenarie 1 helårs skattepligtig indkomst: " + vis(delaar1_par14.helårsberegning.almindelig_skattepligtig_indkomst_kroner))
@ print("delår scenarie 1 statsskat efter § 14 i øre: " + vis(delaar1_par14.statslig_indkomstskat_efter_par14_øre))
@ print("delår scenarie 1 kommune- og kirkeskat efter § 14 i øre: " + vis(delaar1_par14.kommunal_og_kirkelig_indkomstskat_efter_par14_øre))
@ print("delår scenarie 1 delårs AM-bidrag i øre: " + vis(delaar1_par14.arbejdsmarkedsbidrag_for_delåret_øre))
