    kilde = selskabsskattelov_par17_stk1_sats_kilde(skatteår),
    selskabsskat_basispoint = selskabsskattelov_par17_stk1_selskabsskat_basispoint(skatteår),
    tillægsselskabsskat_basispoint = selskabsskattelov_par17_stk1_tillægsselskabsskat_basispoint(skatteår),
    cfc_sats_basispoint = selskabsskattelov_par17_stk1_selskabsskat_basispoint(skatteår)
) under skatteår >= 2024
| selskabsskattelov_par17_stk1_sats_basispoint(skatteår: Heltal) -> selskabsskattelov_par17_stk1_sats_resultat(skatteår).selskabsskat_basispoint
--@end::selskabsskatteloven_par17_stk1--
