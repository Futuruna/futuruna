| selskabsskattelov1_stk1_nr1_selskabsform_omfattet(selskabsform: Selskabsskattelov1Stk1Nr1Selskabsform) -> Falskt
| exception sel1_stk1_nr1_aktieselskab selskabsskattelov1_stk1_nr1_selskabsform_omfattet(selskabsform: Selskabsskattelov1Stk1Nr1Selskabsform) -> Sandt under selskabsform == Sel1Stk1Nr1IndregistreretAktieselskab
| exception sel1_stk1_nr1_anpartsselskab selskabsskattelov1_stk1_nr1_selskabsform_omfattet(selskabsform: Selskabsskattelov1Stk1Nr1Selskabsform) -> Sandt under selskabsform == Sel1Stk1Nr1IndregistreretAnpartsselskab

# Selskabsskattelov1Stk1Nr1Sag(input: Selskabsskattelov1Stk1Nr1Input) {
    | kilde() -> SelskabsskattelovenLbk279Af2025Par1Stk1Nr1
    | selskabsform_omfattet_af_nr1() -> selskabsskattelov1_stk1_nr1_selskabsform_omfattet(input.selskabsform)
    | skattepligtig_efter_par1_stk1_nr1() -> selskabsform_omfattet_af_nr1() && input.hjemmehørende_i_danmark
    | resultat() -> Selskabsskattelov1Stk1Nr1Resultat(
        kilde = kilde(),
        selskabsform = input.selskabsform,
        selskabsform_omfattet_af_nr1 = selskabsform_omfattet_af_nr1(),
        hjemmehørende_i_danmark = input.hjemmehørende_i_danmark,
        skattepligtig_efter_par1_stk1_nr1 = skattepligtig_efter_par1_stk1_nr1()
    )
}
| selskabsskattelov1_stk1_nr1_sag(input: Selskabsskattelov1Stk1Nr1Input) -> Selskabsskattelov1Stk1Nr1Sag(input)
