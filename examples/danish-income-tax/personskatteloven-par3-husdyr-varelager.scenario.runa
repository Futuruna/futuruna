@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Scenarier for Husdyrbeskatningsloven §§ 2 og 8,
-- bekendtgørelse nr. 543 af 16. november 1981 §§ 1-5,
-- Varelagerloven § 1 og Personskatteloven § 3, stk. 2, nr. 4-5.
-- Lovtekst og kildeankre ligger i de importerede lovmoduler.

= husdyr_par2_normalværdi_2026 = husdyr_par2_resultat(HusdyrPar2Input(
    indkomstår = 2026,
    skatteyder = HusdyrLandbrugerPerson,
    værdiansættelse = HusdyrNormalhandelsværdi(
        normalhandelsværdi_kroner = 200000
    ),
    ønsket_nedskrivning_kroner = 50000
))

= husdyr_par2_handelsværdi_efter_moms_2026 = husdyr_par2_resultat(HusdyrPar2Input(
    indkomstår = 2026,
    skatteyder = HusdyrLandbrugerPerson,
    værdiansættelse = HusdyrHandelsværdi(
        normalhandelsværdi_kroner = 100000,
        handelsværdi_inklusive_eventuel_indgående_moms_kroner = 150000,
        fradragsberettiget_indgående_moms_kroner = 30000
    ),
    ønsket_nedskrivning_kroner = 20000
))

= husdyr_par2_selskab_2026 = husdyr_par2_resultat(HusdyrPar2Input(
    indkomstår = 2026,
    skatteyder = HusdyrLandbrugerSelskab,
    værdiansættelse = HusdyrNormalhandelsværdi(
        normalhandelsværdi_kroner = 200000
    ),
    ønsket_nedskrivning_kroner = 50000
))

= husdyr_par8_tomt_2026 = husdyr_par8_resultat(HusdyrPar8Input(
    indkomstår = 2026,
    rettighedshaver = HusdyrPar8Landbruger,
    grupper = [],
    indkomstår1981_forhold = HusdyrPar8IkkeIndkomstår1981
))

= husdyr_par8_gruppevis_reduktion_2026 = husdyr_par8_resultat(HusdyrPar8Input(
    indkomstår = 2026,
    rettighedshaver = HusdyrPar8Landbruger,
    grupper = [
        HusdyrPar8GruppeInput(
            gruppe = HusdyrPar8Kvæg,
            grundlag = HusdyrPar8OrdinærtForskelsgrundlag(
                normalhandelsværdi_1980_kroner = 200000,
                normalpris_eller_lavere_handelsværdi_1980_kroner = 100000
            ),
            c_fradrag_fordelt_til_gruppen_kroner = 0,
            allerede_fradraget_før_indkomståret_kroner = 0,
            ansættelsesændring = HusdyrPar8IngenAnsættelsesændring,
            basisantal_1980 = 100,
            basisantal_forrige_indkomstår = 100,
            basisantal_aktuelt_indkomstår = 80,
            reguleringstal_ved_begyndelsen_af_reduktionsåret = 0,
            højeste_antal_i_to_følgende_indkomstår = 0
        ),
        HusdyrPar8GruppeInput(
            gruppe = HusdyrPar8Svin,
            grundlag = HusdyrPar8MinisterfastsatForskelsbeløb(
                beløb_kroner = 10000
            ),
            c_fradrag_fordelt_til_gruppen_kroner = 0,
            allerede_fradraget_før_indkomståret_kroner = 0,
            ansættelsesændring = HusdyrPar8IngenAnsættelsesændring,
            basisantal_1980 = 50,
            basisantal_forrige_indkomstår = 50,
            basisantal_aktuelt_indkomstår = 50,
            reguleringstal_ved_begyndelsen_af_reduktionsåret = 0,
            højeste_antal_i_to_følgende_indkomstår = 0
        ),
        HusdyrPar8GruppeInput(
            gruppe = HusdyrPar8Heste,
            grundlag = HusdyrPar8MinisterfastsatForskelsbeløb(
                beløb_kroner = 4000
            ),
            c_fradrag_fordelt_til_gruppen_kroner = 0,
            allerede_fradraget_før_indkomståret_kroner = 0,
            ansættelsesændring = HusdyrPar8IngenAnsættelsesændring,
            basisantal_1980 = 20,
            basisantal_forrige_indkomstår = 20,
            basisantal_aktuelt_indkomstår = 0,
            reguleringstal_ved_begyndelsen_af_reduktionsåret = 0,
            højeste_antal_i_to_følgende_indkomstår = 0
        )
    ],
    indkomstår1981_forhold = HusdyrPar8IkkeIndkomstår1981
))

= husdyr_par8_tilbageregulering_2024 = husdyr_par8_resultat(HusdyrPar8Input(
    indkomstår = 2024,
    rettighedshaver = HusdyrPar8Landbruger,
    grupper = [
        HusdyrPar8GruppeInput(
            gruppe = HusdyrPar8Kvæg,
            grundlag = HusdyrPar8MinisterfastsatForskelsbeløb(
