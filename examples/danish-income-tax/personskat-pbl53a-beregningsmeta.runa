    question = Some("Er ordningen omfattet af pensionsbeskatningslovens § 53 B?"),
    help = Some("En ordning omfattet af § 53 B falder uden for § 53 A, stk. 1."),
    unit = None
)
= personskat_pbl53a_felt_stk4_livsforsikring = Beregningsfelt(
