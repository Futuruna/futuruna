    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalgfristfakta::Pbl53ASenereIndtrådtFuldSkattepligt::oplysningsfrist::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalgfristfakta::Pbl53ASenereIndtrådtFuldSkattepligt::oplysningsfrist::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalgfristfakta::Pbl53ASenereIndtrådtFuldSkattepligt::oplysningsfrist::dag), label = "Oplysningsfrist efter senere fuld skattepligt", question = "Hvornår udløb oplysningsfristen for indtrædelsesåret?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalgfristfakta::Pbl53ASenereArvUnderFuldSkattepligt::arvedato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalgfristfakta::Pbl53ASenereArvUnderFuldSkattepligt::arvedato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalgfristfakta::Pbl53ASenereArvUnderFuldSkattepligt::arvedato::dag), label = "Arvedato for det senere overgangsvalg", question = "Hvornår blev den historiske livsforsikring arvet?"),
