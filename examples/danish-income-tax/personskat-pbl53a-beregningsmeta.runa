@ sprog da

@ importer ./metadata
@ importer ./pensionsbeskatningsloven
@ importer ./kapitel-01-indkomst
@ importer ./arbejdsmarkedsbidragsloven

= personskat_pbl53a_felt_ordninger = Beregningsfelt(
    path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger),
    label = "Pensionsordninger efter PBL § 53 A",
    question = Some("Har du en eller flere pensionsordninger, hvis afkast skal behandles efter pensionsbeskatningslovens § 53 A?"),
    help = Some("Tilføj hver ordning særskilt. Negativt afkast fremføres inden for den samme identificerede ordning."),
    unit = None
)

# PersonskatPbl53AFelttekst(path: ProgramReference, label: Tekst, question: Tekst, unit: Tekst?)
# PersonskatPbl53ADatofelttekst(år: ProgramReference, måned: ProgramReference, dag: ProgramReference, label: Tekst, question: Tekst)
# PersonskatPbl53ABerettigedefelttekst(path: ProgramReference, label: Tekst)

| personskat_pbl53a_felt_fra_tekst(felt: PersonskatPbl53AFelttekst) -> Beregningsfelt(
    path = felt.path,
    label = felt.label,
    question = Some(felt.question),
    help = None,
    unit = felt.unit
)
| personskat_pbl53a_datofelter(felt: PersonskatPbl53ADatofelttekst) -> [
    Beregningsfelt(path = felt.år, label = felt.label + " - år", question = Some(felt.question + " Angiv året."), help = None, unit = Some("år")),
    Beregningsfelt(path = felt.måned, label = felt.label + " - måned", question = Some(felt.question + " Angiv måneden."), help = None, unit = None),
    Beregningsfelt(path = felt.dag, label = felt.label + " - dag", question = Some(felt.question + " Angiv dagen i måneden."), help = None, unit = None)
]
| personskat_pbl53a_berettigedefelt(felt: PersonskatPbl53ABerettigedefelttekst) -> Beregningsfelt(
    path = felt.path,
    label = felt.label,
    question = Some("Hvem er berettiget efter direktørens pensionstilsagn?"),
    help = Some("Angiv direktøren og alle efterladte, som kan modtage udbetalinger."),
    unit = None
)

= personskat_pbl53a_omfang_enkeltfelter = map([
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::virkningstidspunkt::rækkefølge_på_dagen), label = "Kontraktændringens rækkefølge på dagen", question = "I hvilken rækkefølge fik kontraktændringen virkning blandt ordningens hændelser samme dag?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::erhvervelser::tidspunkt::rækkefølge_på_dagen), label = "Erhvervelsens rækkefølge på dagen", question = "I hvilken rækkefølge skete erhvervelsen blandt ordningens hændelser samme dag?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::$variant), label = "Livsforsikringens status efter PBL kapitel 1", question = "Er livsforsikringen omfattet af kapitel 1, uden for kapitel 1 eller tidligere godkendt efter § 15 D?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::direktørsikkerhed::$variant), label = "Livsforsikring stillet til sikkerhed for direktørpension", question = "Er livsforsikringen stillet til sikkerhed for et pensionstilsagn til en direktør eller dennes efterladte?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::direktørsikkerhed::Pbl53ASikkerhedForDirektørpensionstilsagn::tilsagn::identifikation), label = "Direktørpensionstilsagn sikret ved livsforsikring", question = "Hvilket pensionstilsagn sikrer livsforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::direktørsikkerhed::Pbl53ASikkerhedForDirektørpensionstilsagn::tilsagn::ansættelsesforhold_identifikation), label = "Ansættelsesforhold for det sikrede pensionstilsagn", question = "Hvilket ansættelsesforhold blev det sikrede pensionstilsagn afgivet i?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53APensionskasseprodukt::kapitel1fakta::$variant), label = "Pensionskassens status efter PBL kapitel 1", question = "Er pensionskasseordningen omfattet af kapitel 1, uden for kapitel 1 eller tidligere godkendt efter § 15 D?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53APensionskasseprodukt::direktørsikkerhed::$variant), label = "Pensionskasseordning stillet til sikkerhed for direktørpension", question = "Er pensionskasseordningen stillet til sikkerhed for et pensionstilsagn til en direktør eller dennes efterladte?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53APensionskasseprodukt::direktørsikkerhed::Pbl53ASikkerhedForDirektørpensionstilsagn::tilsagn::identifikation), label = "Direktørpensionstilsagn sikret ved pensionskasseordning", question = "Hvilket pensionstilsagn sikrer pensionskasseordningen?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53APensionskasseprodukt::direktørsikkerhed::Pbl53ASikkerhedForDirektørpensionstilsagn::tilsagn::ansættelsesforhold_identifikation), label = "Ansættelsesforhold for pensionskassens sikkerhed", question = "Hvilket ansættelsesforhold blev det sikrede pensionstilsagn afgivet i?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53AGarantiforsikringsprodukt::tilsagn::identifikation), label = "Pensionstilsagn dækket af garantiforsikringen", question = "Hvilket direktørpensionstilsagn dækkes af garantiforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53AGarantiforsikringsprodukt::tilsagn::ansættelsesforhold_identifikation), label = "Ansættelsesforhold for garantiforsikringen", question = "Hvilket ansættelsesforhold blev pensionstilsagnet bag garantiforsikringen afgivet i?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53APengeEllerKreditinstitutprodukt::kapitel1fakta::$variant), label = "Pengeinstitutordningens status efter PBL kapitel 1", question = "Er pengeinstitutordningen omfattet af kapitel 1, uden for kapitel 1 eller tidligere godkendt efter § 15 D?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::par53b_oprettelsesposition::Pbl53BOprettetUdenFuldDanskSkattepligt::hjemsted::$variant), label = "Hjemsted uden fuld dansk skattepligt", question = "Var hjemstedet en fremmed stat, Færøerne eller Grønland?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::par53b_oprettelsesposition::Pbl53BOprettetUdenFuldDanskSkattepligt::hjemsted::Pbl53BFremmedStat::stat), label = "Fremmed stat uden fuld dansk skattepligt", question = "I hvilken fremmed stat var personen skattepligtig eller hjemmehørende?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::par53b_oprettelsesposition::Pbl53BOprettetMedDboHjemstedIUdlandet::hjemsted::$variant), label = "Hjemsted efter dobbeltbeskatningsoverenskomst", question = "Var hjemstedet efter overenskomsten en fremmed stat, Færøerne eller Grønland?", unit = None),
    PersonskatPbl53AFelttekst(path = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::par53b_oprettelsesposition::Pbl53BOprettetMedDboHjemstedIUdlandet::hjemsted::Pbl53BFremmedStat::stat), label = "Fremmed stat efter dobbeltbeskatningsoverenskomst", question = "I hvilken fremmed stat var personen hjemmehørende efter overenskomsten?", unit = None)
    ], personskat_pbl53a_felt_fra_tekst)

= personskat_pbl53a_omfang_datofelter = flat_map([
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::oprettelsesdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::oprettelsesdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::oprettelsesdato::dag), label = "Ordningens oprettelsesdato", question = "Hvornår blev ordningen oprettet?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::ændringsdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::ændringsdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::ændringsdato::dag), label = "Dato hvor kontraktændringen blev aftalt", question = "Hvornår blev kontraktændringen aftalt?"),
