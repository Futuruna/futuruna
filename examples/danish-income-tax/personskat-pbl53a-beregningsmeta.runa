@ sprog da

@ importer ./metadata
@ importer ./pensionsbeskatningsloven
@ importer ./kapitel - 01 - indkomst
@ importer ./arbejdsmarkedsbidragsloven

= personskat_pbl53a_felt_ordninger = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger",
    label = "Pensionsordninger efter PBL § 53 A",
    question = Some("Har du en eller flere pensionsordninger, hvis afkast skal behandles efter pensionsbeskatningslovens § 53 A?"),
    help = Some("Tilføj hver ordning særskilt. Negativt afkast fremføres inden for den samme identificerede ordning."),
    unit = None
)
= personskat_pbl53a_felt_identifikation = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.identifikation",
    label = "§ 53 A-ordningens identifikation",
    question = Some("Hvilken entydig identifikation skal pensionsordningen have?"),
    help = Some("Brug en stabil identifikation, så afkast og fremført negativt afkast ikke blandes mellem ordninger."),
    unit = None
)
= personskat_pbl53a_felt_skatteyder_identifikation = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.skatteyder_identifikation",
    label = "Skatteyder på § 53 A-ordningen",
    question = Some("Hvilken skatteyder skal ordningens afkast henføres til?"),
    help = Some("Identifikationen sammenholdes med de berettigede ved hvert års udgang."),
    unit = None
)
= personskat_pbl53a_felt_afkastforløbsåbning = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.afkastforløbsåbning.$variant",
    label = "Historik før det første angivne afkastår",
    question = Some("Er det første angivne afkastår ordningens første skattepligtige afkastår, eller fortsætter beregningen en dokumenteret historik?"),
    help = Some("Vælg dokumenteret historik, hvis ordningen allerede havde et bindende metodevalg eller fremført negativt afkast før det første år i arket."),
    unit = None
)
= personskat_pbl53a_felt_tidligere_seneste_indkomstår = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.afkastforløbsåbning.Pbl53ADokumenteretTidligereAfkasthistorik.seneste_indkomstår",
    label = "Seneste indkomstår før afkastforløbet",
    question = Some("Hvilket indkomstår ligger umiddelbart før det første angivne afkastår?"),
    help = Some("Året skal ligge umiddelbart før første række med årlige afkastfakta."),
    unit = Some("år")
)
= personskat_pbl53a_felt_tidligere_metodetilstand = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.afkastforløbsåbning.Pbl53ADokumenteretTidligereAfkasthistorik.metodetilstand",
    label = "Bindende afkastmetode før afkastforløbet",
    question = Some("Var PAL-metoden eller den alternative kapitalværdimetode allerede bindende før det første angivne år?"),
    help = Some("Før 2010 skal der ikke angives et bindende moderne metodevalg. Fra 2010 følger valget ordningen i senere skattepligtige år."),
    unit = None
)
= personskat_pbl53a_felt_tidligere_negative_afkast = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.afkastforløbsåbning.Pbl53ADokumenteretTidligereAfkasthistorik.fremførte_negative_afkast",
    label = "Fremførte negative afkast ved afkastforløbets begyndelse",
    question = Some("Hvilke uudnyttede negative afkast fra samme ordning var dokumenteret før det første angivne år?"),
    help = Some("Angiv hvert oprindelsesår særskilt. Tab fra 2001 eller tidligere kan kun bruges i oprindelsesåret og de fem følgende indkomstår; tab fra 2002 eller senere har ingen tilsvarende femårsgrænse."),
    unit = None
)
= personskat_pbl53a_felt_tidligere_negativt_afkast_opstået_år = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.afkastforløbsåbning.Pbl53ADokumenteretTidligereAfkasthistorik.fremførte_negative_afkast.opstået_indkomstår",
    label = "Oprindelsesår for fremført negativt afkast",
    question = Some("I hvilket indkomstår opstod det negative afkast?"),
    help = None,
    unit = Some("år")
)
= personskat_pbl53a_felt_tidligere_negativt_afkast_resterende = Beregningsfelt(
    path = "kapitalindkomst.pbl53a.ordninger.afkastforløbsåbning.Pbl53ADokumenteretTidligereAfkasthistorik.fremførte_negative_afkast.resterende_kroner",
    label = "Resterende fremført negativt afkast",
    question = Some("Hvor meget af det negative afkast var endnu ikke modregnet før det første angivne år?"),
    help = None,
    unit = Some("kr.")
)

# PersonskatPbl53AFelttekst(path: Tekst, label: Tekst, question: Tekst, unit: Tekst?)
# PersonskatPbl53ADatofelttekst(path: Tekst, label: Tekst, question: Tekst)
# PersonskatPbl53ABerettigedefelttekst(path: Tekst, label: Tekst)

| personskat_pbl53a_felt_fra_tekst(felt: PersonskatPbl53AFelttekst) -> Beregningsfelt(
    path = felt.path,
    label = felt.label,
    question = Some(felt.question),
    help = None,
    unit = felt.unit
)
| personskat_pbl53a_datofelter(felt: PersonskatPbl53ADatofelttekst) -> [
    Beregningsfelt(path = felt.path + ".år", label = felt.label + " - år", question = Some(felt.question + " Angiv året."), help = None, unit = Some("år")),
    Beregningsfelt(path = felt.path + ".måned", label = felt.label + " - måned", question = Some(felt.question + " Angiv måneden."), help = None, unit = None),
    Beregningsfelt(path = felt.path + ".dag", label = felt.label + " - dag", question = Some(felt.question + " Angiv dagen i måneden."), help = None, unit = None)
]
| personskat_pbl53a_berettigedefelter(felt: PersonskatPbl53ABerettigedefelttekst) -> [
    Beregningsfelt(path = felt.path, label = felt.label, question = Some("Hvem er berettiget efter direktørens pensionstilsagn?"), help = Some("Angiv direktøren og alle efterladte, som kan modtage udbetalinger."), unit = None),
    Beregningsfelt(path = felt.path + ".$variant", label = "Type berettiget til direktørpension", question = Some("Er den berettigede direktøren selv, en efterladt eller en anden person?"), help = None, unit = None),
    Beregningsfelt(path = felt.path + ".Pbl53ADirektørenSomBerettiget.identifikation", label = "Direktørens identifikation", question = Some("Hvilken direktør er berettiget til pensionstilsagnet?"), help = None, unit = None),
    Beregningsfelt(path = felt.path + ".Pbl53AEfterladtEfterDirektør.identifikation", label = "Den efterladtes identifikation", question = Some("Hvilken efterladt er berettiget efter direktørens død?"), help = None, unit = None),
    Beregningsfelt(path = felt.path + ".Pbl53AEfterladtEfterDirektør.direktør_identifikation", label = "Direktør for den efterladte", question = Some("Hvilken direktør er den efterladtes ret knyttet til?"), help = None, unit = None),
    Beregningsfelt(path = felt.path + ".Pbl53AAndenDirektørpensionsberettiget.identifikation", label = "Anden berettigets identifikation", question = Some("Hvilken anden person er angivet som berettiget?"), help = None, unit = None)
]

= personskat_pbl53a_omfang_enkeltfelter = map([
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.oprindelig_rettighedshaver_identifikation", label = "Oprindelig rettighedshaver til ordningen", question = "Hvem havde retten til ordningen, da den blev oprettet?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.kapitalværdi_ved_oprettelsen_kroner", label = "Kapitalværdi ved ordningens oprettelse", question = "Hvad var ordningens kapitalværdi, da den blev oprettet?", unit = Some("kr.")),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser", label = "Senere erhvervelser af ordningen", question = "Er ordningen efter oprettelsen overgået til en ny ejer en eller flere gange?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser.identifikation", label = "Erhvervelsens identifikation", question = "Hvilken entydig identifikation skal denne overgang af rettigheder have?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser.tidspunkt.rækkefølge_på_dagen", label = "Erhvervelsens rækkefølge på dagen", question = "I hvilken rækkefølge skete erhvervelsen blandt ordningens hændelser samme dag?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser.overdrager_identifikation", label = "Rettighedshaver før erhvervelsen", question = "Hvem overdrog retten til ordningen ved denne erhvervelse?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser.erhverver_identifikation", label = "Rettighedshaver efter erhvervelsen", question = "Hvem erhvervede retten til ordningen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser.kapitalværdi_på_erhvervelsestidspunktet_kroner", label = "Kapitalværdi ved erhvervelsen", question = "Hvad var ordningens kapitalværdi på erhvervelsestidspunktet?", unit = Some("kr.")),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.erhvervelser.måde", label = "Erhvervelsesmåden", question = "Skete denne erhvervelse ved arv eller på anden måde?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalgfristfakta.$variant", label = "Fristgrundlag for overgangsvalg efter PBL §§ 53 A eller 53 B", question = "Hvilket fristgrundlag gjaldt for et eventuelt bindende valg for den historiske ordning?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalgfristfakta.Pbl53ASenereArvUnderFuldSkattepligt.fuld_skattepligtig_på_arvedatoen", label = "Fuld dansk skattepligt ved den senere arv", question = "Var arvingen fuldt skattepligtig til Danmark på arvedatoen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalgfristfakta.Pbl53ASenereArvUnderFuldSkattepligt.tidligere_ejer_fuld_skattepligtig_i_ejerperioden", label = "Tidligere ejers danske skattepligt", question = "Var en tidligere ejer fuldt skattepligtig til Danmark, mens vedkommende ejede ordningen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalgfristfakta.Pbl53ASenereArvUnderFuldSkattepligt.tidligere_ejer_havde_valgt_afsnit_iia", label = "Tidligere ejers overgangsvalg", question = "Havde en tidligere ejer allerede valgt behandling efter PBL afsnit II A?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalg", label = "Meddelelser om bindende overgangsvalg", question = "Blev der meddelt et valg om behandling efter PBL § 53 A eller § 53 B?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalg.mål", label = "Valgt pensionsbeskatningsregel", question = "Gjaldt meddelelsen behandling efter PBL § 53 A eller § 53 B?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalg.modtager", label = "Modtager af overgangsvalget", question = "Blev valget meddelt Skattestyrelsen, den indberettende pensionsudbyder eller en anden modtager?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.overgangsvalg.ønsket_virkning", label = "Ønsket virkning af overgangsvalget", question = "Skulle valget have virkning fra modtagelsen eller tilbagevirkende fra 1. januar 2004?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.$variant", label = "Ordningens faktiske produkttype", question = "Hvilket forsikrings-, pensionskasse- eller pengeinstitutprodukt er der faktisk oprettet?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.ejer_identifikation", label = "Livsforsikringens ejer", question = "Hvem ejer livsforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.forsikret_identifikation", label = "Personen forsikret ved livsforsikringen", question = "Hvem er forsikret ved livsforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.kapitel1fakta.$variant", label = "Livsforsikringens status efter PBL kapitel 1", question = "Er livsforsikringen omfattet af kapitel 1, uden for kapitel 1 eller tidligere godkendt efter § 15 D?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.vilkår.dækninger", label = "Livsforsikringens dækninger", question = "Hvilke hændelser kan udløse udbetaling fra livsforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.direktørsikkerhed.$variant", label = "Livsforsikring stillet til sikkerhed for direktørpension", question = "Er livsforsikringen stillet til sikkerhed for et pensionstilsagn til en direktør eller dennes efterladte?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.direktørsikkerhed.Pbl53ASikkerhedForDirektørpensionstilsagn.tilsagn.identifikation", label = "Direktørpensionstilsagn sikret ved livsforsikring", question = "Hvilket pensionstilsagn sikrer livsforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ALivsforsikringsprodukt.direktørsikkerhed.Pbl53ASikkerhedForDirektørpensionstilsagn.tilsagn.ansættelsesforhold_identifikation", label = "Ansættelsesforhold for det sikrede pensionstilsagn", question = "Hvilket ansættelsesforhold blev det sikrede pensionstilsagn afgivet i?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.pensionsberettiget_identifikation", label = "Pensionsberettiget i pensionskassen", question = "Hvem er pensionsberettiget i pensionskasseordningen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.kapitel1fakta.$variant", label = "Pensionskassens status efter PBL kapitel 1", question = "Er pensionskasseordningen omfattet af kapitel 1, uden for kapitel 1 eller tidligere godkendt efter § 15 D?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.karakteristika.selvstændig_juridisk_person", label = "Pensionskassen er en selvstændig juridisk person", question = "Er pensionskassen en selvstændig juridisk person?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.karakteristika.uafhængig_af_arbejdsgiver", label = "Pensionskassen er uafhængig af arbejdsgiveren", question = "Er pensionskassen retligt og økonomisk uafhængig af arbejdsgiveren?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.karakteristika.midler_afsondret_fra_berettigedes_formue", label = "Pensionskassens midler er afsondret", question = "Er pensionskassens midler afsondret fra den pensionsberettigedes øvrige formue?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.karakteristika.vedtægter_fastlægger_pensionsydelser", label = "Vedtægterne fastlægger pensionsydelserne", question = "Fastlægger pensionskassens vedtægter de pensionsydelser, der kan udbetales?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.direktørsikkerhed.$variant", label = "Pensionskasseordning stillet til sikkerhed for direktørpension", question = "Er pensionskasseordningen stillet til sikkerhed for et pensionstilsagn til en direktør eller dennes efterladte?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.direktørsikkerhed.Pbl53ASikkerhedForDirektørpensionstilsagn.tilsagn.identifikation", label = "Direktørpensionstilsagn sikret ved pensionskasseordning", question = "Hvilket pensionstilsagn sikrer pensionskasseordningen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APensionskasseprodukt.direktørsikkerhed.Pbl53ASikkerhedForDirektørpensionstilsagn.tilsagn.ansættelsesforhold_identifikation", label = "Ansættelsesforhold for pensionskassens sikkerhed", question = "Hvilket ansættelsesforhold blev det sikrede pensionstilsagn afgivet i?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ASygeOgUlykkesforsikringsprodukt.ejer_identifikation", label = "Syge- og ulykkesforsikringens ejer", question = "Hvem ejer syge- og ulykkesforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53ASygeOgUlykkesforsikringsprodukt.forsikret_identifikation", label = "Personen dækket af syge- og ulykkesforsikringen", question = "Hvem er forsikret ved syge- og ulykkesforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53AGarantiforsikringsprodukt.tilsagn.identifikation", label = "Pensionstilsagn dækket af garantiforsikringen", question = "Hvilket direktørpensionstilsagn dækkes af garantiforsikringen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53AGarantiforsikringsprodukt.tilsagn.ansættelsesforhold_identifikation", label = "Ansættelsesforhold for garantiforsikringen", question = "Hvilket ansættelsesforhold blev pensionstilsagnet bag garantiforsikringen afgivet i?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.kontohaver_identifikation", label = "Kontohaver i penge- eller kreditinstituttet", question = "Hvem er kontohaver på pensionsordningen?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.kapitel1fakta.$variant", label = "Pengeinstitutordningens status efter PBL kapitel 1", question = "Er pengeinstitutordningen omfattet af kapitel 1, uden for kapitel 1 eller tidligere godkendt efter § 15 D?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.institutionssted.$variant", label = "Penge- eller kreditinstituttets placering", question = "Er instituttet dansk eller udenlandsk?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.institutionssted.Pbl53AUdenlandskInstitution.stat", label = "Stat for det udenlandske institut", question = "I hvilken stat ligger penge- eller kreditinstituttet?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.karakteristika.standardiseret_lovreguleret_pensionsprodukt", label = "Standardiseret og lovreguleret pensionsprodukt", question = "Er ordningen et standardiseret pensionsprodukt reguleret ved lov?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.karakteristika.pensionsmidler_adskilt_fra_øvrig_formue", label = "Pensionsmidlerne er adskilt fra øvrig formue", question = "Er pensionsmidlerne adskilt fra kontohaverens øvrige formue?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.produkt.Pbl53APengeEllerKreditinstitutprodukt.karakteristika.kan_disponeres_som_almindelig_bankkonto", label = "Kan disponeres som almindelig bankkonto", question = "Kan kontohaveren disponere over midlerne som på en almindelig bankkonto?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.afsnit_i_valg.$variant", label = "Afkald på beskatning efter PBL afsnit I", question = "Blev der ved ordningens oprettelse givet afkald på beskatning efter reglerne i afsnit I?", unit = None),
    PersonskatPbl53AFelttekst(path = "kapitalindkomst.pbl53a.ordninger.omfangsfakta.afsnit_i_valg.Pbl53AAfkaldPåAfsnitI.afgiver_identifikation", label = "Personen der gav afkald på afsnit I", question = "Hvem afgav afkaldet på beskatning efter afsnit I?", unit = None),
