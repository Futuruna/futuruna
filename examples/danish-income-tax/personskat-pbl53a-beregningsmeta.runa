    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalg::modtagelsesdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalg::modtagelsesdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::overgangsvalg::modtagelsesdato::dag), label = "Modtagelsesdato for overgangsvalget", question = "Hvornår modtog Skattestyrelsen eller den indberettende pensionsudbyder valget?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::historiske_blanket49020_indsendelser::indsendelsesdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::historiske_blanket49020_indsendelser::indsendelsesdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::historiske_blanket49020_indsendelser::indsendelsesdato::dag), label = "Indsendelsesdato for historisk blanket 49.020", question = "Hvornår blev den historiske blanket 49.020 indsendt?"),
