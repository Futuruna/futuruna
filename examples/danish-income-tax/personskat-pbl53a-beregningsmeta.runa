    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::forhåndsaftale::Pbl53ADokumenteretForhåndsaftale::bindende_fra_dato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::forhåndsaftale::Pbl53ADokumenteretForhåndsaftale::bindende_fra_dato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::forhåndsaftale::Pbl53ADokumenteretForhåndsaftale::bindende_fra_dato::dag), label = "Dato for bindende forhåndsaftale", question = "Fra hvilken dato var forhåndsaftalen endelig og bindende?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::art::Pbl53APræmiebetalingsperiodeForlænget::oprindelig_præmiebetalingsperiodes_slutdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::art::Pbl53APræmiebetalingsperiodeForlænget::oprindelig_præmiebetalingsperiodes_slutdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::art::Pbl53APræmiebetalingsperiodeForlænget::oprindelig_præmiebetalingsperiodes_slutdato::dag), label = "Oprindelig slutdato for præmiebetalingen", question = "Hvornår skulle præmiebetalingen oprindeligt være ophørt?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::art::Pbl53ASelvvalgtOverflytningTilNyUdbyder::modtagende_ordnings_oprettelsesdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::art::Pbl53ASelvvalgtOverflytningTilNyUdbyder::modtagende_ordnings_oprettelsesdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::kontraktændringer::art::Pbl53ASelvvalgtOverflytningTilNyUdbyder::modtagende_ordnings_oprettelsesdato::dag), label = "Oprettelsesdato for modtagende ordning", question = "Hvornår blev ordningen hos den modtagende udbyder oprettet?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::erhvervelser::tidspunkt::dato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::erhvervelser::tidspunkt::dato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::erhvervelser::tidspunkt::dato::dag), label = "Dato for senere erhvervelse", question = "Hvornår overgik ordningen til den nye rettighedshaver?"),
