    label = "Type § 53 A-ordning",
    question = Some("Hvilken type pensions- eller forsikringsordning er der tale om efter § 53 A, stk. 1?"),
    help = None,
    unit = None
)
= personskat_pbl53a_felt_par53b = Beregningsfelt(
