    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::Pbl53ATidligereGodkendtEfterPar15D::godkendt_fra::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::Pbl53ATidligereGodkendtEfterPar15D::godkendt_fra::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::Pbl53ATidligereGodkendtEfterPar15D::godkendt_fra::dag), label = "Start på livsforsikringens § 15 D-godkendelse", question = "Hvornår begyndte livsforsikringens tidligere § 15 D-godkendelse?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::Pbl53ATidligereGodkendtEfterPar15D::godkendt_til::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::Pbl53ATidligereGodkendtEfterPar15D::godkendt_til::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::kapitel1fakta::Pbl53ATidligereGodkendtEfterPar15D::godkendt_til::dag), label = "Slut på livsforsikringens § 15 D-godkendelse", question = "Hvornår udløb livsforsikringens tidligere § 15 D-godkendelse?"),
    PersonskatPbl53ADatofelttekst(år = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::vilkår::aftalt_udløbsdato::år), måned = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::vilkår::aftalt_udløbsdato::måned), dag = refof(PersonskatInput::kapitalindkomst::pbl53a::ordninger::omfangsfakta::produkt::Pbl53ALivsforsikringsprodukt::vilkår::aftalt_udløbsdato::dag), label = "Livsforsikringens aftalte udløbsdato", question = "Hvornår udløber livsforsikringen efter aftalen?"),
