)
| personskat_sømandsfradrag_gave() -> LigningslovGaveFakta(
    identifikation = "gave-2026",
    indkomstår = 2026,
    betalt_beløb_kroner = 1000,
    modtager = LigningslovGavemodtagerFakta(
        identifikation = "gavemodtager-2026",
        hjemsted = LlGaveDanmark,
        formål = LlGaveAlmennyttigtTilStørreKreds,
        godkendelse = LlGaveGodkendtEfterPar8A(godkendelsesår = 2026),
        likvidationsprovenu_til_anden_velgørende_forening = Sandt
