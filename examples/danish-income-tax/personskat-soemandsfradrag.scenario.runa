            arbejdstilknytning = Søbl4Sømandsbeskæftigelsesperiode(beskæftigelsesidentifikation = "kanonisk-fragtskib")
        ),
        personskat_sømandsfradrag_kildetilknytning(
            kilde = Søbl4Ligningslov9BErhvervsbefordring(kildeidentifikation = "godtgørelse-2026"),
            arbejdstilknytning = Søbl4Sømandsbeskæftigelsesperiode(beskæftigelsesidentifikation = "kanonisk-fragtskib")
        ),
        personskat_sømandsfradrag_kildetilknytning(
