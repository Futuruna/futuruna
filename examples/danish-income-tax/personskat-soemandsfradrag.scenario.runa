    arbejdsgiverbetalt_befordring = UdenArbejdsgiverbetaltBefordring,
    broer = ll9c_ingen_bropassager(),
    særlig_transport = ll9c_ingen_særlig_transport()
)
| personskat_sømandsfradrag_kontingent() -> Ligningslov13KontingentFakta(
    identifikation = "fagforening-2026",
    indkomstår = 2026,
    foreningsart = Ll13Fagforening,
    betalt_kontingent_kroner = 8000,
    foreningens_opgjorte_andel_til_faglige_økonomiske_interesser_kroner = 8000,
