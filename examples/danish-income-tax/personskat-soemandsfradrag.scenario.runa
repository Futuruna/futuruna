    indberettet_efter_skatteindberetningslov26 = Sandt,
    art = Ll8AAlmindeligGave(fradraget_efter_par8s = Falskt)
)
| personskat_sømandsfradrag_kildetilknytning(kilde: Sømandsbeskatningslov4Fradragskilde, arbejdstilknytning: Sømandsbeskatningslov4Arbejdstilknytning) -> Sømandsbeskatningslov4Kildetilknytning(kilde = kilde, arbejdstilknytning = arbejdstilknytning)
| personskat_sømandsfradrag_fælles_ligningsfradrag(sømandsfradrag: Sømandsbeskatningslov3Årsinput, sømandsbeskatningslov4: Sømandsbeskatningslov4Årsinput) -> PersonskatLigningsfradragInput(
    sømandsfradrag = sømandsfradrag,
    sømandsbeskatningslov4 = sømandsbeskatningslov4,
    øvrige_lønmodtagerudgifter = ligningslov9_stk1_intet_årsinput(),
    befordring = MedBefordringsfradrag(fakta = personskat_sømandsfradrag_befordringsfakta()),
    rejser = ligningslov9a_intet_årsinput(),
    faglige_kontingenter = Ligningslov13Årsinput(
        skatteyderstatus = Ll13Lønmodtager,
        kontingenter = [personskat_sømandsfradrag_kontingent()]
    ),
    arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(
        skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark,
        bidrag = [
            personskat_sømandsfradrag_pbl_bidrag(
                identifikation = "a-kasse-2026",
                beløb_kroner = 5988,
                art = Pbl49Akassekontingent(
                    arbejdsløshedskasse = Pbl49DanskAnerkendtArbejdsløshedskasse,
                    skatteyderen_er_medlem_og_forsikret = Sandt
                )
            ),
            personskat_sømandsfradrag_pbl_bidrag(
                identifikation = "efterløn-2026",
                beløb_kroner = 3600,
                art = Pbl49AEfterlønsbidrag(
                    arbejdsløshedskasse = Pbl49DanskAnerkendtArbejdsløshedskasse,
                    medlem_af_arbejdsløshedskasse = Sandt,
                    bidrag_efter_arbejdsløshedsforsikringslov77_stk4 = Sandt
                )
            ),
            personskat_sømandsfradrag_pbl_bidrag(
                identifikation = "fleksydelse-2026",
                beløb_kroner = 1800,
                art = Pbl49BFleksydelsesbidrag(
                    tilmeldt_fleksydelsesordningen_efter_fleksydelseslov4 = Sandt,
                    bidrag_efter_fleksydelseslov7 = Sandt
                )
            ),
        ]
    ),
    gaver = LigningslovGaveÅrsinput(gaver = [personskat_sømandsfradrag_gave()])
)
| personskat_sømandsfradrag_ligningsfradrag() -> personskat_sømandsfradrag_fælles_ligningsfradrag(
    sømandsfradrag = Sømandsbeskatningslov3Årsinput(
