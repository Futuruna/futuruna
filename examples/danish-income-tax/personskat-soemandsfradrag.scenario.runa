)
| personskat_sømandsfradrag_pbl_bidrag(identifikation: Tekst, beløb_kroner: Heltal, art: Pbl49Til49BBidragsart) -> Pbl49Til49BBidragsfakta(
    identifikation = identifikation,
    indkomstår = 2026,
    betalt_beløb_kroner = beløb_kroner,
