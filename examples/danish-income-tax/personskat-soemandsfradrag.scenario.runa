        art = Ll9BMellemArbejdspladser,
        kilometer_i_sagen = kilometer,
        tres_dages_forhold = personskat_sømandsfradrag_tres_dages_forhold()
    ),
    udgifter = Ligningslov9BUdgifter(
        har_afholdt_befordringsudgifter = Sandt,
        dokumenterede_faktiske_kørselsudgifter_eksklusive_bro_tunnel_kroner = 4000,
        dokumenterede_bro_tunnel_udgifter_kroner = 0
    ),
    kundeopsøgende_aktivitet = kundeopsøgende,
    antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang = antal_arbejdsgivere,
    godtgørelsesforhold = personskat_sømandsfradrag_godtgørelsesforhold(
        udbetalt_godtgørelse_kroner = udbetalt_godtgørelse_kroner
    )
)
| personskat_sømandsfradrag_erhvervsbefordring(identifikation: Tekst, rækkefølge: Heltal, arbejdsgiver: Tekst, udbetalt_godtgørelse_kroner: Heltal, kundeopsøgende: Boolsk, antal_arbejdsgivere: Heltal) -> personskat_sømandsfradrag_erhvervsbefordring_med_kilometer(identifikation = identifikation, rækkefølge = rækkefølge, arbejdsgiver = arbejdsgiver, kilometer = 1000, udbetalt_godtgørelse_kroner = udbetalt_godtgørelse_kroner, kundeopsøgende = kundeopsøgende, antal_arbejdsgivere = antal_arbejdsgivere)
| personskat_sømandsfradrag_befordringsfakta() -> PersonskatBefordringsfradragFakta(
