@ sprog da

@ importer ./metadata
@ importer ./personskat.calculate

= personskat_sømandsfradrag_scenarier_metadata = Metadata(
    attachments = (
        Source(value = sømandsbeskatningsloven_lbk1181_par3_til4),
        DependencySource(value = sømandsbeskatningsbekendtgørelsen_bek940_par3),
        Guidance(value = juridisk_vejledning_sømandsfradrag_2026_1),
        Guidance(value = skat_sømandsfradrag_vejledning),
        Practice(value = landsskatteretten_skm2025_442_lsr),
    )
)

--@label:personskat_sømandsfradrag_scenarier::meta:personskat_sømandsfradrag_scenarier_metadata--
----
Scenarierne er ikke lovtekst. De fastholder sømandsbeskatningslovens §§ 3-4
fra de typede beskæftigelsesfakta til den kanoniske Personskat-beregning.
----

| personskat_sømandsfradrag_beskæftigelse(identifikation: Tekst, bruttotonnage: Heltal, anvendelse: Sømandsbeskatningslov3Skibsanvendelse, sødage_hundrededele: Heltal) -> Sømandsbeskatningslov3Beskæftigelsesfakta(
    identifikation = identifikation,
    indkomstår = 2026,
    arbejdssted = ArbejdePåSkib(
        bruttotonnage = bruttotonnage,
        anvendelse = anvendelse
    ),
    fart = UdenForBegrænsetFart,
    hjemsted = RegistreretMedHjemstedIDanmark,
    flag = FlagFraEUEØSStat,
    forhyringsvilkår = SædvanligeForhyringsvilkårForSøfolk,
    fuldtidsomregnede_sødage_hundrededele = sødage_hundrededele
)
| personskat_sømandsfradrag_årsresultat(valg: Sømandsbeskatningslov3Fradragsvalg, beskæftigelser: List(Sømandsbeskatningslov3Beskæftigelsesfakta)) -> sømandsbeskatningslov3_årsresultat(
    indkomstår = 2026,
    input = Sømandsbeskatningslov3Årsinput(
        valg = valg,
        beskæftigelser = beskæftigelser
    )
)

= personskat_sømandsfradrag_helår_almindeligt_resultat = personskat_sømandsfradrag_årsresultat(
    valg = AnvendSømandsfradrag,
    beskæftigelser = [personskat_sømandsfradrag_beskæftigelse(
        identifikation = "fragtskib-under-500",
        bruttotonnage = 499,
        anvendelse = ErhvervsmæssigBefordringAfGods,
        sødage_hundrededele = 36500
    )]
)
= personskat_sømandsfradrag_helår_forhøjet_resultat = personskat_sømandsfradrag_årsresultat(
    valg = AnvendSømandsfradrag,
    beskæftigelser = [personskat_sømandsfradrag_beskæftigelse(
        identifikation = "fragtskib-over-500",
        bruttotonnage = 500,
        anvendelse = ErhvervsmæssigBefordringAfGods,
        sødage_hundrededele = 36500
    )]
)
= personskat_sømandsfradrag_halvår_forhøjet_resultat = personskat_sømandsfradrag_årsresultat(
    valg = AnvendSømandsfradrag,
    beskæftigelser = [personskat_sømandsfradrag_beskæftigelse(
        identifikation = "fragtskib-halvår",
        bruttotonnage = 500,
        anvendelse = ErhvervsmæssigBefordringAfGods,
        sødage_hundrededele = 18250
    )]
)
= personskat_sømandsfradrag_forkert_statsborgerskab_resultat = personskat_sømandsfradrag_årsresultat(
    valg = AnvendSømandsfradrag,
    beskæftigelser = [personskat_sømandsfradrag_beskæftigelse(
        identifikation = "passagerskib-tredjelandsstatsborger",
        bruttotonnage = 700,
        anvendelse = ErhvervsmæssigBefordringAfPassagerer(
            rute = RegelmæssigPassagersejladsMellemEUEØSHavne(
                skattepligt = SkattepligtigEfterKildeskattelov1,
                statsborgerskab = AndetStatsborgerskab
            )
        ),
        sødage_hundrededele = 36500
    )]
)
= personskat_sømandsfradrag_fravalgt_resultat = personskat_sømandsfradrag_årsresultat(
    valg = FravælgSømandsfradrag,
    beskæftigelser = [personskat_sømandsfradrag_beskæftigelse(
        identifikation = "fragtskib-fravalg",
        bruttotonnage = 500,
        anvendelse = ErhvervsmæssigBefordringAfGods,
        sødage_hundrededele = 36500
    )]
)

| personskat_sømandsfradrag_tres_dages_forhold() -> Ligningslov9B60DagesForhold(
    arbejdsdage_til_samme_arbejdsplads_inklusive_aktuel_dag_i_forudgående_12_måneder = 0,
    sammenhængende_arbejdsdage_siden_sidst_på_arbejdspladsen = 0,
    mange_forskellige_arbejdspladser = Falskt,
    ikke_sandsynligt_over_60_dage = Falskt,
    skriftligt_kørselsregnskabspålæg_aktivt = Falskt,
    kørselsregnskab_dokumenterer_erhvervsmæssig_befordring = Falskt
)
| personskat_sømandsfradrag_godtgørelsesforhold(udbetalt_godtgørelse_kroner: Heltal) -> Ligningslov9BGodtgørelsesforhold(
