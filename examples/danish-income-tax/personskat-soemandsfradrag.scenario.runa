| personskat_sømandsfradrag_blandet_ligningsfradrag_uden_fagforeningstilknytning() -> {
    = fuldt_input = personskat_sømandsfradrag_blandet_ligningsfradrag()
    = kildetilknytninger = filter(
        fuldt_input.sømandsbeskatningslov4.kildetilknytninger,
        |tilknytning: Sømandsbeskatningslov4Kildetilknytning| tilknytning.kilde != Søbl4Ligningslov13Årsfradrag
    )
    PersonskatLigningsfradragInput(
        sømandsfradrag = fuldt_input.sømandsfradrag,
        sømandsbeskatningslov4 = Sømandsbeskatningslov4Årsinput(kildetilknytninger = kildetilknytninger),
        øvrige_lønmodtagerudgifter = fuldt_input.øvrige_lønmodtagerudgifter,
        befordring = fuldt_input.befordring,
        rejser = fuldt_input.rejser,
        faglige_kontingenter = fuldt_input.faglige_kontingenter,
        arbejdsløshed_efterløn_og_fleksydelse = fuldt_input.arbejdsløshed_efterløn_og_fleksydelse,
        gaver = fuldt_input.gaver
    )
}
