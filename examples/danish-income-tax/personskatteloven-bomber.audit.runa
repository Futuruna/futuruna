@ sprog da

@ importer ./loenmodtager_beregning

-- Personskatteloven -- executable "bomb" audit probes.
--
-- This file is deliberately an audit file, not a scenario fixture. It records
-- surprising interactions that follow from the currently encoded legal model.

----
Audit probe sources:

Personskatteloven § 14 helårsomregning:
Retsinformation, LBK nr. 1284 af 14/06/2021.
https://www.retsinformation.dk/eli/lta/2021/1284

Personskatteloven § 8 a aktieindkomst:
Retsinformation, LBK nr. 1284 af 14/06/2021.
https://www.retsinformation.dk/eli/lta/2021/1284

Personskatteloven § 8 b CFC-indkomst, § 9 personfradrag, § 13
virksomhedsunderskud, and § 19 skatteloft:
Retsinformation, LBK nr. 1284 af 14/06/2021.
https://www.retsinformation.dk/eli/lta/2021/1284

Selskabsskatteloven § 17, stk. 1 corporate tax rate:
Retsinformation, LBK nr. 279 af 13/03/2025.
https://www.retsinformation.dk/eli/lta/2025/279

Personskatteloven § 19 skatteloft, as changed for 2026 by:
LOV nr. 482 af 22/05/2024.
https://www.retsinformation.dk/eli/lta/2024/482

Tax-year and municipal rates:
Skattestyrelsen, "Se alle skattesatser for i år og de forudgående år".
https://skat.dk/hjaelp/satser

Skatteministeriet, "Oversigt over kommuneskatter" and
"Kommuneskattesatser 2026".
https://skm.dk/tal-og-metode/satser/oversigt-over-kommuneskatter

Purpose:
These probes are not accusations that the law is invalid. They flag places
where different legal mechanisms compose in a way that is easy to miss in prose:
partial-year annualisation, municipal-rate feedback into state-tax relief, and
spouse-sensitive capital and share-income thresholds, mandatory negative
share-income offsetting, dividend-tax over-withholding, CFC tax outside
personfradrag/skatteloft, passive business-loss lock-in, and the narrow 2026
skatteloft basis.
----

# PersonskatBombSignal = Par14HelårsomregningØgerStatsligDelårsskat | KommunalSatsSænkerStatsligSkatViaSkatteloft | PositivKapitalLoftAktiveresUdenPersonligtLoft | SkatteloftDækkerIkkeHele2026Progression | ÆgtefælleNegativKapitalReducererBundskat | MellemskatNegativÆgtefællekapitalFjernerKapitalskat | AktieÆgtefællegrundbeløbFjernerHøjSkat | NegativAktieÆgtefællemodregningÆndrerFamilienetto | AktieUdbytteskatStk3EfterladerHøjSkatRest | CfcSkatUdenPersonfradragOgSkatteloft | PassivtVirksomhedsunderskudLåses

| personskat_bomb_signal(signal: PersonskatBombSignal) -> Sandt

= bomb_par14_input = LønmodtagerPar14Input(
    skattepligtsændring = FuldSkattepligtIndtræder,
    delårs_input = LønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 300000,
        nettokapitalindkomst_kroner = 0,
        ligningsmæssige_fradrag_kroner = 0,
        pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    skattepligtsdage = 180
)
= bomb_par14_resultat = beregn_lønmodtager_par14(bomb_par14_input)
= bomb_par14_normal_statslig_delårsskat_kroner = bomb_par14_resultat.delår.statslig_indkomstskat_efter_personfradrag_kroner
= bomb_par14_annualiseret_statslig_delårsskat_kroner = bomb_par14_resultat.delårsskat_efter_par6_til_par9_kroner
= bomb_par14_annualiseringsdelta_kroner = bomb_par14_annualiseret_statslig_delårsskat_kroner - bomb_par14_normal_statslig_delårsskat_kroner

= bomb_københavn_900k = beregn_lønmodtager(LønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 900000,
    nettokapitalindkomst_kroner = 0,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
))
= bomb_langeland_900k = beregn_lønmodtager(LønmodtagerInput(
    skatteår = 2026,
    kommune = Langeland,
    bruttoløn_kroner = 900000,
    nettokapitalindkomst_kroner = 0,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
))
= bomb_langeland_statslig_skattenedsættelse_mod_københavn_kroner = bomb_københavn_900k.statslig_indkomstskat_efter_personfradrag_kroner - bomb_langeland_900k.statslig_indkomstskat_efter_personfradrag_kroner
= bomb_langeland_kommunal_merbelastning_mod_københavn_kroner = bomb_langeland_900k.kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner - bomb_københavn_900k.kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner
= bomb_langeland_samlet_merbelastning_mod_københavn_kroner = bomb_langeland_900k.samlet_inkl_am_efter_personfradrag_kroner - bomb_københavn_900k.samlet_inkl_am_efter_personfradrag_kroner

= bomb_københavn_kapital = beregn_lønmodtager(LønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 650000,
    nettokapitalindkomst_kroner = 110000,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
))
= bomb_par6_ægtefællekapital_input = Par6ÆgtefælleKapitalModregningInput(
    gift = Sandt,
    samlevende_ved_årets_udløb = Sandt,
    positiv_nettokapitalindkomst_kroner = 10000,
    ægtefælle_negativ_nettokapitalindkomst_kroner = -3000
)
= bomb_par6_ægtefællekapital_resultat = par6_ægtefællekapital_modregning_resultat(bomb_par6_ægtefællekapital_input)
= bomb_par6_bundskat_grundlag_uden_ægtefællemodregning_kroner = bundskat_grundlag(BundskatInput(
    personlig_indkomst = 500000,
    positiv_nettokapitalindkomst = 10000
))
= bomb_par6_bundskat_grundlag_med_ægtefællemodregning_kroner = bundskat_grundlag_efter_ægtefællekapitalmodregning(500000, bomb_par6_ægtefællekapital_input)
= bomb_par6_bundskat_uden_ægtefællemodregning_kroner = penge_beløb_gange_basispoint_kroner(bomb_par6_bundskat_grundlag_uden_ægtefællemodregning_kroner, nationalparametre_for(2026).bundskat_basispoint)
= bomb_par6_bundskat_med_ægtefællemodregning_kroner = penge_beløb_gange_basispoint_kroner(bomb_par6_bundskat_grundlag_med_ægtefællemodregning_kroner, nationalparametre_for(2026).bundskat_basispoint)
= bomb_par6_ægtefællekapital_bundskat_delta_kroner = bomb_par6_bundskat_uden_ægtefællemodregning_kroner - bomb_par6_bundskat_med_ægtefællemodregning_kroner
= bomb_par7_stk5_negativ_ægtefællekapital_input = Par7ÆgtefælleKapitalStk5Input(
    nettokapitalindkomst_kroner = -20000,
    ægtefælle_positiv_nettokapitalindkomst_kroner = 140000,
    grundbeløb_kroner = nationalparametre_for(2026).positiv_nettokapital_progressiv_bundfradrag_kroner,
    samlevende_ved_årets_udløb = Sandt
)
= bomb_par7_stk5_negativ_ægtefællekapital = par7_ægtefællekapital_stk5_resultat(bomb_par7_stk5_negativ_ægtefællekapital_input)
= bomb_par7_stk5_mellemskat_med_ægtefælleregel_kroner = par7_ægtefællekapital_stk5_skat_kroner(bomb_par7_stk5_negativ_ægtefællekapital_input, nationalparametre_for(2026).mellemskat_basispoint)
= bomb_par7_mellemskat_uden_ægtefælleregel_kroner = mellemskat_med_kapital_kroner(MellemskatKapitalInput(
    personlig_indkomst_efter_am_kroner = nationalparametre_for(2026).mellemskattegrænse_efter_am_kroner,
    positiv_nettokapitalindkomst_kroner = 140000,
    kapital_bundfradrag_kroner = nationalparametre_for(2026).positiv_nettokapital_progressiv_bundfradrag_kroner,
    mellemskattegrænse_efter_am_kroner = nationalparametre_for(2026).mellemskattegrænse_efter_am_kroner,
    sats_basispoint = nationalparametre_for(2026).mellemskat_basispoint
))
= bomb_par7_stk5_negativ_ægtefællekapital_skattebesparelse_kroner = bomb_par7_mellemskat_uden_ægtefælleregel_kroner - bomb_par7_stk5_mellemskat_med_ægtefælleregel_kroner

| bomb_2026_fuld_progressiv_kommunal_stack_basispoint(kommune: Kommune) -> nationalparametre_for(2026).bundskat_basispoint + nationalparametre_for(2026).mellemskat_basispoint + nationalparametre_for(2026).topskat_basispoint + nationalparametre_for(2026).toptopskat_basispoint + kommunale_parametre_for(2026, kommune).kommuneskat_basispoint

= bomb_københavn_2026_fuld_progressiv_stack_basispoint = bomb_2026_fuld_progressiv_kommunal_stack_basispoint(København)
= bomb_københavn_2026_personligt_skatteloft_basispoint = par19_personlig_skatteloft_basispoint(2026)
= bomb_københavn_2026_stack_over_personligt_skatteloft_basispoint = bomb_københavn_2026_fuld_progressiv_stack_basispoint - bomb_københavn_2026_personligt_skatteloft_basispoint

= bomb_aktie_2026_grundbeløb = aktieindkomst_grundbeløb_for(2026)
= bomb_aktie_150k_enlig = aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(
    skatteår = 2026,
    aktieindkomst_kroner = 150000,
    effektivt_grundbeløb_kroner = bomb_aktie_2026_grundbeløb
))
= bomb_aktie_150k_ægtefællegrundbeløb = aktieindkomst_effektivt_grundbeløb_for_person(AktieindkomstÆgtefælleGrundbeløbInput(
    skatteår = 2026,
    aktieindkomst_kroner = 150000,
    ægtefælle_aktieindkomst_kroner = 0,
    samlevende_ved_årets_udløb = Sandt
))
= bomb_aktie_150k_med_ægtefællegrundbeløb = aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(
    skatteår = 2026,
    aktieindkomst_kroner = 150000,
    effektivt_grundbeløb_kroner = bomb_aktie_150k_ægtefællegrundbeløb
))
= bomb_aktie_ægtefællegrundbeløb_skattebesparelse_kroner = bomb_aktie_150k_enlig.samlet_skat_kroner - bomb_aktie_150k_med_ægtefællegrundbeløb.samlet_skat_kroner

= bomb_negativ_aktie_dobbelt_grundbeløb = bomb_aktie_2026_grundbeløb * 2
= bomb_negativ_aktie_uden_modregning_negativ_skat_kroner = aktieindkomst_negativ_skat_kroner(AktieindkomstNegativSkatInput(
    skatteår = 2026,
    negativ_aktieindkomst_abs_kroner = 180000,
    effektivt_grundbeløb_kroner = bomb_negativ_aktie_dobbelt_grundbeløb
))
= bomb_negativ_aktie_med_ægtefællemodregning = aktieindkomst_ægtefælle_negativ_resultat(AktieindkomstÆgtefælleNegativInput(
    skatteår = 2026,
    negativ_aktieindkomst_kroner = -180000,
    ægtefælle_positiv_aktieindkomst_kroner = 50000,
    samlevende_ved_årets_udløb = Sandt
))
= bomb_negativ_aktie_ægtefælle_positiv_50k_skat = aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(
    skatteår = 2026,
    aktieindkomst_kroner = 50000,
    effektivt_grundbeløb_kroner = bomb_aktie_2026_grundbeløb
))
= bomb_negativ_aktie_familienetto_uden_modregning_kroner = bomb_negativ_aktie_ægtefælle_positiv_50k_skat.samlet_skat_kroner - bomb_negativ_aktie_uden_modregning_negativ_skat_kroner
= bomb_negativ_aktie_familienetto_med_modregning_kroner = 0 - bomb_negativ_aktie_med_ægtefællemodregning.negativ_skat_kroner
= bomb_negativ_aktie_modregning_familienetto_delta_kroner = bomb_negativ_aktie_familienetto_med_modregning_kroner - bomb_negativ_aktie_familienetto_uden_modregning_kroner

= bomb_aktie_stk3_100k_skat = aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(
    skatteår = 2026,
    aktieindkomst_kroner = 100000,
    effektivt_grundbeløb_kroner = bomb_aktie_2026_grundbeløb
