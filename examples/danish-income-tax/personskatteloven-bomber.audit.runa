@ sprog da

@ importer ./loenmodtager_beregning

-- Personskatteloven -- executable "bomb" audit probes.
--
-- This file is deliberately an audit file, not a scenario fixture. It records
-- surprising interactions that follow from the currently encoded legal model.

----
Audit probe sources:

Personskatteloven § 14 helårsomregning:
Retsinformation, LBK nr. 1284 af 14/06/2021.
https://www.retsinformation.dk/eli/lta/2021/1284

Personskatteloven § 19 skatteloft, as changed for 2026 by:
LOV nr. 482 af 22/05/2024.
https://www.retsinformation.dk/eli/lta/2024/482

Tax-year and municipal rates:
Skattestyrelsen, "Se alle skattesatser for i år og de forudgående år".
https://skat.dk/hjaelp/satser

Skatteministeriet, "Oversigt over kommuneskatter" and
"Kommuneskattesatser 2026".
https://skm.dk/tal-og-metode/satser/oversigt-over-kommuneskatter

Purpose:
These probes are not accusations that the law is invalid. They flag places
where different legal mechanisms compose in a way that is easy to miss in prose:
partial-year annualisation, municipal-rate feedback into state-tax relief, and
the narrow 2026 skatteloft basis.
----

# PersonskatBombSignal = Par14HelårsomregningØgerStatsligDelårsskat | KommunalSatsSænkerStatsligSkatViaSkatteloft | PositivKapitalLoftAktiveresUdenPersonligtLoft | SkatteloftDækkerIkkeHele2026Progression

| personskat_bomb_signal(signal: PersonskatBombSignal) -> Sandt

= bomb_par14_input = LønmodtagerPar14Input(FuldSkattepligtIndtræder, LønmodtagerInput(2026, København, 300000, 0, 0, Fyldt18EllerGift, Falskt), 180)
= bomb_par14_resultat = beregn_lønmodtager_par14(bomb_par14_input)
= bomb_par14_normal_statslig_delårsskat_kroner = bomb_par14_resultat.delår.statslig_indkomstskat_efter_personfradrag_kroner
= bomb_par14_annualiseret_statslig_delårsskat_kroner = bomb_par14_resultat.delårsskat_efter_par6_til_par9_kroner
= bomb_par14_annualiseringsdelta_kroner = bomb_par14_annualiseret_statslig_delårsskat_kroner - bomb_par14_normal_statslig_delårsskat_kroner

= bomb_københavn_900k = beregn_lønmodtager(LønmodtagerInput(2026, København, 900000, 0, 0, Fyldt18EllerGift, Falskt))
= bomb_langeland_900k = beregn_lønmodtager(LønmodtagerInput(2026, Langeland, 900000, 0, 0, Fyldt18EllerGift, Falskt))
= bomb_langeland_statslig_skattenedsættelse_mod_københavn_kroner = bomb_københavn_900k.statslig_indkomstskat_efter_personfradrag_kroner - bomb_langeland_900k.statslig_indkomstskat_efter_personfradrag_kroner
= bomb_langeland_kommunal_merbelastning_mod_københavn_kroner = bomb_langeland_900k.kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner - bomb_københavn_900k.kommunal_og_kirkelig_indkomstskat_efter_personfradrag_kroner
= bomb_langeland_samlet_merbelastning_mod_københavn_kroner = bomb_langeland_900k.samlet_inkl_am_efter_personfradrag_kroner - bomb_københavn_900k.samlet_inkl_am_efter_personfradrag_kroner

= bomb_københavn_kapital = beregn_lønmodtager(LønmodtagerInput(2026, København, 650000, 110000, 0, Fyldt18EllerGift, Falskt))

| bomb_2026_fuld_progressiv_kommunal_stack_basispoint(kommune: Kommune) -> nationalparametre_for(2026).bundskat_basispoint + nationalparametre_for(2026).mellemskat_basispoint + nationalparametre_for(2026).topskat_basispoint + nationalparametre_for(2026).toptopskat_basispoint + kommunale_parametre_for(2026, kommune).kommuneskat_basispoint

= bomb_københavn_2026_fuld_progressiv_stack_basispoint = bomb_2026_fuld_progressiv_kommunal_stack_basispoint(København)
= bomb_københavn_2026_personligt_skatteloft_basispoint = par19_personlig_skatteloft_basispoint(2026)
= bomb_københavn_2026_stack_over_personligt_skatteloft_basispoint = bomb_københavn_2026_fuld_progressiv_stack_basispoint - bomb_københavn_2026_personligt_skatteloft_basispoint

| bomb_par14_helårsomregning_øger_statslig_delårsskat: bomb_par14_annualiseringsdelta_kroner -> bomb_par14_annualiseringsdelta_kroner == 3293 && bomb_par14_annualiseret_statslig_delårsskat_kroner > bomb_par14_normal_statslig_delårsskat_kroner
| bomb_par14_signal: personskat_bomb_signal(Par14HelårsomregningØgerStatsligDelårsskat) -> personskat_bomb_signal(Par14HelårsomregningØgerStatsligDelårsskat) == Sandt

| bomb_høj_kommunal_sats_sænker_statslig_skat: bomb_langeland_900k -> bomb_langeland_900k.personligt_skatteloft.nedslag_kroner == 2316 && bomb_langeland_statslig_skattenedsættelse_mod_københavn_kroner == 2316 && bomb_langeland_kommunal_merbelastning_mod_københavn_kroner == 20587 && bomb_langeland_samlet_merbelastning_mod_københavn_kroner == 18271
| bomb_høj_kommunal_sats_signal: personskat_bomb_signal(KommunalSatsSænkerStatsligSkatViaSkatteloft) -> personskat_bomb_signal(KommunalSatsSænkerStatsligSkatViaSkatteloft) == Sandt

| bomb_positiv_kapital_loft_uden_personligt_loft: bomb_københavn_kapital -> bomb_københavn_kapital.personligt_skatteloft.nedslag_kroner == 0 && bomb_københavn_kapital.positiv_kapital_skatteloft.overskydende_basispoint == 90 && bomb_københavn_kapital.positiv_kapital_skatteloft.nedslag_kroner == 106
| bomb_positiv_kapital_signal: personskat_bomb_signal(PositivKapitalLoftAktiveresUdenPersonligtLoft) -> personskat_bomb_signal(PositivKapitalLoftAktiveresUdenPersonligtLoft) == Sandt

| bomb_2026_skatteloft_dækker_ikke_hele_progressionen: bomb_københavn_2026_stack_over_personligt_skatteloft_basispoint -> bomb_københavn_2026_fuld_progressiv_stack_basispoint == 5540 && bomb_københavn_2026_stack_over_personligt_skatteloft_basispoint == 1083 && par19_loftrelevant_progressiv_statsskat_basispoint(2026) == nationalparametre_for(2026).mellemskat_basispoint
| bomb_2026_skatteloft_signal: personskat_bomb_signal(SkatteloftDækkerIkkeHele2026Progression) -> personskat_bomb_signal(SkatteloftDækkerIkkeHele2026Progression) == Sandt

| personskat_bomb_audit_samlet() -> bomb_par14_annualiseringsdelta_kroner == 3293 && bomb_langeland_statslig_skattenedsættelse_mod_københavn_kroner == 2316 && bomb_københavn_kapital.positiv_kapital_skatteloft.nedslag_kroner == 106 && bomb_københavn_2026_stack_over_personligt_skatteloft_basispoint == 1083

? bomb_par14_helårsomregning_øger_statslig_delårsskat
? bomb_par14_signal
? bomb_høj_kommunal_sats_sænker_statslig_skat
? bomb_høj_kommunal_sats_signal
? bomb_positiv_kapital_loft_uden_personligt_loft
? bomb_positiv_kapital_signal
? bomb_2026_skatteloft_dækker_ikke_hele_progressionen
? bomb_2026_skatteloft_signal

@ print("bomb audit §14 annualiseringsdelta stats skat: " + vis(bomb_par14_annualiseringsdelta_kroner))
@ print("bomb audit Langeland stats-skattenedsættelse via §19: " + vis(bomb_langeland_statslig_skattenedsættelse_mod_københavn_kroner))
@ print("bomb audit København positiv kapital §19-nedslag uden personligt nedslag: " + vis(bomb_københavn_kapital.positiv_kapital_skatteloft.nedslag_kroner))
@ print("bomb audit 2026 fuld progressiv stack over personligt skatteloft: " + vis(bomb_københavn_2026_stack_over_personligt_skatteloft_basispoint))
