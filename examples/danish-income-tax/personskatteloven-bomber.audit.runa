    aktieindkomst_kroner = 100000,
    indeholdt_udbytteskat_kroner = 35000
))
= bomb_aktie_stk3_høj_skat_rest_efter_modregning_kroner = bomb_aktie_stk3_100k_skat.slutskat_indgående_skat_kroner - bomb_aktie_stk3_overindeholdt.overskydende_udbytteskat_til_slutskat_kroner

= bomb_cfc_500k = cfc_skat_resultat(CfcSkatInput(
    skatteår = 2026,
    cfc_indkomst_kroner = 500000
))

= bomb_passivt_virksomhedsunderskud_låst = par13_virksomhedsunderskud_beløbsresultat(Par13VirksomhedsUnderskudInput(
    underskud_kroner = 100000,
    positiv_indkomst_samme_virksomhed_kroner = 30000,
    status = PassivVirksomhedPar4Nr9Eller11
))
= bomb_aktivt_virksomhedsunderskud_frigivet = par13_virksomhedsunderskud_beløbsresultat(Par13VirksomhedsUnderskudInput(
    underskud_kroner = 100000,
    positiv_indkomst_samme_virksomhed_kroner = 30000,
    status = TransparentSelskabDeltagetVæsentligt36Måneder
))
= bomb_virksomhedsunderskud_aktivitetsdelta_kroner = bomb_aktivt_virksomhedsunderskud_frigivet.fradrag_i_øvrig_indkomst_kroner - bomb_passivt_virksomhedsunderskud_låst.fradrag_i_øvrig_indkomst_kroner

