@ sprog da

@ importer ./metadata
@ importer ./personskat-personlig-indkomst-kildefakta

= personskat_par3_nr2_ll30a_felt_person = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::ligningslovsfradrag_efter_par3_stk2_nr2::kilde::PsPar3Nr2Ll30A::input::person),
    label = "§ 30 A - personens rolle",
    question = Some("Vedrører udgiften den selvstændige, en medarbejdende ægtefælle eller en anden person?"),
    help = None,
    unit = None
)
= personskat_par3_nr2_ll30a_felt_ægtefælleoverskud = Beregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::ligningslovsfradrag_efter_par3_stk2_nr2::kilde::PsPar3Nr2Ll30A::input::ægtefælle_modtager_overskud_efter_kildeskattelov25a_stk3),
