    label = "§ 30 A - ægtefællen driver ikke virksomheden i overvejende grad",
    question = Some("Er det korrekt, at ægtefællen ikke driver virksomheden i overvejende grad?"),
    help = None,
    unit = None
)

= personskat_par3_nr2_beregningsmeta = Beregningsmeta(
    felter = [
        personskat_par3_nr2_ll30a_felt_person,
        personskat_par3_nr2_ll30a_felt_ægtefælleoverskud,
        personskat_par3_nr2_ll30a_felt_ægtefælle_driver
    ],
    attachments = (
        Source(value = personskatteloven_lbk1284_par3),
        DependencySource(value = ligningsloven_lbk1500_par8),
