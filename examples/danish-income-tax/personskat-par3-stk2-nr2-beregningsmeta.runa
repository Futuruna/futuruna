    question = Some("Modtager ægtefællen en del af virksomhedens overskud efter kildeskattelovens § 25 A, stk. 3?"),
    help = None,
    unit = None
)
= personskat_par3_nr2_ll30a_felt_ægtefælle_driver = Beregningsfelt(
