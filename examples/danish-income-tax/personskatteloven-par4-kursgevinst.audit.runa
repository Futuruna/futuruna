@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Focused audit for Personskatteloven § 4, stk. 1, nr. 2.
-- The original legal texts are copied in kapitel-01-indkomst.runa and
-- kursgevinstloven.runa.

= par4_stk1_nr2_audit_fordring_gevinst_input = KursgevinstlovInput(
