@ sprog da

@ importer ./aktieavancebeskatningsloven - par9

# Par9ScenariePrincipInput(indkomstår: Heltal, opgørelsesdato: AktieavancePar23Dato, skattepligtig: AktieavancePar23Skattepligtig, aktiv: AktieavancePar23Aktiv, stk6_valg: AktieavancePar23Stk6Valg, stk7_valg: AktieavancePar23Stk7Valg)
# Par9ScenarieLagerpostInput(aktivstatus: AktieavancePar9Aktivstatus, princip_resultat: AktieavancePar23PrincipResultat, værdi_primo_kroner: Heltal, værdi_ultimo_kroner: Heltal)
# Par9ScenarieRealisationspostInput(aktivstatus: AktieavancePar9Aktivstatus, princip_resultat: AktieavancePar23PrincipResultat, afståelsessum_kroner: Heltal, anskaffelsessum_kroner: Heltal)

= par9_intet_stk7_valg = AktieavancePar23Stk7Valg(
    selskabsidentifikation = "",
    første_optagelsesdato = AktieavancePar23Dato(år = 0, måned = 0, dag = 0),
    ejer_dage_før_første_optagelse = 0,
    valgmåde = AblIntetPar23Stk7Valg
)

| par9_scenarie_princip_resultat(input: Par9ScenariePrincipInput) -> aktieavance_par23_princip_resultat(AktieavancePar23PrincipInput(
    indkomstår = input.indkomstår,
    opgørelsesdato = input.opgørelsesdato,
    skattepligtig = input.skattepligtig,
    aktiv = input.aktiv,
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = input.stk6_valg,
    stk7_valg = input.stk7_valg,
    obligationsgevinst_opgøres_efter_lagerprincippet = Falskt,
    indkomstår_forskelligt_fra_kalenderår = Falskt
))
| par9_scenarie_par5a_resultat_uden_reduktion(bruttotab_ved_afståelse_kroner: Heltal) -> aktieavance_par5a_resultat(AktieavancePar5AInput(
    bruttotab_ved_afståelse_kroner = bruttotab_ved_afståelse_kroner,
    anvendelsesgrundlag = AblPar5AAfståelseDen24November2010EllerSenere,
    skatteydergrundlag = AblPar5AAndenSkattepligtig,
    ejertidsudbytter = [],
    præferenceposition = AktieavancePar5APræferenceposition(
        modtaget_tilsvarende_udbytte_kroner = 0,
        allerede_anvendt_til_tabsreduktion_kroner = 0
    ),
    koncernbeløb = []
))
| par9_scenarie_lagerpost(input: Par9ScenarieLagerpostInput) -> aktieavance_par9_post_resultat(AktieavancePar9PostInput(
    aktivstatus = input.aktivstatus,
    opgørelsesgrundlag = AblPar9Lagerårsopgørelse(resultat = aktieavance_par23_lager_årsresultat(AktieavancePar23LagerÅrsinput(
        princip_resultat = input.princip_resultat,
        værdi_primo_kroner = input.værdi_primo_kroner,
        værdi_ultimo_kroner = input.værdi_ultimo_kroner,
        anskaffelsessummer_i_perioden_kroner = 0,
        afståelsessummer_i_perioden_kroner = 0,
        afståelsessummer_omfattet_af_ll16b_stk1_kroner = 0,
        ville_være_par17_uden_investeringsstatus = Falskt,
        oplysningsbetingelse_efter_par19d_opfyldt = Sandt
    ))),
    par5a_behandling = AblPar5ALagerafståelser(resultater = [])
))
| par9_scenarie_realisationspost(input: Par9ScenarieRealisationspostInput) -> aktieavance_par9_post_resultat(AktieavancePar9PostInput(
    aktivstatus = input.aktivstatus,
    opgørelsesgrundlag = AblPar9RealiseretAfståelse(
        princip_resultat = input.princip_resultat,
        afståelsessum_kroner = input.afståelsessum_kroner,
        anskaffelsessum_kroner = input.anskaffelsessum_kroner
    ),
    par5a_behandling = AblPar5AEnkeltAfståelse(resultat = par9_scenarie_par5a_resultat_uden_reduktion(penge_positivt_beløb(input.anskaffelsessum_kroner - input.afståelsessum_kroner)))
))

= par9_lager_princip_2026 = par9_scenarie_princip_resultat(Par9ScenariePrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtig = AblSkattepligtigEfterPar6,
    aktiv = AblPar9Aktie(
        selskabsidentifikation = "DK-P9-LAGER",
        markedsstatus = AblOptagetTilHandelPåReguleretMarked
    ),
