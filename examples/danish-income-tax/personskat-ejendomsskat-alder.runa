@ sprog da

@ importer ./ejendomsskatteloven
@ importer ./socialpensionsloven - par1a
@ importer ./personskat - beregningskontrol

# PersonskatEjendomsskatAldersforbehold(besked: Tekst)
= personskat_ejendomsskat_aldersforbehold = PersonskatEjendomsskatAldersforbehold(
    besked = "Sammenhængskontrol af årets ejer og aktuelle samlevende ægtefælle samt ejerens eget rabatgrundlag fra 2024, ikke dokumentautentifikation. Fødselsdato og folkepensionsstatus skal stemme efter ESL § 25 og socialpensionslovens § 1 a. Eget 2024-grundlag afstemmes for 2024, ikke beregningsåret. Historiske ægtefæller, overtaget rabatgrundlag og pensionistsuccession har selvstændige personfakta; en tidligere ægtefælle må ikke identificeres med den aktuelle ejer eller ægtefælle. Kontrollen ændrer ikke kildefakta eller nedslagsbeløb."
)
= personskat_ejendomsskat_alder_metadata = Metadata(
    attachments = (
        Source(value = ejendomsskatteloven_lov678_par23_til_27),
        Source(value = ejendomsskatteloven_lov678_par35_til_45),
        DependencySource(value = ejendomsskatteloven_tidligere_ejendomsvaerdiskattelov),
        DependencySource(value = socialpensionsloven_lbk1123_par1a),
        AmendmentSource(value = socialpensionsloven_lov703_par1_nr1),
        AmendmentSource(value = ejendomsskatteloven_evsl_lov2202_par11),
        Guidance(value = ejendomsskatteloven_l113_bemaerkninger_par25),
        Warning(value = personskat_ejendomsskat_aldersforbehold),
    )
)

--@label:personskat_ejendomsskat_alder::meta:personskat_ejendomsskat_alder_metadata--
--@begin:personskat_ejendomsskat_alder--
-- Genbrug § 1 a's daterede regler; hardkod ikke en pensionsalder på 67 år.
-- Årets status afstemmes ved 31/12 som i § 25, ikke ved første udbetaling.
> personskat_ejendomsskat_alder_stemmer(status: EjendomsskattelovFolkepensionsalder, fødselsdato: Dato, indkomstår: Heltal) -> Boolsk {
    = årets_udgang = Dato(år = indkomstår, måned = 12, dag = 31)
    = alder = socialpensionslov1a_resultat(fødselsdato, årets_udgang)
    = opnået = dato_før_eller_lig_med(alder.folkepensionsdato, årets_udgang)
    alder.input_gyldigt && dato_før_eller_lig_med(fødselsdato, årets_udgang) && match status {
        | EjskFolkepensionsalderIkkeOpnået -> opnået == Falskt
        | EjskFolkepensionsalderOpnået(dato) -> opnået && dato.år == alder.folkepensionsdato.år && dato.måned == alder.folkepensionsdato.måned && dato.dag == alder.folkepensionsdato.dag
    }
}

> personskat_ejendomsskat_alder_forklaring(fødselsdato: Dato, indkomstår: Heltal) -> Tekst {
    = årets_udgang = Dato(år = indkomstår, måned = 12, dag = 31)
    = alder = socialpensionslov1a_resultat(fødselsdato, årets_udgang)
    hvis alder.input_gyldigt == Falskt || dato_før_eller_lig_med(fødselsdato, årets_udgang) == Falskt {
        "Ejendomsskattens folkepensionsstatus kan ikke afstemmes uden en gyldig fødselsdato senest i indkomståret. Afklar kildefakta; gæt ikke en dato."
    } ellers {
        = forventet = hvis dato_før_eller_lig_med(alder.folkepensionsdato, årets_udgang) { "EjskFolkepensionsalderOpnået" } ellers { "EjskFolkepensionsalderIkkeOpnået" }
        "ESL § 25, jf. socialpensionslovens § 1 a: årets folkepensionsstatus skal stemme med personens lønmodtager.pension.fødselsdato. Med den oplyste fødselsdato forventes " + forventet + "; afledt folkepensionsdato: " + show(alder.folkepensionsdato) + ". Kontrollér kilden ved uenighed; brug ikke første pensionsudbetaling eller et ønsket nedslag som dato. Se personskat-validity.md#folkepensionsalder-og-ejendomsskat."
    }
}

> personskat_ejendomsskat_alder_relevant(fakta: EjendomsskattelovPersonÅrsfakta, indkomstår: Heltal) -> Boolsk {
    any(fakta.ejendomme, |ejendom: EjendomsskattelovPersonEjendomFakta| ejendomsskattelov_par3_omfattet_af_ejendomsværdiskat(EjendomsskattelovPar3Input(
        indkomstår = indkomstår,
        kategori = ejendom.ordinært_grundlag.kategori,
        beliggenhed = ejendom.ordinært_grundlag.beliggenhed,
        erhvervsmæssigt_udlejet = ejendom.ordinært_grundlag.erhvervsmæssigt_udlejet,
        særlige_betingelser_for_nr6_til_nr8_opfyldt = ejendom.ordinært_grundlag.særlige_betingelser_for_nr6_til_nr8_opfyldt
    )))
}

-- Eget grundlag tilhører ejeren; et overtaget grundlag gør ikke. Partneren i
-- 2024 kan være en anden end i beregningsåret. Ingen sådan identitet udledes.
> personskat_ejendomsskat_eget_ydelsesgrundlag_alder_stemmer(grundlag: EjendomsskattelovRabat2024Fakta, fødselsdato: Dato) -> Boolsk {
    match grundlag.tidligere_ejendomsværdiskat.historisk_begrænsning.par9_ydelsesgrundlag {
        | None -> Sandt
        | Some(ydelser) -> match ydelser.ejer {
            | EjskEvslModtagerSocialYdelse(_, dato) -> dato.år == fødselsdato.år && dato.måned == fødselsdato.måned && dato.dag == fødselsdato.dag
            | _ -> Sandt
        }
    }
}
> personskat_ejendomsskat_eget_rabatgrundlag_alderkontroller(ejendom: EjendomsskattelovPersonEjendomFakta, fødselsdato: Dato, præfiks: Tekst) -> List(PersonskatInputkontrol) {
    match ejendom.overgangsvurderinger.rabat {
        | EjskIngenRabatvurderingerOplyst -> []
        | EjskRabatvurderingerOplyst(overgang) -> match overgang.eget_rabatgrundlag_2024 {
            | None -> []
            | Some(grundlag) -> hvis ejendomsskattelov_par3_stk1_hjemmel_findes(ejendomsskattelov_par3_hjemmel(grundlag.ny_lov_helårsgrundlag.kategori, 2024)) {
                [PersonskatInputkontrol(
                    sti = præfiks + "ejendomsskatter.ejendomme.overgangsvurderinger.rabat.EjskRabatvurderingerOplyst.fakta.eget_rabatgrundlag_2024",
                    gyldig = personskat_ejendomsskat_alder_stemmer(grundlag.kontekst_2024.kildefakta.ejer_folkepensionsalder, fødselsdato, 2024) && personskat_ejendomsskat_eget_ydelsesgrundlag_alder_stemmer(grundlag, fødselsdato),
                    forklaring = "Ejendom " + show(ejendom.ordinært_grundlag.identifikation) + ": ejer_folkepensionsalder i dit eget rabatgrundlags kontekst_2024 skal passe til din egen fødselsdato. Ejerens fødselsdato i par9_ydelsesgrundlag skal også være " + show(fødselsdato) + ". Afstem status ved udgangen af 2024, ikke ved udgangen af beregningsåret. " + personskat_ejendomsskat_alder_forklaring(fødselsdato, 2024)
                    ), PersonskatInputkontrol(
                        sti = præfiks + "ejendomsskatter.ejendomme.overgangsvurderinger.rabat.EjskRabatvurderingerOplyst.fakta.eget_rabatgrundlag_2024",
                        gyldig = ejendomsskattelov_evsl_par9_ydelsesgrundlag_gyldigt(grundlag),
                        forklaring = "Ejendom " + show(ejendom.ordinært_grundlag.identifikation) + ": afklar par9_ydelsesgrundlag i tidligere_ejendomsværdiskat.historisk_begrænsning for 2024. Ukendte egne eller relevante historiske ægtefælleydelser må ikke blive ingen ydelse. Fødselsdatoer skal være gyldige; nr. 2 kræver fyldt 60 år ved udgangen af 2024. Se personskat-validity.md#historiske-ydelser-og-stigningsbegrænsning."
                    ), PersonskatInputkontrol(
                        sti = præfiks + "ejendomsskatter.ejendomme.overgangsvurderinger.rabat.EjskRabatvurderingerOplyst.fakta.eget_rabatgrundlag_2024",
                        gyldig = ejendomsskattelov_evsl_succession_grundlag_gyldigt(grundlag),
                        forklaring = "Ejendom " + show(ejendom.ordinært_grundlag.identifikation) + ": afklar tidligere_ejendomsværdiskat.succession særskilt efter gamle EVSL §§ 8/9. Den kræver historiske dødsfalds-, beboelses-, ejerskabs- og ægteskabsfakta samt afdødes dokumenterede personkreds; sidstnævnte genberegnes ikke. Ukendt må ikke blive ingen succession eller false. Datoer skal være gyldige og kronologiske; dødsfald senest 2024. Brug ikke ny_lov_nedslagsfakta.pensionistsuccession som erstatning. Se personskat-validity.md#historisk-længstlevendesuccession."
                )]
            } ellers { [] }
        }
    }
}

> personskat_ejendomsskat_alder_inputkontroller(fakta: EjendomsskattelovPersonÅrsfakta, fødselsdato: Dato, samlevende_ægtefælles_fødselsdato: Option(Dato), indkomstår: Heltal, præfiks: Tekst) -> List(PersonskatInputkontrol) {
    = aktuelle = hvis personskat_ejendomsskat_alder_relevant(fakta, indkomstår) == Falskt {
        []
    } ellers {
        = egen = PersonskatInputkontrol(
            sti = præfiks + "ejendomsskatter.person.ejer_folkepensionsalder",
            gyldig = personskat_ejendomsskat_alder_stemmer(fakta.person.ejer_folkepensionsalder, fødselsdato, indkomstår),
            forklaring = personskat_ejendomsskat_alder_forklaring(fødselsdato, indkomstår)
        )
        match samlevende_ægtefælles_fødselsdato {
            | None -> [egen]
            | Some(dato) -> [egen, PersonskatInputkontrol(
                sti = præfiks + "ejendomsskatter.person.samlevende_ægtefælles_folkepensionsalder",
                gyldig = personskat_ejendomsskat_alder_stemmer(fakta.person.samlevende_ægtefælles_folkepensionsalder, dato, indkomstår),
                forklaring = "Kontrollen gælder den anden persons fødselsdato, også når den anden person ikke selv ejer en ejendom. " + personskat_ejendomsskat_alder_forklaring(dato, indkomstår)
            )]
        }
    }
    concat(aktuelle, flat_map(fakta.ejendomme, |ejendom: EjendomsskattelovPersonEjendomFakta| personskat_ejendomsskat_eget_rabatgrundlag_alderkontroller(ejendom, fødselsdato, præfiks)))
}
--@end:personskat_ejendomsskat_alder--
