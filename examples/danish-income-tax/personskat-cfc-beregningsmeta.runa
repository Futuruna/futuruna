@ sprog da

@ importer ./metadata
@ importer ./personskat - cfc - kildefakta

= personskat_cfc_felt_poster = Beregningsfelt(
    path = "cfc.poster",
    label = "CFC-forhold",
    question = Some("Har du kontrollerede udenlandske selskaber eller merafkast gennem en kapital-, venture- eller infrastrukturfond?"),
    help = Some("Opret én række for hvert forhold, der skal vurderes efter ligningslovens § 16 H eller § 16 I, stk. 6 og 7."),
    unit = None
)
= personskat_cfc_felt_art = Beregningsfelt(
    path = "cfc.poster.$variant",
    label = "CFC-regelgrundlag",
    question = Some("Skal forholdet vurderes efter ligningslovens § 16 H eller § 16 I, stk. 6 og 7?"),
    help = Some("§ 16 H vedrører kontrollerede udenlandske selskaber. § 16 I vedrører merafkast gennem fonde med fortrinsstilling."),
    unit = None
)

