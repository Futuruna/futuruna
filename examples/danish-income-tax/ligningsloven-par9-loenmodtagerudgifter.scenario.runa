@ sprog da

@ importer ./ligningsloven - par9 - loenmodtagerudgifter

# Ligningslov9Stk1Årsforventning(indkomstår: Heltal, lovversion: Ligningslov9Stk1Lovversion, reguleringstalskilde: Par20ReguleringstalKilde, reguleringstal_tiendedele: Heltal, grundbeløb_kroner: Heltal, fradrag_kroner: Heltal)

| ll9_stk1_scenarie_udgift(
    identifikation: Tekst,
    indkomstår: Heltal,
    udgiftsart: Ligningslov9Stk1Udgiftsart,
    beløb_kroner: Heltal,
    refunderet_kroner: Heltal,
    dokumentation: Ligningslov9Stk1Dokumentation
) -> Ligningslov9Stk1Udgiftsfakta(
    identifikation = identifikation,
    indkomstår = indkomstår,
    arbejdsforhold_identifikation = "arbejdsforhold-a",
    udgiftsart = udgiftsart,
    afholdt_eller_beregnet_beløb_kroner = beløb_kroner,
    arbejdsgiver_refunderet_efter_regning_kroner = refunderet_kroner,
    dokumentation = dokumentation
)

| ll9_stk1_scenarie_årsresultat(indkomstår: Heltal, udgifter: List(Ligningslov9Stk1Udgiftsfakta)) -> ligningslov9_stk1_årsresultat(
    indkomstår = indkomstår,
    input = Ligningslov9Stk1Årsinput(
        skatteyderstatus = Ll9Stk1Lønmodtager,
        udgifter = udgifter
    )
)

= ll9_stk1_scenarie_årsforventninger = [
    Ligningslov9Stk1Årsforventning(
        indkomstår = 2023,
        lovversion = Ll9Stk1Lbk42Af2023,
        reguleringstalskilde = SkatteministerietPar20HistoriskOversigt,
        reguleringstal_tiendedele = 1218,
        grundbeløb_kroner = 6700,
        fradrag_kroner = 3300
    ),
    Ligningslov9Stk1Årsforventning(
        indkomstår = 2024,
        lovversion = Ll9Stk1Lbk42Af2023,
        reguleringstalskilde = SkatteministerietPar20HistoriskOversigt,
        reguleringstal_tiendedele = 1261,
        grundbeløb_kroner = 7000,
        fradrag_kroner = 3000
    ),
    Ligningslov9Stk1Årsforventning(
        indkomstår = 2025,
        lovversion = Ll9Stk1Lbk42Af2023,
        reguleringstalskilde = SkatteministerietPar20Beløbsgrænser2025_2026,
        reguleringstal_tiendedele = 1310,
        grundbeløb_kroner = 7300,
        fradrag_kroner = 2700
    ),
    Ligningslov9Stk1Årsforventning(
        indkomstår = 2026,
        lovversion = Ll9Stk1Lbk1500Af2025,
        reguleringstalskilde = SkatteministerietPar20Beløbsgrænser2025_2026,
        reguleringstal_tiendedele = 1373,
        grundbeløb_kroner = 7600,
        fradrag_kroner = 2400
    )
]

| ll9_stk1_scenarie_årsforventning_holder(forventning: Ligningslov9Stk1Årsforventning) -> {
    = resultat = ll9_stk1_scenarie_årsresultat(
        indkomstår = forventning.indkomstår,
        udgifter = [ll9_stk1_scenarie_udgift(
            identifikation = "årsudgift",
            indkomstår = forventning.indkomstår,
            udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
            beløb_kroner = 10000,
            refunderet_kroner = 0,
            dokumentation = Ll9Stk1DokumenteretMedBilag
        )]
    )
    resultat.skatteår_understøttet && resultat.alle_input_gyldige && resultat.grundbeløb_kroner == forventning.grundbeløb_kroner && resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 10000 && resultat.samlet_fradrag_kroner == forventning.fradrag_kroner && match resultat.grundbeløbsresultat {
        | Some(grundbeløb) -> grundbeløb.indkomstår == forventning.indkomstår && grundbeløb.lovversion == forventning.lovversion && grundbeløb.reguleringstal.kilde == forventning.reguleringstalskilde && grundbeløb.reguleringstal.reguleringstal_tiendedele == forventning.reguleringstal_tiendedele && grundbeløb.regulering.grundbeløb_2010_niveau_kroner == 5500 && grundbeløb.regulering.reguleret_og_afrundet_kroner == forventning.grundbeløb_kroner
        | None -> Falskt
    }
}

= ll9_stk1_scenarie_kursus = ll9_stk1_scenarie_udgift(
    identifikation = "kursus",
    indkomstår = 2025,
    udgiftsart = Ll9Stk1Kursus(formål = Ll9Stk1VedligeholdelseEllerAjourføringAfFagligUddannelse),
    beløb_kroner = 8000,
    refunderet_kroner = 0,
    dokumentation = Ll9Stk1DokumenteretMedBilag
)

= ll9_stk1_scenarie_faglitteratur = ll9_stk1_scenarie_udgift(
    identifikation = "faglitteratur",
    indkomstår = 2025,
    udgiftsart = Ll9Stk1Faglitteratur(
        art = Ll9Stk1VidenskabeligtVærk,
        nødvendig_for_at_varetage_arbejdet_i_året = Sandt
    ),
    beløb_kroner = 2300,
    refunderet_kroner = 0,
    dokumentation = Ll9Stk1DokumenteretPåAndenKontrollerbarMåde
)

= ll9_stk1_scenarie_2025_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2025,
    udgifter = [ll9_stk1_scenarie_kursus, ll9_stk1_scenarie_faglitteratur]
)

= ll9_stk1_scenarie_præcis_bundgrænse_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2026,
    udgifter = [ll9_stk1_scenarie_udgift(
        identifikation = "præcis-bundgrænse",
        indkomstår = 2026,
        udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
