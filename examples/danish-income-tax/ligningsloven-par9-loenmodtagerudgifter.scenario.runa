)

= ll9_stk1_scenarie_2022_uden_kildedækning = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2022,
    udgifter = [ll9_stk1_scenarie_udgift(
        identifikation = "uden-kildedækning-2022",
        indkomstår = 2022,
        udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
        beløb_kroner = 10000,
        refunderet_kroner = 0,
