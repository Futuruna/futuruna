    )]
)

= ll9_stk1_scenarie_2027_uden_kildedækning = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2027,
    udgifter = [ll9_stk1_scenarie_udgift(
        identifikation = "uden-kildedækning-2027",
        indkomstår = 2027,
        udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
        beløb_kroner = 10000,
        refunderet_kroner = 0,
        dokumentation = Ll9Stk1DokumenteretMedBilag
    )]
)

| ll9_stk1_scenarie_årsserien_afledes_fra_par20: ll9_stk1_scenarie_årsforventninger -> all(ll9_stk1_scenarie_årsforventninger, |forventning: Ligningslov9Stk1Årsforventning| ll9_stk1_scenarie_årsforventning_holder(forventning))
| ll9_stk1_scenarie_bundgrænse_anvendes_på_samlede_udgifter: ll9_stk1_scenarie_2025_resultat -> ll9_stk1_scenarie_2025_resultat.alle_input_gyldige && ll9_stk1_scenarie_2025_resultat.grundbeløb_kroner == 7300 && ll9_stk1_scenarie_2025_resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 10300 && ll9_stk1_scenarie_2025_resultat.samlet_fradrag_kroner == 3000
| ll9_stk1_scenarie_intet_fradrag_ved_bundgrænsen: ll9_stk1_scenarie_præcis_bundgrænse_resultat -> ll9_stk1_scenarie_præcis_bundgrænse_resultat.grundbeløb_kroner == 7600 && ll9_stk1_scenarie_præcis_bundgrænse_resultat.samlet_fradrag_kroner == 0
| ll9_stk1_scenarie_repræsentation_begrænses_før_bundgrænsen: ll9_stk1_scenarie_repræsentation_resultat -> head(ll9_stk1_scenarie_repræsentation_resultat.udgiftsresultater).fradragsandel_basispoint == 2500 && ll9_stk1_scenarie_repræsentation_resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 10000 && ll9_stk1_scenarie_repræsentation_resultat.samlet_fradrag_kroner == 2400
| ll9_stk1_scenarie_erhvervsandel_anvendes_før_bundgrænsen: ll9_stk1_scenarie_delvis_erhverv_resultat -> ll9_stk1_scenarie_delvis_erhverv_resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 12000 && ll9_stk1_scenarie_delvis_erhverv_resultat.samlet_fradrag_kroner == 4400
| ll9_stk1_scenarie_refusion_reducerer_egen_udgift: ll9_stk1_scenarie_refusion_resultat -> head(ll9_stk1_scenarie_refusion_resultat.udgiftsresultater).egen_udgift_kroner == 8000 && ll9_stk1_scenarie_refusion_resultat.samlet_fradrag_kroner == 700
| ll9_stk1_scenarie_udelukkede_udgifter_giver_intet_fradrag: ll9_stk1_scenarie_udelukkede_udgifter_resultat -> ll9_stk1_scenarie_udelukkede_udgifter_resultat.alle_input_gyldige && ll9_stk1_scenarie_udelukkede_udgifter_resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 0 && ll9_stk1_scenarie_udelukkede_udgifter_resultat.samlet_fradrag_kroner == 0
| ll9_stk1_scenarie_ugyldigt_input_fejler_lukket: ll9_stk1_scenarie_ugyldig_resultat -> ll9_stk1_scenarie_ugyldig_resultat.identifikationer_entydige == Falskt && ll9_stk1_scenarie_ugyldig_resultat.alle_input_gyldige == Falskt && ll9_stk1_scenarie_ugyldig_resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 0 && ll9_stk1_scenarie_ugyldig_resultat.samlet_fradrag_kroner == 0
| ll9_stk1_scenarie_uden_kildedækning_fejler_lukket(resultat: Ligningslov9Stk1Årsresultat) -> resultat.skatteår_understøttet == Falskt && resultat.alle_input_gyldige == Falskt && resultat.grundbeløb_kroner == 0 && resultat.samlet_fradragsgrundlag_før_bundgrænse_kroner == 0 && resultat.samlet_fradrag_kroner == 0 && match resultat.grundbeløbsresultat {
    | None -> Sandt
    | Some(_) -> Falskt
}
| ll9_stk1_scenarie_2022_fejler_lukket: ll9_stk1_scenarie_2022_uden_kildedækning -> ll9_stk1_scenarie_uden_kildedækning_fejler_lukket(ll9_stk1_scenarie_2022_uden_kildedækning)
| ll9_stk1_scenarie_2027_fejler_lukket: ll9_stk1_scenarie_2027_uden_kildedækning -> ll9_stk1_scenarie_uden_kildedækning_fejler_lukket(ll9_stk1_scenarie_2027_uden_kildedækning)

? ll9_stk1_scenarie_årsserien_afledes_fra_par20
? ll9_stk1_scenarie_bundgrænse_anvendes_på_samlede_udgifter
? ll9_stk1_scenarie_intet_fradrag_ved_bundgrænsen
? ll9_stk1_scenarie_repræsentation_begrænses_før_bundgrænsen
? ll9_stk1_scenarie_erhvervsandel_anvendes_før_bundgrænsen
? ll9_stk1_scenarie_refusion_reducerer_egen_udgift
