    )]
)

= ll9_stk1_scenarie_repræsentation_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2026,
    udgifter = [ll9_stk1_scenarie_udgift(
        identifikation = "repræsentation",
        indkomstår = 2026,
        udgiftsart = Ll9Stk1Repræsentation(aflønningsform_giver_mulighed_for_at_påvirke_indtægten = Sandt),
        beløb_kroner = 40000,
        refunderet_kroner = 0,
        dokumentation = Ll9Stk1DokumenteretMedBilag
    )]
)

= ll9_stk1_scenarie_delvis_erhverv_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2026,
    udgifter = [ll9_stk1_scenarie_udgift(
        identifikation = "driftsmiddel",
        indkomstår = 2026,
        udgiftsart = Ll9Stk1DriftsmiddelAfskrivning(erhvervsmæssig_andel_basispoint = 6000),
        beløb_kroner = 20000,
        refunderet_kroner = 0,
        dokumentation = Ll9Stk1DokumenteretMedBilag
    )]
)

= ll9_stk1_scenarie_refusion_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2025,
    udgifter = [ll9_stk1_scenarie_udgift(
        identifikation = "arbejdstøj",
        indkomstår = 2025,
        udgiftsart = Ll9Stk1SærligtArbejdstøj(
            særligt_til_arbejdet = Sandt,
            kan_anvendes_som_almindeligt_tøj = Falskt
        ),
        beløb_kroner = 12000,
        refunderet_kroner = 4000,
        dokumentation = Ll9Stk1DokumenteretMedBilag
    )]
)

= ll9_stk1_scenarie_udelukkede_udgifter_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2026,
    udgifter = [
        ll9_stk1_scenarie_udgift(
            identifikation = "videreuddannelse",
            indkomstår = 2026,
            udgiftsart = Ll9Stk1Kursus(formål = Ll9Stk1GrundEllerVidereuddannelse),
            beløb_kroner = 20000,
            refunderet_kroner = 0,
            dokumentation = Ll9Stk1DokumenteretMedBilag
        ),
        ll9_stk1_scenarie_udgift(
            identifikation = "privat-litteratur",
            indkomstår = 2026,
            udgiftsart = Ll9Stk1Faglitteratur(
                art = Ll9Stk1PopulærvidenskabeligtVærk,
                nødvendig_for_at_varetage_arbejdet_i_året = Falskt
            ),
            beløb_kroner = 10000,
            refunderet_kroner = 0,
            dokumentation = Ll9Stk1DokumenteretMedBilag
        ),
        ll9_stk1_scenarie_udgift(
            identifikation = "befordring-9b",
            indkomstår = 2026,
            udgiftsart = Ll9Stk1BefordringOmfattetAfPar9B,
            beløb_kroner = 30000,
            refunderet_kroner = 0,
            dokumentation = Ll9Stk1DokumenteretMedBilag
        ),
        ll9_stk1_scenarie_udgift(
            identifikation = "udokumenteret",
            indkomstår = 2026,
            udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
            beløb_kroner = 10000,
            refunderet_kroner = 0,
            dokumentation = Ll9Stk1UdenTilstrækkeligDokumentation
        )
    ]
)

= ll9_stk1_scenarie_ugyldig_resultat = ll9_stk1_scenarie_årsresultat(
    indkomstår = 2026,
    udgifter = [
        ll9_stk1_scenarie_udgift(
            identifikation = "dublet",
            indkomstår = 2026,
            udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
            beløb_kroner = 10000,
            refunderet_kroner = 0,
            dokumentation = Ll9Stk1DokumenteretMedBilag
        ),
        ll9_stk1_scenarie_udgift(
            identifikation = "dublet",
            indkomstår = 2026,
            udgiftsart = Ll9Stk1ErhvervsmæssigeTelefonsamtaler,
            beløb_kroner = 10000,
