@ sprog da

@ importer ./personskat.calculate

----
Scenariet validerer den kanoniske kildefaktabro fra identificerede ordninger
efter Pensionsbeskatningslovens § 53 A til Personskattelovens § 4, stk. 1,
nr. 13. Hver ordning beholder sit eget negative afkast; kun positive,
skattepligtige resultater indgår i den samlede kapitalindkomst.
----

| personskat_pbl53a_kapitalindkomst(input: PersonskatPbl53AInput) -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = input,
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    omkostninger = []
)
| personskat_pbl53a_scenarie(input: PersonskatPbl53AInput) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 600000,
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_pbl53a_kapitalindkomst(input),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = [],
    årsopgørelse = UdenÅrsopgørelse
)

| personskat_pbl53a_helårs_pal_år(indkomstår: Heltal, afkast_kroner: Heltal, pensionsudbyder_opgjorde_afkast_efter_pal: Boolsk, afkastfordeling: Pbl53AAfkastfordelingsfakta) -> Pbl53AAfkastårFakta(
    indkomstår = indkomstår,
    afkastgrundlag = Pbl53AAfkastEfterPal(afkast_efter_pal_par3_til_5_kroner = afkast_kroner),
    pensionsudbyder_opgjorde_afkast_efter_pal = pensionsudbyder_opgjorde_afkast_efter_pal,
    skattepligtsstatus_ved_årets_begyndelse = Pbl53ASkattepligtigVedÅretsBegyndelse,
    sikkerhedsstatus_ved_årets_begyndelse = Pbl53ASikkerhedIkkeRelevant,
    grænsehændelser = [],
    afkastfordeling = afkastfordeling
)
| personskat_pbl53a_helårs_alternativt_år(indkomstår: Heltal, primo_kroner: Heltal, ultimo_kroner: Heltal, pensionsudbyder_opgjorde_afkast_efter_pal: Boolsk, afkastfordeling: Pbl53AAfkastfordelingsfakta) -> Pbl53AAfkastårFakta(
    indkomstår = indkomstår,
    afkastgrundlag = Pbl53AAlternativtKapitalværdiAfkast(kalenderårets_primo_depotværdi_kroner = primo_kroner, kalenderårets_ultimo_depotværdi_kroner = ultimo_kroner),
    pensionsudbyder_opgjorde_afkast_efter_pal = pensionsudbyder_opgjorde_afkast_efter_pal,
    skattepligtsstatus_ved_årets_begyndelse = Pbl53ASkattepligtigVedÅretsBegyndelse,
    sikkerhedsstatus_ved_årets_begyndelse = Pbl53ASikkerhedIkkeRelevant,
    grænsehændelser = [],
    afkastfordeling = afkastfordeling
)

= personskat_pbl53a_afledt_enkelt_rettighedshaver = Pbl53AAfledtEnkeltRettighedshaver
= personskat_pbl53a_pal_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "livsforsikring-pal",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_liv_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [
        personskat_pbl53a_helårs_pal_år(indkomstår = 2025, afkast_kroner = -6000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver),
        personskat_pbl53a_helårs_pal_år(indkomstår = 2026, afkast_kroner = 28000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver)
    ],
    hændelser = []
)
= personskat_pbl53a_negativ_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "pensionskasse-negativ",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_pensionskasse_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [
        personskat_pbl53a_helårs_alternativt_år(indkomstår = 2025, primo_kroner = 100000, ultimo_kroner = 95000, pensionsudbyder_opgjorde_afkast_efter_pal = Falskt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver),
        personskat_pbl53a_helårs_alternativt_år(indkomstår = 2026, primo_kroner = 140000, ultimo_kroner = 128000, pensionsudbyder_opgjorde_afkast_efter_pal = Falskt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver)
    ],
    hændelser = [
        Pbl53AUdbetaling(fakta = Pbl53AUdbetalingsfakta(
            identifikation = "negativ-udbetaling-2026",
            tidspunkt = Pbl53ATidspunkt(dato = Pbl15ADato(år = 2026, måned = 6, dag = 1), rækkefølge_på_dagen = 1),
            modtager = Pbl53AEjer,
            bruttoudbetaling_kroner = 4000,
            art = Pbl53AUdbetalingFraOrdningen(
                kapitalværdi_umiddelbart_før_udbetalingen_kroner = 140000,
                produktart = Pbl53AAndenProduktart,
                udbetalingsform = Pbl53AIkkeSamletKapitaludbetaling,
                pbl20_stk6_kildefakta = pbl20_stk6_ingen_kildefakta()
            )
        ))
    ]
)
| personskat_pbl53a_halv_andel_fakta_med_periode(skatteyder_identifikation: Tekst, rettighedsperiodereference: Pbl53ARettighedsperiodereference) -> PersonskatPbl53AOrdningFakta(
    identifikation = "pengeinstitut-halv-andel",
    skatteyder_identifikation = skatteyder_identifikation,
    omfangsfakta = pbl53a_pengeinstitut_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [personskat_pbl53a_helårs_alternativt_år(
        indkomstår = 2026,
        primo_kroner = 200000,
        ultimo_kroner = 230000,
        pensionsudbyder_opgjorde_afkast_efter_pal = Falskt,
        afkastfordeling = Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(
            rettighedsperiodereference = rettighedsperiodereference,
            samlet_indestående_ved_afkastperiodens_udgang_kroner = 230000,
            andele = [
                Pbl53ABerettigetAndel(identifikation = "person-1", indestående_ved_afkastperiodens_udgang_kroner = 115000),
                Pbl53ABerettigetAndel(identifikation = "person-2", indestående_ved_afkastperiodens_udgang_kroner = 115000)
            ]
        )
    )],
    hændelser = [
        Pbl53AIndbetaling(fakta = Pbl53AIndbetalingsfakta(
            identifikation = "halv-andel-indbetaling-2026",
            tidspunkt = Pbl53ATidspunkt(dato = Pbl15ADato(år = 2026, måned = 3, dag = 1), rækkefølge_på_dagen = 1),
            beløb_kroner = 15000,
            periode = Pbl53AIndbetaltMensOrdningenErOmfattet,
            indbetaler = Pbl53AEjeren,
            ejerens_fradragsstatus = Pbl53AUdenFradragsEllerBortseelsesret,
            par53b_udenlandsk_skattebehandling = Pbl53BIkkeForetagetIUdenlandsperioden
        )),
        Pbl53AUdbetaling(fakta = Pbl53AUdbetalingsfakta(
            identifikation = "halv-andel-udbetaling-2026",
            tidspunkt = Pbl53ATidspunkt(dato = Pbl15ADato(år = 2026, måned = 9, dag = 1), rækkefølge_på_dagen = 1),
            modtager = Pbl53AEjer,
            bruttoudbetaling_kroner = 12000,
            art = Pbl53AUdbetalingFraOrdningen(
                kapitalværdi_umiddelbart_før_udbetalingen_kroner = 242000,
                produktart = Pbl53AAndenProduktart,
                udbetalingsform = Pbl53AIkkeSamletKapitaludbetaling,
                pbl20_stk6_kildefakta = pbl20_stk6_ingen_kildefakta()
            )
        ))
    ]
)
| personskat_pbl53a_halv_andel_fakta_for(skatteyder_identifikation: Tekst) -> personskat_pbl53a_halv_andel_fakta_med_periode(skatteyder_identifikation, Pbl53ARettighedsperiodeFraOprettelsen)
= personskat_pbl53a_halv_andel_fakta = personskat_pbl53a_halv_andel_fakta_for("person-1")
= personskat_pbl53a_halv_andel_person2_fakta = personskat_pbl53a_halv_andel_fakta_for("person-2")
= personskat_pbl53a_ukendt_rettighedsperiode_fakta = personskat_pbl53a_halv_andel_fakta_med_periode("person-1", Pbl53ARettighedsperiodeFraErhvervelse(erhvervelsesidentifikation = "ukendt-periode"))
= personskat_pbl53a_pal_fortsat_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "livsforsikring-pal-fortsat",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_liv_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [
        personskat_pbl53a_helårs_pal_år(indkomstår = 2025, afkast_kroner = 1000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver),
        personskat_pbl53a_helårs_pal_år(indkomstår = 2026, afkast_kroner = 9000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver)
    ],
    hændelser = []
)
= personskat_pbl53a_skift_til_alternativ_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "ulovligt-skift-til-alternativ",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_liv_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [
        personskat_pbl53a_helårs_pal_år(indkomstår = 2025, afkast_kroner = 5000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver),
        personskat_pbl53a_helårs_alternativt_år(indkomstår = 2026, primo_kroner = 100000, ultimo_kroner = 110000, pensionsudbyder_opgjorde_afkast_efter_pal = Falskt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver)
    ],
    hændelser = []
)
= personskat_pbl53a_skift_til_pal_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "ulovligt-skift-til-pal",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_pengeinstitut_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [
        personskat_pbl53a_helårs_alternativt_år(indkomstår = 2025, primo_kroner = 100000, ultimo_kroner = 105000, pensionsudbyder_opgjorde_afkast_efter_pal = Falskt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver),
        personskat_pbl53a_helårs_pal_år(indkomstår = 2026, afkast_kroner = 10000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver)
    ],
    hændelser = []
)
= personskat_pbl53a_første_alternativ_med_udbyderopgørelse_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "første-alternativ-uden-adgang",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_pengeinstitut_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [personskat_pbl53a_helårs_alternativt_år(indkomstår = 2026, primo_kroner = 100000, ultimo_kroner = 110000, pensionsudbyder_opgjorde_afkast_efter_pal = Sandt, afkastfordeling = personskat_pbl53a_afledt_enkelt_rettighedshaver)],
    hændelser = []
)
= personskat_pbl53a_blandet_input = PersonskatPbl53AInput(
    ordninger = [
        personskat_pbl53a_pal_fakta,
        personskat_pbl53a_negativ_fakta,
        personskat_pbl53a_halv_andel_fakta
    ]
)
= personskat_pbl53a_blandet_resultat = beregn_personskat(personskat_pbl53a_scenarie(personskat_pbl53a_blandet_input))
= personskat_pbl53a_halv_andel_person2_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_halv_andel_person2_fakta]), 2026)
= personskat_pbl53a_ukendt_rettighedsperiode_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_ukendt_rettighedsperiode_fakta]), 2026)
= personskat_pbl53a_pal_fortsat_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_pal_fortsat_fakta]), 2026)
= personskat_pbl53a_skift_til_alternativ_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_skift_til_alternativ_fakta]), 2026)
= personskat_pbl53a_skift_til_pal_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_skift_til_pal_fakta]), 2026)
= personskat_pbl53a_første_alternativ_uden_adgang_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_første_alternativ_med_udbyderopgørelse_fakta]), 2026)

= personskat_pbl53a_dublet_input = PersonskatPbl53AInput(
    ordninger = [personskat_pbl53a_pal_fakta, personskat_pbl53a_pal_fakta]
)
= personskat_pbl53a_dublet_resultat = beregn_personskat(personskat_pbl53a_scenarie(personskat_pbl53a_dublet_input))

= personskat_pbl53a_ugyldig_andel_fakta = PersonskatPbl53AOrdningFakta(
    identifikation = "ugyldig-andel",
    skatteyder_identifikation = "person-1",
    omfangsfakta = pbl53a_liv_uden_kapitel1_omfang_fixture.fakta,
    afkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik,
    afkastår = [personskat_pbl53a_helårs_pal_år(
        indkomstår = 2026,
        afkast_kroner = 10000,
        pensionsudbyder_opgjorde_afkast_efter_pal = Sandt,
        afkastfordeling = Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(
            rettighedsperiodereference = Pbl53ARettighedsperiodeFraOprettelsen,
            samlet_indestående_ved_afkastperiodens_udgang_kroner = 100000,
            andele = [
                Pbl53ABerettigetAndel(identifikation = "person-1", indestående_ved_afkastperiodens_udgang_kroner = 60000),
                Pbl53ABerettigetAndel(identifikation = "person-2", indestående_ved_afkastperiodens_udgang_kroner = 30000)
            ]
        )
    )],
    hændelser = []
)
= personskat_pbl53a_ugyldig_andel_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_ugyldig_andel_fakta]), 2026)
= personskat_pbl53a_fremtidigt_år_resultat = personskat_pbl53a_resultat(PersonskatPbl53AInput(ordninger = [personskat_pbl53a_pal_fakta]), 2027)

| personskat_pbl53a_positive_ordninger_samles: personskat_pbl53a_blandet_resultat -> personskat_pbl53a_blandet_resultat.kapitalindkomst.pbl53a_resultat.alle_input_gyldige && personskat_pbl53a_blandet_resultat.kapitalindkomst.pbl53a_resultat.identifikationer_entydige && length(personskat_pbl53a_blandet_resultat.kapitalindkomst.pbl53a_resultat.kapitalposter) == 2 && personskat_pbl53a_blandet_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 35500
| personskat_pbl53a_pal_resultat_bevarer_regelkæden: personskat_pbl53a_blandet_resultat -> match personskat_pbl53a_blandet_resultat.kapitalindkomst.pbl53a_resultat.ordningsresultater[0] {
    | BeregnetPbl53AOrdning(fakta, _, pensionsbeskatningslov_input, pensionsbeskatningslov_resultat, _, par4_resultat, _, _, _, _, _, afkastforløbsresultat) -> fakta.identifikation == "livsforsikring-pal" && pensionsbeskatningslov_input.indkomstår == 2026 && pensionsbeskatningslov_input.metodehistorik == Pbl53ATidligerePalOpgørelse && pensionsbeskatningslov_resultat.metodevalg_bindende_opfyldt && pensionsbeskatningslov_resultat.fremført_negativt_afkast_anvendt_kroner == 6000 && pensionsbeskatningslov_resultat.skattepligtigt_afkast_kroner == 22000 && par4_resultat.kapitalindkomst_kroner == 22000 && afkastforløbsresultat.fremført_negativt_afkast_ultimo_kroner == 0
    | _ -> Falskt
}
| personskat_pbl53a_negativt_afkast_forbliver_på_ordningen: personskat_pbl53a_blandet_resultat -> match personskat_pbl53a_blandet_resultat.kapitalindkomst.pbl53a_resultat.ordningsresultater[1] {
    | BeregnetPbl53AOrdning(fakta, _, pensionsbeskatningslov_input, pensionsbeskatningslov_resultat, _, par4_resultat, _, _, _, _, _, afkastforløbsresultat) -> fakta.identifikation == "pensionskasse-negativ" && pensionsbeskatningslov_input.metodehistorik == Pbl53ATidligereAlternativKapitalværdiOpgørelse && pensionsbeskatningslov_resultat.metodevalg_bindende_opfyldt && pensionsbeskatningslov_resultat.afkast_efter_valgt_metode_kroner == -8000 && pensionsbeskatningslov_resultat.fremført_negativt_afkast_ultimo_kroner == 13000 && par4_resultat.kapitalindkomst_kroner == 0 && afkastforløbsresultat.fremført_negativt_afkast_ultimo_kroner == 13000
    | _ -> Falskt
}
| personskat_pbl53a_berettiget_andel_spores: personskat_pbl53a_blandet_resultat -> match personskat_pbl53a_blandet_resultat.kapitalindkomst.pbl53a_resultat.ordningsresultater[2] {
    | BeregnetPbl53AOrdning(_, _, pensionsbeskatningslov_input, pensionsbeskatningslov_resultat, _, par4_resultat, _, _, _, _, _, _) -> pensionsbeskatningslov_input.metodehistorik == Pbl53AFørsteAfkastopgørelse && pensionsbeskatningslov_input.andel_tæller == 115000 && pensionsbeskatningslov_input.andel_nævner == 230000 && pensionsbeskatningslov_resultat.metodevalg_bindende_opfyldt && pensionsbeskatningslov_resultat.afkast_efter_valgt_metode_kroner == 27000 && pensionsbeskatningslov_resultat.afkastandel_før_negativ_fremførsel_kroner == 13500 && pensionsbeskatningslov_resultat.udbetaling_til_afkastskat_medregnes_kroner == 0 && par4_resultat.kapitalindkomst_kroner == 13500
    | _ -> Falskt
}
| personskat_pbl53a_samme_rettighedsperiode_fordeles_til_anden_berettiget: personskat_pbl53a_halv_andel_person2_resultat -> personskat_pbl53a_halv_andel_person2_resultat.alle_input_gyldige && length(personskat_pbl53a_halv_andel_person2_resultat.kapitalposter) == 1 && match personskat_pbl53a_halv_andel_person2_resultat.ordningsresultater[0] {
    | BeregnetPbl53AOrdning(_, _, pensionsbeskatningslov_input, pensionsbeskatningslov_resultat, _, par4_resultat, _, _, _, _, _, afkastforløbsresultat) -> pensionsbeskatningslov_input.andel_tæller == 115000 && pensionsbeskatningslov_input.andel_nævner == 230000 && pensionsbeskatningslov_resultat.afkastandel_før_negativ_fremførsel_kroner == 13500 && par4_resultat.kapitalindkomst_kroner == 13500 && pbl53a_afkastårsresultat_for_indkomstår(afkastforløbsresultat, 2026).periode_resultat.rettighedsperiode_findes_entydigt
    | _ -> Falskt
}
| personskat_pbl53a_ukendt_rettighedsperiode_fejler_lukket: personskat_pbl53a_ukendt_rettighedsperiode_resultat -> personskat_pbl53a_ukendt_rettighedsperiode_resultat.alle_input_gyldige == Falskt && length(personskat_pbl53a_ukendt_rettighedsperiode_resultat.kapitalposter) == 0 && match personskat_pbl53a_ukendt_rettighedsperiode_resultat.ordningsresultater[0] {
    | UgyldigtPbl53AGrundlag(_, _, _, _, _, _, _, _, _, afkastforløbsresultat) -> pbl53a_afkastårsresultat_for_indkomstår(afkastforløbsresultat, 2026).periode_resultat.rettighedsperiode_findes_entydigt == Falskt && pbl53a_afkastårsresultat_for_indkomstår(afkastforløbsresultat, 2026).afkastfordelingsfakta_gyldige == Falskt
    | _ -> Falskt
}
| personskat_pbl53a_pal_metode_fortsætter_lovligt: personskat_pbl53a_pal_fortsat_resultat -> personskat_pbl53a_pal_fortsat_resultat.alle_input_gyldige && length(personskat_pbl53a_pal_fortsat_resultat.kapitalposter) == 1 && match personskat_pbl53a_pal_fortsat_resultat.ordningsresultater[0] {
