| exception kildeskat_påbegyndte_måneder_i_året_efter_indkomståret kildeskat_påbegyndte_måneder_fra_1_september(indkomstår: Heltal, dato: KildeskatDato) -> dato.måned - 8 under dato.år == indkomstår + 1 && dato.måned >= 9
| exception kildeskat_påbegyndte_måneder_efter_året_efter_indkomståret kildeskat_påbegyndte_måneder_fra_1_september(indkomstår: Heltal, dato: KildeskatDato) -> 4 + (dato.år - indkomstår - 2) * 12 + dato.måned under dato.år > indkomstår + 1
| kildeskat_påbegyndt_måned_dagstillæg(fra: KildeskatDato, til: KildeskatDato) -> 0
| exception kildeskat_forsinkelse_startet_ny_måned kildeskat_påbegyndt_måned_dagstillæg(fra: KildeskatDato, til: KildeskatDato) -> 1 under til.dag > fra.dag
| kildeskat_påbegyndte_måneder_efter_dato(fra: KildeskatDato, til: KildeskatDato) -> 0
| exception kildeskat_påbegyndte_måneder_efter_forudsat_dato kildeskat_påbegyndte_måneder_efter_dato(fra: KildeskatDato, til: KildeskatDato) -> (til.år - fra.år) * 12 + til.måned - fra.måned + kildeskat_påbegyndt_måned_dagstillæg(fra, til) under kildeskat_dato_efter(til, fra)
| kildeskat_par62a_rente_input_fra_dato(input: KildeskatPar62ARenteDatoInput) -> KildeskatPar62ARenteInput(input.art, input.beløb_kroner, input.tillæg_eller_godtgørelse_kroner, input.opkrævningslov_par7_stk2_rente_basispoint, kildeskat_påbegyndte_måneder_fra_1_september(input.systemdatoer.indkomstår, input.udskrivningsdato), kildeskat_dato_efter(input.udskrivningsdato, input.systemdatoer.seneste_systemdato_for_overførsel))
