# KildeskatPar62ARenteDatoInput(art: KildeskatÆndretÅrsopgørelseArt, beløb_kroner: Heltal, tillæg_eller_godtgørelse_kroner: Heltal, opkrævningslov_par7_stk2_rente_basispoint: Heltal, udskrivningsdato: KildeskatDato, systemdatoer: KildeskatRestskatSystemdatoer)
# KildeskatPar62AForsinketUdbetalingInput(forventet_samlet_udbetaling_kroner: Heltal, opkrævningslov_par7_stk2_rente_basispoint: Heltal, ekstra_påbegyndte_måneder: Heltal, forvaltningen_vælger_samlet_beløb_som_grundlag: Boolsk)
# KildeskatPar62AForsinketUdbetalingsdatoInput(forventet_samlet_udbetaling_kroner: Heltal, opkrævningslov_par7_stk2_rente_basispoint: Heltal, forudsat_udbetalingsdato: KildeskatDato, faktisk_udbetalingsdato: KildeskatDato, forvaltningen_vælger_samlet_beløb_som_grundlag: Boolsk)
# KildeskatPar62CMindreRestskatInput(restskat_tillæg_renter_kroner: Heltal, tidligere_ikke_opkrævet_kroner: Heltal, ikke_indregnet_efter_par61_stk3: Boolsk)

| kildeskat_basispoint_afrundet_til_en_decimal(sats_basispoint: Heltal) -> penge_basispoint_afrundet_til_en_decimal(sats_basispoint)
| kildeskat_restskat_procenttillæg_basispoint(input: KildeskatRestskatTillægInput) -> kildeskat_basispoint_afrundet_til_en_decimal(input.opkrævningslov_par7_stk2_tredje_pkt_rente_basispoint + 150)
| kildeskat_restskat_procenttillæg_kroner(input: KildeskatRestskatTillægInput) -> penge_beløb_gange_basispoint_kroner(input.restskat_kroner, kildeskat_restskat_procenttillæg_basispoint(input))
| kildeskat_forsinkelsesrente_basispoint_pr_påbegyndt_måned(input: KildeskatForsinkelsesrenteInput) -> input.opkrævningslov_par7_stk2_rente_basispoint + 40
| kildeskat_forsinkelsesrente_kroner(input: KildeskatForsinkelsesrenteInput) -> 0
| exception kildeskat_forsinket_beløb_forrentes kildeskat_forsinkelsesrente_kroner(input: KildeskatForsinkelsesrenteInput) -> penge_beløb_gange_basispoint_kroner(input.beløb_kroner * input.påbegyndte_måneder, kildeskat_forsinkelsesrente_basispoint_pr_påbegyndt_måned(input)) under input.rente_udløses && input.påbegyndte_måneder > 0

| kildeskat_restskat_grænse_2010_niveau_kroner() -> 18300
| kildeskat_restskat_udskrives_senest_september_systemdato(postur: KildeskatRestskatUdskrivningspostur) -> postur == SenestSeptemberFørAugust || postur == SenestSeptemberFraAugust
| kildeskat_restskat_udskrives_efter_september_systemdato(postur: KildeskatRestskatUdskrivningspostur) -> postur == EfterSeptemberFørJanuar || postur == JanuarEllerSenere
| kildeskat_restskat_udskrives_foerst_august_eller_senere(postur: KildeskatRestskatUdskrivningspostur) -> postur == SenestSeptemberFraAugust || postur == EfterSeptemberFørJanuar || postur == JanuarEllerSenere
| kildeskat_restskat_udskrives_foerst_januar_eller_senere(postur: KildeskatRestskatUdskrivningspostur) -> postur == JanuarEllerSenere
| kildeskat_restskat_udskrivningspostur_fra_dato(input: KildeskatRestskatOpkrævningDatoInput) -> EfterSeptemberFørJanuar
| exception kildeskat_restskat_dato_senest_september_foer_august kildeskat_restskat_udskrivningspostur_fra_dato(input: KildeskatRestskatOpkrævningDatoInput) -> SenestSeptemberFørAugust under kildeskat_dato_før_eller_lig(input.udskrivningsdato, input.systemdatoer.seneste_systemdato_for_overførsel) && input.udskrivningsdato.måned < 8
| exception kildeskat_restskat_dato_senest_september_fra_august kildeskat_restskat_udskrivningspostur_fra_dato(input: KildeskatRestskatOpkrævningDatoInput) -> SenestSeptemberFraAugust under kildeskat_dato_før_eller_lig(input.udskrivningsdato, input.systemdatoer.seneste_systemdato_for_overførsel) && input.udskrivningsdato.måned >= 8
| exception kildeskat_restskat_dato_januar_eller_senere kildeskat_restskat_udskrivningspostur_fra_dato(input: KildeskatRestskatOpkrævningDatoInput) -> JanuarEllerSenere under input.udskrivningsdato.år >= input.systemdatoer.indkomstår + 2
| kildeskat_restskat_opkrævning_input_fra_dato(input: KildeskatRestskatOpkrævningDatoInput) -> KildeskatRestskatOpkrævningInput(input.restskat_med_eventuelle_renter_kroner, input.reguleret_overførselsgrænse_kroner, kildeskat_restskat_udskrivningspostur_fra_dato(input), input.skattepligtig_ved_begyndelsen_af_efterfølgende_år, kildeskat_b_skat_første_resterende_rate_nr_på_dato(input.udskrivningsdato))
| kildeskat_restskat_del_under_reguleret_grænse_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_slutopgørelse_mindste_beløb(input.restskat_med_eventuelle_renter_kroner, input.reguleret_overførselsgrænse_kroner)
| kildeskat_restskat_resterende_efter_reguleret_grænse_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_slutopgørelse_positivt_beløb(input.restskat_med_eventuelle_renter_kroner - input.reguleret_overførselsgrænse_kroner)
| kildeskat_restskat_indregnes_i_følgende_år_kroner(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_stk3_overføres kildeskat_restskat_indregnes_i_følgende_år_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_restskat_del_under_reguleret_grænse_kroner(input) under kildeskat_restskat_udskrives_senest_september_systemdato(input.udskrivningspostur) && input.skattepligtig_ved_begyndelsen_af_efterfølgende_år
| kildeskat_restskat_tre_rater_stk4_kroner(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_restbeløb_stk4 kildeskat_restskat_tre_rater_stk4_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_restskat_resterende_efter_reguleret_grænse_kroner(input) under kildeskat_restskat_udskrives_senest_september_systemdato(input.udskrivningspostur) && input.skattepligtig_ved_begyndelsen_af_efterfølgende_år
| exception kildeskat_restskat_ikke_skattepligtig_stk7 kildeskat_restskat_tre_rater_stk4_kroner(input: KildeskatRestskatOpkrævningInput) -> input.restskat_med_eventuelle_renter_kroner under input.skattepligtig_ved_begyndelsen_af_efterfølgende_år == Falskt
| kildeskat_restskat_b_skat_tidspunkter_stk5_kroner(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_sen_årsopgørelse_b_skat kildeskat_restskat_b_skat_tidspunkter_stk5_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_restskat_del_under_reguleret_grænse_kroner(input) under kildeskat_restskat_udskrives_efter_september_systemdato(input.udskrivningspostur) && kildeskat_restskat_udskrives_foerst_januar_eller_senere(input.udskrivningspostur) == Falskt && input.skattepligtig_ved_begyndelsen_af_efterfølgende_år
| kildeskat_restskat_resterende_b_skat_rater_stk5_kroner(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_januar_resterende_b_skat_rater kildeskat_restskat_resterende_b_skat_rater_stk5_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_restskat_del_under_reguleret_grænse_kroner(input) under kildeskat_restskat_udskrives_foerst_januar_eller_senere(input.udskrivningspostur) && input.skattepligtig_ved_begyndelsen_af_efterfølgende_år
| kildeskat_restskat_stk6_resterende_tre_måneder_kroner(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_restbeløb_stk6 kildeskat_restskat_stk6_resterende_tre_måneder_kroner(input: KildeskatRestskatOpkrævningInput) -> kildeskat_restskat_resterende_efter_reguleret_grænse_kroner(input) under kildeskat_restskat_udskrives_efter_september_systemdato(input.udskrivningspostur) && input.skattepligtig_ved_begyndelsen_af_efterfølgende_år
| kildeskat_restskat_mindste_antal_rater(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_mindst_tre_rater kildeskat_restskat_mindste_antal_rater(input: KildeskatRestskatOpkrævningInput) -> 3 under input.restskat_med_eventuelle_renter_kroner > 0
| kildeskat_restskat_ordinære_rater_startmåned(input: KildeskatRestskatOpkrævningInput) -> 8
| exception kildeskat_restskat_rater_fra_systemmulig_måned kildeskat_restskat_ordinære_rater_startmåned(input: KildeskatRestskatOpkrævningInput) -> 0 under kildeskat_restskat_udskrives_foerst_august_eller_senere(input.udskrivningspostur)
| kildeskat_restskat_sidste_rettidige_betalingsdag() -> 20
| kildeskat_restskat_opkrævning_plan(input: KildeskatRestskatOpkrævningInput) -> KildeskatRestskatOpkrævningPlan(kildeskat_restskat_indregnes_i_følgende_år_kroner(input), kildeskat_restskat_tre_rater_stk4_kroner(input) + kildeskat_restskat_stk6_resterende_tre_måneder_kroner(input), kildeskat_restskat_b_skat_tidspunkter_stk5_kroner(input), kildeskat_restskat_resterende_b_skat_rater_stk5_kroner(input), kildeskat_restskat_mindste_antal_rater(input), kildeskat_restskat_ordinære_rater_startmåned(input), kildeskat_restskat_sidste_rettidige_betalingsdag())
| kildeskat_restskat_b_skat_første_rate_nr(input: KildeskatRestskatOpkrævningInput) -> 0
| exception kildeskat_restskat_sen_årsopgørelse_bruger_hele_b_skat_kalender kildeskat_restskat_b_skat_første_rate_nr(input: KildeskatRestskatOpkrævningInput) -> 1 under kildeskat_restskat_b_skat_tidspunkter_stk5_kroner(input) > 0
| exception kildeskat_restskat_januar_bruger_resterende_b_skat_kalender kildeskat_restskat_b_skat_første_rate_nr(input: KildeskatRestskatOpkrævningInput) -> input.første_resterende_b_skat_rate_nr under kildeskat_restskat_resterende_b_skat_rater_stk5_kroner(input) > 0
