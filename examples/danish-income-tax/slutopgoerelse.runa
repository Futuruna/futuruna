# KildeskatRestskatOpkrævningPlan(indregnes_i_følgende_år_kroner: Heltal, tre_rater_kroner: Heltal, b_skat_tidspunkter_kroner: Heltal, resterende_b_skat_rater_kroner: Heltal, mindste_antal_rater: Heltal, ordinære_rater_startmåned: Heltal, sidste_rettidige_betalingsdag: Heltal)
