----
§ 58. B-skat og foreløbigt arbejdsmarkedsbidrag forfalder til betaling i 10
rater den 1. i hver af månederne januar, februar, marts, april, maj, juli,
august, september, oktober og november med sidste rettidige betalingsdag for
den skattepligtige den 20. i forfaldsmåneden.
----

# KildeskatDato(år: Heltal, måned: Heltal, dag: Heltal)
# KildeskatRestskatSystemdatoer(indkomstår: Heltal, seneste_systemdato_for_overførsel: KildeskatDato)

| kildeskat_dato_før_eller_lig(a: KildeskatDato, b: KildeskatDato) -> a.år < b.år || (a.år == b.år && (a.måned < b.måned || (a.måned == b.måned && a.dag <= b.dag)))
| kildeskat_dato_efter(a: KildeskatDato, b: KildeskatDato) -> kildeskat_dato_før_eller_lig(a, b) == Falskt
| kildeskat_b_skat_antal_rater() -> 10
| kildeskat_b_skat_rate_forfaldsdag() -> 1
| kildeskat_b_skat_sidste_rettidige_betalingsdag() -> 20
| kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 0
| exception kildeskat_b_skat_rate_1_januar kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 1 under rate_nr == 1
| exception kildeskat_b_skat_rate_2_februar kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 2 under rate_nr == 2
| exception kildeskat_b_skat_rate_3_marts kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 3 under rate_nr == 3
| exception kildeskat_b_skat_rate_4_april kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 4 under rate_nr == 4
| exception kildeskat_b_skat_rate_5_maj kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 5 under rate_nr == 5
| exception kildeskat_b_skat_rate_6_juli kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 7 under rate_nr == 6
| exception kildeskat_b_skat_rate_7_august kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 8 under rate_nr == 7
| exception kildeskat_b_skat_rate_8_september kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 9 under rate_nr == 8
| exception kildeskat_b_skat_rate_9_oktober kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 10 under rate_nr == 9
| exception kildeskat_b_skat_rate_10_november kildeskat_b_skat_rate_forfaldsmåned(rate_nr: Heltal) -> 11 under rate_nr == 10
| kildeskat_b_skat_måned_har_rate(måned: Heltal) -> måned == 1 || måned == 2 || måned == 3 || måned == 4 || måned == 5 || måned == 7 || måned == 8 || måned == 9 || måned == 10 || måned == 11
| kildeskat_b_skat_resterende_rater_fra_rate(første_rate_nr: Heltal) -> 0
| exception kildeskat_b_skat_resterende_rateantal kildeskat_b_skat_resterende_rater_fra_rate(første_rate_nr: Heltal) -> 11 - første_rate_nr under første_rate_nr >= 1 && første_rate_nr <= 10
| kildeskat_b_skat_sidste_rate_nr_fra(første_rate_nr: Heltal) -> 0
| exception kildeskat_b_skat_sidste_rate_er_10 kildeskat_b_skat_sidste_rate_nr_fra(første_rate_nr: Heltal) -> 10 under første_rate_nr >= 1 && første_rate_nr <= 10
| kildeskat_b_skat_første_rate_måned_fra(første_rate_nr: Heltal) -> kildeskat_b_skat_rate_forfaldsmåned(første_rate_nr)
| kildeskat_b_skat_sidste_rate_måned_fra(første_rate_nr: Heltal) -> kildeskat_b_skat_rate_forfaldsmåned(kildeskat_b_skat_sidste_rate_nr_fra(første_rate_nr))
| kildeskat_b_skat_rate_resterer_på_dato(rate_nr: Heltal, dato: KildeskatDato) -> kildeskat_b_skat_rate_forfaldsmåned(rate_nr) > dato.måned || (kildeskat_b_skat_rate_forfaldsmåned(rate_nr) == dato.måned && kildeskat_b_skat_rate_forfaldsdag() > dato.dag)
| kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 0
| exception kildeskat_b_skat_første_resterende_rate_1 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 1 under kildeskat_b_skat_rate_resterer_på_dato(1, dato)
| exception kildeskat_b_skat_første_resterende_rate_2 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 2 under kildeskat_b_skat_rate_resterer_på_dato(1, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(2, dato)
| exception kildeskat_b_skat_første_resterende_rate_3 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 3 under kildeskat_b_skat_rate_resterer_på_dato(2, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(3, dato)
| exception kildeskat_b_skat_første_resterende_rate_4 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 4 under kildeskat_b_skat_rate_resterer_på_dato(3, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(4, dato)
| exception kildeskat_b_skat_første_resterende_rate_5 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 5 under kildeskat_b_skat_rate_resterer_på_dato(4, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(5, dato)
| exception kildeskat_b_skat_første_resterende_rate_6 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 6 under kildeskat_b_skat_rate_resterer_på_dato(5, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(6, dato)
| exception kildeskat_b_skat_første_resterende_rate_7 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 7 under kildeskat_b_skat_rate_resterer_på_dato(6, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(7, dato)
| exception kildeskat_b_skat_første_resterende_rate_8 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 8 under kildeskat_b_skat_rate_resterer_på_dato(7, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(8, dato)
| exception kildeskat_b_skat_første_resterende_rate_9 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 9 under kildeskat_b_skat_rate_resterer_på_dato(8, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(9, dato)
| exception kildeskat_b_skat_første_resterende_rate_10 kildeskat_b_skat_første_resterende_rate_nr_på_dato(dato: KildeskatDato) -> 10 under kildeskat_b_skat_rate_resterer_på_dato(9, dato) == Falskt && kildeskat_b_skat_rate_resterer_på_dato(10, dato)

----
§ 60. I den slutskat, der for et år udskrives for den skattepligtige, med
tillæg af eventuel overført restskat m.v. efter § 61, stk. 3, og afgiften
omfattet af pensionsbeskatningslovens § 25 A, stk. 5-9, modregnes nedennævnte
beløb vedrørende samme år:

a) Foreløbige skattebeløb, som er indeholdt i A-indkomst og
arbejdsmarkedsbidragspligtig indkomst, der skal medregnes ved den
skattepligtiges ansættelse til slutskat.
b) Foreløbige skattebeløb, som har skullet indbetales efter § 68.
c) Foreløbige skattebeløb, som har skullet betales i henhold til skattebillet.
d) De i § 67, stk. 1, 1. pkt., nævnte beløb.
e) Beløb, som den skattepligtige har indbetalt i henhold til § 59.
f) Beløb efter virksomhedsskattelovens § 10, stk. 3, 2. pkt., § 13, stk. 1,
3. pkt., og § 22 b, stk. 5.
g) Beløb efter personskattelovens § 8 a, stk. 5.
h) Beløb, der er indbetalt som acontoskat efter afskrivningslovens § 40 C,
stk. 8-10.
i) Beløb efter § 6 i lov om arbejdsmarkedsbidrag.
j) Nedslag efter lov om skattenedslag for seniorer.
k) Beløb efter lov om skattefri kompensation for forhøjede energi- og
miljøafgifter.

Stk. 3. Ved opgørelsen af det beløb, der skal modregnes efter stk. 1 eller
stk. 2, fradrages skatter, der måtte være tilbagebetalt i henhold til § 55.

Stk. 4. Skatteministeren kan fastsætte regler, hvorefter der åbnes adgang til,
at ægtefæller, der er samlevende ved udgangen af det år, for hvilket slutskatten
skal beregnes, kan erklære sig indforstået med, at eventuel overskydende skat,
der efter reglerne i § 62 tilkommer den ene af ægtefællerne, anvendes til
udligning af eventuel restskat, som efter reglerne i § 61 påhviler den anden
ægtefælle.

I det omfang der efter udligning efter 1. pkt. bliver tale om restskat eller
overskydende skat for en af ægtefællerne, opkræves denne efter reglerne i § 61,
henholdsvis udbetales efter reglerne i § 62.
----

# KildeskatSlutopgørelseArt = IngenSlutopgørelsesDifference | Restskat | OverskydendeSkat
# KildeskatPar60Kreditter(a_skat_og_am_indeholdt_kroner: Heltal, par68_indbetalt_kroner: Heltal, b_skat_betalt_kroner: Heltal, udbytteskat_modregningsberettiget_kroner: Heltal, frivillig_indbetaling_par59_kroner: Heltal, virksomhedsordning_beløb_kroner: Heltal, personskattelov_par8a_stk5_beløb_kroner: Heltal, afskrivningslov_acontoskat_kroner: Heltal, am_lov_par6_beløb_kroner: Heltal, seniornedslag_kroner: Heltal, energiafgiftskompensation_kroner: Heltal, tilbagebetalt_par55_kroner: Heltal)
# KildeskatSlutopgørelseInput(slutskat_kroner: Heltal, overført_restskat_mv_kroner: Heltal, pensionsbeskatningsafgift_kroner: Heltal, kreditter: KildeskatPar60Kreditter)
# KildeskatSlutopgørelseResult(slutskat_med_tillæg_kroner: Heltal, modregnede_foreløbige_skatter_kroner: Heltal, restskat_kroner: Heltal, overskydende_skat_kroner: Heltal, art: KildeskatSlutopgørelseArt)
# KildeskatÆgtefælleUdligningInput(person_a_restskat_kroner: Heltal, person_a_overskydende_skat_kroner: Heltal, person_b_restskat_kroner: Heltal, person_b_overskydende_skat_kroner: Heltal, samlevende_ved_årets_udgang: Boolsk, begge_indforstået: Boolsk)
# KildeskatÆgtefælleUdligningResult(person_a_restskat_efter_udligning_kroner: Heltal, person_a_overskydende_skat_efter_udligning_kroner: Heltal, person_b_restskat_efter_udligning_kroner: Heltal, person_b_overskydende_skat_efter_udligning_kroner: Heltal, anvendt_a_til_b_kroner: Heltal, anvendt_b_til_a_kroner: Heltal)

| kildeskat_slutopgørelse_positivt_beløb(beløb_kroner: Heltal) -> penge_positivt_beløb(beløb_kroner)
| kildeskat_slutopgørelse_mindste_beløb(a_kroner: Heltal, b_kroner: Heltal) -> penge_mindste_beløb(a_kroner, b_kroner)
| kildeskat_par60_modregning_brutto_kroner(kreditter: KildeskatPar60Kreditter) -> kreditter.a_skat_og_am_indeholdt_kroner + kreditter.par68_indbetalt_kroner + kreditter.b_skat_betalt_kroner + kreditter.udbytteskat_modregningsberettiget_kroner + kreditter.frivillig_indbetaling_par59_kroner + kreditter.virksomhedsordning_beløb_kroner + kreditter.personskattelov_par8a_stk5_beløb_kroner + kreditter.afskrivningslov_acontoskat_kroner + kreditter.am_lov_par6_beløb_kroner + kreditter.seniornedslag_kroner + kreditter.energiafgiftskompensation_kroner
| kildeskat_par60_modregning_kroner(kreditter: KildeskatPar60Kreditter) -> kildeskat_slutopgørelse_positivt_beløb(kildeskat_par60_modregning_brutto_kroner(kreditter) - kreditter.tilbagebetalt_par55_kroner)
| kildeskat_slutskat_med_tillæg_kroner(input: KildeskatSlutopgørelseInput) -> input.slutskat_kroner + input.overført_restskat_mv_kroner + input.pensionsbeskatningsafgift_kroner
| kildeskat_ægtefælleudligning_tilladt(input: KildeskatÆgtefælleUdligningInput) -> input.samlevende_ved_årets_udgang && input.begge_indforstået
| kildeskat_ægtefælleudligning_a_til_b_kroner(input: KildeskatÆgtefælleUdligningInput) -> 0
| exception kildeskat_ægtefælle_a_overskydende_udligner_b_restskat kildeskat_ægtefælleudligning_a_til_b_kroner(input: KildeskatÆgtefælleUdligningInput) -> kildeskat_slutopgørelse_mindste_beløb(input.person_a_overskydende_skat_kroner, input.person_b_restskat_kroner) under kildeskat_ægtefælleudligning_tilladt(input) && input.person_a_overskydende_skat_kroner > 0 && input.person_b_restskat_kroner > 0
| kildeskat_ægtefælleudligning_b_til_a_kroner(input: KildeskatÆgtefælleUdligningInput) -> 0
| exception kildeskat_ægtefælle_b_overskydende_udligner_a_restskat kildeskat_ægtefælleudligning_b_til_a_kroner(input: KildeskatÆgtefælleUdligningInput) -> kildeskat_slutopgørelse_mindste_beløb(input.person_b_overskydende_skat_kroner, input.person_a_restskat_kroner) under kildeskat_ægtefælleudligning_tilladt(input) && input.person_b_overskydende_skat_kroner > 0 && input.person_a_restskat_kroner > 0
| kildeskat_ægtefælleudligning_resultat(input: KildeskatÆgtefælleUdligningInput) -> KildeskatÆgtefælleUdligningResult(input.person_a_restskat_kroner - kildeskat_ægtefælleudligning_b_til_a_kroner(input), input.person_a_overskydende_skat_kroner - kildeskat_ægtefælleudligning_a_til_b_kroner(input), input.person_b_restskat_kroner - kildeskat_ægtefælleudligning_a_til_b_kroner(input), input.person_b_overskydende_skat_kroner - kildeskat_ægtefælleudligning_b_til_a_kroner(input), kildeskat_ægtefælleudligning_a_til_b_kroner(input), kildeskat_ægtefælleudligning_b_til_a_kroner(input))

----
§ 61. Den skattepligtige skal tilsvare det beløb, hvormed slutskatten med
tillæg af eventuel overført restskat m.v. efter stk. 3, og af eventuel afgift
omfattet af pensionsbeskatningslovens § 25 A, stk. 5-9, måtte overstige de
foreløbige skatter, der modregnes efter § 60.

Beløbet benævnes »restskat«.

Stk. 9. Af de skattebeløb, der opkræves eller inddrives for et indkomstår,
dækkes indkomstskat forud for ejendomsværdiskat og grundskyld som nævnt i
ejendomsskattelovens § 31, stk. 1, og renter, der forfalder til betaling efter
ejendomsskattelovens § 59, stk. 4, og arbejdsmarkedsbidrag dækkes forud for
A-skat og B-skat.

§ 62. Det beløb hvormed slutskatten med tillæg af eventuel overført restskat
m.v. efter § 61, stk. 3, og af eventuel afgift omfattet af
pensionsbeskatningslovens § 25 A, stk. 5-9, måtte være mindre end de
foreløbige skatter, der modregnes efter § 60, benævnes »overskydende skat«.

Stk. 2. Ved tilbagebetaling af overskydende skat ydes der den skattepligtige
et procenttillæg af beløbet i godtgørelse.

Stk. 4. Af det beløb, der efter foranstående skal udbetales den skattepligtige,
udbetales kun det hele kronebeløb.
----

| kildeskat_slutopgørelse_difference_kroner(input: KildeskatSlutopgørelseInput) -> kildeskat_slutskat_med_tillæg_kroner(input) - kildeskat_par60_modregning_kroner(input.kreditter)
| kildeskat_restskat_kroner(input: KildeskatSlutopgørelseInput) -> kildeskat_slutopgørelse_positivt_beløb(kildeskat_slutopgørelse_difference_kroner(input))
| kildeskat_overskydende_skat_kroner(input: KildeskatSlutopgørelseInput) -> kildeskat_slutopgørelse_positivt_beløb(0 - kildeskat_slutopgørelse_difference_kroner(input))
| kildeskat_slutopgørelse_art(input: KildeskatSlutopgørelseInput) -> IngenSlutopgørelsesDifference
| exception kildeskat_slutopgørelse_er_restskat kildeskat_slutopgørelse_art(input: KildeskatSlutopgørelseInput) -> Restskat under kildeskat_restskat_kroner(input) > 0
| exception kildeskat_slutopgørelse_er_overskydende kildeskat_slutopgørelse_art(input: KildeskatSlutopgørelseInput) -> OverskydendeSkat under kildeskat_overskydende_skat_kroner(input) > 0
| kildeskat_slutopgørelse_resultat(input: KildeskatSlutopgørelseInput) -> KildeskatSlutopgørelseResult(kildeskat_slutskat_med_tillæg_kroner(input), kildeskat_par60_modregning_kroner(input.kreditter), kildeskat_restskat_kroner(input), kildeskat_overskydende_skat_kroner(input), kildeskat_slutopgørelse_art(input))
| kildeskat_restskat_opkræves_efter_par61(input: KildeskatSlutopgørelseInput) -> kildeskat_restskat_kroner(input) > 0
| kildeskat_overskydende_skat_udbetales_efter_par62(input: KildeskatSlutopgørelseInput) -> kildeskat_overskydende_skat_kroner(input) > 0
| kildeskat_indkomstskat_dækkes_før_ejendomsskatter() -> Sandt
| kildeskat_arbejdsmarkedsbidrag_dækkes_før_a_og_b_skat() -> Sandt
| kildeskat_overskydende_skat_udbetales_i_hele_kroner(overskydende_skat_kroner: Heltal) -> overskydende_skat_kroner

----
§ 61. Stk. 2. Ved betaling af restskat skal der ud over restskatten betales et
procenttillæg til staten af restskatten.

Procenttillægget beregnes en gang årligt og fastsættes som rentesatsen i
opkrævningslovens § 7, stk. 2, 3. pkt., med tillæg af 1,5 procentpoint afrundet
til en decimal.

Af restskat og procenttillæg efter 1. pkt. beregnes en rente svarende til
renten i opkrævningslovens § 7, stk. 2, med tillæg af 0,4 procentpoint pr.
påbegyndt måned fra den 1. september i året efter indkomståret og indtil
udskrivningsdatoen for den skattepligtiges årsopgørelse, hvis den
skattepligtige ikke rettidigt har opfyldt sin oplysningspligt efter
skattekontrollovens § 2.

Stk. 3. Er udskrivningsdatoen for den skattepligtiges årsopgørelse senest den
dag i september i året efter indkomståret, hvor en overførsel af restskat til
opkrævning sammen med forskudsskat for næste indkomstår senest systemmæssigt
understøttes, overføres den del af restskatten med eventuelle skyldige renter
efter § 63, stk. 1, der ikke overstiger et grundbeløb på 18.300 kr.
(2010-niveau), med tillæg af et til den overførte restskat svarende tillæg
efter stk. 2 som et yderligere tilsvar for det efterfølgende år, til hvis
dækning der opkræves yderligere A-skat, B-skat eller arbejdsmarkedsbidrag for
dette år.

Skatteministeren fastsætter regler om opkrævningen.

De skattebeløb, der er opkrævet for et år, hvortil der er overført restskat
m.v., anses for medgået først til dækning af den overførte restskat m.v.

Stk. 4. Et eventuelt resterende beløb efter stk. 3 med renter og tillæg efter
stk. 2 forfalder til betaling i tre rater den 1. i hver af månederne august,
september og oktober i året efter indkomståret med sidste rettidige betalingsdag
den 20. i forfaldsmåneden.

Udskrives årsopgørelsen først den 1. august i året efter indkomståret eller
senere, forfalder raterne dog først til betaling den 1. i hver af de nærmest
følgende 3 måneder regnet fra det tidspunkt, hvor det systemmæssigt vil være
muligt at understøtte opkrævningen, med sidste rettidige betalingsfrist den 20.
i forfaldsmåneden.

Stk. 5. Er udskrivningsdatoen for den skattepligtiges årsopgørelse senere end
den dag i september i året efter indkomståret, hvor en overførsel af restskat
til opkrævning sammen med forskudsskat for næste indkomstår senest
systemmæssigt understøttes, forfalder den del af restskatten med eventuelle
skyldige renter efter § 63, stk. 1, der ikke overstiger et grundbeløb på 18.300
kr. (2010-niveau), med tillæg af et til denne del af restskatten svarende
tillæg efter stk. 2, renter efter stk. 2 og renter efter § 62 A, stk. 1,
3. pkt., til betaling i det følgende år på samme tidspunkter og med samme
betalingsfrister som B-skat, jf. § 58.

Er udskrivningsdatoen for årsopgørelsen først den 1. januar eller senere,
forfalder restskatten til betaling over de resterende B-skatterater.

Betalingen skal dog ske i mindst 3 rater, jf. dog § 62 C, stk. 1.

Stk. 6. Et eventuelt resterende beløb efter stk. 5 forfalder med tillæg efter
stk. 2 og renter efter § 62 A, stk. 1, 3. pkt., til betaling den 1. i hver af
de nærmest følgende 3 måneder regnet fra det tidspunkt, hvor det systemmæssigt
vil være muligt at understøtte opkrævningen.

Reglerne i § 58 om betalingsfristen finder tilsvarende anvendelse.

Stk. 7. Er den pågældende ikke skattepligtig ved begyndelsen af det
efterfølgende år, sker opkrævningen efter reglerne i stk. 4.

Overtager den længstlevende ægtefælle i umiddelbar forbindelse med dødsfaldet
boet, jf. dødsboskattelovens § 58, sker opkrævningen hos den længstlevende
ægtefælle af afdødes restskat m.v. før dødsfaldet efter reglerne i stk. 5 og 6.

Stk. 8. Det i stk. 3 og 5 nævnte grundbeløb reguleres efter
personskattelovens § 20.

§ 62. Stk. 2. Ved tilbagebetaling af overskydende skat ydes der den
skattepligtige et procenttillæg af beløbet i godtgørelse.

Procenttillægget beregnes en gang årligt og fastsættes som rentesatsen i
opkrævningslovens § 7, stk. 2, 3. pkt., med fradrag af 5,2 procentpoint
afrundet til en decimal.

Procenttillægget kan dog ikke fastsættes til mindre end 0,0 pct. af den
overskydende skat.

I det omfang overskydende skat modsvares af beløb, der er indbetalt efter
§ 59, ydes ingen godtgørelse efter 1. pkt. Betalt rente af indbetalinger efter
§ 59 tilbagebetales, i det omfang indbetalingen modsvares af overskydende skat.

Ved flere indbetalinger efter § 59 anses de seneste indbetalinger i størst
muligt omfang at modsvares af overskydende skat.

Der ydes ingen godtgørelse for et beløb, som modsvares af nedslaget efter lov
om skattenedslag for seniorer og efter lov om skattefri kompensation for
forhøjede energi- og miljøafgifter.

Stk. 3. Tilbagebetaling af overskydende skat med godtgørelse efter stk. 2 sker
i tiden fra den 1. marts til den 1. september i året efter indkomståret.

Der tilkommer den skattepligtige en rente svarende til renten i henhold til
opkrævningslovens § 7, stk. 2, med tillæg af 0,4 procentpoint pr. påbegyndt
måned fra den 1. september at regne, hvis tilbagebetaling sker efter denne
dato.

Inden tilbagebetaling finder sted, modregnes eventuelle restancer af personlig
skat med påløbne morarenter, uanset om renterne er forfaldne.

Modregningen kræver ingen særskilt erklæring herom fra told- og
skatteforvaltningen.

§ 62 A. Medfører en ændret årsopgørelse, at der skal betales restskat eller
yderligere restskat, gælder reglerne i § 61, stk. 3-6, for betaling af beløbet
med tillæg efter § 61, stk. 2.

Udskrives den ændrede årsopgørelse efter den dag i september i året efter
indkomståret, hvor en overførsel af restskat til opkrævning sammen med
forskudsskat for næste indkomstår senest systemmæssigt understøttes, berører
ændringen ikke den opkrævning, der sker efter § 61, stk. 5, eller den
overførsel, der er sket efter § 61, stk. 3, af den eventuelt tidligere beregnede
restskat m.v. Restskat eller yderligere restskat efter 1. pkt. med tillæg efter
§ 61, stk. 2, forrentes med renten i henhold til opkrævningslovens § 7, stk. 2,
med tillæg af 0,4 procentpoint pr. påbegyndt måned fra den 1. september i året
efter indkomståret og indtil udskrivningsdatoen.

Stk. 2. Medfører en ændret årsopgørelse, at der sker nedsættelse eller bortfald
af overskydende skat, der allerede er udbetalt til den skattepligtige, jf. § 62,
skal beløbet tilbagebetales tillige med godtgørelse efter § 62, stk. 2.

Det samlede beløb efter 1. pkt. forrentes med renten i henhold til
opkrævningslovens § 7, stk. 2, med tillæg af 0,4 procentpoint pr. påbegyndt
måned fra den 1. september i året efter indkomståret og indtil
udskrivningsdatoen.

Tilbagebetaling sker efter § 61, stk. 4.

Kravet på tilbagebetaling stiftes den første dag efter indkomståret og kan ved
en overdragelse til restanceinddrivelsesmyndigheden betegnes som restskat.

Stk. 3. Medfører en ændret årsopgørelse, at den tidligere beregnede restskat
nedsættes eller bortfalder, udbetales det beløb, som restskatten er nedsat med,
med tillæg efter § 61, stk. 2, til den skattepligtige inden udgangen af den
måned, der følger nærmest efter udskrivningsdatoen.

Der tilkommer den skattepligtige en rente svarende til renten i henhold til
opkrævningslovens § 7, stk. 2, med tillæg af 0,4 procentpoint pr. påbegyndt
måned fra den 1. september i året efter indkomståret.

Told- og skatteforvaltningen kan vælge, at de yderligere renter, der skal
beregnes, hvis udbetalingen forsinkes i forhold til den udbetalingsdag, der
blev lagt til grund ved den automatiske renteberegning efter 2. pkt., beregnes
af det samlede beløb, der inklusive renter forventedes udbetalt denne dag.

Inden udbetaling finder sted, modregnes eventuel uforfalden restskat efter
§ 61, stk. 3-6, og eventuelle restancer af personlig skat med påløbne
morarenter, uanset om renterne er forfaldne.

Modregningen kræver ingen særskilt erklæring herom fra told- og
skatteforvaltningen.

Opkrævning af den resterende, ikke forfaldne del af restskatten sker efter
reglerne i § 61, stk. 3-5.

Udskrives den ændrede årsopgørelse efter den dag i september i året efter
indkomståret, hvor en overførsel af restskat til opkrævning sammen med
forskudsskat for næste indkomstår senest systemmæssigt understøttes, berører
ændringen ikke den overførsel af restskat m.v. til det følgende år, der er sket
efter § 61, stk. 3.

Stk. 4. Medfører en ændret årsopgørelse, at der fremkommer overskydende skat
eller yderligere overskydende skat, tilbagebetales beløbet med godtgørelse
efter § 62, stk. 2, og eventuelle renter efter § 62, stk. 3, 2. pkt., inden
udgangen af den måned, der følger nærmest efter udskrivningsdatoen.

Told- og skatteforvaltningen kan vælge, at de yderligere renter, der skal
beregnes, hvis udbetalingen forsinkes i forhold til den udbetalingsdag, der
blev lagt til grund ved den automatiske renteberegning efter 1. pkt., beregnes
af det samlede beløb, der inklusive renter forventedes udbetalt denne dag.

Inden tilbagebetaling finder sted, modregnes eventuelle restancer af personlig
skat med påløbne morarenter, uanset om renterne er forfaldne.

Modregningen kræver ingen særskilt erklæring herom fra told- og
skatteforvaltningen.

§ 62 C. Rater, der opkræves efter denne lov, skal være på mindst 500 kr.,
indtil hele beløbet er betalt.

Stk. 2. Hvis restskat, der ikke bliver indregnet efter § 61, stk. 3, reguleret
med tillæg og renter efter §§ 61-63 i alt udgør et mindre beløb end 500 kr.,
opkræves den ikke.

Tilsvarende gælder skattebeløb, der opstår som følge af ændring af ansættelsen
efter § 62 A.

Ved beregningen tillægges beløb efter 1. og 2. pkt., der ikke tidligere er
opkrævet.

Stk. 3. Beløb på 200 kr. eller derunder bortfalder, når udbetaling over
Nemkontosystemet ikke har kunnet finde sted inden for en periode på 3 måneder.

Stk. 4. Ved opkrævning af beløb efter denne lov opkræves kun hele kronebeløb.

Tilsvarende gælder ved opkrævning af rater efter stk. 1.
----

# KildeskatRestskatTillægInput(restskat_kroner: Heltal, opkrævningslov_par7_stk2_tredje_pkt_rente_basispoint: Heltal)
