# KildeskatOverskydendeTilbagebetalingInput(overskydende_skat_kroner: Heltal, godtgørelse_kroner: Heltal, restancer_personlig_skat_med_morarenter_kroner: Heltal, tilbagebetaling_i_ordinært_vindue: Boolsk, tilbagebetaling_efter_1_september: Boolsk, påbegyndte_måneder_efter_1_september: Heltal, opkrævningslov_par7_stk2_rente_basispoint: Heltal)
