| kildeskat_restskat_b_skat_antal_rater(input: KildeskatRestskatOpkrævningInput) -> kildeskat_b_skat_resterende_rater_fra_rate(kildeskat_restskat_b_skat_første_rate_nr(input))
| kildeskat_restskat_b_skat_første_forfaldsmåned(input: KildeskatRestskatOpkrævningInput) -> kildeskat_b_skat_første_rate_måned_fra(kildeskat_restskat_b_skat_første_rate_nr(input))
