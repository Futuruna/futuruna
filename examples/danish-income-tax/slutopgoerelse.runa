| kildeskat_par62a_rente_udløses(input: KildeskatPar62ARenteInput) -> Falskt
| exception kildeskat_par62a_stk1_restskat_efter_september_forrentes kildeskat_par62a_rente_udløses(input: KildeskatPar62ARenteInput) -> Sandt under input.art == ÆndretRestskatEllerYderligereRestskat && input.udskrives_efter_september_systemdato
| exception kildeskat_par62a_stk2_tilbagebetaling_forrentes kildeskat_par62a_rente_udløses(input: KildeskatPar62ARenteInput) -> Sandt under input.art == ÆndretOverskydendeSkatSkalTilbagebetales
| exception kildeskat_par62a_stk3_nedsat_restskat_forrentes kildeskat_par62a_rente_udløses(input: KildeskatPar62ARenteInput) -> Sandt under input.art == ÆndretRestskatNedsatEllerBortfaldet
| kildeskat_par62a_rentegrundlag_kroner(input: KildeskatPar62ARenteInput) -> input.beløb_kroner + input.tillæg_eller_godtgørelse_kroner
| kildeskat_par62a_rente_kroner(input: KildeskatPar62ARenteInput) -> kildeskat_forsinkelsesrente_kroner(KildeskatForsinkelsesrenteInput(kildeskat_par62a_rentegrundlag_kroner(input), input.opkrævningslov_par7_stk2_rente_basispoint, input.påbegyndte_måneder_fra_1_september, kildeskat_par62a_rente_udløses(input)))
| kildeskat_par62a_tilbagebetalingskrav_stiftes_dagen_efter_indkomståret(art: KildeskatÆndretÅrsopgørelseArt) -> art == ÆndretOverskydendeSkatSkalTilbagebetales
| kildeskat_par62a_tilbagebetalingskrav_kan_betegnes_som_restskat(art: KildeskatÆndretÅrsopgørelseArt) -> art == ÆndretOverskydendeSkatSkalTilbagebetales
| kildeskat_par62a_nedsat_restskat_modregner_uforfalden_restskat(art: KildeskatÆndretÅrsopgørelseArt) -> art == ÆndretRestskatNedsatEllerBortfaldet
| kildeskat_par62a_forsinket_udbetalingsrente_kroner(input: KildeskatPar62AForsinketUdbetalingInput) -> 0
| exception kildeskat_par62a_forvaltning_vælger_samlet_udbetalingsgrundlag kildeskat_par62a_forsinket_udbetalingsrente_kroner(input: KildeskatPar62AForsinketUdbetalingInput) -> kildeskat_forsinkelsesrente_kroner(KildeskatForsinkelsesrenteInput(input.forventet_samlet_udbetaling_kroner, input.opkrævningslov_par7_stk2_rente_basispoint, input.ekstra_påbegyndte_måneder, Sandt)) under input.forvaltningen_vælger_samlet_beløb_som_grundlag && input.ekstra_påbegyndte_måneder > 0

| kildeskat_par62c_minimum_rate_kroner() -> 500
| kildeskat_par62c_restskat_opkræves(input: KildeskatPar62CMindreRestskatInput) -> Sandt
| exception kildeskat_par62c_lille_restskat_opkræves_ikke kildeskat_par62c_restskat_opkræves(input: KildeskatPar62CMindreRestskatInput) -> Falskt under input.ikke_indregnet_efter_par61_stk3 && input.restskat_tillæg_renter_kroner + input.tidligere_ikke_opkrævet_kroner < 500
| kildeskat_par62c_nemkonto_bortfaldsgrænse_kroner() -> 200
| kildeskat_par62c_nemkonto_beløb_bortfalder(beløb_kroner: Heltal, ikke_udbetalt_i_tre_måneder: Boolsk) -> ikke_udbetalt_i_tre_måneder && beløb_kroner <= 200
| kildeskat_par62c_opkrævning_i_hele_kroner(beløb_kroner: Heltal) -> beløb_kroner

----
§ 67. Har nogen, der er skattepligtig efter § 1 eller § 2, stk. 1, nr. 4,
erhvervet udbytte, hvori der efter § 65 er indeholdt udbytteskat, modregnes
udbytteskatten i slutskatten, jf. § 60, stk. 1, litra d. Er den indeholdte
udbytteskat endelig betaling af skatten, jf. personskattelovens § 8 a, stk. 1,
indgår beløbet ikke i slutskatten, og der foretages ikke modregning efter
1. pkt.

Stk. 5. For skattepligtige omfattet af § 1, stk. 1, udbetales udbytteskat, der
ikke kan modregnes i slutskatten, og som ikke er endelig efter
personskattelovens § 8 a, stk. 1, som overskydende skat efter reglerne i § 62 C.

Er udbyttemodtageren ikke omfattet af § 1, stk. 1, udbetales beløbet kun
kontant, hvis det udgør 25 kr. eller derover.
----

