        ),
        logidøgn = [
            Ligningslov9ALogidøgn(
                rejsedøgnsnummer = 1,
                dækning = Ll9ALogiIkkeDækketAfArbejdsgiver,
                godtgørelsesudbetaling = Ll9AUopdeltGodtgørelse(udbetalt_kroner = 0),
                dokumenteret_logiudgift_betalt_før_refusion_kroner = 300,
