    ),
    ekstern_udelukkelse = Ll9AIngenEksternUdelukkelse
)

| ll9a_scenarie_rejse_med_kost_og_logidøgn(identifikation: Tekst, varighed_minutter: Heltal, kost: Ligningslov9AKostfakta, logidøgn: List(Ligningslov9ALogidøgn)) -> Ligningslov9ARejsefakta(
    identifikation = identifikation,
    indkomstår = 2026,
    startdato = ll9a_scenarie_almindelig_startdato,
    rejseart = Ll9ATjenesterejse,
