@ sprog da

@ importer ./ligningsloven - par9a - rejser

# Ll9AScenarieGodtgørelse(kost_kroner: Heltal, logi_kroner: Heltal, kontrol: Ligningslov9AGodtgørelseskontrol)
# Ll9AÅrsforventning(indkomstår: Heltal, lovversion: Ligningslov9ALovversion, satsversion: Ligningslov9ASatsversion, reguleringstalskilde: Par20ReguleringstalKilde, reguleringstal_tiendedele: Heltal, kostsats_kroner: Heltal, logisats_kroner: Heltal, årsloft_kroner: Heltal, rejsefradrag_kroner: Heltal)

| ll9a_scenarie_godtgørelse(kost_kroner: Heltal, logi_kroner: Heltal, kontrol: Ligningslov9AGodtgørelseskontrol) -> Ll9AScenarieGodtgørelse(
    kost_kroner = kost_kroner,
    logi_kroner = logi_kroner,
    kontrol = kontrol
)

| ll9a_scenarie_logidøgn(antal_døgn: Heltal, samlet_logigodtgørelse_kroner: Heltal, samlede_dokumenterede_logiudgifter_kroner: Heltal, fradragsprincip: Ligningslov9ALogifradragsprincip) -> hvis antal_døgn > 0 { map(range(1, antal_døgn + 1), |rejsedøgnsnummer: Heltal| Ligningslov9ALogidøgn(
    rejsedøgnsnummer = rejsedøgnsnummer,
    dækning = Ll9ALogiIkkeDækketAfArbejdsgiver,
    godtgørelsesudbetaling = Ll9AUopdeltGodtgørelse(
        udbetalt_kroner = samlet_logigodtgørelse_kroner / antal_døgn + hvis rejsedøgnsnummer <= samlet_logigodtgørelse_kroner % antal_døgn { 1 } ellers { 0 }
    ),
    dokumenteret_logiudgift_betalt_før_refusion_kroner = samlede_dokumenterede_logiudgifter_kroner / antal_døgn + hvis rejsedøgnsnummer <= samlede_dokumenterede_logiudgifter_kroner % antal_døgn { 1 } ellers { 0 },
    fradragsprincip = fradragsprincip
)) } ellers { [] }

| ll9a_scenarie_rejse(
    identifikation: Tekst,
    arbejdssted_identifikation: Tekst,
    arbejdsstedskarakter: Ligningslov9AArbejdsstedskarakter,
    startdato: Dato,
    hverv: Ligningslov9AHverv,
    varighed_minutter: Heltal,
    godtgørelse: Ll9AScenarieGodtgørelse,
    kostfradragsprincip: Ligningslov9AKostfradragsprincip,
    logifradragsprincip: Ligningslov9ALogifradragsprincip,
    indkomstforhold: Ligningslov9AIndkomstforhold
) -> Ligningslov9ARejsefakta(
    identifikation = identifikation,
    indkomstår = 2026,
    startdato = startdato,
    rejseart = Ll9ATjenesterejse,
    arbejdssted_identifikation = arbejdssted_identifikation,
    arbejdsstedskarakter = arbejdsstedskarakter,
    overnatningsforhold = Ll9AIngenMulighedForOvernatningPåSædvanligBopæl(
        afstand_ad_normal_transportvej_kilometer = 350,
        korteste_transporttid_hver_vej_minutter = 240
    ),
    hverv = hverv,
    varighed_minutter = varighed_minutter,
    kost = Ligningslov9AKostfakta(
        dækning = Ll9AKostIkkeDækketEfterRegning,
        godtgørelsesudbetaling = Ll9AUopdeltGodtgørelse(udbetalt_kroner = godtgørelse.kost_kroner),
        fri_morgenmad_antal = 0,
        fri_frokost_antal = 0,
        fri_aftensmad_antal = 0,
        dokumenterede_kostudgifter_før_arbejdsgiverdækning_kroner = 1600,
        fradragsprincip = kostfradragsprincip
    ),
    logidøgn = ll9a_scenarie_logidøgn(
        antal_døgn = ligningslov9a_fulde_døgn(varighed_minutter),
        samlet_logigodtgørelse_kroner = godtgørelse.logi_kroner,
        samlede_dokumenterede_logiudgifter_kroner = 900,
        fradragsprincip = logifradragsprincip
    ),
    kontrol = godtgørelse.kontrol,
    lønomlægning = Ll9AGodtgørelseUdenLønomlægning,
    indkomstforhold = indkomstforhold
)

| ll9a_scenarie_rejse_i_indkomstår(fakta: Ligningslov9ARejsefakta, indkomstår: Heltal) -> Ligningslov9ARejsefakta(
    identifikation = fakta.identifikation,
    indkomstår = indkomstår,
    startdato = Dato(år = indkomstår, måned = fakta.startdato.måned, dag = fakta.startdato.dag),
    rejseart = fakta.rejseart,
    arbejdssted_identifikation = fakta.arbejdssted_identifikation,
    arbejdsstedskarakter = fakta.arbejdsstedskarakter,
    overnatningsforhold = fakta.overnatningsforhold,
    hverv = fakta.hverv,
    varighed_minutter = fakta.varighed_minutter,
    kost = fakta.kost,
    logidøgn = fakta.logidøgn,
    kontrol = fakta.kontrol,
    lønomlægning = fakta.lønomlægning,
    indkomstforhold = fakta.indkomstforhold
)
| ll9a_scenarie_rejse_med_art(fakta: Ligningslov9ARejsefakta, rejseart: Ligningslov9ARejseart) -> Ligningslov9ARejsefakta(
    identifikation = fakta.identifikation,
    indkomstår = fakta.indkomstår,
    startdato = fakta.startdato,
    rejseart = rejseart,
    arbejdssted_identifikation = fakta.arbejdssted_identifikation,
    arbejdsstedskarakter = fakta.arbejdsstedskarakter,
    overnatningsforhold = fakta.overnatningsforhold,
    hverv = fakta.hverv,
    varighed_minutter = fakta.varighed_minutter,
    kost = fakta.kost,
    logidøgn = fakta.logidøgn,
    kontrol = fakta.kontrol,
    lønomlægning = fakta.lønomlægning,
    indkomstforhold = fakta.indkomstforhold
)
| ll9a_scenarie_kort_tjenesterejse(identifikation: Tekst, startdato: Dato) -> ll9a_scenarie_rejse(
    identifikation = identifikation,
    arbejdssted_identifikation = "projektsted-a",
    arbejdsstedskarakter = Ll9AStedbundetArbejdssted(tidsbegrænsning = Ll9ATidsbegrænsetTilKonkretOpgavesFærdiggørelse),
    startdato = startdato,
    hverv = Ll9AAlmindeligtHverv,
    varighed_minutter = 2880,
    godtgørelse = ll9a_scenarie_godtgørelse(500, 0, Ll9AArbejdsgiverkontrolUdført),
    kostfradragsprincip = Ll9AKostfradragMedStandardsats,
    logifradragsprincip = Ll9AIntetLogifradrag,
    indkomstforhold = Ll9ADanskSkattepligtigArbejdsindkomst
)

| ll9a_scenarie_tom_arbejdshistorik() -> Ligningslov9AArbejdshistorik(
    tidligere_rejser = [],
    arbejdsdage = [],
    arbejdsstedsafstande = []
)
| ll9a_scenarie_årsresultat_med_ølogi(personrolle: Ligningslov9APersonrolle, rejser: List(Ligningslov9ARejsefakta), ølogi: Ligningslov9AØlogiInput, dobbelt_husførelse: Ligningslov9ADobbeltHusførelse, ekstern_udelukkelse: Ligningslov9AEksternUdelukkelse) -> ligningslov9a_årsresultat(
    indkomstår = 2026,
    input = Ligningslov9AÅrsinput(
        personrolle = personrolle,
        rejser = rejser,
        udenlandske_indkomstkilder = [],
        arbejdshistorik = ll9a_scenarie_tom_arbejdshistorik(),
        ølogi = ølogi,
        dobbelt_husførelse = dobbelt_husførelse
    ),
    ekstern_udelukkelse = ekstern_udelukkelse
)
| ll9a_scenarie_årsresultat_med_historik_og_indkomstkilder(rejser: List(Ligningslov9ARejsefakta), udenlandske_indkomstkilder: List(Ligningslov9AUdenlandskIndkomstkilde), arbejdshistorik: Ligningslov9AArbejdshistorik, dobbelt_husførelse: Ligningslov9ADobbeltHusførelse, ekstern_udelukkelse: Ligningslov9AEksternUdelukkelse) -> ligningslov9a_årsresultat(
    indkomstår = 2026,
    input = Ligningslov9AÅrsinput(
        personrolle = Ll9AAlmindeligLønmodtager,
        rejser = rejser,
        udenlandske_indkomstkilder = udenlandske_indkomstkilder,
        arbejdshistorik = arbejdshistorik,
        ølogi = UdenØlogifradrag,
        dobbelt_husførelse = dobbelt_husførelse
    ),
    ekstern_udelukkelse = ekstern_udelukkelse
)
| ll9a_scenarie_årsresultat_med_historik(rejser: List(Ligningslov9ARejsefakta), arbejdshistorik: Ligningslov9AArbejdshistorik, dobbelt_husførelse: Ligningslov9ADobbeltHusførelse, ekstern_udelukkelse: Ligningslov9AEksternUdelukkelse) -> ll9a_scenarie_årsresultat_med_historik_og_indkomstkilder(
    rejser = rejser,
    udenlandske_indkomstkilder = [],
    arbejdshistorik = arbejdshistorik,
    dobbelt_husførelse = dobbelt_husførelse,
    ekstern_udelukkelse = ekstern_udelukkelse
)
| ll9a_scenarie_årsresultat(rejser: List(Ligningslov9ARejsefakta), dobbelt_husførelse: Ligningslov9ADobbeltHusførelse, ekstern_udelukkelse: Ligningslov9AEksternUdelukkelse) -> ll9a_scenarie_årsresultat_med_historik(
    rejser = rejser,
    arbejdshistorik = ll9a_scenarie_tom_arbejdshistorik(),
    dobbelt_husførelse = dobbelt_husførelse,
    ekstern_udelukkelse = ekstern_udelukkelse
)
| ll9a_scenarie_årsresultat_i_indkomstår(indkomstår: Heltal, rejser: List(Ligningslov9ARejsefakta)) -> ligningslov9a_årsresultat(
    indkomstår = indkomstår,
    input = Ligningslov9AÅrsinput(
        personrolle = Ll9AAlmindeligLønmodtager,
        rejser = rejser,
        udenlandske_indkomstkilder = [],
        arbejdshistorik = ll9a_scenarie_tom_arbejdshistorik(),
        ølogi = UdenØlogifradrag,
        dobbelt_husførelse = Ll9AIntetFradragForDobbeltHusførelse
    ),
    ekstern_udelukkelse = Ll9AIngenEksternUdelukkelse
)
| ll9a_scenarie_årsresultat_med_udelukkelseskontekst(rejser: List(Ligningslov9ARejsefakta), udelukkelseskontekst: Ligningslov9AUdelukkelseskontekst) -> ligningslov9a_årsresultat_med_udelukkelseskontekst(
    indkomstår = 2026,
    input = Ligningslov9AÅrsinput(
        personrolle = Ll9AAlmindeligLønmodtager,
        rejser = rejser,
        udenlandske_indkomstkilder = [],
        arbejdshistorik = ll9a_scenarie_tom_arbejdshistorik(),
        ølogi = UdenØlogifradrag,
        dobbelt_husførelse = Ll9AIntetFradragForDobbeltHusførelse
    ),
    udelukkelseskontekst = udelukkelseskontekst
)
| ll9a_scenarie_årsresultat_med_indkomstkilder(rejser: List(Ligningslov9ARejsefakta), udenlandske_indkomstkilder: List(Ligningslov9AUdenlandskIndkomstkilde), dobbelt_husførelse: Ligningslov9ADobbeltHusførelse, ekstern_udelukkelse: Ligningslov9AEksternUdelukkelse) -> ll9a_scenarie_årsresultat_med_historik_og_indkomstkilder(
    rejser = rejser,
    udenlandske_indkomstkilder = udenlandske_indkomstkilder,
    arbejdshistorik = ll9a_scenarie_tom_arbejdshistorik(),
    dobbelt_husførelse = dobbelt_husførelse,
    ekstern_udelukkelse = ekstern_udelukkelse
)

= ll9a_scenarie_almindelig_startdato = Dato(år = 2026, måned = 3, dag = 1)

| ll9a_scenarie_dobbelt_husførelse(identifikation: Tekst, fra_dato: Dato, til_dato: Dato, antal_hele_uger: Heltal) -> Ll9ADobbeltHusførelseEfterStatsskattelov6(input = Statsskattelov6DobbeltHusførelseÅrsinput(
    personkreds = Sl6DhGift,
    ophold = [Statsskattelov6DobbeltHusførelseOphold(
        identifikation = identifikation,
        arbejdssted_identifikation = "tidsbegrænset-arbejdssted",
        oprindelig_startdato = fra_dato,
        fradragsperiode_fra_dato = fra_dato,
        fradragsperiode_til_dato = til_dato,
        erhvervsårsag = Sl6DhSkatteydersEgetArbejdsforhold,
        midlertidighed = Sl6DhMidlertidigtArbejde(
            art = Sl6DhTidsbegrænsetAnsættelse,
            aftalt_fra_dato = Dato(år = 2026, måned = 1, dag = 1),
            aftalt_til_dato = Dato(år = 2026, måned = 12, dag = 31)
        ),
        daglig_transport = Statsskattelov6DobbeltHusførelseDagligTransport(
            vurdering = Sl6DhDagligTransportIkkeRimeligEfterKonkretVurdering,
            afstand_mellem_boliger_kilometer = 250,
            samlet_transporttid_pr_dag_minutter = 360,
            arbejdstid_pr_dag_minutter = 480
        ),
        hjemmebolig = Sl6DhDanskFamilieboligOpretholdt,
        hjemlandsophold = [],
        arbejdsboligform = Sl6DhPrivatIndkvartering,
        merudgiftsforhold = Sl6DhMerudgifterTilKostEllerBoligAfholdt,
        arbejdsgiverdækning = Sl6DhIngenArbejdsgiverdækning,
        opgørelsesmetode = Sl6DhStandardbeløb(antal_hele_uger = antal_hele_uger),
        toårsgrænse = Sl6DhAlmindeligToårsgrænse
    )]
))
= ll9a_scenarie_efter_tolv_måneder_startdato = Dato(år = 2026, måned = 1, dag = 15)
= ll9a_scenarie_tilbagevending_startdato = Dato(år = 2026, måned = 2, dag = 1)
= ll9a_scenarie_efter_tolv_måneder_historik = Ligningslov9AArbejdshistorik(
    tidligere_rejser = [Ligningslov9APerioderejse(
        identifikation = "periode-start-2025",
        startdato = Dato(år = 2025, måned = 1, dag = 15),
        arbejdssted_identifikation = "projektsted-a",
        rejseart = Ll9APeriodeTjenesterejse,
        varighed_minutter = 86400
    )],
    arbejdsdage = [],
    arbejdsstedsafstande = []
)
= ll9a_scenarie_fyrre_arbejdsdage_historik = Ligningslov9AArbejdshistorik(
    tidligere_rejser = [
        Ligningslov9APerioderejse(identifikation = "a-før", startdato = Dato(år = 2025, måned = 1, dag = 1), arbejdssted_identifikation = "projektsted-a", rejseart = Ll9APeriodeTjenesterejse, varighed_minutter = 86400),
        Ligningslov9APerioderejse(identifikation = "b-mellem", startdato = Dato(år = 2025, måned = 2, dag = 1), arbejdssted_identifikation = "projektsted-b", rejseart = Ll9APeriodeTjenesterejse, varighed_minutter = 86400)
    ],
    arbejdsdage = map(range(0, 40), |dagnummer: Heltal| Ligningslov9AArbejdsdag(
        dato = dato_plus_dage(Dato(år = 2025, måned = 3, dag = 1), dagnummer),
        sted = Ll9AArbejdePåReeltArbejdssted(arbejdssted_identifikation = "projektsted-b")
    )),
    arbejdsstedsafstande = [Ligningslov9AArbejdsstedsafstand(
        fra_arbejdssted_identifikation = "projektsted-a",
        til_arbejdssted_identifikation = "projektsted-b",
        gældende_fra = Dato(år = 2025, måned = 1, dag = 1),
        afstand_ad_normal_transportvej_kilometer = 20
    )]
)
= ll9a_scenarie_manglende_afstand_historik = Ligningslov9AArbejdshistorik(
    tidligere_rejser = [Ligningslov9APerioderejse(
        identifikation = "a-før-manglende-afstand",
        startdato = Dato(år = 2025, måned = 1, dag = 1),
        arbejdssted_identifikation = "projektsted-a",
        rejseart = Ll9APeriodeTjenesterejse,
        varighed_minutter = 86400
    )],
    arbejdsdage = [],
    arbejdsstedsafstande = []
)

= ll9a_scenarie_almindelig_rejse = ll9a_scenarie_rejse(
    identifikation = "almindelig",
    arbejdssted_identifikation = "projektsted-a",
    arbejdsstedskarakter = Ll9AStedbundetArbejdssted(tidsbegrænsning = Ll9ATidsbegrænsetTilKonkretOpgavesFærdiggørelse),
    startdato = ll9a_scenarie_almindelig_startdato,
    hverv = Ll9AAlmindeligtHverv,
    varighed_minutter = 2880,
    godtgørelse = ll9a_scenarie_godtgørelse(500, 300, Ll9AArbejdsgiverkontrolUdført),
    kostfradragsprincip = Ll9AKostfradragMedStandardsats,
    logifradragsprincip = Ll9ALogifradragMedStandardsats,
    indkomstforhold = Ll9ADanskSkattepligtigArbejdsindkomst
)
= ll9a_scenarie_almindeligt_resultat = ll9a_scenarie_årsresultat(
    [ll9a_scenarie_almindelig_rejse],
    Ll9AIntetFradragForDobbeltHusførelse,
    Ll9AIngenEksternUdelukkelse
)

= ll9a_scenarie_årsforventninger = [
    Ll9AÅrsforventning(
        indkomstår = 2023,
        lovversion = Ll9ALbk42Af2023,
        satsversion = Ll9ASkm2022_613Sktst,
        reguleringstalskilde = SkatteministerietPar20HistoriskOversigt,
        reguleringstal_tiendedele = 1218,
        kostsats_kroner = 555,
        logisats_kroner = 238,
        årsloft_kroner = 30500,
        rejsefradrag_kroner = 786
    ),
    Ll9AÅrsforventning(
        indkomstår = 2024,
        lovversion = Ll9ALbk42Af2023,
        satsversion = Ll9ASkm2023_613Sktst,
        reguleringstalskilde = SkatteministerietPar20HistoriskOversigt,
        reguleringstal_tiendedele = 1261,
        kostsats_kroner = 574,
        logisats_kroner = 246,
        årsloft_kroner = 31600,
        rejsefradrag_kroner = 840
    ),
    Ll9AÅrsforventning(
        indkomstår = 2025,
        lovversion = Ll9ALbk42Af2023,
        satsversion = Ll9ASkm2024_643Sktst,
        reguleringstalskilde = SkatteministerietPar20Beløbsgrænser2025_2026,
        reguleringstal_tiendedele = 1310,
        kostsats_kroner = 597,
        logisats_kroner = 256,
        årsloft_kroner = 32800,
        rejsefradrag_kroner = 906
    ),
    Ll9AÅrsforventning(
        indkomstår = 2026,
        lovversion = Ll9ALbk1500Af2025,
        satsversion = Ll9ASkm2025_725Sktst,
        reguleringstalskilde = SkatteministerietPar20Beløbsgrænser2025_2026,
        reguleringstal_tiendedele = 1373,
        kostsats_kroner = 625,
        logisats_kroner = 268,
        årsloft_kroner = 34400,
        rejsefradrag_kroner = 986
    )
]

| ll9a_scenarie_årsforventning_holder(forventning: Ll9AÅrsforventning) -> {
    = resultat = ll9a_scenarie_årsresultat_i_indkomstår(
        indkomstår = forventning.indkomstår,
        rejser = [ll9a_scenarie_rejse_i_indkomstår(ll9a_scenarie_almindelig_rejse, forventning.indkomstår)]
    )
    = satser = resultat.satser
    resultat.alle_input_gyldige && resultat.skatteår_understøttet && satser.skatteår_understøttet && satser.lovversion == forventning.lovversion && satser.satsversion == forventning.satsversion && satser.kost_og_småfornødenheder_pr_døgn_kroner == forventning.kostsats_kroner && satser.logi_pr_døgn_kroner == forventning.logisats_kroner && satser.årligt_fælles_fradragsloft_kroner == forventning.årsloft_kroner && resultat.samlet_skattefri_godtgørelse_kroner == 800 && resultat.samlet_rejsefradrag_efter_årsloft_kroner == forventning.rejsefradrag_kroner && match satser.reguleringstal {
        | Some(reguleringstal) -> reguleringstal.kilde == forventning.reguleringstalskilde && reguleringstal.reguleringstal_tiendedele == forventning.reguleringstal_tiendedele
        | None -> Falskt
    } && match satser.kostregulering {
        | Some(regulering) -> regulering.grundbeløb_2010_niveau_kroner == 455 && regulering.reguleret_og_oprundet_kroner == forventning.kostsats_kroner
        | None -> Falskt
    } && match satser.logiregulering {
        | Some(regulering) -> regulering.grundbeløb_2010_niveau_kroner == 195 && regulering.reguleret_og_oprundet_kroner == forventning.logisats_kroner
        | None -> Falskt
    } && match satser.fradragsloftregulering {
        | Some(regulering) -> regulering.grundbeløb_2010_niveau_kroner == 25000 && regulering.reguleret_og_afrundet_kroner == forventning.årsloft_kroner
        | None -> Falskt
    }
}

= ll9a_scenarie_faktiske_udgifter_resultat = ll9a_scenarie_årsresultat(
    [ll9a_scenarie_rejse(
        identifikation = "faktiske-udgifter",
        arbejdssted_identifikation = "projektsted-a",
        arbejdsstedskarakter = Ll9AStedbundetArbejdssted(tidsbegrænsning = Ll9ATidsbegrænsetTilBestemtPeriode),
        startdato = ll9a_scenarie_almindelig_startdato,
        hverv = Ll9AAlmindeligtHverv,
        varighed_minutter = 2880,
        godtgørelse = ll9a_scenarie_godtgørelse(500, 300, Ll9AArbejdsgiverkontrolUdført),
        kostfradragsprincip = Ll9AKostfradragMedDokumenteredeUdgifter,
        logifradragsprincip = Ll9ALogifradragMedDokumenteredeUdgifter,
        indkomstforhold = Ll9ADanskSkattepligtigArbejdsindkomst
    )],
    Ll9AIntetFradragForDobbeltHusførelse,
