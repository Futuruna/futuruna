@ sprog da

@ importer ./loenmodtager_beregning

-- Personskatteloven — executable ordinary wage-earner fixtures.

----
Fixture 1
Skatteår: 2025
Kommune: København
Bruttoløn: 500.000 kr.
Positiv nettokapitalindkomst: 0 kr.
Ligningsmæssige fradrag: 0 kr.
Kirkeskat: ja
Kilder: Personskatteloven §§ 1, 3, 6, 7 og 9; Skattestyrelsens 2025-satser;
Skatteministeriets kommuneskat for København 2025.
----

= m4_københavn_2025_input = LønmodtagerInput(2025, København, 500000, 0, 0, Fyldt18EllerGift, Sandt)
= m4_københavn_2025 = beregn_lønmodtager(m4_københavn_2025_input)

| m4_københavn_2025_am: m4_københavn_2025 -> m4_københavn_2025.arbejdsmarkedsbidrag_kroner == 40000
| m4_københavn_2025_personlig: m4_københavn_2025 -> m4_københavn_2025.personlig_indkomst_efter_am_kroner == 460000
| m4_københavn_2025_bundskat: m4_københavn_2025 -> m4_københavn_2025.bundskat_før_personfradrag_kroner == 55246
| m4_københavn_2025_topskat: m4_københavn_2025 -> m4_københavn_2025.topskat_før_personfradrag_kroner == 0
| m4_københavn_2025_kommuneskat: m4_københavn_2025 -> m4_københavn_2025.kommuneskat_før_personfradrag_kroner == 108100
| m4_københavn_2025_kirkeskat: m4_københavn_2025 -> m4_københavn_2025.kirkeskat_før_personfradrag_kroner == 3680
| m4_københavn_2025_samlet_før: m4_københavn_2025 -> m4_københavn_2025.samlet_inkl_am_før_personfradrag_kroner == 207026
| m4_københavn_2025_personfradrag: m4_københavn_2025 -> m4_københavn_2025.personfradrag_kroner == 51600
| m4_københavn_2025_statslig_skatteværdi: m4_københavn_2025 -> m4_københavn_2025.statslig_personfradrag_skatteværdi_kroner == 6197
| m4_københavn_2025_kommunal_skatteværdi: m4_københavn_2025 -> m4_københavn_2025.kommunal_personfradrag_skatteværdi_kroner == 12126
| m4_københavn_2025_kirkelig_skatteværdi: m4_københavn_2025 -> m4_københavn_2025.kirkelig_personfradrag_skatteværdi_kroner == 412
| m4_københavn_2025_samlet_efter: m4_københavn_2025 -> m4_københavn_2025.samlet_inkl_am_efter_personfradrag_kroner == 188291
| m4_københavn_2025_personfradrag_anvendt: m4_københavn_2025 -> m4_københavn_2025.personfradrag_anvendt_i_slutskat == Sandt
| m4_københavn_2025_uden_par13_underskud: m4_københavn_2025 -> m4_københavn_2025.kræver_par13_underskud == Falskt

? m4_københavn_2025_am
? m4_københavn_2025_personlig
? m4_københavn_2025_bundskat
? m4_københavn_2025_topskat
? m4_københavn_2025_kommuneskat
? m4_københavn_2025_kirkeskat
? m4_københavn_2025_samlet_før
? m4_københavn_2025_personfradrag
? m4_københavn_2025_statslig_skatteværdi
? m4_københavn_2025_kommunal_skatteværdi
? m4_københavn_2025_kirkelig_skatteværdi
? m4_københavn_2025_samlet_efter
? m4_københavn_2025_personfradrag_anvendt
? m4_københavn_2025_uden_par13_underskud

----
Fixture 2
Skatteår: 2025
Kommune: Gentofte
Bruttoløn: 750.000 kr.
Positiv nettokapitalindkomst: 20.000 kr.
Ligningsmæssige fradrag: 10.000 kr.
Kirkeskat: ja
Kilder: Personskatteloven §§ 1, 3, 6, 7 og 9; Skattestyrelsens 2025-satser;
Skatteministeriets kommuneskat for Gentofte 2025.
----

= m4_gentofte_2025_input = LønmodtagerInput(2025, Gentofte, 750000, 20000, 10000, Fyldt18EllerGift, Sandt)
= m4_gentofte_2025 = beregn_lønmodtager(m4_gentofte_2025_input)

| m4_gentofte_2025_am: m4_gentofte_2025 -> m4_gentofte_2025.arbejdsmarkedsbidrag_kroner == 60000
| m4_gentofte_2025_personlig: m4_gentofte_2025 -> m4_gentofte_2025.personlig_indkomst_efter_am_kroner == 690000
| m4_gentofte_2025_almindelig: m4_gentofte_2025 -> m4_gentofte_2025.almindelig_skattepligtig_indkomst_kroner == 700000
| m4_gentofte_2025_bundskat: m4_gentofte_2025 -> m4_gentofte_2025.bundskat_før_personfradrag_kroner == 85271
| m4_gentofte_2025_topskat: m4_gentofte_2025 -> m4_gentofte_2025.topskat_før_personfradrag_kroner == 11730
| m4_gentofte_2025_kommuneskat: m4_gentofte_2025 -> m4_gentofte_2025.kommuneskat_før_personfradrag_kroner == 169680
| m4_gentofte_2025_kirkeskat: m4_gentofte_2025 -> m4_gentofte_2025.kirkeskat_før_personfradrag_kroner == 2730
| m4_gentofte_2025_samlet_før: m4_gentofte_2025 -> m4_gentofte_2025.samlet_inkl_am_før_personfradrag_kroner == 329411
| m4_gentofte_2025_personfradrag: m4_gentofte_2025 -> m4_gentofte_2025.personfradrag_kroner == 51600
| m4_gentofte_2025_statslig_skatteværdi: m4_gentofte_2025 -> m4_gentofte_2025.statslig_personfradrag_skatteværdi_kroner == 6197
| m4_gentofte_2025_kommunal_skatteværdi: m4_gentofte_2025 -> m4_gentofte_2025.kommunal_personfradrag_skatteværdi_kroner == 12507
| m4_gentofte_2025_kirkelig_skatteværdi: m4_gentofte_2025 -> m4_gentofte_2025.kirkelig_personfradrag_skatteværdi_kroner == 201
| m4_gentofte_2025_samlet_efter: m4_gentofte_2025 -> m4_gentofte_2025.samlet_inkl_am_efter_personfradrag_kroner == 310506
| m4_gentofte_2025_personfradrag_anvendt: m4_gentofte_2025 -> m4_gentofte_2025.personfradrag_anvendt_i_slutskat == Sandt
| m4_gentofte_2025_uden_par13_underskud: m4_gentofte_2025 -> m4_gentofte_2025.kræver_par13_underskud == Falskt

? m4_gentofte_2025_am
? m4_gentofte_2025_personlig
? m4_gentofte_2025_almindelig
? m4_gentofte_2025_bundskat
? m4_gentofte_2025_topskat
? m4_gentofte_2025_kommuneskat
? m4_gentofte_2025_kirkeskat
? m4_gentofte_2025_samlet_før
? m4_gentofte_2025_personfradrag
? m4_gentofte_2025_statslig_skatteværdi
? m4_gentofte_2025_kommunal_skatteværdi
? m4_gentofte_2025_kirkelig_skatteværdi
? m4_gentofte_2025_samlet_efter
? m4_gentofte_2025_personfradrag_anvendt
? m4_gentofte_2025_uden_par13_underskud

@ print("m4 København 2025 samlet inkl. AM efter personfradrag: " + vis(m4_københavn_2025.samlet_inkl_am_efter_personfradrag_kroner))
@ print("m4 Gentofte 2025 samlet inkl. AM efter personfradrag: " + vis(m4_gentofte_2025.samlet_inkl_am_efter_personfradrag_kroner))
