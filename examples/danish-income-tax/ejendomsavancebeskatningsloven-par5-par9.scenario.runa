            tillæg_for_genanbragt_del_kroner = 0,
            nedslag_for_genanbragt_del_kroner = 0
        )
    ),
    afstået_ejendoms_erhvervsanvendelse = afstået_ejendoms_anvendelse,
    investering = EblPar6AInvestering(
        indkomstår = 2025,
        erhvervsmæssigt_anskaffelsesgrundlag_kroner = erhvervsmæssigt_anskaffelsesgrundlag_kroner,
        ejendomsstatus = EblPar6AEjendomOmfattetAfLovenIkkePar8,
        erhvervsanvendelse = erhvervet_ejendoms_anvendelse,
        placering = placering
    ),
    begæring = EblPar6ABegæringVedRettidigAfgivelseEfterSkattekontrollovensPar2,
    ejerskab = EblPar6ASammeSkattepligtige
)
| ebl_scenarie_par6a_fakta(erhvervsfortjeneste_kroner: Heltal, erhvervsmæssigt_anskaffelsesgrundlag_kroner: Heltal, erhvervet_ejendoms_anvendelse: EblPar6AErhvervsanvendelse) -> ebl_scenarie_par6a_fakta_med_forhold(
