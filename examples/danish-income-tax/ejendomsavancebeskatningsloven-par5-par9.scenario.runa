| ebl_scenarie_par6a_fakta_med_forhold(erhvervsfortjeneste_kroner: Heltal, erhvervsmæssigt_anskaffelsesgrundlag_kroner: Heltal, afstået_ejendoms_anvendelse: EblPar6AErhvervsanvendelse, erhvervet_ejendoms_anvendelse: EblPar6AErhvervsanvendelse, placering: EblPar6AEjendomsplacering) -> EblPar6AFakta(
    oprindelig_fortjeneste = EblOprindeligErhvervsfortjeneste(
        afståelsesindkomstår = 2024,
        erhvervsfortjeneste_før_par6_stk2_kroner = erhvervsfortjeneste_kroner,
