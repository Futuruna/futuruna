@ sprog da

@ importer ./personskat.calculate

----
Fokuserede regressionsscenarier for den kanoniske beregningsgrænse.

Scenarierne er ikke lovtekst. De fastholder, at borgerens kildefakta om
udlejning efter ligningslovens § 15 Q går gennem beregn_personskat, og at
Futuruna selv afleder fradrag, kapitalindkomst og ugyldige metodevalg.
----

| personskat_fremleje_scenarie_input(fremleje: PersonskatFremlejeInput) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 600000,
        personlig_indkomst = personskat_ingen_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = PersonskatKapitalindkomstInput(
        renter = PersonskatRenteInput(
            renteindtægter_kroner = 0,
            renteudgifter_kroner = 0,
            næringsstatus = IkkeNæring,
            ligningslov6 = UdenLigningslov6Kurstab,
            ligningslov6a = UdenLigningslov6AFradrag
        ),
        virksomhedskapital = personskat_ingen_virksomhedskapital(),
        pbl53a = personskat_ingen_pbl53a(),
        ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
        ejendomsavance = UdenEjendomsavance,
        kursgevinst = UdenKursgevinst,
        fremleje = fremleje,
        omkostninger = []
    ),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_fremleje_scenarie_fakta(bruttolejeindtægt_kroner: Heltal, tidligere_anvendt_par15p_stk3: Boolsk, stk4_samordning: PersonskatLigningslov15QStk4Input) -> PersonskatFremlejeFakta(
    rolle = PersonskatFremlejendeLejer,
    udlejningsform = Ll15QVærelserIHelårsbolig,
    boligstatus = Ll15QHelårsbolig,
    indberetningsstatus = Ll15QIndberettetEfterSkatteindberetningslov43,
    metode = Ll15QStk1Bundfradrag,
    bruttolejeindtægt_kroner = bruttolejeindtægt_kroner,
    faktiske_udgifter_kroner = 0,
    tidligere_anvendt_par15p_stk3 = tidligere_anvendt_par15p_stk3,
    stk4_samordning = stk4_samordning
)

= personskat_fremleje_almindelige_kildefakta = personskat_fremleje_scenarie_fakta(
    bruttolejeindtægt_kroner = 60000,
    tidligere_anvendt_par15p_stk3 = Falskt,
    stk4_samordning = UdenSamordningMedLigningslov15P
)
= personskat_fremleje_samordnede_kildefakta = personskat_fremleje_scenarie_fakta(
    bruttolejeindtægt_kroner = 32500,
    tidligere_anvendt_par15p_stk3 = Falskt,
    stk4_samordning = MedSamordningMedLigningslov15P(
        par15q_udlejningsdage = 65,
        par15p_fakta = PersonskatLigningslov15PSamordningsfakta(
            udlejningsform = Ll15PHeleBoligen,
            bruttolejeindtægt_kroner = 300000,
            årlig_leje_eller_boligafgift_kroner = 60000,
            samme_personer_mindst_fire_måneder = Sandt,
            lejet_eller_ejet_dage = 365,
            udlejningsdage = 300
        ),
        loftvalg = Ll15QStk4BevarPar15QAndel
    )
)
= personskat_fremleje_ugyldige_kildefakta = personskat_fremleje_scenarie_fakta(
    bruttolejeindtægt_kroner = 60000,
    tidligere_anvendt_par15p_stk3 = Sandt,
    stk4_samordning = UdenSamordningMedLigningslov15P
)

| personskat_fremleje_afledes_fra_kildefakta: personskat_fremleje_almindelige_kildefakta -> {
    = resultat = beregn_personskat(personskat_fremleje_scenarie_input(MedFremlejeEfterLigningslov15Q(fakta = personskat_fremleje_almindelige_kildefakta)))
    resultat.kapitalindkomst.fremleje_input_gyldigt && resultat.kapitalindkomst.alle_input_gyldige && resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 14940 && resultat.skat.nettokapitalindkomst_kroner == 14940 && match resultat.kapitalindkomst.fremleje_resultat {
        | BeregnetFremlejeEfterLigningslov15Q(_, _, ligningslov15q_resultat, par4_resultat) -> ligningslov15q_resultat.reguleret_bundfradrag_kroner == 35100 && ligningslov15q_resultat.fradrag_i_indkomstopgørelse_kroner == 45060 && ligningslov15q_resultat.overskud_efter_ligningslov15q_kroner == 14940 && par4_resultat.kapitalindkomst_kroner == 14940
        | _ -> Falskt
    }
}
| personskat_fremleje_stk4_samordnes_fra_kildefakta: personskat_fremleje_samordnede_kildefakta -> {
    = resultat = beregn_personskat(personskat_fremleje_scenarie_input(MedFremlejeEfterLigningslov15Q(fakta = personskat_fremleje_samordnede_kildefakta)))
    resultat.kapitalindkomst.fremleje_input_gyldigt && resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 15709 && match resultat.kapitalindkomst.fremleje_resultat {
        | BeregnetFremlejeEfterLigningslov15Q(_, ligningslov15q_input, ligningslov15q_resultat, par4_resultat) -> ligningslov15q_input.stk4_samordning.par15p_resultat.fuldt_bundfradrag_kroner == 40000 && ligningslov15q_resultat.stk4.par15q_andel_basispoint == 1800 && ligningslov15q_resultat.stk4.par15p_andel_basispoint == 8200 && ligningslov15q_resultat.stk4.par15q_bundfradrag_efter_stk4_kroner == 6318 && par4_resultat.kapitalindkomst_kroner == 15709
        | _ -> Falskt
    }
}
| personskat_fremleje_ugyldigt_valg_afvises: personskat_fremleje_ugyldige_kildefakta -> {
    = resultat = beregn_personskat(personskat_fremleje_scenarie_input(MedFremlejeEfterLigningslov15Q(fakta = personskat_fremleje_ugyldige_kildefakta)))
    resultat.kapitalindkomst.fremleje_input_gyldigt == Falskt && resultat.kapitalindkomst.alle_input_gyldige == Falskt && resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 0 && match resultat.kapitalindkomst.fremleje_resultat {
        | UgyldigtFremlejegrundlag(_, _, ligningslov15q_resultat, stk4_samordning_gyldig) -> ligningslov15q_resultat.tidligere_par15p_stk3_afskærer_stk1 && ligningslov15q_resultat.stk1_anvendelig == Falskt && stk4_samordning_gyldig
        | _ -> Falskt
    }
}
| personskat_fremleje_samordning_afleder_skudårsdagene: personskat_fremleje_samordnede_kildefakta -> personskat_ligningslov15q_stk4_samordning(personskat_fremleje_samordnede_kildefakta.stk4_samordning, personskat_fremleje_samordnede_kildefakta.rolle, 2028).indkomstårets_dage == 366

? personskat_fremleje_afledes_fra_kildefakta
? personskat_fremleje_stk4_samordnes_fra_kildefakta
? personskat_fremleje_ugyldigt_valg_afvises
? personskat_fremleje_samordning_afleder_skudårsdagene
