))
= abl_par19_medarbejderselskab_over_grænse = aktieavance_par19_resultat(abl_par19_input(
    data = abl_par19_værdipapirdata(
        tilbagekøbsordning = AblPar19IngenTilbagekøbsordning,
        deltagere = abl_par19_otte_effektive_deltagere,
        aktivmasse = abl_par19_aktivmasse_kun_værdipapirer,
        datterselskabsvurdering = AblPar19IngenDatterselskabsformue,
