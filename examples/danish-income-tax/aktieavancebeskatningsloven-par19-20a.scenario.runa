))
= abl_par19_tilbagekøbsresultat = aktieavance_par19_resultat(abl_par19_input(
    data = abl_par19_værdipapirdata(
        tilbagekøbsordning = AblPar19TredjemandskøbPåForlangende(kurs = AblPar19KursIkkeVæsentligtUnderIndreVærdi, frist_dage = 180),
        deltagere = [],
        aktivmasse = abl_par19_aktivmasse_kun_værdipapirer,
        datterselskabsvurdering = AblPar19IngenDatterselskabsformue,
        medarbejderselskabsgrundlag = abl_par19_intet_medarbejderselskab
    ),
    institutsundtagelse = AblPar19IngenInstitutsundtagelse
))
= abl_par19_datterselskabsundtaget = aktieavance_par19_resultat(abl_par19_input(
    data = abl_par19_værdipapirdata(
        tilbagekøbsordning = AblPar19SelskabstilbagekøbPåForlangende(kurs = AblPar19KursIkkeVæsentligtUnderIndreVærdi, frist_dage = 30),
        deltagere = [],
        aktivmasse = abl_par19_aktivmasse_med_bestemmende_gennemlysning,
        datterselskabsvurdering = AblPar19DatterselskabsformueHovedsageligAndreVærdier,
        medarbejderselskabsgrundlag = abl_par19_intet_medarbejderselskab
    ),
    institutsundtagelse = AblPar19IngenInstitutsundtagelse
