@ sprog da

@ importer ./aktieavancebeskatningsloven - par23 - 27

| abl_par19_værdipapirdata(tilbagekøbsordning: AktieavancePar19Tilbagekøbsordning, deltagere: List(AktieavancePar19Deltager), aktivmasse: AktieavancePar19Aktivmasse, datterselskabsvurdering: AktieavancePar19Datterselskabsvurdering, medarbejderselskabsgrundlag: AktieavancePar19Medarbejderselskabsgrundlag) -> AktieavancePar19Værdipapirvirksomhed(
    tilbagekøbsordning = tilbagekøbsordning,
    deltagere_ved_indkomstårets_udgang = deltagere,
    aktivmasse = aktivmasse,
    datterselskabsvurdering = datterselskabsvurdering,
    medarbejderselskabsgrundlag = medarbejderselskabsgrundlag
)
| abl_par19_input(data: AktieavancePar19Værdipapirvirksomhed, institutsundtagelse: AktieavancePar19Institutsundtagelse) -> AktieavancePar19Input(
    indkomstår = 2026,
    virksomhedsgrundlag = AblPar19VirksomhedKunMedInvesteringIVærdipapirer(data = data),
    institutsundtagelse = institutsundtagelse
)
| abl_par19a_til20a_input(skattepligtsgrundlag: AktieavancePar6Par7Skattepligtsgrundlag, aktivgrundlag: AktieavancePar19ATil20AAktivgrundlag) -> AktieavancePar19ATil20AInput(
    indkomstår = 2026,
    skattepligtsgrundlag = skattepligtsgrundlag,
    aktivgrundlag = aktivgrundlag
)

