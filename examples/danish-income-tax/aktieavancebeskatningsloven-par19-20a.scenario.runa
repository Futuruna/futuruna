    AblPar19SelvstændigDeltager(identifikation = "G"),
    AblPar19SelvstændigDeltager(identifikation = "H")
]
= abl_par19_aktivmasse_kun_værdipapirer = AktieavancePar19Aktivmasse(
    direkte_aktiver = [AktieavancePar19Aktiv(art = AblPar19Værdipapir, gennemsnitlig_regnskabsmæssig_værdi_kroner = 100000)],
    ejerposter = []
)
= abl_par19_aktivmasse_præcis_15_pct_andre = AktieavancePar19Aktivmasse(
