    målselskabet_eller_koncernselskab_er_investeringsselskab = Falskt,
    gennemsnitlige_kontanter_kroner = 15000,
    gennemsnitlige_regnskabsmæssige_aktiver_kroner = 100000
)
= abl_par19_medarbejderselskab_over_15_pct_kontanter = AblPar19Medarbejderselskabsgrundlag(
    ejer_udelukkende_aktier_tegningsretter_og_aktieretter_i_et_selskab = Sandt,
    alle_aktionærer_var_ansat_i_målselskabet_eller_koncernselskab_ved_erhvervelsen = Sandt,
    målselskabet_eller_koncernselskab_er_investeringsselskab = Falskt,
    gennemsnitlige_kontanter_kroner = 15001,
    gennemsnitlige_regnskabsmæssige_aktiver_kroner = 100000
)

