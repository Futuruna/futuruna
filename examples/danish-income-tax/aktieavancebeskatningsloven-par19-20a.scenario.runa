    ),
    institutsundtagelse = AblPar19IngenInstitutsundtagelse
))

= abl_par20a_syva_deltagere = [
    AktieavancePar20ADeltager(identifikation = "P1", koncernforbundne_selskabsidentifikationer = ["S1"]),
    AktieavancePar20ADeltager(identifikation = "P2", koncernforbundne_selskabsidentifikationer = []),
    AktieavancePar20ADeltager(identifikation = "P3", koncernforbundne_selskabsidentifikationer = []),
    AktieavancePar20ADeltager(identifikation = "P4", koncernforbundne_selskabsidentifikationer = []),
    AktieavancePar20ADeltager(identifikation = "P5", koncernforbundne_selskabsidentifikationer = []),
    AktieavancePar20ADeltager(identifikation = "P6", koncernforbundne_selskabsidentifikationer = []),
    AktieavancePar20ADeltager(identifikation = "P7", koncernforbundne_selskabsidentifikationer = [])
]
= abl_par20a_otte_deltagere = concat(abl_par20a_syva_deltagere, [AktieavancePar20ADeltager(identifikation = "P8", koncernforbundne_selskabsidentifikationer = [])])
= abl_par20a_relateret_fordring = [AktieavancePar20AFordring(debitor_selskabsidentifikation = "S1", gennemsnitlig_værdi_kroner = 50000)]
= abl_par20a_urelateret_fordring = [AktieavancePar20AFordring(debitor_selskabsidentifikation = "U1", gennemsnitlig_værdi_kroner = 50000)]

= abl_par19a_selskabsinput = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar19AGrundlag(par19_input = abl_par19_ucits_resultat.input, undtagelse = AblPar19AIngenUndtagelse)
)
= abl_par19a_personinput = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar7PersonEfterKildeskatteloven,
    aktivgrundlag = AblPar19AGrundlag(par19_input = abl_par19_ucits_resultat.input, undtagelse = AblPar19AIngenUndtagelse)
)
= abl_par19a_undtaget_input = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar19AGrundlag(par19_input = abl_par19_ucits_resultat.input, undtagelse = AblPar19AUndtagetEfterPar18)
)
= abl_par19a_forkert_udstederår_input = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar19AGrundlag(
        par19_input = AktieavancePar19Input(
            indkomstår = 2025,
            virksomhedsgrundlag = AblPar19UcitsEfterDirektiv2009_65_EF,
            institutsundtagelse = AblPar19IngenInstitutsundtagelse
        ),
        undtagelse = AblPar19AIngenUndtagelse
    )
)
= abl_par20_selskabsinput = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar20AkkumulerendeInvesteringsforeningsbevis
)
= abl_par20_personinput = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar7PersonEfterKildeskatteloven,
    aktivgrundlag = AblPar20AkkumulerendeInvesteringsforeningsbevis
)
= abl_par20a_syva_relateret_input = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar20AMinimumsbevis(deltagere = abl_par20a_syva_deltagere, fordringer = abl_par20a_relateret_fordring)
)
= abl_par20a_syva_urelateret_input = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar20AMinimumsbevis(deltagere = abl_par20a_syva_deltagere, fordringer = abl_par20a_urelateret_fordring)
)
= abl_par20a_otte_relateret_input = abl_par19a_til20a_input(
    skattepligtsgrundlag = AblPar6EfterSelskabsskatteloven,
    aktivgrundlag = AblPar20AMinimumsbevis(deltagere = abl_par20a_otte_deltagere, fordringer = abl_par20a_relateret_fordring)
)

= abl_par19a_selskabsresultat = aktieavance_par19a_til20a_resultat(abl_par19a_selskabsinput)
= abl_par19a_personresultat = aktieavance_par19a_til20a_resultat(abl_par19a_personinput)
= abl_par19a_undtaget_resultat = aktieavance_par19a_til20a_resultat(abl_par19a_undtaget_input)
= abl_par19a_forkert_udstederår_resultat = aktieavance_par19a_til20a_resultat(abl_par19a_forkert_udstederår_input)
= abl_par20_selskabsresultat = aktieavance_par19a_til20a_resultat(abl_par20_selskabsinput)
= abl_par20_personresultat = aktieavance_par19a_til20a_resultat(abl_par20_personinput)
= abl_par20a_syva_relateret_resultat = aktieavance_par19a_til20a_resultat(abl_par20a_syva_relateret_input)
= abl_par20a_syva_urelateret_resultat = aktieavance_par19a_til20a_resultat(abl_par20a_syva_urelateret_input)
= abl_par20a_otte_relateret_resultat = aktieavance_par19a_til20a_resultat(abl_par20a_otte_relateret_input)

| abl_par19_til20a_par23_principinput(skattepligtsresultat: AktieavancePar6Par7Resultat, aktiv: AktieavancePar23Aktiv) -> AktieavancePar23PrincipInput(
    indkomstår = 2026,
    opgørelsesdato = AktieavancePar23Dato(år = 2026, måned = 12, dag = 31),
    skattepligtsresultat = skattepligtsresultat,
    aktiv = aktiv,
    stk2_valg = AblIntetPar23Stk2Valg,
    stk3_tilladelse = AblIngenPar23Stk3Tilladelse,
    stk6_valg = AblIntetPar23Stk6Valg,
    stk7_valg = AktieavancePar23Stk7Valg(
        selskabsidentifikation = "",
        første_optagelsesdato = AktieavancePar23Dato(år = 0, måned = 0, dag = 0),
        ejer_dage_før_første_optagelse = 0,
        valgmåde = AblIntetPar23Stk7Valg
    ),
    obligationsgevinst_opgøres_efter_lagerprincippet = Falskt,
    indkomstår_forskelligt_fra_kalenderår = Falskt
)
| abl_par19_til20a_lagerårsresultat(princip_resultat: AktieavancePar23PrincipResultat) -> aktieavance_par23_lager_årsresultat(AktieavancePar23LagerÅrsinput(
    princip_resultat = princip_resultat,
    værdi_primo_kroner = 100000,
    værdi_ultimo_kroner = 90000,
    anskaffelsessummer_i_perioden_kroner = 0,
    afståelser_i_perioden = [],
    par17_modprøve = AktieavancePar17Modprøve(næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier, erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej),
    oplysningsbetingelse_efter_par19d_opfyldt = Sandt
))

= abl_par19a_par23_aktiv = AblPar19AInvesteringsselskabsaktiv(
    klassifikationsinput = abl_par19a_selskabsinput,
    papirart = AblInvesteringsselskabsaktie,
    markedsstatus = AblOptagetTilHandelPåReguleretMarked,
    registreret_i_værdipapircentral = Sandt
)
= abl_par20_par23_aktiv = AblPar20Stk1Investeringsbevis(klassifikationsinput = abl_par20_selskabsinput)
= abl_par20a_afskåret_par23_aktiv = AblPar20AInvesteringsbevis(klassifikationsinput = abl_par20a_syva_relateret_input)
= abl_par20a_tilladt_par23_aktiv = AblPar20AInvesteringsbevis(klassifikationsinput = abl_par20a_syva_urelateret_input)
= abl_par19a_par23_princip = aktieavance_par23_princip_resultat(abl_par19_til20a_par23_principinput(aktieavance_par6_selskab_efter_selskabsskatteloven, abl_par19a_par23_aktiv))
= abl_par20_par23_princip = aktieavance_par23_princip_resultat(abl_par19_til20a_par23_principinput(aktieavance_par6_selskab_efter_selskabsskatteloven, abl_par20_par23_aktiv))
= abl_par20a_afskåret_par23_princip = aktieavance_par23_princip_resultat(abl_par19_til20a_par23_principinput(aktieavance_par6_selskab_efter_selskabsskatteloven, abl_par20a_afskåret_par23_aktiv))
= abl_par20a_tilladt_par23_princip = aktieavance_par23_princip_resultat(abl_par19_til20a_par23_principinput(aktieavance_par6_selskab_efter_selskabsskatteloven, abl_par20a_tilladt_par23_aktiv))
