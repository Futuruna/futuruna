)
= abl_par19_aktivmasse_med_10_pct_ikke_investeringsselskab = AktieavancePar19Aktivmasse(
    direkte_aktiver = [AktieavancePar19Aktiv(art = AblPar19Værdipapir, gennemsnitlig_regnskabsmæssig_værdi_kroner = 84000)],
