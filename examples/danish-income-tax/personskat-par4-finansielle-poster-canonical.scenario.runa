@ sprog da

@ importer ./personskat.calculate

----
Kanoniske scenarier for personskattelovens § 4, stk. 1, nr. 5 a, 5 b og 7.

Scenarierne fastholder den fulde vej fra typede kildefakta gennem
beregn_personskat. Ugyldige år, dubletter og uafsluttede aktivklassifikationer
må ikke påvirke kapitalindkomst eller personlig indkomst.
----

| psl4_finansiel_scenarie_fakta(identifikation: Tekst, kilde: PersonskatPar4FinansielPostkilde) -> PersonskatPar4FinansielPostfakta(
    identifikation = identifikation,
    indkomstår = 2026,
    kilde = kilde
)
| psl4_finansiel_scenarie_sel6_input(enhed: Selskabsskattelov1Stk1Nr6Enhed) -> Selskabsskattelov1Stk1Nr6Input(
    enhed = enhed,
    hjemmehørende_i_danmark = Sandt,
    omfattet_af_par3_undtagelse = Falskt,
    omfattet_af_fondsbeskatningsloven = Falskt
)
| psl4_finansiel_scenarie_nr5a(identifikation: Tekst, beløb_kroner: Heltal, enhed: Selskabsskattelov1Stk1Nr6Enhed) -> psl4_finansiel_scenarie_fakta(
    identifikation,
    PsPar4Nr5AMedlemsbevis(
        opgjort_gevinst_eller_tab_kroner = beløb_kroner,
        selskabsskattelov1_stk1_nr6_input = psl4_finansiel_scenarie_sel6_input(enhed)
    )
)
| psl4_finansiel_scenarie_nr5b(identifikation: Tekst, beløb_kroner: Heltal, formidler: Par4Stk1Nr5bFormidler, modtaget_fra_institut: Boolsk, klassifikation: AktieavanceAktivklassifikationInput) -> psl4_finansiel_scenarie_fakta(
    identifikation,
    PsPar4Nr5BFormidlerbeløb(
        modtaget_beløb_kroner = beløb_kroner,
        formidler = formidler,
        formidler_har_modtaget_gebyrer_provisioner_eller_pengeydelser_fra_investeringsinstitut = modtaget_fra_institut,
        aktieavance_aktivklassifikation_input = klassifikation
    )
)
| psl4_finansiel_scenarie_nr7(identifikation: Tekst, indkomstår: Heltal, art: Ligningslov8Stk3Art, udgift_kroner: Heltal, løbetid_måneder: Heltal) -> psl4_finansiel_scenarie_fakta(
    identifikation,
    PsPar4Nr7Provision(input = Ligningslov8Stk3Input(
        indkomstår = indkomstår,
        art = art,
        udgift_kroner = udgift_kroner,
        løbetid_måneder = løbetid_måneder
    ))
)

| psl4_finansiel_scenarie_alle_poster() -> [
    psl4_finansiel_scenarie_nr5a("medlemsbevis-gevinst", 40000, Ssl1Stk1Nr6AndenForening),
    psl4_finansiel_scenarie_nr5a("medlemsbevis-tab", -10000, Ssl1Stk1Nr6Korporation),
    psl4_finansiel_scenarie_nr5a("investeringsforening-undtaget", 15000, Ssl1Stk1Nr6Investeringsforening),
    psl4_finansiel_scenarie_nr5b(
        "formidler-par22",
        5000,
        Par4Nr5bPengeinstitut,
        Sandt,
        aktieavance_aktivklassifikation_input_fra_beregning(abl22_tab_input)
    ),
    psl4_finansiel_scenarie_nr5b(
        "formidler-par19c-hvis17",
        7000,
        Par4Nr5bInvesteringsrådgiver,
        Sandt,
        aktieavance_aktivklassifikation_input_fra_beregning(abl19c_hvis17_input)
    ),
    psl4_finansiel_scenarie_nr5b(
        "formidler-ikke-naevnt",
        9000,
        Par4Nr5bIkkeNævntFormidler,
        Sandt,
        aktieavance_aktivklassifikation_input_fra_beregning(abl22_tab_input)
    ),
    psl4_finansiel_scenarie_nr7(
        "loebende-laaneprovision",
        2026,
        Ll8Stk3LøbendeProvisionEllerPræmieForLånEllerSikring,
        3000,
        60
    ),
    psl4_finansiel_scenarie_nr7(
        "toaarig-stiftelsesprovision",
        2026,
        Ll8Stk3StiftelsesprovisionEllerEngangspræmie,
        9000,
        24
    ),
]
| psl4_finansiel_scenarie_uafsluttet_klassifikation() -> AktieavanceAktivklassifikationInput(
    indkomstår = 2026,
    aktiv = AblUdenforDenneSlice,
    par17_modprøve = AktieavancePar17Modprøve(
        næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
        erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
    ),
    investeringsklassifikation = AblIngenInvesteringsklassifikation
)

| psl4_finansiel_scenarie_kapitalindkomst(poster: List(PersonskatPar4FinansielPostfakta)) -> {
    = tom = personskat_ingen_kapitalindkomst()
    PersonskatKapitalindkomstInput(
        renter = tom.renter,
        virksomhedskapital = tom.virksomhedskapital,
        pbl53a = tom.pbl53a,
        ejendomsdrift = tom.ejendomsdrift,
        ejendomsavance = tom.ejendomsavance,
        kursgevinst = tom.kursgevinst,
        fremleje = tom.fremleje,
        finansielle_poster = poster,
        særlige_kapitalposter = [],
        omkostninger = tom.omkostninger
    )
}
| psl4_finansiel_scenarie_personlig_indkomst() -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = [],
        personlige_arbejdsvederlag = [],
        virksomheder_uden_virksomhedsordning = [],
        forenings_og_arbejdsløshedsydelser = []
    ),
    arbejdsudleje = [],
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| psl4_finansiel_scenarie_input(poster: List(PersonskatPar4FinansielPostfakta)) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 0,
        personlig_indkomst = psl4_finansiel_scenarie_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = psl4_finansiel_scenarie_kapitalindkomst(poster),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| psl4_finansiel_scenarie_beregning(poster: List(PersonskatPar4FinansielPostfakta)) -> beregn_personskat(psl4_finansiel_scenarie_input(poster))

= psl4_finansiel_scenarie_gyldigt = psl4_finansiel_scenarie_beregning(psl4_finansiel_scenarie_alle_poster())
= psl4_finansiel_scenarie_forkert_år = psl4_finansiel_scenarie_beregning([
    psl4_finansiel_scenarie_nr7(
        "forkert-aar",
        2025,
        Ll8Stk3LøbendeKautionspræmie,
        12000,
        48
    )
])
= psl4_finansiel_scenarie_dobbelt_id = psl4_finansiel_scenarie_beregning([
    psl4_finansiel_scenarie_nr5a("samme-id", 40000, Ssl1Stk1Nr6AndenForening),
    psl4_finansiel_scenarie_nr5a("samme-id", -10000, Ssl1Stk1Nr6Korporation)
])
= psl4_finansiel_scenarie_uafsluttet = psl4_finansiel_scenarie_beregning([
    psl4_finansiel_scenarie_nr5b(
        "uafsluttet-klassifikation",
        12000,
        Par4Nr5bPengeinstitut,
        Sandt,
        psl4_finansiel_scenarie_uafsluttet_klassifikation()
    )
])

| psl4_finansiel_scenarie_positive_negative_og_undtagelser: psl4_finansiel_scenarie_gyldigt -> psl4_finansiel_scenarie_gyldigt.kapitalindkomst.alle_input_gyldige && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postidentifikationer_entydige && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_poster_gyldige && length(psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater) == 8 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[0].kapitalpost.beløb_kroner == 40000 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[1].kapitalpost.beløb_kroner == -10000 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[2].kapitalpost.beløb_kroner == 0 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[3].kapitalpost.beløb_kroner == 5000 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[5].kapitalpost.beløb_kroner == 0 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[6].kapitalpost.beløb_kroner == -3000 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[7].kapitalpost.beløb_kroner == 0 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 32000
| psl4_finansiel_scenarie_par19c_hvis17_omklassificeres_personligt: psl4_finansiel_scenarie_gyldigt -> psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[4].kapitalpost.beløb_kroner == 7000 && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.finansielle_postresultater[4].kapitalpost.personlig_reklassifikation == Investeringsformidler19CHvis17Aktier && psl4_finansiel_scenarie_gyldigt.kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner == 7000
| psl4_finansiel_scenarie_forkert_år_fejler_lukket: psl4_finansiel_scenarie_forkert_år -> psl4_finansiel_scenarie_forkert_år.kapitalindkomst.finansielle_postidentifikationer_entydige && psl4_finansiel_scenarie_forkert_år.kapitalindkomst.finansielle_poster_gyldige == Falskt && psl4_finansiel_scenarie_forkert_år.kapitalindkomst.alle_input_gyldige == Falskt && psl4_finansiel_scenarie_forkert_år.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 0
| psl4_finansiel_scenarie_dobbelt_id_fejler_lukket: psl4_finansiel_scenarie_dobbelt_id -> psl4_finansiel_scenarie_dobbelt_id.kapitalindkomst.finansielle_postidentifikationer_entydige == Falskt && psl4_finansiel_scenarie_dobbelt_id.kapitalindkomst.finansielle_poster_gyldige == Falskt && psl4_finansiel_scenarie_dobbelt_id.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 0
| psl4_finansiel_scenarie_uafsluttet_klassifikation_fejler_lukket: psl4_finansiel_scenarie_uafsluttet -> psl4_finansiel_scenarie_uafsluttet.kapitalindkomst.finansielle_poster_gyldige == Falskt && psl4_finansiel_scenarie_uafsluttet.kapitalindkomst.alle_input_gyldige == Falskt && psl4_finansiel_scenarie_uafsluttet.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 0 && psl4_finansiel_scenarie_uafsluttet.kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner == 0

? psl4_finansiel_scenarie_positive_negative_og_undtagelser
? psl4_finansiel_scenarie_par19c_hvis17_omklassificeres_personligt
? psl4_finansiel_scenarie_forkert_år_fejler_lukket
? psl4_finansiel_scenarie_dobbelt_id_fejler_lukket
? psl4_finansiel_scenarie_uafsluttet_klassifikation_fejler_lukket
