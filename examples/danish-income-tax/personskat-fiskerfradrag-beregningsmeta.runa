@ sprog da

@ importer ./metadata
@ importer ./ligningsloven - par9g - fiskerfradrag

= personskat_fiskerfradrag_felt_valg = TypetBeregningsfelt(
    path = refof(Ligningslov9GÅrsinput::valg::$variant),
    label = "Valg af fiskerfradrag",
    question = Some("Skal fiskerfradraget efter ligningslovens § 9 G anvendes for indkomståret?"),
    help = Some("Valget gælder hele indkomståret. Futuruna udleder registreringskravet, havdagene, årsloftet og de fradrag, som valget erstatter."),
    unit = None
)
