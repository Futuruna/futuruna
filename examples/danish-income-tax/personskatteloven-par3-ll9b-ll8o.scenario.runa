| ll9b_dag60_er_erhvervsmæssig: ll9b_selvstændig_dag60 -> ll9b_selvstændig_dag60.erhvervsmæssig_befordring && ll9b_selvstændig_dag60.godtgørelses_høj_sats_kilometer == 1000 && ll9b_selvstændig_dag60.direkte_fradrags_høj_sats_kilometer == 500 && ll9b_selvstændig_dag60.direkte_fradrags_lav_sats_kilometer == 500 && ll9b_selvstændig_dag60.maksimal_skattefri_godtgørelse_kroner == 3940 && ll9b_selvstændig_dag60.satsbaseret_direkte_fradrag_før_bro_tunnel_kroner == 3110 && ll9b_selvstændig_dag60.fradrag_i_personlig_indkomst_kroner == 3410
