| ll9b_ny_60_dages_periode: ll9b_selvstændig_ny_periode -> ll9b_selvstændig_ny_periode.ny_60_dages_periode && ll9b_selvstændig_ny_periode.erhvervsmæssig_befordring && ll9b_selvstændig_ny_periode.fradrag_i_personlig_indkomst_kroner == 394
| ll9b_stk3_formodning_anvendes: ll9b_stk3_formodning -> ll9b_stk3_formodning.stk3_formodning_anvendt && ll9b_stk3_formodning.erhvervsmæssig_befordring && ll9b_stk3_formodning.fradrag_i_personlig_indkomst_kroner == 197
| ll9b_stk3_pålæg_kræver_dokumentation: ll9b_stk3_pålæg_ikke_dokumenteret -> ll9b_stk3_pålæg_ikke_dokumenteret.stk3_formodning_anvendt == Falskt && ll9b_stk3_pålæg_ikke_dokumenteret.erhvervsmæssig_befordring == Falskt
| ll9b_delvis_skattefri_afskærer_dobbeltfradrag: ll9b_lønmodtager_delvis_skattefri -> ll9b_lønmodtager_delvis_skattefri.skattefri_godtgørelse_kroner == 3000 && ll9b_lønmodtager_delvis_skattefri.godtgørelse_personlig_indkomst_kroner == 0 && ll9b_lønmodtager_delvis_skattefri.fradrag_i_personlig_indkomst_kroner == 0 && ll9b_lønmodtager_delvis_skattefri.henvises_til_par9c == Falskt
| ll9b_lønmodtager_uden_godtgørelse_henvises_til_9c: ll9b_lønmodtager_uden_godtgørelse -> ll9b_lønmodtager_uden_godtgørelse.skattefri_godtgørelse_kroner == 0 && ll9b_lønmodtager_uden_godtgørelse.direkte_fradragsberettiget_efter_par9b == Falskt && ll9b_lønmodtager_uden_godtgørelse.henvises_til_par9c
| ll9b_kundeopsøgende_flere_arbejdsgivere_fradrager: ll9b_kundeopsøgende_uden_godtgørelse -> ll9b_kundeopsøgende_uden_godtgørelse.kundeopsøgende_flere_arbejdsgivere && ll9b_kundeopsøgende_uden_godtgørelse.direkte_fradragsberettiget_efter_par9b && ll9b_kundeopsøgende_uden_godtgørelse.fradrag_i_personlig_indkomst_kroner == 4440 && ll9b_kundeopsøgende_uden_godtgørelse.henvises_til_par9c == Falskt
