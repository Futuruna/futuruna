)
= personskat_kgl_årsnetto_scenarie_obligationslager_modstridende_historik_2026 = personskat_kgl_årsnetto_par25_resultat(
    2026,
    personskat_kgl_årsnetto_par25_årsvalg(KglÅrsnettoVidereførtPar25Valg(fra_indkomstår = 2025, princip = KglRealisationsprincip), KglLagerprincip),
    personskat_kgl_årsnetto_videreført_markedsnoteret_obligation(personskat_kgl_årsnetto_fordringsposition_ultimo(personskat_kgl_årsnetto_scenarie_obligationslager_2025))
