| personskat_kgl_årsnetto_position_fra_foregående_år_accepteres: personskat_kgl_årsnetto_scenarie_videreført -> personskat_kgl_årsnetto_scenarie_videreført.input_gyldigt && personskat_kgl_årsnetto_scenarie_videreført.øvrige_instrumentresultat.fordringsresultater[0].forløb.position_ultimo == KglÅrsnettoIngenPositionUltimo && personskat_kgl_årsnetto_scenarie_videreført.kursgevinstlov_resultater[0].netto_efter_kursgevinstloven_kroner == 3000
| personskat_kgl_årsnetto_for_gammel_position_afvises: personskat_kgl_årsnetto_scenarie_for_gammel_position -> personskat_kgl_årsnetto_scenarie_for_gammel_position.input_gyldigt == Falskt && personskat_kgl_årsnetto_scenarie_for_gammel_position.øvrige_instrumentresultat.fordringsresultater[0].forløb.input_gyldigt == Falskt && length(personskat_kgl_årsnetto_scenarie_for_gammel_position.kursgevinstlov_resultater) == 0
| personskat_kgl_årsnetto_par17_overstyrer_par14_og_par15: personskat_kgl_årsnetto_scenarie_par17_over_par14_15 -> personskat_kgl_årsnetto_scenarie_par17_over_par14_15.input_gyldigt && personskat_kgl_årsnetto_scenarie_par17_over_par14_15.årets_samlede_netto_efter_par14_kroner == 0 && personskat_kgl_årsnetto_scenarie_par17_over_par14_15.øvrige_instrumentresultat.fordringsresultater[0].opgørelser[0].kursgevinstlov_input.fordring.tabsgrundlag == KglFordringstabEfterPar17Statsskattelov6A && personskat_kgl_årsnetto_scenarie_par17_over_par14_15.øvrige_instrumentresultat.fordringsresultater[0].opgørelser[0].kursgevinstlov_input.fordring.tabsbegrænsning == KglFordringstabIkkeAfskåret && personskat_kgl_årsnetto_scenarie_par17_over_par14_15.kursgevinstlov_resultater[0].fradragsberettiget_tab_kroner == 3000 && personskat_kgl_årsnetto_scenarie_par17_over_par14_15.kursgevinstlov_resultater[0].personlig_reklassifikation == KglPar17Fordringstab
