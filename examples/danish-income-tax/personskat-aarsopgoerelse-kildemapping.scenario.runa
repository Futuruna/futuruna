| aarsopgoerelse_2025_fradragslinjer_kræver_typed_kildefakta: aarsopgoerelse_2025_fagforening_mapping -> match aarsopgoerelse_2025_fagforening_mapping.anvendelse {
    | KræverSupplerendeKilde(BidragsEllerKontingentopgørelse, fagforeningskrav) -> fagforeningskrav == [FagforeningsbetalingForeningsformålOgIndberetning] && match aarsopgoerelse_2025_akasse_mapping.anvendelse {
        | KræverSupplerendeKilde(BidragsEllerKontingentopgørelse, bidragskrav) -> bidragskrav == [BidragsartMedlemskabUdlandsfradragOgOrdning] && match aarsopgoerelse_2025_gaver_mapping.anvendelse {
            | KræverSupplerendeKilde(BidragsEllerKontingentopgørelse, gavekrav) -> gavekrav == [GavebetalingModtagergodkendelseIndberetningOgAftale]
