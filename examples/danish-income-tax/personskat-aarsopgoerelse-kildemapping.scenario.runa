= aarsopgoerelse_2025_udbytteskat_mapping = personskat_aarsopgoerelse_kortlaeg_modregningsberettiget_udbytteskat(aarsopgoerelse_2025_udbytteskat)
= aarsopgoerelse_2025_tidligere_udbetalt_mapping = personskat_aarsopgoerelse_kortlaeg_tidligere_udbetalt_overskydende_skat(aarsopgoerelse_2025_tidligere_udbetalt)

| aarsopgoerelse_2025_direkte_felter_bevarer_kilder: aarsopgoerelse_2025_løn_mapping -> match aarsopgoerelse_2025_løn_mapping.anvendelse {
    | DirekteKildebeløb(ProgramMemberReference(rodtype, sti), beløb_kroner, faktakrav) -> rodtype == "PersonskatLønmodtagerInput" && sti == "bruttoløn_kroner" && beløb_kroner == 817097 && length(faktakrav) == 0 && any(aarsopgoerelse_2025_løn_mapping.kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.linje_identifikation == "løn-før-am" && linje.beløb_øre == 81709700)
    | _ -> Falskt
}
| aarsopgoerelse_2025_renter_aggregeres_kun_til_typed_felt: aarsopgoerelse_2025_renteudgift_mapping -> match aarsopgoerelse_2025_renteudgift_mapping.anvendelse {
