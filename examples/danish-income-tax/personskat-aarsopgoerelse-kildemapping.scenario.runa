| aarsopgoerelse_2025_samme_kildelinje_tælles_ikke_to_gange: aarsopgoerelse_2025_dobbelt_rente_mapping -> personskat_aarsopgoerelse_mappingkategori(aarsopgoerelse_2025_dobbelt_rente_mapping) == UgyldigMapping
| aarsopgoerelse_2025_pension_kræver_underliggende_fakta: aarsopgoerelse_2025_arbejdsgiverpension_mapping -> personskat_aarsopgoerelse_mappingkategori(aarsopgoerelse_2025_arbejdsgiverpension_mapping) == SupplerendeKildeMapping && personskat_aarsopgoerelse_mappingkategori(aarsopgoerelse_2025_livrente_mapping) == SupplerendeKildeMapping
