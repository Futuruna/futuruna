| aarsopgoerelse_2025_personlig_indkomst_kræver_supplerende_kilder: aarsopgoerelse_2025_gruppeliv_mapping -> match aarsopgoerelse_2025_gruppeliv_mapping.anvendelse {
    | KræverSupplerendeKilde(EIndkomstEllerLønspecifikation, faktakrav) -> faktakrav == [YdelsensRetligeArtOgAmStatus] && match aarsopgoerelse_2025_virksomhedsunderskud_mapping.anvendelse {
        | KræverSupplerendeKilde(VirksomhedsregnskabOgSkatteordning, virksomhedsfaktakrav) -> virksomhedsfaktakrav == [VirksomhedsindkomstAktivitetOgUnderskudshistorik]
