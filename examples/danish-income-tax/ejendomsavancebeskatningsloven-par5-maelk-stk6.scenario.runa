        hele_ejendommens_anskaffelsessum_før_par5_kroner = 800000,
        ikke_boligdelens_anskaffelsessum_før_par5_kroner = None
    )
)

= ebl_par5_scenarie_del_fordeling_med_boligdel = EblPar5Fordeling(
