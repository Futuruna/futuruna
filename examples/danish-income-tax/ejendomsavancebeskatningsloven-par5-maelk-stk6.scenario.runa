| ebl_par5_scenarie_fakta(
    anskaffelsesdato: EblDato,
    anskaffelsesgrundlag: EjendomsavancePar4Anskaffelsesgrundlag,
    fordeling: EblPar5Fordeling,
    mælkekvoter: List(EblPar5MælkekvoteFakta),
    stk6_overførsel: EblPar5Stk6Overførsel,
    reguleringsvalg: EblPar5Reguleringsvalg
) -> EblPar5Fakta(
    anskaffelsesdato = anskaffelsesdato,
    anskaffelsesgrundlag = anskaffelsesgrundlag,
    fordeling = fordeling,
    vedligeholdelses_og_forbedringsudgifter = [],
    nedsættelser = [],
    mælkekvoter = mælkekvoter,
    stk6_overførsel = stk6_overførsel,
    reguleringsvalg = reguleringsvalg
)

= ebl_par5_scenarie_hel_fordeling = EblPar5Fordeling(
    ejerandel_promille = 1000,
    afståelsesomfang = EblPar5HeleEjendommen
)

= ebl_par5_scenarie_del_fordeling_uden_boligdel = EblPar5Fordeling(
    ejerandel_promille = 500,
    afståelsesomfang = EblPar5DelAfEjendommen(
        afstået_del_anskaffelsessum_før_par5_kroner = 200000,
        hele_ejendommens_anskaffelsessum_før_par5_kroner = 800000,
        ikke_boligdelens_anskaffelsessum_før_par5_kroner = Some(800000)
    )
)

