    identifikation = "mælk-2000",
    anskaffelsesdato = EblDato(år = 2000, måned = 1, dag = 1),
    oprindelige_enheder = 100,
    disponerede_enheder = 100,
    anskaffelsesgrundlag = EblPar5MælkekvoteKøbt(
