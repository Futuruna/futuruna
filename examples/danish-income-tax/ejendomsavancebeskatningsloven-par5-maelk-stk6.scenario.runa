    attachments = (
        Source(value = ebl_par5_lbk132),
        Guidance(value = ebl_par5_mælkekvote_vejledning_2026),
        Guidance(value = ebl_par5_stk6_vejledning_2026),
        AmendmentSource(value = ebl_par5_lov615),
    )
)

