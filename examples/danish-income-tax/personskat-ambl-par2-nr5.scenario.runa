@ sprog da

@ importer ./personskat.calculate

| personskat_ambl_par2_nr5_pensionsinput(årsgrundlag: AmblPar2Nr5Årsgrundlag) -> PersonskatPensionsInput(
    fødselsdato = Dato(år = 1990, måned = 1, dag = 1),
    pbl18_indbetalinger = [],
    pbl18_selvstændig_overskud = personskat_intet_selvstændigt_pensionsoverskud(),
    pbl18_livrentevalg = Pbl18FordeltFradrag,
    pbl14b_årsgrundlag = pbl14b_tomt_årsgrundlag(),
    ambl_par2_stk1_nr5_årsgrundlag = årsgrundlag,
    pbl15a_årsgrundlag = Pbl15AÅrsgrundlag(
        afståelser = [],
        ordninger = [],
        kvalifikationsår = [],
        tidligere_indbetalinger = []
    ),
    pbl15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    øvrige_pbl20_årsgrundlag = pbl20_tomt_årsgrundlag(),
    aktiepensionsfradrag_valg = UdenAktiepensionsfradragIAktieindkomst
)
| personskat_ambl_par2_nr5_lønmodtager(pension: PersonskatPensionsInput) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = pension,
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
| personskat_ambl_par2_nr5_input(pension: PersonskatPensionsInput) -> PersonskatInput(
    lønmodtager = personskat_ambl_par2_nr5_lønmodtager(pension),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)

= personskat_ambl_par2_nr5_dokumenteret = AmblNr5BetingelseDokumenteret(
    dokumentreference = "dokumenteret"
)
= personskat_ambl_par2_nr5_uden_beløbsloft = AmblPar2Nr5Beløbsrammer(
    årsramme_identifikation = "schweizisk-ordning-årsramme-2026",
    dansk_grænse = AmblNr5DokumenteretUdenBeløbsgrænse(
        dokumentreference = "dansk-ordning-uden-beløbsloft"
    ),
    ordningslandets_grænse = AmblNr5DokumenteretUdenBeløbsgrænse(
        dokumentreference = "udenlandsk-ordning-uden-beløbsloft"
    )
)
= personskat_ambl_par2_nr5_schweizisk_indbetaling = AmblPar2Nr5Indbetalingsfakta(
    identifikation = "schweizisk-arbejdsgiverpension",
    indkomstår = 2026,
    indbetalingsdato = Dato(år = 2026, måned = 6, dag = 30),
    arbejdsgiverindbetaling_kroner = 50000,
    dbo_grundlag = AmblNr5Schweiz(fakta = AmblPar2Nr5Schweizfakta(
        ordning = AmblNr5SchweizBeskæftigelsesrelateretPension(
            dokumentreference = "schweizisk-ordning"
        ),
        skattemæssigt_anerkendt_i_schweiz = personskat_ambl_par2_nr5_dokumenteret,
        godkendt_sammenlignelig_i_danmark = personskat_ambl_par2_nr5_dokumenteret,
        yder_personligt_arbejde_i_danmark = personskat_ambl_par2_nr5_dokumenteret,
        ikke_hjemmehørende_i_danmark_umiddelbart_før = personskat_ambl_par2_nr5_dokumenteret,
        deltog_umiddelbart_før_arbejde_i_danmark = personskat_ambl_par2_nr5_dokumenteret,
        beløbsrammer = personskat_ambl_par2_nr5_uden_beløbsloft
    ))
)
| personskat_ambl_par2_nr5_nederlandsk_indbetaling(godkendelse: AmblPar2Nr5Betingelse) -> AmblPar2Nr5Indbetalingsfakta(
    identifikation = "nederlandsk-arbejdsgiverpension",
    indkomstår = 2026,
    indbetalingsdato = Dato(år = 2026, måned = 6, dag = 30),
    arbejdsgiverindbetaling_kroner = 50000,
    dbo_grundlag = AmblNr5Nederlandene(fakta = AmblPar2Nr5Nederlandefakta(
        obligatorisk_ordning = personskat_ambl_par2_nr5_dokumenteret,
        skattemæssigt_anerkendt_i_nederlandene = personskat_ambl_par2_nr5_dokumenteret,
        godkendt_sammenlignelig_i_danmark = godkendelse,
        personligt_arbejde_i_tjenesteforhold = personskat_ambl_par2_nr5_dokumenteret,
        ikke_hjemmehørende_i_danmark_umiddelbart_før = personskat_ambl_par2_nr5_dokumenteret,
        bidrog_umiddelbart_før_dansk_ansættelse = personskat_ambl_par2_nr5_dokumenteret,
        arbejdsgiverrelation = AmblNr5SammeArbejdsgiver(
            dokumentreference = "samme-arbejdsgiver"
        ),
        dansk_ansættelse_startdato = Dato(år = 2023, måned = 1, dag = 1),
        beløbsrammer = AmblPar2Nr5Beløbsrammer(
            årsramme_identifikation = "nederlandsk-ordning-årsramme-2026",
            dansk_grænse = AmblNr5DokumenteretMaksimum(
                maksimum_kroner = 30000,
                dokumentreference = "dansk-beløbsgrænse"
            ),
            ordningslandets_grænse = AmblNr5DokumenteretMaksimum(
                maksimum_kroner = 40000,
                dokumentreference = "nederlandsk-beløbsgrænse"
            )
        )
    ))
)

= personskat_ambl_par2_nr5_uden_pension_resultat = beregn_personskat(personskat_ambl_par2_nr5_input(
    personskat_ingen_pension()
))
= personskat_ambl_par2_nr5_schweiz_resultat = beregn_personskat(personskat_ambl_par2_nr5_input(
    personskat_ambl_par2_nr5_pensionsinput(AmblPar2Nr5Årsgrundlag(
        indbetalinger = [personskat_ambl_par2_nr5_schweizisk_indbetaling]
    ))
))
= personskat_ambl_par2_nr5_nederlandene_resultat = beregn_personskat(personskat_ambl_par2_nr5_input(
    personskat_ambl_par2_nr5_pensionsinput(AmblPar2Nr5Årsgrundlag(
        indbetalinger = [personskat_ambl_par2_nr5_nederlandsk_indbetaling(personskat_ambl_par2_nr5_dokumenteret)]
    ))
))
= personskat_ambl_par2_nr5_uafklaret_resultat = beregn_personskat(personskat_ambl_par2_nr5_input(
    personskat_ambl_par2_nr5_pensionsinput(AmblPar2Nr5Årsgrundlag(
        indbetalinger = [personskat_ambl_par2_nr5_nederlandsk_indbetaling(AmblNr5BetingelseUafklaret)]
    ))
))

| personskat_ambl_par2_nr5_schweiz_betaler_kun_arbejdsmarkedsbidrag: personskat_ambl_par2_nr5_schweiz_resultat -> personskat_ambl_par2_nr5_schweiz_resultat.pension.ambl_par2_stk1_nr5_resultat.input_gyldigt && personskat_ambl_par2_nr5_schweiz_resultat.pension.ambl_par2_stk1_nr5_resultat.samlet_ikke_skattepligtig_efter_dbo_kroner == 50000 && personskat_ambl_par2_nr5_schweiz_resultat.skat.bruttoløn_kroner == 600000 && personskat_ambl_par2_nr5_schweiz_resultat.skat.arbejdsmarkedsbidrag_kroner == 52000 && personskat_ambl_par2_nr5_schweiz_resultat.skat.personlig_indkomst_efter_am_kroner == 552000 && personskat_ambl_par2_nr5_schweiz_resultat.skat.beskæftigelsesfradrag_kroner == personskat_ambl_par2_nr5_uden_pension_resultat.skat.beskæftigelsesfradrag_kroner && personskat_ambl_par2_nr5_schweiz_resultat.skat.samlet_inkl_am_efter_personfradrag_kroner == personskat_ambl_par2_nr5_uden_pension_resultat.skat.samlet_inkl_am_efter_personfradrag_kroner + 4000
| personskat_ambl_par2_nr5_nederlandene_deler_skattepligtig_og_fritaget_del: personskat_ambl_par2_nr5_nederlandene_resultat -> personskat_ambl_par2_nr5_nederlandene_resultat.pension.ambl_par2_stk1_nr5_resultat.input_gyldigt && personskat_ambl_par2_nr5_nederlandene_resultat.pension.ambl_par2_stk1_nr5_resultat.samlet_ikke_skattepligtig_efter_dbo_kroner == 30000 && personskat_ambl_par2_nr5_nederlandene_resultat.pension.ambl_par2_stk1_nr5_resultat.samlet_skattepligtig_arbejdsgiverindbetaling_kroner == 20000 && personskat_ambl_par2_nr5_nederlandene_resultat.skat.bruttoløn_kroner == 620000 && personskat_ambl_par2_nr5_nederlandene_resultat.skat.arbejdsmarkedsbidrag_kroner == 52000 && personskat_ambl_par2_nr5_nederlandene_resultat.skat.personlig_indkomst_efter_am_kroner == 570400
| personskat_ambl_par2_nr5_uafklaret_fejler_lukket: personskat_ambl_par2_nr5_uafklaret_resultat -> personskat_ambl_par2_nr5_uafklaret_resultat.pension.ambl_par2_stk1_nr5_resultat.input_gyldigt == Falskt && personskat_ambl_par2_nr5_uafklaret_resultat.pension.ambl_par2_stk1_nr5_resultat.samlet_arbejdsgiverindbetaling_kroner == 0 && personskat_ambl_par2_nr5_uafklaret_resultat.skat.bruttoløn_kroner == personskat_ambl_par2_nr5_uden_pension_resultat.skat.bruttoløn_kroner && personskat_ambl_par2_nr5_uafklaret_resultat.skat.arbejdsmarkedsbidrag_kroner == personskat_ambl_par2_nr5_uden_pension_resultat.skat.arbejdsmarkedsbidrag_kroner

? personskat_ambl_par2_nr5_schweiz_betaler_kun_arbejdsmarkedsbidrag
? personskat_ambl_par2_nr5_nederlandene_deler_skattepligtig_og_fritaget_del
? personskat_ambl_par2_nr5_uafklaret_fejler_lukket
