@ sprog da

@ importer ./aktieavancebeskatningsloven - par39a - 40

-- Fokusscenarier for Aktieavancebeskatningsloven §§ 39 A-40.

= abl39a_intet_tabsfradrag = AktieavancePar39ATabsfradrag(
    fradrag_i_udlandet = Falskt,
    negativ_skatteværdi_i_udlandet_kroner = 0
)
= abl39a_tabsfradrag_9000 = AktieavancePar39ATabsfradrag(
    fradrag_i_udlandet = Sandt,
    negativ_skatteværdi_i_udlandet_kroner = 9000
)
= abl39a_tabsfradrag_10000 = AktieavancePar39ATabsfradrag(
    fradrag_i_udlandet = Sandt,
    negativ_skatteværdi_i_udlandet_kroner = 10000
)

= abl39a_parti_a = AktieavancePar39ABeholdningsparti(
    identifikation = "A-2018",
    selskabsidentifikation = "A",
    aktieserie = "ordinær",
    erhvervelsesdato = AktieavancePar23Dato(år = 2018, måned = 1, dag = 2),
    erhvervelsesrækkefølge = 1,
    resterende_antal = 100,
    resterende_anskaffelsessum_efter_par38_kroner = 100000,
    resterende_værdi_ved_fraflytning_kroner = 160000,
    par44_status = AblPar39AIkkeOmfattetAfPar44,
    indgik_i_nettotab_ved_fraflytning = Falskt
)
= abl39a_parti_b = AktieavancePar39ABeholdningsparti(
    identifikation = "B-2019",
    selskabsidentifikation = "B",
    aktieserie = "ordinær",
    erhvervelsesdato = AktieavancePar23Dato(år = 2019, måned = 2, dag = 3),
    erhvervelsesrækkefølge = 2,
    resterende_antal = 100,
    resterende_anskaffelsessum_efter_par38_kroner = 120000,
    resterende_værdi_ved_fraflytning_kroner = 90000,
    par44_status = AblPar39AIkkeOmfattetAfPar44,
    indgik_i_nettotab_ved_fraflytning = Sandt
)
= abl39a_parti_c_par44 = AktieavancePar39ABeholdningsparti(
    identifikation = "C-2020",
    selskabsidentifikation = "C",
    aktieserie = "ordinær",
    erhvervelsesdato = AktieavancePar23Dato(år = 2020, måned = 3, dag = 4),
    erhvervelsesrækkefølge = 3,
    resterende_antal = 50,
    resterende_anskaffelsessum_efter_par38_kroner = 20000,
    resterende_værdi_ved_fraflytning_kroner = 50000,
    par44_status = AblPar39AOmfattetAfPar44VedFraflytning,
    indgik_i_nettotab_ved_fraflytning = Falskt
)

= abl39a_tilstand = AktieavancePar39ATilstand(
    beholdning = [abl39a_parti_a, abl39a_parti_b, abl39a_parti_c_par44],
    henstandssaldo_kroner = 100000,
    forfaldsposter = [],
    uudnyttede_realiserede_tab_kan_fremføres = Falskt,
    henstand_aktiv = Sandt
)

| abl39a_afståelse_halvdelen_af_a_i_år(skatteår: Heltal) -> AktieavancePar39AAfståelsesdata(
    hændelsesidentifikation = "salg-a-halv",
    selskabsidentifikation = "A",
    aktieserie = "ordinær",
    antal = 50,
    afståelsessum_kroner = 100000,
    skatteår = skatteår,
    godkendt_fradrag_efter_ligningslov_par33_kroner = 2000,
    udenlandsk_tabsfradrag_efter_stk3 = abl39a_intet_tabsfradrag,
    udenlandsk_tabsfradrag_efter_stk4 = abl39a_intet_tabsfradrag,
    uudnyttet_realiseret_tab_kan_fremføres = Falskt
)
= abl39a_afståelse_halvdelen_af_a = abl39a_afståelse_halvdelen_af_a_i_år(skatteår = 2026)
= abl39a_afståelse_halvdelen_af_a_resultat = aktieavance_par39a_hændelsesresultat(
    tilstand = abl39a_tilstand,
    hændelse = AblPar39AAfståelse(data = abl39a_afståelse_halvdelen_af_a)
)
= abl39a_afståelse_i_ikke_understøttet_år_resultat = aktieavance_par39a_hændelsesresultat(
    tilstand = abl39a_tilstand,
    hændelse = AblPar39AAfståelse(data = abl39a_afståelse_halvdelen_af_a_i_år(skatteår = 2023))
)
= abl39a_betaling_af_a_fordring = aktieavance_par39a_hændelsesresultat(
    tilstand = abl39a_afståelse_halvdelen_af_a_resultat.tilstand_efter,
    hændelse = AblPar39ABetaling(data = AktieavancePar39ABetaling(
        forfaldsidentifikation = "salg-a-halv:stk3-gevinst",
        beløb_kroner = 11500,
        art = AblPar39ABetalingAfForfaldspost,
        friststatus = AblPar39ABetalingRettidigDen20
    ))
)

