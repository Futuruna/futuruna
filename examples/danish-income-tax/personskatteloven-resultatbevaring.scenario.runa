@ sprog da

@ importer ./personskatteloven - resultatbevaring.audit

----
Scenariet bruger syntetiske input og kontrollerer, at hvert offentligt resultat
viser komponenter og totaler fra samme beregningstrin.
----

= personskat_resultatbevaring_negativ_aktieskat_fixture = aktieindkomst_negativ_skat_par_resultat(AktieindkomstNegativSkatParInput(
    egen_negativ_skat_kroner = 50000,
    ægtefælles_negativ_skat_kroner = 0,
    egen_slutskat_før_negativ_skat_kroner = 10000,
    ægtefælles_slutskat_før_negativ_skat_kroner = 20000,
    samlevende_ved_årets_udløb = Sandt
))

| personskat_resultatbevaring_scenarie_negativ_aktieskat: personskat_resultatbevaring_negativ_aktieskat_fixture -> personskat_resultatbevaring_negativ_aktieskat_par(personskat_resultatbevaring_negativ_aktieskat_fixture) && personskat_resultatbevaring_negativ_aktieskat_fixture.egen.modregnet_i_egen_slutskat_kroner == 10000 && personskat_resultatbevaring_negativ_aktieskat_fixture.egen.modregnet_i_ægtefælles_slutskat_kroner == 20000 && personskat_resultatbevaring_negativ_aktieskat_fixture.egen.fremført_kroner == 20000

? personskat_resultatbevaring_scenarie_negativ_aktieskat
