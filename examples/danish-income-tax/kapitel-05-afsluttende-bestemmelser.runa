# Par26Stk7TopskatÆgtefællerResult(nr3_bundfradrag_kroner: Heltal, par7_bundfradrag_kroner: Heltal, kapital_grundbeløb_kroner: Heltal, egen_personligt_beregningsgrundlag_kroner: Heltal, ægtefælle_personligt_beregningsgrundlag_kroner: Heltal, højeste_beregningsgrundlag: Par7HøjesteBeregningsgrundlag, egen_kapital_over_grundbeløb_kroner: Heltal, ægtefælle_kapital_over_grundbeløb_kroner: Heltal, stk2_nr3_samlet_kapitalskat_kroner: Heltal, par7_samlet_kapitalskat_kroner: Heltal, egen_personlig_nr3_kroner: Heltal, ægtefælle_personlig_nr3_kroner: Heltal, egen_kapital_nr3_kroner: Heltal, ægtefælle_kapital_nr3_kroner: Heltal, egen_nr3_kroner: Heltal, ægtefælle_nr3_kroner: Heltal, samlet_nr3_kroner: Heltal)

| par26_gælder_for_skatteår(skatteår: Heltal) -> skatteår >= 2012 && skatteår <= 2019
| par26_positivt_beløb(beløb_kroner: Heltal) -> penge_positivt_beløb(beløb_kroner)
| par26_reguleret_2010_beløb_kroner(grundbeløb_2010_niveau_kroner: Heltal, reguleringstal_tiendedele: Heltal) -> par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
    grundbeløb_2010_niveau_kroner = grundbeløb_2010_niveau_kroner,
    reguleringstal_tiendedele = reguleringstal_tiendedele
))
| par26_bundfradrag_nr1_2010_niveau(status: Par26AlderStatus) -> 44800 under status == Par26Fyldt18EllerGift
| par26_bundfradrag_nr1_2010_niveau(status: Par26AlderStatus) -> 33600 under status == Par26Under18Ugift
| par26_bundfradrag_nr2_og_nr3_2010_niveau() -> 362800
| par26_fradragsgrundbeløb_nr5_2010_niveau() -> 14200
| par26_personfradrag_nr6_2010_niveau() -> 1900
| par26_bundfradrag_nr1_reguleret_kroner(status: Par26AlderStatus, reguleringstal_tiendedele: Heltal) -> par26_reguleret_2010_beløb_kroner(par26_bundfradrag_nr1_2010_niveau(status), reguleringstal_tiendedele)
| par26_bundfradrag_nr2_og_nr3_reguleret_kroner(reguleringstal_tiendedele: Heltal) -> par26_reguleret_2010_beløb_kroner(par26_bundfradrag_nr2_og_nr3_2010_niveau(), reguleringstal_tiendedele)
| par26_fradragsgrundbeløb_nr5_reguleret_kroner(reguleringstal_tiendedele: Heltal) -> par26_reguleret_2010_beløb_kroner(par26_fradragsgrundbeløb_nr5_2010_niveau(), reguleringstal_tiendedele)
| par26_personfradrag_nr6_reguleret_kroner(reguleringstal_tiendedele: Heltal) -> par26_reguleret_2010_beløb_kroner(par26_personfradrag_nr6_2010_niveau(), reguleringstal_tiendedele)
| par26_regulerede_beløbsgrænser(reguleringstal_tiendedele: Heltal) -> Par26ReguleredeBeløbsgrænser(
    bundfradrag_nr1_voksen_kroner = par26_bundfradrag_nr1_reguleret_kroner(Par26Fyldt18EllerGift, reguleringstal_tiendedele),
    bundfradrag_nr1_under18_kroner = par26_bundfradrag_nr1_reguleret_kroner(Par26Under18Ugift, reguleringstal_tiendedele),
    bundfradrag_nr2_og_nr3_kroner = par26_bundfradrag_nr2_og_nr3_reguleret_kroner(reguleringstal_tiendedele),
    fradragsgrundbeløb_nr5_kroner = par26_fradragsgrundbeløb_nr5_reguleret_kroner(reguleringstal_tiendedele),
    personfradrag_nr6_kroner = par26_personfradrag_nr6_reguleret_kroner(reguleringstal_tiendedele)
)
| par26_reguleringstal_tiendedele_for_skatteår(skatteår: Heltal) -> par20_reguleringstal_tiendedele(skatteår) under par26_gælder_for_skatteår(skatteår)
| par26_regulerede_beløbsgrænser_for_skatteår(skatteår: Heltal) -> par26_regulerede_beløbsgrænser(par26_reguleringstal_tiendedele_for_skatteår(skatteår)) under par26_gælder_for_skatteår(skatteår)
| par26_par7_bundfradrag_kroner_for_skatteår(skatteår: Heltal) -> par26_reguleret_2010_beløb_kroner(topskat_bundfradrag_2010_niveau_kroner(skatteår), par26_reguleringstal_tiendedele_for_skatteår(skatteår)) under par26_gælder_for_skatteår(skatteår)
| par26_sundhedsbidrag_basispoint_for_skatteår(skatteår: Heltal) -> sundhedsbidrag_sats_basispoint(skatteår) under par26_gælder_for_skatteår(skatteår)
| par26_årsparametre_for_skatteår(skatteår: Heltal) -> Par26Årsparametre(
    skatteår = skatteår,
    reguleringstal_tiendedele = par26_reguleringstal_tiendedele_for_skatteår(skatteår),
    par7_bundfradrag_kroner = par26_par7_bundfradrag_kroner_for_skatteår(skatteår),
    sundhedsbidrag_basispoint = par26_sundhedsbidrag_basispoint_for_skatteår(skatteår)
) under par26_gælder_for_skatteår(skatteår)
| par26_reguleres_efter_par20() -> Sandt
| par26_nr1_reguleret_kroner(bundskat_grundlag_kroner: Heltal, status: Par26AlderStatus, reguleringstal_tiendedele: Heltal) -> penge_beløb_gange_basispoint_kroner(par26_positivt_beløb(bundskat_grundlag_kroner - par26_bundfradrag_nr1_reguleret_kroner(status, reguleringstal_tiendedele)), 150)
| par26_nr2_med_bundfradrag_kroner(personlig_plus_positiv_kapital_kroner: Heltal, bundfradrag_kroner: Heltal) -> penge_beløb_gange_basispoint_kroner(par26_positivt_beløb(personlig_plus_positiv_kapital_kroner - bundfradrag_kroner), 600)
| par26_nr2_reguleret_kroner(personlig_plus_positiv_kapital_kroner: Heltal, reguleringstal_tiendedele: Heltal) -> par26_nr2_med_bundfradrag_kroner(personlig_plus_positiv_kapital_kroner, par26_bundfradrag_nr2_og_nr3_reguleret_kroner(reguleringstal_tiendedele))
| par26_nr3_reguleret_kroner(topskat_grundlag_kroner: Heltal, par7_bundfradrag_kroner: Heltal, reguleringstal_tiendedele: Heltal) -> penge_beløb_gange_basispoint_kroner(par26_positivt_beløb(topskat_grundlag_kroner - par26_bundfradrag_nr2_og_nr3_reguleret_kroner(reguleringstal_tiendedele)), 1500) - penge_beløb_gange_basispoint_kroner(par26_positivt_beløb(topskat_grundlag_kroner - par7_bundfradrag_kroner), 1500)
| par26_nr1_kroner(bundskat_grundlag_kroner: Heltal, status: Par26AlderStatus) -> par26_nr1_reguleret_kroner(bundskat_grundlag_kroner, status, 1000)
| par26_nr2_kroner(personlig_plus_positiv_kapital_kroner: Heltal) -> par26_nr2_reguleret_kroner(personlig_plus_positiv_kapital_kroner, 1000)
| par26_nr3_kroner(topskat_grundlag_kroner: Heltal, par7_bundfradrag_kroner: Heltal) -> par26_nr3_reguleret_kroner(topskat_grundlag_kroner, par7_bundfradrag_kroner, 1000)
| par26_stk7_topskat_personligt_beregningsgrundlag_kroner(personlig_indkomst_kroner: Heltal, pbl16_tillæg_kroner: Heltal) -> personlig_indkomst_kroner + pbl16_tillæg_kroner
| par26_stk7_skat_for_bundfradrag_kroner(grundlag_kroner: Heltal, bundfradrag_kroner: Heltal) -> penge_beløb_gange_basispoint_kroner(par26_positivt_beløb(grundlag_kroner - bundfradrag_kroner), topskat_sats_basispoint())
| par26_stk7_nr3_forskelsbeløb_kroner(grundlag_kroner: Heltal, nr3_bundfradrag_kroner: Heltal, par7_bundfradrag_kroner: Heltal) -> par26_positivt_beløb(par26_stk7_skat_for_bundfradrag_kroner(grundlag_kroner, nr3_bundfradrag_kroner) - par26_stk7_skat_for_bundfradrag_kroner(grundlag_kroner, par7_bundfradrag_kroner))
| par26_nr4_kroner(aktieindkomstskat_grundlag_kroner: Heltal) -> penge_beløb_gange_basispoint_kroner(aktieindkomstskat_grundlag_kroner, 100)
| par26_nr5_kroner(fradrag_efter_ll9j_9k_9l_kroner: Heltal, kommunal_og_kirke_basispoint: Heltal, baseline_fradrag_kroner: Heltal) -> penge_beløb_gange_basispoint_kroner(fradrag_efter_ll9j_9k_9l_kroner, 800 + kommunal_og_kirke_basispoint) - penge_beløb_gange_basispoint_kroner(baseline_fradrag_kroner, 425)
| par26_nr5_ll_input(input: Par26Nr5LigningsfradragInput) -> Ligningslov9J9K9LInput(
    skatteår = input.skatteår,
    arbejdsmarkedsbidragsgrundlag_kroner = input.arbejdsmarkedsbidragsgrundlag_kroner,
    udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver = input.udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver,
    pensionsalder_status = input.pensionsalder_status,
    pbl18_fradragsberettiget_indbetaling_kroner = input.pbl18_fradragsberettiget_indbetaling_kroner,
    pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = input.pbl19_rate_ophørende_bortseelsesret_efter_am_kroner,
    pbl19_øvrige_indbetalinger_efter_am_kroner = input.pbl19_øvrige_indbetalinger_efter_am_kroner,
    pbl20_indkomstskattepligtig_udbetaling_kroner = input.pbl20_indkomstskattepligtig_udbetaling_kroner,
    pbl20_udbetaling_status = input.pbl20_udbetaling_status
)
| par26_nr5_baseline_grundbeløb_kroner(skatteår: Heltal) -> par26_fradragsgrundbeløb_nr5_reguleret_kroner(par26_reguleringstal_tiendedele_for_skatteår(skatteår)) under par26_gælder_for_skatteår(skatteår)
| par26_nr5_baseline_beregnet_kroner(input: Par26Nr5LigningsfradragInput) -> penge_beløb_gange_basispoint_kroner(par26_positivt_beløb(input.arbejdsmarkedsbidragsgrundlag_kroner), 425)
| par26_nr5_baseline_fradrag_kroner(input: Par26Nr5LigningsfradragInput) -> 0
| exception par26_nr5_samme_betingelser_som_ll9j par26_nr5_baseline_fradrag_kroner(input: Par26Nr5LigningsfradragInput) -> penge_mindste_beløb(par26_nr5_baseline_beregnet_kroner(input), par26_nr5_baseline_grundbeløb_kroner(input.skatteår)) under input.udenlandsk_hjemmehørende_udenlandsk_arbejdsgiver == Falskt
| par26_nr5_ligningsfradrag_resultat(input: Par26Nr5LigningsfradragInput) -> Par26Nr5LigningsfradragResult(
    fradrag_efter_ll9j_9k_9l_kroner = ll9j_9k_9l_fradrag_resultat(par26_nr5_ll_input(input)).samlet_fradrag_kroner,
    baseline_fradrag_efter_425pct_grundbeløb_kroner = par26_nr5_baseline_fradrag_kroner(input),
    nr5_kroner = par26_nr5_kroner(ll9j_9k_9l_fradrag_resultat(par26_nr5_ll_input(input)).samlet_fradrag_kroner, input.kommunal_og_kirke_basispoint, par26_nr5_baseline_fradrag_kroner(input))
)
| par26_nr8_kroner(negativ_kapital_og_ligningsmæssige_fradrag_kroner: Heltal, sundhedsbidrag_basispoint: Heltal) -> penge_beløb_gange_basispoint_kroner(negativ_kapital_og_ligningsmæssige_fradrag_kroner, 800 - sundhedsbidrag_basispoint)
| par26_personlig_plus_positiv_kapital_efter_stk5(personlig_indkomst_kroner: Heltal, nettokapitalindkomst_efter_stk5_kroner: Heltal) -> personlig_indkomst_kroner + par26_positivt_beløb(nettokapitalindkomst_efter_stk5_kroner)
| par26_negativ_kapital_over_par11_og_ligningsfradrag_efter_stk8(nettokapitalindkomst_efter_stk8_kroner: Heltal, ligningsmæssige_fradrag_til_nr8_kroner: Heltal) -> par26_positivt_beløb(par26_positivt_beløb(0 - nettokapitalindkomst_efter_stk8_kroner) - par11_beløbsgrænse_kroner()) + ligningsmæssige_fradrag_til_nr8_kroner
| par26_forskelsbeløb_før_nr8(input: Par26ForskelsbeløbInput) -> par26_positivt_beløb(input.nr1_kroner + input.nr2_kroner + input.nr3_kroner + input.nr4_kroner + input.nr5_kroner - input.nr6_kroner - input.nr7_kroner)
| par26_forskelsbeløb_efter_stk3(input: Par26ForskelsbeløbInput) -> par26_forskelsbeløb_før_nr8(input) - input.nr8_kroner
| par26_kompensation_kroner(input: Par26ForskelsbeløbInput) -> hvis par26_gælder_for_skatteår(input.skatteår) && input.betaler_kommunal_eller_par8c && par26_forskelsbeløb_efter_stk3(input) < 0 { 0 - par26_forskelsbeløb_efter_stk3(input) } ellers { 0 }
| par26_forskelsbeløb_beregning_fra_poster(regulerede_beløbsgrænser: Par26ReguleredeBeløbsgrænser, input: Par26ForskelsbeløbInput) -> Par26ForskelsbeløbBeregning(
    regulerede_beløbsgrænser = regulerede_beløbsgrænser,
    nr1_kroner = input.nr1_kroner,
    nr2_kroner = input.nr2_kroner,
    nr3_kroner = input.nr3_kroner,
    nr4_kroner = input.nr4_kroner,
    nr5_kroner = input.nr5_kroner,
    nr6_kroner = input.nr6_kroner,
    nr7_kroner = input.nr7_kroner,
    nr8_kroner = input.nr8_kroner,
    forskelsbeløb_før_nr8_kroner = par26_forskelsbeløb_før_nr8(input),
    forskelsbeløb_efter_stk3_kroner = par26_forskelsbeløb_efter_stk3(input),
    kompensation_kroner = par26_kompensation_kroner(input)
)
# Par26ForskelsbeløbSag(input: Par26ForskelsbeløbBeregningsInput) {
    | regulerede_beløbsgrænser() -> par26_regulerede_beløbsgrænser(input.reguleringstal_tiendedele)
    | nr1() -> par26_nr1_reguleret_kroner(input.bundskat_grundlag_kroner, input.alder_status, input.reguleringstal_tiendedele)
    | nr2() -> par26_nr2_reguleret_kroner(input.personlig_plus_positiv_kapital_kroner, input.reguleringstal_tiendedele)
    | nr3() -> par26_nr3_reguleret_kroner(input.topskat_grundlag_kroner, input.par7_bundfradrag_kroner, input.reguleringstal_tiendedele)
    | nr4() -> par26_nr4_kroner(input.aktieindkomstskat_grundlag_kroner)
    | nr5() -> par26_nr5_kroner(input.fradrag_efter_ll9j_9k_9l_kroner, input.kommunal_og_kirke_basispoint, input.baseline_fradrag_efter_425pct_grundbeløb_kroner)
    | nr6() -> input.personfradrag_nr6_skatteværdi_kroner
    | nr7() -> input.udligningsskat_kroner
    | nr8() -> par26_nr8_kroner(input.negativ_kapital_over_par11_og_ligningsfradrag_kroner, input.sundhedsbidrag_basispoint)
    | forskelsbeløb_input() -> Par26ForskelsbeløbInput(
        skatteår = input.skatteår,
        nr1_kroner = nr1(),
        nr2_kroner = nr2(),
        nr3_kroner = nr3(),
        nr4_kroner = nr4(),
        nr5_kroner = nr5(),
        nr6_kroner = nr6(),
        nr7_kroner = nr7(),
        nr8_kroner = nr8(),
        betaler_kommunal_eller_par8c = input.betaler_kommunal_eller_par8c
    )
    | forskelsbeløb_før_nr8() -> par26_forskelsbeløb_før_nr8(forskelsbeløb_input())
    | forskelsbeløb_efter_stk3() -> par26_forskelsbeløb_efter_stk3(forskelsbeløb_input())
    | kompensation() -> par26_kompensation_kroner(forskelsbeløb_input())
    | resultat() -> par26_forskelsbeløb_beregning_fra_poster(regulerede_beløbsgrænser(), forskelsbeløb_input())
}
| par26_forskelsbeløb_sag(input: Par26ForskelsbeløbBeregningsInput) -> Par26ForskelsbeløbSag(input)
| par26_forskelsbeløb_beregning(input: Par26ForskelsbeløbBeregningsInput) -> par26_forskelsbeløb_sag(input).resultat()
# Par26ForskelsbeløbÅrsSag(input: Par26ForskelsbeløbÅrsInput) {
    | årsparametre() -> par26_årsparametre_for_skatteår(input.skatteår)
    | beregningsinput() -> Par26ForskelsbeløbBeregningsInput(
        skatteår = input.skatteår,
        reguleringstal_tiendedele = årsparametre().reguleringstal_tiendedele,
        alder_status = input.alder_status,
        bundskat_grundlag_kroner = input.bundskat_grundlag_kroner,
        personlig_plus_positiv_kapital_kroner = input.personlig_plus_positiv_kapital_kroner,
        topskat_grundlag_kroner = input.topskat_grundlag_kroner,
        par7_bundfradrag_kroner = årsparametre().par7_bundfradrag_kroner,
        aktieindkomstskat_grundlag_kroner = input.aktieindkomstskat_grundlag_kroner,
        fradrag_efter_ll9j_9k_9l_kroner = input.fradrag_efter_ll9j_9k_9l_kroner,
        kommunal_og_kirke_basispoint = input.kommunal_og_kirke_basispoint,
        baseline_fradrag_efter_425pct_grundbeløb_kroner = input.baseline_fradrag_efter_425pct_grundbeløb_kroner,
        personfradrag_nr6_skatteværdi_kroner = input.personfradrag_nr6_skatteværdi_kroner,
        udligningsskat_kroner = input.udligningsskat_kroner,
        negativ_kapital_over_par11_og_ligningsfradrag_kroner = input.negativ_kapital_over_par11_og_ligningsfradrag_kroner,
        sundhedsbidrag_basispoint = årsparametre().sundhedsbidrag_basispoint,
        betaler_kommunal_eller_par8c = input.betaler_kommunal_eller_par8c
    )
    | resultat() -> par26_forskelsbeløb_beregning(beregningsinput())
}
| par26_forskelsbeløb_års_sag(input: Par26ForskelsbeløbÅrsInput) -> Par26ForskelsbeløbÅrsSag(input)
| par26_forskelsbeløb_beregningsinput_med_årsparametre(input: Par26ForskelsbeløbÅrsInput) -> par26_forskelsbeløb_års_sag(input).beregningsinput()
| par26_forskelsbeløb_beregning_for_skatteår(input: Par26ForskelsbeløbÅrsInput) -> par26_forskelsbeløb_års_sag(input).resultat()
| par26_forskelsbeløb_input_med_nr2_bundfradrag(års_input: Par26ForskelsbeløbÅrsInput, årsparametre: Par26Årsparametre, effektivt_bundfradrag_nr2_kroner: Heltal) -> Par26ForskelsbeløbInput(
    skatteår = års_input.skatteår,
    nr1_kroner = par26_nr1_reguleret_kroner(års_input.bundskat_grundlag_kroner, års_input.alder_status, årsparametre.reguleringstal_tiendedele),
    nr2_kroner = par26_nr2_med_bundfradrag_kroner(års_input.personlig_plus_positiv_kapital_kroner, effektivt_bundfradrag_nr2_kroner),
    nr3_kroner = par26_nr3_reguleret_kroner(års_input.topskat_grundlag_kroner, årsparametre.par7_bundfradrag_kroner, årsparametre.reguleringstal_tiendedele),
    nr4_kroner = par26_nr4_kroner(års_input.aktieindkomstskat_grundlag_kroner),
    nr5_kroner = par26_nr5_kroner(års_input.fradrag_efter_ll9j_9k_9l_kroner, års_input.kommunal_og_kirke_basispoint, års_input.baseline_fradrag_efter_425pct_grundbeløb_kroner),
    nr6_kroner = års_input.personfradrag_nr6_skatteværdi_kroner,
    nr7_kroner = års_input.udligningsskat_kroner,
    nr8_kroner = par26_nr8_kroner(års_input.negativ_kapital_over_par11_og_ligningsfradrag_kroner, årsparametre.sundhedsbidrag_basispoint),
    betaler_kommunal_eller_par8c = års_input.betaler_kommunal_eller_par8c
)
| par26_ubrugt_efter_skat(skat_kroner: Heltal, kompensation_kroner: Heltal) -> penge_positivt_beløb(kompensation_kroner - skat_kroner)
| par26_skat_efter_kompensation(skat_kroner: Heltal, kompensation_kroner: Heltal) -> penge_positivt_beløb(skat_kroner - kompensation_kroner)
| par26_rester_efter_par6(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.par6_skat_kroner, input.kompensation_kroner)
| par26_rester_efter_par7(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.par7_skat_kroner, par26_rester_efter_par6(input))
| par26_rester_efter_par7a(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.par7a_skat_kroner, par26_rester_efter_par7(input))
| par26_rester_efter_par8(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.par8_skat_kroner, par26_rester_efter_par7a(input))
| par26_rester_efter_par8a_stk2(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.par8a_stk2_skat_kroner, par26_rester_efter_par8(input))
| par26_rester_efter_par8c(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.par8c_skat_kroner, par26_rester_efter_par8a_stk2(input))
| par26_rester_efter_kommuneskat(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.kommuneskat_kroner, par26_rester_efter_par8c(input))
| par26_rester_efter_kirkeskat(input: Par26ModregningInput) -> par26_ubrugt_efter_skat(input.kirkeskat_kroner, par26_rester_efter_kommuneskat(input))
| par26_modregning_resultat(input: Par26ModregningInput) -> Par26ModregningResult(
    par6_efter_kroner = par26_skat_efter_kompensation(input.par6_skat_kroner, input.kompensation_kroner),
    par7_efter_kroner = par26_skat_efter_kompensation(input.par7_skat_kroner, par26_rester_efter_par6(input)),
    par7a_efter_kroner = par26_skat_efter_kompensation(input.par7a_skat_kroner, par26_rester_efter_par7(input)),
    par8_efter_kroner = par26_skat_efter_kompensation(input.par8_skat_kroner, par26_rester_efter_par7a(input)),
    par8a_stk2_efter_kroner = par26_skat_efter_kompensation(input.par8a_stk2_skat_kroner, par26_rester_efter_par8(input)),
    par8c_efter_kroner = par26_skat_efter_kompensation(input.par8c_skat_kroner, par26_rester_efter_par8a_stk2(input)),
    kommuneskat_efter_kroner = par26_skat_efter_kompensation(input.kommuneskat_kroner, par26_rester_efter_par8c(input)),
    kirkeskat_efter_kroner = par26_skat_efter_kompensation(input.kirkeskat_kroner, par26_rester_efter_kommuneskat(input)),
    ubrugt_kompensation_kroner = par26_rester_efter_kirkeskat(input)
)
# Par26KompensationAfregningSag(input: Par26KompensationAfregningInput) {
    | forskelsbeløb() -> par26_forskelsbeløb_beregning_for_skatteår(input.forskelsbeløb_års_input)
    | modregning_input() -> Par26ModregningInput(
        kompensation_kroner = forskelsbeløb().kompensation_kroner,
        par6_skat_kroner = input.par6_skat_kroner,
        par7_skat_kroner = input.par7_skat_kroner,
        par7a_skat_kroner = input.par7a_skat_kroner,
        par8_skat_kroner = input.par8_skat_kroner,
        par8a_stk2_skat_kroner = input.par8a_stk2_skat_kroner,
        par8c_skat_kroner = input.par8c_skat_kroner,
        kommuneskat_kroner = input.kommuneskat_kroner,
        kirkeskat_kroner = input.kirkeskat_kroner
    )
    | modregning() -> par26_modregning_resultat(modregning_input())
    | samlet_skat_efter_modregning() -> modregning().par6_efter_kroner + modregning().par7_efter_kroner + modregning().par7a_efter_kroner + modregning().par8_efter_kroner + modregning().par8a_stk2_efter_kroner + modregning().par8c_efter_kroner + modregning().kommuneskat_efter_kroner + modregning().kirkeskat_efter_kroner
    | resultat() -> Par26KompensationAfregningResult(
        forskelsbeløb = forskelsbeløb(),
        modregning = modregning(),
        kompensation_kroner = forskelsbeløb().kompensation_kroner,
        samlet_skat_efter_modregning_kroner = samlet_skat_efter_modregning()
    )
}
| par26_kompensation_afregning_sag(input: Par26KompensationAfregningInput) -> Par26KompensationAfregningSag(input)
| par26_kompensation_afregning_resultat(input: Par26KompensationAfregningInput) -> par26_kompensation_afregning_sag(input).resultat()
| par26_positivt_forskelsbeløb_nedsætter_ægtefælles_negative(status: Par26ÆgtefælleStatus) -> status == Par26GiftSamlevendeVedÅretsUdløb
| par26_negativ_kapital_modregnes_i_ægtefælles_positive(status: Par26ÆgtefælleStatus) -> status == Par26GiftSamlevendeVedÅretsUdløb
| par26_lavt_personligt_grundlag_forhøjer_ægtefælles_bundfradrag(status: Par26ÆgtefælleStatus) -> status == Par26GiftSamlevendeVedÅretsUdløb
| exception forskerordning_48f par26_lavt_personligt_grundlag_forhøjer_ægtefælles_bundfradrag(status: Par26ÆgtefælleStatus) -> Falskt under status == Par26Forskerordning48FValgt
| par26_par7_ægtefælleregler_anvendes_for_nr3(status: Par26ÆgtefælleStatus) -> status == Par26GiftSamlevendeVedÅretsUdløb
| par26_positiv_kapital_modregnes_i_ægtefælles_negative(status: Par26ÆgtefælleStatus) -> status == Par26GiftSamlevendeVedÅretsUdløb
| par26_kompensation_kræver_kommunal_eller_par8c(input: Par26ForskelsbeløbInput) -> input.betaler_kommunal_eller_par8c
# Par26Stk7TopskatÆgtefællerSag(input: Par26Stk7TopskatÆgtefællerInput) {
    | reguleringstal_tiendedele() -> par26_reguleringstal_tiendedele_for_skatteår(input.skatteår)
    | nr3_bundfradrag_kroner() -> par26_bundfradrag_nr2_og_nr3_reguleret_kroner(reguleringstal_tiendedele())
    | par7_bundfradrag_kroner() -> par26_par7_bundfradrag_kroner_for_skatteår(input.skatteår)
    | kapital_grundbeløb_kroner() -> par7_positiv_kapital_grundbeløb_kroner_for_skatteår(input.skatteår)
    | egen_personligt_beregningsgrundlag_kroner() -> par26_stk7_topskat_personligt_beregningsgrundlag_kroner(input.egen_personlig_indkomst_kroner, input.egen_pbl16_tillæg_kroner)
    | ægtefælle_personligt_beregningsgrundlag_kroner() -> par26_stk7_topskat_personligt_beregningsgrundlag_kroner(input.ægtefælle_personlig_indkomst_kroner, input.ægtefælle_pbl16_tillæg_kroner)
    | højeste_beregningsgrundlag() -> par7_højeste_beregningsgrundlag(Par7ÆgtefælleBeregningsgrundlagInput(
        egen_beregningsgrundlag_efter_stk7_kroner = egen_personligt_beregningsgrundlag_kroner(),
        ægtefælles_beregningsgrundlag_efter_stk7_kroner = ægtefælle_personligt_beregningsgrundlag_kroner(),
        egne_ligningsmæssige_fradrag_kroner = input.egne_ligningsmæssige_fradrag_kroner,
        ægtefælles_ligningsmæssige_fradrag_kroner = input.ægtefælles_ligningsmæssige_fradrag_kroner
    ))
    | højeste_personligt_beregningsgrundlag_kroner() -> egen_personligt_beregningsgrundlag_kroner()
    | exception par26_stk7_ægtefælle_højeste_beregningsgrundlag højeste_personligt_beregningsgrundlag_kroner() -> ægtefælle_personligt_beregningsgrundlag_kroner() under højeste_beregningsgrundlag() == ÆgtefælleHøjesteBeregningsgrundlag
    | egen_stk5_input() -> Par7ÆgtefælleKapitalStk5Input(
        nettokapitalindkomst_kroner = input.ægtefælle_nettokapitalindkomst_kroner,
        ægtefælle_positiv_nettokapitalindkomst_kroner = par26_positivt_beløb(input.egen_nettokapitalindkomst_kroner),
        grundbeløb_kroner = kapital_grundbeløb_kroner(),
        samlevende_ved_årets_udløb = input.samlevende_i_hele_indkomståret
    )
    | ægtefælle_stk5_input() -> Par7ÆgtefælleKapitalStk5Input(
        nettokapitalindkomst_kroner = input.egen_nettokapitalindkomst_kroner,
        ægtefælle_positiv_nettokapitalindkomst_kroner = par26_positivt_beløb(input.ægtefælle_nettokapitalindkomst_kroner),
        grundbeløb_kroner = kapital_grundbeløb_kroner(),
        samlevende_ved_årets_udløb = input.samlevende_i_hele_indkomståret
    )
    | egen_kapital_over_grundbeløb_kroner() -> par7_ægtefællekapital_stk5_over_grundbeløb_kroner(egen_stk5_input())
    | ægtefælle_kapital_over_grundbeløb_kroner() -> par7_ægtefællekapital_stk5_over_grundbeløb_kroner(ægtefælle_stk5_input())
    | samlet_kapital_over_grundbeløb_kroner() -> egen_kapital_over_grundbeløb_kroner() + ægtefælle_kapital_over_grundbeløb_kroner()
    | højeste_personlig_skat_for_bundfradrag_kroner(bundfradrag_kroner: Heltal) -> par26_stk7_skat_for_bundfradrag_kroner(højeste_personligt_beregningsgrundlag_kroner(), bundfradrag_kroner)
    | samlet_skat_med_kapital_for_bundfradrag_kroner(bundfradrag_kroner: Heltal) -> par26_stk7_skat_for_bundfradrag_kroner(højeste_personligt_beregningsgrundlag_kroner() + samlet_kapital_over_grundbeløb_kroner(), bundfradrag_kroner)
    | samlet_kapitalskat_for_bundfradrag_kroner(bundfradrag_kroner: Heltal) -> par26_positivt_beløb(samlet_skat_med_kapital_for_bundfradrag_kroner(bundfradrag_kroner) - højeste_personlig_skat_for_bundfradrag_kroner(bundfradrag_kroner))
    | kapitalskat_fordeling_for_bundfradrag(bundfradrag_kroner: Heltal) -> par7_kapitalskat_fordeling_resultat(Par7KapitalskatFordelingInput(
        samlet_kapitalskat_kroner = samlet_kapitalskat_for_bundfradrag_kroner(bundfradrag_kroner),
        egen_nettokapitalindkomst_over_grundbeløb_kroner = egen_kapital_over_grundbeløb_kroner(),
        ægtefælles_nettokapitalindkomst_over_grundbeløb_kroner = ægtefælle_kapital_over_grundbeløb_kroner()
    ))
    | stk2_nr3_kapitalfordeling() -> kapitalskat_fordeling_for_bundfradrag(nr3_bundfradrag_kroner())
    | par7_kapitalfordeling() -> kapitalskat_fordeling_for_bundfradrag(par7_bundfradrag_kroner())
    | egen_personlig_nr3_kroner() -> par26_stk7_nr3_forskelsbeløb_kroner(egen_personligt_beregningsgrundlag_kroner(), nr3_bundfradrag_kroner(), par7_bundfradrag_kroner())
    | ægtefælle_personlig_nr3_kroner() -> par26_stk7_nr3_forskelsbeløb_kroner(ægtefælle_personligt_beregningsgrundlag_kroner(), nr3_bundfradrag_kroner(), par7_bundfradrag_kroner())
    | egen_kapital_nr3_kroner() -> par26_positivt_beløb(stk2_nr3_kapitalfordeling().egen_kapitalskat_kroner - par7_kapitalfordeling().egen_kapitalskat_kroner)
    | ægtefælle_kapital_nr3_kroner() -> par26_positivt_beløb(stk2_nr3_kapitalfordeling().ægtefælles_kapitalskat_kroner - par7_kapitalfordeling().ægtefælles_kapitalskat_kroner)
    | egen_nr3_kroner() -> egen_personlig_nr3_kroner() + egen_kapital_nr3_kroner()
    | ægtefælle_nr3_kroner() -> ægtefælle_personlig_nr3_kroner() + ægtefælle_kapital_nr3_kroner()
    | resultat() -> Par26Stk7TopskatÆgtefællerResult(
        nr3_bundfradrag_kroner = nr3_bundfradrag_kroner(),
        par7_bundfradrag_kroner = par7_bundfradrag_kroner(),
        kapital_grundbeløb_kroner = kapital_grundbeløb_kroner(),
        egen_personligt_beregningsgrundlag_kroner = egen_personligt_beregningsgrundlag_kroner(),
        ægtefælle_personligt_beregningsgrundlag_kroner = ægtefælle_personligt_beregningsgrundlag_kroner(),
        højeste_beregningsgrundlag = højeste_beregningsgrundlag(),
        egen_kapital_over_grundbeløb_kroner = egen_kapital_over_grundbeløb_kroner(),
        ægtefælle_kapital_over_grundbeløb_kroner = ægtefælle_kapital_over_grundbeløb_kroner(),
        stk2_nr3_samlet_kapitalskat_kroner = stk2_nr3_kapitalfordeling().samlet_kapitalskat_kroner,
        par7_samlet_kapitalskat_kroner = par7_kapitalfordeling().samlet_kapitalskat_kroner,
        egen_personlig_nr3_kroner = egen_personlig_nr3_kroner(),
        ægtefælle_personlig_nr3_kroner = ægtefælle_personlig_nr3_kroner(),
        egen_kapital_nr3_kroner = egen_kapital_nr3_kroner(),
        ægtefælle_kapital_nr3_kroner = ægtefælle_kapital_nr3_kroner(),
        egen_nr3_kroner = egen_nr3_kroner(),
        ægtefælle_nr3_kroner = ægtefælle_nr3_kroner(),
        samlet_nr3_kroner = egen_nr3_kroner() + ægtefælle_nr3_kroner()
    )
}
| par26_stk7_topskat_ægtefæller_sag(input: Par26Stk7TopskatÆgtefællerInput) -> Par26Stk7TopskatÆgtefællerSag(input)
| par26_stk7_topskat_ægtefæller_resultat(input: Par26Stk7TopskatÆgtefællerInput) -> par26_stk7_topskat_ægtefæller_sag(input).resultat()
# Par26ÆgtefælleForskelsbeløbSag(input: Par26ÆgtefælleForskelsbeløbInput) {
    | egen_positive_forskelsbeløb() -> par26_positivt_beløb(input.egen_forskelsbeløb_efter_stk3_kroner)
    | ægtefælle_negative_forskelsbeløb_abs() -> par26_positivt_beløb(0 - input.ægtefælle_forskelsbeløb_efter_stk3_kroner)
    | positivt_modregnet_i_ægtefælle() -> 0
    | exception stk4_samlevende_modregner_positivt_forskelsbeløb positivt_modregnet_i_ægtefælle() -> penge_mindste_beløb(egen_positive_forskelsbeløb(), ægtefælle_negative_forskelsbeløb_abs()) under par26_positivt_forskelsbeløb_nedsætter_ægtefælles_negative(input.status)
    | ægtefælle_forskelsbeløb_efter_stk4() -> input.ægtefælle_forskelsbeløb_efter_stk3_kroner
    | exception stk4_negativt_forskelsbeløb_nedsat ægtefælle_forskelsbeløb_efter_stk4() -> 0 - (ægtefælle_negative_forskelsbeløb_abs() - positivt_modregnet_i_ægtefælle()) under input.ægtefælle_forskelsbeløb_efter_stk3_kroner < 0
    | ægtefælle_kompensation_efter_stk4() -> par26_positivt_beløb(0 - ægtefælle_forskelsbeløb_efter_stk4())
    | resultat() -> Par26ÆgtefælleForskelsbeløbResult(
        positivt_forskelsbeløb_modregnet_kroner = positivt_modregnet_i_ægtefælle(),
        ægtefælle_forskelsbeløb_efter_stk4_kroner = ægtefælle_forskelsbeløb_efter_stk4(),
        ægtefælle_kompensation_efter_stk4_kroner = ægtefælle_kompensation_efter_stk4()
    )
}
| par26_ægtefælle_forskelsbeløb_resultat(input: Par26ÆgtefælleForskelsbeløbInput) -> Par26ÆgtefælleForskelsbeløbSag(input).resultat()
# Par26ÆgtefælleForskelsbeløbParSag(input: Par26ÆgtefælleForskelsbeløbParInput) {
    | egen_til_ægtefælle() -> par26_ægtefælle_forskelsbeløb_resultat(Par26ÆgtefælleForskelsbeløbInput(
        status = input.status,
        egen_forskelsbeløb_efter_stk3_kroner = input.egen_forskelsbeløb_efter_stk3_kroner,
        ægtefælle_forskelsbeløb_efter_stk3_kroner = input.ægtefælle_forskelsbeløb_efter_stk3_kroner
    ))
    | ægtefælle_til_egen() -> par26_ægtefælle_forskelsbeløb_resultat(Par26ÆgtefælleForskelsbeløbInput(
        status = input.status,
        egen_forskelsbeløb_efter_stk3_kroner = input.ægtefælle_forskelsbeløb_efter_stk3_kroner,
        ægtefælle_forskelsbeløb_efter_stk3_kroner = input.egen_forskelsbeløb_efter_stk3_kroner
    ))
    | egen_forskelsbeløb_efter_stk4() -> ægtefælle_til_egen().ægtefælle_forskelsbeløb_efter_stk4_kroner
    | ægtefælle_forskelsbeløb_efter_stk4() -> egen_til_ægtefælle().ægtefælle_forskelsbeløb_efter_stk4_kroner
    | egen_kompensation_efter_stk4() -> par26_positivt_beløb(0 - egen_forskelsbeløb_efter_stk4())
    | ægtefælle_kompensation_efter_stk4() -> par26_positivt_beløb(0 - ægtefælle_forskelsbeløb_efter_stk4())
    | resultat() -> Par26ÆgtefælleForskelsbeløbParResult(
        egen_forskelsbeløb_efter_stk4_kroner = egen_forskelsbeløb_efter_stk4(),
        ægtefælle_forskelsbeløb_efter_stk4_kroner = ægtefælle_forskelsbeløb_efter_stk4(),
        egen_kompensation_efter_stk4_kroner = egen_kompensation_efter_stk4(),
        ægtefælle_kompensation_efter_stk4_kroner = ægtefælle_kompensation_efter_stk4(),
        modregnet_fra_egen_til_ægtefælle_kroner = egen_til_ægtefælle().positivt_forskelsbeløb_modregnet_kroner,
        modregnet_fra_ægtefælle_til_egen_kroner = ægtefælle_til_egen().positivt_forskelsbeløb_modregnet_kroner,
        samlet_kompensation_efter_stk4_kroner = egen_kompensation_efter_stk4() + ægtefælle_kompensation_efter_stk4()
    )
}
| par26_ægtefælle_forskelsbeløb_par_sag(input: Par26ÆgtefælleForskelsbeløbParInput) -> Par26ÆgtefælleForskelsbeløbParSag(input)
| par26_ægtefælle_forskelsbeløb_par_resultat(input: Par26ÆgtefælleForskelsbeløbParInput) -> par26_ægtefælle_forskelsbeløb_par_sag(input).resultat()
# Par26Stk5NegativKapitalSag(input: Par26Stk5NegativKapitalInput) {
    | egen_negativ_abs() -> par26_positivt_beløb(0 - input.negativ_nettokapitalindkomst_kroner)
    | ægtefælle_positiv() -> par26_positivt_beløb(input.ægtefælle_positiv_nettokapitalindkomst_kroner)
    | modregnet_i_ægtefælles_positive() -> 0
    | exception stk5_samlevende_modregner_negativ_kapital modregnet_i_ægtefælles_positive() -> penge_mindste_beløb(egen_negativ_abs(), ægtefælle_positiv()) under par26_negativ_kapital_modregnes_i_ægtefælles_positive(input.status)
    | resultat() -> Par26Stk5NegativKapitalResult(
        modregnet_i_ægtefælles_positive_kroner = modregnet_i_ægtefælles_positive(),
        negativ_nettokapitalindkomst_efter_modregning_kroner = 0 - (egen_negativ_abs() - modregnet_i_ægtefælles_positive()),
        ægtefælle_positiv_nettokapitalindkomst_efter_modregning_kroner = ægtefælle_positiv() - modregnet_i_ægtefælles_positive()
    )
}
| par26_stk5_negativ_kapital_resultat(input: Par26Stk5NegativKapitalInput) -> Par26Stk5NegativKapitalSag(input).resultat()
# Par26Stk5KapitalParSag(input: Par26Stk5KapitalParInput) {
    | egen_negativ_mod_ægtefælle() -> par26_stk5_negativ_kapital_resultat(Par26Stk5NegativKapitalInput(
        status = input.status,
        negativ_nettokapitalindkomst_kroner = input.egen_nettokapitalindkomst_kroner,
        ægtefælle_positiv_nettokapitalindkomst_kroner = input.ægtefælle_nettokapitalindkomst_kroner
    ))
    | ægtefælle_negativ_mod_egen() -> par26_stk5_negativ_kapital_resultat(Par26Stk5NegativKapitalInput(
        status = input.status,
        negativ_nettokapitalindkomst_kroner = input.ægtefælle_nettokapitalindkomst_kroner,
        ægtefælle_positiv_nettokapitalindkomst_kroner = input.egen_nettokapitalindkomst_kroner
    ))
    | modregnet_fra_egen_til_ægtefælle() -> 0
    | exception stk5_egen_negativ_modregnes_i_ægtefælle modregnet_fra_egen_til_ægtefælle() -> egen_negativ_mod_ægtefælle().modregnet_i_ægtefælles_positive_kroner under input.egen_nettokapitalindkomst_kroner < 0 && input.ægtefælle_nettokapitalindkomst_kroner > 0
    | modregnet_fra_ægtefælle_til_egen() -> 0
    | exception stk5_ægtefælle_negativ_modregnes_i_egen modregnet_fra_ægtefælle_til_egen() -> ægtefælle_negativ_mod_egen().modregnet_i_ægtefælles_positive_kroner under input.ægtefælle_nettokapitalindkomst_kroner < 0 && input.egen_nettokapitalindkomst_kroner > 0
    | egen_nettokapitalindkomst_efter_stk5() -> input.egen_nettokapitalindkomst_kroner
    | exception stk5_egen_negativ_efter_modregning egen_nettokapitalindkomst_efter_stk5() -> egen_negativ_mod_ægtefælle().negativ_nettokapitalindkomst_efter_modregning_kroner under input.egen_nettokapitalindkomst_kroner < 0
    | exception stk5_egen_positiv_nedsat_af_ægtefælle egen_nettokapitalindkomst_efter_stk5() -> ægtefælle_negativ_mod_egen().ægtefælle_positiv_nettokapitalindkomst_efter_modregning_kroner under input.egen_nettokapitalindkomst_kroner > 0 && input.ægtefælle_nettokapitalindkomst_kroner < 0
    | ægtefælle_nettokapitalindkomst_efter_stk5() -> input.ægtefælle_nettokapitalindkomst_kroner
    | exception stk5_ægtefælle_negativ_efter_modregning ægtefælle_nettokapitalindkomst_efter_stk5() -> ægtefælle_negativ_mod_egen().negativ_nettokapitalindkomst_efter_modregning_kroner under input.ægtefælle_nettokapitalindkomst_kroner < 0
    | exception stk5_ægtefælle_positiv_nedsat_af_egen ægtefælle_nettokapitalindkomst_efter_stk5() -> egen_negativ_mod_ægtefælle().ægtefælle_positiv_nettokapitalindkomst_efter_modregning_kroner under input.ægtefælle_nettokapitalindkomst_kroner > 0 && input.egen_nettokapitalindkomst_kroner < 0
    | resultat() -> Par26Stk5KapitalParResult(
        egen_nettokapitalindkomst_efter_stk5_kroner = egen_nettokapitalindkomst_efter_stk5(),
        ægtefælle_nettokapitalindkomst_efter_stk5_kroner = ægtefælle_nettokapitalindkomst_efter_stk5(),
        modregnet_fra_egen_til_ægtefælle_kroner = modregnet_fra_egen_til_ægtefælle(),
        modregnet_fra_ægtefælle_til_egen_kroner = modregnet_fra_ægtefælle_til_egen(),
        samlet_modregnet_kroner = modregnet_fra_egen_til_ægtefælle() + modregnet_fra_ægtefælle_til_egen()
    )
}
| par26_stk5_kapital_par_sag(input: Par26Stk5KapitalParInput) -> Par26Stk5KapitalParSag(input)
| par26_stk5_kapital_par_resultat(input: Par26Stk5KapitalParInput) -> par26_stk5_kapital_par_sag(input).resultat()
# Par26Stk6BundfradragSag(input: Par26Stk6BundfradragInput) {
    | egen_manglende_til_bundfradrag() -> par26_positivt_beløb(input.egen_bundfradrag_nr2_kroner - input.egen_personlig_plus_positiv_kapital_kroner)
    | forhøjelse_tilladt() -> par26_lavt_personligt_grundlag_forhøjer_ægtefælles_bundfradrag(input.status) && input.forskerordning_48f_valgt == Falskt
    | ægtefælle_bundfradragsforhøjelse() -> 0
    | exception stk6_samlevende_forhøjer_ægtefælles_bundfradrag ægtefælle_bundfradragsforhøjelse() -> egen_manglende_til_bundfradrag() under forhøjelse_tilladt()
    | resultat() -> Par26Stk6BundfradragResult(
        egen_manglende_til_bundfradrag_kroner = egen_manglende_til_bundfradrag(),
        ægtefælle_bundfradragsforhøjelse_kroner = ægtefælle_bundfradragsforhøjelse(),
        ægtefælle_effektivt_bundfradrag_kroner = input.ægtefælle_bundfradrag_nr2_kroner + ægtefælle_bundfradragsforhøjelse()
    )
}
