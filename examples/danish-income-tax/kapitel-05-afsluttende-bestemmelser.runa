    | egen_bundfradragsforhøjelse() -> ægtefælle_til_egen().ægtefælle_bundfradragsforhøjelse_kroner
    | ægtefælle_bundfradragsforhøjelse() -> egen_til_ægtefælle().ægtefælle_bundfradragsforhøjelse_kroner
