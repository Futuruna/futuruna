    | egen_positiv() -> par26_positivt_beløb(input.positiv_nettokapitalindkomst_kroner)
    | ægtefælle_negativ_abs() -> par26_positivt_beløb(0 - input.ægtefælle_negativ_nettokapitalindkomst_kroner)
    | modregnet_i_ægtefælles_negative() -> 0
    | exception stk8_samlevende_modregner_positiv_kapital modregnet_i_ægtefælles_negative() -> penge_mindste_beløb(egen_positiv(), ægtefælle_negativ_abs()) under par26_positiv_kapital_modregnes_i_ægtefælles_negative(input.status)
    | resultat() -> Par26Stk8PositivKapitalResult(
        modregnet_i_ægtefælles_negative_kroner = modregnet_i_ægtefælles_negative(),
        positiv_nettokapitalindkomst_efter_modregning_kroner = egen_positiv() - modregnet_i_ægtefælles_negative(),
        ægtefælle_negativ_nettokapitalindkomst_efter_modregning_kroner = 0 - (ægtefælle_negativ_abs() - modregnet_i_ægtefælles_negative())
    )
}
