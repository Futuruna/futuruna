    | egen_positiv_mod_ægtefælle() -> par26_stk8_positiv_kapital_resultat(Par26Stk8PositivKapitalInput(
        status = input.status,
        positiv_nettokapitalindkomst_kroner = input.egen_nettokapitalindkomst_kroner,
        ægtefælle_negativ_nettokapitalindkomst_kroner = input.ægtefælle_nettokapitalindkomst_kroner
    ))
    | ægtefælle_positiv_mod_egen() -> par26_stk8_positiv_kapital_resultat(Par26Stk8PositivKapitalInput(
        status = input.status,
        positiv_nettokapitalindkomst_kroner = input.ægtefælle_nettokapitalindkomst_kroner,
        ægtefælle_negativ_nettokapitalindkomst_kroner = input.egen_nettokapitalindkomst_kroner
    ))
    | modregnet_fra_egen_til_ægtefælle() -> 0
    | exception stk8_egen_positiv_modregnes_i_ægtefælle modregnet_fra_egen_til_ægtefælle() -> egen_positiv_mod_ægtefælle().modregnet_i_ægtefælles_negative_kroner under input.egen_nettokapitalindkomst_kroner > 0 && input.ægtefælle_nettokapitalindkomst_kroner < 0
    | modregnet_fra_ægtefælle_til_egen() -> 0
    | exception stk8_ægtefælle_positiv_modregnes_i_egen modregnet_fra_ægtefælle_til_egen() -> ægtefælle_positiv_mod_egen().modregnet_i_ægtefælles_negative_kroner under input.ægtefælle_nettokapitalindkomst_kroner > 0 && input.egen_nettokapitalindkomst_kroner < 0
    | egen_nettokapitalindkomst_efter_stk8() -> input.egen_nettokapitalindkomst_kroner
    | exception stk8_egen_positiv_efter_modregning egen_nettokapitalindkomst_efter_stk8() -> egen_positiv_mod_ægtefælle().positiv_nettokapitalindkomst_efter_modregning_kroner under input.egen_nettokapitalindkomst_kroner > 0
    | exception stk8_egen_negativ_nedsat_af_ægtefælle egen_nettokapitalindkomst_efter_stk8() -> ægtefælle_positiv_mod_egen().ægtefælle_negativ_nettokapitalindkomst_efter_modregning_kroner under input.egen_nettokapitalindkomst_kroner < 0 && input.ægtefælle_nettokapitalindkomst_kroner > 0
    | ægtefælle_nettokapitalindkomst_efter_stk8() -> input.ægtefælle_nettokapitalindkomst_kroner
    | exception stk8_ægtefælle_positiv_efter_modregning ægtefælle_nettokapitalindkomst_efter_stk8() -> ægtefælle_positiv_mod_egen().positiv_nettokapitalindkomst_efter_modregning_kroner under input.ægtefælle_nettokapitalindkomst_kroner > 0
    | exception stk8_ægtefælle_negativ_nedsat_af_egen ægtefælle_nettokapitalindkomst_efter_stk8() -> egen_positiv_mod_ægtefælle().ægtefælle_negativ_nettokapitalindkomst_efter_modregning_kroner under input.ægtefælle_nettokapitalindkomst_kroner < 0 && input.egen_nettokapitalindkomst_kroner > 0
    | resultat() -> Par26Stk8KapitalParResult(
        egen_nettokapitalindkomst_efter_stk8_kroner = egen_nettokapitalindkomst_efter_stk8(),
        ægtefælle_nettokapitalindkomst_efter_stk8_kroner = ægtefælle_nettokapitalindkomst_efter_stk8(),
