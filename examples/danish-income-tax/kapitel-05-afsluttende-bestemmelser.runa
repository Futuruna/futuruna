    | ægtefælle_effektivt_bundfradrag() -> egen_til_ægtefælle().ægtefælle_effektivt_bundfradrag_kroner
    | resultat() -> Par26Stk6BundfradragParResult(
        egen_manglende_til_bundfradrag_kroner = egen_manglende_til_bundfradrag(),
        ægtefælle_manglende_til_bundfradrag_kroner = ægtefælle_manglende_til_bundfradrag(),
