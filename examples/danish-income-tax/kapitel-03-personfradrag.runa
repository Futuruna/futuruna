# Par13ÆgtefælleOverførselResult(fradrag_i_ægtefælle_indkomst_kroner: Heltal, resterende_underskud_kroner: Heltal, overførsel_tilladt: Boolsk)
# Par13ÆgtefælleSkatModregningInput(ubenyttet_underskud_efter_ægtefælleindkomst_kroner: Heltal, skatteværdi_sats_basispoint: Heltal, ægtefælle_skatter: Par13ModregningsSkatter, gift_samlevende_ved_årets_udløb: Boolsk)
# Par13ÆgtefælleSkatModregningResult(overførsel_tilladt: Boolsk, underskud_til_skattemodregning_kroner: Heltal, skatteværdi_til_modregning_kroner: Heltal, modregning: Par13ModregningResult, udnyttet_skatteværdi_kroner: Heltal, dækket_underskud_ved_skattemodregning_kroner: Heltal, resterende_underskud_kroner: Heltal)
# Par13ÆgtefælleEgneUnderskudPrioritetInput(ægtefælles_egne_tidligere_underskud_kroner: Heltal, overført_underskud_fra_skattepligtig_kroner: Heltal, ægtefælle_skattepligtig_indkomst_kroner: Heltal, skatteværdi_sats_basispoint: Heltal, ægtefælle_skatter: Par13ModregningsSkatter, gift_samlevende_ved_årets_udløb: Boolsk)
# Par13ÆgtefælleEgneUnderskudPrioritetResult(overførsel_tilladt: Boolsk, egne_underskud_indkomstfradrag_kroner: Heltal, overført_underskud_indkomstfradrag_kroner: Heltal, egne_underskud_rest_efter_indkomst_kroner: Heltal, overført_underskud_rest_efter_indkomst_kroner: Heltal, egne_underskud_skattemodregning: Par13UnderskudSkatModregningResult, ægtefælle_skatter_efter_egne_underskud: Par13ModregningsSkatter, overført_underskud_skattemodregning: Par13ÆgtefælleSkatModregningResult, egne_underskud_fremført_kroner: Heltal, overført_underskud_fremført_kroner: Heltal)
# Par13NegativPersonligInput(personlig_indkomst_kroner: Heltal, positiv_kapitalindkomst_kroner: Heltal)
# Par13NegativPersonligModregningInput(personlig_indkomst_kroner: Heltal, egen_positiv_kapitalindkomst_kroner: Heltal, ægtefælle_personlig_indkomst_med_pbl16_tillæg_kroner: Heltal, ægtefælle_positiv_kapitalindkomst_kroner: Heltal, gift_samlevende_ved_årets_udløb: Boolsk)
# Par13NegativPersonligModregningResult(negativ_personlig_indkomst_abs_kroner: Heltal, modregnet_i_ægtefælles_personlige_indkomst_kroner: Heltal, modregnet_i_egen_positiv_kapitalindkomst_kroner: Heltal, modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner: Heltal, fremført_negativ_personlig_indkomst_kroner: Heltal)
# Par13FremførtNegativPersonligModregningInput(fremført_negativ_personlig_indkomst_kroner: Heltal, egen_positiv_kapitalindkomst_kroner: Heltal, ægtefælle_positiv_kapitalindkomst_kroner: Heltal, egen_personlig_indkomst_med_pbl16_tillæg_kroner: Heltal, ægtefælle_personlig_indkomst_med_pbl16_tillæg_kroner: Heltal, gift_samlevende_ved_årets_udløb: Boolsk)
# Par13FremførtNegativPersonligModregningResult(modregnet_i_egen_positiv_kapitalindkomst_kroner: Heltal, modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner: Heltal, modregnet_i_egen_personlige_indkomst_kroner: Heltal, modregnet_i_ægtefælles_personlige_indkomst_kroner: Heltal, resterende_fremført_negativ_personlig_indkomst_kroner: Heltal)
# Par13Stk5OverførselInput(skatteår: Heltal, ønsket_overførsel_kroner: Heltal, udenlandsk_beskattet_personlig_indkomst_kroner: Heltal, fradragsberettigede_udgifter_vedrørende_udlandsindkomst_kroner: Heltal, udgifter_fradraget_i_udlandet_kroner: Heltal, pbl16_beløb_kroner: Heltal, overførsel_efter_stk4: Boolsk, lempelsesgrundlag: Par13Stk5Lempelsesgrundlag)
# Par13Stk5OverførselResult(overførbart_underskud_kroner: Heltal, afskåret_udenlandsk_nettoindkomst_kroner: Heltal, afskåret_udlandsfradrag_kroner: Heltal, afskåret_pbl16_kroner: Heltal, samlet_afskåret_kroner: Heltal)
# Par13VirksomhedsUnderskudInput(underskud_kroner: Heltal, positiv_indkomst_samme_virksomhed_kroner: Heltal, status: Par13VirksomhedsUnderskudStatus)
# Par13VirksomhedsUnderskudResult(fradrag_i_øvrig_indkomst_kroner: Heltal, modregnet_i_samme_virksomhed_kroner: Heltal, fremført_til_samme_virksomhed_kroner: Heltal)
# Par13Underskudstype = SkattepligtigIndkomstUnderskud | PersonligIndkomstUnderskud | PassivVirksomhedsUnderskud | TransparentSelskabsUnderskud
# Par13OverførselsBegrænsning = UdenlandskBeskattetPersonligIndkomst | UdgiftFradragetIUdlandet | PensionsbeløbPbl16 | LempelseEfterLl33AEllerSømandsbeskatning
# Par13Stk5Lempelsesgrundlag = IngenPar13Lempelse | LigningslovPar33A | SømandsbeskatningslovPar5 | SømandsbeskatningslovPar6 | SømandsbeskatningslovPar7 | SømandsbeskatningslovPar8
# Par13VirksomhedsUnderskudStatus = PassivVirksomhedPar4Nr9Eller11 | SkibsvirksomhedGodkendtSenest1993 | TransparentSelskabPassiv | TransparentSelskabDeltagetVæsentligt36Måneder

| par13_skattepligtig_indkomst_har_underskud(input: Par13UnderskudInput) -> input.skattepligtig_indkomst_kroner < 0
| par13_personlig_indkomst_er_negativ(input: Par13UnderskudInput) -> input.personlig_indkomst_kroner < 0
| par13_kræver_underskudsbehandling(input: Par13UnderskudInput) -> par13_skattepligtig_indkomst_har_underskud(input) || par13_personlig_indkomst_er_negativ(input)
| par13_underskud_kan_fremføres(type: Par13Underskudstype) -> type == SkattepligtigIndkomstUnderskud || type == PersonligIndkomstUnderskud
| par13_ægtefælleunderskud_overføres(status: ÆgtefællePersonfradragStatus) -> status == GiftSamlevendeVedÅretsUdløb
| par13_negativ_personlig_modregnes_først_i_positiv_kapital() -> Sandt
| par13_passiv_virksomhedsunderskud_låses_til_samme_virksomhed(type: Par13Underskudstype) -> type == PassivVirksomhedsUnderskud || type == TransparentSelskabsUnderskud
| par13_positivt_beløb(beløb_kroner: Heltal) -> penge_positivt_beløb(beløb_kroner)
| par13_mindste_beløb(a_kroner: Heltal, b_kroner: Heltal) -> penge_mindste_beløb(a_kroner, b_kroner)
| par13_absolut_underskud(indkomst_kroner: Heltal) -> hvis indkomst_kroner < 0 { 0 - indkomst_kroner } ellers { 0 }
| par13_tomme_modregningsskatter() -> Par13ModregningsSkatter(
    par6_skat_kroner = 0,
    par7_skat_kroner = 0,
    par7a_skat_kroner = 0,
    par8_skat_kroner = 0,
    par8a_stk2_skat_kroner = 0
)
| par13_modregningsskatter_efter_modregning(resultat: Par13ModregningResult) -> Par13ModregningsSkatter(
    par6_skat_kroner = resultat.par6_efter_kroner,
    par7_skat_kroner = resultat.par7_efter_kroner,
    par7a_skat_kroner = resultat.par7a_efter_kroner,
    par8_skat_kroner = resultat.par8_efter_kroner,
    par8a_stk2_skat_kroner = resultat.par8a_stk2_efter_kroner
)
| par13_skatteværdi_sats_basispoint(input: Par13UnderskudSkatteværdiInput) -> input.sundhedsbidrag_basispoint + input.par8c_basispoint under input.betaler_par8c
| par13_skatteværdi_sats_basispoint(input: Par13UnderskudSkatteværdiInput) -> input.sundhedsbidrag_basispoint + input.kommuneskat_basispoint + input.kirkeskat_basispoint under input.betaler_par8c == Falskt
| par13_underskud_skatteværdi_kroner(input: Par13UnderskudSkatteværdiInput) -> penge_beløb_gange_basispoint_kroner(input.underskud_kroner, par13_skatteværdi_sats_basispoint(input))
| par13_ubrugt_nedslag_efter_skat(skat_kroner: Heltal, nedslag_kroner: Heltal) -> penge_positivt_beløb(nedslag_kroner - skat_kroner)
| par13_udnyttet_skatteværdi_kroner(skatteværdi_kroner: Heltal, ubrugt_skatteværdi_kroner: Heltal) -> par13_positivt_beløb(skatteværdi_kroner - ubrugt_skatteværdi_kroner)
| par13_dækket_underskud_ved_skattemodregning_kroner(input: Par13Stk1FremførselInput) -> 0
| exception par13_udnyttet_skatteværdi_omregnes_til_underskud par13_dækket_underskud_ved_skattemodregning_kroner(input: Par13Stk1FremførselInput) -> par13_mindste_beløb(par13_positivt_beløb(input.underskud_kroner), input.udnyttet_skatteværdi_kroner * 10000 / input.skatteværdi_sats_basispoint) under input.skatteværdi_sats_basispoint > 0
| par13_resterende_underskud_efter_skattemodregning_kroner(input: Par13Stk1FremførselInput) -> par13_positivt_beløb(input.underskud_kroner) - par13_dækket_underskud_ved_skattemodregning_kroner(input)
| par13_fremført_underskud_kroner(input: Par13Stk1FremførselInput) -> 0
| exception par13_fremførsel_hvis_ikke_rummet_tidligere par13_fremført_underskud_kroner(input: Par13Stk1FremførselInput) -> par13_resterende_underskud_efter_skattemodregning_kroner(input) under input.ikke_rummet_i_tidligere_indkomst_eller_skat
| par13_stk1_fremførsel_resultat(input: Par13Stk1FremførselInput) -> Par13Stk1FremførselResult(
    dækket_underskud_ved_skattemodregning_kroner = par13_dækket_underskud_ved_skattemodregning_kroner(input),
    resterende_underskud_kroner = par13_resterende_underskud_efter_skattemodregning_kroner(input),
    fremført_underskud_kroner = par13_fremført_underskud_kroner(input),
    fremføres = par13_fremført_underskud_kroner(input) > 0
)
| par13_modregning_input_fra_skatter(skatteværdi_kroner: Heltal, skatter: Par13ModregningsSkatter) -> Par13ModregningInput(
    skatteværdi_kroner = skatteværdi_kroner,
    par6_skat_kroner = skatter.par6_skat_kroner,
    par7_skat_kroner = skatter.par7_skat_kroner,
    par7a_skat_kroner = skatter.par7a_skat_kroner,
    par8_skat_kroner = skatter.par8_skat_kroner,
    par8a_stk2_skat_kroner = skatter.par8a_stk2_skat_kroner
)
# Par13ModregningSag(input: Par13ModregningInput) {
    | par6_efter() -> skat_efter_nedsættelse(input.par6_skat_kroner, input.skatteværdi_kroner)
    | rester_efter_par6() -> par13_ubrugt_nedslag_efter_skat(input.par6_skat_kroner, input.skatteværdi_kroner)
    | par7_efter() -> skat_efter_nedsættelse(input.par7_skat_kroner, rester_efter_par6())
    | rester_efter_par7() -> par13_ubrugt_nedslag_efter_skat(input.par7_skat_kroner, rester_efter_par6())
    | par7a_efter() -> skat_efter_nedsættelse(input.par7a_skat_kroner, rester_efter_par7())
    | rester_efter_par7a() -> par13_ubrugt_nedslag_efter_skat(input.par7a_skat_kroner, rester_efter_par7())
    | par8_efter() -> skat_efter_nedsættelse(input.par8_skat_kroner, rester_efter_par7a())
    | rester_efter_par8() -> par13_ubrugt_nedslag_efter_skat(input.par8_skat_kroner, rester_efter_par7a())
    | par8a_stk2_efter() -> skat_efter_nedsættelse(input.par8a_stk2_skat_kroner, rester_efter_par8())
    | rester_efter_par8a_stk2() -> par13_ubrugt_nedslag_efter_skat(input.par8a_stk2_skat_kroner, rester_efter_par8())
    | resultat() -> Par13ModregningResult(
        par6_efter_kroner = par6_efter(),
        par7_efter_kroner = par7_efter(),
        par7a_efter_kroner = par7a_efter(),
        par8_efter_kroner = par8_efter(),
        par8a_stk2_efter_kroner = par8a_stk2_efter(),
        ubrugt_skatteværdi_kroner = rester_efter_par8a_stk2()
    )
}
| par13_modregning_sag(input: Par13ModregningInput) -> Par13ModregningSag(input)
| par13_rester_efter_par6(input: Par13ModregningInput) -> par13_modregning_sag(input).rester_efter_par6()
| par13_rester_efter_par7(input: Par13ModregningInput) -> par13_modregning_sag(input).rester_efter_par7()
| par13_rester_efter_par7a(input: Par13ModregningInput) -> par13_modregning_sag(input).rester_efter_par7a()
| par13_rester_efter_par8(input: Par13ModregningInput) -> par13_modregning_sag(input).rester_efter_par8()
| par13_rester_efter_par8a_stk2(input: Par13ModregningInput) -> par13_modregning_sag(input).rester_efter_par8a_stk2()
| par13_modregning_resultat(input: Par13ModregningInput) -> par13_modregning_sag(input).resultat()

# Par13UnderskudSkatModregningSag(input: Par13UnderskudSkatModregningInput) {
    | underskud_til_skattemodregning_kroner() -> par13_positivt_beløb(input.underskud_kroner)
    | skatteværdi_til_modregning_kroner() -> penge_beløb_gange_basispoint_kroner(underskud_til_skattemodregning_kroner(), input.skatteværdi_sats_basispoint)
    | modregning_input() -> par13_modregning_input_fra_skatter(skatteværdi_til_modregning_kroner(), input.skatter)
    | modregning() -> par13_modregning_resultat(modregning_input())
    | udnyttet_skatteværdi_kroner() -> par13_udnyttet_skatteværdi_kroner(skatteværdi_til_modregning_kroner(), modregning().ubrugt_skatteværdi_kroner)
    | dækket_underskud_ved_skattemodregning_kroner() -> par13_dækket_underskud_ved_skattemodregning_kroner(Par13Stk1FremførselInput(
        underskud_kroner = underskud_til_skattemodregning_kroner(),
        skatteværdi_sats_basispoint = input.skatteværdi_sats_basispoint,
        udnyttet_skatteværdi_kroner = udnyttet_skatteværdi_kroner(),
        ikke_rummet_i_tidligere_indkomst_eller_skat = Sandt
    ))
    | resterende_underskud_kroner() -> underskud_til_skattemodregning_kroner() - dækket_underskud_ved_skattemodregning_kroner()
    | resultat() -> Par13UnderskudSkatModregningResult(
        underskud_til_skattemodregning_kroner = underskud_til_skattemodregning_kroner(),
        skatteværdi_til_modregning_kroner = skatteværdi_til_modregning_kroner(),
        modregning = modregning(),
        udnyttet_skatteværdi_kroner = udnyttet_skatteværdi_kroner(),
        dækket_underskud_ved_skattemodregning_kroner = dækket_underskud_ved_skattemodregning_kroner(),
        resterende_underskud_kroner = resterende_underskud_kroner()
    )
}
| par13_underskud_skattemodregning_sag(input: Par13UnderskudSkatModregningInput) -> Par13UnderskudSkatModregningSag(input)
| par13_underskud_skattemodregning_resultat(input: Par13UnderskudSkatModregningInput) -> par13_underskud_skattemodregning_sag(input).resultat()

| par13_underskud_fremføres(status: Par13Underskudstype, ikke_rummet_i_tidligere_indkomst_eller_skat: Boolsk) -> par13_underskud_kan_fremføres(status) && ikke_rummet_i_tidligere_indkomst_eller_skat
| par13_ægtefælleoverførsel_resultat(input: Par13ÆgtefælleOverførselInput) -> hvis input.gift_samlevende_ved_årets_udløb {
    Par13ÆgtefælleOverførselResult(
        fradrag_i_ægtefælle_indkomst_kroner = par13_mindste_beløb(input.ubenyttet_underskud_kroner, par13_positivt_beløb(input.ægtefælle_skattepligtig_indkomst_kroner)),
        resterende_underskud_kroner = input.ubenyttet_underskud_kroner - par13_mindste_beløb(input.ubenyttet_underskud_kroner, par13_positivt_beløb(input.ægtefælle_skattepligtig_indkomst_kroner)),
        overførsel_tilladt = Sandt
    )
} ellers {
    Par13ÆgtefælleOverførselResult(
        fradrag_i_ægtefælle_indkomst_kroner = 0,
        resterende_underskud_kroner = input.ubenyttet_underskud_kroner,
        overførsel_tilladt = Falskt
    )
}
# Par13ÆgtefælleSkatModregningSag(input: Par13ÆgtefælleSkatModregningInput) {
    | overførsel_tilladt() -> input.gift_samlevende_ved_årets_udløb
    | underskud_til_skattemodregning_kroner() -> 0
    | exception par13_stk2_resterende_underskud_modregnes_i_ægtefælles_skatter underskud_til_skattemodregning_kroner() -> par13_positivt_beløb(input.ubenyttet_underskud_efter_ægtefælleindkomst_kroner) under overførsel_tilladt()
    | skattemodregning_input() -> Par13UnderskudSkatModregningInput(
        underskud_kroner = underskud_til_skattemodregning_kroner(),
        skatteværdi_sats_basispoint = input.skatteværdi_sats_basispoint,
        skatter = input.ægtefælle_skatter
    )
    | skattemodregning() -> par13_underskud_skattemodregning_resultat(skattemodregning_input())
    | resterende_underskud_kroner() -> par13_positivt_beløb(input.ubenyttet_underskud_efter_ægtefælleindkomst_kroner)
    | exception par13_stk2_resterende_underskud_efter_ægtefælleskat resterende_underskud_kroner() -> skattemodregning().resterende_underskud_kroner under overførsel_tilladt()
    | resultat() -> Par13ÆgtefælleSkatModregningResult(
        overførsel_tilladt = overførsel_tilladt(),
        underskud_til_skattemodregning_kroner = underskud_til_skattemodregning_kroner(),
        skatteværdi_til_modregning_kroner = skattemodregning().skatteværdi_til_modregning_kroner,
        modregning = skattemodregning().modregning,
        udnyttet_skatteværdi_kroner = skattemodregning().udnyttet_skatteværdi_kroner,
        dækket_underskud_ved_skattemodregning_kroner = skattemodregning().dækket_underskud_ved_skattemodregning_kroner,
        resterende_underskud_kroner = resterende_underskud_kroner()
    )
}
| par13_ægtefælle_skattemodregning_sag(input: Par13ÆgtefælleSkatModregningInput) -> Par13ÆgtefælleSkatModregningSag(input)
| par13_ægtefælle_skattemodregning_resultat(input: Par13ÆgtefælleSkatModregningInput) -> par13_ægtefælle_skattemodregning_sag(input).resultat()

# Par13ÆgtefælleEgneUnderskudPrioritetSag(input: Par13ÆgtefælleEgneUnderskudPrioritetInput) {
    | overførsel_tilladt() -> input.gift_samlevende_ved_årets_udløb
    | ægtefælles_egne_tidligere_underskud_kroner() -> par13_positivt_beløb(input.ægtefælles_egne_tidligere_underskud_kroner)
    | overført_underskud_fra_skattepligtig_kroner() -> par13_positivt_beløb(input.overført_underskud_fra_skattepligtig_kroner)
    | ægtefælle_skattepligtig_indkomst_kroner() -> par13_positivt_beløb(input.ægtefælle_skattepligtig_indkomst_kroner)
    | egne_underskud_indkomstfradrag_kroner() -> par13_mindste_beløb(ægtefælles_egne_tidligere_underskud_kroner(), ægtefælle_skattepligtig_indkomst_kroner())
    | ægtefælle_indkomst_efter_egne_underskud_kroner() -> ægtefælle_skattepligtig_indkomst_kroner() - egne_underskud_indkomstfradrag_kroner()
    | overført_underskud_indkomstfradrag_kroner() -> 0
    | exception par13_stk2_overført_underskud_fradrages_i_ægtefælleindkomst overført_underskud_indkomstfradrag_kroner() -> par13_mindste_beløb(overført_underskud_fra_skattepligtig_kroner(), ægtefælle_indkomst_efter_egne_underskud_kroner()) under overførsel_tilladt()
    | egne_underskud_rest_efter_indkomst_kroner() -> ægtefælles_egne_tidligere_underskud_kroner() - egne_underskud_indkomstfradrag_kroner()
    | overført_underskud_rest_efter_indkomst_kroner() -> overført_underskud_fra_skattepligtig_kroner() - overført_underskud_indkomstfradrag_kroner()
    | egne_underskud_skattemodregning() -> par13_underskud_skattemodregning_resultat(Par13UnderskudSkatModregningInput(
        underskud_kroner = egne_underskud_rest_efter_indkomst_kroner(),
        skatteværdi_sats_basispoint = input.skatteværdi_sats_basispoint,
        skatter = input.ægtefælle_skatter
    ))
    | ægtefælle_skatter_efter_egne_underskud() -> par13_modregningsskatter_efter_modregning(egne_underskud_skattemodregning().modregning)
    | overført_underskud_skattemodregning() -> par13_ægtefælle_skattemodregning_resultat(Par13ÆgtefælleSkatModregningInput(
        ubenyttet_underskud_efter_ægtefælleindkomst_kroner = overført_underskud_rest_efter_indkomst_kroner(),
        skatteværdi_sats_basispoint = input.skatteværdi_sats_basispoint,
        ægtefælle_skatter = ægtefælle_skatter_efter_egne_underskud(),
        gift_samlevende_ved_årets_udløb = overførsel_tilladt()
    ))
    | egne_underskud_fremført_kroner() -> egne_underskud_skattemodregning().resterende_underskud_kroner
    | overført_underskud_fremført_kroner() -> overført_underskud_skattemodregning().resterende_underskud_kroner
    | resultat() -> Par13ÆgtefælleEgneUnderskudPrioritetResult(
        overførsel_tilladt = overførsel_tilladt(),
        egne_underskud_indkomstfradrag_kroner = egne_underskud_indkomstfradrag_kroner(),
        overført_underskud_indkomstfradrag_kroner = overført_underskud_indkomstfradrag_kroner(),
        egne_underskud_rest_efter_indkomst_kroner = egne_underskud_rest_efter_indkomst_kroner(),
        overført_underskud_rest_efter_indkomst_kroner = overført_underskud_rest_efter_indkomst_kroner(),
        egne_underskud_skattemodregning = egne_underskud_skattemodregning(),
        ægtefælle_skatter_efter_egne_underskud = ægtefælle_skatter_efter_egne_underskud(),
        overført_underskud_skattemodregning = overført_underskud_skattemodregning(),
        egne_underskud_fremført_kroner = egne_underskud_fremført_kroner(),
        overført_underskud_fremført_kroner = overført_underskud_fremført_kroner()
    )
}
| par13_ægtefælle_egne_underskud_prioritet_sag(input: Par13ÆgtefælleEgneUnderskudPrioritetInput) -> Par13ÆgtefælleEgneUnderskudPrioritetSag(input)
| par13_ægtefælle_egne_underskud_prioritet_resultat(input: Par13ÆgtefælleEgneUnderskudPrioritetInput) -> par13_ægtefælle_egne_underskud_prioritet_sag(input).resultat()
| par13_overført_underskud_ægtefælleoverførsel_fra_prioritet(resultat: Par13ÆgtefælleEgneUnderskudPrioritetResult) -> Par13ÆgtefælleOverførselResult(
    fradrag_i_ægtefælle_indkomst_kroner = resultat.overført_underskud_indkomstfradrag_kroner,
    resterende_underskud_kroner = resultat.overført_underskud_rest_efter_indkomst_kroner,
    overførsel_tilladt = resultat.overførsel_tilladt
)

| par13_negativ_personlig_beløb(input: Par13NegativPersonligInput) -> par13_absolut_underskud(input.personlig_indkomst_kroner)
| par13_negativ_personlig_modregnet_i_kapital_kroner(input: Par13NegativPersonligInput) -> par13_mindste_beløb(par13_negativ_personlig_beløb(input), input.positiv_kapitalindkomst_kroner)
| par13_negativ_personlig_rest_kroner(input: Par13NegativPersonligInput) -> par13_negativ_personlig_beløb(input) - par13_negativ_personlig_modregnet_i_kapital_kroner(input)
| par13_negativ_personlig_fremføres(input: Par13NegativPersonligInput) -> par13_negativ_personlig_rest_kroner(input) > 0

# Par13NegativPersonligModregningSag(input: Par13NegativPersonligModregningInput) {
    | negativ_personlig_indkomst_abs_kroner() -> par13_absolut_underskud(input.personlig_indkomst_kroner)
    | ægtefælle_personlig_indkomstgrundlag_kroner() -> par13_positivt_beløb(input.ægtefælle_personlig_indkomst_med_pbl16_tillæg_kroner)
    | egen_positiv_kapitalindkomst_kroner() -> par13_positivt_beløb(input.egen_positiv_kapitalindkomst_kroner)
    | ægtefælle_positiv_kapitalindkomst_kroner() -> par13_positivt_beløb(input.ægtefælle_positiv_kapitalindkomst_kroner)
    | modregnet_i_ægtefælles_personlige_indkomst_kroner() -> 0
    | exception par13_stk4_negativ_personlig_modregnes_i_ægtefælle_personlig modregnet_i_ægtefælles_personlige_indkomst_kroner() -> par13_mindste_beløb(negativ_personlig_indkomst_abs_kroner(), ægtefælle_personlig_indkomstgrundlag_kroner()) under input.gift_samlevende_ved_årets_udløb
    | rest_efter_ægtefælles_personlige_indkomst_kroner() -> negativ_personlig_indkomst_abs_kroner() - modregnet_i_ægtefælles_personlige_indkomst_kroner()
    | grundlag_for_egen_kapitalmodregning_kroner() -> negativ_personlig_indkomst_abs_kroner()
    | exception par13_stk4_egen_kapital_efter_ægtefælle_personlig grundlag_for_egen_kapitalmodregning_kroner() -> rest_efter_ægtefælles_personlige_indkomst_kroner() under input.gift_samlevende_ved_årets_udløb
    | modregnet_i_egen_positiv_kapitalindkomst_kroner() -> par13_mindste_beløb(grundlag_for_egen_kapitalmodregning_kroner(), egen_positiv_kapitalindkomst_kroner())
    | rest_efter_egen_positiv_kapitalindkomst_kroner() -> grundlag_for_egen_kapitalmodregning_kroner() - modregnet_i_egen_positiv_kapitalindkomst_kroner()
    | modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner() -> 0
    | exception par13_stk4_rest_modregnes_i_ægtefælle_kapital modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner() -> par13_mindste_beløb(rest_efter_egen_positiv_kapitalindkomst_kroner(), ægtefælle_positiv_kapitalindkomst_kroner()) under input.gift_samlevende_ved_årets_udløb
    | fremført_negativ_personlig_indkomst_kroner() -> rest_efter_egen_positiv_kapitalindkomst_kroner() - modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner()
    | resultat() -> Par13NegativPersonligModregningResult(
        negativ_personlig_indkomst_abs_kroner = negativ_personlig_indkomst_abs_kroner(),
        modregnet_i_ægtefælles_personlige_indkomst_kroner = modregnet_i_ægtefælles_personlige_indkomst_kroner(),
        modregnet_i_egen_positiv_kapitalindkomst_kroner = modregnet_i_egen_positiv_kapitalindkomst_kroner(),
        modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner = modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner(),
        fremført_negativ_personlig_indkomst_kroner = fremført_negativ_personlig_indkomst_kroner()
    )
}
| par13_negativ_personlig_modregning_sag(input: Par13NegativPersonligModregningInput) -> Par13NegativPersonligModregningSag(input)
| par13_negativ_personlig_modregning_resultat(input: Par13NegativPersonligModregningInput) -> par13_negativ_personlig_modregning_sag(input).resultat()

# Par13FremførtNegativPersonligModregningSag(input: Par13FremførtNegativPersonligModregningInput) {
    | fremført_negativ_personlig_indkomst_kroner() -> par13_positivt_beløb(input.fremført_negativ_personlig_indkomst_kroner)
    | egen_positiv_kapitalindkomst_kroner() -> par13_positivt_beløb(input.egen_positiv_kapitalindkomst_kroner)
    | ægtefælle_positiv_kapitalindkomst_kroner() -> par13_positivt_beløb(input.ægtefælle_positiv_kapitalindkomst_kroner)
    | egen_personlig_indkomstgrundlag_kroner() -> par13_positivt_beløb(input.egen_personlig_indkomst_med_pbl16_tillæg_kroner)
    | ægtefælle_personlig_indkomstgrundlag_kroner() -> par13_positivt_beløb(input.ægtefælle_personlig_indkomst_med_pbl16_tillæg_kroner)
    | modregnet_i_egen_positiv_kapitalindkomst_kroner() -> par13_mindste_beløb(fremført_negativ_personlig_indkomst_kroner(), egen_positiv_kapitalindkomst_kroner())
    | rest_efter_egen_positiv_kapitalindkomst_kroner() -> fremført_negativ_personlig_indkomst_kroner() - modregnet_i_egen_positiv_kapitalindkomst_kroner()
    | modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner() -> 0
    | exception par13_stk4_fremført_modregnes_i_ægtefælle_kapital modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner() -> par13_mindste_beløb(rest_efter_egen_positiv_kapitalindkomst_kroner(), ægtefælle_positiv_kapitalindkomst_kroner()) under input.gift_samlevende_ved_årets_udløb
    | rest_efter_positiv_kapitalindkomst_kroner() -> rest_efter_egen_positiv_kapitalindkomst_kroner() - modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner()
    | modregnet_i_egen_personlige_indkomst_kroner() -> par13_mindste_beløb(rest_efter_positiv_kapitalindkomst_kroner(), egen_personlig_indkomstgrundlag_kroner())
    | rest_efter_egen_personlige_indkomst_kroner() -> rest_efter_positiv_kapitalindkomst_kroner() - modregnet_i_egen_personlige_indkomst_kroner()
    | modregnet_i_ægtefælles_personlige_indkomst_kroner() -> 0
    | exception par13_stk4_fremført_modregnes_i_ægtefælle_personlig modregnet_i_ægtefælles_personlige_indkomst_kroner() -> par13_mindste_beløb(rest_efter_egen_personlige_indkomst_kroner(), ægtefælle_personlig_indkomstgrundlag_kroner()) under input.gift_samlevende_ved_årets_udløb
    | resterende_fremført_negativ_personlig_indkomst_kroner() -> rest_efter_egen_personlige_indkomst_kroner() - modregnet_i_ægtefælles_personlige_indkomst_kroner()
    | resultat() -> Par13FremførtNegativPersonligModregningResult(
        modregnet_i_egen_positiv_kapitalindkomst_kroner = modregnet_i_egen_positiv_kapitalindkomst_kroner(),
        modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner = modregnet_i_ægtefælles_positiv_kapitalindkomst_kroner(),
        modregnet_i_egen_personlige_indkomst_kroner = modregnet_i_egen_personlige_indkomst_kroner(),
        modregnet_i_ægtefælles_personlige_indkomst_kroner = modregnet_i_ægtefælles_personlige_indkomst_kroner(),
        resterende_fremført_negativ_personlig_indkomst_kroner = resterende_fremført_negativ_personlig_indkomst_kroner()
    )
}
| par13_fremført_negativ_personlig_modregning_sag(input: Par13FremførtNegativPersonligModregningInput) -> Par13FremførtNegativPersonligModregningSag(input)
| par13_fremført_negativ_personlig_modregning_resultat(input: Par13FremførtNegativPersonligModregningInput) -> par13_fremført_negativ_personlig_modregning_sag(input).resultat()

| par13_stk5_begrænsning_afskærer_ægtefælleoverførsel(begrænsning: Par13OverførselsBegrænsning) -> begrænsning == UdenlandskBeskattetPersonligIndkomst || begrænsning == UdgiftFradragetIUdlandet || begrænsning == PensionsbeløbPbl16
| par13_stk5_begrænsning_finder_ikke_anvendelse(begrænsning: Par13OverførselsBegrænsning) -> begrænsning == LempelseEfterLl33AEllerSømandsbeskatning
| par13_stk5_lempelse_undtager(grundlag: Par13Stk5Lempelsesgrundlag) -> grundlag == LigningslovPar33A || grundlag == SømandsbeskatningslovPar5 || grundlag == SømandsbeskatningslovPar6 || grundlag == SømandsbeskatningslovPar7 || grundlag == SømandsbeskatningslovPar8
| par13_stk5_begrænsning_aktiv(input: Par13Stk5OverførselInput) -> par13_stk5_lempelse_undtager(input.lempelsesgrundlag) == Falskt
| par13_stk5_pbl16_begrænsning_i_kraft(skatteår: Heltal) -> skatteår < 2026
| par13_stk5_udenlandsk_nettoindkomst_kroner(input: Par13Stk5OverførselInput) -> par13_positivt_beløb(input.udenlandsk_beskattet_personlig_indkomst_kroner - input.fradragsberettigede_udgifter_vedrørende_udlandsindkomst_kroner)
| par13_stk5_udenlandsk_indkomst_afskåret_kroner(input: Par13Stk5OverførselInput) -> hvis par13_stk5_begrænsning_aktiv(input) { par13_stk5_udenlandsk_nettoindkomst_kroner(input) } ellers { 0 }
| par13_stk5_udlandsfradrag_afskåret_kroner(input: Par13Stk5OverførselInput) -> hvis par13_stk5_begrænsning_aktiv(input) { par13_positivt_beløb(input.udgifter_fradraget_i_udlandet_kroner) } ellers { 0 }
| par13_stk5_pbl16_afskåret_kroner(input: Par13Stk5OverførselInput) -> hvis par13_stk5_begrænsning_aktiv(input) && input.overførsel_efter_stk4 && par13_stk5_pbl16_begrænsning_i_kraft(input.skatteår) { par13_positivt_beløb(input.pbl16_beløb_kroner) } ellers { 0 }
| par13_stk5_samlet_afskåret_kroner(input: Par13Stk5OverførselInput) -> par13_mindste_beløb(par13_positivt_beløb(input.ønsket_overførsel_kroner), par13_stk5_udenlandsk_indkomst_afskåret_kroner(input) + par13_stk5_udlandsfradrag_afskåret_kroner(input) + par13_stk5_pbl16_afskåret_kroner(input))
| par13_stk5_overførsel_resultat(input: Par13Stk5OverførselInput) -> Par13Stk5OverførselResult(
    overførbart_underskud_kroner = par13_positivt_beløb(input.ønsket_overførsel_kroner) - par13_stk5_samlet_afskåret_kroner(input),
    afskåret_udenlandsk_nettoindkomst_kroner = par13_stk5_udenlandsk_indkomst_afskåret_kroner(input),
    afskåret_udlandsfradrag_kroner = par13_stk5_udlandsfradrag_afskåret_kroner(input),
    afskåret_pbl16_kroner = par13_stk5_pbl16_afskåret_kroner(input),
    samlet_afskåret_kroner = par13_stk5_samlet_afskåret_kroner(input)
)
| par13_virksomhedsunderskud_låses_til_samme_virksomhed(status: Par13VirksomhedsUnderskudStatus) -> status == PassivVirksomhedPar4Nr9Eller11 || status == TransparentSelskabPassiv
| exception godkendt_skibsvirksomhed par13_virksomhedsunderskud_låses_til_samme_virksomhed(status: Par13VirksomhedsUnderskudStatus) -> Falskt under status == SkibsvirksomhedGodkendtSenest1993
| exception væsentlig_deltagelse par13_virksomhedsunderskud_låses_til_samme_virksomhed(status: Par13VirksomhedsUnderskudStatus) -> Falskt under status == TransparentSelskabDeltagetVæsentligt36Måneder
| par13_forskudsafskrivning_låses_til_samme_virksomhed(status: Par13VirksomhedsUnderskudStatus) -> par13_virksomhedsunderskud_låses_til_samme_virksomhed(status)
| par13_virksomhedsunderskud_beløbsresultat(input: Par13VirksomhedsUnderskudInput) -> hvis par13_virksomhedsunderskud_låses_til_samme_virksomhed(input.status) {
    Par13VirksomhedsUnderskudResult(
        fradrag_i_øvrig_indkomst_kroner = 0,
        modregnet_i_samme_virksomhed_kroner = par13_mindste_beløb(par13_positivt_beløb(input.underskud_kroner), par13_positivt_beløb(input.positiv_indkomst_samme_virksomhed_kroner)),
        fremført_til_samme_virksomhed_kroner = par13_positivt_beløb(input.underskud_kroner) - par13_mindste_beløb(par13_positivt_beløb(input.underskud_kroner), par13_positivt_beløb(input.positiv_indkomst_samme_virksomhed_kroner))
    )
} ellers {
    Par13VirksomhedsUnderskudResult(
        fradrag_i_øvrig_indkomst_kroner = par13_positivt_beløb(input.underskud_kroner),
        modregnet_i_samme_virksomhed_kroner = 0,
        fremført_til_samme_virksomhed_kroner = 0
    )
}

