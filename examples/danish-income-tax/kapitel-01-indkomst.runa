    | skattepligtige_beløb_kroner() -> input.afskrivningslov40c_resultat.skattepligtigt_beløb_kroner
    | fradragsberettigede_beløb_kroner() -> input.afskrivningslov40c_resultat.fradragsberettiget_beløb_kroner
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr16_al40c_beløb kapitalindkomst_kroner() -> input.afskrivningslov40c_resultat.netto_skattepligtigt_eller_fradragsberettiget_kroner under omfattet_af_afskrivningslov40c()
    | resultat() -> Par4Stk1Nr16Resultat(
