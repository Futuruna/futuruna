| kapitalindkomst_omfatter(post: Kapitalpost) -> Sandt
| kapitalomkostning_fradrages_i_kapitalindkomst() -> Sandt

| kapitalpost_medregnes_personligt_ved_næring(post: Kapitalpost, status: Næringsstatus) -> Falskt under status == IkkeNæring
| exception fordringsnæring kapitalpost_medregnes_personligt_ved_næring(post: Kapitalpost, status: Næringsstatus) -> Sandt under status == FordringsEllerKontraktNæring
| exception finansieringsnæring kapitalpost_medregnes_personligt_ved_næring(post: Kapitalpost, status: Næringsstatus) -> Sandt under status == FinansieringsNæring

| andelsudlodning_medregnes_personligt(udlodning: AndelsforeningUdlodning) -> Sandt
| exception normal_forrentning andelsudlodning_medregnes_personligt(udlodning: AndelsforeningUdlodning) -> Falskt under udlodning == NormalForrentning

| kapitalundtagelse_medregnes_personligt(undtagelse: KapitalTilPersonligUndtagelse) -> Sandt

| udlejning_af_driftsmidler_regel_anvendes(anskaffelse: Anskaffelsesstatus, tilladelse: SkatterådsTilladelse, skøn: RådetsSkøn) -> Sandt
| exception skatterådet_tillader udlejning_af_driftsmidler_regel_anvendes(anskaffelse: Anskaffelsesstatus, tilladelse: SkatterådsTilladelse, skøn: RådetsSkøn) -> Falskt under anskaffelse == Før19Maj1993 && tilladelse == TilladelseGivet && skøn == Godtgjort

| medregnes_i_ejertal_par4_nr9(anvender_ligningslov8p: Boolsk) -> Sandt
| exception vedvarende_energi medregnes_i_ejertal_par4_nr9(anvender_ligningslov8p: Boolsk) -> Falskt under anvender_ligningslov8p

| par4_reklassifikation_fra_kursgevinstlov(reklassifikation: KursgevinstlovPersonligReklassifikation) -> IngenPersonligReklassifikation
| exception par4_kgl_fordrings_eller_kontraktnæring par4_reklassifikation_fra_kursgevinstlov(reklassifikation: KursgevinstlovPersonligReklassifikation) -> FordringsEllerKontraktNæringReklassifikation under reklassifikation == KglFordringsEllerKontraktNæring
| exception par4_kgl_finansieringsnæring par4_reklassifikation_fra_kursgevinstlov(reklassifikation: KursgevinstlovPersonligReklassifikation) -> FinansieringsNæringReklassifikation under reklassifikation == KglFinansieringsNæring
| exception par4_kgl_par17_fordringstab par4_reklassifikation_fra_kursgevinstlov(reklassifikation: KursgevinstlovPersonligReklassifikation) -> Kursgevinstlov17Fordringstab under reklassifikation == KglPar17Fordringstab

# Par4Stk1Nr1Sag(input: Par4Stk1Nr1Input) {
    | renteindtægter_kroner() -> penge_positivt_beløb(input.renteindtægter_kroner)
    | renteudgifter_kroner() -> penge_positivt_beløb(input.renteudgifter_kroner)
    | ligningslov6_fradrag_kroner() -> input.ligningslov6_resultat.fradrag_kroner
    | ligningslov6a_fradrag_kroner() -> input.ligningslov6a_resultat.fradrag_kroner
    | kapitalindkomst_kroner() -> renteindtægter_kroner() - renteudgifter_kroner() - ligningslov6_fradrag_kroner() - ligningslov6a_fradrag_kroner()
    | resultat() -> Par4Stk1Nr1Resultat(
        renteindtægter_kroner = renteindtægter_kroner(),
        renteudgifter_kroner = renteudgifter_kroner(),
        ligningslov6_fradrag_kroner = ligningslov6_fradrag_kroner(),
        ligningslov6a_fradrag_kroner = ligningslov6a_fradrag_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        personlig_reklassifikation = input.personlig_reklassifikation
    )
}
| par4_stk1_nr1_sag(input: Par4Stk1Nr1Input) -> Par4Stk1Nr1Sag(input)
| par4_stk1_nr1_resultat(input: Par4Stk1Nr1Input) -> par4_stk1_nr1_sag(input).resultat()
| par4_stk1_nr1_kapitalpost(input: Par4Stk1Nr1Input) -> Par4Kapitalpost(
    art = RenterOgLigningslov6,
    beløb_kroner = par4_stk1_nr1_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = input.personlig_reklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)

# Par4Stk1Nr2Sag(input: Par4Stk1Nr2Input) {
    | skattepligtige_gevinster_kroner() -> input.kursgevinstlov_resultat.skattepligtig_gevinst_kroner
    | fradragsberettigede_tab_kroner() -> input.kursgevinstlov_resultat.fradragsberettiget_tab_kroner
    | tab_afskåret_kroner() -> input.kursgevinstlov_resultat.tab_afskåret_kroner
    | kapitalindkomst_kroner() -> input.kursgevinstlov_resultat.netto_efter_kursgevinstloven_kroner
    | personlig_reklassifikation() -> par4_reklassifikation_fra_kursgevinstlov(input.kursgevinstlov_resultat.personlig_reklassifikation)
    | resultat() -> Par4Stk1Nr2Resultat(
        skattepligtige_gevinster_kroner = skattepligtige_gevinster_kroner(),
        fradragsberettigede_tab_kroner = fradragsberettigede_tab_kroner(),
        tab_afskåret_kroner = tab_afskåret_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        personlig_reklassifikation = personlig_reklassifikation()
    )
}
| par4_stk1_nr2_sag(input: Par4Stk1Nr2Input) -> Par4Stk1Nr2Sag(input)
| par4_stk1_nr2_resultat(input: Par4Stk1Nr2Input) -> par4_stk1_nr2_sag(input).resultat()
| par4_stk1_nr2_input_fra_kursgevinstlov(input: KursgevinstlovInput) -> Par4Stk1Nr2Input(
    kursgevinstlov_resultat = kursgevinstlov_resultat(input)
)
| par4_stk1_nr2_resultat_fra_kursgevinstlov(input: KursgevinstlovInput) -> par4_stk1_nr2_resultat(par4_stk1_nr2_input_fra_kursgevinstlov(input))
| par4_stk1_nr2_kapitalpost(input: Par4Stk1Nr2Input) -> Par4Kapitalpost(
    art = KursgevinstOgTab,
    beløb_kroner = par4_stk1_nr2_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = par4_stk1_nr2_sag(input).personlig_reklassifikation(),
    personlig_indkomst_tillæg_kroner = 0
)
| par4_stk1_nr2_kapitalpost_fra_kursgevinstlov(input: KursgevinstlovInput) -> par4_stk1_nr2_kapitalpost(par4_stk1_nr2_input_fra_kursgevinstlov(input))

# Par4Stk1Nr3Sag(input: Par4Stk1Nr3Input) {
    | brutto_kapitalafkast_kroner() -> input.virksomhedsskattelov7_resultat.kapitalafkast_kroner
    | skattekontrollov_hjemmel() -> input.skattekontrollov_oplysningsfrist_resultat.kilde
    | oplysningsfrist_yyyymmdd() -> input.skattekontrollov_oplysningsfrist_resultat.frist_efter_par13_yyyymmdd
    | overført_til_skattepligtig_inden_oplysningsfrist() -> input.skattekontrollov_oplysningsfrist_resultat.rettidigt
    | medregnet_personlig_indkomst_efter_par23a_kroner() -> input.virksomhedsskattelov23a_resultat.personlig_indkomst_kroner
    | kapitalafkast_efter_par23a_kroner() -> penge_positivt_beløb(brutto_kapitalafkast_kroner() - medregnet_personlig_indkomst_efter_par23a_kroner())
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr3_overført_resterende_kapitalafkast kapitalindkomst_kroner() -> kapitalafkast_efter_par23a_kroner() under overført_til_skattepligtig_inden_oplysningsfrist()
    | resultat() -> Par4Stk1Nr3Resultat(
        brutto_kapitalafkast_kroner = brutto_kapitalafkast_kroner(),
        skattekontrollov_hjemmel = skattekontrollov_hjemmel(),
        oplysningsfrist_yyyymmdd = oplysningsfrist_yyyymmdd(),
        overført_til_skattepligtig_inden_oplysningsfrist = overført_til_skattepligtig_inden_oplysningsfrist(),
        medregnet_personlig_indkomst_efter_par23a_kroner = medregnet_personlig_indkomst_efter_par23a_kroner(),
        kapitalafkast_efter_par23a_kroner = kapitalafkast_efter_par23a_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| par4_stk1_nr3_sag(input: Par4Stk1Nr3Input) -> Par4Stk1Nr3Sag(input)
| par4_stk1_nr3_resultat(input: Par4Stk1Nr3Input) -> par4_stk1_nr3_sag(input).resultat()
| par4_stk1_nr3_input_fra_virksomhedsskattelov7(vsl7_input: Virksomhedsskattelov7Input, oplysningsfrist_input: SkattekontrollovOplysningsfristInput, vsl23a_input: Virksomhedsskattelov23AInput) -> Par4Stk1Nr3Input(
    virksomhedsskattelov7_resultat = virksomhedsskattelov7_resultat(vsl7_input),
    skattekontrollov_oplysningsfrist_resultat = skattekontrollov_oplysningsfrist_resultat(oplysningsfrist_input),
    virksomhedsskattelov23a_resultat = virksomhedsskattelov23a_resultat(vsl23a_input)
)
| par4_stk1_nr3_resultat_fra_virksomhedsskattelov7(vsl7_input: Virksomhedsskattelov7Input, oplysningsfrist_input: SkattekontrollovOplysningsfristInput, vsl23a_input: Virksomhedsskattelov23AInput) -> par4_stk1_nr3_resultat(par4_stk1_nr3_input_fra_virksomhedsskattelov7(vsl7_input, oplysningsfrist_input, vsl23a_input))
| par4_stk1_nr3_kapitalpost(input: Par4Stk1Nr3Input) -> Par4Kapitalpost(
    art = KapitalafkastVsl7,
    beløb_kroner = par4_stk1_nr3_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = IngenPersonligReklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)
| par4_stk1_nr3_kapitalpost_fra_virksomhedsskattelov7(vsl7_input: Virksomhedsskattelov7Input, oplysningsfrist_input: SkattekontrollovOplysningsfristInput, vsl23a_input: Virksomhedsskattelov23AInput) -> par4_stk1_nr3_kapitalpost(par4_stk1_nr3_input_fra_virksomhedsskattelov7(vsl7_input, oplysningsfrist_input, vsl23a_input))

# Par4Stk1Nr3aSag(input: Par4Stk1Nr3aInput) {
    | kapitalafkast_efter_virksomhedsskattelov22a_kroner() -> input.virksomhedsskattelov22a_resultat.kapitalafkast_kroner
    | medregnet_personlig_indkomst_efter_par23a_kroner() -> input.virksomhedsskattelov23a_resultat.personlig_indkomst_kroner
    | kapitalafkast_22a_efter_par23a_kroner() -> penge_positivt_beløb(kapitalafkast_efter_virksomhedsskattelov22a_kroner() - medregnet_personlig_indkomst_efter_par23a_kroner())
    | kapitalafkast_efter_virksomhedsskattelov22c_kroner() -> input.virksomhedsskattelov22c_resultat.kapitalindkomst_tillæg_kroner
    | kapitalindkomst_kroner() -> kapitalafkast_22a_efter_par23a_kroner() + kapitalafkast_efter_virksomhedsskattelov22c_kroner()
    | resultat() -> Par4Stk1Nr3aResultat(
        kapitalafkast_efter_virksomhedsskattelov22a_kroner = kapitalafkast_efter_virksomhedsskattelov22a_kroner(),
        medregnet_personlig_indkomst_efter_par23a_kroner = medregnet_personlig_indkomst_efter_par23a_kroner(),
        kapitalafkast_22a_efter_par23a_kroner = kapitalafkast_22a_efter_par23a_kroner(),
        kapitalafkast_efter_virksomhedsskattelov22c_kroner = kapitalafkast_efter_virksomhedsskattelov22c_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| par4_stk1_nr3a_sag(input: Par4Stk1Nr3aInput) -> Par4Stk1Nr3aSag(input)
| par4_stk1_nr3a_resultat(input: Par4Stk1Nr3aInput) -> par4_stk1_nr3a_sag(input).resultat()
| par4_stk1_nr3a_input_fra_virksomhedsskattelov22(vsl22a_input: Virksomhedsskattelov22AInput, vsl23a_input: Virksomhedsskattelov23AInput, vsl22c_input: Virksomhedsskattelov22CInput) -> Par4Stk1Nr3aInput(
    virksomhedsskattelov22a_resultat = virksomhedsskattelov22a_resultat(vsl22a_input),
    virksomhedsskattelov23a_resultat = virksomhedsskattelov23a_resultat(vsl23a_input),
    virksomhedsskattelov22c_resultat = virksomhedsskattelov22c_resultat(vsl22c_input)
)
| par4_stk1_nr3a_resultat_fra_virksomhedsskattelov22(vsl22a_input: Virksomhedsskattelov22AInput, vsl23a_input: Virksomhedsskattelov23AInput, vsl22c_input: Virksomhedsskattelov22CInput) -> par4_stk1_nr3a_resultat(par4_stk1_nr3a_input_fra_virksomhedsskattelov22(vsl22a_input, vsl23a_input, vsl22c_input))
| par4_stk1_nr3a_kapitalpost(input: Par4Stk1Nr3aInput) -> Par4Kapitalpost(
    art = KapitalafkastVsl22,
    beløb_kroner = par4_stk1_nr3a_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = IngenPersonligReklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)
| par4_stk1_nr3a_kapitalpost_fra_virksomhedsskattelov22(vsl22a_input: Virksomhedsskattelov22AInput, vsl23a_input: Virksomhedsskattelov23AInput, vsl22c_input: Virksomhedsskattelov22CInput) -> par4_stk1_nr3a_kapitalpost(par4_stk1_nr3a_input_fra_virksomhedsskattelov22(vsl22a_input, vsl23a_input, vsl22c_input))

# Par4Stk1Nr4Sag(input: Par4Stk1Nr4Input) {
    | skattepligtigt_udbytte_kroner() -> input.ligningslov16a_resultat.udbytte_kroner
    | ikke_aktieindkomst_efter_par4a() -> input.ikke_aktieindkomst_efter_par4a
    | personlig_reklassifikation() -> IngenPersonligReklassifikation
    | exception par4_stk4_andelsudlodning_ikke_normal personlig_reklassifikation() -> AndelsUdlodningIkkeNormal under andelsudlodning_medregnes_personligt(input.andelsforening_udlodning)
    | omfattet_af_kapitalindkomst() -> input.ligningslov16a_resultat.omfattet_af_par16a_udbytte && ikke_aktieindkomst_efter_par4a() && personlig_reklassifikation() == IngenPersonligReklassifikation
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr4_udbytte_ikke_aktieindkomst kapitalindkomst_kroner() -> skattepligtigt_udbytte_kroner() under omfattet_af_kapitalindkomst()
    | postbeløb_kroner() -> 0
    | exception par4_stk1_nr4_kapitalpost postbeløb_kroner() -> skattepligtigt_udbytte_kroner() under omfattet_af_kapitalindkomst()
    | exception par4_stk4_til_7_personlig_post postbeløb_kroner() -> skattepligtigt_udbytte_kroner() under personlig_reklassifikation() != IngenPersonligReklassifikation
    | resultat() -> Par4Stk1Nr4Resultat(
        skattepligtigt_udbytte_kroner = skattepligtigt_udbytte_kroner(),
        ikke_aktieindkomst_efter_par4a = ikke_aktieindkomst_efter_par4a(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        personlig_reklassifikation = personlig_reklassifikation()
    )
}
| par4_stk1_nr4_sag(input: Par4Stk1Nr4Input) -> Par4Stk1Nr4Sag(input)
| par4_stk1_nr4_resultat(input: Par4Stk1Nr4Input) -> par4_stk1_nr4_sag(input).resultat()
| par4_stk1_nr4_input_fra_ligningslov16a(input: Ligningslov16AInput, ikke_aktieindkomst_efter_par4a: Boolsk, andelsforening_udlodning: AndelsforeningUdlodning) -> Par4Stk1Nr4Input(
    ligningslov16a_resultat = ligningslov16a_resultat(input),
    ikke_aktieindkomst_efter_par4a = ikke_aktieindkomst_efter_par4a,
    andelsforening_udlodning = andelsforening_udlodning
)
| par4_stk1_nr4_resultat_fra_ligningslov16a(input: Ligningslov16AInput, ikke_aktieindkomst_efter_par4a: Boolsk, andelsforening_udlodning: AndelsforeningUdlodning) -> par4_stk1_nr4_resultat(par4_stk1_nr4_input_fra_ligningslov16a(input, ikke_aktieindkomst_efter_par4a, andelsforening_udlodning))
| par4_stk1_nr4_kapitalpost(input: Par4Stk1Nr4Input) -> Par4Kapitalpost(
    art = AktieudbytteIkkeAktieindkomst,
    beløb_kroner = par4_stk1_nr4_sag(input).postbeløb_kroner(),
    personlig_reklassifikation = par4_stk1_nr4_sag(input).personlig_reklassifikation(),
    personlig_indkomst_tillæg_kroner = 0
)
| par4_stk1_nr4_kapitalpost_fra_ligningslov16a(input: Ligningslov16AInput, ikke_aktieindkomst_efter_par4a: Boolsk, andelsforening_udlodning: AndelsforeningUdlodning) -> par4_stk1_nr4_kapitalpost(par4_stk1_nr4_input_fra_ligningslov16a(input, ikke_aktieindkomst_efter_par4a, andelsforening_udlodning))

| par4_stk1_nr5_reklassifikation_fra_aktieavancebeskatningslov(resultat: AktieavancebeskatningslovResultat) -> IngenPersonligReklassifikation
| exception par4_stk1_nr5_par17_til_personlig par4_stk1_nr5_reklassifikation_fra_aktieavancebeskatningslov(resultat: AktieavancebeskatningslovResultat) -> Aktieavance17Aktier under resultat.personskattelov_kategori == AblPersonligIndkomstEfterPslUndtagelse && resultat.effektiv_aktiv == AblNæringsaktiePar17
| exception par4_stk1_nr5_par19c_hvis17_til_personlig par4_stk1_nr5_reklassifikation_fra_aktieavancebeskatningslov(resultat: AktieavancebeskatningslovResultat) -> Aktieavance19CHvis17Aktier under resultat.personskattelov_kategori == AblPersonligIndkomstEfterPslUndtagelse && resultat.effektiv_aktiv == AblInvesteringsselskab19C

# Par4Stk1Nr5Sag(input: Par4Stk1Nr5Input) {
    | effektiv_aktiv() -> input.aktieavancebeskatningslov_resultat.effektiv_aktiv
    | skattepligtig_gevinst_kroner() -> input.aktieavancebeskatningslov_resultat.skattepligtig_gevinst_kroner
    | fradragsberettiget_tab_kroner() -> input.aktieavancebeskatningslov_resultat.fradragsberettiget_tab_kroner
    | personlig_reklassifikation() -> par4_stk1_nr5_reklassifikation_fra_aktieavancebeskatningslov(input.aktieavancebeskatningslov_resultat)
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr5_abl18_19c_22_kapital kapitalindkomst_kroner() -> input.aktieavancebeskatningslov_resultat.netto_efter_aktieavancebeskatningsloven_kroner under input.aktieavancebeskatningslov_resultat.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5
    | postbeløb_kroner() -> 0
    | exception par4_stk1_nr5_kapitalpost postbeløb_kroner() -> input.aktieavancebeskatningslov_resultat.netto_efter_aktieavancebeskatningsloven_kroner under input.aktieavancebeskatningslov_resultat.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5
    | exception par4_stk5_personlig_post postbeløb_kroner() -> input.aktieavancebeskatningslov_resultat.netto_efter_aktieavancebeskatningsloven_kroner under personlig_reklassifikation() != IngenPersonligReklassifikation
    | resultat() -> Par4Stk1Nr5Resultat(
        effektiv_aktiv = effektiv_aktiv(),
        skattepligtig_gevinst_kroner = skattepligtig_gevinst_kroner(),
        fradragsberettiget_tab_kroner = fradragsberettiget_tab_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        personlig_reklassifikation = personlig_reklassifikation()
    )
}
| par4_stk1_nr5_sag(input: Par4Stk1Nr5Input) -> Par4Stk1Nr5Sag(input)
| par4_stk1_nr5_resultat(input: Par4Stk1Nr5Input) -> par4_stk1_nr5_sag(input).resultat()
| par4_stk1_nr5_input_fra_aktieavancebeskatningslov(input: AktieavancebeskatningslovInput) -> Par4Stk1Nr5Input(
    aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat(input)
)
| par4_stk1_nr5_resultat_fra_aktieavancebeskatningslov(input: AktieavancebeskatningslovInput) -> par4_stk1_nr5_resultat(par4_stk1_nr5_input_fra_aktieavancebeskatningslov(input))
| par4_stk1_nr5_kapitalpost(input: Par4Stk1Nr5Input) -> Par4Kapitalpost(
    art = AktieavanceIkkeAktieindkomst,
    beløb_kroner = par4_stk1_nr5_sag(input).postbeløb_kroner(),
    personlig_reklassifikation = par4_stk1_nr5_sag(input).personlig_reklassifikation(),
    personlig_indkomst_tillæg_kroner = 0
)
| par4_stk1_nr5_kapitalpost_fra_aktieavancebeskatningslov(input: AktieavancebeskatningslovInput) -> par4_stk1_nr5_kapitalpost(par4_stk1_nr5_input_fra_aktieavancebeskatningslov(input))

# Par4Stk1Nr5aSag(input: Par4Stk1Nr5aInput) {
    | selskabsskattelov_hjemmel() -> input.selskabsskattelov1_stk1_nr6_resultat.kilde
    | skattepligtig_efter_selskabsskattelov1_stk1_nr6() -> input.selskabsskattelov1_stk1_nr6_resultat.skattepligtig_efter_par1_stk1_nr6
    | investeringsforening() -> input.selskabsskattelov1_stk1_nr6_resultat.investeringsforening
    | omfattet_af_kapitalindkomst() -> skattepligtig_efter_selskabsskattelov1_stk1_nr6() && investeringsforening() == Falskt
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr5a_medlemsbevis kapitalindkomst_kroner() -> input.beløb_kroner under omfattet_af_kapitalindkomst()
    | resultat() -> Par4Stk1Nr5aResultat(
        selskabsskattelov_hjemmel = selskabsskattelov_hjemmel(),
        skattepligtig_efter_selskabsskattelov1_stk1_nr6 = skattepligtig_efter_selskabsskattelov1_stk1_nr6(),
        investeringsforening = investeringsforening(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| par4_stk1_nr5a_sag(input: Par4Stk1Nr5aInput) -> Par4Stk1Nr5aSag(input)
| par4_stk1_nr5a_resultat(input: Par4Stk1Nr5aInput) -> par4_stk1_nr5a_sag(input).resultat()
| par4_stk1_nr5a_input_fra_selskabsskattelov1_stk1_nr6(beløb_kroner: Heltal, input: Selskabsskattelov1Stk1Nr6Input) -> Par4Stk1Nr5aInput(
    beløb_kroner = beløb_kroner,
    selskabsskattelov1_stk1_nr6_resultat = selskabsskattelov1_stk1_nr6_resultat(input)
)
| par4_stk1_nr5a_resultat_fra_selskabsskattelov1_stk1_nr6(beløb_kroner: Heltal, input: Selskabsskattelov1Stk1Nr6Input) -> par4_stk1_nr5a_resultat(par4_stk1_nr5a_input_fra_selskabsskattelov1_stk1_nr6(beløb_kroner, input))
| par4_stk1_nr5a_kapitalpost(input: Par4Stk1Nr5aInput) -> Par4Kapitalpost(
    art = Medlemsbeviser,
    beløb_kroner = par4_stk1_nr5a_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = IngenPersonligReklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)

| par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Falskt
| exception par4_stk1_nr5b_pengeinstitut par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bPengeinstitut
| exception par4_stk1_nr5b_realkreditinstitut par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bRealkreditinstitut
| exception par4_stk1_nr5b_fondsmægler par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bFondsmæglerselskab
| exception par4_stk1_nr5b_investeringsforvaltning par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bInvesteringsforvaltningsselskab
| exception par4_stk1_nr5b_alternativ_fond_forvalter par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bForvalterAfAlternativeInvesteringsfonde
