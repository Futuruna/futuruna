# Par4Stk1Nr11Sag(input: Par4Stk1Nr11Input) {
    | aktiv_omfattet() -> par4_stk1_nr11_aktiv_omfattet(input.aktiv)
    | stk8_regel_anvendes() -> udlejning_af_driftsmidler_regel_anvendes(input.anskaffelse, input.skatteråds_tilladelse, input.rådets_skøn)
    | stk8_tilladelse_afskærer() -> stk8_regel_anvendes() == Falskt
    | væsentlig_deltagelse_afskærer() -> input.deltager_væsentligt_i_drift
    | omfattet_af_kapitalindkomst() -> aktiv_omfattet() && stk8_regel_anvendes() && væsentlig_deltagelse_afskærer() == Falskt
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr11_udlejning_indkomst kapitalindkomst_kroner() -> input.beløb_kroner under omfattet_af_kapitalindkomst()
    | ikke_omfattet_af_par4_nr11_kroner() -> input.beløb_kroner - kapitalindkomst_kroner()
    | resultat() -> Par4Stk1Nr11Resultat(
        aktiv = input.aktiv,
        stk8_regel_anvendes = stk8_regel_anvendes(),
        stk8_tilladelse_afskærer = stk8_tilladelse_afskærer(),
        væsentlig_deltagelse_afskærer = væsentlig_deltagelse_afskærer(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        ikke_omfattet_af_par4_nr11_kroner = ikke_omfattet_af_par4_nr11_kroner()
    )
}
| par4_stk1_nr11_sag(input: Par4Stk1Nr11Input) -> Par4Stk1Nr11Sag(input)
| par4_stk1_nr11_resultat(input: Par4Stk1Nr11Input) -> par4_stk1_nr11_sag(input).resultat()
