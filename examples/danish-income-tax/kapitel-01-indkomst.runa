        kapitalindkomst_fradrag_kroner = kapitalindkomst_fradrag_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| par4_stk1_nr8_sag(input: Par4Stk1Nr8Input) -> Par4Stk1Nr8Sag(input)
| par4_stk1_nr8_resultat(input: Par4Stk1Nr8Input) -> par4_stk1_nr8_sag(input).resultat()
