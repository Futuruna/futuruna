# Par3Stk2Nr10PostResultat(hjemmel: Par3Stk2Nr10Hjemmel, selvstændig_erhvervsdrivende_person: Boolsk, fysisk_person: Boolsk, skattepligtig_indtægtsføring_kroner: Heltal, indtægtsføring_i_personlig_indkomst_kroner: Heltal, skattemæssig_afskrivning_kroner: Heltal, tab_kroner: Heltal, andet_fradrag_kroner: Heltal, brutto_fradrag_efter_afskrivningsloven_kroner: Heltal, fradrag_i_personlig_indkomst_kroner: Heltal, afskåret_fordi_ikke_selvstændig_person_kroner: Heltal, afskåret_fordi_ikke_fysisk_person_indtægt_kroner: Heltal)
