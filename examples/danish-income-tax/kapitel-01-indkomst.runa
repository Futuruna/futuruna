| par4_fradragsberettigede_omkostninger_kroner(input: Par4KapitalindkomstInput) -> foldl(input.omkostninger, 0, |sum, omkostning| sum + par4_kapitalomkostning_i_kapitalindkomst_kroner(omkostning))
| par4_omklassificerede_personlige_omkostninger_kroner(input: Par4KapitalindkomstInput) -> foldl(input.omkostninger, 0, |sum, omkostning| sum + par4_kapitalomkostning_i_personlig_indkomst_kroner(omkostning))
| par4_nettokapitalindkomst_kroner(input: Par4KapitalindkomstInput) -> par4_postbeløb_i_kapitalindkomst_kroner(input) - par4_fradragsberettigede_omkostninger_kroner(input)
