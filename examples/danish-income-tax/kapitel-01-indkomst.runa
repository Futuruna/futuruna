| par4_stk1_nr17_lejer_eller_andelshaver(rolle: Par4Stk1Nr17Boligrolle) -> Falskt
| exception par4_stk1_nr17_lejer par4_stk1_nr17_lejer_eller_andelshaver(rolle: Par4Stk1Nr17Boligrolle) -> Sandt under rolle == Lejer
| exception par4_stk1_nr17_andelshaver par4_stk1_nr17_lejer_eller_andelshaver(rolle: Par4Stk1Nr17Boligrolle) -> Sandt under rolle == Andelshaver
| par4_stk1_nr17_ligningslov15q_omfattet(afgrænsning: Par4Stk1Nr17Ligningslov15QAfgrænsning) -> Falskt
| exception par4_stk1_nr17_ligningslov15q_stk1 par4_stk1_nr17_ligningslov15q_omfattet(afgrænsning: Par4Stk1Nr17Ligningslov15QAfgrænsning) -> Sandt under afgrænsning == Ligningslov15QStk1
| exception par4_stk1_nr17_ligningslov15q_stk3 par4_stk1_nr17_ligningslov15q_omfattet(afgrænsning: Par4Stk1Nr17Ligningslov15QAfgrænsning) -> Sandt under afgrænsning == Ligningslov15QStk3

# Par4Stk1Nr17Sag(input: Par4Stk1Nr17Input) {
    | lejer_eller_andelshaver() -> par4_stk1_nr17_lejer_eller_andelshaver(input.rolle)
    | omfattet_af_ligningslov15q() -> par4_stk1_nr17_ligningslov15q_omfattet(input.afgrænsning)
    | bruttolejeindtægt_kroner() -> penge_positivt_beløb(input.bruttolejeindtægt_kroner)
    | ligningslov15q_fradrag_kroner() -> penge_positivt_beløb(input.ligningslov15q_fradrag_kroner)
    | overskud_efter_ligningslov15q_kroner() -> penge_positivt_beløb(bruttolejeindtægt_kroner() - ligningslov15q_fradrag_kroner())
    | omfattet_af_kapitalindkomst() -> lejer_eller_andelshaver() && omfattet_af_ligningslov15q() && overskud_efter_ligningslov15q_kroner() > 0
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr17_fremleje_overskud kapitalindkomst_kroner() -> overskud_efter_ligningslov15q_kroner() under omfattet_af_kapitalindkomst()
    | ikke_omfattet_af_par4_nr17_kroner() -> overskud_efter_ligningslov15q_kroner() - kapitalindkomst_kroner()
    | resultat() -> Par4Stk1Nr17Resultat(
        rolle = input.rolle,
        afgrænsning = input.afgrænsning,
        lejer_eller_andelshaver = lejer_eller_andelshaver(),
        omfattet_af_ligningslov15q = omfattet_af_ligningslov15q(),
        bruttolejeindtægt_kroner = bruttolejeindtægt_kroner(),
        ligningslov15q_fradrag_kroner = ligningslov15q_fradrag_kroner(),
        overskud_efter_ligningslov15q_kroner = overskud_efter_ligningslov15q_kroner(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        ikke_omfattet_af_par4_nr17_kroner = ikke_omfattet_af_par4_nr17_kroner()
    )
}
| par4_stk1_nr17_sag(input: Par4Stk1Nr17Input) -> Par4Stk1Nr17Sag(input)
| par4_stk1_nr17_resultat(input: Par4Stk1Nr17Input) -> par4_stk1_nr17_sag(input).resultat()
| par4_stk1_nr17_kapitalpost(input: Par4Stk1Nr17Input) -> Par4Kapitalpost(
    art = FremlejeOverskud,
    beløb_kroner = par4_stk1_nr17_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = IngenPersonligReklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)

| par4_stk1_nr17_rolle_fra_ligningslov15q(rolle: Ligningslov15QBoligrolle) -> EjerEllerAnden
| exception par4_stk1_nr17_ll15q_lejer par4_stk1_nr17_rolle_fra_ligningslov15q(rolle: Ligningslov15QBoligrolle) -> Lejer under rolle == Ll15QLejer
| exception par4_stk1_nr17_ll15q_andelshaver par4_stk1_nr17_rolle_fra_ligningslov15q(rolle: Ligningslov15QBoligrolle) -> Andelshaver under rolle == Ll15QAndelshaver
| par4_stk1_nr17_afgrænsning_fra_ligningslov15q(resultat: Ligningslov15QResultat) -> IkkeLigningslov15Q
| exception par4_stk1_nr17_ll15q_stk1 par4_stk1_nr17_afgrænsning_fra_ligningslov15q(resultat: Ligningslov15QResultat) -> Ligningslov15QStk1 under resultat.stk1_anvendelig
| exception par4_stk1_nr17_ll15q_stk3 par4_stk1_nr17_afgrænsning_fra_ligningslov15q(resultat: Ligningslov15QResultat) -> Ligningslov15QStk3 under resultat.stk3_anvendelig

# Par4Stk1Nr17FraLigningslov15QSag(input: Ligningslov15QInput) {
    | ll15q_resultat() -> ligningslov15q_resultat(input)
    | par4_input() -> Par4Stk1Nr17Input(
        rolle = par4_stk1_nr17_rolle_fra_ligningslov15q(input.rolle),
        afgrænsning = par4_stk1_nr17_afgrænsning_fra_ligningslov15q(ll15q_resultat()),
        bruttolejeindtægt_kroner = ll15q_resultat().bruttolejeindtægt_kroner,
        ligningslov15q_fradrag_kroner = ll15q_resultat().fradrag_i_indkomstopgørelse_kroner
    )
    | par4_resultat() -> par4_stk1_nr17_resultat(par4_input())
}
| par4_stk1_nr17_fra_ligningslov15q_sag(input: Ligningslov15QInput) -> Par4Stk1Nr17FraLigningslov15QSag(input)
| par4_stk1_nr17_input_fra_ligningslov15q(input: Ligningslov15QInput) -> par4_stk1_nr17_fra_ligningslov15q_sag(input).par4_input()
| par4_stk1_nr17_resultat_fra_ligningslov15q(input: Ligningslov15QInput) -> par4_stk1_nr17_fra_ligningslov15q_sag(input).par4_resultat()
| par4_stk1_nr17_kapitalpost_fra_ligningslov15q(input: Ligningslov15QInput) -> par4_stk1_nr17_kapitalpost(par4_stk1_nr17_input_fra_ligningslov15q(input))

| par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Falskt
| exception par4_stk3_fordrings_eller_kontraktnæring par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == FordringsEllerKontraktNæringReklassifikation
| exception par4_stk3_finansieringsnæring par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == FinansieringsNæringReklassifikation
| exception par4_stk3_kursgevinstlov17_tab par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == Kursgevinstlov17Fordringstab
| exception par4_stk4_andelsudlodning_ikke_normal par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == AndelsUdlodningIkkeNormal
| exception par4_stk5_aktieavance17 par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == Aktieavance17Aktier
| exception par4_stk5_aktieavance19c_hvis17 par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == Aktieavance19CHvis17Aktier
| exception par4_stk6_investeringsformidler19c_hvis17 par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == Investeringsformidler19CHvis17Aktier
| exception par4_stk7_medarbejderinvesteringsselskab par4_reklassifikation_til_personlig_indkomst(reklassifikation: KapitalPersonligReklassifikation) -> Sandt under reklassifikation == MedarbejderinvesteringsselskabAndel
| par4_kapitalpost_reklassificeres_til_personlig_indkomst(post: Par4Kapitalpost) -> par4_reklassifikation_til_personlig_indkomst(post.personlig_reklassifikation)
| par4_kapitalpost_i_kapitalindkomst_kroner(post: Par4Kapitalpost) -> post.beløb_kroner
| exception par4_stk3_til_7_reklassificeret_ikke_kapital par4_kapitalpost_i_kapitalindkomst_kroner(post: Par4Kapitalpost) -> 0 under par4_kapitalpost_reklassificeres_til_personlig_indkomst(post)
| par4_kapitalpost_i_personlig_indkomst_kroner(post: Par4Kapitalpost) -> 0
| exception par4_stk3_til_7_reklassificeret_personlig par4_kapitalpost_i_personlig_indkomst_kroner(post: Par4Kapitalpost) -> post.beløb_kroner under par4_kapitalpost_reklassificeres_til_personlig_indkomst(post)
| par4_kapitalpost_personlig_indkomst_tillæg_kroner(post: Par4Kapitalpost) -> penge_positivt_beløb(post.personlig_indkomst_tillæg_kroner)
| par4_kapitalomkostning_kroner(omkostning: Par4Kapitalomkostning) -> penge_positivt_beløb(omkostning.beløb_kroner)
| par4_postbeløb_i_kapitalindkomst_kroner(input: Par4KapitalindkomstInput) -> foldl(input.poster, 0, |sum, post| sum + par4_kapitalpost_i_kapitalindkomst_kroner(post))
| par4_fradragsberettigede_omkostninger_kroner(input: Par4KapitalindkomstInput) -> foldl(input.omkostninger, 0, |sum, omkostning| sum + par4_kapitalomkostning_kroner(omkostning))
| par4_nettokapitalindkomst_kroner(input: Par4KapitalindkomstInput) -> par4_postbeløb_i_kapitalindkomst_kroner(input) - par4_fradragsberettigede_omkostninger_kroner(input)
| par4_positiv_nettokapitalindkomst_kroner(input: Par4KapitalindkomstInput) -> penge_positivt_beløb(par4_nettokapitalindkomst_kroner(input))
| par4_negativ_nettokapitalindkomst_abs_kroner(input: Par4KapitalindkomstInput) -> penge_positivt_beløb(0 - par4_nettokapitalindkomst_kroner(input))
| par4_omklassificeret_personlig_indkomst_kroner(input: Par4KapitalindkomstInput) -> foldl(input.poster, 0, |sum, post| sum + par4_kapitalpost_i_personlig_indkomst_kroner(post))
| par4_personlig_indkomst_tillæg_kroner(input: Par4KapitalindkomstInput) -> foldl(input.poster, 0, |sum, post| sum + par4_kapitalpost_personlig_indkomst_tillæg_kroner(post))
| par4_kapitalindkomst_resultat(input: Par4KapitalindkomstInput) -> Par4KapitalindkomstResultat(
    postbeløb_i_kapitalindkomst_kroner = par4_postbeløb_i_kapitalindkomst_kroner(input),
    fradragsberettigede_omkostninger_kroner = par4_fradragsberettigede_omkostninger_kroner(input),
    nettokapitalindkomst_kroner = par4_nettokapitalindkomst_kroner(input),
    positiv_nettokapitalindkomst_kroner = par4_positiv_nettokapitalindkomst_kroner(input),
    negativ_nettokapitalindkomst_abs_kroner = par4_negativ_nettokapitalindkomst_abs_kroner(input),
    omklassificeret_personlig_indkomst_kroner = par4_omklassificeret_personlig_indkomst_kroner(input),
    personlig_indkomst_tillæg_kroner = par4_personlig_indkomst_tillæg_kroner(input)
)

