# Par4Stk1Nr9Sag(input: Par4Stk1Nr9Input) {
    | effektivt_ejerantal() -> penge_positivt_beløb(input.samlet_ejerantal - input.ligningslov8p_ejere_der_ikke_medregnes)
    | effektivt_personligt_ejerantal() -> penge_positivt_beløb(input.personligt_ejerantal - input.ligningslov8p_ejere_der_ikke_medregnes)
    | ejergrænse_opfyldt() -> Falskt
    | exception almindelig_virksomhed_over_ti_ejere ejergrænse_opfyldt() -> Sandt under input.virksomhedstype == AlmindeligSelvstændigVirksomhed && effektivt_ejerantal() > 10
    | exception ligningslov8k_over_to_personlige_ejere ejergrænse_opfyldt() -> Sandt under input.virksomhedstype == Ligningslov8KStk2SelvstændigVirksomhed && effektivt_personligt_ejerantal() > 2
    | væsentlig_deltagelse_afskærer() -> input.deltager_væsentligt_i_drift
    | omfattet_af_kapitalindkomst() -> ejergrænse_opfyldt() && væsentlig_deltagelse_afskærer() == Falskt
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr9_passiv_indkomst kapitalindkomst_kroner() -> input.beløb_kroner under omfattet_af_kapitalindkomst()
    | ikke_omfattet_af_par4_nr9_kroner() -> input.beløb_kroner - kapitalindkomst_kroner()
    | resultat() -> Par4Stk1Nr9Resultat(
        virksomhedstype = input.virksomhedstype,
        effektivt_ejerantal = effektivt_ejerantal(),
        effektivt_personligt_ejerantal = effektivt_personligt_ejerantal(),
        ejergrænse_opfyldt = ejergrænse_opfyldt(),
        væsentlig_deltagelse_afskærer = væsentlig_deltagelse_afskærer(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        ikke_omfattet_af_par4_nr9_kroner = ikke_omfattet_af_par4_nr9_kroner()
    )
}
| par4_stk1_nr9_sag(input: Par4Stk1Nr9Input) -> Par4Stk1Nr9Sag(input)
| par4_stk1_nr9_resultat(input: Par4Stk1Nr9Input) -> par4_stk1_nr9_sag(input).resultat()
| par4_stk1_nr9_kapitalpost(input: Par4Stk1Nr9Input) -> Par4Kapitalpost(
