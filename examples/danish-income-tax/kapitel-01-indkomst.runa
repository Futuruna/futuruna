    | kapitalindkomst_fradrag_kroner() -> input.virksomhedsskattelov11_resultat.kapitalindkomst_fradrag_kroner
    | kapitalindkomst_kroner() -> input.virksomhedsskattelov11_resultat.kapitalindkomst_kroner
