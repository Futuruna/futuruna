    | exception par4_stk1_nr6_ejendomsoverskud_underskud kapitalindkomst_kroner() -> input.overskud_eller_underskud_kroner under omfattet_af_kapitalindkomst()
    | ikke_omfattet_af_par4_nr6_kroner() -> input.overskud_eller_underskud_kroner - kapitalindkomst_kroner()
    | resultat() -> Par4Stk1Nr6Resultat(
        ejendomsskattelov_hjemmel = ejendomsskattelov_hjemmel(),
