# Par3PersonligIndkomstInput(indkomstposter: List(Par3Indkomstpost), stk2_nr1_udgifter: List(Par3Stk2Nr1UdgiftInput), stk2_nr2_input: Par3Stk2Nr2Input, stk2_nr3_til_11_input: Par3Stk2Nr3Til11Input)
# Par3UdligningsIndtægtsføringHjemmel = Par3Virksomhedsskattelov22BStk4Stk7Stk8 | Par3Virksomhedsskattelov22DStk2Stk3
# Par3UdligningsIndtægtsføringResultat(indkomstår: Heltal, hjemmel: Par3UdligningsIndtægtsføringHjemmel, indtægtsført_henlæggelse_kroner: Heltal, personlig_indkomst_tillæg_kroner: Heltal, medregnes_ikke_til_konkursindkomsten: Boolsk)

| er_personlig_indkomst(vurdering: IndkomstVurdering) -> vurdering.indgår_i_skattepligtig_indkomst && vurdering.er_kapitalindkomst == Falskt
| par3_fradragstype_nævnt_i_stk2(fradrag: PersonligFradrag) -> Sandt
| par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Falskt
| exception par3_stk2_nr1_undtager_par4_nr1 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr1RenterOgLl6
| exception par3_stk2_nr1_undtager_par4_nr2 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr2Kursgevinst
| exception par3_stk2_nr1_undtager_par4_nr7 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr7Provision
| exception par3_stk2_nr1_undtager_par4_nr8 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr8Rentekorrektion
| exception par3_stk2_nr1_undtager_ll9g par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Ligningslov9GUdgift
| exception par3_stk2_nr1_undtager_ll13 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Ligningslov13Udgift
| par3_stk2_nr1_udgift_fradragsberettiget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> afgrænsning == SelvstændigErhvervsindkomstUdgift && par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning) == Falskt
# Par3Stk2Nr1UdgiftSag(input: Par3Stk2Nr1UdgiftInput) {
    | positivt_beløb_kroner() -> penge_positivt_beløb(input.beløb_kroner)
    | fradragsberettiget_i_personlig_indkomst() -> par3_stk2_nr1_udgift_fradragsberettiget(input.afgrænsning)
    | fradrag_kroner() -> 0
    | exception par3_stk2_nr1_hovedregel fradrag_kroner() -> positivt_beløb_kroner() under fradragsberettiget_i_personlig_indkomst()
    | afskåret_til_anden_regel_kroner() -> positivt_beløb_kroner() - fradrag_kroner()
    | resultat() -> Par3Stk2Nr1UdgiftResultat(
        fradragsberettiget_i_personlig_indkomst = fradragsberettiget_i_personlig_indkomst(),
        fradrag_kroner = fradrag_kroner(),
        afskåret_til_anden_regel_kroner = afskåret_til_anden_regel_kroner()
    )
}
| par3_stk2_nr1_udgift_sag(input: Par3Stk2Nr1UdgiftInput) -> Par3Stk2Nr1UdgiftSag(input)
| par3_stk2_nr1_udgift_resultat(input: Par3Stk2Nr1UdgiftInput) -> par3_stk2_nr1_udgift_sag(input).resultat()

| par3_stk2_nr2_hjemmel(grundlag: Par3Stk2Nr2Grundlag) -> match grundlag {
    | Par3Nr2Ll8Stk1(_) -> Par3Nr2Ligningslov8Stk1
    | Par3Nr2Ll8B(_) -> Par3Nr2Ligningslov8B
    | Par3Nr2Ll8K(_) -> Par3Nr2Ligningslov8K
    | Par3Nr2Ll8L(_) -> Par3Nr2Ligningslov8L
    | Par3Nr2Ll8N(_) -> Par3Nr2Ligningslov8N
    | Par3Nr2Ll14Stk1(_) -> Par3Nr2Ligningslov14Stk1
    | Par3Nr2Ll14F(_) -> Par3Nr2Ligningslov14F
    | Par3Nr2Ll30A(_) -> Par3Nr2Ligningslov30A
    | Par3Nr2Ksl25AStk3Til5(_) -> Par3Nr2Kildeskattelov25AStk3Til5
}
| par3_stk2_nr2_henvist_beløb_kroner(grundlag: Par3Stk2Nr2Grundlag) -> match grundlag {
    | Par3Nr2Ll8Stk1(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll8B(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll8K(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll8L(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll8N(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll14Stk1(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll14F(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ll30A(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr2Ksl25AStk3Til5(resultat) -> resultat.drivende_ægtefælles_personlige_indkomst_nedsættelse_kroner
}

# Par3Stk2Nr2PostSag(post: Par3Stk2Nr2Post) {
    | henvist_beløb_kroner() -> penge_positivt_beløb(par3_stk2_nr2_henvist_beløb_kroner(post.grundlag))
    | fradrag_i_personlig_indkomst_kroner() -> 0
    | exception nr2_henvisning_ved_selvstændig_erhvervsvirksomhed fradrag_i_personlig_indkomst_kroner() -> henvist_beløb_kroner() under post.ved_selvstændig_erhvervsvirksomhed
    | afskåret_fordi_ikke_ved_selvstændig_erhvervsvirksomhed_kroner() -> henvist_beløb_kroner() - fradrag_i_personlig_indkomst_kroner()
    | resultat() -> Par3Stk2Nr2PostResultat(
        hjemmel = par3_stk2_nr2_hjemmel(post.grundlag),
        ved_selvstændig_erhvervsvirksomhed = post.ved_selvstændig_erhvervsvirksomhed,
        fradrag_eller_overført_indkomst_efter_henvisningen_kroner = henvist_beløb_kroner(),
        fradrag_i_personlig_indkomst_kroner = fradrag_i_personlig_indkomst_kroner(),
        afskåret_fordi_ikke_ved_selvstændig_erhvervsvirksomhed_kroner = afskåret_fordi_ikke_ved_selvstændig_erhvervsvirksomhed_kroner()
    )
}

| par3_stk2_nr2_post_sag(post: Par3Stk2Nr2Post) -> Par3Stk2Nr2PostSag(post)
| par3_stk2_nr2_post_resultat(post: Par3Stk2Nr2Post) -> par3_stk2_nr2_post_sag(post).resultat()
| par3_stk2_nr2_post_resultater(input: Par3Stk2Nr2Input) -> map(input.poster, |post: Par3Stk2Nr2Post| par3_stk2_nr2_post_resultat(post))
| par3_stk2_nr2_sum_henvist_beløb_kroner(resultater: List(Par3Stk2Nr2PostResultat)) -> foldl(resultater, 0, |sum, resultat| sum + resultat.fradrag_eller_overført_indkomst_efter_henvisningen_kroner)
| par3_stk2_nr2_sum_personligt_fradrag_kroner(resultater: List(Par3Stk2Nr2PostResultat)) -> foldl(resultater, 0, |sum, resultat| sum + resultat.fradrag_i_personlig_indkomst_kroner)
| par3_stk2_nr2_sum_afskåret_kroner(resultater: List(Par3Stk2Nr2PostResultat)) -> foldl(resultater, 0, |sum, resultat| sum + resultat.afskåret_fordi_ikke_ved_selvstændig_erhvervsvirksomhed_kroner)

# Par3Stk2Nr2Sag(input: Par3Stk2Nr2Input) {
    | post_resultater() -> par3_stk2_nr2_post_resultater(input)
    | resultat() -> Par3Stk2Nr2Resultat(
        post_resultater = post_resultater(),
        fradrag_eller_overført_indkomst_efter_henvisningerne_kroner = par3_stk2_nr2_sum_henvist_beløb_kroner(post_resultater()),
        fradrag_i_personlig_indkomst_kroner = par3_stk2_nr2_sum_personligt_fradrag_kroner(post_resultater()),
        afskåret_fordi_ikke_ved_selvstændig_erhvervsvirksomhed_kroner = par3_stk2_nr2_sum_afskåret_kroner(post_resultater())
    )
}

| par3_stk2_nr2_sag(input: Par3Stk2Nr2Input) -> Par3Stk2Nr2Sag(input)
| par3_stk2_nr2_resultat(input: Par3Stk2Nr2Input) -> par3_stk2_nr2_sag(input).resultat()

| par3_stk2_nr3_hjemmel(grundlag: Par3Stk2Nr3Grundlag) -> match grundlag {
    | Par3Nr3Pbl18(_) -> Par3Nr3Pensionsbeskatningslov18
    | Par3Nr3Pbl18År(_) -> Par3Nr3Pensionsbeskatningslov18
    | Par3Nr3Pbl52(_) -> Par3Nr3Pensionsbeskatningslov52
}
| par3_stk2_nr3_brutto_fradrag_kroner(grundlag: Par3Stk2Nr3Grundlag) -> match grundlag {
    | Par3Nr3Pbl18(resultat) -> resultat.fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr3Pbl18År(resultat) -> resultat.samlet_fradrag_i_skattepligtig_indkomst_kroner
    | Par3Nr3Pbl52(resultat) -> resultat.arbejdsgiverfradrag_i_skattepligtig_indkomst_kroner
}
| par3_stk2_nr3_par15a_ordning(grundlag: Par3Stk2Nr3Grundlag) -> match grundlag {
    | Par3Nr3Pbl18(resultat) -> resultat.ordning == Pbl18Par15ALøbendeUdbetaling || resultat.ordning == Pbl18Par15ARateordning
    | Par3Nr3Pbl18År(resultat) -> resultat.par15a_fradrag_kroner > 0
    | Par3Nr3Pbl52(_) -> Falskt
}
| par3_stk2_nr3_par15a_fradrag_kroner(grundlag: Par3Stk2Nr3Grundlag) -> match grundlag {
    | Par3Nr3Pbl18(resultat) -> hvis resultat.ordning == Pbl18Par15ALøbendeUdbetaling || resultat.ordning == Pbl18Par15ARateordning { resultat.fradrag_i_skattepligtig_indkomst_kroner } ellers { 0 }
    | Par3Nr3Pbl18År(resultat) -> resultat.par15a_fradrag_kroner
    | Par3Nr3Pbl52(_) -> 0
}
| par3_stk2_nr3_fradrag_i_aktieindkomst_kroner(input: Par3Stk2Nr3Input) -> 0
| exception par4a_stk4_par15a_fradrag par3_stk2_nr3_fradrag_i_aktieindkomst_kroner(input: Par3Stk2Nr3Input) -> penge_positivt_beløb(input.aktiepensionsfradrag_resultat.fradrag_i_aktieindkomst_kroner) under par3_stk2_nr3_par15a_ordning(input.grundlag)
| par3_stk2_nr3_dobbeltfradrag_afskåret_kroner(input: Par3Stk2Nr3Input) -> penge_mindste_beløb(penge_positivt_beløb(par3_stk2_nr3_par15a_fradrag_kroner(input.grundlag)), par3_stk2_nr3_fradrag_i_aktieindkomst_kroner(input))
| par3_stk2_nr3_fradrag_i_personlig_indkomst_kroner(input: Par3Stk2Nr3Input) -> penge_positivt_beløb(par3_stk2_nr3_brutto_fradrag_kroner(input.grundlag) - par3_stk2_nr3_dobbeltfradrag_afskåret_kroner(input))
# Par3Stk2Nr3Sag(input: Par3Stk2Nr3Input) {
    | brutto_fradrag_kroner() -> par3_stk2_nr3_brutto_fradrag_kroner(input.grundlag)
    | dobbeltfradrag_afskåret_kroner() -> par3_stk2_nr3_dobbeltfradrag_afskåret_kroner(input)
    | resultat() -> Par3Stk2Nr3Resultat(
        hjemmel = par3_stk2_nr3_hjemmel(input.grundlag),
        brutto_fradrag_efter_pensionsbeskatningsloven_kroner = brutto_fradrag_kroner(),
        fradrag_i_aktieindkomst_kroner = par3_stk2_nr3_fradrag_i_aktieindkomst_kroner(input),
        dobbeltfradrag_afskåret_kroner = dobbeltfradrag_afskåret_kroner(),
        fradrag_i_personlig_indkomst_kroner = par3_stk2_nr3_fradrag_i_personlig_indkomst_kroner(input)
    )
}
| par3_stk2_nr3_sag(input: Par3Stk2Nr3Input) -> Par3Stk2Nr3Sag(input)
| par3_stk2_nr3_resultat(input: Par3Stk2Nr3Input) -> par3_stk2_nr3_sag(input).resultat()
| par3_stk2_nr3_resultat_fra_pbl18_år(resultat: Pbl18Årsresultat, aktiepensionsfradrag_resultat: AktiePensionsFradragResultat) -> par3_stk2_nr3_resultat(Par3Stk2Nr3Input(
    grundlag = Par3Nr3Pbl18År(resultat = resultat),
    aktiepensionsfradrag_resultat = aktiepensionsfradrag_resultat
))

