    | afskårede_provisioner_mv_kroner() -> input.ligningslov8_stk3_resultat.afskåret_kroner
    | kapitalindkomst_kroner() -> 0 - fradragsberettigede_provisioner_mv_kroner()
    | resultat() -> Par4Stk1Nr7Resultat(
