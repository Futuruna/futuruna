| par3_stk2_nr6_delegerer_ligningslov8m: par3_stk2_nr6_fixture -> par3_stk2_nr6_fixture.arbejdsmarkedsbidrag_fradrag_kroner == 40000 && par3_stk2_nr6_fixture.udenlandsk_socialt_bidrag_fradrag_kroner == 8000 && par3_stk2_nr6_fixture.udenlandsk_arbejdsgiverbidrag_fradrag_kroner == 0 && par3_stk2_nr6_fixture.fradrag_i_personlig_indkomst_kroner == 48000
| par3_stk2_nr3_råt_beløb_afskæres: par3_stk2_nr3_råt_beløb_afskåret -> par3_stk2_nr3_råt_beløb_afskåret == 0
