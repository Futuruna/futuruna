@ sprog da

@ importer ./pengebeloeb
@ importer ./ligningsloven_fradrag
@ importer ./ligningsloven_kapitalindkomst
@ importer ./ligningsloven_cfc
@ importer ./selskabsskatteloven
@ importer ./kursgevinstloven
@ importer ./aktieavancebeskatningsloven
@ importer ./virksomhedsskatteloven
@ importer ./skattekontrolloven
@ importer ./afskrivningsloven
@ importer ./pensionsbeskatningsloven
@ importer ./ejendomsavancebeskatningsloven
@ importer ./ejendomsskatteloven

-- Personskatteloven — indkomsttaxonomi (§§ 1-4 b).
--
-- Kilde: Retsinformation, LBK nr. 1284 af 14/06/2021.
-- Officiel tekst: https://www.retsinformation.dk/eli/lta/2021/1284
-- XML: https://www.retsinformation.dk/eli/lta/2021/1284/dan/xml
--
-- Ændringskilder for § 4, stk. 1, nr. 6:
-- LOV nr. 679 af 03/06/2023:
-- https://www.retsinformation.dk/eli/lta/2023/679
-- LOV nr. 615 af 30/06/2026:
-- https://www.retsinformation.dk/eli/lta/2026/615

----
§ 1. For personer, der er skattepligtige her til landet, opgøres den
skattepligtige almindelige indkomst efter skattelovgivningens almindelige
regler med de ændringer, der følger af denne lov.
----

| almindelig_skattepligtig_indkomst_følger_almindelige_regler() -> Sandt
| personskatteloven_ændrer_almindelige_regler() -> Sandt

----
§ 2. Foruden den skattepligtige almindelige indkomst opgøres personlig
indkomst, kapitalindkomst, aktieindkomst og CFC-indkomst.
----

# Indkomstkategori = AlmindeligSkattepligtigIndkomst | PersonligIndkomst | Kapitalindkomst | Aktieindkomst | CfcIndkomst
# Par1AlmindeligSkattepligtigIndkomstInput(personlig_indkomst_kroner: Heltal, kapitalindkomst_kroner: Heltal, aktieindkomst_kroner: Heltal, cfc_indkomst_kroner: Heltal, ligningsmæssige_fradrag_kroner: Heltal, aktieindkomst_indgår_i_skattepligtig_indkomst: Boolsk, cfc_indgår_i_skattepligtig_indkomst_ved_par6_til_8a: Boolsk)
# Par1AlmindeligSkattepligtigIndkomstResultat(personlig_indkomst_til_skattepligtig_indkomst_kroner: Heltal, kapitalindkomst_til_skattepligtig_indkomst_kroner: Heltal, aktieindkomst_medregnet_kroner: Heltal, aktieindkomst_udenfor_skattepligtig_indkomst_kroner: Heltal, cfc_indkomst_medregnet_ved_par6_til_8a_kroner: Heltal, cfc_indkomst_udenfor_par6_til_8a_kroner: Heltal, indkomst_før_ligningsmæssige_fradrag_kroner: Heltal, ligningsmæssige_fradrag_kroner: Heltal, skattepligtig_indkomst_kroner: Heltal)

| opgøres_særskilt(kategori: Indkomstkategori) -> Falskt
| exception personlig_indkomst opgøres_særskilt(kategori: Indkomstkategori) -> Sandt under kategori == PersonligIndkomst
| exception kapitalindkomst opgøres_særskilt(kategori: Indkomstkategori) -> Sandt under kategori == Kapitalindkomst
| exception aktieindkomst opgøres_særskilt(kategori: Indkomstkategori) -> Sandt under kategori == Aktieindkomst
| exception cfc_indkomst opgøres_særskilt(kategori: Indkomstkategori) -> Sandt under kategori == CfcIndkomst

# Par1AlmindeligSkattepligtigIndkomstSag(input: Par1AlmindeligSkattepligtigIndkomstInput) {
    | personlig_indkomst_til_skattepligtig_indkomst_kroner() -> input.personlig_indkomst_kroner
    | kapitalindkomst_til_skattepligtig_indkomst_kroner() -> input.kapitalindkomst_kroner
    | aktieindkomst_medregnet_kroner() -> 0
    | exception par4a_aktieindkomst_medregnes_hvis_loven_siger_det aktieindkomst_medregnet_kroner() -> input.aktieindkomst_kroner under input.aktieindkomst_indgår_i_skattepligtig_indkomst
    | aktieindkomst_udenfor_skattepligtig_indkomst_kroner() -> input.aktieindkomst_kroner - aktieindkomst_medregnet_kroner()
    | cfc_indkomst_medregnet_ved_par6_til_8a_kroner() -> 0
    | exception par4b_cfc_medregnes_hvis_loven_siger_det cfc_indkomst_medregnet_ved_par6_til_8a_kroner() -> input.cfc_indkomst_kroner under input.cfc_indgår_i_skattepligtig_indkomst_ved_par6_til_8a
    | cfc_indkomst_udenfor_par6_til_8a_kroner() -> input.cfc_indkomst_kroner - cfc_indkomst_medregnet_ved_par6_til_8a_kroner()
    | indkomst_før_ligningsmæssige_fradrag_kroner() -> personlig_indkomst_til_skattepligtig_indkomst_kroner() + kapitalindkomst_til_skattepligtig_indkomst_kroner() + aktieindkomst_medregnet_kroner() + cfc_indkomst_medregnet_ved_par6_til_8a_kroner()
    | ligningsmæssige_fradrag_kroner() -> penge_positivt_beløb(input.ligningsmæssige_fradrag_kroner)
    | skattepligtig_indkomst_kroner() -> indkomst_før_ligningsmæssige_fradrag_kroner() - ligningsmæssige_fradrag_kroner()
    | resultat() -> Par1AlmindeligSkattepligtigIndkomstResultat(
        personlig_indkomst_til_skattepligtig_indkomst_kroner = personlig_indkomst_til_skattepligtig_indkomst_kroner(),
        kapitalindkomst_til_skattepligtig_indkomst_kroner = kapitalindkomst_til_skattepligtig_indkomst_kroner(),
        aktieindkomst_medregnet_kroner = aktieindkomst_medregnet_kroner(),
        aktieindkomst_udenfor_skattepligtig_indkomst_kroner = aktieindkomst_udenfor_skattepligtig_indkomst_kroner(),
        cfc_indkomst_medregnet_ved_par6_til_8a_kroner = cfc_indkomst_medregnet_ved_par6_til_8a_kroner(),
        cfc_indkomst_udenfor_par6_til_8a_kroner = cfc_indkomst_udenfor_par6_til_8a_kroner(),
        indkomst_før_ligningsmæssige_fradrag_kroner = indkomst_før_ligningsmæssige_fradrag_kroner(),
        ligningsmæssige_fradrag_kroner = ligningsmæssige_fradrag_kroner(),
        skattepligtig_indkomst_kroner = skattepligtig_indkomst_kroner()
    )
}
| par1_almindelig_skattepligtig_indkomst_sag(input: Par1AlmindeligSkattepligtigIndkomstInput) -> Par1AlmindeligSkattepligtigIndkomstSag(input)
| par1_almindelig_skattepligtig_indkomst_resultat(input: Par1AlmindeligSkattepligtigIndkomstInput) -> par1_almindelig_skattepligtig_indkomst_sag(input).resultat()

= par2_personlig = opgøres_særskilt(PersonligIndkomst)
= par2_kapital = opgøres_særskilt(Kapitalindkomst)
= par2_aktie = opgøres_særskilt(Aktieindkomst)
= par2_cfc = opgøres_særskilt(CfcIndkomst)
= par2_almindelig = opgøres_særskilt(AlmindeligSkattepligtigIndkomst)

| par2_personlig_særskilt: par2_personlig -> par2_personlig == Sandt
| par2_kapital_særskilt: par2_kapital -> par2_kapital == Sandt
| par2_aktie_særskilt: par2_aktie -> par2_aktie == Sandt
| par2_cfc_særskilt: par2_cfc -> par2_cfc == Sandt
| par2_almindelig_er_basis: par2_almindelig -> par2_almindelig == Falskt

----
§ 3. Personlig indkomst omfatter alle de indkomster, der indgår i den
skattepligtige indkomst, og som ikke er kapitalindkomst.

Stk. 2. Ved opgørelsen af den personlige indkomst fradrages
1) udgifter, som i årets løb er anvendt til at erhverve, sikre og vedligeholde
indkomst ved selvstændig erhvervsvirksomhed, dog med undtagelse af de i § 4,
stk. 1, nr. 1, 2, 7 og 8, og ligningslovens §§ 9 G og 13 nævnte udgifter,
2) udgifter, som nævnt i ligningslovens §§ 8, stk. 1, 8 B, 8 K, 8 L, 8 N,
14, stk. 1, 14 F og 30 A, og overført indkomst efter kildeskattelovens § 25 A,
stk. 3-5, ved selvstændig erhvervsvirksomhed,
3) bidrag og præmier til pensionsordninger mv. i samme omfang som nævnt i
pensionsbeskatningslovens §§ 18 og 52, jf. dog § 4 a, stk. 3,
4) forskelsbeløb og nedskrivning på husdyrbesætninger efter lov om den
skattemæssige behandling af husdyrbesætninger §§ 2 og 8,
5) nedskrivning af varelager efter varelagerlovens § 1, stk. 4,
6) arbejdsmarkedsbidrag og obligatoriske udenlandske sociale bidrag i samme
omfang som nævnt i ligningslovens § 8 M,
7) henlæggelser efter § 22 b og § 22 d i virksomhedsskatteloven,
8) udgifter, der er fradragsberettigede efter ligningslovens § 9 B,
9) tilbagebetalt skattepligtig kontanthjælp i samme omfang som nævnt i
ligningslovens § 8 O,
10) skattemæssige afskrivninger, tab og fradrag efter afskrivningsloven og
statsskatteloven for selvstændige erhvervsdrivende og
11) indskud på iværksætterkonto efter lov om indskud på etableringskonto og
iværksætterkonto
----

# IndkomstVurdering(indgår_i_skattepligtig_indkomst: Boolsk, er_kapitalindkomst: Boolsk)
# PersonligFradrag = ErhverveSikreVedligeholdeSelvstændigIndkomst | LigningslovsudgiftVedSelvstændigErhverv | PensionsbidragOgPræmier | HusdyrbesætningForskelsbeløb | VarelagerNedskrivning | Arbejdsmarkedsbidrag | VirksomhedsskatteHenlæggelse | Ligningslov9BUdgift | TilbagebetaltKontanthjælp | AfskrivningerTabFradragSelvstændige | IværksætterkontoIndskud
# Par3Stk2Nr1Udgiftsafgrænsning = IkkeStk2Nr1Udgift | SelvstændigErhvervsindkomstUdgift | Par4Stk1Nr1RenterOgLl6 | Par4Stk1Nr2Kursgevinst | Par4Stk1Nr7Provision | Par4Stk1Nr8Rentekorrektion | Ligningslov9GUdgift | Ligningslov13Udgift
# Par3Indkomstpost(indgår_i_skattepligtig_indkomst: Boolsk, er_kapitalindkomst: Boolsk, beløb_kroner: Heltal)
# Par3Fradragspost(art: PersonligFradrag, stk2_nr1_afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning, beløb_kroner: Heltal)
# Par3PersonligIndkomstInput(indkomstposter: List(Par3Indkomstpost), fradragsposter: List(Par3Fradragspost))
# Par3PersonligIndkomstResultat(brutto_personlig_indkomst_kroner: Heltal, fradrag_i_personlig_indkomst_kroner: Heltal, netto_personlig_indkomst_kroner: Heltal)
# Par3Stk2Nr1UdgiftInput(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning, beløb_kroner: Heltal)
# Par3Stk2Nr1UdgiftResultat(fradragsberettiget_i_personlig_indkomst: Boolsk, fradrag_kroner: Heltal, afskåret_til_anden_regel_kroner: Heltal)

| er_personlig_indkomst(vurdering: IndkomstVurdering) -> vurdering.indgår_i_skattepligtig_indkomst && vurdering.er_kapitalindkomst == Falskt
| par3_fradragstype_nævnt_i_stk2(fradrag: PersonligFradrag) -> Sandt
| par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Falskt
| exception par3_stk2_nr1_undtager_par4_nr1 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr1RenterOgLl6
| exception par3_stk2_nr1_undtager_par4_nr2 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr2Kursgevinst
| exception par3_stk2_nr1_undtager_par4_nr7 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr7Provision
| exception par3_stk2_nr1_undtager_par4_nr8 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Par4Stk1Nr8Rentekorrektion
| exception par3_stk2_nr1_undtager_ll9g par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Ligningslov9GUdgift
| exception par3_stk2_nr1_undtager_ll13 par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> Sandt under afgrænsning == Ligningslov13Udgift
| par3_stk2_nr1_udgift_fradragsberettiget(afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning) -> afgrænsning == SelvstændigErhvervsindkomstUdgift && par3_stk2_nr1_afgrænsning_er_undtaget(afgrænsning) == Falskt
# Par3Stk2Nr1UdgiftSag(input: Par3Stk2Nr1UdgiftInput) {
    | positivt_beløb_kroner() -> penge_positivt_beløb(input.beløb_kroner)
    | fradragsberettiget_i_personlig_indkomst() -> par3_stk2_nr1_udgift_fradragsberettiget(input.afgrænsning)
    | fradrag_kroner() -> 0
    | exception par3_stk2_nr1_hovedregel fradrag_kroner() -> positivt_beløb_kroner() under fradragsberettiget_i_personlig_indkomst()
    | afskåret_til_anden_regel_kroner() -> positivt_beløb_kroner() - fradrag_kroner()
    | resultat() -> Par3Stk2Nr1UdgiftResultat(
        fradragsberettiget_i_personlig_indkomst = fradragsberettiget_i_personlig_indkomst(),
        fradrag_kroner = fradrag_kroner(),
        afskåret_til_anden_regel_kroner = afskåret_til_anden_regel_kroner()
    )
}
| par3_stk2_nr1_udgift_sag(input: Par3Stk2Nr1UdgiftInput) -> Par3Stk2Nr1UdgiftSag(input)
| par3_stk2_nr1_udgift_resultat(input: Par3Stk2Nr1UdgiftInput) -> par3_stk2_nr1_udgift_sag(input).resultat()
| par3_indkomstpost_er_personlig_indkomst(post: Par3Indkomstpost) -> er_personlig_indkomst(IndkomstVurdering(
    indgår_i_skattepligtig_indkomst = post.indgår_i_skattepligtig_indkomst,
    er_kapitalindkomst = post.er_kapitalindkomst
))
| par3_indkomstpost_personlig_kroner(post: Par3Indkomstpost) -> 0
| exception par3_indkomstpost_medregnes par3_indkomstpost_personlig_kroner(post: Par3Indkomstpost) -> post.beløb_kroner under par3_indkomstpost_er_personlig_indkomst(post)
| par3_fradragspost_kroner(post: Par3Fradragspost) -> 0
| exception par3_stk2_nr1_fradrag par3_fradragspost_kroner(post: Par3Fradragspost) -> par3_stk2_nr1_udgift_sag(Par3Stk2Nr1UdgiftInput(
    afgrænsning = post.stk2_nr1_afgrænsning,
    beløb_kroner = post.beløb_kroner
)).fradrag_kroner() under post.art == ErhverveSikreVedligeholdeSelvstændigIndkomst
| exception par3_stk2_nr2_til_11_fradrag par3_fradragspost_kroner(post: Par3Fradragspost) -> penge_positivt_beløb(post.beløb_kroner) under post.art != ErhverveSikreVedligeholdeSelvstændigIndkomst && par3_fradragstype_nævnt_i_stk2(post.art)
| par3_brutto_personlig_indkomst_kroner(input: Par3PersonligIndkomstInput) -> foldl(input.indkomstposter, 0, |sum, post| sum + par3_indkomstpost_personlig_kroner(post))
| par3_fradrag_i_personlig_indkomst_kroner(input: Par3PersonligIndkomstInput) -> foldl(input.fradragsposter, 0, |sum, post| sum + par3_fradragspost_kroner(post))
| par3_netto_personlig_indkomst_kroner(input: Par3PersonligIndkomstInput) -> par3_brutto_personlig_indkomst_kroner(input) - par3_fradrag_i_personlig_indkomst_kroner(input)
| par3_personlig_indkomst_resultat(input: Par3PersonligIndkomstInput) -> Par3PersonligIndkomstResultat(
    brutto_personlig_indkomst_kroner = par3_brutto_personlig_indkomst_kroner(input),
    fradrag_i_personlig_indkomst_kroner = par3_fradrag_i_personlig_indkomst_kroner(input),
    netto_personlig_indkomst_kroner = par3_netto_personlig_indkomst_kroner(input)
)

= par3_personlig_default = er_personlig_indkomst(IndkomstVurdering(
    indgår_i_skattepligtig_indkomst = Sandt,
    er_kapitalindkomst = Falskt
))
= par3_kapital_udelukket = er_personlig_indkomst(IndkomstVurdering(
    indgår_i_skattepligtig_indkomst = Sandt,
    er_kapitalindkomst = Sandt
))
= par3_fradrag_am = par3_fradragstype_nævnt_i_stk2(Arbejdsmarkedsbidrag)
= par3_fradrag_pension = par3_fradragstype_nævnt_i_stk2(PensionsbidragOgPræmier)
= par3_fradrag_erhverv = par3_fradragstype_nævnt_i_stk2(ErhverveSikreVedligeholdeSelvstændigIndkomst)
= par3_stk2_nr1_erhverv_fradrag = par3_stk2_nr1_udgift_resultat(Par3Stk2Nr1UdgiftInput(
    afgrænsning = SelvstændigErhvervsindkomstUdgift,
    beløb_kroner = 22000
))
= par3_stk2_nr1_rente_afskåret = par3_stk2_nr1_udgift_resultat(Par3Stk2Nr1UdgiftInput(
    afgrænsning = Par4Stk1Nr1RenterOgLl6,
    beløb_kroner = 6000
))
= par3_personlig_indkomst_resultat_fixture = par3_personlig_indkomst_resultat(Par3PersonligIndkomstInput(
    indkomstposter = [
        Par3Indkomstpost(indgår_i_skattepligtig_indkomst = Sandt, er_kapitalindkomst = Falskt, beløb_kroner = 600000),
        Par3Indkomstpost(indgår_i_skattepligtig_indkomst = Sandt, er_kapitalindkomst = Sandt, beløb_kroner = 20000),
        Par3Indkomstpost(indgår_i_skattepligtig_indkomst = Falskt, er_kapitalindkomst = Falskt, beløb_kroner = 10000)
    ],
    fradragsposter = [
        Par3Fradragspost(art = Arbejdsmarkedsbidrag, stk2_nr1_afgrænsning = IkkeStk2Nr1Udgift, beløb_kroner = 48000),
        Par3Fradragspost(art = PensionsbidragOgPræmier, stk2_nr1_afgrænsning = IkkeStk2Nr1Udgift, beløb_kroner = 30000),
        Par3Fradragspost(art = ErhverveSikreVedligeholdeSelvstændigIndkomst, stk2_nr1_afgrænsning = SelvstændigErhvervsindkomstUdgift, beløb_kroner = 22000),
        Par3Fradragspost(art = ErhverveSikreVedligeholdeSelvstændigIndkomst, stk2_nr1_afgrænsning = Par4Stk1Nr1RenterOgLl6, beløb_kroner = 6000)
    ]
))

| par3_personlig_hvis_ikke_kapital: par3_personlig_default -> par3_personlig_default == Sandt
| par3_kapital_er_ikke_personlig_default: par3_kapital_udelukket -> par3_kapital_udelukket == Falskt
| par3_am_fradrages: par3_fradrag_am -> par3_fradrag_am == Sandt
| par3_pension_fradrages: par3_fradrag_pension -> par3_fradrag_pension == Sandt
| par3_erhverv_fradrages: par3_fradrag_erhverv -> par3_fradrag_erhverv == Sandt
| par3_stk2_nr1_erhvervsudgift_fradrages: par3_stk2_nr1_erhverv_fradrag -> par3_stk2_nr1_erhverv_fradrag.fradragsberettiget_i_personlig_indkomst == Sandt && par3_stk2_nr1_erhverv_fradrag.fradrag_kroner == 22000
| par3_stk2_nr1_par4_nr1_afskæres: par3_stk2_nr1_rente_afskåret -> par3_stk2_nr1_rente_afskåret.fradragsberettiget_i_personlig_indkomst == Falskt && par3_stk2_nr1_rente_afskåret.fradrag_kroner == 0 && par3_stk2_nr1_rente_afskåret.afskåret_til_anden_regel_kroner == 6000
| par3_personlig_indkomst_beregnes_beløb: par3_personlig_indkomst_resultat_fixture -> par3_personlig_indkomst_resultat_fixture.brutto_personlig_indkomst_kroner == 600000 && par3_personlig_indkomst_resultat_fixture.fradrag_i_personlig_indkomst_kroner == 100000 && par3_personlig_indkomst_resultat_fixture.netto_personlig_indkomst_kroner == 500000

----
§ 4. Kapitalindkomst omfatter det samlede nettobeløb af
1) renteindtægter og renteudgifter samt fradrag efter ligningslovens § 6 og § 6 A,
2) skattepligtige gevinster og fradragsberettigede tab efter kursgevinstloven,
3) beregnet kapitalafkast i selvstændig erhvervsvirksomhed efter
virksomhedsskattelovens § 7, som overføres til den skattepligtige inden
oplysningsfristen efter skattekontrollovens § 10, stk. 2, og § 11, jf. § 13,
for indkomståret, med fradrag af kapitalafkast, der er medregnet i den
personlige indkomst efter virksomhedsskattelovens § 23 a,
3 a) beregnet kapitalafkast efter virksomhedsskattelovens § 22 a, med fradrag
af kapitalafkast, der er medregnet i den personlige indkomst efter
virksomhedsskattelovens § 23 a, samt beregnet kapitalafkast efter
virksomhedsskattelovens § 22 c,
4) skattepligtigt aktieudbytte omfattet af ligningslovens § 16 A, stk. 1,
stk. 2, nr. 1-3, stk. 3, nr. 1 og 2, og stk. 4, der ikke er aktieindkomst
efter § 4 a,
5) skattepligtig gevinst og fradragsberettiget tab efter aktieavancebeskatningslovens
§§ 18, 19 C og 22, der ikke er aktieindkomst efter § 4 a,
5 a) skattepligtig gevinst og fradragsberettiget tab ved afståelse af
medlemsbeviser i foreninger m.v., der er skattepligtige efter selskabsskattelovens
§ 1, stk. 1, nr. 6, bortset fra investeringsforeninger,
5 b) beløb, der er modtaget fra et pengeinstitut, realkreditinstitut,
fondsmæglerselskab, investeringsforvaltningsselskab, en forvalter af alternative
investeringsfonde, en finansiel rådgiver eller en investeringsrådgiver, som
følge af at det pågældende pengeinstitut m.v. har modtaget gebyrer, provisioner
eller andre pengeydelser fra et investeringsinstitut, og som vedrører investering
i en aktie eller et investeringsbevis omfattet af aktieavancebeskatningslovens
§§ 19 C eller 22,
6) overskud eller underskud af en- eller tofamilieshuse mv., fritidshuse,
ejerlejligheder og lignende, som nævnt i ejendomsværdiskattelovens § 4,
nr. 1-5 og 9-11,
7) de i ligningslovens § 8, stk. 3, omhandlede provisioner mv.,
8) rentekorrektion efter virksomhedsskattelovens § 11, stk. 3,
9) indkomst ved selvstændig erhvervsvirksomhed, når antallet af ejere er større
end 10 og den skattepligtige ikke deltager i virksomhedens drift i væsentligt
omfang, samt indkomst ved selvstændig erhvervsvirksomhed efter ligningslovens
§ 8 K, stk. 2, når antallet af personlige ejere er større end 2 og den
skattepligtige ikke deltager i virksomhedens drift i væsentligt omfang,
10) indbetalinger som nævnt i ligningslovens § 14 A, stk. 1,
11) indkomst fra udlejning af afskrivningsberettigede driftsmidler og skibe
uanset antal ejere, når den skattepligtige ikke deltager i virksomhedens drift
i væsentligt omfang,
12) vederlag, der omfattes af ligningslovens § 5 C,
13) afkast efter pensionsbeskatningslovens § 53 A, stk. 3,
14) fortjeneste opgjort efter ejendomsavancebeskatningslovens regler,
15) beløb, der er skattepligtige eller fradragsberettigede efter ligningslovens
§ 12 B, stk. 4-7 eller stk. 9,
16) beløb, der er skattepligtige eller fradragsberettigede efter
afskrivningslovens § 40 C, og
17) overskud ved lejeres og andelshaveres fremleje eller udlejning omfattet af
ligningslovens § 15 Q, stk. 1 og 3.

Stk. 2. Fradragsberettigede omkostninger, der i årets løb er anvendt til at
erhverve, sikre og vedligeholde kapitalindkomst, fradrages ved opgørelsen af denne.

Stk. 3. Personer skal medregne indtægter og udgifter som nævnt i stk. 1 og 2
ved opgørelsen af den personlige indkomst, hvis de udøver næring ved køb og salg
af fordringer eller finansielle kontrakter eller driver næringsvirksomhed ved
finansiering. Endvidere medregnes i den personlige indkomst tab på fordringer,
som omfattes af kursgevinstlovens § 17.

Stk. 4. Uanset bestemmelserne i stk. 1, nr. 4 og 5, medregnes udlodninger fra
andelsforeninger som nævnt i aktieavancebeskatningslovens § 18 dog til den
personlige indkomst, medmindre udlodningen udgør en normal forrentning af en
indbetalt andelskapital.

Stk. 5. Uanset bestemmelserne i stk. 1, nr. 4 og 5, medregnes udlodninger
vedrørende aktier, som omfattes af aktieavancebeskatningslovens § 17, dog til
den personlige indkomst. Det samme gælder udlodninger, fortjenester og tab
vedrørende aktier m.v. omfattet af aktieavancebeskatningslovens § 19 C, såfremt
de ville være omfattet af aktieavancebeskatningslovens § 17, hvis de ikke var
omfattet af samme lovs § 19 C.

Stk. 6. Uanset bestemmelsen i stk. 1, nr. 5 b, medregnes beløb vedrørende en
aktie eller et investeringsbevis omfattet af aktieavancebeskatningslovens § 19 C
til den personlige indkomst, såfremt aktien m.v. ville være omfattet af
aktieavancebeskatningslovens § 17, hvis den ikke var omfattet af samme lovs § 19 C.

Stk. 7. Uanset stk. 1, nr. 4 og 5, medregnes udbetalinger og fortjenester
vedrørende andele i medarbejderinvesteringsselskaber, jf. ligningslovens § 7 N,
stk. 1, og andele i medarbejderinvesteringsselskabslignende selskaber, jf.
ligningslovens § 7 N, stk. 3, til den personlige indkomst.

Stk. 8. Skatterådet kan tillade, at reglen i stk. 1, nr. 11, ikke skal anvendes
for indkomst ved udlejning af aktiver, som er anskaffet inden den 19. maj 1993,
når det efter rådets skøn må anses som godtgjort, at udlejningen indgår i et
generationsskifte, eller særlige omstændigheder i øvrigt taler derfor.

Stk. 9. Ejere af vedvarende energi-anlæg, der anvender reglerne i ligningslovens
§ 8 P, stk. 2 og 3, medregnes ikke ved opgørelsen af antallet af ejere i stk. 1, nr. 9.
----

----
Lov nr. 679 af 03/06/2023, § 12:

I personskatteloven, jf. lovbekendtgørelse nr. 1284 af 14. juni 2021, som
ændret ved lov nr. 252 af 25. februar 2022, foretages følgende ændringer:

1. I § 4, stk. 1, nr. 6, ændres »ejendomsværdiskattelovens § 4, nr. 1-5 og
9-11« til: »ejendomsskattelovens § 3, stk. 1, nr. 1-5, 9 og 10, og stk. 2«.

Lov nr. 679 af 03/06/2023, § 45, stk. 3:

§§ 1 og 2, § 3, nr. 3, 4, 6, 8-18, 20, 21 og 29, §§ 4-8, § 9, nr. 1, 3 og 4,
§§ 10-13, § 14, nr. 1, 2 og 7, §§ 15-18 og 21-29, § 30, nr. 2 og 4, og
§§ 32-44 træder i kraft den 1. januar 2024.
----

----
Lov nr. 615 af 30/06/2026, § 12:

I personskatteloven, jf. lovbekendtgørelse nr. 1284 af 14. juni 2021, som ændret
bl.a. ved § 12 i lov nr. 679 af 3. juni 2023 og senest ved § 4 i lov nr. 1691
af 30. december 2024, foretages følgende ændring:

1. I § 4, stk. 1, nr. 6, ændres »nr. 1-5, 9 og 10« til: »nr. 1-4, 8 og 9«.

Lov nr. 615 af 30/06/2026, § 16, stk. 5:

§ 2, nr. 1-3, 5-9, 15 og 16, §§ 3-12, § 13, nr. 2, og §§ 14 og 15 har virkning
fra og med den 1. januar 2027.
----

