    beløb_kroner = par3_udlignings_indtægtsføring_resultat(resultat).personlig_indkomst_tillæg_kroner
)

| par3_indkomstpost_er_personlig_indkomst(post: Par3Indkomstpost) -> er_personlig_indkomst(IndkomstVurdering(
    indgår_i_skattepligtig_indkomst = post.indgår_i_skattepligtig_indkomst,
    er_kapitalindkomst = post.er_kapitalindkomst
))
| par3_indkomstpost_personlig_kroner(post: Par3Indkomstpost) -> 0
| exception par3_indkomstpost_medregnes par3_indkomstpost_personlig_kroner(post: Par3Indkomstpost) -> post.beløb_kroner under par3_indkomstpost_er_personlig_indkomst(post)
| par3_fradragspost_kroner(post: Par3Fradragspost) -> 0
| exception par3_stk2_nr1_fradrag par3_fradragspost_kroner(post: Par3Fradragspost) -> par3_stk2_nr1_udgift_sag(Par3Stk2Nr1UdgiftInput(
    afgrænsning = post.stk2_nr1_afgrænsning,
    beløb_kroner = post.beløb_kroner
)).fradrag_kroner() under post.art == ErhverveSikreVedligeholdeSelvstændigIndkomst
| par3_stk2_nr1_sum_fradrag_kroner(udgifter: List(Par3Stk2Nr1UdgiftInput)) -> foldl(udgifter, 0, |sum, udgift| sum + par3_stk2_nr1_udgift_resultat(udgift).fradrag_kroner)
# Par3PersonligIndkomstSag(input: Par3PersonligIndkomstInput) {
    | nr2_resultat() -> par3_stk2_nr2_resultat(input.stk2_nr2_input)
    | nr3_til_11_resultat() -> par3_stk2_nr3_til_11_resultat(input.stk2_nr3_til_11_input)
    | brutto_personlig_indkomst_kroner() -> foldl(input.indkomstposter, 0, |sum, post| sum + par3_indkomstpost_personlig_kroner(post)) + nr3_til_11_resultat().indtægtsføring_i_personlig_indkomst_kroner
    | fradrag_i_personlig_indkomst_kroner() -> par3_stk2_nr1_sum_fradrag_kroner(input.stk2_nr1_udgifter) + nr2_resultat().fradrag_i_personlig_indkomst_kroner + nr3_til_11_resultat().fradrag_i_personlig_indkomst_kroner
    | netto_personlig_indkomst_kroner() -> brutto_personlig_indkomst_kroner() - fradrag_i_personlig_indkomst_kroner()
    | resultat() -> Par3PersonligIndkomstResultat(
        brutto_personlig_indkomst_kroner = brutto_personlig_indkomst_kroner(),
        fradrag_i_personlig_indkomst_kroner = fradrag_i_personlig_indkomst_kroner(),
        netto_personlig_indkomst_kroner = netto_personlig_indkomst_kroner()
    )
}
| par3_personlig_indkomst_sag(input: Par3PersonligIndkomstInput) -> Par3PersonligIndkomstSag(input)
| par3_brutto_personlig_indkomst_kroner(input: Par3PersonligIndkomstInput) -> par3_personlig_indkomst_sag(input).brutto_personlig_indkomst_kroner()
| par3_fradrag_i_personlig_indkomst_kroner(input: Par3PersonligIndkomstInput) -> par3_personlig_indkomst_sag(input).fradrag_i_personlig_indkomst_kroner()
| par3_netto_personlig_indkomst_kroner(input: Par3PersonligIndkomstInput) -> par3_personlig_indkomst_sag(input).netto_personlig_indkomst_kroner()
| par3_personlig_indkomst_resultat(input: Par3PersonligIndkomstInput) -> par3_personlig_indkomst_sag(input).resultat()

