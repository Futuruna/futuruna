# Par4Stk1Nr5aSag(input: Par4Stk1Nr5aInput) {
    | selskabsskattelov_hjemmel() -> input.selskabsskattelov1_stk1_nr6_resultat.kilde
    | skattepligtig_efter_selskabsskattelov1_stk1_nr6() -> input.selskabsskattelov1_stk1_nr6_resultat.skattepligtig_efter_par1_stk1_nr6
    | investeringsforening() -> input.selskabsskattelov1_stk1_nr6_resultat.investeringsforening
    | omfattet_af_kapitalindkomst() -> skattepligtig_efter_selskabsskattelov1_stk1_nr6() && investeringsforening() == Falskt
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr5a_medlemsbevis kapitalindkomst_kroner() -> input.beløb_kroner under omfattet_af_kapitalindkomst()
    | resultat() -> Par4Stk1Nr5aResultat(
        selskabsskattelov_hjemmel = selskabsskattelov_hjemmel(),
        skattepligtig_efter_selskabsskattelov1_stk1_nr6 = skattepligtig_efter_selskabsskattelov1_stk1_nr6(),
        investeringsforening = investeringsforening(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| par4_stk1_nr5a_sag(input: Par4Stk1Nr5aInput) -> Par4Stk1Nr5aSag(input)
| par4_stk1_nr5a_resultat(input: Par4Stk1Nr5aInput) -> par4_stk1_nr5a_sag(input).resultat()
| par4_stk1_nr5a_input_fra_selskabsskattelov1_stk1_nr6(beløb_kroner: Heltal, input: Selskabsskattelov1Stk1Nr6Input) -> Par4Stk1Nr5aInput(
    beløb_kroner = beløb_kroner,
    selskabsskattelov1_stk1_nr6_resultat = selskabsskattelov1_stk1_nr6_resultat(input)
)
| par4_stk1_nr5a_resultat_fra_selskabsskattelov1_stk1_nr6(beløb_kroner: Heltal, input: Selskabsskattelov1Stk1Nr6Input) -> par4_stk1_nr5a_resultat(par4_stk1_nr5a_input_fra_selskabsskattelov1_stk1_nr6(beløb_kroner, input))
| par4_stk1_nr5a_kapitalpost(input: Par4Stk1Nr5aInput) -> Par4Kapitalpost(
    art = Medlemsbeviser,
    beløb_kroner = par4_stk1_nr5a_sag(input).kapitalindkomst_kroner(),
    personlig_reklassifikation = IngenPersonligReklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)

| par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Falskt
| exception par4_stk1_nr5b_pengeinstitut par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bPengeinstitut
| exception par4_stk1_nr5b_realkreditinstitut par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bRealkreditinstitut
| exception par4_stk1_nr5b_fondsmægler par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bFondsmæglerselskab
| exception par4_stk1_nr5b_investeringsforvaltning par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bInvesteringsforvaltningsselskab
| exception par4_stk1_nr5b_alternativ_fond_forvalter par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bForvalterAfAlternativeInvesteringsfonde
| exception par4_stk1_nr5b_finansiel_rådgiver par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bFinansielRådgiver
| exception par4_stk1_nr5b_investeringsrådgiver par4_stk1_nr5b_formidler_nævnt(formidler: Par4Stk1Nr5bFormidler) -> Sandt under formidler == Par4Nr5bInvesteringsrådgiver
| par4_stk1_nr5b_aktiv_fra_aktieavanceklassifikation(resultat: AktieavanceAktivklassifikationResultat) -> Par4Nr5bAndet
| exception par4_stk1_nr5b_aktiv_19c par4_stk1_nr5b_aktiv_fra_aktieavanceklassifikation(resultat: AktieavanceAktivklassifikationResultat) -> Par4Nr5bAktieEllerInvesteringsbevis19C under resultat.input_gyldigt && resultat.effektiv_aktiv == AblInvesteringsselskab19C
| exception par4_stk1_nr5b_aktiv_22 par4_stk1_nr5b_aktiv_fra_aktieavanceklassifikation(resultat: AktieavanceAktivklassifikationResultat) -> Par4Nr5bInvesteringsbevis22 under resultat.input_gyldigt && resultat.effektiv_aktiv == AblMinimumsbevis22
| par4_stk1_nr5b_aktiv_omfattet(aktiv: Par4Stk1Nr5bAktiv) -> Falskt
| exception par4_stk1_nr5b_19c_aktiv par4_stk1_nr5b_aktiv_omfattet(aktiv: Par4Stk1Nr5bAktiv) -> Sandt under aktiv == Par4Nr5bAktieEllerInvesteringsbevis19C
| exception par4_stk1_nr5b_22_bevis par4_stk1_nr5b_aktiv_omfattet(aktiv: Par4Stk1Nr5bAktiv) -> Sandt under aktiv == Par4Nr5bInvesteringsbevis22

# Par4Stk1Nr5bSag(input: Par4Stk1Nr5bInput) {
    | aktivklassifikation_resultat() -> aktieavance_aktivklassifikation_resultat(input.aktieavance_aktivklassifikation_input)
    | aktiv() -> par4_stk1_nr5b_aktiv_fra_aktieavanceklassifikation(aktivklassifikation_resultat())
    | formidler_nævnt_i_nr5b() -> par4_stk1_nr5b_formidler_nævnt(input.formidler)
    | aktiv_omfattet_af_nr5b() -> par4_stk1_nr5b_aktiv_omfattet(aktiv())
    | omfattet_af_par4_nr5b() -> formidler_nævnt_i_nr5b() && input.formidler_har_modtaget_gebyrer_provisioner_eller_pengeydelser_fra_investeringsinstitut && aktiv_omfattet_af_nr5b()
    | personlig_reklassifikation() -> IngenPersonligReklassifikation
    | exception par4_stk6_formidler_19c_hvis17_til_personlig personlig_reklassifikation() -> Investeringsformidler19CHvis17Aktier under omfattet_af_par4_nr5b() && aktiv() == Par4Nr5bAktieEllerInvesteringsbevis19C && aktivklassifikation_resultat().ville_være_omfattet_af_par17_uden_investeringsstatus
    | omfattet_af_kapitalindkomst() -> omfattet_af_par4_nr5b() && personlig_reklassifikation() == IngenPersonligReklassifikation
    | kapitalindkomst_kroner() -> 0
    | exception par4_stk1_nr5b_formidlerbeløb kapitalindkomst_kroner() -> penge_positivt_beløb(input.beløb_kroner) under omfattet_af_kapitalindkomst()
    | postbeløb_kroner() -> 0
    | exception par4_stk1_nr5b_postbeløb postbeløb_kroner() -> penge_positivt_beløb(input.beløb_kroner) under omfattet_af_par4_nr5b()
    | resultat() -> Par4Stk1Nr5bResultat(
        formidler = input.formidler,
        aktieavance_aktivklassifikation_resultat = aktivklassifikation_resultat(),
        aktiv = aktiv(),
        formidler_nævnt_i_nr5b = formidler_nævnt_i_nr5b(),
        aktiv_omfattet_af_nr5b = aktiv_omfattet_af_nr5b(),
        omfattet_af_par4_nr5b = omfattet_af_par4_nr5b(),
        omfattet_af_kapitalindkomst = omfattet_af_kapitalindkomst(),
        kapitalindkomst_kroner = kapitalindkomst_kroner(),
        personlig_reklassifikation = personlig_reklassifikation()
    )
}
| par4_stk1_nr5b_sag(input: Par4Stk1Nr5bInput) -> Par4Stk1Nr5bSag(input)
| par4_stk1_nr5b_resultat(input: Par4Stk1Nr5bInput) -> par4_stk1_nr5b_sag(input).resultat()
| par4_stk1_nr5b_kapitalpost(input: Par4Stk1Nr5bInput) -> Par4Kapitalpost(
    art = InvesteringsformidlerBeløb,
    beløb_kroner = par4_stk1_nr5b_sag(input).postbeløb_kroner(),
    personlig_reklassifikation = par4_stk1_nr5b_sag(input).personlig_reklassifikation(),
    personlig_indkomst_tillæg_kroner = 0
)

