    gift_og_samlevende_ved_indkomstårets_udgang = Falskt
)).venstre

= kgl_par32_19c_tab_uden_par19d = kgl_par32_aktieklasse_scenarie_lagerårsresultat(
    indkomstår = 2026,
    aktiv = AblPar19CInvesteringsselskabsaktiv(
        papirart = AblInvesteringsselskabsaktie,
        markedsstatus = AblOptagetTilHandelPåReguleretMarked,
        registreret_i_værdipapircentral = Sandt
    ),
    værdi_primo_kroner = 14000,
    værdi_ultimo_kroner = 10000,
    oplysningsbetingelse_efter_par19d_opfyldt = Falskt
)
= kgl_par32_19c_tab_med_par19d = kgl_par32_aktieklasse_scenarie_lagerårsresultat(
    indkomstår = 2026,
    aktiv = AblPar19CInvesteringsselskabsaktiv(
        papirart = AblInvesteringsselskabsaktie,
        markedsstatus = AblOptagetTilHandelPåReguleretMarked,
        registreret_i_værdipapircentral = Sandt
    ),
    værdi_primo_kroner = 14000,
    værdi_ultimo_kroner = 10000,
    oplysningsbetingelse_efter_par19d_opfyldt = Sandt
)
= kgl_par32_par19d_uden_oplysninger_grundlag = kgl_par32_aktiegevinstgrundlagsresultat(
    grundlag = KursgevinstPar32Aktieårsgrundlag(
        par13a_årsresultat = kgl_par32_tomt_par13a_aktieårsresultat(2026),
        supplerende_årsresultater = [
            KglPar32AblLagerÅrsresultat(resultat = kgl_par32_19b_reguleret_lager),
            KglPar32AblLagerÅrsresultat(resultat = kgl_par32_19c_tab_uden_par19d)
        ]
    ),
    indkomstår = 2026
)
= kgl_par32_par19d_med_oplysninger_grundlag = kgl_par32_aktiegevinstgrundlagsresultat(
    grundlag = KursgevinstPar32Aktieårsgrundlag(
        par13a_årsresultat = kgl_par32_tomt_par13a_aktieårsresultat(2026),
        supplerende_årsresultater = [
            KglPar32AblLagerÅrsresultat(resultat = kgl_par32_19b_reguleret_lager),
            KglPar32AblLagerÅrsresultat(resultat = kgl_par32_19c_tab_med_par19d)
        ]
    ),
    indkomstår = 2026
)

= kgl_par32_ægtefælle_venstre_par13a_resultat = kgl_par32_aktieklasse_scenarie_par13a_årsresultat(
    indkomstår = 2026,
    skatteposter = [kgl_par32_aktieklasse_scenarie_par13a_post(
        art = AblSkattepostOrdinærAktie,
        markedsstatus = AblOptagetTilHandelPåReguleretMarked,
        gevinst_kroner = 0,
        tab_kroner = 8000
    )],
    ægtefælles_positive_nettobeløb_kroner = 10000,
    gift_og_samlevende = Sandt
)
= kgl_par32_ægtefælle_højre_par13a_resultat = kgl_par32_aktieklasse_scenarie_par13a_årsresultat(
    indkomstår = 2026,
    skatteposter = [kgl_par32_aktieklasse_scenarie_par13a_post(
        art = AblSkattepostOrdinærAktie,
        markedsstatus = AblOptagetTilHandelPåReguleretMarked,
        gevinst_kroner = 10000,
        tab_kroner = 0
    )],
    ægtefælles_positive_nettobeløb_kroner = 0,
    gift_og_samlevende = Sandt
)
= kgl_par32_ægtefælle_par13a_før_kgl_resultat = kursgevinst_par32_ægtefællepar_resultat(KursgevinstPar32ÆgtefælleparInput(
    venstre = kgl_par32_aktieklasse_scenarie_person(
        identifikation = "abl-tabshaver",
        indkomstår = 2026,
        kontrakter = [kgl_par32_aktieklasse_scenarie_aktiebaseret_kontraktpost(2026, 10000)],
        aktieårsgrundlag = KursgevinstPar32Aktieårsgrundlag(
            par13a_årsresultat = kgl_par32_ægtefælle_venstre_par13a_resultat,
            supplerende_årsresultater = []
        ),
        aktiemodregningsvalg = KursgevinstPar32Aktiemodregningsvalg(
            omfang = KglPar32EgneOgÆgtefællesAktiegevinster,
            beløb = KglPar32MaksimalAktiemodregning
        )
    ),
    højre = kgl_par32_aktieklasse_scenarie_person(
        identifikation = "aktiegevinsthaver",
        indkomstår = 2026,
        kontrakter = [],
        aktieårsgrundlag = KursgevinstPar32Aktieårsgrundlag(
            par13a_årsresultat = kgl_par32_ægtefælle_højre_par13a_resultat,
            supplerende_årsresultater = []
        ),
        aktiemodregningsvalg = kgl_par32_ingen_aktiemodregning()
    ),
    gift_og_samlevende_ved_indkomstårets_udgang = Sandt
))

| kgl_par32_par20_og_par21_indgår_i_det_typede_grundlag: kgl_par32_par20_par21_grundlag -> kgl_par32_par20_resultat.input_gyldigt && kgl_par32_par21_resultat.input_gyldigt && contains(kgl_par32_par20_par21_grundlag.klasser, KglPar32Abl20Stk2AkkumulerendeInvesteringsbevis) && contains(kgl_par32_par20_par21_grundlag.klasser, KglPar32Abl21AktiebaseretMinimumsbevis) && kgl_par32_par20_par21_grundlag.aktiegevinstkapacitet_kroner == 12000
| kgl_par32_par19b_reguleret_marked_kvalificerer: kgl_par32_19b_reguleret_grundlag -> kgl_par32_aktieklasse_scenarie_har_kvalificeret_klasse(kgl_par32_19b_reguleret_grundlag, KglPar32Abl19BInvesteringsselskab) && kgl_par32_19b_reguleret_grundlag.aktiegevinstkapacitet_kroner == 9000
| kgl_par32_par19c_mtf_kvalificerer_først_fra_2024: kgl_par32_19c_mtf_2024_grundlag -> kgl_par32_19c_mtf_2023_grundlag.aktiegevinstkapacitet_kroner == 0 && kgl_par32_19c_mtf_2023_grundlag.supplerende_udeladt_ikke_kvalificeret_netto_kroner == 7000 && kgl_par32_aktieklasse_scenarie_har_kvalificeret_klasse(kgl_par32_19c_mtf_2024_grundlag, KglPar32Abl19CInvesteringsselskab) && kgl_par32_19c_mtf_2024_grundlag.aktiegevinstkapacitet_kroner == 7000
| kgl_par32_omsætteligt_investeringsbevis_anses_for_reguleret_efter_abl3: kgl_par32_19b_omsætteligt_unoteret_grundlag -> kgl_par32_aktieklasse_scenarie_har_abl3_klassifikation(kgl_par32_19b_omsætteligt_unoteret_grundlag) && kgl_par32_19b_omsætteligt_unoteret_grundlag.aktiegevinstkapacitet_kroner == 6000
| kgl_par32_unoteret_investeringsselskabsaktie_udelades: kgl_par32_19b_unoteret_aktie_grundlag -> kgl_par32_19b_unoteret_aktie_grundlag.aktiegevinstkapacitet_kroner == 0 && kgl_par32_19b_unoteret_aktie_grundlag.supplerende_udeladt_ikke_kvalificeret_netto_kroner == 6000
| kgl_par32_par22_kvalificerer_mens_par18_udelades: kgl_par32_par22_og_par18_grundlag -> kgl_par32_aktieklasse_scenarie_har_kvalificeret_klasse(kgl_par32_par22_og_par18_grundlag, KglPar32Abl22ObligationsbaseretMinimumsbevis) && contains(kgl_par32_par22_og_par18_grundlag.klasser, KglPar32AndenIkkeKvalificeretAktieklasse) && kgl_par32_par22_og_par18_grundlag.aktiegevinstkapacitet_kroner == 8000 && kgl_par32_par22_og_par18_grundlag.supplerende_udeladt_ikke_kvalificeret_netto_kroner == 7000
| kgl_par32_årets_par13a_tab_forbruges_før_kontrakttab: kgl_par32_par13a_tab_før_kontrakttab_resultat -> kgl_par32_par13a_tab_før_kontrakttab_resultat.aktiegevinstgrundlag.aktiegevinstkapacitet_kroner == 5000 && kgl_par32_par13a_tab_før_kontrakttab_resultat.tab_modregnet_i_egne_aktiegevinster_kroner == 5000 && kgl_par32_par13a_tab_før_kontrakttab_resultat.aktiebaserede_tab_fremført_til_følgende_indkomstår_kroner == 5000
| kgl_par32_par19d_afskåret_tab_reducerer_ikke_grundlaget: kgl_par32_par19d_uden_oplysninger_grundlag -> kgl_par32_19c_tab_uden_par19d.tab_afskåret_efter_par19d_kroner == 4000 && kgl_par32_par19d_uden_oplysninger_grundlag.aktiegevinstkapacitet_kroner == 9000 && kgl_par32_par19d_med_oplysninger_grundlag.aktiegevinstkapacitet_kroner == 5000
| kgl_par32_ægtefælles_par13a_tab_forbruges_før_kontrakttab: kgl_par32_ægtefælle_par13a_før_kgl_resultat -> kgl_par32_ægtefælle_venstre_par13a_resultat.tab_overført_til_ægtefælle_kroner == 8000 && kgl_par32_ægtefælle_par13a_før_kgl_resultat.højre.ægtefælles_par13a_tab_modtaget_før_kontrakttab_kroner == 8000 && kgl_par32_ægtefælle_par13a_før_kgl_resultat.højre.aktiegevinstkapacitet_efter_ægtefælles_par13a_tab_kroner == 2000 && kgl_par32_ægtefælle_par13a_før_kgl_resultat.venstre.tab_overført_til_ægtefælles_aktiegevinster_kroner == 2000 && kgl_par32_ægtefælle_par13a_før_kgl_resultat.venstre.aktiebaserede_tab_fremført_til_følgende_indkomstår_kroner == 8000 && kgl_par32_ægtefælle_par13a_før_kgl_resultat.højre.ægtefælles_kontrakttab_modtaget_i_egne_aktiegevinster_kroner == 2000

? kgl_par32_par20_og_par21_indgår_i_det_typede_grundlag
? kgl_par32_par19b_reguleret_marked_kvalificerer
? kgl_par32_par19c_mtf_kvalificerer_først_fra_2024
? kgl_par32_omsætteligt_investeringsbevis_anses_for_reguleret_efter_abl3
? kgl_par32_unoteret_investeringsselskabsaktie_udelades
? kgl_par32_par22_kvalificerer_mens_par18_udelades
? kgl_par32_årets_par13a_tab_forbruges_før_kontrakttab
? kgl_par32_par19d_afskåret_tab_reducerer_ikke_grundlaget
? kgl_par32_ægtefælles_par13a_tab_forbruges_før_kontrakttab
--@end:kursgevinstloven_par32_aktieklasser_scenarier--
