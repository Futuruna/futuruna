@ sprog da

@ importer ./metadata
@ importer ./personskat.calculate

# PersonskatÅrsopgørelseKildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)
# PersonskatÅrsopgørelseMappingAdvarsel(besked: Tekst)

= personskat_aarsopgoerelse_skat_dk_kilde = PersonskatÅrsopgørelseKildeInfo(
    url = "https://skat.dk/borger/aarsopgoerelse",
    identifier = "Skattestyrelsen: Årsopgørelse",
    hentet_dato = "2026-08-03"
)
= personskat_aarsopgoerelse_investeringskilde = PersonskatÅrsopgørelseKildeInfo(
    url = "https://skat.dk/borger/aktier-og-andre-vaerdipapirer/skat-af-investeringsbeviser-udstedt-af-investeringsforeninger-og-investeringsselskaber",
    identifier = "Skattestyrelsen: Skat af investeringsforeninger og -selskaber",
    hentet_dato = "2026-08-03"
)
= personskat_aarsopgoerelse_fagforening_akasse_kilde = PersonskatÅrsopgørelseKildeInfo(
    url = "https://skat.dk/borger/fradrag/fradrag-for-fagforening-a-kasse-efterloen-og-fleksydelse",
    identifier = "Skattestyrelsen: Fradrag for fagforening, A-kasse, efterløn og fleksydelse",
    hentet_dato = "2026-08-03"
)
= personskat_aarsopgoerelse_gavekilde = PersonskatÅrsopgørelseKildeInfo(
    url = "https://skat.dk/borger/fradrag/fradrag-for-gaver-og-bidrag-til-velgoerende-foreninger",
    identifier = "Skattestyrelsen: Fradrag for gaver og bidrag",
    hentet_dato = "2026-08-03"
)
= personskat_aarsopgoerelse_kildemapping_advarsel = PersonskatÅrsopgørelseMappingAdvarsel(
    besked = "En årsopgørelseslinje er dokumentation, ikke en rå genvej forbi de retlige klassifikationsregler."
)
= personskat_aarsopgoerelse_kildemapping_metadata = Metadata(
    attachments = (
        Guidance(value = personskat_aarsopgoerelse_skat_dk_kilde),
        Guidance(value = personskat_aarsopgoerelse_investeringskilde),
        Guidance(value = personskat_aarsopgoerelse_fagforening_akasse_kilde),
        Guidance(value = personskat_aarsopgoerelse_gavekilde),
        Warning(value = personskat_aarsopgoerelse_kildemapping_advarsel),
    )
)

--@label:personskat_aarsopgoerelse_kildemapping::meta:personskat_aarsopgoerelse_kildemapping_metadata--
----
Dokumentgrænse, ikke lovtekst:

En AI eller et menneske læser årsopgørelsen og registrerer hver relevant linje
med dokumentidentifikation, indkomstår, linjeidentifikation, original etiket og
det eksakte beløb i øre. Futuruna parser ikke dokumentet.

En linje må kun blive til et beregningsinput, når årsopgørelsen indeholder de
fakta, som det pågældende input betyder. Beregnede fradrag og overførsler er kun
kontrolresultater. Aggregerede pensions-, virksomheds-, værdipapir-, kontingent-
og gavelinjer skal suppleres med deres underliggende fakta. Årsopgørelsens
linjebeløb må ikke anvendes som et frit fradragsbeløb.
----

--@begin:personskat_aarsopgoerelse_kildemapping--
# PersonskatÅrsopgørelseKildelinje(dokument_identifikation: Tekst, indkomstår: Heltal, linje_identifikation: Tekst, linje_label: Tekst, beløb_øre: Heltal)

# PersonskatÅrsopgørelseSupplerendeKilde = EIndkomstEllerLønspecifikation | PensionsoversigtMedOrdningsvilkår | VirksomhedsregnskabOgSkatteordning | DepotOgVærdipapirtransaktioner | BidragsEllerKontingentopgørelse | ÆgtefællensEgneKildedokumenter | AfgørelseOgBetalingsopgørelse | RenteopgørelseMedEgenAndel

# PersonskatÅrsopgørelseFaktakrav = YdelsensRetligeArtOgAmStatus | LønartOgAfklaretÅrsbeløb | LøngrundlagEfterAtpOgBortseelsesberettigetPension | LønUdenDobbeltregningMedAndreIndkomstgrene | PensionsordningstypeIndbetalingskildeBetalingOgBegrænsninger | VirksomhedsindkomstAktivitetOgUnderskudshistorik | InstrumentidentitetKlassifikationOgOpgørelsesforløb | FagforeningsbetalingForeningsformålOgIndberetning | BidragsartMedlemskabUdlandsfradragOgOrdning | GavebetalingModtagergodkendelseIndberetningOgAftale | RenteNæringsstatusOgSærregler | RenteudgiftensArtEgenAndelOgÅrsbeløb | RenteudgiftensFortegnsbetydning | RenteudgifterUdenDobbeltregning | RentensØkonomiskeArtOgFortegnsbetydning | RentensEgenAndelOgAfklaredeÅrsbeløb | RenterUdenDobbeltregning | IndeholdelsensArtÅrOgPerson | IndeholdelsensÅrstotalerUdenDobbeltregning | UdbytteskattensEndelighedOgModregningsret | ÆgtefællensSamledeIndkomstOgFradragsfakta | SkattetilbagebetalingensHjemmelOgÅr | Par55HjemmelOgBruttokreditterUdenDobbeltfradrag | LønrettelsensHjemmelOgOprindeligeÅr | LønrettelsernesGrundlagOgFuldstændighed

# PersonskatÅrsopgørelseRenteudgiftsfortegn = RenteudgiftsfortegnUoplyst | RenteudgiftSomPositivtBeløb | RenteudgiftSomNegativtFradrag

-- Klassifikation af kildebeløb, ikke automatisk fortolkning af rubrik/fortegn.
# PersonskatÅrsopgørelseRenteart = RenteartUoplyst | OrdinærRenteindtægt | OrdinærRenteudgift | RenteudgiftVistSomFradrag | BetaltNegativIndlånsrente | ModtagetNegativLånerente | RenterettelseEllerBlandetRubrik

# PersonskatÅrsopgørelseIndeholdelsesart = IndeholdelsesartUoplyst | ÅretsIndeholdteASkat | ÅretsIndeholdteAm | ÅretsSamledeIndeholdteASkatOgAm | AndetSkatteEllerKreditbeløb
# PersonskatÅrsopgørelseIndeholdelsespost(kildelinje: PersonskatÅrsopgørelseKildelinje, art: PersonskatÅrsopgørelseIndeholdelsesart)

# PersonskatÅrsopgørelseMappingAnvendelse = DirekteKildebeløb(mål: ProgramReference, beløb_kroner: Heltal, resterende_faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) | DirekteKildebeløbØre(mål: ProgramReference, beløb_øre: Heltal, resterende_faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) | Kontrolresultat(mål: ProgramReference, beløb_øre: Heltal) | KræverSupplerendeKilde(kilde: PersonskatÅrsopgørelseSupplerendeKilde, faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) | ØrepræcisionKanIkkeBevares(mål: ProgramReference, beløb_øre: Heltal, resterende_faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) | UgyldigeKildelinjer

# PersonskatÅrsopgørelseMapping(kildelinjer: List(PersonskatÅrsopgørelseKildelinje), anvendelse: PersonskatÅrsopgørelseMappingAnvendelse)

# PersonskatÅrsopgørelseMappingkategori = DirekteMapping | KontrolMapping | SupplerendeKildeMapping | ØrepræcisionMapping | UgyldigMapping

| personskat_aarsopgoerelse_kildelinje_gyldig(linje: PersonskatÅrsopgørelseKildelinje) -> linje.dokument_identifikation != "" && linje.indkomstår > 0 && linje.linje_identifikation != "" && linje.linje_label != ""
| personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer: List(PersonskatÅrsopgørelseKildelinje)) -> length(kildelinjer) > 0 && all(kildelinjer, personskat_aarsopgoerelse_kildelinje_gyldig) && length(distinct(map(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.dokument_identifikation))) == 1 && length(distinct(map(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.indkomstår))) == 1 && length(distinct(map(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.linje_identifikation))) == length(kildelinjer)
| personskat_aarsopgoerelse_kildelinjer_beløb_øre(kildelinjer: List(PersonskatÅrsopgørelseKildelinje)) -> foldl(kildelinjer, 0, |sum_øre: Heltal, linje: PersonskatÅrsopgørelseKildelinje| sum_øre + linje.beløb_øre)

| personskat_aarsopgoerelse_direkte_kronemapping(kildelinjer: List(PersonskatÅrsopgørelseKildelinje), mål: ProgramReference, resterende_faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) -> {
    = beløb_øre = personskat_aarsopgoerelse_kildelinjer_beløb_øre(kildelinjer)
    hvis personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer) == Falskt {
        PersonskatÅrsopgørelseMapping(
            kildelinjer = kildelinjer,
            anvendelse = UgyldigeKildelinjer
        )
    } ellers hvis beløb_øre % 100 != 0 {
        PersonskatÅrsopgørelseMapping(
            kildelinjer = kildelinjer,
            anvendelse = ØrepræcisionKanIkkeBevares(
                mål = mål,
                beløb_øre = beløb_øre,
                resterende_faktakrav = resterende_faktakrav
            )
        )
    } ellers {
        PersonskatÅrsopgørelseMapping(
            kildelinjer = kildelinjer,
            anvendelse = DirekteKildebeløb(
                mål = mål,
                beløb_kroner = beløb_øre / 100,
                resterende_faktakrav = resterende_faktakrav
            )
        )
    }
}

| personskat_aarsopgoerelse_direkte_øremapping(kildelinjer: List(PersonskatÅrsopgørelseKildelinje), mål: ProgramReference, resterende_faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) -> hvis personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer) {
    PersonskatÅrsopgørelseMapping(
        kildelinjer = kildelinjer,
        anvendelse = DirekteKildebeløbØre(
            mål = mål,
            beløb_øre = personskat_aarsopgoerelse_kildelinjer_beløb_øre(kildelinjer),
            resterende_faktakrav = resterende_faktakrav
        )
    )
} ellers {
    PersonskatÅrsopgørelseMapping(
        kildelinjer = kildelinjer,
        anvendelse = UgyldigeKildelinjer
    )
}

| personskat_aarsopgoerelse_kontrolmapping(linje: PersonskatÅrsopgørelseKildelinje, mål: ProgramReference) -> hvis personskat_aarsopgoerelse_kildelinje_gyldig(linje) {
    PersonskatÅrsopgørelseMapping(
        kildelinjer = [linje],
        anvendelse = Kontrolresultat(
            mål = mål,
            beløb_øre = linje.beløb_øre
        )
    )
} ellers {
    PersonskatÅrsopgørelseMapping(
        kildelinjer = [linje],
        anvendelse = UgyldigeKildelinjer
    )
}

| personskat_aarsopgoerelse_supplerende_kildemapping(linje: PersonskatÅrsopgørelseKildelinje, kilde: PersonskatÅrsopgørelseSupplerendeKilde, faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) -> hvis personskat_aarsopgoerelse_kildelinje_gyldig(linje) {
    PersonskatÅrsopgørelseMapping(
        kildelinjer = [linje],
        anvendelse = KræverSupplerendeKilde(
            kilde = kilde,
            faktakrav = faktakrav
        )
    )
} ellers {
    PersonskatÅrsopgørelseMapping(
        kildelinjer = [linje],
        anvendelse = UgyldigeKildelinjer
    )
}

| personskat_aarsopgoerelse_mappingkategori(mapping: PersonskatÅrsopgørelseMapping) -> match mapping.anvendelse {
    | DirekteKildebeløb(_, _, _) -> DirekteMapping
    | DirekteKildebeløbØre(_, _, _) -> DirekteMapping
    | Kontrolresultat(_, _) -> KontrolMapping
    | KræverSupplerendeKilde(_, _) -> SupplerendeKildeMapping
    | ØrepræcisionKanIkkeBevares(_, _, _) -> ØrepræcisionMapping
    | UgyldigeKildelinjer -> UgyldigMapping
}

= personskat_aarsopgoerelse_løn_faktakrav = [LønartOgAfklaretÅrsbeløb, LøngrundlagEfterAtpOgBortseelsesberettigetPension, LønUdenDobbeltregningMedAndreIndkomstgrene]
= personskat_aarsopgoerelse_lønadvarsel = PersonskatÅrsopgørelseMappingAdvarsel(
    besked = "Et rubriknummer, felt 13 eller en lønetiket fastslår ikke, at hele beløbet er ordinær årsløn. Afklar indkomstart, år og korrigeret årsbeløb; en rettelses forskelsbeløb eller samlet personlig indkomst er ikke dette input. Løngrundlaget er før A-skat og AM, men efter egen ATP og bortseelsesberettiget arbejdsgiveradministreret pension. Træk ikke disse bidrag fra igen, og træk ikke privat pension fra lønfeltet. Samme indkomst må ikke samtidig ligge i andre indkomstgrene; bevar særskilt oplyste komponenter i deres rette grene. Den eksplicitte ordinære rute kræver kildebaseret klassifikation; DirekteMapping beviser ikke de resterende fakta. Bevar original linje, fortegn og øre uden afrunding. EIndkomstEllerLønspecifikation angiver en mulig supplerende kilde, ikke et krav om et nyt dokument, hvis fakta allerede er afklaret. Se fra-bilag-til-input.md#lønlinjer-kræver-klassifikation."
)
= personskat_aarsopgoerelse_lønmetadata = Metadata(
    attachments = (
        Guidance(value = personskat_løngrundlag_am_vejledning),
        Guidance(value = personskat_løngrundlag_eindkomst_vejledning),
        Warning(value = personskat_aarsopgoerelse_lønadvarsel),
    )
)

--@label:personskat_aarsopgoerelse_løn::meta:personskat_aarsopgoerelse_lønmetadata--
--@begin:personskat_aarsopgoerelse_løn--
| personskat_aarsopgoerelse_kortlaeg_bruttoløn(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    EIndkomstEllerLønspecifikation,
    personskat_aarsopgoerelse_løn_faktakrav
)

-- Kald kun efter afklaring af lønart, årsgrundlag og fordeling fra kildefakta.
-- År, fortegn og præcision kontrolleres, ikke dokumentets sandhed eller indhold.
| personskat_aarsopgoerelse_kortlaeg_ordinær_årsløn(linje: PersonskatÅrsopgørelseKildelinje, indkomstår: Heltal) -> hvis linje.indkomstår == indkomstår && linje.beløb_øre >= 0 {
    personskat_aarsopgoerelse_direkte_kronemapping(
        [linje],
        refof(PersonskatLønmodtagerInput::bruttoløn_kroner),
        personskat_aarsopgoerelse_løn_faktakrav
    )
} ellers {
    PersonskatÅrsopgørelseMapping(kildelinjer = [linje], anvendelse = UgyldigeKildelinjer)
}
--@end:personskat_aarsopgoerelse_løn--

= personskat_lønrettelse_årsplacering = PersonskatÅrsopgørelseKildeInfo(url = "https://info.skat.dk/data.aspx?oid=1976766", identifier = "C.A.3.1.1.3: løn modtaget med urette kontra senere indtrufne omstændigheder", hentet_dato = "2026-09-26")
= personskat_lønrettelse_periodisering = PersonskatÅrsopgørelseKildeInfo(url = "https://info.skat.dk/data.aspx?oid=2386660", identifier = "eIndkomst 14.1: negative forskelsbeløb og oprindelig lønperiode", hentet_dato = "2026-09-26")
= personskat_lønrettelse_bruttoregulering = PersonskatÅrsopgørelseKildeInfo(url = "https://info.skat.dk/data.aspx?oid=2386664", identifier = "eIndkomst 14.4: retserhvervet tilbagebetalingskrav, forskelsbeløb og indeholdt A-skat/AM", hentet_dato = "2026-09-26")
= personskat_lønrettelse_advarsel = PersonskatÅrsopgørelseMappingAdvarsel(besked = "Afstem oprindelig ordinær årsløn før rettelser med negative forskelsbeløb for løn modtaget med urette. Et korrigeret årsbeløb er kun kontrol, ikke endnu en post. Kilder skal fastslå samme person, lønomfang, oprindeligt indkomstår og retserhvervet tilbagebetalingskrav; betalingsdatoen afgør ikke året. Senere opstået tilbagebetalingspligt og andre rettelser kræver særskilt afklaring. Bevar brutto og indeholdt A-skat/AM hver for sig: ændret beregnet AM er ikke en automatisk ændring af indeholdt AM. Modellen ændrer ingen skattekreditter og opretter intet ekstra fradrag. Kildeklassifikation og fuldstændighed kan ikke bevises af beløbene. Originale linjer, fortegn og øre bevares uden afrunding. Se fra-bilag-til-input.md#rettet-løn-forskelsbeløb-er-ikke-årsløn.")
= personskat_lønrettelse_metadata = Metadata(attachments = (Guidance(value = personskat_lønrettelse_årsplacering), Guidance(value = personskat_lønrettelse_periodisering), Guidance(value = personskat_lønrettelse_bruttoregulering), Warning(value = personskat_lønrettelse_advarsel)))
= personskat_lønrettelse_faktakrav = concat(personskat_aarsopgoerelse_løn_faktakrav, [LønrettelsensHjemmelOgOprindeligeÅr, LønrettelsernesGrundlagOgFuldstændighed])

--@label:personskat_aarsopgoerelse_lønrettelser::meta:personskat_lønrettelse_metadata--
--@begin:personskat_aarsopgoerelse_lønrettelser--
# PersonskatLønrettelsesgrundlag = LønrettelsesgrundlagUoplyst | LønModtagetMedUrette(krav_kildereference: Tekst, krav_retserhvervet_dato: Dato) | SenereOpståetLøntilbagebetalingspligt | AndenLønrettelse
# PersonskatLønrettelse(identifikation: Tekst, forskelsbeløb: PersonskatÅrsopgørelseKildelinje, grundlag: PersonskatLønrettelsesgrundlag)
# PersonskatÅrslønMedRettelser(oprindelig_årsløn: PersonskatÅrsopgørelseKildelinje, rettelser: List(PersonskatLønrettelse), observeret_korrigeret_årsløn: Option(PersonskatÅrsopgørelseKildelinje), årsbeløb_er_før_alle_rettelser: Boolsk, samme_person_og_ordinære_løngrundlag: Boolsk, rettelser_fuldstændige: Boolsk)

| personskat_lønrettelse_grundlag_gyldigt(post: PersonskatLønrettelse) -> match post.grundlag {
    | LønModtagetMedUrette(kilde, dato) -> kilde != "" && dato_gyldig(dato) && post.forskelsbeløb.beløb_øre < 0
    | _ -> Sandt
}
| personskat_lønrettelse_kan_henføres_til_oprindeligt_år(post: PersonskatLønrettelse) -> match post.grundlag { | LønModtagetMedUrette(_, _) -> Sandt | _ -> Falskt }

-- De negative deltaposter reducerer det oprindelige årsbeløb én gang.
-- Kontroltotalen summeres aldrig, og ingen indeholdelsesfelter ændres.
| personskat_aarsopgoerelse_kortlaeg_rettet_årsløn(input: PersonskatÅrslønMedRettelser, indkomstår: Heltal) -> {
    = kontrol = match input.observeret_korrigeret_årsløn { | Some(linje) -> [linje] | None -> [] }
    = linjer = concat(concat([input.oprindelig_årsløn], map(input.rettelser, |post: PersonskatLønrettelse| post.forskelsbeløb)), kontrol)
    = linjeider = map(linjer, |linje: PersonskatÅrsopgørelseKildelinje| (linje.dokument_identifikation, linje.linje_identifikation))
    = rettelsesider = map(input.rettelser, |post: PersonskatLønrettelse| post.identifikation)
    = ugyldig = PersonskatÅrsopgørelseMapping(kildelinjer = linjer, anvendelse = UgyldigeKildelinjer)
    = kildegyldig = indkomstår > 0 && input.oprindelig_årsløn.beløb_øre >= 0 && all(linjer, |linje: PersonskatÅrsopgørelseKildelinje| personskat_aarsopgoerelse_kildelinje_gyldig(linje) && linje.indkomstår == indkomstår) && all(kontrol, |linje: PersonskatÅrsopgørelseKildelinje| linje.beløb_øre >= 0) && length(distinct(linjeider)) == length(linjeider) && all(rettelsesider, |id: Tekst| id != "") && length(distinct(rettelsesider)) == length(rettelsesider) && all(input.rettelser, personskat_lønrettelse_grundlag_gyldigt)
    hvis kildegyldig == Falskt {
        ugyldig
    } ellers hvis input.årsbeløb_er_før_alle_rettelser == Falskt || input.samme_person_og_ordinære_løngrundlag == Falskt || input.rettelser_fuldstændige == Falskt || all(input.rettelser, personskat_lønrettelse_kan_henføres_til_oprindeligt_år) == Falskt {
        PersonskatÅrsopgørelseMapping(kildelinjer = linjer, anvendelse = KræverSupplerendeKilde(kilde = EIndkomstEllerLønspecifikation, faktakrav = personskat_lønrettelse_faktakrav))
    } ellers {
        = beløb = foldl(input.rettelser, Some(input.oprindelig_årsløn.beløb_øre), |sum: Option(Heltal), post: PersonskatLønrettelse| match sum {
                | None -> None
                | Some(tidligere) -> hvis post.forskelsbeløb.beløb_øre >= 0 - tidligere { Some(tidligere + post.forskelsbeløb.beløb_øre) } ellers { None }
            })
        match beløb {
            | None -> ugyldig
            | Some(sum) -> hvis all(kontrol, |linje: PersonskatÅrsopgørelseKildelinje| linje.beløb_øre == sum) {
                PersonskatÅrsopgørelseMapping(kildelinjer = linjer, anvendelse = hvis sum % 100 == 0 {
                        DirekteKildebeløb(mål = refof(PersonskatLønmodtagerInput::bruttoløn_kroner), beløb_kroner = sum / 100, resterende_faktakrav = personskat_lønrettelse_faktakrav)
                    } ellers {
                        ØrepræcisionKanIkkeBevares(mål = refof(PersonskatLønmodtagerInput::bruttoløn_kroner), beløb_øre = sum, resterende_faktakrav = personskat_lønrettelse_faktakrav)
                    })
            } ellers { ugyldig }
        }
    }
}
--@end:personskat_aarsopgoerelse_lønrettelser--

= personskat_aarsopgoerelse_renteudgiftskrav = [RenteNæringsstatusOgSærregler, RenteudgiftensArtEgenAndelOgÅrsbeløb, RenteudgiftensFortegnsbetydning, RenteudgifterUdenDobbeltregning]
= personskat_aarsopgoerelse_renteudgiftsadvarsel = PersonskatÅrsopgørelseMappingAdvarsel(
    besked = "Afklar om beløbet er egen fradragsberettiget årsrente, ikke afdrag, skatteværdi, provision eller hele lånets beløb. Rubrik 44 kan indeholde andre poster. Afklar særregler, restancer og udenlandske forhold. Tæl ikke både en sum og dens underposter eller samme udgift fra flere bilag. Et minustegn kan være fradragsvisning, men også en rettelse eller modtaget negativ lånerente; brug ikke automatisk absolut værdi. Modtaget negativ lånerente i rubrik 41 eller 42 er indtægt, ikke fradragsvisning: brug personskat_aarsopgoerelse_kortlaeg_afklarede_renter med kildebekræftet art. Den afklarede udgiftsrute kræver udtrykkeligt positiv udgiftsvisning eller negativ fradragsvisning for alle linjer. Ukendt fortegn kræver afklaring; blandede fortegn og beløb uden for repræsentationsgrænsen afvises uden delsum. Hele kroner dannes kun af en eksakt øresum uden afrunding. Originale linjer og fortegn bevares, mens det afklarede udgiftsbeløb angives positivt. Ingen ægtefælleandel udledes eller fratrækkes igen. DirekteMapping beviser ikke de resterende faktakrav. RenteopgørelseMedEgenAndel er en mulig kilde, ikke krav om et ekstra bilag, hvis fakta allerede er afklaret. Se fra-bilag-til-input.md#renteudgifter-bevar-kildens-fortegn."
)
= personskat_aarsopgoerelse_renteudgiftsmetadata = Metadata(
    attachments = (
        Source(value = personskatteloven_2021_1284),
        Guidance(value = personskat_rentefakta_vejledning),
        Guidance(value = personskat_negative_renter_juridisk_vejledning),
        Guidance(value = personskat_negative_renter_rubrikvejledning),
        Warning(value = personskat_aarsopgoerelse_renteudgiftsadvarsel),
    )
)

--@label:personskat_aarsopgoerelse_renteudgifter::meta:personskat_aarsopgoerelse_renteudgiftsmetadata--
--@begin:personskat_aarsopgoerelse_renteudgifter--
| personskat_aarsopgoerelse_kortlaeg_renteudgifter(kildelinjer: List(PersonskatÅrsopgørelseKildelinje)) -> PersonskatÅrsopgørelseMapping(
    kildelinjer = kildelinjer,
    anvendelse = hvis personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer) {
        KræverSupplerendeKilde(kilde = RenteopgørelseMedEgenAndel, faktakrav = personskat_aarsopgoerelse_renteudgiftskrav)
    } ellers { UgyldigeKildelinjer }
)

-- Fortegnsvalget er kildeklassifikation, ikke en tilladelse til at netopgøre
-- rettelser eller udlede en persons andel. Oprindelige observationer bevares.
| personskat_aarsopgoerelse_kortlaeg_afklarede_renteudgifter(kildelinjer: List(PersonskatÅrsopgørelseKildelinje), indkomstår: Heltal, fortegn: PersonskatÅrsopgørelseRenteudgiftsfortegn) -> hvis fortegn == RenteudgiftsfortegnUoplyst {
    hvis all(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.indkomstår == indkomstår) {
        personskat_aarsopgoerelse_kortlaeg_renteudgifter(kildelinjer)
    } ellers {
        PersonskatÅrsopgørelseMapping(kildelinjer = kildelinjer, anvendelse = UgyldigeKildelinjer)
    }
} ellers {
    personskat_aarsopgoerelse_afklaret_rentebeløb(kildelinjer, indkomstår, fortegn == RenteudgiftSomNegativtFradrag, refof(PersonskatRenteInput::renteudgifter_kroner), personskat_aarsopgoerelse_renteudgiftskrav)
}
--@end:personskat_aarsopgoerelse_renteudgifter--

-- Fælles repræsentationskontrol efter kildeklassifikation; ingen nettoberegning.
| personskat_aarsopgoerelse_afklaret_rentebeløb(kildelinjer: List(PersonskatÅrsopgørelseKildelinje), indkomstår: Heltal, negativ_visning: Boolsk, mål: ProgramReference, faktakrav: List(PersonskatÅrsopgørelseFaktakrav)) -> {
    = ugyldig = PersonskatÅrsopgørelseMapping(kildelinjer = kildelinjer, anvendelse = UgyldigeKildelinjer)
    hvis personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer) == Falskt || all(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.indkomstår == indkomstår) == Falskt {
        ugyldig
    } ellers hvis all(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| hvis negativ_visning { linje.beløb_øre <= 0 && linje.beløb_øre >= -9223372036854775807 } ellers { linje.beløb_øre >= 0 }) == Falskt {
        ugyldig
    } ellers {
        -- Kontroller størrelsen før addition/fortegnsskift, også uden for call.
        = sum_øre = foldl(kildelinjer, Some(0), |sum: Option(Heltal), linje: PersonskatÅrsopgørelseKildelinje| {
                = beløb = hvis negativ_visning { 0 - linje.beløb_øre } ellers { linje.beløb_øre }
                match sum {
                    | None -> None
                    | Some(tidligere) -> hvis tidligere <= 9223372036854775807 - beløb { Some(tidligere + beløb) } ellers { None }
                }
            })
        match sum_øre {
            | None -> ugyldig
            | Some(beløb) -> PersonskatÅrsopgørelseMapping(
                kildelinjer = kildelinjer,
                anvendelse = hvis beløb % 100 == 0 {
                    DirekteKildebeløb(mål = mål, beløb_kroner = beløb / 100, resterende_faktakrav = faktakrav)
                } ellers {
                    ØrepræcisionKanIkkeBevares(mål = mål, beløb_øre = beløb, resterende_faktakrav = faktakrav)
                }
            )
        }
    }
}

= personskat_aarsopgoerelse_rentekrav = [RenteNæringsstatusOgSærregler, RentensØkonomiskeArtOgFortegnsbetydning, RentensEgenAndelOgAfklaredeÅrsbeløb, RenterUdenDobbeltregning]
= personskat_aarsopgoerelse_renteadvarsel = PersonskatÅrsopgørelseMappingAdvarsel(
    besked = "Rubriknummer og fortegn fastslår ikke rentens økonomiske art. Betalt negativ indlånsrente kan stå med minus i rubrik 31, men hører som positiv størrelse til renteudgifter. Modtaget negativ lånerente kan stå med minus i rubrik 41 eller 42, men hører som positiv størrelse til renteindtægter. Det er ikke det samme som negativ fradragsvisning eller en rettelse. Vælg kun art efter kildeafklaring af egen andel, årsbeløb og særregler. Ukendt art, rettelser og blandede rubriksummer kræver afklaring; split ikke et nettobeløb ved gæt. Tæl ikke en total og dens underposter eller samme rente fra flere bilag. En rubrik kan indeholde andet end almindelige renter, som kræver andre inputgrene. Originale linjer, fortegn og øre bevares; intet afrundes. DirekteMapping beviser ikke de resterende faktakrav. RenteopgørelseMedEgenAndel angiver en mulig kilde, ikke krav om et ekstra bilag. Se fra-bilag-til-input.md#renteudgifter-bevar-kildens-fortegn."
)
= personskat_aarsopgoerelse_rentemetadata = Metadata(
    attachments = (
        Source(value = personskatteloven_2021_1284),
        Guidance(value = personskat_negative_renter_juridisk_vejledning),
        Guidance(value = personskat_negative_renter_rubrikvejledning),
        Warning(value = personskat_aarsopgoerelse_renteadvarsel),
    )
)

--@label:personskat_aarsopgoerelse_renters_art::meta:personskat_aarsopgoerelse_rentemetadata--
--@begin:personskat_aarsopgoerelse_renters_art--
| personskat_aarsopgoerelse_kortlaeg_renteindtægter(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(linje, RenteopgørelseMedEgenAndel, personskat_aarsopgoerelse_rentekrav)

| personskat_aarsopgoerelse_kortlaeg_afklarede_renter(kildelinjer: List(PersonskatÅrsopgørelseKildelinje), indkomstår: Heltal, art: PersonskatÅrsopgørelseRenteart) -> hvis personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer) == Falskt || all(kildelinjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.indkomstår == indkomstår) == Falskt {
    PersonskatÅrsopgørelseMapping(kildelinjer = kildelinjer, anvendelse = UgyldigeKildelinjer)
} ellers hvis art == RenteartUoplyst || art == RenterettelseEllerBlandetRubrik {
    PersonskatÅrsopgørelseMapping(kildelinjer = kildelinjer, anvendelse = KræverSupplerendeKilde(kilde = RenteopgørelseMedEgenAndel, faktakrav = personskat_aarsopgoerelse_rentekrav))
} ellers {
    = indtægt = art == OrdinærRenteindtægt || art == ModtagetNegativLånerente
    = negativ_visning = art == RenteudgiftVistSomFradrag || art == BetaltNegativIndlånsrente || art == ModtagetNegativLånerente
    = mål = hvis indtægt { refof(PersonskatRenteInput::renteindtægter_kroner) } ellers { refof(PersonskatRenteInput::renteudgifter_kroner) }
    personskat_aarsopgoerelse_afklaret_rentebeløb(kildelinjer, indkomstår, negativ_visning, mål, personskat_aarsopgoerelse_rentekrav)
}
--@end:personskat_aarsopgoerelse_renters_art--

| personskat_aarsopgoerelse_kortlaeg_gruppeliv_og_ydelser(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    EIndkomstEllerLønspecifikation,
    [YdelsensRetligeArtOgAmStatus]
)
| personskat_aarsopgoerelse_kortlaeg_arbejdsgiverpension(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    PensionsoversigtMedOrdningsvilkår,
    [PensionsordningstypeIndbetalingskildeBetalingOgBegrænsninger]
)
| personskat_aarsopgoerelse_kortlaeg_privat_livrente(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    PensionsoversigtMedOrdningsvilkår,
    [PensionsordningstypeIndbetalingskildeBetalingOgBegrænsninger]
)
| personskat_aarsopgoerelse_kortlaeg_virksomhedsunderskud(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    VirksomhedsregnskabOgSkatteordning,
    [VirksomhedsindkomstAktivitetOgUnderskudshistorik]
)

| personskat_aarsopgoerelse_kortlaeg_investeringsudlodning(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    DepotOgVærdipapirtransaktioner,
    [InstrumentidentitetKlassifikationOgOpgørelsesforløb]
)
| personskat_aarsopgoerelse_kortlaeg_investeringsgevinst(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    DepotOgVærdipapirtransaktioner,
    [InstrumentidentitetKlassifikationOgOpgørelsesforløb]
)

| personskat_aarsopgoerelse_kortlaeg_fagforeningsfradrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    BidragsEllerKontingentopgørelse,
    [FagforeningsbetalingForeningsformålOgIndberetning]
)
| personskat_aarsopgoerelse_kortlaeg_akassefradrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    BidragsEllerKontingentopgørelse,
    [BidragsartMedlemskabUdlandsfradragOgOrdning]
)
| personskat_aarsopgoerelse_kortlaeg_gavefradrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    BidragsEllerKontingentopgørelse,
    [GavebetalingModtagergodkendelseIndberetningOgAftale]
)

= personskat_aarsopgoerelse_indeholdelsesfakta = [IndeholdelsensArtÅrOgPerson, IndeholdelsensÅrstotalerUdenDobbeltregning]
= personskat_aarsopgoerelse_indeholdelsesadvarsel = PersonskatÅrsopgørelseMappingAdvarsel(
    besked = "KSL § 60, stk. 1, litra a: brug årets indeholdte A-skat og AM, ikke beregnet skat, skattebillet, bankbetaling eller en bred subtotal for forskudsskat. Klassificér højst én årstotal af hver art for samme person, dokument og indkomstår; arbejdsgiver- og månedsrækker er ikke hver sin årstotal. En samlet A-skat/AM-post og dens komponenter afstemmes, ikke summeres oveni. Manglende AM er ikke nul; nul kræver kildegrundlag. Uafklarede linjer kræver afklaring, ikke gæt ud fra etiketten. Bevar originale linjer, fortegn og eksakte øre; negative rettelsesposter må ikke nettes eller omskrives automatisk. DirekteMapping beviser ikke personidentitet, klassifikation eller fuldstændighed. EIndkomstEllerLønspecifikation er en mulig kilde, ikke krav om et ekstra bilag, hvis årsopgørelsen dokumenterer fakta. Se personskat-skattekreditter.md."
)
= personskat_aarsopgoerelse_indeholdelsesmetadata = Metadata(attachments = (
    Source(value = kildeskatteloven_2024_460),
    Warning(value = personskat_aarsopgoerelse_indeholdelsesadvarsel),
))

--@label:personskat_aarsopgoerelse_indeholdelse::meta:personskat_aarsopgoerelse_indeholdelsesmetadata--
--@begin:personskat_aarsopgoerelse_indeholdelse--
| personskat_aarsopgoerelse_kortlaeg_a_skat_og_indeholdt_am(kildelinjer: List(PersonskatÅrsopgørelseKildelinje)) -> PersonskatÅrsopgørelseMapping(
    kildelinjer = kildelinjer,
    anvendelse = hvis personskat_aarsopgoerelse_kildelinjer_gyldige(kildelinjer) {
        KræverSupplerendeKilde(kilde = EIndkomstEllerLønspecifikation, faktakrav = personskat_aarsopgoerelse_indeholdelsesfakta)
    } ellers { UgyldigeKildelinjer }
)

-- Klassifikationen kommer fra kilden. Kontrollen afstemmer de oplyste
-- årstotaler uden at udlede en manglende komponent eller ændre originalen.
| personskat_aarsopgoerelse_kortlaeg_afklaret_indeholdelse(poster: List(PersonskatÅrsopgørelseIndeholdelsespost), indkomstår: Heltal) -> {
    = linjer = map(poster, |post: PersonskatÅrsopgørelseIndeholdelsespost| post.kildelinje)
    = ugyldig = PersonskatÅrsopgørelseMapping(kildelinjer = linjer, anvendelse = UgyldigeKildelinjer)
    = a_poster = filter(poster, |post: PersonskatÅrsopgørelseIndeholdelsespost| post.art == ÅretsIndeholdteASkat)
    = am_poster = filter(poster, |post: PersonskatÅrsopgørelseIndeholdelsespost| post.art == ÅretsIndeholdteAm)
    = total_poster = filter(poster, |post: PersonskatÅrsopgørelseIndeholdelsespost| post.art == ÅretsSamledeIndeholdteASkatOgAm)
    hvis personskat_aarsopgoerelse_kildelinjer_gyldige(linjer) == Falskt || all(linjer, |linje: PersonskatÅrsopgørelseKildelinje| linje.indkomstår == indkomstår && linje.beløb_øre >= 0) == Falskt || any(poster, |post: PersonskatÅrsopgørelseIndeholdelsespost| post.art == AndetSkatteEllerKreditbeløb) || length(a_poster) > 1 || length(am_poster) > 1 || length(total_poster) > 1 {
        ugyldig
    } ellers hvis any(poster, |post: PersonskatÅrsopgørelseIndeholdelsespost| post.art == IndeholdelsesartUoplyst) || (length(total_poster) == 0 && (length(a_poster) == 0 || length(am_poster) == 0)) {
        personskat_aarsopgoerelse_kortlaeg_a_skat_og_indeholdt_am(linjer)
    } ellers {
        -- Hver liste indeholder højst én ikke-negativ årstotal her.
        = a_øre = foldl(a_poster, 0, |sum: Heltal, post: PersonskatÅrsopgørelseIndeholdelsespost| sum + post.kildelinje.beløb_øre)
        = am_øre = foldl(am_poster, 0, |sum: Heltal, post: PersonskatÅrsopgørelseIndeholdelsespost| sum + post.kildelinje.beløb_øre)
        = total_øre = foldl(total_poster, 0, |sum: Heltal, post: PersonskatÅrsopgørelseIndeholdelsespost| sum + post.kildelinje.beløb_øre)
        hvis a_øre > 9223372036854775807 - am_øre {
            ugyldig
        } ellers {
            = komponenter_øre = a_øre + am_øre
            hvis length(total_poster) == 1 && (komponenter_øre > total_øre || (length(a_poster) == 1 && length(am_poster) == 1 && komponenter_øre != total_øre)) {
                ugyldig
            } ellers {
                PersonskatÅrsopgørelseMapping(
                    kildelinjer = linjer,
                    anvendelse = DirekteKildebeløbØre(
                        mål = refof(KildeskatPar60KreditterØre::a_skat_og_am_indeholdt_øre),
                        beløb_øre = hvis length(total_poster) == 1 { total_øre } ellers { komponenter_øre },
                        resterende_faktakrav = personskat_aarsopgoerelse_indeholdelsesfakta
                    )
                )
            }
        }
    }
}
--@end:personskat_aarsopgoerelse_indeholdelse--

| personskat_aarsopgoerelse_kortlaeg_modregningsberettiget_udbytteskat(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_direkte_øremapping(
    [linje],
    refof(KildeskatPar60KreditterØre::udbytteskat_modregningsberettiget_øre),
    [UdbytteskattensEndelighedOgModregningsret]
)
-- Dokumentklassifikation efter KSL §§ 55, 60, stk. 3, 62 og 62 A.
-- En etiket eller et fortegn fastslår ikke tilbagebetalingens hjemmel.
= personskat_aarsopgoerelse_tilbagebetalingskilde = PersonskatÅrsopgørelseKildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2024/460/pdf",
    identifier = "Kildeskatteloven, LBK nr. 460 af 3. maj 2024, §§ 55, 60, stk. 3, 62 og 62 A",
    hentet_dato = "2026-09-26"
)
= personskat_aarsopgoerelse_tilbagebetalingsadvarsel = PersonskatÅrsopgørelseMappingAdvarsel(
    besked = "Tidligere udbetalt overskydende skat efter §§ 62/62 A må ikke automatisk blive tilbagebetalt_par55_øre. Afklar afgørelse, indkomstår og betalingsopgørelse. § 55-ruten kræver dokumenteret foreløbig skat og bruttokreditter uden dobbeltfradrag; DirekteMapping beviser ikke de resterende fakta. Bevar original linje og fortegn, også ved afvisning. Se personskat-skattekreditter.md og aarsopgoerelse-afstemning.md."
)
= personskat_aarsopgoerelse_tilbagebetalingsmetadata = Metadata(
    attachments = (
        Source(value = personskat_aarsopgoerelse_tilbagebetalingskilde),
        Warning(value = personskat_aarsopgoerelse_tilbagebetalingsadvarsel),
    )
)

--@label:personskat_aarsopgoerelse_tilbagebetaling::meta:personskat_aarsopgoerelse_tilbagebetalingsmetadata--
--@begin:personskat_aarsopgoerelse_tilbagebetaling--
| personskat_aarsopgoerelse_kortlaeg_tidligere_udbetalt_overskydende_skat(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_supplerende_kildemapping(
    linje,
    AfgørelseOgBetalingsopgørelse,
    [SkattetilbagebetalingensHjemmelOgÅr]
)

-- Kald kun denne rute efter kildebaseret klassifikation som § 55-forskudsskat.
-- År og ikke-negativ størrelse kontrolleres; hjemmel og dobbeltfradrag er faktakrav.
| personskat_aarsopgoerelse_kortlaeg_tilbagebetalt_forskudsskat_par55(linje: PersonskatÅrsopgørelseKildelinje, indkomstår: Heltal) -> hvis linje.indkomstår == indkomstår && linje.beløb_øre >= 0 {
    personskat_aarsopgoerelse_direkte_øremapping(
        [linje],
        refof(KildeskatPar60KreditterØre::tilbagebetalt_par55_øre),
        [Par55HjemmelOgBruttokreditterUdenDobbeltfradrag]
    )
} ellers {
    PersonskatÅrsopgørelseMapping(kildelinjer = [linje], anvendelse = UgyldigeKildelinjer)
}
--@end:personskat_aarsopgoerelse_tilbagebetaling--

| personskat_aarsopgoerelse_kortlaeg_beregnet_arbejdsmarkedsbidrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_kontrolmapping(
    linje,
    refof(LønmodtagerBreakdown::arbejdsmarkedsbidrag_kroner)
)
| personskat_aarsopgoerelse_kortlaeg_beskæftigelsesfradrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_kontrolmapping(
    linje,
    refof(LønmodtagerBreakdown::beskæftigelsesfradrag_kroner)
)
| personskat_aarsopgoerelse_kortlaeg_jobfradrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_kontrolmapping(
    linje,
    refof(LønmodtagerBreakdown::jobfradrag_kroner)
)
| personskat_aarsopgoerelse_kortlaeg_ekstra_pensionsfradrag(linje: PersonskatÅrsopgørelseKildelinje) -> personskat_aarsopgoerelse_kontrolmapping(
    linje,
    refof(LønmodtagerBreakdown::ekstra_pensionsfradrag_kroner)
)
| personskat_aarsopgoerelse_kortlaeg_ægtefælleunderskud(linje: PersonskatÅrsopgørelseKildelinje) -> PersonskatÅrsopgørelseMapping(
    kildelinjer = [linje],
    anvendelse = hvis personskat_aarsopgoerelse_kildelinje_gyldig(linje) {
        KræverSupplerendeKilde(
            kilde = ÆgtefællensEgneKildedokumenter,
            faktakrav = [ÆgtefællensSamledeIndkomstOgFradragsfakta]
        )
    } ellers {
        UgyldigeKildelinjer
    }
)
--@end:personskat_aarsopgoerelse_kildemapping--
