        registrering = SøblDanskSkibRegistreretIDAS,
        løngrundlag = SøblOrdinærBruttoløn,
        beløb_kroner = 400000
        )], skibsårsdrifter = [], andre_ligningslov7u_indkomster = [], dødsboskattegrundlag = Søbl5IntetDødsboskattegrundlag, kulbrinteskattegrundlag = Søbl5BIntetKulbrinteskattegrundlag)
))

| personskat_das_føres_til_ordinær_am_løn: personskat_das_kanonisk_resultat -> personskat_das_kanonisk_resultat.personlig_indkomst.sømandsbeskatning.kan_anvende_par5_til8 == Falskt && personskat_das_kanonisk_resultat.personlig_indkomst.sømandsbeskatning.samlet_ordinær_bruttoløn_kroner == 400000 && personskat_das_kanonisk_resultat.skat.bruttoløn_kroner == 400000 && personskat_das_kanonisk_resultat.skat.arbejdsmarkedsbidrag_kroner == 32000 && personskat_das_kanonisk_resultat.sømandsbeskatning.samlet_lempelse_kroner == 0

? personskat_dis_kilde_føres_til_personlig_indkomst
? personskat_dis_lempelse_føres_til_slutskat
? personskat_dis_eksakt_lempelse_bevarer_ører
? personskat_dis_eksakt_lempelse_føres_til_slutskat
? personskat_dis_bevarer_progression
? personskat_dis_afskærer_ligningslov9a
? personskat_dis_afleder_par13_stk5
? personskat_dis_skatteloft_henføres_eksakt
? personskat_dis_ligningslov7u_fordeling_føres_til_skat_og_lempelse
? personskat_dis_ligningslov7u_bundfradrag_skaber_ikke_negativ_indkomst
? personskat_dis_ægtefællegren_bevarer_ører
? personskat_das_føres_til_ordinær_am_løn

@ print("Personskat: DIS-lempelse og ordinær DAS-løn er sammensat i den kanoniske slutskat")
--@end::personskat_dis_scenarier--
