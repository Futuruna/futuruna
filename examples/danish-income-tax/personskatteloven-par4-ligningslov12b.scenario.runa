| scenarie_ll12b_betalingsfrist_er(frist: Ligningslov12BHenstandBetalingsfrist, år: Heltal, måned: Heltal) -> match frist {
    | Ll12BNyBetalingsfrist(forfaldsdato, sidste_rettidige_betalingsdato) -> forfaldsdato.år == år && forfaldsdato.måned == måned && forfaldsdato.dag == 1 && sidste_rettidige_betalingsdato.år == år && sidste_rettidige_betalingsdato.måned == måned && sidste_rettidige_betalingsdato.dag == 10
