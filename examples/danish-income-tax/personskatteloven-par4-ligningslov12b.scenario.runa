@ sprog da

@ importer ./kapitel-01-indkomst

-- Scenarier for Ligningslovens § 12 B og Personskattelovens § 4, stk. 1,
-- nr. 15. Lovtekst og generelle regler står i
-- ligningsloven_kapitalindkomst.runa.

= scenarie_ll12b_oplysninger = Ligningslov12BOplysninger(
    kapitalisering_foretaget_rettidigt = Sandt,
    aktiver_og_fordeling_fremgår_af_aftalen = Sandt,
    aftale_meddelt_rettidigt = Sandt,
    saldo_oplyst_rettidigt = Sandt
)
= scenarie_ll12b_parter = Ligningslov12BParter(
    mindst_en_part_skattepligtig_ved_aftalen = Sandt,
    anden_part_senere_fuldt_skattepligtig = Falskt,
    ydelser_betalt_før_skattepligtsindtræden_kroner = 0,
    yder_betaler_til_selvejende_institution_med_stifterindflydelse = Falskt
)
= scenarie_ll12b_parter_selvejende_institution = Ligningslov12BParter(
    mindst_en_part_skattepligtig_ved_aftalen = Sandt,
    anden_part_senere_fuldt_skattepligtig = Falskt,
    ydelser_betalt_før_skattepligtsindtræden_kroner = 0,
    yder_betaler_til_selvejende_institution_med_stifterindflydelse = Sandt
)
= scenarie_ll12b_parter_senere_skattepligt = Ligningslov12BParter(
    mindst_en_part_skattepligtig_ved_aftalen = Falskt,
    anden_part_senere_fuldt_skattepligtig = Sandt,
    ydelser_betalt_før_skattepligtsindtræden_kroner = 30000,
    yder_betaler_til_selvejende_institution_med_stifterindflydelse = Falskt
)
= scenarie_ll12b_årsfordeling_ingen = Ligningslov12BÅrsfordeling(
    modtager_ikke_skattepligtig_aktivandel_kroner = 0,
    yder_fradrag_helt_afskåret_kroner = 0,
    yder_anskaffelsessum_forhøjes_i_stedet_kroner = 0,
    overtager_nærtstående_fradrag_afskåret_kroner = 0
)
= scenarie_ll12b_ophørsfordeling_ingen = Ligningslov12BOphørsfordeling(
    modtager_ikke_skattepligtig_aktivandel_kroner = 0,
    yder_ophør_ikke_medregnes_kroner = 0,
    yder_ophør_nedsætter_anskaffelsessum_kroner = 0
)

| scenarie_ll12b_aftale_med_antal(
    aftaledato: Ligningslov12BDato,
    antal_overdragne_aktiver: Heltal,
    kun_aktier_abl8: Boolsk,
    kapitaliseret_værdi_kroner: Heltal,
    parter: Ligningslov12BParter
) -> Ligningslov12BAftale(
    aftaledato = aftaledato,
    gensidigt_bebyrdende = Sandt,
    antal_overdragne_aktiver = antal_overdragne_aktiver,
    løbende_ydelse_helt_eller_delvist_vederlag = Sandt,
    usikker_varighed = Sandt,
    usikker_årlig_størrelse = Falskt,
    løber_ud_over_aftaleåret = Sandt,
    anden_lov_regulerer_beskatningen = Falskt,
    kun_aktier_omfattet_af_abl8_for_begge_parter = kun_aktier_abl8,
    kapitaliseret_værdi_kroner = kapitaliseret_værdi_kroner,
    parter = parter,
    oplysninger = scenarie_ll12b_oplysninger
)
| scenarie_ll12b_aftale(aftaledato: Ligningslov12BDato, kun_aktier_abl8: Boolsk, kapitaliseret_værdi_kroner: Heltal) -> scenarie_ll12b_aftale_med_antal(
    aftaledato = aftaledato,
    antal_overdragne_aktiver = 1,
    kun_aktier_abl8 = kun_aktier_abl8,
    kapitaliseret_værdi_kroner = kapitaliseret_værdi_kroner,
    parter = scenarie_ll12b_parter
)
| scenarie_ll12b_aftale_med_parter(aftaledato: Ligningslov12BDato, kun_aktier_abl8: Boolsk, kapitaliseret_værdi_kroner: Heltal, parter: Ligningslov12BParter) -> scenarie_ll12b_aftale_med_antal(
    aftaledato = aftaledato,
    antal_overdragne_aktiver = 1,
    kun_aktier_abl8 = kun_aktier_abl8,
    kapitaliseret_værdi_kroner = kapitaliseret_værdi_kroner,
    parter = parter
)

= scenarie_ll12b_regime_før_start = ll12b_regime(Ligningslov12BDato(år = 1999, måned = 6, dag = 30))
