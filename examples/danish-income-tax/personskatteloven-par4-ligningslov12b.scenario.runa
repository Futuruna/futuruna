    position = Ligningslov12BPosition(
        saldo_primo_kroner = -1,
        henstandsgrundlag = Ll12BIntetUbetaltHenstandsgrundlag
    ),
    begivenhed = Ll12BÅrligBetaling(betalte_ydelser_kroner = 10000),
