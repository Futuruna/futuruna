    løbende_ydelser_endeligt_ophørt = Sandt,
    saldo_efter_realisering_kroner = 525000,
    anvender_virksomhedsordningen = Sandt,
    opsparet_overskud_henført_til_ubetalt_henstand_kroner = 409500
))

= scenarie_ll12b_historisk_ophør_gammel_henstand = ligningslov12b_resultat(Ligningslov12BInput(
    indkomstår = 2026,
    rolle = Ll12BModtager,
    aftale = scenarie_ll12b_aftale(
        aftaledato = Ligningslov12BDato(år = 2025, måned = 12, dag = 31),
        kun_aktier_abl8 = Falskt,
        kapitaliseret_værdi_kroner = 100000
    ),
    position = Ligningslov12BPosition(
        saldo_primo_kroner = 50000,
        henstandsgrundlag = Ll12BUbetaltAfskrivningslov40Stk7(grundlag_kroner = 3000)
    ),
    begivenhed = Ll12BYdelseOphører(betalte_ydelser_kroner = 10000),
    årsfordeling = scenarie_ll12b_årsfordeling_ingen,
    ophørsfordeling = Ligningslov12BOphørsfordeling(
        modtager_ikke_skattepligtig_aktivandel_kroner = 7000,
        yder_ophør_ikke_medregnes_kroner = 0,
        yder_ophør_nedsætter_anskaffelsessum_kroner = 0
    )
))
= scenarie_ll12b_historisk_ophør_forkert_ny_henstand = ligningslov12b_resultat(Ligningslov12BInput(
    indkomstår = 2026,
    rolle = Ll12BModtager,
    aftale = scenarie_ll12b_aftale(
        aftaledato = Ligningslov12BDato(år = 2025, måned = 12, dag = 31),
        kun_aktier_abl8 = Falskt,
        kapitaliseret_værdi_kroner = 100000
    ),
    position = Ligningslov12BPosition(
        saldo_primo_kroner = 50000,
