))

| scenarie_ll12b_regimegrænser: scenarie_ll12b_regime_henstand -> scenarie_ll12b_regime_før_start == Ll12BUdenForAnvendelsesperioden && scenarie_ll12b_regime_historisk_start == Ll12B1Juli1999Til18Marts2025 && scenarie_ll12b_regime_før_reform == Ll12B1Juli1999Til18Marts2025 && scenarie_ll12b_regime_reform == Ll12B19Marts2025Til31December2025 && scenarie_ll12b_regime_før_henstand == Ll12B19Marts2025Til31December2025 && scenarie_ll12b_regime_henstand == Ll12BFra1Januar2026
| scenarie_ll12b_modtagerafskæring_gælder_fra_19_marts_2025: scenarie_ll12b_revideret_modtager -> scenarie_ll12b_historisk_modtager.modtager_skattepligtigt_kroner == 10000 && scenarie_ll12b_revideret_modtager.modtager_skattepligtigt_kroner == 0
| scenarie_ll12b_yderafskæring_gælder_fra_19_marts_2025: scenarie_ll12b_revideret_yder -> scenarie_ll12b_historisk_yder.yder_fradrag_kroner == 10000 && scenarie_ll12b_revideret_yder.yder_fradrag_kroner == 0
| scenarie_ll12b_abl8_kræver_hverken_kapitalisering_eller_saldo: scenarie_ll12b_abl8_uden_saldo -> scenarie_ll12b_abl8_uden_saldo.kapitalisering_påkrævet == Falskt && scenarie_ll12b_abl8_uden_saldo.saldo_påkrævet == Falskt && scenarie_ll12b_abl8_uden_saldo.modtager_skattepligtigt_kroner == 0
| scenarie_ll12b_selvejende_institution_bevarer_stk2_men_afskærer_stk3_og_frem: scenarie_ll12b_selvejende_institution -> scenarie_ll12b_selvejende_institution.omfattet_af_par12b && scenarie_ll12b_selvejende_institution.kapitalisering_påkrævet && scenarie_ll12b_selvejende_institution.saldo_påkrævet == Falskt && scenarie_ll12b_selvejende_institution.modtager_skattepligtigt_kroner == 0 && scenarie_ll12b_henstand_selvejende_afskåret.betingelser_opfyldt == Falskt
| scenarie_ll12b_senere_skattepligt_reducerer_indgangsværdi: scenarie_ll12b_senere_skattepligt -> scenarie_ll12b_senere_skattepligt.saldo_påkrævet && scenarie_ll12b_senere_skattepligt.saldo_indgangsværdi_ved_skattepligtsindtræden_kroner == 70000
| scenarie_ll12b_henstand_skyggeberegning_og_forhold: scenarie_ll12b_henstand_bevilling -> scenarie_ll12b_henstand_bevilling.betingelser_opfyldt && scenarie_ll12b_henstand_bevilling.skat_beregnet_på_fortjenesten_kroner == 515000 && scenarie_ll12b_henstand_bevilling.henstand_med_skat_kroner == 257500 && scenarie_ll12b_henstand_bevilling.henstand_med_arbejdsmarkedsbidrag_kroner == 40000 && scenarie_ll12b_henstand_bevilling.samlet_henstandsbeløb_kroner == 297500 && scenarie_ll12b_henstand_bevilling.lovbestemt_syvårsgrænse == Falskt
| scenarie_ll12b_ny_henstand_gælder_ikke_før_2026: scenarie_ll12b_henstand_før_2026 -> scenarie_ll12b_henstand_før_2026.regime == Ll12B19Marts2025Til31December2025 && scenarie_ll12b_henstand_før_2026.betingelser_opfyldt == Falskt && scenarie_ll12b_henstand_før_2026.samlet_henstandsbeløb_kroner == 0
| scenarie_ll12b_henstand_fordeles_til_det_enkelte_aktiv: scenarie_ll12b_henstand_aktivfordeling -> scenarie_ll12b_henstand_aktivfordeling.finansiering_gyldig && scenarie_ll12b_henstand_aktivfordeling.kapitaliseret_værdi_af_løbende_ydelse_kroner == 500000 && scenarie_ll12b_henstand_aktivfordeling.kapitaliseret_værdi_henført_til_aktiv_kroner == 200000 && scenarie_ll12b_henstand_aktivfordeling.afståelsessum_for_aktiv_kroner == 400000 && scenarie_ll12b_henstand_aktivfordeling.henstand_med_skat_kroner == 257500
| scenarie_ll12b_am_henstand_kræver_par4_eller_par5: scenarie_ll12b_henstand_uden_am_hjemmel -> scenarie_ll12b_henstand_uden_am_hjemmel.beregning_gyldig == Falskt && scenarie_ll12b_henstand_uden_am_hjemmel.betingelser_opfyldt == Falskt && scenarie_ll12b_henstand_uden_am_hjemmel.samlet_henstandsbeløb_kroner == 0
| scenarie_ll12b_forholdsmæssigt_afdrag: scenarie_ll12b_henstand_afdrag -> scenarie_ll12b_henstand_afdrag.skatteafdrag_forfalder_kroner == 51500 && scenarie_ll12b_henstand_afdrag.arbejdsmarkedsbidragsafdrag_forfalder_kroner == 8000 && scenarie_ll12b_henstand_afdrag.samlet_afdrag_forfalder_kroner == 59500 && scenarie_ll12b_henstand_afdrag.position_efter.resterende_skat_kroner == 206000
| scenarie_ll12b_retsafståelse_udløser_forholdsmæssigt_afdrag: scenarie_ll12b_henstand_afdrag_ved_retsafståelse -> scenarie_ll12b_henstand_afdrag_ved_retsafståelse.skatteafdrag_forfalder_kroner == 25750 && scenarie_ll12b_henstand_afdrag_ved_retsafståelse.arbejdsmarkedsbidragsafdrag_forfalder_kroner == 4000 && scenarie_ll12b_henstand_afdrag_ved_retsafståelse.samlet_afdrag_forfalder_kroner == 29750
| scenarie_ll12b_forsinkelsesrente_og_rykkergebyr: scenarie_ll12b_henstand_forsinket -> scenarie_ll12b_henstand_forsinket.månedlig_forsinkelsesrente_basispoint == 50 && scenarie_ll12b_henstand_forsinket.ubetalt_forfaldent_afdrag_kroner == 59500 && scenarie_ll12b_henstand_forsinket.ikke_fradragsberettiget_rente_kroner == 297 && scenarie_ll12b_henstand_forsinket.rykkergebyr_kroner == 65
| scenarie_ll12b_ophør_frafalder_rest_og_reducerer_vso_konto: scenarie_ll12b_henstand_ophør_vso -> scenarie_ll12b_henstand_ophør_vso.frafaldet_henstandsbeløb_kroner == 238000 && scenarie_ll12b_henstand_ophør_vso.konto_for_opsparet_overskud_reduktion_kroner == 150000 && scenarie_ll12b_henstand_ophør_vso.position_efter.resterende_skat_kroner == 0 && scenarie_ll12b_henstand_ophør_vso.position_efter.konto_for_opsparet_overskud_kroner == 0
| scenarie_ll12b_vso_vejledning_reducerer_opsparet_overskud: scenarie_ll12b_vso_vejledning_ophør -> scenarie_ll12b_vso_vejledning_bevilling.henstand_med_skat_kroner == 198000 && scenarie_ll12b_vso_vejledning_ophør.frafaldet_henstandsbeløb_kroner == 115500 && scenarie_ll12b_vso_vejledning_ophør.konto_for_opsparet_overskud_reduktion_kroner == 409500 && scenarie_ll12b_vso_vejledning_ophør.position_efter.konto_for_opsparet_overskud_kroner == 292500
| scenarie_ll12b_grov_misligholdelse_forfalder_efter_påkrav: scenarie_ll12b_henstand_grov_misligholdelse -> scenarie_ll12b_henstand_grov_misligholdelse.resterende_henstandsbeløb_forfalder_efter_påkrav_kroner == 238000 && scenarie_ll12b_henstand_grov_misligholdelse.frafaldet_henstandsbeløb_kroner == 0
| scenarie_ll12b_henstandsgrundlag_følger_aftaleregimet: scenarie_ll12b_historisk_ophør_gammel_henstand -> scenarie_ll12b_historisk_ophør_gammel_henstand.henstandsgrundlag_gyldigt && scenarie_ll12b_historisk_ophør_gammel_henstand.modtager_fradrag_kroner == 30000 && scenarie_ll12b_historisk_ophør_forkert_ny_henstand.henstandsgrundlag_gyldigt == Falskt && scenarie_ll12b_historisk_ophør_forkert_ny_henstand.modtager_fradrag_kroner == 33000 && ll12b_modtager_ophør_fradrag_fixture.henstandsgrundlag_gyldigt && ll12b_modtager_ophør_fradrag_fixture.modtager_fradrag_kroner == 30000
| scenarie_ll12b_stk8_tredjemand_er_skattepligtig_men_ikke_par4_nr15: scenarie_ll12b_tredjemand -> scenarie_ll12b_tredjemand.tredjemand_skattepligtigt_kroner == 12000 && scenarie_ll12b_tredjemand.omfattet_af_stk4_til_7_eller_9 == Falskt && scenarie_ll12b_tredjemand_personskattelov.kapitalindkomst_kroner == 0
| scenarie_ll12b_stk9_overtager_indgangsværdi: scenarie_ll12b_overtager_indgangsværdi -> scenarie_ll12b_overtager_indgangsværdi.overtager_indgangsværdi_kroner == 45000

? scenarie_ll12b_regimegrænser
? scenarie_ll12b_modtagerafskæring_gælder_fra_19_marts_2025
? scenarie_ll12b_yderafskæring_gælder_fra_19_marts_2025
? scenarie_ll12b_abl8_kræver_hverken_kapitalisering_eller_saldo
? scenarie_ll12b_selvejende_institution_bevarer_stk2_men_afskærer_stk3_og_frem
? scenarie_ll12b_senere_skattepligt_reducerer_indgangsværdi
? scenarie_ll12b_henstand_skyggeberegning_og_forhold
? scenarie_ll12b_ny_henstand_gælder_ikke_før_2026
? scenarie_ll12b_henstand_fordeles_til_det_enkelte_aktiv
? scenarie_ll12b_am_henstand_kræver_par4_eller_par5
? scenarie_ll12b_forholdsmæssigt_afdrag
? scenarie_ll12b_retsafståelse_udløser_forholdsmæssigt_afdrag
? scenarie_ll12b_forsinkelsesrente_og_rykkergebyr
? scenarie_ll12b_ophør_frafalder_rest_og_reducerer_vso_konto
? scenarie_ll12b_vso_vejledning_reducerer_opsparet_overskud
? scenarie_ll12b_grov_misligholdelse_forfalder_efter_påkrav
? scenarie_ll12b_henstandsgrundlag_følger_aftaleregimet
? scenarie_ll12b_stk8_tredjemand_er_skattepligtig_men_ikke_par4_nr15
? scenarie_ll12b_stk9_overtager_indgangsværdi

@ print("LL §12B henstand med skat: " + vis(scenarie_ll12b_henstand_bevilling.henstand_med_skat_kroner))
@ print("LL §12B samlet første afdrag: " + vis(scenarie_ll12b_henstand_afdrag.samlet_afdrag_forfalder_kroner))
