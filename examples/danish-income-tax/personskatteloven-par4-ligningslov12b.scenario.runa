    ),
    begivenhed = Ll12BYdelseOphører(betalte_ydelser_kroner = 10000),
    årsfordeling = scenarie_ll12b_årsfordeling_ingen,
    ophørsfordeling = Ligningslov12BOphørsfordeling(
        modtager_ikke_skattepligtig_aktivandel_kroner = 7000,
        yder_ophør_ikke_medregnes_kroner = 0,
        yder_ophør_nedsætter_anskaffelsessum_kroner = 0
    )
))

= scenarie_ll12b_tredjemand = ligningslov12b_resultat(Ligningslov12BInput(
    indkomstår = 2026,
    rolle = Ll12BTredjemandErhverver,
    aftale = scenarie_ll12b_henstand_aftale_2026,
