| vsl7_kapitalafkast_loftes_af_overskud: vsl7_overskudsloft_fixture -> vsl7_overskudsloft_fixture.beregnet_kapitalafkast_positivt_kroner == 20000 && vsl7_overskudsloft_fixture.kapitalafkast_kroner == 18000
| vsl7_forholdsmæssigt_for_regnskabsperiode: vsl7_forholdsmæssigt_fixture -> vsl7_forholdsmæssigt_fixture.beregnet_kapitalafkast_positivt_kroner == 36000 && vsl7_forholdsmæssigt_fixture.forholdsmæssigt_kapitalafkast_kroner == 18000
| vsl7_negativt_afkastgrundlag_ignoreres: vsl7_negativt_afkastgrundlag_fixture -> vsl7_negativt_afkastgrundlag_fixture.beregnet_kapitalafkast_før_positivregulering_kroner == -5000 && vsl7_negativt_afkastgrundlag_fixture.kapitalafkast_kroner == 0
| vsl22a_kapitalafkast_loftes_efter_stk3: vsl22a_loftet_fixture -> vsl22a_loftet_fixture.omfattet_af_stk1 == Sandt && vsl22a_loftet_fixture.beregnet_kapitalafkast_før_loft_kroner == 15000 && vsl22a_loftet_fixture.loft_efter_stk3_kroner == 12000 && vsl22a_loftet_fixture.kapitalafkast_kroner == 12000
| vsl22a_kræver_valg: vsl22a_ikke_valgt_fixture -> vsl22a_ikke_valgt_fixture.omfattet_af_stk1 == Falskt && vsl22a_ikke_valgt_fixture.kapitalafkast_kroner == 0
| vsl22c_betingelser_giver_kapitalafkast: vsl22c_opfyldt_fixture -> vsl22c_opfyldt_fixture.betingelser_opfyldt == Sandt && vsl22c_opfyldt_fixture.kapitalafkastgrundlag_kroner == 1000000 && vsl22c_opfyldt_fixture.kapitalafkast_kroner == 50000
| vsl22c_beløbsgrænse_afskærer: vsl22c_under_beløbsgrænse_fixture -> vsl22c_under_beløbsgrænse_fixture.vederlag_over_beløbsgrænse == Falskt && vsl22c_under_beløbsgrænse_fixture.kapitalafkast_kroner == 0
| vsl23a_delvist_valgt_personlig_indkomst: vsl23a_delvist_personlig_fixture -> vsl23a_delvist_personlig_fixture.personlig_indkomst_kroner == 5000 && vsl23a_delvist_personlig_fixture.resterende_kapitalafkast_kroner == 13000
| vsl23a_grundbeløb_lofter_personlig_indkomst: vsl23a_loftet_fixture -> vsl23a_loftet_fixture.personlig_indkomst_kroner == 6000 && vsl23a_loftet_fixture.resterende_kapitalafkast_kroner == 6000
| vsl11_stk1_afkast_og_nettofinansiering_lofter: vsl11_stk1_loftet_fixture -> vsl11_stk1_loftet_fixture.stk1_indskudskonto_grundlag_kroner == 100000 && vsl11_stk1_loftet_fixture.stk1_rentekorrektion_før_loft_kroner == 5000 && vsl11_stk1_loftet_fixture.stk1_afkastgrundlag_loft_kroner == 3000 && vsl11_stk1_loftet_fixture.stk1_rentekorrektion_kroner == 3000
| vsl11_stk2_indskud_lofter: vsl11_stk2_loftet_fixture -> vsl11_stk2_loftet_fixture.stk2_hævning_og_indskud == Sandt && vsl11_stk2_loftet_fixture.stk2_rentekorrektion_før_loft_kroner == 4000 && vsl11_stk2_loftet_fixture.stk2_indskudsloft_kroner == 1500 && vsl11_stk2_loftet_fixture.stk2_rentekorrektion_kroner == 1500
| vsl11_samlet_medregnes_personligt_og_fradrages_i_kapital: vsl11_samlet_fixture -> vsl11_samlet_fixture.samlet_rentekorrektion_kroner == 4500 && vsl11_samlet_fixture.personlig_indkomst_tillæg_kroner == 4500 && vsl11_samlet_fixture.kapitalindkomst_fradrag_kroner == 4500 && vsl11_samlet_fixture.kapitalindkomst_kroner == -4500
| vsl11_uden_betingelser_giver_nul: vsl11_uden_rentekorrektion_fixture -> vsl11_uden_rentekorrektion_fixture.samlet_rentekorrektion_kroner == 0 && vsl11_uden_rentekorrektion_fixture.kapitalindkomst_kroner == 0

? vsl7_kapitalafkast_loftes_af_overskud
? vsl7_forholdsmæssigt_for_regnskabsperiode
? vsl7_negativt_afkastgrundlag_ignoreres
? vsl22a_kapitalafkast_loftes_efter_stk3
? vsl22a_kræver_valg
