)

= vsl7_overskudsloft_fixture = virksomhedsskattelov7_resultat(vsl7_overskudsloft_input)
= vsl7_forholdsmæssigt_fixture = virksomhedsskattelov7_resultat(vsl7_forholdsmæssigt_input)
= vsl7_negativt_afkastgrundlag_fixture = virksomhedsskattelov7_resultat(vsl7_negativt_afkastgrundlag_input)
= vsl22a_loftet_fixture = virksomhedsskattelov22a_resultat(vsl22a_loftet_input)
= vsl22a_ikke_valgt_fixture = virksomhedsskattelov22a_resultat(vsl22a_ikke_valgt_input)
= vsl22c_opfyldt_fixture = virksomhedsskattelov22c_resultat(vsl22c_opfyldt_input)
= vsl22c_under_beløbsgrænse_fixture = virksomhedsskattelov22c_resultat(vsl22c_under_beløbsgrænse_input)
= vsl23a_delvist_personlig_fixture = virksomhedsskattelov23a_resultat(vsl23a_delvist_personlig_input)
= vsl23a_loftet_fixture = virksomhedsskattelov23a_resultat(vsl23a_loftet_input)

= vsl11_stk1_loftet_input = Virksomhedsskattelov11Input(
    indkomstår = 2026,
    rentekorrektionssats_basispoint = 500,
    negativ_indskudskonto_start_eller_primo_abs_kroner = 100000,
    negativ_indskudskonto_ultimo_abs_kroner = 80000,
    negativt_afkastgrundlag_start_eller_primo_abs_kroner = 60000,
    negativt_afkastgrundlag_ultimo_abs_kroner = 40000,
    nettofinansieringsudgifter_efter_kursgevinstlov_kroner = 3000,
    overført_efter_par5_stk1_nr5_og_stk2_kroner = 0,
    indskud_efter_par3_stk1_kroner = 0
)
= vsl11_stk2_loftet_input = Virksomhedsskattelov11Input(
