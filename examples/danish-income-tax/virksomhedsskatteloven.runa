    ansatte_samlet_stemmeværdi_basispoint = 0,
    ingen_ansat_råder_over_mere_end_50_pct_stemmer = Sandt,
    selskab_ikke_passiv_kapitalanbringelse_eller_næring_finansiering = Sandt,
    aktier_ikke_omfattet_af_abl19b_eller_19c = Sandt,
    ikke_erhvervet_ved_omdannelse_aktieombytning_etableringskonto = Sandt,
    ejet_i_mindre_end_11_år = Sandt,
    kapitalafkastsats_basispoint = 500,
