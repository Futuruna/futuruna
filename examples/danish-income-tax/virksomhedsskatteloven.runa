| virksomhedsskattelov9_månedsrente(indkomstår: Heltal, måned: Virksomhedsskattelov9Måned) -> Virksomhedsskattelov9Månedsrente(
    indkomstår = indkomstår,
    statistikperiode = hvis virksomhedsskattelov9_effektiv_rentesats_milliprocent(indkomstår, måned) > 0 { vis(indkomstår) + "M" + virksomhedsskattelov9_månedskode(måned) } ellers { "" },
    måned = måned,
    effektiv_rentesats_milliprocent = virksomhedsskattelov9_effektiv_rentesats_milliprocent(indkomstår, måned),
    effektiv_rentesats_basispoint = penge_basispoint_fra_milliprocent_afrundet_til_to_decimaler(virksomhedsskattelov9_effektiv_rentesats_milliprocent(indkomstår, måned))
)
| virksomhedsskattelov9_månedsrenter(indkomstår: Heltal) -> map(virksomhedsskattelov9_måneder(), |måned: Virksomhedsskattelov9Måned| virksomhedsskattelov9_månedsrente(indkomstår, måned))
| virksomhedsskattelov9_månedsdata_komplette(månedsrenter: List(Virksomhedsskattelov9Månedsrente)) -> length(månedsrenter) == 6 && all(månedsrenter, |rente: Virksomhedsskattelov9Månedsrente| rente.effektiv_rentesats_milliprocent > 0)
| virksomhedsskattelov9_månedsrenter_sum_basispoint(månedsrenter: List(Virksomhedsskattelov9Månedsrente)) -> foldl(månedsrenter, 0, |sum: Heltal, rente: Virksomhedsskattelov9Månedsrente| sum + rente.effektiv_rentesats_basispoint)
| virksomhedsskattelov9_simpelt_gennemsnit_en_decimal_basispoint(månedsrenter: List(Virksomhedsskattelov9Månedsrente)) -> hvis virksomhedsskattelov9_månedsdata_komplette(månedsrenter) { (virksomhedsskattelov9_månedsrenter_sum_basispoint(månedsrenter) + 30) / 60 * 10 } ellers { 0 }
| virksomhedsskattelov9_sats_efter_nedsættelse_basispoint(månedsrenter: List(Virksomhedsskattelov9Månedsrente)) -> penge_positivt_beløb(virksomhedsskattelov9_simpelt_gennemsnit_en_decimal_basispoint(månedsrenter) - 200)
| virksomhedsskattelov9_afkastsats_basispoint(månedsrenter: List(Virksomhedsskattelov9Månedsrente)) -> penge_basispoint_nedrundet_til_hel_procent(virksomhedsskattelov9_sats_efter_nedsættelse_basispoint(månedsrenter))
| virksomhedsskattelov9a_rentekorrektionssats_basispoint(månedsrenter: List(Virksomhedsskattelov9Månedsrente)) -> penge_basispoint_afrundet_op_til_hel_procent(virksomhedsskattelov9_simpelt_gennemsnit_en_decimal_basispoint(månedsrenter))
| virksomhedsskattelov9_offentliggørelsesstatus(indkomstår: Heltal) -> Vsl9IndkomstårIkkeKildebelagt
| exception vsl9_skatteministeriet_2025_offentliggjort virksomhedsskattelov9_offentliggørelsesstatus(indkomstår: Heltal) -> Vsl9OffentliggjortAfSkatteministeriet(
    afkastsats_basispoint = 200,
    rentekorrektionssats_basispoint = 500,
    kilde_url = "https://skm.dk/tal-og-metode/satser/satser-og-beloebsgraenser-i-lovgivningen/virksomhedsskatteloven"
) under indkomstår == 2025
| exception vsl9_skatteministeriet_2026_afventer virksomhedsskattelov9_offentliggørelsesstatus(indkomstår: Heltal) -> Vsl9AfventerSkatteministerietsOffentliggørelse(
    kilde_url = "https://skm.dk/tal-og-metode/satser/satser-og-beloebsgraenser-i-lovgivningen/virksomhedsskatteloven"
) under indkomstår == 2026
| virksomhedsskattelov9_offentliggjort_sammenligning_mulig(status: Virksomhedsskattelov9Offentliggørelsesstatus) -> match status {
    | Vsl9OffentliggjortAfSkatteministeriet(_, _, _) -> Sandt
    | _ -> Falskt
}
| virksomhedsskattelov9_matcher_offentliggjorte_satser(status: Virksomhedsskattelov9Offentliggørelsesstatus, afkastsats_basispoint: Heltal, rentekorrektionssats_basispoint: Heltal) -> match status {
    | Vsl9OffentliggjortAfSkatteministeriet(offentliggjort_afkastsats, offentliggjort_rentekorrektionssats, _) -> afkastsats_basispoint == offentliggjort_afkastsats && rentekorrektionssats_basispoint == offentliggjort_rentekorrektionssats
    | _ -> Falskt
}

# Virksomhedsskattelov9Og9ASag(indkomstår: Heltal) {
    | månedsrenter() -> virksomhedsskattelov9_månedsrenter(indkomstår)
    | månedsdata_komplette() -> virksomhedsskattelov9_månedsdata_komplette(månedsrenter())
    | månedsrenter_sum_basispoint() -> virksomhedsskattelov9_månedsrenter_sum_basispoint(månedsrenter())
    | simpelt_gennemsnit_en_decimal_basispoint() -> virksomhedsskattelov9_simpelt_gennemsnit_en_decimal_basispoint(månedsrenter())
    | sats_efter_nedsættelse_med_to_procentpoint_basispoint() -> virksomhedsskattelov9_sats_efter_nedsættelse_basispoint(månedsrenter())
    | afkastsats_efter_par9_basispoint() -> virksomhedsskattelov9_afkastsats_basispoint(månedsrenter())
    | rentekorrektionssats_efter_par9a_basispoint() -> virksomhedsskattelov9a_rentekorrektionssats_basispoint(månedsrenter())
    | offentliggørelsesstatus() -> virksomhedsskattelov9_offentliggørelsesstatus(indkomstår)
    | offentliggjort_sammenligning_mulig() -> virksomhedsskattelov9_offentliggjort_sammenligning_mulig(offentliggørelsesstatus())
    | matcher_offentliggjorte_satser() -> virksomhedsskattelov9_matcher_offentliggjorte_satser(offentliggørelsesstatus(), afkastsats_efter_par9_basispoint(), rentekorrektionssats_efter_par9a_basispoint())
    | resultat() -> Virksomhedsskattelov9Og9AResultat(
        indkomstår = indkomstår,
        månedsrenter = månedsrenter(),
        månedsdata_komplette = månedsdata_komplette(),
        månedsrenter_sum_basispoint = månedsrenter_sum_basispoint(),
        simpelt_gennemsnit_en_decimal_basispoint = simpelt_gennemsnit_en_decimal_basispoint(),
        sats_efter_nedsættelse_med_to_procentpoint_basispoint = sats_efter_nedsættelse_med_to_procentpoint_basispoint(),
        afkastsats_efter_par9_basispoint = afkastsats_efter_par9_basispoint(),
        rentekorrektionssats_efter_par9a_basispoint = rentekorrektionssats_efter_par9a_basispoint(),
        offentliggørelsesstatus = offentliggørelsesstatus(),
        offentliggjort_sammenligning_mulig = offentliggjort_sammenligning_mulig(),
        matcher_offentliggjorte_satser = matcher_offentliggjorte_satser()
    )
}
| virksomhedsskattelov9_og_9a_sag(indkomstår: Heltal) -> Virksomhedsskattelov9Og9ASag(indkomstår)
| virksomhedsskattelov9_og_9a_resultat(indkomstår: Heltal) -> virksomhedsskattelov9_og_9a_sag(indkomstår).resultat()

# Virksomhedsskattelov7KildeInput(par8_input: Virksomhedsskattelov8Input, skattepligtigt_overskud_kroner: Heltal, regnskabsperiode_hele_måneder: Heltal)
# Virksomhedsskattelov7KildeResultat(input: Virksomhedsskattelov7KildeInput, par8_resultat: Virksomhedsskattelov8Resultat, par9_og_9a_resultat: Virksomhedsskattelov9Og9AResultat, par7_input: Virksomhedsskattelov7Input, par7_resultat: Virksomhedsskattelov7Resultat, input_gyldigt: Boolsk)
# Virksomhedsskattelov7KildeSag(input: Virksomhedsskattelov7KildeInput) {
    | par8_resultat() -> virksomhedsskattelov8_resultat(input.par8_input)
    | par9_og_9a_resultat() -> virksomhedsskattelov9_og_9a_resultat(input.par8_input.indkomstår)
    | par7_input() -> Virksomhedsskattelov7Input(
        indkomstår = input.par8_input.indkomstår,
        afkastgrundlag_kroner = par8_resultat().afkastgrundlag_kroner,
        kapitalafkastsats_basispoint = par9_og_9a_resultat().afkastsats_efter_par9_basispoint,
        skattepligtigt_overskud_kroner = input.skattepligtigt_overskud_kroner,
        regnskabsperiode_hele_måneder = input.regnskabsperiode_hele_måneder
    )
    | par7_resultat() -> virksomhedsskattelov7_resultat(par7_input())
    | input_gyldigt() -> par8_resultat().input_gyldigt && par9_og_9a_resultat().månedsdata_komplette && input.skattepligtigt_overskud_kroner >= 0 && input.regnskabsperiode_hele_måneder >= 0
    | resultat() -> Virksomhedsskattelov7KildeResultat(
        input = input,
        par8_resultat = par8_resultat(),
        par9_og_9a_resultat = par9_og_9a_resultat(),
        par7_input = par7_input(),
        par7_resultat = par7_resultat(),
        input_gyldigt = input_gyldigt()
    )
}
| virksomhedsskattelov7_kilde_sag(input: Virksomhedsskattelov7KildeInput) -> Virksomhedsskattelov7KildeSag(input)
| virksomhedsskattelov7_kilde_resultat(input: Virksomhedsskattelov7KildeInput) -> virksomhedsskattelov7_kilde_sag(input).resultat()
