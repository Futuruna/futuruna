@ sprog da

@ importer ./afskrivningsloven
@ importer ./slutopgoerelse

-- Scenarier for Afskrivningslovens § 40 C og kæden til Kildeskattelovens
-- slutopgørelse. Den originale lovtekst står i afskrivningsloven.runa.

= al40c_betalingsrettighed_position = Afskrivningslov40CPosition(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    lot = AfskrivningslovKvoteLot(
        lot_id = "betaling-2021-1",
        rettighedsnøgle = "eu-betalingsrettighed",
        erhvervelsesdato = AfskrivningslovDato(år = 2021, måned = 1, dag = 15),
        erhvervelsesrækkefølge = 1,
        resterende_enheder = 10
    ),
    aktivgrundlag = Al40CBetalingsrettighedsgrundlag(
        anskaffelsesgrundlag = Al40CSærskiltAnskaffelsessum(anskaffelsessum_kroner = 100000)
    ),
    resterende_anskaffelsesgrundlag_kroner = 100000
)
= al40c_betalingsrettighed_anskaffet = afskrivningslov40c_aktiv_resultat(Afskrivningslov40CAktivInput(
    indkomstår = 2021,
    position = al40c_betalingsrettighed_position,
    lager = [al40c_betalingsrettighed_position],
    hændelse = Al40CAnskaffelsePåSaldo
))

= al40c_gratis_betalingsrettighed_position = Afskrivningslov40CPosition(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    lot = AfskrivningslovKvoteLot(
        lot_id = "betaling-gratis-2021-1",
        rettighedsnøgle = "eu-betalingsrettighed-gratis",
        erhvervelsesdato = AfskrivningslovDato(år = 2021, måned = 2, dag = 1),
        erhvervelsesrækkefølge = 2,
        resterende_enheder = 5
    ),
    aktivgrundlag = Al40CBetalingsrettighedsgrundlag(
        anskaffelsesgrundlag = Al40CVederlagsfritTildelt(beskattet_værdi_ved_tildeling_kroner = 0)
    ),
    resterende_anskaffelsesgrundlag_kroner = 0
)
= al40c_gratis_betalingsrettighed_anskaffet = afskrivningslov40c_aktiv_resultat(Afskrivningslov40CAktivInput(
    indkomstår = 2021,
    position = al40c_gratis_betalingsrettighed_position,
    lager = [al40c_gratis_betalingsrettighed_position],
    hændelse = Al40CAnskaffelsePåSaldo
))
= al40c_forpagter_afgiver = afskrivningslov40c_aktiv_resultat(Afskrivningslov40CAktivInput(
    indkomstår = 2021,
    position = al40c_gratis_betalingsrettighed_position,
    lager = [al40c_gratis_betalingsrettighed_position],
    hændelse = Al40CForpagterAfgiverVederlagsfrit(
        hændelsesdato = AfskrivningslovDato(år = 2021, måned = 12, dag = 1),
        afgivne_enheder = 5
    )
))
= al40c_bortforpagter_modtager = afskrivningslov40c_aktiv_resultat(Afskrivningslov40CAktivInput(
    indkomstår = 2021,
    position = al40c_gratis_betalingsrettighed_position,
    lager = [al40c_gratis_betalingsrettighed_position],
    hændelse = Al40CBortforpagterModtagerVederlagsfrit
))

= al40c_ny_mælk_position = Afskrivningslov40CPosition(
