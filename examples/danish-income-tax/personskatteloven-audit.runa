| m5_par13_stk5_beløbsbegrænsning_2025: m5_par13_stk5_2025_fixture -> m5_par13_stk5_2025_fixture.overførbart_underskud_kroner == 53000 && m5_par13_stk5_2025_fixture.afskåret_udenlandsk_nettoindkomst_kroner == 25000 && m5_par13_stk5_2025_fixture.afskåret_udlandsfradrag_kroner == 12000 && m5_par13_stk5_2025_fixture.afskåret_pbl16_kroner == 10000
| m5_par13_stk5_pbl16_ophævet_2026: m5_par13_stk5_2026_fixture -> m5_par13_stk5_2026_fixture.overførbart_underskud_kroner == 100000 && m5_par13_stk5_2026_fixture.afskåret_pbl16_kroner == 0
| m5_par13_stk5_ll33a_lempelse: m5_par13_stk5_ll33a_fixture -> m5_par13_stk5_ll33a_fixture.overførbart_underskud_kroner == 100000 && m5_par13_stk5_ll33a_fixture.samlet_afskåret_kroner == 0
| m5_par13_stk5_sømandslempelse: m5_par13_stk5_sømand_fixture -> m5_par13_stk5_sømand_fixture.overførbart_underskud_kroner == 100000 && m5_par13_stk5_sømand_fixture.samlet_afskåret_kroner == 0
| m5_par13_virksomhedsbeløb_låses: m5_par13_virksomhed_fixture -> m5_par13_virksomhed_fixture.fradrag_i_øvrig_indkomst_kroner == 0 && m5_par13_virksomhed_fixture.modregnet_i_samme_virksomhed_kroner == 30000 && m5_par13_virksomhed_fixture.fremført_til_samme_virksomhed_kroner == 50000
