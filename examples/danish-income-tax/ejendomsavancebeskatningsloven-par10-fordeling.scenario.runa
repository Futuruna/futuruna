@ sprog da

@ importer ./metadata
@ importer ./ejendomsavancebeskatningsloven

= ebl_par10_fordeling_scenarier_metadata = Metadata(
    attachments = (
        Source(value = ebl_genanbringelse_lbk132),
        Guidance(value = ebl_par10_anden_ejendom_vejledning_2026),
    )
)

--@label:ebl_par10_fordeling_scenarier::meta:ebl_par10_fordeling_scenarier_metadata--
--@begin:ebl_par10_fordeling_scenarier--
| ebl_par10_fordeling_scenarie_fakta(genopførelsessted: EblPar10Genopførelsessted) -> EblPar10Fakta(
    skadedato = EblDato(år = 2024, måned = 3, dag = 1),
    erstatningssum_endeligt_fastsat_indkomstår = 2024,
    genopførelsesindkomstår = 2025,
    skadelidt_ejendom_omfattet_af_par8 = Falskt,
    erstatnings_eller_forsikringssum_ikke_skattefri_efter_par9_kroner = 500000,
    reguleret_anskaffelsessum_for_skaderamt_erhvervsdel_kroner = 300000,
    genopførelsessted = genopførelsessted,
    fristforhold = EblPar10UdenFristforlængelse,
    afskrivningsforhold = EblPar10IngenAfskrivningsberettigedeBygninger,
    regulering = EblGenanbragtFortjenesteregulering(
        tillæg_for_genanbragt_del_kroner = 0,
        nedslag_for_genanbragt_del_kroner = 0
    )
)

= ebl_par10_fordeling_scenarie_ejendom_a = EblPar10Genopførelsesejendom(
    identifikation = "ejendom-a",
    erhvervsmæssige_genopførelsesudgifter_kroner = 400000,
    ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
)
= ebl_par10_fordeling_scenarie_ejendom_b = EblPar10Genopførelsesejendom(
    identifikation = "ejendom-b",
    erhvervsmæssige_genopførelsesudgifter_kroner = 200000,
    ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
)
= ebl_par10_fordeling_scenarie_grundfakta = ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10SammeEjersErhvervsejendommeUdgørDriftsenhed,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = [
            ebl_par10_fordeling_scenarie_ejendom_a,
            ebl_par10_fordeling_scenarie_ejendom_b,
        ]
    )
)
= ebl_par10_fordeling_scenarie_resultat = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_grundfakta)
= ebl_par10_fordeling_scenarie_fordeling_a = head(filter(ebl_par10_fordeling_scenarie_resultat.fordelinger, |fordeling: EblPar10Ejendomsfordeling| fordeling.ejendomsidentifikation == "ejendom-a"))
= ebl_par10_fordeling_scenarie_fordeling_b = head(filter(ebl_par10_fordeling_scenarie_resultat.fordelinger, |fordeling: EblPar10Ejendomsfordeling| fordeling.ejendomsidentifikation == "ejendom-b"))
= ebl_par10_fordeling_scenarie_valgt_a = ebl_genanbringelsesresultat(EblMedGenanbringelseEfterPar10(
    fakta = ebl_par10_fordeling_scenarie_grundfakta,
    genopført_ejendom_identifikation = "ejendom-a"
))
= ebl_par10_fordeling_scenarie_valgt_b = ebl_genanbringelsesresultat(EblMedGenanbringelseEfterPar10(
    fakta = ebl_par10_fordeling_scenarie_grundfakta,
    genopført_ejendom_identifikation = "ejendom-b"
))

= ebl_par10_fordeling_scenarie_dublet = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10SammeEjersErhvervsejendommeUdgørDriftsenhed,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = [
            ebl_par10_fordeling_scenarie_ejendom_a,
            EblPar10Genopførelsesejendom(
                identifikation = "ejendom-a",
                erhvervsmæssige_genopførelsesudgifter_kroner = 200000,
                ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
            ),
        ]
    )
))
= ebl_par10_fordeling_scenarie_manglende_ejendom = ebl_par10_resultat_for_ejendom(
    ebl_par10_fordeling_scenarie_grundfakta,
    "ejendom-c"
)
= ebl_par10_fordeling_scenarie_tom_liste = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10LovEllerMyndighedHindrerGenopførelsePåSkadested,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = []
    )
))
= ebl_par10_fordeling_scenarie_nuludgift = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10LovEllerMyndighedHindrerGenopførelsePåSkadested,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = [EblPar10Genopførelsesejendom(
            identifikation = "ejendom-nul",
            erhvervsmæssige_genopførelsesudgifter_kroner = 0,
            ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
        )]
    )
))
= ebl_par10_fordeling_scenarie_negativ_udgift = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10LovEllerMyndighedHindrerGenopførelsePåSkadested,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = [EblPar10Genopførelsesejendom(
            identifikation = "ejendom-negativ",
            erhvervsmæssige_genopførelsesudgifter_kroner = -1,
            ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
        )]
    )
))
= ebl_par10_fordeling_scenarie_for_sen_meddelelse = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10SammeEjersErhvervsejendommeUdgørDriftsenhed,
        meddelelse = EblPar10MeddelelseForSen,
        ejendomme = [
            ebl_par10_fordeling_scenarie_ejendom_a,
            ebl_par10_fordeling_scenarie_ejendom_b,
        ]
    )
))
= ebl_par10_fordeling_scenarie_en_ejendom = ebl_par10_fordelingsresultat(ebl_par10_fordeling_scenarie_fakta(
    EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10LovEllerMyndighedHindrerGenopførelsePåSkadested,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = [EblPar10Genopførelsesejendom(
            identifikation = "en-ejendom",
            erhvervsmæssige_genopførelsesudgifter_kroner = 600000,
            ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
        )]
    )
))
= ebl_par10_fordeling_scenarie_en_ejendoms_fordeling = head(ebl_par10_fordeling_scenarie_en_ejendom.fordelinger)
= ebl_par10_fordeling_scenarie_samme_ejendom = ebl_genanbringelsesresultat(EblMedGenanbringelseEfterPar10(
    fakta = ebl_par10_fordeling_scenarie_fakta(EblPar10GenopførelsePåSammeEjendom(
        ejendom = EblPar10Genopførelsesejendom(
            identifikation = "skadelidt-ejendom",
            erhvervsmæssige_genopførelsesudgifter_kroner = 150000,
            ejerboliganvendelse = EblPar10IngenEjerboliganvendelseVedGenopførelsen
        )
    )),
    genopført_ejendom_identifikation = "skadelidt-ejendom"
))

= ebl_par10_afskrivningsscenarie_bygning = Afskrivningslov14Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    anvendelse = Al14AndenErhvervsanvendelse,
    erhvervsmæssigt_benyttet = Sandt,
    postsortering_med_industrielt_præg = Falskt,
    tilknytning = Al14IkkeTilknyttet,
    tilknyttet_art = Al14BygningEllerLokale
)
= ebl_par10_afskrivningsscenarie_nedskrevet_værdi_input = Afskrivningslov21NedskrevetVærdiInput(
    aktiv_identifikation = "genopført-erhvervsbygning",
    aktiv = AlK3Bygning(input = ebl_par10_afskrivningsscenarie_bygning),
    grundlag = Al21OrdinærtGrundlag(
        samlede_anskaffelses_og_forbedringsudgifter_kroner = 600000,
        straksfradrag_som_ikke_medregnes_kroner = 0,
        afskrivningsposter = [Afskrivningslov21Afskrivningspost(
            beregnede_afskrivninger_kroner = 150000,
            fratrukne_afskrivninger_kroner = 150000
        )]
    ),
    par39_historik = Afskrivningslov21Par39Historik(
        afholdte_ombygningsudgifter_kroner = 0,
        foretagne_afskrivninger_kroner = 0
    )
)
= ebl_par10_afskrivningsscenarie_nedskrevet_værdi = afskrivningslov21_nedskrevet_værdi_resultat(ebl_par10_afskrivningsscenarie_nedskrevet_værdi_input)
| ebl_par10_afskrivningsscenarie_par21_input_med_salgssum(salgssum_kroner: Heltal) -> Afskrivningslov21Input(
    indkomstår = 2024,
    nedskrevet_værdi_input = ebl_par10_afskrivningsscenarie_nedskrevet_værdi_input,
    salg_gennemført = Sandt,
    samlet_salgssum = Al45OplystKontantværdi(beløb_kroner = salgssum_kroner),
    kontrol = Afskrivningslov21Kontrol(
        sælgerne_er_en_eller_flere_personer = Sandt,
        køber_er_selskab_mv = Falskt,
        kapitalandel_basispoint = 0,
        stemmerettigheder_basispoint = 0,
        anden_bestemmende_indflydelse = Falskt
    )
)
= ebl_par10_afskrivningsscenarie_par21 = afskrivningslov21_resultat(ebl_par10_afskrivningsscenarie_par21_input_med_salgssum(500000))

| ebl_par10_afskrivningsscenarie_par21_med_salgssum(salgssum_kroner: Heltal) -> afskrivningslov21_resultat(ebl_par10_afskrivningsscenarie_par21_input_med_salgssum(salgssum_kroner))
| ebl_par10_afskrivningsscenarie_par24_input_med_forsikringssum(genopførte_aktiver: List(Afskrivningslov24GenopførtAktiv), placering: Afskrivningslov24Placering, skadeår: Heltal, forsikringssum_kroner: Heltal) -> Afskrivningslov24Input(
    par21_input = ebl_par10_afskrivningsscenarie_par21_input_med_salgssum(forsikringssum_kroner),
    modtaget_erstatnings_eller_forsikringssum_kroner = forsikringssum_kroner,
    genopførelse_eller_ombygning_foretages = Sandt,
    genopførelsesudgifter_kroner = afskrivningslov24_genopførelsesudgifter_i_liste_kroner(genopførte_aktiver),
    genopførte_aktiver = genopførte_aktiver,
    placering = placering,
    skadeår = skadeår,
    erstatningssum_endeligt_fastsat_år = 2024,
    genopførelsesår = 2025,
    opgørelsesår = 2025,
    frist = Al24OrdinærFrist
)
| ebl_par10_afskrivningsscenarie_par24_input(genopførte_aktiver: List(Afskrivningslov24GenopførtAktiv), placering: Afskrivningslov24Placering, skadeår: Heltal) -> ebl_par10_afskrivningsscenarie_par24_input_med_forsikringssum(genopførte_aktiver, placering, skadeår, 500000)

= ebl_par10_afskrivningsscenarie_aktiv_a = Afskrivningslov24GenopførtAktiv(
    identifikation = "bygning-a",
    genopførelsesudgift_kroner = 400000
)
= ebl_par10_afskrivningsscenarie_aktiv_b = Afskrivningslov24GenopførtAktiv(
    identifikation = "bygning-b",
    genopførelsesudgift_kroner = 200000
)
= ebl_par10_afskrivningsscenarie_aktiver = [
    ebl_par10_afskrivningsscenarie_aktiv_a,
    ebl_par10_afskrivningsscenarie_aktiv_b,
]
= ebl_par10_afskrivningsscenarie_tilknytning_a = EblPar10AfskrivningsaktivTilknytning(
    aktiv_identifikation = "bygning-a",
    ejendomsidentifikation = "ejendom-a"
)
= ebl_par10_afskrivningsscenarie_tilknytning_b = EblPar10AfskrivningsaktivTilknytning(
    aktiv_identifikation = "bygning-b",
    ejendomsidentifikation = "ejendom-b"
)
= ebl_par10_afskrivningsscenarie_tilknytninger = [
    ebl_par10_afskrivningsscenarie_tilknytning_a,
    ebl_par10_afskrivningsscenarie_tilknytning_b,
]

| ebl_par10_afskrivningsscenarie_fakta(par24_input: Afskrivningslov24Input, tilknytninger: List(EblPar10AfskrivningsaktivTilknytning)) -> EblPar10Fakta(
    skadedato = EblDato(år = 2024, måned = 3, dag = 1),
    erstatningssum_endeligt_fastsat_indkomstår = 2024,
    genopførelsesindkomstår = 2025,
    skadelidt_ejendom_omfattet_af_par8 = Falskt,
    erstatnings_eller_forsikringssum_ikke_skattefri_efter_par9_kroner = 500000,
    reguleret_anskaffelsessum_for_skaderamt_erhvervsdel_kroner = 300000,
    genopførelsessted = EblPar10GenopførelsePåAndreEjendomme(
        grund = EblPar10SammeEjersErhvervsejendommeUdgørDriftsenhed,
        meddelelse = EblPar10MeddelelseVedOplysningerEfterSkattekontrollovensPar2,
        ejendomme = [
            ebl_par10_fordeling_scenarie_ejendom_a,
            ebl_par10_fordeling_scenarie_ejendom_b,
        ]
    ),
    fristforhold = EblPar10UdenFristforlængelse,
    afskrivningsforhold = EblPar10AfskrivningsberettigedeBygninger(
        par24_input = par24_input,
        aktivtilknytninger = tilknytninger
    ),
    regulering = EblGenanbragtFortjenesteregulering(
        tillæg_for_genanbragt_del_kroner = 0,
        nedslag_for_genanbragt_del_kroner = 0
    )
)

= ebl_par10_afskrivningsscenarie_gyldigt_par24_input = ebl_par10_afskrivningsscenarie_par24_input(
    ebl_par10_afskrivningsscenarie_aktiver,
    Al24AndenEjendomISammeDriftsenhed,
    2024
)
= ebl_par10_afskrivningsscenarie_gyldige_fakta = ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_gyldigt_par24_input,
    ebl_par10_afskrivningsscenarie_tilknytninger
)
= ebl_par10_afskrivningsscenarie_gyldigt = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_gyldige_fakta)
= ebl_par10_afskrivningsscenarie_samordning = ebl_par10_afskrivningssamordningsresultat(ebl_par10_afskrivningsscenarie_gyldige_fakta)
= ebl_par10_afskrivningsscenarie_delvis_stk9_aktiv = Afskrivningslov24GenopførtAktiv(
    identifikation = "blandet-bygning",
    genopførelsesudgift_kroner = 300000
)
= ebl_par10_afskrivningsscenarie_delvis_stk9_par24_input = ebl_par10_afskrivningsscenarie_par24_input_med_forsikringssum(
    [ebl_par10_afskrivningsscenarie_delvis_stk9_aktiv],
    Al24SammeEjendom,
    2024,
    300000
)
= ebl_par10_afskrivningsscenarie_delvis_stk9_fakta = EblPar10Fakta(
    skadedato = EblDato(år = 2024, måned = 3, dag = 1),
    erstatningssum_endeligt_fastsat_indkomstår = 2024,
    genopførelsesindkomstår = 2025,
    skadelidt_ejendom_omfattet_af_par8 = Falskt,
    erstatnings_eller_forsikringssum_ikke_skattefri_efter_par9_kroner = 500000,
    reguleret_anskaffelsessum_for_skaderamt_erhvervsdel_kroner = 300000,
    genopførelsessted = EblPar10GenopførelsePåSammeEjendom(ejendom = EblPar10Genopførelsesejendom(
        identifikation = "blandet-ejendom",
        erhvervsmæssige_genopførelsesudgifter_kroner = 300000,
        ejerboliganvendelse = EblPar10ErhvervserstatningAnvendtTilEjerboligVedGenopførelsen(
            ejerbolig_genopførelsesudgifter_kroner = 200000,
            erhvervserstatning_anvendt_kroner = 200000,
            reguleret_anskaffelsessum_for_skaderamt_del_kroner = 100000
        )
    )),
    fristforhold = EblPar10UdenFristforlængelse,
    afskrivningsforhold = EblPar10AfskrivningsberettigedeBygninger(
        par24_input = ebl_par10_afskrivningsscenarie_delvis_stk9_par24_input,
        aktivtilknytninger = [EblPar10AfskrivningsaktivTilknytning(
            aktiv_identifikation = "blandet-bygning",
            ejendomsidentifikation = "blandet-ejendom"
        )]
    ),
    regulering = EblGenanbragtFortjenesteregulering(
        tillæg_for_genanbragt_del_kroner = 0,
        nedslag_for_genanbragt_del_kroner = 0
    )
)
= ebl_par10_afskrivningsscenarie_delvis_stk9_samordning = ebl_par10_afskrivningssamordningsresultat(ebl_par10_afskrivningsscenarie_delvis_stk9_fakta)
= ebl_par10_afskrivningsscenarie_manglende_tilknytning = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(ebl_par10_afskrivningsscenarie_aktiver, Al24AndenEjendomISammeDriftsenhed, 2024),
    [ebl_par10_afskrivningsscenarie_tilknytning_a]
))
= ebl_par10_afskrivningsscenarie_dublet_tilknytning = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(ebl_par10_afskrivningsscenarie_aktiver, Al24AndenEjendomISammeDriftsenhed, 2024),
    [
        ebl_par10_afskrivningsscenarie_tilknytning_a,
        ebl_par10_afskrivningsscenarie_tilknytning_a,
    ]
))
= ebl_par10_afskrivningsscenarie_ukendt_ejendom = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(ebl_par10_afskrivningsscenarie_aktiver, Al24AndenEjendomISammeDriftsenhed, 2024),
    [
        ebl_par10_afskrivningsscenarie_tilknytning_a,
        EblPar10AfskrivningsaktivTilknytning(
            aktiv_identifikation = "bygning-b",
            ejendomsidentifikation = "ukendt-ejendom"
        ),
    ]
))
= ebl_par10_afskrivningsscenarie_for_stor_udgift = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(
        [
            Afskrivningslov24GenopførtAktiv(identifikation = "bygning-a", genopførelsesudgift_kroner = 450000),
            Afskrivningslov24GenopførtAktiv(identifikation = "bygning-b", genopførelsesudgift_kroner = 150000),
        ],
        Al24AndenEjendomISammeDriftsenhed,
        2024
    ),
    ebl_par10_afskrivningsscenarie_tilknytninger
))
= ebl_par10_afskrivningsscenarie_modstridende_placering = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(ebl_par10_afskrivningsscenarie_aktiver, Al24AndenEjendomHindretAfLovEllerMyndighed, 2024),
    ebl_par10_afskrivningsscenarie_tilknytninger
))
= ebl_par10_afskrivningsscenarie_modstridende_skadeår_fakta = ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(ebl_par10_afskrivningsscenarie_aktiver, Al24AndenEjendomISammeDriftsenhed, 2023),
    ebl_par10_afskrivningsscenarie_tilknytninger
)
= ebl_par10_afskrivningsscenarie_modstridende_skadeår = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_modstridende_skadeår_fakta)
= ebl_par10_afskrivningsscenarie_modstridende_samordning = ebl_par10_afskrivningssamordningsresultat(ebl_par10_afskrivningsscenarie_modstridende_skadeår_fakta)
= ebl_par10_afskrivningsscenarie_dublet_aktiv = ebl_par10_fordelingsresultat(ebl_par10_afskrivningsscenarie_fakta(
    ebl_par10_afskrivningsscenarie_par24_input(
        [
            Afskrivningslov24GenopførtAktiv(identifikation = "bygning-a", genopførelsesudgift_kroner = 400000),
            Afskrivningslov24GenopførtAktiv(identifikation = "bygning-a", genopførelsesudgift_kroner = 200000),
        ],
        Al24AndenEjendomISammeDriftsenhed,
        2024
    ),
    [
        ebl_par10_afskrivningsscenarie_tilknytning_a,
        ebl_par10_afskrivningsscenarie_tilknytning_a,
    ]
))

| ebl_par10_afskrivningsscenarie_sporer_ordinær_par21_før_samordning(resultat: EblPar10AfskrivningssamordningsResultat) -> match resultat.par21_resultat_før_samordning {
    | Some(par21) -> par21.par24_finder_anvendelse == Falskt && par21.beregnede_genvundne_afskrivninger_før_par24_kroner == 50000 && par21.skattepligtige_genvundne_afskrivninger_kroner == 50000
