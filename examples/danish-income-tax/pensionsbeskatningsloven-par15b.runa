# Pbl15BÅrsparameterKilde = Pbl15BSatser2010Til2017 | Pbl15BSatser2018Til2024 | Pbl15BSatser2025Til2026 | Pbl15BIngenKildedækning
# Pbl15BÅrsparametre(indkomstår: Heltal, understøttet: Boolsk, kilde: Pbl15BÅrsparameterKilde, samlet_indbetalingsloft_kroner: Heltal, årligt_rateudbetalingsloft_kroner: Heltal)

| pbl15b_årsparametre_med_kildedækning(indkomstår: Heltal, kilde: Pbl15BÅrsparameterKilde, samlet_indbetalingsloft_kroner: Heltal, årligt_rateudbetalingsloft_kroner: Heltal) -> Pbl15BÅrsparametre(
    indkomstår = indkomstår,
    understøttet = Sandt,
    kilde = kilde,
    samlet_indbetalingsloft_kroner = samlet_indbetalingsloft_kroner,
    årligt_rateudbetalingsloft_kroner = årligt_rateudbetalingsloft_kroner
)

| pbl15b_årsparametre_uden_kildedækning(indkomstår: Heltal) -> Pbl15BÅrsparametre(
    indkomstår = indkomstår,
    understøttet = Falskt,
    kilde = Pbl15BIngenKildedækning,
    samlet_indbetalingsloft_kroner = 0,
    årligt_rateudbetalingsloft_kroner = 0
)

--@label:pbl15b_årsparametre_2010_til_2017::source:skatteministeriet_pbl15b_satser_2010_til_2017--
