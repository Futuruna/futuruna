# Pbl15BOrdningsresultat(fakta: Pbl15BOrdningsfakta, fakta_gyldige: Boolsk, påtegning_aktiv: Boolsk, aldersbetingelse_opfyldt: Boolsk, udbetalingsplanresultat: Pbl15BUdbetalingsplanresultat, indbetaling_tilladt_efter_udbetaling: Boolsk, kvalificerer_til_sportspension: Boolsk)
