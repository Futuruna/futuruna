# Pbl15BUdbetalingsårsresultat(indkomstår: Heltal, grundlag: Pbl15BÅrsgrundlag, årsparametre: Pbl15BÅrsparametre, ordningsresultater: List(Pbl15BOrdningsresultat), rateudbetalingsresultater: List(Pbl15BRateudbetalingsresultat), ordningsidentifikationer_entydige: Boolsk, højst_en_ordning: Boolsk, rateidentifikationer_entydige: Boolsk, højst_en_rate_pr_ordning_pr_år: Boolsk, rater_fuldstændige_til_og_med_indkomståret: Boolsk, input_gyldigt: Boolsk, samlet_udbetalt_kroner: Heltal, samlet_inden_for_par15b_og_par20_kroner: Heltal, samlet_overskydende_efter_par15b_kroner: Heltal, samlet_skattepligtig_indkomst_efter_par20_kroner: Heltal, samlet_personlig_indkomst_efter_par20_kroner: Heltal, samlet_modregningspligtig_efter_ligningslov9l_kroner: Heltal, samlet_afgift_efter_par29_kroner: Heltal, samlet_resterende_ordinær_værdi_kroner: Heltal)
