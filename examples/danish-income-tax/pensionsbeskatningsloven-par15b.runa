    | 2026 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2026, kilde = Pbl15BSatser2025Til2026, samlet_indbetalingsloft_kroner = 2345800, årligt_rateudbetalingsloft_kroner = 469200)
