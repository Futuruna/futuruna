--@begin::pbl15b_årsparametre_2010_til_2017--
| pbl15b_årsparametre_2010_til_2017(indkomstår: Heltal) -> match indkomstår {
    | 2010 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2010, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1708500, årligt_rateudbetalingsloft_kroner = 341700)
    | 2011 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2011, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1708500, årligt_rateudbetalingsloft_kroner = 341700)
    | 2012 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2012, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1708500, årligt_rateudbetalingsloft_kroner = 341700)
    | 2013 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2013, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1708500, årligt_rateudbetalingsloft_kroner = 341700)
    | 2014 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2014, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1739300, årligt_rateudbetalingsloft_kroner = 347900)
    | 2015 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2015, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1764900, årligt_rateudbetalingsloft_kroner = 353000)
    | 2016 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2016, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1788800, årligt_rateudbetalingsloft_kroner = 357800)
    | 2017 -> pbl15b_årsparametre_med_kildedækning(indkomstår = 2017, kilde = Pbl15BSatser2010Til2017, samlet_indbetalingsloft_kroner = 1828100, årligt_rateudbetalingsloft_kroner = 365700)
    | _ -> pbl15b_årsparametre_uden_kildedækning(indkomstår)
}
--@end::pbl15b_årsparametre_2010_til_2017--

