@ sprog da

@ importer ./kalenderdato
@ importer ./metadata
@ importer ./pengebeloeb

# DødsboskattelovPar1Par30KildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst, ændringsstatus: Tekst)

