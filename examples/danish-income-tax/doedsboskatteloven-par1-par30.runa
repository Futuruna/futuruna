    identifier = "Den juridiske vejledning 2026-1, C.E.3.3.5.1.1: Skat for bobeskatningsperioden",
    hentet_dato = "2026-08-06",
    ændringsstatus = "Vejledningens 50-procentsberegning af positiv bobeskatningsindkomst er kontrolleret"
)
= dødsboskattelov_par30_forskudt_indkomstår_vejledning = DødsboskattelovPar1Par30KildeInfo(
    url = "https://info.skat.dk/data.aspx?oid=1847115",
    identifier = "Den juridiske vejledning 2026-1, C.E.3.3.6.2.1: Fradrag i dødsboskatten ved forskudt indkomstår",
    hentet_dato = "2026-08-08",
    ændringsstatus = "Bagudforskudte indkomstår bruger kalenderårets begyndelse; fremadforskudte indkomstår bruger dødsårets faktiske begyndelse"
)
= dødsboskattelov_par30_satser_2024_2026 = DødsboskattelovPar1Par30KildeInfo(
    url = "https://info.skat.dk/data.aspx?chk=220619&oid=2292849",
    identifier = "Den juridiske vejledning 2026-1, C.E.15.2: Oversigt over satser og grundbeløb 2024-2026",
    hentet_dato = "2026-08-08",
    ændringsstatus = "§ 30-satserne er kontrolleret til 6.900/2.500 kr. for dødsåret 2025 og 7.200/2.700 kr. for dødsåret 2026"
)

= dødsboskattelov_par1_metadata = Metadata(
    attachments = (
        Source(value = dødsboskattelov_par1_par30_lbk426),
