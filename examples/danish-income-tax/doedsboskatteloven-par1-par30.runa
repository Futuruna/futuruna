| dødsboskattelov30_kalenderårets_startdato(dødsdato: Dato) -> Dato(år = dødsdato.år, måned = 1, dag = 1)
| dødsboskattelov30_dødsårets_startdato(dødsdato: Dato, indkomstårsforhold: Dødsboskattelov30Indkomstårsforhold) -> match indkomstårsforhold {
    | Dbl30Kalenderindkomstår -> dødsboskattelov30_kalenderårets_startdato(dødsdato)
    | Dbl30BagudforskudtIndkomstår(dødsårets_startdato) -> dødsårets_startdato
    | Dbl30FremadforskudtIndkomstår(dødsårets_startdato) -> dødsårets_startdato
}
| dødsboskattelov30_fradragsstartdato_stk3_stk4(dødsdato: Dato, indkomstårsforhold: Dødsboskattelov30Indkomstårsforhold) -> match indkomstårsforhold {
    | Dbl30BagudforskudtIndkomstår(_) -> dødsboskattelov30_kalenderårets_startdato(dødsdato)
    | _ -> dødsboskattelov30_dødsårets_startdato(dødsdato, indkomstårsforhold)
}
| dødsboskattelov30_forskudt_indkomstår_begynder_første_i_måned(dødsårets_startdato: Dato) -> dødsårets_startdato.dag == 1
| dødsboskattelov30_indkomstårsforhold_gyldigt(dødsdato: Dato, indkomstårsforhold: Dødsboskattelov30Indkomstårsforhold) -> {
    = kalenderårets_startdato = dødsboskattelov30_kalenderårets_startdato(dødsdato)
    = tidligste_bagudforskudte_startdato = Dato(år = dødsdato.år - 1, måned = 3, dag = 1)
    = seneste_fremadforskudte_startdato = Dato(år = dødsdato.år, måned = 2, dag = 1)
    match indkomstårsforhold {
        | Dbl30Kalenderindkomstår -> Sandt
        | Dbl30BagudforskudtIndkomstår(dødsårets_startdato) -> dato_gyldig(dødsårets_startdato) && dødsboskattelov30_forskudt_indkomstår_begynder_første_i_måned(dødsårets_startdato) && dødsårets_startdato.år == dødsdato.år - 1 && dato_før_eller_lig_med(tidligste_bagudforskudte_startdato, dødsårets_startdato) && dato_før(dødsårets_startdato, kalenderårets_startdato)
        | Dbl30FremadforskudtIndkomstår(dødsårets_startdato) -> dato_gyldig(dødsårets_startdato) && dødsboskattelov30_forskudt_indkomstår_begynder_første_i_måned(dødsårets_startdato) && dødsårets_startdato.år == dødsdato.år && dato_efter(dødsårets_startdato, kalenderårets_startdato) && dato_før_eller_lig_med(dødsårets_startdato, seneste_fremadforskudte_startdato) && dato_før_eller_lig_med(dødsårets_startdato, dødsdato)
    }
}
| dødsboskattelov30_ægtefælleforhold_gyldigt(dødsdato: Dato, indkomstårsforhold: Dødsboskattelov30Indkomstårsforhold, ægtefælleforhold: Dødsboskattelov30Ægtefælleforhold) -> match ægtefælleforhold {
    | Dbl30IntetÆgtefælleforholdEfterPar62 -> Sandt
    | Dbl30TidligereAfdødÆgtefælleEfterPar62(førstafdødes_dødsdato, _) -> dato_gyldig(førstafdødes_dødsdato) && dato_før_eller_lig_med(dødsboskattelov30_dødsårets_startdato(dødsdato, indkomstårsforhold), førstafdødes_dødsdato) && dato_før(førstafdødes_dødsdato, dødsdato)
}
| dødsboskattelov30_datoer_gyldige(input: Dødsboskattelov30Input) -> dato_gyldig(input.dødsdato) && dato_gyldig(input.boopgørelsens_skæringsdag) && dato_før_eller_lig_med(input.dødsdato, input.boopgørelsens_skæringsdag)
| dødsboskattelov30_boopgørelsestype_understøttet(boopgørelsestype: Dødsboskattelov30Boopgørelsestype) -> boopgørelsestype == Dbl30OrdinærBoopgørelse
| dødsboskattelov30_input_gyldigt(input: Dødsboskattelov30Input) -> {
    = satser = dødsboskattelov30_regulerede_satser(input.dødsdato.år)
    satser.understøttet && dødsboskattelov30_datoer_gyldige(input) && dødsboskattelov30_boopgørelsestype_understøttet(input.boopgørelsestype) && dødsboskattelov30_indkomstårsforhold_gyldigt(input.dødsdato, input.indkomstårsforhold) && dødsboskattelov30_ægtefælleforhold_gyldigt(input.dødsdato, input.indkomstårsforhold, input.ægtefælleforhold) && dødsboskattelov32_aktieindkomstgrundlag_gyldigt(input.aktieindkomstgrundlag) && dødsboskattelov32_progressionsgrundlag_gyldigt(input.ægtefælleforhold, satser.aktieindkomst_progressionsgrænse_kroner)
}
| dødsboskattelov30_inklusive_påbegyndte_måneder(fra_dato: Dato, til_dato: Dato) -> hvis dato_før_eller_lig_med(fra_dato, til_dato) { dato_månedsindeks(til_dato) - dato_månedsindeks(fra_dato) + 1 } ellers { 0 }
| dødsboskattelov30_bofradragsmåneder_stk2(input: Dødsboskattelov30Input) -> hvis dødsboskattelov30_datoer_gyldige(input) {
    = måneder_efter_dødsmåneden = dato_månedsindeks(input.boopgørelsens_skæringsdag) - dato_månedsindeks(input.dødsdato)
    hvis måneder_efter_dødsmåneden < 12 { måneder_efter_dødsmåneden } ellers { 12 }
} ellers {
    0
}
| dødsboskattelov30_mellemperiodemåneder_stk3(input: Dødsboskattelov30Input) -> dødsboskattelov30_inklusive_påbegyndte_måneder(dødsboskattelov30_fradragsstartdato_stk3_stk4(input.dødsdato, input.indkomstårsforhold), input.dødsdato)
| dødsboskattelov30_ægtefællefradragsmåneder_stk4(input: Dødsboskattelov30Input) -> match input.ægtefælleforhold {
    | Dbl30IntetÆgtefælleforholdEfterPar62 -> 0
    | Dbl30TidligereAfdødÆgtefælleEfterPar62(førstafdødes_dødsdato, _) -> dødsboskattelov30_inklusive_påbegyndte_måneder(dødsboskattelov30_fradragsstartdato_stk3_stk4(input.dødsdato, input.indkomstårsforhold), førstafdødes_dødsdato)
}
| dødsboskattelov30_resultat(input: Dødsboskattelov30Input) -> {
    = regulerede_satser = dødsboskattelov30_regulerede_satser(input.dødsdato.år)
    = input_gyldigt = dødsboskattelov30_input_gyldigt(input)
    = datoer_gyldige = dødsboskattelov30_datoer_gyldige(input)
    = boopgørelsestype_understøttet = dødsboskattelov30_boopgørelsestype_understøttet(input.boopgørelsestype)
    = indkomstårsforhold_gyldigt = dødsboskattelov30_indkomstårsforhold_gyldigt(input.dødsdato, input.indkomstårsforhold)
    = ægtefælleforhold_gyldigt = dødsboskattelov30_ægtefælleforhold_gyldigt(input.dødsdato, input.indkomstårsforhold, input.ægtefælleforhold)
    = aktieindkomstgrundlag_gyldigt = dødsboskattelov32_aktieindkomstgrundlag_gyldigt(input.aktieindkomstgrundlag)
    = progressionsgrundlag_gyldigt = dødsboskattelov32_progressionsgrundlag_gyldigt(input.ægtefælleforhold, regulerede_satser.aktieindkomst_progressionsgrænse_kroner)
    = skattepligtigt_dødsbo = dødsboskattelov1_stk2_skattepligtigt_dødsbo(input.boform)
    = skatteberegning_efter_par30_og_par32_klar = input_gyldigt && skattepligtigt_dødsbo
    = bobeskatningsindkomstgrundlag_kroner = hvis skatteberegning_efter_par30_og_par32_klar { penge_positivt_beløb(input.bobeskatningsindkomst_kroner) } ellers { 0 }
    = bobeskatningsunderskud_kroner = hvis skatteberegning_efter_par30_og_par32_klar { penge_positivt_beløb(0 - input.bobeskatningsindkomst_kroner) } ellers { 0 }
    = dødsboskat_før_fradrag_kroner = penge_beløb_gange_basispoint_kroner(bobeskatningsindkomstgrundlag_kroner, dødsboskattelov30_sats_basispoint())
    = aktieskatteberegning = dødsboskattelov32_resultat(input.aktieindkomstgrundlag, bobeskatningsunderskud_kroner, regulerede_satser, input.ægtefælleforhold)
    = samlet_skat_før_nulgrænse_kroner = hvis skatteberegning_efter_par30_og_par32_klar { dødsboskat_før_fradrag_kroner + aktieskatteberegning.positiv_aktieskat_kroner - aktieskatteberegning.negativ_aktieskat_kroner } ellers { 0 }
    = samlet_skat_før_fradrag_kroner = penge_positivt_beløb(samlet_skat_før_nulgrænse_kroner)
    = overskydende_negativ_aktieskat_kroner = penge_positivt_beløb(0 - samlet_skat_før_nulgrænse_kroner)
    = resterende_negativ_bobeskatningsindkomst_kroner = bobeskatningsunderskud_kroner - aktieskatteberegning.bobeskatningsunderskud_modregnet_efter_par30_stk5_kroner
    = foreløbigt_carryback_efter_par31 = dødsboskattelov31_foreløbigt_carryback(resterende_negativ_bobeskatningsindkomst_kroner, overskydende_negativ_aktieskat_kroner)
    = carryback_efter_par31 = dødsboskattelov31_carryback_resultat(input, foreløbigt_carryback_efter_par31)
    = beregningsklar = skatteberegning_efter_par30_og_par32_klar && carryback_efter_par31.beregningsklar
    = bofradragsmåneder_stk2 = hvis input_gyldigt { dødsboskattelov30_bofradragsmåneder_stk2(input) } ellers { 0 }
    = mellemperiodemåneder_stk3 = hvis input_gyldigt { dødsboskattelov30_mellemperiodemåneder_stk3(input) } ellers { 0 }
    = ægtefællefradragsmåneder_stk4 = hvis input_gyldigt { dødsboskattelov30_ægtefællefradragsmåneder_stk4(input) } ellers { 0 }
    = bofradrag_stk2_kroner = bofradragsmåneder_stk2 * regulerede_satser.bofradrag_pr_måned_kroner
    = mellemperiodefradrag_stk3_kroner = mellemperiodemåneder_stk3 * regulerede_satser.mellemperiodefradrag_pr_måned_kroner
    = ægtefællefradrag_stk4_kroner = ægtefællefradragsmåneder_stk4 * regulerede_satser.mellemperiodefradrag_pr_måned_kroner
    = samlede_fradrag_kroner = bofradrag_stk2_kroner + mellemperiodefradrag_stk3_kroner + ægtefællefradrag_stk4_kroner
    = anvendte_fradrag_kroner = hvis beregningsklar { penge_mindste_beløb(samlede_fradrag_kroner, samlet_skat_før_fradrag_kroner) } ellers { 0 }
    = samlet_skat_efter_fradrag_kroner = hvis beregningsklar { samlet_skat_før_fradrag_kroner - anvendte_fradrag_kroner } ellers { 0 }
    Dødsboskattelov30Resultat(
        input = input,
        input_gyldigt = input_gyldigt,
        skatteår_understøttet = regulerede_satser.understøttet,
        datoer_gyldige = datoer_gyldige,
        boopgørelsestype_understøttet = boopgørelsestype_understøttet,
        indkomstårsforhold_gyldigt = indkomstårsforhold_gyldigt,
        ægtefælleforhold_gyldigt = ægtefælleforhold_gyldigt,
        aktieindkomstgrundlag_gyldigt = aktieindkomstgrundlag_gyldigt,
        progressionsgrundlag_gyldigt = progressionsgrundlag_gyldigt,
        skattepligtigt_dødsbo_efter_par1_stk2 = skattepligtigt_dødsbo,
        skatteberegning_efter_par30_og_par32_klar = skatteberegning_efter_par30_og_par32_klar,
        beregningsklar = beregningsklar,
        regulerede_satser = regulerede_satser,
        bobeskatningsindkomstgrundlag_kroner = bobeskatningsindkomstgrundlag_kroner,
        bobeskatningsunderskud_kroner = bobeskatningsunderskud_kroner,
        dødsboskattesats_basispoint = dødsboskattelov30_sats_basispoint(),
        dødsboskat_før_fradrag_kroner = dødsboskat_før_fradrag_kroner,
        aktieskatteberegning = aktieskatteberegning,
        samlet_skat_før_fradrag_kroner = samlet_skat_før_fradrag_kroner,
        bofradragsmåneder_stk2 = bofradragsmåneder_stk2,
        mellemperiodemåneder_stk3 = mellemperiodemåneder_stk3,
        ægtefællefradragsmåneder_stk4 = ægtefællefradragsmåneder_stk4,
        bofradrag_stk2_kroner = bofradrag_stk2_kroner,
        mellemperiodefradrag_stk3_kroner = mellemperiodefradrag_stk3_kroner,
        ægtefællefradrag_stk4_kroner = ægtefællefradrag_stk4_kroner,
        samlede_fradrag_kroner = samlede_fradrag_kroner,
        anvendte_fradrag_kroner = anvendte_fradrag_kroner,
        samlet_skat_efter_fradrag_kroner = samlet_skat_efter_fradrag_kroner,
        dødsboskat_efter_fradrag_kroner = samlet_skat_efter_fradrag_kroner,
        foreløbigt_carryback_efter_par31 = foreløbigt_carryback_efter_par31,
        carryback_efter_par31 = carryback_efter_par31
    )
}
--@end::dødsboskattelov_par30--

= dødsboskattelov_par31_metadata = Metadata(
    attachments = (
        Source(value = dødsboskattelov_par1_par30_lbk426),
        Guidance(value = dødsboskattelov_par31_carryback_vejledning),
        Guidance(value = dødsboskattelov_par30_beregningsskema_vejledning),
        Guidance(value = dødsboskattelov_par31_særbo_fællesbo_vejledning),
        PreparatoryWork(value = dødsboskattelov_par31_særbo_fællesbo_l159_bemærkninger),
    )
)

--@label:dødsboskattelov_par31::meta:dødsboskattelov_par31_metadata--
----
§ 31. Hvis bobeskatningsindkomsten efter modregning af eventuel positiv aktieindkomst i bobeskatningsperioden udviser et underskud, udbetales et beløb svarende til 30 pct. af det resterende beløb til boet. Endvidere udbetales resterende negativ aktieskat efter § 30, stk. 1, 4. pkt.

Stk. 2. Den samlede udbetaling efter stk. 1 kan dog ikke overstige summen af de skatter, afdøde har betalt af skattepligtig indkomst og aktieindkomst i de to senest afsluttede indkomstår forud for dødsfaldet, samt de skatter, en længstlevende ægtefælle har betalt af skattepligtig indkomst og aktieindkomst i de to senest afsluttede indkomstår før dødsfaldet, i dødsåret og i indkomstår, der fuldt ud omfattes af boperioden.

Stk. 3. Skat af indkomst, som er valgt beskattet efter bestemmelsen i kildeskattelovens §§ 48 E og 48 F, indgår ikke ved opgørelsen af betalte skatter efter stk. 2.

Stk. 4. Var afdøde gift ved dødsfaldet, og skiftes afdødes andel af fællesboet og afdødes særbo hver for sig, fordeles udbetaling efter stk. 1 mellem de to boer efter forholdet mellem summen af bobeskatningsindkomst og aktieindkomst i bobeskatningsperioden i de to boer. Har det ene bo positiv sum af bobeskatningsindkomst og aktieindkomst i bobeskatningsperioden og det andet negativ sum, udbetales hele beløbet til det bo, der har negativ sum.
----

--@begin::dødsboskattelov_par31--
# Dødsboskattelov31LængstlevendeÆgtefælleforhold = Dbl31IngenLængstlevendeÆgtefælle | Dbl31LængstlevendeÆgtefælle(identifikation: Tekst)
# Dødsboskattelov31Skatteperson = Dbl31Afdøde | Dbl31LængstlevendeÆgtefælle
# Dødsboskattelov31BetaltÅrsskat(person: Dødsboskattelov31Skatteperson, indkomstår: Heltal, skat_af_skattepligtig_indkomst_kroner: Heltal, skat_af_aktieindkomst_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal, heraf_skat_efter_kildeskattelov48e_48f_kroner: Heltal, dokumentreference: Tekst)
# Dødsboskattelov31Boindkomstkilde(bobeskatningsindkomst_kroner: Heltal, aktieindkomst_kroner: Heltal, boopgørelsens_skæringsdag: Dato, dokumentreference: Tekst)
# Dødsboskattelov31Bofordelingsgrundlag = Dbl31EtSamletDødsbo | Dbl31FællesboOgSærboSkiftesHverForSig(fællesbo: Dødsboskattelov31Boindkomstkilde, særbo: Dødsboskattelov31Boindkomstkilde)
# Dødsboskattelov31Carrybackgrundlag = Dbl31IngenDokumenteretCarrybackgrundlag | Dbl31DokumenteretCarrybackgrundlag(længstlevende_ægtefælleforhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold, betalte_årsskatter: List(Dødsboskattelov31BetaltÅrsskat), bofordelingsgrundlag: Dødsboskattelov31Bofordelingsgrundlag)
# Dødsboskattelov31ForeløbigtCarrybackResultat(resterende_negativ_bobeskatningsindkomst_kroner: Heltal, underskudsskat_med_30_procent_kroner: Heltal, overskydende_negativ_aktieskat_kroner: Heltal, foreløbigt_tilbagebetalingsbeløb_før_historikloft_kroner: Heltal, kræver_komplet_skattehistorik: Boolsk)
# Dødsboskattelov31Fordelingsresultat(grundlag: Dødsboskattelov31Bofordelingsgrundlag, grundlag_gyldigt: Boolsk, fællesboets_bobeskatningsperiode_gyldig: Boolsk, særboets_bobeskatningsperiode_gyldig: Boolsk, skæringsdage_afstemt: Boolsk, bobeskatningsindkomst_afstemt: Boolsk, aktieindkomst_afstemt: Boolsk, fællesboets_indkomstsum_kroner: Heltal, særboets_indkomstsum_kroner: Heltal, udbetaling_til_samlet_dødsbo_kroner: Heltal, udbetaling_til_fællesbo_kroner: Heltal, udbetaling_til_særbo_kroner: Heltal)
# Dødsboskattelov31CarrybackResultat(grundlag: Dødsboskattelov31Carrybackgrundlag, foreløbigt_carryback: Dødsboskattelov31ForeløbigtCarrybackResultat, historik_påkrævet: Boolsk, historik_tilstede: Boolsk, forventet_antal_årsskatter: Heltal, oplyst_antal_årsskatter: Heltal, årsskatter_gyldige: Boolsk, historik_komplet: Boolsk, bofordelingsgrundlag_gyldigt: Boolsk, betalte_skatter_før_par31_stk3_kroner: Heltal, udelukket_skat_efter_kildeskattelov48e_48f_kroner: Heltal, historikloft_efter_stk2_stk3_kroner: Heltal, udbetaling_efter_historikloft_kroner: Heltal, fordeling_efter_stk4: Dødsboskattelov31Fordelingsresultat, beregningsklar: Boolsk)

| dødsboskattelov31_underskudsskat_basispoint() -> 3000
| dødsboskattelov31_foreløbigt_carryback(resterende_negativ_bobeskatningsindkomst_kroner: Heltal, overskydende_negativ_aktieskat_kroner: Heltal) -> {
    = resterende_underskud_kroner = penge_positivt_beløb(resterende_negativ_bobeskatningsindkomst_kroner)
    = overskydende_aktieskat_kroner = penge_positivt_beløb(overskydende_negativ_aktieskat_kroner)
    = underskudsskat_kroner = penge_beløb_gange_basispoint_kroner(resterende_underskud_kroner, dødsboskattelov31_underskudsskat_basispoint())
    = foreløbigt_tilbagebetalingsbeløb_kroner = underskudsskat_kroner + overskydende_aktieskat_kroner
    Dødsboskattelov31ForeløbigtCarrybackResultat(
        resterende_negativ_bobeskatningsindkomst_kroner = resterende_underskud_kroner,
        underskudsskat_med_30_procent_kroner = underskudsskat_kroner,
        overskydende_negativ_aktieskat_kroner = overskydende_aktieskat_kroner,
        foreløbigt_tilbagebetalingsbeløb_før_historikloft_kroner = foreløbigt_tilbagebetalingsbeløb_kroner,
        kræver_komplet_skattehistorik = foreløbigt_tilbagebetalingsbeløb_kroner > 0
    )
}
| dødsboskattelov31_længstlevende_ægtefælle_tilstede(forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> match forhold {
    | Dbl31IngenLængstlevendeÆgtefælle -> Falskt
    | Dbl31LængstlevendeÆgtefælle(_) -> Sandt
}
| dødsboskattelov31_længstlevende_ægtefælleforhold_gyldigt(forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> match forhold {
    | Dbl31IngenLængstlevendeÆgtefælle -> Sandt
    | Dbl31LængstlevendeÆgtefælle(identifikation) -> identifikation != ""
}
| dødsboskattelov31_fulde_indkomstår_i_boperioden(input: Dødsboskattelov30Input) -> {
    = hele_år_efter_dødsåret = input.boopgørelsens_skæringsdag.år - input.dødsdato.år
    = skæringsåret_fuldt_omfattet = input.boopgørelsens_skæringsdag.måned == 12 && input.boopgørelsens_skæringsdag.dag == 31
    penge_positivt_beløb(hele_år_efter_dødsåret - hvis skæringsåret_fuldt_omfattet { 0 } ellers { 1 })
}
| dødsboskattelov31_forventet_antal_årsskatter(input: Dødsboskattelov30Input, forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> 2 + hvis dødsboskattelov31_længstlevende_ægtefælle_tilstede(forhold) { 3 + dødsboskattelov31_fulde_indkomstår_i_boperioden(input) } ellers { 0 }
| dødsboskattelov31_år_er_et_af_to_senest_afsluttede_før_dødsfaldet(indkomstår: Heltal, dødsår: Heltal) -> indkomstår == dødsår - 2 || indkomstår == dødsår - 1
| dødsboskattelov31_år_fuldt_omfattet_af_boperioden(indkomstår: Heltal, input: Dødsboskattelov30Input) -> indkomstår > input.dødsdato.år && dato_før_eller_lig_med(Dato(år = indkomstår, måned = 12, dag = 31), input.boopgørelsens_skæringsdag)
| dødsboskattelov31_årsskat_hører_til_påkrævet_periode(årsskat: Dødsboskattelov31BetaltÅrsskat, input: Dødsboskattelov30Input, forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> match årsskat.person {
    | Dbl31Afdøde -> dødsboskattelov31_år_er_et_af_to_senest_afsluttede_før_dødsfaldet(årsskat.indkomstår, input.dødsdato.år)
    | Dbl31LængstlevendeÆgtefælle -> dødsboskattelov31_længstlevende_ægtefælle_tilstede(forhold) && (dødsboskattelov31_år_er_et_af_to_senest_afsluttede_før_dødsfaldet(årsskat.indkomstår, input.dødsdato.år) || årsskat.indkomstår == input.dødsdato.år || dødsboskattelov31_år_fuldt_omfattet_af_boperioden(årsskat.indkomstår, input))
}
| dødsboskattelov31_betalt_skat_før_par31_stk3_kroner(årsskat: Dødsboskattelov31BetaltÅrsskat) -> årsskat.skat_af_skattepligtig_indkomst_kroner + årsskat.skat_af_aktieindkomst_kroner + årsskat.arbejdsmarkedsbidrag_kroner
| dødsboskattelov31_betalt_årsskat_gyldig(årsskat: Dødsboskattelov31BetaltÅrsskat, input: Dødsboskattelov30Input, forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> årsskat.indkomstår > 0 && årsskat.skat_af_skattepligtig_indkomst_kroner >= 0 && årsskat.skat_af_aktieindkomst_kroner >= 0 && årsskat.arbejdsmarkedsbidrag_kroner >= 0 && årsskat.heraf_skat_efter_kildeskattelov48e_48f_kroner >= 0 && årsskat.heraf_skat_efter_kildeskattelov48e_48f_kroner <= dødsboskattelov31_betalt_skat_før_par31_stk3_kroner(årsskat) && årsskat.dokumentreference != "" && dødsboskattelov31_årsskat_hører_til_påkrævet_periode(årsskat, input, forhold)
| dødsboskattelov31_årsskat_unik(årsskatter: List(Dødsboskattelov31BetaltÅrsskat), årsskat: Dødsboskattelov31BetaltÅrsskat) -> foldl(årsskatter, 0, |antal: Heltal, anden: Dødsboskattelov31BetaltÅrsskat| antal + hvis anden.person == årsskat.person && anden.indkomstår == årsskat.indkomstår { 1 } ellers { 0 }) == 1
| dødsboskattelov31_årsskatter_gyldige(årsskatter: List(Dødsboskattelov31BetaltÅrsskat), input: Dødsboskattelov30Input, forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> all(årsskatter, |årsskat: Dødsboskattelov31BetaltÅrsskat| dødsboskattelov31_betalt_årsskat_gyldig(årsskat, input, forhold) && dødsboskattelov31_årsskat_unik(årsskatter, årsskat))
| dødsboskattelov31_historik_komplet(årsskatter: List(Dødsboskattelov31BetaltÅrsskat), input: Dødsboskattelov30Input, forhold: Dødsboskattelov31LængstlevendeÆgtefælleforhold) -> dødsboskattelov31_længstlevende_ægtefælleforhold_gyldigt(forhold) && length(årsskatter) == dødsboskattelov31_forventet_antal_årsskatter(input, forhold) && dødsboskattelov31_årsskatter_gyldige(årsskatter, input, forhold)
| dødsboskattelov31_betalte_skatter_før_par31_stk3_kroner(årsskatter: List(Dødsboskattelov31BetaltÅrsskat)) -> foldl(årsskatter, 0, |sum: Heltal, årsskat: Dødsboskattelov31BetaltÅrsskat| sum + dødsboskattelov31_betalt_skat_før_par31_stk3_kroner(årsskat))
| dødsboskattelov31_udelukket_skat_efter_kildeskattelov48e_48f_kroner(årsskatter: List(Dødsboskattelov31BetaltÅrsskat)) -> foldl(årsskatter, 0, |sum: Heltal, årsskat: Dødsboskattelov31BetaltÅrsskat| sum + årsskat.heraf_skat_efter_kildeskattelov48e_48f_kroner)
| dødsboskattelov31_absolut_beløb_kroner(beløb_kroner: Heltal) -> hvis beløb_kroner < 0 { 0 - beløb_kroner } ellers { beløb_kroner }
| dødsboskattelov31_boindkomstkilde_periode_gyldig(kilde: Dødsboskattelov31Boindkomstkilde, dødsdato: Dato) -> dato_gyldig(kilde.boopgørelsens_skæringsdag) && dato_før_eller_lig_med(dødsdato, kilde.boopgørelsens_skæringsdag)
| dødsboskattelov31_boindkomstkilde_gyldig(kilde: Dødsboskattelov31Boindkomstkilde, dødsdato: Dato) -> dødsboskattelov31_boindkomstkilde_periode_gyldig(kilde, dødsdato) && kilde.dokumentreference != ""
| dødsboskattelov31_skæringsdage_afstemt(fællesbo: Dødsboskattelov31Boindkomstkilde, særbo: Dødsboskattelov31Boindkomstkilde, samlet_skæringsdag: Dato) -> dato_gyldig(fællesbo.boopgørelsens_skæringsdag) && dato_gyldig(særbo.boopgørelsens_skæringsdag) && dato_gyldig(samlet_skæringsdag) && dato_før_eller_lig_med(fællesbo.boopgørelsens_skæringsdag, samlet_skæringsdag) && dato_før_eller_lig_med(særbo.boopgørelsens_skæringsdag, samlet_skæringsdag) && (fællesbo.boopgørelsens_skæringsdag == samlet_skæringsdag || særbo.boopgørelsens_skæringsdag == samlet_skæringsdag)
| dødsboskattelov31_bobeskatningsindkomst_afstemt(fællesbo: Dødsboskattelov31Boindkomstkilde, særbo: Dødsboskattelov31Boindkomstkilde, samlet_bobeskatningsindkomst_kroner: Heltal) -> fællesbo.bobeskatningsindkomst_kroner + særbo.bobeskatningsindkomst_kroner == samlet_bobeskatningsindkomst_kroner
| dødsboskattelov31_aktieindkomst_afstemt(fællesbo: Dødsboskattelov31Boindkomstkilde, særbo: Dødsboskattelov31Boindkomstkilde, samlet_aktieindkomst_kroner: Heltal) -> fællesbo.aktieindkomst_kroner + særbo.aktieindkomst_kroner == samlet_aktieindkomst_kroner
| dødsboskattelov31_bofordelingsgrundlag_kilder_gyldige(grundlag: Dødsboskattelov31Bofordelingsgrundlag, input: Dødsboskattelov30Input) -> match grundlag {
    | Dbl31EtSamletDødsbo -> Sandt
    | Dbl31FællesboOgSærboSkiftesHverForSig(fællesbo, særbo) -> dødsboskattelov31_boindkomstkilde_gyldig(kilde = fællesbo, dødsdato = input.dødsdato) && dødsboskattelov31_boindkomstkilde_gyldig(kilde = særbo, dødsdato = input.dødsdato) && dødsboskattelov31_skæringsdage_afstemt(fællesbo = fællesbo, særbo = særbo, samlet_skæringsdag = input.boopgørelsens_skæringsdag) && dødsboskattelov31_bobeskatningsindkomst_afstemt(fællesbo = fællesbo, særbo = særbo, samlet_bobeskatningsindkomst_kroner = input.bobeskatningsindkomst_kroner) && dødsboskattelov31_aktieindkomst_afstemt(fællesbo = fællesbo, særbo = særbo, samlet_aktieindkomst_kroner = dødsboskattelov32_aktieindkomst_kroner(input.aktieindkomstgrundlag))
}
| dødsboskattelov31_fordeling_efter_stk4(input: Dødsboskattelov30Input, grundlag: Dødsboskattelov31Bofordelingsgrundlag, samlet_udbetaling_kroner: Heltal) -> match grundlag {
    | Dbl31EtSamletDødsbo -> Dødsboskattelov31Fordelingsresultat(
        grundlag = grundlag,
        grundlag_gyldigt = Sandt,
        fællesboets_bobeskatningsperiode_gyldig = Sandt,
        særboets_bobeskatningsperiode_gyldig = Sandt,
        skæringsdage_afstemt = Sandt,
        bobeskatningsindkomst_afstemt = Sandt,
        aktieindkomst_afstemt = Sandt,
        fællesboets_indkomstsum_kroner = 0,
        særboets_indkomstsum_kroner = 0,
        udbetaling_til_samlet_dødsbo_kroner = penge_positivt_beløb(samlet_udbetaling_kroner),
        udbetaling_til_fællesbo_kroner = 0,
        udbetaling_til_særbo_kroner = 0
    )
    | Dbl31FællesboOgSærboSkiftesHverForSig(fællesbo, særbo) -> {
        = udbetaling_kroner = penge_positivt_beløb(samlet_udbetaling_kroner)
        = fællesboets_indkomstsum_kroner = fællesbo.bobeskatningsindkomst_kroner + fællesbo.aktieindkomst_kroner
        = særboets_indkomstsum_kroner = særbo.bobeskatningsindkomst_kroner + særbo.aktieindkomst_kroner
        = fællesbo_positivt_særbo_negativt = fællesboets_indkomstsum_kroner > 0 && særboets_indkomstsum_kroner < 0
        = fællesbo_negativt_særbo_positivt = fællesboets_indkomstsum_kroner < 0 && særboets_indkomstsum_kroner > 0
        = forholdsnævner_kroner = dødsboskattelov31_absolut_beløb_kroner(fællesboets_indkomstsum_kroner) + dødsboskattelov31_absolut_beløb_kroner(særboets_indkomstsum_kroner)
        = fællesboets_bobeskatningsperiode_gyldig = dødsboskattelov31_boindkomstkilde_periode_gyldig(kilde = fællesbo, dødsdato = input.dødsdato)
        = særboets_bobeskatningsperiode_gyldig = dødsboskattelov31_boindkomstkilde_periode_gyldig(kilde = særbo, dødsdato = input.dødsdato)
        = skæringsdage_afstemt = dødsboskattelov31_skæringsdage_afstemt(fællesbo = fællesbo, særbo = særbo, samlet_skæringsdag = input.boopgørelsens_skæringsdag)
        = bobeskatningsindkomst_afstemt = dødsboskattelov31_bobeskatningsindkomst_afstemt(fællesbo = fællesbo, særbo = særbo, samlet_bobeskatningsindkomst_kroner = input.bobeskatningsindkomst_kroner)
        = aktieindkomst_afstemt = dødsboskattelov31_aktieindkomst_afstemt(fællesbo = fællesbo, særbo = særbo, samlet_aktieindkomst_kroner = dødsboskattelov32_aktieindkomst_kroner(input.aktieindkomstgrundlag))
        = kilder_gyldige = dødsboskattelov31_bofordelingsgrundlag_kilder_gyldige(grundlag, input)
        = fordeling_mulig = udbetaling_kroner == 0 || fællesbo_positivt_særbo_negativt || fællesbo_negativt_særbo_positivt || forholdsnævner_kroner > 0
        = grundlag_gyldigt = kilder_gyldige && fordeling_mulig
        = udbetaling_til_fællesbo_kroner = hvis !grundlag_gyldigt { 0 } ellers { hvis fællesbo_positivt_særbo_negativt { 0 } ellers { hvis fællesbo_negativt_særbo_positivt { udbetaling_kroner } ellers { hvis forholdsnævner_kroner > 0 { udbetaling_kroner * dødsboskattelov31_absolut_beløb_kroner(fællesboets_indkomstsum_kroner) / forholdsnævner_kroner } ellers { 0 } } } }
        = udbetaling_til_særbo_kroner = hvis grundlag_gyldigt { udbetaling_kroner - udbetaling_til_fællesbo_kroner } ellers { 0 }
        Dødsboskattelov31Fordelingsresultat(
            grundlag = grundlag,
            grundlag_gyldigt = grundlag_gyldigt,
            fællesboets_bobeskatningsperiode_gyldig = fællesboets_bobeskatningsperiode_gyldig,
            særboets_bobeskatningsperiode_gyldig = særboets_bobeskatningsperiode_gyldig,
            skæringsdage_afstemt = skæringsdage_afstemt,
            bobeskatningsindkomst_afstemt = bobeskatningsindkomst_afstemt,
            aktieindkomst_afstemt = aktieindkomst_afstemt,
            fællesboets_indkomstsum_kroner = fællesboets_indkomstsum_kroner,
            særboets_indkomstsum_kroner = særboets_indkomstsum_kroner,
            udbetaling_til_samlet_dødsbo_kroner = 0,
            udbetaling_til_fællesbo_kroner = udbetaling_til_fællesbo_kroner,
            udbetaling_til_særbo_kroner = udbetaling_til_særbo_kroner
        )
    }
}
| dødsboskattelov31_carryback_resultat(input: Dødsboskattelov30Input, foreløbigt_carryback: Dødsboskattelov31ForeløbigtCarrybackResultat) -> match input.carrybackgrundlag {
    | Dbl31IngenDokumenteretCarrybackgrundlag -> {
        = historik_påkrævet = foreløbigt_carryback.kræver_komplet_skattehistorik
        = fordeling = dødsboskattelov31_fordeling_efter_stk4(input, Dbl31EtSamletDødsbo, 0)
        Dødsboskattelov31CarrybackResultat(
            grundlag = input.carrybackgrundlag,
            foreløbigt_carryback = foreløbigt_carryback,
            historik_påkrævet = historik_påkrævet,
            historik_tilstede = Falskt,
            forventet_antal_årsskatter = 0,
            oplyst_antal_årsskatter = 0,
            årsskatter_gyldige = !historik_påkrævet,
            historik_komplet = !historik_påkrævet,
            bofordelingsgrundlag_gyldigt = !historik_påkrævet,
            betalte_skatter_før_par31_stk3_kroner = 0,
            udelukket_skat_efter_kildeskattelov48e_48f_kroner = 0,
            historikloft_efter_stk2_stk3_kroner = 0,
            udbetaling_efter_historikloft_kroner = 0,
            fordeling_efter_stk4 = fordeling,
            beregningsklar = !historik_påkrævet
        )
    }
    | Dbl31DokumenteretCarrybackgrundlag(længstlevende_ægtefælleforhold, betalte_årsskatter, bofordelingsgrundlag) -> {
        = forventet_antal_årsskatter = dødsboskattelov31_forventet_antal_årsskatter(input, længstlevende_ægtefælleforhold)
        = årsskatter_gyldige = dødsboskattelov31_årsskatter_gyldige(betalte_årsskatter, input, længstlevende_ægtefælleforhold)
        = historik_komplet = dødsboskattelov31_historik_komplet(betalte_årsskatter, input, længstlevende_ægtefælleforhold)
        = betalte_skatter_før_par31_stk3_kroner = hvis historik_komplet { dødsboskattelov31_betalte_skatter_før_par31_stk3_kroner(betalte_årsskatter) } ellers { 0 }
        = udelukket_skat_efter_kildeskattelov48e_48f_kroner = hvis historik_komplet { dødsboskattelov31_udelukket_skat_efter_kildeskattelov48e_48f_kroner(betalte_årsskatter) } ellers { 0 }
        = historikloft_efter_stk2_stk3_kroner = betalte_skatter_før_par31_stk3_kroner - udelukket_skat_efter_kildeskattelov48e_48f_kroner
        = foreløbig_fordelingskontrol = dødsboskattelov31_fordeling_efter_stk4(input, bofordelingsgrundlag, 0)
        = grundlag_gyldigt = historik_komplet && foreløbig_fordelingskontrol.grundlag_gyldigt
        = udbetaling_efter_historikloft_kroner = hvis grundlag_gyldigt { penge_mindste_beløb(foreløbigt_carryback.foreløbigt_tilbagebetalingsbeløb_før_historikloft_kroner, historikloft_efter_stk2_stk3_kroner) } ellers { 0 }
        = fordeling = dødsboskattelov31_fordeling_efter_stk4(input, bofordelingsgrundlag, udbetaling_efter_historikloft_kroner)
        Dødsboskattelov31CarrybackResultat(
            grundlag = input.carrybackgrundlag,
            foreløbigt_carryback = foreløbigt_carryback,
            historik_påkrævet = foreløbigt_carryback.kræver_komplet_skattehistorik,
            historik_tilstede = Sandt,
            forventet_antal_årsskatter = forventet_antal_årsskatter,
            oplyst_antal_årsskatter = length(betalte_årsskatter),
            årsskatter_gyldige = årsskatter_gyldige,
            historik_komplet = historik_komplet,
            bofordelingsgrundlag_gyldigt = fordeling.grundlag_gyldigt,
            betalte_skatter_før_par31_stk3_kroner = betalte_skatter_før_par31_stk3_kroner,
            udelukket_skat_efter_kildeskattelov48e_48f_kroner = udelukket_skat_efter_kildeskattelov48e_48f_kroner,
            historikloft_efter_stk2_stk3_kroner = historikloft_efter_stk2_stk3_kroner,
            udbetaling_efter_historikloft_kroner = udbetaling_efter_historikloft_kroner,
            fordeling_efter_stk4 = fordeling,
            beregningsklar = grundlag_gyldigt && fordeling.grundlag_gyldigt
        )
    }
}
--@end::dødsboskattelov_par31--

= dødsboskattelov_par32_metadata = Metadata(
    attachments = (
        Source(value = dødsboskattelov_par1_par30_lbk426),
        Guidance(value = dødsboskattelov_par32_aktieindkomst_vejledning),
        Guidance(value = dødsboskattelov_par30_satser_2023_2024),
        Guidance(value = dødsboskattelov_par30_satser_2024_2026),
    )
)

--@label:dødsboskattelov_par32::meta:dødsboskattelov_par32_metadata--
----
§ 32. Skat af afdødes aktieindkomst i bobeskatningsperioden nedsat med eventuelt underskud i bobeskatningsindkomsten, jf. § 30, stk. 5, beregnes således:

1) 27 pct. af beløb, der ikke overstiger beløbsgrænsen i personskattelovens § 8 a, stk. 1, og

2) 42 pct. af beløb, der overstiger beløbsgrænsen i personskattelovens § 8 a, stk. 1.

Stk. 2. Den indeholdte udbytteskat efter kildeskattelovens § 65 indgår ved opgørelsen af de foreløbige indkomstskattebeløb i § 30 a, stk. 4.

Stk. 3. Er aktieindkomsten negativ, beregnes negativ skat med

1) 27 pct. af beløb, der ikke overstiger beløbsgrænsen i personskattelovens § 8 a, stk. 1, og

2) 42 pct. af beløb, der overstiger beløbsgrænsen i personskattelovens § 8 a, stk. 1.

Stk. 4. Skulle afdøde tillige have været beskattet af en tidligere afdød ægtefælles indkomst efter § 62, fordobles beløbsgrænsen efter personskattelovens § 8 a, stk. 1 og 2, ved anvendelsen af stk. 1-3.
----

--@begin::dødsboskattelov_par32--
# Dødsboskattelov32Aktieindkomstgrundlag = Dbl32IngenAktieindkomst | Dbl32OpgjortAktieindkomstEfterPar21(aktieindkomst_kroner: Heltal, dokumentreference: Tekst)
# Dødsboskattelov32Resultat(grundlag: Dødsboskattelov32Aktieindkomstgrundlag, grundlag_gyldigt: Boolsk, progressionsgrundlag_gyldigt: Boolsk, aktieindkomst_før_par30_stk5_kroner: Heltal, bobeskatningsunderskud_modregnet_efter_par30_stk5_kroner: Heltal, aktieindkomst_efter_par30_stk5_kroner: Heltal, progressionsgrænse_før_par67_stk7_kroner: Heltal, anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner: Heltal, effektiv_progressionsgrænse_kroner: Heltal, lavt_skattegrundlag_kroner: Heltal, højt_skattegrundlag_kroner: Heltal, lav_sats_basispoint: Heltal, høj_sats_basispoint: Heltal, positiv_aktieskat_kroner: Heltal, negativ_aktieskat_kroner: Heltal)

| dødsboskattelov32_aktieindkomstgrundlag_gyldigt(grundlag: Dødsboskattelov32Aktieindkomstgrundlag) -> match grundlag {
    | Dbl32IngenAktieindkomst -> Sandt
    | Dbl32OpgjortAktieindkomstEfterPar21(_, dokumentreference) -> dokumentreference != ""
}
| dødsboskattelov32_aktieindkomst_kroner(grundlag: Dødsboskattelov32Aktieindkomstgrundlag) -> match grundlag {
    | Dbl32IngenAktieindkomst -> 0
    | Dbl32OpgjortAktieindkomstEfterPar21(aktieindkomst_kroner, _) -> aktieindkomst_kroner
}
| dødsboskattelov32_progressionsgrænsemultiplikator(ægtefælleforhold: Dødsboskattelov30Ægtefælleforhold) -> match ægtefælleforhold {
    | Dbl30IntetÆgtefælleforholdEfterPar62 -> 1
    | Dbl30TidligereAfdødÆgtefælleEfterPar62(_, _) -> 2
}
| dødsboskattelov32_progressionsgrundlag_gyldigt(ægtefælleforhold: Dødsboskattelov30Ægtefælleforhold, ordinær_progressionsgrænse_kroner: Heltal) -> match ægtefælleforhold {
    | Dbl30IntetÆgtefælleforholdEfterPar62 -> Sandt
    | Dbl30TidligereAfdødÆgtefælleEfterPar62(_, par67_stk7_progressionsforhold) -> dødsboskattelov67_stk7_progressionsforhold_gyldigt(par67_stk7_progressionsforhold, ordinær_progressionsgrænse_kroner)
}
| dødsboskattelov32_anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner(ægtefælleforhold: Dødsboskattelov30Ægtefælleforhold) -> match ægtefælleforhold {
    | Dbl30IntetÆgtefælleforholdEfterPar62 -> 0
    | Dbl30TidligereAfdødÆgtefælleEfterPar62(_, par67_stk7_progressionsforhold) -> dødsboskattelov67_stk7_anvendt_ekstra_progressionsgrænse_kroner(par67_stk7_progressionsforhold)
}
| dødsboskattelov32_resultat(grundlag: Dødsboskattelov32Aktieindkomstgrundlag, bobeskatningsunderskud_kroner: Heltal, satser: Dødsboskattelov30ReguleredeSatser, ægtefælleforhold: Dødsboskattelov30Ægtefælleforhold) -> {
    = aktieindkomstgrundlag_gyldigt = dødsboskattelov32_aktieindkomstgrundlag_gyldigt(grundlag)
    = progressionsgrundlag_gyldigt = dødsboskattelov32_progressionsgrundlag_gyldigt(ægtefælleforhold, satser.aktieindkomst_progressionsgrænse_kroner)
    = grundlag_gyldigt = aktieindkomstgrundlag_gyldigt && progressionsgrundlag_gyldigt
    = beregningsgrundlag_gyldigt = grundlag_gyldigt && satser.understøttet
    = aktieindkomst_før_modregning_kroner = hvis beregningsgrundlag_gyldigt { dødsboskattelov32_aktieindkomst_kroner(grundlag) } ellers { 0 }
    = positiv_aktieindkomst_kroner = penge_positivt_beløb(aktieindkomst_før_modregning_kroner)
    = underskud_modregnet_kroner = penge_mindste_beløb(penge_positivt_beløb(bobeskatningsunderskud_kroner), positiv_aktieindkomst_kroner)
    = aktieindkomst_efter_modregning_kroner = aktieindkomst_før_modregning_kroner - underskud_modregnet_kroner
    = progressionsgrænse_før_par67_stk7_kroner = hvis beregningsgrundlag_gyldigt { satser.aktieindkomst_progressionsgrænse_kroner * dødsboskattelov32_progressionsgrænsemultiplikator(ægtefælleforhold) } ellers { 0 }
    = anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner = hvis beregningsgrundlag_gyldigt { dødsboskattelov32_anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner(ægtefælleforhold) } ellers { 0 }
    = effektiv_progressionsgrænse_kroner = progressionsgrænse_før_par67_stk7_kroner - anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner
    = absolut_aktieindkomst_kroner = penge_positivt_beløb(aktieindkomst_efter_modregning_kroner) + penge_positivt_beløb(0 - aktieindkomst_efter_modregning_kroner)
    = lavt_skattegrundlag_kroner = penge_mindste_beløb(absolut_aktieindkomst_kroner, effektiv_progressionsgrænse_kroner)
    = højt_skattegrundlag_kroner = absolut_aktieindkomst_kroner - lavt_skattegrundlag_kroner
    = beregnet_aktieskat_kroner = penge_beløb_gange_basispoint_kroner(lavt_skattegrundlag_kroner, satser.aktieindkomst_lav_sats_basispoint) + penge_beløb_gange_basispoint_kroner(højt_skattegrundlag_kroner, satser.aktieindkomst_høj_sats_basispoint)
    Dødsboskattelov32Resultat(
        grundlag = grundlag,
        grundlag_gyldigt = grundlag_gyldigt,
        progressionsgrundlag_gyldigt = progressionsgrundlag_gyldigt,
        aktieindkomst_før_par30_stk5_kroner = aktieindkomst_før_modregning_kroner,
        bobeskatningsunderskud_modregnet_efter_par30_stk5_kroner = underskud_modregnet_kroner,
        aktieindkomst_efter_par30_stk5_kroner = aktieindkomst_efter_modregning_kroner,
        progressionsgrænse_før_par67_stk7_kroner = progressionsgrænse_før_par67_stk7_kroner,
        anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner = anvendt_ekstra_progressionsgrænse_i_førstafdødes_særbo_kroner,
        effektiv_progressionsgrænse_kroner = effektiv_progressionsgrænse_kroner,
        lavt_skattegrundlag_kroner = lavt_skattegrundlag_kroner,
        højt_skattegrundlag_kroner = højt_skattegrundlag_kroner,
        lav_sats_basispoint = satser.aktieindkomst_lav_sats_basispoint,
        høj_sats_basispoint = satser.aktieindkomst_høj_sats_basispoint,
        positiv_aktieskat_kroner = hvis aktieindkomst_efter_modregning_kroner > 0 { beregnet_aktieskat_kroner } ellers { 0 },
        negativ_aktieskat_kroner = hvis aktieindkomst_efter_modregning_kroner < 0 { beregnet_aktieskat_kroner } ellers { 0 }
    )
}
--@end::dødsboskattelov_par32--

= dødsboskattelov_par67_stk7_metadata = Metadata(
    attachments = (
        Source(value = dødsboskattelov_par1_par30_lbk426),
        Guidance(value = dødsboskattelov_par67_stk7_særbo_vejledning),
        Guidance(value = dødsboskattelov_par67_stk7_skatteberegning_vejledning),
        PreparatoryWork(value = dødsboskattelov_par67_stk7_l159_bemærkninger),
    )
)

--@label:dødsboskattelov_par67_stk7::meta:dødsboskattelov_par67_stk7_metadata--
----
Stk. 7. Afgår den længstlevende ægtefælle ved døden i samme indkomstår som førstafdøde, finder § 7, 2. pkt., § 8, 3. pkt., § 16, stk. 4, § 19, stk. 2, 2. pkt., og stk. 3, 2. pkt., samt § 32, stk. 4, ikke anvendelse, i det omfang beløbene er indgået i skifte af førstafdødes særbo efter dette kapitel.
----

--@begin::dødsboskattelov_par67_stk7--
# Dødsboskattelov67Stk7Progressionsforhold = Dbl67Stk7IntetSkifteAfFørstafdødesSærbo | Dbl67Stk7FørstafdødesSærboIkkeEndeligtSkatteberegnet | Dbl67Stk7FørstafdødesSærboEndeligtSkatteberegnet(anvendt_ekstra_progressionsgrænse_kroner: Heltal, dokumentreference: Tekst)

| dødsboskattelov67_stk7_progressionsforhold_gyldigt(forhold: Dødsboskattelov67Stk7Progressionsforhold, ordinær_progressionsgrænse_kroner: Heltal) -> match forhold {
    | Dbl67Stk7IntetSkifteAfFørstafdødesSærbo -> Sandt
    | Dbl67Stk7FørstafdødesSærboIkkeEndeligtSkatteberegnet -> Falskt
    | Dbl67Stk7FørstafdødesSærboEndeligtSkatteberegnet(anvendt_ekstra_progressionsgrænse_kroner, dokumentreference) -> anvendt_ekstra_progressionsgrænse_kroner >= 0 && anvendt_ekstra_progressionsgrænse_kroner <= ordinær_progressionsgrænse_kroner && dokumentreference != ""
}
| dødsboskattelov67_stk7_anvendt_ekstra_progressionsgrænse_kroner(forhold: Dødsboskattelov67Stk7Progressionsforhold) -> match forhold {
    | Dbl67Stk7IntetSkifteAfFørstafdødesSærbo -> 0
    | Dbl67Stk7FørstafdødesSærboIkkeEndeligtSkatteberegnet -> 0
    | Dbl67Stk7FørstafdødesSærboEndeligtSkatteberegnet(anvendt_ekstra_progressionsgrænse_kroner, _) -> anvendt_ekstra_progressionsgrænse_kroner
}
--@end::dødsboskattelov_par67_stk7--
