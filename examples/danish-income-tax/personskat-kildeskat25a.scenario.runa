@ sprog da

@ importer ./personskat.calculate

| personskat_ksl25a_scenarie_virksomhed(identifikation: Tekst, indtægter: List(PersonskatVirksomhedsindtægtFakta), udgifter: List(PersonskatVirksomhedsudgiftFakta)) -> PersonskatOrdinærVirksomhedFakta(
    identifikation = identifikation,
    indkomstår = 2025,
    indtægter = indtægter,
    udgifter = udgifter
)
| personskat_ksl25a_scenarie_personlig_indkomst(virksomheder: List(PersonskatOrdinærVirksomhedFakta)) -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = [],
        virksomheder_uden_virksomhedsordning = virksomheder,
        forenings_og_arbejdsløshedsydelser = []
    ),
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| personskat_ksl25a_scenarie_lønmodtager_for_år(virksomheder: List(PersonskatOrdinærVirksomhedFakta), skatteår: Heltal) -> PersonskatLønmodtagerInput(
    skatteår = skatteår,
    kommune = Frederiksberg,
    bruttoløn_kroner = 0,
    personlig_indkomst = personskat_ksl25a_scenarie_personlig_indkomst(virksomheder),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
| personskat_ksl25a_scenarie_lønmodtager(virksomheder: List(PersonskatOrdinærVirksomhedFakta)) -> personskat_ksl25a_scenarie_lønmodtager_for_år(virksomheder, 2025)
| personskat_ksl25a_scenarie_personfakta_for_år(virksomheder: List(PersonskatOrdinærVirksomhedFakta), skatteår: Heltal) -> PersonskatPersonFakta(
    lønmodtager = personskat_ksl25a_scenarie_lønmodtager_for_år(virksomheder, skatteår),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta()
)
| personskat_ksl25a_scenarie_personfakta(virksomheder: List(PersonskatOrdinærVirksomhedFakta)) -> personskat_ksl25a_scenarie_personfakta_for_år(virksomheder, 2025)
| personskat_ksl25a_scenarie_input_med_samlivsstatus(hovedpersons_virksomheder: List(PersonskatOrdinærVirksomhedFakta), ægtefælles_virksomheder: List(PersonskatOrdinærVirksomhedFakta), fordelinger: List(PersonskatKsl25AVirksomhedsfordelingFakta), ægtefælles_skatteår: Heltal, samlevende_ved_indkomstårets_udløb: Boolsk) -> PersonskatInput(
    lønmodtager = personskat_ksl25a_scenarie_lønmodtager(hovedpersons_virksomheder),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = MedÆgtefælle(
        fakta = personskat_ksl25a_scenarie_personfakta_for_år(ægtefælles_virksomheder, ægtefælles_skatteår),
        samlevende_ved_indkomstårets_udløb = samlevende_ved_indkomstårets_udløb,
        kildeskat25a_fordelinger = fordelinger
    ),
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_ksl25a_scenarie_input_med_ægtefælles_skatteår(hovedpersons_virksomheder: List(PersonskatOrdinærVirksomhedFakta), ægtefælles_virksomheder: List(PersonskatOrdinærVirksomhedFakta), fordelinger: List(PersonskatKsl25AVirksomhedsfordelingFakta), ægtefælles_skatteår: Heltal) -> personskat_ksl25a_scenarie_input_med_samlivsstatus(hovedpersons_virksomheder, ægtefælles_virksomheder, fordelinger, ægtefælles_skatteår, Sandt)
| personskat_ksl25a_scenarie_input(hovedpersons_virksomheder: List(PersonskatOrdinærVirksomhedFakta), ægtefælles_virksomheder: List(PersonskatOrdinærVirksomhedFakta), fordelinger: List(PersonskatKsl25AVirksomhedsfordelingFakta)) -> personskat_ksl25a_scenarie_input_med_ægtefælles_skatteår(hovedpersons_virksomheder, ægtefælles_virksomheder, fordelinger, 2025)
| personskat_ksl25a_scenarie_ægtefælles_am_tillæg_kroner(resultat: PersonskatBeregningResultat) -> match resultat.ægtefælle {
    | BeregnetÆgtefælle(_, grundlag, _, _) -> grundlag.personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner
    | IngenÆgtefælleberegning -> 0
}
| personskat_ksl25a_scenarie_ægtefælles_bruttoløn_kroner(resultat: PersonskatBeregningResultat) -> match resultat.ægtefælle {
    | BeregnetÆgtefælle(_, grundlag, _, _) -> grundlag.lønmodtager_input.bruttoløn_kroner
    | IngenÆgtefælleberegning -> 0
}
| personskat_ksl25a_scenarie_ægtefælles_personlig_indkomst_uden_nyt_am_kroner(resultat: PersonskatBeregningResultat) -> match resultat.ægtefælle {
    | BeregnetÆgtefælle(_, grundlag, _, _) -> grundlag.personlig_indkomst.personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner
    | IngenÆgtefælleberegning -> 0
}
| personskat_ksl25a_scenarie_ægtefælles_personlige_input_gyldige(resultat: PersonskatBeregningResultat) -> match resultat.ægtefælle {
    | BeregnetÆgtefælle(_, grundlag, _, _) -> grundlag.personlig_indkomst.alle_input_gyldige
    | IngenÆgtefælleberegning -> Falskt
}
| personskat_ksl25a_scenarie_parskat_kroner(resultat: PersonskatBeregningResultat) -> resultat.samlet_skat_inkl_ejendomsskatter_efter_fremført_negativ_aktieindkomstskat_kroner + personskat_ægtefælles_slutskat_kroner(resultat)

= personskat_ksl25a_scenarie_ordinær_indtægt = PersonskatVirksomhedsindtægtFakta(
    identifikation = "ordinær-drift",
    art = OrdinærDriftsindtægt,
    beløb_kroner = 400000
)
= personskat_ksl25a_scenarie_anden_ordinær_indtægt = PersonskatVirksomhedsindtægtFakta(
    identifikation = "anden-ordinær-drift",
    art = OrdinærDriftsindtægt,
    beløb_kroner = 400000
)
= personskat_ksl25a_scenarie_lønudgift = PersonskatVirksomhedsudgiftFakta(
    identifikation = "ægtefælleløn",
    afgrænsning = SelvstændigErhvervsindkomstUdgift,
    beløb_kroner = 100000
)
= personskat_ksl25a_scenarie_tabsgivende_udgift = PersonskatVirksomhedsudgiftFakta(
    identifikation = "driftsudgift",
    afgrænsning = SelvstændigErhvervsindkomstUdgift,
    beløb_kroner = 100000
)
= personskat_ksl25a_scenarie_overskudsvirksomhed = personskat_ksl25a_scenarie_virksomhed("fælles-virksomhed", [personskat_ksl25a_scenarie_ordinær_indtægt], [])
= personskat_ksl25a_scenarie_lønvirksomhed = personskat_ksl25a_scenarie_virksomhed("fælles-virksomhed", [personskat_ksl25a_scenarie_ordinær_indtægt], [personskat_ksl25a_scenarie_lønudgift])
= personskat_ksl25a_scenarie_tabsvirksomhed = personskat_ksl25a_scenarie_virksomhed("fælles-virksomhed", [], [personskat_ksl25a_scenarie_tabsgivende_udgift])
= personskat_ksl25a_scenarie_anden_overskudsvirksomhed = personskat_ksl25a_scenarie_virksomhed("anden-fælles-virksomhed", [personskat_ksl25a_scenarie_anden_ordinær_indtægt], [])
= personskat_ksl25a_scenarie_anden_lønvirksomhed = personskat_ksl25a_scenarie_virksomhed("anden-fælles-virksomhed", [personskat_ksl25a_scenarie_anden_ordinær_indtægt], [personskat_ksl25a_scenarie_lønudgift])

= personskat_ksl25a_scenarie_indtægt_før_ophør = PersonskatVirksomhedsindtægtFakta(
    identifikation = "drift-før-ophør",
    art = OrdinærDriftsindtægt,
    beløb_kroner = 120000
)
= personskat_ksl25a_scenarie_indtægt_fra_ophør = PersonskatVirksomhedsindtægtFakta(
    identifikation = "drift-fra-ophør",
    art = OrdinærDriftsindtægt,
    beløb_kroner = 280000
)
= personskat_ksl25a_scenarie_delårsvirksomhed = personskat_ksl25a_scenarie_virksomhed(
    "fælles-virksomhed",
    [personskat_ksl25a_scenarie_indtægt_før_ophør, personskat_ksl25a_scenarie_indtægt_fra_ophør],
    []
)
= personskat_ksl25a_scenarie_separation_1_juli = Ksl25ASamlivsophør(
    dato = Dato(år = 2025, måned = 7, dag = 1),
    årsag = Ksl25ASeparation
)
= personskat_ksl25a_scenarie_faktisk_ophør_1_juli = Ksl25ASamlivsophør(
    dato = Dato(år = 2025, måned = 7, dag = 1),
    årsag = Ksl25AFaktiskSamlivsophør(fakta = Kildeskat25AFaktiskSamlivsophørsfakta(
        varigt_adskilt_uden_fælles_husførelse = Sandt,
        samlivet_genoptaget_i_samme_indkomstår = Falskt
    ))
)
= personskat_ksl25a_scenarie_faktisk_ophør_genoptaget = Ksl25ASamlivsophør(
    dato = Dato(år = 2025, måned = 7, dag = 1),
    årsag = Ksl25AFaktiskSamlivsophør(fakta = Kildeskat25AFaktiskSamlivsophørsfakta(
        varigt_adskilt_uden_fælles_husførelse = Sandt,
        samlivet_genoptaget_i_samme_indkomstår = Sandt
    ))
)
= personskat_ksl25a_scenarie_dødsfald_1_juli = Ksl25ASamlivsophør(
    dato = Dato(år = 2025, måned = 7, dag = 1),
    årsag = Ksl25ADødsfald
)
= personskat_ksl25a_scenarie_delårsperioder = [
    PersonskatKsl25AVirksomhedspostperiode(
        kildepost_identifikation = "drift-før-ophør",
        fra_dato = Dato(år = 2025, måned = 1, dag = 1),
        til_dato = Dato(år = 2025, måned = 6, dag = 30)
    ),
    PersonskatKsl25AVirksomhedspostperiode(
        kildepost_identifikation = "drift-fra-ophør",
        fra_dato = Dato(år = 2025, måned = 7, dag = 1),
        til_dato = Dato(år = 2025, måned = 12, dag = 31)
    ),
]
| personskat_ksl25a_scenarie_delårsfakta_med_parter(fordeling: Kildeskat25AVirksomhedsfordelingsvalg, virksomhedsdriver_før_samlivsophør: Option(PersonskatKsl25APart), ordinær_ejer_efter_samlivsophør: PersonskatKsl25APart) -> PersonskatKsl25AVirksomhedsfordelingFakta(
    virksomhedsidentifikation = "fælles-virksomhed",
    virksomhedens_kildeplacering = Ksl25AKildeHosHovedperson,
    virksomhedsdriver_før_samlivsophør = virksomhedsdriver_før_samlivsophør,
    samlivsforløb = personskat_ksl25a_scenarie_separation_1_juli,
    virksomhedspostperioder = personskat_ksl25a_scenarie_delårsperioder,
    ordinær_ejer_efter_samlivsophør = Some(ordinær_ejer_efter_samlivsophør),
    fordeling = fordeling,
    lønudgiftsidentifikation = None
)
| personskat_ksl25a_scenarie_delårsfakta(fordeling: Kildeskat25AVirksomhedsfordelingsvalg) -> personskat_ksl25a_scenarie_delårsfakta_med_parter(
    fordeling,
    hvis personskat_ksl25a_fordeling_kræver_virksomhedsdriver(fordeling) { Some(Ksl25AHovedperson) } ellers { None },
    Ksl25AÆgtefælle
)
= personskat_ksl25a_scenarie_separation_stk1_fakta = personskat_ksl25a_scenarie_delårsfakta(Ksl25AStk1HosVirksomhedsdriver(
    begge_ægtefæller_deltager_i_driften = Sandt,
    virksomhedsdriveren_driver_i_overvejende_grad = Sandt
))
= personskat_ksl25a_scenarie_separation_stk1_driver_ægtefælle_ejer_hovedperson_fakta = personskat_ksl25a_scenarie_delårsfakta_med_parter(
    Ksl25AStk1HosVirksomhedsdriver(
        begge_ægtefæller_deltager_i_driften = Sandt,
        virksomhedsdriveren_driver_i_overvejende_grad = Sandt
    ),
    Some(Ksl25AÆgtefælle),
    Ksl25AHovedperson
)
= personskat_ksl25a_scenarie_separation_stk1_driver_ægtefælle_ejer_ægtefælle_fakta = personskat_ksl25a_scenarie_delårsfakta_med_parter(
    Ksl25AStk1HosVirksomhedsdriver(
        begge_ægtefæller_deltager_i_driften = Sandt,
        virksomhedsdriveren_driver_i_overvejende_grad = Sandt
    ),
    Some(Ksl25AÆgtefælle),
    Ksl25AÆgtefælle
)
= personskat_ksl25a_scenarie_separation_stk8_fakta = personskat_ksl25a_scenarie_delårsfakta(Ksl25AStk8LigeligResultatfordeling(
    begge_deltager_i_væsentligt_og_ligeligt_omfang = Sandt,
    hæfter_i_samme_omfang = Sandt,
    fordeling_anmodet = Sandt,
    fordeling_sagligt_begrundet_i_driften = Sandt,
    anden_ægtefælles_fordelingsandel_basispoint = 4000
))
= personskat_ksl25a_scenarie_separation_stk3_fakta = personskat_ksl25a_scenarie_delårsfakta(Ksl25AStk3TilMedarbejdendeÆgtefælle(
    begge_deltager_i_væsentligt_omfang = Sandt,
    virksomhedsdriveren_driver_i_overvejende_grad = Sandt,
    anmodet_overførsel_kroner = 50000,
    arbejdsindsats_forsvarligt_maksimum_kroner = 50000
))
| personskat_ksl25a_scenarie_helårsfakta_med_ophør(samlivsforløb: Kildeskat25ASamlivsforløb, fordeling: Kildeskat25AVirksomhedsfordelingsvalg) -> PersonskatKsl25AVirksomhedsfordelingFakta(
    virksomhedsidentifikation = "fælles-virksomhed",
    virksomhedens_kildeplacering = Ksl25AKildeHosHovedperson,
    virksomhedsdriver_før_samlivsophør = hvis personskat_ksl25a_fordeling_kræver_virksomhedsdriver(fordeling) { Some(Ksl25AHovedperson) } ellers { None },
    samlivsforløb = samlivsforløb,
    virksomhedspostperioder = [],
    ordinær_ejer_efter_samlivsophør = None,
    fordeling = fordeling,
    lønudgiftsidentifikation = None
)
= personskat_ksl25a_scenarie_faktisk_ophør_stk1_fakta = personskat_ksl25a_scenarie_helårsfakta_med_ophør(
    personskat_ksl25a_scenarie_faktisk_ophør_1_juli,
    Ksl25AStk1HosVirksomhedsdriver(
        begge_ægtefæller_deltager_i_driften = Sandt,
        virksomhedsdriveren_driver_i_overvejende_grad = Sandt
    )
)
= personskat_ksl25a_scenarie_faktisk_ophør_stk3_fakta = personskat_ksl25a_scenarie_helårsfakta_med_ophør(
    personskat_ksl25a_scenarie_faktisk_ophør_1_juli,
    Ksl25AStk3TilMedarbejdendeÆgtefælle(
        begge_deltager_i_væsentligt_omfang = Sandt,
        virksomhedsdriveren_driver_i_overvejende_grad = Sandt,
        anmodet_overførsel_kroner = 50000,
        arbejdsindsats_forsvarligt_maksimum_kroner = 50000
    )
)
= personskat_ksl25a_scenarie_dødsfald_stk1_fakta = personskat_ksl25a_scenarie_helårsfakta_med_ophør(
    personskat_ksl25a_scenarie_dødsfald_1_juli,
    Ksl25AStk1HosVirksomhedsdriver(
        begge_ægtefæller_deltager_i_driften = Sandt,
        virksomhedsdriveren_driver_i_overvejende_grad = Sandt
    )
)

= personskat_ksl25a_scenarie_lønindtægt_før_ophør = PersonskatVirksomhedsindtægtFakta(identifikation = "løndrift-før-ophør", art = OrdinærDriftsindtægt, beløb_kroner = 200000)
= personskat_ksl25a_scenarie_lønindtægt_fra_ophør = PersonskatVirksomhedsindtægtFakta(identifikation = "løndrift-fra-ophør", art = OrdinærDriftsindtægt, beløb_kroner = 200000)
= personskat_ksl25a_scenarie_delårslønudgift = PersonskatVirksomhedsudgiftFakta(identifikation = "ægtefælleløn-før-ophør", afgrænsning = SelvstændigErhvervsindkomstUdgift, beløb_kroner = 50000)
= personskat_ksl25a_scenarie_delårslønvirksomhed = personskat_ksl25a_scenarie_virksomhed(
    "fælles-virksomhed",
    [personskat_ksl25a_scenarie_lønindtægt_før_ophør, personskat_ksl25a_scenarie_lønindtægt_fra_ophør],
    [personskat_ksl25a_scenarie_delårslønudgift]
)
= personskat_ksl25a_scenarie_delårslønperioder = [
    PersonskatKsl25AVirksomhedspostperiode(kildepost_identifikation = "løndrift-før-ophør", fra_dato = Dato(år = 2025, måned = 1, dag = 1), til_dato = Dato(år = 2025, måned = 6, dag = 30)),
    PersonskatKsl25AVirksomhedspostperiode(kildepost_identifikation = "ægtefælleløn-før-ophør", fra_dato = Dato(år = 2025, måned = 1, dag = 1), til_dato = Dato(år = 2025, måned = 6, dag = 30)),
    PersonskatKsl25AVirksomhedspostperiode(kildepost_identifikation = "løndrift-fra-ophør", fra_dato = Dato(år = 2025, måned = 7, dag = 1), til_dato = Dato(år = 2025, måned = 12, dag = 31)),
]
| personskat_ksl25a_scenarie_delårsløn_fakta(lønperiodens_slutdato: Dato) -> PersonskatKsl25AVirksomhedsfordelingFakta(
    virksomhedsidentifikation = "fælles-virksomhed",
    virksomhedens_kildeplacering = Ksl25AKildeHosHovedperson,
    virksomhedsdriver_før_samlivsophør = Some(Ksl25AHovedperson),
    samlivsforløb = personskat_ksl25a_scenarie_separation_1_juli,
    virksomhedspostperioder = personskat_ksl25a_scenarie_delårslønperioder,
    ordinær_ejer_efter_samlivsophør = Some(Ksl25AHovedperson),
    fordeling = Ksl25AStk7Lønaftale(fakta = Kildeskat25AStk7Fakta(
        aftalens_ikrafttrædelsesdato = Dato(år = 2025, måned = 1, dag = 1),
        lønperiodens_startdato = Dato(år = 2025, måned = 1, dag = 1),
        lønperiodens_slutdato = lønperiodens_slutdato,
        begge_ægtefæller_deltager_i_driften = Sandt,
        a_skat_indeholdt_og_indbetalt = Sandt,
        arbejdsmarkedsbidrag_indeholdt_og_indbetalt = Sandt,
        gældsindeholdelse_påkrævet = Falskt,
        påkrævet_gældsindeholdelse_overholdt = Sandt,
        løn_før_arbejdsmarkedsbidrag_kroner = 50000,
        arbejdsindsats_forsvarligt_maksimum_kroner = 50000
    )),
    lønudgiftsidentifikation = Some("ægtefælleløn-før-ophør")
)

| personskat_ksl25a_scenarie_stk1_fakta_med_driver_for(virksomhedsidentifikation: Tekst, virksomhedens_kildeplacering: PersonskatKsl25AKildeplacering, virksomhedsdriver: Option(PersonskatKsl25APart)) -> PersonskatKsl25AVirksomhedsfordelingFakta(
    virksomhedsidentifikation = virksomhedsidentifikation,
    virksomhedens_kildeplacering = virksomhedens_kildeplacering,
    virksomhedsdriver_før_samlivsophør = virksomhedsdriver,
    samlivsforløb = Ksl25AIntetSamlivsophør,
    virksomhedspostperioder = [],
    ordinær_ejer_efter_samlivsophør = None,
    fordeling = Ksl25AStk1HosVirksomhedsdriver(
        begge_ægtefæller_deltager_i_driften = Sandt,
        virksomhedsdriveren_driver_i_overvejende_grad = Sandt
    ),
    lønudgiftsidentifikation = None
)
