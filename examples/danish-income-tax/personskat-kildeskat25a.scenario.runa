# PersonskatKsl25AArbejdsbogskilde = Stk3OverFællesÅrsloft2025 | SeparationMedFriFordeling2025

@ calculate("Kildeskattelovens § 25 A til kanonisk Personskat-arbejdsbog")
| personskat_ksl25a_kildefakta_til_arbejdsbog(kilde: PersonskatKsl25AArbejdsbogskilde) -> match kilde {
    | Stk3OverFællesÅrsloft2025 -> personskat_ksl25a_scenarie_input(
        [personskat_ksl25a_scenarie_overskudsvirksomhed, personskat_ksl25a_scenarie_anden_overskudsvirksomhed],
        [],
        [
            personskat_ksl25a_scenarie_stk3_fakta_for("fælles-virksomhed", Ksl25AKildeHosHovedperson, 160000),
            personskat_ksl25a_scenarie_stk3_fakta_for("anden-fælles-virksomhed", Ksl25AKildeHosHovedperson, 160000),
        ]
    )
    | SeparationMedFriFordeling2025 -> personskat_ksl25a_scenarie_input_med_samlivsstatus(
        [personskat_ksl25a_scenarie_delårsvirksomhed],
        [],
        [personskat_ksl25a_scenarie_separation_stk8_fakta],
        2025,
        Falskt
    )
}

@ print("KSL § 25 A, stk. 1, samlet skat for parret: " + vis(personskat_ksl25a_scenarie_parskat_kroner(personskat_ksl25a_scenarie_stk1)))
@ print("KSL § 25 A, stk. 3, samlet skat for parret: " + vis(personskat_ksl25a_scenarie_parskat_kroner(personskat_ksl25a_scenarie_stk3)))
@ print("KSL § 25 A, stk. 7, virksomhedsresultat og løn: " + vis(personskat_ksl25a_scenarie_stk7.personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner) + " + " + vis(personskat_ksl25a_scenarie_ægtefælles_bruttoløn_kroner(personskat_ksl25a_scenarie_stk7)))
