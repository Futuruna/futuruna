@ sprog da

@ importer ./metadata
@ importer ./pengebeloeb

-- Ligningsloven § 33, stk. 1-2, og § 33 F - almindelig creditlempelse.
--
-- Kilde: Retsinformation, LBK nr. 1500 af 24/11/2025.
-- Officiel tekst: https://www.retsinformation.dk/eli/lta/2025/1500
-- XML: https://www.retsinformation.dk/eli/lta/2025/1500/dan/xml

# Ligningslov33KildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)

= ligningsloven_lbk1500_par33 = Ligningslov33KildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1500",
    identifier = "Ligningsloven § 33, stk. 1-2, og § 33 F i LBK nr. 1500 af 24/11/2025",
    hentet_dato = "2026-08-08"
)

= ligningsloven_vejledning_par33_credit = Ligningslov33KildeInfo(
    url = "https://info.skat.dk/data.aspx?oid=1977310",
    identifier = "Den juridiske vejledning 2026-2, C.F.4.1 LL § 33",
    hentet_dato = "2026-08-08"
)

= ligningsloven_praksis_skm2018_370_sr = Ligningslov33KildeInfo(
    url = "https://info.skat.dk/data.aspx?oid=2273666",
    identifier = "SKM2018.370.SR, credit i dansk aktieavanceskat for betalt udenlandsk indkomstskat",
