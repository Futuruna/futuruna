--@label:ligningsloven_par33f::meta:ligningsloven_par33_metadata--
----
§ 33 F. Ved beregning af den maksimale nedsættelse af dansk skat, enten i
henhold til reglerne i ligningslovens § 33 eller i henhold til bestemmelserne
i en med fremmed stat, med Grønland eller Færøerne indgået overenskomst til
undgåelse af dobbeltbeskatning, skal der ved opgørelsen af den indkomst, der
oppebæres fra udlandet, fratrækkes de udgifter, der anses for at vedrøre sådan
indkomst, jf. dog stk. 3.

Stk. 2. Udgifter, der ikke kan henføres til enten den danske eller den
udenlandske indkomst, skal fordeles efter forholdet mellem den danske og den
udenlandske bruttoindkomst, jf. dog stk. 3.

Stk. 3. Såfremt en eksportør yder lån til sin aftager i forbindelse med
kreditsalg af varer mv., skal renteudgifter mv. som nævnt i § 5, stk. 1, i
forbindelse hermed ikke fragå ved opgørelsen af den udenlandske indkomst.
----

--@begin:ligningsloven_par33f--

# Ligningslov33Skatteområde = Ll33FremmedStat(landekode: Tekst) | Ll33Grønland | Ll33Færøerne
# Ligningslov33Opkrævningsmåde = Ll33DirektePåligning | Ll33Indeholdelse
# Ligningslov33UdenlandskSkatteart = Ll33Indkomstskat | Ll33SærligIndkomstskat | Ll33Formueskat
# Ligningslov33Overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst | Ll33OverenskomstensUbetingedeKrav(maksimal_skat_øre: Heltal, dokumentreference: Tekst) | Ll33SkatteforvaltningenFastsatSkat(fradragsberettiget_udenlandsk_skat_øre: Heltal, dokumentreference: Tekst)
# Ligningslov33LandelinjeFakta(område: Ligningslov33Skatteområde, opkrævningsmåde: Ligningslov33Opkrævningsmåde, udenlandsk_bruttoindkomst_kroner: Heltal, direkte_henførbare_udgifter_kroner: Heltal, betalt_udenlandsk_skat_øre: Heltal, skatteart: Ligningslov33UdenlandskSkatteart, betalingsdokumentreference: Tekst, overenskomstgrundlag: Ligningslov33Overenskomstgrundlag)
# Ligningslov33Årsinput(dansk_bruttoindkomst_kroner: Heltal, ikke_henførbare_udgifter_kroner: Heltal, eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner: Heltal, landelinjer: List(Ligningslov33LandelinjeFakta))
# Ligningslov33FLandelinjeResultat(fakta: Ligningslov33LandelinjeFakta, input_gyldigt: Boolsk, fordelt_ikke_henførbar_udgift_kroner: Heltal, nettoindkomst_efter_par33f_kroner: Heltal)

| ligningslov33_uden_kredit_input() -> Ligningslov33Årsinput(
    dansk_bruttoindkomst_kroner = 0,
    ikke_henførbare_udgifter_kroner = 0,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
    landelinjer = []
)
| ligningslov33_skatteområde_gyldigt(område: Ligningslov33Skatteområde) -> match område {
    | Ll33FremmedStat(landekode) -> landekode != ""
    | Ll33Grønland -> Sandt
    | Ll33Færøerne -> Sandt
}
| ligningslov33_overenskomstgrundlag_gyldigt(grundlag: Ligningslov33Overenskomstgrundlag) -> match grundlag {
    | Ll33IngenDobbeltbeskatningsoverenskomst -> Sandt
    | Ll33OverenskomstensUbetingedeKrav(maksimal_skat_øre, dokumentreference) -> maksimal_skat_øre >= 0 && dokumentreference != ""
    | Ll33SkatteforvaltningenFastsatSkat(fradragsberettiget_udenlandsk_skat_øre, dokumentreference) -> fradragsberettiget_udenlandsk_skat_øre >= 0 && dokumentreference != ""
}
| ligningslov33_skatteart_omfattet(skatteart: Ligningslov33UdenlandskSkatteart) -> match skatteart {
    | Ll33Indkomstskat -> Sandt
    | Ll33SærligIndkomstskat -> Sandt
    | Ll33Formueskat -> Falskt
}
| ligningslov33_betalingsdokumentation_gyldig(fakta: Ligningslov33LandelinjeFakta) -> fakta.betalt_udenlandsk_skat_øre == 0 || fakta.betalingsdokumentreference != ""
| ligningslov33_landelinje_fakta_gyldige(fakta: Ligningslov33LandelinjeFakta) -> ligningslov33_skatteområde_gyldigt(fakta.område) && fakta.udenlandsk_bruttoindkomst_kroner >= 0 && fakta.direkte_henførbare_udgifter_kroner >= 0 && fakta.betalt_udenlandsk_skat_øre >= 0 && ligningslov33_skatteart_omfattet(fakta.skatteart) && ligningslov33_betalingsdokumentation_gyldig(fakta) && ligningslov33_overenskomstgrundlag_gyldigt(fakta.overenskomstgrundlag)
| ligningslov33_område_antal(linjer: List(Ligningslov33LandelinjeFakta), område: Ligningslov33Skatteområde) -> foldl(linjer, 0, |antal: Heltal, linje: Ligningslov33LandelinjeFakta| antal + hvis linje.område == område { 1 } ellers { 0 })
| ligningslov33_skatteområder_entydige(linjer: List(Ligningslov33LandelinjeFakta)) -> all(linjer, |linje: Ligningslov33LandelinjeFakta| ligningslov33_område_antal(linjer, linje.område) == 1)
| ligningslov33_samlet_udenlandsk_bruttoindkomst_kroner(input: Ligningslov33Årsinput) -> foldl(input.landelinjer, 0, |sum: Heltal, linje: Ligningslov33LandelinjeFakta| sum + linje.udenlandsk_bruttoindkomst_kroner)
| ligningslov33_par33f_fordelingsgrundlag_kroner(input: Ligningslov33Årsinput) -> input.dansk_bruttoindkomst_kroner + ligningslov33_samlet_udenlandsk_bruttoindkomst_kroner(input)
| ligningslov33_par33f_fordelingsudgifter_kroner(input: Ligningslov33Årsinput) -> input.ikke_henførbare_udgifter_kroner - input.eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner
| ligningslov33_par33f_fordelt_udgift_kroner(input: Ligningslov33Årsinput, fakta: Ligningslov33LandelinjeFakta) -> hvis ligningslov33_par33f_fordelingsgrundlag_kroner(input) > 0 {
    ligningslov33_par33f_fordelingsudgifter_kroner(input) * fakta.udenlandsk_bruttoindkomst_kroner / ligningslov33_par33f_fordelingsgrundlag_kroner(input)
} ellers {
    0
}
| ligningslov33_par33f_nettoindkomst_kroner(input: Ligningslov33Årsinput, fakta: Ligningslov33LandelinjeFakta) -> penge_positivt_beløb(fakta.udenlandsk_bruttoindkomst_kroner - fakta.direkte_henførbare_udgifter_kroner - ligningslov33_par33f_fordelt_udgift_kroner(input, fakta))
| ligningslov33_årsinput_gyldigt(input: Ligningslov33Årsinput) -> input.dansk_bruttoindkomst_kroner >= 0 && input.ikke_henførbare_udgifter_kroner >= 0 && input.eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner >= 0 && input.eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner <= input.ikke_henførbare_udgifter_kroner && all(input.landelinjer, ligningslov33_landelinje_fakta_gyldige) && ligningslov33_skatteområder_entydige(input.landelinjer)
| ligningslov33_par33f_landelinje_resultat(input: Ligningslov33Årsinput, fakta: Ligningslov33LandelinjeFakta) -> Ligningslov33FLandelinjeResultat(
    fakta = fakta,
    input_gyldigt = ligningslov33_årsinput_gyldigt(input) && ligningslov33_landelinje_fakta_gyldige(fakta),
    fordelt_ikke_henførbar_udgift_kroner = hvis ligningslov33_årsinput_gyldigt(input) { ligningslov33_par33f_fordelt_udgift_kroner(input, fakta) } ellers { 0 },
    nettoindkomst_efter_par33f_kroner = hvis ligningslov33_årsinput_gyldigt(input) { ligningslov33_par33f_nettoindkomst_kroner(input, fakta) } ellers { 0 }
)
| ligningslov33_par33f_landelinje_resultater(input: Ligningslov33Årsinput) -> map(input.landelinjer, |fakta: Ligningslov33LandelinjeFakta| ligningslov33_par33f_landelinje_resultat(input, fakta))

--@end:ligningsloven_par33f--

--@label:ligningsloven_par33::meta:ligningsloven_par33_metadata--
----
§ 33. Skat, der er betalt til fremmed stat, til Grønland eller til Færøerne og
opkrævet af indkomst fra kilder dér, det være sig ved direkte påligning eller
ved indeholdelse, kan fradrages i de indkomstskatter til stat og kommune, der
skal svares af denne indkomst i Danmark. Fradragsbeløbet skal dog ikke kunne
overstige den del af den samlede danske skat, der efter forholdet mellem den i
fremmed stat, i Grønland eller på Færøerne beskattede del af indkomsten og hele
den i Danmark beskattede indkomst falder på førstnævnte del af indkomsten.

Stk. 2. Såfremt der med den fremmede stat, med Grønland eller med Færøerne er
indgået en overenskomst til undgåelse af dobbeltbeskatning, skal der dog ikke
gives fradrag for et større skattebeløb end det, som denne stat, Grønland eller
Færøerne efter overenskomsten har et ubetinget krav på at oppebære.
----

--@begin:ligningsloven_par33--

# Ligningslov33DanskSkattekreds(samlet_beskattet_indkomst_kroner: Heltal, dansk_skat_før_nedslag_øre: Heltal)
# Ligningslov33LandelinjeResultat(par33f: Ligningslov33FLandelinjeResultat, dansk_skattekreds_gyldig: Boolsk, udenlandsk_skat_efter_overenskomst_øre: Heltal, proportionalt_dansk_skatteloft_øre: Heltal, nedslag_øre: Heltal)
# Ligningslov33Årsresultat(input: Ligningslov33Årsinput, dansk_skattekreds: Ligningslov33DanskSkattekreds, par33f_landelinjer: List(Ligningslov33FLandelinjeResultat), landelinjer: List(Ligningslov33LandelinjeResultat), input_gyldigt: Boolsk, samlet_nedslag_før_skattecap_øre: Heltal, samlet_nedslag_øre: Heltal)

| ligningslov33_dansk_skattekreds_gyldig(skattekreds: Ligningslov33DanskSkattekreds) -> skattekreds.samlet_beskattet_indkomst_kroner >= 0 && skattekreds.dansk_skat_før_nedslag_øre >= 0
| ligningslov33_skat_efter_overenskomst_øre(skat_øre: Heltal, grundlag: Ligningslov33Overenskomstgrundlag) -> match grundlag {
    | Ll33IngenDobbeltbeskatningsoverenskomst -> skat_øre
    | Ll33OverenskomstensUbetingedeKrav(maksimal_skat_øre, _) -> penge_mindste_beløb(skat_øre, maksimal_skat_øre)
    | Ll33SkatteforvaltningenFastsatSkat(fradragsberettiget_udenlandsk_skat_øre, _) -> penge_mindste_beløb(skat_øre, fradragsberettiget_udenlandsk_skat_øre)
}
| ligningslov33_udenlandsk_skat_efter_overenskomst_øre(fakta: Ligningslov33LandelinjeFakta) -> ligningslov33_skat_efter_overenskomst_øre(fakta.betalt_udenlandsk_skat_øre, fakta.overenskomstgrundlag)
| ligningslov33_proportionalt_dansk_skatteloft_øre(skattekreds: Ligningslov33DanskSkattekreds, nettoindkomst_efter_par33f_kroner: Heltal) -> hvis ligningslov33_dansk_skattekreds_gyldig(skattekreds) && skattekreds.samlet_beskattet_indkomst_kroner > 0 {
    penge_mindste_beløb(
        skattekreds.dansk_skat_før_nedslag_øre,
        skattekreds.dansk_skat_før_nedslag_øre * nettoindkomst_efter_par33f_kroner / skattekreds.samlet_beskattet_indkomst_kroner
    )
} ellers {
    0
}
| ligningslov33_landelinje_resultat(skattekreds: Ligningslov33DanskSkattekreds, par33f: Ligningslov33FLandelinjeResultat) -> {
    = skattekreds_gyldig = ligningslov33_dansk_skattekreds_gyldig(skattekreds)
    = udenlandsk_skat_efter_overenskomst_øre = hvis par33f.input_gyldigt && skattekreds_gyldig { ligningslov33_udenlandsk_skat_efter_overenskomst_øre(par33f.fakta) } ellers { 0 }
    = proportionalt_dansk_skatteloft_øre = hvis par33f.input_gyldigt && skattekreds_gyldig { ligningslov33_proportionalt_dansk_skatteloft_øre(skattekreds, par33f.nettoindkomst_efter_par33f_kroner) } ellers { 0 }
    Ligningslov33LandelinjeResultat(
        par33f = par33f,
        dansk_skattekreds_gyldig = skattekreds_gyldig,
        udenlandsk_skat_efter_overenskomst_øre = udenlandsk_skat_efter_overenskomst_øre,
        proportionalt_dansk_skatteloft_øre = proportionalt_dansk_skatteloft_øre,
        nedslag_øre = penge_mindste_beløb(udenlandsk_skat_efter_overenskomst_øre, proportionalt_dansk_skatteloft_øre)
    )
}
| ligningslov33_landelinje_resultater(skattekreds: Ligningslov33DanskSkattekreds, par33f_landelinjer: List(Ligningslov33FLandelinjeResultat)) -> map(par33f_landelinjer, |par33f: Ligningslov33FLandelinjeResultat| ligningslov33_landelinje_resultat(skattekreds, par33f))
| ligningslov33_samlet_nedslag_øre(linjer: List(Ligningslov33LandelinjeResultat)) -> foldl(linjer, 0, |sum: Heltal, linje: Ligningslov33LandelinjeResultat| sum + linje.nedslag_øre)
| ligningslov33_årsresultat(input: Ligningslov33Årsinput, skattekreds: Ligningslov33DanskSkattekreds) -> {
    = par33f_landelinjer = ligningslov33_par33f_landelinje_resultater(input)
    = landelinjer = ligningslov33_landelinje_resultater(skattekreds, par33f_landelinjer)
    = input_gyldigt = ligningslov33_årsinput_gyldigt(input) && ligningslov33_dansk_skattekreds_gyldig(skattekreds)
    = samlet_nedslag_før_skattecap_øre = hvis input_gyldigt { ligningslov33_samlet_nedslag_øre(landelinjer) } ellers { 0 }
    Ligningslov33Årsresultat(
        input = input,
        dansk_skattekreds = skattekreds,
        par33f_landelinjer = par33f_landelinjer,
        landelinjer = landelinjer,
        input_gyldigt = input_gyldigt,
        samlet_nedslag_før_skattecap_øre = samlet_nedslag_før_skattecap_øre,
        samlet_nedslag_øre = penge_mindste_beløb(samlet_nedslag_før_skattecap_øre, skattekreds.dansk_skat_før_nedslag_øre)
    )
}

--@end:ligningsloven_par33--

--@label:ligningsloven_par33_stk6::meta:ligningsloven_par33_metadata--
----
§ 33.

Stk. 6. Hvis en person efter kildeskattelovens § 10, stk. 1, ved
indkomstopgørelsen skal medregne fortjeneste på aktiver, nedsættes den danske
skat efter stk. 1 og 2 eller efter reglerne i dobbeltbeskatningsoverenskomsten
med den skat, som den pågældende stat, Grønland eller Færøerne kunne have
pålignet overskud eller kapitalvinding i et fast driftssted eller en fast
ejendom, såfremt det faste driftssted eller den faste ejendom var afstået på
samme tidspunkt.
----

--@begin:ligningsloven_par33_stk6--

# Ligningslov33Par6Aktivgrundlag = Ll33Par6AktivIFastDriftssted(dokumentreference: Tekst) | Ll33Par6FastEjendomEfterEjendomsavancebeskatningsloven
# Ligningslov33Par6Kreditgrundlag(kildeskat10_aktivfakta: Kildeskat10Aktivfakta, aktivgrundlag: Ligningslov33Par6Aktivgrundlag, udenlandsk_skat_som_kunne_være_pålignet_øre: Heltal, dokumentreference: Tekst)

| ligningslov33_par6_kildeskat10_resultat(grundlag: Ligningslov33Par6Kreditgrundlag) -> kildeskat10_aktivresultat(grundlag.kildeskat10_aktivfakta)
| ligningslov33_par6_aktivgrundlag_gyldigt(aktivgrundlag: Ligningslov33Par6Aktivgrundlag) -> match aktivgrundlag {
    | Ll33Par6AktivIFastDriftssted(dokumentreference) -> dokumentreference != ""
    | Ll33Par6FastEjendomEfterEjendomsavancebeskatningsloven -> Sandt
}
| ligningslov33_par6_kreditgrundlag_gyldigt(grundlag: Ligningslov33Par6Kreditgrundlag) -> {
    = kildeskat10 = ligningslov33_par6_kildeskat10_resultat(grundlag)
    kildeskat10.input_gyldigt && kildeskat10.stk1_hændelse && kildeskat10.anses_for_afhændet && ligningslov33_par6_aktivgrundlag_gyldigt(grundlag.aktivgrundlag) && grundlag.udenlandsk_skat_som_kunne_være_pålignet_øre > 0 && grundlag.dokumentreference != ""
}

--@end:ligningsloven_par33_stk6--

--@label:ligningsloven_par33_stk8::meta:ligningsloven_par33_metadata--
----
§ 33.

Stk. 8. Stk. 1 gælder ikke med hensyn til lønindkomst, der er omfattet af § 33 A
eller af sømandsbeskatningslovens §§ 5-8.
----

--@begin:ligningsloven_par33_stk8--

# Ligningslov33Lønlempelsesstatus = Ll33IngenLønindkomst | Ll33OrdinærCreditlempetLønindkomst | Ll33LønindkomstOmfattetAfPar33A | Ll33LønindkomstOmfattetAfSømandsbeskatningslovenPar5Til8

| ligningslov33_lønlempelsesstatus_tillader_credit(status: Ligningslov33Lønlempelsesstatus) -> match status {
    | Ll33IngenLønindkomst -> Sandt
    | Ll33OrdinærCreditlempetLønindkomst -> Sandt
    | Ll33LønindkomstOmfattetAfPar33A -> Falskt
    | Ll33LønindkomstOmfattetAfSømandsbeskatningslovenPar5Til8 -> Falskt
}

--@end:ligningsloven_par33_stk8--

--@label:ligningsloven_par33_personberegning::meta:ligningsloven_par33_metadata--
----
Med virkning fra indkomståret 2010 er der offentliggjort en praksisændring, som
betyder, at beregningsmetoderne for lempelse for skat af udenlandsk indkomst
ændres.

Lempelsen skal herefter beregnes på grundlag af den beregnede danske skat, før
personfradraget er fratrukket, og ikke efter personfradraget er fratrukket. Der
bliver således ikke henført en forholdsmæssig del af personfradraget til den
udenlandske indkomst.

Lempelsen for skat af udenlandsk indkomst beregnes særskilt for hver
indkomstskat, der indgår i en persons skatteberegning. Lempelsen ved credit og
exemption bliver beregnet med udgangspunkt i denne brøk:

dansk skat x udenlandsk indkomst
den skattepligtige indkomst

Lempelsesbrøken for skat af udenlandsk indkomst beregnes således særskilt for
hver af de indkomstskatter, som følger af:

* PSL § 6 (bundskat)
* PSL § 7 (mellemskat)
* PSL § 7 a (topskat)
* PSL § 8 (toptopskat)
* PSL § 8a (skat af aktieindkomst)
* PSL § 8b (skat af CFC-indkomst)
* AMBL § 1 (AM-bidrag)

Derudover skal der beregnes lempelse af kommunal indkomstskat og kirkeskat.

Hvis der er flere indkomster fra det samme land, skal lempelsesberegningen ske
samlet. Lempelsesberegningen skal dog ske særskilt for hver indkomst, hvis der
skal lempes efter forskellige metoder, eller hvis indkomsten i det pågældende
land er blevet særskilt (kilde-)beskattet, og der skal lempes efter
creditmetoden.

Hvis der er indkomst fra forskellige lande, skal lempelsesberegningerne
foretages for hvert enkelt land for sig.

Det er kun de udenlandske indkomster, som indgår i beregningsgrundlaget for den
pågældende skat, som bliver taget med ved lempelsesberegningen.

Den udenlandske skattepligtige indkomst, personlige indkomst, kapitalindkomst,
aktieindkomst og CFC-indkomst opgøres efter danske regler.

Fradrag, der vedrører den udenlandske indkomst, skal trækkes fra i den
udenlandske indkomst. Det er derfor den udenlandske nettoindkomst, der indgår i
lempelsesbrøkens tæller.
----

--@begin:ligningsloven_par33_personberegning--

# Ligningslov33PersonSkattekomponentart = Ll33PersonskattelovPar6 | Ll33PersonskattelovPar7 | Ll33PersonskattelovPar7A | Ll33PersonskattelovPar8 | Ll33PersonskattelovPar8A | Ll33PersonskattelovPar8B | Ll33ArbejdsmarkedsbidragslovPar1 | Ll33KommunalIndkomstskat | Ll33Kirkeskat
# Ligningslov33DanskBeregningsgrundlag = Ll33SkattepligtigIndkomst(samlet_indkomst_kroner: Heltal) | Ll33PersonligIndkomst(samlet_indkomst_kroner: Heltal) | Ll33PersonligOgPositivKapitalindkomst(samlet_indkomst_kroner: Heltal) | Ll33Aktieindkomst(samlet_indkomst_kroner: Heltal) | Ll33CfcIndkomst(samlet_indkomst_kroner: Heltal) | Ll33Arbejdsmarkedsbidragsgrundlag(samlet_indkomst_kroner: Heltal)
# Ligningslov33DanskSkattekomponent(art: Ligningslov33PersonSkattekomponentart, beregningsgrundlag: Ligningslov33DanskBeregningsgrundlag, dansk_skat_før_personfradrag_øre: Heltal)
# Ligningslov33PersonDanskSkattekreds(komponenter: List(Ligningslov33DanskSkattekomponent), samlet_dansk_indkomstskat_tilgængelig_øre: Heltal)
# Ligningslov33UdenlandskIndkomstEfterDanskeRegler(skattepligtig_nettoindkomst_efter_par33f_kroner: Heltal, personlig_nettoindkomst_efter_par33f_kroner: Heltal, positiv_kapitalnettoindkomst_efter_par33f_kroner: Heltal, aktienettoindkomst_efter_par33f_kroner: Heltal, cfc_nettoindkomst_efter_par33f_kroner: Heltal, arbejdsmarkedsbidragsgrundlag_kroner: Heltal)
# Ligningslov33Kreditgrupperingsgrundlag = Ll33SamletIndkomstFraSkatteområdet | Ll33SærskiltKildebeskattetCredit(dokumentreference: Tekst)
# Ligningslov33PersonKreditgruppe(identifikation: Tekst, grupperingsgrundlag: Ligningslov33Kreditgrupperingsgrundlag, fakta: Ligningslov33LandelinjeFakta, udenlandsk_indkomst_efter_danske_regler: Ligningslov33UdenlandskIndkomstEfterDanskeRegler, lønlempelsesstatus: Ligningslov33Lønlempelsesstatus)
# Ligningslov33Par6Kreditfakta(grundlag: Ligningslov33Par6Kreditgrundlag, identifikation: Tekst, grupperingsgrundlag: Ligningslov33Kreditgrupperingsgrundlag, område: Ligningslov33Skatteområde, udenlandsk_bruttoindkomst_kroner: Heltal, direkte_henførbare_udgifter_kroner: Heltal, overenskomstgrundlag: Ligningslov33Overenskomstgrundlag, udenlandsk_indkomst_efter_danske_regler: Ligningslov33UdenlandskIndkomstEfterDanskeRegler, lønlempelsesstatus: Ligningslov33Lønlempelsesstatus)
# Ligningslov33PersonÅrsinput(dansk_bruttoindkomst_kroner: Heltal, ikke_henførbare_udgifter_kroner: Heltal, eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner: Heltal, kreditgrupper: List(Ligningslov33PersonKreditgruppe), par6_kreditter: List(Ligningslov33Par6Kreditfakta))
# Ligningslov33PersonKomponentresultat(komponent: Ligningslov33DanskSkattekomponent, udenlandsk_nettoindkomst_i_beregningsgrundlaget_kroner: Heltal, forholdsmæssig_beregning: PengeØreBeregning, proportionalt_dansk_skatteloft_øre: Heltal)
# Ligningslov33PersonKreditgrupperesultat(gruppe: Ligningslov33PersonKreditgruppe, par33f: Ligningslov33FLandelinjeResultat, komponenter: List(Ligningslov33PersonKomponentresultat), input_gyldigt: Boolsk, udenlandsk_skat_efter_overenskomst_øre: Heltal, proportionalt_dansk_skatteloft_øre: Heltal, nedslag_øre: Heltal)
# Ligningslov33Par6Kreditresultat(fakta: Ligningslov33Par6Kreditfakta, kildeskat10: Kildeskat10Aktivresultat, kreditgruppe: Ligningslov33PersonKreditgrupperesultat, input_gyldigt: Boolsk, udenlandsk_skat_som_kunne_være_pålignet_efter_overenskomst_øre: Heltal, nedslag_øre: Heltal)
# Ligningslov33PersonÅrsresultat(input: Ligningslov33PersonÅrsinput, dansk_skattekreds: Ligningslov33PersonDanskSkattekreds, kreditgrupper: List(Ligningslov33PersonKreditgrupperesultat), par6_kreditter: List(Ligningslov33Par6Kreditresultat), input_gyldigt: Boolsk, samlet_nedslag_før_skattecap_øre: Heltal, samlet_nedslag_øre: Heltal)

| ligningslov33_dansk_beregningsgrundlag_kroner(grundlag: Ligningslov33DanskBeregningsgrundlag) -> match grundlag {
    | Ll33SkattepligtigIndkomst(samlet_indkomst_kroner) -> samlet_indkomst_kroner
    | Ll33PersonligIndkomst(samlet_indkomst_kroner) -> samlet_indkomst_kroner
    | Ll33PersonligOgPositivKapitalindkomst(samlet_indkomst_kroner) -> samlet_indkomst_kroner
    | Ll33Aktieindkomst(samlet_indkomst_kroner) -> samlet_indkomst_kroner
    | Ll33CfcIndkomst(samlet_indkomst_kroner) -> samlet_indkomst_kroner
    | Ll33Arbejdsmarkedsbidragsgrundlag(samlet_indkomst_kroner) -> samlet_indkomst_kroner
}
| ligningslov33_dansk_skattekomponent_gyldig(komponent: Ligningslov33DanskSkattekomponent) -> ligningslov33_dansk_beregningsgrundlag_kroner(komponent.beregningsgrundlag) >= 0 && komponent.dansk_skat_før_personfradrag_øre >= 0
| ligningslov33_skattekomponent_antal(komponenter: List(Ligningslov33DanskSkattekomponent), art: Ligningslov33PersonSkattekomponentart) -> foldl(komponenter, 0, |antal: Heltal, komponent: Ligningslov33DanskSkattekomponent| antal + hvis komponent.art == art { 1 } ellers { 0 })
| ligningslov33_skattekomponenter_entydige(komponenter: List(Ligningslov33DanskSkattekomponent)) -> all(komponenter, |komponent: Ligningslov33DanskSkattekomponent| ligningslov33_skattekomponent_antal(komponenter, komponent.art) == 1)
| ligningslov33_person_dansk_skattekreds_gyldig(skattekreds: Ligningslov33PersonDanskSkattekreds) -> skattekreds.samlet_dansk_indkomstskat_tilgængelig_øre >= 0 && all(skattekreds.komponenter, ligningslov33_dansk_skattekomponent_gyldig) && ligningslov33_skattekomponenter_entydige(skattekreds.komponenter)
| ligningslov33_udenlandsk_indkomst_efter_danske_regler_gyldig(indkomst: Ligningslov33UdenlandskIndkomstEfterDanskeRegler, status: Ligningslov33Lønlempelsesstatus) -> indkomst.positiv_kapitalnettoindkomst_efter_par33f_kroner >= 0 && indkomst.arbejdsmarkedsbidragsgrundlag_kroner >= 0 && (status != Ll33IngenLønindkomst || indkomst.arbejdsmarkedsbidragsgrundlag_kroner == 0) && ligningslov33_lønlempelsesstatus_tillader_credit(status)
| ligningslov33_kreditgrupperingsgrundlag_gyldigt(grundlag: Ligningslov33Kreditgrupperingsgrundlag) -> match grundlag {
    | Ll33SamletIndkomstFraSkatteområdet -> Sandt
    | Ll33SærskiltKildebeskattetCredit(dokumentreference) -> dokumentreference != ""
}
| ligningslov33_person_kreditgruppe_gyldig(gruppe: Ligningslov33PersonKreditgruppe) -> gruppe.identifikation != "" && ligningslov33_kreditgrupperingsgrundlag_gyldigt(gruppe.grupperingsgrundlag) && ligningslov33_landelinje_fakta_gyldige(gruppe.fakta) && ligningslov33_udenlandsk_indkomst_efter_danske_regler_gyldig(gruppe.udenlandsk_indkomst_efter_danske_regler, gruppe.lønlempelsesstatus)
| ligningslov33_person_kreditgruppe_antal(grupper: List(Ligningslov33PersonKreditgruppe), identifikation: Tekst) -> foldl(grupper, 0, |antal: Heltal, gruppe: Ligningslov33PersonKreditgruppe| antal + hvis gruppe.identifikation == identifikation { 1 } ellers { 0 })
| ligningslov33_person_kreditgrupper_entydige(grupper: List(Ligningslov33PersonKreditgruppe)) -> all(grupper, |gruppe: Ligningslov33PersonKreditgruppe| ligningslov33_person_kreditgruppe_antal(grupper, gruppe.identifikation) == 1)
| ligningslov33_person_kreditgruppe_er_samlet(gruppe: Ligningslov33PersonKreditgruppe) -> match gruppe.grupperingsgrundlag {
    | Ll33SamletIndkomstFraSkatteområdet -> Sandt
    | Ll33SærskiltKildebeskattetCredit(_) -> Falskt
}
| ligningslov33_person_samlede_områdegrupper_antal(grupper: List(Ligningslov33PersonKreditgruppe), område: Ligningslov33Skatteområde) -> foldl(grupper, 0, |antal: Heltal, gruppe: Ligningslov33PersonKreditgruppe| antal + hvis gruppe.fakta.område == område && ligningslov33_person_kreditgruppe_er_samlet(gruppe) { 1 } ellers { 0 })
| ligningslov33_person_områdegruppering_gyldig(grupper: List(Ligningslov33PersonKreditgruppe)) -> all(grupper, |gruppe: Ligningslov33PersonKreditgruppe| ligningslov33_person_samlede_områdegrupper_antal(grupper, gruppe.fakta.område) <= 1)
| ligningslov33_par6_kreditgruppe(fakta: Ligningslov33Par6Kreditfakta) -> Ligningslov33PersonKreditgruppe(
    identifikation = fakta.identifikation,
    grupperingsgrundlag = fakta.grupperingsgrundlag,
    fakta = Ligningslov33LandelinjeFakta(
        område = fakta.område,
        opkrævningsmåde = Ll33DirektePåligning,
        udenlandsk_bruttoindkomst_kroner = fakta.udenlandsk_bruttoindkomst_kroner,
        direkte_henførbare_udgifter_kroner = fakta.direkte_henførbare_udgifter_kroner,
        betalt_udenlandsk_skat_øre = 0,
        skatteart = Ll33Indkomstskat,
        betalingsdokumentreference = "",
        overenskomstgrundlag = fakta.overenskomstgrundlag
    ),
    udenlandsk_indkomst_efter_danske_regler = fakta.udenlandsk_indkomst_efter_danske_regler,
    lønlempelsesstatus = fakta.lønlempelsesstatus
)
| ligningslov33_par6_kreditfakta_gyldige(fakta: Ligningslov33Par6Kreditfakta) -> ligningslov33_par6_kreditgrundlag_gyldigt(fakta.grundlag) && ligningslov33_person_kreditgruppe_gyldig(ligningslov33_par6_kreditgruppe(fakta))
| ligningslov33_person_par6_kreditgrupper(input: Ligningslov33PersonÅrsinput) -> map(input.par6_kreditter, ligningslov33_par6_kreditgruppe)
| ligningslov33_person_alle_kreditgrupper(input: Ligningslov33PersonÅrsinput) -> concat(input.kreditgrupper, ligningslov33_person_par6_kreditgrupper(input))
| ligningslov33_person_til_par33f_input(input: Ligningslov33PersonÅrsinput) -> Ligningslov33Årsinput(
    dansk_bruttoindkomst_kroner = input.dansk_bruttoindkomst_kroner,
    ikke_henførbare_udgifter_kroner = input.ikke_henførbare_udgifter_kroner,
    eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = input.eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner,
    landelinjer = map(ligningslov33_person_alle_kreditgrupper(input), |gruppe: Ligningslov33PersonKreditgruppe| gruppe.fakta)
)
| ligningslov33_person_årsinput_gyldigt(input: Ligningslov33PersonÅrsinput) -> {
    = alle_kreditgrupper = ligningslov33_person_alle_kreditgrupper(input)
    input.dansk_bruttoindkomst_kroner >= 0 && input.ikke_henførbare_udgifter_kroner >= 0 && input.eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner >= 0 && input.eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner <= input.ikke_henførbare_udgifter_kroner && all(input.kreditgrupper, ligningslov33_person_kreditgruppe_gyldig) && all(input.par6_kreditter, ligningslov33_par6_kreditfakta_gyldige) && ligningslov33_person_kreditgrupper_entydige(alle_kreditgrupper) && ligningslov33_person_områdegruppering_gyldig(alle_kreditgrupper)
}
| ligningslov33_person_par33f_resultat(input: Ligningslov33PersonÅrsinput, gruppe: Ligningslov33PersonKreditgruppe) -> {
    = par33f_input = ligningslov33_person_til_par33f_input(input)
    = input_gyldigt = ligningslov33_person_årsinput_gyldigt(input) && ligningslov33_person_kreditgruppe_gyldig(gruppe)
    Ligningslov33FLandelinjeResultat(
        fakta = gruppe.fakta,
        input_gyldigt = input_gyldigt,
        fordelt_ikke_henførbar_udgift_kroner = hvis input_gyldigt { ligningslov33_par33f_fordelt_udgift_kroner(par33f_input, gruppe.fakta) } ellers { 0 },
        nettoindkomst_efter_par33f_kroner = hvis input_gyldigt { ligningslov33_par33f_nettoindkomst_kroner(par33f_input, gruppe.fakta) } ellers { 0 }
    )
}
| ligningslov33_udenlandsk_indkomst_i_beregningsgrundlaget_kroner(grundlag: Ligningslov33DanskBeregningsgrundlag, indkomst: Ligningslov33UdenlandskIndkomstEfterDanskeRegler) -> match grundlag {
    | Ll33SkattepligtigIndkomst(_) -> indkomst.skattepligtig_nettoindkomst_efter_par33f_kroner
    | Ll33PersonligIndkomst(_) -> indkomst.personlig_nettoindkomst_efter_par33f_kroner
    | Ll33PersonligOgPositivKapitalindkomst(_) -> indkomst.personlig_nettoindkomst_efter_par33f_kroner + indkomst.positiv_kapitalnettoindkomst_efter_par33f_kroner
    | Ll33Aktieindkomst(_) -> indkomst.aktienettoindkomst_efter_par33f_kroner
    | Ll33CfcIndkomst(_) -> indkomst.cfc_nettoindkomst_efter_par33f_kroner
    | Ll33Arbejdsmarkedsbidragsgrundlag(_) -> indkomst.arbejdsmarkedsbidragsgrundlag_kroner
}
| ligningslov33_tom_forholdsmæssig_beregning() -> penge_øre_beregning(0, 1)
| ligningslov33_person_forholdsmæssig_beregning(komponent: Ligningslov33DanskSkattekomponent, udenlandsk_indkomst_kroner: Heltal) -> {
    = samlet_indkomst_kroner = ligningslov33_dansk_beregningsgrundlag_kroner(komponent.beregningsgrundlag)
    hvis ligningslov33_dansk_skattekomponent_gyldig(komponent) && samlet_indkomst_kroner > 0 && udenlandsk_indkomst_kroner > 0 {
        penge_øre_beregning(
            komponent.dansk_skat_før_personfradrag_øre * penge_mindste_beløb(udenlandsk_indkomst_kroner, samlet_indkomst_kroner),
            samlet_indkomst_kroner
        )
    } ellers {
        ligningslov33_tom_forholdsmæssig_beregning()
    }
}
| ligningslov33_person_komponentresultat(komponent: Ligningslov33DanskSkattekomponent, gruppe: Ligningslov33PersonKreditgruppe, input_gyldigt: Boolsk) -> {
    = udenlandsk_indkomst_kroner = ligningslov33_udenlandsk_indkomst_i_beregningsgrundlaget_kroner(komponent.beregningsgrundlag, gruppe.udenlandsk_indkomst_efter_danske_regler)
    = beregning = hvis input_gyldigt { ligningslov33_person_forholdsmæssig_beregning(komponent, udenlandsk_indkomst_kroner) } ellers { ligningslov33_tom_forholdsmæssig_beregning() }
    Ligningslov33PersonKomponentresultat(
        komponent = komponent,
        udenlandsk_nettoindkomst_i_beregningsgrundlaget_kroner = hvis input_gyldigt { penge_positivt_beløb(udenlandsk_indkomst_kroner) } ellers { 0 },
        forholdsmæssig_beregning = beregning,
        proportionalt_dansk_skatteloft_øre = beregning.øre_nedrundet
    )
}
| ligningslov33_person_komponentresultater(skattekreds: Ligningslov33PersonDanskSkattekreds, gruppe: Ligningslov33PersonKreditgruppe, input_gyldigt: Boolsk) -> map(skattekreds.komponenter, |komponent: Ligningslov33DanskSkattekomponent| ligningslov33_person_komponentresultat(komponent, gruppe, input_gyldigt))
| ligningslov33_person_samlet_komponentloft_øre(komponenter: List(Ligningslov33PersonKomponentresultat)) -> foldl(komponenter, 0, |sum_øre: Heltal, komponent: Ligningslov33PersonKomponentresultat| sum_øre + komponent.proportionalt_dansk_skatteloft_øre)
| ligningslov33_person_kreditgrupperesultat_med_skat(input: Ligningslov33PersonÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds, gruppe: Ligningslov33PersonKreditgruppe, udenlandsk_skat_efter_overenskomst_øre: Heltal, kreditgrundlag_gyldigt: Boolsk) -> {
    = par33f = ligningslov33_person_par33f_resultat(input, gruppe)
    = input_gyldigt = ligningslov33_person_årsinput_gyldigt(input) && ligningslov33_person_dansk_skattekreds_gyldig(skattekreds) && par33f.input_gyldigt && kreditgrundlag_gyldigt && udenlandsk_skat_efter_overenskomst_øre >= 0
    = komponenter = ligningslov33_person_komponentresultater(skattekreds, gruppe, input_gyldigt)
    = anvendelig_udenlandsk_skat_øre = hvis input_gyldigt { udenlandsk_skat_efter_overenskomst_øre } ellers { 0 }
    = proportionalt_dansk_skatteloft_øre = hvis input_gyldigt { ligningslov33_person_samlet_komponentloft_øre(komponenter) } ellers { 0 }
    Ligningslov33PersonKreditgrupperesultat(
        gruppe = gruppe,
        par33f = par33f,
        komponenter = komponenter,
        input_gyldigt = input_gyldigt,
        udenlandsk_skat_efter_overenskomst_øre = anvendelig_udenlandsk_skat_øre,
        proportionalt_dansk_skatteloft_øre = proportionalt_dansk_skatteloft_øre,
        nedslag_øre = penge_mindste_beløb(anvendelig_udenlandsk_skat_øre, proportionalt_dansk_skatteloft_øre)
    )
}
| ligningslov33_person_kreditgrupperesultat(input: Ligningslov33PersonÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds, gruppe: Ligningslov33PersonKreditgruppe) -> ligningslov33_person_kreditgrupperesultat_med_skat(
    input,
    skattekreds,
    gruppe,
    ligningslov33_udenlandsk_skat_efter_overenskomst_øre(gruppe.fakta),
    Sandt
)
| ligningslov33_person_kreditgrupperesultater(input: Ligningslov33PersonÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds) -> map(input.kreditgrupper, |gruppe: Ligningslov33PersonKreditgruppe| ligningslov33_person_kreditgrupperesultat(input, skattekreds, gruppe))
| ligningslov33_person_samlet_nedslag_øre(grupper: List(Ligningslov33PersonKreditgrupperesultat)) -> foldl(grupper, 0, |sum_øre: Heltal, gruppe: Ligningslov33PersonKreditgrupperesultat| sum_øre + gruppe.nedslag_øre)
| ligningslov33_par6_udenlandsk_skat_efter_overenskomst_øre(fakta: Ligningslov33Par6Kreditfakta) -> ligningslov33_skat_efter_overenskomst_øre(fakta.grundlag.udenlandsk_skat_som_kunne_være_pålignet_øre, fakta.overenskomstgrundlag)
| ligningslov33_par6_kreditresultat(input: Ligningslov33PersonÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds, fakta: Ligningslov33Par6Kreditfakta) -> {
    = kildeskat10 = ligningslov33_par6_kildeskat10_resultat(fakta.grundlag)
    = udenlandsk_skat_efter_overenskomst_øre = ligningslov33_par6_udenlandsk_skat_efter_overenskomst_øre(fakta)
    = kreditgruppe = ligningslov33_person_kreditgrupperesultat_med_skat(
        input,
        skattekreds,
        ligningslov33_par6_kreditgruppe(fakta),
        udenlandsk_skat_efter_overenskomst_øre,
        ligningslov33_par6_kreditfakta_gyldige(fakta)
    )
    Ligningslov33Par6Kreditresultat(
        fakta = fakta,
        kildeskat10 = kildeskat10,
        kreditgruppe = kreditgruppe,
        input_gyldigt = kreditgruppe.input_gyldigt,
        udenlandsk_skat_som_kunne_være_pålignet_efter_overenskomst_øre = hvis kreditgruppe.input_gyldigt { udenlandsk_skat_efter_overenskomst_øre } ellers { 0 },
        nedslag_øre = kreditgruppe.nedslag_øre
    )
}
| ligningslov33_par6_kreditresultater(input: Ligningslov33PersonÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds) -> map(input.par6_kreditter, |fakta: Ligningslov33Par6Kreditfakta| ligningslov33_par6_kreditresultat(input, skattekreds, fakta))
| ligningslov33_par6_samlet_nedslag_øre(kreditter: List(Ligningslov33Par6Kreditresultat)) -> foldl(kreditter, 0, |sum_øre: Heltal, kredit: Ligningslov33Par6Kreditresultat| sum_øre + kredit.nedslag_øre)
| ligningslov33_person_årsresultat(input: Ligningslov33PersonÅrsinput, skattekreds: Ligningslov33PersonDanskSkattekreds) -> {
    = kreditgrupper = ligningslov33_person_kreditgrupperesultater(input, skattekreds)
    = par6_kreditter = ligningslov33_par6_kreditresultater(input, skattekreds)
    = input_gyldigt = ligningslov33_person_årsinput_gyldigt(input) && ligningslov33_person_dansk_skattekreds_gyldig(skattekreds)
    = samlet_nedslag_før_skattecap_øre = hvis input_gyldigt { ligningslov33_person_samlet_nedslag_øre(kreditgrupper) + ligningslov33_par6_samlet_nedslag_øre(par6_kreditter) } ellers { 0 }
    Ligningslov33PersonÅrsresultat(
        input = input,
        dansk_skattekreds = skattekreds,
        kreditgrupper = kreditgrupper,
        par6_kreditter = par6_kreditter,
        input_gyldigt = input_gyldigt,
        samlet_nedslag_før_skattecap_øre = samlet_nedslag_før_skattecap_øre,
        samlet_nedslag_øre = penge_mindste_beløb(samlet_nedslag_før_skattecap_øre, skattekreds.samlet_dansk_indkomstskat_tilgængelig_øre)
    )
}

--@end:ligningsloven_par33_personberegning--
