@ sprog da

@ importer ./kapitel - 01 - indkomst

| udligningshenlæggelse_22_pct(ordning: VirksomhedsskattelovUdligningsordning, henlæggelsesår: Heltal, oprindelig_henlæggelse_kroner: Heltal, tidligere_indtægtsført_kroner: Heltal) -> VirksomhedsskattelovUdligningshenlæggelse(
    ordning = ordning,
    henlæggelsesår = henlæggelsesår,
    oprindelig_henlæggelse_kroner = oprindelig_henlæggelse_kroner,
    tidligere_indtægtsført_kroner = tidligere_indtægtsført_kroner,
    oprindelig_udligningsskat_kroner = oprindelig_henlæggelse_kroner * 2200 / 10000,
    tidligere_modregnet_udligningsskat_kroner = tidligere_indtægtsført_kroner * 2200 / 10000
)

| udlignings_oplysningsfrist(indkomstår: Heltal, handling_yyyymmdd: Heltal) -> skattekontrollov_oplysningsfrist_resultat(skattekontrollov_par10_stk2_oplysningsfrist_input(indkomstår, handling_yyyymmdd))

= udlignings_rettidig_2026 = udlignings_oplysningsfrist(2026, 20270630)

= udlignings_fifo_portefølje = [
    udligningshenlæggelse_22_pct(
        ordning = VslPar22BKonjunkturudligning,
        henlæggelsesår = 2019,
        oprindelig_henlæggelse_kroner = 80000,
        tidligere_indtægtsført_kroner = 0
    ),
    udligningshenlæggelse_22_pct(
        ordning = VslPar22BKonjunkturudligning,
        henlæggelsesår = 2018,
        oprindelig_henlæggelse_kroner = 100000,
        tidligere_indtægtsført_kroner = 0
    )
]

= udlignings_frivillig_hændelser = VirksomhedsskattelovUdligningsIndtægtsføringHændelser(
    ønsket_frivillig_indtægtsføring_kroner = 120000,
    frivillig_hævning_oplysningsfrist_resultat = udlignings_rettidig_2026,
    mindst_tre_måneder_fra_indskud = Sandt,
    personlig_indkomst_fra_selvstændig_erhvervsvirksomhed_før_henlæggelsesfradrag_og_efter_kapitalafkast_kroner = 200000,
    ophører_med_kapitalafkastordningen = Falskt,
    overgår_til_virksomhedsordningen = Falskt,
    konkursdekret_afsagt = Falskt,
    ophører_fuld_skattepligt_eller_dbo_hjemsted = Falskt,
    fortsat_skattepligtig_for_fast_driftssted = Falskt,
    ophører_skattepligt_for_fast_driftssted = Falskt
)
= udlignings_frivillig_fixture = virksomhedsskattelov22b_indtægtsføring_resultat(VirksomhedsskattelovUdligningsIndtægtsføringInput(
    ordning = VslPar22BKonjunkturudligning,
    indkomstår = 2026,
    henlæggelser = udlignings_fifo_portefølje,
    hændelser = udlignings_frivillig_hændelser,
    slutskat = VirksomhedsskattelovUdligningsSlutskatInput(
        slutskat_med_overført_restskat_kroner = 15000,
        konto_overtaget_ved_succession = Falskt,
        gift_og_samlevende_ved_årets_udløb = Falskt,
        ægtefælles_slutskat_kroner = 0,
