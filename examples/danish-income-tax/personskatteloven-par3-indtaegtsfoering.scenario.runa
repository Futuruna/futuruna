    ),
    slutskat = VirksomhedsskattelovUdligningsSlutskatInput(50000, Falskt, Falskt, 0, 0)
))

= udlignings_succession_fixture = virksomhedsskattelov22b_indtægtsføring_resultat(VirksomhedsskattelovUdligningsIndtægtsføringInput(
    ordning = VslPar22BKonjunkturudligning,
    indkomstår = 2026,
    henlæggelser = [udligningshenlæggelse_22_pct(VslPar22BKonjunkturudligning, 2016, 100000, 0)],
    hændelser = VirksomhedsskattelovUdligningsIndtægtsføringHændelser(
        ønsket_frivillig_indtægtsføring_kroner = 0,
        frivillig_hævning_oplysningsfrist_resultat = udlignings_rettidig_2026,
        mindst_tre_måneder_fra_indskud = Sandt,
        personlig_indkomst_fra_selvstændig_erhvervsvirksomhed_før_henlæggelsesfradrag_og_efter_kapitalafkast_kroner = 100000,
        ophører_med_kapitalafkastordningen = Falskt,
