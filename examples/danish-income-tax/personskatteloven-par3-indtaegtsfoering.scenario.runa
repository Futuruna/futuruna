        fortsat_skattepligtig_for_fast_driftssted = Falskt,
        ophører_skattepligt_for_fast_driftssted = Falskt
    ),
    slutskat = VirksomhedsskattelovUdligningsSlutskatInput(50000, Falskt, Falskt, 0, 0)
))

= udlignings_par22d_portefølje = [udligningshenlæggelse_22_pct(VslPar22DIndkomstudligning, 2024, 70000, 0)]
= udlignings_par22d_konkurs_fixture = virksomhedsskattelov22d_indtægtsføring_resultat(VirksomhedsskattelovUdligningsIndtægtsføringInput(
    ordning = VslPar22DIndkomstudligning,
    indkomstår = 2026,
    henlæggelser = udlignings_par22d_portefølje,
    hændelser = VirksomhedsskattelovUdligningsIndtægtsføringHændelser(
        ønsket_frivillig_indtægtsføring_kroner = 0,
        frivillig_hævning_oplysningsfrist_resultat = udlignings_rettidig_2026,
        mindst_tre_måneder_fra_indskud = Sandt,
        personlig_indkomst_fra_selvstændig_erhvervsvirksomhed_før_henlæggelsesfradrag_og_efter_kapitalafkast_kroner = 0,
        ophører_med_kapitalafkastordningen = Falskt,
        overgår_til_virksomhedsordningen = Falskt,
