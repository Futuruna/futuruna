    )
))

= udlignings_par3_bro_fixture = par3_udlignings_indtægtsføring_resultat(udlignings_frivillig_fixture)
= udlignings_par3_personlig_indkomst_fixture = par3_personlig_indkomst_resultat(Par3PersonligIndkomstInput(
    indkomstposter = [
        Par3Indkomstpost(
            indgår_i_skattepligtig_indkomst = Sandt,
            er_kapitalindkomst = Falskt,
            beløb_kroner = 500000
        ),
        par3_udlignings_indtægtsføring_indkomstpost(udlignings_frivillig_fixture)
    ],
    fradragsposter = []
))

| udligning_fifo_ældste_først: udlignings_frivillig_fixture -> head(udlignings_frivillig_fixture.opgørelser).henlæggelsesår == 2018 && head(udlignings_frivillig_fixture.opgørelser).indtægtsført_i_året_kroner == 100000 && nth(udlignings_frivillig_fixture.opgørelser, 1).henlæggelsesår == 2019 && nth(udlignings_frivillig_fixture.opgørelser, 1).indtægtsført_i_året_kroner == 20000
| udligning_frivillig_brutto_og_kontohævning: udlignings_frivillig_fixture -> udlignings_frivillig_fixture.indtægtsført_henlæggelse_kroner == 120000 && udlignings_frivillig_fixture.personlig_indkomst_tillæg_kroner == 120000 && udlignings_frivillig_fixture.udligningsskat_til_modregning_kroner == 26400 && udlignings_frivillig_fixture.konto_hævet_kroner == 93600 && udlignings_frivillig_fixture.samlet_rest_henlæggelse_efter_kroner == 60000
| udligning_stk5_modregner_og_udbetaler_rest: udlignings_frivillig_fixture -> udlignings_frivillig_fixture.slutskat_resultat.fradrag_i_egen_slutskat_kroner == 15000 && udlignings_frivillig_fixture.slutskat_resultat.egen_slutskat_efter_kroner == 0 && udlignings_frivillig_fixture.slutskat_resultat.kontant_udbetaling_kroner == 11400 && udlignings_frivillig_fixture.slutskat_resultat.fremført_til_følgende_indkomstår_kroner == 0
| udligning_tiårsfrist_tvinger_rest: udlignings_tiårsfrist_fixture -> udlignings_tiårsfrist_fixture.tiårsfrist_indtægtsføring_kroner == 50000 && udlignings_tiårsfrist_fixture.indtægtsført_henlæggelse_kroner == 50000 && head(udlignings_tiårsfrist_fixture.opgørelser).tiårsfrist_udløbet
| par22b_stk7_udligner_underskud: udlignings_underskud_fixture -> udlignings_underskud_fixture.underskud_før_indtægtsføring_kroner == 60000 && udlignings_underskud_fixture.underskud_indtægtsføring_kroner == 60000 && udlignings_underskud_fixture.indtægtsført_henlæggelse_kroner == 60000 && udlignings_underskud_fixture.samlet_rest_henlæggelse_efter_kroner == 40000
| par22b_stk8_ophør_indtægtsfører_alt: udlignings_ophør_fixture -> udlignings_ophør_fixture.ophør_uden_virksomhedsordning && udlignings_ophør_fixture.fuld_indtægtsføring_påkrævet && udlignings_ophør_fixture.indtægtsført_henlæggelse_kroner == 180000
| par22b_stk8_overgang_beskatter_valgt_del_og_overfører_rest: udlignings_overgang_fixture -> udlignings_overgang_fixture.overgang_til_virksomhedsordningen && udlignings_overgang_fixture.fuld_indtægtsføring_påkrævet == Falskt && udlignings_overgang_fixture.indtægtsført_henlæggelse_kroner == 40000 && udlignings_overgang_fixture.overført_henlæggelse_til_virksomhedsordningen_kroner == 140000 && udlignings_overgang_fixture.overført_foreløbig_skat_til_virksomhedsordningen_kroner == 30800 && udlignings_overgang_fixture.overført_til_konto_for_opsparet_overskud_kroner == 109200 && udlignings_overgang_fixture.samlet_rest_henlæggelse_efter_kroner == 0
| par22d_stk3_konkurs_indtægtsfører_uden_konkursindkomst: udlignings_par22d_konkurs_fixture -> udlignings_par22d_konkurs_fixture.konkursindtægtsføring && udlignings_par22d_konkurs_fixture.indtægtsført_henlæggelse_kroner == 70000 && udlignings_par22d_konkurs_fixture.medregnes_ikke_til_konkursindkomsten
| par22d_arver_ikke_par22b_almindeligt_ophør: udlignings_par22d_ophør_ignoreres_fixture -> udlignings_par22d_ophør_ignoreres_fixture.ophør_uden_virksomhedsordning == Falskt && udlignings_par22d_ophør_ignoreres_fixture.indtægtsført_henlæggelse_kroner == 0 && udlignings_par22d_ophør_ignoreres_fixture.samlet_rest_henlæggelse_efter_kroner == 70000
| par22d_fast_driftssted_udskyder_exitbeskatning: udlignings_fast_driftssted_fortsætter_fixture -> udlignings_fast_driftssted_fortsætter_fixture.skattepligtsophør_indtægtsføring == Falskt && udlignings_fast_driftssted_fortsætter_fixture.indtægtsført_henlæggelse_kroner == 0
