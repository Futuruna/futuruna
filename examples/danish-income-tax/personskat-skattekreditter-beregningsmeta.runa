= personskat_felt_årsopgørelse_eksakt_par55_tilbagebetalt = TypetBeregningsfelt(
    path = refof(KildeskatPar60KreditterØre::tilbagebetalt_par55_øre),
    label = "Tidligere tilbagebetalt efter KSL § 55",
    question = Some(personskat_skattekredit_par55_spørgsmål),
    help = Some(personskat_skattekredit_par55_hjælp),
    unit = Some("øre")
)
= personskat_skattekreditter_øre_metadata = Metadata(attachments = (
    Field(value = personskat_felt_årsopgørelse_eksakt_a_skat_og_am),
    Field(value = personskat_felt_årsopgørelse_eksakt_par68),
    Field(value = personskat_felt_årsopgørelse_eksakt_b_skat),
    Field(value = personskat_felt_årsopgørelse_eksakt_par59),
    Field(value = personskat_felt_årsopgørelse_eksakt_par55_tilbagebetalt),
    Source(value = kildeskatteloven_2024_460),
    Warning(value = personskat_skattekredit_kildegrænse),
))
