@ sprog da

@ importer ./metadata
@ importer ./source-status
@ importer ./slutopgoerelse
@ importer ./personskat-skattekreditter-kildekontrol

-- KSL § 60, stk. 1, litra a-c og e, samt stk. 3. Feltnavnene bevares;
-- navnlig b_skat_betalt_* og par68_indbetalt_* beskriver ikke et kontantprincip.
-- Typeankrene lader vejledningen følge kreditterne gennem andre beregninger.

= personskat_skattekreditter_øre_metadata = Metadata(attachments = (
    Source(value = kildeskatteloven_2024_460),
    Warning(value = personskat_skattekredit_kildegrænse),
    Warning(value = personskat_skattekredit_fortegnsforklaring),
))
@ meta(personskat_skattekreditter_øre_metadata) for KildeskatPar60KreditterØre

= personskat_skattekreditter_kroner_metadata = Metadata(attachments = (
    Source(value = kildeskatteloven_2024_460),
    Warning(value = personskat_skattekredit_kildegrænse),
    Warning(value = personskat_skattekredit_fortegnsforklaring),
))
@ meta(personskat_skattekreditter_kroner_metadata) for KildeskatPar60Kreditter
