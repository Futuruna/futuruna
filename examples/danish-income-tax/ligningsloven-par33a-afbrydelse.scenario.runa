| ll33a_sen_overskridelse_finder_den_43_dag: ll33a_afbrydelse_scenarie_sen -> head(head(ll33a_afbrydelse_scenarie_sen.forholdsresultater).periodevurderinger).afbrydelse == Some(Ligningslov33AAfbrydelse(årsag = Ll33AOverskridelseAf42DagesGrænsen(første_overskridelsesdato = Dato(år = 2025, måned = 7, dag = 12)), afbrydelsesdato = Dato(år = 2025, måned = 6, dag = 30), ny_udrejsedato = Dato(år = 2025, måned = 7, dag = 13)))
| ll33a_sen_overskridelse_afbryder_ved_besøgets_start: ll33a_afbrydelse_scenarie_sen -> head(head(ll33a_afbrydelse_scenarie_sen.forholdsresultater).periodevurderinger).vurderet_ophold.til_dato == Dato(år = 2025, måned = 6, dag = 30)
| ll33a_sen_overskridelse_bevarer_senere_kandidatperioder: ll33a_afbrydelse_scenarie_sen -> length(head(ll33a_afbrydelse_scenarie_sen.forholdsresultater).periodevurderinger) == 12
| ll33a_sen_overskridelse_bevarer_kvalificerende_prefix: ll33a_afbrydelse_scenarie_sen -> ll33a_afbrydelse_scenarie_sen.input_gyldigt && ll33a_afbrydelse_scenarie_sen.alle_forhold_lempelsesberettigede && head(ll33a_afbrydelse_scenarie_sen.forholdsresultater).oprindeligt_opholds_højeste_antal_danske_dage_i_afsluttet_seksmånedersperiode == 44
