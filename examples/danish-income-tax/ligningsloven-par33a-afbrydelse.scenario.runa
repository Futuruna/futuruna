                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-januar-august",
                    Dato(år = 2025, måned = 1, dag = 1),
                    Dato(år = 2025, måned = 8, dag = 31),
                    ll33a_afbrydelse_scenarie_indkomst(160000, 160000, 210000),
