                ),
            ]
        )
    )
)

= ll33a_afbrydelse_scenarie_tidlig = ll33a_afbrydelse_scenarie_resultat(
    ll33a_afbrydelse_scenarie_forhold_med_periodevalg(
        "afbrydelse-før-seks-måneder",
        ll33a_afbrydelse_scenarie_ophold(
            concat(
                ll33a_afbrydelse_scenarie_ti_weekendophold,
                ll33a_afbrydelse_scenarie_danske_dage(Dato(år = 2025, måned = 6, dag = 29), 14)
            )
        ),
        Ligningslov33APeriodevalg(valgte_udrejsedatoer = [Dato(år = 2025, måned = 2, dag = 9)]),
        Ll33ADateredeIndkomstfordelinger(
            perioder = [
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-før-senere-udrejse",
                    Dato(år = 2025, måned = 1, dag = 1),
                    Dato(år = 2025, måned = 2, dag = 8),
                    ll33a_afbrydelse_scenarie_indkomst(20000, 20000, 20000),
                    ll33a_afbrydelse_scenarie_indkomst(0, 0, 0)
                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-fra-senere-udrejse",
                    Dato(år = 2025, måned = 2, dag = 9),
                    Dato(år = 2025, måned = 6, dag = 29),
                    ll33a_afbrydelse_scenarie_indkomst(100000, 100000, 140000),
                    ll33a_afbrydelse_scenarie_indkomst(0, 0, 0)
                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-efter-tidlig-afbrydelse",
                    Dato(år = 2025, måned = 6, dag = 30),
                    Dato(år = 2025, måned = 8, dag = 31),
                    ll33a_afbrydelse_scenarie_indkomst(40000, 40000, 50000),
                    ll33a_afbrydelse_scenarie_indkomst(0, 0, 0)
                ),
            ]
        )
    )
)

= ll33a_afbrydelse_scenarie_to_lempelsesperioder = ll33a_afbrydelse_scenarie_resultat(
    ll33a_afbrydelse_scenarie_forhold_med_periodevalg(
        "to-lempelsesperioder",
        ll33a_afbrydelse_scenarie_ophold_med_slutdato(
            ll33a_afbrydelse_scenarie_danske_dage(Dato(år = 2025, måned = 6, dag = 30), 43),
            Dato(år = 2026, måned = 2, dag = 28)
        ),
        Ligningslov33APeriodevalg(valgte_udrejsedatoer = [Dato(år = 2025, måned = 1, dag = 1), Dato(år = 2025, måned = 8, dag = 11)]),
        Ll33ADateredeIndkomstfordelinger(
            perioder = [
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-før-42-dages-afbrydelse",
