                    ll33a_afbrydelse_scenarie_indkomst(10000, 10000, 10000),
                    ll33a_afbrydelse_scenarie_indkomst(10000, 10000, 10000)
                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
