                    ),
                    ll33a_afbrydelse_scenarie_danske_dage(Dato(år = 2025, måned = 7, dag = 4), 2)
                )
            ),
            Dato(år = 2026, måned = 2, dag = 28)
        ),
        Ligningslov33APeriodevalg(valgte_udrejsedatoer = [Dato(år = 2025, måned = 1, dag = 1), Dato(år = 2025, måned = 7, dag = 5)]),
        Ll33ADateredeIndkomstfordelinger(
            perioder = [
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-før-arbejdsafbrydelse",
                    Dato(år = 2025, måned = 1, dag = 1),
                    Dato(år = 2025, måned = 7, dag = 3),
                    ll33a_afbrydelse_scenarie_indkomst(120000, 120000, 160000),
                    ll33a_afbrydelse_scenarie_indkomst(20000, 20000, 20000)
                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-under-arbejdsafbrydelse",
                    Dato(år = 2025, måned = 7, dag = 4),
                    Dato(år = 2025, måned = 7, dag = 4),
                    ll33a_afbrydelse_scenarie_indkomst(10000, 10000, 10000),
                    ll33a_afbrydelse_scenarie_indkomst(10000, 10000, 10000)
                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-efter-arbejdsafbrydelse",
                    Dato(år = 2025, måned = 7, dag = 5),
                    Dato(år = 2025, måned = 12, dag = 31),
                    ll33a_afbrydelse_scenarie_indkomst(100000, 100000, 120000),
                    ll33a_afbrydelse_scenarie_indkomst(20000, 20000, 20000)
                ),
            ]
        )
    )
)

= ll33a_afbrydelse_scenarie_endagsarbejde_med_genkvalifikation = ll33a_afbrydelse_scenarie_resultat(
    ll33a_afbrydelse_scenarie_forhold_med_periodevalg(
        "endagsarbejde-med-genkvalifikation",
        ll33a_afbrydelse_scenarie_ophold_med_slutdato(
