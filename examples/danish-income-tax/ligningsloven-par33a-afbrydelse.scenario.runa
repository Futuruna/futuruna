            ),
            Dato(år = 2026, måned = 1, dag = 31)
        ),
        Ligningslov33APeriodevalg(valgte_udrejsedatoer = [Dato(år = 2025, måned = 1, dag = 1), Dato(år = 2025, måned = 7, dag = 3)]),
        Ll33ADateredeIndkomstfordelinger(
            perioder = [
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-før-endagsarbejde",
                    Dato(år = 2025, måned = 1, dag = 1),
