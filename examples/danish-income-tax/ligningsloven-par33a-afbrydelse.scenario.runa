                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-under-42-dages-afbrydelse",
                    Dato(år = 2025, måned = 7, dag = 1),
                    Dato(år = 2025, måned = 8, dag = 10),
                    ll33a_afbrydelse_scenarie_indkomst(20000, 20000, 20000),
                    ll33a_afbrydelse_scenarie_indkomst(0, 0, 0)
                ),
                ll33a_afbrydelse_scenarie_dateret_indkomstfordeling(
                    "løn-efter-ny-udrejse",
                    Dato(år = 2025, måned = 8, dag = 11),
                    Dato(år = 2025, måned = 12, dag = 31),
                    ll33a_afbrydelse_scenarie_indkomst(100000, 100000, 120000),
                    ll33a_afbrydelse_scenarie_indkomst(0, 0, 0)
                ),
            ]
        )
    )
)

= ll33a_afbrydelse_scenarie_andet_arbejde_med_genkvalifikation = ll33a_afbrydelse_scenarie_resultat(
    ll33a_afbrydelse_scenarie_forhold_med_periodevalg(
        "andet-arbejde-med-genkvalifikation",
        ll33a_afbrydelse_scenarie_ophold_med_slutdato(
            concat(
                ll33a_afbrydelse_scenarie_danske_dage(Dato(år = 2025, måned = 7, dag = 1), 2),
