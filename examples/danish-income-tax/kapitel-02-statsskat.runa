@ sprog da

@ importer ./pengebeloeb
@ importer ./skatteaar - parametre

-- Personskatteloven — statsskat og skatteværdi (§§ 5-9).
--
-- Kilde: Retsinformation, LBK nr. 1284 af 14/06/2021.
-- Officiel tekst: https://www.retsinformation.dk/eli/lta/2021/1284
-- XML: https://www.retsinformation.dk/eli/lta/2021/1284/dan/xml

----
§ 5. Indkomstskatten til staten opgøres som summen af
1) bundskat efter § 6,
2) topskat efter § 7,
3) udligningsskat efter § 7 a,
4) sundhedsbidrag efter § 8,
5) skat af aktieindkomst efter § 8 a,
6) skat af CFC-indkomst efter § 8 b og
7) skat svarende til kommunal indkomstskat efter § 8 c.
----

# StatsskatKomponent = Bundskat | Mellemskat | Topskat | Toptopskat | Udligningsskat | Sundhedsbidrag | Aktieindkomstskat | CfcIndkomstskat | KommunalLignendeStatsskat

| statsskat_indeholder(komponent: StatsskatKomponent) -> Falskt
| exception par5_historisk_bundskat statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == Bundskat
| exception par5_historisk_topskat statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == Topskat
| exception par5_historisk_udligning statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == Udligningsskat
| exception par5_historisk_sundhed statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == Sundhedsbidrag
| exception par5_historisk_aktie statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == Aktieindkomstskat
| exception par5_historisk_cfc statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == CfcIndkomstskat
| exception par5_historisk_par8c statsskat_indeholder(komponent: StatsskatKomponent) -> Sandt under komponent == KommunalLignendeStatsskat

= par5_bundskat = statsskat_indeholder(Bundskat)
= par5_topskat = statsskat_indeholder(Topskat)
= par5_udligning = statsskat_indeholder(Udligningsskat)
= par5_sundhed = statsskat_indeholder(Sundhedsbidrag)
= par5_aktie = statsskat_indeholder(Aktieindkomstskat)
= par5_cfc = statsskat_indeholder(CfcIndkomstskat)
= par5_par8c = statsskat_indeholder(KommunalLignendeStatsskat)

| par5_bundskat_indgår: par5_bundskat -> par5_bundskat == Sandt
| par5_topskat_indgår: par5_topskat -> par5_topskat == Sandt
| par5_udligning_indgår: par5_udligning -> par5_udligning == Sandt
| par5_sundhed_indgår: par5_sundhed -> par5_sundhed == Sandt
| par5_aktie_indgår: par5_aktie -> par5_aktie == Sandt
| par5_cfc_indgår: par5_cfc -> par5_cfc == Sandt
| par5_par8c_indgår: par5_par8c -> par5_par8c == Sandt

----
LOV nr. 482 af 22/05/2024, § 1, nr. 1.

§ 5 affattes således:

§ 5. Indkomstskatten til staten opgøres som summen af
1) bundskat efter § 6,
2) mellemskat efter § 7,
3) topskat efter § 7 a,
4) toptopskat efter § 8,
5) skat af aktieindkomst efter § 8 a,
6) skat af CFC-indkomst efter § 8 b og
7) skat svarende til kommunal indkomstskat efter § 8 c.

LOV nr. 482 af 22/05/2024, § 8, stk. 4.

§ 1, § 2, nr. 2 og 4, og §§ 4-6 har virkning fra og med indkomståret 2026.
----

| statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Falskt
| exception historisk_bundskat statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == Bundskat
| exception historisk_topskat statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == Topskat
| exception historisk_udligning statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == Udligningsskat
| exception historisk_sundhed statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == Sundhedsbidrag
| exception historisk_aktie statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == Aktieindkomstskat
| exception historisk_cfc statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == CfcIndkomstskat
| exception historisk_par8c statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår < 2026 && komponent == KommunalLignendeStatsskat
| exception reform_bundskat statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == Bundskat
| exception reform_mellemskat statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == Mellemskat
| exception reform_topskat statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == Topskat
| exception reform_toptopskat statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == Toptopskat
| exception reform_aktie statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == Aktieindkomstskat
| exception reform_cfc statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == CfcIndkomstskat
| exception reform_par8c statsskat_indeholder_i_år(komponent: StatsskatKomponent, skatteår: Heltal) -> Sandt under skatteår >= 2026 && komponent == KommunalLignendeStatsskat

= par5_2026_mellemskat = statsskat_indeholder_i_år(Mellemskat, 2026)
= par5_2026_toptopskat = statsskat_indeholder_i_år(Toptopskat, 2026)
= par5_2026_udligning = statsskat_indeholder_i_år(Udligningsskat, 2026)
= par5_2026_sundhed = statsskat_indeholder_i_år(Sundhedsbidrag, 2026)

| par5_2026_mellemskat_indgår: par5_2026_mellemskat -> par5_2026_mellemskat == Sandt
| par5_2026_toptopskat_indgår: par5_2026_toptopskat -> par5_2026_toptopskat == Sandt
| par5_2026_udligningsskat_udgår: par5_2026_udligning -> par5_2026_udligning == Falskt
| par5_2026_sundhedsbidrag_udgår: par5_2026_sundhed -> par5_2026_sundhed == Falskt

----
§ 6. Skatten efter § 5, nr. 1, beregnes med den procent, der anføres i stk. 2,
af den personlige indkomst med tillæg af positiv nettokapitalindkomst.

Stk. 2. For indkomståret 2021 udgør procenten 12,09. For indkomståret 2022 og
efterfølgende indkomstår udgør procenten 12,10. For personer, der ikke har pligt
til at betale indkomstskat efter § 8 c eller kommunal indkomstskat efter lov om
kommunal indkomstskat, udgør procenten for indkomståret 2021 4,09. For
indkomståret 2022 og efterfølgende indkomstår udgør procenten 4,10.

Stk. 3. Hvis en gift person har negativ nettokapitalindkomst, modregnes dette
beløb i den anden ægtefælles positive nettokapitalindkomst, inden skatten efter
stk. 1 og 2 beregnes. Det er en forudsætning, at ægtefællerne er samlevende ved
indkomstårets udløb.
----

# KommunalSkattepligt = BetalerKommunalEllerPar8c | BetalerIkkeKommunalEllerPar8c
# BundskatInput(personlig_indkomst: Heltal, positiv_nettokapitalindkomst: Heltal)
# ÆgtefælleKapitalModregning(gift: Boolsk, samlevende_ved_årets_udløb: Boolsk, negativ_nettokapitalindkomst: Boolsk)

| bundskat_grundlag(input: BundskatInput) -> input.personlig_indkomst + input.positiv_nettokapitalindkomst

| bundskatte_sats_basispoint(år: Heltal, skattepligt: KommunalSkattepligt) -> 1209 under år == 2021 && skattepligt == BetalerKommunalEllerPar8c
| bundskatte_sats_basispoint(år: Heltal, skattepligt: KommunalSkattepligt) -> 1210 under år >= 2022 && skattepligt == BetalerKommunalEllerPar8c
| bundskatte_sats_basispoint(år: Heltal, skattepligt: KommunalSkattepligt) -> 409 under år == 2021 && skattepligt == BetalerIkkeKommunalEllerPar8c
| bundskatte_sats_basispoint(år: Heltal, skattepligt: KommunalSkattepligt) -> 410 under år >= 2022 && skattepligt == BetalerIkkeKommunalEllerPar8c

| ægtefælles_negative_kapital_modregnes(input: ÆgtefælleKapitalModregning) -> input.gift && input.samlevende_ved_årets_udløb && input.negativ_nettokapitalindkomst

= par6_grundlag = bundskat_grundlag(BundskatInput(500000, 10000))
= par6_sats_2021 = bundskatte_sats_basispoint(2021, BetalerKommunalEllerPar8c)
= par6_sats_2022 = bundskatte_sats_basispoint(2022, BetalerKommunalEllerPar8c)
= par6_sats_ikke_kommunal = bundskatte_sats_basispoint(2022, BetalerIkkeKommunalEllerPar8c)
= par6_modregning = ægtefælles_negative_kapital_modregnes(ÆgtefælleKapitalModregning(Sandt, Sandt, Sandt))

| par6_grundlag_lægger_til: par6_grundlag -> par6_grundlag == 510000
| par6_2021_sats: par6_sats_2021 -> par6_sats_2021 == 1209
| par6_2022_sats: par6_sats_2022 -> par6_sats_2022 == 1210
| par6_ikke_kommunal_sats: par6_sats_ikke_kommunal -> par6_sats_ikke_kommunal == 410
| par6_ægtefælle_modregning: par6_modregning -> par6_modregning == Sandt

----
§ 6 a. (Ophævet)
----

| par6a_ophævet() -> Sandt

----
§ 7. Skatten efter § 5, nr. 2, udgør 15 pct. af den personlige indkomst med
tillæg af heri fradragne og ikke medregnede beløb omfattet af beløbsgrænsen i
pensionsbeskatningslovens § 16, stk. 1, 4. pkt., og med tillæg af positiv
nettokapitalindkomst, der overstiger et grundbeløb på 40.000 kr. (2010-niveau),
i det omfang det samlede beløb overstiger bundfradraget anført i stk. 2.

Stk. 2. Bundfradraget udgør 389.900 kr. For indkomståret 2013 udgør
bundfradraget 421.000 kr. (2010-niveau). For indkomståret 2014 udgør
bundfradraget 441.100 kr. (2010- niveau). For indkomståret 2015 udgør
bundfradraget 444.500 kr. (2010-niveau). For indkomståret 2016 udgør
bundfradraget 446.300 kr. (2010-niveau). For indkomståret 2017 udgør
bundfradraget 448.200 kr. (2010-niveau). For indkomståret 2018 udgør
bundfradraget 456.000 kr. (2010-niveau). For indkomståret 2019 udgør
bundfradraget 459.200 kr. (2010-niveau). For indkomståret 2020 udgør
bundfradraget 464.500 (2010-niveau). For indkomståret 2021 udgør bundfradraget
466.000 kr. (2010-niveau). For indkomståret 2022 og efterfølgende indkomstår
udgør bundfradraget 467.000 kr. (2010-niveau).

Stk. 3. For personer, der ikke er omfattet af stk. 7, beregnes skat med 15 pct.
af vedkommendes personlige indkomst med tillæg af heri fradragne og ikke
medregnede beløb omfattet af beløbsgrænsen i pensionsbeskatningslovens § 16,
stk. 1, 4. pkt., i det omfang dette beregningsgrundlag overstiger bundfradraget
i stk. 2.

Stk. 4. Der beregnes tillige skat af personens positive nettokapitalindkomst,
der overstiger bundfradraget i stk. 1. Skatten beregnes med 15 pct. af
beregningsgrundlaget efter stk. 3 med tillæg af den del af den positive
nettokapitalindkomst, der overstiger grundbeløbet i stk. 1. Skatten beregnes dog
kun, i det omfang det samlede beløb overstiger bundfradraget i stk. 2. Forskellen
mellem skatten efter 2. og 3. pkt. og skatten efter stk. 3 udgør skatten af
personens positive nettokapitalindkomst, jf. dog § 19, stk. 2.

Stk. 5. Er en gift persons nettokapitalindkomst lavere end grundbeløbet for
positiv nettokapitalindkomst i stk. 1, forhøjes den anden ægtefælles grundbeløb
med forskelsbeløbet, hvis ægtefællerne er samlevende ved indkomstårets udløb. Er
personens nettokapitalindkomst negativ, modregnes dette beløb i den anden
ægtefælles positive nettokapitalindkomst, inden ægtefællens grundbeløb forhøjes
efter 1. pkt.

Stk. 6. For ægtefæller beregnes skatten efter stk. 7-12, når de er samlevende i
hele indkomståret og dette udgør en periode af et helt år.

Stk. 7. For hver ægtefælle beregnes skat med 15 pct. af vedkommendes personlige
indkomst med tillæg af heri fradragne og ikke medregnede beløb omfattet af
beløbsgrænsen i pensionsbeskatningslovens § 16, stk. 1, 4. pkt., i det omfang
dette beregningsgrundlag overstiger bundfradraget i stk. 2.

Stk. 8. Der beregnes tillige skat af ægtefællernes samlede positive
nettokapitalindkomst. Til dette formål beregnes skat hos den af ægtefællerne,
der har det højeste beregningsgrundlag efter stk. 7. Skatten beregnes med 15
pct. af denne ægtefælles beregningsgrundlag efter stk. 7 med tillæg af den del
af ægtefællernes samlede positive nettokapitalindkomst, der overstiger det
dobbelte af grundbeløbet i stk. 1. Skatten beregnes dog kun i det omfang, det
samlede beløb overstiger bundfradraget i stk. 2.

Stk. 9. Forskellen mellem skatten efter stk. 8 og skatten efter stk. 7 for den
ægtefælle, der har det højeste beregningsgrundlag efter stk. 7, udgør skatten af
ægtefællernes samlede positive nettokapitalindkomst, jf. dog § 19, stk. 2.

Stk. 10. Har kun den ene ægtefælle positiv nettokapitalindkomst over grundbeløbet
i stk. 1, påhviler den samlede skat af ægtefællernes nettokapitalindkomst efter
stk. 9 denne ægtefælle.

Stk. 11. Hvis begge ægtefæller har positiv nettokapitalindkomst over grundbeløbet
i stk. 1, fordeles skatten af ægtefællernes samlede nettokapitalindkomst imellem
dem efter forholdet mellem hver enkelt ægtefælles nettokapitalindkomst over
grundbeløbet i stk. 1.

Stk. 12. Hvis ægtefællernes beregningsgrundlag efter stk. 7 er lige store, anses
den af ægtefællerne, som har de største udgifter af den art, der fradrages ved
opgørelsen af den skattepligtige indkomst, men ikke ved opgørelsen af personlig
indkomst og kapitalindkomst, for at have det højeste beregningsgrundlag efter stk. 7.

Stk. 13. Grundbeløb og bundfradrag i stk. 1 og 2 reguleres efter § 20.
----

# TopskatInput(personlig_indkomst: Heltal, pbl16_tillæg: Heltal)
# ÆgtefælleTopskatStatus = IkkeÆgtefælleRegel | HeleÅretSamlevendeÆgtefæller
# KapitalTærskelStatus = IngenOverGrundbeløb | EnÆgtefælleOverGrundbeløb | BeggeÆgtefællerOverGrundbeløb

| topskat_sats_basispoint() -> 1500
| topskat_personligt_grundlag(input: TopskatInput) -> input.personlig_indkomst + input.pbl16_tillæg
| topskat_beregnes_over_bundfradrag(grundlag: Heltal, bundfradrag: Heltal) -> grundlag > bundfradrag
| topskat_ægtefælleregler_gælder(status: ÆgtefælleTopskatStatus) -> status == HeleÅretSamlevendeÆgtefæller
| positiv_kapital_topskat_fordeles(status: KapitalTærskelStatus) -> status == BeggeÆgtefællerOverGrundbeløb
| positiv_kapital_topskat_påhviler_ene(status: KapitalTærskelStatus) -> status == EnÆgtefælleOverGrundbeløb
| topskat_grundbeløb_reguleres_efter_par20() -> Sandt

= par7_sats = topskat_sats_basispoint()
= par7_personligt = topskat_personligt_grundlag(TopskatInput(600000, 20000))
= par7_over_bundfradrag = topskat_beregnes_over_bundfradrag(620000, 467000)
= par7_ægtefæller = topskat_ægtefælleregler_gælder(HeleÅretSamlevendeÆgtefæller)
= par7_fordeling = positiv_kapital_topskat_fordeles(BeggeÆgtefællerOverGrundbeløb)
= par7_ene = positiv_kapital_topskat_påhviler_ene(EnÆgtefælleOverGrundbeløb)

| par7_sats_15pct: par7_sats -> par7_sats == 1500
| par7_personligt_grundlag_lægger_til: par7_personligt -> par7_personligt == 620000
| par7_kun_over_bundfradrag: par7_over_bundfradrag -> par7_over_bundfradrag == Sandt
| par7_ægtefælleperiode_kræves: par7_ægtefæller -> par7_ægtefæller == Sandt
| par7_begge_positive_fordeles: par7_fordeling -> par7_fordeling == Sandt
| par7_en_positiv_påhviler_ene: par7_ene -> par7_ene == Sandt

----
LOV nr. 482 af 22/05/2024, § 1, nr. 2, 5 og 6.

§ 7, stk. 1-3, affattes således:

Skatten efter § 5, nr. 2, udgør 7,5 pct. af den personlige indkomst med tillæg
af positiv nettokapitalindkomst, der overstiger et grundbeløb på 40.000 kr.
(2010-niveau), i det omfang det samlede beløb overstiger bundfradraget anført i
stk. 2.

Stk. 2. Bundfradraget udgør 467.000 kr. (2010-niveau).
Bundfradraget reguleres efter § 20.

Stk. 3. For personer, der ikke er omfattet af stk. 7, beregnes skat med 7,5 pct.
af vedkommendes personlige indkomst, i det omfang den personlige indkomst
overstiger bundfradraget anført i stk. 2.

I § 7, stk. 4, 2. pkt., og stk. 8, 3. pkt., ændres »15 pct.« til: »7,5 pct.«

§ 7, stk. 7, affattes således:

Stk. 7. For hver ægtefælle beregnes skat med 7,5 pct. af vedkommendes
personlige indkomst, i det omfang den personlige indkomst overstiger
bundfradraget anført i stk. 2.

§ 7 a affattes således:

§ 7 a. Skatten efter § 5, nr. 3, udgør 7,5 pct. af den personlige indkomst, i det
omfang den personlige indkomst overstiger bundfradraget i stk. 2.

Stk. 2. Bundfradraget udgør 566.500 kr. (2010-niveau).
Bundfradraget reguleres efter § 20.

§ 8 affattes således:

§ 8. Skatten efter § 5, nr. 4, udgør 5 pct. af den personlige indkomst, i det
omfang den personlige indkomst overstiger bundfradraget i stk. 2.

Stk. 2. Bundfradraget udgør 1.888.300 kr. (2010-niveau).
Bundfradraget reguleres efter § 20.
----

# ProgressivStatsskatLag = MellemskatLag | TopskatLag | ToptopskatLag
# ProgressivStatsskatInput(personlig_indkomst_efter_am_kroner: Heltal, grænse_efter_am_kroner: Heltal, sats_basispoint: Heltal)
# MellemskatKapitalInput(personlig_indkomst_efter_am_kroner: Heltal, positiv_nettokapitalindkomst_kroner: Heltal, kapital_bundfradrag_kroner: Heltal, mellemskattegrænse_efter_am_kroner: Heltal, sats_basispoint: Heltal)
# MellemskatÆgtefælleKapitalInput(personlig_indkomst_efter_am_kroner: Heltal, ægtefælle_personlig_indkomst_efter_am_kroner: Heltal, positiv_nettokapitalindkomst_kroner: Heltal, ægtefælle_positiv_nettokapitalindkomst_kroner: Heltal, ægtefælle_kapital_bundfradrag_kroner: Heltal, mellemskattegrænse_efter_am_kroner: Heltal, sats_basispoint: Heltal)

| progressiv_personlig_overskud_kroner(input: ProgressivStatsskatInput) -> 0
| exception progressiv_personlig_over_grænse progressiv_personlig_overskud_kroner(input: ProgressivStatsskatInput) -> input.personlig_indkomst_efter_am_kroner - input.grænse_efter_am_kroner under input.personlig_indkomst_efter_am_kroner > input.grænse_efter_am_kroner
| progressiv_statsskat_kroner(input: ProgressivStatsskatInput) -> penge_beløb_gange_basispoint_kroner(progressiv_personlig_overskud_kroner(input), input.sats_basispoint)
| mellemskat_kapital_over_bundfradrag_kroner(input: MellemskatKapitalInput) -> 0
| exception mellemskat_kapital_over_grundbeløb mellemskat_kapital_over_bundfradrag_kroner(input: MellemskatKapitalInput) -> input.positiv_nettokapitalindkomst_kroner - input.kapital_bundfradrag_kroner under input.positiv_nettokapitalindkomst_kroner > input.kapital_bundfradrag_kroner
| mellemskat_grundlag_med_kapital_kroner(input: MellemskatKapitalInput) -> 0
| exception mellemskat_samlet_over_bundfradrag mellemskat_grundlag_med_kapital_kroner(input: MellemskatKapitalInput) -> input.personlig_indkomst_efter_am_kroner + mellemskat_kapital_over_bundfradrag_kroner(input) - input.mellemskattegrænse_efter_am_kroner under input.personlig_indkomst_efter_am_kroner + mellemskat_kapital_over_bundfradrag_kroner(input) > input.mellemskattegrænse_efter_am_kroner
| mellemskat_med_kapital_kroner(input: MellemskatKapitalInput) -> penge_beløb_gange_basispoint_kroner(mellemskat_grundlag_med_kapital_kroner(input), input.sats_basispoint)
| mellemskat_ægtefæller_samlet_positiv_kapital_kroner(input: MellemskatÆgtefælleKapitalInput) -> input.positiv_nettokapitalindkomst_kroner + input.ægtefælle_positiv_nettokapitalindkomst_kroner
| mellemskat_ægtefæller_kapital_over_bundfradrag_kroner(input: MellemskatÆgtefælleKapitalInput) -> 0
| exception mellemskat_ægtefæller_over_dobbelt_grundbeløb mellemskat_ægtefæller_kapital_over_bundfradrag_kroner(input: MellemskatÆgtefælleKapitalInput) -> mellemskat_ægtefæller_samlet_positiv_kapital_kroner(input) - input.ægtefælle_kapital_bundfradrag_kroner under mellemskat_ægtefæller_samlet_positiv_kapital_kroner(input) > input.ægtefælle_kapital_bundfradrag_kroner
| mellemskat_ægtefælle_højeste_personlig_indkomst_kroner(input: MellemskatÆgtefælleKapitalInput) -> input.personlig_indkomst_efter_am_kroner
| exception mellemskat_ægtefælle_har_højeste_personlig mellemskat_ægtefælle_højeste_personlig_indkomst_kroner(input: MellemskatÆgtefælleKapitalInput) -> input.ægtefælle_personlig_indkomst_efter_am_kroner under input.ægtefælle_personlig_indkomst_efter_am_kroner > input.personlig_indkomst_efter_am_kroner
| mellemskat_ægtefælle_personlig_grundlag_kroner(input: MellemskatÆgtefælleKapitalInput) -> 0
| exception mellemskat_ægtefælle_personlig_over_bundfradrag mellemskat_ægtefælle_personlig_grundlag_kroner(input: MellemskatÆgtefælleKapitalInput) -> mellemskat_ægtefælle_højeste_personlig_indkomst_kroner(input) - input.mellemskattegrænse_efter_am_kroner under mellemskat_ægtefælle_højeste_personlig_indkomst_kroner(input) > input.mellemskattegrænse_efter_am_kroner
| mellemskat_ægtefælle_samlet_grundlag_kroner(input: MellemskatÆgtefælleKapitalInput) -> 0
| exception mellemskat_ægtefælle_samlet_over_bundfradrag mellemskat_ægtefælle_samlet_grundlag_kroner(input: MellemskatÆgtefælleKapitalInput) -> mellemskat_ægtefælle_højeste_personlig_indkomst_kroner(input) + mellemskat_ægtefæller_kapital_over_bundfradrag_kroner(input) - input.mellemskattegrænse_efter_am_kroner under mellemskat_ægtefælle_højeste_personlig_indkomst_kroner(input) + mellemskat_ægtefæller_kapital_over_bundfradrag_kroner(input) > input.mellemskattegrænse_efter_am_kroner
| mellemskat_ægtefælle_samlet_skat_kroner(input: MellemskatÆgtefælleKapitalInput) -> penge_beløb_gange_basispoint_kroner(mellemskat_ægtefælle_samlet_grundlag_kroner(input), input.sats_basispoint)
| mellemskat_ægtefælle_personlig_skat_kroner(input: MellemskatÆgtefælleKapitalInput) -> penge_beløb_gange_basispoint_kroner(mellemskat_ægtefælle_personlig_grundlag_kroner(input), input.sats_basispoint)
| mellemskat_ægtefælle_kapital_skat_kroner(input: MellemskatÆgtefælleKapitalInput) -> mellemskat_ægtefælle_samlet_skat_kroner(input) - mellemskat_ægtefælle_personlig_skat_kroner(input)
| reform_statskat_sats_basispoint(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 0
| exception mellemskat_2026 reform_statskat_sats_basispoint(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 750 under skatteår >= 2026 && lag == MellemskatLag
| exception topskat_2026 reform_statskat_sats_basispoint(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 750 under skatteår >= 2026 && lag == TopskatLag
| exception toptopskat_2026 reform_statskat_sats_basispoint(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 500 under skatteår >= 2026 && lag == ToptopskatLag
| reform_statskat_grænse_efter_am_kroner(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 0
| exception mellemskat_grænse_2026 reform_statskat_grænse_efter_am_kroner(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 641200 under skatteår == 2026 && lag == MellemskatLag
| exception topskat_grænse_2026 reform_statskat_grænse_efter_am_kroner(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 777900 under skatteår == 2026 && lag == TopskatLag
| exception toptopskat_grænse_2026 reform_statskat_grænse_efter_am_kroner(lag: ProgressivStatsskatLag, skatteår: Heltal) -> 2592700 under skatteår == 2026 && lag == ToptopskatLag
| reform_statskat_input(lag: ProgressivStatsskatLag, skatteår: Heltal, personlig_indkomst_efter_am_kroner: Heltal) -> ProgressivStatsskatInput(personlig_indkomst_efter_am_kroner, reform_statskat_grænse_efter_am_kroner(lag, skatteår), reform_statskat_sats_basispoint(lag, skatteår))
| reform_statskat_kroner(lag: ProgressivStatsskatLag, skatteår: Heltal, personlig_indkomst_efter_am_kroner: Heltal) -> progressiv_statsskat_kroner(reform_statskat_input(lag, skatteår, personlig_indkomst_efter_am_kroner))

= par7_2026_mellemskat_under = reform_statskat_kroner(MellemskatLag, 2026, 641200)
= par7_2026_mellemskat_over = reform_statskat_kroner(MellemskatLag, 2026, 651200)
= par7a_2026_topskat_over = reform_statskat_kroner(TopskatLag, 2026, 800000)
= par8_2026_toptopskat_over = reform_statskat_kroner(ToptopskatLag, 2026, 2600000)
= par7_2026_mellemskat_kapital_input = MellemskatKapitalInput(598000, 110000, 55000, 641200, 750)
= par7_2026_mellemskat_kapital_skat = mellemskat_med_kapital_kroner(par7_2026_mellemskat_kapital_input)
= par7_2026_mellemskat_ægtefæller_input = MellemskatÆgtefælleKapitalInput(650000, 500000, 70000, 50000, 110000, 641200, 750)
= par7_2026_mellemskat_ægtefæller_kapital_over = mellemskat_ægtefæller_kapital_over_bundfradrag_kroner(par7_2026_mellemskat_ægtefæller_input)
= par7_2026_mellemskat_ægtefæller_kapital_skat = mellemskat_ægtefælle_kapital_skat_kroner(par7_2026_mellemskat_ægtefæller_input)

| par7_2026_mellemskat_under_grænse: par7_2026_mellemskat_under -> par7_2026_mellemskat_under == 0
| par7_2026_mellemskat_aktiveres: par7_2026_mellemskat_over -> par7_2026_mellemskat_over == 750
| par7a_2026_topskat_aktiveres: par7a_2026_topskat_over -> par7a_2026_topskat_over == 1657
| par8_2026_toptopskat_aktiveres: par8_2026_toptopskat_over -> par8_2026_toptopskat_over == 365
| par7_2026_mellemskat_kapital_aktiveres: par7_2026_mellemskat_kapital_skat -> par7_2026_mellemskat_kapital_skat == 885
| par7_2026_mellemskat_ægtefæller_bruger_dobbelt_grundbeløb: par7_2026_mellemskat_ægtefæller_kapital_over -> par7_2026_mellemskat_ægtefæller_kapital_over == 10000
| par7_2026_mellemskat_ægtefæller_kapitalskat: par7_2026_mellemskat_ægtefæller_kapital_skat -> par7_2026_mellemskat_ægtefæller_kapital_skat == 750

