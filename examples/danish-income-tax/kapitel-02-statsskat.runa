= par9_høj_aktie_nedsættes = personfradrag_nedsætter(PersonfradragHøjAktieSkat)
= par9_par8c_nedsættes = personfradrag_nedsætter(PersonfradragPar8c)

| par9_bundskat_personfradrag: par9_bundskat_nedsættes -> par9_bundskat_nedsættes == Sandt
| par9_aktie_personfradrag: par9_høj_aktie_nedsættes -> par9_høj_aktie_nedsættes == Sandt
| par9_par8c_personfradrag: par9_par8c_nedsættes -> par9_par8c_nedsættes == Sandt
