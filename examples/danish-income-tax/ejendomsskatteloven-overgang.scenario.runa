@ sprog da

@ importer ./ejendomsskatteloven

| ejsk_overgang_kontekst(indkomstår: Heltal, pensionsalder: EjendomsskattelovFolkepensionsalder) -> EjendomsskattelovPersonÅrskontekst(
    indkomstår = indkomstår,
    kildefakta = EjendomsskattelovPersonKildeFakta(
        ejer_folkepensionsalder = pensionsalder,
        samlevende_ægtefælles_folkepensionsalder = EjskFolkepensionsalderIkkeOpnået,
        skattemæssigt_hjemsted = EjskFuldtSkattepligtigEfterKildeskattelovensPar1,
        egen_udbytteindkomst_kroner = 0,
        ægtefælles_udbytteindkomst_kroner = 0,
        egne_historiske_aktielønshændelser = [],
        ægtefælles_historiske_aktielønshændelser = []
    ),
    egen_indkomst = EjendomsskattelovIndkomstkomponenter(
        personlig_indkomst_kroner = 0,
        kapitalindkomst_kroner = 0,
        aktieindkomst_kroner = 0
    ),
    ægtefælles_indkomst = EjendomsskattelovIndkomstkomponenter(
        personlig_indkomst_kroner = 0,
        kapitalindkomst_kroner = 0,
        aktieindkomst_kroner = 0
    ),
    gift_og_samlevende_ved_indkomstårets_udgang = Falskt
)

| ejsk_overgang_ordinært_grundlag(identifikation: Tekst, ejendomsværdi_kroner: Heltal, grundværdi_kroner: Heltal, ejerandel_basispoint: Heltal, kategori: EjendomsskattelovPar3Kategori) -> EjendomsskattelovOrdinærPersonEjendomFakta(
    identifikation = identifikation,
    kommune = København,
    kategori = kategori,
    beliggenhed = EjskDanmark,
    erhvervsmæssigt_udlejet = Falskt,
    særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt,
    ejendomsværdi_kroner = ejendomsværdi_kroner,
    grundværdi_kroner = grundværdi_kroner,
    produktionsjord = Falskt,
    ejendomsværdiskatteperiode = HeleEjendomsskatteåret,
    grundskyldsperiode = HeleEjendomsskatteåret,
    ejerandel_basispoint = ejerandel_basispoint
)

| ejsk_overgang_ordinært_delårsgrundlag(identifikation: Tekst, grundværdi_kroner: Heltal, startmåned: Heltal, startdag: Heltal) -> EjendomsskattelovOrdinærPersonEjendomFakta(
    identifikation = identifikation,
    kommune = København,
    kategori = EjskAndenEjendom,
    beliggenhed = EjskDanmark,
    erhvervsmæssigt_udlejet = Falskt,
    særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt,
    ejendomsværdi_kroner = 0,
    grundværdi_kroner = grundværdi_kroner,
    produktionsjord = Falskt,
    ejendomsværdiskatteperiode = HeleEjendomsskatteåret,
    grundskyldsperiode = EjendomsskatFraOgMed(EjendomsskattelovDato(år = 2025, måned = startmåned, dag = startdag)),
    ejerandel_basispoint = 10000
)

| ejsk_overgang_nedslagsfakta(erhvervelsesdato: EjendomsskattelovDato) -> EjendomsskattelovNedslagsfakta(
    ejerskabshistorik = EjendomsskattelovEjerskabshistorik(
        oprindelig_erhvervelsesdato = erhvervelsesdato,
        ejerskifter = []
    ),
    boliganvendelse = EjskHelårsbolig,
    selvstændige_boligenheder = 1,
    ejendomsform = EjskIkkeEjerlejlighed,
    fredet_og_omfattet_af_ligningslovens_par15k = Falskt,
    par24_beregningsgrundlag = EjskPar24SammeVærdiSomPar13,
    pensionistsuccession = EjskIngenPensionistsuccession,
    udenlandske_ejendomsskatter = []
)

| ejsk_overgang_historisk_ejendomsværdiskat(beregningsgrundlag_kroner: Heltal) -> EjendomsskattelovTidligereEjendomsværdiskat2024Fakta(
    ejendomsværdi_året_før_kroner = beregningsgrundlag_kroner * 100 / 80,
    ejendomsværdi_2001_kroner = beregningsgrundlag_kroner,
    ejendomsværdi_2002_kroner = beregningsgrundlag_kroner,
    historisk_begrænsning = EjendomsskattelovEvslHistoriskeBegrænsningsfakta(
        foregående_indkomstårs_ejendomsværdiskat_øre = None,
        par9b_nedsættelse_øre = 0,
        vurderet_helt_eller_delvis_benyttet_til_ejerbolig = Sandt,
        ejerlejlighed_frigjort_for_lejemål = Falskt,
        ombygning_over_100_procent = Falskt
    ),
    udenlandske_ejendomsskatter = []
)

| ejsk_overgang_historisk_grundskyld(afgiftspligtig_grundværdi_kroner: Heltal, foregående_grundværdi_kroner: Heltal, promille_tiendedele: Heltal) -> EjendomsskattelovTidligereGrundskyld2024Fakta(
    grundværdi_efter_fradrag_og_fritagelser_kroner = afgiftspligtig_grundværdi_kroner,
    foregående_års_afgiftspligtige_grundværdi_kroner = foregående_grundværdi_kroner,
    grundskyld_promille_2023_tiendedele = promille_tiendedele
)

| ejsk_overgang_ejerbolig_omfang() -> EjendomsskattelovOvergangsomfang(
    vurderingskategori = EjskEjerboligEfterEjendomsvurderingslovensPar3Stk1Nr1,
    ejerkreds = EjskKunFysiskeEjere
)

| ejsk_overgang_anden_ejendom_omfang() -> EjendomsskattelovOvergangsomfang(
    vurderingskategori = EjskAndenVurderingskategori,
    ejerkreds = EjskKunFysiskeEjere
)

| ejsk_overgang_rabat_2024_fakta(identifikation: Tekst, ny_ejendomsværdi_kroner: Heltal, tidligere_beregningsgrundlag_kroner: Heltal, erhvervelsesdato: EjendomsskattelovDato, pensionsalder: EjendomsskattelovFolkepensionsalder) -> EjendomsskattelovRabat2024Fakta(
    kontekst_2024 = ejsk_overgang_kontekst(2024, pensionsalder),
    ny_lov_helårsgrundlag = ejsk_overgang_ordinært_grundlag(identifikation, ny_ejendomsværdi_kroner, 0, 10000, EjskEnBoligenhed),
    ny_lov_nedslagsfakta = ejsk_overgang_nedslagsfakta(erhvervelsesdato),
    tidligere_ejendomsværdiskat = ejsk_overgang_historisk_ejendomsværdiskat(tidligere_beregningsgrundlag_kroner),
    tidligere_grundskyld = ejsk_overgang_historisk_grundskyld(0, 0, 0),
    byggeri = EjskIngenNyEllerOmbygning,
    grundskyld_fritaget_basispoint = 0,
    grundskyld_kan_fordeles_på_samme_boligenhed = Sandt
)

= ejsk_overgang_officielt_rabatgrundlag = ejsk_overgang_rabat_2024_fakta(
    "officielt-rabateksempel",
    2250000,
    850000,
    EjendomsskattelovDato(år = 1998, måned = 7, dag = 1),
    EjskFolkepensionsalderIkkeOpnået
)

= ejsk_overgang_officielt_resultat = ejendomsskattelov_person_ejendom_resultat(
    ejsk_overgang_kontekst(2024, EjskFolkepensionsalderIkkeOpnået),
    EjendomsskattelovPersonEjendomFakta(
        ordinært_grundlag = ejsk_overgang_officielt_rabatgrundlag.ny_lov_helårsgrundlag,
        nedslagsfakta = ejsk_overgang_officielt_rabatgrundlag.ny_lov_nedslagsfakta,
        overgangsomfang = ejsk_overgang_ejerbolig_omfang(),
        overgangsvurderinger = EjendomsskattelovOvergangsvurderinger(
            rabat = EjskRabatvurderingerOplyst(EjendomsskattelovRabatOvergangsfakta(
                rabat_2024 = ejsk_overgang_officielt_rabatgrundlag,
                hændelser = []
            )),
            stigningsbegrænsning = EjskIngenStigningsvurderingerOplyst
        )
    )
)

= ejsk_overgang_pensionist_rabatgrundlag = ejsk_overgang_rabat_2024_fakta(
    "officielt-pensionisteksempel",
    2000000,
    850000,
    EjendomsskattelovDato(år = 2020, måned = 1, dag = 1),
    EjskFolkepensionsalderOpnået(opnået_dato = EjendomsskattelovDato(år = 2023, måned = 1, dag = 1))
)
= ejsk_overgang_pensionist_tidligere = ejendomsskattelov_tidligere_ejendomsværdiskat_2024_resultat(ejsk_overgang_pensionist_rabatgrundlag)
= ejsk_overgang_pensionist_ny = ejendomsskattelov_nedslag_resultat(
    ejsk_overgang_pensionist_rabatgrundlag.kontekst_2024,
    ejsk_overgang_pensionist_rabatgrundlag.ny_lov_helårsgrundlag,
    ejsk_overgang_pensionist_rabatgrundlag.ny_lov_nedslagsfakta
)
= ejsk_overgang_pensionist_rabat = ejendomsskattelov_rabat_2024_resultat(ejsk_overgang_ejerbolig_omfang(), ejsk_overgang_pensionist_rabatgrundlag)

= ejsk_overgang_delvist_fritaget_rabatgrundlag = EjendomsskattelovRabat2024Fakta(
    kontekst_2024 = ejsk_overgang_kontekst(2024, EjskFolkepensionsalderIkkeOpnået),
    ny_lov_helårsgrundlag = ejsk_overgang_ordinært_grundlag("delvist-fritaget-rabateksempel", 0, 1500000, 10000, EjskEnBoligenhed),
    ny_lov_nedslagsfakta = ejsk_overgang_nedslagsfakta(EjendomsskattelovDato(år = 2020, måned = 1, dag = 1)),
    tidligere_ejendomsværdiskat = ejsk_overgang_historisk_ejendomsværdiskat(0),
    tidligere_grundskyld = ejsk_overgang_historisk_grundskyld(200000, 200000, 100),
    byggeri = EjskIngenNyEllerOmbygning,
    grundskyld_fritaget_basispoint = 5000,
    grundskyld_kan_fordeles_på_samme_boligenhed = Falskt
)
= ejsk_overgang_delvist_fritaget_rabat = ejendomsskattelov_rabat_2024_resultat(
    ejsk_overgang_ejerbolig_omfang(),
    ejsk_overgang_delvist_fritaget_rabatgrundlag
)

= ejsk_overgang_delvis_overdragelse_resultat = ejendomsskattelov_person_ejendom_resultat(
    ejsk_overgang_kontekst(2025, EjskFolkepensionsalderIkkeOpnået),
    EjendomsskattelovPersonEjendomFakta(
        ordinært_grundlag = ejsk_overgang_ordinært_grundlag("officielt-rabateksempel", 2250000, 0, 5000, EjskEnBoligenhed),
        nedslagsfakta = ejsk_overgang_officielt_rabatgrundlag.ny_lov_nedslagsfakta,
        overgangsomfang = ejsk_overgang_ejerbolig_omfang(),
        overgangsvurderinger = EjendomsskattelovOvergangsvurderinger(
            rabat = EjskRabatvurderingerOplyst(EjendomsskattelovRabatOvergangsfakta(
                rabat_2024 = ejsk_overgang_officielt_rabatgrundlag,
                hændelser = [EjendomsskattelovRabatHændelse(
                    dato = EjendomsskattelovDato(år = 2025, måned = 1, dag = 1),
                    art = EjskDelvisOverdragelseTilFysiskePersoner(ny_ejerandel_basispoint = 5000)
                )]
            )),
            stigningsbegrænsning = EjskIngenStigningsvurderingerOplyst
        )
    )
)

= ejsk_overgang_før_overdragelse = EjendomsskattelovRabatBeløbstilstand(
    ejerandel_basispoint = 10000,
    rabat_ejendomsværdiskat_helår_øre = 100000,
    rabat_grundskyld_helår_øre = 200000,
    input_gyldigt = Sandt
)
= ejsk_overgang_til_juridisk_person = ejendomsskattelov_rabatbeløb_efter_hændelse(
    ejsk_overgang_før_overdragelse,
    EjendomsskattelovRabatHændelse(
        dato = EjendomsskattelovDato(år = 2025, måned = 1, dag = 1),
        art = EjskDelvisOverdragelseTilJuridiskePersoner(ny_ejerandel_basispoint = 5000)
    )
)
= ejsk_overgang_til_ægtefælle = ejendomsskattelov_rabatbeløb_efter_hændelse(
    ejsk_overgang_før_overdragelse,
    EjendomsskattelovRabatHændelse(
        dato = EjendomsskattelovDato(år = 2025, måned = 1, dag = 1),
        art = EjskÆgtefælleOvertagerRabat
    )
)
= ejsk_overgang_almindeligt_ejerskifte = ejendomsskattelov_rabatbeløb_efter_hændelse(
    ejsk_overgang_før_overdragelse,
    EjendomsskattelovRabatHændelse(
        dato = EjendomsskattelovDato(år = 2025, måned = 1, dag = 1),
        art = EjskAlmindeligtFuldtEjerskifte
    )
)

= ejsk_overgang_stigningshistorik_2024 = EjendomsskattelovStigningsårsfakta(
    kalenderår = 2024,
    kommune = København,
    grundværdi_kroner = 1500000,
    produktionsjord = Falskt,
    ejerandel_basispoint = 10000,
    almen_bolig = Falskt,
    hændelse = EjskIngenStigningshændelse
)
= ejsk_overgang_stigningsfakta_2025 = EjendomsskattelovStigningsbegrænsningsfakta(
    tidligere_grundskyld_2024 = ejsk_overgang_historisk_grundskyld(200000, 200000, 260),
    tidligere_år = [ejsk_overgang_stigningshistorik_2024],
    aktuel_almen_bolig = Falskt,
    aktuel_hændelse = EjskIngenStigningshændelse
)
= ejsk_overgang_stigning_2024 = ejendomsskattelov_stigningsbegrænsningsresultat(
    2024,
    ejsk_overgang_anden_ejendom_omfang(),
    EjendomsskattelovStigningsbegrænsningsfakta(
        tidligere_grundskyld_2024 = ejsk_overgang_historisk_grundskyld(200000, 200000, 260),
        tidligere_år = [],
        aktuel_almen_bolig = Falskt,
        aktuel_hændelse = EjskIngenStigningshændelse
    ),
    ejsk_overgang_ordinært_grundlag("stigning-2024", 0, 1500000, 10000, EjskAndenEjendom)
)
= ejsk_overgang_stigning_2025 = ejendomsskattelov_stigningsbegrænsningsresultat(
    2025,
    ejsk_overgang_anden_ejendom_omfang(),
    ejsk_overgang_stigningsfakta_2025,
    ejsk_overgang_ordinært_grundlag("stigning-2025", 0, 2000000, 10000, EjskAndenEjendom)
)
= ejsk_overgang_almen_stigning_2025 = ejendomsskattelov_stigningsbegrænsningsresultat(
    2025,
    ejsk_overgang_anden_ejendom_omfang(),
    EjendomsskattelovStigningsbegrænsningsfakta(
        tidligere_grundskyld_2024 = ejsk_overgang_stigningsfakta_2025.tidligere_grundskyld_2024,
        tidligere_år = [EjendomsskattelovStigningsårsfakta(
            kalenderår = 2024,
            kommune = København,
            grundværdi_kroner = 1500000,
            produktionsjord = Falskt,
            ejerandel_basispoint = 10000,
            almen_bolig = Sandt,
            hændelse = EjskIngenStigningshændelse
        )],
        aktuel_almen_bolig = Sandt,
        aktuel_hændelse = EjskIngenStigningshændelse
    ),
    ejsk_overgang_ordinært_grundlag("almen-stigning-2025", 0, 2000000, 10000, EjskAndenEjendom)
)
= ejsk_overgang_nulstillet_stigning_2025 = ejendomsskattelov_stigningsbegrænsningsresultat(
    2025,
    ejsk_overgang_anden_ejendom_omfang(),
    EjendomsskattelovStigningsbegrænsningsfakta(
        tidligere_grundskyld_2024 = ejsk_overgang_stigningsfakta_2025.tidligere_grundskyld_2024,
        tidligere_år = [ejsk_overgang_stigningshistorik_2024],
        aktuel_almen_bolig = Falskt,
        aktuel_hændelse = EjskOmkategoriseretEjendom
    ),
    ejsk_overgang_ordinært_grundlag("nulstillet-stigning-2025", 0, 2000000, 10000, EjskAndenEjendom)
)
= ejsk_overgang_fritagelse_ophørt_2025 = ejendomsskattelov_stigningsbegrænsningsresultat(
    2025,
    ejsk_overgang_anden_ejendom_omfang(),
    EjendomsskattelovStigningsbegrænsningsfakta(
        tidligere_grundskyld_2024 = ejsk_overgang_stigningsfakta_2025.tidligere_grundskyld_2024,
        tidligere_år = [ejsk_overgang_stigningshistorik_2024],
        aktuel_almen_bolig = Falskt,
        aktuel_hændelse = EjskGrundskyldsfritagelseOphørt
    ),
    ejsk_overgang_ordinært_grundlag("fritagelse-ophørt-2025", 0, 2000000, 10000, EjskAndenEjendom)
)
= ejsk_overgang_offentlig_stigningsberegning = ejendomsskattelov_person_ejendom_resultat(
    ejsk_overgang_kontekst(2025, EjskFolkepensionsalderIkkeOpnået),
    EjendomsskattelovPersonEjendomFakta(
        ordinært_grundlag = ejsk_overgang_ordinært_grundlag("offentlig-stigning-2025", 0, 2000000, 10000, EjskAndenEjendom),
        nedslagsfakta = ejsk_overgang_nedslagsfakta(EjendomsskattelovDato(år = 2025, måned = 1, dag = 1)),
        overgangsomfang = ejsk_overgang_anden_ejendom_omfang(),
        overgangsvurderinger = EjendomsskattelovOvergangsvurderinger(
            rabat = EjskIngenRabatvurderingerOplyst,
            stigningsbegrænsning = EjskStigningsvurderingerOplyst(ejsk_overgang_stigningsfakta_2025)
        )
    )
)

= ejsk_overgang_halvårsgrundlag = ejsk_overgang_ordinært_delårsgrundlag("halvår-stigning-2025", 2000000, 7, 1)
= ejsk_overgang_halvårs_stigning = ejendomsskattelov_stigningsbegrænsningsresultat(
    2025,
    ejsk_overgang_anden_ejendom_omfang(),
    ejsk_overgang_stigningsfakta_2025,
    ejsk_overgang_halvårsgrundlag
)
= ejsk_overgang_offentlig_halvårs_stigningsberegning = ejendomsskattelov_person_ejendom_resultat(
    ejsk_overgang_kontekst(2025, EjskFolkepensionsalderIkkeOpnået),
    EjendomsskattelovPersonEjendomFakta(
        ordinært_grundlag = ejsk_overgang_halvårsgrundlag,
        nedslagsfakta = ejsk_overgang_nedslagsfakta(EjendomsskattelovDato(år = 2025, måned = 7, dag = 1)),
        overgangsomfang = ejsk_overgang_anden_ejendom_omfang(),
        overgangsvurderinger = EjendomsskattelovOvergangsvurderinger(
            rabat = EjskIngenRabatvurderingerOplyst,
            stigningsbegrænsning = EjskStigningsvurderingerOplyst(ejsk_overgang_stigningsfakta_2025)
        )
    )
)

= ejsk_overgang_fem_månedersgrundlag = ejsk_overgang_ordinært_delårsgrundlag("fem-måneder-uden-loft-2025", 1000007, 8, 1)
= ejsk_overgang_fem_måneder_uden_bindende_loft = ejendomsskattelov_stigningsbegrænsningsresultat(
    2025,
    ejsk_overgang_anden_ejendom_omfang(),
    EjendomsskattelovStigningsbegrænsningsfakta(
        tidligere_grundskyld_2024 = ejsk_overgang_stigningsfakta_2025.tidligere_grundskyld_2024,
        tidligere_år = [ejsk_overgang_stigningshistorik_2024],
        aktuel_almen_bolig = Falskt,
        aktuel_hændelse = EjskOmkategoriseretEjendom
    ),
    ejsk_overgang_fem_månedersgrundlag
)
= ejsk_overgang_offentlig_fem_måneder_uden_bindende_loft = ejendomsskattelov_person_ejendom_resultat(
    ejsk_overgang_kontekst(2025, EjskFolkepensionsalderIkkeOpnået),
    EjendomsskattelovPersonEjendomFakta(
        ordinært_grundlag = ejsk_overgang_fem_månedersgrundlag,
        nedslagsfakta = ejsk_overgang_nedslagsfakta(EjendomsskattelovDato(år = 2025, måned = 8, dag = 1)),
        overgangsomfang = ejsk_overgang_anden_ejendom_omfang(),
        overgangsvurderinger = EjendomsskattelovOvergangsvurderinger(
            rabat = EjskIngenRabatvurderingerOplyst,
            stigningsbegrænsning = EjskStigningsvurderingerOplyst(EjendomsskattelovStigningsbegrænsningsfakta(
                tidligere_grundskyld_2024 = ejsk_overgang_stigningsfakta_2025.tidligere_grundskyld_2024,
                tidligere_år = [ejsk_overgang_stigningshistorik_2024],
                aktuel_almen_bolig = Falskt,
                aktuel_hændelse = EjskOmkategoriseretEjendom
            ))
        )
    )
)

