# Pbl15ARegnskabsperiode(rækkefølge_fra_ældste: Heltal, startdato: Pbl15ADato, slutdato: Pbl15ADato, virksomhedens_indtægter: List(Pbl15AIndtægtspost), virksomhedens_aktiver: List(Pbl15AAktivpost), selskabsregnskaber: List(Pbl15ASelskabsregnskab))
