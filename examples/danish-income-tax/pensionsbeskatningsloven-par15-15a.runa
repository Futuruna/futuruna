# Pbl15AIndtægtspost(identifikation: Tekst, beløb_kroner: Heltal, art: Pbl15AIndtægtsart)
# Pbl15AAktivart = Pbl15APassivUdlejningsejendom | Pbl15AAktivUdlejningsejendomEfterAbl34Stk7 | Pbl15ALandbrugsEllerSkovejendom | Pbl15AKontanter | Pbl15AVærdipapirer | Pbl15AAndelOmfattetAfAbl18 | Pbl15AKoncerninternDriftsejendom | Pbl15AØvrigtDriftsaktiv
# Pbl15AAktivpost(identifikation: Tekst, handelsværdi_kroner: Heltal, art: Pbl15AAktivart)
# Pbl15AIndirekteEjervej(identifikation: Tekst, ejerandele_gennem_kæden_basispoint: List(Heltal))
# Pbl15AEjerforhold(direkte_ejerandel_basispoint: Heltal, indirekte_ejerveje: List(Pbl15AIndirekteEjervej))
# Pbl15ASelskab(identifikation: Tekst, ejerforhold: Pbl15AEjerforhold, udøver_aktiv_udlejning_efter_abl34_stk7: Boolsk)
