# Pbl15AKvalifikationsår(indkomstår: Heltal, grundlag: Pbl15AKvalifikationsårsgrund)
# Pbl15ADato(år: Heltal, måned: Heltal, dag: Heltal)
# Pbl15ATidspunkt(dato: Pbl15ADato, rækkefølge_på_dagen: Heltal)
