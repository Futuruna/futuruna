# Pbl15ASelskabsaktivopgørelse(selskab: Pbl15ASelskab, aktiernes_handelsværdi_i_virksomheden_kroner: Heltal, selskabets_aktiver_før_ejerandel: List(Pbl15AAktivpost))
# Pbl15ADatterselskabshændelse = Pbl15ADatterselskabsaktierAfstået(hændelses_identifikation: Tekst, selskab_identifikation: Tekst, tidspunkt: Pbl15ATidspunkt, provenuaktiv: Pbl15AAktivpost) | Pbl15ADatterselskabLikvideret(hændelses_identifikation: Tekst, selskab_identifikation: Tekst, tidspunkt: Pbl15ATidspunkt, provenuaktiv: Pbl15AAktivpost)
# Pbl15AHoldingafvikling = Pbl15AIntetHoldingselskab | Pbl15AHoldingFortsatBestående | Pbl15AHoldingselskabLikvideret(hændelses_identifikation: Tekst, tidspunkt: Pbl15ATidspunkt)
