# Pbl15AAfståelsesresultat(fakta: Pbl15AAfståelsesfakta, fortjenestegrundlagsresultat: Pbl15AFortjenestegrundlagsresultat, ægtefællehenføringsresultat: Option(Kildeskat25AFortjenestehenføringsresultat), skattepligtig_fortjeneste_før_am_kroner: Heltal, fakta_gyldige: Boolsk, fyldt_55_år_før_afståelsen: Boolsk, passiv_kapital_resultat: Pbl15APassivKapitalResultat, driftsbegrænsning_opfyldt: Boolsk, kvalificerer_til_ophørspension: Boolsk, højeste_indbetaling_fra_afståelsen_kroner: Heltal)
# Pbl15AOrdningsfakta(identifikation: Tekst, oprettelsesår: Heltal, art: Pbl15AOrdningsart, oprettelsesafståelse_identifikation: Tekst)
# Pbl15AOrdningsresultat(fakta: Pbl15AOrdningsfakta, fakta_gyldige: Boolsk, tilladt_ordningsart: Boolsk, oprettelsesafståelse_findes: Boolsk, oprettelsesafståelse_kvalificerer: Boolsk, rettidigt_oprettet_efter_afståelsen: Boolsk, kvalifikationsår_i_seneste_15_år: Heltal, mindst_10_kvalifikationsår: Boolsk, kvalificerer_som_ophørspension: Boolsk)
# Pbl15ATidligereIndbetaling(identifikation: Tekst, indbetalingsår: Heltal, ordning_identifikation: Tekst, afståelse_identifikation: Tekst, beløb_kroner: Heltal)
# Pbl15AÅrsgrundlag(afståelser: List(Pbl15AAfståelsesfakta), ordninger: List(Pbl15AOrdningsfakta), kvalifikationsår: List(Pbl15AKvalifikationsår), tidligere_indbetalinger: List(Pbl15ATidligereIndbetaling))
# Pbl15AÅrsgrundlagsresultat(grundlag: Pbl15AÅrsgrundlag, afståelsesresultater: List(Pbl15AAfståelsesresultat), ordningsresultater: List(Pbl15AOrdningsresultat), identifikationer_entydige: Boolsk, kvalifikationsår_entydige: Boolsk, grundfakta_gyldige: Boolsk)

| pbl15a_understøttet_indkomstår(indkomstår: Heltal) -> indkomstår >= 2009 && indkomstår <= 2026
| pbl15a_reguleret_samlet_maksimum_kroner(indkomstår: Heltal) -> 0
| exception pbl15a_regulerer_stk6_grundbeløbet pbl15a_reguleret_samlet_maksimum_kroner(indkomstår: Heltal) -> par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
    grundbeløb_2010_niveau_kroner = 2507900,
    reguleringstal_tiendedele = par20_reguleringstal_tiendedele(indkomstår)
)) under pbl15a_understøttet_indkomstår(indkomstår)

| pbl15a_skudår(år: Heltal) -> år % 400 == 0 || år % 4 == 0 && år % 100 != 0
| pbl15a_dage_i_måned(år: Heltal, måned: Heltal) -> hvis måned < 1 || måned > 12 { 0 } ellers { hvis måned == 2 { hvis pbl15a_skudår(år) { 29 } ellers { 28 } } ellers { hvis måned == 4 || måned == 6 || måned == 9 || måned == 11 { 30 } ellers { 31 } } }
| pbl15a_dato_gyldig(dato: Pbl15ADato) -> dato.år > 0 && dato.måned >= 1 && dato.måned <= 12 && dato.dag >= 1 && dato.dag <= pbl15a_dage_i_måned(dato.år, dato.måned)
| pbl15a_dato_nøgle(dato: Pbl15ADato) -> dato.år * 10000 + dato.måned * 100 + dato.dag
| pbl15a_næste_dato(dato: Pbl15ADato) -> hvis dato.dag < pbl15a_dage_i_måned(dato.år, dato.måned) { Pbl15ADato(år = dato.år, måned = dato.måned, dag = dato.dag + 1) } ellers { hvis dato.måned < 12 { Pbl15ADato(år = dato.år, måned = dato.måned + 1, dag = 1) } ellers { Pbl15ADato(år = dato.år + 1, måned = 1, dag = 1) } }
| pbl15a_dato_plus_måneder(dato: Pbl15ADato, måneder: Heltal) -> Pbl15ADato(
    år = (dato.år * 12 + dato.måned - 1 + måneder) / 12,
    måned = (dato.år * 12 + dato.måned - 1 + måneder) % 12 + 1,
    dag = penge_mindste_beløb(dato.dag, pbl15a_dage_i_måned((dato.år * 12 + dato.måned - 1 + måneder) / 12, (dato.år * 12 + dato.måned - 1 + måneder) % 12 + 1))
)
| pbl15a_tidspunkt_gyldigt(tidspunkt: Pbl15ATidspunkt) -> pbl15a_dato_gyldig(tidspunkt.dato) && tidspunkt.rækkefølge_på_dagen > 0
| pbl15a_tidspunkt_før(a: Pbl15ATidspunkt, b: Pbl15ATidspunkt) -> pbl15a_dato_nøgle(a.dato) < pbl15a_dato_nøgle(b.dato) || pbl15a_dato_nøgle(a.dato) == pbl15a_dato_nøgle(b.dato) && a.rækkefølge_på_dagen < b.rækkefølge_på_dagen
| pbl15a_dato_inden_for_højst_tolv_måneder(startdato: Pbl15ADato, slutdato: Pbl15ADato) -> pbl15a_dato_gyldig(startdato) && pbl15a_dato_gyldig(slutdato) && pbl15a_dato_nøgle(startdato) <= pbl15a_dato_nøgle(slutdato) && pbl15a_dato_nøgle(slutdato) <= pbl15a_dato_nøgle(pbl15a_dato_plus_måneder(startdato, 12))

| pbl15a_datterselskabshændelse_identifikation(hændelse: Pbl15ADatterselskabshændelse) -> match hændelse {
    | Pbl15ADatterselskabsaktierAfstået(hændelses_identifikation, _, _, _) -> hændelses_identifikation
    | Pbl15ADatterselskabLikvideret(hændelses_identifikation, _, _, _) -> hændelses_identifikation
}
| pbl15a_datterselskabshændelse_selskab_identifikation(hændelse: Pbl15ADatterselskabshændelse) -> match hændelse {
    | Pbl15ADatterselskabsaktierAfstået(_, selskab_identifikation, _, _) -> selskab_identifikation
    | Pbl15ADatterselskabLikvideret(_, selskab_identifikation, _, _) -> selskab_identifikation
}
| pbl15a_datterselskabshændelse_tidspunkt(hændelse: Pbl15ADatterselskabshændelse) -> match hændelse {
    | Pbl15ADatterselskabsaktierAfstået(_, _, tidspunkt, _) -> tidspunkt
    | Pbl15ADatterselskabLikvideret(_, _, tidspunkt, _) -> tidspunkt
}
| pbl15a_datterselskabshændelse_provenuaktiv(hændelse: Pbl15ADatterselskabshændelse) -> match hændelse {
    | Pbl15ADatterselskabsaktierAfstået(_, _, _, provenuaktiv) -> provenuaktiv
    | Pbl15ADatterselskabLikvideret(_, _, _, provenuaktiv) -> provenuaktiv
}
| pbl15a_datterselskabshændelse_identifikation_unik(hændelser: List(Pbl15ADatterselskabshændelse), hændelse: Pbl15ADatterselskabshændelse) -> length(filter(hændelser, |anden: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_identifikation(anden) == pbl15a_datterselskabshændelse_identifikation(hændelse))) == 1
| pbl15a_datterselskabshændelse_selskab_unikt(hændelser: List(Pbl15ADatterselskabshændelse), hændelse: Pbl15ADatterselskabshændelse) -> length(filter(hændelser, |anden: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_selskab_identifikation(anden) == pbl15a_datterselskabshændelse_selskab_identifikation(hændelse))) == 1
| pbl15a_datterselskabshændelse_provenu_unikt(hændelser: List(Pbl15ADatterselskabshændelse), hændelse: Pbl15ADatterselskabshændelse) -> length(filter(hændelser, |anden: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_provenuaktiv(anden).identifikation == pbl15a_datterselskabshændelse_provenuaktiv(hændelse).identifikation)) == 1
| pbl15a_datterselskabshændelse_gyldig(personens_afståelsestidspunkt: Pbl15ATidspunkt, hændelser: List(Pbl15ADatterselskabshændelse), hændelse: Pbl15ADatterselskabshændelse) -> pbl15a_datterselskabshændelse_identifikation(hændelse) != "" && pbl15a_datterselskabshændelse_selskab_identifikation(hændelse) != "" && pbl15a_tidspunkt_gyldigt(pbl15a_datterselskabshændelse_tidspunkt(hændelse)) && pbl15a_tidspunkt_før(pbl15a_datterselskabshændelse_tidspunkt(hændelse), personens_afståelsestidspunkt) && pbl15a_aktivpost_gyldig(pbl15a_datterselskabshændelse_provenuaktiv(hændelse)) && pbl15a_datterselskabshændelse_provenuaktiv(hændelse).art == Pbl15AKontanter && pbl15a_datterselskabshændelse_identifikation_unik(hændelser, hændelse) && pbl15a_datterselskabshændelse_selskab_unikt(hændelser, hændelse) && pbl15a_datterselskabshændelse_provenu_unikt(hændelser, hændelse)
| pbl15a_holdingselskab_likvideret(forløb: Pbl15AHoldingforløb) -> match forløb.afvikling {
    | Pbl15AIntetHoldingselskab -> Falskt
    | Pbl15AHoldingFortsatBestående -> Falskt
    | Pbl15AHoldingselskabLikvideret(_, _) -> Sandt
}
| pbl15a_holdingselskab_fortsat_bestående(forløb: Pbl15AHoldingforløb) -> match forløb.afvikling {
    | Pbl15AHoldingFortsatBestående -> Sandt
    | _ -> Falskt
}
| pbl15a_holdinglikvidation_inden_for_praksisgrænse(forløb: Pbl15AHoldingforløb) -> match forløb.afvikling {
    | Pbl15AIntetHoldingselskab -> Falskt
    | Pbl15AHoldingFortsatBestående -> Falskt
    | Pbl15AHoldingselskabLikvideret(_, likvidationstidspunkt) -> length(forløb.datterselskabshændelser) > 0 && all(forløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| pbl15a_dato_inden_for_højst_tolv_måneder(pbl15a_datterselskabshændelse_tidspunkt(hændelse).dato, likvidationstidspunkt.dato))
}
| pbl15a_holdingafvikling_mangler(forløb: Pbl15AHoldingforløb) -> length(forløb.datterselskabshændelser) > 0 && pbl15a_holdingselskab_fortsat_bestående(forløb)
| pbl15a_holdingafvikling_for_sen(forløb: Pbl15AHoldingforløb) -> pbl15a_holdingselskab_likvideret(forløb) && length(forløb.datterselskabshændelser) > 0 && pbl15a_holdinglikvidation_inden_for_praksisgrænse(forløb) == Falskt
| pbl15a_uden_holdingforløb() -> Pbl15AHoldingforløb(
    personens_afståelsesrækkefølge_på_dagen = 1,
    datterselskabshændelser = [],
    afvikling = Pbl15AIntetHoldingselskab
)

| pbl15a_indtægtspost_gyldig(post: Pbl15AIndtægtspost) -> post.identifikation != "" && post.beløb_kroner >= 0
| pbl15a_aktivpost_gyldig(post: Pbl15AAktivpost) -> post.identifikation != "" && post.handelsværdi_kroner >= 0
| pbl15a_indtægtsidentifikation_unik(poster: List(Pbl15AIndtægtspost), post: Pbl15AIndtægtspost) -> length(filter(poster, |anden: Pbl15AIndtægtspost| anden.identifikation == post.identifikation)) == 1
| pbl15a_aktividentifikation_unik(poster: List(Pbl15AAktivpost), post: Pbl15AAktivpost) -> length(filter(poster, |anden: Pbl15AAktivpost| anden.identifikation == post.identifikation)) == 1
| pbl15a_indtægtsposter_gyldige(poster: List(Pbl15AIndtægtspost)) -> all(poster, |post: Pbl15AIndtægtspost| pbl15a_indtægtspost_gyldig(post) && pbl15a_indtægtsidentifikation_unik(poster, post))
| pbl15a_aktivposter_gyldige(poster: List(Pbl15AAktivpost)) -> all(poster, |post: Pbl15AAktivpost| pbl15a_aktivpost_gyldig(post) && pbl15a_aktividentifikation_unik(poster, post))

| pbl15a_ejerandel_basispoint_gyldig(ejerandel_basispoint: Heltal) -> ejerandel_basispoint > 0 && ejerandel_basispoint <= 10000
| pbl15a_indirekte_ejervej_gyldig(vej: Pbl15AIndirekteEjervej) -> vej.identifikation != "" && length(vej.ejerandele_gennem_kæden_basispoint) >= 2 && all(vej.ejerandele_gennem_kæden_basispoint, pbl15a_ejerandel_basispoint_gyldig)
| pbl15a_indirekte_ejervej_identifikation_unik(veje: List(Pbl15AIndirekteEjervej), vej: Pbl15AIndirekteEjervej) -> length(filter(veje, |anden: Pbl15AIndirekteEjervej| anden.identifikation == vej.identifikation)) == 1
| pbl15a_indirekte_ejervej_basispoint(vej: Pbl15AIndirekteEjervej) -> foldl(vej.ejerandele_gennem_kæden_basispoint, 10000, |andel: Heltal, næste_led_basispoint: Heltal| andel * næste_led_basispoint / 10000)
| pbl15a_indirekte_ejerandel_basispoint(ejerforhold: Pbl15AEjerforhold) -> foldl(ejerforhold.indirekte_ejerveje, 0, |andel: Heltal, vej: Pbl15AIndirekteEjervej| andel + pbl15a_indirekte_ejervej_basispoint(vej))
| pbl15a_effektiv_ejerandel_basispoint(ejerforhold: Pbl15AEjerforhold) -> ejerforhold.direkte_ejerandel_basispoint + pbl15a_indirekte_ejerandel_basispoint(ejerforhold)
| pbl15a_ejerforhold_gyldigt(ejerforhold: Pbl15AEjerforhold) -> ejerforhold.direkte_ejerandel_basispoint >= 0 && ejerforhold.direkte_ejerandel_basispoint <= 10000 && all(ejerforhold.indirekte_ejerveje, |vej: Pbl15AIndirekteEjervej| pbl15a_indirekte_ejervej_gyldig(vej) && pbl15a_indirekte_ejervej_identifikation_unik(ejerforhold.indirekte_ejerveje, vej)) && pbl15a_effektiv_ejerandel_basispoint(ejerforhold) > 0 && pbl15a_effektiv_ejerandel_basispoint(ejerforhold) <= 10000
| pbl15a_selskab_gyldigt(selskab: Pbl15ASelskab) -> selskab.identifikation != "" && pbl15a_ejerforhold_gyldigt(selskab.ejerforhold)
| pbl15a_selskab_gennemlyses(afståelsesdato: Pbl15ADato, selskab: Pbl15ASelskab) -> pbl15a_effektiv_ejerandel_basispoint(selskab.ejerforhold) >= 2500 || (pbl15a_dato_nøgle(afståelsesdato) >= 20250101 && selskab.udøver_aktiv_udlejning_efter_abl34_stk7)
| pbl15a_selskabsregnskab_gyldigt(afståelsesdato: Pbl15ADato, regnskab: Pbl15ASelskabsregnskab) -> pbl15a_selskab_gyldigt(regnskab.selskab) && regnskab.aktiernes_handelsværdi_i_virksomheden_kroner >= 0 && regnskab.aktieafkast_i_virksomheden_kroner >= 0 && pbl15a_indtægtsposter_gyldige(regnskab.selskabets_indtægter_før_ejerandel) && pbl15a_aktivposter_gyldige(regnskab.selskabets_aktiver_før_ejerandel) && (pbl15a_selskab_gennemlyses(afståelsesdato, regnskab.selskab) == Falskt || length(regnskab.selskabets_aktiver_før_ejerandel) > 0)
| pbl15a_selskabsaktivopgørelse_gyldig(afståelsesdato: Pbl15ADato, opgørelse: Pbl15ASelskabsaktivopgørelse) -> pbl15a_selskab_gyldigt(opgørelse.selskab) && opgørelse.aktiernes_handelsværdi_i_virksomheden_kroner >= 0 && pbl15a_aktivposter_gyldige(opgørelse.selskabets_aktiver_før_ejerandel) && (pbl15a_selskab_gennemlyses(afståelsesdato, opgørelse.selskab) == Falskt || length(opgørelse.selskabets_aktiver_før_ejerandel) > 0)
| pbl15a_selskabsregnskabsidentifikation_unik(regnskaber: List(Pbl15ASelskabsregnskab), regnskab: Pbl15ASelskabsregnskab) -> length(filter(regnskaber, |andet: Pbl15ASelskabsregnskab| andet.selskab.identifikation == regnskab.selskab.identifikation)) == 1
| pbl15a_selskabsaktividentifikation_unik(opgørelser: List(Pbl15ASelskabsaktivopgørelse), opgørelse: Pbl15ASelskabsaktivopgørelse) -> length(filter(opgørelser, |anden: Pbl15ASelskabsaktivopgørelse| anden.selskab.identifikation == opgørelse.selskab.identifikation)) == 1

| pbl15a_regnskabsperiode_gyldig(afståelsesdato: Pbl15ADato, periode: Pbl15ARegnskabsperiode) -> periode.rækkefølge_fra_ældste >= 1 && periode.rækkefølge_fra_ældste <= 3 && pbl15a_dato_gyldig(periode.startdato) && pbl15a_dato_gyldig(periode.slutdato) && pbl15a_dato_nøgle(periode.startdato) <= pbl15a_dato_nøgle(periode.slutdato) && pbl15a_dato_nøgle(periode.slutdato) < pbl15a_dato_nøgle(afståelsesdato) && pbl15a_indtægtsposter_gyldige(periode.virksomhedens_indtægter) && pbl15a_aktivposter_gyldige(periode.virksomhedens_aktiver) && all(periode.selskabsregnskaber, |regnskab: Pbl15ASelskabsregnskab| pbl15a_selskabsregnskab_gyldigt(afståelsesdato, regnskab) && pbl15a_selskabsregnskabsidentifikation_unik(periode.selskabsregnskaber, regnskab))
| pbl15a_regnskabsperioder_har_entydig_rækkefølge(perioder: List(Pbl15ARegnskabsperiode)) -> all(perioder, |periode: Pbl15ARegnskabsperiode| length(filter(perioder, |anden: Pbl15ARegnskabsperiode| anden.rækkefølge_fra_ældste == periode.rækkefølge_fra_ældste)) == 1)
| pbl15a_regnskabsperioder_er_sammenhængende(perioder: List(Pbl15ARegnskabsperiode)) -> all(perioder, |periode: Pbl15ARegnskabsperiode| all(perioder, |næste: Pbl15ARegnskabsperiode| næste.rækkefølge_fra_ældste != periode.rækkefølge_fra_ældste + 1 || næste.startdato == pbl15a_næste_dato(periode.slutdato)))
| pbl15a_seneste_regnskabsperiode_støder_op_til_den_aktuelle(perioder: List(Pbl15ARegnskabsperiode), aktuel_startdato: Pbl15ADato) -> any(perioder, |periode: Pbl15ARegnskabsperiode| periode.rækkefølge_fra_ældste == 3 && aktuel_startdato == pbl15a_næste_dato(periode.slutdato))
| pbl15a_personens_afståelsestidspunkt(afståelsesdato: Pbl15ADato, forløb: Pbl15AHoldingforløb) -> Pbl15ATidspunkt(dato = afståelsesdato, rækkefølge_på_dagen = forløb.personens_afståelsesrækkefølge_på_dagen)
| pbl15a_selskab_findes_i_regnskabsperiode(periode: Pbl15ARegnskabsperiode, selskab_identifikation: Tekst) -> any(periode.selskabsregnskaber, |regnskab: Pbl15ASelskabsregnskab| regnskab.selskab.identifikation == selskab_identifikation)
| pbl15a_selskab_findes_ved_afståelse(opgørelser: List(Pbl15ASelskabsaktivopgørelse), selskab_identifikation: Tekst) -> any(opgørelser, |opgørelse: Pbl15ASelskabsaktivopgørelse| opgørelse.selskab.identifikation == selskab_identifikation)
| pbl15a_datterselskabshændelse_findes(forløb: Pbl15AHoldingforløb, selskab_identifikation: Tekst) -> any(forløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_selskab_identifikation(hændelse) == selskab_identifikation)
| pbl15a_datterselskab_består_på_dato(forløb: Pbl15AHoldingforløb, selskab_identifikation: Tekst, dato: Pbl15ADato) -> all(forløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_selskab_identifikation(hændelse) != selskab_identifikation || pbl15a_dato_nøgle(pbl15a_datterselskabshændelse_tidspunkt(hændelse).dato) > pbl15a_dato_nøgle(dato))
| pbl15a_datterselskabshændelse_har_tidligere_regnskab(perioder: List(Pbl15ARegnskabsperiode), hændelse: Pbl15ADatterselskabshændelse) -> any(perioder, |periode: Pbl15ARegnskabsperiode| pbl15a_dato_nøgle(periode.slutdato) < pbl15a_dato_nøgle(pbl15a_datterselskabshændelse_tidspunkt(hændelse).dato) && pbl15a_selskab_findes_i_regnskabsperiode(periode, pbl15a_datterselskabshændelse_selskab_identifikation(hændelse)))
| pbl15a_selskabsspor_fra_regnskab_gyldigt(fakta: Pbl15APassivKapitalFakta, startperiode: Pbl15ARegnskabsperiode, regnskab: Pbl15ASelskabsregnskab) -> all(fakta.seneste_tre_regnskabsperioder, |senere_periode: Pbl15ARegnskabsperiode| senere_periode.rækkefølge_fra_ældste <= startperiode.rækkefølge_fra_ældste || pbl15a_selskab_findes_i_regnskabsperiode(senere_periode, regnskab.selskab.identifikation) == pbl15a_datterselskab_består_på_dato(fakta.holdingforløb, regnskab.selskab.identifikation, senere_periode.slutdato)) && (pbl15a_selskab_findes_ved_afståelse(fakta.selskabsaktiver_på_overdragelsestidspunktet, regnskab.selskab.identifikation) == (pbl15a_datterselskabshændelse_findes(fakta.holdingforløb, regnskab.selskab.identifikation) == Falskt))
| pbl15a_selskabsspor_gyldige(fakta: Pbl15APassivKapitalFakta) -> all(fakta.seneste_tre_regnskabsperioder, |periode: Pbl15ARegnskabsperiode| all(periode.selskabsregnskaber, |regnskab: Pbl15ASelskabsregnskab| pbl15a_selskabsspor_fra_regnskab_gyldigt(fakta, periode, regnskab))) && all(fakta.selskabsaktiver_på_overdragelsestidspunktet, |opgørelse: Pbl15ASelskabsaktivopgørelse| pbl15a_datterselskabshændelse_findes(fakta.holdingforløb, opgørelse.selskab.identifikation) == Falskt) && all(fakta.holdingforløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_har_tidligere_regnskab(fakta.seneste_tre_regnskabsperioder, hændelse))
| pbl15a_regnskabsperiode_uden_dobbelt_selskabsaktiv(periode: Pbl15ARegnskabsperiode) -> all(periode.virksomhedens_aktiver, |aktiv: Pbl15AAktivpost| all(periode.selskabsregnskaber, |regnskab: Pbl15ASelskabsregnskab| aktiv.identifikation != regnskab.selskab.identifikation))
| pbl15a_overdragelse_uden_dobbelt_selskabsaktiv(fakta: Pbl15APassivKapitalFakta) -> all(fakta.virksomhedens_aktiver_på_overdragelsestidspunktet, |aktiv: Pbl15AAktivpost| all(fakta.selskabsaktiver_på_overdragelsestidspunktet, |opgørelse: Pbl15ASelskabsaktivopgørelse| aktiv.identifikation != opgørelse.selskab.identifikation) && all(fakta.holdingforløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| aktiv.identifikation != pbl15a_datterselskabshændelse_provenuaktiv(hændelse).identifikation)) && all(fakta.holdingforløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| all(fakta.selskabsaktiver_på_overdragelsestidspunktet, |opgørelse: Pbl15ASelskabsaktivopgørelse| pbl15a_datterselskabshændelse_provenuaktiv(hændelse).identifikation != opgørelse.selskab.identifikation))
| pbl15a_holdingafvikling_gyldig(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> match fakta.holdingforløb.afvikling {
    | Pbl15AIntetHoldingselskab -> length(fakta.holdingforløb.datterselskabshændelser) == 0
    | Pbl15AHoldingFortsatBestående -> Sandt
    | Pbl15AHoldingselskabLikvideret(hændelses_identifikation, tidspunkt) -> hændelses_identifikation != "" && length(fakta.holdingforløb.datterselskabshændelser) > 0 && pbl15a_tidspunkt_gyldigt(tidspunkt) && tidspunkt == pbl15a_personens_afståelsestidspunkt(afståelsesdato, fakta.holdingforløb) && all(fakta.holdingforløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_identifikation(hændelse) != hændelses_identifikation) && length(fakta.virksomhedens_aktiver_på_overdragelsestidspunktet) == 0 && length(fakta.selskabsaktiver_på_overdragelsestidspunktet) == 0
}
| pbl15a_holdingforløb_gyldigt(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> pbl15a_tidspunkt_gyldigt(pbl15a_personens_afståelsestidspunkt(afståelsesdato, fakta.holdingforløb)) && all(fakta.holdingforløb.datterselskabshændelser, |hændelse: Pbl15ADatterselskabshændelse| pbl15a_datterselskabshændelse_gyldig(pbl15a_personens_afståelsestidspunkt(afståelsesdato, fakta.holdingforløb), fakta.holdingforløb.datterselskabshændelser, hændelse)) && pbl15a_selskabsspor_gyldige(fakta) && all(fakta.seneste_tre_regnskabsperioder, pbl15a_regnskabsperiode_uden_dobbelt_selskabsaktiv) && pbl15a_overdragelse_uden_dobbelt_selskabsaktiv(fakta) && pbl15a_holdingafvikling_gyldig(afståelsesdato, fakta)
| pbl15a_passiv_kapital_fakta_gyldige(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> pbl15a_dato_gyldig(afståelsesdato) && pbl15a_dato_gyldig(fakta.aktuel_regnskabsperiodes_startdato) && pbl15a_dato_nøgle(fakta.aktuel_regnskabsperiodes_startdato) <= pbl15a_dato_nøgle(afståelsesdato) && length(fakta.seneste_tre_regnskabsperioder) == 3 && all(fakta.seneste_tre_regnskabsperioder, |periode: Pbl15ARegnskabsperiode| pbl15a_regnskabsperiode_gyldig(afståelsesdato, periode)) && pbl15a_regnskabsperioder_har_entydig_rækkefølge(fakta.seneste_tre_regnskabsperioder) && pbl15a_regnskabsperioder_er_sammenhængende(fakta.seneste_tre_regnskabsperioder) && pbl15a_seneste_regnskabsperiode_støder_op_til_den_aktuelle(fakta.seneste_tre_regnskabsperioder, fakta.aktuel_regnskabsperiodes_startdato) && pbl15a_aktivposter_gyldige(fakta.virksomhedens_aktiver_på_overdragelsestidspunktet) && all(fakta.selskabsaktiver_på_overdragelsestidspunktet, |opgørelse: Pbl15ASelskabsaktivopgørelse| pbl15a_selskabsaktivopgørelse_gyldig(afståelsesdato, opgørelse) && pbl15a_selskabsaktividentifikation_unik(fakta.selskabsaktiver_på_overdragelsestidspunktet, opgørelse)) && pbl15a_holdingforløb_gyldigt(afståelsesdato, fakta)
| exception pbl15a_næringsvirksomhed_er_undtaget_fra_passiv_kapitalprøven pbl15a_passiv_kapital_fakta_gyldige(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> pbl15a_dato_gyldig(afståelsesdato) && pbl15a_holdingforløb_gyldigt(afståelsesdato, fakta) under fakta.næringsvirksomhed_med_værdipapirer_eller_finansiering

| pbl15a_indtægt_medregnes_i_total(post: Pbl15AIndtægtspost) -> post.art != Pbl15AKoncerninternUdlejningsindtægt
| pbl15a_indtægt_er_passiv(afståelsesdato: Pbl15ADato, post: Pbl15AIndtægtspost) -> post.art == Pbl15APassivEjendomsindtægt || post.art == Pbl15AKontantEllerVærdipapirindtægt || (post.art == Pbl15AAktivUdlejningsindtægtEfterAbl34Stk7 && pbl15a_dato_nøgle(afståelsesdato) < 20250101)
| pbl15a_aktiv_medregnes_i_total(post: Pbl15AAktivpost) -> Sandt
| pbl15a_aktiv_er_passiv(afståelsesdato: Pbl15ADato, post: Pbl15AAktivpost) -> post.art == Pbl15APassivUdlejningsejendom || post.art == Pbl15AKontanter || post.art == Pbl15AVærdipapirer || (post.art == Pbl15AAktivUdlejningsejendomEfterAbl34Stk7 && pbl15a_dato_nøgle(afståelsesdato) < 20250101)
| pbl15a_indtægtssum_kroner(poster: List(Pbl15AIndtægtspost), medregnes: (Pbl15AIndtægtspost) -> Boolsk) -> foldl(poster, 0, |sum: Heltal, post: Pbl15AIndtægtspost| sum + hvis medregnes(post) { post.beløb_kroner } ellers { 0 })
| pbl15a_passiv_indtægtssum_kroner(afståelsesdato: Pbl15ADato, poster: List(Pbl15AIndtægtspost)) -> foldl(poster, 0, |sum: Heltal, post: Pbl15AIndtægtspost| sum + hvis pbl15a_indtægt_er_passiv(afståelsesdato, post) { post.beløb_kroner } ellers { 0 })
| pbl15a_aktivsum_kroner(poster: List(Pbl15AAktivpost), medregnes: (Pbl15AAktivpost) -> Boolsk) -> foldl(poster, 0, |sum: Heltal, post: Pbl15AAktivpost| sum + hvis medregnes(post) { post.handelsværdi_kroner } ellers { 0 })
| pbl15a_passiv_aktivsum_kroner(afståelsesdato: Pbl15ADato, poster: List(Pbl15AAktivpost)) -> foldl(poster, 0, |sum: Heltal, post: Pbl15AAktivpost| sum + hvis pbl15a_aktiv_er_passiv(afståelsesdato, post) { post.handelsværdi_kroner } ellers { 0 })

| pbl15a_kapitalsammenfatning_nul() -> Pbl15AKapitalsammenfatning(passive_indtægter_kroner = 0, samlede_indtægter_kroner = 0, passive_aktiver_kroner = 0, samlede_aktiver_kroner = 0)
| pbl15a_kapitalsammenfatning_læg_sammen(a: Pbl15AKapitalsammenfatning, b: Pbl15AKapitalsammenfatning) -> Pbl15AKapitalsammenfatning(passive_indtægter_kroner = a.passive_indtægter_kroner + b.passive_indtægter_kroner, samlede_indtægter_kroner = a.samlede_indtægter_kroner + b.samlede_indtægter_kroner, passive_aktiver_kroner = a.passive_aktiver_kroner + b.passive_aktiver_kroner, samlede_aktiver_kroner = a.samlede_aktiver_kroner + b.samlede_aktiver_kroner)
| pbl15a_kapitalsammenfatning_gange_ejerandel(sammenfatning: Pbl15AKapitalsammenfatning, ejerandel_basispoint: Heltal) -> Pbl15AKapitalsammenfatning(passive_indtægter_kroner = penge_beløb_gange_basispoint_kroner(sammenfatning.passive_indtægter_kroner, ejerandel_basispoint), samlede_indtægter_kroner = penge_beløb_gange_basispoint_kroner(sammenfatning.samlede_indtægter_kroner, ejerandel_basispoint), passive_aktiver_kroner = penge_beløb_gange_basispoint_kroner(sammenfatning.passive_aktiver_kroner, ejerandel_basispoint), samlede_aktiver_kroner = penge_beløb_gange_basispoint_kroner(sammenfatning.samlede_aktiver_kroner, ejerandel_basispoint))
| pbl15a_direkte_kapitalsammenfatning(afståelsesdato: Pbl15ADato, indtægter: List(Pbl15AIndtægtspost), aktiver: List(Pbl15AAktivpost)) -> Pbl15AKapitalsammenfatning(passive_indtægter_kroner = pbl15a_passiv_indtægtssum_kroner(afståelsesdato, indtægter), samlede_indtægter_kroner = pbl15a_indtægtssum_kroner(indtægter, pbl15a_indtægt_medregnes_i_total), passive_aktiver_kroner = pbl15a_passiv_aktivsum_kroner(afståelsesdato, aktiver), samlede_aktiver_kroner = pbl15a_aktivsum_kroner(aktiver, pbl15a_aktiv_medregnes_i_total))
| pbl15a_selskabsregnskab_sammenfatning(afståelsesdato: Pbl15ADato, regnskab: Pbl15ASelskabsregnskab) -> hvis pbl15a_selskab_gennemlyses(afståelsesdato, regnskab.selskab) { pbl15a_kapitalsammenfatning_gange_ejerandel(pbl15a_direkte_kapitalsammenfatning(afståelsesdato, regnskab.selskabets_indtægter_før_ejerandel, regnskab.selskabets_aktiver_før_ejerandel), pbl15a_effektiv_ejerandel_basispoint(regnskab.selskab.ejerforhold)) } ellers { Pbl15AKapitalsammenfatning(passive_indtægter_kroner = regnskab.aktieafkast_i_virksomheden_kroner, samlede_indtægter_kroner = regnskab.aktieafkast_i_virksomheden_kroner, passive_aktiver_kroner = regnskab.aktiernes_handelsværdi_i_virksomheden_kroner, samlede_aktiver_kroner = regnskab.aktiernes_handelsværdi_i_virksomheden_kroner) }
| pbl15a_selskabsaktivopgørelse_sammenfatning(afståelsesdato: Pbl15ADato, opgørelse: Pbl15ASelskabsaktivopgørelse) -> hvis pbl15a_selskab_gennemlyses(afståelsesdato, opgørelse.selskab) { pbl15a_kapitalsammenfatning_gange_ejerandel(pbl15a_direkte_kapitalsammenfatning(afståelsesdato, [], opgørelse.selskabets_aktiver_før_ejerandel), pbl15a_effektiv_ejerandel_basispoint(opgørelse.selskab.ejerforhold)) } ellers { Pbl15AKapitalsammenfatning(passive_indtægter_kroner = 0, samlede_indtægter_kroner = 0, passive_aktiver_kroner = opgørelse.aktiernes_handelsværdi_i_virksomheden_kroner, samlede_aktiver_kroner = opgørelse.aktiernes_handelsværdi_i_virksomheden_kroner) }
| pbl15a_regnskabsperiode_sammenfatning(afståelsesdato: Pbl15ADato, periode: Pbl15ARegnskabsperiode) -> foldl(periode.selskabsregnskaber, pbl15a_direkte_kapitalsammenfatning(afståelsesdato, periode.virksomhedens_indtægter, periode.virksomhedens_aktiver), |sum: Pbl15AKapitalsammenfatning, regnskab: Pbl15ASelskabsregnskab| pbl15a_kapitalsammenfatning_læg_sammen(sum, pbl15a_selskabsregnskab_sammenfatning(afståelsesdato, regnskab)))
| pbl15a_treårs_sammenfatning(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> foldl(fakta.seneste_tre_regnskabsperioder, pbl15a_kapitalsammenfatning_nul(), |sum: Pbl15AKapitalsammenfatning, periode: Pbl15ARegnskabsperiode| pbl15a_kapitalsammenfatning_læg_sammen(sum, pbl15a_regnskabsperiode_sammenfatning(afståelsesdato, periode)))
| pbl15a_datterselskabsprovenuaktiver(forløb: Pbl15AHoldingforløb) -> map(forløb.datterselskabshændelser, pbl15a_datterselskabshændelse_provenuaktiv)
| pbl15a_datterselskabsprovenu_før_holdingafvikling_kroner(forløb: Pbl15AHoldingforløb) -> pbl15a_aktivsum_kroner(pbl15a_datterselskabsprovenuaktiver(forløb), pbl15a_aktiv_medregnes_i_total)
| pbl15a_beholdte_datterselskabsprovenuaktiver(forløb: Pbl15AHoldingforløb) -> hvis pbl15a_holdingselskab_likvideret(forløb) { [] } ellers { pbl15a_datterselskabsprovenuaktiver(forløb) }
| pbl15a_overdragelses_sammenfatning(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> foldl(fakta.selskabsaktiver_på_overdragelsestidspunktet, pbl15a_direkte_kapitalsammenfatning(afståelsesdato, [], concat(fakta.virksomhedens_aktiver_på_overdragelsestidspunktet, pbl15a_beholdte_datterselskabsprovenuaktiver(fakta.holdingforløb))), |sum: Pbl15AKapitalsammenfatning, opgørelse: Pbl15ASelskabsaktivopgørelse| pbl15a_kapitalsammenfatning_læg_sammen(sum, pbl15a_selskabsaktivopgørelse_sammenfatning(afståelsesdato, opgørelse)))
| pbl15a_alle_regnskabsperioder_fra_2012(fakta: Pbl15APassivKapitalFakta) -> all(fakta.seneste_tre_regnskabsperioder, |periode: Pbl15ARegnskabsperiode| pbl15a_dato_nøgle(periode.startdato) >= 20120101)
| pbl15a_gennemsnitsgrænse_basispoint(fakta: Pbl15APassivKapitalFakta) -> hvis pbl15a_alle_regnskabsperioder_fra_2012(fakta) { 5000 } ellers { 7500 }
| pbl15a_overdragelsesgrænse_basispoint(afståelsesdato: Pbl15ADato) -> hvis pbl15a_dato_nøgle(afståelsesdato) <= 20131231 { 7500 } ellers { 5000 }
| pbl15a_mindst_grænse(del_kroner: Heltal, total_kroner: Heltal, grænse_basispoint: Heltal) -> total_kroner > 0 && del_kroner * 10000 >= total_kroner * grænse_basispoint

# Pbl15APassivKapitalSag(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) {
    | fakta_gyldige() -> pbl15a_passiv_kapital_fakta_gyldige(afståelsesdato, fakta)
    | holdingforløb_gyldigt() -> pbl15a_holdingforløb_gyldigt(afståelsesdato, fakta)
    | datterselskabsprovenu_før_holdingafvikling_kroner() -> pbl15a_datterselskabsprovenu_før_holdingafvikling_kroner(fakta.holdingforløb)
    | holdingselskab_likvideret() -> pbl15a_holdingselskab_likvideret(fakta.holdingforløb)
    | holdingafvikling_mangler() -> pbl15a_holdingafvikling_mangler(fakta.holdingforløb)
    | holdinglikvidation_inden_for_praksisgrænse() -> pbl15a_holdinglikvidation_inden_for_praksisgrænse(fakta.holdingforløb)
    | holdingafvikling_for_sen() -> pbl15a_holdingafvikling_for_sen(fakta.holdingforløb)
    | treårs_sammenfatning() -> pbl15a_treårs_sammenfatning(afståelsesdato, fakta)
    | overdragelses_sammenfatning() -> pbl15a_overdragelses_sammenfatning(afståelsesdato, fakta)
    | passive_indtægter_tre_år_kroner() -> treårs_sammenfatning().passive_indtægter_kroner
    | samlede_indtægter_tre_år_kroner() -> treårs_sammenfatning().samlede_indtægter_kroner
    | passive_aktiver_tre_år_kroner() -> treårs_sammenfatning().passive_aktiver_kroner
    | samlede_aktiver_tre_år_kroner() -> treårs_sammenfatning().samlede_aktiver_kroner
    | passive_aktiver_ved_afståelse_kroner() -> overdragelses_sammenfatning().passive_aktiver_kroner
    | samlede_aktiver_ved_afståelse_kroner() -> overdragelses_sammenfatning().samlede_aktiver_kroner
    | gennemsnitsgrænse_basispoint() -> pbl15a_gennemsnitsgrænse_basispoint(fakta)
    | overdragelsesgrænse_basispoint() -> pbl15a_overdragelsesgrænse_basispoint(afståelsesdato)
    | indtægtsgrænse_nået() -> pbl15a_mindst_grænse(passive_indtægter_tre_år_kroner(), samlede_indtægter_tre_år_kroner(), gennemsnitsgrænse_basispoint())
    | gennemsnitlig_aktivgrænse_nået() -> pbl15a_mindst_grænse(passive_aktiver_tre_år_kroner(), samlede_aktiver_tre_år_kroner(), gennemsnitsgrænse_basispoint())
    | aktivgrænse_ved_afståelse_nået() -> pbl15a_mindst_grænse(passive_aktiver_ved_afståelse_kroner(), samlede_aktiver_ved_afståelse_kroner(), overdragelsesgrænse_basispoint())
    | overvejende_passiv_kapitalanbringelse() -> fakta_gyldige() && fakta.næringsvirksomhed_med_værdipapirer_eller_finansiering == Falskt && (holdingafvikling_mangler() || holdingafvikling_for_sen() || indtægtsgrænse_nået() || gennemsnitlig_aktivgrænse_nået() || aktivgrænse_ved_afståelse_nået())
    | resultat() -> Pbl15APassivKapitalResultat(
        fakta = fakta,
        fakta_gyldige = fakta_gyldige(),
        holdingforløb_gyldigt = holdingforløb_gyldigt(),
        datterselskabsprovenu_før_holdingafvikling_kroner = datterselskabsprovenu_før_holdingafvikling_kroner(),
        holdingselskab_likvideret = holdingselskab_likvideret(),
        holdingafvikling_mangler = holdingafvikling_mangler(),
        holdinglikvidation_inden_for_praksisgrænse = holdinglikvidation_inden_for_praksisgrænse(),
        holdingafvikling_for_sen = holdingafvikling_for_sen(),
        passive_indtægter_tre_år_kroner = passive_indtægter_tre_år_kroner(),
        samlede_indtægter_tre_år_kroner = samlede_indtægter_tre_år_kroner(),
        passive_aktiver_tre_år_kroner = passive_aktiver_tre_år_kroner(),
        samlede_aktiver_tre_år_kroner = samlede_aktiver_tre_år_kroner(),
        passive_aktiver_ved_afståelse_kroner = passive_aktiver_ved_afståelse_kroner(),
        samlede_aktiver_ved_afståelse_kroner = samlede_aktiver_ved_afståelse_kroner(),
        gennemsnitsgrænse_basispoint = gennemsnitsgrænse_basispoint(),
        overdragelsesgrænse_basispoint = overdragelsesgrænse_basispoint(),
        indtægtsgrænse_nået = indtægtsgrænse_nået(),
        gennemsnitlig_aktivgrænse_nået = gennemsnitlig_aktivgrænse_nået(),
        aktivgrænse_ved_afståelse_nået = aktivgrænse_ved_afståelse_nået(),
        overvejende_passiv_kapitalanbringelse = overvejende_passiv_kapitalanbringelse()
    )
}
| pbl15a_passiv_kapital_resultat(afståelsesdato: Pbl15ADato, fakta: Pbl15APassivKapitalFakta) -> Pbl15APassivKapitalSag(afståelsesdato, fakta).resultat()

| pbl15a_afståelses_fortjenestegrundlagsresultat(fakta: Pbl15AAfståelsesfakta) -> pbl15a_fortjenestegrundlagsresultat(fakta.afståelsesdato.år, fakta.fortjenestegrundlag)
| pbl15a_ægtefællehenføringsresultat(fakta: Pbl15AAfståelsesfakta) -> match fakta.grundlag {
    | Pbl15AÆgtefællefortjenesteEfterKildeskattelov25A(henføringsgrundlag) -> Some(kildeskat25a_fortjenestehenføringsresultat(fakta.afståelsesdato.år, pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).netto_skattepligtig_fortjeneste_før_am_kroner, henføringsgrundlag))
    | _ -> None
}
| pbl15a_afståelsesgrundlag_gyldigt(fakta: Pbl15AAfståelsesfakta) -> match fakta.grundlag {
    | Pbl15AEgenVirksomhedsfortjeneste -> Sandt
    | Pbl15AHovedaktionæraktier -> pbl15a_fortjenestegrundlag_er_udelukkende_aktieavance(fakta.fortjenestegrundlag) && pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).aktieavanceresultat.indeholder_afståelse && pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).aktieavanceresultat.alle_afståelser_er_hovedaktionæraktier
    | Pbl15AÆgtefællefortjenesteEfterKildeskattelov25A(henføringsgrundlag) -> kildeskat25a_fortjenestehenføringsresultat(fakta.afståelsesdato.år, pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).netto_skattepligtig_fortjeneste_før_am_kroner, henføringsgrundlag).grundlag_gyldigt && kildeskat25a_fortjenestehenføringsresultat(fakta.afståelsesdato.år, pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).netto_skattepligtig_fortjeneste_før_am_kroner, henføringsgrundlag).hjemmel_opfyldt
}
| pbl15a_skattepligtig_fortjeneste_før_am_kroner(fakta: Pbl15AAfståelsesfakta) -> match fakta.grundlag {
    | Pbl15AÆgtefællefortjenesteEfterKildeskattelov25A(henføringsgrundlag) -> kildeskat25a_fortjenestehenføringsresultat(fakta.afståelsesdato.år, pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).netto_skattepligtig_fortjeneste_før_am_kroner, henføringsgrundlag).fortjeneste_medregnet_hos_person_før_am_kroner
    | _ -> pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).netto_skattepligtig_fortjeneste_før_am_kroner
}
| pbl15a_afståelsesfakta_gyldige(fakta: Pbl15AAfståelsesfakta) -> fakta.identifikation != "" && pbl15a_dato_gyldig(fakta.afståelsesdato) && pbl15a_afståelses_fortjenestegrundlagsresultat(fakta).alle_kilder_gyldige && pbl15a_skattepligtig_fortjeneste_før_am_kroner(fakta) > 0 && pbl15a_afståelsesgrundlag_gyldigt(fakta) && fakta.alder_hele_år_ved_afståelsen >= 0 && fakta.antal_ejere > 0 && pbl15a_passiv_kapital_fakta_gyldige(fakta.afståelsesdato, fakta.passiv_kapital)
| pbl15a_driftsbegrænsning_opfyldt(fakta: Pbl15AAfståelsesfakta) -> (fakta.udlejning_af_afskrivningsberettigede_driftsmidler_eller_skibe == Falskt && fakta.antal_ejere <= 10) || fakta.opretter_deltog_i_driften_i_væsentligt_omfang

# Pbl15AAfståelsesSag(fakta: Pbl15AAfståelsesfakta) {
    | fortjenestegrundlagsresultat() -> pbl15a_afståelses_fortjenestegrundlagsresultat(fakta)
    | ægtefællehenføringsresultat() -> pbl15a_ægtefællehenføringsresultat(fakta)
    | skattepligtig_fortjeneste_før_am_kroner() -> pbl15a_skattepligtig_fortjeneste_før_am_kroner(fakta)
    | fakta_gyldige() -> pbl15a_afståelsesfakta_gyldige(fakta)
    | fyldt_55_år_før_afståelsen() -> fakta.alder_hele_år_ved_afståelsen >= 55
    | passiv_kapital_resultat() -> pbl15a_passiv_kapital_resultat(fakta.afståelsesdato, fakta.passiv_kapital)
    | driftsbegrænsning_opfyldt() -> pbl15a_driftsbegrænsning_opfyldt(fakta)
    | kvalificerer_til_ophørspension() -> fakta_gyldige() && fyldt_55_år_før_afståelsen() && passiv_kapital_resultat().overvejende_passiv_kapitalanbringelse == Falskt && driftsbegrænsning_opfyldt()
    | højeste_indbetaling_fra_afståelsen_kroner() -> hvis kvalificerer_til_ophørspension() { skattepligtig_fortjeneste_før_am_kroner() } ellers { 0 }
    | resultat() -> Pbl15AAfståelsesresultat(
        fakta = fakta,
        fortjenestegrundlagsresultat = fortjenestegrundlagsresultat(),
        ægtefællehenføringsresultat = ægtefællehenføringsresultat(),
        skattepligtig_fortjeneste_før_am_kroner = skattepligtig_fortjeneste_før_am_kroner(),
        fakta_gyldige = fakta_gyldige(),
        fyldt_55_år_før_afståelsen = fyldt_55_år_før_afståelsen(),
        passiv_kapital_resultat = passiv_kapital_resultat(),
        driftsbegrænsning_opfyldt = driftsbegrænsning_opfyldt(),
        kvalificerer_til_ophørspension = kvalificerer_til_ophørspension(),
        højeste_indbetaling_fra_afståelsen_kroner = højeste_indbetaling_fra_afståelsen_kroner()
    )
}
| pbl15a_afståelsesresultat(fakta: Pbl15AAfståelsesfakta) -> Pbl15AAfståelsesSag(fakta).resultat()

| pbl15a_kvalifikationsår_gyldigt(år: Pbl15AKvalifikationsår) -> år.indkomstår > 0
| pbl15a_kvalifikationsår_entydigt(kvalifikationsår: List(Pbl15AKvalifikationsår), år: Pbl15AKvalifikationsår) -> length(filter(kvalifikationsår, |andet: Pbl15AKvalifikationsår| andet.indkomstår == år.indkomstår)) == 1
| pbl15a_kvalifikationsår_i_seneste_15_år(oprettelsesår: Heltal, kvalifikationsår: List(Pbl15AKvalifikationsår)) -> length(filter(kvalifikationsår, |år: Pbl15AKvalifikationsår| år.indkomstår >= oprettelsesår - 15 && år.indkomstår < oprettelsesår))
| pbl15a_ordningsart_tilladt(art: Pbl15AOrdningsart) -> art == Pbl15ALøbendeUdbetalinger || art == Pbl15ARateforsikring || art == Pbl15ARateopsparing
| pbl15a_ordningsfakta_gyldige(fakta: Pbl15AOrdningsfakta) -> fakta.identifikation != "" && fakta.oprettelsesår > 0 && fakta.oprettelsesafståelse_identifikation != ""
| pbl15a_ordnings_oprettelsesafståelse_findes(fakta: Pbl15AOrdningsfakta, afståelser: List(Pbl15AAfståelsesresultat)) -> any(afståelser, |afståelse: Pbl15AAfståelsesresultat| afståelse.fakta.identifikation == fakta.oprettelsesafståelse_identifikation)
| pbl15a_ordnings_oprettelsesafståelse_kvalificerer(fakta: Pbl15AOrdningsfakta, afståelser: List(Pbl15AAfståelsesresultat)) -> any(afståelser, |afståelse: Pbl15AAfståelsesresultat| afståelse.fakta.identifikation == fakta.oprettelsesafståelse_identifikation && afståelse.kvalificerer_til_ophørspension)
| pbl15a_ordning_rettidigt_oprettet_efter_afståelsen(fakta: Pbl15AOrdningsfakta, afståelser: List(Pbl15AAfståelsesresultat)) -> any(afståelser, |afståelse: Pbl15AAfståelsesresultat| afståelse.fakta.identifikation == fakta.oprettelsesafståelse_identifikation && fakta.oprettelsesår >= afståelse.fakta.afståelsesdato.år && fakta.oprettelsesår <= afståelse.fakta.afståelsesdato.år + 1)
| pbl15a_ordningsresultat(fakta: Pbl15AOrdningsfakta, kvalifikationsår: List(Pbl15AKvalifikationsår), afståelser: List(Pbl15AAfståelsesresultat)) -> Pbl15AOrdningsresultat(
    fakta = fakta,
    fakta_gyldige = pbl15a_ordningsfakta_gyldige(fakta),
    tilladt_ordningsart = pbl15a_ordningsart_tilladt(fakta.art),
    oprettelsesafståelse_findes = pbl15a_ordnings_oprettelsesafståelse_findes(fakta, afståelser),
    oprettelsesafståelse_kvalificerer = pbl15a_ordnings_oprettelsesafståelse_kvalificerer(fakta, afståelser),
    rettidigt_oprettet_efter_afståelsen = pbl15a_ordning_rettidigt_oprettet_efter_afståelsen(fakta, afståelser),
    kvalifikationsår_i_seneste_15_år = pbl15a_kvalifikationsår_i_seneste_15_år(fakta.oprettelsesår, kvalifikationsår),
    mindst_10_kvalifikationsår = pbl15a_kvalifikationsår_i_seneste_15_år(fakta.oprettelsesår, kvalifikationsår) >= 10,
    kvalificerer_som_ophørspension = pbl15a_ordningsfakta_gyldige(fakta) && pbl15a_ordningsart_tilladt(fakta.art) && pbl15a_ordnings_oprettelsesafståelse_kvalificerer(fakta, afståelser) && pbl15a_ordning_rettidigt_oprettet_efter_afståelsen(fakta, afståelser) && pbl15a_kvalifikationsår_i_seneste_15_år(fakta.oprettelsesår, kvalifikationsår) >= 10
)

| pbl15a_afståelsesidentifikation_unik(afståelser: List(Pbl15AAfståelsesfakta), afståelse: Pbl15AAfståelsesfakta) -> length(filter(afståelser, |anden: Pbl15AAfståelsesfakta| anden.identifikation == afståelse.identifikation)) == 1
| pbl15a_ordningsidentifikation_unik(ordninger: List(Pbl15AOrdningsfakta), ordning: Pbl15AOrdningsfakta) -> length(filter(ordninger, |anden: Pbl15AOrdningsfakta| anden.identifikation == ordning.identifikation)) == 1
| pbl15a_historikidentifikation_unik(indbetalinger: List(Pbl15ATidligereIndbetaling), indbetaling: Pbl15ATidligereIndbetaling) -> length(filter(indbetalinger, |anden: Pbl15ATidligereIndbetaling| anden.identifikation == indbetaling.identifikation)) == 1
| pbl15a_årsgrundlag_identifikationer_entydige(grundlag: Pbl15AÅrsgrundlag) -> all(grundlag.afståelser, |afståelse: Pbl15AAfståelsesfakta| pbl15a_afståelsesidentifikation_unik(grundlag.afståelser, afståelse)) && all(grundlag.ordninger, |ordning: Pbl15AOrdningsfakta| pbl15a_ordningsidentifikation_unik(grundlag.ordninger, ordning)) && all(grundlag.tidligere_indbetalinger, |indbetaling: Pbl15ATidligereIndbetaling| pbl15a_historikidentifikation_unik(grundlag.tidligere_indbetalinger, indbetaling))
| pbl15a_årsgrundlag_kvalifikationsår_entydige(grundlag: Pbl15AÅrsgrundlag) -> all(grundlag.kvalifikationsår, |år: Pbl15AKvalifikationsår| pbl15a_kvalifikationsår_gyldigt(år) && pbl15a_kvalifikationsår_entydigt(grundlag.kvalifikationsår, år))
| pbl15a_årsgrundlagsresultat(grundlag: Pbl15AÅrsgrundlag) -> {
    = afståelsesresultater = map(grundlag.afståelser, pbl15a_afståelsesresultat)
    Pbl15AÅrsgrundlagsresultat(
        grundlag = grundlag,
        afståelsesresultater = afståelsesresultater,
        ordningsresultater = map(grundlag.ordninger, |ordning: Pbl15AOrdningsfakta| pbl15a_ordningsresultat(ordning, grundlag.kvalifikationsår, afståelsesresultater)),
        identifikationer_entydige = pbl15a_årsgrundlag_identifikationer_entydige(grundlag),
        kvalifikationsår_entydige = pbl15a_årsgrundlag_kvalifikationsår_entydige(grundlag),
        grundfakta_gyldige = pbl15a_årsgrundlag_identifikationer_entydige(grundlag) && pbl15a_årsgrundlag_kvalifikationsår_entydige(grundlag) && all(grundlag.afståelser, pbl15a_afståelsesfakta_gyldige) && all(grundlag.ordninger, pbl15a_ordningsfakta_gyldige)
    )
}

| pbl15a_afståelse_findes(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> length(filter(resultat.afståelsesresultater, |afståelse: Pbl15AAfståelsesresultat| afståelse.fakta.identifikation == identifikation)) == 1
| pbl15a_afståelse_kvalificerer(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> any(resultat.afståelsesresultater, |afståelse: Pbl15AAfståelsesresultat| afståelse.fakta.identifikation == identifikation && afståelse.kvalificerer_til_ophørspension)
| pbl15a_afståelsesår(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> foldl(resultat.afståelsesresultater, 0, |år: Heltal, afståelse: Pbl15AAfståelsesresultat| hvis afståelse.fakta.identifikation == identifikation { afståelse.fakta.afståelsesdato.år } ellers { år })
| pbl15a_afståelsesfortjeneste_kroner(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> foldl(resultat.afståelsesresultater, 0, |beløb: Heltal, afståelse: Pbl15AAfståelsesresultat| hvis afståelse.fakta.identifikation == identifikation { afståelse.højeste_indbetaling_fra_afståelsen_kroner } ellers { beløb })
| pbl15a_ordning_findes(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> length(filter(resultat.ordningsresultater, |ordning: Pbl15AOrdningsresultat| ordning.fakta.identifikation == identifikation)) == 1
| pbl15a_ordning_kvalificerer(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> any(resultat.ordningsresultater, |ordning: Pbl15AOrdningsresultat| ordning.fakta.identifikation == identifikation && ordning.kvalificerer_som_ophørspension)
| pbl15a_ordningsår(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> foldl(resultat.ordningsresultater, 0, |år: Heltal, ordning: Pbl15AOrdningsresultat| hvis ordning.fakta.identifikation == identifikation { ordning.fakta.oprettelsesår } ellers { år })
| pbl15a_ordningsart(resultat: Pbl15AÅrsgrundlagsresultat, identifikation: Tekst) -> foldl(resultat.ordningsresultater, Pbl15ALøbendeUdbetalinger, |art: Pbl15AOrdningsart, ordning: Pbl15AOrdningsresultat| hvis ordning.fakta.identifikation == identifikation { ordning.fakta.art } ellers { art })
| pbl15a_tiårsperiode_omfatter_indbetalingsår(afståelsesår: Heltal, indbetalingsår: Heltal) -> indbetalingsår >= afståelsesår && indbetalingsår <= afståelsesår + 9
| pbl15a_indbetalingsforbindelse_gyldig(resultat: Pbl15AÅrsgrundlagsresultat, ordning_identifikation: Tekst, afståelse_identifikation: Tekst, indbetalingsår: Heltal, ordningsart: Pbl15AOrdningsart) -> resultat.grundfakta_gyldige && pbl15a_ordning_findes(resultat, ordning_identifikation) && pbl15a_afståelse_findes(resultat, afståelse_identifikation) && pbl15a_ordning_kvalificerer(resultat, ordning_identifikation) && pbl15a_afståelse_kvalificerer(resultat, afståelse_identifikation) && pbl15a_ordningsart(resultat, ordning_identifikation) == ordningsart && pbl15a_ordningsår(resultat, ordning_identifikation) <= pbl15a_afståelsesår(resultat, afståelse_identifikation) + 1 && pbl15a_ordningsår(resultat, ordning_identifikation) <= indbetalingsår && pbl15a_tiårsperiode_omfatter_indbetalingsår(pbl15a_afståelsesår(resultat, afståelse_identifikation), indbetalingsår)

| pbl15a_tidligere_indbetaling_gyldig(resultat: Pbl15AÅrsgrundlagsresultat, indkomstår: Heltal, indbetaling: Pbl15ATidligereIndbetaling) -> indbetaling.identifikation != "" && indbetaling.indbetalingsår > 0 && indbetaling.indbetalingsår < indkomstår && indbetaling.beløb_kroner > 0 && pbl15a_indbetalingsforbindelse_gyldig(resultat, indbetaling.ordning_identifikation, indbetaling.afståelse_identifikation, indbetaling.indbetalingsår, pbl15a_ordningsart(resultat, indbetaling.ordning_identifikation))
| pbl15a_tidligere_indbetalinger_kroner(grundlag: Pbl15AÅrsgrundlag) -> foldl(grundlag.tidligere_indbetalinger, 0, |sum: Heltal, indbetaling: Pbl15ATidligereIndbetaling| sum + indbetaling.beløb_kroner)
| pbl15a_tidligere_indbetalinger_for_afståelse_kroner(grundlag: Pbl15AÅrsgrundlag, afståelse_identifikation: Tekst) -> foldl(grundlag.tidligere_indbetalinger, 0, |sum: Heltal, indbetaling: Pbl15ATidligereIndbetaling| sum + hvis indbetaling.afståelse_identifikation == afståelse_identifikation { indbetaling.beløb_kroner } ellers { 0 })
| pbl15a_sidste_tidligere_indbetalingsår(grundlag: Pbl15AÅrsgrundlag) -> foldl(grundlag.tidligere_indbetalinger, 0, |seneste: Heltal, indbetaling: Pbl15ATidligereIndbetaling| penge_største_beløb(seneste, indbetaling.indbetalingsår))
| pbl15a_tidligere_indbetalinger_til_og_med_år_kroner(grundlag: Pbl15AÅrsgrundlag, indkomstår: Heltal) -> foldl(grundlag.tidligere_indbetalinger, 0, |sum: Heltal, indbetaling: Pbl15ATidligereIndbetaling| sum + hvis indbetaling.indbetalingsår <= indkomstår { indbetaling.beløb_kroner } ellers { 0 })
| pbl15a_tidligere_maksimum_nået_i_år(grundlag: Pbl15AÅrsgrundlag, indkomstår: Heltal) -> indkomstår > 0 && pbl15a_tidligere_indbetalinger_til_og_med_år_kroner(grundlag, indkomstår) >= pbl15a_reguleret_samlet_maksimum_kroner(indkomstår)
| pbl15a_tidligere_maksimum_fuldt_udnyttet(grundlag: Pbl15AÅrsgrundlag) -> any(grundlag.tidligere_indbetalinger, |indbetaling: Pbl15ATidligereIndbetaling| pbl15a_tidligere_maksimum_nået_i_år(grundlag, indbetaling.indbetalingsår))
| pbl15a_historik_inden_for_afståelseslofter(resultat: Pbl15AÅrsgrundlagsresultat) -> all(resultat.afståelsesresultater, |afståelse: Pbl15AAfståelsesresultat| pbl15a_tidligere_indbetalinger_for_afståelse_kroner(resultat.grundlag, afståelse.fakta.identifikation) <= afståelse.højeste_indbetaling_fra_afståelsen_kroner)
| pbl15a_historik_inden_for_samlet_loft(resultat: Pbl15AÅrsgrundlagsresultat) -> all(resultat.grundlag.tidligere_indbetalinger, |indbetaling: Pbl15ATidligereIndbetaling| pbl15a_tidligere_indbetalinger_til_og_med_år_kroner(resultat.grundlag, indbetaling.indbetalingsår) <= pbl15a_reguleret_samlet_maksimum_kroner(indbetaling.indbetalingsår))
| pbl15a_historik_fortsætter_ikke_efter_fuldt_loft(resultat: Pbl15AÅrsgrundlagsresultat) -> all(resultat.grundlag.tidligere_indbetalinger, |indbetaling: Pbl15ATidligereIndbetaling| all(resultat.grundlag.tidligere_indbetalinger, |tidligere: Pbl15ATidligereIndbetaling| tidligere.indbetalingsår >= indbetaling.indbetalingsår || pbl15a_tidligere_maksimum_nået_i_år(resultat.grundlag, tidligere.indbetalingsår) == Falskt))
| pbl15a_årsgrundlag_gyldigt_for_indkomstår(resultat: Pbl15AÅrsgrundlagsresultat, indkomstår: Heltal) -> pbl15a_understøttet_indkomstår(indkomstår) && resultat.grundfakta_gyldige && all(resultat.grundlag.tidligere_indbetalinger, |indbetaling: Pbl15ATidligereIndbetaling| pbl15a_tidligere_indbetaling_gyldig(resultat, indkomstår, indbetaling)) && pbl15a_historik_inden_for_afståelseslofter(resultat) && pbl15a_historik_inden_for_samlet_loft(resultat) && pbl15a_historik_fortsætter_ikke_efter_fuldt_loft(resultat)
--@end:pensionsbeskatningsloven_par15a--
