@ sprog da

@ importer ./personskat.calculate

----
Kanoniske integrationsscenarier for rejser efter ligningslovens § 9 A.

Scenarierne er ikke lovtekst. De fastholder, at en almindelig rejse fordeles
mellem skattefri godtgørelse og ligningsmæssigt fradrag, at logi ved et fast
arbejdssted for en skatteyder bosat på en ikkebrofast ø indgår i samme § 9 A-
fradrag, og at udelukkelsen i sømandsbeskatningslovens § 4, stk. 2, følger
retten til sømandsfradrag frem for personens valg om faktisk at anvende
fradraget.
----

| personskat_rejsefradrag_rejse() -> Ligningslov9ARejsefakta(
    identifikation = "kanonisk-rejse-2026",
    indkomstår = 2026,
    startdato = Dato(år = 2026, måned = 3, dag = 1),
    rejseart = Ll9ATjenesterejse,
    arbejdssted_identifikation = "projektsted-a",
    arbejdsstedskarakter = Ll9AStedbundetArbejdssted(
        tidsbegrænsning = Ll9ATidsbegrænsetTilKonkretOpgavesFærdiggørelse
    ),
    overnatningsforhold = Ll9AIngenMulighedForOvernatningPåSædvanligBopæl(
        afstand_ad_normal_transportvej_kilometer = 350,
        korteste_transporttid_hver_vej_minutter = 240
    ),
    hverv = Ll9AAlmindeligtHverv,
    varighed_minutter = 2880,
    kost = Ligningslov9AKostfakta(
        dækning = Ll9AKostIkkeDækketEfterRegning,
        godtgørelsesudbetaling = Ll9AUopdeltGodtgørelse(udbetalt_kroner = 500),
        fri_morgenmad_antal = 0,
        fri_frokost_antal = 0,
        fri_aftensmad_antal = 0,
        dokumenterede_kostudgifter_før_arbejdsgiverdækning_kroner = 1600,
        fradragsprincip = Ll9AKostfradragMedStandardsats
    ),
    logidøgn = [
        Ligningslov9ALogidøgn(
            rejsedøgnsnummer = 1,
            dækning = Ll9ALogiIkkeDækketAfArbejdsgiver,
            godtgørelsesudbetaling = Ll9AUopdeltGodtgørelse(udbetalt_kroner = 150),
            dokumenteret_logiudgift_betalt_før_refusion_kroner = 450,
            fradragsprincip = Ll9ALogifradragMedStandardsats
        ),
        Ligningslov9ALogidøgn(
            rejsedøgnsnummer = 2,
            dækning = Ll9ALogiIkkeDækketAfArbejdsgiver,
            godtgørelsesudbetaling = Ll9AUopdeltGodtgørelse(udbetalt_kroner = 150),
            dokumenteret_logiudgift_betalt_før_refusion_kroner = 450,
            fradragsprincip = Ll9ALogifradragMedStandardsats
        )
    ],
    kontrol = Ll9AArbejdsgiverkontrolUdført,
    lønomlægning = Ll9AGodtgørelseUdenLønomlægning,
    indkomstforhold = Ll9ADanskSkattepligtigArbejdsindkomst
)

| personskat_rejsefradrag_årsinput_med_rejser_og_ølogi(rejser: List(Ligningslov9ARejsefakta), ølogi: Ligningslov9AØlogiInput) -> Ligningslov9AÅrsinput(
    personrolle = Ll9AAlmindeligLønmodtager,
    rejser = rejser,
    udenlandske_indkomstkilder = [],
    arbejdshistorik = Ligningslov9AArbejdshistorik(
        tidligere_rejser = [],
        arbejdsdage = [],
        arbejdsstedsafstande = []
    ),
    ølogi = ølogi,
    dobbelt_husførelse = Ll9AIntetFradragForDobbeltHusførelse
)
| personskat_rejsefradrag_årsinput() -> personskat_rejsefradrag_årsinput_med_rejser_og_ølogi(
    rejser = [personskat_rejsefradrag_rejse()],
    ølogi = UdenØlogifradrag
)
| personskat_ølogifradrag_årsinput() -> personskat_rejsefradrag_årsinput_med_rejser_og_ølogi(
    rejser = [],
    ølogi = MedØlogifradrag(
        bopæl = Ligningslov9AØbopæl(
            kommune = Samsø,
            ø = Ll9AAndenDanskØ(navn = "Samsø"),
            vejforbindelse = Ll9AIngenFastVejforbindelseFraØen
        ),
        arbejdsforhold = [Ligningslov9AØlogiArbejdsforhold(
            arbejdssted_identifikation = "fast-arbejdssted-fra-samsø",
            arbejdsstedskarakter = Ll9AØlogiFastArbejdssted,
            overnatningsforhold = Ll9AØlogiIngenMulighedForOvernatningPåSædvanligBopæl(
                afstand_ad_normal_transportvej_kilometer = 95,
                korteste_transporttid_hver_vej_minutter = 180
            ),
            hverv = Ll9AAlmindeligtHverv,
            ophold = [Ligningslov9AØlogiophold(
                identifikation = "samsø-fire-døgn",
                startdato = Dato(år = 2026, måned = 6, dag = 1),
                varighed_minutter = 5760,
                udgiftsforhold = Ll9AØlogiEgenUdgiftAfholdt
            )]
        )]
    )
)

| personskat_rejsefradrag_berettiget_sømandsinput() -> Sømandsbeskatningslov3Årsinput(
    valg = FravælgSømandsfradrag,
    beskæftigelser = [Sømandsbeskatningslov3Beskæftigelsesfakta(
        identifikation = "søarbejde-2026",
        indkomstår = 2026,
        arbejdssted = ArbejdePåSkib(
            bruttotonnage = 1000,
            anvendelse = ErhvervsmæssigBefordringAfGods
        ),
        fart = UdenForBegrænsetFart,
        hjemsted = RegistreretMedHjemstedIDanmark,
        flag = FlagFraEUEØSStat,
        forhyringsvilkår = SædvanligeForhyringsvilkårForSøfolk,
        fuldtidsomregnede_sødage_hundrededele = 100
    )]
)

| personskat_rejsefradrag_nul_befordringsfradrag() -> MedBefordringsfradrag(fakta = PersonskatBefordringsfradragFakta(
    arbejdsdage = 0,
    daglige_befordringskilometer = 0,
    bopæl_i_yderkommune_eller_lille_ø = Falskt,
    befordringsformål = IndtægtsgivendeArbejdsplads,
    modtaget_skattefri_befordringsgodtgørelse_for_strækning = Falskt,
    modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = Falskt,
    ligningslov9d = UdenLigningslov9D,
    fradrag_udelukket_folketingshverv_m_v = Falskt,
    arbejdsgiverbetalt_befordring = UdenArbejdsgiverbetaltBefordring,
    broer = ll9c_ingen_bropassager(),
    særlig_transport = ll9c_ingen_særlig_transport()
))

| personskat_rejsefradrag_ll9c_aftrapningsindkomst_kroner(resultat: PersonskatBefordringsfradragResultat) -> match resultat {
    | BeregnetBefordringsfradrag(_, _, ligningslov9c_input, _, _, _, _) -> ligningslov9c_input.aftrapningsindkomst_kroner
    | _ -> 0
}

| personskat_rejsefradrag_ligningsfradrag_med_ll9a(sømandsfradrag: Sømandsbeskatningslov3Årsinput, rejser: Ligningslov9AÅrsinput) -> PersonskatLigningsfradragInput(
    sømandsfradrag = sømandsfradrag,
    sømandsbeskatningslov4 = sømandsbeskatningslov4_intet_årsinput(),
    øvrige_lønmodtagerudgifter = ligningslov9_stk1_intet_årsinput(),
    befordring = personskat_rejsefradrag_nul_befordringsfradrag(),
    rejser = rejser,
    faglige_kontingenter = Ligningslov13Årsinput(
        skatteyderstatus = Ll13Lønmodtager,
        kontingenter = []
    ),
    arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(
        skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark,
        bidrag = []
    ),
    gaver = LigningslovGaveÅrsinput(gaver = [])
)
| personskat_rejsefradrag_ligningsfradrag(sømandsfradrag: Sømandsbeskatningslov3Årsinput) -> personskat_rejsefradrag_ligningsfradrag_med_ll9a(
    sømandsfradrag = sømandsfradrag,
    rejser = personskat_rejsefradrag_årsinput()
)

| personskat_rejsefradrag_input_med_ll9a(sømandsfradrag: Sømandsbeskatningslov3Årsinput, rejser: Ligningslov9AÅrsinput) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 600000,
        personlig_indkomst = personskat_ingen_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_rejsefradrag_ligningsfradrag_med_ll9a(
            sømandsfradrag = sømandsfradrag,
            rejser = rejser
        ),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_rejsefradrag_input(sømandsfradrag: Sømandsbeskatningslov3Årsinput) -> personskat_rejsefradrag_input_med_ll9a(
    sømandsfradrag = sømandsfradrag,
    rejser = personskat_rejsefradrag_årsinput()
)

= personskat_rejsefradrag_almindeligt_resultat = beregn_personskat(personskat_rejsefradrag_input(sømandsbeskatningslov3_intet_årsinput()))
= personskat_rejsefradrag_sømandsberettiget_resultat = beregn_personskat(personskat_rejsefradrag_input(personskat_rejsefradrag_berettiget_sømandsinput()))
= personskat_ølogifradrag_almindeligt_resultat = beregn_personskat(personskat_rejsefradrag_input_med_ll9a(
    sømandsfradrag = sømandsbeskatningslov3_intet_årsinput(),
    rejser = personskat_ølogifradrag_årsinput()
))
= personskat_ølogifradrag_sømandsberettiget_resultat = beregn_personskat(personskat_rejsefradrag_input_med_ll9a(
    sømandsfradrag = personskat_rejsefradrag_berettiget_sømandsinput(),
    rejser = personskat_ølogifradrag_årsinput()
))

| personskat_rejsefradrag_almindelig_rejse_fordeles_kanonisk: personskat_rejsefradrag_almindeligt_resultat -> personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.alle_input_gyldige && personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.rejser.ekstern_udelukkelse == Ll9AIngenEksternUdelukkelse && personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.rejsegodtgørelse_skattefri_efter_sømandsbeskatningslov4_stk2_kroner == 800 && personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner == 0 && personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner == 986 && personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.samlet_ligningsfradrag_kroner == 986 && personskat_rejsefradrag_ll9c_aftrapningsindkomst_kroner(personskat_rejsefradrag_almindeligt_resultat.ligningsfradrag.befordring) == 600000 && personskat_rejsefradrag_almindeligt_resultat.skat.bruttoløn_kroner == 600000 && personskat_rejsefradrag_almindeligt_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000

| personskat_rejsefradrag_sømandsudelukkelse_følger_ret_frem_for_valg: personskat_rejsefradrag_sømandsberettiget_resultat -> personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.alle_input_gyldige && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.sømandsfradrag.kan_foretage_fradrag_efter_par3 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.sømandsfradrag.fradrag_foretaget_efter_par3 == Falskt && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.rejser.ekstern_udelukkelse == Ll9AUdelukketEfterSømandsbeskatningslov4Stk2 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.rejsegodtgørelse_skattefri_før_sømandsbeskatningslov4_stk2_kroner == 800 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.rejsegodtgørelse_skattefri_efter_sømandsbeskatningslov4_stk2_kroner == 0 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner == 800 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner == 986 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner == 0 && personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.samlet_afskåret_efter_sømandsbeskatningslov4_kroner == 986 && personskat_rejsefradrag_ll9c_aftrapningsindkomst_kroner(personskat_rejsefradrag_sømandsberettiget_resultat.ligningsfradrag.befordring) == 600800 && personskat_rejsefradrag_sømandsberettiget_resultat.skat.bruttoløn_kroner == 600800 && personskat_rejsefradrag_sømandsberettiget_resultat.skat.arbejdsmarkedsbidrag_kroner == 48064

| personskat_ølogifradrag_indgår_i_kanonisk_ligningsfradrag: personskat_ølogifradrag_almindeligt_resultat -> personskat_ølogifradrag_almindeligt_resultat.ligningsfradrag.alle_input_gyldige && personskat_ølogifradrag_almindeligt_resultat.ligningsfradrag.rejser.ølogi.fradrag_før_fælles_årsloft_kroner == 1072 && personskat_ølogifradrag_almindeligt_resultat.ligningsfradrag.rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner == 1072 && personskat_ølogifradrag_almindeligt_resultat.ligningsfradrag.samlet_ligningsfradrag_kroner == 1072

| personskat_ølogifradrag_følger_sømandsudelukkelsen: personskat_ølogifradrag_sømandsberettiget_resultat -> personskat_ølogifradrag_sømandsberettiget_resultat.ligningsfradrag.alle_input_gyldige && personskat_ølogifradrag_sømandsberettiget_resultat.ligningsfradrag.rejser_før_sømandsbeskatningslov4_stk2.ølogi.fradrag_efter_fælles_årsloft_kroner == 1072 && personskat_ølogifradrag_sømandsberettiget_resultat.ligningsfradrag.rejser.ølogi.stk11_udelukket && personskat_ølogifradrag_sømandsberettiget_resultat.ligningsfradrag.rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner == 1072 && personskat_ølogifradrag_sømandsberettiget_resultat.ligningsfradrag.rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner == 0 && personskat_ølogifradrag_sømandsberettiget_resultat.ligningsfradrag.samlet_afskåret_efter_sømandsbeskatningslov4_kroner == 1072

? personskat_rejsefradrag_almindelig_rejse_fordeles_kanonisk
? personskat_rejsefradrag_sømandsudelukkelse_følger_ret_frem_for_valg
? personskat_ølogifradrag_indgår_i_kanonisk_ligningsfradrag
? personskat_ølogifradrag_følger_sømandsudelukkelsen
