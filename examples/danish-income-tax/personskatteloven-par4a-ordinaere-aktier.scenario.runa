@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Fokus-scenarier for ordinære personaktier efter
-- Aktieavancebeskatningslovens §§ 12-15 og §§ 23-26.

= abl_ordinaer_ingen_boligret = AktieavanceOrdinærBoligretInput(
    forbundet_med_brugsret_til_beboelseslejlighed = Falskt,
    beboelseskrav_opfyldt = Falskt,
    likvidationsprovenu = Falskt,
    udloddet_i_endeligt_opløsningsår = Falskt
)
= abl_ordinaer_boligret_opfyldt = AktieavanceOrdinærBoligretInput(
    forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
    beboelseskrav_opfyldt = Sandt,
    likvidationsprovenu = Falskt,
    udloddet_i_endeligt_opløsningsår = Falskt
)
= abl_ordinaer_noteret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblOptagetTilHandelPåReguleretMarked,
    har_tidligere_været_optaget_til_handel = Sandt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_unoteret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplysningsbetingelseIkkeOpfyldt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_tidligere_noteret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Sandt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblIndberettetAfAndenIndberetningspligtig,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_noteret_manglende_oplysning_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblOptagetTilHandelPåMultilateralHandelsfacilitet,
    har_tidligere_været_optaget_til_handel = Sandt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplysningsbetingelseIkkeOpfyldt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_hovedaktionær_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Sandt,
    afståede_aktiers_handelsværdi_kroner = 80000,
    beholdte_aktiers_handelsværdi_kroner = 20000,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_hovedaktionær_nulværdi_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Sandt,
    afståede_aktiers_handelsværdi_kroner = 100000,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_boligret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_boligret_opfyldt
)

= abl_ordinaer_position_primo = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-ORDINAER-A",
    antal_aktier = 100,
    samlet_pålydende_kroner = 10000,
    anskaffelsessum_kroner = 100000
)
= abl_ordinaer_anskaffelse = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAnskaffelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000,
        anskaffelsessum_kroner = 140000
    )
)
= abl_ordinaer_første_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_anskaffelse.position_efter,
    AblOrdinærAfståelse(
        antal_aktier = 50,
        samlet_pålydende_kroner = 5000,
        afståelsessum_kroner = 90000,
        vilkår = abl_ordinaer_noteret_vilkår
    )
)
= abl_ordinaer_andet_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_første_delsalg.position_efter,
    AblOrdinærAfståelse(
        antal_aktier = 50,
        samlet_pålydende_kroner = 5000,
        afståelsessum_kroner = 40000,
        vilkår = abl_ordinaer_noteret_vilkår
    )
)
= abl_ordinaer_gennemsnit_hændelsesforløb = aktieavance_ordinaer_hændelsesforløb(
    abl_ordinaer_position_primo,
    [
        abl_ordinaer_anskaffelse.hændelse,
        abl_ordinaer_første_delsalg.hændelse,
        abl_ordinaer_andet_delsalg.hændelse
    ]
)
= abl_ordinaer_gennemsnit_årsresultat = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    hændelsesresultater = abl_ordinaer_gennemsnit_hændelsesforløb.hændelsesresultater,
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
    ),
    gift_og_samlevende_ved_årets_udgang = Falskt
))
= abl_ordinaer_gennemsnit_par4a = par4a_aktieavancebeskatningslov_resultat(Par4aAktieavancebeskatningslovInput(
    aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat_fra_ordinaere_aktier(abl_ordinaer_gennemsnit_årsresultat)
))

= abl_ordinaer_hovedaktionær_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 50,
        samlet_pålydende_kroner = 5000,
        afståelsessum_kroner = 90000,
        vilkår = abl_ordinaer_hovedaktionær_vilkår
    )
)
= abl_ordinaer_hovedaktionær_nulværdi_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 50,
        samlet_pålydende_kroner = 5000,
        afståelsessum_kroner = 90000,
        vilkår = abl_ordinaer_hovedaktionær_nulværdi_vilkår
    )
)

= abl_ordinaer_unoteret_tab = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000,
        afståelsessum_kroner = 70000,
        vilkår = abl_ordinaer_unoteret_vilkår
    )
)
= abl_ordinaer_unoteret_tab_årsresultat = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    hændelsesresultater = [abl_ordinaer_unoteret_tab],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
    ),
    gift_og_samlevende_ved_årets_udgang = Falskt
))

= abl_ordinaer_tidligere_noteret_tab = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000,
        afståelsessum_kroner = 50000,
        vilkår = abl_ordinaer_tidligere_noteret_vilkår
    )
)
= abl_ordinaer_tidligere_noteret_gevinst_position = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-ORDINAER-B",
    antal_aktier = 100,
    samlet_pålydende_kroner = 10000,
    anskaffelsessum_kroner = 100000
)
= abl_ordinaer_tidligere_noteret_gevinst = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_tidligere_noteret_gevinst_position,
    AblOrdinærAfståelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000,
        afståelsessum_kroner = 130000,
        vilkår = abl_ordinaer_tidligere_noteret_vilkår
    )
)
= abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    hændelsesresultater = [abl_ordinaer_tidligere_noteret_tab, abl_ordinaer_tidligere_noteret_gevinst],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
    ),
    gift_og_samlevende_ved_årets_udgang = Falskt
))
= abl_ordinaer_par13a_ægtefælle_årsresultat = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    hændelsesresultater = [abl_ordinaer_tidligere_noteret_tab],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 30000,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 12000
    ),
    gift_og_samlevende_ved_årets_udgang = Sandt
))
= abl_ordinaer_par13a_ægtefælle_par4a_post = par4a_aktiepost_resultat(
    par4a_ægtefællepost_fra_abl_ordinaert_tab(abl_ordinaer_par13a_ægtefælle_årsresultat)
)

= abl_ordinaer_noteret_tab_uden_oplysning = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000,
        afståelsessum_kroner = 70000,
        vilkår = abl_ordinaer_noteret_manglende_oplysning_vilkår
    )
)
= abl_ordinaer_boligret_gevinst = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000,
        afståelsessum_kroner = 180000,
        vilkår = abl_ordinaer_boligret_vilkår
    )
)
= abl_ordinaer_ugyldigt_salg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 101,
        samlet_pålydende_kroner = 10100,
        afståelsessum_kroner = 120000,
        vilkår = abl_ordinaer_unoteret_vilkår
    )
)
= abl_ordinaer_usammenhængende_fuldt_salg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        antal_aktier = 100,
        samlet_pålydende_kroner = 5000,
        afståelsessum_kroner = 120000,
        vilkår = abl_ordinaer_unoteret_vilkår
    )
)

| scenarie_abl_ordinaer_anskaffelse_opdaterer_gennemsnitsbeholdning: abl_ordinaer_anskaffelse -> abl_ordinaer_anskaffelse.hændelse_gyldig && abl_ordinaer_anskaffelse.position_efter.antal_aktier == 200 && abl_ordinaer_anskaffelse.position_efter.samlet_pålydende_kroner == 20000 && abl_ordinaer_anskaffelse.position_efter.anskaffelsessum_kroner == 240000
| scenarie_abl_par26_første_delsalg_bruger_gennemsnitsmetoden: abl_ordinaer_første_delsalg -> abl_ordinaer_første_delsalg.anskaffelsessum_henført_til_afståelse_kroner == 60000 && abl_ordinaer_første_delsalg.bruttogevinst_kroner == 30000 && abl_ordinaer_første_delsalg.position_efter.antal_aktier == 150 && abl_ordinaer_første_delsalg.position_efter.anskaffelsessum_kroner == 180000
| scenarie_abl_par26_senere_delsalg_bevarer_resten: abl_ordinaer_andet_delsalg -> abl_ordinaer_andet_delsalg.anskaffelsessum_henført_til_afståelse_kroner == 60000 && abl_ordinaer_andet_delsalg.bruttotab_kroner == 20000 && abl_ordinaer_andet_delsalg.position_efter.antal_aktier == 100 && abl_ordinaer_andet_delsalg.position_efter.anskaffelsessum_kroner == 120000
| scenarie_abl_hændelsesforløb_tråder_positionen_automatisk: abl_ordinaer_gennemsnit_hændelsesforløb -> abl_ordinaer_gennemsnit_hændelsesforløb.alle_hændelser_gyldige && length(abl_ordinaer_gennemsnit_hændelsesforløb.hændelsesresultater) == 3 && abl_ordinaer_gennemsnit_hændelsesforløb.position_ultimo == abl_ordinaer_andet_delsalg.position_efter
| scenarie_abl_par12_par13a_nettogevinst: abl_ordinaer_gennemsnit_årsresultat -> abl_ordinaer_gennemsnit_årsresultat.skattepligtige_gevinster_efter_par12_kroner == 30000 && abl_ordinaer_gennemsnit_årsresultat.tab_modregnet_i_egne_udbytter_og_gevinster_kroner == 20000 && abl_ordinaer_gennemsnit_årsresultat.netto_aktieindkomst_fra_ordinære_aktier_kroner == 10000
| scenarie_abl_ordinaer_føder_personskattelov_par4a: abl_ordinaer_gennemsnit_par4a -> abl_ordinaer_gennemsnit_par4a.effektiv_aktiv == AblOrdinærAktiePar12Til15 && abl_ordinaer_gennemsnit_par4a.afgrænsning == AktiepostOmfattetAfStk1 && abl_ordinaer_gennemsnit_par4a.aktieindkomst_kroner == 10000 && abl_ordinaer_gennemsnit_par4a.personlig_indkomst_kroner == 0
| scenarie_abl_par26_hovedaktionær_fordeler_efter_handelsværdi: abl_ordinaer_hovedaktionær_delsalg -> abl_ordinaer_hovedaktionær_delsalg.anskaffelsessum_henført_til_afståelse_kroner == 80000 && abl_ordinaer_hovedaktionær_delsalg.bruttogevinst_kroner == 10000 && abl_ordinaer_hovedaktionær_delsalg.position_efter.anskaffelsessum_kroner == 20000
| scenarie_abl_par26_hovedaktionær_tillader_værdiløs_rest: abl_ordinaer_hovedaktionær_nulværdi_delsalg -> abl_ordinaer_hovedaktionær_nulværdi_delsalg.hændelse_gyldig && abl_ordinaer_hovedaktionær_nulværdi_delsalg.anskaffelsessum_henført_til_afståelse_kroner == 100000 && abl_ordinaer_hovedaktionær_nulværdi_delsalg.bruttotab_kroner == 10000 && abl_ordinaer_hovedaktionær_nulværdi_delsalg.position_efter.anskaffelsessum_kroner == 0
| scenarie_abl_par13_unoteret_tab_fradrages_direkte: abl_ordinaer_unoteret_tab_årsresultat -> abl_ordinaer_unoteret_tab_årsresultat.direkte_fradrag_efter_par13_kroner == 30000 && abl_ordinaer_unoteret_tab_årsresultat.netto_aktieindkomst_fra_ordinære_aktier_kroner == -30000 && abl_ordinaer_unoteret_tab_årsresultat.tab_fremført_til_følgende_indkomstår_kroner == 0
| scenarie_abl_par13_stk2_tidligere_noteret_følger_par13a: abl_ordinaer_tidligere_noteret_tab -> abl_ordinaer_tidligere_noteret_tab.tab_behandles_efter_par13a && abl_ordinaer_tidligere_noteret_tab.fradragsberettiget_tab_efter_par13_kroner == 0 && abl_ordinaer_tidligere_noteret_tab.tab_til_modregning_efter_par13a_kroner == 50000
| scenarie_abl_par13a_tidligere_noteret_gevinst_er_udenfor_modregningsgrundlaget: abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag -> abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag.skattepligtige_gevinster_efter_par12_kroner == 30000 && abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag.eget_modregningsgrundlag_efter_par13a_kroner == 0 && abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag.tab_modregnet_i_egne_udbytter_og_gevinster_kroner == 0 && abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag.tab_fremført_til_følgende_indkomstår_kroner == 50000
| scenarie_abl_par13a_ægtefælle_og_fremførsel: abl_ordinaer_par13a_ægtefælle_årsresultat -> abl_ordinaer_par13a_ægtefælle_årsresultat.årets_og_fremførte_tab_efter_par13a_kroner == 50000 && abl_ordinaer_par13a_ægtefælle_årsresultat.tab_modregnet_i_egne_udbytter_og_gevinster_kroner == 30000 && abl_ordinaer_par13a_ægtefælle_årsresultat.tab_overført_til_ægtefælle_kroner == 12000 && abl_ordinaer_par13a_ægtefælle_årsresultat.tab_fremført_til_følgende_indkomstår_kroner == 8000
| scenarie_abl_par13a_ægtefællepost_føder_personskattelov_par4a: abl_ordinaer_par13a_ægtefælle_par4a_post -> abl_ordinaer_par13a_ægtefælle_par4a_post.medregnes_i_aktieindkomst && abl_ordinaer_par13a_ægtefælle_par4a_post.aktieindkomst_kroner == -12000 && abl_ordinaer_par13a_ægtefælle_par4a_post.personlig_indkomst_kroner == 0
| scenarie_abl_par14_manglende_oplysning_afskærer_noteret_tab: abl_ordinaer_noteret_tab_uden_oplysning -> abl_ordinaer_noteret_tab_uden_oplysning.oplysningsbetingelse_efter_par14_opfyldt == Falskt && abl_ordinaer_noteret_tab_uden_oplysning.tab_til_modregning_efter_par13a_kroner == 0 && abl_ordinaer_noteret_tab_uden_oplysning.tab_afskåret_efter_par14_kroner == 30000
| scenarie_abl_par15_boligret_gevinst_er_skattefri: abl_ordinaer_boligret_gevinst -> abl_ordinaer_boligret_gevinst.bruttogevinst_kroner == 80000 && abl_ordinaer_boligret_gevinst.skattefri_efter_par15 && abl_ordinaer_boligret_gevinst.skattepligtig_gevinst_efter_par12_kroner == 0
| scenarie_abl_ugyldig_afståelse_bevarer_position: abl_ordinaer_ugyldigt_salg -> abl_ordinaer_ugyldigt_salg.hændelse_gyldig == Falskt && abl_ordinaer_ugyldigt_salg.bruttogevinst_kroner == 0 && abl_ordinaer_ugyldigt_salg.bruttotab_kroner == 0 && abl_ordinaer_ugyldigt_salg.position_efter == abl_ordinaer_position_primo
| scenarie_abl_usammenhængende_fuldt_salg_bevarer_position: abl_ordinaer_usammenhængende_fuldt_salg -> abl_ordinaer_usammenhængende_fuldt_salg.hændelse_gyldig == Falskt && abl_ordinaer_usammenhængende_fuldt_salg.anskaffelsessum_henført_til_afståelse_kroner == 0 && abl_ordinaer_usammenhængende_fuldt_salg.position_efter == abl_ordinaer_position_primo

? scenarie_abl_ordinaer_anskaffelse_opdaterer_gennemsnitsbeholdning
? scenarie_abl_par26_første_delsalg_bruger_gennemsnitsmetoden
? scenarie_abl_par26_senere_delsalg_bevarer_resten
? scenarie_abl_hændelsesforløb_tråder_positionen_automatisk
? scenarie_abl_par12_par13a_nettogevinst
? scenarie_abl_ordinaer_føder_personskattelov_par4a
