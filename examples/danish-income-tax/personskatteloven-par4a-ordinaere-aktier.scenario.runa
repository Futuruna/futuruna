@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Fokus-scenarier for ordinære personaktier efter
-- Aktieavancebeskatningslovens §§ 12-15 og §§ 23-26.

= abl_ordinaer_ingen_boligret = AblUdenBoligret
= abl_ordinaer_boligret_fakta_opfyldt = EblPar8Stk4VærdipapirFakta(
    værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
    udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Sandt,
    lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Sandt,
    grundforhold = EblPar8Stk4UdenBestemtGrundareal
)
= abl_ordinaer_boligret_fakta_uden_tidsmæssigt_sammenfald = EblPar8Stk4VærdipapirFakta(
    værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
    udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Sandt,
    lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Falskt,
    grundforhold = EblPar8Stk4UdenBestemtGrundareal
)
= abl_ordinaer_boligret_fakta_med_uopfyldt_grundkrav = EblPar8Stk4VærdipapirFakta(
    værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
    udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Sandt,
    lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Sandt,
    grundforhold = EblPar8Stk4MedBestemtGrundareal(
        grundbetingelse = EblPar8GrundbetingelseIkkeOpfyldt
    )
)
= abl_ordinaer_par15_kapitalselskabsudsteder = AblPar15Kapitalselskabsudsteder(
    sel_input = Selskabsskattelov1Stk1Nr1Input(
        selskabsform = Sel1Stk1Nr1IndregistreretAktieselskab,
        hjemmehørende_i_danmark = Sandt
    )
)
= abl_ordinaer_par15_foreningsudsteder = AblPar15Foreningsudsteder(
    sel_input = Selskabsskattelov1Stk1Nr6Input(
        enhed = Ssl1Stk1Nr6AndenForening,
        hjemmehørende_i_danmark = Sandt,
        omfattet_af_par3_undtagelse = Falskt,
        omfattet_af_fondsbeskatningsloven = Falskt
    )
)
= abl_ordinaer_par15_fondsbeskattet_foreningsudsteder = AblPar15Foreningsudsteder(
    sel_input = Selskabsskattelov1Stk1Nr6Input(
        enhed = Ssl1Stk1Nr6AndenForening,
        hjemmehørende_i_danmark = Sandt,
        omfattet_af_par3_undtagelse = Falskt,
        omfattet_af_fondsbeskatningsloven = Sandt
    )
)
= abl_ordinaer_par15_værdipapir_omfattet = AblPar15VærdipapirOmfattetAfAktieavancebeskatningsloven
= abl_ordinaer_par15_værdipapir_uden_for_abl = AblPar15VærdipapirUdenForAktieavancebeskatningsloven
= abl_ordinaer_boligret_opfyldt = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_kapitalselskabsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_opfyldt,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_boligret_uden_tidsmæssigt_sammenfald = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_kapitalselskabsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_uden_tidsmæssigt_sammenfald,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_boligret_med_uopfyldt_grundkrav = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_kapitalselskabsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_med_uopfyldt_grundkrav,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_boligret_likvidation_før_endelig_opløsning = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_kapitalselskabsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_opfyldt,
    afståelsesform = AblPar15Likvidationsprovenu(
        udloddet_i_endeligt_opløsningsår = Falskt
    )
)
= abl_ordinaer_boligret_forening_opfyldt = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_foreningsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_opfyldt,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_boligret_fondsbeskattet_forening = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_fondsbeskattet_foreningsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_opfyldt,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_boligret_transparent_udsteder = AblBoligretEfterPar15(
    udsteder = AblPar15TransparentEllerAndenUdsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_omfattet,
    fakta = abl_ordinaer_boligret_fakta_opfyldt,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_boligret_uden_for_abl = AblBoligretEfterPar15(
    udsteder = abl_ordinaer_par15_kapitalselskabsudsteder,
    værdipapirstatus = abl_ordinaer_par15_værdipapir_uden_for_abl,
    fakta = abl_ordinaer_boligret_fakta_opfyldt,
    afståelsesform = AblPar15AlmindeligAfståelse
)
= abl_ordinaer_noteret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblOptagetTilHandelPåReguleretMarked,
    har_tidligere_været_optaget_til_handel = Sandt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_unoteret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplysningsbetingelseIkkeOpfyldt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_tidligere_noteret_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Sandt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblIndberettetAfAndenIndberetningspligtig,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_noteret_manglende_oplysning_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblOptagetTilHandelPåMultilateralHandelsfacilitet,
    har_tidligere_været_optaget_til_handel = Sandt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplysningsbetingelseIkkeOpfyldt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_hovedaktionær_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Sandt,
    afståede_aktiers_handelsværdi_kroner = 80000,
    beholdte_aktiers_handelsværdi_kroner = 20000,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_hovedaktionær_nulværdi_vilkår = AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Sandt,
    afståede_aktiers_handelsværdi_kroner = 100000,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplystRettidigt,
    boligret = abl_ordinaer_ingen_boligret
)
= abl_ordinaer_par5a_uden_reduktionsgrundlag = AblOrdinærPar5AKildefakta(
    fakta = AktieavancePar5AFakta(
        anvendelsesgrundlag = AblPar5AAfståelseDen24November2010EllerSenere,
        skatteydergrundlag = AblPar5APersonSkattepligtigEfterPar7,
        ejertidsudbytter = [],
        præferenceposition = AktieavancePar5APræferenceposition(
            modtaget_tilsvarende_udbytte_kroner = 0,
            allerede_anvendt_til_tabsreduktion_kroner = 0
        ),
        koncernbeløb = []
    )
)
| abl_ordinaer_par5a_med_skattefrit_udbytte(beløb_kroner: Heltal) -> AblOrdinærPar5AKildefakta(
    fakta = AktieavancePar5AFakta(
        anvendelsesgrundlag = AblPar5AAfståelseDen24November2010EllerSenere,
        skatteydergrundlag = AblPar5APersonSkattepligtigEfterPar7,
        ejertidsudbytter = [AblPar5ASkattefritUdbytteAfPågældendeAktier(beløb_kroner = beløb_kroner)],
        præferenceposition = AktieavancePar5APræferenceposition(
            modtaget_tilsvarende_udbytte_kroner = 0,
            allerede_anvendt_til_tabsreduktion_kroner = 0
        ),
        koncernbeløb = []
    )
)
| abl_ordinaer_boligret_vilkår_for(boligret: AktieavanceOrdinærBoligretInput) -> AktieavanceOrdinærAfståelsesvilkår(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    hovedaktionæraktier = Falskt,
    afståede_aktiers_handelsværdi_kroner = 0,
    beholdte_aktiers_handelsværdi_kroner = 0,
    oplysningsstatus = AblOplystRettidigt,
    boligret = boligret
)
| abl_ordinaer_boligret_gevinst_resultat_for(position: AktieavanceOrdinærPosition, boligret: AktieavanceOrdinærBoligretInput) -> aktieavance_ordinaer_hændelsesresultat(
    position,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        afståelsessum_kroner = 180000,
        vilkår = abl_ordinaer_boligret_vilkår_for(boligret),
        par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
    )
)

= abl_ordinaer_position_primo = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-ORDINAER-A",
    kapitalmængde = AblPålydendeAktiekapital(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000
    ),
    anskaffelsessum_kroner = 100000
)
= abl_ordinaer_anskaffelse = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAnskaffelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        anskaffelsessum_kroner = 140000
    )
)
= abl_ordinaer_første_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_anskaffelse.position_efter,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 50,
            samlet_pålydende_kroner = 5000
        ),
        afståelsessum_kroner = 90000,
        vilkår = abl_ordinaer_noteret_vilkår,
        par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
    )
)
= abl_ordinaer_andet_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_første_delsalg.position_efter,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 50,
            samlet_pålydende_kroner = 5000
        ),
        afståelsessum_kroner = 40000,
        vilkår = abl_ordinaer_noteret_vilkår,
        par5a_kildefakta = abl_ordinaer_par5a_uden_reduktionsgrundlag
    )
)
= abl_ordinaer_gennemsnit_hændelsesforløb = aktieavance_ordinaer_hændelsesforløb(
    abl_ordinaer_position_primo,
    [
        abl_ordinaer_anskaffelse.hændelse,
        abl_ordinaer_første_delsalg.hændelse,
        abl_ordinaer_andet_delsalg.hændelse
    ]
)
= abl_ordinaer_gennemsnit_årsresultat = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    skatteposter = aktieavance_skatteposter_fra_ordinaere_hændelsesresultater(abl_ordinaer_gennemsnit_hændelsesforløb.hændelsesresultater),
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0
    )
))
= abl_ordinaer_gennemsnit_par4a = par4a_aktieavancebeskatningslov_resultat(Par4aAktieavancebeskatningslovInput(
    aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat_fra_ordinaere_aktier(abl_ordinaer_gennemsnit_årsresultat)
))

= abl_ordinaer_hovedaktionær_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 50,
            samlet_pålydende_kroner = 5000
        ),
        afståelsessum_kroner = 90000,
        vilkår = abl_ordinaer_hovedaktionær_vilkår,
        par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
    )
)
= abl_ordinaer_hovedaktionær_nulværdi_delsalg = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 50,
            samlet_pålydende_kroner = 5000
        ),
        afståelsessum_kroner = 90000,
        vilkår = abl_ordinaer_hovedaktionær_nulværdi_vilkår,
        par5a_kildefakta = abl_ordinaer_par5a_uden_reduktionsgrundlag
    )
)

= abl_ordinaer_unoteret_tab = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        afståelsessum_kroner = 70000,
        vilkår = abl_ordinaer_unoteret_vilkår,
        par5a_kildefakta = abl_ordinaer_par5a_uden_reduktionsgrundlag
    )
)
= abl_ordinaer_unoteret_tab_reduceret_efter_par5a = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        afståelsessum_kroner = 70000,
        vilkår = abl_ordinaer_unoteret_vilkår,
        par5a_kildefakta = abl_ordinaer_par5a_med_skattefrit_udbytte(beløb_kroner = 12000)
    )
)
= abl_ordinaer_unoteret_tab_uden_par5a_kildefakta = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        afståelsessum_kroner = 70000,
        vilkår = abl_ordinaer_unoteret_vilkår,
        par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
    )
)
= abl_ordinaer_unoteret_tab_årsresultat = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    skatteposter = aktieavance_skatteposter_fra_ordinaere_hændelsesresultater([abl_ordinaer_unoteret_tab]),
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0
    )
))

= abl_ordinaer_tidligere_noteret_tab = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_position_primo,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        afståelsessum_kroner = 50000,
        vilkår = abl_ordinaer_tidligere_noteret_vilkår,
        par5a_kildefakta = abl_ordinaer_par5a_uden_reduktionsgrundlag
    )
)
= abl_ordinaer_tidligere_noteret_gevinst_position = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-ORDINAER-B",
    kapitalmængde = AblPålydendeAktiekapital(
        antal_aktier = 100,
        samlet_pålydende_kroner = 10000
    ),
    anskaffelsessum_kroner = 100000
)
= abl_ordinaer_tidligere_noteret_gevinst = aktieavance_ordinaer_hændelsesresultat(
    abl_ordinaer_tidligere_noteret_gevinst_position,
    AblOrdinærAfståelse(
        kapitalmængde = AblPålydendeAktiekapital(
            antal_aktier = 100,
            samlet_pålydende_kroner = 10000
        ),
        afståelsessum_kroner = 130000,
        vilkår = abl_ordinaer_tidligere_noteret_vilkår,
        par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
    )
)
= abl_ordinaer_tidligere_noteret_gevinst_udenfor_modregningsgrundlag = aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    skatteposter = aktieavance_skatteposter_fra_ordinaere_hændelsesresultater([abl_ordinaer_tidligere_noteret_tab, abl_ordinaer_tidligere_noteret_gevinst]),
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0
    )
))
= abl_ordinaer_par13a_hovedperson_årsinput = AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    skatteposter = aktieavance_skatteposter_fra_ordinaere_hændelsesresultater([abl_ordinaer_tidligere_noteret_tab]),
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 30000,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0
    )
)
= abl_ordinaer_par13a_ægtefælle_årsinput = AktieavanceOrdinærÅrsinput(
    indkomstår = 2026,
    skatteposter = [],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 12000,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0
