)
= personskat_felt_aktiehændelser = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser",
    label = "Aktiehændelser",
    question = Some("Hvilke anskaffelser eller afståelser skete for denne aktiebeholdning?"),
    help = Some("Tilføj hændelserne i den rækkefølge, de skal behandles for beholdningen."),
    unit = None
)
= personskat_felt_aktie_boligret = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.$variant",
    label = "Boligret efter ABL § 15",
    question = Some("Er værdipapiret forbundet med brugsret til en beboelseslejlighed?"),
    help = Some("Boligretten kan gøre både gevinst og tab skattefri, når betingelserne i ejendomsavancebeskatningslovens § 8, stk. 4, er opfyldt."),
    unit = None
)
= personskat_felt_aktie_boligret_værdipapir = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.fakta.værdipapir_forbundet_med_brugsret_til_beboelseslejlighed",
    label = "Værdipapir med boligret",
    question = Some("Er aktien, andelsbeviset eller det lignende værdipapir knyttet til brugsretten til lejligheden?"),
    help = Some("ABL § 15 og EBL § 8, stk. 4, omfatter kun værdipapirer, som er forbundet med den konkrete boligret."),
    unit = None
)
= personskat_felt_aktie_boligret_flerlejlighedsejendom = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.fakta.udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder",
    label = "Udstederens ejendom med flere boliger",
    question = Some("Ejer selskabet eller foreningen direkte den ejendom med flere beboelseslejligheder, som boligretten vedrører?"),
    help = Some("Boligretsfritagelsen forudsætter, at udstederen direkte ejer ejendommen med de flere beboelseslejligheder."),
    unit = None
)
= personskat_felt_aktie_boligret_beboelse = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.fakta.lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden",
    label = "Boligbrug i kvalificerende periode",
    question = Some("Har lejligheden tjent til bolig for ejeren eller husstanden i en del af den ejerperiode, hvor skattefrihedsbetingelserne var opfyldt?"),
    help = Some("Feltet kræver tidsmæssigt overlap mellem boligbrug og den periode, hvor værdipapiret kunne afstås skattefrit efter EBL § 8, stk. 4."),
    unit = None
)
= personskat_felt_aktie_boligret_grundforhold = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.fakta.grundforhold.$variant",
    label = "Grundareal knyttet til lejligheden",
    question = Some("Hører der et bestemt grundareal til lejligheden?"),
