--@label:beregn_personskat::meta:personskat_beregningsmetadata--

| personskat_supplerende_skatteforhold(forhold: PersonskatSupplerendeSkatteforhold) -> LønmodtagerSkatteforhold(
    aktieindkomst_kroner = 0,
    ægtefælle_aktieindkomst_kroner = 0,
    aktieindkomst_ægtefæller_samlevende_ved_årets_udløb = Falskt,
    ægtefælle_nettokapitalindkomst_kroner = 0,
    kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb = Falskt,
    cfc_indkomst_kroner = 0,
    par8c_status = forhold.par8c_status,
    personfradrag_skattepligt = forhold.personfradrag_skattepligt,
    personfradrag_valg_dato_yyyymmdd = forhold.personfradrag_valg_dato_yyyymmdd,
    personfradrag_omvalg_dato_yyyymmdd = forhold.personfradrag_omvalg_dato_yyyymmdd
)
| personskat_angivne_skatteforhold(input: PersonskatSkatteforholdInput) -> match input {
    | StandardSkatteforhold -> lønmodtager_standard_skatteforhold()
    | SærligeSkatteforhold(forhold) -> personskat_supplerende_skatteforhold(forhold)
}
| personskat_ligningslov8m_kildeskattepligt_forenelig_med_personfradrag(kildeskattepligt: Ligningslov8MKildeskattepligt, personfradrag_skattepligt: PersonfradragSkattepligt) -> match personfradrag_skattepligt {
    | FuldtSkattepligtigHerILandet -> kildeskattepligt == Ll8MKildeskattelovPar1
    | KildeskattelovPar2HelårRelevantIndtægt -> kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr1 || kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr3
    | KildeskattelovPar2DelårValgtRelevantIndtægt -> kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr1 || kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr3
    | KildeskattelovPar2DelårIkkeValgt -> kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr1 || kildeskattepligt == Ll8MKildeskattelovPar2Stk1Nr3
    | _ -> Sandt
}
| personskat_ligningslov8m_kildeskattepligt_forenelig(input: PersonskatUdenlandskeSocialeBidragInput, skatteforhold: PersonskatSkatteforholdInput) -> match input {
    | UdenUdenlandskeSocialeBidragEfterLigningslov8M -> Sandt
    | MedUdenlandskeSocialeBidragEfterLigningslov8M(fakta) -> match skatteforhold {
        | StandardSkatteforhold -> fakta.kildeskattepligt == Ll8MKildeskattelovPar1
        | SærligeSkatteforhold(forhold) -> personskat_ligningslov8m_kildeskattepligt_forenelig_med_personfradrag(fakta.kildeskattepligt, forhold.personfradrag_skattepligt)
    }
}
| personskat_fastsættelsesproveniens_gyldig(proveniens: PersonskatFastsættelsesproveniens) -> match proveniens {
    | SkatteforvaltningensÅrsopgørelse(dokumentreference) -> dokumentreference != ""
    | SkatteforvaltningensAfgørelse(dokumentreference) -> dokumentreference != ""
    | AndenMyndighedsafgørelse(myndighed, dokumentreference) -> myndighed != "" && dokumentreference != ""
}
| personskat_underskudsårsresultat_disponeret_kroner(resultat: PersonskatUnderskudsårsresultat) -> resultat.dækket_ved_egen_skattemodregning_kroner + resultat.fradraget_i_ægtefælles_indkomst_kroner + resultat.dækket_ved_ægtefælles_skattemodregning_kroner + resultat.fremført_underskud_ultimo_kroner
| personskat_underskudsårsresultat_tilgængeligt_kroner(resultat: PersonskatUnderskudsårsresultat) -> resultat.fremført_underskud_primo_kroner - resultat.fremført_underskud_anvendt_i_egen_indkomst_kroner + resultat.årets_nye_underskud_kroner
| personskat_underskudsårsresultat_konsistent(resultat: PersonskatUnderskudsårsresultat) -> resultat.åbningsgrundlag_gyldigt && resultat.indkomstår > 0 && resultat.fremført_underskud_primo_kroner >= 0 && resultat.fremført_underskud_anvendt_i_egen_indkomst_kroner == penge_mindste_beløb(resultat.fremført_underskud_primo_kroner, penge_positivt_beløb(resultat.årets_skattepligtige_indkomst_før_fremførsel_kroner)) && resultat.årets_nye_underskud_kroner == par13_absolut_underskud(resultat.årets_skattepligtige_indkomst_før_fremførsel_kroner) && resultat.dækket_ved_egen_skattemodregning_kroner >= 0 && resultat.fradraget_i_ægtefælles_indkomst_kroner >= 0 && resultat.dækket_ved_ægtefælles_skattemodregning_kroner >= 0 && resultat.fremført_underskud_ultimo_kroner >= 0 && personskat_underskudsårsresultat_disponeret_kroner(resultat) == personskat_underskudsårsresultat_tilgængeligt_kroner(resultat)
| personskat_underskudsforhold_gyldigt(input: PersonskatUnderskudsforholdInput, skatteår: Heltal) -> match input {
    | StandardUnderskudsforhold -> Sandt
    | FremførtUnderskudFraForrigePersonskatÅr(resultat) -> personskat_underskudsårsresultat_konsistent(resultat) && resultat.indkomstår + 1 == skatteår
    | EksterntFastsatFremførtUnderskud(fra_indkomstår, underskud_kroner, proveniens) -> fra_indkomstår > 0 && fra_indkomstår + 1 == skatteår && underskud_kroner >= 0 && personskat_fastsættelsesproveniens_gyldig(proveniens)
}
| personskat_angivet_tidligere_underskud_kroner(input: PersonskatUnderskudsforholdInput) -> match input {
    | StandardUnderskudsforhold -> 0
    | FremførtUnderskudFraForrigePersonskatÅr(resultat) -> resultat.fremført_underskud_ultimo_kroner
    | EksterntFastsatFremførtUnderskud(_, underskud_kroner, _) -> underskud_kroner
}
| personskat_egne_tidligere_underskud_kroner(input: PersonskatUnderskudsforholdInput, skatteår: Heltal) -> hvis personskat_underskudsforhold_gyldigt(input, skatteår) { personskat_angivet_tidligere_underskud_kroner(input) } ellers { 0 }
| personskat_aktuelt_underskud_ikke_rummet_i_tidligere_indkomst_eller_skat(input: PersonskatUnderskudsforholdInput, skatteår: Heltal) -> personskat_underskudsforhold_gyldigt(input, skatteår)

| personskat_ingen_fremført_negativ_aktieskat() -> PersonskatNegativAktieskatFremførselsparInput(
    hovedperson = UdenFremførtNegativAktieskat,
    ægtefælle = UdenFremførtNegativAktieskat
)
| personskat_negativ_aktieskat_tranche_med_ejer(tranche: PersonskatNegativAktieskatTranche, ejer: PersonskatNegativAktieskatEjer) -> PersonskatNegativAktieskatTranche(
    ejer = ejer,
    oprindelsesår = tranche.oprindelsesår,
    resterende_negativ_skat_kroner = tranche.resterende_negativ_skat_kroner
)
| personskat_negativ_aktieskat_generisk_tranche(tranche: PersonskatNegativAktieskatTranche) -> AktieindkomstNegativSkatFremførselstranche(
    oprindelsesår = tranche.oprindelsesår,
    resterende_negativ_skat_kroner = tranche.resterende_negativ_skat_kroner
)
| personskat_negativ_aktieskat_generiske_trancher(trancher: List(PersonskatNegativAktieskatTranche)) -> map(
    trancher,
    personskat_negativ_aktieskat_generisk_tranche
)
| personskat_negativ_aktieskat_trancher_sorteret(trancher: List(PersonskatNegativAktieskatTranche)) -> sort_by(
    trancher,
    |tranche: PersonskatNegativAktieskatTranche| tranche.oprindelsesår
)
| personskat_negativ_aktieskat_trancher_med_ejer(trancher: List(PersonskatNegativAktieskatTranche), ejer: PersonskatNegativAktieskatEjer) -> map(
    personskat_negativ_aktieskat_trancher_sorteret(trancher),
    |tranche: PersonskatNegativAktieskatTranche| personskat_negativ_aktieskat_tranche_med_ejer(tranche, ejer)
)
| personskat_negativ_aktieskat_trancher_gyldige_for_ejer(trancher: List(PersonskatNegativAktieskatTranche), ejer: PersonskatNegativAktieskatEjer, seneste_oprindelsesår: Heltal) -> all(
    trancher,
    |tranche: PersonskatNegativAktieskatTranche| tranche.ejer == ejer && tranche.oprindelsesår > 0 && tranche.oprindelsesår <= seneste_oprindelsesår && tranche.resterende_negativ_skat_kroner > 0
) && aktieindkomst_negativ_skat_fremførselstrancher_gyldige(personskat_negativ_aktieskat_generiske_trancher(trancher))
| personskat_negativ_aktieskat_anvendelse_gyldig(anvendelse: AktieindkomstNegativSkatFremførselsanvendelse, seneste_oprindelsesår: Heltal) -> anvendelse.tranche.oprindelsesår > 0 && anvendelse.tranche.oprindelsesår <= seneste_oprindelsesår && anvendelse.tranche.resterende_negativ_skat_kroner > 0 && anvendelse.modregnet_i_egen_slutskat_kroner >= 0 && anvendelse.modregnet_i_ægtefælles_slutskat_kroner >= 0 && anvendelse.fremført_kroner >= 0 && anvendelse.modregnet_i_egen_slutskat_kroner + anvendelse.modregnet_i_ægtefælles_slutskat_kroner + anvendelse.fremført_kroner == anvendelse.tranche.resterende_negativ_skat_kroner
| personskat_negativ_aktieskat_anvendelser_gyldige(anvendelser: List(AktieindkomstNegativSkatFremførselsanvendelse), seneste_oprindelsesår: Heltal) -> all(
    anvendelser,
    |anvendelse: AktieindkomstNegativSkatFremførselsanvendelse| personskat_negativ_aktieskat_anvendelse_gyldig(anvendelse, seneste_oprindelsesår)
)
| personskat_negativ_aktieskat_årets_resultat_konsistent(resultat: AktieindkomstNegativSkatPersonResultat) -> resultat.negativ_skat_kroner >= 0 && resultat.modregnet_i_egen_slutskat_kroner >= 0 && resultat.modregnet_i_ægtefælles_slutskat_kroner >= 0 && resultat.fremført_kroner >= 0 && resultat.modregnet_i_egen_slutskat_kroner + resultat.modregnet_i_ægtefælles_slutskat_kroner + resultat.fremført_kroner == resultat.negativ_skat_kroner
| personskat_negativ_aktieskat_fremført_tranche_fra_anvendelse(ejer: PersonskatNegativAktieskatEjer, anvendelse: AktieindkomstNegativSkatFremførselsanvendelse) -> PersonskatNegativAktieskatTranche(
    ejer = ejer,
    oprindelsesår = anvendelse.tranche.oprindelsesår,
    resterende_negativ_skat_kroner = anvendelse.fremført_kroner
)
| personskat_negativ_aktieskat_tidligere_trancher_ultimo(ejer: PersonskatNegativAktieskatEjer, anvendelser: List(AktieindkomstNegativSkatFremførselsanvendelse)) -> map(
    filter(anvendelser, |anvendelse: AktieindkomstNegativSkatFremførselsanvendelse| anvendelse.fremført_kroner > 0),
    |anvendelse: AktieindkomstNegativSkatFremførselsanvendelse| personskat_negativ_aktieskat_fremført_tranche_fra_anvendelse(ejer, anvendelse)
)
| personskat_negativ_aktieskat_trancher_ultimo(ejer: PersonskatNegativAktieskatEjer, indkomstår: Heltal, anvendelser: List(AktieindkomstNegativSkatFremførselsanvendelse), årets_resultat: AktieindkomstNegativSkatPersonResultat) -> {
    = tidligere = personskat_negativ_aktieskat_tidligere_trancher_ultimo(ejer, anvendelser)
    hvis årets_resultat.fremført_kroner > 0 {
        concat(tidligere, [PersonskatNegativAktieskatTranche(
            ejer = ejer,
            oprindelsesår = indkomstår,
            resterende_negativ_skat_kroner = årets_resultat.fremført_kroner
        )])
    } ellers {
        tidligere
    }
}
| personskat_negativ_aktieskat_årsresultat_konsistent(resultat: PersonskatNegativAktieskatPersonÅrsresultat) -> resultat.åbningsgrundlag_gyldigt && resultat.indkomstår > 0 && personskat_negativ_aktieskat_trancher_gyldige_for_ejer(resultat.fremført_negativ_skat_primo, resultat.ejer, resultat.indkomstår - 1) && personskat_negativ_aktieskat_anvendelser_gyldige(resultat.tidligere_fremført_negativ_skat_anvendelser, resultat.indkomstår - 1) && personskat_negativ_aktieskat_generiske_trancher(resultat.fremført_negativ_skat_primo) == map(resultat.tidligere_fremført_negativ_skat_anvendelser, |anvendelse: AktieindkomstNegativSkatFremførselsanvendelse| anvendelse.tranche) && personskat_negativ_aktieskat_årets_resultat_konsistent(resultat.årets_negative_skat) && resultat.fremført_negativ_skat_ultimo == personskat_negativ_aktieskat_trancher_ultimo(resultat.ejer, resultat.indkomstår, resultat.tidligere_fremført_negativ_skat_anvendelser, resultat.årets_negative_skat)
| personskat_negativ_aktieskat_fremførselsinput_gyldigt(input: PersonskatNegativAktieskatFremførselsinput, skatteår: Heltal, ejer: PersonskatNegativAktieskatEjer) -> match input {
    | UdenFremførtNegativAktieskat -> Sandt
    | FremførtNegativAktieskatFraForrigePersonskatÅr(resultat) -> personskat_negativ_aktieskat_årsresultat_konsistent(resultat) && resultat.indkomstår + 1 == skatteår
    | EksterntFastsatFremførtNegativAktieskat(trancher, proveniens) -> personskat_fastsættelsesproveniens_gyldig(proveniens) && personskat_negativ_aktieskat_trancher_gyldige_for_ejer(trancher, ejer, skatteår - 1)
}
| personskat_negativ_aktieskat_trancher_primo(input: PersonskatNegativAktieskatFremførselsinput, skatteår: Heltal, ejer: PersonskatNegativAktieskatEjer) -> hvis personskat_negativ_aktieskat_fremførselsinput_gyldigt(input, skatteår, ejer) {
    match input {
        | UdenFremførtNegativAktieskat -> []
        | FremførtNegativAktieskatFraForrigePersonskatÅr(resultat) -> personskat_negativ_aktieskat_trancher_med_ejer(resultat.fremført_negativ_skat_ultimo, ejer)
        | EksterntFastsatFremførtNegativAktieskat(trancher, _) -> personskat_negativ_aktieskat_trancher_sorteret(trancher)
    }
} ellers {
    []
}

| personskat_ingen_erhvervsbefordring() -> PersonskatErhvervsbefordringInput(sager = [])
| personskat_ll9b_skatteår_understøttet(skatteår: Heltal) -> skatteår == 2026
| personskat_erhvervsbefordring_grundfakta_gyldige(fakta: PersonskatErhvervsbefordringFakta) -> fakta.identifikation != "" && fakta.rækkefølge_i_indkomståret > 0 && (fakta.godtgørelsesforhold.udbetalt_godtgørelse_kroner == 0 || fakta.godtgørende_arbejdsgiver_identifikation != "") && fakta.befordring.kilometer_i_sagen >= 0 && fakta.befordring.tres_dages_forhold.arbejdsdage_til_samme_arbejdsplads_inklusive_aktuel_dag_i_forudgående_12_måneder >= 0 && fakta.befordring.tres_dages_forhold.arbejdsdage_til_samme_arbejdsplads_inklusive_aktuel_dag_i_forudgående_12_måneder <= 366 && fakta.befordring.tres_dages_forhold.sammenhængende_arbejdsdage_siden_sidst_på_arbejdspladsen >= 0 && fakta.udgifter.dokumenterede_faktiske_kørselsudgifter_eksklusive_bro_tunnel_kroner >= 0 && fakta.udgifter.dokumenterede_bro_tunnel_udgifter_kroner >= 0 && fakta.antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang >= 0 && fakta.godtgørelsesforhold.udbetalt_godtgørelse_kroner >= 0
| personskat_erhvervsbefordring_sager_med_identifikation(sager: List(PersonskatErhvervsbefordringFakta), identifikation: Tekst) -> filter(sager, |fakta: PersonskatErhvervsbefordringFakta| fakta.identifikation == identifikation)
| personskat_erhvervsbefordring_identifikationer_entydige(input: PersonskatErhvervsbefordringInput) -> all(input.sager, |fakta: PersonskatErhvervsbefordringFakta| length(personskat_erhvervsbefordring_sager_med_identifikation(input.sager, fakta.identifikation)) == 1)
| personskat_ll9b_input(fakta: PersonskatErhvervsbefordringFakta, kilometerhistorik: Ligningslov9BKilometerhistorik, skatteår: Heltal) -> Ligningslov9BInput(
    indkomstår = skatteår,
    køretøj = fakta.køretøj,
    befordring = Ligningslov9BBefordring(
        art = fakta.befordring.art,
        kilometer_i_sagen = fakta.befordring.kilometer_i_sagen,
        kilometerhistorik = kilometerhistorik,
        tres_dages_forhold = fakta.befordring.tres_dages_forhold
    ),
    udgifter = fakta.udgifter,
    fradragsforhold = Ligningslov9BFradragsforhold(
        personrolle = Ll9BLønmodtager,
        metode = Ll9BSkatteraadetsKilometersatser,
        kundeopsøgende_aktivitet = fakta.kundeopsøgende_aktivitet,
        antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang = fakta.antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang
    ),
    godtgørelsesforhold = fakta.godtgørelsesforhold
)
| personskat_erhvervsbefordring_sagsresultat(fakta: PersonskatErhvervsbefordringFakta, kilometerhistorik: Ligningslov9BKilometerhistorik, skatteår: Heltal) -> {
    = skatteår_understøttet = personskat_ll9b_skatteår_understøttet(skatteår)
    = grundfakta_gyldige = personskat_erhvervsbefordring_grundfakta_gyldige(fakta)
    hvis skatteår_understøttet && grundfakta_gyldige {
        = ll9b_input = personskat_ll9b_input(fakta, kilometerhistorik, skatteår)
        = ll9b_resultat = ligningslov9b_resultat(ll9b_input)
        BeregnetErhvervsbefordringEfterLigningslov9B(
            fakta = fakta,
            ligningslov9b_input = ll9b_input,
            ligningslov9b_resultat = ll9b_resultat,
            par3_stk2_nr8_resultat = par3_stk2_nr8_resultat(ll9b_resultat)
        )
    } ellers {
        UgyldigtErhvervsbefordringsgrundlag(
            fakta = fakta,
            skatteår_understøttet = skatteår_understøttet,
            grundfakta_gyldige = grundfakta_gyldige
        )
    }
}
| personskat_erhvervsbefordring_sagsresultat_gyldigt(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | UgyldigtErhvervsbefordringsgrundlag(_, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_erhvervsbefordring_sag_identifikation(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | UgyldigtErhvervsbefordringsgrundlag(fakta, _, _) -> fakta.identifikation
    | BeregnetErhvervsbefordringEfterLigningslov9B(fakta, _, _, _) -> fakta.identifikation
}
| personskat_erhvervsbefordring_sag_skattefri_godtgørelse_kroner(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, ligningslov9b_resultat, _) -> ligningslov9b_resultat.skattefri_godtgørelse_kroner
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_skattepligtig_godtgørelse_kroner(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, ligningslov9b_resultat, _) -> ligningslov9b_resultat.godtgørelse_personlig_indkomst_kroner
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_fradrag_i_personlig_indkomst_kroner(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, _, par3_stk2_nr8_resultat) -> par3_stk2_nr8_resultat.fradrag_i_personlig_indkomst_kroner
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_bil_motorcykelkilometer(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, ligningslov9b_input, ligningslov9b_resultat, _) -> hvis ligningslov9b_input.køretøj == Ll9BEgenBil || ligningslov9b_input.køretøj == Ll9BEgenMotorcykel { ligningslov9b_resultat.erhvervsmæssige_kilometer } ellers { 0 }
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_bil_motorcykelkilometer_til_direkte_fradrag(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, ligningslov9b_resultat, _) -> hvis ligningslov9b_resultat.direkte_fradragsberettiget_efter_par9b { personskat_erhvervsbefordring_sag_bil_motorcykelkilometer(resultat) } ellers { 0 }
    | _ -> 0
}

# PersonskatErhvervsbefordringForløbstrinSag(tilstand: PersonskatErhvervsbefordringForløbstilstand, fakta: PersonskatErhvervsbefordringFakta, skatteår: Heltal) {
    | tidligere_godtgørelseskilometer() -> map_get_or(tilstand.historik.bil_motorcykelkilometer_pr_arbejdsgiver, fakta.godtgørende_arbejdsgiver_identifikation, 0)
    | kilometerhistorik() -> Ligningslov9BKilometerhistorik(
        tidligere_erhvervsmæssige_kilometer_hos_godtgørende_arbejdsgiver_i_indkomståret = tidligere_godtgørelseskilometer(),
        tidligere_erhvervsmæssige_kilometer_til_direkte_fradrag_i_indkomståret = tilstand.historik.bil_motorcykelkilometer_til_direkte_fradrag
    )
    | sagsresultat() -> personskat_erhvervsbefordring_sagsresultat(fakta, kilometerhistorik(), skatteår)
    | bil_motorcykelkilometer_pr_arbejdsgiver_efter() -> tilstand.historik.bil_motorcykelkilometer_pr_arbejdsgiver
    | exception bil_motorcykelkilometer_føjes_til_arbejdsgiverhistorik bil_motorcykelkilometer_pr_arbejdsgiver_efter() -> map_insert(
        tilstand.historik.bil_motorcykelkilometer_pr_arbejdsgiver,
        fakta.godtgørende_arbejdsgiver_identifikation,
        tidligere_godtgørelseskilometer() + personskat_erhvervsbefordring_sag_bil_motorcykelkilometer(sagsresultat())
    ) under fakta.godtgørende_arbejdsgiver_identifikation != "" && personskat_erhvervsbefordring_sagsresultat_gyldigt(sagsresultat())
    | bil_motorcykelkilometer_til_direkte_fradrag_efter() -> tilstand.historik.bil_motorcykelkilometer_til_direkte_fradrag + personskat_erhvervsbefordring_sag_bil_motorcykelkilometer_til_direkte_fradrag(sagsresultat())
    | rækkefølge_gyldig() -> tilstand.rækkefølge_gyldig && fakta.rækkefølge_i_indkomståret == tilstand.næste_rækkefølge_i_indkomståret
    | resultat() -> PersonskatErhvervsbefordringForløbstilstand(
        næste_rækkefølge_i_indkomståret = tilstand.næste_rækkefølge_i_indkomståret + 1,
        historik = PersonskatErhvervsbefordringÅrshistorik(
            bil_motorcykelkilometer_pr_arbejdsgiver = bil_motorcykelkilometer_pr_arbejdsgiver_efter(),
            bil_motorcykelkilometer_til_direkte_fradrag = bil_motorcykelkilometer_til_direkte_fradrag_efter()
        ),
        sagsresultater = concat(tilstand.sagsresultater, [sagsresultat()]),
        rækkefølge_gyldig = rækkefølge_gyldig()
    )
}

| personskat_erhvervsbefordring_forløbstrin(tilstand: PersonskatErhvervsbefordringForløbstilstand, fakta: PersonskatErhvervsbefordringFakta, skatteår: Heltal) -> PersonskatErhvervsbefordringForløbstrinSag(tilstand, fakta, skatteår).resultat()
| personskat_erhvervsbefordring_forløb(input: PersonskatErhvervsbefordringInput, skatteår: Heltal) -> foldl(input.sager, PersonskatErhvervsbefordringForløbstilstand(
    næste_rækkefølge_i_indkomståret = 1,
    historik = PersonskatErhvervsbefordringÅrshistorik(
        bil_motorcykelkilometer_pr_arbejdsgiver = map_new(),
        bil_motorcykelkilometer_til_direkte_fradrag = 0
    ),
    sagsresultater = [],
    rækkefølge_gyldig = Sandt
    ), |tilstand: PersonskatErhvervsbefordringForløbstilstand, fakta: PersonskatErhvervsbefordringFakta| personskat_erhvervsbefordring_forløbstrin(tilstand, fakta, skatteår))
| personskat_erhvervsbefordring_skattefri_godtgørelse_før_validering_kroner(resultater: List(PersonskatErhvervsbefordringSagResultat)) -> foldl(resultater, 0, |sum: Heltal, resultat: PersonskatErhvervsbefordringSagResultat| sum + personskat_erhvervsbefordring_sag_skattefri_godtgørelse_kroner(resultat))
| personskat_erhvervsbefordring_skattepligtig_godtgørelse_før_validering_kroner(resultater: List(PersonskatErhvervsbefordringSagResultat)) -> foldl(resultater, 0, |sum: Heltal, resultat: PersonskatErhvervsbefordringSagResultat| sum + personskat_erhvervsbefordring_sag_skattepligtig_godtgørelse_kroner(resultat))
| personskat_erhvervsbefordring_fradrag_før_validering_kroner(resultater: List(PersonskatErhvervsbefordringSagResultat)) -> foldl(resultater, 0, |sum: Heltal, resultat: PersonskatErhvervsbefordringSagResultat| sum + personskat_erhvervsbefordring_sag_fradrag_i_personlig_indkomst_kroner(resultat))
| personskat_erhvervsbefordring_resultat(input: PersonskatErhvervsbefordringInput, skatteår: Heltal) -> {
    = forløb = personskat_erhvervsbefordring_forløb(input, skatteår)
    = sagsresultater = forløb.sagsresultater
    = identifikationer_entydige = personskat_erhvervsbefordring_identifikationer_entydige(input)
    = alle_input_gyldige = identifikationer_entydige && forløb.rækkefølge_gyldig && all(sagsresultater, personskat_erhvervsbefordring_sagsresultat_gyldigt)
    PersonskatErhvervsbefordringResultat(
        input = input,
        sagsresultater = sagsresultater,
        identifikationer_entydige = identifikationer_entydige,
        rækkefølge_gyldig = forløb.rækkefølge_gyldig,
        historik_ultimo = forløb.historik,
        alle_input_gyldige = alle_input_gyldige,
        samlet_skattefri_godtgørelse_kroner = hvis alle_input_gyldige { personskat_erhvervsbefordring_skattefri_godtgørelse_før_validering_kroner(sagsresultater) } ellers { 0 },
        samlet_skattepligtig_godtgørelse_kroner = hvis alle_input_gyldige { personskat_erhvervsbefordring_skattepligtig_godtgørelse_før_validering_kroner(sagsresultater) } ellers { 0 },
        samlet_fradrag_i_personlig_indkomst_kroner = hvis alle_input_gyldige { personskat_erhvervsbefordring_fradrag_før_validering_kroner(sagsresultater) } ellers { 0 }
    )
}
| personskat_erhvervsbefordring_input_gyldigt(resultat: PersonskatErhvervsbefordringResultat) -> resultat.alle_input_gyldige
| personskat_erhvervsbefordring_skattepligtig_løn_kroner(resultat: PersonskatErhvervsbefordringResultat) -> resultat.samlet_skattepligtig_godtgørelse_kroner
| personskat_erhvervsbefordring_fradrag_i_personlig_indkomst_kroner(resultat: PersonskatErhvervsbefordringResultat) -> resultat.samlet_fradrag_i_personlig_indkomst_kroner
| personskat_ingen_befordringsfradrag() -> PersonskatBefordringsfradragInput(forhold = [])

| personskat_ingen_ligningsfradrag() -> PersonskatLigningsfradragInput(
    sømandsfradrag = sømandsbeskatningslov3_intet_årsinput(),
    sømandsbeskatningslov4 = sømandsbeskatningslov4_intet_årsinput(),
    fiskerfradrag = ligningslov9g_intet_årsinput(),
    øvrige_lønmodtagerudgifter = ligningslov9_stk1_intet_årsinput(),
    befordring = personskat_ingen_befordringsfradrag(),
    rejser = ligningslov9a_intet_årsinput(),
    faglige_kontingenter = Ligningslov13Årsinput(
        skatteyderstatus = Ll13Lønmodtager,
        kontingenter = []
    ),
    arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(
        skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark,
        bidrag = []
    ),
    gaver = LigningslovGaveÅrsinput(gaver = [])
)
| personskat_ll9g_pbl49_stk1_kildetype(fakta: Pbl49Til49BBidragsfakta) -> match fakta.art {
    | Pbl49Akassekontingent(_, _) -> Sandt
    | Pbl49PrivatArbejdsløshedsforsikring(_, _) -> Sandt
    | Pbl49Seniormedlemskontingent(_, _) -> Sandt
    | _ -> Falskt
}
| personskat_ll9g_ølogiopholdskilder(input: Ligningslov9AØlogiInput) -> match input {
    | UdenØlogifradrag -> []
    | MedØlogifradrag(_, arbejdsforhold) -> flat_map(
        arbejdsforhold,
        |forhold: Ligningslov9AØlogiArbejdsforhold| map(
            forhold.ophold,
            |ophold: Ligningslov9AØlogiophold| Ll9GLigningslov9AØlogiophold(kildeidentifikation = ophold.identifikation)
        )
    )
}
| personskat_ll9g_selvstændigt_fiskerarbejde_findes(input: Ligningslov9GÅrsinput, virksomhedsidentifikation: Tekst) -> any(
    input.arbejdsforhold,
    |arbejdsforhold: Ligningslov9GArbejdsforhold| arbejdsforhold.identifikation == virksomhedsidentifikation && arbejdsforhold.erhvervsform == Ll9GSelvstændigFisker
)
| personskat_ll9g_selvstændig_udgiftsnøgle(virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst) -> Ligningslov9GSelvstændigUdgiftsnøgle(
    virksomhedsidentifikation = virksomhedsidentifikation,
    kildeidentifikation = kildeidentifikation
)
| personskat_ll9g_selvstændige_udgifter_til_vurdering(lønmodtager: PersonskatLønmodtagerInput) -> flat_map(
    filter(
        lønmodtager.personlig_indkomst.ordinære_forhold.virksomheder_uden_virksomhedsordning,
        |virksomhed: PersonskatOrdinærVirksomhedFakta| personskat_ll9g_selvstændigt_fiskerarbejde_findes(lønmodtager.ligningsfradrag.fiskerfradrag, virksomhed.identifikation)
    ),
    |virksomhed: PersonskatOrdinærVirksomhedFakta| map(
        filter(
            virksomhed.udgifter,
            |udgift: PersonskatVirksomhedsudgiftFakta| udgift.afgrænsning == SelvstændigErhvervsindkomstUdgift
        ),
        |udgift: PersonskatVirksomhedsudgiftFakta| personskat_ll9g_selvstændig_udgiftsnøgle(virksomhed.identifikation, udgift.identifikation)
    )
)
| personskat_ll9g_selvstændig_udgiftsvurdering_for(input: Ligningslov9GÅrsinput, nøgle: Ligningslov9GSelvstændigUdgiftsnøgle) -> filter(
    input.selvstændige_udgiftsvurderinger,
    |vurdering: Ligningslov9GSelvstændigUdgiftsvurdering| vurdering.virksomhedsidentifikation == nøgle.virksomhedsidentifikation && vurdering.kildeidentifikation == nøgle.kildeidentifikation
)
| personskat_ll9g_selvstændig_udgift_sidestillet_med_lønmodtagerudgift(input: Ligningslov9GÅrsinput, virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst) -> any(
    input.selvstændige_udgiftsvurderinger,
    |vurdering: Ligningslov9GSelvstændigUdgiftsvurdering| vurdering.virksomhedsidentifikation == virksomhedsidentifikation && vurdering.kildeidentifikation == kildeidentifikation && vurdering.sammenlignelighed == Ll9GSidstillesMedLønmodtagerudgift
)
| personskat_ll9g_selvstændige_sidestillede_udgiftskilder(input: Ligningslov9GÅrsinput) -> map(
    filter(
        input.selvstændige_udgiftsvurderinger,
        |vurdering: Ligningslov9GSelvstændigUdgiftsvurdering| vurdering.sammenlignelighed == Ll9GSidstillesMedLønmodtagerudgift
    ),
    |vurdering: Ligningslov9GSelvstændigUdgiftsvurdering| Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(
        virksomhedsidentifikation = vurdering.virksomhedsidentifikation,
        kildeidentifikation = vurdering.kildeidentifikation
    )
)
| personskat_ll9g_påkrævede_kilder(lønmodtager: PersonskatLønmodtagerInput) -> {
    = ligningslov9_stk1_kilder = map(
        lønmodtager.ligningsfradrag.øvrige_lønmodtagerudgifter.udgifter,
        |udgift: Ligningslov9Stk1Udgiftsfakta| Ll9GLigningslov9Stk1Udgift(kildeidentifikation = udgift.identifikation)
    )
    = ligningslov9a_rejsekilder = map(
        lønmodtager.ligningsfradrag.rejser.rejser,
        |rejse: Ligningslov9ARejsefakta| Ll9GLigningslov9ARejse(kildeidentifikation = rejse.identifikation)
    )
    = ligningslov9a_ølogikilder = personskat_ll9g_ølogiopholdskilder(lønmodtager.ligningsfradrag.rejser.ølogi)
    = ligningslov9b_kilder = map(
        lønmodtager.erhvervsbefordring.sager,
        |sag: PersonskatErhvervsbefordringFakta| Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation = sag.identifikation)
    )
    = ligningslov9c_og_9d_kilder = map(
        filter(
            lønmodtager.ligningsfradrag.befordring.forhold,
            |forhold: PersonskatBefordringsfradragFakta| forhold.befordringsformål == IndtægtsgivendeArbejdsplads
        ),
        |forhold: PersonskatBefordringsfradragFakta| Ll9GLigningslov9COg9DBefordringsforhold(kildeidentifikation = forhold.identifikation)
    )
    = ligningslov13_kilder = map(
        distinct(map(
            lønmodtager.ligningsfradrag.faglige_kontingenter.kontingenter,
            |kontingent: Ligningslov13KontingentFakta| kontingent.forening_identifikation
        )),
        |forening_identifikation: Tekst| Ll9GLigningslov13Forening(forening_identifikation = forening_identifikation)
    )
    = pensionsbeskatningslov49_stk1_kilder = map(
        filter(
            lønmodtager.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.bidrag,
            personskat_ll9g_pbl49_stk1_kildetype
        ),
        |bidrag: Pbl49Til49BBidragsfakta| Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = bidrag.identifikation)
    )
    = selvstændige_sidestillede_udgiftskilder = personskat_ll9g_selvstændige_sidestillede_udgiftskilder(lønmodtager.ligningsfradrag.fiskerfradrag)
    concat(
        ligningslov9_stk1_kilder,
        concat(
            ligningslov9a_rejsekilder,
            concat(
                ligningslov9a_ølogikilder,
                concat(
                    ligningslov9b_kilder,
                    concat(
                        ligningslov9c_og_9d_kilder,
                        concat(ligningslov13_kilder, concat(pensionsbeskatningslov49_stk1_kilder, selvstændige_sidestillede_udgiftskilder))
                    )
                )
            )
        )
    )
}
| personskat_ll9g_ølogiophold_findes(input: Ligningslov9AØlogiInput, kildeidentifikation: Tekst) -> match input {
    | UdenØlogifradrag -> Falskt
    | MedØlogifradrag(_, arbejdsforhold) -> any(
        arbejdsforhold,
        |forhold: Ligningslov9AØlogiArbejdsforhold| any(
            forhold.ophold,
            |ophold: Ligningslov9AØlogiophold| ophold.identifikation == kildeidentifikation
        )
    )
}
| personskat_ll9g_selvstændig_driftsudgift_findes(input: PersonskatPersonligIndkomstInput, virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst) -> any(
    input.ordinære_forhold.virksomheder_uden_virksomhedsordning,
    |virksomhed: PersonskatOrdinærVirksomhedFakta| virksomhed.identifikation == virksomhedsidentifikation && any(
        virksomhed.udgifter,
        |udgift: PersonskatVirksomhedsudgiftFakta| udgift.identifikation == kildeidentifikation && udgift.afgrænsning == SelvstændigErhvervsindkomstUdgift
    )
)
| personskat_ll9g_selvstændig_udgiftsvurdering_kanonisk_gyldig(lønmodtager: PersonskatLønmodtagerInput, vurdering: Ligningslov9GSelvstændigUdgiftsvurdering) -> personskat_ll9g_selvstændig_driftsudgift_findes(
    lønmodtager.personlig_indkomst,
    vurdering.virksomhedsidentifikation,
    vurdering.kildeidentifikation
) && personskat_ll9g_selvstændigt_fiskerarbejde_findes(lønmodtager.ligningsfradrag.fiskerfradrag, vurdering.virksomhedsidentifikation)
| personskat_ll9g_selvstændige_udgiftsvurderinger_kanonisk_gyldige(lønmodtager: PersonskatLønmodtagerInput) -> all(
    lønmodtager.ligningsfradrag.fiskerfradrag.selvstændige_udgiftsvurderinger,
    |vurdering: Ligningslov9GSelvstændigUdgiftsvurdering| personskat_ll9g_selvstændig_udgiftsvurdering_kanonisk_gyldig(lønmodtager, vurdering)
)
| personskat_ll9g_påkrævede_selvstændige_udgifter_vurderet(fiskerfradrag: Ligningslov9GÅrsresultat, påkrævede_vurderinger: List(Ligningslov9GSelvstændigUdgiftsnøgle)) -> fiskerfradrag.fradrag_foretaget_efter_par9g == Falskt || all(
    påkrævede_vurderinger,
    |nøgle: Ligningslov9GSelvstændigUdgiftsnøgle| length(personskat_ll9g_selvstændig_udgiftsvurdering_for(fiskerfradrag.input, nøgle)) == 1
)
| personskat_ll9g_kilde_findes(kilde: Ligningslov9GFradragskilde, lønmodtager: PersonskatLønmodtagerInput) -> match kilde {
    | Ll9GLigningslov9Stk1Udgift(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.øvrige_lønmodtagerudgifter.udgifter, |udgift: Ligningslov9Stk1Udgiftsfakta| udgift.identifikation == kildeidentifikation)
    | Ll9GLigningslov9ARejse(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.rejser.rejser, |rejse: Ligningslov9ARejsefakta| rejse.identifikation == kildeidentifikation)
    | Ll9GLigningslov9AØlogiophold(kildeidentifikation) -> personskat_ll9g_ølogiophold_findes(lønmodtager.ligningsfradrag.rejser.ølogi, kildeidentifikation)
    | Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation) -> any(lønmodtager.erhvervsbefordring.sager, |sag: PersonskatErhvervsbefordringFakta| sag.identifikation == kildeidentifikation)
    | Ll9GLigningslov9COg9DBefordringsforhold(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.befordring.forhold, |forhold: PersonskatBefordringsfradragFakta| forhold.identifikation == kildeidentifikation)
    | Ll9GLigningslov13Forening(forening_identifikation) -> any(lønmodtager.ligningsfradrag.faglige_kontingenter.kontingenter, |kontingent: Ligningslov13KontingentFakta| kontingent.forening_identifikation == forening_identifikation)
    | Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.arbejdsløshed_efterløn_og_fleksydelse.bidrag, |bidrag: Pbl49Til49BBidragsfakta| bidrag.identifikation == kildeidentifikation && personskat_ll9g_pbl49_stk1_kildetype(bidrag))
    | Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation, kildeidentifikation) -> personskat_ll9g_selvstændig_driftsudgift_findes(lønmodtager.personlig_indkomst, virksomhedsidentifikation, kildeidentifikation) && personskat_ll9g_selvstændig_udgift_sidestillet_med_lønmodtagerudgift(lønmodtager.ligningsfradrag.fiskerfradrag, virksomhedsidentifikation, kildeidentifikation)
}
| personskat_ll9g_arbejdstilknytning_identifikation(arbejdstilknytning: Ligningslov9GArbejdstilknytning) -> match arbejdstilknytning {
    | Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation) -> arbejdsforhold_identifikation
    | Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation) -> arbejdsforhold_identifikation
}
| personskat_ll9g_arbejdsforhold_har_erhvervsform(input: Ligningslov9GÅrsinput, arbejdsforhold_identifikation: Tekst, erhvervsform: Ligningslov9GErhvervsform) -> any(
    input.arbejdsforhold,
    |arbejdsforhold: Ligningslov9GArbejdsforhold| arbejdsforhold.identifikation == arbejdsforhold_identifikation && arbejdsforhold.erhvervsform == erhvervsform
)
| personskat_ll9g_ølogiophold_arbejdstilknytning_svarer(input: Ligningslov9AØlogiInput, kildeidentifikation: Tekst, arbejdsforhold_identifikation: Tekst) -> match input {
    | UdenØlogifradrag -> Falskt
    | MedØlogifradrag(_, arbejdsforhold) -> any(
        arbejdsforhold,
        |forhold: Ligningslov9AØlogiArbejdsforhold| forhold.arbejdssted_identifikation == arbejdsforhold_identifikation && any(
            forhold.ophold,
            |ophold: Ligningslov9AØlogiophold| ophold.identifikation == kildeidentifikation
        )
    )
}
| personskat_ll9g_kildens_arbejdstilknytning_svarer(tilknytning: Ligningslov9GKildetilknytning, lønmodtager: PersonskatLønmodtagerInput) -> {
    = arbejdsforhold_identifikation = personskat_ll9g_arbejdstilknytning_identifikation(tilknytning.arbejdstilknytning)
    match tilknytning.kilde {
        | Ll9GLigningslov9Stk1Udgift(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.øvrige_lønmodtagerudgifter.udgifter, |udgift: Ligningslov9Stk1Udgiftsfakta| udgift.identifikation == kildeidentifikation && udgift.arbejdsforhold_identifikation == arbejdsforhold_identifikation) && match tilknytning.arbejdstilknytning {
            | Ll9GTilknyttetErhvervsfiskerarbejde(_) -> personskat_ll9g_arbejdsforhold_har_erhvervsform(lønmodtager.ligningsfradrag.fiskerfradrag, arbejdsforhold_identifikation, Ll9GAnsatFisker)
            | Ll9GTilknyttetAndetArbejde(_) -> Sandt
        }
        | Ll9GLigningslov9ARejse(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.rejser.rejser, |rejse: Ligningslov9ARejsefakta| rejse.identifikation == kildeidentifikation && rejse.arbejdssted_identifikation == arbejdsforhold_identifikation)
        | Ll9GLigningslov9AØlogiophold(kildeidentifikation) -> personskat_ll9g_ølogiophold_arbejdstilknytning_svarer(lønmodtager.ligningsfradrag.rejser.ølogi, kildeidentifikation, arbejdsforhold_identifikation)
        | Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation) -> any(lønmodtager.erhvervsbefordring.sager, |sag: PersonskatErhvervsbefordringFakta| sag.identifikation == kildeidentifikation && sag.godtgørende_arbejdsgiver_identifikation == arbejdsforhold_identifikation)
        | Ll9GLigningslov9COg9DBefordringsforhold(kildeidentifikation) -> any(lønmodtager.ligningsfradrag.befordring.forhold, |forhold: PersonskatBefordringsfradragFakta| forhold.identifikation == kildeidentifikation && forhold.befordringsformål == IndtægtsgivendeArbejdsplads && forhold.befordringsmål_identifikation == arbejdsforhold_identifikation)
        | Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation, _) -> virksomhedsidentifikation == arbejdsforhold_identifikation && personskat_ll9g_arbejdsforhold_har_erhvervsform(lønmodtager.ligningsfradrag.fiskerfradrag, arbejdsforhold_identifikation, Ll9GSelvstændigFisker)
        | _ -> Sandt
    }
}
| personskat_ll9g_kildetilknytninger_kanonisk_gyldige(lønmodtager: PersonskatLønmodtagerInput, fiskerfradrag: Ligningslov9GÅrsresultat) -> fiskerfradrag.alle_input_gyldige && all(
    fiskerfradrag.input.kildetilknytninger,
    |tilknytning: Ligningslov9GKildetilknytning| personskat_ll9g_kilde_findes(tilknytning.kilde, lønmodtager) && personskat_ll9g_kildens_arbejdstilknytning_svarer(tilknytning, lønmodtager)
)
| personskat_ll9g_påkrævede_kilder_tilknyttet(fiskerfradrag: Ligningslov9GÅrsresultat, påkrævede_kilder: List(Ligningslov9GFradragskilde)) -> fiskerfradrag.fradrag_foretaget_efter_par9g == Falskt || all(
    påkrævede_kilder,
    |kilde: Ligningslov9GFradragskilde| length(ligningslov9g_kildetilknytninger_for(fiskerfradrag.input, kilde)) == 1
)
| personskat_ll9g_selvstændige_driftsudgifter_afskåret_kroner(lønmodtager: PersonskatLønmodtagerInput, fiskerfradrag: Ligningslov9GÅrsresultat, samordning_gyldig: Boolsk) -> hvis samordning_gyldig == Falskt { 0 } ellers {
    foldl(
        lønmodtager.personlig_indkomst.ordinære_forhold.virksomheder_uden_virksomhedsordning,
        0,
        |virksomhedssum_kroner: Heltal, virksomhed: PersonskatOrdinærVirksomhedFakta| virksomhedssum_kroner + foldl(
            virksomhed.udgifter,
            0,
            |udgiftssum_kroner: Heltal, udgift: PersonskatVirksomhedsudgiftFakta| udgiftssum_kroner + hvis udgift.afgrænsning == SelvstændigErhvervsindkomstUdgift && udgift.beløb_kroner > 0 && personskat_ll9g_selvstændig_udgift_sidestillet_med_lønmodtagerudgift(fiskerfradrag.input, virksomhed.identifikation, udgift.identifikation) && ligningslov9g_kilde_afskåret(
                fiskerfradrag,
                Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation = virksomhed.identifikation, kildeidentifikation = udgift.identifikation)
            ) { udgift.beløb_kroner } ellers { 0 }
        )
    )
}
| personskat_ll9g_koordinering(lønmodtager: PersonskatLønmodtagerInput) -> {
    = fiskerfradrag = ligningslov9g_årsresultat(lønmodtager.skatteår, lønmodtager.ligningsfradrag.fiskerfradrag)
    = påkrævede_kilder = personskat_ll9g_påkrævede_kilder(lønmodtager)
    = påkrævede_selvstændige_udgiftsvurderinger = personskat_ll9g_selvstændige_udgifter_til_vurdering(lønmodtager)
    = kildetilknytninger_gyldige = personskat_ll9g_kildetilknytninger_kanonisk_gyldige(lønmodtager, fiskerfradrag)
    = påkrævede_kilder_tilknyttet = personskat_ll9g_påkrævede_kilder_tilknyttet(fiskerfradrag, påkrævede_kilder)
    = selvstændige_udgiftsvurderinger_gyldige = fiskerfradrag.alle_input_gyldige && personskat_ll9g_selvstændige_udgiftsvurderinger_kanonisk_gyldige(lønmodtager)
    = påkrævede_selvstændige_udgifter_vurderet = personskat_ll9g_påkrævede_selvstændige_udgifter_vurderet(fiskerfradrag, påkrævede_selvstændige_udgiftsvurderinger)
    = samordning_gyldig = kildetilknytninger_gyldige && påkrævede_kilder_tilknyttet && selvstændige_udgiftsvurderinger_gyldige && påkrævede_selvstændige_udgifter_vurderet
    PersonskatLigningslov9GKoordinering(
        fiskerfradrag = fiskerfradrag,
        påkrævede_kilder = påkrævede_kilder,
        påkrævede_selvstændige_udgiftsvurderinger = påkrævede_selvstændige_udgiftsvurderinger,
        kildetilknytninger_gyldige = kildetilknytninger_gyldige,
        påkrævede_kilder_tilknyttet = påkrævede_kilder_tilknyttet,
        selvstændige_udgiftsvurderinger_gyldige = selvstændige_udgiftsvurderinger_gyldige,
        påkrævede_selvstændige_udgifter_vurderet = påkrævede_selvstændige_udgifter_vurderet,
        samordning_gyldig = samordning_gyldig,
        selvstændige_driftsudgifter_afskåret_kroner = personskat_ll9g_selvstændige_driftsudgifter_afskåret_kroner(lønmodtager, fiskerfradrag, samordning_gyldig)
    )
}
| personskat_ll9g_kilde_bevares(koordinering: PersonskatLigningslov9GKoordinering, kilde: Ligningslov9GFradragskilde) -> koordinering.fiskerfradrag.fradrag_foretaget_efter_par9g == Falskt || koordinering.samordning_gyldig && ligningslov9g_kilde_afskåret(koordinering.fiskerfradrag, kilde) == Falskt
| personskat_ll9g_lønmodtagerudgifter_input(input: Ligningslov9Stk1Årsinput, koordinering: PersonskatLigningslov9GKoordinering) -> Ligningslov9Stk1Årsinput(
    skatteyderstatus = input.skatteyderstatus,
    udgifter = filter(
        input.udgifter,
        |udgift: Ligningslov9Stk1Udgiftsfakta| personskat_ll9g_kilde_bevares(
            koordinering,
            Ll9GLigningslov9Stk1Udgift(kildeidentifikation = udgift.identifikation)
        )
    )
)
| personskat_ll9g_faglige_kontingenter_input(input: Ligningslov13Årsinput, koordinering: PersonskatLigningslov9GKoordinering) -> Ligningslov13Årsinput(
    skatteyderstatus = input.skatteyderstatus,
    kontingenter = filter(
        input.kontingenter,
        |kontingent: Ligningslov13KontingentFakta| personskat_ll9g_kilde_bevares(
            koordinering,
            Ll9GLigningslov13Forening(forening_identifikation = kontingent.forening_identifikation)
        )
    )
)
| personskat_ll9g_virksomhedsudgift_anvendt(virksomhedsidentifikation: Tekst, udgift: PersonskatVirksomhedsudgiftFakta, koordinering: PersonskatLigningslov9GKoordinering) -> PersonskatVirksomhedsudgiftFakta(
    identifikation = udgift.identifikation,
    afgrænsning = udgift.afgrænsning,
    beløb_kroner = hvis koordinering.samordning_gyldig && udgift.afgrænsning == SelvstændigErhvervsindkomstUdgift && personskat_ll9g_selvstændig_udgift_sidestillet_med_lønmodtagerudgift(koordinering.fiskerfradrag.input, virksomhedsidentifikation, udgift.identifikation) && ligningslov9g_kilde_afskåret(
        koordinering.fiskerfradrag,
        Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation = virksomhedsidentifikation, kildeidentifikation = udgift.identifikation)
    ) { 0 } ellers { udgift.beløb_kroner }
)
| personskat_ll9g_virksomhed_anvendt(virksomhed: PersonskatOrdinærVirksomhedFakta, koordinering: PersonskatLigningslov9GKoordinering) -> PersonskatOrdinærVirksomhedFakta(
    identifikation = virksomhed.identifikation,
    indkomstår = virksomhed.indkomstår,
    indtægter = virksomhed.indtægter,
    udgifter = map(
        virksomhed.udgifter,
        |udgift: PersonskatVirksomhedsudgiftFakta| personskat_ll9g_virksomhedsudgift_anvendt(virksomhed.identifikation, udgift, koordinering)
    )
)
| personskat_ll9g_personlig_indkomst_input(input: PersonskatPersonligIndkomstInput, koordinering: PersonskatLigningslov9GKoordinering) -> PersonskatPersonligIndkomstInput(
    etableringskonto = input.etableringskonto,
    ordinære_forhold = PersonskatOrdinærPersonligIndkomstInput(
        arbejdsgiverydelser = input.ordinære_forhold.arbejdsgiverydelser,
        virksomheder_uden_virksomhedsordning = map(
            input.ordinære_forhold.virksomheder_uden_virksomhedsordning,
            |virksomhed: PersonskatOrdinærVirksomhedFakta| personskat_ll9g_virksomhed_anvendt(virksomhed, koordinering)
        ),
        forenings_og_arbejdsløshedsydelser = input.ordinære_forhold.forenings_og_arbejdsløshedsydelser
    ),
    sømandsbeskatning = input.sømandsbeskatning
)
| personskat_ll9g_befordringsforhold_bevares(forhold: PersonskatBefordringsfradragFakta, koordinering: PersonskatLigningslov9GKoordinering) -> forhold.befordringsformål != IndtægtsgivendeArbejdsplads || personskat_ll9g_kilde_bevares(
    koordinering,
    Ll9GLigningslov9COg9DBefordringsforhold(kildeidentifikation = forhold.identifikation)
)
| personskat_ll9g_befordringsfradrag_input(input: PersonskatBefordringsfradragInput, koordinering: PersonskatLigningslov9GKoordinering) -> PersonskatBefordringsfradragInput(
    forhold = filter(
        input.forhold,
        |forhold: PersonskatBefordringsfradragFakta| personskat_ll9g_befordringsforhold_bevares(forhold, koordinering)
    )
)
| personskat_ll9g_erhvervsbefordring_fradrag_anvendt_kroner(resultat: PersonskatErhvervsbefordringResultat, koordinering: PersonskatLigningslov9GKoordinering) -> foldl(
    resultat.sagsresultater,
    0,
    |sum_kroner: Heltal, sag: PersonskatErhvervsbefordringSagResultat| sum_kroner + hvis personskat_ll9g_kilde_bevares(
        koordinering,
        Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation = personskat_erhvervsbefordring_sag_identifikation(sag))
    ) { personskat_erhvervsbefordring_sag_fradrag_i_personlig_indkomst_kroner(sag) } ellers { 0 }
)
| personskat_ll9g_pbl49_stk1_fradrag_anvendt_kroner(resultat: Pbl49Til49BÅrsresultat, koordinering: PersonskatLigningslov9GKoordinering) -> foldl(
    resultat.bidragsresultater,
    0,
    |sum_kroner: Heltal, bidrag: Pbl49Til49BBidragsresultat| sum_kroner + hvis bidrag.hjemmel == Pbl49Arbejdsløshedsforsikringsfradrag && personskat_ll9g_kilde_bevares(
        koordinering,
        Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = bidrag.fakta.identifikation)
    ) { bidrag.fradrag_kroner } ellers { 0 }
)
| personskat_ll9g_rejsefradrag_før_årsloft_kroner(resultat: Ligningslov9AÅrsresultat, koordinering: PersonskatLigningslov9GKoordinering) -> foldl(
    resultat.rejseresultater,
    0,
    |sum_kroner: Heltal, rejse: Ligningslov9ARejseresultat| sum_kroner + hvis personskat_ll9g_kilde_bevares(
        koordinering,
        Ll9GLigningslov9ARejse(kildeidentifikation = rejse.fakta.identifikation)
    ) { rejse.fradrag_før_årsloft_kroner } ellers { 0 }
)
| personskat_ll9g_ølogifradrag_før_årsloft_kroner(resultat: Ligningslov9AÅrsresultat, koordinering: PersonskatLigningslov9GKoordinering) -> foldl(
    resultat.ølogi.arbejdsforholdsresultater,
    0,
    |arbejdsforholdssum_kroner: Heltal, arbejdsforhold: Ligningslov9AØlogiArbejdsforholdsresultat| arbejdsforholdssum_kroner + foldl(
        arbejdsforhold.opholdsresultater,
        0,
        |opholdssum_kroner: Heltal, ophold: Ligningslov9AØlogiopholdsresultat| opholdssum_kroner + hvis personskat_ll9g_kilde_bevares(
            koordinering,
            Ll9GLigningslov9AØlogiophold(kildeidentifikation = ophold.fakta.identifikation)
        ) { ophold.fradrag_før_fælles_årsloft_kroner } ellers { 0 }
    )
)
| personskat_ll9g_rejsefradrag_resultat(resultat: Ligningslov9AÅrsresultat, koordinering: PersonskatLigningslov9GKoordinering) -> {
    = input_gyldigt = resultat.alle_input_gyldige && koordinering.samordning_gyldig
    = rejsefradrag_før_årsloft_kroner = hvis input_gyldigt { personskat_ll9g_rejsefradrag_før_årsloft_kroner(resultat, koordinering) } ellers { 0 }
    = tilgængeligt_rejsefradragsloft_kroner = penge_positivt_beløb(resultat.årligt_fælles_fradragsloft_kroner - resultat.dobbelt_husførelse_efter_fælles_loft_kroner)
    = rejsefradrag_efter_årsloft_kroner = hvis input_gyldigt { penge_mindste_beløb(rejsefradrag_før_årsloft_kroner, tilgængeligt_rejsefradragsloft_kroner) } ellers { 0 }
    = ølogifradrag_før_årsloft_kroner = hvis input_gyldigt { personskat_ll9g_ølogifradrag_før_årsloft_kroner(resultat, koordinering) } ellers { 0 }
    = tilgængeligt_ølogiloft_kroner = penge_positivt_beløb(tilgængeligt_rejsefradragsloft_kroner - rejsefradrag_efter_årsloft_kroner)
    = ølogifradrag_efter_årsloft_kroner = hvis input_gyldigt { penge_mindste_beløb(ølogifradrag_før_årsloft_kroner, tilgængeligt_ølogiloft_kroner) } ellers { 0 }
    PersonskatLigningslov9GRejsefradrag(
        rejsefradrag_før_årsloft_kroner = rejsefradrag_før_årsloft_kroner,
        rejsefradrag_efter_årsloft_kroner = rejsefradrag_efter_årsloft_kroner,
        ølogifradrag_før_årsloft_kroner = ølogifradrag_før_årsloft_kroner,
        ølogifradrag_efter_årsloft_kroner = ølogifradrag_efter_årsloft_kroner,
        samlet_ll9a_fradrag_efter_årsloft_kroner = rejsefradrag_efter_årsloft_kroner + ølogifradrag_efter_årsloft_kroner
    )
}
| personskat_ll9c_skatteår_understøttet(skatteår: Heltal) -> skatteår == 2025 || skatteår == 2026
| personskat_ll9d_grundfakta_gyldige(input: Ligningslov9DInput) -> input.billigste_offentlige_befordring_kroner >= 0 && input.befordringsudgifter.årlige_kilometer_egen_befordring >= 0 && input.befordringsudgifter.dokumenteret_faktisk_udgift_kroner >= 0
| personskat_ll9d_input_gyldigt(input: PersonskatLigningslov9DInput, skatteår: Heltal) -> match input {
    | UdenLigningslov9D -> Sandt
    | MedLigningslov9D(ll9d_input) -> skatteår == 2026 && ll9d_input.skatteår == skatteår && personskat_ll9d_grundfakta_gyldige(ll9d_input)
}
| personskat_ll9d_resultat(input: PersonskatLigningslov9DInput, skatteår: Heltal) -> match input {
    | UdenLigningslov9D -> ll9d_ikke_omfattet_resultat_for(skatteår)
    | MedLigningslov9D(ll9d_input) -> hvis personskat_ll9d_input_gyldigt(input, skatteår) { ll9d_resultat(ll9d_input) } ellers { ll9d_ikke_omfattet_resultat_for(skatteår) }
}
| personskat_befordringsgrundfakta_gyldige(fakta: PersonskatBefordringsfradragFakta) -> fakta.identifikation != "" && fakta.befordringsmål_identifikation != "" && fakta.arbejdsdage >= 0 && fakta.arbejdsdage <= 366 && fakta.daglige_befordringskilometer >= 0 && fakta.broer.storebælt_bil_motorcykel_passager >= 0 && fakta.broer.storebælt_kollektiv_passager >= 0 && fakta.broer.øresund_bil_motorcykel_passager >= 0 && fakta.særlig_transport.faktisk_dokumenteret_udgift_kroner >= 0
| personskat_befordringsidentifikationer_entydige(input: PersonskatBefordringsfradragInput) -> length(distinct(map(input.forhold, |forhold: PersonskatBefordringsfradragFakta| forhold.identifikation))) == length(input.forhold) && all(input.forhold, |forhold: PersonskatBefordringsfradragFakta| forhold.identifikation != "")
| personskat_arbejdsgiverbetalt_befordring_for_hele_strækningen(input: PersonskatArbejdsgiverbetaltBefordring) -> input != UdenArbejdsgiverbetaltBefordring
| personskat_arbejdsgiverbetalt_befordring_am_bidragspligtig(input: PersonskatArbejdsgiverbetaltBefordring) -> input == ArbejdsgiverbetaltBilTilRådighedForHeleStrækningen
| personskat_ll9c_aftrapningsindkomst_før_fri_befordring_kroner(input: PersonskatLønmodtagerInput, skattepligtige_godtgørelser_kroner: Heltal, personlig_indkomst: PersonskatPersonligIndkomstResultat) -> input.bruttoløn_kroner + skattepligtige_godtgørelser_kroner + personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner
| personskat_ll9c_input(fakta: PersonskatBefordringsfradragFakta, lønmodtager: PersonskatLønmodtagerInput, aftrapningsindkomst_kroner: Heltal, ligningslov9d_resultat: Ligningslov9DResultat) -> Ligningslov9CInput(
    skatteår = lønmodtager.skatteår,
    arbejdsdage = fakta.arbejdsdage,
    daglige_befordringskilometer = fakta.daglige_befordringskilometer,
    bopæl_i_yderkommune_eller_lille_ø = fakta.bopæl_i_yderkommune_eller_lille_ø,
    aftrapningsindkomst_kroner = aftrapningsindkomst_kroner,
    befordringsformål = fakta.befordringsformål,
    modtaget_skattefri_befordringsgodtgørelse_for_strækning = fakta.modtaget_skattefri_befordringsgodtgørelse_for_strækning,
    modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = fakta.modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning,
    par9d = ligningslov9d_resultat,
    fradrag_udelukket_folketingshverv_m_v = fakta.fradrag_udelukket_folketingshverv_m_v,
    fri_befordring_betalt_af_arbejdsgiver_for_hele_strækningen = personskat_arbejdsgiverbetalt_befordring_for_hele_strækningen(fakta.arbejdsgiverbetalt_befordring),
    broer = fakta.broer,
    særlig_transport = fakta.særlig_transport
)
| personskat_befordringsfradragsforhold_resultat(fakta: PersonskatBefordringsfradragFakta, lønmodtager: PersonskatLønmodtagerInput, aftrapningsindkomst_kroner: Heltal) -> {
    = skatteår_understøttet = personskat_ll9c_skatteår_understøttet(lønmodtager.skatteår)
    = grundfakta_gyldige = personskat_befordringsgrundfakta_gyldige(fakta)
    = ligningslov9d_input_gyldigt = personskat_ll9d_input_gyldigt(fakta.ligningslov9d, lønmodtager.skatteår)
    hvis skatteår_understøttet && grundfakta_gyldige && ligningslov9d_input_gyldigt {
        = ligningslov9d_resultat = personskat_ll9d_resultat(fakta.ligningslov9d, lønmodtager.skatteår)
        = ligningslov9c_input = personskat_ll9c_input(fakta, lønmodtager, aftrapningsindkomst_kroner, ligningslov9d_resultat)
        BeregnetBefordringsfradragsforhold(
            fakta = fakta,
            ligningslov9d_resultat = ligningslov9d_resultat,
            ligningslov9c_input = ligningslov9c_input,
            ligningslov9c_resultat = ll9c_befordringsfradrag_resultat(ligningslov9c_input)
        )
    } ellers {
        UgyldigtBefordringsfradragsforhold(
            fakta = fakta,
            skatteår_understøttet = skatteår_understøttet,
            grundfakta_gyldige = grundfakta_gyldige,
            ligningslov9d_input_gyldigt = ligningslov9d_input_gyldigt
        )
    }
}
| personskat_befordringsfradragsforhold_input_gyldigt(resultat: PersonskatBefordringsfradragForholdsresultat) -> match resultat {
    | UgyldigtBefordringsfradragsforhold(_, _, _, _) -> Falskt
    | BeregnetBefordringsfradragsforhold(_, _, _, _) -> Sandt
}
| personskat_befordringsfradragsforhold_par9d_kroner(resultat: PersonskatBefordringsfradragForholdsresultat) -> match resultat {
    | BeregnetBefordringsfradragsforhold(_, ligningslov9d_resultat, _, _) -> ligningslov9d_resultat.fradrag_kroner
    | UgyldigtBefordringsfradragsforhold(_, _, _, _) -> 0
}
| personskat_befordringsfradragsforhold_par9c_grundfradrag_kroner(resultat: PersonskatBefordringsfradragForholdsresultat) -> match resultat {
    | BeregnetBefordringsfradragsforhold(_, _, _, ligningslov9c_resultat) -> ligningslov9c_resultat.grundfradrag_før_lavindkomsttillæg_kroner
    | UgyldigtBefordringsfradragsforhold(_, _, _, _) -> 0
}
| personskat_befordringsfradragsforhold_lavindkomstgrundlag_kroner(resultat: PersonskatBefordringsfradragForholdsresultat) -> match resultat {
    | BeregnetBefordringsfradragsforhold(_, _, _, ligningslov9c_resultat) -> hvis ligningslov9c_resultat.berettiget_til_ordinært_fradrag { ligningslov9c_resultat.grundfradrag_før_lavindkomsttillæg_kroner } ellers { 0 }
    | UgyldigtBefordringsfradragsforhold(_, _, _, _) -> 0
}
| personskat_befordringsfradragsforhold_personlig_indkomst_kroner(resultat: PersonskatBefordringsfradragForholdsresultat) -> match resultat {
    | BeregnetBefordringsfradragsforhold(_, _, _, ligningslov9c_resultat) -> ligningslov9c_resultat.fri_befordring_skattepligtig_værdi_kroner
    | UgyldigtBefordringsfradragsforhold(_, _, _, _) -> 0
}
| personskat_befordringsfradragsforhold_am_bidragspligtig_personlig_indkomst_kroner(resultat: PersonskatBefordringsfradragForholdsresultat) -> match resultat {
    | BeregnetBefordringsfradragsforhold(fakta, _, _, ligningslov9c_resultat) -> hvis personskat_arbejdsgiverbetalt_befordring_am_bidragspligtig(fakta.arbejdsgiverbetalt_befordring) { ligningslov9c_resultat.fri_befordring_skattepligtig_værdi_kroner } ellers { 0 }
    | UgyldigtBefordringsfradragsforhold(_, _, _, _) -> 0
}
| personskat_befordringsfradrag_resultat(input: PersonskatBefordringsfradragInput, lønmodtager: PersonskatLønmodtagerInput, skattepligtige_godtgørelser_kroner: Heltal, personlig_indkomst: PersonskatPersonligIndkomstResultat) -> {
    = skatteår_understøttet = personskat_ll9c_skatteår_understøttet(lønmodtager.skatteår)
    = identifikationer_entydige = personskat_befordringsidentifikationer_entydige(input)
    = aftrapningsindkomst_før_fri_befordring_kroner = personskat_ll9c_aftrapningsindkomst_før_fri_befordring_kroner(input = lønmodtager, skattepligtige_godtgørelser_kroner = skattepligtige_godtgørelser_kroner, personlig_indkomst = personlig_indkomst)
    = foreløbige_forholdsresultater = map(input.forhold, |forhold: PersonskatBefordringsfradragFakta| personskat_befordringsfradragsforhold_resultat(forhold, lønmodtager, aftrapningsindkomst_før_fri_befordring_kroner))
    = foreløbig_am_bidragspligtig_personlig_indkomst_kroner = foldl(foreløbige_forholdsresultater, 0, |sum_kroner: Heltal, resultat: PersonskatBefordringsfradragForholdsresultat| sum_kroner + personskat_befordringsfradragsforhold_am_bidragspligtig_personlig_indkomst_kroner(resultat))
    = aftrapningsindkomst_kroner = aftrapningsindkomst_før_fri_befordring_kroner + foreløbig_am_bidragspligtig_personlig_indkomst_kroner
    = forholdsresultater = map(input.forhold, |forhold: PersonskatBefordringsfradragFakta| personskat_befordringsfradragsforhold_resultat(forhold, lønmodtager, aftrapningsindkomst_kroner))
    = alle_input_gyldige = skatteår_understøttet && identifikationer_entydige && all(forholdsresultater, personskat_befordringsfradragsforhold_input_gyldigt)
    = samlet_par9d_fradrag_kroner = hvis alle_input_gyldige { foldl(forholdsresultater, 0, |sum_kroner: Heltal, resultat: PersonskatBefordringsfradragForholdsresultat| sum_kroner + personskat_befordringsfradragsforhold_par9d_kroner(resultat)) } ellers { 0 }
    = samlet_par9c_grundfradrag_kroner = hvis alle_input_gyldige { foldl(forholdsresultater, 0, |sum_kroner: Heltal, resultat: PersonskatBefordringsfradragForholdsresultat| sum_kroner + personskat_befordringsfradragsforhold_par9c_grundfradrag_kroner(resultat)) } ellers { 0 }
    = lavindkomstgrundlag_kroner = hvis alle_input_gyldige { foldl(forholdsresultater, 0, |sum_kroner: Heltal, resultat: PersonskatBefordringsfradragForholdsresultat| sum_kroner + personskat_befordringsfradragsforhold_lavindkomstgrundlag_kroner(resultat)) } ellers { 0 }
    = lavindkomsttillæg_kroner = hvis alle_input_gyldige { ll9c_lavindkomst_tillæg_for_årsgrundlag_kroner(lønmodtager.skatteår, aftrapningsindkomst_kroner, lavindkomstgrundlag_kroner) } ellers { 0 }
    = personlig_indkomst_kroner = hvis alle_input_gyldige { foldl(forholdsresultater, 0, |sum_kroner: Heltal, resultat: PersonskatBefordringsfradragForholdsresultat| sum_kroner + personskat_befordringsfradragsforhold_personlig_indkomst_kroner(resultat)) } ellers { 0 }
    = arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner = hvis alle_input_gyldige { foldl(forholdsresultater, 0, |sum_kroner: Heltal, resultat: PersonskatBefordringsfradragForholdsresultat| sum_kroner + personskat_befordringsfradragsforhold_am_bidragspligtig_personlig_indkomst_kroner(resultat)) } ellers { 0 }
    PersonskatBefordringsfradragResultat(
        input = input,
        forholdsresultater = forholdsresultater,
        skatteår_understøttet = skatteår_understøttet,
        identifikationer_entydige = identifikationer_entydige,
        alle_input_gyldige = alle_input_gyldige,
        aftrapningsindkomst_kroner = aftrapningsindkomst_kroner,
        samlet_par9d_fradrag_kroner = samlet_par9d_fradrag_kroner,
        samlet_par9c_grundfradrag_kroner = samlet_par9c_grundfradrag_kroner,
        lavindkomstgrundlag_kroner = lavindkomstgrundlag_kroner,
        lavindkomsttillæg_kroner = lavindkomsttillæg_kroner,
        samlet_ligningsfradrag_kroner = samlet_par9d_fradrag_kroner + samlet_par9c_grundfradrag_kroner + lavindkomsttillæg_kroner,
        personlig_indkomst_kroner = personlig_indkomst_kroner,
        arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner = arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner
    )
}
| personskat_befordringsfradrag_input_gyldigt(resultat: PersonskatBefordringsfradragResultat) -> resultat.alle_input_gyldige
| personskat_befordringsfradrag_kroner(resultat: PersonskatBefordringsfradragResultat) -> resultat.samlet_ligningsfradrag_kroner
| personskat_befordring_personlig_indkomst_kroner(resultat: PersonskatBefordringsfradragResultat) -> resultat.personlig_indkomst_kroner
| personskat_befordring_arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner(resultat: PersonskatBefordringsfradragResultat) -> resultat.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner
| personskat_pbl49_stk1_fradrag_kroner(resultat: Pbl49Til49BÅrsresultat) -> foldl(resultat.bidragsresultater, 0, |sum_kroner: Heltal, bidrag: Pbl49Til49BBidragsresultat| sum_kroner + hvis bidrag.hjemmel == Pbl49Arbejdsløshedsforsikringsfradrag { bidrag.fradrag_kroner } ellers { 0 })
| personskat_pbl49a_og_49b_fradrag_kroner(resultat: Pbl49Til49BÅrsresultat) -> foldl(resultat.bidragsresultater, 0, |sum_kroner: Heltal, bidrag: Pbl49Til49BBidragsresultat| sum_kroner + hvis bidrag.hjemmel == Pbl49AEfterlønsfradrag || bidrag.hjemmel == Pbl49BFleksydelsesfradrag { bidrag.fradrag_kroner } ellers { 0 })
| personskat_søbl4_lønmodtagerudgiftskilde(resultat: Ligningslov9Stk1Udgiftsresultat) -> Søbl4Ligningslov9Stk1Lønmodtagerudgift(kildeidentifikation = resultat.fakta.identifikation)
| personskat_søbl4_lønmodtagerudgift_har_omfattet_beløb(resultat: Ligningslov9Stk1Udgiftsresultat) -> resultat.fradragsgrundlag_før_bundgrænse_kroner > 0
| personskat_søbl4_erhvervsbefordringskilde(resultat: PersonskatErhvervsbefordringSagResultat) -> Søbl4Ligningslov9BErhvervsbefordring(kildeidentifikation = personskat_erhvervsbefordring_sag_identifikation(resultat = resultat))
| personskat_søbl4_erhvervsbefordring_har_omfattet_beløb(resultat: PersonskatErhvervsbefordringSagResultat) -> personskat_erhvervsbefordring_sag_skattefri_godtgørelse_kroner(resultat = resultat) > 0 || personskat_erhvervsbefordring_sag_fradrag_i_personlig_indkomst_kroner(resultat = resultat) > 0
| personskat_søbl4_pbl49_kilde(resultat: Pbl49Til49BBidragsresultat) -> Søbl4Pensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = resultat.fakta.identifikation)
| personskat_søbl4_pbl49_stk1_kildetype(resultat: Pbl49Til49BBidragsresultat) -> match resultat.fakta.art {
    | Pbl49Akassekontingent(_, _) -> Sandt
    | Pbl49PrivatArbejdsløshedsforsikring(_, _) -> Sandt
    | Pbl49Seniormedlemskontingent(_, _) -> Sandt
    | _ -> Falskt
}
| personskat_søbl4_pbl49_stk1_har_omfattet_beløb(resultat: Pbl49Til49BBidragsresultat) -> resultat.hjemmel == Pbl49Arbejdsløshedsforsikringsfradrag && resultat.fradrag_kroner > 0
| personskat_søbl4_befordringskilde_findes(resultat: PersonskatBefordringsfradragResultat) -> length(resultat.input.forhold) > 0
| personskat_søbl4_påkrævede_kilder(lønmodtagerudgifter: Ligningslov9Stk1Årsresultat, erhvervsbefordring: PersonskatErhvervsbefordringResultat, befordring: PersonskatBefordringsfradragResultat, faglige_kontingenter: Ligningslov13Årsresultat, arbejdsløshed_efterløn_og_fleksydelse: Pbl49Til49BÅrsresultat) -> {
    = lønmodtagerudgiftskilder = flat_map(lønmodtagerudgifter.udgiftsresultater, |resultat: Ligningslov9Stk1Udgiftsresultat| hvis personskat_søbl4_lønmodtagerudgift_har_omfattet_beløb(resultat = resultat) { [personskat_søbl4_lønmodtagerudgiftskilde(resultat = resultat)] } ellers { [] })
    = erhvervsbefordringskilder = flat_map(erhvervsbefordring.sagsresultater, |resultat: PersonskatErhvervsbefordringSagResultat| hvis personskat_søbl4_erhvervsbefordring_har_omfattet_beløb(resultat = resultat) { [personskat_søbl4_erhvervsbefordringskilde(resultat = resultat)] } ellers { [] })
    = befordringskilder = hvis personskat_befordringsfradrag_kroner(resultat = befordring) > 0 { [Søbl4Ligningslov9COg9DBefordringsfradrag] } ellers { [] }
    = kontingentkilder = hvis faglige_kontingenter.samlet_fradrag_kroner > 0 { [Søbl4Ligningslov13Årsfradrag] } ellers { [] }
    = pbl49kilder = flat_map(arbejdsløshed_efterløn_og_fleksydelse.bidragsresultater, |resultat: Pbl49Til49BBidragsresultat| hvis personskat_søbl4_pbl49_stk1_har_omfattet_beløb(resultat = resultat) { [personskat_søbl4_pbl49_kilde(resultat = resultat)] } ellers { [] })
    concat(lønmodtagerudgiftskilder, concat(concat(erhvervsbefordringskilder, befordringskilder), concat(kontingentkilder, pbl49kilder)))
}
| personskat_søbl4_kildetilknytninger_for(input: Sømandsbeskatningslov4Årsinput, kilde: Sømandsbeskatningslov4Fradragskilde) -> filter(input.kildetilknytninger, |tilknytning: Sømandsbeskatningslov4Kildetilknytning| tilknytning.kilde == kilde)
| personskat_søbl4_kildetilknytning(input: Sømandsbeskatningslov4Årsinput, kilde: Sømandsbeskatningslov4Fradragskilde) -> find(input.kildetilknytninger, |tilknytning: Sømandsbeskatningslov4Kildetilknytning| tilknytning.kilde == kilde)
| personskat_søbl4_kilder_entydige(input: Sømandsbeskatningslov4Årsinput) -> length(distinct(map(input.kildetilknytninger, |tilknytning: Sømandsbeskatningslov4Kildetilknytning| tilknytning.kilde))) == length(input.kildetilknytninger)
| personskat_søbl4_kilde_findes(kilde: Sømandsbeskatningslov4Fradragskilde, lønmodtagerudgifter: Ligningslov9Stk1Årsresultat, erhvervsbefordring: PersonskatErhvervsbefordringResultat, befordring: PersonskatBefordringsfradragResultat, faglige_kontingenter: Ligningslov13Årsresultat, arbejdsløshed_efterløn_og_fleksydelse: Pbl49Til49BÅrsresultat) -> match kilde {
