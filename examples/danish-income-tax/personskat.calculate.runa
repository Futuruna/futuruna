| personskat_ligningsfradrag_resultat(input: PersonskatLigningsfradragInput, lønmodtager: PersonskatLønmodtagerInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, personlig_indkomst: PersonskatPersonligIndkomstResultat, ligningslov12_indkomstgrundlag: Ligningslov12Indkomstgrundlag) -> {
    = fiskerfradragssamordning = personskat_ll9g_koordinering(lønmodtager)
    = sømandsfradrag = sømandsbeskatningslov3_årsresultat(indkomstår = lønmodtager.skatteår, input = input.sømandsfradrag)
