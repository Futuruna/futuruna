    question = Some("Har lejligheden tjent til bolig for ejeren eller husstanden i en del af den ejerperiode, hvor skattefrihedsbetingelserne var opfyldt?"),
    help = Some("Feltet kræver tidsmæssigt overlap mellem boligbrug og den periode, hvor værdipapiret kunne afstås skattefrit efter EBL § 8, stk. 4."),
    unit = None
)
= personskat_felt_aktie_boligret_grundforhold = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.fakta.grundforhold.$variant",
    label = "Grundareal knyttet til lejligheden",
    question = Some("Hører der et bestemt grundareal til lejligheden?"),
    help = Some("Hvis et bestemt grundareal hører til lejligheden, skal grundbetingelsen i EBL § 8, stk. 1, også prøves."),
    unit = None
)
= personskat_felt_aktie_boligret_grundbetingelse = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.fakta.grundforhold.EblPar8Stk4MedBestemtGrundareal.grundbetingelse",
    label = "Grundbetingelse efter EBL § 8",
    question = Some("Hvilken grundbetingelse er opfyldt for det bestemte grundareal?"),
    help = Some("Vælg under 1.400 m², manglende udstykningsmulighed, værdiforringelse over 20 pct. eller at ingen betingelse er opfyldt."),
    unit = None
)
= personskat_felt_aktie_boligret_afståelsesform = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.afståelsesform.$variant",
    label = "Afståelsesform for boligret",
    question = Some("Er værdipapiret afstået almindeligt eller som likvidationsprovenu?"),
    help = Some("Likvidationsprovenu er kun skattefrit efter ABL § 15, stk. 2, når det udloddes i selskabets endelige opløsningsår."),
    unit = None
)
= personskat_felt_aktie_boligret_endeligt_opløsningsår = Beregningsfelt(
    path = "aktieavance.ordinært_aktieår.MedOrdinærtAktieår.input.hændelsesforløb.hændelser.AblOrdinærAfståelse.vilkår.boligret.AblBoligretEfterPar15.afståelsesform.AblPar15Likvidationsprovenu.udloddet_i_endeligt_opløsningsår",
    label = "Udloddet i endeligt opløsningsår",
    question = Some("Blev likvidationsprovenuet udloddet i det kalenderår, hvor selskabet endeligt blev opløst?"),
    help = Some("Et nej betyder, at gevinst eller tab fortsætter gennem de almindelige regler i aktieavancebeskatningsloven."),
    unit = None
)

