# Beregningsbeløbsfelt(path: Tekst, label: Tekst, question: Tekst, unit: Tekst)

= personskat_felt_skatteår = Beregningsfelt(
    path = "lønmodtager.skatteår",
    label = "Skatteår",
    question = Some("Hvilket indkomstår skal skatten beregnes for?"),
    help = Some("Satser, beløbsgrænser og lovregler afhænger af skatteåret."),
    unit = Some("år")
)
= personskat_felt_kommune = Beregningsfelt(
    path = "lønmodtager.kommune",
    label = "Bopælskommune",
    question = Some("Hvilken kommune bor du i?"),
    help = Some("Kommunen bestemmer kommuneskatten og er relevant for kirkeskatten."),
    unit = None
)
= personskat_felt_bruttoløn = Beregningsfelt(
    path = "lønmodtager.bruttoløn_kroner",
    label = "Årlig bruttoløn",
    question = Some("Hvor meget modtager du i almindelig løn før skat i hele indkomståret, bortset fra kørselsgodtgørelse oplyst særskilt efter § 9 B?"),
    help = Some("Angiv lønnen før arbejdsmarkedsbidrag, skat og personlige fradrag. Medtag ikke godtgørelse, som oplyses i grenen for erhvervsmæssig kørsel; Futuruna udleder selv den skattepligtige løndel."),
    unit = Some("kr./år")
)
= personskat_felt_erhvervsbefordring = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager",
    label = "Erhvervsmæssige kørsler (§ 9 B)",
    question = Some("Har du haft erhvervsmæssig kørsel, som skal behandles efter ligningslovens § 9 B?"),
    help = Some("Tilføj de identificerede kørsels- og afregningsforløb i kronologisk rækkefølge. Futuruna udleder selv årets tidligere kilometer pr. godtgørende arbejdsgiver."),
    unit = None
)
= personskat_felt_erhvervsbefordring_identifikation = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager.identifikation",
    label = "Kørselssag",
    question = Some("Hvilken entydig identifikation skal denne kørselssag have?"),
    help = Some("Brug en stabil identifikation, så sagen og dens juridiske resultat kan spores særskilt fra andre kørsler."),
    unit = None
)
= personskat_felt_erhvervsbefordring_rækkefølge = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager.rækkefølge_i_indkomståret",
    label = "Rækkefølge i indkomståret",
    question = Some("Hvilket nummer har kørsels- eller afregningsforløbet i årets kronologiske rækkefølge?"),
    help = Some("Nummerér forløbene 1, 2, 3 og så videre uden huller. Rækkefølgen gør det muligt at udlede 20.000-kilometergrænsen uden at bede om allerede summerede kilometer."),
    unit = None
)
= personskat_felt_erhvervsbefordring_arbejdsgiver_identifikation = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager.godtgørende_arbejdsgiver_identifikation",
    label = "Godtgørende arbejdsgiver",
    question = Some("Hvilken arbejdsgiver har udbetalt kørselsgodtgørelsen i denne sag?"),
    help = Some("Arbejdsgiverens identifikation skal udfyldes, når der er udbetalt godtgørelse, fordi 20.000-kilometergrænsen opgøres pr. arbejdsgiver."),
    unit = None
)
= personskat_felt_erhvervsbefordring_køretøj = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager.køretøj",
    label = "Køretøj til erhvervskørsel",
    question = Some("Hvilket køretøj blev brugt til den erhvervsmæssige kørsel?"),
    help = Some("Skatterådets kilometersats afhænger af, om der er brugt egen bil, motorcykel eller et mindre køretøj."),
    unit = None
)
= personskat_felt_erhvervsbefordring_art = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager.befordring.art",
    label = "Type af erhvervsmæssig kørsel",
    question = Some("Foregik kørslen mellem hjem og arbejdsplads, mellem arbejdspladser eller inden for samme arbejdsplads?"),
    help = Some("60-dages-reglen gælder kun kørsel mellem den sædvanlige bopæl og samme arbejdsplads."),
    unit = None
)
= personskat_felt_erhvervsbefordring_kilometer = Beregningsfelt(
    path = "lønmodtager.erhvervsbefordring.sager.befordring.kilometer_i_sagen",
