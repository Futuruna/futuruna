--@label:beregn_personskat::field:personskat_felt_aktie_boligret_afståelsesform::source:aktieavancebeskatningsloven_lbk1098_par12_til_par15::dependency_source:ebl_par8_par9_lbk132--
--@label:beregn_personskat::field:personskat_felt_aktie_boligret_endeligt_opløsningsår::source:aktieavancebeskatningsloven_lbk1098_par12_til_par15::dependency_source:ebl_par8_par9_lbk132--

| personskat_supplerende_skatteforhold(forhold: PersonskatSupplerendeSkatteforhold) -> LønmodtagerSkatteforhold(
    aktieindkomst_kroner = forhold.øvrig_aktieindkomst_kroner,
    ægtefælle_aktieindkomst_kroner = forhold.ægtefælle_aktieindkomst_kroner,
    aktieindkomst_ægtefæller_samlevende_ved_årets_udløb = forhold.aktieindkomst_ægtefæller_samlevende_ved_årets_udløb,
    ægtefælle_nettokapitalindkomst_kroner = forhold.ægtefælle_nettokapitalindkomst_kroner,
    kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb = forhold.kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb,
    cfc_indkomst_kroner = forhold.cfc_indkomst_kroner,
    par8c_status = forhold.par8c_status,
    personfradrag_skattepligt = forhold.personfradrag_skattepligt,
    personfradrag_valg_dato_yyyymmdd = forhold.personfradrag_valg_dato_yyyymmdd,
    personfradrag_omvalg_dato_yyyymmdd = forhold.personfradrag_omvalg_dato_yyyymmdd
)
| personskat_angivne_skatteforhold(input: PersonskatSkatteforholdInput) -> match input {
    | StandardSkatteforhold -> lønmodtager_standard_skatteforhold()
    | SærligeSkatteforhold(forhold) -> personskat_supplerende_skatteforhold(forhold)
}
| personskat_underskudsforhold(input: PersonskatUnderskudsforholdInput) -> match input {
    | StandardUnderskudsforhold -> lønmodtager_par13_standard_forhold()
    | SærligeUnderskudsforhold(forhold) -> forhold
}

| personskat_ingen_erhvervsbefordring() -> PersonskatErhvervsbefordringInput(sager = [])
| personskat_ll9b_skatteår_understøttet(skatteår: Heltal) -> skatteår == 2026
| personskat_erhvervsbefordring_grundfakta_gyldige(fakta: PersonskatErhvervsbefordringFakta) -> fakta.identifikation != "" && fakta.rækkefølge_i_indkomståret > 0 && (fakta.godtgørelsesforhold.udbetalt_godtgørelse_kroner == 0 || fakta.godtgørende_arbejdsgiver_identifikation != "") && fakta.befordring.kilometer_i_sagen >= 0 && fakta.befordring.tres_dages_forhold.arbejdsdage_til_samme_arbejdsplads_inklusive_aktuel_dag_i_forudgående_12_måneder >= 0 && fakta.befordring.tres_dages_forhold.arbejdsdage_til_samme_arbejdsplads_inklusive_aktuel_dag_i_forudgående_12_måneder <= 366 && fakta.befordring.tres_dages_forhold.sammenhængende_arbejdsdage_siden_sidst_på_arbejdspladsen >= 0 && fakta.udgifter.dokumenterede_faktiske_kørselsudgifter_eksklusive_bro_tunnel_kroner >= 0 && fakta.udgifter.dokumenterede_bro_tunnel_udgifter_kroner >= 0 && fakta.antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang >= 0 && fakta.godtgørelsesforhold.udbetalt_godtgørelse_kroner >= 0
| personskat_erhvervsbefordring_sager_med_identifikation(sager: List(PersonskatErhvervsbefordringFakta), identifikation: Tekst) -> filter(sager, |fakta: PersonskatErhvervsbefordringFakta| fakta.identifikation == identifikation)
| personskat_erhvervsbefordring_identifikationer_entydige(input: PersonskatErhvervsbefordringInput) -> all(input.sager, |fakta: PersonskatErhvervsbefordringFakta| length(personskat_erhvervsbefordring_sager_med_identifikation(input.sager, fakta.identifikation)) == 1)
| personskat_ll9b_input(fakta: PersonskatErhvervsbefordringFakta, kilometerhistorik: Ligningslov9BKilometerhistorik, skatteår: Heltal) -> Ligningslov9BInput(
    indkomstår = skatteår,
    køretøj = fakta.køretøj,
    befordring = Ligningslov9BBefordring(
        art = fakta.befordring.art,
        kilometer_i_sagen = fakta.befordring.kilometer_i_sagen,
        kilometerhistorik = kilometerhistorik,
        tres_dages_forhold = fakta.befordring.tres_dages_forhold
    ),
    udgifter = fakta.udgifter,
    fradragsforhold = Ligningslov9BFradragsforhold(
        personrolle = Ll9BLønmodtager,
        metode = Ll9BSkatteraadetsKilometersatser,
        kundeopsøgende_aktivitet = fakta.kundeopsøgende_aktivitet,
        antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang = fakta.antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang
    ),
    godtgørelsesforhold = fakta.godtgørelsesforhold
)
| personskat_erhvervsbefordring_sagsresultat(fakta: PersonskatErhvervsbefordringFakta, kilometerhistorik: Ligningslov9BKilometerhistorik, skatteår: Heltal) -> {
    = skatteår_understøttet = personskat_ll9b_skatteår_understøttet(skatteår)
    = grundfakta_gyldige = personskat_erhvervsbefordring_grundfakta_gyldige(fakta)
    hvis skatteår_understøttet && grundfakta_gyldige {
        = ll9b_input = personskat_ll9b_input(fakta, kilometerhistorik, skatteår)
        = ll9b_resultat = ligningslov9b_resultat(ll9b_input)
        BeregnetErhvervsbefordringEfterLigningslov9B(
            fakta = fakta,
            ligningslov9b_input = ll9b_input,
            ligningslov9b_resultat = ll9b_resultat,
            par3_stk2_nr8_resultat = par3_stk2_nr8_resultat(ll9b_resultat)
        )
    } ellers {
        UgyldigtErhvervsbefordringsgrundlag(
            fakta = fakta,
            skatteår_understøttet = skatteår_understøttet,
            grundfakta_gyldige = grundfakta_gyldige
        )
    }
}
| personskat_erhvervsbefordring_sagsresultat_gyldigt(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | UgyldigtErhvervsbefordringsgrundlag(_, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_erhvervsbefordring_sag_skattefri_godtgørelse_kroner(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, ligningslov9b_resultat, _) -> ligningslov9b_resultat.skattefri_godtgørelse_kroner
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_skattepligtig_godtgørelse_kroner(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, ligningslov9b_resultat, _) -> ligningslov9b_resultat.godtgørelse_personlig_indkomst_kroner
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_fradrag_i_personlig_indkomst_kroner(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, _, par3_stk2_nr8_resultat) -> par3_stk2_nr8_resultat.fradrag_i_personlig_indkomst_kroner
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_bil_motorcykelkilometer(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, ligningslov9b_input, ligningslov9b_resultat, _) -> hvis ligningslov9b_input.køretøj == Ll9BEgenBil || ligningslov9b_input.køretøj == Ll9BEgenMotorcykel { ligningslov9b_resultat.erhvervsmæssige_kilometer } ellers { 0 }
    | _ -> 0
}
| personskat_erhvervsbefordring_sag_bil_motorcykelkilometer_til_direkte_fradrag(resultat: PersonskatErhvervsbefordringSagResultat) -> match resultat {
    | BeregnetErhvervsbefordringEfterLigningslov9B(_, _, ligningslov9b_resultat, _) -> hvis ligningslov9b_resultat.direkte_fradragsberettiget_efter_par9b { personskat_erhvervsbefordring_sag_bil_motorcykelkilometer(resultat) } ellers { 0 }
    | _ -> 0
}

# PersonskatErhvervsbefordringForløbstrinSag(tilstand: PersonskatErhvervsbefordringForløbstilstand, fakta: PersonskatErhvervsbefordringFakta, skatteår: Heltal) {
    | tidligere_godtgørelseskilometer() -> map_get_or(tilstand.historik.bil_motorcykelkilometer_pr_arbejdsgiver, fakta.godtgørende_arbejdsgiver_identifikation, 0)
    | kilometerhistorik() -> Ligningslov9BKilometerhistorik(
        tidligere_erhvervsmæssige_kilometer_hos_godtgørende_arbejdsgiver_i_indkomståret = tidligere_godtgørelseskilometer(),
        tidligere_erhvervsmæssige_kilometer_til_direkte_fradrag_i_indkomståret = tilstand.historik.bil_motorcykelkilometer_til_direkte_fradrag
    )
    | sagsresultat() -> personskat_erhvervsbefordring_sagsresultat(fakta, kilometerhistorik(), skatteår)
    | bil_motorcykelkilometer_pr_arbejdsgiver_efter() -> tilstand.historik.bil_motorcykelkilometer_pr_arbejdsgiver
    | exception bil_motorcykelkilometer_føjes_til_arbejdsgiverhistorik bil_motorcykelkilometer_pr_arbejdsgiver_efter() -> map_insert(
        tilstand.historik.bil_motorcykelkilometer_pr_arbejdsgiver,
        fakta.godtgørende_arbejdsgiver_identifikation,
        tidligere_godtgørelseskilometer() + personskat_erhvervsbefordring_sag_bil_motorcykelkilometer(sagsresultat())
    ) under fakta.godtgørende_arbejdsgiver_identifikation != "" && personskat_erhvervsbefordring_sagsresultat_gyldigt(sagsresultat())
    | bil_motorcykelkilometer_til_direkte_fradrag_efter() -> tilstand.historik.bil_motorcykelkilometer_til_direkte_fradrag + personskat_erhvervsbefordring_sag_bil_motorcykelkilometer_til_direkte_fradrag(sagsresultat())
    | rækkefølge_gyldig() -> tilstand.rækkefølge_gyldig && fakta.rækkefølge_i_indkomståret == tilstand.næste_rækkefølge_i_indkomståret
    | resultat() -> PersonskatErhvervsbefordringForløbstilstand(
        næste_rækkefølge_i_indkomståret = tilstand.næste_rækkefølge_i_indkomståret + 1,
        historik = PersonskatErhvervsbefordringÅrshistorik(
            bil_motorcykelkilometer_pr_arbejdsgiver = bil_motorcykelkilometer_pr_arbejdsgiver_efter(),
            bil_motorcykelkilometer_til_direkte_fradrag = bil_motorcykelkilometer_til_direkte_fradrag_efter()
        ),
        sagsresultater = concat(tilstand.sagsresultater, [sagsresultat()]),
        rækkefølge_gyldig = rækkefølge_gyldig()
    )
}

| personskat_erhvervsbefordring_forløbstrin(tilstand: PersonskatErhvervsbefordringForløbstilstand, fakta: PersonskatErhvervsbefordringFakta, skatteår: Heltal) -> PersonskatErhvervsbefordringForløbstrinSag(tilstand, fakta, skatteår).resultat()
| personskat_erhvervsbefordring_forløb(input: PersonskatErhvervsbefordringInput, skatteår: Heltal) -> foldl(input.sager, PersonskatErhvervsbefordringForløbstilstand(
    næste_rækkefølge_i_indkomståret = 1,
    historik = PersonskatErhvervsbefordringÅrshistorik(
        bil_motorcykelkilometer_pr_arbejdsgiver = map_new(),
        bil_motorcykelkilometer_til_direkte_fradrag = 0
    ),
    sagsresultater = [],
    rækkefølge_gyldig = Sandt
    ), |tilstand: PersonskatErhvervsbefordringForløbstilstand, fakta: PersonskatErhvervsbefordringFakta| personskat_erhvervsbefordring_forløbstrin(tilstand, fakta, skatteår))
| personskat_erhvervsbefordring_skattefri_godtgørelse_før_validering_kroner(resultater: List(PersonskatErhvervsbefordringSagResultat)) -> foldl(resultater, 0, |sum: Heltal, resultat: PersonskatErhvervsbefordringSagResultat| sum + personskat_erhvervsbefordring_sag_skattefri_godtgørelse_kroner(resultat))
| personskat_erhvervsbefordring_skattepligtig_godtgørelse_før_validering_kroner(resultater: List(PersonskatErhvervsbefordringSagResultat)) -> foldl(resultater, 0, |sum: Heltal, resultat: PersonskatErhvervsbefordringSagResultat| sum + personskat_erhvervsbefordring_sag_skattepligtig_godtgørelse_kroner(resultat))
| personskat_erhvervsbefordring_fradrag_før_validering_kroner(resultater: List(PersonskatErhvervsbefordringSagResultat)) -> foldl(resultater, 0, |sum: Heltal, resultat: PersonskatErhvervsbefordringSagResultat| sum + personskat_erhvervsbefordring_sag_fradrag_i_personlig_indkomst_kroner(resultat))
| personskat_erhvervsbefordring_resultat(input: PersonskatErhvervsbefordringInput, skatteår: Heltal) -> {
    = forløb = personskat_erhvervsbefordring_forløb(input, skatteår)
    = sagsresultater = forløb.sagsresultater
    = identifikationer_entydige = personskat_erhvervsbefordring_identifikationer_entydige(input)
    = alle_input_gyldige = identifikationer_entydige && forløb.rækkefølge_gyldig && all(sagsresultater, personskat_erhvervsbefordring_sagsresultat_gyldigt)
    PersonskatErhvervsbefordringResultat(
        input = input,
        sagsresultater = sagsresultater,
        identifikationer_entydige = identifikationer_entydige,
        rækkefølge_gyldig = forløb.rækkefølge_gyldig,
        historik_ultimo = forløb.historik,
        alle_input_gyldige = alle_input_gyldige,
        samlet_skattefri_godtgørelse_kroner = hvis alle_input_gyldige { personskat_erhvervsbefordring_skattefri_godtgørelse_før_validering_kroner(sagsresultater) } ellers { 0 },
        samlet_skattepligtig_godtgørelse_kroner = hvis alle_input_gyldige { personskat_erhvervsbefordring_skattepligtig_godtgørelse_før_validering_kroner(sagsresultater) } ellers { 0 },
        samlet_fradrag_i_personlig_indkomst_kroner = hvis alle_input_gyldige { personskat_erhvervsbefordring_fradrag_før_validering_kroner(sagsresultater) } ellers { 0 }
    )
}
| personskat_erhvervsbefordring_input_gyldigt(resultat: PersonskatErhvervsbefordringResultat) -> resultat.alle_input_gyldige
| personskat_erhvervsbefordring_skattepligtig_løn_kroner(resultat: PersonskatErhvervsbefordringResultat) -> resultat.samlet_skattepligtig_godtgørelse_kroner
| personskat_erhvervsbefordring_fradrag_i_personlig_indkomst_kroner(resultat: PersonskatErhvervsbefordringResultat) -> resultat.samlet_fradrag_i_personlig_indkomst_kroner

| personskat_ingen_ligningsfradrag() -> PersonskatLigningsfradragInput(
    befordring = UdenBefordringsfradrag
)
| personskat_ll9c_skatteår_understøttet(skatteår: Heltal) -> skatteår == 2025 || skatteår == 2026
| personskat_ll9d_grundfakta_gyldige(input: Ligningslov9DInput) -> input.billigste_offentlige_befordring_kroner >= 0 && input.befordringsudgifter.årlige_kilometer_egen_befordring >= 0 && input.befordringsudgifter.dokumenteret_faktisk_udgift_kroner >= 0
| personskat_ll9d_input_gyldigt(input: PersonskatLigningslov9DInput, skatteår: Heltal) -> match input {
    | UdenLigningslov9D -> Sandt
    | MedLigningslov9D(ll9d_input) -> skatteår == 2026 && ll9d_input.skatteår == skatteår && personskat_ll9d_grundfakta_gyldige(ll9d_input)
}
| personskat_ll9d_resultat(input: PersonskatLigningslov9DInput, skatteår: Heltal) -> match input {
    | UdenLigningslov9D -> ll9d_ikke_omfattet_resultat_for(skatteår)
    | MedLigningslov9D(ll9d_input) -> hvis personskat_ll9d_input_gyldigt(input, skatteår) { ll9d_resultat(ll9d_input) } ellers { ll9d_ikke_omfattet_resultat_for(skatteår) }
}
| personskat_befordringsgrundfakta_gyldige(fakta: PersonskatBefordringsfradragFakta) -> fakta.arbejdsdage >= 0 && fakta.arbejdsdage <= 366 && fakta.daglige_befordringskilometer >= 0 && fakta.broer.storebælt_bil_motorcykel_passager >= 0 && fakta.broer.storebælt_kollektiv_passager >= 0 && fakta.broer.øresund_bil_motorcykel_passager >= 0 && fakta.broer.øresund_kollektiv_passager >= 0 && fakta.særlig_transport.faktisk_dokumenteret_udgift_kroner >= 0
| personskat_ll9c_aftrapningsindkomst_kroner(input: PersonskatLønmodtagerInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat) -> input.bruttoløn_kroner + personskat_erhvervsbefordring_skattepligtig_løn_kroner(erhvervsbefordring)
| personskat_ll9c_input(fakta: PersonskatBefordringsfradragFakta, lønmodtager: PersonskatLønmodtagerInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningslov9d_resultat: Ligningslov9DResultat) -> Ligningslov9CInput(
    skatteår = lønmodtager.skatteår,
    arbejdsdage = fakta.arbejdsdage,
    daglige_befordringskilometer = fakta.daglige_befordringskilometer,
    bopæl_i_yderkommune_eller_lille_ø = fakta.bopæl_i_yderkommune_eller_lille_ø,
    aftrapningsindkomst_kroner = personskat_ll9c_aftrapningsindkomst_kroner(lønmodtager, erhvervsbefordring),
    befordringsformål = fakta.befordringsformål,
    modtaget_skattefri_befordringsgodtgørelse_for_strækning = fakta.modtaget_skattefri_befordringsgodtgørelse_for_strækning,
    modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = fakta.modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning,
    par9d = ligningslov9d_resultat,
    fradrag_udelukket_folketingshverv_m_v = fakta.fradrag_udelukket_folketingshverv_m_v,
    fri_befordring_betalt_af_arbejdsgiver_for_hele_strækningen = fakta.fri_befordring_betalt_af_arbejdsgiver_for_hele_strækningen,
    broer = fakta.broer,
    særlig_transport = fakta.særlig_transport
)
| personskat_befordringsfradrag_resultat(input: PersonskatBefordringsfradragInput, lønmodtager: PersonskatLønmodtagerInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat) -> match input {
    | UdenBefordringsfradrag -> IntetBefordringsfradrag
    | MedBefordringsfradrag(fakta) -> {
        = skatteår_understøttet = personskat_ll9c_skatteår_understøttet(lønmodtager.skatteår)
        = grundfakta_gyldige = personskat_befordringsgrundfakta_gyldige(fakta)
        = ligningslov9d_input_gyldigt = personskat_ll9d_input_gyldigt(fakta.ligningslov9d, lønmodtager.skatteår)
        hvis skatteår_understøttet && grundfakta_gyldige && ligningslov9d_input_gyldigt {
            = ligningslov9d_resultat = personskat_ll9d_resultat(fakta.ligningslov9d, lønmodtager.skatteår)
            = ligningslov9c_input = personskat_ll9c_input(fakta, lønmodtager, erhvervsbefordring, ligningslov9d_resultat)
            = ligningslov9c_resultat = ll9c_befordringsfradrag_resultat(ligningslov9c_input)
            BeregnetBefordringsfradrag(
                fakta = fakta,
                ligningslov9d_resultat = ligningslov9d_resultat,
                ligningslov9c_input = ligningslov9c_input,
                ligningslov9c_resultat = ligningslov9c_resultat,
                samlet_ligningsfradrag_kroner = ligningslov9d_resultat.fradrag_kroner + ligningslov9c_resultat.samlet_befordringsfradrag_kroner,
                personlig_indkomst_kroner = ligningslov9c_resultat.fri_befordring_skattepligtig_værdi_kroner
            )
        } ellers {
            UgyldigtBefordringsfradrag(
                fakta = fakta,
                skatteår_understøttet = skatteår_understøttet,
                grundfakta_gyldige = grundfakta_gyldige,
                ligningslov9d_input_gyldigt = ligningslov9d_input_gyldigt
            )
        }
    }
}
| personskat_befordringsfradrag_input_gyldigt(resultat: PersonskatBefordringsfradragResultat) -> match resultat {
    | UgyldigtBefordringsfradrag(_, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_befordringsfradrag_kroner(resultat: PersonskatBefordringsfradragResultat) -> match resultat {
    | BeregnetBefordringsfradrag(_, _, _, _, samlet_ligningsfradrag_kroner, _) -> samlet_ligningsfradrag_kroner
    | _ -> 0
}
| personskat_befordring_personlig_indkomst_kroner(resultat: PersonskatBefordringsfradragResultat) -> match resultat {
    | BeregnetBefordringsfradrag(_, _, _, _, _, personlig_indkomst_kroner) -> personlig_indkomst_kroner
    | _ -> 0
}
| personskat_ligningsfradrag_resultat(input: PersonskatLigningsfradragInput, lønmodtager: PersonskatLønmodtagerInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat) -> {
    = befordring = personskat_befordringsfradrag_resultat(input.befordring, lønmodtager, erhvervsbefordring)
    PersonskatLigningsfradragResultat(
        input = input,
        befordring = befordring,
        alle_input_gyldige = personskat_befordringsfradrag_input_gyldigt(befordring),
        samlet_ligningsfradrag_kroner = personskat_befordringsfradrag_kroner(befordring),
        personlig_indkomst_kroner = personskat_befordring_personlig_indkomst_kroner(befordring)
    )
}

| personskat_kapital_reklassifikation(næringsstatus: Næringsstatus) -> IngenPersonligReklassifikation
| exception personskat_par4_stk3_fordrings_eller_kontraktnæring personskat_kapital_reklassifikation(næringsstatus: Næringsstatus) -> FordringsEllerKontraktNæringReklassifikation under næringsstatus == FordringsEllerKontraktNæring
| exception personskat_par4_stk3_finansieringsnæring personskat_kapital_reklassifikation(næringsstatus: Næringsstatus) -> FinansieringsNæringReklassifikation under næringsstatus == FinansieringsNæring
| personskat_ligningslov6_input_gyldigt(input: PersonskatLigningslov6Input, skatteår: Heltal) -> match input {
    | UdenLigningslov6Kurstab -> Sandt
    | MedLigningslov6Kurstab(ll6_input) -> ll6_input.indkomstår == skatteår && ligningslov6_kurstab_input_gyldigt(ll6_input)
}
| personskat_ligningslov6_resultat(input: PersonskatLigningslov6Input, skatteår: Heltal) -> match input {
    | UdenLigningslov6Kurstab -> ligningslov6_intet_kurstab_resultat(skatteår)
    | MedLigningslov6Kurstab(ll6_input) -> ligningslov6_kurstab_resultat(ll6_input)
}
| personskat_ligningslov6_resultat_anvendt(input: PersonskatLigningslov6Input, skatteår: Heltal) -> hvis personskat_ligningslov6_input_gyldigt(input, skatteår) { personskat_ligningslov6_resultat(input, skatteår) } ellers { ligningslov6_intet_kurstab_resultat(skatteår) }
| personskat_ligningslov6a_input_gyldigt(input: PersonskatLigningslov6AInput, skatteår: Heltal) -> match input {
    | UdenLigningslov6AFradrag -> Sandt
    | MedLigningslov6AFradrag(ll6a_input) -> ll6a_input.indkomstår == skatteår && ligningslov6a_input_gyldigt(ll6a_input)
}
| personskat_ligningslov6a_resultat(input: PersonskatLigningslov6AInput, skatteår: Heltal) -> match input {
    | UdenLigningslov6AFradrag -> ligningslov6a_intet_fradrag_resultat(skatteår)
    | MedLigningslov6AFradrag(ll6a_input) -> ligningslov6a_resultat(ll6a_input)
}
| personskat_ligningslov6a_resultat_anvendt(input: PersonskatLigningslov6AInput, skatteår: Heltal) -> hvis personskat_ligningslov6a_input_gyldigt(input, skatteår) { personskat_ligningslov6a_resultat(input, skatteår) } ellers { ligningslov6a_intet_fradrag_resultat(skatteår) }
| personskat_ejendomsavance_fremførsel_gyldig(fremførsel: PersonskatEjendomsavanceFremførsel, skatteår: Heltal) -> match fremførsel {
    | UdenFremførtEjendomstab -> Sandt
    | MedFremførtEjendomstab(fra_indkomstår, tab_kroner) -> fra_indkomstår + 1 == skatteår && tab_kroner >= 0
}
| personskat_ejendomsavance_fremførsel(fremførsel: PersonskatEjendomsavanceFremførsel) -> match fremførsel {
    | UdenFremførtEjendomstab -> EblIngenFremførsel
    | MedFremførtEjendomstab(fra_indkomstår, tab_kroner) -> EblFremførtTabFraForrigeIndkomstår(fra_indkomstår = fra_indkomstår, tab_kroner = tab_kroner)
}
| personskat_ejendomsavance_input(fakta: PersonskatEjendomsavanceFakta) -> EjendomsavancebeskatningslovInput(
    indkomstår = fakta.afståelsesdato.år,
    afståelsesdato = fakta.afståelsesdato,
    afståelse = fakta.afståelse,
    erhvervet_som_led_i_næring = fakta.erhvervet_som_led_i_næring,
    kontant_anskaffelsessum_kroner = fakta.kontant_anskaffelsessum_kroner,
    gæld_kursværdi_ved_anskaffelse_kroner = fakta.gæld_kursværdi_ved_anskaffelse_kroner,
    par5_fakta = fakta.par5_fakta,
    par4_stk8_anskaffelse_udeladt_kroner = fakta.par4_stk8_anskaffelse_udeladt_kroner,
    kontant_afståelsessum_kroner = fakta.kontant_afståelsessum_kroner,
    overdragne_gældsposter_kursværdi_kroner = fakta.overdragne_gældsposter_kursværdi_kroner,
    par4_stk8_afståelsesværdi_udeladt_kroner = fakta.par4_stk8_afståelsesværdi_udeladt_kroner,
    ejendomstype = fakta.ejendomstype,
    par11_stk2_valg = fakta.par11_stk2_valg,
    par6d_valg = fakta.par6d_valg
)
| personskat_ejendomsavance_afståelsesresultat(fakta: PersonskatEjendomsavanceFakta) -> ejendomsavancebeskatningslov_resultat(personskat_ejendomsavance_input(fakta))
| personskat_ejendomsavance_afståelsesresultater(afståelser: List(PersonskatEjendomsavanceFakta)) -> map(afståelser, personskat_ejendomsavance_afståelsesresultat)
| personskat_ejendomsavance_identifikation_unik(afståelser: List(PersonskatEjendomsavanceFakta), fakta: PersonskatEjendomsavanceFakta) -> length(filter(afståelser, |anden: PersonskatEjendomsavanceFakta| anden.identifikation == fakta.identifikation)) == 1
| personskat_ejendomsavance_grundfakta_gyldige(afståelser: List(PersonskatEjendomsavanceFakta), fakta: PersonskatEjendomsavanceFakta, resultat: EjendomsavancebeskatningslovResultat, skatteår: Heltal) -> fakta.identifikation != "" && personskat_ejendomsavance_identifikation_unik(afståelser, fakta) && fakta.afståelsesdato.år <= skatteår && resultat.input_gyldigt
| personskat_ejendomsavance_afståelser_grundfakta_gyldige(afståelser: List(PersonskatEjendomsavanceFakta), skatteår: Heltal) -> all(afståelser, |fakta: PersonskatEjendomsavanceFakta| personskat_ejendomsavance_grundfakta_gyldige(afståelser, fakta, personskat_ejendomsavance_afståelsesresultat(fakta), skatteår))
| personskat_ejendomsavance_fortjenesteafgrænsning_understøttet(fakta: PersonskatEjendomsavanceFakta, resultat: EjendomsavancebeskatningslovResultat) -> resultat.regelgrundlag_understøttet && (resultat.omfattet_af_loven || fakta.erhvervet_som_led_i_næring)
| personskat_ejendomsavance_afståelser_fortjenesteafgrænsninger_understøttet(afståelser: List(PersonskatEjendomsavanceFakta)) -> all(afståelser, |fakta: PersonskatEjendomsavanceFakta| personskat_ejendomsavance_fortjenesteafgrænsning_understøttet(fakta, personskat_ejendomsavance_afståelsesresultat(fakta)))
| personskat_ejendomsavance_tabspost_fra_resultat(resultat: EjendomsavancebeskatningslovResultat) -> EjendomsavancePar6Tabspost(resultat = resultat)
| personskat_ejendomsavance_tabspost(fakta: PersonskatEjendomsavanceFakta) -> personskat_ejendomsavance_tabspost_fra_resultat(personskat_ejendomsavance_afståelsesresultat(fakta))
| personskat_ejendomsavance_tabsposter(afståelser: List(PersonskatEjendomsavanceFakta)) -> map(afståelser, personskat_ejendomsavance_tabspost)
| personskat_ejendomsavance_tabsposter_fra_resultater(resultater: List(EjendomsavancebeskatningslovResultat)) -> map(resultater, personskat_ejendomsavance_tabspost_fra_resultat)
| personskat_ejendomsavance_tabsårsgrundlag(afståelser: List(PersonskatEjendomsavanceFakta), fremførsel: PersonskatEjendomsavanceFremførsel, skatteår: Heltal) -> EjendomsavancePar6Tabsårsgrundlag(
    indkomstår = skatteår,
    tabsposter = personskat_ejendomsavance_tabsposter(afståelser),
    fortjenestegrundlag = EblPar6FortjenesterFraResultater(resultater = personskat_ejendomsavance_afståelsesresultater(afståelser)),
    fremførsel = personskat_ejendomsavance_fremførsel(fremførsel)
)
| personskat_ejendomsavance_fordelt_tabsårsgrundlag(resultater: List(EjendomsavancebeskatningslovResultat), fremførsel: PersonskatEjendomsavanceFremførsel, skatteår: Heltal, fordelt_fortjeneste_kroner: Heltal) -> EjendomsavancePar6Tabsårsgrundlag(
    indkomstår = skatteår,
    tabsposter = personskat_ejendomsavance_tabsposter_fra_resultater(resultater),
    fortjenestegrundlag = EblPar6FordeltFortjenesteKroner(beløb_kroner = fordelt_fortjeneste_kroner),
    fremførsel = personskat_ejendomsavance_fremførsel(fremførsel)
)
| personskat_ejendomsavance_ægtefælledata_relevant(fakta: PersonskatEjendomsavanceÅrsfakta) -> fakta.gift_samlevende_ved_indkomstårets_udgang || (length(fakta.ægtefælles_afståelser) == 0 && fakta.ægtefælles_fremførte_tab == UdenFremførtEjendomstab)
| personskat_ejendomsavance_resultat(input: PersonskatEjendomsavanceInput, skatteår: Heltal) -> match input {
    | UdenEjendomsavance -> IngenEjendomsavance
    | MedEjendomsavance(fakta) -> {
        = egne_grundfakta_gyldige = personskat_ejendomsavance_afståelser_grundfakta_gyldige(fakta.egne_afståelser, skatteår)
        = ægtefælles_grundfakta_gyldige = personskat_ejendomsavance_afståelser_grundfakta_gyldige(fakta.ægtefælles_afståelser, skatteår)
        = grundfakta_gyldige = skatteår > 0 && egne_grundfakta_gyldige && ægtefælles_grundfakta_gyldige
        = egne_fortjenesteafgrænsninger_understøttet = personskat_ejendomsavance_afståelser_fortjenesteafgrænsninger_understøttet(fakta.egne_afståelser)
        = ægtefælles_fortjenesteafgrænsninger_understøttet = personskat_ejendomsavance_afståelser_fortjenesteafgrænsninger_understøttet(fakta.ægtefælles_afståelser)
        = fortjenesteafgrænsninger_understøttet = egne_fortjenesteafgrænsninger_understøttet && ægtefælles_fortjenesteafgrænsninger_understøttet
        = egne_årsforløb_dækker_skatteår = ejendomsavance_par6_resultater_dækker_indkomstår(personskat_ejendomsavance_afståelsesresultater(fakta.egne_afståelser), skatteår)
        = ægtefælles_årsforløb_dækker_skatteår = ejendomsavance_par6_resultater_dækker_indkomstår(personskat_ejendomsavance_afståelsesresultater(fakta.ægtefælles_afståelser), skatteår)
        = årsforløb_dækker_skatteår = egne_årsforløb_dækker_skatteår && ægtefælles_årsforløb_dækker_skatteår
        = fremførsler_gyldige = personskat_ejendomsavance_fremførsel_gyldig(fakta.eget_fremført_tab, skatteår) && personskat_ejendomsavance_fremførsel_gyldig(fakta.ægtefælles_fremførte_tab, skatteår)
        = ægtefælledata_relevant = personskat_ejendomsavance_ægtefælledata_relevant(fakta)
        hvis grundfakta_gyldige && fortjenesteafgrænsninger_understøttet && årsforløb_dækker_skatteår && fremførsler_gyldige && ægtefælledata_relevant {
            = egne_afståelsesresultater = personskat_ejendomsavance_afståelsesresultater(fakta.egne_afståelser)
            = ægtefælles_afståelsesresultater = personskat_ejendomsavance_afståelsesresultater(fakta.ægtefælles_afståelser)
            = ægtefællepar_resultat = ejendomsavance_par6_ægtefællepar_resultat(EjendomsavancePar6ÆgtefælleparInput(
                venstre = personskat_ejendomsavance_tabsårsgrundlag(fakta.egne_afståelser, fakta.eget_fremført_tab, skatteår),
                højre = personskat_ejendomsavance_tabsårsgrundlag(fakta.ægtefælles_afståelser, fakta.ægtefælles_fremførte_tab, skatteår),
                gift_samlevende_ved_indkomstårets_udgang = fakta.gift_samlevende_ved_indkomstårets_udgang
            ))
            = eget_tabsårsresultat = ægtefællepar_resultat.venstre
            = ægtefælles_tabsårsresultat = ægtefællepar_resultat.højre
            = par4_resultat = par4_stk1_nr14_årsresultat(Par4Stk1Nr14Årsinput(
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat
            ))
            BeregnetEjendomsavance(
                fakta = fakta,
                egne_afståelsesresultater = egne_afståelsesresultater,
                ægtefælles_afståelsesresultater = ægtefælles_afståelsesresultater,
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat,
                par4_resultat = par4_resultat
            )
        } ellers {
            UgyldigtEjendomsavancegrundlag(
                fakta = fakta,
                grundfakta_gyldige = grundfakta_gyldige,
                fortjenesteafgrænsninger_understøttet = fortjenesteafgrænsninger_understøttet,
                årsforløb_dækker_skatteår = årsforløb_dækker_skatteår,
                fremførsler_gyldige = fremførsler_gyldige,
                ægtefælledata_relevant = ægtefælledata_relevant
            )
        }
    }
}
| personskat_ejendomsavance_input_gyldigt(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | UgyldigtEjendomsavancegrundlag(_, _, _, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_ejendomsavance_kapitalposter(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, _, _, _, _, par4_resultat) -> [par4_stk1_nr14_års_kapitalpost(par4_resultat)]
    | _ -> []
}
| personskat_egne_ejendomsavance_resultater(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, egne_afståelsesresultater, _, _, _, _) -> egne_afståelsesresultater
    | _ -> []
}
| personskat_ægtefælles_ejendomsavance_resultater(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, _, ægtefælles_afståelsesresultater, _, _, _) -> ægtefælles_afståelsesresultater
    | _ -> []
}
| personskat_alle_ejendomsavance_resultater(resultat: PersonskatEjendomsavanceResultat) -> concat(personskat_egne_ejendomsavance_resultater(resultat), personskat_ægtefælles_ejendomsavance_resultater(resultat))
| personskat_ejendomsavance_har_par6d_sælgerpantebrev(resultat: EjendomsavancebeskatningslovResultat) -> match resultat.par6d_resultat.valg {
    | EblMedPar6DValg(_) -> Sandt
    | EblUdenPar6DValg -> Falskt
}
| personskat_egne_par6d_sælgerpantebrevsresultater(resultat: PersonskatEjendomsavanceResultat) -> filter(personskat_egne_ejendomsavance_resultater(resultat), personskat_ejendomsavance_har_par6d_sælgerpantebrev)
| personskat_alle_par6d_sælgerpantebrevsresultater(resultat: PersonskatEjendomsavanceResultat) -> filter(personskat_alle_ejendomsavance_resultater(resultat), personskat_ejendomsavance_har_par6d_sælgerpantebrev)
| personskat_kgl_fakta_matcher_par6d_resultat(fakta: KglEblPar6DSælgerpantebrevsfakta, resultat: EjendomsavancebeskatningslovResultat) -> fakta.sælgerpantebrev_identifikation != "" && fakta.sælgerpantebrev_identifikation == kgl_ebl_par6d_sælgerpantebrev(resultat.par6d_resultat).identifikation
| personskat_kgl_matchende_par6d_resultater(fakta: KglEblPar6DSælgerpantebrevsfakta, resultater: List(EjendomsavancebeskatningslovResultat)) -> filter(resultater, |resultat: EjendomsavancebeskatningslovResultat| personskat_kgl_fakta_matcher_par6d_resultat(fakta, resultat))
| personskat_kgl_matchende_fakta(resultat: EjendomsavancebeskatningslovResultat, fakta: List(KglEblPar6DSælgerpantebrevsfakta)) -> filter(fakta, |pantebrevsfakta: KglEblPar6DSælgerpantebrevsfakta| personskat_kgl_fakta_matcher_par6d_resultat(pantebrevsfakta, resultat))
| personskat_kgl_alle_fakta_matcher_entydigt(fakta: List(KglEblPar6DSælgerpantebrevsfakta), resultater: List(EjendomsavancebeskatningslovResultat)) -> all(fakta, |pantebrevsfakta: KglEblPar6DSælgerpantebrevsfakta| length(personskat_kgl_matchende_par6d_resultater(pantebrevsfakta, resultater)) == 1)
| personskat_kgl_alle_par6d_resultater_matcher_entydigt(resultater: List(EjendomsavancebeskatningslovResultat), fakta: List(KglEblPar6DSælgerpantebrevsfakta)) -> all(resultater, |resultat: EjendomsavancebeskatningslovResultat| length(personskat_kgl_matchende_fakta(resultat, fakta)) == 1)
| personskat_kgl_sælgerpantebrevsresultater(fakta: List(KglEblPar6DSælgerpantebrevsfakta), resultater: List(EjendomsavancebeskatningslovResultat)) -> flat_map(fakta, |pantebrevsfakta: KglEblPar6DSælgerpantebrevsfakta| map(personskat_kgl_matchende_par6d_resultater(pantebrevsfakta, resultater), |resultat: EjendomsavancebeskatningslovResultat| kgl_ebl_par6d_resultat(pantebrevsfakta, resultat.par6d_resultat)))
| personskat_kgl_rå_netto_i_indkomstår_kroner(resultat: KglEblPar6DSælgerpantebrevsresultat, skatteår: Heltal, skatteyder_identifikation: Tekst) -> kgl_sælgerpantebrev_rå_netto_for_skatteyder_i_indkomstår_kroner(resultat.kursgevinstresultat, skatteår, skatteyder_identifikation)
| personskat_kgl_årets_samlede_netto_kroner(resultater: List(KglEblPar6DSælgerpantebrevsresultat), skatteår: Heltal, skatteyder_identifikation: Tekst, øvrigt_netto_kroner: Heltal) -> foldl(resultater, øvrigt_netto_kroner, |sum: Heltal, resultat: KglEblPar6DSælgerpantebrevsresultat| sum + personskat_kgl_rå_netto_i_indkomstår_kroner(resultat, skatteår, skatteyder_identifikation))
| personskat_kgl_resultater_i_indkomstår(resultat: KglEblPar6DSælgerpantebrevsresultat, skatteår: Heltal, skatteyder_identifikation: Tekst, årets_samlede_netto_kroner: Heltal) -> map(kgl_sælgerpantebrev_personrealiseringer_for_skatteyder_i_indkomstår(resultat.kursgevinstresultat, skatteår, skatteyder_identifikation), |disposition: KglSælgerpantebrevDispositionsresultat| kgl_sælgerpantebrev_kursgevinstlov_resultat(disposition, årets_samlede_netto_kroner, resultat.skatteforhold))
| personskat_kgl_alle_resultater_i_indkomstår(resultater: List(KglEblPar6DSælgerpantebrevsresultat), skatteår: Heltal, skatteyder_identifikation: Tekst, årets_samlede_netto_kroner: Heltal) -> flat_map(resultater, |resultat: KglEblPar6DSælgerpantebrevsresultat| personskat_kgl_resultater_i_indkomstår(resultat, skatteår, skatteyder_identifikation, årets_samlede_netto_kroner))
| personskat_kgl_kapitalpost(resultat: KursgevinstlovResultat) -> par4_stk1_nr2_kapitalpost(Par4Stk1Nr2Input(kursgevinstlov_resultat = resultat))
| personskat_kgl_fortjenestemedregninger(resultater: List(KglEblPar6DSælgerpantebrevsresultat)) -> flat_map(resultater, |resultat: KglEblPar6DSælgerpantebrevsresultat| resultat.fortjenestemedregninger)
| personskat_kgl_fortjenestemedregning_tilhører_beregning(medregning: KglEblPar6DFortjenestemedregning, skatteyder_identifikation: Tekst, ægtefælles_skatteyder_identifikation: Tekst) -> medregning.skatteyder.rolle != KglPersonEfterKildeskatteloven || medregning.skatteyder.identifikation == skatteyder_identifikation || (ægtefælles_skatteyder_identifikation != "" && medregning.skatteyder.identifikation == ægtefælles_skatteyder_identifikation)

# PersonskatKursgevinstSag(input: PersonskatKursgevinstInput, skatteår: Heltal, ejendomsavance_resultat: PersonskatEjendomsavanceResultat) {
    | par6d_resultater() -> personskat_alle_par6d_sælgerpantebrevsresultater(ejendomsavance_resultat)
    | sælgerpantebrevsfakta() -> match input {
        | UdenKursgevinst -> []
        | MedKursgevinst(fakta) -> fakta.sælgerpantebreve
    }
    | øvrigt_netto_kroner() -> match input {
        | UdenKursgevinst -> 0
        | MedKursgevinst(fakta) -> fakta.øvrigt_netto_fordringer_valutagæld_og_obligationsbaserede_investeringsbeviser_kroner
    }
    | skatteyder_identifikation() -> match input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> fakta.skatteyder_identifikation
    }
    | ægtefælles_skatteyder_identifikation() -> match input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> match fakta.ægtefælles_skatteyder_identifikation {
            | Some(identifikation) -> identifikation
            | None -> ""
        }
    }
    | inputvariant_matcher_ebl() -> match input {
        | UdenKursgevinst -> length(par6d_resultater()) == 0
        | MedKursgevinst(_) -> length(sælgerpantebrevsfakta()) > 0 && personskat_kgl_alle_fakta_matcher_entydigt(sælgerpantebrevsfakta(), par6d_resultater()) && personskat_kgl_alle_par6d_resultater_matcher_entydigt(par6d_resultater(), sælgerpantebrevsfakta())
    }
    | sælgerpantebrevsresultater() -> personskat_kgl_sælgerpantebrevsresultater(sælgerpantebrevsfakta(), par6d_resultater())
    | alle_sælgerpantebrevsresultater_gyldige() -> all(sælgerpantebrevsresultater(), |resultat: KglEblPar6DSælgerpantebrevsresultat| resultat.input_gyldigt)
    | skatteyderidentifikationer_gyldige() -> skatteyder_identifikation() != "" && (ægtefælles_skatteyder_identifikation() == "" || ægtefælles_skatteyder_identifikation() != skatteyder_identifikation())
    | fortjenestefordeling_dækker_beregning() -> all(personskat_kgl_fortjenestemedregninger(sælgerpantebrevsresultater()), |medregning: KglEblPar6DFortjenestemedregning| personskat_kgl_fortjenestemedregning_tilhører_beregning(medregning, skatteyder_identifikation(), ægtefælles_skatteyder_identifikation()))
    | input_gyldigt() -> skatteår > 0 && inputvariant_matcher_ebl() && match input { | UdenKursgevinst -> Sandt | MedKursgevinst(_) -> skatteyderidentifikationer_gyldige() } && alle_sælgerpantebrevsresultater_gyldige() && fortjenestefordeling_dækker_beregning()
    | årets_samlede_netto_efter_par14_kroner() -> personskat_kgl_årets_samlede_netto_kroner(sælgerpantebrevsresultater(), skatteår, skatteyder_identifikation(), øvrigt_netto_kroner())
    | kursgevinstlov_resultater_før_validering() -> personskat_kgl_alle_resultater_i_indkomstår(sælgerpantebrevsresultater(), skatteår, skatteyder_identifikation(), årets_samlede_netto_efter_par14_kroner())
    | kursgevinstlov_resultater() -> hvis input_gyldigt() { kursgevinstlov_resultater_før_validering() } ellers { [] }
    | kapitalposter() -> map(kursgevinstlov_resultater(), personskat_kgl_kapitalpost)
    | resultat() -> PersonskatKursgevinstResultat(
        input = input,
        input_gyldigt = input_gyldigt(),
        sælgerpantebrevsresultater = sælgerpantebrevsresultater(),
        årets_samlede_netto_efter_par14_kroner = årets_samlede_netto_efter_par14_kroner(),
        kursgevinstlov_resultater = kursgevinstlov_resultater(),
        kapitalposter = kapitalposter()
    )
}

| personskat_kursgevinst_resultat(input: PersonskatKursgevinstInput, skatteår: Heltal, ejendomsavance_resultat: PersonskatEjendomsavanceResultat) -> PersonskatKursgevinstSag(input, skatteår, ejendomsavance_resultat).resultat()
| personskat_ejendomsavance_afståelsesårets_par6d_medregning_kroner(resultat: EjendomsavancebeskatningslovResultat) -> ebl_par6d_medregnet_fortjeneste_i_indkomstår_kroner(resultat.par6d_resultat, resultat.indkomstår)
| personskat_ejendomsavance_afståelsesårsgrundfortjeneste_kroner(resultat: EjendomsavancebeskatningslovResultat, skatteår: Heltal) -> hvis resultat.indkomstår == skatteår { resultat.skattepligtig_fortjeneste_kroner - personskat_ejendomsavance_afståelsesårets_par6d_medregning_kroner(resultat) } ellers { 0 }
| personskat_ejendomsavance_afståelsesårsgrundfortjenester_kroner(resultater: List(EjendomsavancebeskatningslovResultat), skatteår: Heltal) -> foldl(resultater, 0, |sum: Heltal, resultat: EjendomsavancebeskatningslovResultat| sum + personskat_ejendomsavance_afståelsesårsgrundfortjeneste_kroner(resultat, skatteår))
| personskat_kgl_ebl_medregning_tilhører_person_i_indkomstår(medregning: KglEblPar6DFortjenestemedregning, skatteår: Heltal, skatteyder_identifikation: Tekst) -> skatteyder_identifikation != "" && medregning.medregning.indkomstår == skatteår && medregning.skatteyder.rolle == KglPersonEfterKildeskatteloven && medregning.skatteyder.identifikation == skatteyder_identifikation
| personskat_kgl_ebl_fordelt_fortjeneste_for_person_i_indkomstår_kroner(resultater: List(KglEblPar6DSælgerpantebrevsresultat), skatteår: Heltal, skatteyder_identifikation: Tekst) -> foldl(personskat_kgl_fortjenestemedregninger(resultater), 0, |sum: Heltal, medregning: KglEblPar6DFortjenestemedregning| sum + hvis personskat_kgl_ebl_medregning_tilhører_person_i_indkomstår(medregning, skatteår, skatteyder_identifikation) { medregning.medregning.beløb_kroner } ellers { 0 })

# PersonskatEjendomsavanceFordelingsSag(ejendomsavance_resultat: PersonskatEjendomsavanceResultat, kursgevinst_resultat: PersonskatKursgevinstResultat, skatteår: Heltal) {
    | skatteyder_identifikation() -> match kursgevinst_resultat.input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> fakta.skatteyder_identifikation
    }
    | ægtefælles_skatteyder_identifikation() -> match kursgevinst_resultat.input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> match fakta.ægtefælles_skatteyder_identifikation {
            | Some(identifikation) -> identifikation
            | None -> ""
        }
    }
    | sælgerpantebrevsresultater() -> kursgevinst_resultat.sælgerpantebrevsresultater
    | egne_fordelte_par6d_fortjenester_kroner() -> personskat_kgl_ebl_fordelt_fortjeneste_for_person_i_indkomstår_kroner(sælgerpantebrevsresultater(), skatteår, skatteyder_identifikation())
    | ægtefælles_fordelte_par6d_fortjenester_kroner() -> personskat_kgl_ebl_fordelt_fortjeneste_for_person_i_indkomstår_kroner(sælgerpantebrevsresultater(), skatteår, ægtefælles_skatteyder_identifikation())
    | resultat() -> match ejendomsavance_resultat {
        | BeregnetEjendomsavance(fakta, egne_afståelsesresultater, ægtefælles_afståelsesresultater, _, _, _) -> hvis kursgevinst_resultat.input_gyldigt {
            = egne_fortjenester_kroner = personskat_ejendomsavance_afståelsesårsgrundfortjenester_kroner(egne_afståelsesresultater, skatteår) + egne_fordelte_par6d_fortjenester_kroner()
            = ægtefælles_fortjenester_kroner = personskat_ejendomsavance_afståelsesårsgrundfortjenester_kroner(ægtefælles_afståelsesresultater, skatteår) + ægtefælles_fordelte_par6d_fortjenester_kroner()
            = ægtefællepar_resultat = ejendomsavance_par6_ægtefællepar_resultat(EjendomsavancePar6ÆgtefælleparInput(
                venstre = personskat_ejendomsavance_fordelt_tabsårsgrundlag(egne_afståelsesresultater, fakta.eget_fremført_tab, skatteår, egne_fortjenester_kroner),
                højre = personskat_ejendomsavance_fordelt_tabsårsgrundlag(ægtefælles_afståelsesresultater, fakta.ægtefælles_fremførte_tab, skatteår, ægtefælles_fortjenester_kroner),
                gift_samlevende_ved_indkomstårets_udgang = fakta.gift_samlevende_ved_indkomstårets_udgang
            ))
            = eget_tabsårsresultat = ægtefællepar_resultat.venstre
            = ægtefælles_tabsårsresultat = ægtefællepar_resultat.højre
            = par4_resultat = par4_stk1_nr14_årsresultat(Par4Stk1Nr14Årsinput(
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat
            ))
            BeregnetEjendomsavance(
                fakta = fakta,
                egne_afståelsesresultater = egne_afståelsesresultater,
                ægtefælles_afståelsesresultater = ægtefælles_afståelsesresultater,
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat,
                par4_resultat = par4_resultat
            )
        } ellers { ejendomsavance_resultat }
        | _ -> ejendomsavance_resultat
    }
}

| personskat_ejendomsavance_resultat_med_fortjenestefordeling(ejendomsavance_resultat: PersonskatEjendomsavanceResultat, kursgevinst_resultat: PersonskatKursgevinstResultat, skatteår: Heltal) -> PersonskatEjendomsavanceFordelingsSag(ejendomsavance_resultat, kursgevinst_resultat, skatteår).resultat()
| personskat_kapitalomkostning_identifikation_unik(omkostninger: List(PersonskatKapitalomkostningInput), omkostning: PersonskatKapitalomkostningInput) -> length(filter(omkostninger, |anden: PersonskatKapitalomkostningInput| anden.identifikation == omkostning.identifikation)) == 1
| personskat_kapitalomkostning_gyldig(omkostninger: List(PersonskatKapitalomkostningInput), omkostning: PersonskatKapitalomkostningInput) -> omkostning.identifikation != "" && omkostning.beløb_kroner >= 0 && personskat_kapitalomkostning_identifikation_unik(omkostninger, omkostning)
| personskat_par4_kapitalomkostning(omkostning: PersonskatKapitalomkostningInput, reklassifikation: KapitalPersonligReklassifikation) -> Par4Kapitalomkostning(
    beløb_kroner = omkostning.beløb_kroner,
    personlig_reklassifikation = reklassifikation
)

| personskat_ordinært_aktieår_resultat(input: PersonskatOrdinærtAktieårInput) -> match input {
    | UdenOrdinærtAktieår -> IntetOrdinærtAktieår
    | MedOrdinærtAktieår(årsinput) -> BeregnetOrdinærtAktieår(resultat = aktieavance_ordinaer_person_årsresultat(årsinput))
}
| personskat_ordinært_aktieår_gyldigt(resultat: PersonskatOrdinærtAktieårResultat, skatteår: Heltal) -> match resultat {
    | IntetOrdinærtAktieår -> Sandt
    | BeregnetOrdinærtAktieår(årsresultat) -> årsresultat.alle_input_gyldige && årsresultat.input.indkomstår == skatteår
}
| personskat_ordinære_aktieposter(resultat: PersonskatOrdinærtAktieårResultat) -> match resultat {
    | IntetOrdinærtAktieår -> []
    | BeregnetOrdinærtAktieår(årsresultat) -> [par4a_aktiepost(Par4aAktieavancebeskatningslovInput(
        aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat_fra_ordinaere_aktier(årsresultat.årsresultat)
    ))]
}
| personskat_særlig_aktieavance_input_gyldigt(input: AktieavancebeskatningslovInput, skatteår: Heltal) -> input.indkomstår == skatteår && aktieavancebeskatningslov_input_gyldigt(input)
| personskat_særlig_par4_kapitalpost(resultat: AktieavancebeskatningslovResultat) -> par4_stk1_nr5_kapitalpost(Par4Stk1Nr5Input(aktieavancebeskatningslov_resultat = resultat))
| personskat_særlig_par4a_aktiepost(resultat: AktieavancebeskatningslovResultat) -> par4a_aktiepost(Par4aAktieavancebeskatningslovInput(aktieavancebeskatningslov_resultat = resultat))

# PersonskatAktieavanceSag(input: PersonskatAktieavanceInput, skatteår: Heltal) {
    | ordinært_aktieår() -> personskat_ordinært_aktieår_resultat(input.ordinært_aktieår)
    | særlige_resultater() -> map(input.særlige_aktiver, aktieavancebeskatningslov_resultat)
    | ordinært_aktieår_gyldigt() -> personskat_ordinært_aktieår_gyldigt(ordinært_aktieår(), skatteår)
    | særlige_aktiver_gyldige() -> all(input.særlige_aktiver, |aktiv: AktieavancebeskatningslovInput| personskat_særlig_aktieavance_input_gyldigt(aktiv, skatteår))
    | alle_input_gyldige() -> ordinært_aktieår_gyldigt() && særlige_aktiver_gyldige()
    | par4_kapitalposter_før_validering() -> map(særlige_resultater(), personskat_særlig_par4_kapitalpost)
    | par4a_aktieposter_før_validering() -> concat(personskat_ordinære_aktieposter(ordinært_aktieår()), map(særlige_resultater(), personskat_særlig_par4a_aktiepost))
    | par4_kapitalposter() -> hvis alle_input_gyldige() { par4_kapitalposter_før_validering() } ellers { [] }
    | par4a_aktieposter() -> hvis alle_input_gyldige() { par4a_aktieposter_før_validering() } ellers { [] }
    | kapitalindkomst_resultat() -> par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
        poster = par4_kapitalposter(),
        omkostninger = []
    ))
    | aktieindkomst_resultat() -> par4a_aktieindkomst_resultat(Par4aAktieindkomstInput(
        poster = par4a_aktieposter(),
        pbl15a_grundlag = IntetPbl15AFradragsgrundlag,
        pensionsfradrag_valg_resultat = par4a_intet_pensionsfradrag_valg(skatteår)
    ))
    | personlig_indkomst_kroner() -> kapitalindkomst_resultat().omklassificeret_personlig_indkomst_kroner + kapitalindkomst_resultat().personlig_indkomst_tillæg_kroner + aktieindkomst_resultat().omklassificeret_personlig_indkomst_kroner
    | resultat() -> PersonskatAktieavanceResultat(
        input = input,
        ordinært_aktieår = ordinært_aktieår(),
        særlige_resultater = særlige_resultater(),
        alle_input_gyldige = alle_input_gyldige(),
        kapitalposter = par4_kapitalposter(),
        aktieposter = par4a_aktieposter(),
        kapitalindkomst_resultat = kapitalindkomst_resultat(),
        aktieindkomst_resultat = aktieindkomst_resultat(),
        personlig_indkomst_kroner = personlig_indkomst_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_resultat().nettokapitalindkomst_kroner,
        aktieindkomst_kroner = aktieindkomst_resultat().aktieindkomst_efter_pensionsfradrag_kroner
    )
}

| personskat_aktieavance_resultat(input: PersonskatAktieavanceInput, skatteår: Heltal) -> PersonskatAktieavanceSag(input, skatteår).resultat()
| personskat_ingen_aktieavance() -> PersonskatAktieavanceInput(ordinært_aktieår = UdenOrdinærtAktieår, særlige_aktiver = [])

| personskat_ejendomsdrift_ejendomsskattelov_input(fakta: PersonskatEjendomsdriftFakta, skatteår: Heltal) -> EjendomsskattelovPar3Input(
    indkomstår = skatteår,
    kategori = fakta.kategori,
    beliggenhed = fakta.beliggenhed,
    erhvervsmæssigt_udlejet = fakta.erhvervsmæssigt_udlejet,
    særlige_betingelser_for_nr6_til_nr8_opfyldt = fakta.særlige_betingelser_for_nr6_til_nr8_opfyldt
)
| personskat_ejendomsdrift_resultat(input: PersonskatEjendomsdriftInput, skatteår: Heltal) -> match input {
    | UdenEjendomsdriftEfterPar4Nr6 -> IngenEjendomsdriftEfterPar4Nr6
    | MedEjendomsdriftEfterPar4Nr6(fakta) -> {
        = ejendomsskattelov_input = personskat_ejendomsdrift_ejendomsskattelov_input(fakta, skatteår)
        = par4_input = par4_stk1_nr6_input_fra_ejendomsskattelov_par3(ejendomsskattelov_input, fakta.overskud_eller_underskud_kroner)
        BeregnetEjendomsdriftEfterPar4Nr6(
            fakta = fakta,
            ejendomsskattelov_input = ejendomsskattelov_input,
            par4_input = par4_input,
            par4_resultat = par4_stk1_nr6_resultat(par4_input)
        )
    }
}
| personskat_ejendomsdrift_kapitalposter(resultat: PersonskatEjendomsdriftResultat) -> match resultat {
    | BeregnetEjendomsdriftEfterPar4Nr6(_, _, par4_input, _) -> [par4_stk1_nr6_kapitalpost(par4_input)]
    | _ -> []
}

| personskat_fremlejerrolle_til_ligningslov15q(rolle: PersonskatFremlejerrolle) -> Ll15QLejer
| exception andelshaverrolle_til_ligningslov15q personskat_fremlejerrolle_til_ligningslov15q(rolle: PersonskatFremlejerrolle) -> Ll15QAndelshaver under rolle == PersonskatUdlejendeAndelshaver
| personskat_fremlejerrolle_til_ligningslov15p(rolle: PersonskatFremlejerrolle) -> Ll15PLejer
| exception andelshaverrolle_til_ligningslov15p personskat_fremlejerrolle_til_ligningslov15p(rolle: PersonskatFremlejerrolle) -> Ll15PAndelshaver under rolle == PersonskatUdlejendeAndelshaver
| personskat_indkomstårets_dage(skatteår: Heltal) -> 365
| exception personskat_skudår_har_366_dage personskat_indkomstårets_dage(skatteår: Heltal) -> 366 under kildeskat_skudår(skatteår)
| personskat_ligningslov15p_samordningsinput(fakta: PersonskatLigningslov15PSamordningsfakta, rolle: PersonskatFremlejerrolle, skatteår: Heltal) -> Ligningslov15PInput(
    skatteår = skatteår,
    rolle = personskat_fremlejerrolle_til_ligningslov15p(rolle),
    udlejningsform = fakta.udlejningsform,
    metode = Ll15PSkematiskBundfradrag,
    bruttolejeindtægt_kroner = fakta.bruttolejeindtægt_kroner,
    årlig_leje_eller_boligafgift_kroner = fakta.årlig_leje_eller_boligafgift_kroner,
    ejendomsværdi_kroner = 0,
    ejer_ejendom_omfattet_af_ejendomsskattelov3 = Falskt,
    samme_personer_mindst_fire_måneder = fakta.samme_personer_mindst_fire_måneder,
    lejet_eller_ejet_dage = fakta.lejet_eller_ejet_dage,
    udlejningsdage = fakta.udlejningsdage,
    indkomstårets_dage = personskat_indkomstårets_dage(skatteår),
    faktiske_udgifter_kroner = 0
)
| personskat_ligningslov15q_stk4_samordning(input: PersonskatLigningslov15QStk4Input, rolle: PersonskatFremlejerrolle, skatteår: Heltal) -> match input {
    | UdenSamordningMedLigningslov15P -> ll15q_ingen_stk4_samordning()
    | MedSamordningMedLigningslov15P(par15q_udlejningsdage, par15p_fakta, loftvalg) -> Ligningslov15QStk4Samordning(
        anvender_både_par15q_og_par15p = Sandt,
        par15q_udlejningsdage = par15q_udlejningsdage,
        par15p_resultat = ligningslov15p_resultat(personskat_ligningslov15p_samordningsinput(par15p_fakta, rolle, skatteår)),
        indkomstårets_dage = personskat_indkomstårets_dage(skatteår),
        loftvalg = loftvalg
    )
}
| personskat_ligningslov15q_stk4_samordning_gyldig(input: PersonskatLigningslov15QStk4Input, rolle: PersonskatFremlejerrolle, metode: Ligningslov15QMetode, skatteår: Heltal) -> match input {
    | UdenSamordningMedLigningslov15P -> Sandt
    | MedSamordningMedLigningslov15P(par15q_udlejningsdage, par15p_fakta, _) -> {
        = indkomstårets_dage = personskat_indkomstårets_dage(skatteår)
        = par15p_resultat = ligningslov15p_resultat(personskat_ligningslov15p_samordningsinput(par15p_fakta, rolle, skatteår))
        metode == Ll15QStk1Bundfradrag && indkomstårets_dage > 0 && par15q_udlejningsdage >= 0 && par15q_udlejningsdage <= indkomstårets_dage && par15p_fakta.bruttolejeindtægt_kroner >= 0 && par15p_fakta.årlig_leje_eller_boligafgift_kroner >= 0 && par15p_fakta.lejet_eller_ejet_dage >= 0 && par15p_fakta.lejet_eller_ejet_dage <= indkomstårets_dage && par15p_fakta.udlejningsdage >= 0 && par15p_fakta.udlejningsdage <= indkomstårets_dage && par15p_resultat.skematisk_anvendelig
    }
}
| personskat_ligningslov15q_input(fakta: PersonskatFremlejeFakta, skatteår: Heltal) -> Ligningslov15QInput(
    skatteår = skatteår,
    rolle = personskat_fremlejerrolle_til_ligningslov15q(fakta.rolle),
    udlejningsform = fakta.udlejningsform,
    boligstatus = fakta.boligstatus,
    indberetningsstatus = fakta.indberetningsstatus,
    metode = fakta.metode,
    bruttolejeindtægt_kroner = fakta.bruttolejeindtægt_kroner,
    faktiske_udgifter_kroner = fakta.faktiske_udgifter_kroner,
    ejer_ejendom_omfattet_af_ejendomsskattelov3 = Falskt,
    tidligere_anvendt_par15p_stk3 = fakta.tidligere_anvendt_par15p_stk3,
    stk4_samordning = personskat_ligningslov15q_stk4_samordning(fakta.stk4_samordning, fakta.rolle, skatteår)
)
| personskat_ligningslov15q_valgte_metode_anvendelig(resultat: Ligningslov15QResultat) -> resultat.stk1_anvendelig || resultat.stk3_anvendelig
| personskat_fremlejegrundlag_gyldigt(fakta: PersonskatFremlejeFakta, skatteår: Heltal, resultat: Ligningslov15QResultat) -> fakta.bruttolejeindtægt_kroner >= 0 && fakta.faktiske_udgifter_kroner >= 0 && personskat_ligningslov15q_stk4_samordning_gyldig(fakta.stk4_samordning, fakta.rolle, fakta.metode, skatteår) && personskat_ligningslov15q_valgte_metode_anvendelig(resultat)
| personskat_fremleje_resultat(input: PersonskatFremlejeInput, skatteår: Heltal) -> match input {
    | UdenFremlejeEfterLigningslov15Q -> IngenFremlejeEfterLigningslov15Q
    | MedFremlejeEfterLigningslov15Q(fakta) -> {
        = ligningslov15q_input = personskat_ligningslov15q_input(fakta, skatteår)
        = ligningslov15q_resultat = ligningslov15q_resultat(ligningslov15q_input)
        = stk4_samordning_gyldig = personskat_ligningslov15q_stk4_samordning_gyldig(fakta.stk4_samordning, fakta.rolle, fakta.metode, skatteår)
        hvis personskat_fremlejegrundlag_gyldigt(fakta, skatteår, ligningslov15q_resultat) {
            BeregnetFremlejeEfterLigningslov15Q(
                fakta = fakta,
                ligningslov15q_input = ligningslov15q_input,
                ligningslov15q_resultat = ligningslov15q_resultat,
                par4_resultat = par4_stk1_nr17_resultat_fra_ligningslov15q(ligningslov15q_input)
            )
        } ellers {
            UgyldigtFremlejegrundlag(
                fakta = fakta,
                ligningslov15q_input = ligningslov15q_input,
                ligningslov15q_resultat = ligningslov15q_resultat,
                stk4_samordning_gyldig = stk4_samordning_gyldig
            )
        }
    }
}
| personskat_fremleje_input_gyldigt(resultat: PersonskatFremlejeResultat) -> match resultat {
    | UgyldigtFremlejegrundlag(_, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_fremleje_kapitalposter(resultat: PersonskatFremlejeResultat) -> match resultat {
    | BeregnetFremlejeEfterLigningslov15Q(_, ligningslov15q_input, _, _) -> [par4_stk1_nr17_kapitalpost_fra_ligningslov15q(ligningslov15q_input)]
    | _ -> []
}

# PersonskatKapitalindkomstSag(input: PersonskatKapitalindkomstInput, skatteår: Heltal, aktieavance: PersonskatAktieavanceResultat) {
    | reklassifikation() -> personskat_kapital_reklassifikation(input.renter.næringsstatus)
    | rentegrundlag_gyldigt() -> input.renter.renteindtægter_kroner >= 0 && input.renter.renteudgifter_kroner >= 0
    | ligningslov6_input_gyldigt() -> personskat_ligningslov6_input_gyldigt(input.renter.ligningslov6, skatteår)
    | ligningslov6a_input_gyldigt() -> personskat_ligningslov6a_input_gyldigt(input.renter.ligningslov6a, skatteår)
    | ejendomsavancegrundlag_resultat() -> personskat_ejendomsavance_resultat(input.ejendomsavance, skatteår)
    | ejendomsavance_input_gyldigt() -> personskat_ejendomsavance_input_gyldigt(ejendomsavancegrundlag_resultat())
    | kursgevinst_resultat() -> personskat_kursgevinst_resultat(input.kursgevinst, skatteår, ejendomsavancegrundlag_resultat())
    | kursgevinst_input_gyldigt() -> kursgevinst_resultat().input_gyldigt
    | ejendomsavance_resultat() -> personskat_ejendomsavance_resultat_med_fortjenestefordeling(ejendomsavancegrundlag_resultat(), kursgevinst_resultat(), skatteår)
    | fremleje_resultat() -> personskat_fremleje_resultat(input.fremleje, skatteår)
    | fremleje_input_gyldigt() -> personskat_fremleje_input_gyldigt(fremleje_resultat())
    | omkostninger_gyldige() -> all(input.omkostninger, |omkostning: PersonskatKapitalomkostningInput| personskat_kapitalomkostning_gyldig(input.omkostninger, omkostning))
    | alle_input_gyldige() -> skatteår > 0 && rentegrundlag_gyldigt() && ligningslov6_input_gyldigt() && ligningslov6a_input_gyldigt() && ejendomsavance_input_gyldigt() && kursgevinst_input_gyldigt() && fremleje_input_gyldigt() && omkostninger_gyldige()
    | ligningslov6_resultat() -> personskat_ligningslov6_resultat(input.renter.ligningslov6, skatteår)
    | ligningslov6_resultat_anvendt() -> personskat_ligningslov6_resultat_anvendt(input.renter.ligningslov6, skatteår)
    | ligningslov6a_resultat() -> personskat_ligningslov6a_resultat(input.renter.ligningslov6a, skatteår)
    | ligningslov6a_resultat_anvendt() -> personskat_ligningslov6a_resultat_anvendt(input.renter.ligningslov6a, skatteår)
    | rente_par4_input() -> Par4Stk1Nr1Input(
        renteindtægter_kroner = input.renter.renteindtægter_kroner,
        renteudgifter_kroner = input.renter.renteudgifter_kroner,
        ligningslov6_resultat = ligningslov6_resultat_anvendt(),
        ligningslov6a_resultat = ligningslov6a_resultat_anvendt(),
        personlig_reklassifikation = reklassifikation()
    )
    | rente_resultat() -> par4_stk1_nr1_resultat(rente_par4_input())
    | renteposter() -> hvis rentegrundlag_gyldigt() { [par4_stk1_nr1_kapitalpost(rente_par4_input())] } ellers { [] }
    | ejendomsdrift_resultat() -> personskat_ejendomsdrift_resultat(input.ejendomsdrift, skatteår)
    | ejendomsdriftposter() -> personskat_ejendomsdrift_kapitalposter(ejendomsdrift_resultat())
    | ejendomsavanceposter() -> hvis ejendomsavance_input_gyldigt() && kursgevinst_input_gyldigt() { personskat_ejendomsavance_kapitalposter(ejendomsavance_resultat()) } ellers { [] }
    | kursgevinstposter() -> kursgevinst_resultat().kapitalposter
    | fremlejeposter() -> personskat_fremleje_kapitalposter(fremleje_resultat())
    | kapitalomkostninger() -> hvis omkostninger_gyldige() { map(input.omkostninger, |omkostning: PersonskatKapitalomkostningInput| personskat_par4_kapitalomkostning(omkostning, reklassifikation())) } ellers { [] }
    | kapitalindkomst_resultat() -> par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
        poster = concat(concat(concat(concat(concat(renteposter(), ejendomsdriftposter()), ejendomsavanceposter()), kursgevinstposter()), fremlejeposter()), aktieavance.kapitalposter),
        omkostninger = kapitalomkostninger()
    ))
    | resultat() -> {
        = reklassifikation_resultat = personskat_kapital_reklassifikation(input.renter.næringsstatus)
        = rentegrundlag_er_gyldigt = input.renter.renteindtægter_kroner >= 0 && input.renter.renteudgifter_kroner >= 0
        = ligningslov6_er_gyldig = personskat_ligningslov6_input_gyldigt(input.renter.ligningslov6, skatteår)
        = ligningslov6a_er_gyldig = personskat_ligningslov6a_input_gyldigt(input.renter.ligningslov6a, skatteår)
        = ejendomsavancegrundlag = personskat_ejendomsavance_resultat(input.ejendomsavance, skatteår)
        = ejendomsavance_er_gyldig = personskat_ejendomsavance_input_gyldigt(ejendomsavancegrundlag)
        = kursgevinst = personskat_kursgevinst_resultat(input.kursgevinst, skatteår, ejendomsavancegrundlag)
        = kursgevinst_er_gyldig = kursgevinst.input_gyldigt
        = fordelt_ejendomsavance = personskat_ejendomsavance_resultat_med_fortjenestefordeling(ejendomsavancegrundlag, kursgevinst, skatteår)
        = fremleje = personskat_fremleje_resultat(input.fremleje, skatteår)
        = fremleje_er_gyldig = personskat_fremleje_input_gyldigt(fremleje)
        = omkostninger_er_gyldige = all(input.omkostninger, |omkostning: PersonskatKapitalomkostningInput| personskat_kapitalomkostning_gyldig(input.omkostninger, omkostning))
        = alle_input_er_gyldige = skatteår > 0 && rentegrundlag_er_gyldigt && ligningslov6_er_gyldig && ligningslov6a_er_gyldig && ejendomsavance_er_gyldig && kursgevinst_er_gyldig && fremleje_er_gyldig && omkostninger_er_gyldige
        = ligningslov6 = personskat_ligningslov6_resultat(input.renter.ligningslov6, skatteår)
        = ligningslov6_anvendt = personskat_ligningslov6_resultat_anvendt(input.renter.ligningslov6, skatteår)
        = ligningslov6a = personskat_ligningslov6a_resultat(input.renter.ligningslov6a, skatteår)
        = ligningslov6a_anvendt = personskat_ligningslov6a_resultat_anvendt(input.renter.ligningslov6a, skatteår)
        = renteinput = Par4Stk1Nr1Input(
            renteindtægter_kroner = input.renter.renteindtægter_kroner,
            renteudgifter_kroner = input.renter.renteudgifter_kroner,
            ligningslov6_resultat = ligningslov6_anvendt,
            ligningslov6a_resultat = ligningslov6a_anvendt,
            personlig_reklassifikation = reklassifikation_resultat
        )
        = renteresultat = par4_stk1_nr1_resultat(renteinput)
        = renteposter_resultat = hvis rentegrundlag_er_gyldigt { [par4_stk1_nr1_kapitalpost(renteinput)] } ellers { [] }
        = ejendomsdrift = personskat_ejendomsdrift_resultat(input.ejendomsdrift, skatteår)
        = ejendomsdriftposter_resultat = personskat_ejendomsdrift_kapitalposter(ejendomsdrift)
        = ejendomsavanceposter_resultat = hvis ejendomsavance_er_gyldig && kursgevinst_er_gyldig { personskat_ejendomsavance_kapitalposter(fordelt_ejendomsavance) } ellers { [] }
        = fremlejeposter_resultat = personskat_fremleje_kapitalposter(fremleje)
        = kapitalomkostninger_resultat = hvis omkostninger_er_gyldige { map(input.omkostninger, |omkostning: PersonskatKapitalomkostningInput| personskat_par4_kapitalomkostning(omkostning, reklassifikation_resultat)) } ellers { [] }
        = samlet_kapitalindkomst = par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
            poster = concat(concat(concat(concat(concat(renteposter_resultat, ejendomsdriftposter_resultat), ejendomsavanceposter_resultat), kursgevinst.kapitalposter), fremlejeposter_resultat), aktieavance.kapitalposter),
            omkostninger = kapitalomkostninger_resultat
        ))
        PersonskatKapitalindkomstResultat(
            input = input,
            rentegrundlag_gyldigt = rentegrundlag_er_gyldigt,
            ligningslov6_input_gyldigt = ligningslov6_er_gyldig,
            ligningslov6a_input_gyldigt = ligningslov6a_er_gyldig,
            ejendomsavance_input_gyldigt = ejendomsavance_er_gyldig,
            kursgevinst_input_gyldigt = kursgevinst_er_gyldig,
            fremleje_input_gyldigt = fremleje_er_gyldig,
            omkostninger_gyldige = omkostninger_er_gyldige,
            alle_input_gyldige = alle_input_er_gyldige,
            ligningslov6_resultat = ligningslov6,
            ligningslov6a_resultat = ligningslov6a,
            rente_resultat = renteresultat,
            ejendomsdrift_resultat = ejendomsdrift,
            ejendomsavance_resultat = fordelt_ejendomsavance,
            kursgevinst_resultat = kursgevinst,
            fremleje_resultat = fremleje,
            kapitalindkomst_resultat = samlet_kapitalindkomst
        )
    }
}

| personskat_kapitalindkomst_resultat(input: PersonskatKapitalindkomstInput, skatteår: Heltal, aktieavance: PersonskatAktieavanceResultat) -> PersonskatKapitalindkomstSag(input, skatteår, aktieavance).resultat()
| personskat_ingen_kapitalindkomst() -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    omkostninger = []
)
| personskat_intet_selvstændigt_pensionsoverskud() -> Pbl18SelvstændigOverskudInput(
    skattepligtigt_overskud_før_vsl22b_kroner = 0,
    renteudgifter_kroner = 0,
    kurstab_kroner = 0,
    renteindtægter_kroner = 0,
    udbytteindtægter_kroner = 0,
    kursgevinster_kroner = 0,
    udelukkede_afståelsesindkomster_kroner = 0
)
| personskat_ingen_pension() -> PersonskatPensionsInput(
    pensionsalder_status = Ll9lMereEnd15ÅrFørFolkepension,
    pbl18_indbetalinger = [],
    pbl18_selvstændig_overskud = personskat_intet_selvstændigt_pensionsoverskud(),
    pbl18_livrentevalg = Pbl18FordeltFradrag,
    aktiepensionsfradrag_valg = UdenAktiepensionsfradragIAktieindkomst,
    pbl20_indkomstskattepligtig_udbetaling_kroner = 0,
    pbl20_udbetaling_status = Ll9lIngenPbl20Udbetaling
)

# PersonskatPensionsSag(input: PersonskatInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat) {
    | lønmodtager_før_pensionsfradrag() -> LønmodtagerInput(
        skatteår = input.lønmodtager.skatteår,
        kommune = input.lønmodtager.kommune,
        bruttoløn_kroner = input.lønmodtager.bruttoløn_kroner + personskat_erhvervsbefordring_skattepligtig_løn_kroner(erhvervsbefordring),
        øvrig_personlig_indkomst_kroner = ligningsfradrag.personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.personlig_indkomst_tillæg_kroner + aktieavance.aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner - personskat_erhvervsbefordring_fradrag_i_personlig_indkomst_kroner(erhvervsbefordring),
        nettokapitalindkomst_kroner = kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner,
        ligningsmæssige_fradrag_kroner = ligningsfradrag.samlet_ligningsfradrag_kroner,
        pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
        personfradrag_alder_status = input.lønmodtager.personfradrag_alder_status,
        betaler_kirkeskat = input.lønmodtager.betaler_kirkeskat
    )
    | personlig_indkomst_før_pensionsfradrag_kroner() -> penge_positivt_beløb(personlig_indkomst_efter_am(lønmodtager_før_pensionsfradrag()))
    | årsinput() -> Pbl18Årsinput(
        indkomstår = input.lønmodtager.skatteår,
        personlig_indkomst_før_pensionsfradrag_kroner = personlig_indkomst_før_pensionsfradrag_kroner(),
        selvstændig_overskud = input.lønmodtager.pension.pbl18_selvstændig_overskud,
        livrentevalg = input.lønmodtager.pension.pbl18_livrentevalg,
        indbetalinger = input.lønmodtager.pension.pbl18_indbetalinger
    )
    | årsresultat() -> pbl18_årsresultat(årsinput())
    | aktiepensionsfradrag_valg_resultat() -> match input.lønmodtager.pension.aktiepensionsfradrag_valg {
        | UdenAktiepensionsfradragIAktieindkomst -> par4a_intet_pensionsfradrag_valg(input.lønmodtager.skatteår)
        | MedAktiepensionsfradragIAktieindkomst(ønsket_fradrag_kroner, meddelelse_dato_yyyymmdd, omgørelse_dato_yyyymmdd) -> par4a_pensionsfradrag_valg_resultat(AktiePensionsFradragValgInput(
            indkomstår = input.lønmodtager.skatteår,
            ønsket_fradrag_kroner = ønsket_fradrag_kroner,
            meddelelse_dato_yyyymmdd = meddelelse_dato_yyyymmdd,
            omgørelse_dato_yyyymmdd = omgørelse_dato_yyyymmdd,
            personlig_indkomst_status = IkkeFradragetIPersonligIndkomst
        ))
    }
    | aktiepensionsfradrag_resultat() -> par4a_pensionsfradrag_resultat(AktiePensionsFradragInput(
        aktieindkomst_efter_stk1_og_2_kroner = aktieavance.aktieindkomst_resultat.aktieindkomst_efter_stk1_og_2_kroner,
        pbl15a_grundlag = par4a_pbl15a_grundlag_fra_pbl18_år(årsresultat()),
        valg_resultat = aktiepensionsfradrag_valg_resultat()
    ))
    | par3_resultat() -> par3_stk2_nr3_resultat_fra_pbl18_år(
        årsresultat(),
        aktiepensionsfradrag_resultat()
    )
    | arbejdsgiver_rate_og_ophørende_efter_am_kroner() -> hvis årsresultat().input_gyldigt { årsresultat().arbejdsgivergrundlag.rate_og_ophørende_brutto_kroner - årsresultat().arbejdsgivergrundlag.rate_og_ophørende_am_bidrag_kroner } ellers { 0 }
    | arbejdsgiver_øvrige_efter_am_kroner() -> hvis årsresultat().input_gyldigt { årsresultat().arbejdsgivergrundlag.øvrige_efter_am_bidrag_kroner } ellers { 0 }
    | lønmodtager_pensionsfradrag() -> LønmodtagerPensionsfradrag(
        pensionsalder_status = input.lønmodtager.pension.pensionsalder_status,
        pbl18_fradragsberettiget_indbetaling_kroner = årsresultat().samlet_fradrag_i_skattepligtig_indkomst_kroner,
        pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = arbejdsgiver_rate_og_ophørende_efter_am_kroner(),
        pbl19_øvrige_indbetalinger_efter_am_kroner = arbejdsgiver_øvrige_efter_am_kroner(),
        pbl20_indkomstskattepligtig_udbetaling_kroner = input.lønmodtager.pension.pbl20_indkomstskattepligtig_udbetaling_kroner,
        pbl20_udbetaling_status = input.lønmodtager.pension.pbl20_udbetaling_status
    )
    | resultat() -> PersonskatPensionsResultat(
        pbl18_årsinput = årsinput(),
        pbl18_årsresultat = årsresultat(),
        aktiepensionsfradrag_resultat = aktiepensionsfradrag_resultat(),
        par3_stk2_nr3_resultat = par3_resultat(),
        lønmodtager_pensionsfradrag = lønmodtager_pensionsfradrag()
    )
}

| personskat_pensions_resultat(input: PersonskatInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat) -> PersonskatPensionsSag(input, erhvervsbefordring, ligningsfradrag, kapitalindkomst, aktieavance).resultat()

# PersonskatAktieavanceEfterPensionSag(aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) {
    | aktieindkomst_resultat() -> Par4aAktieindkomstResultat(
        aktieindkomst_efter_stk1_og_2_kroner = aktieavance.aktieindkomst_resultat.aktieindkomst_efter_stk1_og_2_kroner,
        pensionsfradrag_i_aktieindkomst_kroner = pension.aktiepensionsfradrag_resultat.fradrag_i_aktieindkomst_kroner,
        aktieindkomst_efter_pensionsfradrag_kroner = pension.aktiepensionsfradrag_resultat.aktieindkomst_efter_fradrag_kroner,
        omklassificeret_personlig_indkomst_kroner = aktieavance.aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner,
        aktieindkomst_indgår_i_skattepligtig_indkomst = aktieavance.aktieindkomst_resultat.aktieindkomst_indgår_i_skattepligtig_indkomst
    )
    | resultat() -> PersonskatAktieavanceResultat(
        input = aktieavance.input,
        ordinært_aktieår = aktieavance.ordinært_aktieår,
        særlige_resultater = aktieavance.særlige_resultater,
        alle_input_gyldige = aktieavance.alle_input_gyldige,
        kapitalposter = aktieavance.kapitalposter,
        aktieposter = aktieavance.aktieposter,
        kapitalindkomst_resultat = aktieavance.kapitalindkomst_resultat,
        aktieindkomst_resultat = aktieindkomst_resultat(),
        personlig_indkomst_kroner = aktieavance.personlig_indkomst_kroner,
        kapitalindkomst_kroner = aktieavance.kapitalindkomst_kroner,
        aktieindkomst_kroner = aktieindkomst_resultat().aktieindkomst_efter_pensionsfradrag_kroner
    )
}
| personskat_aktieavance_efter_pensionsfradrag(aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) -> PersonskatAktieavanceEfterPensionSag(aktieavance, pension).resultat()

| personskat_lønmodtager_input(input: PersonskatLønmodtagerInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) -> LønmodtagerInput(
    skatteår = input.skatteår,
    kommune = input.kommune,
    bruttoløn_kroner = input.bruttoløn_kroner + personskat_erhvervsbefordring_skattepligtig_løn_kroner(erhvervsbefordring),
    øvrig_personlig_indkomst_kroner = ligningsfradrag.personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.personlig_indkomst_tillæg_kroner + aktieavance.aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner - personskat_erhvervsbefordring_fradrag_i_personlig_indkomst_kroner(erhvervsbefordring) - pension.par3_stk2_nr3_resultat.fradrag_i_personlig_indkomst_kroner,
    nettokapitalindkomst_kroner = kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner,
    ligningsmæssige_fradrag_kroner = ligningsfradrag.samlet_ligningsfradrag_kroner,
    pensionsfradrag = pension.lønmodtager_pensionsfradrag,
    personfradrag_alder_status = input.personfradrag_alder_status,
    betaler_kirkeskat = input.betaler_kirkeskat
)
| personskat_skatteforhold(input: PersonskatSkatteforholdInput, aktieavance: PersonskatAktieavanceResultat) -> lønmodtager_skatteforhold_med_aktieindkomst_tillæg(personskat_angivne_skatteforhold(input), aktieavance.aktieindkomst_kroner)
| personskat_lønmodtagermodel(input: PersonskatInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) -> beregn_lønmodtager_model_med_skatteforhold_og_par13_forhold(
    personskat_lønmodtager_input(input.lønmodtager, erhvervsbefordring, ligningsfradrag, kapitalindkomst, aktieavance, pension),
    personskat_skatteforhold(input.skatteforhold, aktieavance),
    personskat_underskudsforhold(input.underskudsforhold)
)
| personskat_skat(input: PersonskatInput, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) -> lønmodtager_breakdown_fra_model(personskat_lønmodtagermodel(input, erhvervsbefordring, ligningsfradrag, kapitalindkomst, aktieavance, pension))
| personskat_årsopgørelse(input: PersonskatÅrsopgørelseInput, skat: LønmodtagerBreakdown) -> match input {
    | UdenÅrsopgørelse -> IngenÅrsopgørelse
    | MedÅrsopgørelse(overført_restskat_mv_kroner, pensionsbeskatningsafgift_kroner, kreditter) -> {
        = årsopgørelsesinput = KildeskatSlutopgørelseInput(
            slutskat_kroner = skat.samlet_inkl_am_efter_personfradrag_kroner,
            overført_restskat_mv_kroner = overført_restskat_mv_kroner,
            pensionsbeskatningsafgift_kroner = pensionsbeskatningsafgift_kroner,
            kreditter = kreditter
        )
        BeregnetÅrsopgørelse(
            input = årsopgørelsesinput,
            resultat = kildeskat_slutopgørelse_resultat(årsopgørelsesinput)
        )
    }
}
| personskat_beregning_resultat(input: PersonskatInput) -> {
    = aktieavance_før_pensionsfradrag = personskat_aktieavance_resultat(input.aktieavance, input.lønmodtager.skatteår)
    = kapitalindkomst = personskat_kapitalindkomst_resultat(input.kapitalindkomst, input.lønmodtager.skatteår, aktieavance_før_pensionsfradrag)
    = erhvervsbefordring = personskat_erhvervsbefordring_resultat(input.lønmodtager.erhvervsbefordring, input.lønmodtager.skatteår)
    = ligningsfradrag = personskat_ligningsfradrag_resultat(input.lønmodtager.ligningsfradrag, input.lønmodtager, erhvervsbefordring)
    = pension = personskat_pensions_resultat(input, erhvervsbefordring, ligningsfradrag, kapitalindkomst, aktieavance_før_pensionsfradrag)
    = aktieavance = personskat_aktieavance_efter_pensionsfradrag(aktieavance_før_pensionsfradrag, pension)
    = skat = personskat_skat(input, erhvervsbefordring, ligningsfradrag, kapitalindkomst, aktieavance, pension)
    PersonskatBeregningResultat(
        skat = skat,
        pension = pension,
        erhvervsbefordring = erhvervsbefordring,
        ligningsfradrag = ligningsfradrag,
        kapitalindkomst = kapitalindkomst,
        aktieavance = aktieavance,
        årsopgørelse = personskat_årsopgørelse(input.årsopgørelse, skat)
    )
}
| beregn_personskat_lønmodtager(input: LønmodtagerInput) -> beregn_lønmodtager(input)

@ calculate("Dansk personskat")
| beregn_personskat(input: PersonskatInput) -> personskat_beregning_resultat(input)
--@end:personskat_lønmodtagerberegning--
