    | Søbl4Ligningslov9BErhvervsbefordring(kildeidentifikation) -> personskat_ll9g_kilde_bevares(koordinering, Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation = kildeidentifikation))
    | Søbl4Ligningslov9COg9DBefordringsfradrag -> Sandt
    | Søbl4Pensionsbeskatningslov49Stk1Bidrag(kildeidentifikation) -> personskat_ll9g_kilde_bevares(koordinering, Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation = kildeidentifikation))
