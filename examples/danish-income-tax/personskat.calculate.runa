        personskat_søbl4_påkrævede_kilder(lønmodtagerudgifter = øvrige_lønmodtagerudgifter, erhvervsbefordring = erhvervsbefordring, befordring = befordring, faglige_kontingenter = faglige_kontingenter, arbejdsløshed_efterløn_og_fleksydelse = arbejdsløshed_efterløn_og_fleksydelse),
        |kilde: Sømandsbeskatningslov4Fradragskilde| personskat_ll9g_søbl4_kilde_bevares(kilde, fiskerfradragssamordning)
    )
    = sømandsbeskatningslov4_kildetilknytninger_gyldige = personskat_søbl4_kildetilknytninger_gyldige(input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag, lønmodtagerudgifter = øvrige_lønmodtagerudgifter_før_ligningslov9g, erhvervsbefordring = erhvervsbefordring, befordring = befordring_før_ligningslov9g, faglige_kontingenter = faglige_kontingenter_før_ligningslov9g, arbejdsløshed_efterløn_og_fleksydelse = arbejdsløshed_efterløn_og_fleksydelse)
    = sømandsbeskatningslov4_påkrævede_kilder_tilknyttet = personskat_søbl4_påkrævede_kilder_tilknyttet(input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag, påkrævede_kilder = sømandsbeskatningslov4_påkrævede_kilder)
    = erhvervsbefordring_fradrag_før_ligningslov9g_kroner = personskat_erhvervsbefordring_fradrag_i_personlig_indkomst_kroner(erhvervsbefordring)
    = erhvervsbefordring_fradrag_før_par4_kroner = personskat_ll9g_erhvervsbefordring_fradrag_anvendt_kroner(erhvervsbefordring, fiskerfradragssamordning)
    = erhvervsbefordring_fradrag_anvendt_kroner = personskat_ll9g_og_søbl4_erhvervsbefordring_fradrag_anvendt_kroner(erhvervsbefordring = erhvervsbefordring, koordinering = fiskerfradragssamordning, input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag)
    = rejsefradrag_før_ligningslov9g = personskat_ll9g_rejsefradrag_resultat(rejser_før_sømandsbeskatningslov4_stk2, fiskerfradragssamordning)
    = rejsefradrag_efter_ligningslov9g_og_sømandsbeskatningslov4 = personskat_ll9g_rejsefradrag_resultat(rejser, fiskerfradragssamordning)
    = rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner = rejsefradrag_før_ligningslov9g.samlet_ll9a_fradrag_efter_årsloft_kroner
    = rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner = rejsefradrag_efter_ligningslov9g_og_sømandsbeskatningslov4.samlet_ll9a_fradrag_efter_årsloft_kroner
    = dobbelt_husførelse_før_sømandsbeskatningslov4_stk2_kroner = rejser_før_sømandsbeskatningslov4_stk2.dobbelt_husførelse_efter_fælles_loft_kroner
    = dobbelt_husførelse_efter_sømandsbeskatningslov4_stk2_kroner = rejser.dobbelt_husførelse_efter_fælles_loft_kroner
    = lønmodtagerudgifter_fradragsgrundlag_før_par4_kroner = øvrige_lønmodtagerudgifter.samlet_fradragsgrundlag_før_bundgrænse_kroner
    = lønmodtagerudgifter_fradragsgrundlag_efter_par4_kroner = personskat_søbl4_lønmodtagerudgifter_fradragsgrundlag_anvendt_kroner(lønmodtagerudgifter = øvrige_lønmodtagerudgifter, input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag)
