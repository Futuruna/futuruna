    = øvrige_lønmodtagerudgifter = ligningslov9_stk1_årsresultat(indkomstår = lønmodtager.skatteår, input = personskat_ll9g_lønmodtagerudgifter_input(input.øvrige_lønmodtagerudgifter, fiskerfradragssamordning))
    = rejser_før_sømandsbeskatningslov4_stk2 = ligningslov9a_årsresultat(indkomstår = lønmodtager.skatteår, input = input.rejser, ekstern_udelukkelse = Ll9AIngenEksternUdelukkelse)
    = rejser_ekstern_udelukkelse = hvis personlig_indkomst.sømandsbeskatning.ligningslov9a_stk1_til9_afskåret { Ll9AUdelukketEfterSømandsbeskatningslov5Stk5 } ellers {
        hvis sømandsfradrag.kan_foretage_fradrag_efter_par3 { Ll9AUdelukketEfterSømandsbeskatningslov4Stk2 } ellers { Ll9AIngenEksternUdelukkelse }
    }
    = rejser = ligningslov9a_årsresultat(indkomstår = lønmodtager.skatteår, input = input.rejser, ekstern_udelukkelse = rejser_ekstern_udelukkelse)
    = erhvervsbefordring_skattefri_godtgørelse_før_par4_kroner = erhvervsbefordring.samlet_skattefri_godtgørelse_kroner
    = erhvervsbefordring_skattefri_godtgørelse_efter_par4_kroner = personskat_søbl4_erhvervsbefordring_skattefri_godtgørelse_anvendt_kroner(erhvervsbefordring = erhvervsbefordring, input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag)
    = erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner = erhvervsbefordring.samlet_skattepligtig_godtgørelse_kroner + erhvervsbefordring_skattefri_godtgørelse_før_par4_kroner - erhvervsbefordring_skattefri_godtgørelse_efter_par4_kroner
    = rejsegodtgørelse_skattefri_før_sømandsbeskatningslov4_stk2_kroner = rejser_før_sømandsbeskatningslov4_stk2.samlet_skattefri_godtgørelse_kroner
    = rejsegodtgørelse_skattefri_efter_sømandsbeskatningslov4_stk2_kroner = rejser.samlet_skattefri_godtgørelse_kroner
    = rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner = rejser.samlet_skattepligtig_godtgørelse_kroner
    = skattepligtige_godtgørelser_kroner = erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner + rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner
    = befordring_før_ligningslov9g = personskat_befordringsfradrag_resultat(input = input.befordring, lønmodtager = lønmodtager, skattepligtige_godtgørelser_kroner = skattepligtige_godtgørelser_kroner, personlig_indkomst = personlig_indkomst)
    = befordring = personskat_befordringsfradrag_resultat(input = personskat_ll9g_befordringsfradrag_input(input.befordring, fiskerfradragssamordning), lønmodtager = lønmodtager, skattepligtige_godtgørelser_kroner = skattepligtige_godtgørelser_kroner, personlig_indkomst = personlig_indkomst)
    = faglige_kontingenter_før_ligningslov9g = ligningslov13_årsresultat(lønmodtager.skatteår, input.faglige_kontingenter)
    = faglige_kontingenter = ligningslov13_årsresultat(lønmodtager.skatteår, personskat_ll9g_faglige_kontingenter_input(input.faglige_kontingenter, fiskerfradragssamordning))
    = arbejdsløshed_efterløn_og_fleksydelse = pbl49_til49b_årsresultat(lønmodtager.skatteår, input.arbejdsløshed_efterløn_og_fleksydelse)
    = gaver = ligningslov_gave_årsresultat(lønmodtager.skatteår, input.gaver, ligningslov12_indkomstgrundlag)
