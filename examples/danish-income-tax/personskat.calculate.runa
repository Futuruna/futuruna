    = befordring_fradrag_anvendt_kroner = personskat_søbl4_beløb_anvendt_kroner(beløb_før_par4_kroner = befordring_fradrag_før_par4_kroner, kilde = Søbl4Ligningslov9COg9DBefordringsfradrag, input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag)
    = faglige_kontingenter_fradrag_anvendt_kroner = personskat_søbl4_beløb_anvendt_kroner(beløb_før_par4_kroner = faglige_kontingenter.samlet_fradrag_kroner, kilde = Søbl4Ligningslov13Årsfradrag, input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag)
    = pbl49_stk1_fradrag_før_ligningslov9g_kroner = personskat_pbl49_stk1_fradrag_kroner(resultat = arbejdsløshed_efterløn_og_fleksydelse)
    = pbl49_stk1_fradrag_før_par4_kroner = personskat_ll9g_pbl49_stk1_fradrag_anvendt_kroner(arbejdsløshed_efterløn_og_fleksydelse, fiskerfradragssamordning)
    = pbl49_stk1_fradrag_anvendt_kroner = personskat_ll9g_og_søbl4_pbl49_stk1_fradrag_anvendt_kroner(resultat = arbejdsløshed_efterløn_og_fleksydelse, koordinering = fiskerfradragssamordning, input = input.sømandsbeskatningslov4, sømandsfradrag = sømandsfradrag)
    = pbl49a_og_49b_fradrag_anvendt_kroner = personskat_pbl49a_og_49b_fradrag_kroner(resultat = arbejdsløshed_efterløn_og_fleksydelse)
    = samlet_afskåret_efter_ligningslov9g_kroner = øvrige_lønmodtagerudgifter_før_ligningslov9g.samlet_fradrag_kroner - øvrige_lønmodtagerudgifter.samlet_fradrag_kroner + rejser_før_sømandsbeskatningslov4_stk2.samlet_ll9a_fradrag_efter_årsloft_kroner - rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner + erhvervsbefordring_fradrag_før_ligningslov9g_kroner - erhvervsbefordring_fradrag_før_par4_kroner + befordring_fradrag_før_ligningslov9g_kroner - befordring_fradrag_før_par4_kroner + faglige_kontingenter_før_ligningslov9g.samlet_fradrag_kroner - faglige_kontingenter.samlet_fradrag_kroner + pbl49_stk1_fradrag_før_ligningslov9g_kroner - pbl49_stk1_fradrag_før_par4_kroner
    = samlet_afskåret_efter_sømandsbeskatningslov4_kroner = erhvervsbefordring_fradrag_før_par4_kroner - erhvervsbefordring_fradrag_anvendt_kroner + rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner - rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner + lønmodtagerudgifter_fradrag_før_par4_kroner - lønmodtagerudgifter_fradrag_anvendt_kroner + befordring_fradrag_før_par4_kroner - befordring_fradrag_anvendt_kroner + faglige_kontingenter.samlet_fradrag_kroner - faglige_kontingenter_fradrag_anvendt_kroner + pbl49_stk1_fradrag_før_par4_kroner - pbl49_stk1_fradrag_anvendt_kroner
    = alle_input_gyldige = fiskerfradragssamordning.samordning_gyldig && sømandsfradrag.alle_input_gyldige && sømandsbeskatningslov4_kildetilknytninger_gyldige && sømandsbeskatningslov4_påkrævede_kilder_tilknyttet && øvrige_lønmodtagerudgifter_før_ligningslov9g.alle_input_gyldige && øvrige_lønmodtagerudgifter.alle_input_gyldige && personskat_befordringsfradrag_input_gyldigt(befordring_før_ligningslov9g) && personskat_befordringsfradrag_input_gyldigt(befordring) && rejser.alle_input_gyldige && faglige_kontingenter_før_ligningslov9g.alle_input_gyldige && faglige_kontingenter.alle_input_gyldige && arbejdsløshed_efterløn_og_fleksydelse.alle_input_gyldige && gaver.alle_input_gyldige
    PersonskatLigningsfradragResultat(
        input = input,
        sømandsfradrag = sømandsfradrag,
        sømandsbeskatningslov4_kildetilknytninger_gyldige = sømandsbeskatningslov4_kildetilknytninger_gyldige,
        sømandsbeskatningslov4_påkrævede_kilder_tilknyttet = sømandsbeskatningslov4_påkrævede_kilder_tilknyttet,
        fiskerfradragssamordning = fiskerfradragssamordning,
        øvrige_lønmodtagerudgifter = øvrige_lønmodtagerudgifter,
        befordring_før_ligningslov9g = befordring_før_ligningslov9g,
        befordring = befordring,
        rejser_før_sømandsbeskatningslov4_stk2 = rejser_før_sømandsbeskatningslov4_stk2,
        rejser = rejser,
        faglige_kontingenter = faglige_kontingenter,
        arbejdsløshed_efterløn_og_fleksydelse = arbejdsløshed_efterløn_og_fleksydelse,
        gaver = gaver,
        erhvervsbefordring_skattefri_godtgørelse_før_par4_kroner = erhvervsbefordring_skattefri_godtgørelse_før_par4_kroner,
        erhvervsbefordring_skattefri_godtgørelse_efter_par4_kroner = erhvervsbefordring_skattefri_godtgørelse_efter_par4_kroner,
        erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner = erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner,
        rejsegodtgørelse_skattefri_før_sømandsbeskatningslov4_stk2_kroner = rejsegodtgørelse_skattefri_før_sømandsbeskatningslov4_stk2_kroner,
        rejsegodtgørelse_skattefri_efter_sømandsbeskatningslov4_stk2_kroner = rejsegodtgørelse_skattefri_efter_sømandsbeskatningslov4_stk2_kroner,
        rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner = rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner,
        erhvervsbefordring_fradrag_før_par4_kroner = erhvervsbefordring_fradrag_før_par4_kroner,
        erhvervsbefordring_fradrag_anvendt_kroner = erhvervsbefordring_fradrag_anvendt_kroner,
        rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner = rejsefradrag_før_sømandsbeskatningslov4_stk2_kroner,
        rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner = rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner,
        dobbelt_husførelse_før_sømandsbeskatningslov4_stk2_kroner = dobbelt_husførelse_før_sømandsbeskatningslov4_stk2_kroner,
        dobbelt_husførelse_efter_sømandsbeskatningslov4_stk2_kroner = dobbelt_husførelse_efter_sømandsbeskatningslov4_stk2_kroner,
        lønmodtagerudgifter_fradragsgrundlag_før_par4_kroner = lønmodtagerudgifter_fradragsgrundlag_før_par4_kroner,
        lønmodtagerudgifter_fradragsgrundlag_efter_par4_kroner = lønmodtagerudgifter_fradragsgrundlag_efter_par4_kroner,
        lønmodtagerudgifter_fradrag_før_par4_kroner = lønmodtagerudgifter_fradrag_før_par4_kroner,
        lønmodtagerudgifter_fradrag_anvendt_kroner = lønmodtagerudgifter_fradrag_anvendt_kroner,
        befordring_fradrag_før_par4_kroner = befordring_fradrag_før_par4_kroner,
        befordring_fradrag_anvendt_kroner = befordring_fradrag_anvendt_kroner,
        faglige_kontingenter_fradrag_anvendt_kroner = faglige_kontingenter_fradrag_anvendt_kroner,
        pbl49_stk1_fradrag_før_par4_kroner = pbl49_stk1_fradrag_før_par4_kroner,
        pbl49_stk1_fradrag_anvendt_kroner = pbl49_stk1_fradrag_anvendt_kroner,
        pbl49a_og_49b_fradrag_anvendt_kroner = pbl49a_og_49b_fradrag_anvendt_kroner,
        samlet_afskåret_efter_ligningslov9g_kroner = samlet_afskåret_efter_ligningslov9g_kroner,
        samlet_afskåret_efter_sømandsbeskatningslov4_kroner = samlet_afskåret_efter_sømandsbeskatningslov4_kroner,
        alle_input_gyldige = alle_input_gyldige,
        samlet_ligningsfradrag_kroner = hvis alle_input_gyldige { fiskerfradragssamordning.fiskerfradrag.samlet_fradrag_kroner + sømandsfradrag.samlet_fradrag_kroner + rejsefradrag_efter_sømandsbeskatningslov4_stk2_kroner + dobbelt_husførelse_efter_sømandsbeskatningslov4_stk2_kroner + lønmodtagerudgifter_fradrag_anvendt_kroner + befordring_fradrag_anvendt_kroner + faglige_kontingenter_fradrag_anvendt_kroner + pbl49_stk1_fradrag_anvendt_kroner + pbl49a_og_49b_fradrag_anvendt_kroner + gaver.samlet_fradrag_kroner } ellers { 0 },
        personlig_indkomst_kroner = personskat_befordring_personlig_indkomst_kroner(befordring),
        arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner = personskat_befordring_arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner(befordring)
    )
}

| personskat_kapital_reklassifikation(næringsstatus: Næringsstatus) -> par4_reklassifikation_fra_næringsstatus(næringsstatus)
| personskat_ligningslov6_input_gyldigt(input: PersonskatLigningslov6Input, skatteår: Heltal) -> match input {
    | UdenLigningslov6Kurstab -> Sandt
    | MedLigningslov6Kurstab(ll6_input) -> ll6_input.indkomstår == skatteår && ligningslov6_kurstab_input_gyldigt(ll6_input)
}
| personskat_ligningslov6_resultat(input: PersonskatLigningslov6Input, skatteår: Heltal) -> match input {
    | UdenLigningslov6Kurstab -> ligningslov6_intet_kurstab_resultat(skatteår)
    | MedLigningslov6Kurstab(ll6_input) -> ligningslov6_kurstab_resultat(ll6_input)
}
| personskat_ligningslov6_resultat_anvendt(input: PersonskatLigningslov6Input, skatteår: Heltal) -> hvis personskat_ligningslov6_input_gyldigt(input, skatteår) { personskat_ligningslov6_resultat(input, skatteår) } ellers { ligningslov6_intet_kurstab_resultat(skatteår) }
| personskat_ligningslov6a_input_gyldigt(input: PersonskatLigningslov6AInput, skatteår: Heltal) -> match input {
    | UdenLigningslov6AFradrag -> Sandt
    | MedLigningslov6AFradrag(ll6a_input) -> ll6a_input.indkomstår == skatteår && ligningslov6a_input_gyldigt(ll6a_input)
}
| personskat_ligningslov6a_resultat(input: PersonskatLigningslov6AInput, skatteår: Heltal) -> match input {
    | UdenLigningslov6AFradrag -> ligningslov6a_intet_fradrag_resultat(skatteår)
    | MedLigningslov6AFradrag(ll6a_input) -> ligningslov6a_resultat(ll6a_input)
}
| personskat_ligningslov6a_resultat_anvendt(input: PersonskatLigningslov6AInput, skatteår: Heltal) -> hvis personskat_ligningslov6a_input_gyldigt(input, skatteår) { personskat_ligningslov6a_resultat(input, skatteår) } ellers { ligningslov6a_intet_fradrag_resultat(skatteår) }
| personskat_ejendomsavance_fremførsel_gyldig(fremførsel: PersonskatEjendomsavanceFremførsel, skatteår: Heltal) -> match fremførsel {
    | UdenFremførtEjendomstab -> Sandt
    | MedFremførtEjendomstab(fra_indkomstår, tab_kroner) -> fra_indkomstår + 1 == skatteår && tab_kroner >= 0
}
| personskat_ejendomsavance_fremførsel(fremførsel: PersonskatEjendomsavanceFremførsel) -> match fremførsel {
    | UdenFremførtEjendomstab -> EblIngenFremførsel
    | MedFremførtEjendomstab(fra_indkomstår, tab_kroner) -> EblFremførtTabFraForrigeIndkomstår(fra_indkomstår = fra_indkomstår, tab_kroner = tab_kroner)
}
| personskat_ejendomsavance_input(fakta: PersonskatEjendomsavanceFakta) -> EjendomsavancebeskatningslovInput(
    indkomstår = fakta.afståelsesdato.år,
    afståelsesdato = fakta.afståelsesdato,
    afståelse = fakta.afståelse,
    erhvervet_som_led_i_næring = fakta.erhvervet_som_led_i_næring,
    kontant_anskaffelsessum_kroner = fakta.kontant_anskaffelsessum_kroner,
    gæld_kursværdi_ved_anskaffelse_kroner = fakta.gæld_kursværdi_ved_anskaffelse_kroner,
    par5_fakta = fakta.par5_fakta,
    par4_stk8_anskaffelse_udeladt_kroner = fakta.par4_stk8_anskaffelse_udeladt_kroner,
    kontant_afståelsessum_kroner = fakta.kontant_afståelsessum_kroner,
    overdragne_gældsposter_kursværdi_kroner = fakta.overdragne_gældsposter_kursværdi_kroner,
    par4_stk8_afståelsesværdi_udeladt_kroner = fakta.par4_stk8_afståelsesværdi_udeladt_kroner,
    ejendomstype = fakta.ejendomstype,
    par11_stk2_valg = fakta.par11_stk2_valg,
    par6d_valg = fakta.par6d_valg
)
| personskat_ejendomsavance_afståelsesresultat(fakta: PersonskatEjendomsavanceFakta) -> ejendomsavancebeskatningslov_resultat(personskat_ejendomsavance_input(fakta))
| personskat_ejendomsavance_afståelsesresultater(afståelser: List(PersonskatEjendomsavanceFakta)) -> map(afståelser, personskat_ejendomsavance_afståelsesresultat)
| personskat_ejendomsavance_identifikation_unik(afståelser: List(PersonskatEjendomsavanceFakta), fakta: PersonskatEjendomsavanceFakta) -> length(filter(afståelser, |anden: PersonskatEjendomsavanceFakta| anden.identifikation == fakta.identifikation)) == 1
| personskat_ejendomsavance_grundfakta_gyldige(afståelser: List(PersonskatEjendomsavanceFakta), fakta: PersonskatEjendomsavanceFakta, resultat: EjendomsavancebeskatningslovResultat, skatteår: Heltal) -> fakta.identifikation != "" && personskat_ejendomsavance_identifikation_unik(afståelser, fakta) && fakta.afståelsesdato.år <= skatteår && resultat.input_gyldigt
| personskat_ejendomsavance_afståelser_grundfakta_gyldige(afståelser: List(PersonskatEjendomsavanceFakta), skatteår: Heltal) -> all(afståelser, |fakta: PersonskatEjendomsavanceFakta| personskat_ejendomsavance_grundfakta_gyldige(afståelser, fakta, personskat_ejendomsavance_afståelsesresultat(fakta), skatteår))
| personskat_ejendomsavance_fortjenesteafgrænsning_understøttet(fakta: PersonskatEjendomsavanceFakta, resultat: EjendomsavancebeskatningslovResultat) -> resultat.regelgrundlag_understøttet && (resultat.omfattet_af_loven || fakta.erhvervet_som_led_i_næring)
| personskat_ejendomsavance_afståelser_fortjenesteafgrænsninger_understøttet(afståelser: List(PersonskatEjendomsavanceFakta)) -> all(afståelser, |fakta: PersonskatEjendomsavanceFakta| personskat_ejendomsavance_fortjenesteafgrænsning_understøttet(fakta, personskat_ejendomsavance_afståelsesresultat(fakta)))
| personskat_ejendomsavance_skadegenopførelsesresultat(fakta: PersonskatEjendomsavanceSkadefakta) -> ebl_par10_resultat(fakta.par10_fakta)
| personskat_ejendomsavance_skadegenopførelsesresultater(skadegenopførelser: List(PersonskatEjendomsavanceSkadefakta)) -> map(skadegenopførelser, personskat_ejendomsavance_skadegenopførelsesresultat)
| personskat_ejendomsavance_skadeidentifikation_unik(skadegenopførelser: List(PersonskatEjendomsavanceSkadefakta), fakta: PersonskatEjendomsavanceSkadefakta) -> length(filter(skadegenopførelser, |anden: PersonskatEjendomsavanceSkadefakta| anden.identifikation == fakta.identifikation)) == 1
| personskat_ejendomsavance_skadegrundfakta_gyldige(skadegenopførelser: List(PersonskatEjendomsavanceSkadefakta), fakta: PersonskatEjendomsavanceSkadefakta, resultat: EblPar10Resultat, skatteår: Heltal) -> fakta.identifikation != "" && personskat_ejendomsavance_skadeidentifikation_unik(skadegenopførelser, fakta) && fakta.par10_fakta.skadedato.år <= skatteår && fakta.par10_fakta.genopførelsesindkomstår <= skatteår && fakta.par10_fakta.skadelidt_ejendom_omfattet_af_par8 == Falskt && resultat.input_gyldigt
| personskat_ejendomsavance_skadegenopførelser_grundfakta_gyldige(skadegenopførelser: List(PersonskatEjendomsavanceSkadefakta), skatteår: Heltal) -> all(skadegenopførelser, |fakta: PersonskatEjendomsavanceSkadefakta| personskat_ejendomsavance_skadegrundfakta_gyldige(skadegenopførelser, fakta, personskat_ejendomsavance_skadegenopførelsesresultat(fakta), skatteår))
| personskat_ejendomsavance_skadegenopførelser_understøttet(skadegenopførelser: List(PersonskatEjendomsavanceSkadefakta)) -> all(skadegenopførelser, |fakta: PersonskatEjendomsavanceSkadefakta| personskat_ejendomsavance_skadegenopførelsesresultat(fakta).regelgrundlag_understøttet)
| personskat_ejendomsavance_skade_ordinær_fortjeneste_i_indkomstår_kroner(resultater: List(EblPar10Resultat), skatteår: Heltal) -> foldl(resultater, 0, |sum: Heltal, resultat: EblPar10Resultat| sum + ebl_par10_ordinær_fortjeneste_i_indkomstår_kroner(resultat, skatteår))
| personskat_ejendomsavance_skade_stk9_erstatningssum_i_indkomstår_kroner(resultater: List(EblPar10Resultat), skatteår: Heltal) -> foldl(resultater, 0, |sum: Heltal, resultat: EblPar10Resultat| sum + ebl_par10_stk9_erstatningssum_i_indkomstår_kroner(resultat, skatteår))
| personskat_ejendomsavance_tabspost_fra_resultat(resultat: EjendomsavancebeskatningslovResultat) -> EjendomsavancePar6Tabspost(resultat = resultat)
| personskat_ejendomsavance_tabspost(fakta: PersonskatEjendomsavanceFakta) -> personskat_ejendomsavance_tabspost_fra_resultat(personskat_ejendomsavance_afståelsesresultat(fakta))
| personskat_ejendomsavance_tabsposter(afståelser: List(PersonskatEjendomsavanceFakta)) -> map(afståelser, personskat_ejendomsavance_tabspost)
| personskat_ejendomsavance_tabsposter_fra_resultater(resultater: List(EjendomsavancebeskatningslovResultat)) -> map(resultater, personskat_ejendomsavance_tabspost_fra_resultat)
| personskat_ejendomsavance_tabsårsgrundlag(afståelser: List(PersonskatEjendomsavanceFakta), fremførsel: PersonskatEjendomsavanceFremførsel, skatteår: Heltal, øvrige_skattepligtige_fortjenester_kroner: Heltal) -> EjendomsavancePar6Tabsårsgrundlag(
    indkomstår = skatteår,
    tabsposter = personskat_ejendomsavance_tabsposter(afståelser),
    fortjenestegrundlag = EblPar6FordeltFortjenesteKroner(beløb_kroner = ejendomsavance_par6_skattepligtige_fortjenester_kroner(personskat_ejendomsavance_afståelsesresultater(afståelser), skatteår) + øvrige_skattepligtige_fortjenester_kroner),
    fremførsel = personskat_ejendomsavance_fremførsel(fremførsel)
)
| personskat_ejendomsavance_fordelt_tabsårsgrundlag(resultater: List(EjendomsavancebeskatningslovResultat), fremførsel: PersonskatEjendomsavanceFremførsel, skatteår: Heltal, fordelt_fortjeneste_kroner: Heltal) -> EjendomsavancePar6Tabsårsgrundlag(
    indkomstår = skatteår,
    tabsposter = personskat_ejendomsavance_tabsposter_fra_resultater(resultater),
    fortjenestegrundlag = EblPar6FordeltFortjenesteKroner(beløb_kroner = fordelt_fortjeneste_kroner),
    fremførsel = personskat_ejendomsavance_fremførsel(fremførsel)
)
| personskat_ejendomsavance_ægtefælledata_relevant(fakta: PersonskatEjendomsavanceÅrsfakta) -> fakta.gift_samlevende_ved_indkomstårets_udgang || (length(fakta.ægtefælles_afståelser) == 0 && length(fakta.ægtefælles_skadegenopførelser) == 0 && fakta.ægtefælles_fremførte_tab == UdenFremførtEjendomstab)
| personskat_ejendomsavance_resultat(input: PersonskatEjendomsavanceInput, skatteår: Heltal) -> match input {
    | UdenEjendomsavance -> IngenEjendomsavance
    | MedEjendomsavance(fakta) -> {
        = egne_grundfakta_gyldige = personskat_ejendomsavance_afståelser_grundfakta_gyldige(fakta.egne_afståelser, skatteår) && personskat_ejendomsavance_skadegenopførelser_grundfakta_gyldige(fakta.egne_skadegenopførelser, skatteår)
        = ægtefælles_grundfakta_gyldige = personskat_ejendomsavance_afståelser_grundfakta_gyldige(fakta.ægtefælles_afståelser, skatteår) && personskat_ejendomsavance_skadegenopførelser_grundfakta_gyldige(fakta.ægtefælles_skadegenopførelser, skatteår)
        = grundfakta_gyldige = skatteår > 0 && egne_grundfakta_gyldige && ægtefælles_grundfakta_gyldige
        = egne_fortjenesteafgrænsninger_understøttet = personskat_ejendomsavance_afståelser_fortjenesteafgrænsninger_understøttet(fakta.egne_afståelser) && personskat_ejendomsavance_skadegenopførelser_understøttet(fakta.egne_skadegenopførelser)
        = ægtefælles_fortjenesteafgrænsninger_understøttet = personskat_ejendomsavance_afståelser_fortjenesteafgrænsninger_understøttet(fakta.ægtefælles_afståelser) && personskat_ejendomsavance_skadegenopførelser_understøttet(fakta.ægtefælles_skadegenopførelser)
        = fortjenesteafgrænsninger_understøttet = egne_fortjenesteafgrænsninger_understøttet && ægtefælles_fortjenesteafgrænsninger_understøttet
        = egne_årsforløb_dækker_skatteår = ejendomsavance_par6_resultater_dækker_indkomstår(personskat_ejendomsavance_afståelsesresultater(fakta.egne_afståelser), skatteår)
        = ægtefælles_årsforløb_dækker_skatteår = ejendomsavance_par6_resultater_dækker_indkomstår(personskat_ejendomsavance_afståelsesresultater(fakta.ægtefælles_afståelser), skatteår)
        = årsforløb_dækker_skatteår = egne_årsforløb_dækker_skatteår && ægtefælles_årsforløb_dækker_skatteår
        = fremførsler_gyldige = personskat_ejendomsavance_fremførsel_gyldig(fakta.eget_fremført_tab, skatteår) && personskat_ejendomsavance_fremførsel_gyldig(fakta.ægtefælles_fremførte_tab, skatteår)
        = ægtefælledata_relevant = personskat_ejendomsavance_ægtefælledata_relevant(fakta)
        hvis grundfakta_gyldige && fortjenesteafgrænsninger_understøttet && årsforløb_dækker_skatteår && fremførsler_gyldige && ægtefælledata_relevant {
            = egne_afståelsesresultater = personskat_ejendomsavance_afståelsesresultater(fakta.egne_afståelser)
            = egne_skadegenopførelsesresultater = personskat_ejendomsavance_skadegenopførelsesresultater(fakta.egne_skadegenopførelser)
            = ægtefælles_afståelsesresultater = personskat_ejendomsavance_afståelsesresultater(fakta.ægtefælles_afståelser)
            = ægtefælles_skadegenopførelsesresultater = personskat_ejendomsavance_skadegenopførelsesresultater(fakta.ægtefælles_skadegenopførelser)
            = egne_ordinære_skadefortjenester_kroner = personskat_ejendomsavance_skade_ordinær_fortjeneste_i_indkomstår_kroner(egne_skadegenopførelsesresultater, skatteår)
            = ægtefælles_ordinære_skadefortjenester_kroner = personskat_ejendomsavance_skade_ordinær_fortjeneste_i_indkomstår_kroner(ægtefælles_skadegenopførelsesresultater, skatteår)
            = ægtefællepar_resultat = ejendomsavance_par6_ægtefællepar_resultat(EjendomsavancePar6ÆgtefælleparInput(
                venstre = personskat_ejendomsavance_tabsårsgrundlag(fakta.egne_afståelser, fakta.eget_fremført_tab, skatteår, egne_ordinære_skadefortjenester_kroner),
                højre = personskat_ejendomsavance_tabsårsgrundlag(fakta.ægtefælles_afståelser, fakta.ægtefælles_fremførte_tab, skatteår, ægtefælles_ordinære_skadefortjenester_kroner),
                gift_samlevende_ved_indkomstårets_udgang = fakta.gift_samlevende_ved_indkomstårets_udgang
            ))
            = eget_tabsårsresultat = ægtefællepar_resultat.venstre
            = ægtefælles_tabsårsresultat = ægtefællepar_resultat.højre
            = par4_resultat = par4_stk1_nr14_årsresultat(Par4Stk1Nr14Årsinput(
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat,
                skattepligtige_erstatningssummer_efter_ebl_par10_stk9_kroner = personskat_ejendomsavance_skade_stk9_erstatningssum_i_indkomstår_kroner(egne_skadegenopførelsesresultater, skatteår)
            ))
            BeregnetEjendomsavance(
                fakta = fakta,
                egne_afståelsesresultater = egne_afståelsesresultater,
                egne_skadegenopførelsesresultater = egne_skadegenopførelsesresultater,
                ægtefælles_afståelsesresultater = ægtefælles_afståelsesresultater,
                ægtefælles_skadegenopførelsesresultater = ægtefælles_skadegenopførelsesresultater,
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat,
                par4_resultat = par4_resultat
            )
        } ellers {
            UgyldigtEjendomsavancegrundlag(
                fakta = fakta,
                grundfakta_gyldige = grundfakta_gyldige,
                fortjenesteafgrænsninger_understøttet = fortjenesteafgrænsninger_understøttet,
                årsforløb_dækker_skatteår = årsforløb_dækker_skatteår,
                fremførsler_gyldige = fremførsler_gyldige,
                ægtefælledata_relevant = ægtefælledata_relevant
            )
        }
    }
}
| personskat_ejendomsavance_input_gyldigt(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | UgyldigtEjendomsavancegrundlag(_, _, _, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_ejendomsavance_kapitalposter(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, _, _, _, _, _, _, par4_resultat) -> [par4_stk1_nr14_års_kapitalpost(par4_resultat)]
    | _ -> []
}
| personskat_egne_ejendomsavance_resultater(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, egne_afståelsesresultater, _, _, _, _, _, _) -> egne_afståelsesresultater
    | _ -> []
}
| personskat_egne_ejendomsskade_resultater(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, _, egne_skadegenopførelsesresultater, _, _, _, _, _) -> egne_skadegenopførelsesresultater
    | _ -> []
}
| personskat_ægtefælles_ejendomsavance_resultater(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, _, _, ægtefælles_afståelsesresultater, _, _, _, _) -> ægtefælles_afståelsesresultater
    | _ -> []
}
| personskat_ægtefælles_ejendomsskade_resultater(resultat: PersonskatEjendomsavanceResultat) -> match resultat {
    | BeregnetEjendomsavance(_, _, _, _, ægtefælles_skadegenopførelsesresultater, _, _, _) -> ægtefælles_skadegenopførelsesresultater
    | _ -> []
}
| personskat_alle_ejendomsavance_resultater(resultat: PersonskatEjendomsavanceResultat) -> concat(personskat_egne_ejendomsavance_resultater(resultat), personskat_ægtefælles_ejendomsavance_resultater(resultat))
| personskat_ejendomsavance_har_par6d_sælgerpantebrev(resultat: EjendomsavancebeskatningslovResultat) -> match resultat.par6d_resultat.valg {
    | EblMedPar6DValg(_) -> Sandt
    | EblUdenPar6DValg -> Falskt
}
| personskat_egne_par6d_sælgerpantebrevsresultater(resultat: PersonskatEjendomsavanceResultat) -> filter(personskat_egne_ejendomsavance_resultater(resultat), personskat_ejendomsavance_har_par6d_sælgerpantebrev)
| personskat_alle_par6d_sælgerpantebrevsresultater(resultat: PersonskatEjendomsavanceResultat) -> filter(personskat_alle_ejendomsavance_resultater(resultat), personskat_ejendomsavance_har_par6d_sælgerpantebrev)
| personskat_kgl_fakta_matcher_par6d_resultat(fakta: KglEblPar6DSælgerpantebrevsfakta, resultat: EjendomsavancebeskatningslovResultat) -> fakta.sælgerpantebrev_identifikation != "" && fakta.sælgerpantebrev_identifikation == kgl_ebl_par6d_sælgerpantebrev(resultat.par6d_resultat).identifikation
| personskat_kgl_matchende_par6d_resultater(fakta: KglEblPar6DSælgerpantebrevsfakta, resultater: List(EjendomsavancebeskatningslovResultat)) -> filter(resultater, |resultat: EjendomsavancebeskatningslovResultat| personskat_kgl_fakta_matcher_par6d_resultat(fakta, resultat))
| personskat_kgl_matchende_fakta(resultat: EjendomsavancebeskatningslovResultat, fakta: List(KglEblPar6DSælgerpantebrevsfakta)) -> filter(fakta, |pantebrevsfakta: KglEblPar6DSælgerpantebrevsfakta| personskat_kgl_fakta_matcher_par6d_resultat(pantebrevsfakta, resultat))
| personskat_kgl_alle_fakta_matcher_entydigt(fakta: List(KglEblPar6DSælgerpantebrevsfakta), resultater: List(EjendomsavancebeskatningslovResultat)) -> all(fakta, |pantebrevsfakta: KglEblPar6DSælgerpantebrevsfakta| length(personskat_kgl_matchende_par6d_resultater(pantebrevsfakta, resultater)) == 1)
| personskat_kgl_alle_par6d_resultater_matcher_entydigt(resultater: List(EjendomsavancebeskatningslovResultat), fakta: List(KglEblPar6DSælgerpantebrevsfakta)) -> all(resultater, |resultat: EjendomsavancebeskatningslovResultat| length(personskat_kgl_matchende_fakta(resultat, fakta)) == 1)
| personskat_kgl_sælgerpantebrevsresultater(fakta: List(KglEblPar6DSælgerpantebrevsfakta), resultater: List(EjendomsavancebeskatningslovResultat)) -> flat_map(fakta, |pantebrevsfakta: KglEblPar6DSælgerpantebrevsfakta| map(personskat_kgl_matchende_par6d_resultater(pantebrevsfakta, resultater), |resultat: EjendomsavancebeskatningslovResultat| kgl_ebl_par6d_resultat(pantebrevsfakta, resultat.par6d_resultat)))
| personskat_kgl_rå_netto_i_indkomstår_kroner(resultat: KglEblPar6DSælgerpantebrevsresultat, skatteår: Heltal, skatteyder_identifikation: Tekst) -> kgl_sælgerpantebrev_rå_netto_for_skatteyder_i_indkomstår_kroner(resultat.kursgevinstresultat, skatteår, skatteyder_identifikation)
| personskat_kgl_årets_samlede_netto_kroner(resultater: List(KglEblPar6DSælgerpantebrevsresultat), skatteår: Heltal, skatteyder_identifikation: Tekst, øvrigt_netto_kroner: Heltal) -> foldl(resultater, øvrigt_netto_kroner, |sum: Heltal, resultat: KglEblPar6DSælgerpantebrevsresultat| sum + personskat_kgl_rå_netto_i_indkomstår_kroner(resultat, skatteår, skatteyder_identifikation))
| personskat_kgl_gældsidentifikation_unik(gældsposter: List(KursgevinstlovGældFakta), gæld: KursgevinstlovGældFakta) -> gæld.identifikation != "" && length(filter(gældsposter, |anden: KursgevinstlovGældFakta| anden.identifikation == gæld.identifikation)) == 1
| personskat_kgl_gældsinput(gæld: KursgevinstlovGældFakta, skatteår: Heltal) -> kursgevinstlov_gæld_input(skatteår, gæld)
| personskat_kgl_gældsfakta_gyldige(gæld: KursgevinstlovGældFakta, skatteår: Heltal) -> kursgevinstlov_gæld_input_gyldigt(personskat_kgl_gældsinput(gæld, skatteår))
| personskat_kgl_alle_gældsfakta_gyldige(gældsposter: List(KursgevinstlovGældFakta), skatteår: Heltal) -> all(gældsposter, |gæld: KursgevinstlovGældFakta| personskat_kgl_gældsidentifikation_unik(gældsposter, gæld) && personskat_kgl_gældsfakta_gyldige(gæld, skatteår))
| personskat_kgl_gæld_rå_netto_kroner(gæld: KursgevinstlovGældFakta, skatteår: Heltal) -> hvis personskat_kgl_gældsfakta_gyldige(gæld, skatteår) { kgl_gæld_rå_netto_til_par14_23_kroner(gæld) } ellers { 0 }
| personskat_kgl_gældsposters_rå_netto_kroner(gældsposter: List(KursgevinstlovGældFakta), skatteår: Heltal) -> foldl(gældsposter, 0, |sum: Heltal, gæld: KursgevinstlovGældFakta| sum + personskat_kgl_gæld_rå_netto_kroner(gæld, skatteår))
| personskat_kgl_gældsresultater(gældsposter: List(KursgevinstlovGældFakta), skatteår: Heltal, årets_samlede_netto_kroner: Heltal) -> map(gældsposter, |gæld: KursgevinstlovGældFakta| kursgevinstlov_resultat_fra_gæld(personskat_kgl_gældsinput(gæld, skatteår), årets_samlede_netto_kroner))
| personskat_kgl_gældsidentifikation_adskilt_fra_årsnetto(gæld: KursgevinstlovGældFakta, øvrige_instrumenter: KursgevinstlovÅrsnettoInput) -> all(kgl_årsnetto_identifikationer(øvrige_instrumenter), |identifikation: Tekst| identifikation != gæld.identifikation)
| personskat_kgl_gældsposter_adskilt_fra_årsnetto(gældsposter: List(KursgevinstlovGældFakta), øvrige_instrumenter: KursgevinstlovÅrsnettoInput) -> all(gældsposter, |gæld: KursgevinstlovGældFakta| personskat_kgl_gældsidentifikation_adskilt_fra_årsnetto(gæld, øvrige_instrumenter))
| personskat_kgl_legacy_gæld_matcher_valutavalg(gæld: KursgevinstlovGældFakta, valg: KglÅrsnettoPar25Årsvalg) -> valg.valutakursændringer.aktuelt_princip != KglLagerprincip || kgl_gæld_behandles_som_fremmed_valuta(gæld.valuta) == Falskt
| personskat_kgl_alle_legacy_gældsposter_matcher_valutavalg(gældsposter: List(KursgevinstlovGældFakta), valg: KglÅrsnettoPar25Årsvalg) -> all(gældsposter, |gæld: KursgevinstlovGældFakta| personskat_kgl_legacy_gæld_matcher_valutavalg(gæld, valg))
| personskat_kgl_resultater_i_indkomstår(resultat: KglEblPar6DSælgerpantebrevsresultat, skatteår: Heltal, skatteyder_identifikation: Tekst, årets_samlede_netto_kroner: Heltal) -> map(kgl_sælgerpantebrev_personrealiseringer_for_skatteyder_i_indkomstår(resultat.kursgevinstresultat, skatteår, skatteyder_identifikation), |disposition: KglSælgerpantebrevDispositionsresultat| kgl_sælgerpantebrev_kursgevinstlov_resultat(disposition, årets_samlede_netto_kroner, resultat.skatteforhold))
| personskat_kgl_alle_resultater_i_indkomstår(resultater: List(KglEblPar6DSælgerpantebrevsresultat), skatteår: Heltal, skatteyder_identifikation: Tekst, årets_samlede_netto_kroner: Heltal) -> flat_map(resultater, |resultat: KglEblPar6DSælgerpantebrevsresultat| personskat_kgl_resultater_i_indkomstår(resultat, skatteår, skatteyder_identifikation, årets_samlede_netto_kroner))
| personskat_kgl_kapitalpost(resultat: KursgevinstlovResultat) -> par4_stk1_nr2_kapitalpost(Par4Stk1Nr2Input(kursgevinstlov_resultat = resultat))
| personskat_kgl_abl_kapitalpost(resultat: AktieavancebeskatningslovResultat) -> par4_stk1_nr5_kapitalpost(Par4Stk1Nr5Input(aktieavancebeskatningslov_resultat = resultat))
| personskat_kgl_fortjenestemedregninger(resultater: List(KglEblPar6DSælgerpantebrevsresultat)) -> flat_map(resultater, |resultat: KglEblPar6DSælgerpantebrevsresultat| resultat.fortjenestemedregninger)
| personskat_kgl_fortjenestemedregning_tilhører_beregning(medregning: KglEblPar6DFortjenestemedregning, skatteyder_identifikation: Tekst, ægtefælles_skatteyder_identifikation: Tekst) -> medregning.skatteyder.rolle != KglPersonEfterKildeskatteloven || medregning.skatteyder.identifikation == skatteyder_identifikation || (ægtefælles_skatteyder_identifikation != "" && medregning.skatteyder.identifikation == ægtefælles_skatteyder_identifikation)
| personskat_kgl_par32_kontekst_deltager(kontekst: PersonskatKursgevinstPar32PersonKontekst) -> match kontekst { | UdenPar32Årsresultat -> Falskt | MedPar32Årsresultat(_, _, _, _) -> Sandt }
| personskat_kgl_par32_kontekst_gyldig(kontekst: PersonskatKursgevinstPar32PersonKontekst, skatteyder_identifikation: Tekst, skatteår: Heltal) -> match kontekst {
    | UdenPar32Årsresultat -> Sandt
    | MedPar32Årsresultat(afledning, årsresultat, personskattelov_resultat, forløb_gyldigt) -> forløb_gyldigt && afledning.input_gyldigt && afledning.skatteyder_identifikation == skatteyder_identifikation && afledning.fakta.indkomstår == skatteår && årsresultat.input_gyldigt && årsresultat.identifikation == skatteyder_identifikation && årsresultat.indkomstår == skatteår && personskattelov_resultat.kursgevinstlov_par32_årsresultat == årsresultat && personskattelov_resultat.fuldt_klassificeret
}
| personskat_kgl_par32_kontekst_matcher_input(input: PersonskatKursgevinstInput, kontekst: PersonskatKursgevinstPar32PersonKontekst) -> match input {
    | UdenKursgevinst -> personskat_kgl_par32_kontekst_deltager(kontekst) == Falskt
    | MedKursgevinst(fakta) -> match fakta.par32_kontraktforløb {
        | UdenPar32Kontraktforløb -> personskat_kgl_par32_kontekst_deltager(kontekst) == Falskt
        | MedPar32Kontraktforløb(_, _) -> personskat_kgl_par32_kontekst_deltager(kontekst)
    }
}
| personskat_kgl_par32_kapitalposter(kontekst: PersonskatKursgevinstPar32PersonKontekst) -> match kontekst {
    | UdenPar32Årsresultat -> []
    | MedPar32Årsresultat(_, _, personskattelov_resultat, forløb_gyldigt) -> hvis forløb_gyldigt { par4_stk1_nr2_års_kapitalposter(personskattelov_resultat) } ellers { [] }
}

# PersonskatKursgevinstSag(input: PersonskatKursgevinstInput, skatteår: Heltal, ejendomsavance_resultat: PersonskatEjendomsavanceResultat, par32: PersonskatKursgevinstPar32PersonKontekst) {
    | par6d_resultater() -> personskat_alle_par6d_sælgerpantebrevsresultater(ejendomsavance_resultat)
    | sælgerpantebrevsfakta() -> match input {
        | UdenKursgevinst -> []
        | MedKursgevinst(fakta) -> fakta.sælgerpantebreve
    }
    | gældsposter() -> match input {
        | UdenKursgevinst -> []
        | MedKursgevinst(fakta) -> fakta.gældsposter
    }
    | øvrige_instrumenter() -> match input {
        | UdenKursgevinst -> kgl_årsnetto_tomt_input()
        | MedKursgevinst(fakta) -> fakta.øvrige_instrumenter
    }
    | øvrige_instrumenter_har_fakta() -> length(øvrige_instrumenter().fordringer) > 0 || length(øvrige_instrumenter().valutainstrumenter) > 0 || length(øvrige_instrumenter().obligationsbaserede_minimumsbeviser) > 0
    | øvrige_instrumenter_forberedelse() -> kursgevinstlov_årsnetto_resultat(øvrige_instrumenter(), skatteår, 0)
    | skatteyder_identifikation() -> match input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> fakta.skatteyder_identifikation
    }
    | ægtefælles_skatteyder_identifikation() -> match input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> match fakta.ægtefælles_skatteyder_identifikation {
            | Some(identifikation) -> identifikation
            | None -> ""
        }
    }
    | inputvariant_matcher_ebl() -> match input {
        | UdenKursgevinst -> length(par6d_resultater()) == 0
        | MedKursgevinst(_) -> (length(sælgerpantebrevsfakta()) > 0 || length(gældsposter()) > 0 || øvrige_instrumenter_har_fakta() || personskat_kgl_par32_har_forløb(input) || personskat_kgl_par32_kontekst_deltager(par32)) && personskat_kgl_alle_fakta_matcher_entydigt(sælgerpantebrevsfakta(), par6d_resultater()) && personskat_kgl_alle_par6d_resultater_matcher_entydigt(par6d_resultater(), sælgerpantebrevsfakta())
    }
    | sælgerpantebrevsresultater() -> personskat_kgl_sælgerpantebrevsresultater(sælgerpantebrevsfakta(), par6d_resultater())
    | alle_sælgerpantebrevsresultater_gyldige() -> all(sælgerpantebrevsresultater(), |resultat: KglEblPar6DSælgerpantebrevsresultat| resultat.input_gyldigt)
    | alle_gældsfakta_gyldige() -> personskat_kgl_alle_gældsfakta_gyldige(gældsposter(), skatteår)
    | gældsposter_matcher_årsnetto() -> personskat_kgl_gældsposter_adskilt_fra_årsnetto(gældsposter(), øvrige_instrumenter()) && personskat_kgl_alle_legacy_gældsposter_matcher_valutavalg(gældsposter(), øvrige_instrumenter().par25_valg)
    | skatteyderidentifikationer_gyldige() -> skatteyder_identifikation() != "" && (ægtefælles_skatteyder_identifikation() == "" || ægtefælles_skatteyder_identifikation() != skatteyder_identifikation())
    | fortjenestefordeling_dækker_beregning() -> all(personskat_kgl_fortjenestemedregninger(sælgerpantebrevsresultater()), |medregning: KglEblPar6DFortjenestemedregning| personskat_kgl_fortjenestemedregning_tilhører_beregning(medregning, skatteyder_identifikation(), ægtefælles_skatteyder_identifikation()))
    | par32_gyldigt() -> personskat_kgl_par32_kontekst_matcher_input(input, par32) && personskat_kgl_par32_kontekst_gyldig(par32, skatteyder_identifikation(), skatteår)
    | input_gyldigt() -> skatteår > 0 && inputvariant_matcher_ebl() && match input { | UdenKursgevinst -> Sandt | MedKursgevinst(_) -> skatteyderidentifikationer_gyldige() } && alle_sælgerpantebrevsresultater_gyldige() && alle_gældsfakta_gyldige() && gældsposter_matcher_årsnetto() && øvrige_instrumenter_forberedelse().input_gyldigt && fortjenestefordeling_dækker_beregning() && par32_gyldigt()
    | gældsposters_rå_netto_kroner() -> personskat_kgl_gældsposters_rå_netto_kroner(gældsposter(), skatteår)
    | årets_samlede_netto_efter_par14_kroner() -> personskat_kgl_årets_samlede_netto_kroner(sælgerpantebrevsresultater(), skatteår, skatteyder_identifikation(), øvrige_instrumenter_forberedelse().rå_netto_til_par14_og_abl22_kroner + gældsposters_rå_netto_kroner())
    | gældsresultater() -> personskat_kgl_gældsresultater(gældsposter(), skatteår, årets_samlede_netto_efter_par14_kroner())
    | øvrige_instrumentresultat() -> kursgevinstlov_årsnetto_resultat(øvrige_instrumenter(), skatteår, årets_samlede_netto_efter_par14_kroner())
    | kursgevinstlov_resultater_før_validering() -> concat(concat(personskat_kgl_alle_resultater_i_indkomstår(sælgerpantebrevsresultater(), skatteår, skatteyder_identifikation(), årets_samlede_netto_efter_par14_kroner()), gældsresultater()), øvrige_instrumentresultat().kursgevinstlov_resultater)
    | kursgevinstlov_resultater() -> hvis input_gyldigt() { kursgevinstlov_resultater_før_validering() } ellers { [] }
    | aktieavancebeskatningslov_resultater() -> hvis input_gyldigt() { øvrige_instrumentresultat().aktieavancebeskatningslov_resultater } ellers { [] }
    | kapitalposter() -> concat(concat(map(kursgevinstlov_resultater(), personskat_kgl_kapitalpost), map(aktieavancebeskatningslov_resultater(), personskat_kgl_abl_kapitalpost)), personskat_kgl_par32_kapitalposter(par32))
    | resultat() -> PersonskatKursgevinstResultat(
        input = input,
        input_gyldigt = input_gyldigt(),
        sælgerpantebrevsresultater = sælgerpantebrevsresultater(),
        gældsresultater = gældsresultater(),
        øvrige_instrumentresultat = øvrige_instrumentresultat(),
        årets_samlede_netto_efter_par14_kroner = årets_samlede_netto_efter_par14_kroner(),
        kursgevinstlov_resultater = kursgevinstlov_resultater(),
        aktieavancebeskatningslov_resultater = aktieavancebeskatningslov_resultater(),
        par32 = par32,
        kapitalposter = kapitalposter()
    )
}

| personskat_kursgevinst_resultat_med_par32(input: PersonskatKursgevinstInput, skatteår: Heltal, ejendomsavance_resultat: PersonskatEjendomsavanceResultat, par32: PersonskatKursgevinstPar32PersonKontekst) -> PersonskatKursgevinstSag(input, skatteår, ejendomsavance_resultat, par32).resultat()
| personskat_kursgevinst_resultat(input: PersonskatKursgevinstInput, skatteår: Heltal, ejendomsavance_resultat: PersonskatEjendomsavanceResultat) -> personskat_kursgevinst_resultat_med_par32(input, skatteår, ejendomsavance_resultat, UdenPar32Årsresultat)
| personskat_ejendomsavance_afståelsesårets_par6d_medregning_kroner(resultat: EjendomsavancebeskatningslovResultat) -> ebl_par6d_medregnet_fortjeneste_i_indkomstår_kroner(resultat.par6d_resultat, resultat.indkomstår)
| personskat_ejendomsavance_afståelsesårsgrundfortjeneste_kroner(resultat: EjendomsavancebeskatningslovResultat, skatteår: Heltal) -> hvis resultat.indkomstår == skatteår { resultat.skattepligtig_fortjeneste_kroner - personskat_ejendomsavance_afståelsesårets_par6d_medregning_kroner(resultat) } ellers { 0 }
| personskat_ejendomsavance_afståelsesårsgrundfortjenester_kroner(resultater: List(EjendomsavancebeskatningslovResultat), skatteår: Heltal) -> foldl(resultater, 0, |sum: Heltal, resultat: EjendomsavancebeskatningslovResultat| sum + personskat_ejendomsavance_afståelsesårsgrundfortjeneste_kroner(resultat, skatteår))
| personskat_kgl_ebl_medregning_tilhører_person_i_indkomstår(medregning: KglEblPar6DFortjenestemedregning, skatteår: Heltal, skatteyder_identifikation: Tekst) -> skatteyder_identifikation != "" && medregning.medregning.indkomstår == skatteår && medregning.skatteyder.rolle == KglPersonEfterKildeskatteloven && medregning.skatteyder.identifikation == skatteyder_identifikation
| personskat_kgl_ebl_fordelt_fortjeneste_for_person_i_indkomstår_kroner(resultater: List(KglEblPar6DSælgerpantebrevsresultat), skatteår: Heltal, skatteyder_identifikation: Tekst) -> foldl(personskat_kgl_fortjenestemedregninger(resultater), 0, |sum: Heltal, medregning: KglEblPar6DFortjenestemedregning| sum + hvis personskat_kgl_ebl_medregning_tilhører_person_i_indkomstår(medregning, skatteår, skatteyder_identifikation) { medregning.medregning.beløb_kroner } ellers { 0 })

# PersonskatEjendomsavanceFordelingsSag(ejendomsavance_resultat: PersonskatEjendomsavanceResultat, kursgevinst_resultat: PersonskatKursgevinstResultat, skatteår: Heltal) {
    | skatteyder_identifikation() -> match kursgevinst_resultat.input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> fakta.skatteyder_identifikation
    }
    | ægtefælles_skatteyder_identifikation() -> match kursgevinst_resultat.input {
        | UdenKursgevinst -> ""
        | MedKursgevinst(fakta) -> match fakta.ægtefælles_skatteyder_identifikation {
            | Some(identifikation) -> identifikation
            | None -> ""
        }
    }
    | sælgerpantebrevsresultater() -> kursgevinst_resultat.sælgerpantebrevsresultater
    | egne_fordelte_par6d_fortjenester_kroner() -> personskat_kgl_ebl_fordelt_fortjeneste_for_person_i_indkomstår_kroner(sælgerpantebrevsresultater(), skatteår, skatteyder_identifikation())
    | ægtefælles_fordelte_par6d_fortjenester_kroner() -> personskat_kgl_ebl_fordelt_fortjeneste_for_person_i_indkomstår_kroner(sælgerpantebrevsresultater(), skatteår, ægtefælles_skatteyder_identifikation())
    | resultat() -> match ejendomsavance_resultat {
        | BeregnetEjendomsavance(fakta, egne_afståelsesresultater, egne_skadegenopførelsesresultater, ægtefælles_afståelsesresultater, ægtefælles_skadegenopførelsesresultater, _, _, _) -> hvis kursgevinst_resultat.input_gyldigt {
            = egne_fortjenester_kroner = personskat_ejendomsavance_afståelsesårsgrundfortjenester_kroner(egne_afståelsesresultater, skatteår) + egne_fordelte_par6d_fortjenester_kroner() + personskat_ejendomsavance_skade_ordinær_fortjeneste_i_indkomstår_kroner(egne_skadegenopførelsesresultater, skatteår)
            = ægtefælles_fortjenester_kroner = personskat_ejendomsavance_afståelsesårsgrundfortjenester_kroner(ægtefælles_afståelsesresultater, skatteår) + ægtefælles_fordelte_par6d_fortjenester_kroner() + personskat_ejendomsavance_skade_ordinær_fortjeneste_i_indkomstår_kroner(ægtefælles_skadegenopførelsesresultater, skatteår)
            = ægtefællepar_resultat = ejendomsavance_par6_ægtefællepar_resultat(EjendomsavancePar6ÆgtefælleparInput(
                venstre = personskat_ejendomsavance_fordelt_tabsårsgrundlag(egne_afståelsesresultater, fakta.eget_fremført_tab, skatteår, egne_fortjenester_kroner),
                højre = personskat_ejendomsavance_fordelt_tabsårsgrundlag(ægtefælles_afståelsesresultater, fakta.ægtefælles_fremførte_tab, skatteår, ægtefælles_fortjenester_kroner),
                gift_samlevende_ved_indkomstårets_udgang = fakta.gift_samlevende_ved_indkomstårets_udgang
            ))
            = eget_tabsårsresultat = ægtefællepar_resultat.venstre
            = ægtefælles_tabsårsresultat = ægtefællepar_resultat.højre
            = par4_resultat = par4_stk1_nr14_årsresultat(Par4Stk1Nr14Årsinput(
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat,
                skattepligtige_erstatningssummer_efter_ebl_par10_stk9_kroner = personskat_ejendomsavance_skade_stk9_erstatningssum_i_indkomstår_kroner(egne_skadegenopførelsesresultater, skatteår)
            ))
            BeregnetEjendomsavance(
                fakta = fakta,
                egne_afståelsesresultater = egne_afståelsesresultater,
                egne_skadegenopførelsesresultater = egne_skadegenopførelsesresultater,
                ægtefælles_afståelsesresultater = ægtefælles_afståelsesresultater,
                ægtefælles_skadegenopførelsesresultater = ægtefælles_skadegenopførelsesresultater,
                eget_tabsårsresultat = eget_tabsårsresultat,
                ægtefælles_tabsårsresultat = ægtefælles_tabsårsresultat,
                par4_resultat = par4_resultat
            )
        } ellers { ejendomsavance_resultat }
        | _ -> ejendomsavance_resultat
    }
}

| personskat_ejendomsavance_resultat_med_fortjenestefordeling(ejendomsavance_resultat: PersonskatEjendomsavanceResultat, kursgevinst_resultat: PersonskatKursgevinstResultat, skatteår: Heltal) -> PersonskatEjendomsavanceFordelingsSag(ejendomsavance_resultat, kursgevinst_resultat, skatteår).resultat()
| personskat_kapitalomkostning_identifikation_unik(omkostninger: List(PersonskatKapitalomkostningInput), omkostning: PersonskatKapitalomkostningInput) -> length(filter(omkostninger, |anden: PersonskatKapitalomkostningInput| anden.identifikation == omkostning.identifikation)) == 1
| personskat_kapitalomkostningsresultat(omkostninger: List(PersonskatKapitalomkostningInput), omkostning: PersonskatKapitalomkostningInput, skatteår: Heltal) -> {
    = identifikation_unik = personskat_kapitalomkostning_identifikation_unik(omkostninger, omkostning)
    = par4_resultat = par4_stk2_omkostningsresultat(Par4Stk2Omkostningsinput(
        indkomstår = skatteår,
        anvendelsesår = omkostning.anvendelsesår,
        anvendelse = omkostning.anvendelse,
        omkostningsart = omkostning.omkostningsart,
        beløb_kroner = omkostning.beløb_kroner,
        næringsstatus = omkostning.næringsstatus
    ))
    PersonskatKapitalomkostningsresultat(
        input = omkostning,
        identifikation_unik = identifikation_unik,
        input_gyldigt = omkostning.identifikation != "" && identifikation_unik && par4_resultat.input_gyldigt,
        par4_resultat = par4_resultat
    )
}
| personskat_kapitalomkostning_identifikation_gyldig(resultat: PersonskatKapitalomkostningsresultat) -> resultat.input.identifikation != "" && resultat.identifikation_unik
| personskat_kapitalomkostninger_til_par4(resultater: List(PersonskatKapitalomkostningsresultat)) -> flat_map(resultater, |resultat: PersonskatKapitalomkostningsresultat| hvis personskat_kapitalomkostning_identifikation_gyldig(resultat) { [resultat.par4_resultat] } ellers { [] })

| personskat_udbytte_identifikation_unik(udbytter: List(PersonskatUdbytteFakta), fakta: PersonskatUdbytteFakta) -> length(filter(udbytter, |andet: PersonskatUdbytteFakta| andet.identifikation == fakta.identifikation)) == 1
| personskat_udbytte_aktiv_og_retsforhold_forenelige(fakta: PersonskatUdbytteFakta) -> match fakta.aktiv {
    | PersonskatAlmindeligAktie -> fakta.udlodder == Ll16AAlmindeligtSelskab && fakta.modtager == Ll16AAktuelAktionær
    | PersonskatAndelsbevis(forrentning) -> fakta.udlodder == Ll16AAlmindeligtSelskab && fakta.modtager == Ll16AAktuelAndelshaver && forrentning != IkkeAndelsforeningsudlodning
    | PersonskatMedarbejderejeandel -> fakta.udlodder == Ll16AMedarbejderejevirksomhedEfterSelskabsskattelov1Stk1Nr2J && fakta.modtager == Ll16AMedarbejderdeltager
}
| personskat_udbytte_par4a_afgrænsning(aktiv: PersonskatUdbytteAktiv) -> match aktiv {
    | PersonskatAlmindeligAktie -> AktiepostOmfattetAfStk1
    | PersonskatAndelsbevis(forrentning) -> hvis forrentning == IkkeNormalForrentning { AktiepostUdenforStk1 } ellers { AktiepostOmfattetAfStk1 }
    | PersonskatMedarbejderejeandel -> AktiepostOmfattetAfStk1
}
| personskat_udbytte_andelsforeningsudlodning(aktiv: PersonskatUdbytteAktiv) -> match aktiv {
    | PersonskatAndelsbevis(forrentning) -> forrentning
    | _ -> IkkeAndelsforeningsudlodning
}
| personskat_udbytte_par13a_kildefakta_indkomstår_gyldigt(kildefakta: AktieavancePar13AUdbytteKildefakta, skatteår: Heltal) -> match kildefakta {
    | AblPar13AUdbytteUdenForModregningsgrundlag -> Sandt
    | AblPar13AUdbytteForMarkedsaktieEfterPar12(_, klassifikation) -> klassifikation.indkomstår == skatteår
    | AblPar13AUdbytteForMarkedsaktieEfterPar19B(_, klassifikation) -> klassifikation.indkomstår == skatteår
    | AblPar13AUdbytteForAktieOmfattetAfPar44(beholdning, aktie_identifikation) -> match aktieavance_par44_resultat_fra_beholdning(beholdning, aktie_identifikation) {
        | Some(par44_resultat) -> par44_resultat.input.indkomstår == skatteår
        | None -> Falskt
    }
}
| personskat_udbytte_par13a_kildefakta_og_aktiv_forenelige(fakta: PersonskatUdbytteFakta, kilderesultat: AktieavancePar13AUdbytteKilderesultat, skatteår: Heltal) -> kilderesultat.input_gyldigt && personskat_udbytte_par13a_kildefakta_indkomstår_gyldigt(fakta.par13a_kildefakta, skatteår) && (fakta.par13a_kildefakta == AblPar13AUdbytteUdenForModregningsgrundlag || fakta.aktiv == PersonskatAlmindeligAktie)
| personskat_udbytte_ligningslov16a_fakta(fakta: PersonskatUdbytteFakta, skatteår: Heltal) -> Ligningslov16AOrdinærUdlodningsfakta(
    indkomstår = skatteår,
    udlodder = fakta.udlodder,
    modtager = fakta.modtager,
    beløb_kroner = fakta.beløb_kroner
)
| personskat_udbytte_resultat(udbytter: List(PersonskatUdbytteFakta), fakta: PersonskatUdbytteFakta, skatteår: Heltal) -> {
    = identifikation_unik = personskat_udbytte_identifikation_unik(udbytter, fakta)
    = aktiv_og_retsforhold_forenelige = personskat_udbytte_aktiv_og_retsforhold_forenelige(fakta)
    = par13a_kilderesultat = aktieavance_par13a_udbytte_kilderesultat(fakta.par13a_kildefakta)
    = par13a_kildefakta_og_aktiv_forenelige = personskat_udbytte_par13a_kildefakta_og_aktiv_forenelige(fakta, par13a_kilderesultat, skatteår)
    = ligningslov16a_resultat = ligningslov16a_ordinær_udlodning_resultat(personskat_udbytte_ligningslov16a_fakta(fakta, skatteår))
    = input_gyldigt = fakta.identifikation != "" && identifikation_unik && aktiv_og_retsforhold_forenelige && par13a_kildefakta_og_aktiv_forenelige && ligningslov16a_resultat.input_gyldigt
    = par4a_afgrænsning = personskat_udbytte_par4a_afgrænsning(fakta.aktiv)
    = andelsforening_udlodning = personskat_udbytte_andelsforeningsudlodning(fakta.aktiv)
    = par4_input = par4_stk1_nr4_input_fra_ligningslov16a_resultat(
        ligningslov16a_resultat.ligningslov16a_resultat,
        par4a_afgrænsning,
        andelsforening_udlodning
    )
    PersonskatUdbytteResultat(
        fakta = fakta,
        identifikation_unik = identifikation_unik,
        aktiv_og_retsforhold_forenelige = aktiv_og_retsforhold_forenelige,
        par13a_kilderesultat = par13a_kilderesultat,
        par13a_kildefakta_og_aktiv_forenelige = par13a_kildefakta_og_aktiv_forenelige,
        ligningslov16a_resultat = ligningslov16a_resultat,
        input_gyldigt = input_gyldigt,
        par4_input = par4_input,
        par4_resultat = par4_stk1_nr4_resultat(par4_input),
        par4a_resultat = par4a_ligningslov16a_aktiepost_resultat_fra_resultat(ligningslov16a_resultat.ligningslov16a_resultat, par4a_afgrænsning)
    )
}
| personskat_udbytte_par4_kapitalpost(resultat: PersonskatUdbytteResultat) -> par4_stk1_nr4_kapitalpost(resultat.par4_input)
| personskat_udbytte_par4a_aktiepost(resultat: PersonskatUdbytteResultat) -> Par4aAktiepost(
    art = resultat.par4a_resultat.art,
    beløb_kroner = resultat.par4a_resultat.beløb_kroner,
    afgrænsning = resultat.par4a_resultat.afgrænsning,
    personlig_reklassifikation = resultat.par4a_resultat.personlig_reklassifikation
)

| personskat_ordinært_aktieår_resultat_med_modregningsgrundlag(input: PersonskatOrdinærtAktieårInput, modregningsgrundlag: AktieavanceOrdinærPar13AModregningsgrundlag) -> match input {
    | UdenOrdinærtAktieår -> IntetOrdinærtAktieår
    | MedOrdinærtAktieår(årsinput) -> BeregnetOrdinærtAktieår(resultat = aktieavance_ordinaer_person_årsresultat_med_modregningsgrundlag(årsinput, modregningsgrundlag))
}
| personskat_ordinært_aktieår_resultat(input: PersonskatOrdinærtAktieårInput) -> personskat_ordinært_aktieår_resultat_med_modregningsgrundlag(input, aktieavance_ordinaer_tomt_par13a_modregningsgrundlag())
| personskat_ordinært_aktieår_gyldigt(resultat: PersonskatOrdinærtAktieårResultat, skatteår: Heltal) -> match resultat {
    | IntetOrdinærtAktieår -> Sandt
    | BeregnetOrdinærtAktieår(årsresultat) -> årsresultat.alle_input_gyldige && årsresultat.input.indkomstår == skatteår
}
| personskat_ordinære_aktieposter(resultat: PersonskatOrdinærtAktieårResultat) -> match resultat {
    | IntetOrdinærtAktieår -> []
    | BeregnetOrdinærtAktieår(årsresultat) -> [par4a_aktiepost(Par4aAktieavancebeskatningslovInput(
        aktieavancebeskatningslov_resultat = aktieavancebeskatningslov_resultat_fra_ordinaere_aktier(årsresultat.årsresultat)
    ))]
}
| personskat_par17_input_fra_kildefakta(fakta: PersonskatPar17Kildefakta) -> AktieavancePar17Input(
    indkomstår = fakta.indkomstår,
    skatteyder = AktieavancePar17Skatteyder(
        skattepligtsresultat = aktieavance_par6_par7_resultat(fakta.skattepligtsgrundlag),
        næringsstatus = fakta.næringsstatus
    ),
    instrument = fakta.instrument,
    erhvervelsesstatus = fakta.erhvervelsesstatus,
    afståelsessum_kroner = fakta.afståelsessum_kroner,
    anskaffelsessum_kroner = fakta.anskaffelsessum_kroner
)
| personskat_par17_resultat_fra_kildefakta(fakta: PersonskatPar17Kildefakta) -> aktieavance_par17_resultat(personskat_par17_input_fra_kildefakta(fakta))
| personskat_par17_kildefakta_er_person(fakta: PersonskatPar17Kildefakta) -> fakta.skattepligtsgrundlag == AblPar7PersonEfterKildeskatteloven
| personskat_par17_modprøve_fra_kildefakta(fakta: PersonskatPar17Kildefakta) -> AktieavancePar17Modprøve(
    næringsstatus = fakta.næringsstatus,
    erhvervelsesstatus = fakta.erhvervelsesstatus
)
| personskat_ingen_par17_modprøve() -> AktieavancePar17Modprøve(
    næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
    erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
)
| personskat_par17_modprøve_fra_kilde(kilde: PersonskatPar17Modprøvekilde) -> match kilde {
    | UdenPar17Modprøvekilde -> personskat_ingen_par17_modprøve()
    | MedPar17Modprøvekilde(fakta) -> personskat_par17_modprøve_fra_kildefakta(fakta)
}
| personskat_par17_resultat_fra_kilde(kilde: PersonskatPar17Modprøvekilde) -> match kilde {
    | UdenPar17Modprøvekilde -> None
    | MedPar17Modprøvekilde(fakta) -> Some(personskat_par17_resultat_fra_kildefakta(fakta))
}
| personskat_par17_kgl_relation_fra_kilde(kilde: PersonskatPar17Modprøvekilde) -> match kilde {
    | UdenPar17Modprøvekilde -> KglPar32AlmindeligKontrakt
    | MedPar17Modprøvekilde(fakta) -> personskat_par17_resultat_fra_kildefakta(fakta).kgl_par32_kontraktrelation
}
| personskat_øvrigt_særligt_aktieaktiv_abl_input(input: PersonskatØvrigtSærligtAktieaktivInput, par17_modprøve: AktieavancePar17Modprøve) -> AktieavancebeskatningslovInput(
    indkomstår = input.indkomstår,
    aktiv = input.aktiv,
    afståelsessum_kroner = input.afståelsessum_kroner,
    anskaffelsessum_kroner = input.anskaffelsessum_kroner,
    par17_modprøve = par17_modprøve,
    koncernintern_konvertibel_eller_tegningsret = input.koncernintern_konvertibel_eller_tegningsret,
    andelsforening_stiftet_før_22_maj_1987 = input.andelsforening_stiftet_før_22_maj_1987,
    afståelse_sker_for_at_undgå_likvidationsbeskatning = input.afståelse_sker_for_at_undgå_likvidationsbeskatning,
    investeringsklassifikation = input.investeringsklassifikation,
    årets_netto_med_kgl_par14_23_kroner = 0
)
| personskat_øvrigt_aktiv_kræver_par17_modprøvekilde(effektiv_aktiv: AktieavancebeskatningslovAktiv) -> effektiv_aktiv == AblInvesteringsselskab19B || effektiv_aktiv == AblInvesteringsselskab19C || effektiv_aktiv == AblMinimumsbevis21 || effektiv_aktiv == AblMinimumsbevis22
| personskat_par17_instrument_matcher_effektiv_aktiv(instrument: AktieavancePar17Instrument, effektiv_aktiv: AktieavancebeskatningslovAktiv) -> match effektiv_aktiv {
    | AblInvesteringsselskab19A -> instrument == AblPar17UndtagetEfterPar19A
    | AblInvesteringsselskab19B -> instrument == AblPar17UndtagetEfterPar19B
    | AblInvesteringsselskab19C -> instrument == AblPar17UndtagetEfterPar19C
    | AblMinimumsbevis21 -> instrument == AblPar17InvesteringsbevisIMinimumsinstitut
    | AblMinimumsbevis22 -> instrument == AblPar17InvesteringsbevisIMinimumsinstitut
    | _ -> Falskt
}
| personskat_par17_kildefakta_matcher_øvrigt_aktiv(fakta: PersonskatPar17Kildefakta, input: PersonskatØvrigtSærligtAktieaktivInput, resultat: AktieavancebeskatningslovResultat, par17_resultat: AktieavancePar17Resultat) -> personskat_par17_kildefakta_er_person(fakta) && fakta.indkomstår == input.indkomstår && fakta.afståelsessum_kroner == input.afståelsessum_kroner && fakta.anskaffelsessum_kroner == input.anskaffelsessum_kroner && par17_resultat.input_gyldigt && par17_resultat.reglen_finder_anvendelse == Falskt && personskat_par17_instrument_matcher_effektiv_aktiv(fakta.instrument, resultat.effektiv_aktiv)
| personskat_øvrigt_aktiv_par17_kilde_gyldig(kilde: PersonskatPar17Modprøvekilde, input: PersonskatØvrigtSærligtAktieaktivInput, resultat: AktieavancebeskatningslovResultat, par17_resultat: Option(AktieavancePar17Resultat)) -> match kilde {
    | UdenPar17Modprøvekilde -> personskat_øvrigt_aktiv_kræver_par17_modprøvekilde(resultat.effektiv_aktiv) == Falskt
    | MedPar17Modprøvekilde(fakta) -> match par17_resultat {
        | Some(afledt_par17_resultat) -> personskat_par17_kildefakta_matcher_øvrigt_aktiv(fakta, input, resultat, afledt_par17_resultat)
        | None -> Falskt
    }
}
| personskat_særligt_aktieaktiv_enkelt_kilderesultat(fakta: PersonskatSærligtAktieaktivFakta, resultat: AktieavancebeskatningslovResultat, input_gyldigt: Boolsk) -> AktieavancebeskatningslovKilderesultat(
    kildeidentifikation = fakta.identifikation,
    resultat = resultat,
    kildegrundlag = AblSærligtAktiekildegrundlag(markedsstatus = fakta.markedsstatus),
    input_gyldigt = input_gyldigt
)
| personskat_øvrigt_særligt_aktieaktiv_resultat(fakta: PersonskatSærligtAktieaktivFakta, input: PersonskatØvrigtSærligtAktieaktivInput, par17_kilde: PersonskatPar17Modprøvekilde, skatteår: Heltal) -> {
    = par17_resultat = personskat_par17_resultat_fra_kilde(par17_kilde)
    = abl_input = personskat_øvrigt_særligt_aktieaktiv_abl_input(input, personskat_par17_modprøve_fra_kilde(par17_kilde))
    = resultat = aktieavancebeskatningslov_resultat(abl_input)
    = input_gyldigt = input.indkomstår == skatteår && input.aktiv != AblNæringsaktiePar17 && resultat.effektiv_aktiv != AblMinimumsbevis22 && aktieavancebeskatningslov_input_gyldigt(abl_input) && personskat_øvrigt_aktiv_par17_kilde_gyldig(par17_kilde, input, resultat, par17_resultat)
    PersonskatSærligtAktieaktivResultat(
        fakta = fakta,
        resultat = resultat,
        kilderesultater = [personskat_særligt_aktieaktiv_enkelt_kilderesultat(fakta, resultat, input_gyldigt)],
        resultater = [resultat],
        par17_resultat = par17_resultat,
        par35_forløbsresultat = None,
        par37_til40_forløbsresultat = None,
        kgl_par32_kontraktrelation = personskat_par17_kgl_relation_fra_kilde(par17_kilde),
        årets_forfaldne_overdragerskat_kroner = 0,
        årets_betalte_overdragerskat_kroner = 0,
        årets_saldobortfald_kroner = 0,
        årets_nye_henstand_med_fraflytterskat_kroner = 0,
        årets_forfaldne_fraflytterskat_kroner = 0,
        årets_betalte_fraflytterskat_kroner = 0,
        årets_fraflytterskat_saldobortfald_kroner = 0,
        input_gyldigt = input_gyldigt
    )
}
| personskat_par37_til40_fraflytningsdato_gyldig(fakta: PersonskatPar37Til40Fraflytningsfakta) -> dato_gyldig(fakta.fraflytningsdato) && fakta.fraflytningsdato.år == fakta.fraflytningsår
| personskat_par37_til40_kontekstafledning(fakta: PersonskatPar37Til40Fraflytningsfakta, skatteår: Heltal, årskontekst: PersonskatPar37Til40Årskontekst) -> match fakta.kontekstgrundlag {
    | AfledPar37Til40KontekstFraPersonskat -> PersonskatPar37Til40Kontekstafledning(
        kontekst = AktieavancePar37Til40Aktieindkomstkontekst(
            indkomstår = skatteår,
            øvrig_egen_aktieindkomst_kroner = årskontekst.egen_aktieindkomst_kroner,
            ægtefælles_aktieindkomst_kroner = årskontekst.ægtefælles_aktieindkomst_kroner,
            samlevende_med_ægtefælle_ved_indkomstårets_udløb = årskontekst.samlevende_ved_indkomstårets_udløb
        ),
        input_gyldigt = personskat_par37_til40_fraflytningsdato_gyldig(fakta) && fakta.fraflytningsår == skatteår && årskontekst.afledning_tilladt
    )
    | HistoriskPar37Til40Aktieindkomstkontekst(kontekst) -> PersonskatPar37Til40Kontekstafledning(
        kontekst = kontekst,
        input_gyldigt = personskat_par37_til40_fraflytningsdato_gyldig(fakta) && fakta.fraflytningsår < skatteår && kontekst.indkomstår == fakta.fraflytningsår
    )
}
| personskat_par37_til40_fraflytningsfakta(fakta: PersonskatPar37Til40Fraflytningsfakta, kontekst: AktieavancePar37Til40Aktieindkomstkontekst) -> AktieavancePar37Til40Fraflytningsfakta(
    fraflytningsår = fakta.fraflytningsår,
    ophørsgrund = fakta.ophørsgrund,
    tilknytning = fakta.tilknytning,
    aktier = fakta.aktier,
    aktieindkomstkontekst = kontekst,
    indberetning = fakta.indberetning,
    bopæl = fakta.bopæl,
    sikkerhed = fakta.sikkerhed
)
| personskat_par37_til40_forløbsinput(fakta: PersonskatPar37Til40Forløbsfakta, kontekst: AktieavancePar37Til40Aktieindkomstkontekst) -> AktieavancePar37Til40Forløbsinput(
    identifikation = fakta.identifikation,
    opgørelsesår = fakta.opgørelsesår,
    fraflytning = personskat_par37_til40_fraflytningsfakta(fakta.fraflytning, kontekst),
    hændelsesposter = fakta.hændelsesposter,
    kildehistorik = fakta.kildehistorik,
    tilflytning = fakta.tilflytning
)
| personskat_særligt_aktieaktiv_resultat_med_par37_kontekst(fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal, årskontekst: PersonskatPar37Til40Årskontekst) -> match fakta.kilde {
    | PersonskatAktieaktivEfterPar17(par17_fakta) -> {
        = par17_resultat = personskat_par17_resultat_fra_kildefakta(par17_fakta)
        = input_gyldigt = par17_fakta.indkomstår == skatteår && personskat_par17_kildefakta_er_person(par17_fakta) && par17_resultat.input_gyldigt && par17_resultat.reglen_finder_anvendelse
        PersonskatSærligtAktieaktivResultat(
            fakta = fakta,
            resultat = par17_resultat.aktieavancebeskatningslov_resultat,
            kilderesultater = [personskat_særligt_aktieaktiv_enkelt_kilderesultat(fakta, par17_resultat.aktieavancebeskatningslov_resultat, input_gyldigt)],
            resultater = [par17_resultat.aktieavancebeskatningslov_resultat],
            par17_resultat = Some(par17_resultat),
            par35_forløbsresultat = None,
            par37_til40_forløbsresultat = None,
            kgl_par32_kontraktrelation = par17_resultat.kgl_par32_kontraktrelation,
            årets_forfaldne_overdragerskat_kroner = 0,
            årets_betalte_overdragerskat_kroner = 0,
            årets_saldobortfald_kroner = 0,
            årets_nye_henstand_med_fraflytterskat_kroner = 0,
            årets_forfaldne_fraflytterskat_kroner = 0,
            årets_betalte_fraflytterskat_kroner = 0,
            årets_fraflytterskat_saldobortfald_kroner = 0,
            input_gyldigt = input_gyldigt
        )
    }
    | PersonskatØvrigtAktieaktiv(input, par17_kilde) -> personskat_øvrigt_særligt_aktieaktiv_resultat(fakta, input, par17_kilde, skatteår)
    | PersonskatMedarbejderejeordningEfterPar35G(par35_fakta) -> {
        = par35_resultat = aktieavance_par35_forløbsresultat(par35_fakta)
        = input_gyldigt = par35_fakta.opgørelsesår == skatteår && par35_resultat.input_gyldigt
        PersonskatSærligtAktieaktivResultat(
            fakta = fakta,
            resultat = par35_resultat.aktieavancebeskatningslov_resultat,
            kilderesultater = [personskat_særligt_aktieaktiv_enkelt_kilderesultat(fakta, par35_resultat.aktieavancebeskatningslov_resultat, input_gyldigt)],
            resultater = [par35_resultat.aktieavancebeskatningslov_resultat],
            par17_resultat = None,
            par35_forløbsresultat = Some(par35_resultat),
            par37_til40_forløbsresultat = None,
            kgl_par32_kontraktrelation = KglPar32AlmindeligKontrakt,
            årets_forfaldne_overdragerskat_kroner = par35_resultat.årets_nye_forfald_kroner,
            årets_betalte_overdragerskat_kroner = par35_resultat.årets_betalte_overdragerskat_kroner,
            årets_saldobortfald_kroner = par35_resultat.årets_saldobortfald_kroner,
            årets_nye_henstand_med_fraflytterskat_kroner = 0,
            årets_forfaldne_fraflytterskat_kroner = 0,
            årets_betalte_fraflytterskat_kroner = 0,
            årets_fraflytterskat_saldobortfald_kroner = 0,
            input_gyldigt = input_gyldigt
        )
    }
    | PersonskatFraflytteraktierEfterPar37Til40(par37_til40_fakta) -> {
        = kontekstafledning = personskat_par37_til40_kontekstafledning(par37_til40_fakta.fraflytning, skatteår, årskontekst)
        = par37_til40_input = personskat_par37_til40_forløbsinput(par37_til40_fakta, kontekstafledning.kontekst)
        = par37_til40_resultat = aktieavance_par37_til40_forløbsresultat(par37_til40_input)
        PersonskatSærligtAktieaktivResultat(
            fakta = fakta,
            resultat = par37_til40_resultat.aktieavancebeskatningslov_resultat,
            kilderesultater = par37_til40_resultat.aktieavancebeskatningslov_kilderesultater,
            resultater = par37_til40_resultat.aktieavancebeskatningslov_resultater,
            par17_resultat = None,
            par35_forløbsresultat = None,
            par37_til40_forløbsresultat = Some(par37_til40_resultat),
            kgl_par32_kontraktrelation = KglPar32AlmindeligKontrakt,
            årets_forfaldne_overdragerskat_kroner = 0,
            årets_betalte_overdragerskat_kroner = 0,
            årets_saldobortfald_kroner = 0,
            årets_nye_henstand_med_fraflytterskat_kroner = par37_til40_resultat.årets_nye_henstand_kroner,
            årets_forfaldne_fraflytterskat_kroner = par37_til40_resultat.årets_skat_til_betaling_ved_fraflytning_kroner + par37_til40_resultat.årets_nye_forfald_kroner,
            årets_betalte_fraflytterskat_kroner = par37_til40_resultat.årets_betalte_fraflytterskat_kroner,
            årets_fraflytterskat_saldobortfald_kroner = par37_til40_resultat.årets_saldobortfald_kroner,
            input_gyldigt = par37_til40_fakta.opgørelsesår == skatteår && kontekstafledning.input_gyldigt && hvis par37_til40_resultat.fraflytningsresultat.fraflytterskatteberegning_understøttet { par37_til40_resultat.input_gyldigt } ellers { par37_til40_fakta.opgørelsesår == par37_til40_fakta.fraflytning.fraflytningsår && length(par37_til40_fakta.hændelsesposter) == 0 && par37_til40_fakta.tilflytning == IngenTilflytningEfterPar39B && par37_til40_resultat.fraflytningsresultat.par38_resultat.input_gyldigt }
        )
    }
}
| personskat_særligt_aktieaktiv_resultat_uden_par37_til40(fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal) -> personskat_særligt_aktieaktiv_resultat_med_par37_kontekst(fakta, skatteår, PersonskatPar37Til40Årskontekst(egen_aktieindkomst_kroner = 0, ægtefælles_aktieindkomst_kroner = 0, samlevende_ved_indkomstårets_udløb = Falskt, afledning_tilladt = Sandt))
| personskat_særlig_par4_kapitalpost_fra_abl(resultat: AktieavancebeskatningslovResultat) -> par4_stk1_nr5_kapitalpost(Par4Stk1Nr5Input(aktieavancebeskatningslov_resultat = resultat))
| personskat_særlig_par4a_aktiepost_fra_abl(resultat: AktieavancebeskatningslovResultat) -> par4a_aktiepost(Par4aAktieavancebeskatningslovInput(aktieavancebeskatningslov_resultat = resultat))
| personskat_særlige_par4_kapitalposter(resultat: PersonskatSærligtAktieaktivResultat) -> map(resultat.resultater, personskat_særlig_par4_kapitalpost_fra_abl)
| personskat_særlige_par4a_aktieposter(resultat: PersonskatSærligtAktieaktivResultat) -> map(resultat.resultater, personskat_særlig_par4a_aktiepost_fra_abl)
| personskat_udbytte_par13a_beløb_kroner(resultat: PersonskatUdbytteResultat, kvalificerer: Boolsk) -> hvis resultat.input_gyldigt && kvalificerer && resultat.par4a_resultat.afgrænsning == AktiepostOmfattetAfStk1 { penge_positivt_beløb(resultat.par4a_resultat.beløb_kroner) } ellers { 0 }
| personskat_udbytte_par13a_par12_beløb_kroner(resultat: PersonskatUdbytteResultat) -> personskat_udbytte_par13a_beløb_kroner(resultat, resultat.par13a_kilderesultat.udbytte_for_aktie_med_gevinst_efter_par12)
| personskat_udbytte_par13a_par19b_beløb_kroner(resultat: PersonskatUdbytteResultat) -> personskat_udbytte_par13a_beløb_kroner(resultat, resultat.par13a_kilderesultat.udbytte_for_aktie_med_gevinst_efter_par19b)
| personskat_udbytte_par13a_par44_beløb_kroner(resultat: PersonskatUdbytteResultat) -> personskat_udbytte_par13a_beløb_kroner(resultat, resultat.par13a_kilderesultat.udbytte_for_aktie_omfattet_af_par44)
| personskat_særligt_aktiv_kilderesultat_er_optaget_til_handel(kilderesultat: AktieavancebeskatningslovKilderesultat) -> match aktieavancebeskatningslov_kildegrundlag_markedsstatus(kilderesultat.kildegrundlag) { | Some(markedsstatus) -> aktieavance_ordinaer_er_optaget_til_handel(markedsstatus) | None -> Falskt }
| personskat_særligt_aktiv_par13a_par19b_nettogevinst_for_kilde_kroner(kilderesultat: AktieavancebeskatningslovKilderesultat) -> hvis aktieavancebeskatningslov_kilderesultat_gyldigt(kilderesultat) && personskat_særligt_aktiv_kilderesultat_er_optaget_til_handel(kilderesultat) && kilderesultat.resultat.effektiv_aktiv == AblInvesteringsselskab19B && kilderesultat.resultat.personskattelov_kategori == AblAktieindkomstEfterPslPar4a { penge_positivt_beløb(kilderesultat.resultat.netto_efter_aktieavancebeskatningsloven_kroner) } ellers { 0 }
| personskat_særligt_aktiv_par13a_par19b_nettogevinster_fra_kilderesultater_kroner(kilderesultater: List(AktieavancebeskatningslovKilderesultat)) -> foldl(kilderesultater, 0, |sum: Heltal, kilderesultat: AktieavancebeskatningslovKilderesultat| sum + personskat_særligt_aktiv_par13a_par19b_nettogevinst_for_kilde_kroner(kilderesultat))
| personskat_særligt_aktiv_par13a_par19b_nettogevinst_kroner(resultat: PersonskatSærligtAktieaktivResultat) -> hvis resultat.input_gyldigt { personskat_særligt_aktiv_par13a_par19b_nettogevinster_fra_kilderesultater_kroner(resultat.kilderesultater) } ellers { 0 }
| personskat_særligt_aktieaktiv_identifikation_unik(aktiver: List(PersonskatSærligtAktieaktivFakta), fakta: PersonskatSærligtAktieaktivFakta) -> fakta.identifikation != "" && length(filter(aktiver, |andet: PersonskatSærligtAktieaktivFakta| andet.identifikation == fakta.identifikation)) == 1
| personskat_særligt_aktieaktiv_kilderesultater_matcher_resultater(resultat: PersonskatSærligtAktieaktivResultat) -> map(resultat.kilderesultater, |kilderesultat: AktieavancebeskatningslovKilderesultat| kilderesultat.resultat) == resultat.resultater
| personskat_særligt_aktieaktiv_kilderesultater_gyldige(resultat: PersonskatSærligtAktieaktivResultat) -> personskat_særligt_aktieaktiv_kilderesultater_matcher_resultater(resultat) && all(resultat.kilderesultater, aktieavancebeskatningslov_kilderesultat_gyldigt)
| personskat_særligt_aktieaktiv_resultat_gyldigt(aktiver: List(PersonskatSærligtAktieaktivFakta), resultat: PersonskatSærligtAktieaktivResultat) -> resultat.input_gyldigt && personskat_særligt_aktieaktiv_identifikation_unik(aktiver, resultat.fakta) && personskat_særligt_aktieaktiv_kilderesultater_gyldige(resultat)
| personskat_særligt_aktieaktiv_er_par37_til40(fakta: PersonskatSærligtAktieaktivFakta) -> match fakta.kilde { | PersonskatFraflytteraktierEfterPar37Til40(_) -> Sandt | _ -> Falskt }
| personskat_særligt_aktieaktiv_med_kilderesultater(resultat: PersonskatSærligtAktieaktivResultat, kilderesultater: List(AktieavancebeskatningslovKilderesultat)) -> PersonskatSærligtAktieaktivResultat(
    fakta = resultat.fakta,
    resultat = resultat.resultat,
    kilderesultater = kilderesultater,
    resultater = map(kilderesultater, |kilderesultat: AktieavancebeskatningslovKilderesultat| kilderesultat.resultat),
    par17_resultat = resultat.par17_resultat,
    par35_forløbsresultat = resultat.par35_forløbsresultat,
    par37_til40_forløbsresultat = resultat.par37_til40_forløbsresultat,
    kgl_par32_kontraktrelation = resultat.kgl_par32_kontraktrelation,
    årets_forfaldne_overdragerskat_kroner = resultat.årets_forfaldne_overdragerskat_kroner,
    årets_betalte_overdragerskat_kroner = resultat.årets_betalte_overdragerskat_kroner,
    årets_saldobortfald_kroner = resultat.årets_saldobortfald_kroner,
    årets_nye_henstand_med_fraflytterskat_kroner = resultat.årets_nye_henstand_med_fraflytterskat_kroner,
    årets_forfaldne_fraflytterskat_kroner = resultat.årets_forfaldne_fraflytterskat_kroner,
    årets_betalte_fraflytterskat_kroner = resultat.årets_betalte_fraflytterskat_kroner,
    årets_fraflytterskat_saldobortfald_kroner = resultat.årets_fraflytterskat_saldobortfald_kroner,
    input_gyldigt = resultat.input_gyldigt
)
| personskat_særligt_aktieaktiv_med_umiddelbare_par37_til40_resultater(resultat: PersonskatSærligtAktieaktivResultat) -> match resultat.par37_til40_forløbsresultat {
    | Some(forløb) -> personskat_særligt_aktieaktiv_med_kilderesultater(resultat, forløb.fraflytningsresultat.umiddelbare_aktieavancebeskatningslov_kilderesultater)
    | None -> resultat
}
| personskat_aktieavance_uden_par37_til40(input: PersonskatAktieavanceInput) -> PersonskatAktieavanceInput(
    ordinært_aktieår = input.ordinært_aktieår,
    særlige_aktiver = filter(input.særlige_aktiver, |fakta: PersonskatSærligtAktieaktivFakta| personskat_særligt_aktieaktiv_er_par37_til40(fakta) == Falskt),
    udbytter = input.udbytter
)
| personskat_par37_til40_har_aktuel_afledning(fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal) -> match fakta.kilde {
    | PersonskatFraflytteraktierEfterPar37Til40(par37_fakta) -> par37_fakta.fraflytning.fraflytningsår == skatteår && par37_fakta.fraflytning.kontekstgrundlag == AfledPar37Til40KontekstFraPersonskat
    | _ -> Falskt
}
| personskat_par37_til40_har_aktuel_afledning_i_input(input: PersonskatAktieavanceInput, skatteår: Heltal) -> length(filter(input.særlige_aktiver, |fakta: PersonskatSærligtAktieaktivFakta| personskat_par37_til40_har_aktuel_afledning(fakta, skatteår))) > 0
| personskat_par37_til40_resultat_har_aktuel_afledning(resultat: PersonskatSærligtAktieaktivResultat, skatteår: Heltal) -> personskat_par37_til40_har_aktuel_afledning(resultat.fakta, skatteår)

= personskat_par37_til40_ægtefællemodregning_metadata = Metadata(
    attachments = (
        Guidance(value = aktieavancebeskatningsloven_juridisk_vejledning_par38_opgoerelse),
    )
)

--@label:personskat_par37_til40_ægtefællemodregning::meta:personskat_par37_til40_ægtefællemodregning_metadata--
----
Den juridiske vejledning C.B.2.14.2.7:
"Efter Skattestyrelsens opfattelse kan der kun ske modregning mellem ægtefæller,
hvis begge ægtefæller bliver skattepligtige af gevinst/tab på aktier ved
fraflytningen."
----

--@begin:personskat_par37_til40_ægtefællemodregning--
| personskat_par37_til40_neutral_årskontekst() -> PersonskatPar37Til40Årskontekst(
    egen_aktieindkomst_kroner = 0,
    ægtefælles_aktieindkomst_kroner = 0,
    samlevende_ved_indkomstårets_udløb = Falskt,
    afledning_tilladt = Sandt
)
| personskat_par37_til40_neutralt_resultat(fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal) -> personskat_særligt_aktieaktiv_resultat_med_par37_kontekst(fakta, skatteår, personskat_par37_til40_neutral_årskontekst())
| personskat_par37_til40_fraflytningsdato(fakta: PersonskatSærligtAktieaktivFakta) -> match fakta.kilde {
    | PersonskatFraflytteraktierEfterPar37Til40(par37_fakta) -> par37_fakta.fraflytning.fraflytningsdato
    | _ -> dato_ugyldig()
}
| personskat_par37_til40_aktuelle_fraflytningsdatoer(input: PersonskatAktieavanceInput, skatteår: Heltal) -> map(
    filter(input.særlige_aktiver, |fakta: PersonskatSærligtAktieaktivFakta| personskat_par37_til40_har_aktuel_afledning(fakta, skatteår)),
    personskat_par37_til40_fraflytningsdato
)
| personskat_par37_til40_alle_datoer_lig_med(datoer: List(Dato), dato: Dato) -> all(datoer, |anden: Dato| anden == dato)
| personskat_par37_til40_fraflytning_samtidig(hovedpersons_input: PersonskatAktieavanceInput, hovedpersons_skatteår: Heltal, ægtefælles_input: PersonskatAktieavanceInput, ægtefælles_skatteår: Heltal) -> {
    = hovedpersons_datoer = personskat_par37_til40_aktuelle_fraflytningsdatoer(hovedpersons_input, hovedpersons_skatteår)
    = ægtefælles_datoer = personskat_par37_til40_aktuelle_fraflytningsdatoer(ægtefælles_input, ægtefælles_skatteår)
    = alle_datoer = concat(hovedpersons_datoer, ægtefælles_datoer)
    hovedpersons_skatteår == ægtefælles_skatteår && length(hovedpersons_datoer) > 0 && length(ægtefælles_datoer) > 0 && dato_gyldig(head(alle_datoer)) && personskat_par37_til40_alle_datoer_lig_med(alle_datoer, head(alle_datoer))
}
| personskat_par37_til40_resultat_udløser_skattepligt(resultat: PersonskatSærligtAktieaktivResultat) -> match resultat.par37_til40_forløbsresultat {
    | Some(forløb) -> forløb.fraflytningsresultat.par38_resultat.skattepligtsophør_efter_stk1 && forløb.fraflytningsresultat.par38_resultat.antal_aktier_omfattet > 0
    | None -> Falskt
}
| personskat_par37_til40_aktuel_skattepligt(fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal) -> personskat_par37_til40_har_aktuel_afledning(fakta, skatteår) && personskat_par37_til40_resultat_udløser_skattepligt(personskat_par37_til40_neutralt_resultat(fakta, skatteår))
| personskat_par37_til40_har_aktuel_skattepligt(input: PersonskatAktieavanceInput, skatteår: Heltal) -> length(filter(input.særlige_aktiver, |fakta: PersonskatSærligtAktieaktivFakta| personskat_par37_til40_aktuel_skattepligt(fakta, skatteår))) > 0
| personskat_par37_til40_ægtefællemodregning_tilladt(hovedpersons_input: PersonskatAktieavanceInput, hovedpersons_skatteår: Heltal, ægtefælles_input: PersonskatAktieavanceInput, ægtefælles_skatteår: Heltal, samlevende_ved_indkomstårets_udløb: Boolsk) -> samlevende_ved_indkomstårets_udløb && personskat_par37_til40_fraflytning_samtidig(hovedpersons_input, hovedpersons_skatteår, ægtefælles_input, ægtefælles_skatteår) && personskat_par37_til40_har_aktuel_skattepligt(hovedpersons_input, hovedpersons_skatteår) && personskat_par37_til40_har_aktuel_skattepligt(ægtefælles_input, ægtefælles_skatteår)
| personskat_par37_til40_nettogevinst_før_gulv_kroner(resultat: PersonskatSærligtAktieaktivResultat) -> match resultat.par37_til40_forløbsresultat {
    | Some(forløb) -> forløb.fraflytningsresultat.par38_resultat.samlet_nettogevinst_før_gulv_kroner
    | None -> 0
}
| personskat_par37_til40_aktuel_nettogevinst_før_gulv_kroner(fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal) -> hvis personskat_par37_til40_aktuel_skattepligt(fakta, skatteår) { personskat_par37_til40_nettogevinst_før_gulv_kroner(personskat_par37_til40_neutralt_resultat(fakta, skatteår)) } ellers { 0 }
| personskat_par37_til40_samlet_aktuel_nettogevinst_før_gulv_kroner(input: PersonskatAktieavanceInput, skatteår: Heltal) -> foldl(input.særlige_aktiver, 0, |sum: Heltal, fakta: PersonskatSærligtAktieaktivFakta| sum + personskat_par37_til40_aktuel_nettogevinst_før_gulv_kroner(fakta, skatteår))
| personskat_par37_til40_kilderesultater_før_nettogulv(resultat: PersonskatSærligtAktieaktivResultat) -> match resultat.par37_til40_forløbsresultat {
    | Some(forløb) -> aktieavance_par38_kilderesultater_før_nettogulv(forløb.fraflytningsresultat.par38_resultat.input)
    | None -> resultat.kilderesultater
}
| personskat_par37_til40_kilderesultater_efter_ægtefællemodregning(resultat: PersonskatSærligtAktieaktivResultat, skatteår: Heltal, ægtefællemodregning_tilladt: Boolsk, parrets_nettogevinst_før_gulv_kroner: Heltal) -> hvis ægtefællemodregning_tilladt && personskat_par37_til40_resultat_har_aktuel_afledning(resultat, skatteår) {
    hvis parrets_nettogevinst_før_gulv_kroner > 0 { personskat_par37_til40_kilderesultater_før_nettogulv(resultat) } ellers { [] }
} ellers {
    resultat.kilderesultater
}
| personskat_par37_til40_resultat_efter_ægtefællemodregning(resultat: PersonskatSærligtAktieaktivResultat, skatteår: Heltal, ægtefællemodregning_tilladt: Boolsk, parrets_nettogevinst_før_gulv_kroner: Heltal) -> personskat_særligt_aktieaktiv_med_kilderesultater(
    resultat,
    personskat_par37_til40_kilderesultater_efter_ægtefællemodregning(resultat, skatteår, ægtefællemodregning_tilladt, parrets_nettogevinst_før_gulv_kroner)
)
--@end:personskat_par37_til40_ægtefællemodregning--

| personskat_par37_til40_resultatnøgle(person: PersonskatPar37Til40Skatteperson, resultat: PersonskatSærligtAktieaktivResultat) -> PersonskatPar37Til40Resultatnøgle(person = person, aktieaktiv_identifikation = resultat.fakta.identifikation)
| personskat_par37_til40_resultat_inkluderet(resultat: PersonskatSærligtAktieaktivResultat, person: PersonskatPar37Til40Skatteperson, skatteår: Heltal, inkluderede_resultater: List(PersonskatPar37Til40Resultatnøgle), aktuel_nøgle: PersonskatPar37Til40Resultatnøgle, projektion: PersonskatPar37Til40Skatteprojektion) -> hvis personskat_par37_til40_resultat_har_aktuel_afledning(resultat, skatteår) == Falskt {
    Sandt
} ellers {
    = nøgle = personskat_par37_til40_resultatnøgle(person, resultat)
    contains(inkluderede_resultater, nøgle) || (nøgle == aktuel_nøgle && projektion != UdenAktuelFraflytterindkomst)
}
| personskat_par37_til40_resultat_til_projektion(resultat: PersonskatSærligtAktieaktivResultat, person: PersonskatPar37Til40Skatteperson, aktuel_nøgle: PersonskatPar37Til40Resultatnøgle, projektion: PersonskatPar37Til40Skatteprojektion) -> hvis personskat_par37_til40_resultatnøgle(person, resultat) == aktuel_nøgle && projektion == MedAktuelUmiddelbarFraflytterindkomst { personskat_særligt_aktieaktiv_med_umiddelbare_par37_til40_resultater(resultat) } ellers { resultat }
| personskat_par37_til40_særlige_resultater_til_projektion(resultater: List(PersonskatSærligtAktieaktivResultat), person: PersonskatPar37Til40Skatteperson, skatteår: Heltal, inkluderede_resultater: List(PersonskatPar37Til40Resultatnøgle), aktuel_nøgle: PersonskatPar37Til40Resultatnøgle, projektion: PersonskatPar37Til40Skatteprojektion) -> map(
    filter(resultater, |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_resultat_inkluderet(resultat, person, skatteår, inkluderede_resultater, aktuel_nøgle, projektion)),
    |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_resultat_til_projektion(resultat, person, aktuel_nøgle, projektion)
)
| personskat_særligt_aktieaktiv_par37_til40_tillæg_kroner(resultat: PersonskatSærligtAktieaktivResultat) -> hvis personskat_særligt_aktieaktiv_er_par37_til40(resultat.fakta) && resultat.input_gyldigt { foldl(resultat.resultater, 0, |sum: Heltal, abl_resultat: AktieavancebeskatningslovResultat| sum + hvis abl_resultat.personskattelov_kategori == AblAktieindkomstEfterPslPar4a { abl_resultat.netto_efter_aktieavancebeskatningsloven_kroner } ellers { 0 }) } ellers { 0 }
| personskat_særligt_aktieaktiv_afledningstrin(tilstand: PersonskatSærligtAktieaktivAfledningstilstand, fakta: PersonskatSærligtAktieaktivFakta, skatteår: Heltal) -> {
    = resultat = personskat_særligt_aktieaktiv_resultat_med_par37_kontekst(fakta, skatteår, tilstand.årskontekst)
    PersonskatSærligtAktieaktivAfledningstilstand(
        årskontekst = PersonskatPar37Til40Årskontekst(
            egen_aktieindkomst_kroner = tilstand.årskontekst.egen_aktieindkomst_kroner + personskat_særligt_aktieaktiv_par37_til40_tillæg_kroner(resultat),
            ægtefælles_aktieindkomst_kroner = tilstand.årskontekst.ægtefælles_aktieindkomst_kroner,
            samlevende_ved_indkomstårets_udløb = tilstand.årskontekst.samlevende_ved_indkomstårets_udløb,
            afledning_tilladt = tilstand.årskontekst.afledning_tilladt
        ),
        resultater = concat(tilstand.resultater, [resultat])
    )
}
| personskat_særlige_aktieaktiver_med_afledt_par37_til40_kontekst(input: PersonskatAktieavanceInput, skatteår: Heltal, årskontekst: PersonskatPar37Til40Årskontekst) -> foldl(
    input.særlige_aktiver,
    PersonskatSærligtAktieaktivAfledningstilstand(
        årskontekst = årskontekst,
        resultater = []
    ),
    |tilstand: PersonskatSærligtAktieaktivAfledningstilstand, fakta: PersonskatSærligtAktieaktivFakta| personskat_særligt_aktieaktiv_afledningstrin(tilstand, fakta, skatteår)
)

| personskat_aktieavance_forberedelse_fra_resultater(input: PersonskatAktieavanceInput, skatteår: Heltal, særlige_resultater: List(PersonskatSærligtAktieaktivResultat), udbytter: List(PersonskatUdbytteResultat)) -> {
    = særlige_aktiver_gyldige = all(særlige_resultater, |resultat: PersonskatSærligtAktieaktivResultat| personskat_særligt_aktieaktiv_resultat_gyldigt(input.særlige_aktiver, resultat))
    = udbytter_gyldige = all(udbytter, |resultat: PersonskatUdbytteResultat| resultat.input_gyldigt)
    = udbytter_efter_par12_kroner = foldl(udbytter, 0, |sum: Heltal, resultat: PersonskatUdbytteResultat| sum + personskat_udbytte_par13a_par12_beløb_kroner(resultat))
    = udbytter_efter_par19b_kroner = foldl(udbytter, 0, |sum: Heltal, resultat: PersonskatUdbytteResultat| sum + personskat_udbytte_par13a_par19b_beløb_kroner(resultat))
    = nettogevinster_efter_par19b_kroner = foldl(særlige_resultater, 0, |sum: Heltal, resultat: PersonskatSærligtAktieaktivResultat| sum + personskat_særligt_aktiv_par13a_par19b_nettogevinst_kroner(resultat))
    = udbytter_efter_par44_kroner = foldl(udbytter, 0, |sum: Heltal, resultat: PersonskatUdbytteResultat| sum + personskat_udbytte_par13a_par44_beløb_kroner(resultat))
    PersonskatAktieavanceForberedelse(
        input = input,
        skatteår = skatteår,
        særlige_resultater = særlige_resultater,
        udbytter = udbytter,
        særlige_aktiver_gyldige = særlige_aktiver_gyldige,
        udbytter_gyldige = udbytter_gyldige,
        modregningsgrundlag_efter_par13a = AktieavanceOrdinærPar13AModregningsgrundlag(
            udbytter_for_aktier_med_gevinst_efter_par12_kroner = udbytter_efter_par12_kroner,
            udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = udbytter_efter_par19b_kroner + nettogevinster_efter_par19b_kroner,
            udbytter_for_aktier_omfattet_af_par44_kroner = udbytter_efter_par44_kroner
        )
    )
}
| personskat_aktieavance_forberedelse_direkte(input: PersonskatAktieavanceInput, skatteår: Heltal) -> personskat_aktieavance_forberedelse_fra_resultater(
    input,
    skatteår,
    map(input.særlige_aktiver, |fakta: PersonskatSærligtAktieaktivFakta| personskat_særligt_aktieaktiv_resultat_uden_par37_til40(fakta, skatteår)),
    map(input.udbytter, |fakta: PersonskatUdbytteFakta| personskat_udbytte_resultat(input.udbytter, fakta, skatteår))
)

# PersonskatAktieavanceSag(forberedelse: PersonskatAktieavanceForberedelse, ordinært_aktieår: PersonskatOrdinærtAktieårResultat) {
    | ordinært_aktieår_gyldigt() -> personskat_ordinært_aktieår_gyldigt(ordinært_aktieår, forberedelse.skatteår)
    | alle_input_gyldige() -> ordinært_aktieår_gyldigt() && forberedelse.særlige_aktiver_gyldige && forberedelse.udbytter_gyldige
    | særlige_par4_kapitalposter() -> foldl(forberedelse.særlige_resultater, [], |poster: List(Par4Kapitalpost), resultat: PersonskatSærligtAktieaktivResultat| concat(poster, personskat_særlige_par4_kapitalposter(resultat)))
    | særlige_par4a_aktieposter() -> foldl(forberedelse.særlige_resultater, [], |poster: List(Par4aAktiepost), resultat: PersonskatSærligtAktieaktivResultat| concat(poster, personskat_særlige_par4a_aktieposter(resultat)))
    | par4_kapitalposter_før_validering() -> concat(særlige_par4_kapitalposter(), map(forberedelse.udbytter, personskat_udbytte_par4_kapitalpost))
    | par4a_aktieposter_før_validering() -> concat(concat(personskat_ordinære_aktieposter(ordinært_aktieår), særlige_par4a_aktieposter()), map(forberedelse.udbytter, personskat_udbytte_par4a_aktiepost))
    | par4_kapitalposter() -> hvis alle_input_gyldige() { par4_kapitalposter_før_validering() } ellers { [] }
    | par4a_aktieposter() -> hvis alle_input_gyldige() { par4a_aktieposter_før_validering() } ellers { [] }
    | kapitalindkomst_resultat() -> par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
        poster = par4_kapitalposter(),
        omkostninger = []
    ))
    | aktieindkomst_resultat() -> par4a_aktieindkomst_resultat(Par4aAktieindkomstInput(
        poster = par4a_aktieposter(),
        pbl15a_grundlag = IntetPbl15AFradragsgrundlag,
        pensionsfradrag_valg_resultat = par4a_intet_pensionsfradrag_valg(forberedelse.skatteår)
    ))
    | personlig_indkomst_kroner() -> kapitalindkomst_resultat().omklassificeret_personlig_indkomst_kroner + kapitalindkomst_resultat().personlig_indkomst_tillæg_kroner + aktieindkomst_resultat().omklassificeret_personlig_indkomst_kroner
    | resultat() -> PersonskatAktieavanceResultat(
        input = forberedelse.input,
        ordinært_aktieår = ordinært_aktieår,
        særlige_resultater = forberedelse.særlige_resultater,
        udbytter = forberedelse.udbytter,
        alle_input_gyldige = alle_input_gyldige(),
        kapitalposter = par4_kapitalposter(),
        aktieposter = par4a_aktieposter(),
        kapitalindkomst_resultat = kapitalindkomst_resultat(),
        aktieindkomst_resultat = aktieindkomst_resultat(),
        personlig_indkomst_kroner = personlig_indkomst_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_resultat().nettokapitalindkomst_kroner,
        aktieindkomst_kroner = aktieindkomst_resultat().aktieindkomst_efter_pensionsfradrag_kroner
    )
}

| personskat_aktieavance_resultat_fra_forberedelse(forberedelse: PersonskatAktieavanceForberedelse, ordinært_aktieår: PersonskatOrdinærtAktieårResultat) -> PersonskatAktieavanceSag(forberedelse, ordinært_aktieår).resultat()
| personskat_aktieavance_resultat_med_særlige_resultater(resultat: PersonskatAktieavanceResultat, skatteår: Heltal, særlige_resultater: List(PersonskatSærligtAktieaktivResultat)) -> personskat_aktieavance_resultat_fra_forberedelse(
    personskat_aktieavance_forberedelse_fra_resultater(resultat.input, skatteår, særlige_resultater, resultat.udbytter),
    resultat.ordinært_aktieår
)
| personskat_aktieavance_resultat(input: PersonskatAktieavanceInput, skatteår: Heltal) -> {
    = basisinput = personskat_aktieavance_uden_par37_til40(input)
    = basisforberedelse = personskat_aktieavance_forberedelse_direkte(basisinput, skatteår)
    = ordinært_aktieår = personskat_ordinært_aktieår_resultat_med_modregningsgrundlag(input.ordinært_aktieår, basisforberedelse.modregningsgrundlag_efter_par13a)
    = basisresultat = personskat_aktieavance_resultat_fra_forberedelse(basisforberedelse, ordinært_aktieår)
    = særlige = personskat_særlige_aktieaktiver_med_afledt_par37_til40_kontekst(input, skatteår, PersonskatPar37Til40Årskontekst(
        egen_aktieindkomst_kroner = basisresultat.aktieindkomst_kroner,
        ægtefælles_aktieindkomst_kroner = 0,
        samlevende_ved_indkomstårets_udløb = Falskt,
        afledning_tilladt = Sandt
    ))
    = forberedelse = personskat_aktieavance_forberedelse_fra_resultater(input, skatteår, særlige.resultater, basisforberedelse.udbytter)
    personskat_aktieavance_resultat_fra_forberedelse(forberedelse, ordinært_aktieår)
}
| personskat_tomt_ordinært_aktieårsinput(skatteår: Heltal) -> AktieavanceOrdinærPersonÅrsinput(indkomstår = skatteår, hændelsesforløb = [], investeringsbeviser = [], fremført_tab_efter_par13a_kroner = 0)
| personskat_ordinært_aktieår_parinput(input: PersonskatOrdinærtAktieårInput, skatteår: Heltal) -> match input { | UdenOrdinærtAktieår -> personskat_tomt_ordinært_aktieårsinput(skatteår) | MedOrdinærtAktieår(årsinput) -> årsinput }
| personskat_ordinært_aktieår_resultat_fra_par(input: PersonskatOrdinærtAktieårInput, resultat: AktieavanceOrdinærPersonÅrsresultat) -> match input {
    | MedOrdinærtAktieår(_) -> BeregnetOrdinærtAktieår(resultat = resultat)
    | UdenOrdinærtAktieår -> hvis resultat.årsresultat.medregnes_i_skattepligtig_indkomst || resultat.årsresultat.tab_overført_til_ægtefælle_kroner > 0 || resultat.årsresultat.tab_fremført_til_følgende_indkomstår_kroner > 0 { BeregnetOrdinærtAktieår(resultat = resultat) } ellers { IntetOrdinærtAktieår }
}
| personskat_aktieavance_parresultat_fra_personer(hovedpersons_input: PersonskatAktieavanceInput, hovedpersons_skatteår: Heltal, ægtefælles_input: PersonskatAktieavanceInput, ægtefælles_skatteår: Heltal, samlevende_ved_indkomstårets_udløb: Boolsk) -> {
    = hovedbasisinput = personskat_aktieavance_uden_par37_til40(hovedpersons_input)
    = ægtefællebasisinput = personskat_aktieavance_uden_par37_til40(ægtefælles_input)
    = hovedbasisforberedelse = personskat_aktieavance_forberedelse_direkte(hovedbasisinput, hovedpersons_skatteår)
    = ægtefællebasisforberedelse = personskat_aktieavance_forberedelse_direkte(ægtefællebasisinput, ægtefælles_skatteår)
    = ordinært_årspar = aktieavance_ordinaer_person_årsparresultat(
        personskat_ordinært_aktieår_parinput(hovedpersons_input.ordinært_aktieår, hovedpersons_skatteår),
        hovedbasisforberedelse.modregningsgrundlag_efter_par13a,
        personskat_ordinært_aktieår_parinput(ægtefælles_input.ordinært_aktieår, ægtefælles_skatteår),
        ægtefællebasisforberedelse.modregningsgrundlag_efter_par13a,
        samlevende_ved_indkomstårets_udløb
    )
    = hovedordinært_aktieår = personskat_ordinært_aktieår_resultat_fra_par(hovedpersons_input.ordinært_aktieår, ordinært_årspar.hovedperson)
    = ægtefælleordinært_aktieår = personskat_ordinært_aktieår_resultat_fra_par(ægtefælles_input.ordinært_aktieår, ordinært_årspar.ægtefælle)
    = hovedbasisresultat = personskat_aktieavance_resultat_fra_forberedelse(hovedbasisforberedelse, hovedordinært_aktieår)
    = ægtefællebasisresultat = personskat_aktieavance_resultat_fra_forberedelse(ægtefællebasisforberedelse, ægtefælleordinært_aktieår)
    = hovedpersons_par37_til40_netto_før_gulv_kroner = personskat_par37_til40_samlet_aktuel_nettogevinst_før_gulv_kroner(hovedpersons_input, hovedpersons_skatteår)
    = ægtefælles_par37_til40_netto_før_gulv_kroner = personskat_par37_til40_samlet_aktuel_nettogevinst_før_gulv_kroner(ægtefælles_input, ægtefælles_skatteår)
    = ægtefællemodregning_tilladt = personskat_par37_til40_ægtefællemodregning_tilladt(hovedpersons_input, hovedpersons_skatteår, ægtefælles_input, ægtefælles_skatteår, samlevende_ved_indkomstårets_udløb)
    = parrets_nettogevinst_før_gulv_kroner = hovedpersons_par37_til40_netto_før_gulv_kroner + ægtefælles_par37_til40_netto_før_gulv_kroner
    = hovedpersons_ægtefællefraflytning_kroner = hvis ægtefællemodregning_tilladt { ægtefælles_par37_til40_netto_før_gulv_kroner } ellers { 0 }
    = ægtefælles_ægtefællefraflytning_kroner = hvis ægtefællemodregning_tilladt { hovedpersons_par37_til40_netto_før_gulv_kroner } ellers { 0 }
    = hovedsærlige = personskat_særlige_aktieaktiver_med_afledt_par37_til40_kontekst(
        hovedpersons_input,
        hovedpersons_skatteår,
        PersonskatPar37Til40Årskontekst(
            egen_aktieindkomst_kroner = hovedbasisresultat.aktieindkomst_kroner,
            ægtefælles_aktieindkomst_kroner = ægtefællebasisresultat.aktieindkomst_kroner + hovedpersons_ægtefællefraflytning_kroner,
            samlevende_ved_indkomstårets_udløb = samlevende_ved_indkomstårets_udløb,
            afledning_tilladt = Sandt
        )
    )
    = ægtefællesærlige = personskat_særlige_aktieaktiver_med_afledt_par37_til40_kontekst(
        ægtefælles_input,
        ægtefælles_skatteår,
        PersonskatPar37Til40Årskontekst(
            egen_aktieindkomst_kroner = ægtefællebasisresultat.aktieindkomst_kroner,
            ægtefælles_aktieindkomst_kroner = hovedbasisresultat.aktieindkomst_kroner + ægtefælles_ægtefællefraflytning_kroner,
            samlevende_ved_indkomstårets_udløb = samlevende_ved_indkomstårets_udløb,
            afledning_tilladt = Sandt
        )
    )
    = hovedresultater_efter_ægtefællemodregning = map(hovedsærlige.resultater, |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_resultat_efter_ægtefællemodregning(resultat, hovedpersons_skatteår, ægtefællemodregning_tilladt, parrets_nettogevinst_før_gulv_kroner))
    = ægtefælleresultater_efter_ægtefællemodregning = map(ægtefællesærlige.resultater, |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_resultat_efter_ægtefællemodregning(resultat, ægtefælles_skatteår, ægtefællemodregning_tilladt, parrets_nettogevinst_før_gulv_kroner))
    = hovedforberedelse = personskat_aktieavance_forberedelse_fra_resultater(hovedpersons_input, hovedpersons_skatteår, hovedresultater_efter_ægtefællemodregning, hovedbasisforberedelse.udbytter)
    = ægtefælleforberedelse = personskat_aktieavance_forberedelse_fra_resultater(ægtefælles_input, ægtefælles_skatteår, ægtefælleresultater_efter_ægtefællemodregning, ægtefællebasisforberedelse.udbytter)
    = hovedresultat = personskat_aktieavance_resultat_fra_forberedelse(hovedforberedelse, hovedordinært_aktieår)
    = ægtefælleresultat = personskat_aktieavance_resultat_fra_forberedelse(ægtefælleforberedelse, ægtefælleordinært_aktieår)
    PersonskatAktieavanceParResultat(
        par_gyldigt = ordinært_årspar.par_gyldigt && hovedresultat.alle_input_gyldige && ægtefælleresultat.alle_input_gyldige,
        hovedperson = hovedresultat,
        ægtefælle = BeregnetÆgtefælleAktieavance(resultat = ægtefælleresultat)
    )
}
| personskat_aktieavance_parresultat(hovedpersons_input: PersonskatAktieavanceInput, hovedpersons_skatteår: Heltal, ægtefælle_input: PersonskatÆgtefælleInput) -> match ægtefælle_input {
    | UdenÆgtefælle -> PersonskatAktieavanceParResultat(par_gyldigt = Sandt, hovedperson = personskat_aktieavance_resultat(hovedpersons_input, hovedpersons_skatteår), ægtefælle = IngenÆgtefælleAktieavance)
    | MedÆgtefælle(ægtefælle_fakta, samlevende_ved_indkomstårets_udløb) -> personskat_aktieavance_parresultat_fra_personer(hovedpersons_input, hovedpersons_skatteår, ægtefælle_fakta.aktieavance, ægtefælle_fakta.lønmodtager.skatteår, samlevende_ved_indkomstårets_udløb)
}
| personskat_ægtefælle_skatteår(input: PersonskatÆgtefælleInput, hovedpersons_skatteår: Heltal) -> match input { | UdenÆgtefælle -> hovedpersons_skatteår | MedÆgtefælle(fakta, _) -> fakta.lønmodtager.skatteår }
| personskat_ægtefælle_særlige_resultater(parresultat: PersonskatAktieavanceParResultat) -> match parresultat.ægtefælle { | IngenÆgtefælleAktieavance -> [] | BeregnetÆgtefælleAktieavance(resultat) -> resultat.særlige_resultater }
| personskat_aktieavance_parresultat_med_særlige_resultater(parresultat: PersonskatAktieavanceParResultat, hovedpersons_skatteår: Heltal, ægtefælles_skatteår: Heltal, hovedpersons_særlige_resultater: List(PersonskatSærligtAktieaktivResultat), ægtefælles_særlige_resultater: List(PersonskatSærligtAktieaktivResultat)) -> {
    = hovedperson = personskat_aktieavance_resultat_med_særlige_resultater(parresultat.hovedperson, hovedpersons_skatteår, hovedpersons_særlige_resultater)
    match parresultat.ægtefælle {
        | IngenÆgtefælleAktieavance -> PersonskatAktieavanceParResultat(
            par_gyldigt = parresultat.par_gyldigt && hovedperson.alle_input_gyldige,
            hovedperson = hovedperson,
            ægtefælle = IngenÆgtefælleAktieavance
        )
        | BeregnetÆgtefælleAktieavance(resultat) -> {
            = ægtefælle = personskat_aktieavance_resultat_med_særlige_resultater(resultat, ægtefælles_skatteår, ægtefælles_særlige_resultater)
            PersonskatAktieavanceParResultat(
                par_gyldigt = parresultat.par_gyldigt && hovedperson.alle_input_gyldige && ægtefælle.alle_input_gyldige,
                hovedperson = hovedperson,
                ægtefælle = BeregnetÆgtefælleAktieavance(resultat = ægtefælle)
            )
        }
    }
}
| personskat_par37_til40_aktieavance_parprojektion(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat, inkluderede_resultater: List(PersonskatPar37Til40Resultatnøgle), aktuel_nøgle: PersonskatPar37Til40Resultatnøgle, projektion: PersonskatPar37Til40Skatteprojektion) -> {
    = hovedpersons_skatteår = input.lønmodtager.skatteår
    = ægtefælles_skatteår = personskat_ægtefælle_skatteår(input.ægtefælle, hovedpersons_skatteår)
    = hovedpersons_resultater = personskat_par37_til40_særlige_resultater_til_projektion(parresultat.hovedperson.særlige_resultater, Par37Til40Hovedperson, hovedpersons_skatteår, inkluderede_resultater, aktuel_nøgle, projektion)
    = ægtefælles_resultater = personskat_par37_til40_særlige_resultater_til_projektion(personskat_ægtefælle_særlige_resultater(parresultat), Par37Til40Ægtefælle, ægtefælles_skatteår, inkluderede_resultater, aktuel_nøgle, projektion)
    personskat_aktieavance_parresultat_med_særlige_resultater(parresultat, hovedpersons_skatteår, ægtefælles_skatteår, hovedpersons_resultater, ægtefælles_resultater)
}
| personskat_ingen_aktieavance() -> PersonskatAktieavanceInput(ordinært_aktieår = UdenOrdinærtAktieår, særlige_aktiver = [], udbytter = [])

| personskat_kgl_par32_forløb(input: PersonskatKursgevinstInput) -> match input {
    | UdenKursgevinst -> UdenPar32Kontraktforløb
    | MedKursgevinst(fakta) -> fakta.par32_kontraktforløb
}
| personskat_kgl_par32_har_forløb(input: PersonskatKursgevinstInput) -> match personskat_kgl_par32_forløb(input) {
    | UdenPar32Kontraktforløb -> Falskt
    | MedPar32Kontraktforløb(_, _) -> Sandt
}
| personskat_kgl_par32_historik(input: PersonskatKursgevinstInput) -> match personskat_kgl_par32_forløb(input) {
    | UdenPar32Kontraktforløb -> []
    | MedPar32Kontraktforløb(tidligere_år, _) -> tidligere_år
}
| personskat_kgl_par32_tomt_årsvalg() -> KursgevinstPar32Kildeårsvalg(
    tabsprioritet = KglPar32AlmindeligeTabFørst,
    fast_ejendomstabsprioritet = KglPar32SælgertabFørst,
    aktiemodregningsvalg = kgl_par32_ingen_aktiemodregning(),
    aktiemodregningsfordeling = kgl_par32_afled_entydig_aktiemodregningsfordeling()
)
| personskat_kgl_par32_tomt_kildeår(indkomstår: Heltal) -> KursgevinstPar32PersonKildeårsfakta(
    indkomstår = indkomstår,
    kontrakter = [],
    valg = personskat_kgl_par32_tomt_årsvalg()
)
| personskat_kgl_par32_tomt_årsgrundlag() -> PersonskatKursgevinstÅrsgrundlag(
    ejendomsavance = UdenEjendomsavance,
    sælgerpantebreve = [],
    gældsposter = [],
    øvrige_instrumenter = kgl_årsnetto_tomt_input()
)
| personskat_kgl_par32_aktuelt_kildeår(input: PersonskatKursgevinstInput, indkomstår: Heltal) -> match personskat_kgl_par32_forløb(input) {
    | UdenPar32Kontraktforløb -> personskat_kgl_par32_tomt_kildeår(indkomstår)
    | MedPar32Kontraktforløb(_, aktuelt_år) -> aktuelt_år
}
| personskat_kgl_par32_tomt_historikår(fra: PersonskatKursgevinstPar32Historikår) -> PersonskatKursgevinstPar32Historikår(
    fakta = personskat_kgl_par32_tomt_kildeår(fra.fakta.indkomstår),
    aktieavance = personskat_ingen_aktieavance(),
    årsgrundlag = personskat_kgl_par32_tomt_årsgrundlag(),
    gift_og_samlevende_ved_indkomstårets_udgang = fra.gift_og_samlevende_ved_indkomstårets_udgang
)
| personskat_kgl_par32_historikparring(venstre: List(PersonskatKursgevinstPar32Historikår), højre: List(PersonskatKursgevinstPar32Historikår)) -> hvis length(venstre) == 0 && length(højre) == 0 {
    PersonskatKursgevinstPar32Historikparring(årspar = [], input_gyldigt = Sandt)
} ellers {
    hvis length(venstre) == 0 {
        = næste = personskat_kgl_par32_historikparring([], tail(højre))
        PersonskatKursgevinstPar32Historikparring(
            årspar = concat([PersonskatKursgevinstPar32Historikpar(venstre = personskat_kgl_par32_tomt_historikår(head(højre)), højre = head(højre))], næste.årspar),
            input_gyldigt = næste.input_gyldigt
        )
    } ellers {
        hvis length(højre) == 0 {
            = næste = personskat_kgl_par32_historikparring(tail(venstre), [])
            PersonskatKursgevinstPar32Historikparring(
                årspar = concat([PersonskatKursgevinstPar32Historikpar(venstre = head(venstre), højre = personskat_kgl_par32_tomt_historikår(head(venstre)))], næste.årspar),
                input_gyldigt = næste.input_gyldigt
            )
        } ellers {
            = venstre_år = head(venstre)
            = højre_år = head(højre)
            = næste = personskat_kgl_par32_historikparring(tail(venstre), tail(højre))
            PersonskatKursgevinstPar32Historikparring(
                årspar = concat([PersonskatKursgevinstPar32Historikpar(venstre = venstre_år, højre = højre_år)], næste.årspar),
                input_gyldigt = venstre_år.fakta.indkomstår == højre_år.fakta.indkomstår && venstre_år.gift_og_samlevende_ved_indkomstårets_udgang == højre_år.gift_og_samlevende_ved_indkomstårets_udgang && næste.input_gyldigt
            )
        }
    }
}
| personskat_kgl_skatteyder_identifikation(input: PersonskatKursgevinstInput) -> match input {
    | UdenKursgevinst -> ""
    | MedKursgevinst(fakta) -> fakta.skatteyder_identifikation
}
| personskat_kgl_ægtefælles_identifikation(input: PersonskatKursgevinstInput) -> match input {
    | UdenKursgevinst -> ""
    | MedKursgevinst(fakta) -> match fakta.ægtefælles_skatteyder_identifikation { | Some(identifikation) -> identifikation | None -> "" }
}
| personskat_kgl_par32_ægtefælles_input(input: PersonskatÆgtefælleInput) -> match input {
    | UdenÆgtefælle -> UdenKursgevinst
    | MedÆgtefælle(fakta, _) -> fakta.kapitalindkomst.kursgevinst
}
| personskat_kgl_par32_ægtefælles_ejendomsavance_input(input: PersonskatÆgtefælleInput) -> match input {
    | UdenÆgtefælle -> UdenEjendomsavance
    | MedÆgtefælle(fakta, _) -> fakta.kapitalindkomst.ejendomsavance
}
| personskat_kgl_par32_samlevende(input: PersonskatÆgtefælleInput) -> match input {
    | UdenÆgtefælle -> Falskt
    | MedÆgtefælle(_, samlevende) -> samlevende
}
| personskat_kgl_par32_har_ægtefælle(input: PersonskatÆgtefælleInput) -> match input { | UdenÆgtefælle -> Falskt | MedÆgtefælle(_, _) -> Sandt }
| personskat_kgl_par32_modpartsidentifikation(hovedpersons_identifikation: Tekst, ægtefælle_input: PersonskatÆgtefælleInput, ægtefælles_kursgevinst: PersonskatKursgevinstInput) -> hvis personskat_kgl_par32_har_ægtefælle(ægtefælle_input) { personskat_kgl_skatteyder_identifikation(ægtefælles_kursgevinst) } ellers { hovedpersons_identifikation + "::uden-aegtefaelle" }
| personskat_kgl_par32_identiteter_gyldige(hovedpersons_kursgevinst: PersonskatKursgevinstInput, ægtefælle_input: PersonskatÆgtefælleInput, ægtefælles_kursgevinst: PersonskatKursgevinstInput) -> {
    = hovedperson = personskat_kgl_skatteyder_identifikation(hovedpersons_kursgevinst)
    hvis personskat_kgl_par32_har_ægtefælle(ægtefælle_input) {
        = ægtefælle = personskat_kgl_skatteyder_identifikation(ægtefælles_kursgevinst)
        hovedperson != "" && ægtefælle != "" && hovedperson != ægtefælle && personskat_kgl_ægtefælles_identifikation(hovedpersons_kursgevinst) == ægtefælle && personskat_kgl_ægtefælles_identifikation(ægtefælles_kursgevinst) == hovedperson
    } ellers {
        hovedperson != "" && personskat_kgl_ægtefælles_identifikation(hovedpersons_kursgevinst) == ""
    }
}
| personskat_kgl_par32_årsgrundlag_fra_input(kursgevinst: PersonskatKursgevinstInput, ejendomsavance: PersonskatEjendomsavanceInput) -> match kursgevinst {
    | UdenKursgevinst -> PersonskatKursgevinstÅrsgrundlag(
        ejendomsavance = ejendomsavance,
        sælgerpantebreve = [],
        gældsposter = [],
        øvrige_instrumenter = kgl_årsnetto_tomt_input()
    )
    | MedKursgevinst(fakta) -> PersonskatKursgevinstÅrsgrundlag(
        ejendomsavance = ejendomsavance,
        sælgerpantebreve = fakta.sælgerpantebreve,
        gældsposter = fakta.gældsposter,
        øvrige_instrumenter = fakta.øvrige_instrumenter
    )
}
| personskat_kgl_par32_årsgrundlag_har_kgl_fakta(årsgrundlag: PersonskatKursgevinstÅrsgrundlag) -> length(årsgrundlag.sælgerpantebreve) > 0 || length(årsgrundlag.gældsposter) > 0 || length(årsgrundlag.øvrige_instrumenter.fordringer) > 0 || length(årsgrundlag.øvrige_instrumenter.valutainstrumenter) > 0 || length(årsgrundlag.øvrige_instrumenter.obligationsbaserede_minimumsbeviser) > 0
| personskat_kgl_par32_årsgrundlag_til_kursgevinstinput(årsgrundlag: PersonskatKursgevinstÅrsgrundlag, skatteyder_identifikation: Tekst, ægtefælles_identifikation: Option(Tekst), ejendomsavance_resultat: PersonskatEjendomsavanceResultat) -> hvis personskat_kgl_par32_årsgrundlag_har_kgl_fakta(årsgrundlag) || length(personskat_alle_par6d_sælgerpantebrevsresultater(ejendomsavance_resultat)) > 0 {
    MedKursgevinst(fakta = PersonskatKursgevinstÅrsfakta(
        skatteyder_identifikation = skatteyder_identifikation,
        ægtefælles_skatteyder_identifikation = ægtefælles_identifikation,
        sælgerpantebreve = årsgrundlag.sælgerpantebreve,
        gældsposter = årsgrundlag.gældsposter,
        øvrige_instrumenter = årsgrundlag.øvrige_instrumenter,
        par32_kontraktforløb = UdenPar32Kontraktforløb
    ))
} ellers {
    UdenKursgevinst
}
| personskat_kgl_par32_ægtefælleidentifikation(har_ægtefælle: Boolsk, identifikation: Tekst) -> hvis har_ægtefælle { Some(identifikation) } ellers { None }
| personskat_kgl_par32_ægtefælleidentifikation_gyldig(skatteyder_identifikation: Tekst, ægtefælles_identifikation: Option(Tekst)) -> match ægtefælles_identifikation {
    | Some(identifikation) -> identifikation != "" && identifikation != skatteyder_identifikation
    | None -> Sandt
}
| personskat_kgl_par32_årsgrundlagsafledning(årsgrundlag: PersonskatKursgevinstÅrsgrundlag, skatteyder_identifikation: Tekst, ægtefælles_identifikation: Option(Tekst), indkomstår: Heltal) -> {
    = ejendomsavance_resultat = personskat_ejendomsavance_resultat(årsgrundlag.ejendomsavance, indkomstår)
    = kursgevinst_input = personskat_kgl_par32_årsgrundlag_til_kursgevinstinput(årsgrundlag, skatteyder_identifikation, ægtefælles_identifikation, ejendomsavance_resultat)
    = kursgevinst_resultat = personskat_kursgevinst_resultat(kursgevinst_input, indkomstår, ejendomsavance_resultat)
    PersonskatKursgevinstÅrsgrundlagsafledning(
        årsgrundlag = årsgrundlag,
        ejendomsavance_resultat = ejendomsavance_resultat,
        kursgevinst_resultat = kursgevinst_resultat,
        input_gyldigt = indkomstår > 0 && skatteyder_identifikation != "" && personskat_kgl_par32_ægtefælleidentifikation_gyldig(skatteyder_identifikation, ægtefælles_identifikation) && personskat_ejendomsavance_input_gyldigt(ejendomsavance_resultat) && kursgevinst_resultat.input_gyldigt
    )
}
| personskat_kgl_par32_ordinært_aktieårsresultat(resultat: PersonskatAktieavanceResultat, indkomstår: Heltal) -> match resultat.ordinært_aktieår {
    | IntetOrdinærtAktieår -> kgl_par32_tomt_par13a_aktieårsresultat(indkomstår)
    | BeregnetOrdinærtAktieår(årsresultat) -> årsresultat.årsresultat
}
| personskat_kgl_par32_supplerende_aktieårsresultat(kilderesultat: AktieavancebeskatningslovKilderesultat) -> match aktieavancebeskatningslov_kildegrundlag_markedsstatus(kilderesultat.kildegrundlag) {
    | Some(markedsstatus) -> KglPar32AblKilderesultat(kilde = KursgevinstPar32AblKilderesultat(
        resultat = kilderesultat.resultat,
        markedsstatus = markedsstatus,
        input_gyldigt = aktieavancebeskatningslov_kilderesultat_gyldigt(kilderesultat)
    ))
    | None -> KglPar32AblKilderesultat(kilde = KursgevinstPar32AblKilderesultat(
        resultat = kilderesultat.resultat,
        markedsstatus = AblIkkeOptagetTilHandel,
        input_gyldigt = Falskt
    ))
}
| personskat_kgl_par32_supplerende_aktieårsresultater_fra_kilderesultater(kilderesultater: List(AktieavancebeskatningslovKilderesultat)) -> map(kilderesultater, personskat_kgl_par32_supplerende_aktieårsresultat)
| personskat_kgl_par32_supplerende_aktieårsresultater(resultat: PersonskatSærligtAktieaktivResultat) -> personskat_kgl_par32_supplerende_aktieårsresultater_fra_kilderesultater(resultat.kilderesultater)
| personskat_kgl_par32_årsnetto_abl22_kilderesultat(resultat: KglÅrsnettoAbl22Resultat) -> AktieavancebeskatningslovKilderesultat(
    kildeidentifikation = resultat.fakta.identifikation,
    resultat = resultat.aktieavancebeskatningslov_resultat,
    kildegrundlag = AblSærligtAktiekildegrundlag(markedsstatus = AblIkkeOptagetTilHandel),
    input_gyldigt = resultat.input_gyldigt && resultat.forløb.har_opgørelse
)
| personskat_kgl_par32_årsnetto_abl22_kilderesultater(resultat: KursgevinstlovÅrsnettoResultat) -> map(filter(resultat.obligationsbevisresultater, |bevisresultat: KglÅrsnettoAbl22Resultat| bevisresultat.forløb.har_opgørelse), personskat_kgl_par32_årsnetto_abl22_kilderesultat)
| personskat_kgl_par32_årsnetto_supplerende_aktieårsresultater(resultat: KursgevinstlovÅrsnettoResultat) -> personskat_kgl_par32_supplerende_aktieårsresultater_fra_kilderesultater(personskat_kgl_par32_årsnetto_abl22_kilderesultater(resultat))
| personskat_kgl_par32_aktieårsgrundlag(resultat: PersonskatAktieavanceResultat, årsnetto: KursgevinstlovÅrsnettoResultat, indkomstår: Heltal) -> KursgevinstPar32Aktieårsgrundlag(
    par13a_årsresultat = personskat_kgl_par32_ordinært_aktieårsresultat(resultat, indkomstår),
    supplerende_årsresultater = concat(foldl(resultat.særlige_resultater, [], |samlet: List(KursgevinstPar32SupplerendeAktieårsresultat), særligt_resultat: PersonskatSærligtAktieaktivResultat| concat(samlet, personskat_kgl_par32_supplerende_aktieårsresultater(særligt_resultat))), personskat_kgl_par32_årsnetto_supplerende_aktieårsresultater(årsnetto))
)
| personskat_kgl_par32_kilderesultat_har_markedsstatus(kilderesultat: AktieavancebeskatningslovKilderesultat, forventet: AktieavanceOrdinærMarkedsstatus) -> match aktieavancebeskatningslov_kildegrundlag_markedsstatus(kilderesultat.kildegrundlag) { | Some(markedsstatus) -> markedsstatus == forventet | None -> Falskt }
| personskat_kgl_par32_alle_kilderesultater_har_markedsstatus(kilderesultater: List(AktieavancebeskatningslovKilderesultat), forventet: AktieavanceOrdinærMarkedsstatus) -> length(kilderesultater) > 0 && all(kilderesultater, |kilderesultat: AktieavancebeskatningslovKilderesultat| aktieavancebeskatningslov_kilderesultat_gyldigt(kilderesultat) && personskat_kgl_par32_kilderesultat_har_markedsstatus(kilderesultat, forventet))
| personskat_kgl_par32_entydig_markedsstatus_fra_kilderesultater(kilderesultater: List(AktieavancebeskatningslovKilderesultat)) -> hvis personskat_kgl_par32_alle_kilderesultater_har_markedsstatus(kilderesultater, AblOptagetTilHandelPåReguleretMarked) {
    Some(AblOptagetTilHandelPåReguleretMarked)
} ellers hvis personskat_kgl_par32_alle_kilderesultater_har_markedsstatus(kilderesultater, AblOptagetTilHandelPåMultilateralHandelsfacilitet) {
    Some(AblOptagetTilHandelPåMultilateralHandelsfacilitet)
} ellers hvis personskat_kgl_par32_alle_kilderesultater_har_markedsstatus(kilderesultater, AblIkkeOptagetTilHandel) {
    Some(AblIkkeOptagetTilHandel)
} ellers {
    None
}
| personskat_kgl_par32_entydig_markedsstatus(resultat: PersonskatSærligtAktieaktivResultat) -> personskat_kgl_par32_entydig_markedsstatus_fra_kilderesultater(resultat.kilderesultater)
| personskat_kgl_par32_abl_reference(resultat: PersonskatSærligtAktieaktivResultat, alle_aktiver: List(PersonskatSærligtAktieaktivFakta)) -> {
    = markedsstatus = personskat_kgl_par32_entydig_markedsstatus(resultat)
    KursgevinstPar32AblKontraktreference(
        aktieaktiv_identifikation = resultat.fakta.identifikation,
        relation = resultat.kgl_par32_kontraktrelation,
        markedsstatus = match markedsstatus { | Some(status) -> status | None -> AblIkkeOptagetTilHandel },
        input_gyldigt = resultat.input_gyldigt && personskat_særligt_aktieaktiv_identifikation_unik(alle_aktiver, resultat.fakta) && match markedsstatus { | Some(_) -> Sandt | None -> Falskt }
    )
}
| personskat_kgl_par32_abl_referencer(resultat: PersonskatAktieavanceResultat) -> map(resultat.særlige_resultater, |særligt_resultat: PersonskatSærligtAktieaktivResultat| personskat_kgl_par32_abl_reference(særligt_resultat, resultat.input.særlige_aktiver))
| personskat_kgl_par32_ægtefælle_aktieavance_resultat(par: PersonskatAktieavanceParResultat, indkomstår: Heltal) -> match par.ægtefælle {
    | IngenÆgtefælleAktieavance -> personskat_aktieavance_resultat(personskat_ingen_aktieavance(), indkomstår)
    | BeregnetÆgtefælleAktieavance(resultat) -> resultat
}
| personskat_kgl_par32_aktiemodregning_i_persons_gevinster_kroner(resultat: KursgevinstPar32PersonÅrsresultat) -> resultat.tab_modregnet_i_egne_aktiegevinster_kroner + resultat.ægtefælles_kontrakttab_modtaget_i_egne_aktiegevinster_kroner
| personskat_kgl_par32_aktieklasse_er_ordinær_aktieindkomst(klasse: KursgevinstPar32Aktiegevinstklasse) -> klasse == KglPar32Abl12OrdinæreAktierOgRettigheder || klasse == KglPar32Abl20Stk2AkkumulerendeInvesteringsbevis || klasse == KglPar32Abl21AktiebaseretMinimumsbevis
| personskat_kgl_par32_aktieklasse_psl_kategori_matcher(klasse: KursgevinstPar32Aktiegevinstklasse, kategori: AktieavancebeskatningslovPslKategori) -> match klasse {
    | KglPar32Abl12OrdinæreAktierOgRettigheder -> kategori == AblAktieindkomstEfterPslPar4a
    | KglPar32Abl19BInvesteringsselskab -> kategori == AblAktieindkomstEfterPslPar4a
    | KglPar32Abl19CInvesteringsselskab -> kategori == AblKapitalindkomstEfterPslPar4Nr5
    | KglPar32Abl20Stk2AkkumulerendeInvesteringsbevis -> kategori == AblAktieindkomstEfterPslPar4a
    | KglPar32Abl21AktiebaseretMinimumsbevis -> kategori == AblAktieindkomstEfterPslPar4a
    | KglPar32Abl22ObligationsbaseretMinimumsbevis -> kategori == AblKapitalindkomstEfterPslPar4Nr5
    | KglPar32AndenIkkeKvalificeretAktieklasse -> Falskt
}
| personskat_kgl_par32_ordinære_aktieklasser(resultat: KursgevinstPar32PersonÅrsresultat) -> filter(resultat.aktiegevinstgrundlag.klasser, personskat_kgl_par32_aktieklasse_er_ordinær_aktieindkomst)
| personskat_kgl_par32_ordinær_aktiegevinstkapacitet_kroner(resultat: KursgevinstPar32PersonÅrsresultat) -> penge_positivt_beløb(
    resultat.aktiegevinstgrundlag.par13a_gevinster_på_reguleret_marked_kroner
    + hvis resultat.indkomstår >= 2024 { resultat.aktiegevinstgrundlag.par13a_gevinster_på_multilateral_handelsfacilitet_kroner } ellers { 0 }
    - resultat.aktiegevinstgrundlag.årets_par13a_tab_kroner
    - resultat.ægtefælles_par13a_tab_modtaget_før_kontrakttab_kroner
)
| personskat_kgl_par32_ordinær_aktiegevinstkilde(resultat: KursgevinstPar32PersonÅrsresultat) -> PersonskatKglPar32Aktiegevinstkilde(
    mål = KglPar32OrdinærtPar13AÅrsgrundlag,
    klasser = personskat_kgl_par32_ordinære_aktieklasser(resultat),
    personskattelov_kategori = AblAktieindkomstEfterPslPar4a,
    gevinstkapacitet_kroner = personskat_kgl_par32_ordinær_aktiegevinstkapacitet_kroner(resultat),
    input_gyldigt = length(personskat_kgl_par32_ordinære_aktieklasser(resultat)) > 0
)
| personskat_kgl_par32_ordinære_aktiegevinstkilder(resultat: KursgevinstPar32PersonÅrsresultat) -> hvis personskat_kgl_par32_ordinær_aktiegevinstkapacitet_kroner(resultat) > 0 { [personskat_kgl_par32_ordinær_aktiegevinstkilde(resultat)] } ellers { [] }
| personskat_kgl_par32_supplerende_aktiegevinstkilde(kilderesultat: AktieavancebeskatningslovKilderesultat, indkomstår: Heltal) -> {
    = supplerende = personskat_kgl_par32_supplerende_aktieårsresultat(kilderesultat)
    = klassificeret = kgl_par32_klassificer_supplerende_aktieårsresultat(supplerende, indkomstår)
    PersonskatKglPar32Aktiegevinstkilde(
        mål = KglPar32SupplerendeAblKilde(kildeidentifikation = kilderesultat.kildeidentifikation),
        klasser = [klassificeret.klasse],
        personskattelov_kategori = kilderesultat.resultat.personskattelov_kategori,
        gevinstkapacitet_kroner = penge_positivt_beløb(klassificeret.medregnet_nettoaktiegevinst_kroner),
        input_gyldigt = kilderesultat.kildeidentifikation != "" && aktieavancebeskatningslov_kilderesultat_gyldigt(kilderesultat) && klassificeret.strukturelt_gyldigt && klassificeret.kvalificerer_til_par32_stk3 && personskat_kgl_par32_aktieklasse_psl_kategori_matcher(klassificeret.klasse, kilderesultat.resultat.personskattelov_kategori)
    )
}
| personskat_kgl_par32_aktiegevinstkilde_har_kapacitet(kilde: PersonskatKglPar32Aktiegevinstkilde) -> kilde.gevinstkapacitet_kroner > 0
| personskat_kgl_par32_supplerende_aktiegevinstkilder_fra_kilderesultater(kilderesultater: List(AktieavancebeskatningslovKilderesultat), indkomstår: Heltal) -> filter(map(kilderesultater, |kilderesultat: AktieavancebeskatningslovKilderesultat| personskat_kgl_par32_supplerende_aktiegevinstkilde(kilderesultat, indkomstår)), personskat_kgl_par32_aktiegevinstkilde_har_kapacitet)
| personskat_kgl_par32_supplerende_aktiegevinstkilder(resultat: PersonskatAktieavanceResultat, indkomstår: Heltal) -> foldl(resultat.særlige_resultater, [], |kilder: List(PersonskatKglPar32Aktiegevinstkilde), særligt_resultat: PersonskatSærligtAktieaktivResultat| concat(kilder, personskat_kgl_par32_supplerende_aktiegevinstkilder_fra_kilderesultater(særligt_resultat.kilderesultater, indkomstår)))
| personskat_kgl_par32_årsnetto_aktiegevinstkilder(resultat: KursgevinstlovÅrsnettoResultat, indkomstår: Heltal) -> personskat_kgl_par32_supplerende_aktiegevinstkilder_fra_kilderesultater(personskat_kgl_par32_årsnetto_abl22_kilderesultater(resultat), indkomstår)
| personskat_kgl_par32_aktiegevinstkilder(aktieavance: PersonskatAktieavanceResultat, årsnetto: KursgevinstlovÅrsnettoResultat, resultat: KursgevinstPar32PersonÅrsresultat) -> concat(concat(personskat_kgl_par32_ordinære_aktiegevinstkilder(resultat), personskat_kgl_par32_supplerende_aktiegevinstkilder(aktieavance, resultat.indkomstår)), personskat_kgl_par32_årsnetto_aktiegevinstkilder(årsnetto, resultat.indkomstår))
| personskat_kgl_par32_mål_matcher_kilde(mål: KursgevinstPar32Aktiemodregningsmål, kilde: PersonskatKglPar32Aktiegevinstkilde) -> mål == kilde.mål
| personskat_kgl_par32_matchende_aktiegevinstkilder(mål: KursgevinstPar32Aktiemodregningsmål, kilder: List(PersonskatKglPar32Aktiegevinstkilde)) -> filter(kilder, |kilde: PersonskatKglPar32Aktiegevinstkilde| personskat_kgl_par32_mål_matcher_kilde(mål, kilde))
| personskat_kgl_par32_ugyldig_aktiegevinstkilde(mål: KursgevinstPar32Aktiemodregningsmål) -> PersonskatKglPar32Aktiegevinstkilde(mål = mål, klasser = [], personskattelov_kategori = AblIkkeMedregnetISlice, gevinstkapacitet_kroner = 0, input_gyldigt = Falskt)
| personskat_kgl_par32_aktiegevinstkilde_fra_mål(mål: KursgevinstPar32Aktiemodregningsmål, kilder: List(PersonskatKglPar32Aktiegevinstkilde)) -> {
    = matchende = personskat_kgl_par32_matchende_aktiegevinstkilder(mål, kilder)
    hvis length(matchende) == 1 { head(matchende) } ellers { personskat_kgl_par32_ugyldig_aktiegevinstkilde(mål) }
}
| personskat_kgl_par32_aktiegevinstkilder_entydige(kilder: List(PersonskatKglPar32Aktiegevinstkilde)) -> {
    = mål = map(kilder, |kilde: PersonskatKglPar32Aktiegevinstkilde| kilde.mål)
    length(mål) == length(distinct(mål))
}
| personskat_kgl_par32_kildekategori_understøttet(kilde: PersonskatKglPar32Aktiegevinstkilde) -> kilde.personskattelov_kategori == AblAktieindkomstEfterPslPar4a || kilde.personskattelov_kategori == AblKapitalindkomstEfterPslPar4Nr5
| personskat_kgl_par32_kildekategorier(kilder: List(PersonskatKglPar32Aktiegevinstkilde)) -> distinct(map(kilder, |kilde: PersonskatKglPar32Aktiegevinstkilde| kilde.personskattelov_kategori))
| personskat_kgl_par32_valgte_aktiegevinstkilder(fordelingsvalg: KursgevinstPar32Aktiemodregningsfordeling, kilder: List(PersonskatKglPar32Aktiegevinstkilde)) -> match fordelingsvalg {
    | KglPar32AfledEntydigFordeling -> kilder
    | KglPar32FordelEfterKilder(mål) -> map(mål, |enkelt_mål: KursgevinstPar32Aktiemodregningsmål| personskat_kgl_par32_aktiegevinstkilde_fra_mål(enkelt_mål, kilder))
}
| personskat_kgl_par32_valgte_mål_gyldige(mål: List(KursgevinstPar32Aktiemodregningsmål), kilder: List(PersonskatKglPar32Aktiegevinstkilde), modregning_kroner: Heltal) -> (modregning_kroner == 0 || length(mål) > 0) && length(mål) == length(distinct(mål)) && all(mål, |enkelt_mål: KursgevinstPar32Aktiemodregningsmål| length(personskat_kgl_par32_matchende_aktiegevinstkilder(enkelt_mål, kilder)) == 1)
| personskat_kgl_par32_fordelingsvalg_gyldigt(fordelingsvalg: KursgevinstPar32Aktiemodregningsfordeling, kilder: List(PersonskatKglPar32Aktiegevinstkilde), modregning_kroner: Heltal) -> match fordelingsvalg {
    | KglPar32AfledEntydigFordeling -> modregning_kroner == 0 || length(personskat_kgl_par32_kildekategorier(kilder)) <= 1
    | KglPar32FordelEfterKilder(mål) -> personskat_kgl_par32_valgte_mål_gyldige(mål, kilder, modregning_kroner)
}
| personskat_kgl_par32_aktiegevinstkapacitet_i_alt_kroner(kilder: List(PersonskatKglPar32Aktiegevinstkilde)) -> foldl(kilder, 0, |sum: Heltal, kilde: PersonskatKglPar32Aktiegevinstkilde| sum + kilde.gevinstkapacitet_kroner)
| personskat_kgl_par32_aktiemodregningstrin(tilstand: PersonskatKglPar32Aktiemodregningstilstand, kilde: PersonskatKglPar32Aktiegevinstkilde) -> {
    = anvendt_kroner = penge_mindste_beløb(tilstand.resterende_modregning_kroner, kilde.gevinstkapacitet_kroner)
    PersonskatKglPar32Aktiemodregningstilstand(
        resterende_modregning_kroner = tilstand.resterende_modregning_kroner - anvendt_kroner,
        anvendelser = hvis anvendt_kroner > 0 { concat(tilstand.anvendelser, [PersonskatKglPar32Aktiemodregningsanvendelse(kilde = kilde, modregnet_kroner = anvendt_kroner)]) } ellers { tilstand.anvendelser }
    )
}
| personskat_kgl_par32_aktiemodregningsfordeling(aktieavance: PersonskatAktieavanceResultat, årsnetto: KursgevinstlovÅrsnettoResultat, resultat: KursgevinstPar32PersonÅrsresultat, fordelingsvalg: KursgevinstPar32Aktiemodregningsfordeling) -> {
    = modregning_kroner = personskat_kgl_par32_aktiemodregning_i_persons_gevinster_kroner(resultat)
    = kilder = personskat_kgl_par32_aktiegevinstkilder(aktieavance, årsnetto, resultat)
    = valgte_kilder = personskat_kgl_par32_valgte_aktiegevinstkilder(fordelingsvalg, kilder)
    = sluttilstand = foldl(valgte_kilder, PersonskatKglPar32Aktiemodregningstilstand(resterende_modregning_kroner = modregning_kroner, anvendelser = []), personskat_kgl_par32_aktiemodregningstrin)
    = fordelt_kroner = modregning_kroner - sluttilstand.resterende_modregning_kroner
    PersonskatKglPar32Aktiemodregningsfordeling(
        fordelingsvalg = fordelingsvalg,
        kilder = kilder,
        anvendelser = sluttilstand.anvendelser,
        modregning_i_alt_kroner = modregning_kroner,
        fordelt_i_alt_kroner = fordelt_kroner,
        input_gyldigt = resultat.input_gyldigt && aktieavance.alle_input_gyldige && modregning_kroner >= 0 && personskat_kgl_par32_aktiegevinstkilder_entydige(kilder) && all(kilder, |kilde: PersonskatKglPar32Aktiegevinstkilde| kilde.input_gyldigt && personskat_kgl_par32_kildekategori_understøttet(kilde)) && personskat_kgl_par32_fordelingsvalg_gyldigt(fordelingsvalg, kilder, modregning_kroner) && personskat_kgl_par32_aktiegevinstkapacitet_i_alt_kroner(valgte_kilder) >= modregning_kroner && sluttilstand.resterende_modregning_kroner == 0 && fordelt_kroner == modregning_kroner
    )
}
| personskat_kgl_par32_aktiemodregning_i_kategori_kroner(fordeling: PersonskatKglPar32Aktiemodregningsfordeling, kategori: AktieavancebeskatningslovPslKategori) -> foldl(fordeling.anvendelser, 0, |sum: Heltal, anvendelse: PersonskatKglPar32Aktiemodregningsanvendelse| sum + hvis anvendelse.kilde.personskattelov_kategori == kategori { anvendelse.modregnet_kroner } ellers { 0 })
| personskat_kgl_par32_aktiemodregning_i_aktieindkomst_kroner(fordeling: PersonskatKglPar32Aktiemodregningsfordeling) -> personskat_kgl_par32_aktiemodregning_i_kategori_kroner(fordeling, AblAktieindkomstEfterPslPar4a)
| personskat_kgl_par32_aktiemodregning_i_kapitalindkomst_kroner(fordeling: PersonskatKglPar32Aktiemodregningsfordeling) -> personskat_kgl_par32_aktiemodregning_i_kategori_kroner(fordeling, AblKapitalindkomstEfterPslPar4Nr5)
| personskat_kgl_par32_aktiepost(modregning_kroner: Heltal) -> Par4aAktiepost(
    art = KursgevinstlovPar32Kontrakttabsmodregning,
    beløb_kroner = 0 - modregning_kroner,
    afgrænsning = AktiepostOmfattetAfStk1,
    personlig_reklassifikation = IngenAktieTilPersonligUndtagelse
)
| personskat_kgl_par32_kapitalpost(modregning_kroner: Heltal) -> Par4Kapitalpost(
    art = AktieavanceIkkeAktieindkomst,
    beløb_kroner = 0 - modregning_kroner,
    personlig_reklassifikation = IngenPersonligReklassifikation,
    personlig_indkomst_tillæg_kroner = 0
)
| personskat_kgl_par32_aktiemodregningsaktieposter(fordeling: PersonskatKglPar32Aktiemodregningsfordeling) -> {
    = modregning_kroner = personskat_kgl_par32_aktiemodregning_i_aktieindkomst_kroner(fordeling)
    hvis modregning_kroner > 0 { [personskat_kgl_par32_aktiepost(modregning_kroner)] } ellers { [] }
}
| personskat_kgl_par32_aktiemodregningskapitalposter(fordeling: PersonskatKglPar32Aktiemodregningsfordeling) -> {
    = modregning_kroner = personskat_kgl_par32_aktiemodregning_i_kapitalindkomst_kroner(fordeling)
    hvis modregning_kroner > 0 { [personskat_kgl_par32_kapitalpost(modregning_kroner)] } ellers { [] }
}
| personskat_aktieavance_med_kgl_par32_årsresultat(aktieavance: PersonskatAktieavanceResultat, par32: KursgevinstPar32PersonÅrsresultat, fordeling: PersonskatKglPar32Aktiemodregningsfordeling, par32_gyldigt: Boolsk) -> {
    hvis par32_gyldigt && fordeling.input_gyldigt && fordeling.fordelt_i_alt_kroner > 0 {
        = kapitalposter = concat(aktieavance.kapitalposter, personskat_kgl_par32_aktiemodregningskapitalposter(fordeling))
        = aktieposter = concat(aktieavance.aktieposter, personskat_kgl_par32_aktiemodregningsaktieposter(fordeling))
        = kapitalindkomst_resultat = par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
            poster = kapitalposter,
            omkostninger = []
        ))
        = aktieindkomst_resultat = par4a_aktieindkomst_resultat(Par4aAktieindkomstInput(
            poster = aktieposter,
            pbl15a_grundlag = IntetPbl15AFradragsgrundlag,
            pensionsfradrag_valg_resultat = par4a_intet_pensionsfradrag_valg(par32.indkomstår)
        ))
        PersonskatAktieavanceResultat(
            input = aktieavance.input,
            ordinært_aktieår = aktieavance.ordinært_aktieår,
            særlige_resultater = aktieavance.særlige_resultater,
            udbytter = aktieavance.udbytter,
            alle_input_gyldige = aktieavance.alle_input_gyldige,
            kapitalposter = kapitalposter,
            aktieposter = aktieposter,
            kapitalindkomst_resultat = kapitalindkomst_resultat,
            aktieindkomst_resultat = aktieindkomst_resultat,
            personlig_indkomst_kroner = kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner + kapitalindkomst_resultat.personlig_indkomst_tillæg_kroner + aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner,
            kapitalindkomst_kroner = kapitalindkomst_resultat.nettokapitalindkomst_kroner,
            aktieindkomst_kroner = aktieindkomst_resultat.aktieindkomst_efter_pensionsfradrag_kroner
        )
    } ellers {
        aktieavance
    }
}
| personskat_aktieavance_par_med_kgl_par32(aktieavance: PersonskatAktieavanceParResultat, par32: KursgevinstPar32ÆgtefælleparResultat, venstre_fordeling: PersonskatKglPar32Aktiemodregningsfordeling, højre_fordeling: PersonskatKglPar32Aktiemodregningsfordeling, par32_gyldigt: Boolsk) -> {
    = højre = personskat_kgl_par32_ægtefælle_aktieavance_resultat(aktieavance, par32.højre.indkomstår)
    PersonskatAktieavanceParResultat(
        par_gyldigt = aktieavance.par_gyldigt && par32_gyldigt,
        hovedperson = personskat_aktieavance_med_kgl_par32_årsresultat(aktieavance.hovedperson, par32.venstre, venstre_fordeling, par32_gyldigt),
        ægtefælle = BeregnetÆgtefælleAktieavance(resultat = personskat_aktieavance_med_kgl_par32_årsresultat(højre, par32.højre, højre_fordeling, par32_gyldigt))
    )
}
| personskat_kgl_par32_venstre_fremførsel(seneste: Option(PersonskatKursgevinstPar32Årsparresultat)) -> match seneste {
    | None -> KglPar32IngenFremførsel
    | Some(resultat) -> KglPar32FremførselFraForrigeIndkomstår(resultat = resultat.kursgevinst.venstre)
}
| personskat_kgl_par32_højre_fremførsel(seneste: Option(PersonskatKursgevinstPar32Årsparresultat)) -> match seneste {
    | None -> KglPar32IngenFremførsel
    | Some(resultat) -> KglPar32FremførselFraForrigeIndkomstår(resultat = resultat.kursgevinst.højre)
}
| personskat_kgl_par32_årsparresultat(venstre_identifikation: Tekst, højre_identifikation: Tekst, venstre_fakta: KursgevinstPar32PersonKildeårsfakta, højre_fakta: KursgevinstPar32PersonKildeårsfakta, venstre_årsgrundlag: PersonskatKursgevinstÅrsgrundlagsafledning, højre_årsgrundlag: PersonskatKursgevinstÅrsgrundlagsafledning, aktieavance: PersonskatAktieavanceParResultat, venstre_fremførsel: KursgevinstPar32Fremførsel, højre_fremførsel: KursgevinstPar32Fremførsel, gift_og_samlevende: Boolsk) -> {
    = højre_aktieavance = personskat_kgl_par32_ægtefælle_aktieavance_resultat(aktieavance, højre_fakta.indkomstår)
    = venstre_årsnetto = venstre_årsgrundlag.kursgevinst_resultat.øvrige_instrumentresultat
    = højre_årsnetto = højre_årsgrundlag.kursgevinst_resultat.øvrige_instrumentresultat
    = venstre_afledning = kgl_par32_person_kildeårsafledning(
        skatteyder_identifikation = venstre_identifikation,
        fakta = venstre_fakta,
        referencer = personskat_kgl_par32_abl_referencer(aktieavance.hovedperson),
        aktieårsgrundlag = personskat_kgl_par32_aktieårsgrundlag(aktieavance.hovedperson, venstre_årsnetto, venstre_fakta.indkomstår),
        fremførsel = venstre_fremførsel
    )
    = højre_afledning = kgl_par32_person_kildeårsafledning(
        skatteyder_identifikation = højre_identifikation,
        fakta = højre_fakta,
        referencer = personskat_kgl_par32_abl_referencer(højre_aktieavance),
        aktieårsgrundlag = personskat_kgl_par32_aktieårsgrundlag(højre_aktieavance, højre_årsnetto, højre_fakta.indkomstår),
        fremførsel = højre_fremførsel
    )
    = kursgevinst = kursgevinst_par32_ægtefællepar_resultat(KursgevinstPar32ÆgtefælleparInput(
        venstre = venstre_afledning.årsinput,
        højre = højre_afledning.årsinput,
        gift_og_samlevende_ved_indkomstårets_udgang = gift_og_samlevende
    ))
    = venstre_fordeling = personskat_kgl_par32_aktiemodregningsfordeling(aktieavance.hovedperson, venstre_årsnetto, kursgevinst.venstre, venstre_fakta.valg.aktiemodregningsfordeling)
    = højre_fordeling = personskat_kgl_par32_aktiemodregningsfordeling(højre_aktieavance, højre_årsnetto, kursgevinst.højre, højre_fakta.valg.aktiemodregningsfordeling)
    = rute_gyldig = venstre_fordeling.input_gyldigt && højre_fordeling.input_gyldigt
    = samlet_gyldig = venstre_årsgrundlag.input_gyldigt && højre_årsgrundlag.input_gyldigt && aktieavance.par_gyldigt && venstre_afledning.input_gyldigt && højre_afledning.input_gyldigt && kursgevinst.venstre.input_gyldigt && kursgevinst.højre.input_gyldigt && rute_gyldig
    PersonskatKursgevinstPar32Årsparresultat(
        venstre_årsgrundlag = venstre_årsgrundlag,
        højre_årsgrundlag = højre_årsgrundlag,
        venstre_afledning = venstre_afledning,
        højre_afledning = højre_afledning,
        venstre_aktiemodregningsfordeling = venstre_fordeling,
        højre_aktiemodregningsfordeling = højre_fordeling,
        aktieavance = personskat_aktieavance_par_med_kgl_par32(aktieavance, kursgevinst, venstre_fordeling, højre_fordeling, samlet_gyldig),
        kursgevinst = kursgevinst,
        input_gyldigt = samlet_gyldig
    )
}
| personskat_kgl_par32_historiktrin(venstre_identifikation: Tekst, højre_identifikation: Tekst, har_ægtefælle: Boolsk, tilstand: PersonskatKursgevinstPar32Forløbstilstand, årspar: PersonskatKursgevinstPar32Historikpar) -> {
    = venstre_år = årspar.venstre.fakta.indkomstår
    = højre_år = årspar.højre.fakta.indkomstår
    = aktieavance = personskat_aktieavance_parresultat_fra_personer(
        årspar.venstre.aktieavance,
        venstre_år,
        årspar.højre.aktieavance,
        højre_år,
        årspar.venstre.gift_og_samlevende_ved_indkomstårets_udgang
    )
    = venstre_årsgrundlag = personskat_kgl_par32_årsgrundlagsafledning(årspar.venstre.årsgrundlag, venstre_identifikation, personskat_kgl_par32_ægtefælleidentifikation(har_ægtefælle, højre_identifikation), venstre_år)
    = højre_årsgrundlag = personskat_kgl_par32_årsgrundlagsafledning(årspar.højre.årsgrundlag, højre_identifikation, personskat_kgl_par32_ægtefælleidentifikation(har_ægtefælle, venstre_identifikation), højre_år)
    = årsresultat = personskat_kgl_par32_årsparresultat(
        venstre_identifikation,
        højre_identifikation,
        årspar.venstre.fakta,
        årspar.højre.fakta,
        venstre_årsgrundlag,
        højre_årsgrundlag,
        aktieavance,
        personskat_kgl_par32_venstre_fremførsel(tilstand.seneste_årsresultat),
        personskat_kgl_par32_højre_fremførsel(tilstand.seneste_årsresultat),
        årspar.venstre.gift_og_samlevende_ved_indkomstårets_udgang
    )
    = rækkefølge_gyldig = venstre_år == højre_år && (tilstand.næste_indkomstår == 0 || venstre_år == tilstand.næste_indkomstår)
    PersonskatKursgevinstPar32Forløbstilstand(
        seneste_årsresultat = Some(årsresultat),
        årsresultater = concat(tilstand.årsresultater, [årsresultat]),
        næste_indkomstår = venstre_år + 1,
        input_gyldigt = tilstand.input_gyldigt && rækkefølge_gyldig && årsresultat.input_gyldigt
    )
}
| personskat_kgl_par32_tom_forløbstilstand() -> PersonskatKursgevinstPar32Forløbstilstand(seneste_årsresultat = None, årsresultater = [], næste_indkomstår = 0, input_gyldigt = Sandt)
| personskat_kgl_par32_personkontekst(afledning: KursgevinstPar32PersonKildeårsafledning, årsresultat: KursgevinstPar32PersonÅrsresultat, forløb_gyldigt: Boolsk) -> MedPar32Årsresultat(
    afledning = afledning,
    årsresultat = årsresultat,
    personskattelov_resultat = par4_stk1_nr2_årsresultat(årsresultat),
    forløb_gyldigt = forløb_gyldigt
)
| personskat_kgl_par32_parresultat(input: PersonskatInput, aktieavance: PersonskatAktieavanceParResultat) -> {
    = hovedpersons_kursgevinst = input.kapitalindkomst.kursgevinst
    = ægtefælles_kursgevinst = personskat_kgl_par32_ægtefælles_input(input.ægtefælle)
    = har_forløb = personskat_kgl_par32_har_forløb(hovedpersons_kursgevinst) || personskat_kgl_par32_har_forløb(ægtefælles_kursgevinst)
    hvis har_forløb == Falskt {
        IntetPar32Kontraktforløb
    } ellers {
        = hovedperson_identifikation = personskat_kgl_skatteyder_identifikation(hovedpersons_kursgevinst)
        = modpart_identifikation = personskat_kgl_par32_modpartsidentifikation(hovedperson_identifikation, input.ægtefælle, ægtefælles_kursgevinst)
        = har_ægtefælle = personskat_kgl_par32_har_ægtefælle(input.ægtefælle)
        = historikparring = personskat_kgl_par32_historikparring(personskat_kgl_par32_historik(hovedpersons_kursgevinst), personskat_kgl_par32_historik(ægtefælles_kursgevinst))
        = historiktilstand = foldl(
            historikparring.årspar,
            personskat_kgl_par32_tom_forløbstilstand(),
            |tilstand: PersonskatKursgevinstPar32Forløbstilstand, årspar: PersonskatKursgevinstPar32Historikpar| personskat_kgl_par32_historiktrin(hovedperson_identifikation, modpart_identifikation, har_ægtefælle, tilstand, årspar)
        )
        = skatteår = input.lønmodtager.skatteår
        = hovedpersons_årsgrundlag = personskat_kgl_par32_årsgrundlagsafledning(
            personskat_kgl_par32_årsgrundlag_fra_input(hovedpersons_kursgevinst, input.kapitalindkomst.ejendomsavance),
            hovedperson_identifikation,
            personskat_kgl_par32_ægtefælleidentifikation(har_ægtefælle, modpart_identifikation),
            skatteår
        )
        = ægtefælles_årsgrundlag = personskat_kgl_par32_årsgrundlagsafledning(
            personskat_kgl_par32_årsgrundlag_fra_input(ægtefælles_kursgevinst, personskat_kgl_par32_ægtefælles_ejendomsavance_input(input.ægtefælle)),
            modpart_identifikation,
            personskat_kgl_par32_ægtefælleidentifikation(har_ægtefælle, hovedperson_identifikation),
            skatteår
        )
        = aktuelt_årsresultat = personskat_kgl_par32_årsparresultat(
            hovedperson_identifikation,
            modpart_identifikation,
            personskat_kgl_par32_aktuelt_kildeår(hovedpersons_kursgevinst, skatteår),
            personskat_kgl_par32_aktuelt_kildeår(ægtefælles_kursgevinst, skatteår),
            hovedpersons_årsgrundlag,
            ægtefælles_årsgrundlag,
            aktieavance,
            personskat_kgl_par32_venstre_fremførsel(historiktilstand.seneste_årsresultat),
            personskat_kgl_par32_højre_fremførsel(historiktilstand.seneste_årsresultat),
            personskat_kgl_par32_samlevende(input.ægtefælle)
        )
        = historik_fører_til_skatteår = historiktilstand.næste_indkomstår == 0 || historiktilstand.næste_indkomstår == skatteår
        = forløb_gyldigt = personskat_kgl_par32_identiteter_gyldige(hovedpersons_kursgevinst, input.ægtefælle, ægtefælles_kursgevinst) && historikparring.input_gyldigt && historiktilstand.input_gyldigt && historik_fører_til_skatteår && aktuelt_årsresultat.input_gyldigt && aktuelt_årsresultat.kursgevinst.venstre.indkomstår == skatteår && aktuelt_årsresultat.kursgevinst.højre.indkomstår == skatteår
        = hovedperson = personskat_kgl_par32_personkontekst(aktuelt_årsresultat.venstre_afledning, aktuelt_årsresultat.kursgevinst.venstre, forløb_gyldigt)
        = ægtefælle = hvis personskat_kgl_par32_har_ægtefælle(input.ægtefælle) { personskat_kgl_par32_personkontekst(aktuelt_årsresultat.højre_afledning, aktuelt_årsresultat.kursgevinst.højre, forløb_gyldigt) } ellers { UdenPar32Årsresultat }
        BeregnetPar32Kontraktforløb(
            historiske_årsresultater = historiktilstand.årsresultater,
            aktuelt_årsresultat = aktuelt_årsresultat,
            hovedperson = hovedperson,
            ægtefælle = ægtefælle,
            input_gyldigt = forløb_gyldigt
        )
    }
}
| personskat_kgl_par32_hovedperson_kontekst(resultat: PersonskatKursgevinstPar32ParResultat) -> match resultat {
    | IntetPar32Kontraktforløb -> UdenPar32Årsresultat
    | BeregnetPar32Kontraktforløb(_, _, hovedperson, _, _) -> hovedperson
}
| personskat_kgl_par32_ægtefælle_kontekst(resultat: PersonskatKursgevinstPar32ParResultat) -> match resultat {
    | IntetPar32Kontraktforløb -> UdenPar32Årsresultat
    | BeregnetPar32Kontraktforløb(_, _, _, ægtefælle, _) -> ægtefælle
}

| personskat_ejendomsdrift_ejendomsskattelov_input(fakta: PersonskatEjendomsdriftFakta, skatteår: Heltal) -> EjendomsskattelovPar3Input(
    indkomstår = skatteår,
    kategori = fakta.kategori,
    beliggenhed = fakta.beliggenhed,
    erhvervsmæssigt_udlejet = fakta.erhvervsmæssigt_udlejet,
    særlige_betingelser_for_nr6_til_nr8_opfyldt = fakta.særlige_betingelser_for_nr6_til_nr8_opfyldt
)
| personskat_ejendomsdrift_resultat(input: PersonskatEjendomsdriftInput, skatteår: Heltal) -> match input {
    | UdenEjendomsdriftEfterPar4Nr6 -> IngenEjendomsdriftEfterPar4Nr6
    | MedEjendomsdriftEfterPar4Nr6(fakta) -> {
        = ejendomsskattelov_input = personskat_ejendomsdrift_ejendomsskattelov_input(fakta, skatteår)
        = par4_input = par4_stk1_nr6_input_fra_ejendomsskattelov_par3(ejendomsskattelov_input, fakta.overskud_eller_underskud_kroner)
        BeregnetEjendomsdriftEfterPar4Nr6(
            fakta = fakta,
            ejendomsskattelov_input = ejendomsskattelov_input,
            par4_input = par4_input,
            par4_resultat = par4_stk1_nr6_resultat(par4_input)
        )
    }
}
| personskat_ejendomsdrift_kapitalposter(resultat: PersonskatEjendomsdriftResultat) -> match resultat {
    | BeregnetEjendomsdriftEfterPar4Nr6(_, _, par4_input, _) -> [par4_stk1_nr6_kapitalpost(par4_input)]
    | _ -> []
}

| personskat_fremlejerrolle_til_ligningslov15q(rolle: PersonskatFremlejerrolle) -> Ll15QLejer
| exception andelshaverrolle_til_ligningslov15q personskat_fremlejerrolle_til_ligningslov15q(rolle: PersonskatFremlejerrolle) -> Ll15QAndelshaver under rolle == PersonskatUdlejendeAndelshaver
| personskat_fremlejerrolle_til_ligningslov15p(rolle: PersonskatFremlejerrolle) -> Ll15PLejer
| exception andelshaverrolle_til_ligningslov15p personskat_fremlejerrolle_til_ligningslov15p(rolle: PersonskatFremlejerrolle) -> Ll15PAndelshaver under rolle == PersonskatUdlejendeAndelshaver
| personskat_indkomstårets_dage(skatteår: Heltal) -> 365
| exception personskat_skudår_har_366_dage personskat_indkomstårets_dage(skatteår: Heltal) -> 366 under kildeskat_skudår(skatteår)
| personskat_ligningslov15p_samordningsinput(fakta: PersonskatLigningslov15PSamordningsfakta, rolle: PersonskatFremlejerrolle, skatteår: Heltal) -> Ligningslov15PInput(
    skatteår = skatteår,
    rolle = personskat_fremlejerrolle_til_ligningslov15p(rolle),
    udlejningsform = fakta.udlejningsform,
    metode = Ll15PSkematiskBundfradrag,
    bruttolejeindtægt_kroner = fakta.bruttolejeindtægt_kroner,
    årlig_leje_eller_boligafgift_kroner = fakta.årlig_leje_eller_boligafgift_kroner,
    ejendomsværdi_kroner = 0,
    ejer_ejendom_omfattet_af_ejendomsskattelov3 = Falskt,
    samme_personer_mindst_fire_måneder = fakta.samme_personer_mindst_fire_måneder,
    lejet_eller_ejet_dage = fakta.lejet_eller_ejet_dage,
    udlejningsdage = fakta.udlejningsdage,
    indkomstårets_dage = personskat_indkomstårets_dage(skatteår),
    faktiske_udgifter_kroner = 0
)
| personskat_ligningslov15q_stk4_samordning(input: PersonskatLigningslov15QStk4Input, rolle: PersonskatFremlejerrolle, skatteår: Heltal) -> match input {
    | UdenSamordningMedLigningslov15P -> ll15q_ingen_stk4_samordning()
    | MedSamordningMedLigningslov15P(par15q_udlejningsdage, par15p_fakta, loftvalg) -> Ligningslov15QStk4Samordning(
        anvender_både_par15q_og_par15p = Sandt,
        par15q_udlejningsdage = par15q_udlejningsdage,
        par15p_resultat = ligningslov15p_resultat(personskat_ligningslov15p_samordningsinput(par15p_fakta, rolle, skatteår)),
        indkomstårets_dage = personskat_indkomstårets_dage(skatteår),
        loftvalg = loftvalg
    )
}
| personskat_ligningslov15q_stk4_samordning_gyldig(input: PersonskatLigningslov15QStk4Input, rolle: PersonskatFremlejerrolle, metode: Ligningslov15QMetode, skatteår: Heltal) -> match input {
    | UdenSamordningMedLigningslov15P -> Sandt
    | MedSamordningMedLigningslov15P(par15q_udlejningsdage, par15p_fakta, _) -> {
        = indkomstårets_dage = personskat_indkomstårets_dage(skatteår)
        = par15p_resultat = ligningslov15p_resultat(personskat_ligningslov15p_samordningsinput(par15p_fakta, rolle, skatteår))
        metode == Ll15QStk1Bundfradrag && indkomstårets_dage > 0 && par15q_udlejningsdage >= 0 && par15q_udlejningsdage <= indkomstårets_dage && par15p_fakta.bruttolejeindtægt_kroner >= 0 && par15p_fakta.årlig_leje_eller_boligafgift_kroner >= 0 && par15p_fakta.lejet_eller_ejet_dage >= 0 && par15p_fakta.lejet_eller_ejet_dage <= indkomstårets_dage && par15p_fakta.udlejningsdage >= 0 && par15p_fakta.udlejningsdage <= indkomstårets_dage && par15p_resultat.skematisk_anvendelig
    }
}
| personskat_ligningslov15q_input(fakta: PersonskatFremlejeFakta, skatteår: Heltal) -> Ligningslov15QInput(
    skatteår = skatteår,
    rolle = personskat_fremlejerrolle_til_ligningslov15q(fakta.rolle),
    udlejningsform = fakta.udlejningsform,
    boligstatus = fakta.boligstatus,
    indberetningsstatus = fakta.indberetningsstatus,
    metode = fakta.metode,
    bruttolejeindtægt_kroner = fakta.bruttolejeindtægt_kroner,
    faktiske_udgifter_kroner = fakta.faktiske_udgifter_kroner,
    ejer_ejendom_omfattet_af_ejendomsskattelov3 = Falskt,
    tidligere_anvendt_par15p_stk3 = fakta.tidligere_anvendt_par15p_stk3,
    stk4_samordning = personskat_ligningslov15q_stk4_samordning(fakta.stk4_samordning, fakta.rolle, skatteår)
)
| personskat_ligningslov15q_valgte_metode_anvendelig(resultat: Ligningslov15QResultat) -> resultat.stk1_anvendelig || resultat.stk3_anvendelig
| personskat_fremlejegrundlag_gyldigt(fakta: PersonskatFremlejeFakta, skatteår: Heltal, resultat: Ligningslov15QResultat) -> fakta.bruttolejeindtægt_kroner >= 0 && fakta.faktiske_udgifter_kroner >= 0 && personskat_ligningslov15q_stk4_samordning_gyldig(fakta.stk4_samordning, fakta.rolle, fakta.metode, skatteår) && personskat_ligningslov15q_valgte_metode_anvendelig(resultat)
| personskat_fremleje_resultat(input: PersonskatFremlejeInput, skatteår: Heltal) -> match input {
    | UdenFremlejeEfterLigningslov15Q -> IngenFremlejeEfterLigningslov15Q
    | MedFremlejeEfterLigningslov15Q(fakta) -> {
        = ligningslov15q_input = personskat_ligningslov15q_input(fakta, skatteår)
        = ligningslov15q_resultat = ligningslov15q_resultat(ligningslov15q_input)
        = stk4_samordning_gyldig = personskat_ligningslov15q_stk4_samordning_gyldig(fakta.stk4_samordning, fakta.rolle, fakta.metode, skatteår)
        hvis personskat_fremlejegrundlag_gyldigt(fakta, skatteår, ligningslov15q_resultat) {
            BeregnetFremlejeEfterLigningslov15Q(
                fakta = fakta,
                ligningslov15q_input = ligningslov15q_input,
                ligningslov15q_resultat = ligningslov15q_resultat,
                par4_resultat = par4_stk1_nr17_resultat_fra_ligningslov15q(ligningslov15q_input)
            )
        } ellers {
            UgyldigtFremlejegrundlag(
                fakta = fakta,
                ligningslov15q_input = ligningslov15q_input,
                ligningslov15q_resultat = ligningslov15q_resultat,
                stk4_samordning_gyldig = stk4_samordning_gyldig
            )
        }
    }
}
| personskat_fremleje_input_gyldigt(resultat: PersonskatFremlejeResultat) -> match resultat {
    | UgyldigtFremlejegrundlag(_, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_fremleje_kapitalposter(resultat: PersonskatFremlejeResultat) -> match resultat {
    | BeregnetFremlejeEfterLigningslov15Q(_, ligningslov15q_input, _, _) -> [par4_stk1_nr17_kapitalpost_fra_ligningslov15q(ligningslov15q_input)]
    | _ -> []
}

# PersonskatKapitalindkomstSag(input: PersonskatKapitalindkomstInput, skatteår: Heltal, aktieavance: PersonskatAktieavanceResultat, par32: PersonskatKursgevinstPar32PersonKontekst) {
    | reklassifikation() -> personskat_kapital_reklassifikation(input.renter.næringsstatus)
    | rentegrundlag_gyldigt() -> input.renter.renteindtægter_kroner >= 0 && input.renter.renteudgifter_kroner >= 0
    | ligningslov6_input_gyldigt() -> personskat_ligningslov6_input_gyldigt(input.renter.ligningslov6, skatteår)
    | ligningslov6a_input_gyldigt() -> personskat_ligningslov6a_input_gyldigt(input.renter.ligningslov6a, skatteår)
    | virksomhedskapital_resultat() -> personskat_virksomhedskapital_resultat(input.virksomhedskapital, skatteår)
    | virksomhedskapital_input_gyldigt() -> virksomhedskapital_resultat().alle_input_gyldige
    | pbl53a_resultat() -> personskat_pbl53a_resultat(input.pbl53a, skatteår)
    | pbl53a_input_gyldigt() -> pbl53a_resultat().alle_input_gyldige
    | ejendomsavancegrundlag_resultat() -> personskat_ejendomsavance_resultat(input.ejendomsavance, skatteår)
    | ejendomsavance_input_gyldigt() -> personskat_ejendomsavance_input_gyldigt(ejendomsavancegrundlag_resultat())
    | kursgevinst_resultat() -> personskat_kursgevinst_resultat_med_par32(input.kursgevinst, skatteår, ejendomsavancegrundlag_resultat(), par32)
    | kursgevinst_input_gyldigt() -> kursgevinst_resultat().input_gyldigt
    | ejendomsavance_resultat() -> personskat_ejendomsavance_resultat_med_fortjenestefordeling(ejendomsavancegrundlag_resultat(), kursgevinst_resultat(), skatteår)
    | fremleje_resultat() -> personskat_fremleje_resultat(input.fremleje, skatteår)
    | fremleje_input_gyldigt() -> personskat_fremleje_input_gyldigt(fremleje_resultat())
    | omkostningsresultater() -> map(input.omkostninger, |omkostning: PersonskatKapitalomkostningInput| personskat_kapitalomkostningsresultat(input.omkostninger, omkostning, skatteår))
    | omkostninger_gyldige() -> all(omkostningsresultater(), |resultat: PersonskatKapitalomkostningsresultat| resultat.input_gyldigt)
    | alle_input_gyldige() -> skatteår > 0 && rentegrundlag_gyldigt() && ligningslov6_input_gyldigt() && ligningslov6a_input_gyldigt() && virksomhedskapital_input_gyldigt() && pbl53a_input_gyldigt() && ejendomsavance_input_gyldigt() && kursgevinst_input_gyldigt() && fremleje_input_gyldigt() && omkostninger_gyldige()
    | ligningslov6_resultat() -> personskat_ligningslov6_resultat(input.renter.ligningslov6, skatteår)
    | ligningslov6_resultat_anvendt() -> personskat_ligningslov6_resultat_anvendt(input.renter.ligningslov6, skatteår)
    | ligningslov6a_resultat() -> personskat_ligningslov6a_resultat(input.renter.ligningslov6a, skatteår)
    | ligningslov6a_resultat_anvendt() -> personskat_ligningslov6a_resultat_anvendt(input.renter.ligningslov6a, skatteår)
    | rente_par4_input() -> Par4Stk1Nr1Input(
        renteindtægter_kroner = input.renter.renteindtægter_kroner,
        renteudgifter_kroner = input.renter.renteudgifter_kroner,
        ligningslov6_resultat = ligningslov6_resultat_anvendt(),
        ligningslov6a_resultat = ligningslov6a_resultat_anvendt(),
        personlig_reklassifikation = reklassifikation()
    )
    | rente_resultat() -> par4_stk1_nr1_resultat(rente_par4_input())
    | renteposter() -> hvis rentegrundlag_gyldigt() { [par4_stk1_nr1_kapitalpost(rente_par4_input())] } ellers { [] }
    | virksomhedskapitalposter() -> virksomhedskapital_resultat().kapitalposter
    | pbl53a_poster() -> pbl53a_resultat().kapitalposter
    | ejendomsdrift_resultat() -> personskat_ejendomsdrift_resultat(input.ejendomsdrift, skatteår)
    | ejendomsdriftposter() -> personskat_ejendomsdrift_kapitalposter(ejendomsdrift_resultat())
    | ejendomsavanceposter() -> hvis ejendomsavance_input_gyldigt() && kursgevinst_input_gyldigt() { personskat_ejendomsavance_kapitalposter(ejendomsavance_resultat()) } ellers { [] }
    | kursgevinstposter() -> kursgevinst_resultat().kapitalposter
    | fremlejeposter() -> personskat_fremleje_kapitalposter(fremleje_resultat())
    | kapitalomkostninger() -> personskat_kapitalomkostninger_til_par4(omkostningsresultater())
    | kapitalindkomst_resultat() -> par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
        poster = concat(concat(concat(concat(concat(concat(concat(renteposter(), virksomhedskapitalposter()), pbl53a_poster()), ejendomsdriftposter()), ejendomsavanceposter()), kursgevinstposter()), fremlejeposter()), aktieavance.kapitalposter),
        omkostninger = kapitalomkostninger()
    ))
    | resultat() -> {
        = reklassifikation_resultat = personskat_kapital_reklassifikation(input.renter.næringsstatus)
        = rentegrundlag_er_gyldigt = input.renter.renteindtægter_kroner >= 0 && input.renter.renteudgifter_kroner >= 0
        = ligningslov6_er_gyldig = personskat_ligningslov6_input_gyldigt(input.renter.ligningslov6, skatteår)
        = ligningslov6a_er_gyldig = personskat_ligningslov6a_input_gyldigt(input.renter.ligningslov6a, skatteår)
        = virksomhedskapital = personskat_virksomhedskapital_resultat(input.virksomhedskapital, skatteår)
        = pbl53a = personskat_pbl53a_resultat(input.pbl53a, skatteår)
        = ejendomsavancegrundlag = personskat_ejendomsavance_resultat(input.ejendomsavance, skatteår)
        = ejendomsavance_er_gyldig = personskat_ejendomsavance_input_gyldigt(ejendomsavancegrundlag)
        = kursgevinst = personskat_kursgevinst_resultat_med_par32(input.kursgevinst, skatteår, ejendomsavancegrundlag, par32)
        = kursgevinst_er_gyldig = kursgevinst.input_gyldigt
        = fordelt_ejendomsavance = personskat_ejendomsavance_resultat_med_fortjenestefordeling(ejendomsavancegrundlag, kursgevinst, skatteår)
        = fremleje = personskat_fremleje_resultat(input.fremleje, skatteår)
        = fremleje_er_gyldig = personskat_fremleje_input_gyldigt(fremleje)
        = omkostningsresultater_resultat = map(input.omkostninger, |omkostning: PersonskatKapitalomkostningInput| personskat_kapitalomkostningsresultat(input.omkostninger, omkostning, skatteår))
        = omkostninger_er_gyldige = all(omkostningsresultater_resultat, |resultat: PersonskatKapitalomkostningsresultat| resultat.input_gyldigt)
        = alle_input_er_gyldige = skatteår > 0 && rentegrundlag_er_gyldigt && ligningslov6_er_gyldig && ligningslov6a_er_gyldig && virksomhedskapital.alle_input_gyldige && pbl53a.alle_input_gyldige && ejendomsavance_er_gyldig && kursgevinst_er_gyldig && fremleje_er_gyldig && omkostninger_er_gyldige
        = ligningslov6 = personskat_ligningslov6_resultat(input.renter.ligningslov6, skatteår)
        = ligningslov6_anvendt = personskat_ligningslov6_resultat_anvendt(input.renter.ligningslov6, skatteår)
        = ligningslov6a = personskat_ligningslov6a_resultat(input.renter.ligningslov6a, skatteår)
        = ligningslov6a_anvendt = personskat_ligningslov6a_resultat_anvendt(input.renter.ligningslov6a, skatteår)
        = renteinput = Par4Stk1Nr1Input(
            renteindtægter_kroner = input.renter.renteindtægter_kroner,
            renteudgifter_kroner = input.renter.renteudgifter_kroner,
            ligningslov6_resultat = ligningslov6_anvendt,
            ligningslov6a_resultat = ligningslov6a_anvendt,
            personlig_reklassifikation = reklassifikation_resultat
        )
        = renteresultat = par4_stk1_nr1_resultat(renteinput)
        = renteposter_resultat = hvis rentegrundlag_er_gyldigt { [par4_stk1_nr1_kapitalpost(renteinput)] } ellers { [] }
        = ejendomsdrift = personskat_ejendomsdrift_resultat(input.ejendomsdrift, skatteår)
        = ejendomsdriftposter_resultat = personskat_ejendomsdrift_kapitalposter(ejendomsdrift)
        = ejendomsavanceposter_resultat = hvis ejendomsavance_er_gyldig && kursgevinst_er_gyldig { personskat_ejendomsavance_kapitalposter(fordelt_ejendomsavance) } ellers { [] }
        = fremlejeposter_resultat = personskat_fremleje_kapitalposter(fremleje)
        = kapitalomkostninger_resultat = personskat_kapitalomkostninger_til_par4(omkostningsresultater_resultat)
        = samlet_kapitalindkomst = par4_kapitalindkomst_resultat(Par4KapitalindkomstInput(
            poster = concat(concat(concat(concat(concat(concat(concat(renteposter_resultat, virksomhedskapital.kapitalposter), pbl53a.kapitalposter), ejendomsdriftposter_resultat), ejendomsavanceposter_resultat), kursgevinst.kapitalposter), fremlejeposter_resultat), aktieavance.kapitalposter),
            omkostninger = kapitalomkostninger_resultat
        ))
        PersonskatKapitalindkomstResultat(
            input = input,
            rentegrundlag_gyldigt = rentegrundlag_er_gyldigt,
            ligningslov6_input_gyldigt = ligningslov6_er_gyldig,
            ligningslov6a_input_gyldigt = ligningslov6a_er_gyldig,
            virksomhedskapital_input_gyldigt = virksomhedskapital.alle_input_gyldige,
            pbl53a_input_gyldigt = pbl53a.alle_input_gyldige,
            ejendomsavance_input_gyldigt = ejendomsavance_er_gyldig,
            kursgevinst_input_gyldigt = kursgevinst_er_gyldig,
            fremleje_input_gyldigt = fremleje_er_gyldig,
            omkostninger_gyldige = omkostninger_er_gyldige,
            alle_input_gyldige = alle_input_er_gyldige,
            ligningslov6_resultat = ligningslov6,
            ligningslov6a_resultat = ligningslov6a,
            rente_resultat = renteresultat,
            virksomhedskapital_resultat = virksomhedskapital,
            pbl53a_resultat = pbl53a,
            ejendomsdrift_resultat = ejendomsdrift,
            ejendomsavance_resultat = fordelt_ejendomsavance,
            kursgevinst_resultat = kursgevinst,
            fremleje_resultat = fremleje,
            omkostningsresultater = omkostningsresultater_resultat,
            kapitalindkomst_resultat = samlet_kapitalindkomst
        )
    }
}

| personskat_kapitalindkomst_resultat_med_par32(input: PersonskatKapitalindkomstInput, skatteår: Heltal, aktieavance: PersonskatAktieavanceResultat, par32: PersonskatKursgevinstPar32PersonKontekst) -> PersonskatKapitalindkomstSag(input, skatteår, aktieavance, par32).resultat()
| personskat_kapitalindkomst_resultat(input: PersonskatKapitalindkomstInput, skatteår: Heltal, aktieavance: PersonskatAktieavanceResultat) -> personskat_kapitalindkomst_resultat_med_par32(input, skatteår, aktieavance, UdenPar32Årsresultat)
| personskat_ingen_kapitalindkomst() -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    omkostninger = []
)
| personskat_intet_selvstændigt_pensionsoverskud() -> Pbl18SelvstændigOverskudInput(
    skattepligtigt_overskud_før_vsl22b_kroner = 0,
    renteudgifter_kroner = 0,
    kurstab_kroner = 0,
    renteindtægter_kroner = 0,
    udbytteindtægter_kroner = 0,
    kursgevinster_kroner = 0,
    udelukkede_afståelsesindkomster_kroner = 0
)
| personskat_ingen_pension() -> PersonskatPensionsInput(
    pensionsalder_status = Ll9lMereEnd15ÅrFørFolkepension,
    pbl18_indbetalinger = [],
    pbl18_selvstændig_overskud = personskat_intet_selvstændigt_pensionsoverskud(),
    pbl18_livrentevalg = Pbl18FordeltFradrag,
    pbl15a_årsgrundlag = Pbl15AÅrsgrundlag(
        afståelser = [],
        ordninger = [],
        kvalifikationsår = [],
        tidligere_indbetalinger = []
    ),
    pbl15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    øvrige_pbl20_årsgrundlag = pbl20_tomt_årsgrundlag(),
    aktiepensionsfradrag_valg = UdenAktiepensionsfradragIAktieindkomst
)

| personskat_pbl20_udbetalingsstatus(skattepligtig_udbetaling_kroner: Heltal, modregningspligtig_udbetaling_kroner: Heltal) -> Ll9lIngenPbl20Udbetaling
| exception personskat_har_undtaget_pbl20_udbetaling personskat_pbl20_udbetalingsstatus(skattepligtig_udbetaling_kroner: Heltal, modregningspligtig_udbetaling_kroner: Heltal) -> Ll9lUndtagetPbl20Udbetaling under skattepligtig_udbetaling_kroner > 0 && modregningspligtig_udbetaling_kroner == 0
| exception personskat_har_modregningspligtig_pbl20_udbetaling personskat_pbl20_udbetalingsstatus(skattepligtig_udbetaling_kroner: Heltal, modregningspligtig_udbetaling_kroner: Heltal) -> Ll9lModregningspligtigPbl20Udbetaling under modregningspligtig_udbetaling_kroner > 0

| personskat_pensionsudbetalingsresultat(skatteår: Heltal, pension: PersonskatPensionsInput) -> {
    = aktuelle_pbl20_resultat = pbl20_årsresultat(skatteår, pension.øvrige_pbl20_årsgrundlag)
    = foregående_pbl20_resultat = pbl20_årsresultat(skatteår - 1, pension.øvrige_pbl20_årsgrundlag)
    = aktuelle_pbl15b_resultat = pbl15b_udbetalingsårsresultat(skatteår, pension.pbl15b_årsgrundlag)
    = foregående_pbl15b_resultat = pbl15b_udbetalingsårsresultat(skatteår - 1, pension.pbl15b_årsgrundlag)
    PersonskatPensionsudbetalingsresultat(
        aktuelle_pbl20_resultat = aktuelle_pbl20_resultat,
        foregående_pbl20_resultat = foregående_pbl20_resultat,
        aktuelle_pbl15b_resultat = aktuelle_pbl15b_resultat,
        foregående_pbl15b_resultat = foregående_pbl15b_resultat,
        aktuelle_input_gyldige = aktuelle_pbl20_resultat.input_gyldigt && aktuelle_pbl15b_resultat.input_gyldigt,
        foregående_input_gyldige = foregående_pbl20_resultat.input_gyldigt && foregående_pbl15b_resultat.input_gyldigt,
        samlet_personlig_indkomst_i_året_kroner = aktuelle_pbl20_resultat.samlet_personlig_indkomst_kroner + aktuelle_pbl15b_resultat.samlet_personlig_indkomst_efter_par20_kroner,
        samlet_skattepligtig_pbl20_i_foregående_indkomstår_kroner = foregående_pbl20_resultat.samlet_skattepligtig_indkomst_kroner + foregående_pbl15b_resultat.samlet_skattepligtig_indkomst_efter_par20_kroner,
        samlet_modregningspligtig_pbl20_i_foregående_indkomstår_kroner = foregående_pbl20_resultat.samlet_modregningspligtig_efter_ligningslov9l_kroner + foregående_pbl15b_resultat.samlet_modregningspligtig_efter_ligningslov9l_kroner,
        samlet_pbl29_afgift_i_året_kroner = aktuelle_pbl15b_resultat.samlet_afgift_efter_par29_kroner
    )
}

# PersonskatPensionsSag(input: PersonskatPersonFakta, personlig_indkomst: PersonskatPersonligIndkomstResultat, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat, udenlandske_sociale_bidrag: PersonskatUdenlandskeSocialeBidragResultat, udbetalingsresultat: PersonskatPensionsudbetalingsresultat) {
    | lønmodtager_før_pensionsfradrag() -> LønmodtagerInput(
        skatteår = input.lønmodtager.skatteår,
        kommune = input.lønmodtager.kommune,
        bruttoløn_kroner = input.lønmodtager.bruttoløn_kroner + ligningsfradrag.erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner + ligningsfradrag.rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner + ligningsfradrag.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + kapitalindkomst.pbl53a_resultat.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner,
        øvrig_personlig_indkomst_kroner = ligningsfradrag.personlig_indkomst_kroner - ligningsfradrag.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.personlig_indkomst_tillæg_kroner + kapitalindkomst.virksomhedskapital_resultat.personlig_indkomst_regulering_kroner + aktieavance.aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner + udbetalingsresultat.samlet_personlig_indkomst_i_året_kroner + kapitalindkomst.pbl53a_resultat.personlig_indkomst_kroner - kapitalindkomst.pbl53a_resultat.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + personlig_indkomst.personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner - ligningsfradrag.erhvervsbefordring_fradrag_anvendt_kroner - personskat_udenlandske_sociale_bidrag_fradrag_kroner(udenlandske_sociale_bidrag) - personlig_indkomst.fradrag_i_personlig_indkomst_kroner,
        nettokapitalindkomst_kroner = kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner,
        ligningsmæssige_fradrag_kroner = ligningsfradrag.samlet_ligningsfradrag_kroner + personlig_indkomst.ligningsmæssigt_fradrag_kroner,
        pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
        personfradrag_alder_status = input.lønmodtager.personfradrag_alder_status,
        betaler_kirkeskat = input.lønmodtager.betaler_kirkeskat
    )
    | personlig_indkomst_før_pensionsfradrag_kroner() -> penge_positivt_beløb(personlig_indkomst_efter_am(lønmodtager_før_pensionsfradrag()))
    | årsinput() -> Pbl18Årsinput(
        indkomstår = input.lønmodtager.skatteår,
        personlig_indkomst_før_pensionsfradrag_kroner = personlig_indkomst_før_pensionsfradrag_kroner(),
        selvstændig_overskud = input.lønmodtager.pension.pbl18_selvstændig_overskud,
        livrentevalg = input.lønmodtager.pension.pbl18_livrentevalg,
        par15a_årsgrundlag = input.lønmodtager.pension.pbl15a_årsgrundlag,
        par15b_årsgrundlag = input.lønmodtager.pension.pbl15b_årsgrundlag,
        indbetalinger = input.lønmodtager.pension.pbl18_indbetalinger
    )
    | årsresultat() -> pbl18_årsresultat(årsinput())
    | aktiepensionsfradrag_valg_resultat() -> match input.lønmodtager.pension.aktiepensionsfradrag_valg {
        | UdenAktiepensionsfradragIAktieindkomst -> par4a_intet_pensionsfradrag_valg(input.lønmodtager.skatteår)
        | MedAktiepensionsfradragIAktieindkomst(ønsket_fradrag_kroner, meddelelse_dato_yyyymmdd, omgørelse_dato_yyyymmdd) -> par4a_pensionsfradrag_valg_resultat(AktiePensionsFradragValgInput(
            indkomstår = input.lønmodtager.skatteår,
            ønsket_fradrag_kroner = ønsket_fradrag_kroner,
            meddelelse_dato_yyyymmdd = meddelelse_dato_yyyymmdd,
            omgørelse_dato_yyyymmdd = omgørelse_dato_yyyymmdd,
            personlig_indkomst_status = IkkeFradragetIPersonligIndkomst
        ))
    }
    | aktiepensionsfradrag_resultat() -> par4a_pensionsfradrag_resultat(AktiePensionsFradragInput(
        aktieindkomst_efter_stk1_og_2_kroner = aktieavance.aktieindkomst_resultat.aktieindkomst_efter_stk1_og_2_kroner,
        pbl15a_grundlag = par4a_pbl15a_grundlag_fra_pbl18_år(årsresultat()),
        valg_resultat = aktiepensionsfradrag_valg_resultat()
    ))
    | par3_resultat() -> par3_stk2_nr3_resultat_fra_pbl18_år(
        årsresultat(),
        aktiepensionsfradrag_resultat()
    )
    | arbejdsgiver_rate_og_ophørende_efter_am_kroner() -> hvis årsresultat().input_gyldigt { årsresultat().arbejdsgivergrundlag.rate_og_ophørende_brutto_kroner - årsresultat().arbejdsgivergrundlag.rate_og_ophørende_am_bidrag_kroner } ellers { 0 }
    | arbejdsgiver_øvrige_efter_am_kroner() -> hvis årsresultat().input_gyldigt { årsresultat().arbejdsgivergrundlag.øvrige_efter_am_bidrag_kroner } ellers { 0 }
    | lønmodtager_pensionsfradrag() -> LønmodtagerPensionsfradrag(
        pensionsalder_status = input.lønmodtager.pension.pensionsalder_status,
        pbl18_fradragsberettiget_indbetaling_kroner = årsresultat().samlet_fradrag_i_skattepligtig_indkomst_kroner,
        pbl19_rate_ophørende_bortseelsesret_efter_am_kroner = arbejdsgiver_rate_og_ophørende_efter_am_kroner(),
        pbl19_øvrige_indbetalinger_efter_am_kroner = arbejdsgiver_øvrige_efter_am_kroner(),
        pbl20_indkomstskattepligtig_udbetaling_kroner = udbetalingsresultat.samlet_modregningspligtig_pbl20_i_foregående_indkomstår_kroner,
        pbl20_udbetaling_status = personskat_pbl20_udbetalingsstatus(
            udbetalingsresultat.samlet_skattepligtig_pbl20_i_foregående_indkomstår_kroner,
            udbetalingsresultat.samlet_modregningspligtig_pbl20_i_foregående_indkomstår_kroner
        )
    )
    | resultat() -> PersonskatPensionsResultat(
        pbl18_årsinput = årsinput(),
        pbl18_årsresultat = årsresultat(),
        udbetalingsresultat = udbetalingsresultat,
        aktiepensionsfradrag_resultat = aktiepensionsfradrag_resultat(),
        par3_stk2_nr3_resultat = par3_resultat(),
        lønmodtager_pensionsfradrag = lønmodtager_pensionsfradrag()
    )
}

| personskat_pensions_resultat(input: PersonskatPersonFakta, personlig_indkomst: PersonskatPersonligIndkomstResultat, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat, udenlandske_sociale_bidrag: PersonskatUdenlandskeSocialeBidragResultat) -> PersonskatPensionsSag(
    input,
    personlig_indkomst,
    erhvervsbefordring,
    ligningsfradrag,
    kapitalindkomst,
    aktieavance,
    udenlandske_sociale_bidrag,
    personskat_pensionsudbetalingsresultat(input.lønmodtager.skatteår, input.lønmodtager.pension)
).resultat()

# PersonskatAktieavanceEfterPensionSag(aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) {
    | aktieindkomst_resultat() -> Par4aAktieindkomstResultat(
        aktieindkomst_efter_stk1_og_2_kroner = aktieavance.aktieindkomst_resultat.aktieindkomst_efter_stk1_og_2_kroner,
        pensionsfradrag_i_aktieindkomst_kroner = pension.aktiepensionsfradrag_resultat.fradrag_i_aktieindkomst_kroner,
        aktieindkomst_efter_pensionsfradrag_kroner = pension.aktiepensionsfradrag_resultat.aktieindkomst_efter_fradrag_kroner,
        omklassificeret_personlig_indkomst_kroner = aktieavance.aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner,
        aktieindkomst_indgår_i_skattepligtig_indkomst = aktieavance.aktieindkomst_resultat.aktieindkomst_indgår_i_skattepligtig_indkomst
    )
    | resultat() -> PersonskatAktieavanceResultat(
        input = aktieavance.input,
        ordinært_aktieår = aktieavance.ordinært_aktieår,
        særlige_resultater = aktieavance.særlige_resultater,
        udbytter = aktieavance.udbytter,
        alle_input_gyldige = aktieavance.alle_input_gyldige,
        kapitalposter = aktieavance.kapitalposter,
        aktieposter = aktieavance.aktieposter,
        kapitalindkomst_resultat = aktieavance.kapitalindkomst_resultat,
        aktieindkomst_resultat = aktieindkomst_resultat(),
        personlig_indkomst_kroner = aktieavance.personlig_indkomst_kroner,
        kapitalindkomst_kroner = aktieavance.kapitalindkomst_kroner,
        aktieindkomst_kroner = aktieindkomst_resultat().aktieindkomst_efter_pensionsfradrag_kroner
    )
}
| personskat_aktieavance_efter_pensionsfradrag(aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat) -> PersonskatAktieavanceEfterPensionSag(aktieavance, pension).resultat()

| personskat_arbejdsmarkedsbidrag_kroner(input: PersonskatLønmodtagerInput, personlig_indkomst: PersonskatPersonligIndkomstResultat, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat) -> arbejdsmarkedsbidrag_lønmodtager_kroner(ArbejdsmarkedsbidragInput(
    lønvederlag_kroner = input.bruttoløn_kroner + ligningsfradrag.erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner + ligningsfradrag.rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner + kapitalindkomst.pbl53a_resultat.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner,
    naturalieværdi_kroner = ligningsfradrag.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner
))
| personskat_lønmodtager_input(input: PersonskatLønmodtagerInput, personlig_indkomst: PersonskatPersonligIndkomstResultat, erhvervsbefordring: PersonskatErhvervsbefordringResultat, ligningsfradrag: PersonskatLigningsfradragResultat, kapitalindkomst: PersonskatKapitalindkomstResultat, aktieavance: PersonskatAktieavanceResultat, pension: PersonskatPensionsResultat, udenlandske_sociale_bidrag: PersonskatUdenlandskeSocialeBidragResultat) -> LønmodtagerInput(
    skatteår = input.skatteår,
    kommune = input.kommune,
    bruttoløn_kroner = input.bruttoløn_kroner + ligningsfradrag.erhvervsbefordring_skattepligtig_godtgørelse_efter_par4_kroner + ligningsfradrag.rejsegodtgørelse_skattepligtig_efter_sømandsbeskatningslov4_stk2_kroner + ligningsfradrag.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + kapitalindkomst.pbl53a_resultat.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + personlig_indkomst.arbejdsmarkedsbidragsgrundlag_tillæg_kroner,
    øvrig_personlig_indkomst_kroner = ligningsfradrag.personlig_indkomst_kroner - ligningsfradrag.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner + kapitalindkomst.kapitalindkomst_resultat.personlig_indkomst_tillæg_kroner + kapitalindkomst.virksomhedskapital_resultat.personlig_indkomst_regulering_kroner + aktieavance.aktieindkomst_resultat.omklassificeret_personlig_indkomst_kroner + pension.udbetalingsresultat.samlet_personlig_indkomst_i_året_kroner + kapitalindkomst.pbl53a_resultat.personlig_indkomst_kroner - kapitalindkomst.pbl53a_resultat.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner + personlig_indkomst.personlig_indkomst_uden_nyt_arbejdsmarkedsbidrag_kroner - ligningsfradrag.erhvervsbefordring_fradrag_anvendt_kroner - pension.par3_stk2_nr3_resultat.fradrag_i_personlig_indkomst_kroner - personskat_udenlandske_sociale_bidrag_fradrag_kroner(udenlandske_sociale_bidrag) - personlig_indkomst.fradrag_i_personlig_indkomst_kroner,
    nettokapitalindkomst_kroner = kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner,
    ligningsmæssige_fradrag_kroner = ligningsfradrag.samlet_ligningsfradrag_kroner + personlig_indkomst.ligningsmæssigt_fradrag_kroner,
    pensionsfradrag = pension.lønmodtager_pensionsfradrag,
    personfradrag_alder_status = input.personfradrag_alder_status,
    betaler_kirkeskat = input.betaler_kirkeskat
)
| personskat_skatteforhold_med_cfc(forhold: LønmodtagerSkatteforhold, cfc: PersonskatCfcResultat) -> LønmodtagerSkatteforhold(
    aktieindkomst_kroner = forhold.aktieindkomst_kroner,
    ægtefælle_aktieindkomst_kroner = forhold.ægtefælle_aktieindkomst_kroner,
    aktieindkomst_ægtefæller_samlevende_ved_årets_udløb = forhold.aktieindkomst_ægtefæller_samlevende_ved_årets_udløb,
    ægtefælle_nettokapitalindkomst_kroner = forhold.ægtefælle_nettokapitalindkomst_kroner,
    kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb = forhold.kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb,
    cfc_indkomst_kroner = cfc.par4b_resultat.positiv_cfc_indkomst_til_par8b_kroner,
    par8c_status = forhold.par8c_status,
    personfradrag_skattepligt = forhold.personfradrag_skattepligt,
    personfradrag_valg_dato_yyyymmdd = forhold.personfradrag_valg_dato_yyyymmdd,
    personfradrag_omvalg_dato_yyyymmdd = forhold.personfradrag_omvalg_dato_yyyymmdd
)
| personskat_skatteforhold(input: PersonskatSkatteforholdInput, aktieavance: PersonskatAktieavanceResultat, cfc: PersonskatCfcResultat) -> personskat_skatteforhold_med_cfc(lønmodtager_skatteforhold_med_aktieindkomst_tillæg(personskat_angivne_skatteforhold(input), aktieavance.aktieindkomst_kroner), cfc)
| personskat_positiv_aktieindkomstskat(skatteår: Heltal, forhold: LønmodtagerSkatteforhold) -> aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(
    skatteår = skatteår,
    aktieindkomst_kroner = forhold.aktieindkomst_kroner,
    effektivt_grundbeløb_kroner = aktieindkomst_effektivt_grundbeløb_for_person(AktieindkomstÆgtefælleGrundbeløbInput(
        skatteår = skatteår,
        aktieindkomst_kroner = forhold.aktieindkomst_kroner,
        ægtefælle_aktieindkomst_kroner = forhold.ægtefælle_aktieindkomst_kroner,
        samlevende_ved_årets_udløb = forhold.aktieindkomst_ægtefæller_samlevende_ved_årets_udløb
    ))
))
| personskat_hovedperson_fakta(input: PersonskatInput) -> PersonskatPersonFakta(
    lønmodtager = input.lønmodtager,
    kapitalindkomst = input.kapitalindkomst,
    aktieavance = input.aktieavance,
    udenlandske_sociale_bidrag = input.udenlandske_sociale_bidrag,
    cfc = input.cfc,
    skatteforhold = input.skatteforhold,
    underskudsforhold = input.underskudsforhold,
    ejendomsskatter = input.ejendomsskatter
)

# PersonskatPersonGrundlagSag(fakta: PersonskatPersonFakta, aktieavance_før_pensionsfradrag: PersonskatAktieavanceResultat, par32: PersonskatKursgevinstPar32PersonKontekst) {
    | fiskerfradragssamordning() -> personskat_ll9g_koordinering(fakta.lønmodtager)
    | personlig_indkomst() -> personskat_personlig_indkomst_resultat(
        personskat_ll9g_personlig_indkomst_input(fakta.lønmodtager.personlig_indkomst, fiskerfradragssamordning()),
        fakta.lønmodtager.skatteår
    )
    | kapitalindkomst() -> personskat_kapitalindkomst_resultat_med_par32(fakta.kapitalindkomst, fakta.lønmodtager.skatteår, aktieavance_før_pensionsfradrag, par32)
    | erhvervsbefordring() -> personskat_erhvervsbefordring_resultat(fakta.lønmodtager.erhvervsbefordring, fakta.lønmodtager.skatteår)
    | foreløbigt_ligningsfradrag() -> personskat_ligningsfradrag_resultat(fakta.lønmodtager.ligningsfradrag, fakta.lønmodtager, erhvervsbefordring(), personlig_indkomst(), UdenLigningslov12Indkomstgrundlag)
    | udenlandske_sociale_bidrag() -> personskat_udenlandske_sociale_bidrag_resultat(
        fakta.udenlandske_sociale_bidrag,
        fakta.lønmodtager.skatteår,
        personskat_arbejdsmarkedsbidrag_kroner(fakta.lønmodtager, personlig_indkomst(), erhvervsbefordring(), foreløbigt_ligningsfradrag(), kapitalindkomst()),
        personskat_ligningslov8m_kildeskattepligt_forenelig(fakta.udenlandske_sociale_bidrag, fakta.skatteforhold)
    )
    | pension() -> personskat_pensions_resultat(
        fakta,
        personlig_indkomst(),
        erhvervsbefordring(),
        foreløbigt_ligningsfradrag(),
        kapitalindkomst(),
        aktieavance_før_pensionsfradrag,
        udenlandske_sociale_bidrag()
    )
    | aktieavance() -> personskat_aktieavance_efter_pensionsfradrag(aktieavance_før_pensionsfradrag, pension())
    | cfc() -> personskat_cfc_resultat(fakta.cfc, fakta.lønmodtager.skatteår)
    | lønmodtager_input_før_ligningslov12() -> personskat_lønmodtager_input(
        fakta.lønmodtager,
        personlig_indkomst(),
        erhvervsbefordring(),
        foreløbigt_ligningsfradrag(),
        kapitalindkomst(),
        aktieavance(),
        pension(),
        udenlandske_sociale_bidrag()
    )
    | ligningslov12_indkomstgrundlag() -> MedLigningslov12Indkomstgrundlag(
        personlig_indkomst_kroner = personlig_indkomst_efter_am(lønmodtager_input_før_ligningslov12()),
        positiv_nettokapitalindkomst_kroner = penge_positivt_beløb(lønmodtager_input_før_ligningslov12().nettokapitalindkomst_kroner)
    )
    | ligningsfradrag() -> personskat_ligningsfradrag_resultat(fakta.lønmodtager.ligningsfradrag, fakta.lønmodtager, erhvervsbefordring(), personlig_indkomst(), ligningslov12_indkomstgrundlag())
    | lønmodtager_input() -> personskat_lønmodtager_input(
        fakta.lønmodtager,
        personlig_indkomst(),
        erhvervsbefordring(),
        ligningsfradrag(),
        kapitalindkomst(),
        aktieavance(),
        pension(),
        udenlandske_sociale_bidrag()
    )
    | individuelle_skatteforhold() -> personskat_skatteforhold(fakta.skatteforhold, aktieavance(), cfc())
    | resultat() -> PersonskatPersonGrundlagResultat(
        fakta = fakta,
        personlig_indkomst = personlig_indkomst(),
        erhvervsbefordring = erhvervsbefordring(),
        ligningsfradrag = ligningsfradrag(),
        kapitalindkomst = kapitalindkomst(),
        aktieavance = aktieavance(),
        pension = pension(),
        udenlandske_sociale_bidrag = udenlandske_sociale_bidrag(),
        cfc = cfc(),
        lønmodtager_input = lønmodtager_input(),
        individuelle_skatteforhold = individuelle_skatteforhold()
    )
}
| personskat_person_grundlag_med_aktieavance_og_par32(fakta: PersonskatPersonFakta, aktieavance_før_pensionsfradrag: PersonskatAktieavanceResultat, par32: PersonskatKursgevinstPar32PersonKontekst) -> PersonskatPersonGrundlagSag(fakta, aktieavance_før_pensionsfradrag, par32).resultat()
| personskat_person_grundlag_med_aktieavance(fakta: PersonskatPersonFakta, aktieavance_før_pensionsfradrag: PersonskatAktieavanceResultat) -> personskat_person_grundlag_med_aktieavance_og_par32(fakta, aktieavance_før_pensionsfradrag, UdenPar32Årsresultat)
| personskat_person_grundlag(fakta: PersonskatPersonFakta) -> personskat_person_grundlag_med_aktieavance(fakta, personskat_aktieavance_resultat(fakta.aktieavance, fakta.lønmodtager.skatteår))

| personskat_skatteforhold_med_aktieindkomster_og_ægtefælle(forhold: LønmodtagerSkatteforhold, egen_aktieindkomst_kroner: Heltal, ægtefælle_aktieindkomst_kroner: Heltal, ægtefælle_nettokapitalindkomst_kroner: Heltal, samlevende_ved_indkomstårets_udløb: Boolsk) -> LønmodtagerSkatteforhold(
    aktieindkomst_kroner = egen_aktieindkomst_kroner,
    ægtefælle_aktieindkomst_kroner = ægtefælle_aktieindkomst_kroner,
    aktieindkomst_ægtefæller_samlevende_ved_årets_udløb = samlevende_ved_indkomstårets_udløb,
    ægtefælle_nettokapitalindkomst_kroner = ægtefælle_nettokapitalindkomst_kroner,
    kapitalindkomst_ægtefæller_samlevende_ved_årets_udløb = samlevende_ved_indkomstårets_udløb,
    cfc_indkomst_kroner = forhold.cfc_indkomst_kroner,
    par8c_status = forhold.par8c_status,
    personfradrag_skattepligt = forhold.personfradrag_skattepligt,
    personfradrag_valg_dato_yyyymmdd = forhold.personfradrag_valg_dato_yyyymmdd,
    personfradrag_omvalg_dato_yyyymmdd = forhold.personfradrag_omvalg_dato_yyyymmdd
)
| personskat_skatteforhold_med_ægtefælle(forhold: LønmodtagerSkatteforhold, ægtefælle_aktieindkomst_kroner: Heltal, ægtefælle_nettokapitalindkomst_kroner: Heltal, samlevende_ved_indkomstårets_udløb: Boolsk) -> personskat_skatteforhold_med_aktieindkomster_og_ægtefælle(
    forhold,
    forhold.aktieindkomst_kroner,
    ægtefælle_aktieindkomst_kroner,
    ægtefælle_nettokapitalindkomst_kroner,
    samlevende_ved_indkomstårets_udløb
)
| personskat_aktieindkomst_parårsresultat(hovedpersons_skatteår: Heltal, ægtefælles_skatteår: Heltal, hovedpersons_skatteforhold: LønmodtagerSkatteforhold, ægtefælles_skatteforhold: LønmodtagerSkatteforhold, samlevende_ved_indkomstårets_udløb: Boolsk) -> aktieindkomst_par_årsskat_resultat(AktieindkomstParÅrsskatInput(
    skatteår = hovedpersons_skatteår,
    egen_aktieindkomst_kroner = hovedpersons_skatteforhold.aktieindkomst_kroner,
    ægtefælles_aktieindkomst_kroner = ægtefælles_skatteforhold.aktieindkomst_kroner,
    samlevende_ved_årets_udløb = samlevende_ved_indkomstårets_udløb && hovedpersons_skatteår == ægtefælles_skatteår
))

| personskat_par13_par7_skat_kroner(model: LønmodtagerBeregning) -> model.før_personfradrag.topskat_kroner
| exception personskat_par13_reform_par7_er_mellemskat personskat_par13_par7_skat_kroner(model: LønmodtagerBeregning) -> model.før_personfradrag.mellemskat_kroner under model.input.skatteår >= 2026
| personskat_par13_par7a_skat_kroner(model: LønmodtagerBeregning) -> model.før_personfradrag.udligningsskat_kroner
| exception personskat_par13_reform_par7a_er_topskat personskat_par13_par7a_skat_kroner(model: LønmodtagerBeregning) -> model.før_personfradrag.topskat_kroner under model.input.skatteår >= 2026
| personskat_par13_par8_skat_kroner(model: LønmodtagerBeregning) -> model.før_personfradrag.sundhedsbidrag_kroner
| exception personskat_par13_reform_par8_er_toptopskat personskat_par13_par8_skat_kroner(model: LønmodtagerBeregning) -> model.før_personfradrag.toptopskat_kroner under model.input.skatteår >= 2026
| personskat_par13_modregningsskatter(model: LønmodtagerBeregning) -> Par13ModregningsSkatter(
    par6_skat_kroner = model.før_personfradrag.bundskat_kroner,
    par7_skat_kroner = personskat_par13_par7_skat_kroner(model),
    par7a_skat_kroner = personskat_par13_par7a_skat_kroner(model),
    par8_skat_kroner = personskat_par13_par8_skat_kroner(model),
    par8a_stk2_skat_kroner = model.før_personfradrag.aktieindkomstskat_kroner
)
| personskat_par13_modregningsskatter_efter_eget_underskud(model: LønmodtagerBeregning) -> Par13ModregningsSkatter(
    par6_skat_kroner = model.par13_underskud.modregning.par6_efter_kroner,
    par7_skat_kroner = model.par13_underskud.modregning.par7_efter_kroner,
    par7a_skat_kroner = model.par13_underskud.modregning.par7a_efter_kroner,
    par8_skat_kroner = model.par13_underskud.modregning.par8_efter_kroner,
    par8a_stk2_skat_kroner = model.par13_underskud.modregning.par8a_stk2_efter_kroner
)
| personskat_par13_forhold_uden_ægtefælle(underskudsforhold: PersonskatUnderskudsforholdInput, skatteår: Heltal) -> LønmodtagerPar13Forhold(
    egne_tidligere_underskud_kroner = personskat_egne_tidligere_underskud_kroner(underskudsforhold, skatteår),
    ægtefælle_skattepligtig_indkomst_kroner = 0,
    ægtefælles_egne_tidligere_underskud_kroner = 0,
    ægtefælle_modregningsskatter = par13_tomme_modregningsskatter(),
    gift_samlevende_ved_årets_udløb = Falskt,
    ikke_rummet_i_tidligere_indkomst_eller_skat = personskat_aktuelt_underskud_ikke_rummet_i_tidligere_indkomst_eller_skat(underskudsforhold, skatteår)
)
| personskat_par13_forhold_med_ægtefælle(egne_underskudsforhold: PersonskatUnderskudsforholdInput, ægtefælles_foreløbige_skat: LønmodtagerBeregning, samlevende_ved_indkomstårets_udløb: Boolsk, skatteår: Heltal) -> LønmodtagerPar13Forhold(
    egne_tidligere_underskud_kroner = personskat_egne_tidligere_underskud_kroner(egne_underskudsforhold, skatteår),
    ægtefælle_skattepligtig_indkomst_kroner = ægtefælles_foreløbige_skat.indkomstgrundlag.almindelig_skattepligtig_indkomst_kroner,
    ægtefælles_egne_tidligere_underskud_kroner = 0,
    ægtefælle_modregningsskatter = personskat_par13_modregningsskatter_efter_eget_underskud(ægtefælles_foreløbige_skat),
    gift_samlevende_ved_årets_udløb = samlevende_ved_indkomstårets_udløb,
    ikke_rummet_i_tidligere_indkomst_eller_skat = personskat_aktuelt_underskud_ikke_rummet_i_tidligere_indkomst_eller_skat(egne_underskudsforhold, skatteår)
)
| personskat_kun_par13_indgående_ægtefælle(afsenders_skat: LønmodtagerBeregning, samlevende_ved_indkomstårets_udløb: Boolsk) -> MedIndgåendeÆgtefælleoverførsler(
    afsenders_par13_underskud = afsenders_skat.par13_underskud,
    afsenders_statslige_personfradrag = lønmodtager_tom_statslig_personfradragsnedsættelse(),
    afsenders_ikke_statslige_personfradrag = lønmodtager_tom_ikke_statslig_personfradragsnedsættelse(),
    afsenders_par11_nedslag = lønmodtager_tom_par11_modregning(),
    gift_samlevende_ved_årets_udløb = samlevende_ved_indkomstårets_udløb
)
| personskat_indgående_ægtefælleoverførsler(afsenders_par13_skat: LønmodtagerBeregning, afsenders_skat_efter_par13: LønmodtagerBeregning, samlevende_ved_indkomstårets_udløb: Boolsk) -> MedIndgåendeÆgtefælleoverførsler(
    afsenders_par13_underskud = afsenders_par13_skat.par13_underskud,
    afsenders_statslige_personfradrag = afsenders_skat_efter_par13.statsligt_personfradrag,
    afsenders_ikke_statslige_personfradrag = afsenders_skat_efter_par13.ikke_statsligt_personfradrag,
    afsenders_par11_nedslag = afsenders_skat_efter_par13.par11_nedslag.modregning,
    gift_samlevende_ved_årets_udløb = samlevende_ved_indkomstårets_udløb
)

| personskat_ægtefælle_aktieavance_resultat(ægtefælle_fakta: PersonskatPersonFakta, parresultat: PersonskatÆgtefælleAktieavanceResultat) -> match parresultat {
    | IngenÆgtefælleAktieavance -> personskat_aktieavance_resultat(ægtefælle_fakta.aktieavance, ægtefælle_fakta.lønmodtager.skatteår)
    | BeregnetÆgtefælleAktieavance(resultat) -> resultat
}
| personskat_parberegning_med_par32(hovedgrundlag: PersonskatPersonGrundlagResultat, ægtefælle_input: PersonskatÆgtefælleInput, ægtefælle_aktieavance: PersonskatÆgtefælleAktieavanceResultat, ægtefælle_par32: PersonskatKursgevinstPar32PersonKontekst) -> match ægtefælle_input {
    | UdenÆgtefælle -> {
        = aktieindkomst_parår = personskat_aktieindkomst_parårsresultat(
            hovedgrundlag.fakta.lønmodtager.skatteår,
            hovedgrundlag.fakta.lønmodtager.skatteår,
            hovedgrundlag.individuelle_skatteforhold,
            lønmodtager_standard_skatteforhold(),
            Falskt
        )
        = hovedskatteforhold = personskat_skatteforhold_med_aktieindkomster_og_ægtefælle(
            hovedgrundlag.individuelle_skatteforhold,
            aktieindkomst_parår.egen_aktieindkomst_efter_ægtefællemodregning_kroner,
            0,
            0,
            Falskt
        )
        = par13_forhold = personskat_par13_forhold_uden_ægtefælle(hovedgrundlag.fakta.underskudsforhold, hovedgrundlag.fakta.lønmodtager.skatteår)
        = hovedskat = beregn_lønmodtager_model_med_skatteforhold_og_par13_forhold(
            hovedgrundlag.lønmodtager_input,
            hovedskatteforhold,
            par13_forhold
        )
        PersonskatParberegningResultat(
            hovedskat = hovedskat,
            hovedskatteforhold = hovedskatteforhold,
            ægtefælle = IngenÆgtefælleberegning,
            aktieindkomst_parår = aktieindkomst_parår
        )
    }
    | MedÆgtefælle(ægtefælle_fakta, samlevende_ved_indkomstårets_udløb) -> {
        = ægtefællegrundlag = personskat_person_grundlag_med_aktieavance_og_par32(ægtefælle_fakta, personskat_ægtefælle_aktieavance_resultat(ægtefælle_fakta, ægtefælle_aktieavance), ægtefælle_par32)
        = fælles_skatteår = hovedgrundlag.fakta.lønmodtager.skatteår == ægtefællegrundlag.fakta.lønmodtager.skatteår
        = aktieindkomst_samlevende_ved_indkomstårets_udløb = samlevende_ved_indkomstårets_udløb && fælles_skatteår
        = aktieindkomst_parår = personskat_aktieindkomst_parårsresultat(
            hovedgrundlag.fakta.lønmodtager.skatteår,
            ægtefællegrundlag.fakta.lønmodtager.skatteår,
            hovedgrundlag.individuelle_skatteforhold,
            ægtefællegrundlag.individuelle_skatteforhold,
            samlevende_ved_indkomstårets_udløb
        )
        = hovedskatteforhold = personskat_skatteforhold_med_aktieindkomster_og_ægtefælle(
            hovedgrundlag.individuelle_skatteforhold,
            aktieindkomst_parår.egen_aktieindkomst_efter_ægtefællemodregning_kroner,
            aktieindkomst_parår.ægtefælles_aktieindkomst_efter_ægtefællemodregning_kroner,
            ægtefællegrundlag.lønmodtager_input.nettokapitalindkomst_kroner,
            aktieindkomst_samlevende_ved_indkomstårets_udløb
        )
        = ægtefælleskabsskatteforhold = personskat_skatteforhold_med_aktieindkomster_og_ægtefælle(
            ægtefællegrundlag.individuelle_skatteforhold,
            aktieindkomst_parår.ægtefælles_aktieindkomst_efter_ægtefællemodregning_kroner,
            aktieindkomst_parår.egen_aktieindkomst_efter_ægtefællemodregning_kroner,
            hovedgrundlag.lønmodtager_input.nettokapitalindkomst_kroner,
            aktieindkomst_samlevende_ved_indkomstårets_udløb
        )
        = hoved_foreløbig = beregn_lønmodtager_model_med_skatteforhold_og_par13_forhold(
            hovedgrundlag.lønmodtager_input,
            hovedskatteforhold,
            personskat_par13_forhold_uden_ægtefælle(hovedgrundlag.fakta.underskudsforhold, hovedgrundlag.fakta.lønmodtager.skatteår)
        )
        = ægtefælle_foreløbig = beregn_lønmodtager_model_med_skatteforhold_og_par13_forhold(
            ægtefællegrundlag.lønmodtager_input,
            ægtefælleskabsskatteforhold,
            personskat_par13_forhold_uden_ægtefælle(ægtefællegrundlag.fakta.underskudsforhold, ægtefællegrundlag.fakta.lønmodtager.skatteår)
        )
        = hoved_par13_forhold = personskat_par13_forhold_med_ægtefælle(
            hovedgrundlag.fakta.underskudsforhold,
            ægtefælle_foreløbig,
            samlevende_ved_indkomstårets_udløb,
            hovedgrundlag.fakta.lønmodtager.skatteår
        )
        = ægtefælle_par13_forhold = personskat_par13_forhold_med_ægtefælle(
            ægtefællegrundlag.fakta.underskudsforhold,
            hoved_foreløbig,
            samlevende_ved_indkomstårets_udløb,
            ægtefællegrundlag.fakta.lønmodtager.skatteår
        )
        = hoved_par13_kilde = beregn_lønmodtager_model_med_skatteforhold_og_par13_forhold(
            hovedgrundlag.lønmodtager_input,
            hovedskatteforhold,
            hoved_par13_forhold
        )
        = ægtefælle_par13_kilde = beregn_lønmodtager_model_med_skatteforhold_og_par13_forhold(
            ægtefællegrundlag.lønmodtager_input,
            ægtefælleskabsskatteforhold,
            ægtefælle_par13_forhold
        )
        = hoved_efter_par13 = beregn_lønmodtager_model_med_ægtefælleoverførsler(
            hovedgrundlag.lønmodtager_input,
            hovedskatteforhold,
            hoved_par13_forhold,
            personskat_kun_par13_indgående_ægtefælle(ægtefælle_par13_kilde, samlevende_ved_indkomstårets_udløb)
        )
        = ægtefælle_efter_par13 = beregn_lønmodtager_model_med_ægtefælleoverførsler(
            ægtefællegrundlag.lønmodtager_input,
            ægtefælleskabsskatteforhold,
            ægtefælle_par13_forhold,
            personskat_kun_par13_indgående_ægtefælle(hoved_par13_kilde, samlevende_ved_indkomstårets_udløb)
        )
        = hovedskat = beregn_lønmodtager_model_med_ægtefælleoverførsler(
            hovedgrundlag.lønmodtager_input,
            hovedskatteforhold,
            hoved_par13_forhold,
            personskat_indgående_ægtefælleoverførsler(ægtefælle_par13_kilde, ægtefælle_efter_par13, samlevende_ved_indkomstårets_udløb)
        )
        = ægtefælleskat = beregn_lønmodtager_model_med_ægtefælleoverførsler(
            ægtefællegrundlag.lønmodtager_input,
            ægtefælleskabsskatteforhold,
            ægtefælle_par13_forhold,
            personskat_indgående_ægtefælleoverførsler(hoved_par13_kilde, hoved_efter_par13, samlevende_ved_indkomstårets_udløb)
        )
        PersonskatParberegningResultat(
            hovedskat = hovedskat,
            hovedskatteforhold = hovedskatteforhold,
            ægtefælle = BeregnetÆgtefælle(
                fakta = ægtefælle_fakta,
                grundlag = ægtefællegrundlag,
                skat = ægtefælleskat,
                samlevende_ved_indkomstårets_udløb = samlevende_ved_indkomstårets_udløb
            ),
            aktieindkomst_parår = aktieindkomst_parår
        )
    }
}
| personskat_parberegning(hovedgrundlag: PersonskatPersonGrundlagResultat, ægtefælle_input: PersonskatÆgtefælleInput, ægtefælle_aktieavance: PersonskatÆgtefælleAktieavanceResultat) -> personskat_parberegning_med_par32(hovedgrundlag, ægtefælle_input, ægtefælle_aktieavance, UdenPar32Årsresultat)
| personskat_kildeskat_par8a_kredit_input_gyldigt(input: PersonskatÅrsopgørelseInput) -> match input {
    | UdenÅrsopgørelse -> Sandt
    | MedÅrsopgørelse(_, _, kreditter) -> kreditter.personskattelov_par8a_stk5_beløb_kroner == 0
    | MedEksaktÅrsopgørelse(_, _, kreditter) -> kreditter.personskattelov_par8a_stk5_beløb_øre == 0
}
| personskat_kreditter_med_negativ_aktieindkomstskat(kreditter: KildeskatPar60Kreditter, negativ_aktieindkomstskat_modregnet_kroner: Heltal) -> KildeskatPar60Kreditter(
    a_skat_og_am_indeholdt_kroner = kreditter.a_skat_og_am_indeholdt_kroner,
    par68_indbetalt_kroner = kreditter.par68_indbetalt_kroner,
    b_skat_betalt_kroner = kreditter.b_skat_betalt_kroner,
    udbytteskat_modregningsberettiget_kroner = kreditter.udbytteskat_modregningsberettiget_kroner,
    frivillig_indbetaling_par59_kroner = kreditter.frivillig_indbetaling_par59_kroner,
    virksomhedsordning_beløb_kroner = kreditter.virksomhedsordning_beløb_kroner,
    personskattelov_par8a_stk5_beløb_kroner = negativ_aktieindkomstskat_modregnet_kroner,
    afskrivningslov_acontoskat_kroner = kreditter.afskrivningslov_acontoskat_kroner,
    am_lov_par6_beløb_kroner = kreditter.am_lov_par6_beløb_kroner,
    seniornedslag_kroner = kreditter.seniornedslag_kroner,
    energiafgiftskompensation_kroner = kreditter.energiafgiftskompensation_kroner,
    tilbagebetalt_par55_kroner = kreditter.tilbagebetalt_par55_kroner
)
| personskat_kreditter_øre_med_negativ_aktieindkomstskat(kreditter: KildeskatPar60KreditterØre, negativ_aktieindkomstskat_modregnet_kroner: Heltal) -> KildeskatPar60KreditterØre(
    a_skat_og_am_indeholdt_øre = kreditter.a_skat_og_am_indeholdt_øre,
    par68_indbetalt_øre = kreditter.par68_indbetalt_øre,
    b_skat_betalt_øre = kreditter.b_skat_betalt_øre,
    udbytteskat_modregningsberettiget_øre = kreditter.udbytteskat_modregningsberettiget_øre,
    frivillig_indbetaling_par59_øre = kreditter.frivillig_indbetaling_par59_øre,
    virksomhedsordning_beløb_øre = kreditter.virksomhedsordning_beløb_øre,
    personskattelov_par8a_stk5_beløb_øre = negativ_aktieindkomstskat_modregnet_kroner * 100,
    afskrivningslov_acontoskat_øre = kreditter.afskrivningslov_acontoskat_øre,
    am_lov_par6_beløb_øre = kreditter.am_lov_par6_beløb_øre,
    seniornedslag_øre = kreditter.seniornedslag_øre,
    energiafgiftskompensation_øre = kreditter.energiafgiftskompensation_øre,
    tilbagebetalt_par55_øre = kreditter.tilbagebetalt_par55_øre
)
| personskat_årsopgørelse(input: PersonskatÅrsopgørelseInput, slutskat_før_negativ_aktieindkomstskat_kroner: Heltal, pension: PersonskatPensionsResultat, negativ_aktieindkomstskat_modregnet_kroner: Heltal) -> match input {
    | UdenÅrsopgørelse -> IngenÅrsopgørelse
    | MedÅrsopgørelse(overført_restskat_mv_kroner, øvrig_pensionsbeskatningsafgift_kroner, kreditter) -> {
        = årsopgørelsesinput_kroner = KildeskatSlutopgørelseInput(
            slutskat_kroner = slutskat_før_negativ_aktieindkomstskat_kroner,
            overført_restskat_mv_kroner = overført_restskat_mv_kroner,
            pensionsbeskatningsafgift_kroner = øvrig_pensionsbeskatningsafgift_kroner + pension.udbetalingsresultat.samlet_pbl29_afgift_i_året_kroner,
            kreditter = personskat_kreditter_med_negativ_aktieindkomstskat(kreditter, negativ_aktieindkomstskat_modregnet_kroner)
        )
        = årsopgørelsesinput = kildeskat_slutopgørelse_eksakt_input_fra_kroner(årsopgørelsesinput_kroner)
        BeregnetÅrsopgørelse(
            input = årsopgørelsesinput,
            resultat = kildeskat_slutopgørelse_eksakt_resultat(årsopgørelsesinput)
        )
    }
    | MedEksaktÅrsopgørelse(overført_restskat_mv_øre, øvrig_pensionsbeskatningsafgift_øre, kreditter) -> {
        = årsopgørelsesinput = KildeskatSlutopgørelseEksaktInput(
            slutskat_øre = slutskat_før_negativ_aktieindkomstskat_kroner * 100,
            overført_restskat_mv_øre = overført_restskat_mv_øre,
            pensionsbeskatningsafgift_øre = øvrig_pensionsbeskatningsafgift_øre + pension.udbetalingsresultat.samlet_pbl29_afgift_i_året_kroner * 100,
            kreditter = personskat_kreditter_øre_med_negativ_aktieindkomstskat(kreditter, negativ_aktieindkomstskat_modregnet_kroner)
        )
        BeregnetÅrsopgørelse(
            input = årsopgørelsesinput,
            resultat = kildeskat_slutopgørelse_eksakt_resultat(årsopgørelsesinput)
        )
    }
}
| personskat_ejendomsskat_indkomstkomponenter(grundlag: PersonskatPersonGrundlagResultat) -> EjendomsskattelovIndkomstkomponenter(
    personlig_indkomst_kroner = personlig_indkomst_efter_am(grundlag.lønmodtager_input),
    kapitalindkomst_kroner = grundlag.lønmodtager_input.nettokapitalindkomst_kroner,
    aktieindkomst_kroner = grundlag.individuelle_skatteforhold.aktieindkomst_kroner
)
| personskat_ejendomsskat_ægtefælle_indkomstkomponenter(ægtefælle: PersonskatÆgtefælleBeregningResultat) -> match ægtefælle {
    | IngenÆgtefælleberegning -> EjendomsskattelovIndkomstkomponenter(personlig_indkomst_kroner = 0, kapitalindkomst_kroner = 0, aktieindkomst_kroner = 0)
    | BeregnetÆgtefælle(_, grundlag, _, _) -> personskat_ejendomsskat_indkomstkomponenter(grundlag)
}
| personskat_ejendomsskat_gift_og_samlevende(ægtefælle: PersonskatÆgtefælleBeregningResultat) -> match ægtefælle {
    | IngenÆgtefælleberegning -> Falskt
    | BeregnetÆgtefælle(_, _, _, samlevende) -> samlevende
}
| personskat_ejendomsskat_årskontekst(hovedgrundlag: PersonskatPersonGrundlagResultat, parberegning: PersonskatParberegningResultat, fakta: EjendomsskattelovPersonÅrsfakta) -> EjendomsskattelovPersonÅrskontekst(
    indkomstår = hovedgrundlag.lønmodtager_input.skatteår,
    kildefakta = fakta.person,
    egen_indkomst = personskat_ejendomsskat_indkomstkomponenter(hovedgrundlag),
    ægtefælles_indkomst = personskat_ejendomsskat_ægtefælle_indkomstkomponenter(parberegning.ægtefælle),
    gift_og_samlevende_ved_indkomstårets_udgang = personskat_ejendomsskat_gift_og_samlevende(parberegning.ægtefælle)
)
| personskat_ægtefælle_ejendomsskatter(hovedgrundlag: PersonskatPersonGrundlagResultat, ægtefælle: PersonskatÆgtefælleBeregningResultat) -> match ægtefælle {
    | IngenÆgtefælleberegning -> IngenÆgtefælleEjendomsskatter
    | BeregnetÆgtefælle(fakta, grundlag, _, samlevende) -> {
        = kontekst = EjendomsskattelovPersonÅrskontekst(
            indkomstår = grundlag.lønmodtager_input.skatteår,
            kildefakta = fakta.ejendomsskatter.person,
            egen_indkomst = personskat_ejendomsskat_indkomstkomponenter(grundlag),
            ægtefælles_indkomst = personskat_ejendomsskat_indkomstkomponenter(hovedgrundlag),
            gift_og_samlevende_ved_indkomstårets_udgang = samlevende
        )
        BeregnedeÆgtefælleEjendomsskatter(
            fakta = fakta.ejendomsskatter,
            resultat = ejendomsskattelov_person_årsresultat(kontekst, fakta.ejendomsskatter.ejendomme)
        )
    }
}
| personskat_ægtefælle_ejendomsskat_kroner(resultat: PersonskatÆgtefælleEjendomsskatterResultat) -> match resultat {
    | IngenÆgtefælleEjendomsskatter -> 0
    | BeregnedeÆgtefælleEjendomsskatter(_, ejendomsskatter) -> ejendomsskatter.samlet_ejendomsskat_kroner
}
| personskat_kgl_par32_justeret_aktieavance(før_par32: PersonskatAktieavanceParResultat, par32: PersonskatKursgevinstPar32ParResultat) -> match par32 {
    | IntetPar32Kontraktforløb -> før_par32
    | BeregnetPar32Kontraktforløb(_, aktuelt_årsresultat, _, _, _) -> aktuelt_årsresultat.aktieavance
}
| personskat_skattepligtig_indkomst_før_underskudsfremførsel_kroner(model: LønmodtagerBeregning, fremført_underskud_primo_kroner: Heltal) -> model.indkomstgrundlag.almindelig_skattepligtig_indkomst_kroner + fremført_underskud_primo_kroner + model.indgående_ægtefælle.par13_indkomstfradrag_kroner
| personskat_underskudsårsresultat(underskudsforhold: PersonskatUnderskudsforholdInput, model: LønmodtagerBeregning) -> {
    = indkomstår = model.input.skatteår
    = åbningsgrundlag_gyldigt = personskat_underskudsforhold_gyldigt(underskudsforhold, indkomstår)
    = fremført_underskud_primo_kroner = personskat_egne_tidligere_underskud_kroner(underskudsforhold, indkomstår)
    = årets_skattepligtige_indkomst_før_fremførsel_kroner = personskat_skattepligtig_indkomst_før_underskudsfremførsel_kroner(model, fremført_underskud_primo_kroner)
    PersonskatUnderskudsårsresultat(
        indkomstår = indkomstår,
        åbningsgrundlag_gyldigt = åbningsgrundlag_gyldigt,
        fremført_underskud_primo_kroner = fremført_underskud_primo_kroner,
        årets_skattepligtige_indkomst_før_fremførsel_kroner = årets_skattepligtige_indkomst_før_fremførsel_kroner,
        fremført_underskud_anvendt_i_egen_indkomst_kroner = penge_mindste_beløb(fremført_underskud_primo_kroner, penge_positivt_beløb(årets_skattepligtige_indkomst_før_fremførsel_kroner)),
        årets_nye_underskud_kroner = par13_absolut_underskud(årets_skattepligtige_indkomst_før_fremførsel_kroner),
        dækket_ved_egen_skattemodregning_kroner = model.par13_underskud.stk1_fremførsel.dækket_underskud_ved_skattemodregning_kroner,
        fradraget_i_ægtefælles_indkomst_kroner = model.par13_underskud.ægtefælle_egne_underskud_prioritet.overført_underskud_indkomstfradrag_kroner,
        dækket_ved_ægtefælles_skattemodregning_kroner = model.par13_underskud.ægtefælle_egne_underskud_prioritet.overført_underskud_skattemodregning.dækket_underskud_ved_skattemodregning_kroner,
        fremført_underskud_ultimo_kroner = model.par13_underskud.fremført_efter_ægtefælle_kroner
    )
}
| personskat_ægtefælle_underskudsårsresultat(ægtefælle: PersonskatÆgtefælleBeregningResultat) -> match ægtefælle {
    | IngenÆgtefælleberegning -> None
    | BeregnetÆgtefælle(fakta, _, skat, _) -> Some(personskat_underskudsårsresultat(fakta.underskudsforhold, skat))
}
| personskat_ægtefælle_underskudsgrundlag_gyldigt(ægtefælle: PersonskatÆgtefælleBeregningResultat, hovedpersons_indkomstår: Heltal) -> match ægtefælle {
    | IngenÆgtefælleberegning -> Sandt
    | BeregnetÆgtefælle(fakta, _, _, _) -> fakta.lønmodtager.skatteår == hovedpersons_indkomstår && personskat_underskudsforhold_gyldigt(fakta.underskudsforhold, fakta.lønmodtager.skatteår)
}
| personskat_underskudsparårsresultat(input: PersonskatInput, parberegning: PersonskatParberegningResultat) -> PersonskatUnderskudsparårsresultat(
    hovedperson = personskat_underskudsårsresultat(input.underskudsforhold, parberegning.hovedskat),
    ægtefælle = personskat_ægtefælle_underskudsårsresultat(parberegning.ægtefælle),
    alle_åbningsgrundlag_gyldige = personskat_underskudsforhold_gyldigt(input.underskudsforhold, input.lønmodtager.skatteår) && personskat_ægtefælle_underskudsgrundlag_gyldigt(parberegning.ægtefælle, input.lønmodtager.skatteår)
)
| personskat_ægtefælles_slutskat_før_negativ_aktieindkomstskat_kroner(parberegning: PersonskatParberegningResultat, ægtefælles_ejendomsskatter: PersonskatÆgtefælleEjendomsskatterResultat) -> match parberegning.ægtefælle {
    | IngenÆgtefælleberegning -> 0
    | BeregnetÆgtefælle(_, grundlag, skat, _) -> {
        = positiv_aktieindkomstskat = aktieindkomst_positiv_skat(AktieindkomstPositivSkatInput(
            skatteår = grundlag.fakta.lønmodtager.skatteår,
            aktieindkomst_kroner = parberegning.aktieindkomst_parår.ægtefælles_aktieindkomst_efter_ægtefællemodregning_kroner,
            effektivt_grundbeløb_kroner = parberegning.aktieindkomst_parår.ægtefælles_effektive_grundbeløb_kroner
        ))
        = sømandsbeskatning = søbl5_lempelsesresultat(skat, grundlag.personlig_indkomst.sømandsbeskatning)
        sømandsbeskatning.samlet_skat_inkl_am_efter_dis_lempelse_kroner + positiv_aktieindkomstskat.endelig_skat_kroner + personskat_ægtefælle_ejendomsskat_kroner(ægtefælles_ejendomsskatter)
    }
}
| personskat_negativ_aktieindkomstskat_resultat(parberegning: PersonskatParberegningResultat, hovedpersons_slutskat_før_negativ_aktieindkomstskat_kroner: Heltal, ægtefælles_ejendomsskatter: PersonskatÆgtefælleEjendomsskatterResultat) -> aktieindkomst_negativ_skat_par_resultat(AktieindkomstNegativSkatParInput(
    egen_negativ_skat_kroner = penge_positivt_beløb(0 - parberegning.aktieindkomst_parår.egen_skat_kroner),
    ægtefælles_negativ_skat_kroner = penge_positivt_beløb(0 - parberegning.aktieindkomst_parår.ægtefælles_skat_kroner),
    egen_slutskat_før_negativ_skat_kroner = hovedpersons_slutskat_før_negativ_aktieindkomstskat_kroner,
    ægtefælles_slutskat_før_negativ_skat_kroner = personskat_ægtefælles_slutskat_før_negativ_aktieindkomstskat_kroner(parberegning, ægtefælles_ejendomsskatter),
    samlevende_ved_årets_udløb = parberegning.aktieindkomst_parår.input.samlevende_ved_årets_udløb
))
| personskat_negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner(resultat: AktieindkomstNegativSkatParResultat) -> resultat.egen.modregnet_i_egen_slutskat_kroner + resultat.ægtefælle.modregnet_i_ægtefælles_slutskat_kroner
| personskat_negativ_aktieskat_har_ægtefælle(parberegning: PersonskatParberegningResultat) -> match parberegning.ægtefælle {
    | IngenÆgtefælleberegning -> Falskt
    | BeregnetÆgtefælle(_, _, _, _) -> Sandt
}
| personskat_negativ_aktieskat_ægtefælleåbning_gyldig(input: PersonskatNegativAktieskatFremførselsinput, skatteår: Heltal, parberegning: PersonskatParberegningResultat) -> hvis personskat_negativ_aktieskat_har_ægtefælle(parberegning) {
    personskat_negativ_aktieskat_fremførselsinput_gyldigt(input, skatteår, ÆgtefællensNegativAktieskat)
} ellers {
    input == UdenFremførtNegativAktieskat
}
| personskat_negativ_aktieskat_tidligere_fremførsel_resultat(input: PersonskatInput, parberegning: PersonskatParberegningResultat, årets_negative_skat: AktieindkomstNegativSkatParResultat) -> {
    = skatteår = input.lønmodtager.skatteår
    = hovedpersons_trancher = personskat_negativ_aktieskat_trancher_primo(input.negativ_aktieskat_fremførsel.hovedperson, skatteår, HovedpersonensNegativAktieskat)
    = ægtefælles_trancher = hvis personskat_negativ_aktieskat_har_ægtefælle(parberegning) {
        personskat_negativ_aktieskat_trancher_primo(input.negativ_aktieskat_fremførsel.ægtefælle, skatteår, ÆgtefællensNegativAktieskat)
    } ellers {
        []
    }
    aktieindkomst_negativ_skat_fremførselspar_resultat(AktieindkomstNegativSkatFremførselsparInput(
        egne_trancher = personskat_negativ_aktieskat_generiske_trancher(hovedpersons_trancher),
        ægtefælles_trancher = personskat_negativ_aktieskat_generiske_trancher(ægtefælles_trancher),
        egen_slutskat_før_fremført_negativ_skat_kroner = årets_negative_skat.egen_slutskat_efter_negativ_skat_kroner,
        ægtefælles_slutskat_før_fremført_negativ_skat_kroner = årets_negative_skat.ægtefælles_slutskat_efter_negativ_skat_kroner,
        samlevende_ved_årets_udløb = parberegning.aktieindkomst_parår.input.samlevende_ved_årets_udløb
    ))
}
| personskat_negativ_aktieskat_personårsresultat(ejer: PersonskatNegativAktieskatEjer, skatteår: Heltal, åbningsinput: PersonskatNegativAktieskatFremførselsinput, årets_negative_skat: AktieindkomstNegativSkatPersonResultat, tidligere_anvendelser: List(AktieindkomstNegativSkatFremførselsanvendelse)) -> {
    = åbningsgrundlag_gyldigt = personskat_negativ_aktieskat_fremførselsinput_gyldigt(åbningsinput, skatteår, ejer)
    = fremført_negativ_skat_primo = personskat_negativ_aktieskat_trancher_primo(åbningsinput, skatteår, ejer)
    PersonskatNegativAktieskatPersonÅrsresultat(
        ejer = ejer,
        indkomstår = skatteår,
        åbningsgrundlag_gyldigt = åbningsgrundlag_gyldigt,
        fremført_negativ_skat_primo = fremført_negativ_skat_primo,
        årets_negative_skat = årets_negative_skat,
        tidligere_fremført_negativ_skat_anvendelser = tidligere_anvendelser,
        fremført_negativ_skat_ultimo = personskat_negativ_aktieskat_trancher_ultimo(ejer, skatteår, tidligere_anvendelser, årets_negative_skat)
    )
}
| personskat_negativ_aktieskat_ægtefælleårsresultat(input: PersonskatInput, parberegning: PersonskatParberegningResultat, årets_negative_skat: AktieindkomstNegativSkatParResultat, tidligere_fremført_negativ_skat: AktieindkomstNegativSkatFremførselsparResultat) -> match parberegning.ægtefælle {
    | IngenÆgtefælleberegning -> None
    | BeregnetÆgtefælle(_, _, _, _) -> Some(personskat_negativ_aktieskat_personårsresultat(
        ÆgtefællensNegativAktieskat,
        input.lønmodtager.skatteår,
        input.negativ_aktieskat_fremførsel.ægtefælle,
        årets_negative_skat.ægtefælle,
        tidligere_fremført_negativ_skat.ægtefælles_anvendelser
    ))
}
| personskat_negativ_aktieskat_option_årsresultat_konsistent(resultat: Option(PersonskatNegativAktieskatPersonÅrsresultat)) -> match resultat {
    | None -> Sandt
    | Some(årsresultat) -> personskat_negativ_aktieskat_årsresultat_konsistent(årsresultat)
}
| personskat_negativ_aktieskat_parårsresultat(input: PersonskatInput, parberegning: PersonskatParberegningResultat, årets_negative_skat: AktieindkomstNegativSkatParResultat) -> {
    = skatteår = input.lønmodtager.skatteår
    = tidligere_fremført_negativ_skat = personskat_negativ_aktieskat_tidligere_fremførsel_resultat(input, parberegning, årets_negative_skat)
    = hovedperson = personskat_negativ_aktieskat_personårsresultat(
        HovedpersonensNegativAktieskat,
        skatteår,
        input.negativ_aktieskat_fremførsel.hovedperson,
        årets_negative_skat.egen,
        tidligere_fremført_negativ_skat.egne_anvendelser
    )
    = ægtefælle = personskat_negativ_aktieskat_ægtefælleårsresultat(input, parberegning, årets_negative_skat, tidligere_fremført_negativ_skat)
    = alle_åbningsgrundlag_gyldige = årets_negative_skat.input_gyldigt && tidligere_fremført_negativ_skat.input_gyldigt && hovedperson.åbningsgrundlag_gyldigt && personskat_negativ_aktieskat_ægtefælleåbning_gyldig(input.negativ_aktieskat_fremførsel.ægtefælle, skatteår, parberegning) && personskat_negativ_aktieskat_årsresultat_konsistent(hovedperson) && personskat_negativ_aktieskat_option_årsresultat_konsistent(ægtefælle)
    PersonskatNegativAktieskatParÅrsresultat(
        indkomstår = skatteår,
        hovedperson = hovedperson,
        ægtefælle = ægtefælle,
        tidligere_fremført_negativ_skat = tidligere_fremført_negativ_skat,
        alle_åbningsgrundlag_gyldige = alle_åbningsgrundlag_gyldige
    )
}
| personskat_beregning_resultat_fra_aktieavance_par(input: PersonskatInput, aktieavance_før_par32: PersonskatAktieavanceParResultat) -> {
    = kursgevinst_par32 = personskat_kgl_par32_parresultat(input, aktieavance_før_par32)
    = aktieavance_par = personskat_kgl_par32_justeret_aktieavance(aktieavance_før_par32, kursgevinst_par32)
    = hovedgrundlag = personskat_person_grundlag_med_aktieavance_og_par32(personskat_hovedperson_fakta(input), aktieavance_par.hovedperson, personskat_kgl_par32_hovedperson_kontekst(kursgevinst_par32))
    = parberegning = personskat_parberegning_med_par32(hovedgrundlag, input.ægtefælle, aktieavance_par.ægtefælle, personskat_kgl_par32_ægtefælle_kontekst(kursgevinst_par32))
    = skat = lønmodtager_breakdown_fra_model(parberegning.hovedskat)
    = sømandsbeskatning = søbl5_lempelsesresultat(parberegning.hovedskat, hovedgrundlag.personlig_indkomst.sømandsbeskatning)
    = positiv_aktieindkomstskat = personskat_positiv_aktieindkomstskat(input.lønmodtager.skatteår, parberegning.hovedskatteforhold)
    = samlet_skat_inkl_endelig_aktieindkomstskat_kroner = sømandsbeskatning.samlet_skat_inkl_am_efter_dis_lempelse_kroner + positiv_aktieindkomstskat.endelig_skat_kroner
    = ejendomsskatteårskontekst = personskat_ejendomsskat_årskontekst(hovedgrundlag, parberegning, input.ejendomsskatter)
    = ejendomsskatter = ejendomsskattelov_person_årsresultat(ejendomsskatteårskontekst, input.ejendomsskatter.ejendomme)
    = ægtefælles_ejendomsskatter = personskat_ægtefælle_ejendomsskatter(hovedgrundlag, parberegning.ægtefælle)
    = samlet_skat_inkl_ejendomsskatter_kroner = samlet_skat_inkl_endelig_aktieindkomstskat_kroner + ejendomsskatter.samlet_ejendomsskat_kroner
    = negativ_aktieindkomstskat = personskat_negativ_aktieindkomstskat_resultat(parberegning, samlet_skat_inkl_ejendomsskatter_kroner, ægtefælles_ejendomsskatter)
    = negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner = personskat_negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner(negativ_aktieindkomstskat)
    = samlet_skat_efter_negativ_aktieindkomstskat_kroner = penge_positivt_beløb(samlet_skat_inkl_endelig_aktieindkomstskat_kroner - negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner)
    = samlet_skat_inkl_ejendomsskatter_efter_negativ_aktieindkomstskat_kroner = negativ_aktieindkomstskat.egen_slutskat_efter_negativ_skat_kroner
    = negativ_aktieskat_fremførselsår = personskat_negativ_aktieskat_parårsresultat(input, parberegning, negativ_aktieindkomstskat)
    = samlet_skat_inkl_ejendomsskatter_efter_fremført_negativ_aktieindkomstskat_kroner = negativ_aktieskat_fremførselsår.tidligere_fremført_negativ_skat.egen_slutskat_efter_fremført_negativ_skat_kroner
    = fremført_negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner = negativ_aktieskat_fremførselsår.tidligere_fremført_negativ_skat.egen_slutskat_modregnet_kroner
    = samlet_negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner = negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner + fremført_negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner
    PersonskatBeregningResultat(
        skat = skat,
        sømandsbeskatning = sømandsbeskatning,
        indgående_ægtefælle = parberegning.hovedskat.indgående_ægtefælle,
        ægtefælle = parberegning.ægtefælle,
        underskudsår = personskat_underskudsparårsresultat(input, parberegning),
        aktieindkomst_parår = parberegning.aktieindkomst_parår,
        positiv_aktieindkomstskat = positiv_aktieindkomstskat,
        negativ_aktieindkomstskat = negativ_aktieindkomstskat,
        negativ_aktieskat_fremførselsår = negativ_aktieskat_fremførselsår,
        endelig_aktieindkomstskat_kroner = positiv_aktieindkomstskat.endelig_skat_kroner,
        samlet_skat_inkl_endelig_aktieindkomstskat_kroner = samlet_skat_inkl_endelig_aktieindkomstskat_kroner,
        samlet_skat_efter_negativ_aktieindkomstskat_kroner = samlet_skat_efter_negativ_aktieindkomstskat_kroner,
        ejendomsskatter = ejendomsskatter,
        ægtefælles_ejendomsskatter = ægtefælles_ejendomsskatter,
        samlet_skat_inkl_ejendomsskatter_kroner = samlet_skat_inkl_ejendomsskatter_kroner,
        samlet_skat_inkl_ejendomsskatter_efter_negativ_aktieindkomstskat_kroner = samlet_skat_inkl_ejendomsskatter_efter_negativ_aktieindkomstskat_kroner,
        samlet_skat_inkl_ejendomsskatter_efter_fremført_negativ_aktieindkomstskat_kroner = samlet_skat_inkl_ejendomsskatter_efter_fremført_negativ_aktieindkomstskat_kroner,
        kildeskat_par8a_kredit_input_gyldigt = personskat_kildeskat_par8a_kredit_input_gyldigt(input.årsopgørelse),
        personlig_indkomst = hovedgrundlag.personlig_indkomst,
        pension = hovedgrundlag.pension,
        erhvervsbefordring = hovedgrundlag.erhvervsbefordring,
        ligningsfradrag = hovedgrundlag.ligningsfradrag,
        kapitalindkomst = hovedgrundlag.kapitalindkomst,
        aktieavance = hovedgrundlag.aktieavance,
        kursgevinst_par32 = kursgevinst_par32,
        udenlandske_sociale_bidrag = hovedgrundlag.udenlandske_sociale_bidrag,
        cfc = hovedgrundlag.cfc,
        årsopgørelse = personskat_årsopgørelse(
            input.årsopgørelse,
            samlet_skat_inkl_ejendomsskatter_kroner,
            hovedgrundlag.pension,
            samlet_negativ_aktieindkomstskat_modregnet_i_hovedpersons_slutskat_kroner
        )
    )
}
| personskat_kgl_par32_parresultat_gyldigt(resultat: PersonskatKursgevinstPar32ParResultat) -> match resultat { | IntetPar32Kontraktforløb -> Sandt | BeregnetPar32Kontraktforløb(_, _, _, _, input_gyldigt) -> input_gyldigt }
| personskat_ægtefælle_aktieavance_gyldig(resultat: PersonskatÆgtefælleAktieavanceResultat) -> match resultat { | IngenÆgtefælleAktieavance -> Sandt | BeregnetÆgtefælleAktieavance(aktieavance) -> aktieavance.alle_input_gyldige }
| personskat_ægtefælles_slutskat_kroner(resultat: PersonskatBeregningResultat) -> resultat.negativ_aktieskat_fremførselsår.tidligere_fremført_negativ_skat.ægtefælles_slutskat_efter_fremført_negativ_skat_kroner
| personskat_slutskat_parprojektion(input: PersonskatInput, aktieavance_før_par32: PersonskatAktieavanceParResultat) -> {
    = resultat = personskat_beregning_resultat_fra_aktieavance_par(input, aktieavance_før_par32)
    PersonskatSlutskatParprojektion(
        hovedperson_kroner = resultat.samlet_skat_inkl_ejendomsskatter_efter_fremført_negativ_aktieindkomstskat_kroner,
        ægtefælle_kroner = personskat_ægtefælles_slutskat_kroner(resultat),
        input_gyldigt = aktieavance_før_par32.par_gyldigt && resultat.aktieavance.alle_input_gyldige && personskat_ægtefælle_aktieavance_gyldig(aktieavance_før_par32.ægtefælle) && personskat_kgl_par32_parresultat_gyldigt(resultat.kursgevinst_par32)
    )
}
| personskat_slutskat_for_par_kroner(projektion: PersonskatSlutskatParprojektion) -> projektion.hovedperson_kroner + projektion.ægtefælle_kroner
| personskat_par37_til40_aktuelle_resultater_for_person(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat, person: PersonskatPar37Til40Skatteperson) -> hvis person == Par37Til40Hovedperson {
    filter(parresultat.hovedperson.særlige_resultater, |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_resultat_har_aktuel_afledning(resultat, input.lønmodtager.skatteår))
} ellers {
    = ægtefælles_skatteår = personskat_ægtefælle_skatteår(input.ægtefælle, input.lønmodtager.skatteår)
    filter(personskat_ægtefælle_særlige_resultater(parresultat), |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_resultat_har_aktuel_afledning(resultat, ægtefælles_skatteår))
}
| personskat_par37_til40_aktuelt_resultat(person: PersonskatPar37Til40Skatteperson, resultat: PersonskatSærligtAktieaktivResultat) -> PersonskatPar37Til40AktueltResultat(
    nøgle = personskat_par37_til40_resultatnøgle(person, resultat),
    resultat = resultat,
    nettogevinst_før_gulv_kroner = personskat_par37_til40_nettogevinst_før_gulv_kroner(resultat)
)
| personskat_par37_til40_aktuelle_resultater_med_person(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat, person: PersonskatPar37Til40Skatteperson) -> map(
    personskat_par37_til40_aktuelle_resultater_for_person(input, parresultat, person),
    |resultat: PersonskatSærligtAktieaktivResultat| personskat_par37_til40_aktuelt_resultat(person, resultat)
)
| personskat_par37_til40_aktuelle_resultater(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat) -> concat(
    personskat_par37_til40_aktuelle_resultater_med_person(input, parresultat, Par37Til40Hovedperson),
    personskat_par37_til40_aktuelle_resultater_med_person(input, parresultat, Par37Til40Ægtefælle)
)
| personskat_par37_til40_resultater_i_tabsførst_rækkefølge(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat) -> {
    = aktuelle = personskat_par37_til40_aktuelle_resultater(input, parresultat)
    concat(
        filter(aktuelle, |aktuelt: PersonskatPar37Til40AktueltResultat| aktuelt.nettogevinst_før_gulv_kroner < 0),
        filter(aktuelle, |aktuelt: PersonskatPar37Til40AktueltResultat| aktuelt.nettogevinst_før_gulv_kroner >= 0)
    )
}
| personskat_par37_til40_skatteafledningstrin(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat, tilstand: PersonskatPar37Til40Skatteafledningstilstand, aktuelt: PersonskatPar37Til40AktueltResultat) -> {
    = uden_par = personskat_par37_til40_aktieavance_parprojektion(input, parresultat, tilstand.inkluderede_resultater, aktuelt.nøgle, UdenAktuelFraflytterindkomst)
    = umiddelbar_par = personskat_par37_til40_aktieavance_parprojektion(input, parresultat, tilstand.inkluderede_resultater, aktuelt.nøgle, MedAktuelUmiddelbarFraflytterindkomst)
    = fuld_par = personskat_par37_til40_aktieavance_parprojektion(input, parresultat, tilstand.inkluderede_resultater, aktuelt.nøgle, MedAktuelFuldFraflytterindkomst)
    = uden = personskat_slutskat_parprojektion(input, uden_par)
    = umiddelbar = personskat_slutskat_parprojektion(input, umiddelbar_par)
    = fuld = personskat_slutskat_parprojektion(input, fuld_par)
    = ikke_positivt_resultat = aktuelt.nettogevinst_før_gulv_kroner <= 0
    = faktisk_umiddelbar_skat_kroner = personskat_slutskat_for_par_kroner(umiddelbar)
    = faktisk_fuld_skat_kroner = personskat_slutskat_for_par_kroner(fuld)
    = tilskrevet_umiddelbar_skat_kroner = hvis ikke_positivt_resultat { tilstand.seneste_skat_med_fraflytterindkomst_kroner } ellers { penge_største_beløb(tilstand.seneste_skat_med_fraflytterindkomst_kroner, faktisk_umiddelbar_skat_kroner) }
    = tilskrevet_fuld_skat_kroner = hvis ikke_positivt_resultat { tilstand.seneste_skat_med_fraflytterindkomst_kroner } ellers { faktisk_fuld_skat_kroner }
    = tilskrivning_gyldig = ikke_positivt_resultat || faktisk_fuld_skat_kroner >= tilstand.seneste_skat_med_fraflytterindkomst_kroner
    = kontekst_gyldig = tilstand.input_gyldigt && aktuelt.resultat.input_gyldigt && uden.input_gyldigt && umiddelbar.input_gyldigt && fuld.input_gyldigt && tilskrivning_gyldig
    = skattekontekst = AblPar37Til40AfledtSlutskat(kontekst = AktieavancePar37Til40Slutskattekontekst(
        skat_uden_fraflytterindkomst_kroner = tilstand.seneste_skat_med_fraflytterindkomst_kroner,
        skat_før_henstandsvalgt_fraflytterindkomst_kroner = tilskrevet_umiddelbar_skat_kroner,
        skat_med_hele_fraflytterindkomsten_kroner = tilskrevet_fuld_skat_kroner,
        input_gyldigt = kontekst_gyldig
    ))
    PersonskatPar37Til40Skatteafledningstilstand(
        inkluderede_resultater = concat(tilstand.inkluderede_resultater, [aktuelt.nøgle]),
        slutskatsposter = concat(tilstand.slutskatsposter, [PersonskatPar37Til40Slutskatspost(nøgle = aktuelt.nøgle, skattekontekst = skattekontekst)]),
        seneste_skat_med_fraflytterindkomst_kroner = tilskrevet_fuld_skat_kroner,
        input_gyldigt = kontekst_gyldig
    )
}
| personskat_par37_til40_skat_uden_aktuelle_fraflytninger_kroner(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat) -> {
    = ingen_resultatnøgle = PersonskatPar37Til40Resultatnøgle(person = Par37Til40Hovedperson, aktieaktiv_identifikation = "")
    = uden_aktuelle = personskat_par37_til40_aktieavance_parprojektion(input, parresultat, [], ingen_resultatnøgle, UdenAktuelFraflytterindkomst)
    personskat_slutskat_for_par_kroner(personskat_slutskat_parprojektion(input, uden_aktuelle))
}
| personskat_par37_til40_skattekontekster(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat) -> foldl(
    personskat_par37_til40_resultater_i_tabsførst_rækkefølge(input, parresultat),
    PersonskatPar37Til40Skatteafledningstilstand(
        inkluderede_resultater = [],
        slutskatsposter = [],
        seneste_skat_med_fraflytterindkomst_kroner = personskat_par37_til40_skat_uden_aktuelle_fraflytninger_kroner(input, parresultat),
        input_gyldigt = Sandt
    ),
    |tilstand: PersonskatPar37Til40Skatteafledningstilstand, aktuelt: PersonskatPar37Til40AktueltResultat| personskat_par37_til40_skatteafledningstrin(input, parresultat, tilstand, aktuelt)
)
| personskat_par37_til40_skattekontekst_for_resultat(resultat: PersonskatSærligtAktieaktivResultat, person: PersonskatPar37Til40Skatteperson, slutskatsposter: List(PersonskatPar37Til40Slutskatspost)) -> {
    = nøgle = personskat_par37_til40_resultatnøgle(person, resultat)
    = matchende = filter(slutskatsposter, |post: PersonskatPar37Til40Slutskatspost| post.nøgle == nøgle)
    hvis length(matchende) == 1 { head(matchende).skattekontekst } ellers { aktieavance_par37_til40_lokal_skattekontekst() }
}
| personskat_særligt_aktieaktiv_med_par37_til40_skattekontekst(resultat: PersonskatSærligtAktieaktivResultat, person: PersonskatPar37Til40Skatteperson, skatteår: Heltal, slutskatsposter: List(PersonskatPar37Til40Slutskatspost)) -> hvis personskat_par37_til40_resultat_har_aktuel_afledning(resultat, skatteår) {
    match resultat.par37_til40_forløbsresultat {
        | None -> resultat
        | Some(forløb) -> {
            = nyt_forløb = aktieavance_par37_til40_forløbsresultat_med_skattekontekst(forløb.input, personskat_par37_til40_skattekontekst_for_resultat(resultat, person, slutskatsposter))
            PersonskatSærligtAktieaktivResultat(
                fakta = resultat.fakta,
                resultat = resultat.resultat,
                kilderesultater = resultat.kilderesultater,
                resultater = resultat.resultater,
                par17_resultat = resultat.par17_resultat,
                par35_forløbsresultat = resultat.par35_forløbsresultat,
                par37_til40_forløbsresultat = Some(nyt_forløb),
                kgl_par32_kontraktrelation = resultat.kgl_par32_kontraktrelation,
                årets_forfaldne_overdragerskat_kroner = resultat.årets_forfaldne_overdragerskat_kroner,
                årets_betalte_overdragerskat_kroner = resultat.årets_betalte_overdragerskat_kroner,
                årets_saldobortfald_kroner = resultat.årets_saldobortfald_kroner,
                årets_nye_henstand_med_fraflytterskat_kroner = nyt_forløb.årets_nye_henstand_kroner,
                årets_forfaldne_fraflytterskat_kroner = nyt_forløb.årets_skat_til_betaling_ved_fraflytning_kroner + nyt_forløb.årets_nye_forfald_kroner,
                årets_betalte_fraflytterskat_kroner = nyt_forløb.årets_betalte_fraflytterskat_kroner,
                årets_fraflytterskat_saldobortfald_kroner = nyt_forløb.årets_saldobortfald_kroner,
                input_gyldigt = resultat.input_gyldigt && nyt_forløb.input_gyldigt
            )
        }
    }
} ellers {
    resultat
}
| personskat_aktieavance_resultat_med_par37_til40_skattekontekster(resultat: PersonskatAktieavanceResultat, person: PersonskatPar37Til40Skatteperson, skatteår: Heltal, slutskatsposter: List(PersonskatPar37Til40Slutskatspost)) -> personskat_aktieavance_resultat_med_særlige_resultater(
    resultat,
    skatteår,
    map(resultat.særlige_resultater, |særligt_resultat: PersonskatSærligtAktieaktivResultat| personskat_særligt_aktieaktiv_med_par37_til40_skattekontekst(særligt_resultat, person, skatteår, slutskatsposter))
)
| personskat_aktieavance_parresultat_med_par37_til40_skattekontekster(input: PersonskatInput, parresultat: PersonskatAktieavanceParResultat, slutskatsposter: List(PersonskatPar37Til40Slutskatspost)) -> {
    = hovedpersons_skatteår = input.lønmodtager.skatteår
    = ægtefælles_skatteår = personskat_ægtefælle_skatteår(input.ægtefælle, hovedpersons_skatteår)
    = hovedperson = personskat_aktieavance_resultat_med_par37_til40_skattekontekster(parresultat.hovedperson, Par37Til40Hovedperson, hovedpersons_skatteår, slutskatsposter)
    match parresultat.ægtefælle {
        | IngenÆgtefælleAktieavance -> PersonskatAktieavanceParResultat(par_gyldigt = parresultat.par_gyldigt && hovedperson.alle_input_gyldige, hovedperson = hovedperson, ægtefælle = IngenÆgtefælleAktieavance)
        | BeregnetÆgtefælleAktieavance(resultat) -> {
            = ægtefælle = personskat_aktieavance_resultat_med_par37_til40_skattekontekster(resultat, Par37Til40Ægtefælle, ægtefælles_skatteår, slutskatsposter)
            PersonskatAktieavanceParResultat(par_gyldigt = parresultat.par_gyldigt && hovedperson.alle_input_gyldige && ægtefælle.alle_input_gyldige, hovedperson = hovedperson, ægtefælle = BeregnetÆgtefælleAktieavance(resultat = ægtefælle))
        }
    }
}
| personskat_beregning_resultat(input: PersonskatInput) -> {
    = rå_aktieavance = personskat_aktieavance_parresultat(input.aktieavance, input.lønmodtager.skatteår, input.ægtefælle)
    = skattekontekster = personskat_par37_til40_skattekontekster(input, rå_aktieavance)
    = aktieavance = personskat_aktieavance_parresultat_med_par37_til40_skattekontekster(input, rå_aktieavance, skattekontekster.slutskatsposter)
    personskat_beregning_resultat_fra_aktieavance_par(input, aktieavance)
}
| beregn_personskat_lønmodtager(input: LønmodtagerInput) -> beregn_lønmodtager(input)

@ calculate("Dansk personskat")
| beregn_personskat(input: PersonskatInput) -> personskat_beregning_resultat(input)
