)

= kgl_gæld_scenarie_frivillig_akkord_valuta = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "frivillig-akkord-valuta",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældFremmedValuta,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglFrivilligSamletKreditorordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    80000
)

= kgl_gæld_scenarie_ejet_selskab_akkord = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "ejet-selskab-akkord",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ejet_selskab,
        gældsordning = KglFrivilligSamletKreditorordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_pengeinstitut_fem_procent = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "pengeinstitut-fem-procent",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
