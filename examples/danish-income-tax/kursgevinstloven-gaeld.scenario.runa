    ),
    0
)

| kgl_gæld_scenarie_selskabseftergivelse(identifikation: Tekst, selskabsfakta: KursgevinstlovPar21Stk2Selskabsfakta) -> kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = identifikation,
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = selskabsfakta,
        gældsordning = KglIngenSamletGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)
= kgl_gæld_scenarie_overdraget_insolvent = kgl_gæld_scenarie_selskabseftergivelse("overdraget-insolvent", kgl_gæld_scenarie_overdraget_fra_ejet_selskab_insolvent)
= kgl_gæld_scenarie_overdraget_solid = kgl_gæld_scenarie_selskabseftergivelse("overdraget-solid", kgl_gæld_scenarie_overdraget_fra_ejet_selskab_solid)
= kgl_gæld_scenarie_ligningslov16e = kgl_gæld_scenarie_selskabseftergivelse("ligningslov-16e", kgl_gæld_scenarie_ejet_selskab_ligningslov16e)

= kgl_gæld_scenarie_valutagæld = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "valutagæld",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 97000, kreditorværdi_kroner = 97000),
        frigørelsesart = KglGældOrdinærIndfrielse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældFremmedValuta,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenSamletGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    3000
)

= kgl_gæld_scenarie_valutagæld_bagatel = kursgevinstlov_gæld_resultat(
