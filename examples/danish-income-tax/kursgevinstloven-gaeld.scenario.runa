        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ejet_pengeinstitut_fem_procent,
        gældsordning = KglFrivilligSamletKreditorordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
