@ sprog da

@ importer ./kursgevinstloven

| kgl_gæld_scenarie_input(
    identifikation: Tekst,
    indkomstår: Heltal,
    beløb: KursgevinstlovGældBeløb,
    frigørelsesart: KursgevinstlovGældFrigørelsesart,
    erhvervsforhold: KursgevinstlovGældErhvervsforhold,
    valuta: KursgevinstlovGældValuta,
    selskabsfakta: KursgevinstlovPar21Stk2Selskabsfakta,
    gældsordning: KursgevinstlovGældsordning,
    vedrører_ikke_indbetalt_selskabskapital: Boolsk,
    par22_hændelse: KursgevinstlovPar22Hændelse
) -> kursgevinstlov_gæld_input(indkomstår, KursgevinstlovGældFakta(
    identifikation = identifikation,
    beløb = beløb,
    frigørelsesart = frigørelsesart,
    erhvervsforhold = erhvervsforhold,
    valuta = valuta,
    selskabsfakta = selskabsfakta,
    gældsordning = gældsordning,
    vedrører_ikke_indbetalt_selskabskapital = vedrører_ikke_indbetalt_selskabskapital,
    par22_hændelse = par22_hændelse
))

| kgl_gæld_scenarie_beløb(påtagelse_kroner: Heltal, frigørelse_kroner: Heltal, kreditorværdi_kroner: Heltal) -> KursgevinstlovGældBeløb(
    gældens_værdi_ved_påtagelse_kroner = påtagelse_kroner,
    gældens_værdi_ved_frigørelse_eller_indfrielse_kroner = frigørelse_kroner,
    fordringens_værdi_for_kreditor_kroner = kreditorværdi_kroner
)

| kgl_gæld_scenarie_fuld_frivillig_ordning(gældsidentifikation: Tekst, samlet_krav_kroner: Heltal, aftalt_restkrav_kroner: Heltal) -> KglFrivilligKreditorordning(fakta = KursgevinstlovFrivilligKreditorordningFakta(
    ordningsidentifikation = "frivillig-ordning",
    alle_usikrede_krav_oplyst = Sandt,
    krav = [KursgevinstlovFrivilligKreditorkrav(
        krav_identifikation = gældsidentifikation,
        kreditor_identifikation = "eneste-usikrede-kreditor",
        samlet_krav_kroner = samlet_krav_kroner,
        værdi_af_tilstrækkelig_sikkerhed_kroner = 0,
        deltagelse = KglKreditorTiltrådtFrivilligOrdning(aftalt_restkrav_kroner = aftalt_restkrav_kroner)
    )]
))

= kgl_gæld_scenarie_ingen_selskabsforbindelse = kgl_gæld_tom_par21_stk2_selskabsfakta()
= kgl_gæld_scenarie_ejet_selskab = KglAktuelGældTilSelskab(
    personen_eller_nærtstående_har_ejet_aktier_siden_gældspåtagelsen = Sandt,
    långiver_er_pengeinstitut = Falskt,
    personens_største_direkte_og_indirekte_ejerandel_basispoint = 2500,
    forpligtelse_omfattet_af_ligningslov16e = Falskt
)
= kgl_gæld_scenarie_ejet_pengeinstitut_fem_procent = KglAktuelGældTilSelskab(
    personen_eller_nærtstående_har_ejet_aktier_siden_gældspåtagelsen = Sandt,
    långiver_er_pengeinstitut = Sandt,
    personens_største_direkte_og_indirekte_ejerandel_basispoint = 500,
    forpligtelse_omfattet_af_ligningslov16e = Falskt
)
= kgl_gæld_scenarie_overdraget_fra_ejet_selskab_insolvent = KglOverdragetGældFraSelskab(
    personen_eller_nærtstående_har_ejet_aktier_i_det_tidligere_selskab_siden_gældspåtagelsen = Sandt,
    debitor_insolvent_ved_overdragelsen = Sandt,
    tidligere_långiver_var_pengeinstitut = Falskt,
    personens_største_direkte_og_indirekte_ejerandel_i_det_tidligere_selskab_basispoint = 2500,
    forpligtelse_omfattet_af_ligningslov16e = Falskt
)
= kgl_gæld_scenarie_overdraget_fra_ejet_selskab_solid = KglOverdragetGældFraSelskab(
    personen_eller_nærtstående_har_ejet_aktier_i_det_tidligere_selskab_siden_gældspåtagelsen = Sandt,
    debitor_insolvent_ved_overdragelsen = Falskt,
    tidligere_långiver_var_pengeinstitut = Falskt,
    personens_største_direkte_og_indirekte_ejerandel_i_det_tidligere_selskab_basispoint = 2500,
    forpligtelse_omfattet_af_ligningslov16e = Falskt
)
= kgl_gæld_scenarie_ejet_selskab_ligningslov16e = KglAktuelGældTilSelskab(
    personen_eller_nærtstående_har_ejet_aktier_siden_gældspåtagelsen = Sandt,
    långiver_er_pengeinstitut = Falskt,
    personens_største_direkte_og_indirekte_ejerandel_basispoint = 2500,
    forpligtelse_omfattet_af_ligningslov16e = Sandt
)

= kgl_gæld_scenarie_ordinær_dkk = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "ordinær-dkk",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 90000, kreditorværdi_kroner = 90000),
        frigørelsesart = KglGældOrdinærIndfrielse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_finansieringsnæring_gevinst = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "finansieringsnæring-gevinst",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 90000, kreditorværdi_kroner = 90000),
        frigørelsesart = KglGældOrdinærIndfrielse,
        erhvervsforhold = KglGældFinansieringsnæringMedVirksomhedstilknytning,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_finansieringsnæring_tab = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "finansieringsnæring-tab",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 112000, kreditorværdi_kroner = 112000),
        frigørelsesart = KglGældOrdinærIndfrielse,
        erhvervsforhold = KglGældFinansieringsnæringMedVirksomhedstilknytning,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_singulær_eftergivelse = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "singulær-eftergivelse",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_singulær_eftergivelse_valuta = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "singulær-eftergivelse-valuta",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældFremmedValuta,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    80000
)

= kgl_gæld_scenarie_singulær_eftergivelse_valuta_bagatel = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "singulær-eftergivelse-valuta-bagatel",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 98000, kreditorværdi_kroner = 100000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældFremmedValuta,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    2000
)

= kgl_gæld_scenarie_finansieringsnæring_singulær_eftergivelse_valuta = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "finansieringsnæring-singulær-eftergivelse-valuta",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældFinansieringsnæringMedVirksomhedstilknytning,
        valuta = KglGældFremmedValuta,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglIngenDokumenteretGældsordning,
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    80000
)

= kgl_gæld_scenarie_frivillig_akkord = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "frivillig-akkord",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = kgl_gæld_scenarie_fuld_frivillig_ordning("frivillig-akkord", 100000, 20000),
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_frivillig_akkord_valuta = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "frivillig-akkord-valuta",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældFremmedValuta,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = kgl_gæld_scenarie_fuld_frivillig_ordning("frivillig-akkord-valuta", 100000, 20000),
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    80000
)

= kgl_gæld_scenarie_ejet_selskab_akkord = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "ejet-selskab-akkord",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ejet_selskab,
        gældsordning = kgl_gæld_scenarie_fuld_frivillig_ordning("ejet-selskab-akkord", 100000, 20000),
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_pengeinstitut_fem_procent = kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = "pengeinstitut-fem-procent",
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 20000, kreditorværdi_kroner = 30000),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ejet_pengeinstitut_fem_procent,
        gældsordning = kgl_gæld_scenarie_fuld_frivillig_ordning("pengeinstitut-fem-procent", 100000, 20000),
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

| kgl_gæld_scenarie_deltagende_kreditorkrav(identifikation: Tekst, krav_kroner: Heltal, restkrav_kroner: Heltal) -> KursgevinstlovFrivilligKreditorkrav(
    krav_identifikation = identifikation,
    kreditor_identifikation = identifikation,
    samlet_krav_kroner = krav_kroner,
    værdi_af_tilstrækkelig_sikkerhed_kroner = 0,
    deltagelse = KglKreditorTiltrådtFrivilligOrdning(aftalt_restkrav_kroner = restkrav_kroner)
)
| kgl_gæld_scenarie_udeladt_kreditorkrav(identifikation: Tekst, krav_kroner: Heltal, småkravsgrundlag: KursgevinstlovUdeladtKravsSmåkravsgrundlag) -> KursgevinstlovFrivilligKreditorkrav(
    krav_identifikation = identifikation,
    kreditor_identifikation = identifikation,
    samlet_krav_kroner = krav_kroner,
    værdi_af_tilstrækkelig_sikkerhed_kroner = 0,
    deltagelse = KglKreditorUdenforFrivilligOrdning(småkravsgrundlag = småkravsgrundlag)
)
| kgl_gæld_scenarie_fuldt_sikret_udeladt_kreditorkrav(identifikation: Tekst, krav_kroner: Heltal) -> KursgevinstlovFrivilligKreditorkrav(
    krav_identifikation = identifikation,
    kreditor_identifikation = identifikation,
    samlet_krav_kroner = krav_kroner,
    værdi_af_tilstrækkelig_sikkerhed_kroner = krav_kroner,
    deltagelse = KglKreditorUdenforFrivilligOrdning(småkravsgrundlag = KglUdeladtKravUdenSmåkravsdokumentation)
)
| kgl_gæld_scenarie_frivillig_ordningsfakta(ordningsidentifikation: Tekst, alle_usikrede_krav_oplyst: Boolsk, krav: List(KursgevinstlovFrivilligKreditorkrav)) -> KursgevinstlovFrivilligKreditorordningFakta(
    ordningsidentifikation = ordningsidentifikation,
    alle_usikrede_krav_oplyst = alle_usikrede_krav_oplyst,
    krav = krav
)
| kgl_gæld_scenarie_eftergivelse_med_frivillig_ordning(identifikation: Tekst, påtagelse_kroner: Heltal, frigørelse_kroner: Heltal, kreditorværdi_kroner: Heltal, fakta: KursgevinstlovFrivilligKreditorordningFakta) -> kursgevinstlov_gæld_resultat(
    kgl_gæld_scenarie_input(
        identifikation = identifikation,
        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = påtagelse_kroner, frigørelse_kroner = frigørelse_kroner, kreditorværdi_kroner = kreditorværdi_kroner),
        frigørelsesart = KglGældEftergivelse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældDanskeKroner,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
        gældsordning = KglFrivilligKreditorordning(fakta = fakta),
        vedrører_ikke_indbetalt_selskabskapital = Falskt,
        par22_hændelse = KglIngenPar22Hændelse
    ),
    0
)

= kgl_gæld_scenarie_82_pct_med_dokumenterede_småkrav = kgl_gæld_scenarie_eftergivelse_med_frivillig_ordning(
    identifikation = "hovedkrav-82",
    påtagelse_kroner = 820800,
    frigørelse_kroner = 150000,
    kreditorværdi_kroner = 200000,
    fakta = kgl_gæld_scenarie_frivillig_ordningsfakta(
        ordningsidentifikation = "skm2017-10-mønster",
        alle_usikrede_krav_oplyst = Sandt,
        krav = [
            kgl_gæld_scenarie_deltagende_kreditorkrav("hovedkrav-82", 820800, 150000),
            kgl_gæld_scenarie_udeladt_kreditorkrav("småkrav-347", 34700, KglUdeladtKravDokumenteretSomSmåkrav(afgørelsesreference = "SKM2017.10.SR")),
            kgl_gæld_scenarie_udeladt_kreditorkrav("småkrav-717", 71700, KglUdeladtKravDokumenteretSomSmåkrav(afgørelsesreference = "SKM2017.10.SR")),
            kgl_gæld_scenarie_udeladt_kreditorkrav("småkrav-636", 63600, KglUdeladtKravDokumenteretSomSmåkrav(afgørelsesreference = "SKM2017.10.SR")),
            kgl_gæld_scenarie_udeladt_kreditorkrav("småkrav-92", 9200, KglUdeladtKravDokumenteretSomSmåkrav(afgørelsesreference = "SKM2017.10.SR")),
        ]
    )
)
= kgl_gæld_scenarie_677_pct_med_ikke_småkrav = kgl_gæld_scenarie_eftergivelse_med_frivillig_ordning(
    identifikation = "hovedkrav-677",
    påtagelse_kroner = 677000,
    frigørelse_kroner = 150000,
    kreditorværdi_kroner = 200000,
    fakta = kgl_gæld_scenarie_frivillig_ordningsfakta(
        ordningsidentifikation = "udeladt-væsentligt-krav",
        alle_usikrede_krav_oplyst = Sandt,
        krav = [
            kgl_gæld_scenarie_deltagende_kreditorkrav("hovedkrav-677", 677000, 150000),
            kgl_gæld_scenarie_udeladt_kreditorkrav("væsentligt-udeladt-krav", 288000, KglUdeladtKravDokumenteretSomIkkeSmåkrav(afgørelsesreference = "SKM2007.677.SR")),
            kgl_gæld_scenarie_udeladt_kreditorkrav("dokumenteret-småkrav", 35000, KglUdeladtKravDokumenteretSomSmåkrav(afgørelsesreference = "SKM2007.677.SR")),
        ]
    )
)
= kgl_gæld_scenarie_677_pct_uafklaret_småkrav = kgl_gæld_scenarie_eftergivelse_med_frivillig_ordning(
    identifikation = "hovedkrav-uafklaret",
    påtagelse_kroner = 677000,
    frigørelse_kroner = 150000,
    kreditorværdi_kroner = 200000,
    fakta = kgl_gæld_scenarie_frivillig_ordningsfakta(
        ordningsidentifikation = "uafklaret-småkrav",
        alle_usikrede_krav_oplyst = Sandt,
        krav = [
            kgl_gæld_scenarie_deltagende_kreditorkrav("hovedkrav-uafklaret", 677000, 150000),
            kgl_gæld_scenarie_udeladt_kreditorkrav("udeladt-uafklaret", 323000, KglUdeladtKravUdenSmåkravsdokumentation),
        ]
    )
)
= kgl_gæld_scenarie_ufuldstændig_kreditoropgørelse = kgl_gæld_scenarie_eftergivelse_med_frivillig_ordning(
    identifikation = "ufuldstændigt-hovedkrav",
    påtagelse_kroner = 100000,
    frigørelse_kroner = 20000,
    kreditorværdi_kroner = 30000,
    fakta = kgl_gæld_scenarie_frivillig_ordningsfakta(
