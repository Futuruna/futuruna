        indkomstår = 2026,
        beløb = kgl_gæld_scenarie_beløb(påtagelse_kroner = 100000, frigørelse_kroner = 96000, kreditorværdi_kroner = 96000),
        frigørelsesart = KglGældOrdinærIndfrielse,
        erhvervsforhold = KglGældUdenFinansieringsnæring,
        valuta = KglGældFremmedValutaKronereguleret,
        selskabsfakta = kgl_gæld_scenarie_ingen_selskabsforbindelse,
