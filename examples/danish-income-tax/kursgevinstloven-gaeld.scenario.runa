)

= kgl_gæld_scenarie_ukvalificeret_realkreditgrundlag = KursgevinstlovPar22Realkreditgrundlag(
    långiver_driver_finansieringsnæring = Falskt,
    sikkerhed = KglPar22IngenKvalificerendeSikkerhed,
    lånet_baseret_på_obligationer = Falskt,
    udbetalingsdato = KursgevinstlovGældDato(år = 2026, måned = 1, dag = 15),
    obligationskurs_ved_udbetaling_basispoint = 10500,
    lånetilbud = None
)
= kgl_gæld_scenarie_par22_undtagelsesgrundlag = KursgevinstlovPar22Realkreditgrundlag(
    långiver_driver_finansieringsnæring = Sandt,
    sikkerhed = KglPar22PantIFastEjendom,
    lånet_baseret_på_obligationer = Sandt,
    udbetalingsdato = KursgevinstlovGældDato(år = 2026, måned = 1, dag = 15),
    obligationskurs_ved_udbetaling_basispoint = 9900,
    lånetilbud = None
)
= kgl_gæld_scenarie_par22a_realkreditgrundlag = KursgevinstlovPar22Realkreditgrundlag(
    långiver_driver_finansieringsnæring = Sandt,
    sikkerhed = KglPar22PantIFastEjendom,
    lånet_baseret_på_obligationer = Sandt,
    udbetalingsdato = KursgevinstlovGældDato(år = 2026, måned = 1, dag = 15),
    obligationskurs_ved_udbetaling_basispoint = 10500,
    lånetilbud = None
)
= kgl_gæld_scenarie_par22_tilbud_præcis_seks_måneder = KursgevinstlovPar22Realkreditgrundlag(
    långiver_driver_finansieringsnæring = Sandt,
    sikkerhed = KglPar22PantIFastEjendom,
    lånet_baseret_på_obligationer = Sandt,
    udbetalingsdato = KursgevinstlovGældDato(år = 2026, måned = 1, dag = 15),
    obligationskurs_ved_udbetaling_basispoint = 10500,
    lånetilbud = Some(KursgevinstlovPar22Lånetilbud(
        dato = KursgevinstlovGældDato(år = 2025, måned = 7, dag = 15),
        obligationskurs_basispoint = 9900
    ))
)
