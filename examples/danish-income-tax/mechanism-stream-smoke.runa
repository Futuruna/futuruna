-- Small checked fixture for a query-owned function observer.
-- Isolated endpoint replay and mechanism publication are not implemented yet;
-- this fixture seals the canonical transition and observation IR only.
-- It is not a Personskat search bound or a policy result.

# IncomeState = IncomeState(income: Int)
# IncomeContext = IncomeContext(step: Int)

> adjustment(income: Int) -> Int {
    if income >= 200 { 20 } else { 0 }
}

> net_income(income: Int) -> Int {
    income - adjustment(income)
}

> observe_income_band(state: IncomeState, context: IncomeContext) -> Bool {
    state.income >= 200
}

| is_declared_step(
    before: IncomeState,
    after: IncomeState,
    context: IncomeContext
) -> after.income == before.income + context.step

? explore function_mechanism_observation_smoke {
    over is_declared_step(before, after, context)
    find matches
    bounds {
        context.step = 1
        before.income in range(198, 202)
    }
    transition as IncomeState context IncomeContext {
        relative
        after.income = before.income + context.step
    }
    boundaries on before.income by context.step
    observe mechanisms with observe_income_band
    output {
        key [income = before.income]
        show [
            before_net = net_income(before.income),
            after_net = net_income(after.income)
        ]
        representative first
    }
}
