| ll9g_scenarie_havdagsgrænser_udledes: ll9g_scenarie_valgt -> ll9g_scenarie_valgt.alle_input_gyldige && ll9g_scenarie_valgt.registreret_som_erhvervsfisker_i_indkomståret && ll9g_scenarie_valgt.påbegyndte_havdage_før_årsloft == 4 && ll9g_scenarie_valgt.samlet_fradrag_kroner == 760
