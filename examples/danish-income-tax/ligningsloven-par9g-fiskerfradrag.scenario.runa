= ll9g_scenarie_nytår_tredive_timer_2025 = ligningslov9g_årsresultat(2025, ll9g_scenarie_nytårsinput(ll9g_scenarie_nytårstur_tredive_timer))
= ll9g_scenarie_nytår_tredive_timer_2026 = ligningslov9g_årsresultat(2026, ll9g_scenarie_nytårsinput(ll9g_scenarie_nytårstur_tredive_timer))
= ll9g_scenarie_nytår_præcis_fireogtyve_timer_2025 = ligningslov9g_årsresultat(2025, ll9g_scenarie_nytårsinput(ll9g_scenarie_nytårstur_præcis_fireogtyve_timer))
= ll9g_scenarie_nytår_præcis_fireogtyve_timer_2026 = ligningslov9g_årsresultat(2026, ll9g_scenarie_nytårsinput(ll9g_scenarie_nytårstur_præcis_fireogtyve_timer))
= ll9g_scenarie_nytår_fireogtyve_timer_et_minut_2025 = ligningslov9g_årsresultat(2025, ll9g_scenarie_nytårsinput(ll9g_scenarie_nytårstur_fireogtyve_timer_et_minut))
= ll9g_scenarie_nytår_fireogtyve_timer_et_minut_2026 = ligningslov9g_årsresultat(2026, ll9g_scenarie_nytårsinput(ll9g_scenarie_nytårstur_fireogtyve_timer_et_minut))
