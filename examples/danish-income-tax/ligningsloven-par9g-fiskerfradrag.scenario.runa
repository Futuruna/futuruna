| ll9g_scenarie_2024_a_status_er_kildebelagt: ll9g_scenarie_2024_a_status -> ll9g_scenarie_2024_a_status.lovversion == Ll9GLbk42Af2023 && ll9g_scenarie_2024_a_status.skatteår_understøttet && ll9g_scenarie_2024_a_status.alle_input_gyldige && ll9g_scenarie_2024_a_status.fradrag_foretaget_efter_par9g && ll9g_scenarie_2024_a_status.samlet_fradrag_kroner == 190
