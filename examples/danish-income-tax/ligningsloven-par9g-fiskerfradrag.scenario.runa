| ll9g_scenarie_nytårstur_fordeles_uden_dobbeltregning: ll9g_scenarie_nytår_tredive_timer_2026 -> ll9g_scenarie_nytår_tredive_timer_2025.alle_input_gyldige && ll9g_scenarie_nytår_tredive_timer_2026.alle_input_gyldige && head(ll9g_scenarie_nytår_tredive_timer_2026.fangstturresultater).samlede_påbegyndte_havdage_på_fangstturen == 2 && ll9g_scenarie_nytår_tredive_timer_2025.påbegyndte_havdage_før_årsloft == 1 && ll9g_scenarie_nytår_tredive_timer_2026.påbegyndte_havdage_før_årsloft == 1 && ll9g_scenarie_nytår_tredive_timer_2025.påbegyndte_havdage_før_årsloft + ll9g_scenarie_nytår_tredive_timer_2026.påbegyndte_havdage_før_årsloft == head(ll9g_scenarie_nytår_tredive_timer_2026.fangstturresultater).samlede_påbegyndte_havdage_på_fangstturen && ll9g_scenarie_nytår_tredive_timer_2025.samlet_fradrag_kroner == 190 && ll9g_scenarie_nytår_tredive_timer_2026.samlet_fradrag_kroner == 190
| ll9g_scenarie_præcis_fireogtyve_timer_starter_kun_en_havdag: ll9g_scenarie_nytår_præcis_fireogtyve_timer_2026 -> head(ll9g_scenarie_nytår_præcis_fireogtyve_timer_2025.fangstturresultater).samlede_påbegyndte_havdage_på_fangstturen == 1 && ll9g_scenarie_nytår_præcis_fireogtyve_timer_2025.påbegyndte_havdage_før_årsloft == 1 && ll9g_scenarie_nytår_præcis_fireogtyve_timer_2026.påbegyndte_havdage_før_årsloft == 0 && ll9g_scenarie_nytår_præcis_fireogtyve_timer_2026.kan_vælge_fiskerfradrag == Falskt
| ll9g_scenarie_et_minut_over_fireogtyve_starter_ny_havdag: ll9g_scenarie_nytår_fireogtyve_timer_et_minut_2026 -> head(ll9g_scenarie_nytår_fireogtyve_timer_et_minut_2026.fangstturresultater).samlede_påbegyndte_havdage_på_fangstturen == 2 && ll9g_scenarie_nytår_fireogtyve_timer_et_minut_2025.påbegyndte_havdage_før_årsloft == 1 && ll9g_scenarie_nytår_fireogtyve_timer_et_minut_2026.påbegyndte_havdage_før_årsloft == 1
