@ sprog da

@ importer ./ligningsloven - par9g - fiskerfradrag

| ll9g_scenarie_tidspunkt(år: Heltal, måned: Heltal, dag: Heltal, time: Heltal, minut: Heltal) -> DatoTidspunkt(
    dato = Dato(år = år, måned = måned, dag = dag),
    klokkeslæt = Klokkeslæt(time = time, minut = minut)
)
| ll9g_scenarie_registrering(status: Ligningslov9GRegistreringsstatus) -> Ligningslov9GRegistreringsperiode(
    identifikation = "fiskerregistrering-2026",
    status = status,
    fra_dato = Dato(år = 2026, måned = 7, dag = 1),
    til_dato = Dato(år = 2026, måned = 12, dag = 31)
)
| ll9g_scenarie_arbejdsforhold() -> Ligningslov9GArbejdsforhold(
    identifikation = "fiskerarbejde-2026",
    erhvervsform = Ll9GAnsatFisker,
    fra_dato = Dato(år = 2026, måned = 1, dag = 1),
    til_dato = Dato(år = 2026, måned = 12, dag = 31)
)
| ll9g_scenarie_fangsttur(identifikation: Tekst, startdag: Heltal, starttime: Heltal, slutdag: Heltal, sluttime: Heltal, slutminut: Heltal) -> Ligningslov9GFangsttur(
    identifikation = identifikation,
    arbejdsforhold_identifikation = "fiskerarbejde-2026",
    afgang_fra_havn = ll9g_scenarie_tidspunkt(2026, 1, startdag, starttime, 0),
    ankomst_til_havn = ll9g_scenarie_tidspunkt(2026, 1, slutdag, sluttime, slutminut)
)
| ll9g_scenarie_input(valg: Ligningslov9GFradragsvalg, registreringer: List(Ligningslov9GRegistreringsperiode), fangstture: List(Ligningslov9GFangsttur), kildetilknytninger: List(Ligningslov9GKildetilknytning)) -> Ligningslov9GÅrsinput(
    valg = valg,
    registreringer = registreringer,
    arbejdsforhold = [ll9g_scenarie_arbejdsforhold()],
    fangstture = fangstture,
    selvstændige_udgiftsvurderinger = [],
    kontingentperiodeundtagelser = [],
    kildetilknytninger = kildetilknytninger
)
| ll9g_scenarie_input_med_udgiftsvurderinger(vurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering)) -> Ligningslov9GÅrsinput(
    valg = Ll9GVælgFiskerfradrag,
    registreringer = [ll9g_scenarie_registrering(Ll9GErhvervsfiskerMedAStatus)],
    arbejdsforhold = [ll9g_scenarie_arbejdsforhold()],
    fangstture = [ll9g_scenarie_fangsttur("gyldig-tur-med-udgiftsvurdering", 22, 0, 22, 12, 0)],
    selvstændige_udgiftsvurderinger = vurderinger,
    kontingentperiodeundtagelser = [],
    kildetilknytninger = []
)
| ll9g_scenarie_historisk_input(indkomstår: Heltal, status: Ligningslov9GRegistreringsstatus) -> {
    = arbejdsforhold_identifikation = "fiskerarbejde-" + vis(indkomstår)
    Ligningslov9GÅrsinput(
        valg = Ll9GVælgFiskerfradrag,
        registreringer = [Ligningslov9GRegistreringsperiode(
            identifikation = "fiskerregistrering-" + vis(indkomstår),
            status = status,
            fra_dato = Dato(år = indkomstår, måned = 1, dag = 1),
            til_dato = Dato(år = indkomstår, måned = 12, dag = 31)
        )],
        arbejdsforhold = [Ligningslov9GArbejdsforhold(
            identifikation = arbejdsforhold_identifikation,
            erhvervsform = Ll9GAnsatFisker,
            fra_dato = Dato(år = indkomstår, måned = 1, dag = 1),
            til_dato = Dato(år = indkomstår, måned = 12, dag = 31)
        )],
        fangstture = [Ligningslov9GFangsttur(
            identifikation = "tolvtimers-fangsttur-" + vis(indkomstår),
            arbejdsforhold_identifikation = arbejdsforhold_identifikation,
            afgang_fra_havn = ll9g_scenarie_tidspunkt(indkomstår, 6, 1, 0, 0),
            ankomst_til_havn = ll9g_scenarie_tidspunkt(indkomstår, 6, 1, 12, 0)
        )],
        selvstændige_udgiftsvurderinger = [],
        kontingentperiodeundtagelser = [],
        kildetilknytninger = []
    )
}
| ll9g_scenarie_nytårsinput(fangsttur: Ligningslov9GFangsttur) -> Ligningslov9GÅrsinput(
    valg = Ll9GVælgFiskerfradrag,
    registreringer = [Ligningslov9GRegistreringsperiode(
        identifikation = "a-status-over-årsskifte",
        status = Ll9GErhvervsfiskerMedAStatus,
        fra_dato = Dato(år = 2025, måned = 12, dag = 1),
        til_dato = Dato(år = 2026, måned = 12, dag = 31)
    )],
    arbejdsforhold = [Ligningslov9GArbejdsforhold(
        identifikation = "fiskerarbejde-over-årsskifte",
        erhvervsform = Ll9GAnsatFisker,
        fra_dato = Dato(år = 2025, måned = 12, dag = 1),
        til_dato = Dato(år = 2026, måned = 12, dag = 31)
    )],
    fangstture = [fangsttur],
    selvstændige_udgiftsvurderinger = [],
    kontingentperiodeundtagelser = [],
    kildetilknytninger = []
)

= ll9g_scenarie_nytårstur_tredive_timer = Ligningslov9GFangsttur(
    identifikation = "nytårstur-tredive-timer",
    arbejdsforhold_identifikation = "fiskerarbejde-over-årsskifte",
    afgang_fra_havn = ll9g_scenarie_tidspunkt(2025, 12, 31, 18, 0),
    ankomst_til_havn = ll9g_scenarie_tidspunkt(2026, 1, 2, 0, 0)
)
= ll9g_scenarie_nytårstur_præcis_fireogtyve_timer = Ligningslov9GFangsttur(
    identifikation = "nytårstur-præcis-fireogtyve-timer",
    arbejdsforhold_identifikation = "fiskerarbejde-over-årsskifte",
    afgang_fra_havn = ll9g_scenarie_tidspunkt(2025, 12, 31, 12, 0),
    ankomst_til_havn = ll9g_scenarie_tidspunkt(2026, 1, 1, 12, 0)
)
= ll9g_scenarie_nytårstur_fireogtyve_timer_et_minut = Ligningslov9GFangsttur(
    identifikation = "nytårstur-fireogtyve-timer-et-minut",
    arbejdsforhold_identifikation = "fiskerarbejde-over-årsskifte",
    afgang_fra_havn = ll9g_scenarie_tidspunkt(2025, 12, 31, 12, 0),
    ankomst_til_havn = ll9g_scenarie_tidspunkt(2026, 1, 1, 12, 1)
)

= ll9g_scenarie_grænseture = [
    ll9g_scenarie_fangsttur("tolv-timer", 1, 0, 1, 12, 0),
    ll9g_scenarie_fangsttur("elleve-nioghalvtreds", 2, 0, 2, 11, 59),
    ll9g_scenarie_fangsttur("fireogtyve-timer", 3, 0, 4, 0, 0),
    ll9g_scenarie_fangsttur("fireogtyve-timer-et-minut", 5, 0, 6, 0, 1)
]
= ll9g_scenarie_kildetilknytninger = [
    Ligningslov9GKildetilknytning(
        kilde = Ll9GLigningslov13Forening(forening_identifikation = "fiskerforbund"),
        arbejdstilknytning = Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation = "fiskerarbejde-2026")
    ),
    Ligningslov9GKildetilknytning(
        kilde = Ll9GLigningslov13Forening(forening_identifikation = "andet-forbund"),
        arbejdstilknytning = Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation = "landarbejde-2026")
    )
]
= ll9g_scenarie_valgt = ligningslov9g_årsresultat(
    2026,
    ll9g_scenarie_input(
        Ll9GVælgFiskerfradrag,
        [ll9g_scenarie_registrering(Ll9GErhvervsfiskerMedBStatus)],
        ll9g_scenarie_grænseture,
        ll9g_scenarie_kildetilknytninger
    )
)
= ll9g_scenarie_fravalgt = ligningslov9g_årsresultat(
    2026,
    ll9g_scenarie_input(
        Ll9GFravælgFiskerfradrag,
        [ll9g_scenarie_registrering(Ll9GErhvervsfiskerMedAStatus)],
        ll9g_scenarie_grænseture,
        []
    )
)
= ll9g_scenarie_uden_registrering = ligningslov9g_årsresultat(
    2026,
    ll9g_scenarie_input(Ll9GVælgFiskerfradrag, [], ll9g_scenarie_grænseture, [])
)
= ll9g_scenarie_overlap = ligningslov9g_årsresultat(
    2026,
    ll9g_scenarie_input(
        Ll9GVælgFiskerfradrag,
        [ll9g_scenarie_registrering(Ll9GErhvervsfiskerMedAStatus)],
        [
            ll9g_scenarie_fangsttur("overlap-a", 10, 0, 11, 0, 0),
