| ll9g_scenarie_overlap_fejler_lukket: ll9g_scenarie_overlap -> ll9g_scenarie_overlap.fangstture_ikke_overlappende == Falskt && ll9g_scenarie_overlap.alle_input_gyldige == Falskt && ll9g_scenarie_overlap.samlet_fradrag_kroner == 0
| ll9g_scenarie_årsloftet_er_220_havdage: ll9g_scenarie_årsloft -> ll9g_scenarie_årsloft.påbegyndte_havdage_før_årsloft == 221 && ll9g_scenarie_årsloft.havdage_efter_årsloft == 220 && ll9g_scenarie_årsloft.samlet_fradrag_kroner == 41800
