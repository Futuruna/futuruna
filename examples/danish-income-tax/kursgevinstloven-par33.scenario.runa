@ sprog da

@ importer ./metadata
@ importer ./kursgevinstloven - par32

= kursgevinstloven_par33_scenarier_metadata = Metadata(
    attachments = (
        Source(value = kursgevinstloven_lbk1176_par29_par30_par33),
        Guidance(value = kursgevinstloven_juridisk_vejledning_par33),
    )
)

--@label:kursgevinstloven_par33_scenarier::meta:kursgevinstloven_par33_scenarier_metadata--
----
§ 33. Gevinst eller tab på en kontrakt opgøres som forskellen mellem værdien af
kontrakten ved indkomstårets udløb og værdien ved indkomstårets begyndelse
(lagerprincippet). Er kontrakten anskaffet i indkomståret, opgøres gevinst eller
tab som forskellen mellem værdien ved indkomstårets udløb og kontraktens
anskaffelsessum. Er kontrakten realiseret i indkomståret, opgøres gevinst eller
tab som forskellen mellem kontraktens afståelsesværdi og kontraktens værdi ved
indkomstårets begyndelse. Er kontrakten anskaffet og realiseret i samme
indkomstår, opgøres gevinst eller tab som forskellen mellem afståelsesværdien og
anskaffelsessummen. Afvikles kontrakten ved levering, anses det overdragne aktiv
eller passiv for erhvervet henholdsvis afstået på afviklingsdagen og til
markedsværdien på afviklingsdagen.
----

--@begin:kursgevinstloven_par33_scenarier--
| kgl_par33_scenarie_resultat(fakta: KursgevinstlovKontraktKildeFakta) -> kursgevinstlov_resultat(kursgevinstlov_personinput_fra_kontrakt_kildefakta(
    indkomstår = 2026,
    fakta = fakta
))
| kgl_par33_scenarie_kildekontrakt(identifikation: Tekst, rækkefølge: Heltal, fakta: KursgevinstlovKontraktKildeFakta) -> KursgevinstPar32KildekontraktFakta(
    identifikation = identifikation,
    rækkefølge_i_indkomståret = rækkefølge,
    kontrakt = fakta,
    relationsfakta = KglPar32KildeUdenSærligRelation,
    underliggende = KglPar32KildeIkkeAktiebaseret
)
| kgl_par33_scenarie_årsvalg() -> KursgevinstPar32Kildeårsvalg(
    tabsprioritet = KglPar32AlmindeligeTabFørst,
    fast_ejendomstabsprioritet = KglPar32SælgertabFørst,
    aktiemodregningsvalg = kgl_par32_ingen_aktiemodregning()
)
| kgl_par33_scenarie_tom_person() -> KursgevinstPar32PersonÅrsinput(
    identifikation = "tom-modpart",
    indkomstår = 2026,
    kontrakter = [],
    aktieårsgrundlag = kgl_par32_tomt_aktieårsgrundlag(2026),
    fremførsel = KglPar32IngenFremførsel,
    tabsprioritet = KglPar32AlmindeligeTabFørst,
    fast_ejendomstabsprioritet = KglPar32SælgertabFørst,
    aktiemodregningsvalg = kgl_par32_ingen_aktiemodregning()
)

= kgl_par33_positiv_til_negativ_fakta = KursgevinstlovKontraktKildeFakta(
    aftaleart = KglPar30IngenUndtagelsesaftale,
    har_modgående_kontrakt_eller_forretning = Falskt,
    værdi_primo_kroner = 4000,
    værdi_ultimo_kroner = -6000,
    anskaffelsessum_kroner = 0,
    afståelsesværdi_kroner = 0,
    anskaffet_i_indkomståret = Falskt,
    realiseret_i_indkomståret = Falskt,
    udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = Falskt
)
= kgl_par33_positiv_til_negativ_resultat = kgl_par33_scenarie_resultat(kgl_par33_positiv_til_negativ_fakta)

= kgl_par33_negativ_til_positiv_fakta = KursgevinstlovKontraktKildeFakta(
    aftaleart = KglPar30IngenUndtagelsesaftale,
    har_modgående_kontrakt_eller_forretning = Falskt,
    værdi_primo_kroner = -5000,
    værdi_ultimo_kroner = 7000,
    anskaffelsessum_kroner = 0,
    afståelsesværdi_kroner = 0,
    anskaffet_i_indkomståret = Falskt,
    realiseret_i_indkomståret = Falskt,
    udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = Falskt
)
= kgl_par33_negativ_til_positiv_resultat = kgl_par33_scenarie_resultat(kgl_par33_negativ_til_positiv_fakta)

= kgl_par33_anskaffelsesår_fakta = KursgevinstlovKontraktKildeFakta(
    aftaleart = KglPar30IngenUndtagelsesaftale,
    har_modgående_kontrakt_eller_forretning = Falskt,
    værdi_primo_kroner = 0,
    værdi_ultimo_kroner = 3000,
    anskaffelsessum_kroner = -2000,
    afståelsesværdi_kroner = 0,
    anskaffet_i_indkomståret = Sandt,
    realiseret_i_indkomståret = Falskt,
    udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = Falskt
)
= kgl_par33_anskaffelsesår_resultat = kgl_par33_scenarie_resultat(kgl_par33_anskaffelsesår_fakta)

= kgl_par33_realisationsår_fakta = KursgevinstlovKontraktKildeFakta(
    aftaleart = KglPar30IngenUndtagelsesaftale,
    har_modgående_kontrakt_eller_forretning = Falskt,
    værdi_primo_kroner = -3000,
    værdi_ultimo_kroner = 0,
    anskaffelsessum_kroner = 0,
    afståelsesværdi_kroner = -8000,
    anskaffet_i_indkomståret = Falskt,
    realiseret_i_indkomståret = Sandt,
    udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = Falskt
)
= kgl_par33_realisationsår_resultat = kgl_par33_scenarie_resultat(kgl_par33_realisationsår_fakta)

= kgl_par33_uændret_negativ_fakta = KursgevinstlovKontraktKildeFakta(
    aftaleart = KglPar30IngenUndtagelsesaftale,
    har_modgående_kontrakt_eller_forretning = Falskt,
    værdi_primo_kroner = -4000,
    værdi_ultimo_kroner = -4000,
    anskaffelsessum_kroner = 0,
    afståelsesværdi_kroner = 0,
    anskaffet_i_indkomståret = Falskt,
    realiseret_i_indkomståret = Falskt,
    udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = Falskt
)
= kgl_par33_uændret_negativ_resultat = kgl_par33_scenarie_resultat(kgl_par33_uændret_negativ_fakta)

= kgl_par33_ugyldigt_primo_ved_anskaffelse_fakta = KursgevinstlovKontraktKildeFakta(
    aftaleart = KglPar30IngenUndtagelsesaftale,
    har_modgående_kontrakt_eller_forretning = Falskt,
    værdi_primo_kroner = -1,
    værdi_ultimo_kroner = 3000,
    anskaffelsessum_kroner = -2000,
    afståelsesværdi_kroner = 0,
    anskaffet_i_indkomståret = Sandt,
    realiseret_i_indkomståret = Falskt,
    udøver_næring_ved_køb_og_salg_af_finansielle_kontrakter = Falskt
)
= kgl_par33_ugyldigt_primo_ved_anskaffelse_resultat = kgl_par33_scenarie_resultat(kgl_par33_ugyldigt_primo_ved_anskaffelse_fakta)

= kgl_par33_par32_afledning = kgl_par32_person_kildeårsafledning(
    skatteyder_identifikation = "signerede-kontrakter",
    fakta = KursgevinstPar32PersonKildeårsfakta(
        indkomstår = 2026,
        kontrakter = [
            kgl_par33_scenarie_kildekontrakt(
                identifikation = "positiv-til-negativ",
                rækkefølge = 1,
                fakta = kgl_par33_positiv_til_negativ_fakta
            ),
            kgl_par33_scenarie_kildekontrakt(
                identifikation = "negativ-til-positiv",
                rækkefølge = 2,
                fakta = kgl_par33_negativ_til_positiv_fakta
            )
        ],
        valg = kgl_par33_scenarie_årsvalg()
    ),
    referencer = [],
    aktieårsgrundlag = kgl_par32_tomt_aktieårsgrundlag(2026),
    fremførsel = KglPar32IngenFremførsel
)
= kgl_par33_par32_årsresultat = kursgevinst_par32_ægtefællepar_resultat(KursgevinstPar32ÆgtefælleparInput(
    venstre = kgl_par33_par32_afledning.årsinput,
    højre = kgl_par33_scenarie_tom_person(),
    gift_og_samlevende_ved_indkomstårets_udgang = Falskt
)).venstre

| kgl_par33_scenarie_positiv_til_negativ_giver_fuldt_tab: kgl_par33_positiv_til_negativ_resultat -> kursgevinstlov_kontrakt_kildefakta_gyldige(kgl_par33_positiv_til_negativ_fakta) && kgl_par33_positiv_til_negativ_resultat.input_gyldigt && kgl_par33_positiv_til_negativ_resultat.bruttotab_kroner == 10000 && kgl_par33_positiv_til_negativ_resultat.kontrakttab_til_par32_årsopgørelse_kroner == 10000
| kgl_par33_scenarie_negativ_til_positiv_giver_fuld_gevinst: kgl_par33_negativ_til_positiv_resultat -> kursgevinstlov_kontrakt_kildefakta_gyldige(kgl_par33_negativ_til_positiv_fakta) && kgl_par33_negativ_til_positiv_resultat.input_gyldigt && kgl_par33_negativ_til_positiv_resultat.bruttogevinst_kroner == 12000 && kgl_par33_negativ_til_positiv_resultat.skattepligtig_gevinst_kroner == 12000
| kgl_par33_scenarie_anskaffelsesår_bruger_signeret_anskaffelsessum: kgl_par33_anskaffelsesår_resultat -> kursgevinstlov_kontrakt_kildefakta_gyldige(kgl_par33_anskaffelsesår_fakta) && kgl_par33_anskaffelsesår_resultat.bruttogevinst_kroner == 5000
| kgl_par33_scenarie_realisationsår_bruger_signeret_afståelsesværdi: kgl_par33_realisationsår_resultat -> kursgevinstlov_kontrakt_kildefakta_gyldige(kgl_par33_realisationsår_fakta) && kgl_par33_realisationsår_resultat.bruttotab_kroner == 5000
| kgl_par33_scenarie_uændret_negativ_værdi_giver_nul: kgl_par33_uændret_negativ_resultat -> kursgevinstlov_kontrakt_kildefakta_gyldige(kgl_par33_uændret_negativ_fakta) && kgl_par33_uændret_negativ_resultat.bruttogevinst_kroner == 0 && kgl_par33_uændret_negativ_resultat.bruttotab_kroner == 0
| kgl_par33_scenarie_inaktiv_primo_skal_fortsat_være_nul: kgl_par33_ugyldigt_primo_ved_anskaffelse_resultat -> kursgevinstlov_kontrakt_kildefakta_gyldige(kgl_par33_ugyldigt_primo_ved_anskaffelse_fakta) == Falskt && kgl_par33_ugyldigt_primo_ved_anskaffelse_resultat.input_gyldigt == Falskt
| kgl_par33_scenarie_par32_modregner_signerede_beløb_præcis_en_gang: kgl_par33_par32_årsresultat -> kgl_par33_par32_afledning.input_gyldigt && kgl_par33_par32_årsresultat.input_gyldigt && kgl_par33_par32_årsresultat.årets_kontraktgevinster_kroner == 12000 && kgl_par33_par32_årsresultat.årets_almindelige_tab_kroner == 10000 && kgl_par33_par32_årsresultat.tab_modregnet_i_egne_indkomstårsgevinster_kroner == 10000 && kgl_par33_par32_årsresultat.netto_kontraktindkomst_efter_par32_kroner == 2000 && kgl_par33_par32_årsresultat.tab_fremført_til_følgende_indkomstår_kroner == 0

? kgl_par33_scenarie_positiv_til_negativ_giver_fuldt_tab
? kgl_par33_scenarie_negativ_til_positiv_giver_fuld_gevinst
? kgl_par33_scenarie_anskaffelsesår_bruger_signeret_anskaffelsessum
? kgl_par33_scenarie_realisationsår_bruger_signeret_afståelsesværdi
? kgl_par33_scenarie_uændret_negativ_værdi_giver_nul
? kgl_par33_scenarie_inaktiv_primo_skal_fortsat_være_nul
? kgl_par33_scenarie_par32_modregner_signerede_beløb_præcis_en_gang
--@end:kursgevinstloven_par33_scenarier--

@ print("Kursgevinstlovens § 33: 7 signerede værdi- og årsopgørelsesforløb kontrolleret")
