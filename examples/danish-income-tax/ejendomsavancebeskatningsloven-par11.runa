@ sprog da

@ importer ./metadata
@ importer ./pengebeloeb
@ importer ./ejendomsavancebeskatningsloven - genanbringelse

# EblPar11KildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)

= ebl_par11_lbk132 = EblPar11KildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2019/132",
    identifier = "Ejendomsavancebeskatningsloven § 11",
    hentet_dato = "2026-07-18"
)

