= nr2_samlet = par3_stk2_nr2_resultat(Par3Stk2Nr2Input(poster = [
    Par3Stk2Nr2Post(grundlag = Par3Nr2Ll8Stk1(nr2_ll8_reklame), ved_selvstændig_erhvervsvirksomhed = Sandt),
    Par3Stk2Nr2Post(grundlag = Par3Nr2Ll8B(nr2_ll8b_straks), ved_selvstændig_erhvervsvirksomhed = Sandt),
