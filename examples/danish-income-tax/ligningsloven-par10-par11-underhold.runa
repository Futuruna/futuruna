    identifikation: Tekst,
    @ field(
        label = "Bidragets indkomstår",
        question = "I hvilket indkomstår skal bidraget fradrages eller beskattes?",
        help = "For bidragsyderen er det som udgangspunkt betalingsåret, dog først forfaldsåret ved forudbetaling. For modtageren anvendes modtagelsesåret.",
