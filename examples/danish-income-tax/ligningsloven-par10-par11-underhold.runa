# Ligningslov10Og11BidragFakta(
    @ field(
        label = "Bidragets identifikation",
        question = "Hvilken entydig identifikation har bidraget?",
        help = "Brug en stabil reference fra aftalen, afgørelsen, betalingsbilaget eller årsopgørelsen.",
