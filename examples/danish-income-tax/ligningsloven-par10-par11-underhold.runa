= ligningsloven_normalbidrag_metadata = Metadata(
    attachments = (
        HistoricalSource(value = ligningsloven_normalbidrag_2023_kilde),
        HistoricalSource(value = ligningsloven_normalbidrag_2024_kilde),
        ParameterSource(value = ligningsloven_normalbidrag_2025_kilde),
        ParameterSource(value = ligningsloven_normalbidrag_2026_kilde),
    )
)

----
Normalbidraget består i 2023 af et grundbeløb på 1.328 kr. om måneden og et
tillæg på 172 kr. om måneden.

Tabel 19 for 2024 angiver normalbidragets grundbeløb til 1.370 kr. om måneden
og tillægget til 178 kr. om måneden.

Tabel 19 for 2025 angiver normalbidragets grundbeløb til 1.419 kr. om måneden
og tillægget til 184 kr. om måneden.

Normalbidraget består i 2026 af et grundbeløb på 1.483 kr. om måneden og et
tillæg på 192 kr. om måneden.
----

@ meta(ligningsloven_normalbidrag_metadata)
@ section ligningsloven_par10_par11_normalbidrag {

| exception ligningslov10_11_2023_normalbidrag_grundbeløb ligningslov10_11_normalbidrag_grundbeløb_pr_måned_kroner(indkomstår) -> 1328 under indkomstår == 2023
| exception ligningslov10_11_2024_normalbidrag_grundbeløb ligningslov10_11_normalbidrag_grundbeløb_pr_måned_kroner(indkomstår) -> 1370 under indkomstår == 2024
| exception ligningslov10_11_2025_normalbidrag_grundbeløb ligningslov10_11_normalbidrag_grundbeløb_pr_måned_kroner(indkomstår) -> 1419 under indkomstår == 2025
| exception ligningslov10_11_2026_normalbidrag_grundbeløb ligningslov10_11_normalbidrag_grundbeløb_pr_måned_kroner(indkomstår) -> 1483 under indkomstår == 2026
| exception ligningslov10_11_2023_normalbidrag_tillæg ligningslov10_11_normalbidrag_tillæg_pr_måned_kroner(indkomstår) -> 172 under indkomstår == 2023
| exception ligningslov10_11_2024_normalbidrag_tillæg ligningslov10_11_normalbidrag_tillæg_pr_måned_kroner(indkomstår) -> 178 under indkomstår == 2024
| exception ligningslov10_11_2025_normalbidrag_tillæg ligningslov10_11_normalbidrag_tillæg_pr_måned_kroner(indkomstår) -> 184 under indkomstår == 2025
| exception ligningslov10_11_2026_normalbidrag_tillæg ligningslov10_11_normalbidrag_tillæg_pr_måned_kroner(indkomstår) -> 192 under indkomstår == 2026

}
