@ sprog da

@ importer ./personskat.calculate

| personskat_ordinaer_scenario_input(arbejdsgiverydelser: List(PersonskatArbejdsgiverydelseFakta), virksomheder: List(PersonskatOrdinærVirksomhedFakta)) -> PersonskatOrdinærPersonligIndkomstInput(
    arbejdsgiverydelser = arbejdsgiverydelser,
    personlige_arbejdsvederlag = [],
    virksomheder_uden_virksomhedsordning = virksomheder,
    forenings_og_arbejdsløshedsydelser = []
)
| personskat_ordinaer_scenario_input_med_forenings_og_arbejdsløshedsydelser(ydelser: List(PersonskatForeningsOgArbejdsløshedsydelseFakta)) -> PersonskatOrdinærPersonligIndkomstInput(
    arbejdsgiverydelser = [],
    personlige_arbejdsvederlag = [],
    virksomheder_uden_virksomhedsordning = [],
    forenings_og_arbejdsløshedsydelser = ydelser
)
| personskat_ordinaer_scenario_input_med_arbejdsvederlag(vederlag: List(PersonskatPersonligtArbejdsvederlagFakta)) -> PersonskatOrdinærPersonligIndkomstInput(
    arbejdsgiverydelser = [],
    personlige_arbejdsvederlag = vederlag,
    virksomheder_uden_virksomhedsordning = [],
    forenings_og_arbejdsløshedsydelser = []
)
| personskat_ordinaer_scenario_arbejdsvederlag(identifikation: Tekst, indkomstår: Heltal, forhold: PersonskatPersonligtArbejdsvederlagsforhold, vederlagsform: PersonskatPersonligtArbejdsvederlagsform, skattepligtig_værdi_kroner: Heltal) -> PersonskatPersonligtArbejdsvederlagFakta(
    identifikation = identifikation,
    indkomstår = indkomstår,
    forhold = forhold,
    vederlagsform = vederlagsform,
    skattepligtig_værdi_kroner = skattepligtig_værdi_kroner
)
| personskat_ordinaer_scenario_foreningsydelse(identifikation: Tekst, beløb_kroner: Heltal, undtagelse: Ligningslov30Og31Undtagelse) -> PersonskatForeningsydelseEfterLigningslov13(fakta = Ligningslov13ForeningsydelseFakta(
    identifikation = identifikation,
    indkomstår = 2025,
    foreningsart = Ll13Fagforening,
    beløb_kroner = beløb_kroner,
    foreningens_hovedformål_er_erhvervsgruppens_økonomiske_interesser = Sandt,
    modtager_hører_til_erhvervsgruppen = Sandt,
    modtager_er_medlem = Sandt,
    undtagelse = undtagelse
))
| personskat_ordinaer_scenario_arbejdsløshedsudbetaling(identifikation: Tekst, beløb_kroner: Heltal, undtagelse: Ligningslov30Og31Undtagelse) -> PersonskatArbejdsløshedsforsikringsudbetalingEfterPbl49(fakta = Pbl49ArbejdsløshedsforsikringsudbetalingFakta(
    identifikation = identifikation,
    indkomstår = 2025,
    beløb_kroner = beløb_kroner,
    art = Pbl49UdbetalingFraArbejdsløshedskasse,
    skatteyderrelation = Pbl49SkatteyderenErEjer,
    undtagelse = undtagelse
))
| personskat_ordinaer_scenario_arbejdsgiverydelse(identifikation: Tekst, indkomstår: Heltal, ydelse: PersonskatArbejdsgiverydelse) -> PersonskatArbejdsgiverydelseFakta(
    identifikation = identifikation,
    indkomstår = indkomstår,
    ydelse = ydelse
)
| personskat_ordinaer_scenario_pbl19_fakta(arbejdsgiverrelation: Pbl19Arbejdsgiverrelation, ordning: Pbl18Ordning, beløb_før_am_kroner: Option(Heltal), beløb_efter_am_kroner: Heltal, kapitalordningsstatus: Pbl19Kapitalordningsstatus) -> Pbl19ArbejdsgiverindbetalingFakta(
    arbejdsgiverrelation = arbejdsgiverrelation,
    ordning = ordning,
    indberettet_indbetaling_før_indeholdt_arbejdsmarkedsbidrag_kroner = beløb_før_am_kroner,
    indberettet_indbetaling_efter_indeholdt_arbejdsmarkedsbidrag_kroner = beløb_efter_am_kroner,
    kapitalordningsstatus = kapitalordningsstatus
)
| personskat_ordinaer_scenario_indtægt(identifikation: Tekst, art: PersonskatVirksomhedsindtægtsart, beløb_kroner: Heltal) -> PersonskatVirksomhedsindtægtFakta(
    identifikation = identifikation,
    art = art,
    beløb_kroner = beløb_kroner
)
| personskat_ordinaer_scenario_udgift(identifikation: Tekst, afgrænsning: Par3Stk2Nr1Udgiftsafgrænsning, beløb_kroner: Heltal) -> PersonskatVirksomhedsudgiftFakta(
    identifikation = identifikation,
    afgrænsning = afgrænsning,
    beløb_kroner = beløb_kroner
)
| personskat_ordinaer_scenario_virksomhed(identifikation: Tekst, indkomstår: Heltal, indtægter: List(PersonskatVirksomhedsindtægtFakta), udgifter: List(PersonskatVirksomhedsudgiftFakta)) -> PersonskatOrdinærVirksomhedFakta(
    identifikation = identifikation,
    indkomstår = indkomstår,
    indtægter = indtægter,
    udgifter = udgifter,
    ligningslovsfradrag_efter_par3_stk2_nr2 = []
)

= personskat_ordinaer_tomt_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ingen_ordinær_personlig_indkomst(), 2025)
= personskat_ordinaer_honorar = personskat_ordinaer_scenario_arbejdsvederlag(
    identifikation = "honorar-personligt-arbejde",
    indkomstår = 2025,
    forhold = PsArbejdeUdenAnsættelse,
    vederlagsform = PsArbejdsvederlagIPenge,
    skattepligtig_værdi_kroner = 50000
)
= personskat_ordinaer_honorar_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([personskat_ordinaer_honorar]), 2025)
= personskat_ordinaer_naturaliehonorar_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "honorar-fri-telefon",
        indkomstår = 2025,
        forhold = PsArbejdeUdenAnsættelse,
        vederlagsform = PsArbejdsvederlagINaturalie(art = AmFriTelefon),
        skattepligtig_værdi_kroner = 3200
    )
    ]), 2025)
= personskat_ordinaer_ansættelsesvederlag_i_nr2_gren = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "løn-i-forkert-gren",
        indkomstår = 2025,
        forhold = PsArbejdeIAnsættelse,
        vederlagsform = PsArbejdsvederlagIPenge,
        skattepligtig_værdi_kroner = 50000
    )
    ]), 2025)
= personskat_ordinaer_selvstændigt_vederlag_i_nr2_gren = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "virksomhedsindtægt-i-forkert-gren",
        indkomstår = 2025,
        forhold = PsSelvstændigtArbejde,
        vederlagsform = PsArbejdsvederlagIPenge,
        skattepligtig_værdi_kroner = 50000
    )
    ]), 2025)
= personskat_ordinaer_ugyldigt_naturaliehonorar = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "naturalie-uden-for-stk2",
        indkomstår = 2025,
        forhold = PsArbejdeUdenAnsættelse,
        vederlagsform = PsArbejdsvederlagINaturalie(art = AmIkkePar2Stk2Naturalia),
        skattepligtig_værdi_kroner = 3200
    )
    ]), 2025)
= personskat_ordinaer_dubleret_arbejdsvederlag = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "samme-honorar",
        indkomstår = 2025,
        forhold = PsArbejdeUdenAnsættelse,
        vederlagsform = PsArbejdsvederlagIPenge,
        skattepligtig_værdi_kroner = 20000
    ),
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "samme-honorar",
        indkomstår = 2025,
        forhold = PsArbejdeUdenAnsættelse,
        vederlagsform = PsArbejdsvederlagIPenge,
        skattepligtig_værdi_kroner = 30000
    )
    ]), 2025)
= personskat_ordinaer_arbejdsvederlag_forkert_år = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_arbejdsvederlag([
    personskat_ordinaer_scenario_arbejdsvederlag(
        identifikation = "honorar-forkert-år",
        indkomstår = 2024,
        forhold = PsArbejdeUdenAnsættelse,
        vederlagsform = PsArbejdsvederlagIPenge,
        skattepligtig_værdi_kroner = 50000
    )
    ]), 2025)
= personskat_ordinaer_gruppeliv_efter_am_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("gruppeliv-pbl19", 2025, GruppelivSomUadskiltDelAfPbl19Ordning(personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner = 507))
    ], []), 2025)
= personskat_ordinaer_gruppeliv_direkte_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("gruppeliv-direkte", 2025, DirekteArbejdsgiverbetaltGruppeliv(præmie_før_arbejdsmarkedsbidrag_kroner = 1000))
    ], []), 2025)
= personskat_ordinaer_pbl19_aldersopsparing_fakta = personskat_ordinaer_scenario_pbl19_fakta(
    arbejdsgiverrelation = Pbl19NuværendeArbejdsgiver,
    ordning = Pbl18Aldersopsparing,
    beløb_før_am_kroner = Some(990),
    beløb_efter_am_kroner = 911,
    kapitalordningsstatus = Pbl19IngenTidligereAfgiftsberigtigelse
)
= personskat_ordinaer_pbl19_ratepension_fakta = personskat_ordinaer_scenario_pbl19_fakta(
    arbejdsgiverrelation = Pbl19NuværendeArbejdsgiver,
    ordning = Pbl18Rateopsparing,
    beløb_før_am_kroner = Some(3564),
    beløb_efter_am_kroner = 3279,
    kapitalordningsstatus = Pbl19IngenTidligereAfgiftsberigtigelse
)
= personskat_ordinaer_pbl19_afgiftsberigtiget_kapital_fakta = personskat_ordinaer_scenario_pbl19_fakta(
    arbejdsgiverrelation = Pbl19TidligereArbejdsgiver,
    ordning = Pbl18Kapitalforsikring,
    beløb_før_am_kroner = Some(1304),
    beløb_efter_am_kroner = 1200,
    kapitalordningsstatus = Pbl19AfgiftsberigtigetEfterPensionsalderen(afgiftsberigtigelsesår = 2024)
)
= personskat_ordinaer_pbl19_anden_indbetaler_fakta = personskat_ordinaer_scenario_pbl19_fakta(
    arbejdsgiverrelation = Pbl19AndenIndbetaler,
    ordning = Pbl18Aldersopsparing,
    beløb_før_am_kroner = Some(990),
    beløb_efter_am_kroner = 911,
    kapitalordningsstatus = Pbl19IngenTidligereAfgiftsberigtigelse
)
= personskat_ordinaer_pbl19_aldersopsparing_par19_resultat = pbl19_stk1_arbejdsgiverindbetaling_resultat(personskat_ordinaer_pbl19_aldersopsparing_fakta, 2025)
= personskat_ordinaer_pbl19_ratepension_par19_resultat = pbl19_stk1_arbejdsgiverindbetaling_resultat(personskat_ordinaer_pbl19_ratepension_fakta, 2025)
= personskat_ordinaer_pbl19_afgiftsberigtiget_kapital_par19_resultat = pbl19_stk1_arbejdsgiverindbetaling_resultat(personskat_ordinaer_pbl19_afgiftsberigtiget_kapital_fakta, 2025)
= personskat_ordinaer_pbl19_anden_indbetaler_par19_resultat = pbl19_stk1_arbejdsgiverindbetaling_resultat(personskat_ordinaer_pbl19_anden_indbetaler_fakta, 2025)
= personskat_ordinaer_pbl19_aldersopsparing_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("aldersopsparing-efter-am", 2025, ArbejdsgiveradministreretPensionEfterPbl19(fakta = personskat_ordinaer_pbl19_aldersopsparing_fakta))
    ], []), 2025)
= personskat_ordinaer_pbl19_pbl56_samlepost_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("pbl19-pbl56-samlepost", 2025, ArbejdsgiveradministreretSamlepostEfterPbl19EllerPbl56(
        indberettet_beløb_før_indeholdt_arbejdsmarkedsbidrag_kroner = Some(990),
        indberettet_beløb_efter_indeholdt_arbejdsmarkedsbidrag_kroner = 911
    ))
    ], []), 2025)
= personskat_ordinaer_naturalie_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("fri-bil", 2025, NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(
        art = AmFriBil,
        skattepligtig_værdi_kroner = 12000
    ))
    ], []), 2025)
= personskat_ordinaer_uklassificeret_ydelse_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("uklassificeret", 2025, UklassificeretArbejdsgiverbetaltYdelse(
        beskrivelse = "Årsopgørelsens samlelinje uden underliggende klassifikation",
        beløb_kroner = 507
    ))
    ], []), 2025)
= personskat_ordinaer_ikke_par2_naturalie_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("anden-naturalie", 2025, NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2(
        art = AmIkkePar2Stk2Naturalia,
        skattepligtig_værdi_kroner = 12000
    ))
    ], []), 2025)
= personskat_ordinaer_dubleret_ydelse_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("samme-id", 2025, DirekteArbejdsgiverbetaltGruppeliv(præmie_før_arbejdsmarkedsbidrag_kroner = 1000)),
    personskat_ordinaer_scenario_arbejdsgiverydelse("samme-id", 2025, GruppelivSomUadskiltDelAfPbl19Ordning(personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner = 507))
    ], []), 2025)
= personskat_ordinaer_negativ_ydelse_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("negativ", 2025, DirekteArbejdsgiverbetaltGruppeliv(præmie_før_arbejdsmarkedsbidrag_kroner = -1))
    ], []), 2025)
= personskat_ordinaer_forkert_ydelsesaar_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([
    personskat_ordinaer_scenario_arbejdsgiverydelse("forkert-år", 2024, DirekteArbejdsgiverbetaltGruppeliv(præmie_før_arbejdsmarkedsbidrag_kroner = 1000))
    ], []), 2025)

= personskat_ordinaer_virksomhedsoverskud = personskat_ordinaer_scenario_virksomhed(
    "enkeltmandsvirksomhed-overskud",
    2025,
    [personskat_ordinaer_scenario_indtægt("omsætning", OrdinærDriftsindtægt, 100000)],
    [personskat_ordinaer_scenario_udgift("driftsudgifter", SelvstændigErhvervsindkomstUdgift, 40000)]
)
= personskat_ordinaer_virksomhedsoverskud_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([], [personskat_ordinaer_virksomhedsoverskud]), 2025)
= personskat_ordinaer_virksomhedsunderskud = personskat_ordinaer_scenario_virksomhed(
    "enkeltmandsvirksomhed-underskud",
    2025,
    [personskat_ordinaer_scenario_indtægt("omsætning", OrdinærDriftsindtægt, 10000)],
    [personskat_ordinaer_scenario_udgift("driftsudgifter", SelvstændigErhvervsindkomstUdgift, 30000)]
)
= personskat_ordinaer_virksomhedsunderskud_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([], [personskat_ordinaer_virksomhedsunderskud]), 2025)
= personskat_ordinaer_virksomhed_kapitalindtægt_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([], [
    personskat_ordinaer_scenario_virksomhed(
        "kapitalindtægt",
        2025,
        [personskat_ordinaer_scenario_indtægt("renteindtægt", KapitalindkomstEfterPersonskattelovensPar4, 1000)],
        []
    )
    ]), 2025)
= personskat_ordinaer_virksomhed_afskaaret_udgift_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([], [
    personskat_ordinaer_scenario_virksomhed(
        "renteudgift",
        2025,
        [personskat_ordinaer_scenario_indtægt("omsætning", OrdinærDriftsindtægt, 10000)],
        [personskat_ordinaer_scenario_udgift("renteudgift", Par4Stk1Nr1RenterOgLl6, 1000)]
    )
    ]), 2025)
= personskat_ordinaer_virksomhed_dubleret_post_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([], [
    personskat_ordinaer_scenario_virksomhed(
        "dubleret-post",
        2025,
        [personskat_ordinaer_scenario_indtægt("samme-post", OrdinærDriftsindtægt, 10000)],
        [personskat_ordinaer_scenario_udgift("samme-post", SelvstændigErhvervsindkomstUdgift, 1000)]
    )
    ]), 2025)
= personskat_ordinaer_virksomhed_dubleret_id_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input([], [
    personskat_ordinaer_virksomhedsoverskud,
    personskat_ordinaer_scenario_virksomhed(
        "enkeltmandsvirksomhed-overskud",
        2025,
        [personskat_ordinaer_scenario_indtægt("anden-omsætning", OrdinærDriftsindtægt, 10000)],
        []
    )
    ]), 2025)

= personskat_ordinaer_par31_bogundtagelse = Ll30Og31UddannelsesydelseEfterPar31(fakta = Ligningslov31Uddannelsesfakta(
    uddannelsen_eller_kurset_udelukkende_privat = Falskt,
    ydelsesart = Ll31BøgerOgMaterialer(relevante_for_uddannelsen_eller_kurset = Sandt)
))
= personskat_ordinaer_skattepligtig_foreningsydelse = personskat_ordinaer_scenario_foreningsydelse("foreningsydelse", 12000, Ll30Og31UdenUndtagelse)
= personskat_ordinaer_skattefri_foreningsydelse = personskat_ordinaer_scenario_foreningsydelse("foreningsydelse-par31", 4500, personskat_ordinaer_par31_bogundtagelse)
= personskat_ordinaer_skattepligtig_arbejdsløshedsudbetaling = personskat_ordinaer_scenario_arbejdsløshedsudbetaling("arbejdsløshedsudbetaling", 18000, Ll30Og31UdenUndtagelse)
= personskat_ordinaer_skattefri_arbejdsløshedsudbetaling = personskat_ordinaer_scenario_arbejdsløshedsudbetaling("arbejdsløshedsudbetaling-par31", 4500, personskat_ordinaer_par31_bogundtagelse)
= personskat_ordinaer_skattepligtige_forenings_og_arbejdsløshedsydelser_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_forenings_og_arbejdsløshedsydelser([
    personskat_ordinaer_skattepligtig_foreningsydelse,
    personskat_ordinaer_skattepligtig_arbejdsløshedsudbetaling,
    ]), 2025)
= personskat_ordinaer_skattefri_forenings_og_arbejdsløshedsydelser_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_forenings_og_arbejdsløshedsydelser([
    personskat_ordinaer_skattefri_foreningsydelse,
    personskat_ordinaer_skattefri_arbejdsløshedsudbetaling,
    ]), 2025)
= personskat_ordinaer_dubleret_forenings_og_arbejdsløshedsydelse_resultat = personskat_ordinær_personlig_indkomst_resultat(personskat_ordinaer_scenario_input_med_forenings_og_arbejdsløshedsydelser([
    personskat_ordinaer_scenario_foreningsydelse("samme-ydelses-id", 12000, Ll30Og31UdenUndtagelse),
    personskat_ordinaer_scenario_arbejdsløshedsudbetaling("samme-ydelses-id", 18000, Ll30Og31UdenUndtagelse),
    ]), 2025)

| personskat_ordinaer_scenario_personlig_indkomst(input: PersonskatOrdinærPersonligIndkomstInput) -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = input,
    arbejdsudleje = [],
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| personskat_ordinaer_scenario_lønmodtager(input: PersonskatOrdinærPersonligIndkomstInput, ligningsfradrag: PersonskatLigningsfradragInput) -> PersonskatLønmodtagerInput(
    skatteår = 2025,
    kommune = København,
    bruttoløn_kroner = 600000,
    personlig_indkomst = personskat_ordinaer_scenario_personlig_indkomst(input),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = ligningsfradrag,
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
