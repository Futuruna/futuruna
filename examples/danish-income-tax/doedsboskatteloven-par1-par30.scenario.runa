| dødsbo_scenarie_bagudforskudt_begynder_ved_kalenderåret: dødsbo_scenarie_bagudforskudt -> dødsbo_scenarie_bagudforskudt.input_gyldigt && dødsbo_scenarie_bagudforskudt.bofradragsmåneder_stk2 == 12 && dødsbo_scenarie_bagudforskudt.mellemperiodemåneder_stk3 == 11 && dødsbo_scenarie_bagudforskudt.dødsboskat_efter_fradrag_kroner == 73350
