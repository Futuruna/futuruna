| dødsbo_scenarie_par30_beregnes_fra_kildefakta: dødsbo_scenarie_positiv_indkomst -> dødsbo_scenarie_positiv_indkomst.input_gyldigt && dødsbo_scenarie_positiv_indkomst.beregningsklar && dødsbo_scenarie_positiv_indkomst.dødsboskat_før_fradrag_kroner == 300000 && dødsbo_scenarie_positiv_indkomst.bofradragsmåneder_stk2 == 0 && dødsbo_scenarie_positiv_indkomst.mellemperiodemåneder_stk3 == 8 && dødsbo_scenarie_positiv_indkomst.ægtefællefradragsmåneder_stk4 == 8 && dødsbo_scenarie_positiv_indkomst.samlede_fradrag_kroner == 40000 && dødsbo_scenarie_positiv_indkomst.dødsboskat_efter_fradrag_kroner == 260000
