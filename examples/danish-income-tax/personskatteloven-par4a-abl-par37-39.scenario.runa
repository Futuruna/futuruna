@ sprog da

@ importer ./aktieavancebeskatningsloven - par37 - 39

-- Fokusscenarier for Aktieavancebeskatningsloven §§ 37-39.

= abl_par37_faktisk_dato = AktieavancePar23Dato(år = 2018, måned = 5, dag = 17)

= abl_par37_direkte_indtræden = aktieavance_par37_resultat(input = AktieavancePar37Input(
    faktisk_anskaffelsestidspunkt = abl_par37_faktisk_dato,
    hidtidig_anskaffelsessum_kroner = 80000,
    handelsværdi_på_tilflytningstidspunktet_kroner = 125000,
    i_forvejen_omfattet_af_dansk_beskatning = Falskt,
    indtrædelsesgrund = AblPar37SkattepligtIndtræder
))

= abl_par37_traktatindtræden = aktieavance_par37_resultat(input = AktieavancePar37Input(
    faktisk_anskaffelsestidspunkt = abl_par37_faktisk_dato,
    hidtidig_anskaffelsessum_kroner = 90000,
    handelsværdi_på_tilflytningstidspunktet_kroner = 140000,
    i_forvejen_omfattet_af_dansk_beskatning = Falskt,
    indtrædelsesgrund = AblPar37TraktathjemstedBliverDanmark
))

