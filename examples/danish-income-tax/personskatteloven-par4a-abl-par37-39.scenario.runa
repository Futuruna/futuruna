| scenarie_abl_par37_direkte_indtræden_bruger_handelsværdi: abl_par37_direkte_indtræden -> abl_par37_direkte_indtræden.input_gyldigt && abl_par37_direkte_indtræden.reglen_finder_anvendelse && abl_par37_direkte_indtræden.skattemæssigt_anskaffelsestidspunkt == abl_par37_faktisk_dato && abl_par37_direkte_indtræden.skattemæssig_anskaffelsessum_kroner == 125000
| scenarie_abl_par37_traktathjemsted_sidestilles_med_indtræden: abl_par37_traktatindtræden -> abl_par37_traktatindtræden.reglen_finder_anvendelse && abl_par37_traktatindtræden.skattemæssig_anskaffelsessum_kroner == 140000
| scenarie_abl_par37_allerede_beskattet_bevarer_basis: abl_par37_allerede_beskattet -> abl_par37_allerede_beskattet.reglen_finder_anvendelse == Falskt && abl_par37_allerede_beskattet.skattemæssig_anskaffelsessum_kroner == 90000
| scenarie_abl_par38_normal_fraflytning_nettoopgøres: abl_par38_normal_fraflytning -> abl_par38_normal_fraflytning.input_gyldigt && abl_par38_normal_fraflytning.skattepligtsophør_efter_stk1 && abl_par38_normal_fraflytning.samlet_kursværdi_efter_stk2_kroner == 200000 && abl_par38_normal_fraflytning.antal_aktier_omfattet == 2 && abl_par38_normal_fraflytning.samlede_gevinster_kroner == 50000 && abl_par38_normal_fraflytning.fradragsberettigede_tab_kroner == 20000 && abl_par38_normal_fraflytning.nettogevinst_til_skatteberegning_efter_stk5_kroner == 30000 && abl_par38_normal_fraflytning.har_realisationsopgjorte_poster
| scenarie_abl_par38_under_beløbsgrænsen_undtages: abl_par38_almindelig_beholdning_under_100000 -> abl_par38_almindelig_beholdning_under_100000.samlet_kursværdi_efter_stk2_kroner == 90000 && abl_par38_almindelig_beholdning_under_100000.særlig_beholdning_efter_stk2 == Falskt && abl_par38_almindelig_beholdning_under_100000.beholdningskrav_efter_stk2_opfyldt == Falskt && abl_par38_almindelig_beholdning_under_100000.antal_aktier_omfattet == 0
