@ sprog da

@ importer ./statsskatteloven - par6 - dobbelt - husfoerelse

----
Scenarier for den praksisbaserede opgørelse af fradrag for dobbelt
husførelse efter statsskattelovens § 6, litra a. Scenarierne er ikke lovtekst.
----

| sl6dh_scenarie_ophold(
    identifikation: Tekst,
    fra_dato: Dato,
    til_dato: Dato,
    erhvervsårsag: Statsskattelov6DobbeltHusførelseErhvervsårsag,
    midlertidighed: Statsskattelov6DobbeltHusførelseMidlertidighed,
    daglig_transport: Statsskattelov6DobbeltHusførelseDagligTransport,
    arbejdsgiverdækning: Statsskattelov6DobbeltHusførelseArbejdsgiverdækning,
    opgørelsesmetode: Statsskattelov6DobbeltHusførelseOpgørelsesmetode,
    toårsgrænse: Statsskattelov6DobbeltHusførelseToårsgrænse
) -> Statsskattelov6DobbeltHusførelseOphold(
    identifikation = identifikation,
    arbejdssted_identifikation = "projektsted",
    oprindelig_startdato = Dato(år = 2026, måned = 1, dag = 1),
    fradragsperiode_fra_dato = fra_dato,
    fradragsperiode_til_dato = til_dato,
    erhvervsårsag = erhvervsårsag,
    midlertidighed = midlertidighed,
    daglig_transport = daglig_transport,
    hjemmebolig = Sl6DhDanskFamilieboligOpretholdt,
    hjemlandsophold = [],
    arbejdsboligform = Sl6DhPrivatIndkvartering,
    merudgiftsforhold = Sl6DhMerudgifterTilKostEllerBoligAfholdt,
    arbejdsgiverdækning = arbejdsgiverdækning,
    opgørelsesmetode = opgørelsesmetode,
    toårsgrænse = toårsgrænse
)
| sl6dh_scenarie_midlertidigt_arbejde() -> Sl6DhMidlertidigtArbejde(
    art = Sl6DhTidsbegrænsetAnsættelse,
    aftalt_fra_dato = Dato(år = 2026, måned = 1, dag = 1),
    aftalt_til_dato = Dato(år = 2026, måned = 12, dag = 31)
)
| sl6dh_scenarie_umulig_daglig_transport() -> Statsskattelov6DobbeltHusførelseDagligTransport(
    vurdering = Sl6DhDagligTransportIkkeRimeligEfterKonkretVurdering,
    afstand_mellem_boliger_kilometer = 250,
    samlet_transporttid_pr_dag_minutter = 360,
    arbejdstid_pr_dag_minutter = 480
)
| sl6dh_scenarie_grundophold(identifikation: Tekst, opgørelsesmetode: Statsskattelov6DobbeltHusførelseOpgørelsesmetode) -> sl6dh_scenarie_ophold(
    identifikation = identifikation,
    fra_dato = Dato(år = 2026, måned = 1, dag = 1),
    til_dato = Dato(år = 2026, måned = 3, dag = 11),
    erhvervsårsag = Sl6DhSkatteydersEgetArbejdsforhold,
    midlertidighed = sl6dh_scenarie_midlertidigt_arbejde(),
    daglig_transport = sl6dh_scenarie_umulig_daglig_transport(),
    arbejdsgiverdækning = Sl6DhIngenArbejdsgiverdækning,
    opgørelsesmetode = opgørelsesmetode,
    toårsgrænse = Sl6DhAlmindeligToårsgrænse
)
| sl6dh_scenarie_ophold_efter_to_år(identifikation: Tekst, toårsgrænse: Statsskattelov6DobbeltHusførelseToårsgrænse) -> Statsskattelov6DobbeltHusførelseOphold(
    identifikation = identifikation,
    arbejdssted_identifikation = "langvarigt-projektsted",
    oprindelig_startdato = Dato(år = 2023, måned = 1, dag = 1),
    fradragsperiode_fra_dato = Dato(år = 2026, måned = 1, dag = 1),
    fradragsperiode_til_dato = Dato(år = 2026, måned = 3, dag = 11),
