    toårsgrænse = toårsgrænse
)
| sl6dh_scenarie_årsresultat(personkreds: Statsskattelov6DobbeltHusførelsePersonkreds, ophold: List(Statsskattelov6DobbeltHusførelseOphold), andre_dækninger: List(Statsskattelov6DobbeltHusførelseAndenDækning)) -> statsskattelov6_dobbelt_husførelse_årsresultat(
    indkomstår = 2026,
