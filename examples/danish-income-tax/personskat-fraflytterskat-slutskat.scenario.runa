@ sprog da

@ importer ./personskat.calculate

----
Scenarier for den kanoniske slutskattedifference ved fraflytning efter ABL
§ 38. Scenarierne er ikke lovtekst.
----

# FraflytterSlutskatPersonscenarie(aktieavance: PersonskatAktieavanceInput, ejendomsskatter: EjendomsskattelovPersonÅrsfakta)

| fraflytter_slutskat_ordinaert_aktivgrundlag() -> AblPar38OrdinærAktieEfterPar12Til15(fakta = AktieavancePar38OrdinærtAktivgrundlag(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    oplysningsstatus = AblOplysningsbetingelseIkkeOpfyldt,
    par5a_kildefakta = AblOrdinærIngenPar5AFaktaPåkrævet
))
| fraflytter_slutskat_ordinaert_tabsaktivgrundlag() -> AblPar38OrdinærAktieEfterPar12Til15(fakta = AktieavancePar38OrdinærtAktivgrundlag(
    markedsstatus = AblIkkeOptagetTilHandel,
    har_tidligere_været_optaget_til_handel = Falskt,
    oplysningsstatus = AblOplysningsbetingelseIkkeOpfyldt,
    par5a_kildefakta = AblOrdinærPar5AKildefakta(fakta = AktieavancePar5AFakta(
        anvendelsesgrundlag = AblPar5AAfståelseDen24November2010EllerSenere,
        skatteydergrundlag = AblPar5APersonSkattepligtigEfterPar7,
        ejertidsudbytter = [],
        præferenceposition = AktieavancePar5APræferenceposition(
            modtaget_tilsvarende_udbytte_kroner = 0,
            allerede_anvendt_til_tabsreduktion_kroner = 0
        ),
        koncernbeløb = []
    ))
))
| fraflytter_slutskat_saerligt_aktivgrundlag(klassifikation: AktieavanceAktivklassifikationInput) -> AblPar38SærligtAktiv(fakta = AktieavancePar38SærligtAktivgrundlag(
    klassifikation = klassifikation,
    markedsstatus = AblIkkeOptagetTilHandel,
    koncernintern_konvertibel_eller_tegningsret = Falskt,
    andelsforening_stiftet_før_22_maj_1987 = Falskt,
    afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
    årets_netto_med_kgl_par14_23_kroner = 0
))

= fraflytter_slutskat_naeringsaktiv = fraflytter_slutskat_saerligt_aktivgrundlag(AktieavanceAktivklassifikationInput(
    indkomstår = 2026,
    aktiv = AblNæringsaktiePar17,
    par17_modprøve = AktieavancePar17Modprøve(
        næringsstatus = AblPar17UdøverNæringVedKøbOgSalgAfAktier,
        erhvervelsesstatus = AblPar17ErhvervetSomLedINæringsvej
    ),
    investeringsklassifikation = AblIngenInvesteringsklassifikation
))
= fraflytter_slutskat_investeringsselskab19c = fraflytter_slutskat_saerligt_aktivgrundlag(AktieavanceAktivklassifikationInput(
    indkomstår = 2026,
    aktiv = AblInvesteringsselskabPar19TilKlassifikation,
    par17_modprøve = AktieavancePar17Modprøve(
        næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
        erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
    ),
    investeringsklassifikation = AblPar19BPar19CKlassifikation(input = abl19c_klassifikationsresultat.input)
))

| fraflytter_slutskat_aktiepost(identifikation: Tekst, raekkefoelge: Heltal, gevinst_kroner: Heltal, aktivgrundlag: AktieavancePar38Aktivgrundlag, princip: AktieavancePar23Princip, henstandsvalg: AktieavancePar37Til40Henstandsvalg) -> AktieavancePar37Til40AktiepostFakta(
    identifikation = identifikation,
    selskabsidentifikation = "DK-" + identifikation,
    aktieserie = "ordinær",
    erhvervelsesdato = AktieavancePar23Dato(år = 2020, måned = 1, dag = 1),
    erhvervelsesrækkefølge = raekkefoelge,
    antal = 100,
    handelsværdi_ved_ophør_kroner = 200000 + gevinst_kroner,
    skattemæssig_anskaffelsessum_kroner = 200000,
    beskatningsstatus = AblPar38AktieOmfattetAfDanskBeskatning,
    par44_status = AblPar38IkkeHistoriskPar44Aktie,
    egenskaber = [],
    opgørelseskilde = AblPar37Til40OpgørelseEfterPar23Til29Og46,
    aktivgrundlag = aktivgrundlag,
    princip = princip,
    henstandsvalg = henstandsvalg
)

| fraflytter_slutskat_kilde_med_fraflytningsforhold(identifikation: Tekst, fraflytningsdato: Dato, tilknytning: AktieavancePar38Tilknytning, aktier: List(AktieavancePar37Til40AktiepostFakta)) -> PersonskatSærligtAktieaktivFakta(
    identifikation = identifikation,
    kilde = PersonskatFraflytteraktierEfterPar37Til40(fakta = PersonskatPar37Til40Forløbsfakta(
        identifikation = identifikation,
        opgørelsesår = 2026,
        fraflytning = PersonskatPar37Til40Fraflytningsfakta(
            fraflytningsdato = fraflytningsdato,
            fraflytningsår = 2026,
            ophørsgrund = AblPar38OphørAfSkattepligtEfterKildeskattelovPar1,
            tilknytning = tilknytning,
            aktier = aktier,
            kontekstgrundlag = AfledPar37Til40KontekstFraPersonskat,
            indberetning = AktieavancePar39Indberetning(
                oplysninger_efter_skattekontrollov_par2 = AblPar39RettidigOrdinærFrist,
                beholdningsoversigt_efter_par39a = AblPar39RettidigOrdinærFrist
            ),
            bopæl = AktieavancePar39Bopæl(
                oprindeligt_fraflytningsland = AblPar39LandOmfattetAfNordiskOverenskomstEllerEuDirektiv,
                aktuelt_land = AblPar39LandOmfattetAfNordiskOverenskomstEllerEuDirektiv,
                frigivelse_af_sikkerhed_anmodet = Falskt
            ),
            sikkerhed = AblPar39IngenSikkerhedStillet
        ),
        hændelsesposter = [],
        kildehistorik = AktieavancePar39AKildehistorik(
            opgjort_pr = Dato(år = 2026, måned = 12, dag = 31),
            fristudsættelser = []
        ),
        tilflytning = IngenTilflytningEfterPar39B
    )),
    markedsstatus = AblIkkeOptagetTilHandel
)
| fraflytter_slutskat_kilde(identifikation: Tekst, aktier: List(AktieavancePar37Til40AktiepostFakta)) -> fraflytter_slutskat_kilde_med_fraflytningsforhold(
    identifikation,
    Dato(år = 2026, måned = 7, dag = 1),
    AblPar38MindstSyvÅrIndenForSenesteTiÅr,
    aktier
)

= fraflytter_slutskat_loenmodtager = PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
| fraflytter_slutskat_aktieavance(særlige_aktiver: List(PersonskatSærligtAktieaktivFakta)) -> PersonskatAktieavanceInput(
    ordinært_aktieår = UdenOrdinærtAktieår,
    særlige_aktiver = særlige_aktiver,
    udbytter = []
)
| fraflytter_slutskat_personscenarie(særlige_aktiver: List(PersonskatSærligtAktieaktivFakta)) -> FraflytterSlutskatPersonscenarie(
    aktieavance = fraflytter_slutskat_aktieavance(særlige_aktiver),
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta()
)
| fraflytter_slutskat_input(særlige_aktiver: List(PersonskatSærligtAktieaktivFakta)) -> PersonskatInput(
    lønmodtager = fraflytter_slutskat_loenmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = fraflytter_slutskat_aktieavance(særlige_aktiver),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    årsopgørelse = UdenÅrsopgørelse
)
| fraflytter_slutskat_personfakta_fra_scenarie(scenarie: FraflytterSlutskatPersonscenarie) -> PersonskatPersonFakta(
    lønmodtager = fraflytter_slutskat_loenmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = scenarie.aktieavance,
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ejendomsskatter = scenarie.ejendomsskatter
)
| fraflytter_slutskat_personfakta(særlige_aktiver: List(PersonskatSærligtAktieaktivFakta)) -> fraflytter_slutskat_personfakta_fra_scenarie(fraflytter_slutskat_personscenarie(særlige_aktiver))
| fraflytter_slutskat_parinput_med_personer(hovedperson: FraflytterSlutskatPersonscenarie, ægtefælle: FraflytterSlutskatPersonscenarie) -> PersonskatInput(
    lønmodtager = fraflytter_slutskat_loenmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = hovedperson.aktieavance,
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = MedÆgtefælle(
        fakta = fraflytter_slutskat_personfakta_fra_scenarie(ægtefælle),
        samlevende_ved_indkomstårets_udløb = Sandt
    ),
    ejendomsskatter = hovedperson.ejendomsskatter,
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    årsopgørelse = UdenÅrsopgørelse
)
| fraflytter_slutskat_parinput(hovedpersons_særlige_aktiver: List(PersonskatSærligtAktieaktivFakta), ægtefælles_særlige_aktiver: List(PersonskatSærligtAktieaktivFakta)) -> fraflytter_slutskat_parinput_med_personer(
    hovedperson = fraflytter_slutskat_personscenarie(hovedpersons_særlige_aktiver),
    ægtefælle = fraflytter_slutskat_personscenarie(ægtefælles_særlige_aktiver)
)
| fraflytter_slutskat_parinput_med_fremførsel(input: PersonskatInput, fremførsel: PersonskatNegativAktieskatFremførselsparInput) -> PersonskatInput(
    lønmodtager = input.lønmodtager,
    kapitalindkomst = input.kapitalindkomst,
    aktieavance = input.aktieavance,
    udenlandske_sociale_bidrag = input.udenlandske_sociale_bidrag,
    cfc = input.cfc,
    skatteforhold = input.skatteforhold,
    underskudsforhold = input.underskudsforhold,
    ægtefælle = input.ægtefælle,
    ejendomsskatter = input.ejendomsskatter,
    negativ_aktieskat_fremførsel = fremførsel,
    årsopgørelse = input.årsopgørelse
)
| fraflytter_slutskat_for_særligt_resultat(resultat: PersonskatSærligtAktieaktivResultat) -> match resultat.par37_til40_forløbsresultat {
    | Some(forløb) -> forløb.årets_beregnede_fraflytterskat_kroner
    | None -> 0
}
| fraflytter_slutskat_for_aktieavance(resultat: PersonskatAktieavanceResultat) -> foldl(
    resultat.særlige_resultater,
    0,
    |skat_kroner: Heltal, særligt_resultat: PersonskatSærligtAktieaktivResultat| skat_kroner + fraflytter_slutskat_for_særligt_resultat(særligt_resultat)
)
| fraflytter_slutskat_for_ægtefælle(resultat: PersonskatBeregningResultat) -> match resultat.ægtefælle {
    | IngenÆgtefælleberegning -> 0
    | BeregnetÆgtefælle(_, grundlag, _, _) -> fraflytter_slutskat_for_aktieavance(grundlag.aktieavance)
}
| fraflytter_slutskat_for_par(resultat: PersonskatBeregningResultat) -> fraflytter_slutskat_for_aktieavance(resultat.aktieavance) + fraflytter_slutskat_for_ægtefælle(resultat)
| fraflytter_slutskat_parrets_samlede_skat(resultat: PersonskatBeregningResultat) -> resultat.samlet_skat_inkl_ejendomsskatter_efter_fremført_negativ_aktieindkomstskat_kroner + personskat_ægtefælles_slutskat_kroner(resultat)

= fraflytter_slutskat_blandet_aktier = [
    fraflytter_slutskat_aktiepost("ordinaer-gevinst", 1, 50000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
    fraflytter_slutskat_aktiepost("naering-gevinst", 2, 30000, fraflytter_slutskat_naeringsaktiv, AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
    fraflytter_slutskat_aktiepost("par19c-gevinst", 3, 20000, fraflytter_slutskat_investeringsselskab19c, AblPar23Lagerprincip, AblPar37Til40SkatBetalesStraks),
]
= fraflytter_slutskat_blandet_kilde = fraflytter_slutskat_kilde("blandet-slutskat", fraflytter_slutskat_blandet_aktier)
= fraflytter_slutskat_basis = beregn_personskat(fraflytter_slutskat_input([]))
= fraflytter_slutskat_blandet = beregn_personskat(fraflytter_slutskat_input([fraflytter_slutskat_blandet_kilde]))

= fraflytter_slutskat_ikke_positiv_kilde = fraflytter_slutskat_kilde("ikke-positiv-slutskat", [
    fraflytter_slutskat_aktiepost("ikke-positiv-ordinaer", 1, 50000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
    fraflytter_slutskat_aktiepost("ikke-positiv-par19c", 2, -60000, fraflytter_slutskat_investeringsselskab19c, AblPar23Lagerprincip, AblPar37Til40SkatBetalesStraks),
])
= fraflytter_slutskat_ikke_positiv = beregn_personskat(fraflytter_slutskat_input([fraflytter_slutskat_ikke_positiv_kilde]))

= fraflytter_slutskat_foerste_kilde = fraflytter_slutskat_kilde("foerste-slutskat", [
    fraflytter_slutskat_aktiepost("foerste-aktie", 1, 20000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
])
= fraflytter_slutskat_anden_kilde = fraflytter_slutskat_kilde("anden-slutskat", [
    fraflytter_slutskat_aktiepost("anden-aktie", 1, 80000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
])
= fraflytter_slutskat_flere = beregn_personskat(fraflytter_slutskat_input([fraflytter_slutskat_foerste_kilde, fraflytter_slutskat_anden_kilde]))

| fraflytter_slutskat_tabskilde(fraflytningsdato: Dato, tilknytning: AktieavancePar38Tilknytning) -> fraflytter_slutskat_kilde_med_fraflytningsforhold("tabsmodregning", fraflytningsdato, tilknytning, [
    fraflytter_slutskat_aktiepost("tab-30000", 1, -30000, fraflytter_slutskat_ordinaert_tabsaktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
])
| fraflytter_slutskat_gevinstkilde(fraflytningsdato: Dato) -> fraflytter_slutskat_kilde_med_fraflytningsforhold("tabsmodregning", fraflytningsdato, AblPar38MindstSyvÅrIndenForSenesteTiÅr, [
    fraflytter_slutskat_aktiepost("gevinst-100000", 1, 100000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
])

= fraflytter_slutskat_ejendomsskat_tabsposition = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-EJENDOMSSKAT-PROJEKTION-TAB",
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 100),
    anskaffelsessum_kroner = 560000
)
= fraflytter_slutskat_ejendomsskat_tabsafståelse = AblOrdinærAfståelse(
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 100),
    afståelsessum_kroner = 0,
    vilkår = AktieavanceOrdinærAfståelsesvilkår(
        markedsstatus = AblIkkeOptagetTilHandel,
        har_tidligere_været_optaget_til_handel = Falskt,
        hovedaktionæraktier = Falskt,
        afståede_aktiers_handelsværdi_kroner = 0,
        beholdte_aktiers_handelsværdi_kroner = 0,
        oplysningsstatus = AblOplystRettidigt,
        boligret = AblUdenBoligret
    ),
    par5a_kildefakta = AblOrdinærPar5AKildefakta(fakta = AktieavancePar5AFakta(
        anvendelsesgrundlag = AblPar5AAfståelseDen24November2010EllerSenere,
        skatteydergrundlag = AblPar5APersonSkattepligtigEfterPar7,
        ejertidsudbytter = [],
        præferenceposition = AktieavancePar5APræferenceposition(
            modtaget_tilsvarende_udbytte_kroner = 0,
            allerede_anvendt_til_tabsreduktion_kroner = 0
        ),
        koncernbeløb = []
    ))
)
= fraflytter_slutskat_ejendomsskat_tabsår = AktieavanceOrdinærPersonÅrsinput(
    indkomstår = 2026,
    hændelsesforløb = [AktieavanceOrdinærHændelsesforløbInput(
        position_primo = fraflytter_slutskat_ejendomsskat_tabsposition,
        hændelser = [fraflytter_slutskat_ejendomsskat_tabsafståelse]
    )],
    investeringsbeviser = [],
    fremført_tab_efter_par13a_kroner = 0
)
= fraflytter_slutskat_ejendomsskat_gevinstkilde = fraflytter_slutskat_kilde("ejendomsskat-projektion", [
    fraflytter_slutskat_aktiepost("ejendomsskat-projektion-gevinst", 1, 100000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
])
= fraflytter_slutskat_ejendomsskat_aktieavance = PersonskatAktieavanceInput(
    ordinært_aktieår = MedOrdinærtAktieår(input = fraflytter_slutskat_ejendomsskat_tabsår),
    særlige_aktiver = [fraflytter_slutskat_ejendomsskat_gevinstkilde],
    udbytter = []
)
= fraflytter_slutskat_ejendomsskat_fakta = EjendomsskattelovPersonÅrsfakta(
    person = ejendomsskattelov_ingen_person_kildefakta(),
    ejendomme = [EjendomsskattelovPersonEjendomFakta(
        ordinært_grundlag = EjendomsskattelovOrdinærPersonEjendomFakta(
            identifikation = "fraflytter-projektion-ejerbolig",
            kommune = København,
            kategori = EjskEnBoligenhed,
            beliggenhed = EjskDanmark,
            erhvervsmæssigt_udlejet = Falskt,
            særlige_betingelser_for_nr6_til_nr8_opfyldt = Sandt,
            ejendomsværdi_kroner = 3710000,
            grundværdi_kroner = 3363000,
            produktionsjord = Falskt,
            ejendomsværdiskatteperiode = HeleEjendomsskatteåret,
            grundskyldsperiode = HeleEjendomsskatteåret,
            ejerandel_basispoint = 5000
        ),
        nedslagsfakta = EjendomsskattelovNedslagsfakta(
            ejerskabshistorik = EjendomsskattelovEjerskabshistorik(
                oprindelig_erhvervelsesdato = EjendomsskattelovDato(år = 2025, måned = 8, dag = 1),
                ejerskifter = []
            ),
            boliganvendelse = EjskHelårsbolig,
            selvstændige_boligenheder = 1,
            ejendomsform = EjskIkkeEjerlejlighed,
            fredet_og_omfattet_af_ligningslovens_par15k = Falskt,
            par24_beregningsgrundlag = EjskPar24SammeVærdiSomPar13,
            pensionistsuccession = EjskIngenPensionistsuccession,
            udenlandske_ejendomsskatter = []
        ),
        overgangsomfang = EjendomsskattelovOvergangsomfang(
            vurderingskategori = EjskEjerboligEfterEjendomsvurderingslovensPar3Stk1Nr1,
            ejerkreds = EjskKunFysiskeEjere
        ),
        overgangsvurderinger = ejendomsskattelov_ingen_overgangsvurderinger()
    )]
)
= fraflytter_slutskat_ejendomsskat_personscenarie = FraflytterSlutskatPersonscenarie(
    aktieavance = fraflytter_slutskat_ejendomsskat_aktieavance,
    ejendomsskatter = fraflytter_slutskat_ejendomsskat_fakta
)
= fraflytter_slutskat_ejendomsskat_neutral_personscenarie = fraflytter_slutskat_personscenarie([])
= fraflytter_slutskat_ejendomsskat_hovedperson = beregn_personskat(fraflytter_slutskat_parinput_med_personer(
    hovedperson = fraflytter_slutskat_ejendomsskat_personscenarie,
    ægtefælle = fraflytter_slutskat_ejendomsskat_neutral_personscenarie
))
= fraflytter_slutskat_ejendomsskat_ægtefælle = beregn_personskat(fraflytter_slutskat_parinput_med_personer(
    hovedperson = fraflytter_slutskat_ejendomsskat_neutral_personscenarie,
    ægtefælle = fraflytter_slutskat_ejendomsskat_personscenarie
))
| fraflytter_slutskat_afledt_kontekst(resultat: PersonskatAktieavanceResultat) -> match head(resultat.særlige_resultater).par37_til40_forløbsresultat {
    | Some(forløb) -> match forløb.fraflytningsresultat.skattekontekst {
        | AblPar37Til40AfledtSlutskat(kontekst) -> Some(kontekst)
        | AblPar37Til40LokalAktieindkomstskat -> None
    }
    | None -> None
}
| fraflytter_slutskat_ægtefælles_afledte_kontekst(resultat: PersonskatBeregningResultat) -> match resultat.ægtefælle {
    | BeregnetÆgtefælle(_, grundlag, _, _) -> fraflytter_slutskat_afledt_kontekst(grundlag.aktieavance)
    | IngenÆgtefælleberegning -> None
}
| fraflytter_slutskat_ejendomsskat_rolleombytning() -> match fraflytter_slutskat_afledt_kontekst(fraflytter_slutskat_ejendomsskat_hovedperson.aktieavance) {
    | Some(hovedkontekst) -> match fraflytter_slutskat_ægtefælles_afledte_kontekst(fraflytter_slutskat_ejendomsskat_ægtefælle) {
        | Some(ægtefællekontekst) -> {
            = hoved_ejendomsskat_kroner = fraflytter_slutskat_ejendomsskat_hovedperson.ejendomsskatter.samlet_ejendomsskat_kroner
            = ægtefælle_ejendomsskat_kroner = personskat_ægtefælle_ejendomsskat_kroner(fraflytter_slutskat_ejendomsskat_ægtefælle.ægtefælles_ejendomsskatter)
            = hoved_fraflytterskat_kroner = fraflytter_slutskat_for_par(fraflytter_slutskat_ejendomsskat_hovedperson)
            = ægtefælle_fraflytterskat_kroner = fraflytter_slutskat_for_par(fraflytter_slutskat_ejendomsskat_ægtefælle)
            @ print("ABL §§ 37-40 ejendomsskatteprojektion: ejendom=" + vis(hoved_ejendomsskat_kroner) + "/" + vis(ægtefælle_ejendomsskat_kroner) + ", uden=" + vis(hovedkontekst.skat_uden_fraflytterindkomst_kroner) + "/" + vis(ægtefællekontekst.skat_uden_fraflytterindkomst_kroner) + ", fuld=" + vis(hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner) + "/" + vis(ægtefællekontekst.skat_med_hele_fraflytterindkomsten_kroner) + ", fraflytterskat=" + vis(hoved_fraflytterskat_kroner) + "/" + vis(ægtefælle_fraflytterskat_kroner))
            (hoved_ejendomsskat_kroner == 14428
                && hoved_ejendomsskat_kroner == ægtefælle_ejendomsskat_kroner
                && hovedkontekst.skat_uden_fraflytterindkomst_kroner == 220500
                && hovedkontekst.skat_uden_fraflytterindkomst_kroner == ægtefællekontekst.skat_uden_fraflytterindkomst_kroner
                && hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner == 262500
                && hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner == ægtefællekontekst.skat_med_hele_fraflytterindkomsten_kroner
                && hoved_fraflytterskat_kroner == 42000
                && hoved_fraflytterskat_kroner == ægtefælle_fraflytterskat_kroner)
        }
        | None -> Falskt
    }
    | None -> Falskt
}
| fraflytter_slutskat_ejendomsskatteprojektion_er_rolleuafhængig: Sandt -> fraflytter_slutskat_ejendomsskat_rolleombytning()

| fraflytter_slutskat_ekstern_fremførsel(ejer: PersonskatNegativAktieskatEjer) -> EksterntFastsatFremførtNegativAktieskat(
    trancher = [PersonskatNegativAktieskatTranche(
        ejer = ejer,
        oprindelsesår = 2024,
        resterende_negativ_skat_kroner = 440000
    )],
    proveniens = SkatteforvaltningensÅrsopgørelse(
        dokumentreference = "fraflytterprojektion-fremførsel-2025"
    )
)
= fraflytter_slutskat_fremførsel_personscenarie = fraflytter_slutskat_personscenarie([fraflytter_slutskat_ejendomsskat_gevinstkilde])
= fraflytter_slutskat_fremførsel_hovedperson = beregn_personskat(fraflytter_slutskat_parinput_med_fremførsel(
    input = fraflytter_slutskat_parinput_med_personer(
        hovedperson = fraflytter_slutskat_fremførsel_personscenarie,
        ægtefælle = fraflytter_slutskat_ejendomsskat_neutral_personscenarie
    ),
    fremførsel = PersonskatNegativAktieskatFremførselsparInput(
        hovedperson = fraflytter_slutskat_ekstern_fremførsel(HovedpersonensNegativAktieskat),
        ægtefælle = UdenFremførtNegativAktieskat
    )
))
= fraflytter_slutskat_fremførsel_ægtefælle = beregn_personskat(fraflytter_slutskat_parinput_med_fremførsel(
    input = fraflytter_slutskat_parinput_med_personer(
        hovedperson = fraflytter_slutskat_ejendomsskat_neutral_personscenarie,
        ægtefælle = fraflytter_slutskat_fremførsel_personscenarie
    ),
    fremførsel = PersonskatNegativAktieskatFremførselsparInput(
        hovedperson = UdenFremførtNegativAktieskat,
        ægtefælle = fraflytter_slutskat_ekstern_fremførsel(ÆgtefællensNegativAktieskat)
    )
))
| fraflytter_slutskat_fremførselsprojektion_rolleombytning() -> match fraflytter_slutskat_afledt_kontekst(fraflytter_slutskat_fremførsel_hovedperson.aktieavance) {
    | Some(hovedkontekst) -> match fraflytter_slutskat_ægtefælles_afledte_kontekst(fraflytter_slutskat_fremførsel_ægtefælle) {
        | Some(ægtefællekontekst) -> {
            = hoved_fraflytterskat_kroner = fraflytter_slutskat_for_par(fraflytter_slutskat_fremførsel_hovedperson)
            = ægtefælle_fraflytterskat_kroner = fraflytter_slutskat_for_par(fraflytter_slutskat_fremførsel_ægtefælle)
            @ print("ABL §§ 37-40 fremførselsprojektion: uden=" + vis(hovedkontekst.skat_uden_fraflytterindkomst_kroner) + "/" + vis(ægtefællekontekst.skat_uden_fraflytterindkomst_kroner) + ", fuld=" + vis(hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner) + "/" + vis(ægtefællekontekst.skat_med_hele_fraflytterindkomsten_kroner) + ", fraflytterskat=" + vis(hoved_fraflytterskat_kroner) + "/" + vis(ægtefælle_fraflytterskat_kroner))
            (hovedkontekst.input_gyldigt
                && ægtefællekontekst.input_gyldigt
                && fraflytter_slutskat_fremførsel_hovedperson.negativ_aktieskat_fremførselsår.alle_åbningsgrundlag_gyldige
                && fraflytter_slutskat_fremførsel_ægtefælle.negativ_aktieskat_fremførselsår.alle_åbningsgrundlag_gyldige
                && hovedkontekst.skat_uden_fraflytterindkomst_kroner == 0
                && hovedkontekst.skat_uden_fraflytterindkomst_kroner == ægtefællekontekst.skat_uden_fraflytterindkomst_kroner
                && hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner == 4452
                && hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner == ægtefællekontekst.skat_med_hele_fraflytterindkomsten_kroner
                && hoved_fraflytterskat_kroner == hovedkontekst.skat_med_hele_fraflytterindkomsten_kroner
                && hoved_fraflytterskat_kroner == ægtefælle_fraflytterskat_kroner)
        }
        | None -> Falskt
    }
    | None -> Falskt
}
| fraflytter_slutskat_fremførselsprojektion_er_rolleuafhængig: Sandt -> fraflytter_slutskat_fremførselsprojektion_rolleombytning()

| fraflytter_slutskat_ægtefællemodregning_scenarier() -> {
    = samtidig_dato = Dato(år = 2026, måned = 7, dag = 1)
    = anden_dato = Dato(år = 2026, måned = 8, dag = 1)
    = parbasis_input = fraflytter_slutskat_parinput([], [])
    = parbasis = beregn_personskat(parbasis_input)
    = hovedgevinst_100000 = fraflytter_slutskat_kilde_med_fraflytningsforhold("fælles-kilde", samtidig_dato, AblPar38MindstSyvÅrIndenForSenesteTiÅr, [
        fraflytter_slutskat_aktiepost("hovedgevinst-100000", 1, 100000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
    ])
    = ægtefællegevinst_50000 = fraflytter_slutskat_kilde_med_fraflytningsforhold("fælles-kilde", samtidig_dato, AblPar38MindstSyvÅrIndenForSenesteTiÅr, [
        fraflytter_slutskat_aktiepost("ægtefællegevinst-50000", 1, 50000, fraflytter_slutskat_ordinaert_aktivgrundlag(), AblPar23Realisationsprincip, AblPar37Til40HenstandSøges),
    ])
    = begge_positive_input = fraflytter_slutskat_parinput([hovedgevinst_100000], [ægtefællegevinst_50000])
    = begge_positive = beregn_personskat(begge_positive_input)
    = tab_og_gevinst_input = fraflytter_slutskat_parinput(
        [fraflytter_slutskat_tabskilde(samtidig_dato, AblPar38MindstSyvÅrIndenForSenesteTiÅr)],
        [fraflytter_slutskat_gevinstkilde(samtidig_dato)]
    )
    = tab_og_gevinst = beregn_personskat(tab_og_gevinst_input)
    = gevinst_og_tab_input = fraflytter_slutskat_parinput(
        [fraflytter_slutskat_gevinstkilde(samtidig_dato)],
        [fraflytter_slutskat_tabskilde(samtidig_dato, AblPar38MindstSyvÅrIndenForSenesteTiÅr)]
    )
    = gevinst_og_tab = beregn_personskat(gevinst_og_tab_input)
    = kun_en_skattepligtig_input = fraflytter_slutskat_parinput(
        [fraflytter_slutskat_tabskilde(samtidig_dato, AblPar38UnderSyvÅrIndenForSenesteTiÅr)],
        [fraflytter_slutskat_gevinstkilde(samtidig_dato)]
    )
    = kun_en_skattepligtig = beregn_personskat(kun_en_skattepligtig_input)
    = forskellige_datoer_input = fraflytter_slutskat_parinput(
        [fraflytter_slutskat_tabskilde(samtidig_dato, AblPar38MindstSyvÅrIndenForSenesteTiÅr)],
        [fraflytter_slutskat_gevinstkilde(anden_dato)]
    )
    = forskellige_datoer = beregn_personskat(forskellige_datoer_input)
    = basis_skat_kroner = fraflytter_slutskat_parrets_samlede_skat(parbasis)
    = begge_positive_fraflytterskat_kroner = fraflytter_slutskat_for_par(begge_positive)
    = tab_og_gevinst_fraflytterskat_kroner = fraflytter_slutskat_for_par(tab_og_gevinst)
    = gevinst_og_tab_fraflytterskat_kroner = fraflytter_slutskat_for_par(gevinst_og_tab)
    = kun_en_skattepligtig_fraflytterskat_kroner = fraflytter_slutskat_for_par(kun_en_skattepligtig)
    = forskellige_datoer_fraflytterskat_kroner = fraflytter_slutskat_for_par(forskellige_datoer)
    = ægtefælleresultater_gyldige = match tab_og_gevinst.ægtefælle {
        | BeregnetÆgtefælle(_, grundlag, _, _) -> grundlag.aktieavance.alle_input_gyldige && grundlag.aktieavance.aktieindkomst_kroner == 100000
        | IngenÆgtefælleberegning -> Falskt
    }
    @ print("ABL § 38 ægtefællekontrol: positive=" + vis(begge_positive_fraflytterskat_kroner) + ", tab/gevinst=" + vis(tab_og_gevinst_fraflytterskat_kroner) + ", omvendt=" + vis(gevinst_og_tab_fraflytterskat_kroner) + ", kun-en=" + vis(kun_en_skattepligtig_fraflytterskat_kroner) + ", forskellige-datoer=" + vis(forskellige_datoer_fraflytterskat_kroner) + ", deltas=" + vis(fraflytter_slutskat_parrets_samlede_skat(begge_positive) - basis_skat_kroner) + "/" + vis(fraflytter_slutskat_parrets_samlede_skat(tab_og_gevinst) - basis_skat_kroner) + "/" + vis(fraflytter_slutskat_parrets_samlede_skat(gevinst_og_tab) - basis_skat_kroner) + "/" + vis(fraflytter_slutskat_parrets_samlede_skat(kun_en_skattepligtig) - basis_skat_kroner) + "/" + vis(fraflytter_slutskat_parrets_samlede_skat(forskellige_datoer) - basis_skat_kroner) + ", spouse-valid=" + vis(ægtefælleresultater_gyldige))
    (begge_positive.aktieavance.alle_input_gyldige
        && begge_positive_fraflytterskat_kroner == 40500
        && begge_positive_fraflytterskat_kroner == fraflytter_slutskat_parrets_samlede_skat(begge_positive) - basis_skat_kroner
        && tab_og_gevinst.aktieavance.alle_input_gyldige
        && tab_og_gevinst.aktieavance.aktieindkomst_kroner == -30000
        && tab_og_gevinst.aktieindkomst_parår.input.egen_aktieindkomst_kroner == -30000
        && tab_og_gevinst.aktieindkomst_parår.input.ægtefælles_aktieindkomst_kroner == 100000
        && tab_og_gevinst.aktieindkomst_parår.egen_aktieindkomst_efter_ægtefællemodregning_kroner == 0
        && tab_og_gevinst.aktieindkomst_parår.ægtefælles_aktieindkomst_efter_ægtefællemodregning_kroner == 70000
        && tab_og_gevinst.negativ_aktieindkomstskat.samlet_negativ_skat_kroner == 0
        && tab_og_gevinst.negativ_aktieindkomstskat.samlet_negativ_skat_fremført_kroner == 0
        && ægtefælleresultater_gyldige
        && length(head(tab_og_gevinst.aktieavance.særlige_resultater).kilderesultater) == 1
        && tab_og_gevinst_fraflytterskat_kroner == 18900
        && tab_og_gevinst_fraflytterskat_kroner == fraflytter_slutskat_parrets_samlede_skat(tab_og_gevinst) - basis_skat_kroner
        && gevinst_og_tab_fraflytterskat_kroner == tab_og_gevinst_fraflytterskat_kroner
        && gevinst_og_tab_fraflytterskat_kroner == fraflytter_slutskat_parrets_samlede_skat(gevinst_og_tab) - basis_skat_kroner
        && kun_en_skattepligtig_fraflytterskat_kroner == 27000
        && kun_en_skattepligtig_fraflytterskat_kroner == fraflytter_slutskat_parrets_samlede_skat(kun_en_skattepligtig) - basis_skat_kroner
        && length(head(kun_en_skattepligtig.aktieavance.særlige_resultater).kilderesultater) == 0
        && forskellige_datoer_fraflytterskat_kroner == 27000
        && forskellige_datoer_fraflytterskat_kroner == fraflytter_slutskat_parrets_samlede_skat(forskellige_datoer) - basis_skat_kroner
        && length(head(forskellige_datoer.aktieavance.særlige_resultater).kilderesultater) == 0)
}
| fraflytter_slutskat_ægtefællemodregning_scenarier_består: Sandt -> fraflytter_slutskat_ægtefællemodregning_scenarier()

| fraflytter_slutskat_blandet_kategorier_foedes_til_aarsberegningen: fraflytter_slutskat_blandet -> fraflytter_slutskat_blandet.aktieavance.alle_input_gyldige && fraflytter_slutskat_blandet.aktieavance.aktieindkomst_kroner == 50000 && fraflytter_slutskat_blandet.aktieavance.personlig_indkomst_kroner == 30000 && fraflytter_slutskat_blandet.aktieavance.kapitalindkomst_kroner == 20000
| fraflytter_slutskat_blandet_bruger_kanonisk_marginaldelta: fraflytter_slutskat_blandet -> match head(fraflytter_slutskat_blandet.aktieavance.særlige_resultater).par37_til40_forløbsresultat {
    | Some(forløb) -> match forløb.fraflytningsresultat.skattekontekst {
        | AblPar37Til40AfledtSlutskat(kontekst) -> forløb.input_gyldigt && kontekst.input_gyldigt && kontekst.skat_uden_fraflytterindkomst_kroner == fraflytter_slutskat_basis.samlet_skat_inkl_endelig_aktieindkomstskat_kroner && kontekst.skat_med_hele_fraflytterindkomsten_kroner == fraflytter_slutskat_blandet.samlet_skat_inkl_endelig_aktieindkomstskat_kroner && forløb.årets_beregnede_fraflytterskat_kroner == kontekst.skat_med_hele_fraflytterindkomsten_kroner - kontekst.skat_uden_fraflytterindkomst_kroner
        | AblPar37Til40LokalAktieindkomstskat -> Falskt
    }
    | None -> Falskt
}
| fraflytter_slutskat_kun_realisationsposter_giver_henstand: fraflytter_slutskat_blandet -> match head(fraflytter_slutskat_blandet.aktieavance.særlige_resultater).par37_til40_forløbsresultat {
    | Some(forløb) -> match forløb.fraflytningsresultat.skattekontekst {
        | AblPar37Til40AfledtSlutskat(kontekst) -> length(forløb.fraflytningsresultat.umiddelbare_aktieavancebeskatningslov_resultater) == 1 && length(forløb.fraflytningsresultat.henstandsvalgte_aktieavancebeskatningslov_resultater) == 2 && forløb.årets_nye_henstand_kroner == kontekst.skat_med_hele_fraflytterindkomsten_kroner - kontekst.skat_før_henstandsvalgt_fraflytterindkomst_kroner && forløb.årets_skat_til_betaling_ved_fraflytning_kroner == forløb.årets_beregnede_fraflytterskat_kroner - forløb.årets_nye_henstand_kroner
        | AblPar37Til40LokalAktieindkomstskat -> Falskt
    }
    | None -> Falskt
}
| fraflytter_slutskat_ikke_positiv_netto_giver_ingen_skat: fraflytter_slutskat_ikke_positiv -> match head(fraflytter_slutskat_ikke_positiv.aktieavance.særlige_resultater).par37_til40_forløbsresultat {
    | Some(forløb) -> forløb.input_gyldigt && forløb.fraflytningsresultat.par38_resultat.samlet_nettogevinst_før_gulv_kroner == -10000 && length(forløb.aktieavancebeskatningslov_resultater) == 0 && forløb.årets_beregnede_fraflytterskat_kroner == 0 && forløb.årets_nye_henstand_kroner == 0 && fraflytter_slutskat_ikke_positiv.samlet_skat_inkl_endelig_aktieindkomstskat_kroner == fraflytter_slutskat_basis.samlet_skat_inkl_endelig_aktieindkomstskat_kroner
    | None -> Falskt
}
| fraflytter_slutskat_flere_kilder_teleskoperer_i_kildelisteorden: fraflytter_slutskat_flere -> match head(fraflytter_slutskat_flere.aktieavance.særlige_resultater).par37_til40_forløbsresultat {
    | Some(foerste) -> match head(tail(fraflytter_slutskat_flere.aktieavance.særlige_resultater)).par37_til40_forløbsresultat {
        | Some(anden) -> foerste.input_gyldigt && anden.input_gyldigt && foerste.fraflytningsresultat.skat_med_hele_fraflyttergevinsten_kroner == anden.fraflytningsresultat.skat_uden_fraflyttergevinst_kroner && foerste.årets_beregnede_fraflytterskat_kroner + anden.årets_beregnede_fraflytterskat_kroner == fraflytter_slutskat_flere.samlet_skat_inkl_endelig_aktieindkomstskat_kroner - fraflytter_slutskat_basis.samlet_skat_inkl_endelig_aktieindkomstskat_kroner
        | None -> Falskt
    }
    | None -> Falskt
}

? fraflytter_slutskat_blandet_kategorier_foedes_til_aarsberegningen
? fraflytter_slutskat_blandet_bruger_kanonisk_marginaldelta
? fraflytter_slutskat_kun_realisationsposter_giver_henstand
? fraflytter_slutskat_ikke_positiv_netto_giver_ingen_skat
? fraflytter_slutskat_flere_kilder_teleskoperer_i_kildelisteorden
? fraflytter_slutskat_ægtefællemodregning_scenarier_består
? fraflytter_slutskat_ejendomsskatteprojektion_er_rolleuafhængig
? fraflytter_slutskat_fremførselsprojektion_er_rolleuafhængig

@ print("ABL § 38 kanonisk blandet fraflytterskat: " + vis(fraflytter_slutskat_blandet.samlet_skat_inkl_endelig_aktieindkomstskat_kroner - fraflytter_slutskat_basis.samlet_skat_inkl_endelig_aktieindkomstskat_kroner))
