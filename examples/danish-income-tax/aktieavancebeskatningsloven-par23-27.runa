--@label:aktieavancebeskatningsloven_rettigheder_mtf_overgang::meta:aktieavancebeskatningsloven_rettigheder_mtf_overgang_metadata--
----
LOV nr. 1563 af 12/12/2023, § 2, nr. 12. I § 24, stk. 2, indsættes efter
»reguleret marked«: »eller en multilateral handelsfacilitet«.

14. I § 25, stk. 1, indsættes efter »reguleret marked«: »eller en multilateral
handelsfacilitet«.

§ 8, stk. 6. § 2, nr. 12 og 14, har ikke virkning for aktieretter og
tegningsretter til aktier optaget til handel på en multilateral
handelsfacilitet, der er erhvervet før den 1. januar 2024.
For sådanne aktieretter og tegningsretter til aktier finder de hidtil gældende
regler anvendelse.
----

--@begin:aktieavancebeskatningsloven_rettigheder_mtf_overgang--
# AktieavanceRettighedsOpgørelsesregime = AblRettighedUdenforAktieavancebeskatningsloven | AblRettighedEfterLagerprincippet | AblRettighedEfterPar25AktieForAktie | AblTegningsretEfterPar26Stk4SomAktie | AblAktieretEfterPar26Gennemsnitsmetode
# AktieavanceRettighedsOpgørelsesresultat(rettighed: AktieavancePar25Rettighed, beskatningsprincip: AktieavancePar25Beskatningsprincip, erhvervelsesår: Heltal, regime: AktieavanceRettighedsOpgørelsesregime, mtf_overgang_før_2024_finder_anvendelse: Boolsk)

# AktieavanceRettighedsOpgørelsesSag(rettighed: AktieavancePar25Rettighed, beskatningsprincip: AktieavancePar25Beskatningsprincip, erhvervelsesår: Heltal) {
    | omfattet_af_abl() -> aktieavance_rettighed_omfattet_af_abl(rettighed.lovregime)
    | lagerprincip() -> beskatningsprincip == AblPar25Lagerprincip
    | par25_finder_anvendelse() -> aktieavance_par25_finder_anvendelse(rettighed, beskatningsprincip, erhvervelsesår)
    | mtf_overgang_før_2024_finder_anvendelse() -> omfattet_af_abl() && rettighed.underliggende_aktiers_markedsstatus == AblOptagetTilHandelPåMultilateralHandelsfacilitet && erhvervelsesår > 0 && erhvervelsesår < 2024
    | regime() -> AblRettighedUdenforAktieavancebeskatningsloven
    | exception abl_rettighed_lagerprincip regime() -> AblRettighedEfterLagerprincippet under omfattet_af_abl() && lagerprincip()
    | exception abl_rettighed_par25_aktie_for_aktie regime() -> AblRettighedEfterPar25AktieForAktie under par25_finder_anvendelse()
    | exception abl_tegningsret_udenfor_par25_par26_stk4 regime() -> AblTegningsretEfterPar26Stk4SomAktie under omfattet_af_abl() && lagerprincip() == Falskt && par25_finder_anvendelse() == Falskt && rettighed.art == AblPar25Tegningsret
    | exception abl_aktieret_udenfor_par25_gennemsnitsmetode regime() -> AblAktieretEfterPar26Gennemsnitsmetode under omfattet_af_abl() && lagerprincip() == Falskt && par25_finder_anvendelse() == Falskt && rettighed.art == AblPar25Aktieret
    | resultat() -> AktieavanceRettighedsOpgørelsesresultat(
        rettighed = rettighed,
        beskatningsprincip = beskatningsprincip,
        erhvervelsesår = erhvervelsesår,
        regime = regime(),
        mtf_overgang_før_2024_finder_anvendelse = mtf_overgang_før_2024_finder_anvendelse()
    )
}

| aktieavance_rettigheds_opgørelsesresultat(rettighed: AktieavancePar25Rettighed, beskatningsprincip: AktieavancePar25Beskatningsprincip, erhvervelsesår: Heltal) -> AktieavanceRettighedsOpgørelsesSag(rettighed, beskatningsprincip, erhvervelsesår).resultat()
--@end:aktieavancebeskatningsloven_rettigheder_mtf_overgang--

= aktieavancebeskatningsloven_par26_resterende_grene_metadata = Metadata(
    attachments = (
        Source(value = aktieavancebeskatningsloven_lbk1098_par23_til_par26),
        Warning(value = aktieavance_par23_til_par26_afhængighedsgrænse),
    )
)

--@label:aktieavancebeskatningsloven_par26_resterende_grene::meta:aktieavancebeskatningsloven_par26_resterende_grene_metadata--
----
§ 26. Gevinst og tab ved afståelse af aktier opgøres efter reglerne i stk. 2-6,
jf. dog § 23, stk. 2, 4, 5, 8 og 9, og § 23 A, 1. pkt., om lagerprincippet.

Stk. 2. Gevinst og tab opgøres som forskellen mellem afståelsessummen og
anskaffelsessummen for de pågældende aktier. Ved anskaffelsessummen forstås den
samlede anskaffelsessum for den beholdning af aktier, som den skattepligtige
har i det pågældende selskab, uanset om de har forskellige rettigheder.
Anskaffelsessummen for andele i et medarbejderinvesteringsselskab, hvor
indbetalingen har været omfattet af ligningslovens § 7 N, sættes til nul.
Afstår et selskab aktier til en kurs under handelsværdien, og kan selskabet
fradrage forskellen mellem aktiernes handelsværdi og afståelsessummen efter
statsskattelovens § 6, stk. 1, litra a, skal aktierne ved opgørelsen efter 1.
pkt. anses for afstået til aktiernes handelsværdi på afståelsestidspunktet.

Stk. 3. Aktieretter og tegningsretter til aktier, der er omfattet af § 25, skal
ikke medregnes ved opgørelser efter stk. 2 og 5, og der skal ikke foretages en
opgørelse efter stk. 2 og 5 ved afståelse af sådanne retter. Tilsvarende gælder
for aktier, som indgår i en beholdning omfattet af § 44, og tegningsretter til
aktier omfattet af § 16, stk. 1, hvor der er tale om tegningsretter til aktier,
der hverken er optaget til handel på et reguleret marked eller en multilateral
handelsfacilitet. Tegningsretter som nævnt i 2. pkt. er ikke omfattet af
reglerne i stk. 4.

Stk. 4. Tegningsretter til aktier, der ikke er omfattet af § 25, betragtes som
aktier. Tegningsretter anses for erhvervet for et beløb opgjort som summen af
købesummen for tegningsretten og det beløb, der skal betales ved tegningen.
Tegningsretter anses for afstået for et beløb opgjort som summen af
salgssummen for tegningsretten og det beløb, der skal betales ved tegningen.

Stk. 5. Afstår en skattepligtig en del af sine aktier i et selskab m.v.,
fordeles anskaffelsessummen for hele aktiebeholdningen i det pågældende selskab
m.v. forholdsmæssigt imellem de afståede aktier og de aktier, som den
skattepligtige beholder. Dette gælder også i tilfælde, hvor afståelsen ikke
udløser beskatning. Hvis aktierne har en pålydende værdi, foretages fordelingen
på grundlag af denne værdi. Den pålydende værdi af konvertible obligationer
opgøres som den pålydende værdi af den aktie, obligationen kan konverteres til.
For hovedaktionæraktier, jf. § 4, foretages fordelingen dog på grundlag af
handelsværdien af de enkelte aktier på afståelsestidspunktet. Den del af den
samlede anskaffelsessum, der ved fordelingen henføres til de afståede aktier,
lægges til grund ved opgørelsen af gevinst eller tab ved afståelsen. Resten af
den samlede anskaffelsessum betragtes som anskaffelsessum for de i behold
værende aktier og skal ved senere afståelser af en del af aktierne fordeles
efter foranstående regler.

Stk. 6. Ved opgørelse af gevinst på andele, hvor indbetalingen har været
omfattet af ligningslovens § 7 N, ses bort fra andele, hvor indbetalingen ikke
har været omfattet af ligningslovens § 7 N. Ved opgørelse af gevinst og tab på
andele, hvor indbetalingen ikke har været omfattet af ligningslovens § 7 N, ses
bort fra andele, hvor indbetalingen har været omfattet af ligningslovens § 7 N.
----

--@begin:aktieavancebeskatningsloven_par26_resterende_grene--
# AktieavancePar26Stk2Andelsstatus = AblMedarbejderinvesteringsandelMedIndbetalingEfterLl7N | AblAndenAndel
# AktieavancePar26Stk2Sælgerstatus = AblAndenSælger | AblSelskabUdenFradragEfterStatsskattelovPar6 | AblSelskabMedFradragEfterStatsskattelovPar6
# AktieavancePar26Stk2Afståelsesprisinput(faktisk_afståelsessum_kroner: Heltal, handelsværdi_kroner: Heltal, sælgerstatus: AktieavancePar26Stk2Sælgerstatus)

| aktieavance_par26_stk2_anskaffelsessum_kroner(faktisk_anskaffelsessum_kroner: Heltal, status: AktieavancePar26Stk2Andelsstatus) -> hvis status == AblMedarbejderinvesteringsandelMedIndbetalingEfterLl7N { 0 } ellers { faktisk_anskaffelsessum_kroner }
| aktieavance_par26_stk2_afståelsessum_kroner(input: AktieavancePar26Stk2Afståelsesprisinput) -> input.faktisk_afståelsessum_kroner
| exception abl_par26_stk2_selskab_med_fradrag_til_handelsværdi aktieavance_par26_stk2_afståelsessum_kroner(input: AktieavancePar26Stk2Afståelsesprisinput) -> input.handelsværdi_kroner under input.sælgerstatus == AblSelskabMedFradragEfterStatsskattelovPar6 && input.handelsværdi_kroner > input.faktisk_afståelsessum_kroner
| aktieavance_par26_stk2_anskaffelseshændelse(kapitalmængde: AktieavanceOrdinærKapitalmængde, faktisk_anskaffelsessum_kroner: Heltal, status: AktieavancePar26Stk2Andelsstatus) -> AblOrdinærAnskaffelse(
    kapitalmængde = kapitalmængde,
    anskaffelsessum_kroner = aktieavance_par26_stk2_anskaffelsessum_kroner(faktisk_anskaffelsessum_kroner, status)
)
| aktieavance_par26_stk2_afståelseshændelse(kapitalmængde: AktieavanceOrdinærKapitalmængde, prisinput: AktieavancePar26Stk2Afståelsesprisinput, vilkår: AktieavanceOrdinærAfståelsesvilkår, par5a_kildefakta: AktieavanceOrdinærPar5AKildefakta) -> AblOrdinærAfståelse(
    kapitalmængde = kapitalmængde,
    afståelsessum_kroner = aktieavance_par26_stk2_afståelsessum_kroner(prisinput),
    vilkår = vilkår,
    par5a_kildefakta = par5a_kildefakta
)

# AktieavancePar26Stk6Beholdningsgruppe = AblBeholdningMedIndbetalingEfterLl7N | AblBeholdningUdenIndbetalingEfterLl7N
# AktieavancePar26Stk6Beholdning(ll7n_position: AktieavanceOrdinærPosition, anden_position: AktieavanceOrdinærPosition)
# AktieavancePar26Stk6Hændelse(gruppe: AktieavancePar26Stk6Beholdningsgruppe, hændelse: AktieavanceOrdinærHændelse)
# AktieavancePar26Stk6Hændelsesresultat(beholdning_før: AktieavancePar26Stk6Beholdning, hændelse: AktieavancePar26Stk6Hændelse, beholdning_gyldig: Boolsk, hændelse_gyldig: Boolsk, valgt_hændelsesresultat: AktieavanceOrdinærHændelsesresultat, beholdning_efter: AktieavancePar26Stk6Beholdning, skattepost: AktieavanceSkattepost)

| aktieavance_par26_stk6_valgt_position(beholdning: AktieavancePar26Stk6Beholdning, gruppe: AktieavancePar26Stk6Beholdningsgruppe) -> hvis gruppe == AblBeholdningMedIndbetalingEfterLl7N { beholdning.ll7n_position } ellers { beholdning.anden_position }
| aktieavance_par26_stk6_anskaffelse_har_nul_basis(hændelse: AktieavanceOrdinærHændelse) -> match hændelse { | AblOrdinærAnskaffelse(_, anskaffelsessum) -> anskaffelsessum == 0 | _ -> Sandt }

# AktieavancePar26Stk6HændelsesSag(beholdning: AktieavancePar26Stk6Beholdning, hændelse: AktieavancePar26Stk6Hændelse) {
    | beholdning_gyldig() -> aktieavance_ordinaer_position_gyldig(beholdning.ll7n_position) && aktieavance_ordinaer_position_gyldig(beholdning.anden_position) && beholdning.ll7n_position.selskabsidentifikation == beholdning.anden_position.selskabsidentifikation
    | hændelse_passer_til_gruppe() -> hændelse.gruppe == AblBeholdningUdenIndbetalingEfterLl7N || aktieavance_par26_stk6_anskaffelse_har_nul_basis(hændelse.hændelse)
    | valgt_hændelsesresultat() -> aktieavance_ordinaer_hændelsesresultat(aktieavance_par26_stk6_valgt_position(beholdning, hændelse.gruppe), hændelse.hændelse)
    | hændelse_gyldig() -> beholdning_gyldig() && hændelse_passer_til_gruppe() && valgt_hændelsesresultat().hændelse_gyldig
    | beholdning_efter() -> beholdning
    | exception abl_par26_stk6_ll7n_beholdning_opdateres beholdning_efter() -> AktieavancePar26Stk6Beholdning(
        ll7n_position = valgt_hændelsesresultat().position_efter,
        anden_position = beholdning.anden_position
    ) under hændelse_gyldig() && hændelse.gruppe == AblBeholdningMedIndbetalingEfterLl7N
    | exception abl_par26_stk6_anden_beholdning_opdateres beholdning_efter() -> AktieavancePar26Stk6Beholdning(
        ll7n_position = beholdning.ll7n_position,
        anden_position = valgt_hændelsesresultat().position_efter
    ) under hændelse_gyldig() && hændelse.gruppe == AblBeholdningUdenIndbetalingEfterLl7N
    | resultat() -> AktieavancePar26Stk6Hændelsesresultat(
        beholdning_før = beholdning,
        hændelse = hændelse,
        beholdning_gyldig = beholdning_gyldig(),
        hændelse_gyldig = hændelse_gyldig(),
        valgt_hændelsesresultat = valgt_hændelsesresultat(),
        beholdning_efter = beholdning_efter(),
        skattepost = aktieavance_skattepost_fra_ordinaert_hændelsesresultat(valgt_hændelsesresultat())
    )
}

| aktieavance_par26_stk6_hændelsesresultat(beholdning: AktieavancePar26Stk6Beholdning, hændelse: AktieavancePar26Stk6Hændelse) -> AktieavancePar26Stk6HændelsesSag(beholdning, hændelse).resultat()
--@end:aktieavancebeskatningsloven_par26_resterende_grene--
