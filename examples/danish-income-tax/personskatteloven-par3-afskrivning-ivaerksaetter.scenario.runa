    anskaffelsessum_kroner = 35000,
    samlet_anskaffelsessum_for_funktionsenhed_kroner = 35000,
    fysisk_levetid_år = 2,
    anvendes_til_forsøgs_og_forskningsvirksomhed = Falskt,
    anvendes_til_råstofefterforskning = Falskt,
    forskningsudgifter_omfattet_af_loftet_før_dette_aktiv_kroner = 0,
