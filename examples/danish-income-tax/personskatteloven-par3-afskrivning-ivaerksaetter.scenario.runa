@ sprog da

@ importer ./kapitel - 01 - indkomst

-- Scenarier for Afskrivningsloven §§ 1-2, 5, 5 A og 6, stk. 1,
-- Statsskatteloven § 6, litra a, Etableringskontoloven §§ 1-4 og
-- Personskatteloven § 3, stk. 2, nr. 10-11.
-- Lovtekst og kildeankre ligger i de importerede lovmoduler.

= al_2026_parametre = afskrivningslov_årsparametre(2026)

= etbl_gyldig_kontantplacering = EtableringskontoPar4Placering(
    placering = EtblSærligIndlånskonto,
    pengeinstitut_omfattet_af_par4_stk1 = Sandt,
    etableringskonto_og_iværksætterkonto_ført_særskilt = Sandt,
    konto_korrekt_betegnet = Sandt,
    navn_adresse_og_personnummer_påført = Sandt,
    kontantkonto_og_depot_i_samme_pengeinstitut = Sandt
)

= etbl_ugyldig_placering = EtableringskontoPar4Placering(
    placering = EtblIkkeGodkendtPlacering,
    pengeinstitut_omfattet_af_par4_stk1 = Falskt,
    etableringskonto_og_iværksætterkonto_ført_særskilt = Falskt,
    konto_korrekt_betegnet = Falskt,
    navn_adresse_og_personnummer_påført = Falskt,
    kontantkonto_og_depot_i_samme_pengeinstitut = Falskt
)

= al_selvstændig_maskine = afskrivningslov_par1_par2_resultat(AfskrivningslovPar1Par2Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    aktivart = AlMaskine,
    erhvervsmæssig_anvendelsesandel_basispoint = 10000
))

= al_selvstændig_software = afskrivningslov_par1_par2_resultat(AfskrivningslovPar1Par2Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    aktivart = AlSoftware,
    erhvervsmæssig_anvendelsesandel_basispoint = 10000
))

= al_selvstændig_skib = afskrivningslov_par1_par2_resultat(AfskrivningslovPar1Par2Input(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    aktivart = AlSkib,
    erhvervsmæssig_anvendelsesandel_basispoint = 10000
))

= al_selskab_maskine = afskrivningslov_par1_par2_resultat(AfskrivningslovPar1Par2Input(
    skatteyder = AlSelskabEllerForening,
    aktivart = AlMaskine,
    erhvervsmæssig_anvendelsesandel_basispoint = 10000
))

= al5_ordinær_selvstændig = afskrivningslov5_resultat(Afskrivningslov5Input(
    indkomstår = 2026,
    aktiv_resultat = al_selvstændig_maskine,
    saldoordning = AlPar5AlmindeligSaldo,
    saldoværdi_primo_kroner = 100000,
    anskaffelsessummer_i_året_kroner = 40000,
    forbedringsudgifter_i_året_kroner = 10000,
    salgssummer_i_året_kroner = 20000,
    valg = Al5OrdinærAfskrivning(sats_basispoint = 2500)
), al_2026_parametre)

= al5_ordinær_selskab = afskrivningslov5_resultat(Afskrivningslov5Input(
    indkomstår = 2026,
    aktiv_resultat = al_selskab_maskine,
    saldoordning = AlPar5AlmindeligSaldo,
    saldoværdi_primo_kroner = 100000,
    anskaffelsessummer_i_året_kroner = 40000,
    forbedringsudgifter_i_året_kroner = 10000,
    salgssummer_i_året_kroner = 20000,
    valg = Al5OrdinærAfskrivning(sats_basispoint = 2500)
), al_2026_parametre)

= al5_fuld_småsaldo = afskrivningslov5_resultat(Afskrivningslov5Input(
    indkomstår = 2026,
    aktiv_resultat = al_selvstændig_maskine,
    saldoordning = AlPar5AlmindeligSaldo,
    saldoværdi_primo_kroner = 36000,
    anskaffelsessummer_i_året_kroner = 0,
    forbedringsudgifter_i_året_kroner = 0,
    salgssummer_i_året_kroner = 0,
    valg = Al5FuldRestsaldo
), al_2026_parametre)

= al5_fuld_over_småsaldogrænsen = afskrivningslov5_resultat(Afskrivningslov5Input(
    indkomstår = 2026,
    aktiv_resultat = al_selvstændig_maskine,
    saldoordning = AlPar5AlmindeligSaldo,
    saldoværdi_primo_kroner = 36001,
    anskaffelsessummer_i_året_kroner = 0,
    forbedringsudgifter_i_året_kroner = 0,
    salgssummer_i_året_kroner = 0,
