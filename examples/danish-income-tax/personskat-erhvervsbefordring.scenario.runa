= personskat_erhvervsbefordring_scenarier_metadata = Metadata(
    attachments = (
        MetaAttachment(role = Source, value = ligningsloven_lbk1500_par9b),
        MetaAttachment(role = Source, value = personskatteloven_lbk1284_par3),
        MetaAttachment(role = Source, value = skatteraadet_bek1333_par4_par14),
        MetaAttachment(role = Guidance, value = ligningsloven_juridisk_vejledning_par9b_godtgørelse),
        MetaAttachment(role = Guidance, value = ligningsloven_juridisk_vejledning_par9b_flere_arbejdsgivere),
        MetaAttachment(role = DependencySource, value = arbejdsmarkedsbidragsloven_2020_121),
    )
)

--@label:personskat_erhvervsbefordring_scenarier::meta:personskat_erhvervsbefordring_scenarier_metadata--
----
Scenarierne er ikke lovtekst. De fastholder den kanoniske beregningskæde fra
flere identificerede kørsels- og godtgørelsessager gennem ligningslovens § 9 B
og personskattelovens § 3, stk. 2, nr. 8 til den samlede
lønmodtagerberegning. Sagerne står i indkomstårets kronologiske rækkefølge;
tidligere kilometer udledes af forløbet og er ikke kildefakta.
----

| personskat_erhvervsbefordring_tres_dages_forhold() -> Ligningslov9B60DagesForhold(
    arbejdsdage_til_samme_arbejdsplads_inklusive_aktuel_dag_i_forudgående_12_måneder = 0,
    sammenhængende_arbejdsdage_siden_sidst_på_arbejdspladsen = 0,
    mange_forskellige_arbejdspladser = Falskt,
    ikke_sandsynligt_over_60_dage = Falskt,
    skriftligt_kørselsregnskabspålæg_aktivt = Falskt,
    kørselsregnskab_dokumenterer_erhvervsmæssig_befordring = Falskt
)
| personskat_erhvervsbefordring_godtgørelse(udbetalt_kroner: Heltal, overskud_som_løn: Boolsk, medregnes_i_indkomsten: Boolsk) -> Ligningslov9BGodtgørelsesforhold(
    udbetalt_godtgørelse_kroner = udbetalt_kroner,
    form = Ll9BKilometerafregnet,
    arbejdsgiver_har_kontrolleret_kilometer = Sandt,
    bogføringsbilag_opfylder_par6 = Sandt,
    modregnet_i_forud_aftalt_bruttoløn = Falskt,
    firmabil_stillet_til_rådighed = Falskt,
    dokumenteret_kørsel_i_eget_køretøj = Sandt,
    fuldt_vederlag_betalt_for_firmabilskørsel_for_anden_arbejdsgiver = Falskt,
    overskydende_beløb_behandlet_som_løn_ved_endelig_opgørelse = overskud_som_løn,
    eventuel_godtgørelse_valgt_medregnet_i_indkomsten = medregnes_i_indkomsten
)
| personskat_erhvervsbefordring_fakta(identifikation: Tekst, rækkefølge: Heltal, arbejdsgiver: Tekst, køretøj: Ligningslov9BKøretøj, kilometer: Heltal, udbetalt_godtgørelse_kroner: Heltal, kundeopsøgende: Boolsk, antal_arbejdsgivere: Heltal) -> PersonskatErhvervsbefordringFakta(
    identifikation = identifikation,
    rækkefølge_i_indkomståret = rækkefølge,
    godtgørende_arbejdsgiver_identifikation = arbejdsgiver,
    køretøj = køretøj,
    befordring = PersonskatErhvervsbefordring(
        art = Ll9BMellemArbejdspladser,
        kilometer_i_sagen = kilometer,
        tres_dages_forhold = personskat_erhvervsbefordring_tres_dages_forhold()
    ),
    udgifter = Ligningslov9BUdgifter(
        har_afholdt_befordringsudgifter = Sandt,
        dokumenterede_faktiske_kørselsudgifter_eksklusive_bro_tunnel_kroner = 4000,
        dokumenterede_bro_tunnel_udgifter_kroner = 500
    ),
    kundeopsøgende_aktivitet = kundeopsøgende,
    antal_arbejdsgivere_som_befordringen_vedrører_på_en_gang = antal_arbejdsgivere,
    godtgørelsesforhold = personskat_erhvervsbefordring_godtgørelse(
        udbetalt_kroner = udbetalt_godtgørelse_kroner,
        overskud_som_løn = Sandt,
        medregnes_i_indkomsten = Falskt
    )
)
| personskat_erhvervsbefordring_input(skatteår: Heltal, sager: List(PersonskatErhvervsbefordringFakta)) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = skatteår,
        kommune = København,
        bruttoløn_kroner = 600000,
        erhvervsbefordring = PersonskatErhvervsbefordringInput(sager = sager),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_erhvervsbefordring_beregn(skatteår: Heltal, sager: List(PersonskatErhvervsbefordringFakta)) -> beregn_personskat(personskat_erhvervsbefordring_input(skatteår, sager))

