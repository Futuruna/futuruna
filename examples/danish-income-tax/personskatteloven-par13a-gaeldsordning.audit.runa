@ sprog da

@ importer ./kapitel - 03 - personfradrag

-- Focused validation for Personskatteloven § 13 a debt-settlement reduction.
-- Source: Retsinformation, LBK nr. 1284 af 14/06/2021.
-- https://www.retsinformation.dk/eli/lta/2021/1284

----
§ 13 a. Opnår en person i et indkomstår en tvangsakkord i en rekonstruktion
eller en gældssanering, nedsættes uudnyttede, fradragsberettigede underskud og
dernæst uudnyttede, fradragsberettigede tab, der kan fremføres efter reglerne i
aktieavancebeskatningslovens § 13 A, stk. 2 og 3, kursgevinstlovens § 32,
stk. 3, og ejendomsavancebeskatningslovens § 6, stk. 3, fra det pågældende og
tidligere indkomstår med det beløb, hvormed gælden er nedsat.
Nedsættelsesbeløbet formindskes med den del af skyldnerens indkomst, der
hidrører fra hans frigørelse for gældsforpligtelser.
Nedsættelsen af underskud
sker med virkning for det indkomstår, hvori rekonstruktionsforslaget med
tvangsakkorden stadfæstes eller kendelse om gældssanering afsiges, og for
senere indkomstår.

Stk. 2. I det omfang det beløb, hvormed underskuddet skal nedsættes efter
stk. 1, ikke er blevet anvendt til nedsættelse af underskud hos skyldneren,
skal det bruges til at nedsætte underskud efter reglerne i stk. 1 vedrørende
skyldnerens virksomhed hos den samlevende ægtefælle, hvis denne driver den
pågældende virksomhed.

Stk. 3. Ved opgørelsen af virksomhedens underskud hos skyldnerens ægtefælle
nedsættes ægtefællens indtægter, der ikke vedrører virksomheden, med
ægtefællens udgifter, der ikke vedrører virksomheden.

Stk. 4. Nedsættelsesbeløbet efter stk. 1, 1.-3. pkt., nedsætter uudnyttet
negativ skat af aktieindkomst fra det indkomstår, hvori tvangsakkord i en
rekonstruktion eller gældssanering opnås, eller fra tidligere indkomstår. Ved
nedsættelse af negativ skat af aktieindkomst modregnes nedsættelsesbeløbet med
en skatteværdi på 40 pct. Nedsættelsen sker med virkning for det indkomstår,
hvori rekonstruktionsforslaget med tvangsakkorden stadfæstes eller kendelse om
gældssanering afsiges, og for senere indkomstår. Hvis der er et uudnyttet
fradragsberettiget underskud og en uudnyttet negativ skat af aktieindkomst,
bruges nedsættelsesbeløbet til at nedsætte underskuddet før negativ skat af
aktieindkomst, således at den negative skat af aktieindkomst kun nedsættes, i
det omfang nedsættelsesbeløbet overstiger underskuddet. Ved anvendelse af
stk. 2 nedsættes både underskud og negativ skat af aktieindkomst hos
skyldneren, inden nedsættelsesbeløbet bruges til at nedsætte underskud hos
ægtefællen.

Stk. 5. Reglerne i stk. 1-4 finder tilsvarende anvendelse på aftaler om en
samlet ordning mellem en skyldner og dennes kreditorer om bortfald eller
nedsættelse af skyldnerens gæld (frivillig akkord).
----

| par13a_audit_tomt_abl_modregningsgrundlag() -> AktieavanceOrdinærPar13AModregningsgrundlag(
    udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
    udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
    udbytter_for_aktier_omfattet_af_par44_kroner = 0,
    ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
)
| par13a_audit_abl_fremført_tab(indkomstår: Heltal, tab_kroner: Heltal) -> aktieavance_ordinaer_årsresultat(AktieavanceOrdinærÅrsinput(
    indkomstår = indkomstår,
    skatteposter = [],
    fremført_tab_efter_par13a_kroner = tab_kroner,
    modregningsgrundlag = par13a_audit_tomt_abl_modregningsgrundlag(),
    gift_og_samlevende_ved_årets_udgang = Falskt
))
| par13a_audit_kgl_tabspost(indkomstår: Heltal, tab_kroner: Heltal) -> KursgevinstPar32Kontraktpost(
    resultat = kursgevinstlov_resultat(KursgevinstlovInput(
        indkomstår = indkomstår,
        rolle = KglPersonEfterKildeskatteloven,
        aktiv = KglFinansielKontrakt,
        par1_afgrænsning = KglPar1Omfattet,
        bagatelgrundlag = kgl_tom_bagatelgrundlag(),
        fordring = kgl_tom_fordring(),
        gæld = kgl_tom_gæld(),
        kontrakt = KursgevinstlovKontraktOpgørelse(
            kontrakt_art = KglKontraktOmfattetPar29,
            værdi_primo_kroner = 0,
            værdi_ultimo_kroner = 0,
            anskaffelsessum_kroner = tab_kroner,
            afståelsesværdi_kroner = 0,
            anskaffet_i_indkomståret = Sandt,
            realiseret_i_indkomståret = Sandt
        ),
        udøver_fordrings_eller_kontraktnæring = Falskt,
        driver_finansieringsnæring = Falskt,
        fordring_erhvervet_udenfor_næring = Falskt,
        gæld_vedrører_finansieringsnæring = Falskt,
        anvender_lagerprincip_efter_par25 = Falskt
    )),
    relation = KglPar32AlmindeligKontrakt,
    aktiegrundlag = KglPar32IkkeAktiebaseret
)
| par13a_audit_kgl_person(indkomstår: Heltal, identifikation: Tekst, kontrakter: List(KursgevinstPar32Kontraktpost)) -> KursgevinstPar32PersonÅrsinput(
    identifikation = identifikation,
    indkomstår = indkomstår,
    kontrakter = kontrakter,
    aktieårsgrundlag = kgl_par32_tomt_aktieårsgrundlag(indkomstår),
    fremførsel = KglPar32IngenFremførsel,
    tabsprioritet = KglPar32AlmindeligeTabFørst,
    fast_ejendomstabsprioritet = KglPar32SælgertabFørst,
    aktiemodregningsvalg = kgl_par32_ingen_aktiemodregning()
)
| par13a_audit_kgl_fremført_tab(indkomstår: Heltal, tab_kroner: Heltal) -> kursgevinst_par32_ægtefællepar_resultat(KursgevinstPar32ÆgtefælleparInput(
    venstre = par13a_audit_kgl_person(indkomstår, "skyldner", [par13a_audit_kgl_tabspost(indkomstår, tab_kroner)]),
    højre = par13a_audit_kgl_person(indkomstår, "ægtefælle", []),
    gift_og_samlevende_ved_indkomstårets_udgang = Falskt
)).venstre
| par13a_audit_ebl_tab(indkomstår: Heltal, tab_kroner: Heltal) -> ejendomsavancebeskatningslov_resultat(EjendomsavancebeskatningslovInput(
    indkomstår = indkomstår,
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = tab_kroner,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    regulering_efter_par5_og_5a_kroner = 0,
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = 0,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    par11_stk2_genanbragt_erhvervsejendom = Falskt
))
| par13a_audit_ebl_fremført_tab(indkomstår: Heltal, tab_kroner: Heltal) -> ejendomsavance_par6_tabsårsresultat(EjendomsavancePar6Tabsårsinput(
    indkomstår = indkomstår,
    tabsposter = [EjendomsavancePar6Tabspost(
        resultat = par13a_audit_ebl_tab(indkomstår, tab_kroner),
        ejendomsafgrænsning = EblPar6AlmindeligEjendom,
        anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag
    )],
    fortjenester = [],
    fremførsel = EblIngenFremførsel,
    ægtefælles_fortjenester = [],
    gift_samlevende_ved_indkomstårets_udgang = Falskt
))

= par13a_abl_tab_2024 = par13a_audit_abl_fremført_tab(2024, 10000)
= par13a_kgl_tab_2025 = par13a_audit_kgl_fremført_tab(2025, 10000)
= par13a_ebl_tab_2026 = par13a_audit_ebl_fremført_tab(2026, 10000)
= par13a_abl_fremtidigt_tab_2027 = par13a_audit_abl_fremført_tab(2027, 7000)
= par13a_tabsposter = [
    Par13aAktieavanceTab(resultat = par13a_abl_tab_2024),
    Par13aKursgevinstTab(resultat = par13a_kgl_tab_2025),
    Par13aEjendomsavanceTab(resultat = par13a_ebl_tab_2026),
    Par13aAktieavanceTab(resultat = par13a_abl_fremtidigt_tab_2027)
]
= par13a_tabsposter_2026 = par13a_fremførbare_tab_resultat(Par13aFremførbareTabInput(
    indkomstår = 2026,
    poster = par13a_tabsposter
))

= par13a_tvangsakkord_probe = par13a_nedsættelse_resultat(Par13aNedsættelseInput(
    indkomstår = 2026,
    status = TvangsakkordIRekonstruktion,
    gæld_nedsat_kroner = 100000,
    frigørelsesindkomst_kroner = 0,
    skyldner_underskud_kroner = 40000,
    skyldner_fremførbare_tab = par13a_tabsposter,
    skyldner_negativ_aktieskat_kroner = 8000,
    ægtefælle_samlevende_driver_virksomhed = Sandt,
    ægtefælle_virksomhedsunderskud_før_stk3_kroner = 50000,
    ægtefælle_ikke_virksomhedsindtægter_kroner = 10000,
    ægtefælle_ikke_virksomhedsudgifter_kroner = 3000
))

= par13a_frivillig_akkord_probe = par13a_nedsættelse_resultat(Par13aNedsættelseInput(
    indkomstår = 2026,
    status = FrivilligAkkord,
    gæld_nedsat_kroner = 50000,
    frigørelsesindkomst_kroner = 12000,
    skyldner_underskud_kroner = 60000,
    skyldner_fremførbare_tab = [],
    skyldner_negativ_aktieskat_kroner = 0,
    ægtefælle_samlevende_driver_virksomhed = Falskt,
    ægtefælle_virksomhedsunderskud_før_stk3_kroner = 0,
    ægtefælle_ikke_virksomhedsindtægter_kroner = 0,
    ægtefælle_ikke_virksomhedsudgifter_kroner = 0
))

= par13a_ingen_ordning_probe = par13a_nedsættelse_resultat(Par13aNedsættelseInput(
    indkomstår = 2026,
    status = IngenPar13aAkkord,
    gæld_nedsat_kroner = 100000,
    frigørelsesindkomst_kroner = 0,
    skyldner_underskud_kroner = 50000,
    skyldner_fremførbare_tab = par13a_tabsposter,
    skyldner_negativ_aktieskat_kroner = 5000,
    ægtefælle_samlevende_driver_virksomhed = Sandt,
    ægtefælle_virksomhedsunderskud_før_stk3_kroner = 30000,
    ægtefælle_ikke_virksomhedsindtægter_kroner = 0,
    ægtefælle_ikke_virksomhedsudgifter_kroner = 0
))

| par13a_afhængighedslove_leverer_fremførte_tab: par13a_tabsposter_2026 -> par13a_abl_tab_2024.tab_fremført_til_følgende_indkomstår_kroner == 10000 && par13a_kgl_tab_2025.tab_fremført_til_følgende_indkomstår_kroner == 10000 && par13a_ebl_tab_2026.tab_fremført_til_følgende_indkomstår_kroner == 10000
| par13a_samler_kun_tab_fra_nuvaerende_og_tidligere_år: par13a_tabsposter_2026 -> par13a_tabsposter_2026.aktieavancetab_kroner == 10000 && par13a_tabsposter_2026.kursgevinsttab_kroner == 10000 && par13a_tabsposter_2026.ejendomsavancetab_kroner == 10000 && par13a_tabsposter_2026.fremførbare_tab_i_alt_kroner == 30000 && par13a_tabsposter_2026.afvist_fremtidigt_tab_kroner == 7000
| par13a_nedsætter_i_lovbestemt_rækkefølge: par13a_tvangsakkord_probe -> par13a_tvangsakkord_probe.nedsættelsesbeløb_kroner == 100000 && par13a_tvangsakkord_probe.skyldner_underskud_nedsat_kroner == 40000 && par13a_tvangsakkord_probe.skyldner_fremførbare_tab_resultat.fremførbare_tab_i_alt_kroner == 30000 && par13a_tvangsakkord_probe.skyldner_fremførbare_tab_resultat.afvist_fremtidigt_tab_kroner == 7000 && par13a_tvangsakkord_probe.skyldner_tab_nedsat_kroner == 30000 && par13a_tvangsakkord_probe.skyldner_negativ_aktieskat_nedsat_kroner == 8000 && par13a_tvangsakkord_probe.nedsættelsesbeløb_efter_skyldner_kroner == 10000
| par13a_stk2_stk3_nedsætter_ægtefælles_virksomhedsunderskud: par13a_tvangsakkord_probe -> par13a_tvangsakkord_probe.ægtefælle_ikke_virksomhedsnettoindtægt_kroner == 7000 && par13a_tvangsakkord_probe.ægtefælle_virksomhedsunderskud_efter_stk3_kroner == 43000 && par13a_tvangsakkord_probe.ægtefælle_virksomhedsunderskud_nedsat_kroner == 10000 && par13a_tvangsakkord_probe.ægtefælle_virksomhedsunderskud_efter_nedsættelse_kroner == 33000
| par13a_frivillig_akkord_følger_samme_regler: par13a_frivillig_akkord_probe -> par13a_frivillig_akkord_probe.ordning_omfattet == Sandt && par13a_frivillig_akkord_probe.nedsættelsesbeløb_kroner == 38000 && par13a_frivillig_akkord_probe.skyldner_underskud_nedsat_kroner == 38000 && par13a_frivillig_akkord_probe.skyldner_underskud_efter_nedsættelse_kroner == 22000
| par13a_uden_ordning_nedsætter_ikke: par13a_ingen_ordning_probe -> par13a_ingen_ordning_probe.ordning_omfattet == Falskt && par13a_ingen_ordning_probe.nedsættelsesbeløb_kroner == 0 && par13a_ingen_ordning_probe.skyldner_underskud_efter_nedsættelse_kroner == 50000 && par13a_ingen_ordning_probe.ægtefælle_virksomhedsunderskud_nedsat_kroner == 0

? par13a_afhængighedslove_leverer_fremførte_tab
? par13a_samler_kun_tab_fra_nuvaerende_og_tidligere_år
? par13a_nedsætter_i_lovbestemt_rækkefølge
? par13a_stk2_stk3_nedsætter_ægtefælles_virksomhedsunderskud
? par13a_frivillig_akkord_følger_samme_regler
? par13a_uden_ordning_nedsætter_ikke

@ print("§13 a rest efter skyldner før ægtefælle: " + vis(par13a_tvangsakkord_probe.nedsættelsesbeløb_efter_skyldner_kroner))
@ print("§13 a fremførbare tab fra ABL/KGL/EBL: " + vis(par13a_tabsposter_2026.fremførbare_tab_i_alt_kroner))
@ print("§13 a afvist fremtidigt tab: " + vis(par13a_tabsposter_2026.afvist_fremtidigt_tab_kroner))
@ print("§13 a ægtefællevirksomhedsunderskud efter nedsættelse: " + vis(par13a_tvangsakkord_probe.ægtefælle_virksomhedsunderskud_efter_nedsættelse_kroner))
