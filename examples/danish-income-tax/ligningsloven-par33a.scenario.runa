= ll33a_scenarie_covidvalg = ll33a_scenarie_resultat(2020, [
    ll33a_scenarie_privat_forhold(
        "covidvalg",
        ll33a_scenarie_ophold(
            Dato(år = 2020, måned = 1, dag = 1),
            Dato(år = 2020, måned = 9, dag = 30),
            concat(
                ll33a_scenarie_danske_dage(Dato(år = 2020, måned = 1, dag = 10), 42, Ll33AFerieEllerLignende),
                [Ligningslov33ADanskOpholdsdag(dato = Dato(år = 2020, måned = 3, dag = 15), art = Ll33AAndetOpholdIRiget)]
            ),
            Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet,
            Ll33ACovidvalgAnvendt(
                arbejde_genoptaget_i_arbejdslandet_dato = None,
                valgdato = Dato(år = 2021, måned = 4, dag = 30)
            )
        ),
        Ll33AIngenDobbeltbeskatningsoverenskomst,
        ll33a_scenarie_indkomst(120000, 120000, 160000),
        ll33a_scenarie_indkomst(20000, 20000, 20000)
    ),
])

