@ sprog da

@ importer ./ligningsloven - par33a

| ll33a_scenarie_danske_dage(første_dato: Dato, antal: Heltal, art: Ligningslov33ADanskOpholdsart) -> map(
    range(0, antal),
    |forskydning: Heltal| Ligningslov33ADanskOpholdsdag(
        dato = dato_plus_dage(første_dato, forskydning),
        art = art
    )
)
| ll33a_scenarie_indkomst(skattepligtig_kroner: Heltal, personlig_kroner: Heltal, am_grundlag_kroner: Heltal) -> Ligningslov33ALønindkomstEfterDanskeRegler(
    skattepligtig_nettoindkomst_kroner = skattepligtig_kroner,
    personlig_nettoindkomst_kroner = personlig_kroner,
    arbejdsmarkedsbidragsgrundlag_kroner = am_grundlag_kroner
)
| ll33a_scenarie_ophold(fra_dato: Dato, til_dato: Dato, danske_dage: List(Ligningslov33ADanskOpholdsdag), skattepligt: Ligningslov33ASkattepligtsstatus, covidvalg: Ligningslov33ACovidvalg) -> Ligningslov33AOphold(
    fra_dato = fra_dato,
    til_dato = til_dato,
    danske_opholdsdage = danske_dage,
    arbejdsgiverforbindelse = Ll33AUdlandsopholdBegrundetIArbejdsgiverensForhold(dokumentreference = "udstationeringsaftale"),
    tjenesteforhold = Ll33APersonligtArbejdeITjenesteforhold,
    skattepligt = skattepligt,
    covidvalg = covidvalg,
    dokumentreference = "pas-rejsebilag"
)
| ll33a_scenarie_privat_forhold(identifikation: Tekst, ophold: Ligningslov33AOphold, beskatningsret: Ligningslov33ABeskatningsret, samlet_indkomst: Ligningslov33ALønindkomstEfterDanskeRegler, dansk_arbejde: Ligningslov33ALønindkomstEfterDanskeRegler) -> Ligningslov33AAnsættelsesforhold(
    identifikation = identifikation,
    subjekt = Ll33APerson,
    ophold = ophold,
    arbejdsgivergrundlag = Ll33AIkkeDanskOffentligArbejdsgiver,
    beskatningsret = beskatningsret,
    indkomstfordeling = Ligningslov33AIndkomstfordeling(
        samlet_lønindkomst_efter_danske_regler = samlet_indkomst,
        heraf_arbejde_i_riget_efter_danske_regler = dansk_arbejde
    ),
    henstand = Ll33AIngenHenstand
)
| ll33a_scenarie_offentligt_forhold(identifikation: Tekst, ophold: Ligningslov33AOphold, ydelser: Ligningslov33AOffentligYdelsesstatus, lønfastsættelse: Ligningslov33AOffentligLønfastsættelse, systemeksport: Ligningslov33ASystemeksportstatus, beskatningsret: Ligningslov33ABeskatningsret) -> Ligningslov33AAnsættelsesforhold(
    identifikation = identifikation,
    subjekt = Ll33APerson,
    ophold = ophold,
    arbejdsgivergrundlag = Ll33ADanskStatEllerOffentligMyndighed(
        ydelser = ydelser,
        lønfastsættelse = lønfastsættelse,
        systemeksport = systemeksport
    ),
    beskatningsret = beskatningsret,
    indkomstfordeling = Ligningslov33AIndkomstfordeling(
        samlet_lønindkomst_efter_danske_regler = ll33a_scenarie_indkomst(120000, 120000, 160000),
        heraf_arbejde_i_riget_efter_danske_regler = ll33a_scenarie_indkomst(0, 0, 0)
    ),
    henstand = Ll33AIngenHenstand
)
| ll33a_scenarie_skattekreds() -> Ligningslov33PersonDanskSkattekreds(
    komponenter = [
        Ligningslov33DanskSkattekomponent(
            art = Ll33KommunalIndkomstskat,
            beregningsgrundlag = Ll33SkattepligtigIndkomst(samlet_indkomst_kroner = 300000),
            dansk_skat_før_personfradrag_øre = 7500000
        ),
        Ligningslov33DanskSkattekomponent(
            art = Ll33PersonskattelovPar6,
            beregningsgrundlag = Ll33PersonligOgPositivKapitalindkomst(samlet_indkomst_kroner = 300000),
            dansk_skat_før_personfradrag_øre = 3600000
        ),
        Ligningslov33DanskSkattekomponent(
            art = Ll33ArbejdsmarkedsbidragslovPar1,
            beregningsgrundlag = Ll33Arbejdsmarkedsbidragsgrundlag(samlet_indkomst_kroner = 400000),
            dansk_skat_før_personfradrag_øre = 3200000
        ),
    ],
    samlet_dansk_indkomstskat_tilgængelig_øre = 14300000
)
| ll33a_scenarie_resultat(indkomstår: Heltal, forhold: List(Ligningslov33AAnsættelsesforhold)) -> ligningslov33a_årsresultat(
    Ligningslov33AÅrsinput(
        indkomstår = indkomstår,
        ansættelsesforhold = forhold
    ),
    ll33a_scenarie_skattekreds()
)

= ll33a_scenarie_standardophold = ll33a_scenarie_ophold(
    Dato(år = 2025, måned = 1, dag = 10),
    Dato(år = 2025, måned = 7, dag = 9),
    ll33a_scenarie_danske_dage(Dato(år = 2025, måned = 2, dag = 1), 42, Ll33AFerieEllerLignende),
    Ll33ASkattepligtigEfterKildeskattelovensPar1HeleOpholdet,
    Ll33AUdenCovidvalg
)

= ll33a_scenarie_fuld_lempelse = ll33a_scenarie_resultat(2025, [
    ll33a_scenarie_privat_forhold(
        "fuld-lempelse",
        ll33a_scenarie_standardophold,
        Ll33AArbejdslandetHarBeskatningsrettenEfterOverenskomst(dokumentreference = "dba-artikel-15"),
        ll33a_scenarie_indkomst(120000, 120000, 160000),
        ll33a_scenarie_indkomst(0, 0, 0)
    ),
])

= ll33a_scenarie_halv_lempelse = ll33a_scenarie_resultat(2025, [
