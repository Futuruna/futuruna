| ll33a_præcis_seks_måneder_og_42_dage_giver_fuld_lempelse: ll33a_scenarie_fuld_lempelse -> ll33a_scenarie_fuld_lempelse.input_gyldigt && ll33a_scenarie_fuld_lempelse.alle_forhold_lempelsesberettigede && head(ll33a_scenarie_fuld_lempelse.forholdsresultater).højeste_antal_danske_dage_i_afsluttet_seksmånedersperiode == 42 && ll33a_scenarie_fuld_lempelse.samlet_nedslag_øre == 5720000
| ll33a_dansk_beskatningsret_giver_halv_lempelse: ll33a_scenarie_halv_lempelse -> ll33a_scenarie_halv_lempelse.input_gyldigt && head(ll33a_scenarie_halv_lempelse.forholdsresultater).lempelsesandel_basispoint == 5000 && ll33a_scenarie_halv_lempelse.samlet_nedslag_øre == 2860000
| ll33a_arbejde_i_riget_trækkes_fra_lempelsesindkomsten: ll33a_scenarie_dansk_arbejde_udeladt -> ll33a_scenarie_dansk_arbejde_udeladt.input_gyldigt && ll33a_scenarie_dansk_arbejde_udeladt.fuldt_lempelsesberettiget_indkomst.skattepligtig_nettoindkomst_kroner == 100000 && ll33a_scenarie_dansk_arbejde_udeladt.fuldt_lempelsesberettiget_indkomst.arbejdsmarkedsbidragsgrundlag_kroner == 140000 && ll33a_scenarie_dansk_arbejde_udeladt.samlet_nedslag_øre == 4820000
