        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl5Saldo::input::aktivgrundlag::Al5Kapitel2Aktiv::input::skatteyder), label = "Skatteyder i honoraraktiviteten", question = Some("Er dette en fysisk persons honoraraktivitet uden selvstændig virksomhed?"), help = Some("Brug AlAndenFysiskPerson her; virksomheds- og selskabsopgørelser skal ikke flyttes ind i honorargrenen. Se personskat-honorar.md."), unit = None),
