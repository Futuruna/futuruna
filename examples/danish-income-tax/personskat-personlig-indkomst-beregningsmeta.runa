)
= personskat_personlig_indkomst_felt_virksomhedsindtægt_beløb = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indtægter::beløb_kroner),
    label = "Virksomhedsindtægt",
    question = Some("Hvor stort er indtægtspostens beløb?"),
    help = Some("Angiv et ikke-negativt bruttobeløb. Indtægtens skattemæssige art bestemmer den videre regelgren."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_virksomhedsudgift_id = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::udgifter::identifikation),
    label = "Udgiftspostens identifikation",
    question = Some("Hvilken entydig identifikation har udgiftsposten i virksomhedsregnskabet?"),
    help = Some("Identifikationen skal være entydig blandt alle virksomhedens indtægts- og udgiftsposter."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhedsudgift_afgrænsning = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::udgifter::afgrænsning),
    label = "Udgiftens afgrænsning efter PSL § 3, stk. 2, nr. 1",
    question = Some("Hvilken lovbestemt udgiftskategori tilhører posten?"),
    help = Some("Futuruna fradrager kun udgifter til at erhverve, sikre og vedligeholde selvstændig erhvervsindkomst her. Renter, kurstab og andre udtrykkeligt undtagne poster skal til deres egne regler."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhedsudgift_beløb = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::udgifter::beløb_kroner),
    label = "Virksomhedsudgift",
    question = Some("Hvor stort er udgiftspostens beløb?"),
    help = Some("Angiv et ikke-negativt beløb. Fradragsretten afledes af udgiftskategorien."),
    unit = Some("kr./år")
)

= personskat_personlig_indkomst_beregningsmeta = TypetBeregningsmeta(
    felter = [
        personskat_personlig_indkomst_felt_arbejdsgiverydelse_id,
        personskat_personlig_indkomst_felt_arbejdsgiverydelse_år,
        personskat_personlig_indkomst_felt_arbejdsgiverydelse_art,
        personskat_personlig_indkomst_felt_direkte_gruppeliv,
        personskat_personlig_indkomst_felt_pbl19_gruppeliv,
        personskat_personlig_indkomst_felt_naturalie_art,
        personskat_personlig_indkomst_felt_naturalie_værdi,
        personskat_personlig_indkomst_felt_uklassificeret_ydelse_beskrivelse,
        personskat_personlig_indkomst_felt_uklassificeret_ydelse_beløb,
        personskat_personlig_indkomst_felt_virksomhed_id,
        personskat_personlig_indkomst_felt_virksomhed_år,
        personskat_personlig_indkomst_felt_virksomhedsindtægt_id,
        personskat_personlig_indkomst_felt_virksomhedsindtægt_art,
        personskat_personlig_indkomst_felt_virksomhedsindtægt_beløb,
        personskat_personlig_indkomst_felt_virksomhedsudgift_id,
        personskat_personlig_indkomst_felt_virksomhedsudgift_afgrænsning,
        personskat_personlig_indkomst_felt_virksomhedsudgift_beløb
    ],
    spørgsmål = [],
    beløbsfelter = [],
    attachments = (
        Source(value = personskatteloven_lbk1284_par3),
        DependencySource(value = arbejdsmarkedsbidragsloven_lbk121_par2),
        DependencySource(value = arbejdsmarkedsbidragsloven_lbk121_par4),
        DependencySource(value = pensionsbeskatningsloven_lbk1243_par56),
        Guidance(value = skat_gruppeliv_vejledning),
    )
)

