    help = Some("Vælg den præcise retlige type, når kilden dokumenterer den. Brug den afgrænsede PBL § 19/PBL § 56-samlepost, når kilden kun viser det samlede indberettede beløb."),
    unit = None
)
= personskat_personlig_indkomst_felt_direkte_gruppeliv = TypetBeregningsfelt(
