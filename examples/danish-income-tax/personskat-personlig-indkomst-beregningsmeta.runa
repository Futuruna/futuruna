        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::aktiv_input::erhvervsmæssig_anvendelsesandel_basispoint), label = "Andel anvendt i honoraraktiviteten", question = Some("Hvor stor en andel af brugen vedrører denne honoraraktivitet?"), help = Some("Her betyder AL-feltets erhvervsmæssige andel den dokumenterede honorarbrug. Skal matche årets oplyste brugsenheder; ikke også en virksomhedsandel. Se personskat-honorar.md."), unit = Some("basispoint")),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::afskrivningskategori), label = "Almindelig afskrivningskategori", question = Some("Er aktivet et almindeligt driftsmiddel efter AL § 5, stk. 1?"), help = Some("Brug Al11Par5Stk1. Infrastruktur og særlige § 5 C-aktiver behandles ikke i denne honorarrute. Se personskat-honorar.md."), unit = None),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::aktiv_input::aktivart), label = "Driftsmidlets art", question = Some("Hvilken afskrivningsberettiget art har driftsmidlet?"), help = Some("AlMaskine, AlInventar, AlAndetDriftsmiddel eller AlSoftware i denne almindelige rute. Andre arter afvises her, ikke generelt efter loven. Se personskat-honorar.md."), unit = None),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::aktiv_input::skatteyder), label = "Skatteyder i honoraraktiviteten", question = Some("Er dette en fysisk persons honoraraktivitet uden selvstændig virksomhed?"), help = Some("Brug AlAndenFysiskPerson her; virksomheds- og selskabsopgørelser skal ikke flyttes ind i honorargrenen. Se personskat-honorar.md."), unit = None),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::anskaffelsessum_i_året_kroner), label = "Årets anskaffelsessum", question = Some("Hvad er det kildeafklarede beløb for årets anskaffelsessum?"), help = Some("Ikke-negativ skattemæssig værdi i hele kroner før privat brugsandel; ingen dobbelt medregning mellem primo, køb og forbedringer. Se personskat-honorar.md."), unit = Some("kr.")),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::forbedringsudgifter_i_året_kroner), label = "Årets forbedringer", question = Some("Hvad er det kildeafklarede beløb for årets forbedringer?"), help = Some("Ikke-negativ skattemæssig værdi i hele kroner før privat brugsandel; ingen dobbelt medregning mellem primo, køb og forbedringer. Se personskat-honorar.md."), unit = Some("kr.")),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::indkomstår), label = "Afskrivningens år", question = Some("Hvilket indkomstår vedrører opgørelsen?"), help = Some("Skal matche honorarets skatteår. Årsparametre er dækket for 2023–2026. Se personskat-honorar.md."), unit = Some("år")),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::uafskrevet_beløb_primo_kroner), label = "Uafskrevet beløb primo", question = Some("Hvad er det kildeafklarede beløb for uafskrevet beløb primo?"), help = Some("Ikke-negativ skattemæssig værdi i hele kroner før privat brugsandel; ingen dobbelt medregning mellem primo, køb og forbedringer. Se personskat-honorar.md."), unit = Some("kr.")),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::valg::$variant), label = "Afskrivningsvalg", question = Some("Hvilket afskrivningsvalg er faktisk truffet for året?"), help = Some("Ingen, ordinær sats eller fuld restværdi inden for årets grænse. Modellen optimerer ikke valget og ændrer ikke allerede trufne valg. Se personskat-honorar.md."), unit = None),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::valg::Al11OrdinærAfskrivning::sats_basispoint), label = "Valgt afskrivningssats", question = Some("Hvilken ordinær afskrivningssats er valgt?"), help = Some("0–2500 basispoint (0–25 %). For blandet brug beregnes privat andel bagefter, ikke ved at reducere satsen. Se personskat-honorar.md."), unit = Some("basispoint")),
        Beregningsfelt(path = refof(PersonskatHonorarAfskrivningFakta::grundlag::PsHonorarAl11Aktiv::input::årets_benyttelse::erhvervsmæssig_benyttelse_enheder), label = "Årets honorarbrug", question = Some("Hvor mange af årets dokumenterede brugsenheder vedrører honoraraktiviteten?"), help = Some("Samme enhed som samlet brug, fx timer eller kilometer. Større end nul og mindre end samlet brug; gæt ikke en andel. Se personskat-honorar.md."), unit = Some("brugsenheder")),
