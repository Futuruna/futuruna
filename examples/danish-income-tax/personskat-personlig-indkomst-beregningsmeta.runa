@ sprog da

@ importer ./metadata
@ importer ./personskat - personlig - indkomst - kildefakta

= personskat_personlig_indkomst_felt_arbejdsgiverydelse_id = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::identifikation),
    label = "Ydelsens identifikation",
    question = Some("Hvilken entydig identifikation skal denne arbejdsgiverbetalte ydelse have?"),
    help = Some("Brug en stabil identifikation fra lønsedlen, eIndkomst eller pensionsoversigten, så samme ydelse ikke medregnes to gange."),
    unit = None
)
= personskat_personlig_indkomst_felt_arbejdsgiverydelse_år = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::indkomstår),
    label = "Ydelsens indkomstår",
    question = Some("Hvilket indkomstår vedrører ydelsen?"),
    help = Some("Indkomståret skal være det samme som skatteåret i Personskat-beregningen."),
    unit = Some("år")
)
= personskat_personlig_indkomst_felt_arbejdsgiverydelse_art = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::$variant),
    label = "Arbejdsgiverbetalt ydelse",
    question = Some("Hvilken retlig type arbejdsgiverbetalt ydelse fremgår af kildematerialet?"),
    help = Some("Vælg ikke ud fra årsopgørelsens samlelinje alene. Brug lønseddel, eIndkomst eller pensionsoversigt til at afgøre ydelsens type og AM-status."),
    unit = None
)
= personskat_personlig_indkomst_felt_direkte_gruppeliv = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::DirekteArbejdsgiverbetaltGruppeliv::præmie_før_arbejdsmarkedsbidrag_kroner),
    label = "Direkte arbejdsgiverbetalt gruppeliv før AM-bidrag",
    question = Some("Hvor stor gruppelivspræmie betalte arbejdsgiveren direkte før arbejdsmarkedsbidrag?"),
    help = Some("Denne type er A-indkomst og AM-bidragspligtig. Brug kun feltet, når kilden viser direkte betaling til gruppelivsforsikringen."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_pbl19_gruppeliv = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::GruppelivSomUadskiltDelAfPbl19Ordning::personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner),
    label = "Gruppeliv i PBL § 19-ordning efter AM-bidrag",
    question = Some("Hvor stor personlig indkomst er indberettet for gruppeliv, der er en uadskilt del af en arbejdsgiveradministreret pensionsordning?"),
    help = Some("Forsikringsselskabet har allerede indeholdt arbejdsmarkedsbidrag. Beløbet må derfor ikke lægges i et nyt AM-grundlag."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_naturalie_art = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2::art),
    label = "Naturaliets art",
    question = Some("Hvilken naturalietype efter arbejdsmarkedsbidragslovens § 2, stk. 2 har arbejdsgiveren stillet til rådighed?"),
    help = Some("Futuruna bruger den lovbestemte kategori til at afgøre, om den skattepligtige værdi indgår i AM-grundlaget."),
    unit = None
)
= personskat_personlig_indkomst_felt_naturalie_værdi = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2::skattepligtig_værdi_kroner),
    label = "Naturaliets skattepligtige værdi",
    question = Some("Hvad er naturaliets skattepligtige værdi i indkomståret?"),
    help = Some("Angiv den skattemæssigt opgjorte værdi, ikke arbejdsgiverens indkøbspris."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_uklassificeret_ydelse_beskrivelse = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::UklassificeretArbejdsgiverbetaltYdelse::beskrivelse),
    label = "Beskrivelse af uklassificeret ydelse",
    question = Some("Hvordan beskriver kilden den ydelse, som endnu ikke kan klassificeres retligt?"),
    help = Some("En uklassificeret ydelse beregnes ikke. Beskrivelsen gør det muligt at hente den manglende dokumentation uden at bruge et frit nettobeløb."),
    unit = None
)
= personskat_personlig_indkomst_felt_uklassificeret_ydelse_beløb = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::UklassificeretArbejdsgiverbetaltYdelse::beløb_kroner),
    label = "Uklassificeret arbejdsgiverydelse",
    question = Some("Hvilket beløb står i kilden for den endnu uklassificerede ydelse?"),
    help = Some("Beløbet bevares til dokumentation, men påvirker ikke beregningen, før ydelsens retlige art og AM-status er fastlagt."),
    unit = Some("kr./år")
)

= personskat_personlig_indkomst_felt_virksomhed_id = TypetBeregningsfelt(
