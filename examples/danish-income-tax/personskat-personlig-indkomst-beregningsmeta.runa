= personskat_personlig_indkomst_felt_virksomhed_år = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indkomstår),
    label = "Virksomhedens indkomstår",
