= personskat_personlig_indkomst_felt_virksomhedsindtægt_art = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indtægter::art),
    label = "Indtægtspostens skattemæssige art",
    question = Some("Er posten ordinær driftsindtægt, kapitalindkomst, aktieindkomst eller endnu uklassificeret?"),
    help = Some("Kun ordinær driftsindtægt beregnes i denne gren. Kapital- og aktieindkomst skal føres gennem deres egne lovregler."),
