= personskat_ydelsesudbetaling_felt_samling = TypetBeregningsfelt(
    path = refof(PersonskatOrdinærPersonligIndkomstInput::forenings_og_arbejdsløshedsydelser),
    label = "Ydelser fra faglige foreninger og arbejdsløshedsforsikring",
    question = Some("Hvilke erstatninger eller ydelser har personen modtaget fra en faglig forening, A-kasse eller privat arbejdsløshedsforsikring?"),
    help = Some("Opret én række for hver særskilt udbetaling og for hver retligt identificerbar del af en sammensat udbetaling."),
    unit = None
)
= personskat_ydelsesudbetaling_felt_hjemmel = TypetBeregningsfelt(
    path = refof(PersonskatForeningsOgArbejdsløshedsydelseFakta::$variant),
    label = "Udbetalingens lovgren",
    question = Some("Er udbetalingen en medlemsydelse fra en faglig forening efter LL § 13 eller en arbejdsløshedsforsikringsudbetaling efter PBL § 49?"),
    help = Some("Vælg efter den udbetalende ordning og dokumentationen, ikke efter årsopgørelsens samlelinje."),
    unit = None
)

