@ sprog da

@ importer ./metadata
@ importer ./personskat - personlig - indkomst - kildefakta

= personskat_personlig_indkomst_felt_arbejdsgiverydelse_id = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::identifikation),
    label = "Ydelsens identifikation",
    question = Some("Hvilken entydig identifikation skal denne arbejdsgiverbetalte ydelse have?"),
    help = Some("Brug en stabil identifikation fra lønsedlen, eIndkomst eller pensionsoversigten, så samme ydelse ikke medregnes to gange."),
    unit = None
)
= personskat_personlig_indkomst_felt_arbejdsgiverydelse_år = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::indkomstår),
    label = "Ydelsens indkomstår",
    question = Some("Hvilket indkomstår vedrører ydelsen?"),
    help = Some("Indkomståret skal være det samme som skatteåret i Personskat-beregningen."),
    unit = Some("år")
)
= personskat_personlig_indkomst_felt_arbejdsgiverydelse_art = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::$variant),
    label = "Arbejdsgiverbetalt ydelse",
    question = Some("Hvilken retlig type arbejdsgiverbetalt ydelse fremgår af kildematerialet?"),
    help = Some("Vælg ikke ud fra årsopgørelsens samlelinje alene. Brug lønseddel, eIndkomst eller pensionsoversigt til at afgøre ydelsens type og AM-status."),
    unit = None
)
= personskat_personlig_indkomst_felt_direkte_gruppeliv = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::DirekteArbejdsgiverbetaltGruppeliv::præmie_før_arbejdsmarkedsbidrag_kroner),
    label = "Direkte arbejdsgiverbetalt gruppeliv før AM-bidrag",
    question = Some("Hvor stor gruppelivspræmie betalte arbejdsgiveren direkte før arbejdsmarkedsbidrag?"),
    help = Some("Denne type er A-indkomst og AM-bidragspligtig. Brug kun feltet, når kilden viser direkte betaling til gruppelivsforsikringen."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_pbl19_gruppeliv = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::GruppelivSomUadskiltDelAfPbl19Ordning::personlig_indkomst_efter_indeholdt_arbejdsmarkedsbidrag_kroner),
    label = "Gruppeliv i PBL § 19-ordning efter AM-bidrag",
    question = Some("Hvor stor personlig indkomst er indberettet for gruppeliv, der er en uadskilt del af en arbejdsgiveradministreret pensionsordning?"),
    help = Some("Forsikringsselskabet har allerede indeholdt arbejdsmarkedsbidrag. Beløbet må derfor ikke lægges i et nyt AM-grundlag."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_naturalie_art = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2::art),
    label = "Naturaliets art",
    question = Some("Hvilken naturalietype efter arbejdsmarkedsbidragslovens § 2, stk. 2 har arbejdsgiveren stillet til rådighed?"),
    help = Some("Futuruna bruger den lovbestemte kategori til at afgøre, om den skattepligtige værdi indgår i AM-grundlaget."),
    unit = None
)
= personskat_personlig_indkomst_felt_naturalie_værdi = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::NaturalieEfterArbejdsmarkedsbidragslovensPar2Stk2::skattepligtig_værdi_kroner),
    label = "Naturaliets skattepligtige værdi",
    question = Some("Hvad er naturaliets skattepligtige værdi i indkomståret?"),
    help = Some("Angiv den skattemæssigt opgjorte værdi, ikke arbejdsgiverens indkøbspris."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_uklassificeret_ydelse_beskrivelse = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::UklassificeretArbejdsgiverbetaltYdelse::beskrivelse),
    label = "Beskrivelse af uklassificeret ydelse",
    question = Some("Hvordan beskriver kilden den ydelse, som endnu ikke kan klassificeres retligt?"),
    help = Some("En uklassificeret ydelse beregnes ikke. Beskrivelsen gør det muligt at hente den manglende dokumentation uden at bruge et frit nettobeløb."),
    unit = None
)
= personskat_personlig_indkomst_felt_uklassificeret_ydelse_beløb = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::arbejdsgiverydelser::ydelse::UklassificeretArbejdsgiverbetaltYdelse::beløb_kroner),
    label = "Uklassificeret arbejdsgiverydelse",
    question = Some("Hvilket beløb står i kilden for den endnu uklassificerede ydelse?"),
    help = Some("Beløbet bevares til dokumentation, men påvirker ikke beregningen, før ydelsens retlige art og AM-status er fastlagt."),
    unit = Some("kr./år")
)

= personskat_personlig_indkomst_felt_virksomhed_id = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::identifikation),
    label = "Virksomhedens identifikation",
    question = Some("Hvilken entydig identifikation har virksomheden?"),
    help = Some("Brug eksempelvis CVR-nummer eller en stabil intern identifikation. Denne gren gælder kun virksomhed uden virksomhedsordningen."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhed_år = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indkomstår),
    label = "Virksomhedens indkomstår",
    question = Some("Hvilket indkomstår vedrører virksomhedens resultat?"),
    help = Some("Indkomståret skal være det samme som skatteåret i Personskat-beregningen."),
    unit = Some("år")
)
= personskat_personlig_indkomst_felt_virksomhedsindtægt_id = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indtægter::identifikation),
    label = "Indtægtspostens identifikation",
    question = Some("Hvilken entydig identifikation har indtægtsposten i virksomhedsregnskabet?"),
    help = Some("Identifikationen skal være entydig blandt alle virksomhedens indtægts- og udgiftsposter."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhedsindtægt_art = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indtægter::art),
    label = "Indtægtspostens skattemæssige art",
    question = Some("Er posten ordinær driftsindtægt, kapitalindkomst, aktieindkomst eller endnu uklassificeret?"),
    help = Some("Kun ordinær driftsindtægt beregnes i denne gren. Kapital- og aktieindkomst skal føres gennem deres egne lovregler."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhedsindtægt_beløb = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::indtægter::beløb_kroner),
    label = "Virksomhedsindtægt",
    question = Some("Hvor stort er indtægtspostens beløb?"),
    help = Some("Angiv et ikke-negativt bruttobeløb. Indtægtens skattemæssige art bestemmer den videre regelgren."),
    unit = Some("kr./år")
)
= personskat_personlig_indkomst_felt_virksomhedsudgift_id = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::udgifter::identifikation),
    label = "Udgiftspostens identifikation",
    question = Some("Hvilken entydig identifikation har udgiftsposten i virksomhedsregnskabet?"),
    help = Some("Identifikationen skal være entydig blandt alle virksomhedens indtægts- og udgiftsposter."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhedsudgift_afgrænsning = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::udgifter::afgrænsning),
    label = "Udgiftens afgrænsning efter PSL § 3, stk. 2, nr. 1",
    question = Some("Hvilken lovbestemt udgiftskategori tilhører posten?"),
    help = Some("Futuruna fradrager kun udgifter til at erhverve, sikre og vedligeholde selvstændig erhvervsindkomst her. Renter, kurstab og andre udtrykkeligt undtagne poster skal til deres egne regler."),
    unit = None
)
= personskat_personlig_indkomst_felt_virksomhedsudgift_beløb = TypetBeregningsfelt(
    path = refof(PersonskatPersonligIndkomstInput::ordinære_forhold::virksomheder_uden_virksomhedsordning::udgifter::beløb_kroner),
    label = "Virksomhedsudgift",
    question = Some("Hvor stort er udgiftspostens beløb?"),
    help = Some("Angiv et ikke-negativt beløb. Fradragsretten afledes af udgiftskategorien."),
    unit = Some("kr./år")
)

= personskat_personlig_indkomst_beregningsmeta = TypetBeregningsmeta(
    felter = [
        personskat_personlig_indkomst_felt_arbejdsgiverydelse_id,
        personskat_personlig_indkomst_felt_arbejdsgiverydelse_år,
        personskat_personlig_indkomst_felt_arbejdsgiverydelse_art,
        personskat_personlig_indkomst_felt_direkte_gruppeliv,
        personskat_personlig_indkomst_felt_pbl19_gruppeliv,
        personskat_personlig_indkomst_felt_naturalie_art,
        personskat_personlig_indkomst_felt_naturalie_værdi,
        personskat_personlig_indkomst_felt_uklassificeret_ydelse_beskrivelse,
        personskat_personlig_indkomst_felt_uklassificeret_ydelse_beløb,
        personskat_personlig_indkomst_felt_virksomhed_id,
        personskat_personlig_indkomst_felt_virksomhed_år,
        personskat_personlig_indkomst_felt_virksomhedsindtægt_id,
        personskat_personlig_indkomst_felt_virksomhedsindtægt_art,
        personskat_personlig_indkomst_felt_virksomhedsindtægt_beløb,
        personskat_personlig_indkomst_felt_virksomhedsudgift_id,
        personskat_personlig_indkomst_felt_virksomhedsudgift_afgrænsning,
        personskat_personlig_indkomst_felt_virksomhedsudgift_beløb
    ],
    spørgsmål = [],
    beløbsfelter = [],
    attachments = (
        Source(value = personskatteloven_lbk1284_par3),
        DependencySource(value = arbejdsmarkedsbidragsloven_lbk121_par2),
        DependencySource(value = arbejdsmarkedsbidragsloven_lbk121_par4),
        DependencySource(value = pensionsbeskatningsloven_lbk1243_par56),
        Guidance(value = skat_gruppeliv_vejledning),
    )
)

