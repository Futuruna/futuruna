@ sprog da

@ importer ./personskat.calculate

-- Find the places where one additional krone of gross income leaves less
-- after-tax income. This is a finite search across the 50 adjacent boundaries
-- in the encoded 2026 phase-out of Ligningsloven § 9 C's low-income commuting
-- supplement.

----
Question:
Where does earning one additional krone leave this commuter worse off after
personal tax in the current Futuruna model?

Fixed profile:
- Tax year 2026, municipality of Copenhagen.
- Adult, aged 18 or older.
- Single, no spouse, no church tax.
- No capital income, share income, pension, property tax, foreign social
contributions, carried tax positions, or special tax arrangements.
- Ordinary commute of 60 km in total per workday for 203 workdays.

Search space:
For n in range(1, 51), compare gross income 341,499 + n * 1,000 DKK with
exactly one additional DKK. Net resources are gross income in øre minus the
exact final tax in øre.

Boundary and commuting sources:
Ligningsloven, LBK nr. 1500 af 24/11/2025, § 9 C.
https://www.retsinformation.dk/eli/lta/2025/1500

LOV nr. 616 af 30/06/2026, § 1.
https://www.retsinformation.dk/eli/lta/2026/616

BEK nr. 1333 af 20/11/2025, §§ 1-3.
https://www.retsinformation.dk/eli/lta/2025/1333

Skatteministeriet, beløbsgrænser efter personskattelovens § 20 for 2025-2026.
https://skm.dk/tal-og-metode/satser/regulering-af-beloebsgraenser/beloebsgraenser-i-skattelovgivningen-der-reguleres-efter-personskattelovens-20-2025-2026

Skat.dk, Kørselsfradrag (befordringsfradrag) 2026.
https://skat.dk/borger/fradrag/koerselsfradrag/koerselsfradrag-befordringsfradrag

Skatteministeriet, skatteberegningseksempel for et ægtepar i 2020,
Tabel 2, linje 43. Eksemplet opgør indkomst over aftrapningsgrænsen i hele
antal 1.000 kr. og anvender 45 trin ved et overskud på 45.961 kr.
https://skm.dk/tal-og-metode/satser/skatte-og-afgiftsberegning/skatteberegningseksempel-for-et-aegtepar-i-2020

The imported Personskat model carries source metadata for the remaining
components of the final-tax calculation.
----

# PersonskatIndkomstovergang(indkomst_før_kroner: Heltal, indkomst_efter_kroner: Heltal, lavindkomsttillæg_før_kroner: Heltal, lavindkomsttillæg_efter_kroner: Heltal, slutskat_før_øre: Heltal, slutskat_efter_øre: Heltal, netto_før_øre: Heltal, netto_efter_øre: Heltal, nettotab_øre: Heltal, ligningsfradrag_input_gyldige: Boolsk)

| personskat_indkomstklint_lønmodtager(bruttoløn_kroner: Heltal) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = bruttoløn_kroner,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = PersonskatLigningsfradragInput(
        sømandsfradrag = sømandsbeskatningslov3_intet_årsinput(),
        sømandsbeskatningslov4 = sømandsbeskatningslov4_intet_årsinput(),
        fiskerfradrag = ligningslov9g_intet_årsinput(),
        øvrige_lønmodtagerudgifter = ligningslov9_stk1_intet_årsinput(),
        befordring = PersonskatBefordringsfradragInput(forhold = [PersonskatBefordringsfradragFakta(
            identifikation = "indkomstklint-pendling",
            befordringsmål_identifikation = "indkomstklint-arbejde",
            arbejdsdage = 203,
            daglige_befordringskilometer = 60,
            bopæl_i_yderkommune_eller_lille_ø = Falskt,
            befordringsformål = IndtægtsgivendeArbejdsplads,
            modtaget_skattefri_befordringsgodtgørelse_for_strækning = Falskt,
            modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = Falskt,
            ligningslov9d = UdenLigningslov9D,
            fradrag_udelukket_folketingshverv_m_v = Falskt,
            arbejdsgiverbetalt_befordring = UdenArbejdsgiverbetaltBefordring,
            broer = ll9c_ingen_bropassager(),
            særlig_transport = ll9c_ingen_særlig_transport()
        )]),
        rejser = ligningslov9a_intet_årsinput(),
        faglige_kontingenter = Ligningslov13Årsinput(skatteyderstatus = Ll13Lønmodtager, kontingenter = []),
        arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark, bidrag = []),
        gaver = LigningslovGaveÅrsinput(gaver = [])
    ),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)

| personskat_indkomstklint_input(bruttoløn_kroner: Heltal) -> PersonskatInput(
    lønmodtager = personskat_indkomstklint_lønmodtager(bruttoløn_kroner),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)

| personskat_indkomstklint_netto_øre(bruttoløn_kroner: Heltal, resultat: PersonskatBeregningResultat) -> bruttoløn_kroner * 100 - resultat.slutskat_øre

= personskat_indkomstklint_grænser = map(range(1, 51), |n: Heltal| 341499 + n * 1000)

= personskat_indkomstovergange = map(personskat_indkomstklint_grænser, |indkomst_før_kroner: Heltal| {
        = indkomst_efter_kroner = indkomst_før_kroner + 1
        = resultat_før = beregn_personskat(personskat_indkomstklint_input(indkomst_før_kroner))
        = resultat_efter = beregn_personskat(personskat_indkomstklint_input(indkomst_efter_kroner))
        = netto_før_øre = personskat_indkomstklint_netto_øre(indkomst_før_kroner, resultat_før)
        = netto_efter_øre = personskat_indkomstklint_netto_øre(indkomst_efter_kroner, resultat_efter)

        PersonskatIndkomstovergang(
            indkomst_før_kroner = indkomst_før_kroner,
            indkomst_efter_kroner = indkomst_efter_kroner,
            lavindkomsttillæg_før_kroner = resultat_før.ligningsfradrag.befordring.lavindkomsttillæg_kroner,
            lavindkomsttillæg_efter_kroner = resultat_efter.ligningsfradrag.befordring.lavindkomsttillæg_kroner,
            slutskat_før_øre = resultat_før.slutskat_øre,
            slutskat_efter_øre = resultat_efter.slutskat_øre,
            netto_før_øre = netto_før_øre,
            netto_efter_øre = netto_efter_øre,
            nettotab_øre = netto_før_øre - netto_efter_øre,
            ligningsfradrag_input_gyldige = resultat_før.ligningsfradrag.alle_input_gyldige && resultat_efter.ligningsfradrag.alle_input_gyldige
        )
    })

= personskat_ligningsfradrag_gyldige_indkomstovergange = filter(personskat_indkomstovergange, |overgang: PersonskatIndkomstovergang| overgang.ligningsfradrag_input_gyldige)
= personskat_indkomstklinter = filter(personskat_ligningsfradrag_gyldige_indkomstovergange, |overgang: PersonskatIndkomstovergang| overgang.netto_efter_øre < overgang.netto_før_øre)
= personskat_indkomstklint_antal = length(personskat_indkomstklinter)
= personskat_indkomstklint_342499_til_342500_fund = find(personskat_indkomstklinter, |overgang: PersonskatIndkomstovergang| overgang.indkomst_før_kroner == 342499 && overgang.indkomst_efter_kroner == 342500)
= personskat_værste_indkomstklint = if personskat_indkomstklint_antal == 0 {
    None
} else {
    Some(foldl(
        tail(personskat_indkomstklinter),
        head(personskat_indkomstklinter),
        |værste: PersonskatIndkomstovergang, overgang: PersonskatIndkomstovergang| if overgang.nettotab_øre > værste.nettotab_øre { overgang } else { værste }
    ))
}

| personskat_indkomstklint_søger_50_grænser: personskat_indkomstklint_grænser -> length(personskat_indkomstklint_grænser) == 50
| personskat_indkomstklint_alle_ligningsfradrag_input_gyldige: personskat_ligningsfradrag_gyldige_indkomstovergange -> length(personskat_ligningsfradrag_gyldige_indkomstovergange) == length(personskat_indkomstovergange)
| personskat_indkomstklint_alle_50_fundet: personskat_indkomstklint_antal -> personskat_indkomstklint_antal == 50
| personskat_indkomstklint_342499_til_342500: personskat_indkomstklint_342499_til_342500_fund -> match personskat_indkomstklint_342499_til_342500_fund {
    | Some(overgang) -> overgang.indkomst_før_kroner == 342499 && overgang.indkomst_efter_kroner == 342500 && overgang.lavindkomsttillæg_før_kroner == 14826 && overgang.lavindkomsttillæg_efter_kroner == 14529 && overgang.slutskat_før_øre == 9996763 && overgang.slutskat_efter_øre == 10003810 && overgang.netto_før_øre == 24253137 && overgang.netto_efter_øre == 24246190 && overgang.nettotab_øre == 6947
    | None -> Falskt
}
| personskat_værste_indkomstklint_er_maksimal: personskat_værste_indkomstklint -> match personskat_værste_indkomstklint {
    | Some(overgang) -> overgang.ligningsfradrag_input_gyldige && overgang.nettotab_øre > 0 && all(personskat_indkomstklinter, |kandidat: PersonskatIndkomstovergang| kandidat.nettotab_øre <= overgang.nettotab_øre)
    | None -> Falskt
}

? personskat_indkomstklint_søger_50_grænser
? personskat_indkomstklint_alle_ligningsfradrag_input_gyldige
? personskat_indkomstklint_alle_50_fundet
? personskat_indkomstklint_342499_til_342500
? personskat_værste_indkomstklint_er_maksimal

@ print("personskat indkomstklint søgte grænser: " + vis(length(personskat_indkomstklint_grænser)))
@ print("personskat indkomstklint ligningsfradrag-gyldige overgange: " + vis(length(personskat_ligningsfradrag_gyldige_indkomstovergange)))
@ print("personskat indkomstklint fund: " + vis(personskat_indkomstklint_antal))
@ print("personskat indkomstklint værste fund: " + vis(personskat_værste_indkomstklint))
