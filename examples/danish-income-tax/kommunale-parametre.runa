--@end::kommunale_parametre_2026--

| kommunale_parametre_kilde_for_år(skatteår: Heltal) -> SkatteministerietKommuneskattesatser2026Xlsx under skatteår == 2026

| kommunalt_skatteår_understøttet(skatteår: Heltal) -> skatteår == 2024 || skatteår == 2025 || skatteår == 2026
| kommunale_parametre_for_år(skatteår: Heltal) -> kommunale_parametre_2024 under skatteår == 2024
| kommunale_parametre_for_år(skatteår: Heltal) -> kommunale_parametre_2025 under skatteår == 2025
| kommunale_parametre_for_år(skatteår: Heltal) -> kommunale_parametre_2026 under skatteår == 2026
| kommunale_parametre_kandidater(skatteår: Heltal, kommune: Kommune) -> filter(kommunale_parametre_for_år(skatteår), |parametre: KommunaleParametre| parametre.kommune == kommune)
| kommune_understøttet(kommune: Kommune) -> any(alle_kommuner, |kandidat: Kommune| kandidat == kommune)
| kommune_understøttet_i_år(skatteår: Heltal, kommune: Kommune) -> kommunalt_skatteår_understøttet(skatteår) && length(kommunale_parametre_kandidater(skatteår, kommune)) == 1
| kommunale_parametre_værdi_for(skatteår: Heltal, kommune: Kommune) -> head(kommunale_parametre_kandidater(skatteår, kommune)) under kommune_understøttet_i_år(skatteår, kommune)
| kommunale_parametre_kilde(skatteår: Heltal, kommune: Kommune) -> kommunale_parametre_kilde_for_år(skatteår) under kommune_understøttet_i_år(skatteår, kommune)
| kommunale_parametre_kildeinfo(kilde: KommunaleParametreKilde) -> match kilde {
    | SkatteministerietKommuneskatter2024 -> skatteministeriet_kommunale_parametre_2024
    | SkatteministerietKommuneskatter2025 -> skatteministeriet_kommunale_parametre_2025
    | SkatteministerietKommuneskattesatser2026Xlsx -> skatteministeriet_kommunale_parametre_2026
}
| kommunale_parametre_resultat(skatteår: Heltal, kommune: Kommune) -> KommunaleParametreResultat(
    skatteår = skatteår,
    kommune = kommune,
    kilde = kommunale_parametre_kilde(skatteår, kommune),
    parametre = kommunale_parametre_værdi_for(skatteår, kommune)
) under kommune_understøttet_i_år(skatteår, kommune)
| kommunale_parametre_for(skatteår: Heltal, kommune: Kommune) -> kommunale_parametre_resultat(skatteår, kommune).parametre
