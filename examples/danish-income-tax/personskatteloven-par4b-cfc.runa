@ sprog da

@ importer ./ligningsloven_cfc
@ importer ./metadata
@ importer ./pengebeloeb
@ importer ./source - status

= personskatteloven_par4b_metadata = Metadata(
    attachments = (
        Source(value = personskatteloven_2021_1284),
        HistoricalSource(value = ligningsloven_lbk42_par16h_og_par16i_stk6_7),
        DependencySource(value = ligningsloven_lbk1500_par16h_og_par16i_stk6_7),
    )
)

--@label:personskatteloven_par4b::meta:personskatteloven_par4b_metadata--
----
§ 4 b. CFC-indkomst (Controlled Foreign Company) omfatter det samlede beløb af
indkomst som omhandlet i ligningslovens § 16 H og § 16 I, stk. 6 og 7.

Stk. 2. CFC-indkomst indgår ikke i den skattepligtige indkomst ved beregning af
skat efter §§ 6-8 a.
----

--@begin:personskatteloven_par4b--
# CfcPost = Ligningslov16H | Ligningslov16IStk6Og7 | Ligningslov16IStk7
# Par4bCfcIndkomstPost(kilde: CfcPost, beløb_kroner: Heltal)
# Par4bLigningslov16HResultat(omfattet_af_ligningslov16h: Boolsk, cfc_indkomst_kroner: Heltal)
# Par4bLigningslov16IStk6Og7Resultat(omfattet_af_ligningslov16i_stk6_og_7: Boolsk, cfc_indkomst_kroner: Heltal)
# Par4bCfcIndkomstInput(poster: List(Par4bCfcIndkomstPost))
# Par4bCfcIndkomstResultat(cfc_indkomst_kroner: Heltal, positiv_cfc_indkomst_til_par8b_kroner: Heltal, indgår_i_skattepligtig_indkomst_ved_par6_til_8a: Boolsk)

| cfc_indkomst_omfatter(post: CfcPost) -> Sandt
| cfc_indgår_i_skattepligtig_indkomst_ved_par6_til_8a() -> Falskt
| par4b_cfc_post_medregnes(post: Par4bCfcIndkomstPost) -> cfc_indkomst_omfatter(post.kilde)
| par4b_cfc_post_kroner(post: Par4bCfcIndkomstPost) -> 0
| exception par4b_cfc_post_omfattet par4b_cfc_post_kroner(post: Par4bCfcIndkomstPost) -> post.beløb_kroner under par4b_cfc_post_medregnes(post)
| par4b_cfc_indkomst_kroner(input: Par4bCfcIndkomstInput) -> foldl(input.poster, 0, |sum, post| sum + par4b_cfc_post_kroner(post))
| par4b_positiv_cfc_indkomst_til_par8b_kroner(input: Par4bCfcIndkomstInput) -> penge_positivt_beløb(par4b_cfc_indkomst_kroner(input))
| par4b_cfc_indkomst_resultat(input: Par4bCfcIndkomstInput) -> Par4bCfcIndkomstResultat(
    cfc_indkomst_kroner = par4b_cfc_indkomst_kroner(input),
    positiv_cfc_indkomst_til_par8b_kroner = par4b_positiv_cfc_indkomst_til_par8b_kroner(input),
    indgår_i_skattepligtig_indkomst_ved_par6_til_8a = cfc_indgår_i_skattepligtig_indkomst_ved_par6_til_8a()
)

# Par4bLigningslov16HSag(input: Ligningslov16HResultat) {
    | cfcpost() -> Par4bCfcIndkomstPost(
        kilde = Ligningslov16H,
        beløb_kroner = input.medregnet_cfc_indkomst_kroner
    )
    | resultat() -> Par4bLigningslov16HResultat(
        omfattet_af_ligningslov16h = input.omfattet_af_par16h,
        cfc_indkomst_kroner = input.medregnet_cfc_indkomst_kroner
    )
}
| par4b_ligningslov16h_sag(input: Ligningslov16HResultat) -> Par4bLigningslov16HSag(input)
| par4b_ligningslov16h_resultat(input: Ligningslov16HInput) -> par4b_ligningslov16h_sag(ligningslov16h_resultat(input)).resultat()
| par4b_cfc_post_fra_ligningslov16h_resultat(input: Ligningslov16HResultat) -> par4b_ligningslov16h_sag(input).cfcpost()
| par4b_cfc_post_fra_ligningslov16h(input: Ligningslov16HInput) -> par4b_cfc_post_fra_ligningslov16h_resultat(ligningslov16h_resultat(input))

# Par4bLigningslov16IStk6Og7Sag(input: Ligningslov16IStk6Og7Resultat) {
    | cfcpost() -> Par4bCfcIndkomstPost(
        kilde = Ligningslov16IStk6Og7,
        beløb_kroner = input.medregnet_som_cfc_indkomst_kroner
    )
    | resultat() -> Par4bLigningslov16IStk6Og7Resultat(
        omfattet_af_ligningslov16i_stk6_og_7 = input.omfattet_af_stk6,
        cfc_indkomst_kroner = input.medregnet_som_cfc_indkomst_kroner
    )
}
| par4b_ligningslov16i_stk6_og_7_sag(input: Ligningslov16IStk6Og7Resultat) -> Par4bLigningslov16IStk6Og7Sag(input)
| par4b_ligningslov16i_stk6_og_7_resultat(input: Ligningslov16IStk6Og7Input) -> par4b_ligningslov16i_stk6_og_7_sag(ligningslov16i_stk6_og_7_resultat(input)).resultat()
| par4b_cfc_post_fra_ligningslov16i_stk6_og_7_resultat(input: Ligningslov16IStk6Og7Resultat) -> par4b_ligningslov16i_stk6_og_7_sag(input).cfcpost()
| par4b_cfc_post_fra_ligningslov16i_stk6_og_7(input: Ligningslov16IStk6Og7Input) -> par4b_cfc_post_fra_ligningslov16i_stk6_og_7_resultat(ligningslov16i_stk6_og_7_resultat(input))

= par4b_16h = cfc_indkomst_omfatter(Ligningslov16H)
= par4b_16i6 = cfc_indkomst_omfatter(Ligningslov16IStk6Og7)
= par4b_udenfor_par6_8a = cfc_indgår_i_skattepligtig_indkomst_ved_par6_til_8a()
= par4b_cfc_indkomst_resultat_fixture = par4b_cfc_indkomst_resultat(Par4bCfcIndkomstInput(
    poster = [
        Par4bCfcIndkomstPost(kilde = Ligningslov16H, beløb_kroner = 300000),
        Par4bCfcIndkomstPost(kilde = Ligningslov16IStk6Og7, beløb_kroner = 150000),
        Par4bCfcIndkomstPost(kilde = Ligningslov16IStk7, beløb_kroner = 50000)
    ]
))
= par4b_negativ_cfc_indkomst_fixture = par4b_cfc_indkomst_resultat(Par4bCfcIndkomstInput(
    poster = [
        Par4bCfcIndkomstPost(kilde = Ligningslov16H, beløb_kroner = -25000)
    ]
))
= par4b_ligningslov_cfc_fixture = par4b_cfc_indkomst_resultat(Par4bCfcIndkomstInput(
    poster = [
        par4b_cfc_post_fra_ligningslov16h_resultat(ll16h_positiv_fixture),
        par4b_cfc_post_fra_ligningslov16i_stk6_og_7_resultat(ll16i_stk6_og_7_fixture)
    ]
))

| par4b_16h_er_cfc: par4b_16h -> par4b_16h == Sandt
| par4b_16i_stk6_er_cfc: par4b_16i6 -> par4b_16i6 == Sandt
| par4b_ikke_i_skattepligtig_ved_par6_8a: par4b_udenfor_par6_8a -> par4b_udenfor_par6_8a == Falskt
| par4b_cfc_indkomst_beregnes_beløb: par4b_cfc_indkomst_resultat_fixture -> par4b_cfc_indkomst_resultat_fixture.cfc_indkomst_kroner == 500000 && par4b_cfc_indkomst_resultat_fixture.positiv_cfc_indkomst_til_par8b_kroner == 500000 && par4b_cfc_indkomst_resultat_fixture.indgår_i_skattepligtig_indkomst_ved_par6_til_8a == Falskt
| par4b_negativ_cfc_indkomst_giver_intet_positivt_par8b_grundlag: par4b_negativ_cfc_indkomst_fixture -> par4b_negativ_cfc_indkomst_fixture.cfc_indkomst_kroner == -25000 && par4b_negativ_cfc_indkomst_fixture.positiv_cfc_indkomst_til_par8b_kroner == 0 && par4b_negativ_cfc_indkomst_fixture.indgår_i_skattepligtig_indkomst_ved_par6_til_8a == Falskt
| par4b_ligningslov16h_og_16i_føder_cfc_indkomst: par4b_ligningslov_cfc_fixture -> par4b_ligningslov_cfc_fixture.cfc_indkomst_kroner == 150000 && par4b_ligningslov_cfc_fixture.positiv_cfc_indkomst_til_par8b_kroner == 150000 && par4b_ligningslov_cfc_fixture.indgår_i_skattepligtig_indkomst_ved_par6_til_8a == Falskt
--@end:personskatteloven_par4b--
