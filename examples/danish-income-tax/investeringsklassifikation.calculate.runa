@ sprog da

@ importer ./metadata
@ importer ./aktieavancebeskatningsloven-par19-20a
@ importer ./aktieavancebeskatningsloven-par19b-22

= abl_investeringsklassifikation_beregning_metadata = Metadata(
    attachments = (
        Source(value = aktieavancebeskatningsloven_lbk1098_par19_til_par20a),
        Source(value = aktieavancebeskatningsloven_lbk1098_par19b_til_par22),
        HistoricalSource(value = aktieavancebeskatningsloven_lbk172_par19_til_par22),
        AmendmentSource(value = aktieavancebeskatningsloven_lov1179_par2_nr1_2_og_par13),
        TransitionSource(value = aktieavancebeskatningsloven_lov1179_par2_nr1_2_og_par13),
        AmendmentSource(value = aktieavancebeskatningsloven_lov1563_par2_nr10_11_og_par8),
        TransitionSource(value = aktieavancebeskatningsloven_lov1563_par2_nr10_11_og_par8),
    )
)

@ meta(abl_investeringsklassifikation_beregning_metadata)
@ section abl_investeringsklassifikation_beregning {

@ calculate
| klassificer_investeringsselskab_efter_par19(input: AktieavancePar19Input) -> aktieavance_par19_resultat(input)

@ calculate
| klassificer_investeringsbevis_efter_par19a_til20a(input: AktieavancePar19ATil20AInput) -> aktieavance_par19a_til20a_resultat(input)

@ calculate
| klassificer_investeringsselskab(input: AktieavancePar19BPar19CInput) -> aktieavance_par19b_par19c_resultat(input)

@ calculate
| klassificer_minimumsinstitut(input: AktieavancePar21Par22Input) -> aktieavance_par21_par22_resultat(input)

}

= abl_investeringsselskab_klassifikationsår_beregningsmeta = Beregningsmeta(
    felter = [
        Beregningsfelt(path = refof(AktieavancePar19BPar19CInput::indkomstår), label = "Investeringsselskabets klassifikationsår", question = Some("Hvilket indkomstår gælder investeringsselskabets klassifikation for?"), help = None, unit = Some("år"))
    ],
    attachments = personskat_kilder_2
)
= abl_minimumsinstitut_ejerpost_klassifikationsår_beregningsmeta = Beregningsmeta(
    felter = [
        Beregningsfelt(path = refof(AktieavancePar21Par22Input::aktivmasse::ejerposter::AblEjerpostIPar19B::klassifikationsinput::indkomstår), label = "Investeringsselskabets klassifikationsår", question = Some("Hvilket indkomstår gælder investeringsselskabets klassifikation for?"), help = None, unit = Some("år"))
    ],
    attachments = personskat_kilder_2
)
@ meta(abl_investeringsselskab_klassifikationsår_beregningsmeta) for klassificer_investeringsselskab
@ meta(abl_minimumsinstitut_ejerpost_klassifikationsår_beregningsmeta) for klassificer_minimumsinstitut
