@ sprog da

@ importer ./metadata
@ importer ./aktieavancebeskatningsloven - par19 - 20a
@ importer ./aktieavancebeskatningsloven - par19b - 22

= abl_investeringsklassifikation_beregning_metadata = Metadata(
    attachments = (
        MetaAttachment(role = Source, value = aktieavancebeskatningsloven_lbk1098_par19_til_par20a),
        MetaAttachment(role = Source, value = aktieavancebeskatningsloven_lbk1098_par19b_til_par22),
    )
)

--@label:abl_investeringsklassifikation_beregning::meta:abl_investeringsklassifikation_beregning_metadata--
--@begin:abl_investeringsklassifikation_beregning--
@ calculate
| klassificer_investeringsselskab_efter_par19(input: AktieavancePar19Input) -> aktieavance_par19_resultat(input)

@ calculate
| klassificer_investeringsbevis_efter_par19a_til20a(input: AktieavancePar19ATil20AInput) -> aktieavance_par19a_til20a_resultat(input)

@ calculate
| klassificer_investeringsselskab(input: AktieavancePar19BPar19CInput) -> aktieavance_par19b_par19c_resultat(input)

@ calculate
| klassificer_minimumsinstitut(input: AktieavancePar21Par22Input) -> aktieavance_par21_par22_resultat(input)
--@end:abl_investeringsklassifikation_beregning--
