@ sprog da

@ importer ./kildeskatteloven - arbejdsudleje

| arbejdsudleje_scenarie_parter(personstatus: KildeskattelovArbejdsudlejePersonstatus, ansættelsesforhold: KildeskattelovArbejdsudlejeAnsættelsesforhold, udlejerstatus: KildeskattelovArbejdsudlejeUdlejerstatus) -> KildeskattelovArbejdsudlejeParter(
    person_identifikation = "Oliver",
    udenlandsk_arbejdsgiver_identifikation = "DE-B",
    dansk_hvervgiver_identifikation = "DK-A",
    personstatus = personstatus,
    ansættelsesforhold = ansættelsesforhold,
    udlejerstatus = udlejerstatus,
    hvervgiverstatus = DanskHvervgiverMedHjemtingEllerFastDriftssted
)
| arbejdsudleje_scenarie_arbejde(tilknytning: KildeskattelovArbejdsudlejeTilknytning, udskillelse: KildeskattelovArbejdsudlejeUdskillelse) -> KildeskattelovArbejdsudlejeArbejde(
    arbejdssted = ArbejdePåDanskLandEllerSøterritorium,
    tilknytning = tilknytning,
    udskillelse = udskillelse
)
| arbejdsudleje_scenarie_tomt_arbejdsgiverbidrag(indkomstår: Heltal) -> Ligningslov8MUdenlandskArbejdsgiverbidragInput(
    bidrag_kroner = 0,
    bidrag_vedrører_indkomstår = indkomstår,
    obligatorisk = Falskt,
    omfattet_af_eu_socialsikringsforordning = Falskt,
    aftale_om_at_bidrag_påhviler_lønmodtageren = Falskt
)
| arbejdsudleje_scenarie_input(indkomstår: Heltal, alder: Heltal, parter: KildeskattelovArbejdsudlejeParter, arbejde: KildeskattelovArbejdsudlejeArbejde, beskatningsret: KildeskattelovArbejdsudlejeDanskBeskatningsret, valg: KildeskattelovArbejdsudlejeBeskatningsvalg, vederlag: KildeskattelovArbejdsudlejeVederlag, arbejdsgiverbidrag: Ligningslov8MUdenlandskArbejdsgiverbidragInput) -> KildeskattelovArbejdsudlejeInput(
    identifikation = "arbejdsudleje-1",
