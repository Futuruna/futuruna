    vederlag = vederlag,
    udenlandsk_arbejdsgiverbidrag = arbejdsgiverbidrag
)
| arbejdsudleje_scenarie_standardinput(indkomstår: Heltal, alder: Heltal, valg: KildeskattelovArbejdsudlejeBeskatningsvalg, vederlag: KildeskattelovArbejdsudlejeVederlag) -> arbejdsudleje_scenarie_input(
    indkomstår = indkomstår,
    alder = alder,
    parter = arbejdsudleje_scenarie_parter(ArbejdsudlejetIkkeOmfattetAfKsl1EllerKsl2Stk1Nr1, AnsatHosUdenlandskUdlejer, UdenlandskUdlejerUdenDanskFastDriftssted),
    arbejde = arbejdsudleje_scenarie_arbejde(ArbejdeErKerneydelse, ArbejdetErIkkePermanentUdskilt),
    beskatningsret = ArbejdsudlejeDanskBeskatningsretBekræftet,
    valg = valg,
    vederlag = vederlag,
    arbejdsgiverbidrag = arbejdsudleje_scenarie_tomt_arbejdsgiverbidrag(indkomstår)
)
| arbejdsudleje_scenarie_resultat(input: KildeskattelovArbejdsudlejeInput) -> kildeskat_arbejdsudleje_resultat(input)

= arbejdsudleje_scenarie_oliver = arbejdsudleje_scenarie_resultat(arbejdsudleje_scenarie_standardinput(
    indkomstår = 2025,
    alder = 40,
    valg = EndeligArbejdsudlejeskatEfterPar48B,
    vederlag = DokumenteretArbejdsudlejevederlag(
        løn_bonus_provision_tillæg_kroner = 18000,
        ferie_og_afspadsering_kroner = 0,
        rejse_og_befordringsgodtgørelse_kroner = 2000,
        fri_kost_og_logi = IngenFriKostEllerLogi,
        andre_skattepligtige_personalegoder_kroner = 0
    )
))
= arbejdsudleje_scenarie_fakturasum = arbejdsudleje_scenarie_resultat(arbejdsudleje_scenarie_standardinput(2025, 40, EndeligArbejdsudlejeskatEfterPar48B, ArbejdsudlejevederlagEfterFakturasum(fakturasum_kroner = 30000)))
= arbejdsudleje_scenarie_rejsekost = arbejdsudleje_scenarie_resultat(arbejdsudleje_scenarie_standardinput(2025, 40, EndeligArbejdsudlejeskatEfterPar48B, DokumenteretArbejdsudlejevederlag(20000, 0, 0, FriKostOgLogiDækketEfterRegningPåSkattemæssigRejse(dækket_beløb_kroner = 4000), 0)))
= arbejdsudleje_scenarie_ung_2026 = arbejdsudleje_scenarie_resultat(arbejdsudleje_scenarie_standardinput(2026, 17, EndeligArbejdsudlejeskatEfterPar48B, DokumenteretArbejdsudlejevederlag(20000, 0, 0, IngenFriKostEllerLogi, 0)))
= arbejdsudleje_scenarie_arbejdsgiverbidrag = arbejdsudleje_scenarie_resultat(arbejdsudleje_scenarie_input(
    indkomstår = 2025,
    alder = 40,
    parter = arbejdsudleje_scenarie_parter(ArbejdsudlejetIkkeOmfattetAfKsl1EllerKsl2Stk1Nr1, AnsatHosUdenlandskUdlejer, UdenlandskUdlejerUdenDanskFastDriftssted),
    arbejde = arbejdsudleje_scenarie_arbejde(ArbejdeErNaturligDelAfDrift, ArbejdetErIkkePermanentUdskilt),
    beskatningsret = ArbejdsudlejeDanskBeskatningsretBekræftet,
    valg = EndeligArbejdsudlejeskatEfterPar48B,
    vederlag = DokumenteretArbejdsudlejevederlag(20000, 0, 0, IngenFriKostEllerLogi, 0),
    arbejdsgiverbidrag = Ligningslov8MUdenlandskArbejdsgiverbidragInput(1000, 2025, Sandt, Sandt, Sandt)
