# Pbl15AAfskrivningslovKilderesultat = Pbl15AAl6SalgBeregnet(resultat: Afskrivningslov6SalgResultat) | Pbl15AAl9VirksomhedsophørBeregnet(resultat: Afskrivningslov9Resultat) | Pbl15AAl9EfterfølgendeSalgBeregnet(resultat: Afskrivningslov9EfterfølgendeSalgResultat) | Pbl15AAl12BlandetAktivBeregnet(resultat: Afskrivningslov12Resultat) | Pbl15AAl21BygningEllerInstallationBeregnet(resultat: Afskrivningslov21Resultat) | Pbl15AAl26LejetGrundEllerHjemfaldBeregnet(resultat: Afskrivningslov26Resultat) | Pbl15AAl39LejedeLokalerBeregnet(resultat: Afskrivningslov39Resultat) | Pbl15AAl40GoodwillEllerImmaterieltAktivBeregnet(resultat: Afskrivningslov40Resultat) | Pbl15AAl40AKvoteBeregnet(resultat: Afskrivningslov40AResultat) | Pbl15AAl40BLøbendeKvoteBeregnet(resultat: Afskrivningslov40BResultat) | Pbl15AAl40CBetalingsrettighedEllerMælkekvoteBeregnet(resultat: Afskrivningslov40CResultat) | Pbl15AAl42TelefonEllerDatakommunikationBeregnet(resultat: Afskrivningslov42AfståelsesResultat) | Pbl15AAl44AKunstneriskUdsmykningBeregnet(resultat: Afskrivningslov44AAfståelsesResultat) | Pbl15AAl44CForskudsafskrevetAktivBeregnet(resultat: Afskrivningslov44CResultat) | Pbl15AAl50HistoriskBlandetAktivBeregnet(resultat: Afskrivningslov50Resultat) | Pbl15AAl58HistoriskBygningBeregnet(resultat: Afskrivningslov58Resultat) | Pbl15AAl62HistoriskDriftsmiddelBeregnet(resultat: Afskrivningslov62DriftsmiddelSalgResultat) | Pbl15AAl62HistoriskMiljøanlægBeregnet(resultat: Afskrivningslov62MiljøanlægSalgResultat)
