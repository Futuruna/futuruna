@ sprog da

@ importer ./personskat - par14.calculate

----
Scenarierne afprøver den kanoniske delårsgrænse for personskattelovens § 14.
De er ikke lovtekst. Hvert resultat begynder i beregn_personskat og anvender
derefter de identificerede kilders valgte helårsbehandling.
----

# PersonskatPar14ScenarieKonfiguration(bruttoløn_kroner: Heltal, kapitalindkomst: PersonskatKapitalindkomstInput, skatteforhold: PersonskatSkatteforholdInput, aktieavance: PersonskatAktieavanceInput, cfc: PersonskatCfcInput, underskudsforhold: PersonskatUnderskudsforholdInput, ægtefælle: PersonskatÆgtefælleInput, negativ_aktieskat_fremførsel: PersonskatNegativAktieskatFremførselsparInput, ligningslov33: PersonskatLigningslov33ParInput, årsopgørelse: PersonskatÅrsopgørelseInput)

| personskat_par14_scenarie_lønmodtager(bruttoløn_kroner: Heltal) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = bruttoløn_kroner,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
| personskat_par14_scenarie_personskat_fra(konfiguration: PersonskatPar14ScenarieKonfiguration) -> PersonskatInput(
    lønmodtager = personskat_par14_scenarie_lønmodtager(konfiguration.bruttoløn_kroner),
    kapitalindkomst = konfiguration.kapitalindkomst,
    aktieavance = konfiguration.aktieavance,
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = konfiguration.cfc,
    skatteforhold = konfiguration.skatteforhold,
    underskudsforhold = konfiguration.underskudsforhold,
    ægtefælle = konfiguration.ægtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = konfiguration.negativ_aktieskat_fremførsel,
    ligningslov33 = konfiguration.ligningslov33,
    årsopgørelse = konfiguration.årsopgørelse
)
| personskat_par14_scenarie_personskat(skatteforhold: PersonskatSkatteforholdInput) -> personskat_par14_scenarie_personskat_fra(PersonskatPar14ScenarieKonfiguration(
    bruttoløn_kroner = 300000,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    skatteforhold = skatteforhold,
    aktieavance = personskat_ingen_aktieavance(),
    cfc = personskat_ingen_cfc(),
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
))
| personskat_par14_scenarie_kilde(faktisk_helårsbeløb_kroner: Option(Heltal)) -> PersonskatPar14Kilde(
    identifikation = "løn-fra-dansk-arbejdsgiver",
    beregningsfelt = Par14Bruttoløn,
    delårsbeløb_kroner = 300000,
    omregningsmetode = Par14ForholdsmæssigtLøbendeBeløb,
    faktisk_helårsbeløb_kroner = faktisk_helårsbeløb_kroner
)
| personskat_par14_scenarie_input(skatteforhold: PersonskatSkatteforholdInput, ændring: Par14Skattepligtsændring, periode: PersonskatPar14Skattepligtsperiode, valg: Boolsk, omvalg: Option(Dato), faktisk_helårsbeløb_kroner: Option(Heltal)) -> PersonskatPar14Input(
    personskat = personskat_par14_scenarie_personskat(skatteforhold),
    skattepligtsændring = ændring,
    skattepligtsperiode = periode,
    valg_afgivet_ved_oplysninger = valg,
    omvalg_dato = omvalg,
    kilder = [personskat_par14_scenarie_kilde(faktisk_helårsbeløb_kroner)],
    helårsgrundlag = AfledtFraIdentificeredeKilder
)
| personskat_par14_scenarie_personfakta(bruttoløn_kroner: Heltal) -> PersonskatPersonFakta(
    lønmodtager = personskat_par14_scenarie_lønmodtager(bruttoløn_kroner),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta()
)
| personskat_par14_scenarie_aktieinput(identifikation: Tekst, beløb_kroner: Heltal) -> PersonskatAktieavanceInput(
    ordinært_aktieår = UdenOrdinærtAktieår,
    særlige_aktiver = [],
    udbytter = [PersonskatUdbytteFakta(
        identifikation = identifikation,
        udlodder = Ll16AAlmindeligtSelskab,
        modtager = Ll16AAktuelAktionær,
        aktiv = PersonskatAlmindeligAktie,
        beløb_kroner = beløb_kroner,
        par13a_kildefakta = AblPar13AUdbytteUdenForModregningsgrundlag
    )],
    ligningslov7n_poster = []
)
| personskat_par14_scenarie_cfc_fakta() -> PersonskatCfcEfterLigningslov16HFakta(
    fuldt_skattepligtig_eller_dødsbo = Sandt,
    udenlandsk_selskab = Sandt,
    direkte_indirekte_ejerandel_basispoint = 6000,
    stemmerettigheder_basispoint = 4000,
    fælleskontrol_med_nærtstående_fond_eller_trust = Falskt,
    aftale_om_skattesats_eller_beskatningsgrundlag = Falskt,
    hjemstat_regler_indrettet_efter_kontrollerende_aktionær = Falskt,
    udenlandsk_indkomstskat_kroner = 40000,
    selskabets_cfc_indkomst_stk4_og_sel32_stk5_kroner = 200000,
    selskabets_samlede_skattepligtige_indkomst_stk4_5_kroner = 300000,
    aktier_ikke_investeringsselskab = Sandt,
    eu_eøs_selskab = Falskt,
    reel_etablering_og_økonomisk_virksomhed = Falskt,
    dokumentation_kan_verificeres = Falskt,
    medregnet_efter_selskabsskat31a_32_eller_fondsbeskatning12 = Falskt,
    gennemsnitlig_ejerandel_basispoint = 6000,
    kontrolperiode_basispoint = 10000,
    fremført_underskud_danske_regler_kroner = 0
)
| personskat_par14_scenarie_årsopgørelse(a_skat_og_am_indeholdt_kroner: Heltal, personskattelov_par8a_stk5_beløb_kroner: Heltal) -> MedÅrsopgørelse(
    overført_restskat_mv_kroner = 0,
    øvrig_pensionsbeskatningsafgift_kroner = 0,
    kreditter = KildeskatPar60Kreditter(
        a_skat_og_am_indeholdt_kroner = a_skat_og_am_indeholdt_kroner,
        par68_indbetalt_kroner = 0,
        b_skat_betalt_kroner = 0,
        udbytteskat_modregningsberettiget_kroner = 0,
        frivillig_indbetaling_par59_kroner = 0,
        virksomhedsordning_beløb_kroner = 0,
        personskattelov_par8a_stk5_beløb_kroner = personskattelov_par8a_stk5_beløb_kroner,
        afskrivningslov_acontoskat_kroner = 0,
        am_lov_par6_beløb_kroner = 0,
        seniornedslag_kroner = 0,
        energiafgiftskompensation_kroner = 0,
        tilbagebetalt_par55_kroner = 0
    ),
    afskrivningslov40c_acontoskat = UdenAfskrivningslov40CAcontoskat
)
| personskat_par14_scenarie_ligningslov33_kreditgruppe() -> Ligningslov33PersonKreditgruppe(
    identifikation = "svensk-delårsløn",
    grupperingsgrundlag = Ll33SamletIndkomstFraSkatteområdet,
    område = Ll33FremmedStat(landekode = "SE"),
    indkomstposter = [ligningslov33_bruttoindkomstpost(
        identifikation = "svensk-delårsløn-brutto",
        beløb_kroner = 120000,
        indkomstkategorier = [Ll33SkattepligtigIndkomstkategori, Ll33PersonligIndkomstkategori, Ll33Arbejdsmarkedsbidragskategori],
        dokumentreference = "svensk-lønseddel-2026"
    )],
    skattebetalinger = [Ligningslov33Skattebetaling(
        opkrævningsmåde = Ll33DirektePåligning,
        betalt_udenlandsk_skat_øre = 5000000,
        skatteart = Ll33Indkomstskat,
        betalingsdokumentreference = "svensk-skattebilag-2026",
        overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst
    )],
    lønlempelsesstatus = Ll33OrdinærCreditlempetLønindkomst
)
| personskat_par14_scenarie_ligningslov33() -> PersonskatLigningslov33ParInput(
    hovedperson = MedLigningslov33(input = Ligningslov33PersonÅrsinput(
        indkomstår = 2026,
        dansk_bruttoindkomst_kroner = 300000,
        ikke_henførbare_udgifter = [],
        kreditgrupper = [personskat_par14_scenarie_ligningslov33_kreditgruppe()],
        par6_kreditter = [],
        fragtskat_åbningssaldi = []
    )),
    ægtefælle = UdenLigningslov33,
    ligningslov33a_hovedperson = UdenLigningslov33A,
    ligningslov33a_ægtefælle = UdenLigningslov33A
)
| personskat_par14_scenarie_fremført_negativ_aktieskat() -> PersonskatNegativAktieskatFremførselsparInput(
    hovedperson = EksterntFastsatFremførtNegativAktieskat(
        trancher = [PersonskatNegativAktieskatTranche(
            ejer = HovedpersonensNegativAktieskat,
            oprindelsesår = 2025,
            resterende_negativ_skat_kroner = 1000
        )],
        proveniens = SkatteforvaltningensÅrsopgørelse(dokumentreference = "årsopgørelse-2025-negativ-aktieskat")
    ),
    ægtefælle = UdenFremførtNegativAktieskat
)
| personskat_par14_scenarie_kapitalindkomst(renteindtægter_kroner: Heltal, renteudgifter_kroner: Heltal) -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = renteindtægter_kroner,
        renteudgifter_kroner = renteudgifter_kroner,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = []
)
| personskat_par14_dis_fakta() -> Søbl5Til8Indkomstfakta(
    identifikation = "dis-delår-2026",
    indkomstår = 2026,
    person = Søbl5Til8Personfakta(
        skattepligt = SøblFuldtSkattepligtigEfterKsl1,
        statsborgerskab = SøblStatsborgerIEUEØS,
        relation = SøblAlmindeligLønmodtager
    ),
    skib = Søbl5Til8Skibsfakta(
        identifikation = "dis-skib-delår-2026",
        registrering = SøblDanskSkibRegistreretIDIS,
        bruttotonnage = 12000,
        arbejdsgiverstatus = SøblDanskArbejdsgiver
    ),
    arbejde = Søbl5Til8Arbejdsfakta(
        anvendelse = SøblUdelukkendeAnvendtTil(SøblTransportAfGodsMellemForskelligeDestinationer),
        arbejdsområde = SøblArbejdeUdenForEUEØS,
        passagerrute = SøblIngenPassagersejlads,
        arbejdsrolle = SøblNormalDriftsbesætning,
        par8_valg = SøblAnvendPar10RefusionEllerAlmindeligBeskatning
    ),
    løn = Søbl5Til8Lønfakta(
        indkomsttype = SøblLønVedArbejdeOmBord,
        løngrundlag = SøblSkattefriNettolønFastsatUnderHensynTilFritagelsen,
        beløb_kroner = 250000
    )
)
| personskat_par14_dis_personlig_indkomst() -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = personskat_ingen_ordinær_personlig_indkomst(),
    arbejdsudleje = [],
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = Søbl5Til8Årsinput(
        indkomster = [personskat_par14_dis_fakta()],
        skibsårsdrifter = [],
        andre_ligningslov7u_indkomster = [],
        dødsboskattegrundlag = Søbl5IntetDødsboskattegrundlag,
        kulbrinteskattegrundlag = Søbl5BIntetKulbrinteskattegrundlag
    )
)
| personskat_par14_dis_personskat_med_ligningslov33(ligningslov33: PersonskatLigningslov33ParInput) -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 300000,
        personlig_indkomst = personskat_par14_dis_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = ligningslov33,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_par14_dis_personskat() -> personskat_par14_dis_personskat_med_ligningslov33(personskat_uden_ligningslov33())
| personskat_par14_dis_kilder() -> [
    personskat_par14_scenarie_kilde(None),
    PersonskatPar14Kilde(
        identifikation = "dis-delår-2026",
        beregningsfelt = Par14DisPersonligIndkomst,
        delårsbeløb_kroner = 250000,
        omregningsmetode = Par14ForholdsmæssigtLøbendeBeløb,
        faktisk_helårsbeløb_kroner = None
    )
]
| personskat_par14_arbejdsudleje_fakta() -> KildeskattelovArbejdsudlejeInput(
    identifikation = "arbejdsudleje-delår-2026",
    indkomstår = 2026,
    alder_ved_indkomstårets_udløb = 40,
    parter = KildeskattelovArbejdsudlejeParter(
        person_identifikation = "delårsperson",
        udenlandsk_arbejdsgiver_identifikation = "udenlandsk-udlejer",
        dansk_hvervgiver_identifikation = "dansk-hvervgiver",
        personstatus = ArbejdsudlejetIkkeOmfattetAfKsl1EllerKsl2Stk1Nr1,
        ansættelsesforhold = AnsatHosUdenlandskUdlejer,
        udlejerstatus = UdenlandskUdlejerUdenDanskFastDriftssted,
        hvervgiverstatus = DanskHvervgiverMedHjemtingEllerFastDriftssted
    ),
    arbejde = KildeskattelovArbejdsudlejeArbejde(
        arbejdssted = ArbejdePåDanskLandEllerSøterritorium,
        tilknytning = ArbejdeErKerneydelse,
        udskillelse = ArbejdetErIkkePermanentUdskilt
    ),
    dansk_beskatningsret = ArbejdsudlejeDanskBeskatningsretBekræftet,
    beskatningsvalg = EndeligArbejdsudlejeskatEfterPar48B,
    vederlag = DokumenteretArbejdsudlejevederlag(
        løn_bonus_provision_tillæg_kroner = 18000,
        ferie_og_afspadsering_kroner = 0,
        rejse_og_befordringsgodtgørelse_kroner = 2000,
        fri_kost_og_logi = IngenFriKostEllerLogi,
        andre_skattepligtige_personalegoder_kroner = 0
    ),
    udenlandsk_arbejdsgiverbidrag = Ligningslov8MUdenlandskArbejdsgiverbidragInput(
        bidrag_kroner = 0,
        bidrag_vedrører_indkomstår = 2026,
        obligatorisk = Falskt,
        omfattet_af_eu_socialsikringsforordning = Falskt,
        aftale_om_at_bidrag_påhviler_lønmodtageren = Falskt
    )
)
| personskat_par14_arbejdsudleje_personlig_indkomst() -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud,
    ordinære_forhold = personskat_ingen_ordinær_personlig_indkomst(),
    arbejdsudleje = [personskat_par14_arbejdsudleje_fakta()],
    underholdsbidrag = ligningslov10_11_tomt_årsinput(),
    børnebidragslov19_bidrag = børnebidragslov19_tomt_årsinput(),
    sømandsbeskatning = søbl5_til8_intet_årsinput()
)
| personskat_par14_arbejdsudleje_personskat() -> PersonskatInput(
    lønmodtager = PersonskatLønmodtagerInput(
        skatteår = 2026,
        kommune = København,
        bruttoløn_kroner = 300000,
        personlig_indkomst = personskat_par14_arbejdsudleje_personlig_indkomst(),
        erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
        ligningsfradrag = personskat_ingen_ligningsfradrag(),
        pension = personskat_ingen_pension(),
        personfradrag_alder_status = Fyldt18EllerGift,
        betaler_kirkeskat = Falskt
    ),
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_par14_scenarie_kapitalkilde(identifikation: Tekst, delårsbeløb_kroner: Heltal) -> PersonskatPar14Kilde(
    identifikation = identifikation,
    beregningsfelt = Par14Nettokapitalindkomst,
    delårsbeløb_kroner = delårsbeløb_kroner,
    omregningsmetode = Par14UændretEngangsbeløb,
    faktisk_helårsbeløb_kroner = None
)
| personskat_par14_scenarie_statslig_komponent(resultat: PersonskatPar14BeregningResultat, art: Par14Skattekomponentart) -> head(filter(resultat.statslige_skattekomponenter, |komponent: Par14SkattekomponentResultat| komponent.art == art))
| personskat_par14_scenarie_kommunal_komponent(resultat: PersonskatPar14BeregningResultat, art: Par14Skattekomponentart) -> head(filter(resultat.kommunale_og_kirkelige_skattekomponenter, |komponent: Par14SkattekomponentResultat| komponent.art == art))
| personskat_par14_scenarie_ligningslov33_komponent(resultat: PersonskatPar14BeregningResultat, art: Ligningslov33PersonSkattekomponentart) -> head(filter(resultat.efterfølgende_skat.ligningslov33.dansk_skattekreds.komponenter, |komponent: Ligningslov33DanskSkattekomponent| komponent.art == art))
| personskat_par14_scenarie_ordinær_statslig_skat_før_loft_øre(resultat: PersonskatPar14BeregningResultat) -> foldl(
    filter(resultat.statslige_skattekomponenter, |komponent: Par14SkattekomponentResultat| komponent.art != Par14EndeligAktieindkomstskat),
    0,
    |sum_øre: Heltal, komponent: Par14SkattekomponentResultat| sum_øre + komponent.delårsskat_øre
)
| personskat_par14_scenarie_skatteloftsnedslag_øre(resultat: PersonskatPar14BeregningResultat) -> foldl(resultat.skatteloftsnedslag, 0, |sum_øre: Heltal, komponent: Par14SkattekomponentResultat| sum_øre + komponent.delårsskat_øre)

= personskat_par14_stk1 = beregn_personskat_delår(personskat_par14_scenarie_input(
    skatteforhold = StandardSkatteforhold,
    ændring = FuldSkattepligtIndtræder,
    periode = PersonskatPar14Skattepligtsperiode(fra_dato = Dato(år = 2026, måned = 7, dag = 1), til_dato = Dato(år = 2026, måned = 12, dag = 31)),
    valg = Falskt,
    omvalg = None,
    faktisk_helårsbeløb_kroner = None
))
= personskat_par14_stk2 = beregn_personskat_delår(personskat_par14_scenarie_input(
    skatteforhold = StandardSkatteforhold,
    ændring = FuldSkattepligtIndtræder,
    periode = PersonskatPar14Skattepligtsperiode(fra_dato = Dato(år = 2026, måned = 7, dag = 1), til_dato = Dato(år = 2026, måned = 12, dag = 31)),
    valg = Sandt,
    omvalg = None,
    faktisk_helårsbeløb_kroner = Some(520000)
))
= personskat_par14_omvalg = beregn_personskat_delår(personskat_par14_scenarie_input(
    skatteforhold = StandardSkatteforhold,
    ændring = FuldSkattepligtIndtræder,
    periode = PersonskatPar14Skattepligtsperiode(fra_dato = Dato(år = 2026, måned = 7, dag = 1), til_dato = Dato(år = 2026, måned = 12, dag = 31)),
    valg = Sandt,
    omvalg = Some(Dato(år = 2028, måned = 6, dag = 30)),
    faktisk_helårsbeløb_kroner = Some(520000)
