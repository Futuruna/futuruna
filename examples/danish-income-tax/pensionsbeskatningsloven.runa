# Pensionsbeskatningslov53AResultat(indkomstår: Heltal, ordning: Pensionsbeskatningslov53AOrdning, omfangsresultat: Pbl53AOmfangsresultat, afkastregelregime: Pbl53AAfkastregelregime, regelregime_understøttet: Boolsk, ordning_bestod_i_indkomståret: Boolsk, omfattet_af_stk1: Boolsk, undtaget_efter_stk4: Boolsk, afkastmetode_tilladt_efter_udbyderopgørelse: Boolsk, metodevalg_bindende_opfyldt: Boolsk, afkast_efter_valgt_metode_kroner: Heltal, afkastandel_før_negativ_fremførsel_kroner: Heltal, fremført_negativt_afkast_anvendt_kroner: Heltal, skattepligtigt_afkast_kroner: Heltal, fremført_negativt_afkast_ultimo_kroner: Heltal, udbetaling_til_afkastskat_medregnes_kroner: Heltal, kapitalindkomst_kroner: Heltal)
| pbl53a_metodevalg_bindende_opfyldt(afkastmetode: Pensionsbeskatningslov53AAfkastmetode, metodehistorik: Pensionsbeskatningslov53AMetodehistorik) -> match metodehistorik {
    | Pbl53AFørsteAfkastopgørelse -> Sandt
    | Pbl53ATidligerePalOpgørelse -> afkastmetode == Pbl53AAfkastEfterPalPar3Til5
    | Pbl53ATidligereAlternativKapitalværdiOpgørelse -> afkastmetode == Pbl53AAlternativKapitalværdi
}
| pbl53a_afkastmetode_tilladt_efter_udbyderopgørelse(afkastmetode: Pensionsbeskatningslov53AAfkastmetode, pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget: Boolsk) -> match afkastmetode {
    | Pbl53AAfkastEfterPalPar3Til5 -> Sandt
    | Pbl53AAlternativKapitalværdi -> pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget == Falskt
}
| pbl53a_overgangsskæringsdato_nøgle() -> 19920218
| pbl53a_produkt_omfattet_af_arveundtagelsen(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, _, _, _) -> Sandt
    | _ -> Falskt
}
| pbl53a_erhvervelse_er_kvalificerende_arv(produkt: Pbl53AProduktfakta, erhvervelse: Pbl53AErhvervelseshændelse) -> erhvervelse.måde == Pbl53AErhvervetVedArv && pbl53a_produkt_omfattet_af_arveundtagelsen(produkt)

= pbl53a_overgangsvalg_kildemeta = Metadata(
    attachments = (
        TransitionSource(value = pensionsbeskatningsloven_lov1388_par5_nr2_og_par7_stk1),
        Guidance(value = skat_juridisk_vejledning_pbl53a_overgangsvalg),
        Practice(value = skat_skm2023_171_sr_pbl53a_arvevalg),
        Practice(value = skat_skm2025_658_lsr_pbl53a_blanketvalg),
    )
)
--@label:pensionsbeskatningsloven_par53a_overgangsvalg::meta:pbl53a_overgangsvalg_kildemeta--
----
§ 5. I lov nr. 429 af 26. juni 1998 om ændring af
pensionsbeskatningsloven, realrenteafgiftsloven, fondsbeskatningsloven,
kildeskatteloven og skattekontrolloven. (Filialer af EU-forsikringsselskaber
og -pengeinstitutter, symmetri i pensionsbeskatningen, afgift af aktieafkast
og afskaffelse af kvoteordningen) foretages følgende ændringer:

2. I § 6 indsættes som stk. 12:

»Stk. 12. En forsikringstager eller pensionsopsparer, der har en forsikring
eller pensionsordning, der er oprettet eller erhvervet før den 18. februar
1992, kan med virkning fra og med indkomståret 2004 vælge, at § 1, nr. 4, 5,
6 og 7, finder anvendelse på forsikringen eller pensionsordningen, såfremt
pensionsbeskatningslovens § 53 A eller § 53 B i øvrigt er anvendelig på
forsikringen eller pensionsordningen. Valget er bindende og skal træffes
inden den 1. januar 2006 eller i forbindelse med indtræden af fuld
skattepligt her til landet. Valget skal inden for fristen i 2. pkt. enten
meddeles Told- og Skattestyrelsen eller forsikringsselskabet m.v., såfremt
dette indgiver oplysninger til de statslige told- og skattemyndigheder efter
skattekontrollovens § 8 B. Valget får i så fald virkning fra og med det
tidspunkt, hvor Told- og Skattestyrelsen eller forsikringsselskabet m.v. får
oplysningen. De personer, som inden den 1. april 2005 træffer beslutning om,
at pensionsbeskatningslovens § 53 A eller § 53 B skal finde anvendelse på
forsikringen eller pensionsordningen, kan vælge, at beslutningen får
virkning fra og med den 1. januar 2004. I så fald gives Told- og
Skattestyrelsen eller forsikringsselskabet m.v. oplysning herom.«

§ 7

Stk. 1. Loven træder i kraft dagen efter bekendtgørelsen i Lovtidende, jf. dog
stk. 2-4.

Den juridiske vejledning 2026-1, afsnit C.A.10.4.2.5:

Landsskatterettens afgørelse i SKM2025.658.LSR medfører, at hvis skatteyder har
indsendt blanket 49.020 på et tidspunkt, hvor den gældende blanket ikke gav
mulighed for at vælge beskatning efter de nævnte bestemmelser, så skal
Skattestyrelsen acceptere, at der er valgt beskatning efter PBL § 53 A eller
§ 53 B, hvis skatteyder påberåber sig dette.

Det er derfor Skattestyrelsens opfattelse, at det skal accepteres, hvis
skatteyder, påberåber sig ikke at have valgt beskatning efter disse
bestemmelser. Det er med andre ord Skattestyrelsens opfattelse, at det ikke
skal komme skatteyder til ulempe, at den tidligere blanket 49.020 ikke har
været udarbejdet på en måde, hvor det tydeligt fremgår, hvorvidt der er
foretaget et valg om beskatning efter de nævnte bestemmelser.

Blanket 49.020 er ændret i juni 2023 sådan, at der efter dette tidspunkt findes
et afkrydsningsfelt, hvori der eksplicit skal vælges beskatning efter PBL § 53 A
eller § 53 B ved at krydse feltet af. Det er Skattestyrelsens opfattelse, at
Landsskatterettens afgørelse, alene angår situationer, hvor det er den tidligere
blanket 49.020 (uden afkrydsningsfelt), der er anvendt.

SKM2025.658.LSR:

På baggrund af skattemyndighedens praksis på området og de anvisninger, der er
givet på selve blanketten og i Den Juridiske Vejledning, finder
Landsskatteretten, at klageren med indsendelsen af blanket 49.020 - Erklæring L
har truffet et valg med fristafbrydende virkning i relation til bestemmelsen i
lov nr. 429 af 26. juni 1998, stk. 12.

Landsskatteretten finder endvidere, at klageren har valgt, at pensionsordningen
skal være omfattet af pensionsbeskatningslovens §§ 53 A eller 53 B. Den
omstændighed, at klageren har foretaget afkrydsning i en forkert rubrik i
blankettens afsnit 5, er uden betydning for valget.
----

--@begin::pensionsbeskatningsloven_par53a_overgangsvalg--
| pbl53a_overgangsvalg_lovens_ikrafttræden_nøgle() -> 20041222
| pbl53a_overgangsvalg_ordinær_frist_nøgle() -> 20060101
| pbl53a_overgangsvalg_tilbagevirkende_beslutningsfrist_nøgle() -> 20050401
| pbl53a_overgangsvalg_tilbagevirkende_startdato() -> Pbl15ADato(år = 2004, måned = 1, dag = 1)
| pbl53a_overgangsvalg_har_kvalificerende_arv_på_dato(fakta: Pbl53AOmfangsfakta, arvedato: Pbl15ADato) -> any(fakta.erhvervelser, |erhvervelse: Pbl53AErhvervelseshændelse| pbl15a_dato_nøgle(erhvervelse.tidspunkt.dato) == pbl15a_dato_nøgle(arvedato) && pbl53a_erhvervelse_er_kvalificerende_arv(fakta.produkt, erhvervelse))
| pbl53a_overgangsvalgfristfakta_gyldige(fakta: Pbl53AOmfangsfakta) -> match fakta.overgangsvalgfristfakta {
    | Pbl53AIntetOvergangsvalgfristgrundlag -> Sandt
    | Pbl53AFuldSkattepligtVedLovensIkrafttræden -> Sandt
    | Pbl53ASenereIndtrådtFuldSkattepligt(indtrædelsesdato, oplysningsfrist) -> pbl15a_dato_gyldig(indtrædelsesdato) && pbl15a_dato_gyldig(oplysningsfrist) && pbl15a_dato_nøgle(indtrædelsesdato) >= pbl53a_overgangsvalg_lovens_ikrafttræden_nøgle() && pbl15a_dato_nøgle(oplysningsfrist) >= pbl15a_dato_nøgle(indtrædelsesdato)
    | Pbl53ASenereArvUnderFuldSkattepligt(arvedato, oplysningsfrist, _, _, _) -> pbl15a_dato_gyldig(arvedato) && pbl15a_dato_gyldig(oplysningsfrist) && pbl15a_dato_nøgle(arvedato) >= pbl53a_overgangsvalg_lovens_ikrafttræden_nøgle() && pbl15a_dato_nøgle(oplysningsfrist) >= pbl15a_dato_nøgle(arvedato) && pbl53a_overgangsvalg_har_kvalificerende_arv_på_dato(fakta, arvedato)
}
| pbl53a_overgangsvalgfristgrundlag_findes(fristfakta: Pbl53AOvergangsvalgfristfakta) -> fristfakta != Pbl53AIntetOvergangsvalgfristgrundlag
| pbl53a_overgangsvalgmodtager_gyldig(modtager: Pbl53AOvergangsvalgmodtager) -> modtager != Pbl53AValgMeddeltAndenModtager
| pbl53a_overgangsvalg_datoer_rettidige(fristfakta: Pbl53AOvergangsvalgfristfakta, beslutningsdato: Pbl15ADato, modtagelsesdato: Pbl15ADato) -> {
    = beslutningsnøgle = pbl15a_dato_nøgle(beslutningsdato)
    = modtagelsesnøgle = pbl15a_dato_nøgle(modtagelsesdato)
    match fristfakta {
        | Pbl53AIntetOvergangsvalgfristgrundlag -> Falskt
        | Pbl53AFuldSkattepligtVedLovensIkrafttræden -> beslutningsnøgle >= pbl53a_overgangsvalg_lovens_ikrafttræden_nøgle() && modtagelsesnøgle >= pbl53a_overgangsvalg_lovens_ikrafttræden_nøgle() && beslutningsnøgle < pbl53a_overgangsvalg_ordinær_frist_nøgle() && modtagelsesnøgle < pbl53a_overgangsvalg_ordinær_frist_nøgle()
        | Pbl53ASenereIndtrådtFuldSkattepligt(indtrædelsesdato, oplysningsfrist) -> beslutningsnøgle >= pbl15a_dato_nøgle(indtrædelsesdato) && modtagelsesnøgle >= pbl15a_dato_nøgle(indtrædelsesdato) && beslutningsnøgle <= pbl15a_dato_nøgle(oplysningsfrist) && modtagelsesnøgle <= pbl15a_dato_nøgle(oplysningsfrist)
        | Pbl53ASenereArvUnderFuldSkattepligt(arvedato, oplysningsfrist, fuld_skattepligtig_på_arvedatoen, tidligere_ejer_fuld_skattepligtig_i_ejerperioden, tidligere_ejer_havde_valgt_afsnit_iia) -> fuld_skattepligtig_på_arvedatoen && tidligere_ejer_fuld_skattepligtig_i_ejerperioden == Falskt && tidligere_ejer_havde_valgt_afsnit_iia == Falskt && beslutningsnøgle >= pbl15a_dato_nøgle(arvedato) && modtagelsesnøgle >= pbl15a_dato_nøgle(arvedato) && beslutningsnøgle <= pbl15a_dato_nøgle(oplysningsfrist) && modtagelsesnøgle <= pbl15a_dato_nøgle(oplysningsfrist)
    }
}
| pbl53a_overgangsvalg_rettidigt(fristfakta: Pbl53AOvergangsvalgfristfakta, meddelelse: Pbl53AOvergangsvalgmeddelelse) -> pbl53a_overgangsvalg_datoer_rettidige(fristfakta, meddelelse.beslutningsdato, meddelelse.modtagelsesdato)
| pbl53a_overgangsvalg_virkning_tilladt_for_beslutning(fristfakta: Pbl53AOvergangsvalgfristfakta, beslutningsdato: Pbl15ADato, ønsket_virkning: Pbl53AOvergangsvalgvirkning) -> match ønsket_virkning {
    | Pbl53AValgVirkningFraModtagelse -> Sandt
    | Pbl53AValgVirkningFra1Januar2004 -> fristfakta == Pbl53AFuldSkattepligtVedLovensIkrafttræden && pbl15a_dato_nøgle(beslutningsdato) >= pbl53a_overgangsvalg_lovens_ikrafttræden_nøgle() && pbl15a_dato_nøgle(beslutningsdato) < pbl53a_overgangsvalg_tilbagevirkende_beslutningsfrist_nøgle()
}
| pbl53a_overgangsvalg_ønsket_virkning_tilladt(fristfakta: Pbl53AOvergangsvalgfristfakta, meddelelse: Pbl53AOvergangsvalgmeddelelse) -> pbl53a_overgangsvalg_virkning_tilladt_for_beslutning(fristfakta, meddelelse.beslutningsdato, meddelelse.ønsket_virkning)
| pbl53a_overgangsvalg_valgt_regime(mål: Pbl53AOvergangsvalgmål) -> match mål {
    | Pbl53AValgAfPar53A -> Pbl53AOvergangsvalgTilPar53A
    | Pbl53AValgAfPar53B -> Pbl53AOvergangsvalgTilPar53B
}
| pbl53a_overgangsvalg_vurderingsår(meddelelse: Pbl53AOvergangsvalgmeddelelse) -> match meddelelse.ønsket_virkning {
    | Pbl53AValgVirkningFraModtagelse -> meddelelse.modtagelsesdato.år
    | Pbl53AValgVirkningFra1Januar2004 -> 2004
}
| pbl53a_overgangsvalgmål_i_øvrigt_anvendeligt(mål: Pbl53AOvergangsvalgmål, vurderingsår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> match mål {
    | Pbl53AValgAfPar53A -> pbl53a_i_øvrigt_anvendelig(vurderingsår, fakta, hændelser)
    | Pbl53AValgAfPar53B -> pbl53b_i_øvrigt_anvendelig(vurderingsår, fakta, hændelser)
}
| pbl53a_overgangsvalg_virkningsstart(meddelelse: Pbl53AOvergangsvalgmeddelelse) -> match meddelelse.ønsket_virkning {
    | Pbl53AValgVirkningFraModtagelse -> Pbl53AModerneVirkningsstartFra(dato = meddelelse.modtagelsesdato)
    | Pbl53AValgVirkningFra1Januar2004 -> Pbl53AModerneVirkningsstartFra(dato = pbl53a_overgangsvalg_tilbagevirkende_startdato())
}
| pbl53a_overgangsvalg_virkningsstart_for_modtagelse(modtagelsesdato: Pbl15ADato, ønsket_virkning: Pbl53AOvergangsvalgvirkning) -> match ønsket_virkning {
    | Pbl53AValgVirkningFraModtagelse -> Pbl53AModerneVirkningsstartFra(dato = modtagelsesdato)
    | Pbl53AValgVirkningFra1Januar2004 -> Pbl53AModerneVirkningsstartFra(dato = pbl53a_overgangsvalg_tilbagevirkende_startdato())
}
| pbl53a_overgangsvalgmeddelelsesresultat(fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse), historisk_ordning_uden_valg: Boolsk, meddelelse: Pbl53AOvergangsvalgmeddelelse) -> {
    = datoer_gyldige = pbl15a_dato_gyldig(meddelelse.beslutningsdato) && pbl15a_dato_gyldig(meddelelse.modtagelsesdato)
    = beslutning_ikke_efter_modtagelse = datoer_gyldige && pbl15a_dato_nøgle(meddelelse.beslutningsdato) <= pbl15a_dato_nøgle(meddelelse.modtagelsesdato)
    = modtager_gyldig = pbl53a_overgangsvalgmodtager_gyldig(meddelelse.modtager)
    = fristgrundlag_gyldigt = pbl53a_overgangsvalgfristfakta_gyldige(fakta) && pbl53a_overgangsvalgfristgrundlag_findes(fakta.overgangsvalgfristfakta)
    = rettidig = fristgrundlag_gyldigt && datoer_gyldige && beslutning_ikke_efter_modtagelse && pbl53a_overgangsvalg_rettidigt(fakta.overgangsvalgfristfakta, meddelelse)
    = mål_i_øvrigt_anvendeligt = pbl53a_overgangsvalgmål_i_øvrigt_anvendeligt(meddelelse.mål, pbl53a_overgangsvalg_vurderingsår(meddelelse), fakta, hændelser)
    = ønsket_virkning_tilladt = pbl53a_overgangsvalg_ønsket_virkning_tilladt(fakta.overgangsvalgfristfakta, meddelelse)
    = meddelelse_opfylder_betingelser = datoer_gyldige && beslutning_ikke_efter_modtagelse && modtager_gyldig && fristgrundlag_gyldigt && rettidig && historisk_ordning_uden_valg && mål_i_øvrigt_anvendeligt && ønsket_virkning_tilladt
    Pbl53AOvergangsvalgmeddelelsesresultat(
        meddelelse = meddelelse,
        datoer_gyldige = datoer_gyldige,
        beslutning_ikke_efter_modtagelse = beslutning_ikke_efter_modtagelse,
        modtager_gyldig = modtager_gyldig,
        fristgrundlag_gyldigt = fristgrundlag_gyldigt,
        rettidig = rettidig,
        historisk_ordning_uden_valg = historisk_ordning_uden_valg,
        mål_i_øvrigt_anvendeligt = mål_i_øvrigt_anvendeligt,
        ønsket_virkning_tilladt = ønsket_virkning_tilladt,
        meddelelse_opfylder_betingelser = meddelelse_opfylder_betingelser,
        valgt_regime = pbl53a_overgangsvalg_valgt_regime(meddelelse.mål),
        virkningsstart = pbl53a_overgangsvalg_virkningsstart(meddelelse)
    )
}
| pbl53a_historisk_blanket_tidligere_udgave_uden_valgfelt(indsendelse: Pbl53AHistoriskBlanket49020Indsendelse) -> indsendelse.udgave == Pbl53ATidligereBlanket49020UdenValgfelt
| pbl53a_historisk_blanket_modtager_gyldig(indsendelse: Pbl53AHistoriskBlanket49020Indsendelse) -> indsendelse.modtager == Pbl53AValgMeddeltSkattestyrelsen
| pbl53a_historisk_blanket_valg_påberåbt(påberåbelse: Pbl53AHistoriskBlanketpåberåbelse) -> påberåbelse == Pbl53AValgEfterPar53AEllerPar53BPåberåbt
| pbl53a_historisk_blanket_intet_valg_påberåbt(påberåbelse: Pbl53AHistoriskBlanketpåberåbelse) -> påberåbelse == Pbl53AIntetValgEfterPar53AEllerPar53BPåberåbt
| pbl53a_historisk_blanket_vurderingsår(indsendelse: Pbl53AHistoriskBlanket49020Indsendelse) -> match indsendelse.ønsket_virkning {
    | Pbl53AValgVirkningFraModtagelse -> indsendelse.modtagelsesdato.år
    | Pbl53AValgVirkningFra1Januar2004 -> 2004
}
| pbl53a_historisk_blanket_afledt_regime(vurderingsår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> hvis pbl53b_i_øvrigt_anvendelig(vurderingsår, fakta, hændelser) { Pbl53AOvergangsvalgTilPar53B } ellers hvis pbl53a_i_øvrigt_anvendelig(vurderingsår, fakta, hændelser) { Pbl53AOvergangsvalgTilPar53A } ellers { Pbl53AIntetGyldigtOvergangsvalg }
| pbl53a_historisk_blanket49020_resultat(fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse), historisk_ordning_uden_valg: Boolsk, indsendelse: Pbl53AHistoriskBlanket49020Indsendelse) -> {
    = datoer_gyldige = pbl15a_dato_gyldig(indsendelse.indsendelsesdato) && pbl15a_dato_gyldig(indsendelse.modtagelsesdato)
    = indsendelse_ikke_efter_modtagelse = datoer_gyldige && pbl15a_dato_nøgle(indsendelse.indsendelsesdato) <= pbl15a_dato_nøgle(indsendelse.modtagelsesdato)
    = tidligere_udgave_uden_valgfelt = pbl53a_historisk_blanket_tidligere_udgave_uden_valgfelt(indsendelse)
    = modtager_gyldig = pbl53a_historisk_blanket_modtager_gyldig(indsendelse)
    = fristgrundlag_gyldigt = pbl53a_overgangsvalgfristfakta_gyldige(fakta) && pbl53a_overgangsvalgfristgrundlag_findes(fakta.overgangsvalgfristfakta)
    = rettidig = fristgrundlag_gyldigt && datoer_gyldige && indsendelse_ikke_efter_modtagelse && pbl53a_overgangsvalg_datoer_rettidige(fakta.overgangsvalgfristfakta, indsendelse.indsendelsesdato, indsendelse.modtagelsesdato)
    = valg_påberåbt = pbl53a_historisk_blanket_valg_påberåbt(indsendelse.påberåbelse)
    = intet_valg_påberåbt = pbl53a_historisk_blanket_intet_valg_påberåbt(indsendelse.påberåbelse)
    = vurderingsår = pbl53a_historisk_blanket_vurderingsår(indsendelse)
    = par53b_i_øvrigt_anvendelig = pbl53b_i_øvrigt_anvendelig(vurderingsår, fakta, hændelser)
    = par53a_i_øvrigt_anvendelig = pbl53a_i_øvrigt_anvendelig(vurderingsår, fakta, hændelser)
    = afledt_regime = pbl53a_historisk_blanket_afledt_regime(vurderingsår, fakta, hændelser)
    = mål_entydigt_afledt = afledt_regime != Pbl53AIntetGyldigtOvergangsvalg && par53a_i_øvrigt_anvendelig != par53b_i_øvrigt_anvendelig
    = ønsket_virkning_tilladt = pbl53a_overgangsvalg_virkning_tilladt_for_beslutning(fakta.overgangsvalgfristfakta, indsendelse.indsendelsesdato, indsendelse.ønsket_virkning)
    = indsendelse_opfylder_betingelser = datoer_gyldige && indsendelse_ikke_efter_modtagelse && tidligere_udgave_uden_valgfelt && modtager_gyldig && fristgrundlag_gyldigt && rettidig && historisk_ordning_uden_valg && valg_påberåbt && mål_entydigt_afledt && ønsket_virkning_tilladt
    Pbl53AHistoriskBlanket49020Resultat(
        indsendelse = indsendelse,
        datoer_gyldige = datoer_gyldige,
        indsendelse_ikke_efter_modtagelse = indsendelse_ikke_efter_modtagelse,
        tidligere_udgave_uden_valgfelt = tidligere_udgave_uden_valgfelt,
        modtager_gyldig = modtager_gyldig,
        fristgrundlag_gyldigt = fristgrundlag_gyldigt,
        rettidig = rettidig,
        historisk_ordning_uden_valg = historisk_ordning_uden_valg,
        valg_påberåbt = valg_påberåbt,
        intet_valg_påberåbt = intet_valg_påberåbt,
        par53a_i_øvrigt_anvendelig = par53a_i_øvrigt_anvendelig,
        par53b_i_øvrigt_anvendelig = par53b_i_øvrigt_anvendelig,
        mål_entydigt_afledt = mål_entydigt_afledt,
        ønsket_virkning_tilladt = ønsket_virkning_tilladt,
        indsendelse_opfylder_betingelser = indsendelse_opfylder_betingelser,
        afledt_regime = afledt_regime,
        virkningsstart = pbl53a_overgangsvalg_virkningsstart_for_modtagelse(indsendelse.modtagelsesdato, indsendelse.ønsket_virkning)
    )
}
| pbl53a_overgangsvalgpost_fra_meddelelsesresultat(resultat: Pbl53AOvergangsvalgmeddelelsesresultat) -> Pbl53AOvergangsvalgpost(
    modtagelsesdato = resultat.meddelelse.modtagelsesdato,
    datoer_gyldige = resultat.datoer_gyldige,
    valg_opfylder_betingelser = resultat.meddelelse_opfylder_betingelser,
    modstridende_valg_relevant = resultat.rettidig && resultat.modtager_gyldig && resultat.historisk_ordning_uden_valg && resultat.ønsket_virkning_tilladt,
    valgt_regime = resultat.valgt_regime,
    virkningsstart = resultat.virkningsstart
)
| pbl53a_overgangsvalgpost_fra_historisk_blanketresultat(resultat: Pbl53AHistoriskBlanket49020Resultat) -> Pbl53AOvergangsvalgpost(
    modtagelsesdato = resultat.indsendelse.modtagelsesdato,
    datoer_gyldige = resultat.datoer_gyldige,
    valg_opfylder_betingelser = resultat.indsendelse_opfylder_betingelser,
    modstridende_valg_relevant = resultat.rettidig && resultat.tidligere_udgave_uden_valgfelt && resultat.modtager_gyldig && resultat.historisk_ordning_uden_valg && resultat.valg_påberåbt && resultat.mål_entydigt_afledt && resultat.ønsket_virkning_tilladt,
    valgt_regime = resultat.afledt_regime,
    virkningsstart = resultat.virkningsstart
)
| pbl53a_overgangsvalgpost_sorteringsnøgle(post: Pbl53AOvergangsvalgpost) -> pbl15a_dato_nøgle(post.modtagelsesdato)
| pbl53a_overgangsvalgfold_tom() -> Pbl53AOvergangsvalgfold(
    seneste_modtagelsesdato_nøgle = 0,
    datoer_gyldige = Sandt,
    kronologiske = Sandt,
    valgt_regime = Pbl53AIntetGyldigtOvergangsvalg,
    virkningsstart = Pbl53AIngenModerneVirkningsstart,
    gyldige_meddelelser_antal = 0,
    senere_modstridende_valg = Falskt
)
| pbl53a_overgangsvalgfold_trin(tilstand: Pbl53AOvergangsvalgfold, post: Pbl53AOvergangsvalgpost) -> {
    = modtagelsesdato_nøgle = pbl15a_dato_nøgle(post.modtagelsesdato)
    = første_gyldige_valg = post.valg_opfylder_betingelser && tilstand.valgt_regime == Pbl53AIntetGyldigtOvergangsvalg
    = senere_modstridende_valg = post.modstridende_valg_relevant && tilstand.valgt_regime != Pbl53AIntetGyldigtOvergangsvalg && post.valgt_regime != tilstand.valgt_regime
    Pbl53AOvergangsvalgfold(
        seneste_modtagelsesdato_nøgle = modtagelsesdato_nøgle,
        datoer_gyldige = tilstand.datoer_gyldige && post.datoer_gyldige,
        kronologiske = tilstand.kronologiske && post.datoer_gyldige && modtagelsesdato_nøgle > tilstand.seneste_modtagelsesdato_nøgle,
        valgt_regime = hvis første_gyldige_valg { post.valgt_regime } ellers { tilstand.valgt_regime },
        virkningsstart = hvis første_gyldige_valg { post.virkningsstart } ellers { tilstand.virkningsstart },
        gyldige_meddelelser_antal = tilstand.gyldige_meddelelser_antal + hvis post.valg_opfylder_betingelser { 1 } ellers { 0 },
        senere_modstridende_valg = tilstand.senere_modstridende_valg || senere_modstridende_valg
    )
}
| pbl53a_overgangsvalgresultat(fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse), historisk_ordning_uden_valg: Boolsk) -> {
    = meddelelsesresultater = map(fakta.overgangsvalg, |meddelelse: Pbl53AOvergangsvalgmeddelelse| pbl53a_overgangsvalgmeddelelsesresultat(fakta, hændelser, historisk_ordning_uden_valg, meddelelse))
    = historiske_blanketresultater = map(fakta.historiske_blanket49020_indsendelser, |indsendelse: Pbl53AHistoriskBlanket49020Indsendelse| pbl53a_historisk_blanket49020_resultat(fakta, hændelser, historisk_ordning_uden_valg, indsendelse))
    = meddelelsesposter = map(meddelelsesresultater, pbl53a_overgangsvalgpost_fra_meddelelsesresultat)
    = historiske_blanketposter = map(historiske_blanketresultater, pbl53a_overgangsvalgpost_fra_historisk_blanketresultat)
    = meddelelsestilstand = foldl(meddelelsesposter, pbl53a_overgangsvalgfold_tom(), pbl53a_overgangsvalgfold_trin)
    = historisk_blankettilstand = foldl(historiske_blanketposter, pbl53a_overgangsvalgfold_tom(), pbl53a_overgangsvalgfold_trin)
    = sorterede_poster = sort_by(concat(meddelelsesposter, historiske_blanketposter), pbl53a_overgangsvalgpost_sorteringsnøgle)
    = tilstand = foldl(sorterede_poster, pbl53a_overgangsvalgfold_tom(), pbl53a_overgangsvalgfold_trin)
    = fristfakta_gyldige = pbl53a_overgangsvalgfristfakta_gyldige(fakta)
    = fakta_gyldige = fristfakta_gyldige && tilstand.datoer_gyldige && meddelelsestilstand.kronologiske && historisk_blankettilstand.kronologiske && tilstand.kronologiske
    = valg_gyldigt = fakta_gyldige && tilstand.valgt_regime != Pbl53AIntetGyldigtOvergangsvalg
    Pbl53AOvergangsvalgresultat(
        fakta_gyldige = fakta_gyldige,
        fristfakta_gyldige = fristfakta_gyldige,
        datoer_gyldige = tilstand.datoer_gyldige,
        meddelelser_kronologiske = meddelelsestilstand.kronologiske,
        historiske_blanketter_kronologiske = historisk_blankettilstand.kronologiske,
        indgivelser_entydige = tilstand.kronologiske,
        meddelelsesresultater = meddelelsesresultater,
        historiske_blanketresultater = historiske_blanketresultater,
        gyldige_meddelelser_antal = tilstand.gyldige_meddelelser_antal,
        valg_gyldigt = valg_gyldigt,
        valg_bindende = valg_gyldigt,
        valgt_regime = tilstand.valgt_regime,
        virkningsstart = tilstand.virkningsstart,
        senere_modstridende_valg = tilstand.senere_modstridende_valg
    )
}
--@end::pensionsbeskatningsloven_par53a_overgangsvalg--

= pbl53a_kontraktændring_kildemeta = Metadata(
    attachments = (
        TransitionSource(value = pensionsbeskatningsloven_lov569_par1_nr11_og_par6_stk1),
        Source(value = aftaleloven_lbk193_par6),
        Guidance(value = skat_juridisk_vejledning_pbl53a_overgang),
        Practice(value = skat_skm2013_481_sr_pbl53a_produktændring),
        Practice(value = skat_skm2023_406_lsr_pbl53a_overflytning),
    )
)
--@label:pensionsbeskatningsloven_par53a_kontraktaendringer::meta:pbl53a_kontraktændring_kildemeta--
----
Aftaleloven § 6, stk. 1:

Svar, som går ud på, at tilbud antages, men som på grund af tillæg,
indskrænkninger eller forbehold ikke stemmer med tilbudet, anses som afslag i
forbindelse med nyt tilbud.

Den juridiske vejledning 2026-1, afsnit C.A.10.4.2.3.6:

Aftalelovens regler betyder ved fortolkning af ikrafttrædelsesbestemmelsen, at
ændringer efter den 18. februar 1992 af en eksisterende forsikringsaftale mv.
fører til, at der foreligger en nyoprettet ordning, der omfattes af reglerne i
PBL § 53 A.

For forsikringer mv. oprettet før den 18. februar 1992 gælder, at ændringer, der
ikke er aftalt endeligt og bindende mellem forsikringstager eller den
pensionsberettigede og selskab før den 18. februar 1992, fører til, at der
foreligger en ny ordning omfattet af reglerne.

En formålsfortolkning indebærer, at i tilfælde, hvor en ændring af
forsikringsaftalen bringer mere uden for indkomstbeskatning, er forsikringen
omfattet af reglerne i PBL § 53 A.

SKM2013.481.SR:

Skatterådet kunne ikke bekræfte, at en pensionsordning, der er omfattet af
overgangsreglerne for pensionsbeskatningslovens § 50, bevarer sin skattemæssige
behandling efter pensionsbeskatningslovens § 50, når pensionsordningen ændres
fra et opsparingsprodukt (gennemsnitsrente) til et andet opsparingsprodukt
(markedsrenteprodukt).

SKM2023.406.LSR:

Efter en konkret vurdering finder Landsskatteretten, at der ved klagerens
flytning af forsikring fra Nordben til G1 er tale om en ændring i
forsikringspolicen, som fører til, at der foreligger en nyoprettet
forsikringsordning, som omfattes af pensionsbeskatningslovens § 53 A.
----

--@begin::pensionsbeskatningsloven_par53a_kontraktaendringer--
| pbl53a_kontraktændring_virkningstidspunkt_nøgle(tidspunkt: Pbl15ATidspunkt) -> pbl15a_dato_nøgle(tidspunkt.dato) * 1000000 + tidspunkt.rækkefølge_på_dagen
| pbl53a_forhåndsaftalefakta_gyldige(fakta: Pbl53AForhåndsaftalefakta, ændringsdato: Pbl15ADato) -> match fakta {
    | Pbl53AIngenDokumenteretForhåndsaftale -> Sandt
    | Pbl53ADokumenteretForhåndsaftale(bindende_fra_dato, _, _) -> pbl15a_dato_gyldig(bindende_fra_dato) && pbl15a_dato_nøgle(bindende_fra_dato) <= pbl15a_dato_nøgle(ændringsdato)
    | Pbl53AForhåndsaftaleUoplyst -> Falskt
}
| pbl53a_endeligt_og_bindende_aftalt_før_skæringsdatoen(fakta: Pbl53AForhåndsaftalefakta) -> match fakta {
    | Pbl53ADokumenteretForhåndsaftale(bindende_fra_dato, vilkår_fuldt_fastlagt, indtræder_uden_nyt_valg) -> pbl15a_dato_gyldig(bindende_fra_dato) && pbl15a_dato_nøgle(bindende_fra_dato) < pbl53a_overgangsskæringsdato_nøgle() && vilkår_fuldt_fastlagt && indtræder_uden_nyt_valg
    | _ -> Falskt
}
| pbl53a_kontraktændringsart_understøttet(art: Pbl53AKontraktændringsart) -> match art {
    | Pbl53AÅrligOpsparingspræmieForhøjet(_, Pbl53APræmieforhøjelsesgrundlagUoplyst) -> Falskt
    | Pbl53APræmiebetalingstidAfkortet(Pbl53APræmieafkortningsfølgeUoplyst) -> Falskt
    | Pbl53AForsikringGenoptagetEfterMisligholdelse(Pbl53AMisligholdelsesfølgeUoplyst, _) -> Falskt
    | Pbl53AHelBestandOverførtVedFusionOpkøbEllerOphør(Pbl53ABestandsoverførselsvilkårUoplyst) -> Falskt
    | Pbl53AAndenKontraktændring(_) -> Falskt
    | _ -> Sandt
}
| pbl53a_kontraktændringsart_grundfakta_gyldige(ændring: Pbl53AKontraktændring) -> match ændring.art {
    | Pbl53APræmiebetalingsperiodeForlænget(oprindelig_slutdato) -> pbl15a_dato_gyldig(oprindelig_slutdato) && pbl15a_dato_nøgle(oprindelig_slutdato) == pbl15a_dato_nøgle(ændring.virkningstidspunkt.dato)
    | Pbl53AÅrligOpsparingspræmieForhøjet(forhøjelse_kroner, grundlag) -> forhøjelse_kroner > 0 && grundlag != Pbl53APræmieforhøjelsesgrundlagUoplyst
    | Pbl53APræmiebetalingstidAfkortet(følge) -> følge != Pbl53APræmieafkortningsfølgeUoplyst
    | Pbl53AForsikringGenoptagetEfterMisligholdelse(følge, _) -> følge != Pbl53AMisligholdelsesfølgeUoplyst
    | Pbl53AIkkefastsatIndskudsretUdnyttet(indskud_kroner) -> indskud_kroner > 0
    | Pbl53ALøbendePræmieAfløstAfEngangsindskud(indskud_kroner) -> indskud_kroner > 0
    | Pbl53AHelBestandOverførtVedFusionOpkøbEllerOphør(vilkår) -> vilkår != Pbl53ABestandsoverførselsvilkårUoplyst
    | Pbl53ASelvvalgtOverflytningTilNyUdbyder(oprettelsesdato, _) -> pbl15a_dato_gyldig(oprettelsesdato) && pbl15a_dato_nøgle(oprettelsesdato) >= pbl53a_overgangsskæringsdato_nøgle() && pbl15a_dato_nøgle(oprettelsesdato) <= pbl15a_dato_nøgle(ændring.virkningstidspunkt.dato)
    | Pbl53AAndenKontraktændring(beskrivelse) -> beskrivelse != ""
    | _ -> Sandt
}
| pbl53a_ingen_ny_ordning_ved_kontraktændring() -> Pbl53AIngenNyOrdningVedKontraktændring
| pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring: Pbl53AKontraktændring) -> match ændring.kapitalværdi_på_virkningstidspunktet {
    | Pbl53AHeleOrdningensKapitalværdi(kroner) -> hvis kroner >= 0 { Pbl53AHeleOrdningenNyVedKontraktændring(ændringsidentifikation = ændring.identifikation, virkningstidspunkt = ændring.virkningstidspunkt, kapitalværdi_kroner = kroner) } ellers { Pbl53AKontraktændringUafklaret }
    | _ -> Pbl53AKontraktændringUafklaret
}
| pbl53a_del_ny_ved_kontraktændring(ændring: Pbl53AKontraktændring) -> match ændring.kapitalværdi_på_virkningstidspunktet {
    | Pbl53ANyeDelsKapitalværdi(kroner) -> hvis kroner >= 0 { Pbl53ADelNyVedKontraktændring(ændringsidentifikation = ændring.identifikation, virkningstidspunkt = ændring.virkningstidspunkt, kapitalværdi_kroner = kroner) } ellers { Pbl53AKontraktændringUafklaret }
    | _ -> Pbl53AKontraktændringUafklaret
}
| pbl53a_kontraktændringsvirkning_for_art(ændring: Pbl53AKontraktændring) -> match ændring.art {
    | Pbl53AForsikringsperiodeForlængetFørForsikringsbegivenhed -> pbl53a_del_ny_ved_kontraktændring(ændring)
    | Pbl53APræmiebetalingsperiodeForlænget(_) -> pbl53a_del_ny_ved_kontraktændring(ændring)
    | Pbl53AÅrligOpsparingspræmieForhøjet(_, grundlag) -> match grundlag {
        | Pbl53ANyPræmieforhøjelse -> pbl53a_del_ny_ved_kontraktændring(ændring)
        | Pbl53AAutomatiskPristalsreguleringUdenIndflydelse -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53AAutomatiskForhøjelseVedBonustilskrivning -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53AFørskæringsaftaltReguleringValgtLavere -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53APræmieforhøjelsesgrundlagUoplyst -> Pbl53AKontraktændringUafklaret
    }
    | Pbl53AForsikringForlængetVedForsikringsbegivenhed -> pbl53a_del_ny_ved_kontraktændring(ændring)
    | Pbl53APræmiebetalingstidAfkortet(følge) -> match følge {
        | Pbl53AKunPræmiebetalingstidenAfkortet -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
        | Pbl53APræmiebetalingstidAfkortetOgPræmieNedsat -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53APræmiebetalingBortfaldtVedFripolice -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53APræmiebetalingBortfaldtMedUændretForsikring -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53APræmieafkortningsfølgeUoplyst -> Pbl53AKontraktændringUafklaret
    }
    | Pbl53AFripoliceGenopskrevet -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
    | Pbl53AForsikringGenoptagetEfterMisligholdelse(følge, nye_helbredsoplysninger_krævet) -> hvis nye_helbredsoplysninger_krævet {
        pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
    } ellers {
        match følge {
            | Pbl53AForsikringsdækningOpretholdtUnderMisligholdelse -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
            | Pbl53AForsikringsaftaleBortfaldtUnderMisligholdelse -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
            | Pbl53AMisligholdelsesfølgeUoplyst -> Pbl53AKontraktændringUafklaret
        }
    }
    | Pbl53AIkkefastsatIndskudsretUdnyttet(_) -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
    | Pbl53ABedreHelbredsvilkårMedHøjereForsikringssum -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53ABedreHelbredsvilkårMedLaverePræmie -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53APræmiebetalingsterminÆndretIndenForÅret -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53ALøbendePræmieAfløstAfEngangsindskud(_) -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
    | Pbl53AGennemsnitsrenteSkiftetTilMarkedsrente -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
    | Pbl53AValutaÆndret -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53APorteføljemanagerUdskiftet -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53ADepotbankUdskiftet -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53APolicePantsat -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53ABegunstigetIndsatEllerTilbagekaldt -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53APoliceOpdeltUdenVilkårsændring -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
    | Pbl53AHelBestandOverførtVedFusionOpkøbEllerOphør(vilkår) -> match vilkår {
        | Pbl53ABestandOverførtPåUændredeVilkår -> pbl53a_ingen_ny_ordning_ved_kontraktændring()
        | Pbl53ABestandOverførtMedVilkårsændringer -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
        | Pbl53ABestandsoverførselsvilkårUoplyst -> Pbl53AKontraktændringUafklaret
    }
    | Pbl53ASelvvalgtOverflytningTilNyUdbyder(_, _) -> pbl53a_hele_ordningen_ny_ved_kontraktændring(ændring)
    | Pbl53AAndenKontraktændring(_) -> Pbl53AKontraktændringUafklaret
}
| pbl53a_kapitalværdi_matcher_kontraktændringsvirkning(kapitalværdi: Pbl53AKapitalværdiVedKontraktændring, virkning: Pbl53AKontraktændringsvirkning) -> match virkning {
    | Pbl53AIngenNyOrdningVedKontraktændring -> kapitalværdi == Pbl53AKapitalværdiIkkeRelevant
    | Pbl53AHeleOrdningenNyVedKontraktændring(_, _, kroner) -> kapitalværdi == Pbl53AHeleOrdningensKapitalværdi(kroner = kroner)
    | Pbl53ADelNyVedKontraktændring(_, _, kroner) -> kapitalværdi == Pbl53ANyeDelsKapitalværdi(kroner = kroner)
    | Pbl53AKontraktændringUafklaret -> Falskt
}
| pbl53a_kontraktændringsresultat(oprettelsesdato: Pbl15ADato, ændring: Pbl53AKontraktændring) -> {
    = datoer_gyldige = pbl15a_dato_gyldig(ændring.ændringsdato) && pbl15a_dato_gyldig(ændring.virkningstidspunkt.dato) && ændring.virkningstidspunkt.rækkefølge_på_dagen >= 0
    = ændring_ikke_efter_virkning = datoer_gyldige && pbl15a_dato_nøgle(ændring.ændringsdato) <= pbl15a_dato_nøgle(ændring.virkningstidspunkt.dato)
    = efter_oprettelsen = datoer_gyldige && pbl15a_dato_nøgle(ændring.ændringsdato) >= pbl15a_dato_nøgle(oprettelsesdato) && pbl15a_dato_nøgle(ændring.virkningstidspunkt.dato) >= pbl15a_dato_nøgle(oprettelsesdato)
    = forhåndsaftalefakta_gyldige = pbl53a_forhåndsaftalefakta_gyldige(ændring.forhåndsaftale, ændring.ændringsdato)
    = endeligt_og_bindende_aftalt_før_skæringsdatoen = pbl53a_endeligt_og_bindende_aftalt_før_skæringsdatoen(ændring.forhåndsaftale) || pbl15a_dato_nøgle(ændring.ændringsdato) < pbl53a_overgangsskæringsdato_nøgle()
    = ændringsart_understøttet = pbl53a_kontraktændringsart_understøttet(ændring.art)
    = grundfakta_gyldige = ændring.identifikation != "" && pbl15a_dato_gyldig(oprettelsesdato) && datoer_gyldige && ændring_ikke_efter_virkning && efter_oprettelsen && forhåndsaftalefakta_gyldige && ændringsart_understøttet && pbl53a_kontraktændringsart_grundfakta_gyldige(ændring)
    = foreløbig_virkning = hvis grundfakta_gyldige == Falskt {
        Pbl53AKontraktændringUafklaret
    } ellers hvis pbl15a_dato_nøgle(ændring.virkningstidspunkt.dato) < pbl53a_overgangsskæringsdato_nøgle() || endeligt_og_bindende_aftalt_før_skæringsdatoen {
        pbl53a_ingen_ny_ordning_ved_kontraktændring()
    } ellers {
        pbl53a_kontraktændringsvirkning_for_art(ændring)
    }
    = kapitalværdi_entydig = pbl53a_kapitalværdi_matcher_kontraktændringsvirkning(ændring.kapitalværdi_på_virkningstidspunktet, foreløbig_virkning)
    = ændring_gyldig = grundfakta_gyldige && kapitalværdi_entydig
    = virkning = hvis ændring_gyldig { foreløbig_virkning } ellers { Pbl53AKontraktændringUafklaret }
    Pbl53AKontraktændringsresultat(
        ændring = ændring,
        datoer_gyldige = datoer_gyldige,
        ændring_ikke_efter_virkning = ændring_ikke_efter_virkning,
        efter_oprettelsen = efter_oprettelsen,
        forhåndsaftalefakta_gyldige = forhåndsaftalefakta_gyldige,
        endeligt_og_bindende_aftalt_før_skæringsdatoen = endeligt_og_bindende_aftalt_før_skæringsdatoen,
        ændringsart_understøttet = ændringsart_understøttet,
        kapitalværdi_entydig = kapitalværdi_entydig,
        ændring_gyldig = ændring_gyldig,
        virkning = virkning
    )
}
| pbl53a_kontraktændringsidentifikation_unik(ændringer: List(Pbl53AKontraktændring), ændring: Pbl53AKontraktændring) -> length(filter(ændringer, |anden: Pbl53AKontraktændring| anden.identifikation == ændring.identifikation)) == 1
| pbl53a_kontraktændringsidentifikationer_entydige(ændringer: List(Pbl53AKontraktændring)) -> all(ændringer, |ændring: Pbl53AKontraktændring| ændring.identifikation != "" && pbl53a_kontraktændringsidentifikation_unik(ændringer, ændring))
| pbl53a_kontraktændringsrækkefølge_trin(tilstand: Pbl53AKontraktændringsrækkefølgetilstand, resultat: Pbl53AKontraktændringsresultat) -> {
    = nøgle = pbl53a_kontraktændring_virkningstidspunkt_nøgle(resultat.ændring.virkningstidspunkt)
    Pbl53AKontraktændringsrækkefølgetilstand(
        seneste_virkningstidspunkt_nøgle = nøgle,
        kronologiske = tilstand.kronologiske && resultat.datoer_gyldige && nøgle > tilstand.seneste_virkningstidspunkt_nøgle
    )
}
| pbl53a_kontraktændringsvirkning_er_hel(virkning: Pbl53AKontraktændringsvirkning) -> match virkning {
    | Pbl53AHeleOrdningenNyVedKontraktændring(_, _, _) -> Sandt
    | _ -> Falskt
}
| pbl53a_kontraktændringsvirkning_er_delvis(virkning: Pbl53AKontraktændringsvirkning) -> match virkning {
    | Pbl53ADelNyVedKontraktændring(_, _, _) -> Sandt
    | _ -> Falskt
}
| pbl53a_kontraktændringsvirkning_er_uafklaret(virkning: Pbl53AKontraktændringsvirkning) -> virkning == Pbl53AKontraktændringUafklaret
| pbl53a_kontraktændringsresultat_matcher_del(resultat: Pbl53AKontraktændringsresultat, ændringsidentifikation: Tekst) -> match resultat.virkning {
    | Pbl53ADelNyVedKontraktændring(identifikation, _, _) -> identifikation == ændringsidentifikation
    | _ -> Falskt
}
| pbl53a_kontraktdelsrepræsentation_gyldig(repræsentation: Pbl53AKontraktdelsrepræsentation, oprindelig_moderne_virkningsstart: Pbl53AModerneVirkningsstart, resultater: List(Pbl53AKontraktændringsresultat)) -> match repræsentation {
    | Pbl53AHeleKontrakten -> oprindelig_moderne_virkningsstart != Pbl53AIngenModerneVirkningsstart || length(filter(resultater, |resultat: Pbl53AKontraktændringsresultat| pbl53a_kontraktændringsvirkning_er_delvis(resultat.virkning))) == 0
    | Pbl53AHistoriskRestEfterDelviseKontraktændringer -> length(filter(resultater, |resultat: Pbl53AKontraktændringsresultat| pbl53a_kontraktændringsvirkning_er_delvis(resultat.virkning))) > 0
    | Pbl53ADelSkabtVedKontraktændring(ændringsidentifikation) -> ændringsidentifikation != "" && length(filter(resultater, |resultat: Pbl53AKontraktændringsresultat| pbl53a_kontraktændringsresultat_matcher_del(resultat, ændringsidentifikation))) == 1
}
| pbl53a_tidligste_moderne_virkningsstart(nuværende: Pbl53AModerneVirkningsstart, kandidat: Pbl53AModerneVirkningsstart) -> match nuværende {
    | Pbl53AIngenModerneVirkningsstart -> kandidat
    | Pbl53AModerneVirkningsstartFra(nuværende_dato) -> match kandidat {
        | Pbl53AIngenModerneVirkningsstart -> nuværende
        | Pbl53AModerneVirkningsstartFra(kandidat_dato) -> hvis pbl15a_dato_nøgle(kandidat_dato) < pbl15a_dato_nøgle(nuværende_dato) { kandidat } ellers { nuværende }
    }
}
| pbl53a_tidligste_moderne_afkastvirkningsgrænse(nuværende: Pbl53AModerneAfkastvirkningsgrænse, kandidat: Pbl53AModerneAfkastvirkningsgrænse) -> match nuværende {
    | Pbl53AIngenModerneAfkastvirkningsgrænse -> kandidat
    | Pbl53AKendtModerneAfkastvirkningsgrænse(_, nuværende_tidspunkt, _) -> match kandidat {
        | Pbl53AKendtModerneAfkastvirkningsgrænse(_, kandidat_tidspunkt, _) -> hvis pbl15a_tidspunkt_før(kandidat_tidspunkt, nuværende_tidspunkt) { kandidat } ellers { nuværende }
        | _ -> nuværende
    }
    | Pbl53AModerneAfkastvirkningsgrænseUdenKapitalværdi(_, _) -> nuværende
}
| pbl53a_kontraktændringsstart_for_repræsentation(resultat: Pbl53AKontraktændringsresultat, repræsentation: Pbl53AKontraktdelsrepræsentation) -> match resultat.virkning {
    | Pbl53AHeleOrdningenNyVedKontraktændring(_, virkningstidspunkt, _) -> Pbl53AModerneVirkningsstartFra(dato = virkningstidspunkt.dato)
    | Pbl53ADelNyVedKontraktændring(ændringsidentifikation, virkningstidspunkt, _) -> match repræsentation {
        | Pbl53ADelSkabtVedKontraktændring(repræsenteret_ændringsidentifikation) -> hvis ændringsidentifikation == repræsenteret_ændringsidentifikation { Pbl53AModerneVirkningsstartFra(dato = virkningstidspunkt.dato) } ellers { Pbl53AIngenModerneVirkningsstart }
        | _ -> Pbl53AIngenModerneVirkningsstart
    }
    | _ -> Pbl53AIngenModerneVirkningsstart
}
| pbl53a_kontraktændringsafkastgrænse_for_repræsentation(resultat: Pbl53AKontraktændringsresultat, repræsentation: Pbl53AKontraktdelsrepræsentation) -> match resultat.virkning {
    | Pbl53AHeleOrdningenNyVedKontraktændring(ændringsidentifikation, virkningstidspunkt, kapitalværdi_kroner) -> Pbl53AKendtModerneAfkastvirkningsgrænse(kilde = Pbl53AVirkningFraKontraktændring(ændringsidentifikation = ændringsidentifikation), tidspunkt = virkningstidspunkt, kapitalværdi_kroner = kapitalværdi_kroner)
    | Pbl53ADelNyVedKontraktændring(ændringsidentifikation, virkningstidspunkt, kapitalværdi_kroner) -> match repræsentation {
        | Pbl53ADelSkabtVedKontraktændring(repræsenteret_ændringsidentifikation) -> hvis ændringsidentifikation == repræsenteret_ændringsidentifikation { Pbl53AKendtModerneAfkastvirkningsgrænse(kilde = Pbl53AVirkningFraKontraktændring(ændringsidentifikation = ændringsidentifikation), tidspunkt = virkningstidspunkt, kapitalværdi_kroner = kapitalværdi_kroner) } ellers { Pbl53AIngenModerneAfkastvirkningsgrænse }
        | _ -> Pbl53AIngenModerneAfkastvirkningsgrænse
    }
    | _ -> Pbl53AIngenModerneAfkastvirkningsgrænse
}
| pbl53a_kontraktændringsforløbsresultat(fakta: Pbl53AOmfangsfakta, oprindelig_moderne_virkningsstart: Pbl53AModerneVirkningsstart, oprindelig_moderne_afkastvirkningsgrænse: Pbl53AModerneAfkastvirkningsgrænse) -> {
    = ændringsresultater = map(fakta.kontraktændringer, |ændring: Pbl53AKontraktændring| pbl53a_kontraktændringsresultat(fakta.oprettelsesdato, ændring))
    = rækkefølge = foldl(ændringsresultater, Pbl53AKontraktændringsrækkefølgetilstand(seneste_virkningstidspunkt_nøgle = 0, kronologiske = Sandt), pbl53a_kontraktændringsrækkefølge_trin)
    = identifikationer_entydige = pbl53a_kontraktændringsidentifikationer_entydige(fakta.kontraktændringer)
    = datoer_gyldige = all(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| resultat.datoer_gyldige && resultat.ændring_ikke_efter_virkning)
    = alle_efter_oprettelsen = all(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| resultat.efter_oprettelsen)
    = alle_ændringsarter_understøttede = all(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| resultat.ændringsart_understøttet)
    = alle_kapitalværdier_entydige = all(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| resultat.kapitalværdi_entydig)
    = repræsentation_gyldig = pbl53a_kontraktdelsrepræsentation_gyldig(fakta.repræsenteret_kontraktdel, oprindelig_moderne_virkningsstart, ændringsresultater)
    = moderne_virkningsstart = foldl(ændringsresultater, oprindelig_moderne_virkningsstart, |nuværende: Pbl53AModerneVirkningsstart, resultat: Pbl53AKontraktændringsresultat| pbl53a_tidligste_moderne_virkningsstart(nuværende, pbl53a_kontraktændringsstart_for_repræsentation(resultat, fakta.repræsenteret_kontraktdel)))
    = moderne_afkastvirkningsgrænse = foldl(ændringsresultater, oprindelig_moderne_afkastvirkningsgrænse, |nuværende: Pbl53AModerneAfkastvirkningsgrænse, resultat: Pbl53AKontraktændringsresultat| pbl53a_tidligste_moderne_afkastvirkningsgrænse(nuværende, pbl53a_kontraktændringsafkastgrænse_for_repræsentation(resultat, fakta.repræsenteret_kontraktdel)))
    = uafklarede_ændringer_antal = length(filter(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| pbl53a_kontraktændringsvirkning_er_uafklaret(resultat.virkning)))
    = fakta_gyldige = identifikationer_entydige && datoer_gyldige && rækkefølge.kronologiske && alle_efter_oprettelsen && alle_ændringsarter_understøttede && alle_kapitalværdier_entydige && repræsentation_gyldig && all(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| resultat.ændring_gyldig) && uafklarede_ændringer_antal == 0
    Pbl53AKontraktændringsforløbsresultat(
        fakta_gyldige = fakta_gyldige,
        identifikationer_entydige = identifikationer_entydige,
        datoer_gyldige = datoer_gyldige,
        ændringer_kronologiske = rækkefølge.kronologiske,
        alle_efter_oprettelsen = alle_efter_oprettelsen,
        alle_ændringsarter_understøttede = alle_ændringsarter_understøttede,
        alle_kapitalværdier_entydige = alle_kapitalværdier_entydige,
        repræsentation_gyldig = repræsentation_gyldig,
        ændringsresultater = ændringsresultater,
        hele_nye_ordninger_antal = length(filter(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| pbl53a_kontraktændringsvirkning_er_hel(resultat.virkning))),
        delvise_nye_ordninger_antal = length(filter(ændringsresultater, |resultat: Pbl53AKontraktændringsresultat| pbl53a_kontraktændringsvirkning_er_delvis(resultat.virkning))),
        uafklarede_ændringer_antal = uafklarede_ændringer_antal,
        moderne_virkningsstart = moderne_virkningsstart,
        moderne_afkastvirkningsgrænse = moderne_afkastvirkningsgrænse
    )
}
--@end::pensionsbeskatningsloven_par53a_kontraktaendringer--

| pbl53a_moderne_virkningsstart_fra_oprettelse(oprettelsesdato: Pbl15ADato) -> hvis pbl15a_dato_nøgle(oprettelsesdato) >= pbl53a_overgangsskæringsdato_nøgle() { Pbl53AModerneVirkningsstartFra(dato = oprettelsesdato) } ellers { Pbl53AIngenModerneVirkningsstart }
| pbl53a_moderne_afkastvirkningsgrænse_fra_oprettelse(fakta: Pbl53AOmfangsfakta) -> hvis pbl15a_dato_nøgle(fakta.oprettelsesdato) >= pbl53a_overgangsskæringsdato_nøgle() && fakta.kapitalværdi_ved_oprettelsen_kroner >= 0 {
    Pbl53AKendtModerneAfkastvirkningsgrænse(
        kilde = Pbl53AVirkningFraOprettelse,
        tidspunkt = Pbl15ATidspunkt(dato = fakta.oprettelsesdato, rækkefølge_på_dagen = 0),
        kapitalværdi_kroner = fakta.kapitalværdi_ved_oprettelsen_kroner
    )
} ellers {
    Pbl53AIngenModerneAfkastvirkningsgrænse
}
| pbl53a_moderne_virkningsstart_fra_erhvervelse(nuværende: Pbl53AModerneVirkningsstart, produkt: Pbl53AProduktfakta, erhvervelse: Pbl53AErhvervelseshændelse) -> match nuværende {
    | Pbl53AModerneVirkningsstartFra(_) -> nuværende
    | Pbl53AIngenModerneVirkningsstart -> hvis pbl15a_dato_nøgle(erhvervelse.tidspunkt.dato) >= pbl53a_overgangsskæringsdato_nøgle() && pbl53a_erhvervelse_er_kvalificerende_arv(produkt, erhvervelse) == Falskt { Pbl53AModerneVirkningsstartFra(dato = erhvervelse.tidspunkt.dato) } ellers { Pbl53AIngenModerneVirkningsstart }
}
| pbl53a_moderne_afkastvirkningsgrænse_fra_erhvervelse(nuværende: Pbl53AModerneAfkastvirkningsgrænse, produkt: Pbl53AProduktfakta, erhvervelse: Pbl53AErhvervelseshændelse) -> hvis pbl15a_dato_nøgle(erhvervelse.tidspunkt.dato) >= pbl53a_overgangsskæringsdato_nøgle() && pbl53a_erhvervelse_er_kvalificerende_arv(produkt, erhvervelse) == Falskt && erhvervelse.kapitalværdi_på_erhvervelsestidspunktet_kroner >= 0 {
    pbl53a_tidligste_moderne_afkastvirkningsgrænse(nuværende, Pbl53AKendtModerneAfkastvirkningsgrænse(
        kilde = Pbl53AVirkningFraErhvervelse(erhvervelsesidentifikation = erhvervelse.identifikation),
        tidspunkt = erhvervelse.tidspunkt,
        kapitalværdi_kroner = erhvervelse.kapitalværdi_på_erhvervelsestidspunktet_kroner
    ))
} ellers {
    nuværende
}
| pbl53a_erhvervelsesidentifikation_unik(erhvervelser: List(Pbl53AErhvervelseshændelse), erhvervelse: Pbl53AErhvervelseshændelse) -> length(filter(erhvervelser, |anden: Pbl53AErhvervelseshændelse| anden.identifikation == erhvervelse.identifikation)) == 1
| pbl53a_erhvervelsesidentifikationer_entydige(erhvervelser: List(Pbl53AErhvervelseshændelse)) -> all(erhvervelser, |erhvervelse: Pbl53AErhvervelseshændelse| erhvervelse.identifikation != "" && pbl53a_erhvervelsesidentifikation_unik(erhvervelser, erhvervelse))
| pbl53a_luk_rettighedsperiode(periode: Pbl53ARettighedsperiode, erhvervelse: Pbl53AErhvervelseshændelse) -> Pbl53ARettighedsperiode(
    identifikation = periode.identifikation,
    reference = periode.reference,
    rettighedshaver_identifikation = periode.rettighedshaver_identifikation,
    starttidspunkt = periode.starttidspunkt,
    kapitalværdi_ved_starten_kroner = periode.kapitalværdi_ved_starten_kroner,
    slutning = Pbl53ARettighedsperiodeSlutter(
        erhvervelse_identifikation = erhvervelse.identifikation,
        tidspunkt = erhvervelse.tidspunkt,
        kapitalværdi_ved_slutningen_kroner = erhvervelse.kapitalværdi_på_erhvervelsestidspunktet_kroner
    )
)
| pbl53a_ny_rettighedsperiode(erhvervelse: Pbl53AErhvervelseshændelse) -> Pbl53ARettighedsperiode(
    identifikation = erhvervelse.identifikation,
    reference = Pbl53ARettighedsperiodeFraErhvervelse(erhvervelsesidentifikation = erhvervelse.identifikation),
    rettighedshaver_identifikation = erhvervelse.erhverver_identifikation,
    starttidspunkt = erhvervelse.tidspunkt,
    kapitalværdi_ved_starten_kroner = erhvervelse.kapitalværdi_på_erhvervelsestidspunktet_kroner,
    slutning = Pbl53AÅbenRettighedsperiode
)
| pbl53a_rettighedsperioder_fra_fold(tilstand: Pbl53AErhvervelsesfold) -> concat(tilstand.afsluttede_rettighedsperioder, [tilstand.aktuel_rettighedsperiode])
| pbl53a_erhvervelsesfold_trin(oprettelsesdato: Pbl15ADato, produkt: Pbl53AProduktfakta, tilstand: Pbl53AErhvervelsesfold, erhvervelse: Pbl53AErhvervelseshændelse) -> {
    = oprettelsestidspunkt = Pbl15ATidspunkt(dato = oprettelsesdato, rækkefølge_på_dagen = 0)
    = dato_gyldig = pbl15a_tidspunkt_gyldigt(erhvervelse.tidspunkt)
    = kronologisk = hvis dato_gyldig { pbl15a_tidspunkt_før(tilstand.seneste_tidspunkt, erhvervelse.tidspunkt) } ellers { Falskt }
    = efter_oprettelsen = hvis dato_gyldig { pbl15a_tidspunkt_før(oprettelsestidspunkt, erhvervelse.tidspunkt) } ellers { Falskt }
    = rettighedskæde_sammenhængende = erhvervelse.overdrager_identifikation != "" && erhvervelse.erhverver_identifikation != "" && erhvervelse.overdrager_identifikation != erhvervelse.erhverver_identifikation && erhvervelse.overdrager_identifikation == tilstand.aktuel_rettighedshaver_identifikation && erhvervelse.kapitalværdi_på_erhvervelsestidspunktet_kroner >= 0
    = erhvervelse_gyldig = dato_gyldig && kronologisk && efter_oprettelsen && rettighedskæde_sammenhængende
    = afsluttede_rettighedsperioder = hvis erhvervelse_gyldig { concat(tilstand.afsluttede_rettighedsperioder, [pbl53a_luk_rettighedsperiode(tilstand.aktuel_rettighedsperiode, erhvervelse)]) } ellers { tilstand.afsluttede_rettighedsperioder }
    = aktuel_rettighedsperiode = hvis erhvervelse_gyldig { pbl53a_ny_rettighedsperiode(erhvervelse) } ellers { tilstand.aktuel_rettighedsperiode }
    Pbl53AErhvervelsesfold(
        seneste_tidspunkt = hvis dato_gyldig && kronologisk { erhvervelse.tidspunkt } ellers { tilstand.seneste_tidspunkt },
        datoer_gyldige = tilstand.datoer_gyldige && dato_gyldig,
        kronologiske = tilstand.kronologiske && kronologisk,
        alle_efter_oprettelsen = tilstand.alle_efter_oprettelsen && efter_oprettelsen,
        rettighedskæde_sammenhængende = tilstand.rettighedskæde_sammenhængende && rettighedskæde_sammenhængende,
        aktuel_rettighedshaver_identifikation = hvis erhvervelse_gyldig { erhvervelse.erhverver_identifikation } ellers { tilstand.aktuel_rettighedshaver_identifikation },
        aktuel_rettighedsperiode = aktuel_rettighedsperiode,
        afsluttede_rettighedsperioder = afsluttede_rettighedsperioder,
        moderne_virkningsstart = hvis erhvervelse_gyldig { pbl53a_moderne_virkningsstart_fra_erhvervelse(tilstand.moderne_virkningsstart, produkt, erhvervelse) } ellers { tilstand.moderne_virkningsstart },
        kvalificerende_arv_efter_skæringsdato = tilstand.kvalificerende_arv_efter_skæringsdato || erhvervelse_gyldig && pbl15a_dato_nøgle(erhvervelse.tidspunkt.dato) >= pbl53a_overgangsskæringsdato_nøgle() && pbl53a_erhvervelse_er_kvalificerende_arv(produkt, erhvervelse)
    )
}
| pbl53a_moderne_virkningsstart_efter_overgangsvalg(erhvervelsesstart: Pbl53AModerneVirkningsstart, valgresultat: Pbl53AOvergangsvalgresultat) -> match erhvervelsesstart {
    | Pbl53AModerneVirkningsstartFra(_) -> erhvervelsesstart
    | Pbl53AIngenModerneVirkningsstart -> hvis valgresultat.valg_gyldigt { valgresultat.virkningsstart } ellers { Pbl53AIngenModerneVirkningsstart }
}
| pbl53a_moderne_afkastvirkningsgrænse_efter_overgangsvalg(tidligere_grænse: Pbl53AModerneAfkastvirkningsgrænse, valgresultat: Pbl53AOvergangsvalgresultat) -> match tidligere_grænse {
    | Pbl53AIngenModerneAfkastvirkningsgrænse -> hvis valgresultat.valg_gyldigt {
        match valgresultat.virkningsstart {
            | Pbl53AModerneVirkningsstartFra(dato) -> Pbl53AModerneAfkastvirkningsgrænseUdenKapitalværdi(kilde = Pbl53AVirkningFraOvergangsvalg, dato = dato)
            | Pbl53AIngenModerneVirkningsstart -> Pbl53AIngenModerneAfkastvirkningsgrænse
        }
    } ellers {
        Pbl53AIngenModerneAfkastvirkningsgrænse
    }
    | _ -> tidligere_grænse
}
| pbl53a_overgangsresultat(fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> {
    = oprettelsestidspunkt = Pbl15ATidspunkt(dato = fakta.oprettelsesdato, rækkefølge_på_dagen = 0)
    = tilstand = foldl(
        fakta.erhvervelser,
        Pbl53AErhvervelsesfold(
            seneste_tidspunkt = oprettelsestidspunkt,
            datoer_gyldige = Sandt,
            kronologiske = Sandt,
            alle_efter_oprettelsen = Sandt,
            rettighedskæde_sammenhængende = Sandt,
            aktuel_rettighedshaver_identifikation = fakta.oprindelig_rettighedshaver_identifikation,
            aktuel_rettighedsperiode = Pbl53ARettighedsperiode(
                identifikation = "oprettelse",
                reference = Pbl53ARettighedsperiodeFraOprettelsen,
                rettighedshaver_identifikation = fakta.oprindelig_rettighedshaver_identifikation,
                starttidspunkt = oprettelsestidspunkt,
                kapitalværdi_ved_starten_kroner = fakta.kapitalværdi_ved_oprettelsen_kroner,
                slutning = Pbl53AÅbenRettighedsperiode
            ),
            afsluttede_rettighedsperioder = [],
            moderne_virkningsstart = pbl53a_moderne_virkningsstart_fra_oprettelse(fakta.oprettelsesdato),
            kvalificerende_arv_efter_skæringsdato = Falskt
        ),
        |fold: Pbl53AErhvervelsesfold, erhvervelse: Pbl53AErhvervelseshændelse| pbl53a_erhvervelsesfold_trin(fakta.oprettelsesdato, fakta.produkt, fold, erhvervelse)
    )
    = oprindelig_moderne_afkastvirkningsgrænse = pbl53a_moderne_afkastvirkningsgrænse_fra_oprettelse(fakta)
    = erhvervelsesgrænse = foldl(fakta.erhvervelser, oprindelig_moderne_afkastvirkningsgrænse, |nuværende: Pbl53AModerneAfkastvirkningsgrænse, erhvervelse: Pbl53AErhvervelseshændelse| pbl53a_moderne_afkastvirkningsgrænse_fra_erhvervelse(nuværende, fakta.produkt, erhvervelse))
    = erhvervelsesidentifikationer_entydige = pbl53a_erhvervelsesidentifikationer_entydige(fakta.erhvervelser)
    = erhvervelsesfakta_gyldige = pbl15a_dato_gyldig(fakta.oprettelsesdato) && fakta.oprindelig_rettighedshaver_identifikation != "" && fakta.kapitalværdi_ved_oprettelsen_kroner >= 0 && erhvervelsesidentifikationer_entydige && tilstand.datoer_gyldige && tilstand.kronologiske && tilstand.alle_efter_oprettelsen && tilstand.rettighedskæde_sammenhængende
    = kontraktændringsresultat = pbl53a_kontraktændringsforløbsresultat(fakta, tilstand.moderne_virkningsstart, erhvervelsesgrænse)
    = historisk_ordning_uden_valg = erhvervelsesfakta_gyldige && kontraktændringsresultat.fakta_gyldige && kontraktændringsresultat.moderne_virkningsstart == Pbl53AIngenModerneVirkningsstart
    = valgresultat = pbl53a_overgangsvalgresultat(fakta, hændelser, historisk_ordning_uden_valg)
    = moderne_virkningsstart = pbl53a_moderne_virkningsstart_efter_overgangsvalg(kontraktændringsresultat.moderne_virkningsstart, valgresultat)
    = moderne_afkastvirkningsgrænse = pbl53a_moderne_afkastvirkningsgrænse_efter_overgangsvalg(kontraktændringsresultat.moderne_afkastvirkningsgrænse, valgresultat)
    = fakta_gyldige = erhvervelsesfakta_gyldige && kontraktændringsresultat.fakta_gyldige && valgresultat.fakta_gyldige
    = historisk_regime = fakta_gyldige && moderne_virkningsstart == Pbl53AIngenModerneVirkningsstart
    Pbl53AOvergangsresultat(
        fakta_gyldige = fakta_gyldige,
        erhvervelsesidentifikationer_entydige = erhvervelsesidentifikationer_entydige,
        erhvervelsesdatoer_gyldige = tilstand.datoer_gyldige,
        erhvervelser_kronologiske = tilstand.kronologiske,
        alle_erhvervelser_efter_oprettelsen = tilstand.alle_efter_oprettelsen,
        rettighedskæde_sammenhængende = tilstand.rettighedskæde_sammenhængende,
        rettighedsperioder = pbl53a_rettighedsperioder_fra_fold(tilstand),
        kontraktændringsresultat = kontraktændringsresultat,
        valgresultat = valgresultat,
        moderne_virkningsstart = moderne_virkningsstart,
        moderne_afkastvirkningsgrænse = moderne_afkastvirkningsgrænse,
        arveundtagelse_bevarer_historisk_regime = historisk_regime && tilstand.kvalificerende_arv_efter_skæringsdato,
        historisk_par50_eller_statsskattelov = historisk_regime
    )
}
| pbl53a_moderne_regler_har_virkning_i_indkomstår(overgang: Pbl53AOvergangsresultat, indkomstår: Heltal) -> overgang.fakta_gyldige && match overgang.moderne_virkningsstart {
    | Pbl53AModerneVirkningsstartFra(dato) -> dato.år <= indkomstår
    | Pbl53AIngenModerneVirkningsstart -> Falskt
}
| pbl53a_afkastregelregime(indkomstår: Heltal, overgang: Pbl53AOvergangsresultat) -> hvis pbl53a_moderne_regler_har_virkning_i_indkomstår(overgang, indkomstår) == Falskt {
    Pbl53AHistorikIkkeUnderstøttet
} ellers hvis indkomstår <= 2009 {
    Pbl53AHistoriskKapitalværdiTilOgMed2009
} ellers {
    Pbl53AModerneMetodevalgFra2010
}
| pbl53a_afkastregelregime_understøttet(regime: Pbl53AAfkastregelregime) -> regime != Pbl53AHistorikIkkeUnderstøttet
| pbl53a_afkastmetode_tilladt_i_regime(regime: Pbl53AAfkastregelregime, afkastmetode: Pensionsbeskatningslov53AAfkastmetode, pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget: Boolsk) -> match regime {
    | Pbl53AHistoriskKapitalværdiTilOgMed2009 -> afkastmetode == Pbl53AAlternativKapitalværdi
    | Pbl53AModerneMetodevalgFra2010 -> pbl53a_afkastmetode_tilladt_efter_udbyderopgørelse(afkastmetode, pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget)
    | Pbl53AHistorikIkkeUnderstøttet -> Falskt
}
| pbl53a_metodevalg_bindende_i_regime(regime: Pbl53AAfkastregelregime, afkastmetode: Pensionsbeskatningslov53AAfkastmetode, metodehistorik: Pensionsbeskatningslov53AMetodehistorik) -> match regime {
    | Pbl53AHistoriskKapitalværdiTilOgMed2009 -> afkastmetode == Pbl53AAlternativKapitalværdi
    | Pbl53AModerneMetodevalgFra2010 -> pbl53a_metodevalg_bindende_opfyldt(afkastmetode, metodehistorik)
    | Pbl53AHistorikIkkeUnderstøttet -> Falskt
}

# Pensionsbeskatningslov53ASag(input: Pensionsbeskatningslov53AInput) {
    | afkastregelregime() -> pbl53a_afkastregelregime(input.indkomstår, input.omfangsresultat.overgangsresultat)
    | regelregime_understøttet() -> pbl53a_afkastregelregime_understøttet(afkastregelregime())
    | ordning_bestod_i_indkomståret() -> input.indkomstår >= input.omfangsresultat.fakta.oprettelsesdato.år
    | omfattet_af_stk1() -> input.omfangsresultat.omfattes_af_par53a && pbl53a_omfang_klassifikation_matcher_ordning(input.omfangsresultat, input.ordning)
    | undtaget_efter_stk4() -> input.omfangsresultat.undtaget_efter_stk4
    | afkastmetode_tilladt_efter_udbyderopgørelse() -> pbl53a_afkastmetode_tilladt_i_regime(afkastregelregime(), input.afkastmetode, input.pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget)
    | metodevalg_bindende_opfyldt() -> pbl53a_metodevalg_bindende_i_regime(afkastregelregime(), input.afkastmetode, input.metodehistorik)
    | beløb_medregnes_efter_stk3() -> regelregime_understøttet() && ordning_bestod_i_indkomståret() && omfattet_af_stk1() && undtaget_efter_stk4() == Falskt && afkastmetode_tilladt_efter_udbyderopgørelse() && metodevalg_bindende_opfyldt()
    | afkast_efter_valgt_metode_kroner() -> input.afkast_efter_pal_par3_til_5_kroner under input.afkastmetode == Pbl53AAfkastEfterPalPar3Til5
    | exception pbl53a_alternativ_kapitalværdi_afkast afkast_efter_valgt_metode_kroner() -> (input.kapitalværdi_ultimo_kroner + penge_positivt_beløb(input.udbetalinger_i_året_kroner)) - (input.kapitalværdi_primo_kroner + penge_positivt_beløb(input.indbetalinger_i_året_kroner)) under input.afkastmetode == Pbl53AAlternativKapitalværdi
    | andel_nævner() -> penge_største_beløb(input.andel_nævner, 1)
    | afkastandel_før_negativ_fremførsel_kroner() -> afkast_efter_valgt_metode_kroner() * penge_positivt_beløb(input.andel_tæller) / andel_nævner()
    | fremført_negativt_afkast_primo_kroner() -> penge_positivt_beløb(input.fremført_negativt_afkast_primo_kroner)
    | fremført_negativt_afkast_anvendt_kroner() -> 0
    | exception pbl53a_fremført_negativt_afkast_modregnes fremført_negativt_afkast_anvendt_kroner() -> penge_mindste_beløb(penge_positivt_beløb(afkastandel_før_negativ_fremførsel_kroner()), fremført_negativt_afkast_primo_kroner()) under beløb_medregnes_efter_stk3()
    | skattepligtigt_afkast_kroner() -> 0
    | exception pbl53a_positivt_afkast_medregnes skattepligtigt_afkast_kroner() -> penge_positivt_beløb(afkastandel_før_negativ_fremførsel_kroner()) - fremført_negativt_afkast_anvendt_kroner() under beløb_medregnes_efter_stk3()
    | fremført_negativt_afkast_ultimo_kroner() -> 0
    | exception pbl53a_negativt_afkast_fremføres fremført_negativt_afkast_ultimo_kroner() -> fremført_negativt_afkast_primo_kroner() - fremført_negativt_afkast_anvendt_kroner() + penge_positivt_beløb(0 - afkastandel_før_negativ_fremførsel_kroner()) under beløb_medregnes_efter_stk3()
    | udbetaling_til_afkastskat_medregnes_kroner() -> hvis beløb_medregnes_efter_stk3() { penge_positivt_beløb(input.udbetaling_til_afkastskat_kroner) } ellers { 0 }
    | kapitalindkomst_kroner() -> skattepligtigt_afkast_kroner()
    | resultat() -> Pensionsbeskatningslov53AResultat(
        indkomstår = input.indkomstår,
        ordning = input.ordning,
        omfangsresultat = input.omfangsresultat,
        afkastregelregime = afkastregelregime(),
        regelregime_understøttet = regelregime_understøttet(),
        ordning_bestod_i_indkomståret = ordning_bestod_i_indkomståret(),
        omfattet_af_stk1 = omfattet_af_stk1(),
        undtaget_efter_stk4 = undtaget_efter_stk4(),
        afkastmetode_tilladt_efter_udbyderopgørelse = afkastmetode_tilladt_efter_udbyderopgørelse(),
        metodevalg_bindende_opfyldt = metodevalg_bindende_opfyldt(),
        afkast_efter_valgt_metode_kroner = afkast_efter_valgt_metode_kroner(),
        afkastandel_før_negativ_fremførsel_kroner = afkastandel_før_negativ_fremførsel_kroner(),
        fremført_negativt_afkast_anvendt_kroner = fremført_negativt_afkast_anvendt_kroner(),
        skattepligtigt_afkast_kroner = skattepligtigt_afkast_kroner(),
        fremført_negativt_afkast_ultimo_kroner = fremført_negativt_afkast_ultimo_kroner(),
        udbetaling_til_afkastskat_medregnes_kroner = udbetaling_til_afkastskat_medregnes_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| pensionsbeskatningslov53a_sag(input: Pensionsbeskatningslov53AInput) -> Pensionsbeskatningslov53ASag(input)
| pensionsbeskatningslov53a_resultat(input: Pensionsbeskatningslov53AInput) -> pensionsbeskatningslov53a_sag(input).resultat()

# Pbl53ATidspunkt(dato: Pbl15ADato, rækkefølge_på_dagen: Heltal)
# Pbl53ASenesteTidspunkt = Pbl53AIntetTidspunkt | Pbl53ARegistreretTidspunkt(tidspunkt: Pbl53ATidspunkt)
# Pbl53AUdsendelsessted = Pbl53AFremmedStat | Pbl53AFærøerne | Pbl53AGrønland | Pbl53ADanmark
# Pbl53AUdsendelsesfakta(startdato: Pbl15ADato, slutdato: Pbl15ADato, sted: Pbl53AUdsendelsessted, fælles_bopæl_hele_perioden: Boolsk, indbetaling_til_afsnit_i_eller_iia_under_udsendelsen: Boolsk)
# Pbl53AIndbetalingsperiode = Pbl53AIndbetaltMensOrdningenErOmfattet | Pbl53AHistoriskIndbetalingFørOrdningenBlevOmfattet
# Pbl53AEjerensFradragsstatus = Pbl53AUdenFradragsEllerBortseelsesret | Pbl53AFradragEllerBortseelsesretIDanmark | Pbl53AFradragEllerBortseelsesretIUdlandet | Pbl53AFradragEllerBortseelsesretIDanmarkOgUdlandet
# Pbl53AIndbetaler = Pbl53AEjeren | Pbl53ANuværendeArbejdsgiver | Pbl53ATidligereArbejdsgiver | Pbl53AÆgtefællesEllerSamleversArbejdsgiver(udsendelse: Pbl53AUdsendelsesfakta) | Pbl53AAndenIndbetaler
# Pbl53AIndbetalingsfakta(identifikation: Tekst, tidspunkt: Pbl53ATidspunkt, beløb_kroner: Heltal, periode: Pbl53AIndbetalingsperiode, indbetaler: Pbl53AIndbetaler, ejerens_fradragsstatus: Pbl53AEjerensFradragsstatus, par53b_udenlandsk_skattebehandling: Pbl53BUdenlandskIndbetalingsbehandling)
# Pbl53AIndbetalingsresultat(fakta: Pbl53AIndbetalingsfakta, fakta_gyldige: Boolsk, medfølgende_ægtefælle_eller_samlever_omfattet: Boolsk, eget_fradrag_i_skattepligtig_indkomst_kroner: Heltal, arbejdsgiverfradrag_for_sikkerhedsstillelse_kroner: Heltal, personlig_indkomst_kroner: Heltal, arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner: Heltal, fradrags_eller_bortseelsesberettiget_principal_tilføjet_kroner: Heltal)
# Pbl53AUdbetalingsmodtager = Pbl53AEjer | Pbl53APensionsberettiget | Pbl53ABerettigetEfterEjerensEllerPensionsberettigedesDød | Pbl53AAndenUdbetalingsmodtager
# Pbl53AKapitaludbetalingsgrund = Pbl53APensionsudbetalingsalder | Pbl53AInvaliditet | Pbl53ALivstruendeSygdom | Pbl53ADød | Pbl53AAndenUdbetalingsgrund
# Pbl53AUdbetalingsform = Pbl53AIkkeSamletKapitaludbetaling | Pbl53ASamletKapitaludbetaling(grund: Pbl53AKapitaludbetalingsgrund)
# Pbl53AProduktart = Pbl53ATilsvarerDanskKapitalforsikringEllerOpsparing | Pbl53AAndenProduktart
# Pbl53AUdbetalingsart = Pbl53AUdbetalingFraOrdningen(kapitalværdi_umiddelbart_før_udbetalingen_kroner: Heltal, produktart: Pbl53AProduktart, udbetalingsform: Pbl53AUdbetalingsform, pbl20_stk6_kildefakta: Pbl20Stk6KildeFakta) | Pbl53AUdbetalingTilAfkastskat(kapitalværdi_umiddelbart_før_udbetalingen_kroner: Heltal, afkast_indkomstår: Heltal, dokumenteret_endelig_afkastskat_kroner: Heltal, dokumentationsdato: Pbl15ADato, pbl20_stk6_kildefakta: Pbl20Stk6KildeFakta) | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(sikkerhedsstillelse_eller_tidligere_sikkerhedsstillelse_kroner: Heltal)
# Pbl53AUdbetalingsfakta(identifikation: Tekst, tidspunkt: Pbl53ATidspunkt, modtager: Pbl53AUdbetalingsmodtager, bruttoudbetaling_kroner: Heltal, art: Pbl53AUdbetalingsart)
# Pbl53AUdbetalingsresultat(fakta: Pbl53AUdbetalingsfakta, fakta_gyldige: Boolsk, modtager_omfattet_af_par55: Boolsk, afkastskatteudbetaling_rettidig: Boolsk, fradrags_eller_bortseelsesberettiget_principal_før_kroner: Heltal, principal_fordelt_til_udbetalingen_kroner: Heltal, principal_medregnet_før_75_procent_kroner: Heltal, kapitalregel_75_procent_anvendt: Boolsk, sikkerhedsstillelse_modsvarer_udbetaling_kroner: Heltal, personlig_indkomst_kroner: Heltal, arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner: Heltal, pbl20_stk6_resultat: Pbl20Stk6Resultat)
# Pbl53AHændelse = Pbl53AIndbetaling(fakta: Pbl53AIndbetalingsfakta) | Pbl53AUdbetaling(fakta: Pbl53AUdbetalingsfakta)
# Pbl53AHændelsesresultat = Pbl53AIndbetalingBeregnet(resultat: Pbl53AIndbetalingsresultat) | Pbl53AUdbetalingBeregnet(resultat: Pbl53AUdbetalingsresultat)
# Pbl53AForløbsinput(indkomstår: Heltal, ordning: Pensionsbeskatningslov53AOrdning, omfangsresultat: Pbl53AOmfangsresultat, hændelser: List(Pbl53AHændelse))
# Pbl53AForløbstilstand(seneste_tidspunkt: Pbl53ASenesteTidspunkt, hændelsesresultater: List(Pbl53AHændelsesresultat), alle_hændelser_kronologiske: Boolsk, alle_hændelser_gyldige: Boolsk, resterende_fradrags_eller_bortseelsesberettiget_principal_kroner: Heltal, personlig_indkomst_i_indkomståret_kroner: Heltal, arbejdsmarkedsbidragspligtig_personlig_indkomst_i_indkomståret_kroner: Heltal, arbejdsgiverfradrag_i_indkomståret_kroner: Heltal, udenlandsk_indkomstskat_til_ligningslov33_i_indkomståret_kroner: Heltal)
# Pbl53AForløbsresultat(input: Pbl53AForløbsinput, hændelsesresultater: List(Pbl53AHændelsesresultat), identifikationer_entydige: Boolsk, hændelser_kronologiske: Boolsk, alle_hændelser_gyldige: Boolsk, input_gyldigt: Boolsk, resterende_fradrags_eller_bortseelsesberettiget_principal_kroner: Heltal, personlig_indkomst_kroner: Heltal, arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner: Heltal, arbejdsgiverfradrag_kroner: Heltal, udenlandsk_indkomstskat_til_ligningslov33_kroner: Heltal)

| pbl53a_kapitel1fakta_gyldige(fakta: Pbl53AKapitel1Fakta) -> match fakta {
    | Pbl53ATidligereGodkendtEfterPar15D(godkendt_fra, godkendt_til) -> pbl15a_dato_gyldig(godkendt_fra) && pbl15a_dato_gyldig(godkendt_til) && pbl15a_dato_nøgle(godkendt_fra) <= pbl15a_dato_nøgle(godkendt_til)
    | _ -> Sandt
}
| pbl53a_ikke_omfattet_af_kapitel1(fakta: Pbl53AKapitel1Fakta) -> fakta == Pbl53AIkkeOmfattetAfKapitel1
| pbl53a_omfattet_af_kapitel1(fakta: Pbl53AKapitel1Fakta) -> fakta == Pbl53AOmfattetAfKapitel1
| pbl53a_tidligere_par15d_udløbet_før_indkomstår(fakta: Pbl53AKapitel1Fakta, indkomstår: Heltal) -> match fakta {
    | Pbl53ATidligereGodkendtEfterPar15D(_, godkendt_til) -> godkendt_til.år < indkomstår
    | _ -> Falskt
}
| pbl53a_direktørberettigelse_gyldig(berettigelse: Pbl53ADirektørberettigelse) -> match berettigelse {
    | Pbl53ADirektørenSomBerettiget(identifikation) -> identifikation != ""
    | Pbl53AEfterladtEfterDirektør(identifikation, direktør_identifikation) -> identifikation != "" && direktør_identifikation != ""
    | Pbl53AAndenDirektørpensionsberettiget(_) -> Falskt
}
| pbl53a_direktørpensionstilsagn_gyldigt(tilsagn: Pbl53ADirektørpensionstilsagnsfakta) -> tilsagn.identifikation != "" && tilsagn.ansættelsesforhold_identifikation != "" && length(tilsagn.berettigede) > 0 && all(tilsagn.berettigede, pbl53a_direktørberettigelse_gyldig)
| pbl53a_direktørsikkerhed_gyldig(sikkerhed: Pbl53ADirektørsikkerhedsfakta) -> match sikkerhed {
    | Pbl53AIngenDirektørsikkerhed -> Sandt
    | Pbl53ASikkerhedForDirektørpensionstilsagn(tilsagn) -> pbl53a_direktørpensionstilsagn_gyldigt(tilsagn)
}
| pbl53a_har_direktørsikkerhed(sikkerhed: Pbl53ADirektørsikkerhedsfakta) -> match sikkerhed {
    | Pbl53ASikkerhedForDirektørpensionstilsagn(_) -> Sandt
    | _ -> Falskt
}
| pbl53a_pensionskassekarakteristika_opfyldt(karakteristika: Pbl53APensionskassekarakteristika) -> karakteristika.selvstændig_juridisk_person && karakteristika.uafhængig_af_arbejdsgiver && karakteristika.midler_afsondret_fra_berettigedes_formue && karakteristika.vedtægter_fastlægger_pensionsydelser
| pbl53a_institutionssted_gyldigt(sted: Pbl53AInstitutionssted) -> match sted {
    | Pbl53AUdenlandskInstitution(stat) -> stat != ""
    | _ -> Sandt
}
| pbl53a_udenlandsk_institution(sted: Pbl53AInstitutionssted) -> match sted {
    | Pbl53AUdenlandskInstitution(_) -> Sandt
    | _ -> Falskt
}
| pbl53a_pengeinstitutkarakteristika_opfyldt(karakteristika: Pbl53APengeinstitutkarakteristika) -> karakteristika.standardiseret_lovreguleret_pensionsprodukt && karakteristika.pensionsmidler_adskilt_fra_øvrig_formue && karakteristika.kan_disponeres_som_almindelig_bankkonto == Falskt
| pbl53a_livsforsikringsvilkår_gyldige(vilkår: Pbl53ALivsforsikringsvilkår) -> length(vilkår.dækninger) > 0 && pbl15a_dato_gyldig(vilkår.aftalt_udløbsdato) && pbl15a_dato_gyldig(vilkår.første_policedag_efter_fyldte_80_år)
| pbl53a_direktørsikkerhed_konsistent_med_kapitel1(sikkerhed: Pbl53ADirektørsikkerhedsfakta, kapitel1fakta: Pbl53AKapitel1Fakta) -> pbl53a_har_direktørsikkerhed(sikkerhed) == Falskt || pbl53a_ikke_omfattet_af_kapitel1(kapitel1fakta)
| pbl53a_produktfakta_gyldige(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(ejer_identifikation, forsikret_identifikation, kapitel1fakta, vilkår, direktørsikkerhed) -> ejer_identifikation != "" && forsikret_identifikation != "" && pbl53a_kapitel1fakta_gyldige(kapitel1fakta) && pbl53a_livsforsikringsvilkår_gyldige(vilkår) && pbl53a_direktørsikkerhed_gyldig(direktørsikkerhed) && pbl53a_direktørsikkerhed_konsistent_med_kapitel1(direktørsikkerhed, kapitel1fakta)
    | Pbl53APensionskasseprodukt(pensionsberettiget_identifikation, kapitel1fakta, _, direktørsikkerhed) -> pensionsberettiget_identifikation != "" && pbl53a_kapitel1fakta_gyldige(kapitel1fakta) && pbl53a_direktørsikkerhed_gyldig(direktørsikkerhed) && pbl53a_direktørsikkerhed_konsistent_med_kapitel1(direktørsikkerhed, kapitel1fakta)
    | Pbl53ASygeOgUlykkesforsikringsprodukt(ejer_identifikation, forsikret_identifikation) -> ejer_identifikation != "" && forsikret_identifikation != ""
    | Pbl53AGarantiforsikringsprodukt(tilsagn) -> pbl53a_direktørpensionstilsagn_gyldigt(tilsagn)
    | Pbl53APengeEllerKreditinstitutprodukt(kontohaver_identifikation, kapitel1fakta, institutionssted, _) -> kontohaver_identifikation != "" && pbl53a_kapitel1fakta_gyldige(kapitel1fakta) && pbl53a_institutionssted_gyldigt(institutionssted)
}
| pbl53a_produkt_karakteristika_opfyldt(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53APensionskasseprodukt(_, _, karakteristika, _) -> pbl53a_pensionskassekarakteristika_opfyldt(karakteristika)
    | Pbl53ASygeOgUlykkesforsikringsprodukt(ejer_identifikation, forsikret_identifikation) -> ejer_identifikation == forsikret_identifikation
    | Pbl53APengeEllerKreditinstitutprodukt(_, _, _, karakteristika) -> pbl53a_pengeinstitutkarakteristika_opfyldt(karakteristika)
    | _ -> Sandt
}
| pbl53a_produkt_kapitel1fakta(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, kapitel1fakta, _, _) -> kapitel1fakta
    | Pbl53APensionskasseprodukt(_, kapitel1fakta, _, _) -> kapitel1fakta
    | Pbl53APengeEllerKreditinstitutprodukt(_, kapitel1fakta, _, _) -> kapitel1fakta
    | _ -> Pbl53AIkkeOmfattetAfKapitel1
}
| pbl53a_afsnit_i_valgfakta_grundgyldige(valg: Pbl53AAfsnitIValgfakta) -> match valg {
    | Pbl53AAfkaldPåAfsnitI(afgiver_identifikation, _, afgivet_dato) -> afgiver_identifikation != "" && pbl15a_dato_gyldig(afgivet_dato)
    | _ -> Sandt
}
| pbl53a_afkald_givet_ved_oprettelsen(valg: Pbl53AAfsnitIValgfakta, oprettelsesdato: Pbl15ADato) -> match valg {
    | Pbl53AAfkaldPåAfsnitI(_, _, afgivet_dato) -> pbl15a_dato_nøgle(afgivet_dato) == pbl15a_dato_nøgle(oprettelsesdato)
    | _ -> Falskt
}
| pbl53a_afkald_matcher_produkt(produkt: Pbl53AProduktfakta, valg: Pbl53AAfsnitIValgfakta, oprettelsesdato: Pbl15ADato) -> match valg {
    | Pbl53AIntetAfkaldPåAfsnitI -> Sandt
    | Pbl53AAfkaldPåAfsnitI(afgiver_identifikation, afgiver, _) -> pbl53a_afkald_givet_ved_oprettelsen(valg, oprettelsesdato) && match produkt {
        | Pbl53ALivsforsikringsprodukt(ejer_identifikation, _, kapitel1fakta, _, direktørsikkerhed) -> pbl53a_omfattet_af_kapitel1(kapitel1fakta) && pbl53a_har_direktørsikkerhed(direktørsikkerhed) == Falskt && afgiver == Pbl53AForsikringsejerSomAfkaldsgiver && afgiver_identifikation == ejer_identifikation
        | Pbl53APensionskasseprodukt(pensionsberettiget_identifikation, kapitel1fakta, _, direktørsikkerhed) -> pbl53a_omfattet_af_kapitel1(kapitel1fakta) && pbl53a_har_direktørsikkerhed(direktørsikkerhed) == Falskt && afgiver == Pbl53APensionsberettigetSomAfkaldsgiver && afgiver_identifikation == pensionsberettiget_identifikation
        | Pbl53APengeEllerKreditinstitutprodukt(kontohaver_identifikation, kapitel1fakta, _, _) -> pbl53a_omfattet_af_kapitel1(kapitel1fakta) && afgiver == Pbl53AKontohaverSomAfkaldsgiver && afgiver_identifikation == kontohaver_identifikation
        | _ -> Falskt
    }
}
| pbl53a_afsnit_i_valgfakta_konsistente(fakta: Pbl53AOmfangsfakta) -> pbl53a_afsnit_i_valgfakta_grundgyldige(fakta.afsnit_i_valg) && pbl53a_afkald_matcher_produkt(fakta.produkt, fakta.afsnit_i_valg, fakta.oprettelsesdato)
| pbl53a_institutionsfinansiering_gyldig(finansiering: Pbl53AInstitutionsfinansiering) -> finansiering.samlet_drift_løn_og_pension_kroner >= 0 && finansiering.statsligt_finansieret_drift_løn_og_pension_kroner >= 0 && finansiering.statsligt_finansieret_drift_løn_og_pension_kroner <= finansiering.samlet_drift_løn_og_pension_kroner
| pbl53a_modtager_statsstøtte(finansiering: Pbl53AInstitutionsfinansiering) -> pbl53a_institutionsfinansiering_gyldig(finansiering) && finansiering.statsligt_finansieret_drift_løn_og_pension_kroner > 0
| pbl53a_afkald_relevant_for_stk6(produkt: Pbl53AProduktfakta, valg: Pbl53AAfsnitIValgfakta) -> match valg {
    | Pbl53AAfkaldPåAfsnitI(_, _, _) -> match produkt {
        | Pbl53ALivsforsikringsprodukt(_, _, _, _, _) -> Sandt
        | Pbl53APensionskasseprodukt(_, _, _, _) -> Sandt
        | _ -> Falskt
    }
    | _ -> Falskt
}
--@begin::pensionsbeskatningsloven_par53b--
| pbl53a_udenlandsk_hjemsted_gyldigt(hjemsted: Pbl53BUdenlandskHjemsted) -> match hjemsted {
    | Pbl53BFremmedStat(stat) -> stat != ""
    | _ -> Sandt
}
| pbl53b_oprettelsesposition_gyldig(oprettelsesdato: Pbl15ADato, position: Pbl53BOprettelsesposition) -> match position {
    | Pbl53BOprettetUnderDanskSkattepligtOgHjemsted -> Sandt
    | Pbl53BOprettetUdenFuldDanskSkattepligt(hjemsted, sidste_dato) -> pbl53a_udenlandsk_hjemsted_gyldigt(hjemsted) && pbl15a_dato_gyldig(sidste_dato) && pbl15a_dato_nøgle(oprettelsesdato) <= pbl15a_dato_nøgle(sidste_dato)
    | Pbl53BOprettetMedDboHjemstedIUdlandet(hjemsted, sidste_dato) -> pbl53a_udenlandsk_hjemsted_gyldigt(hjemsted) && pbl15a_dato_gyldig(sidste_dato) && pbl15a_dato_nøgle(oprettelsesdato) <= pbl15a_dato_nøgle(sidste_dato)
}
| pbl53b_oprettelsesbetingelse_opfyldt(position: Pbl53BOprettelsesposition) -> position != Pbl53BOprettetUnderDanskSkattepligtOgHjemsted
| pbl53b_sidste_udenlandsdato(position: Pbl53BOprettelsesposition) -> match position {
    | Pbl53BOprettetUdenFuldDanskSkattepligt(_, sidste_dato) -> sidste_dato
    | Pbl53BOprettetMedDboHjemstedIUdlandet(_, sidste_dato) -> sidste_dato
    | _ -> Pbl15ADato(år = 1, måned = 1, dag = 1)
}
| pbl53b_indbetaling_foretaget_i_udenlandsperioden(fakta: Pbl53AIndbetalingsfakta, position: Pbl53BOprettelsesposition) -> pbl53b_oprettelsesbetingelse_opfyldt(position) && pbl15a_dato_nøgle(fakta.tidspunkt.dato) <= pbl15a_dato_nøgle(pbl53b_sidste_udenlandsdato(position))
| pbl53b_indbetaler_er_arbejdsgiver(indbetaler: Pbl53AIndbetaler) -> indbetaler == Pbl53ANuværendeArbejdsgiver || indbetaler == Pbl53ATidligereArbejdsgiver
| pbl53b_udenlandsk_indbetalingsbehandling_kvalificerer(fakta: Pbl53AIndbetalingsfakta) -> match fakta.par53b_udenlandsk_skattebehandling {
    | Pbl53BEjerbidragFuldtFradragetIPositivIndkomst(positiv_indkomst_kroner, faktisk_fradrag_kroner) -> fakta.indbetaler == Pbl53AEjeren && positiv_indkomst_kroner >= fakta.beløb_kroner && faktisk_fradrag_kroner >= fakta.beløb_kroner
    | Pbl53BArbejdsgiverbidragFuldtBortsetFraIndkomst -> pbl53b_indbetaler_er_arbejdsgiver(fakta.indbetaler)
    | _ -> Falskt
}
| pbl53b_indbetalingsdokumentation_konsistent(fakta: Pbl53AIndbetalingsfakta, position: Pbl53BOprettelsesposition) -> hvis pbl53b_indbetaling_foretaget_i_udenlandsperioden(fakta, position) { fakta.periode == Pbl53AHistoriskIndbetalingFørOrdningenBlevOmfattet && fakta.par53b_udenlandsk_skattebehandling != Pbl53BIkkeForetagetIUdenlandsperioden } ellers { fakta.par53b_udenlandsk_skattebehandling == Pbl53BIkkeForetagetIUdenlandsperioden }
| pbl53b_hændelsesdokumentation_konsistent(hændelse: Pbl53AHændelse, position: Pbl53BOprettelsesposition) -> match hændelse {
    | Pbl53AIndbetaling(fakta) -> pbl53b_indbetalingsdokumentation_konsistent(fakta, position)
    | _ -> Sandt
}
| pbl53b_hændelse_kvalificerer(hændelse: Pbl53AHændelse, position: Pbl53BOprettelsesposition) -> match hændelse {
    | Pbl53AIndbetaling(fakta) -> pbl53b_indbetaling_foretaget_i_udenlandsperioden(fakta, position) == Falskt || pbl53b_udenlandsk_indbetalingsbehandling_kvalificerer(fakta)
    | _ -> Sandt
}
| pbl53b_produktkreds_omfattet(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta) -> match fakta.produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, kapitel1fakta, _, _) -> pbl53a_ikke_omfattet_af_kapitel1(kapitel1fakta) || pbl53a_tidligere_par15d_udløbet_før_indkomstår(kapitel1fakta, indkomstår)
    | Pbl53APensionskasseprodukt(_, kapitel1fakta, karakteristika, _) -> pbl53a_pensionskassekarakteristika_opfyldt(karakteristika) && (pbl53a_ikke_omfattet_af_kapitel1(kapitel1fakta) || pbl53a_tidligere_par15d_udløbet_før_indkomstår(kapitel1fakta, indkomstår))
    | Pbl53ASygeOgUlykkesforsikringsprodukt(ejer_identifikation, forsikret_identifikation) -> ejer_identifikation == forsikret_identifikation
    | Pbl53APengeEllerKreditinstitutprodukt(_, kapitel1fakta, institutionssted, karakteristika) -> pbl53a_udenlandsk_institution(institutionssted) && pbl53a_pengeinstitutkarakteristika_opfyldt(karakteristika) && (pbl53a_omfattet_af_kapitel1(kapitel1fakta) == Falskt || pbl53a_afkald_givet_ved_oprettelsen(fakta.afsnit_i_valg, fakta.oprettelsesdato))
    | _ -> Falskt
}
| pbl53b_i_øvrigt_anvendelig(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> indkomstår > 0 && pbl15a_dato_gyldig(fakta.oprettelsesdato) && pbl53a_produktfakta_gyldige(fakta.produkt) && pbl53a_produkt_karakteristika_opfyldt(fakta.produkt) && pbl53a_afsnit_i_valgfakta_konsistente(fakta) && pbl53b_oprettelsesposition_gyldig(fakta.oprettelsesdato, fakta.par53b_oprettelsesposition) && pbl53b_produktkreds_omfattet(indkomstår, fakta) && pbl53b_oprettelsesbetingelse_opfyldt(fakta.par53b_oprettelsesposition) && all(hændelser, |hændelse: Pbl53AHændelse| pbl53b_hændelsesdokumentation_konsistent(hændelse, fakta.par53b_oprettelsesposition)) && all(hændelser, |hændelse: Pbl53AHændelse| pbl53b_hændelse_kvalificerer(hændelse, fakta.par53b_oprettelsesposition))
| pbl53b_resultat(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> {
    = overgangsresultat = pbl53a_overgangsresultat(fakta, hændelser)
    = overgang_har_virkning = pbl53a_moderne_regler_har_virkning_i_indkomstår(overgangsresultat, indkomstår)
    = produktkreds_omfattet = pbl53b_produktkreds_omfattet(indkomstår, fakta)
    = oprettelsesbetingelse_opfyldt = pbl53b_oprettelsesbetingelse_opfyldt(fakta.par53b_oprettelsesposition)
    = indbetalingsdokumentation_konsistent = all(hændelser, |hændelse: Pbl53AHændelse| pbl53b_hændelsesdokumentation_konsistent(hændelse, fakta.par53b_oprettelsesposition))
    = samtlige_udenlandske_indbetalinger_kvalificerer = all(hændelser, |hændelse: Pbl53AHændelse| pbl53b_hændelse_kvalificerer(hændelse, fakta.par53b_oprettelsesposition))
    = i_øvrigt_anvendelig = pbl53b_i_øvrigt_anvendelig(indkomstår, fakta, hændelser)
    Pbl53BResultat(
        overgang_har_virkning = overgang_har_virkning,
        produktkreds_omfattet = produktkreds_omfattet,
        oprettelsesbetingelse_opfyldt = oprettelsesbetingelse_opfyldt,
        indbetalingsdokumentation_konsistent = indbetalingsdokumentation_konsistent,
        samtlige_udenlandske_indbetalinger_kvalificerer = samtlige_udenlandske_indbetalinger_kvalificerer,
        i_øvrigt_anvendelig = i_øvrigt_anvendelig,
        omfattes_af_par53b = overgang_har_virkning && i_øvrigt_anvendelig
    )
}
--@end::pensionsbeskatningsloven_par53b--
| pbl53a_livsforsikring_uden_direktørsikkerhed(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, _, _, Pbl53AIngenDirektørsikkerhed) -> Sandt
    | _ -> Falskt
}
| pbl53a_pensionskasse_uden_direktørsikkerhed(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53APensionskasseprodukt(_, _, karakteristika, Pbl53AIngenDirektørsikkerhed) -> pbl53a_pensionskassekarakteristika_opfyldt(karakteristika)
    | _ -> Falskt
}
| pbl53a_direktørsikkerhedsprodukt(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, kapitel1fakta, _, sikkerhed) -> pbl53a_ikke_omfattet_af_kapitel1(kapitel1fakta) && pbl53a_har_direktørsikkerhed(sikkerhed)
    | Pbl53APensionskasseprodukt(_, kapitel1fakta, karakteristika, sikkerhed) -> pbl53a_ikke_omfattet_af_kapitel1(kapitel1fakta) && pbl53a_pensionskassekarakteristika_opfyldt(karakteristika) && pbl53a_har_direktørsikkerhed(sikkerhed)
    | Pbl53AGarantiforsikringsprodukt(tilsagn) -> pbl53a_direktørpensionstilsagn_gyldigt(tilsagn)
    | _ -> Falskt
}
| pbl53a_pengeinstitutprodukt(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53APengeEllerKreditinstitutprodukt(_, _, _, karakteristika) -> pbl53a_pengeinstitutkarakteristika_opfyldt(karakteristika)
    | _ -> Falskt
}
| pbl53a_tidligere_par15d_produkt_udløbet(produkt: Pbl53AProduktfakta, indkomstår: Heltal) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, kapitel1fakta, _, Pbl53AIngenDirektørsikkerhed) -> pbl53a_tidligere_par15d_udløbet_før_indkomstår(kapitel1fakta, indkomstår)
    | Pbl53APensionskasseprodukt(_, kapitel1fakta, karakteristika, Pbl53AIngenDirektørsikkerhed) -> pbl53a_pensionskassekarakteristika_opfyldt(karakteristika) && pbl53a_tidligere_par15d_udløbet_før_indkomstår(kapitel1fakta, indkomstår)
    | Pbl53APengeEllerKreditinstitutprodukt(_, kapitel1fakta, _, karakteristika) -> pbl53a_pengeinstitutkarakteristika_opfyldt(karakteristika) && pbl53a_tidligere_par15d_udløbet_før_indkomstår(kapitel1fakta, indkomstår)
    | _ -> Falskt
}
| pbl53a_stk1_nr6_ordning(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53AGarantiforsikringsprodukt(_) -> Pbl53ADirektørGarantiforsikring
    | _ -> Pbl53ADirektørSikkerhedLivsforsikringEllerPensionskasse
}
| pbl53a_stk1_klassifikation(nr1: Boolsk, nr2: Boolsk, nr3: Boolsk, nr4: Boolsk, nr5: Boolsk, nr6: Boolsk, nr7: Boolsk, nr8: Boolsk, nr9: Boolsk, produkt: Pbl53AProduktfakta) -> hvis nr1 { Pbl53AStk1Hjemmel(nummer = 1, ordning = Pbl53ALivsforsikringUdenKapitel1) } ellers hvis nr2 { Pbl53AStk1Hjemmel(nummer = 2, ordning = Pbl53ALivsforsikringAfkaldAfsnitI) } ellers hvis nr3 { Pbl53AStk1Hjemmel(nummer = 3, ordning = Pbl53APensionskasseUdenKapitel1) } ellers hvis nr4 { Pbl53AStk1Hjemmel(nummer = 4, ordning = Pbl53APensionskasseAfkaldAfsnitI) } ellers hvis nr5 { Pbl53AStk1Hjemmel(nummer = 5, ordning = Pbl53ASygeOgUlykkesforsikring) } ellers hvis nr6 { Pbl53AStk1Hjemmel(nummer = 6, ordning = pbl53a_stk1_nr6_ordning(produkt)) } ellers hvis nr7 { Pbl53AStk1Hjemmel(nummer = 7, ordning = Pbl53APengeinstitutUdenKapitel1) } ellers hvis nr8 { Pbl53AStk1Hjemmel(nummer = 8, ordning = Pbl53APengeinstitutAfkaldAfsnitI) } ellers hvis nr9 { Pbl53AStk1Hjemmel(nummer = 9, ordning = Pbl53ATidligerePar15DGodkendt) } ellers { Pbl53AIngenStk1Hjemmel }
| pbl53a_stk1_hjemler_antal(nr1: Boolsk, nr2: Boolsk, nr3: Boolsk, nr4: Boolsk, nr5: Boolsk, nr6: Boolsk, nr7: Boolsk, nr8: Boolsk, nr9: Boolsk) -> foldl([nr1, nr2, nr3, nr4, nr5, nr6, nr7, nr8, nr9], 0, |antal: Heltal, opfyldt: Boolsk| antal + hvis opfyldt { 1 } ellers { 0 })
| pbl53a_livsforsikringsdækning_er_stk4_risiko(dækning: Pbl53ALivsforsikringsdækning) -> dækning != Pbl53AAndenLivsforsikringsdækning
| pbl53a_risikoliv_undtaget_efter_stk4(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ALivsforsikringsprodukt(_, _, _, vilkår, _) -> length(vilkår.dækninger) > 0 && all(vilkår.dækninger, pbl53a_livsforsikringsdækning_er_stk4_risiko) && pbl15a_dato_nøgle(vilkår.aftalt_udløbsdato) <= pbl15a_dato_nøgle(vilkår.første_policedag_efter_fyldte_80_år)
    | _ -> Falskt
}
| pbl53a_syge_ulykke_undtaget_efter_stk4(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53ASygeOgUlykkesforsikringsprodukt(ejer_identifikation, forsikret_identifikation) -> ejer_identifikation == forsikret_identifikation
    | _ -> Falskt
}
| pbl53a_direktørgaranti_undtaget_efter_stk4(produkt: Pbl53AProduktfakta) -> match produkt {
    | Pbl53AGarantiforsikringsprodukt(tilsagn) -> pbl53a_direktørpensionstilsagn_gyldigt(tilsagn)
    | _ -> Falskt
}
| pbl53a_afkald_tilladt_efter_stk6_for_fakta(fakta: Pbl53AOmfangsfakta) -> pbl53a_afkald_relevant_for_stk6(fakta.produkt, fakta.afsnit_i_valg) == Falskt || pbl53a_modtager_statsstøtte(fakta.institutionsfinansiering) == Falskt
| pbl53a_stk1_nr1_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_livsforsikring_uden_direktørsikkerhed(fakta.produkt) && pbl53a_ikke_omfattet_af_kapitel1(pbl53a_produkt_kapitel1fakta(fakta.produkt))
| pbl53a_stk1_nr2_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_livsforsikring_uden_direktørsikkerhed(fakta.produkt) && pbl53a_omfattet_af_kapitel1(pbl53a_produkt_kapitel1fakta(fakta.produkt)) && pbl53a_afkald_givet_ved_oprettelsen(fakta.afsnit_i_valg, fakta.oprettelsesdato) && pbl53a_afkald_tilladt_efter_stk6_for_fakta(fakta)
| pbl53a_stk1_nr3_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_pensionskasse_uden_direktørsikkerhed(fakta.produkt) && pbl53a_ikke_omfattet_af_kapitel1(pbl53a_produkt_kapitel1fakta(fakta.produkt))
| pbl53a_stk1_nr4_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_pensionskasse_uden_direktørsikkerhed(fakta.produkt) && pbl53a_omfattet_af_kapitel1(pbl53a_produkt_kapitel1fakta(fakta.produkt)) && pbl53a_afkald_givet_ved_oprettelsen(fakta.afsnit_i_valg, fakta.oprettelsesdato) && pbl53a_afkald_tilladt_efter_stk6_for_fakta(fakta)
| pbl53a_stk1_nr5_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_syge_ulykke_undtaget_efter_stk4(fakta.produkt)
| pbl53a_stk1_nr6_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_direktørsikkerhedsprodukt(fakta.produkt)
| pbl53a_stk1_nr7_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_pengeinstitutprodukt(fakta.produkt) && pbl53a_ikke_omfattet_af_kapitel1(pbl53a_produkt_kapitel1fakta(fakta.produkt))
| pbl53a_stk1_nr8_i_øvrigt_opfyldt(fakta: Pbl53AOmfangsfakta) -> pbl53a_pengeinstitutprodukt(fakta.produkt) && pbl53a_omfattet_af_kapitel1(pbl53a_produkt_kapitel1fakta(fakta.produkt)) && pbl53a_afkald_givet_ved_oprettelsen(fakta.afsnit_i_valg, fakta.oprettelsesdato)
| pbl53a_stk1_nr9_i_øvrigt_opfyldt(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta) -> pbl53a_tidligere_par15d_produkt_udløbet(fakta.produkt, indkomstår)
| pbl53a_i_øvrigt_anvendelig(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> {
    = nr1 = pbl53a_stk1_nr1_i_øvrigt_opfyldt(fakta)
    = nr2 = pbl53a_stk1_nr2_i_øvrigt_opfyldt(fakta)
    = nr3 = pbl53a_stk1_nr3_i_øvrigt_opfyldt(fakta)
    = nr4 = pbl53a_stk1_nr4_i_øvrigt_opfyldt(fakta)
    = nr5 = pbl53a_stk1_nr5_i_øvrigt_opfyldt(fakta)
    = nr6 = pbl53a_stk1_nr6_i_øvrigt_opfyldt(fakta)
    = nr7 = pbl53a_stk1_nr7_i_øvrigt_opfyldt(fakta)
    = nr8 = pbl53a_stk1_nr8_i_øvrigt_opfyldt(fakta)
    = nr9 = pbl53a_stk1_nr9_i_øvrigt_opfyldt(indkomstår, fakta)
    indkomstår > 0 && pbl15a_dato_gyldig(fakta.oprettelsesdato) && pbl53a_produktfakta_gyldige(fakta.produkt) && pbl53a_produkt_karakteristika_opfyldt(fakta.produkt) && pbl53a_afsnit_i_valgfakta_konsistente(fakta) && pbl53a_institutionsfinansiering_gyldig(fakta.institutionsfinansiering) && pbl53b_oprettelsesposition_gyldig(fakta.oprettelsesdato, fakta.par53b_oprettelsesposition) && pbl53b_i_øvrigt_anvendelig(indkomstår, fakta, hændelser) == Falskt && pbl53a_stk1_hjemler_antal(nr1, nr2, nr3, nr4, nr5, nr6, nr7, nr8, nr9) == 1
}

# Pbl53AOmfangssag(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) {
    | produkt_fakta_gyldige() -> pbl53a_produktfakta_gyldige(fakta.produkt)
    | afsnit_i_valgfakta_konsistente() -> pbl53a_afsnit_i_valgfakta_konsistente(fakta)
    | overgangsresultat() -> pbl53a_overgangsresultat(fakta, hændelser)
    | par53b_resultat() -> pbl53b_resultat(indkomstår, fakta, hændelser)
    | grundfakta_gyldige() -> indkomstår > 0 && pbl15a_dato_gyldig(fakta.oprettelsesdato) && overgangsresultat().fakta_gyldige && produkt_fakta_gyldige() && pbl53a_produkt_karakteristika_opfyldt(fakta.produkt) && afsnit_i_valgfakta_konsistente() && pbl53a_institutionsfinansiering_gyldig(fakta.institutionsfinansiering) && pbl53b_oprettelsesposition_gyldig(fakta.oprettelsesdato, fakta.par53b_oprettelsesposition) && par53b_resultat().indbetalingsdokumentation_konsistent
    | modtager_statsstøtte() -> pbl53a_modtager_statsstøtte(fakta.institutionsfinansiering)
    | afkald_relevant_for_stk6() -> pbl53a_afkald_relevant_for_stk6(fakta.produkt, fakta.afsnit_i_valg)
    | afkald_tilladt_efter_stk6() -> pbl53a_afkald_tilladt_efter_stk6_for_fakta(fakta)
    | par53a_i_øvrigt_anvendelig() -> pbl53a_i_øvrigt_anvendelig(indkomstår, fakta, hændelser)
    | kan_klassificeres_i_par53a() -> grundfakta_gyldige() && pbl53a_moderne_regler_har_virkning_i_indkomstår(overgangsresultat(), indkomstår) && par53a_i_øvrigt_anvendelig()
    | kapitel1fakta() -> pbl53a_produkt_kapitel1fakta(fakta.produkt)
    | afkald_givet_ved_oprettelsen() -> pbl53a_afkald_givet_ved_oprettelsen(fakta.afsnit_i_valg, fakta.oprettelsesdato)
    | stk1_nr1_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr1_i_øvrigt_opfyldt(fakta)
    | stk1_nr2_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr2_i_øvrigt_opfyldt(fakta)
    | stk1_nr3_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr3_i_øvrigt_opfyldt(fakta)
    | stk1_nr4_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr4_i_øvrigt_opfyldt(fakta)
    | stk1_nr5_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr5_i_øvrigt_opfyldt(fakta)
    | stk1_nr6_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr6_i_øvrigt_opfyldt(fakta)
    | stk1_nr7_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr7_i_øvrigt_opfyldt(fakta)
    | stk1_nr8_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr8_i_øvrigt_opfyldt(fakta)
    | stk1_nr9_opfyldt() -> kan_klassificeres_i_par53a() && pbl53a_stk1_nr9_i_øvrigt_opfyldt(indkomstår, fakta)
    | stk1_hjemler_antal() -> pbl53a_stk1_hjemler_antal(stk1_nr1_opfyldt(), stk1_nr2_opfyldt(), stk1_nr3_opfyldt(), stk1_nr4_opfyldt(), stk1_nr5_opfyldt(), stk1_nr6_opfyldt(), stk1_nr7_opfyldt(), stk1_nr8_opfyldt(), stk1_nr9_opfyldt())
    | stk1_hjemmel_entydig() -> stk1_hjemler_antal() == 1
    | stk1_klassifikation() -> pbl53a_stk1_klassifikation(stk1_nr1_opfyldt(), stk1_nr2_opfyldt(), stk1_nr3_opfyldt(), stk1_nr4_opfyldt(), stk1_nr5_opfyldt(), stk1_nr6_opfyldt(), stk1_nr7_opfyldt(), stk1_nr8_opfyldt(), stk1_nr9_opfyldt(), fakta.produkt)
    | omfattes_af_par53a() -> kan_klassificeres_i_par53a() && stk1_hjemmel_entydig()
    | risikoliv_undtaget_efter_stk4() -> pbl53a_risikoliv_undtaget_efter_stk4(fakta.produkt)
    | syge_ulykke_undtaget_efter_stk4() -> pbl53a_syge_ulykke_undtaget_efter_stk4(fakta.produkt)
    | direktørgaranti_undtaget_efter_stk4() -> pbl53a_direktørgaranti_undtaget_efter_stk4(fakta.produkt)
    | undtaget_efter_stk4() -> omfattes_af_par53a() && (risikoliv_undtaget_efter_stk4() || syge_ulykke_undtaget_efter_stk4() || direktørgaranti_undtaget_efter_stk4())
    | resultat() -> Pbl53AOmfangsresultat(
        fakta = fakta,
        grundfakta_gyldige = grundfakta_gyldige(),
        produkt_fakta_gyldige = produkt_fakta_gyldige(),
        afsnit_i_valgfakta_konsistente = afsnit_i_valgfakta_konsistente(),
        overgangsresultat = overgangsresultat(),
        modtager_statsstøtte = modtager_statsstøtte(),
        afkald_relevant_for_stk6 = afkald_relevant_for_stk6(),
        afkald_tilladt_efter_stk6 = afkald_tilladt_efter_stk6(),
        par53b_resultat = par53b_resultat(),
        par53a_i_øvrigt_anvendelig = par53a_i_øvrigt_anvendelig(),
        stk1_nr1_opfyldt = stk1_nr1_opfyldt(),
        stk1_nr2_opfyldt = stk1_nr2_opfyldt(),
        stk1_nr3_opfyldt = stk1_nr3_opfyldt(),
        stk1_nr4_opfyldt = stk1_nr4_opfyldt(),
        stk1_nr5_opfyldt = stk1_nr5_opfyldt(),
        stk1_nr6_opfyldt = stk1_nr6_opfyldt(),
        stk1_nr7_opfyldt = stk1_nr7_opfyldt(),
        stk1_nr8_opfyldt = stk1_nr8_opfyldt(),
        stk1_nr9_opfyldt = stk1_nr9_opfyldt(),
        stk1_hjemler_antal = stk1_hjemler_antal(),
        stk1_hjemmel_entydig = stk1_hjemmel_entydig(),
        stk1_klassifikation = stk1_klassifikation(),
        risikoliv_undtaget_efter_stk4 = risikoliv_undtaget_efter_stk4(),
        syge_ulykke_undtaget_efter_stk4 = syge_ulykke_undtaget_efter_stk4(),
        direktørgaranti_undtaget_efter_stk4 = direktørgaranti_undtaget_efter_stk4(),
        undtaget_efter_stk4 = undtaget_efter_stk4(),
        omfattes_af_par53a = omfattes_af_par53a()
    )
}
| pbl53a_omfangsresultat(indkomstår: Heltal, fakta: Pbl53AOmfangsfakta, hændelser: List(Pbl53AHændelse)) -> Pbl53AOmfangssag(indkomstår, fakta, hændelser).resultat()
| pbl53a_omfang_klassifikation_matcher_ordning(resultat: Pbl53AOmfangsresultat, ordning: Pensionsbeskatningslov53AOrdning) -> match resultat.stk1_klassifikation {
    | Pbl53AStk1Hjemmel(_, klassificeret_ordning) -> klassificeret_ordning == ordning
    | _ -> Falskt
}
| pbl53a_omfang_ordning(resultat: Pbl53AOmfangsresultat) -> match resultat.stk1_klassifikation {
    | Pbl53AStk1Hjemmel(_, ordning) -> ordning
    | _ -> Pbl53ALivsforsikringUdenKapitel1
}

| pbl53a_tidspunkt_gyldigt(tidspunkt: Pbl53ATidspunkt) -> pbl15a_dato_gyldig(tidspunkt.dato) && tidspunkt.rækkefølge_på_dagen > 0
| pbl53a_tidspunkt_før(a: Pbl53ATidspunkt, b: Pbl53ATidspunkt) -> pbl15a_dato_nøgle(a.dato) < pbl15a_dato_nøgle(b.dato) || pbl15a_dato_nøgle(a.dato) == pbl15a_dato_nøgle(b.dato) && a.rækkefølge_på_dagen < b.rækkefølge_på_dagen
| pbl53a_tidspunkt_efter_seneste(seneste: Pbl53ASenesteTidspunkt, tidspunkt: Pbl53ATidspunkt) -> match seneste {
    | Pbl53AIntetTidspunkt -> Sandt
    | Pbl53ARegistreretTidspunkt(forrige) -> pbl53a_tidspunkt_før(forrige, tidspunkt)
}
| pbl53a_udsendelsesgrundfakta_gyldige(udsendelse: Pbl53AUdsendelsesfakta) -> pbl15a_dato_gyldig(udsendelse.startdato) && pbl15a_dato_gyldig(udsendelse.slutdato) && pbl15a_dato_nøgle(udsendelse.startdato) <= pbl15a_dato_nøgle(udsendelse.slutdato)
| pbl53a_udsendelse_mindst_en_måned(udsendelse: Pbl53AUdsendelsesfakta) -> pbl53a_udsendelsesgrundfakta_gyldige(udsendelse) && pbl15a_dato_nøgle(pbl15a_dato_plus_måneder(udsendelse.startdato, 1)) <= pbl15a_dato_nøgle(udsendelse.slutdato)
| pbl53a_udsendelsessted_omfattet(sted: Pbl53AUdsendelsessted) -> sted != Pbl53ADanmark
| pbl53a_udsendelse_giver_medfølgende_regel(udsendelse: Pbl53AUdsendelsesfakta) -> Falskt
| exception pbl53a_medfølgende_under_udsendelse pbl53a_udsendelse_giver_medfølgende_regel(udsendelse: Pbl53AUdsendelsesfakta) -> Sandt under pbl53a_udsendelse_mindst_en_måned(udsendelse) && pbl53a_udsendelsessted_omfattet(udsendelse.sted) && udsendelse.fælles_bopæl_hele_perioden && udsendelse.indbetaling_til_afsnit_i_eller_iia_under_udsendelsen == Falskt
| pbl53a_medfølgende_ægtefælle_eller_samlever_omfattet(indbetaler: Pbl53AIndbetaler) -> match indbetaler {
    | Pbl53AÆgtefællesEllerSamleversArbejdsgiver(udsendelse) -> pbl53a_udsendelse_giver_medfølgende_regel(udsendelse)
    | _ -> Falskt
}
| pbl53a_indbetaler_fakta_gyldige(indbetaler: Pbl53AIndbetaler) -> match indbetaler {
    | Pbl53AÆgtefællesEllerSamleversArbejdsgiver(udsendelse) -> pbl53a_udsendelsesgrundfakta_gyldige(udsendelse)
    | _ -> Sandt
}
| pbl53a_fradragsstatus_har_dansk_ret(status: Pbl53AEjerensFradragsstatus) -> status == Pbl53AFradragEllerBortseelsesretIDanmark || status == Pbl53AFradragEllerBortseelsesretIDanmarkOgUdlandet
| pbl53a_fradragsstatus_har_ret(status: Pbl53AEjerensFradragsstatus) -> status != Pbl53AUdenFradragsEllerBortseelsesret
| pbl53a_indbetalingsfakta_gyldige(ordning: Pensionsbeskatningslov53AOrdning, fakta: Pbl53AIndbetalingsfakta) -> fakta.identifikation != "" && pbl53a_tidspunkt_gyldigt(fakta.tidspunkt) && fakta.beløb_kroner > 0 && pbl53a_indbetaler_fakta_gyldige(fakta.indbetaler) && (fakta.periode == Pbl53AHistoriskIndbetalingFørOrdningenBlevOmfattet || pbl53a_fradragsstatus_har_dansk_ret(fakta.ejerens_fradragsstatus) == Falskt) && (ordning != Pbl53ADirektørSikkerhedLivsforsikringEllerPensionskasse || fakta.ejerens_fradragsstatus == Pbl53AUdenFradragsEllerBortseelsesret)

# Pbl53AIndbetalingssag(ordning: Pensionsbeskatningslov53AOrdning, fakta: Pbl53AIndbetalingsfakta) {
    | fakta_gyldige() -> pbl53a_indbetalingsfakta_gyldige(ordning, fakta)
    | medfølgende_ægtefælle_eller_samlever_omfattet() -> pbl53a_medfølgende_ægtefælle_eller_samlever_omfattet(fakta.indbetaler)
    | indbetalt_mens_omfattet() -> fakta.periode == Pbl53AIndbetaltMensOrdningenErOmfattet
    | sikkerhedsstillelse_efter_stk1_nr6() -> ordning == Pbl53ADirektørSikkerhedLivsforsikringEllerPensionskasse
    | eget_fradrag_i_skattepligtig_indkomst_kroner() -> 0
    | arbejdsgiverfradrag_for_sikkerhedsstillelse_kroner() -> 0
    | exception pbl53a_stk2_arbejdsgiver_sikkerhedsfradrag arbejdsgiverfradrag_for_sikkerhedsstillelse_kroner() -> fakta.beløb_kroner under fakta_gyldige() && indbetalt_mens_omfattet() && sikkerhedsstillelse_efter_stk1_nr6() && fakta.indbetaler == Pbl53ANuværendeArbejdsgiver
    | personlig_indkomst_kroner() -> 0
    | exception pbl53a_stk2_nuværende_arbejdsgiverbidrag personlig_indkomst_kroner() -> fakta.beløb_kroner under fakta_gyldige() && indbetalt_mens_omfattet() && sikkerhedsstillelse_efter_stk1_nr6() == Falskt && fakta.indbetaler == Pbl53ANuværendeArbejdsgiver
    | exception pbl53a_stk2_tidligere_arbejdsgiverbidrag personlig_indkomst_kroner() -> fakta.beløb_kroner under fakta_gyldige() && indbetalt_mens_omfattet() && sikkerhedsstillelse_efter_stk1_nr6() == Falskt && fakta.indbetaler == Pbl53ATidligereArbejdsgiver
    | exception pbl53a_stk2_medfølgende_ægtefælle_eller_samlever personlig_indkomst_kroner() -> fakta.beløb_kroner under fakta_gyldige() && indbetalt_mens_omfattet() && medfølgende_ægtefælle_eller_samlever_omfattet()
    | arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner() -> 0
    | exception pbl53a_stk2_arbejdsgiverbidrag_er_ansættelsesvederlag arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner() -> personlig_indkomst_kroner() under (fakta.indbetaler == Pbl53ANuværendeArbejdsgiver || fakta.indbetaler == Pbl53ATidligereArbejdsgiver)
    | fradrags_eller_bortseelsesberettiget_principal_tilføjet_kroner() -> 0
    | exception pbl53a_stk5_principal_med_tidligere_skattefordel fradrags_eller_bortseelsesberettiget_principal_tilføjet_kroner() -> fakta.beløb_kroner under fakta_gyldige() && sikkerhedsstillelse_efter_stk1_nr6() == Falskt && pbl53a_fradragsstatus_har_ret(fakta.ejerens_fradragsstatus)
    | resultat() -> Pbl53AIndbetalingsresultat(
        fakta = fakta,
        fakta_gyldige = fakta_gyldige(),
        medfølgende_ægtefælle_eller_samlever_omfattet = medfølgende_ægtefælle_eller_samlever_omfattet(),
        eget_fradrag_i_skattepligtig_indkomst_kroner = eget_fradrag_i_skattepligtig_indkomst_kroner(),
        arbejdsgiverfradrag_for_sikkerhedsstillelse_kroner = arbejdsgiverfradrag_for_sikkerhedsstillelse_kroner(),
        personlig_indkomst_kroner = personlig_indkomst_kroner(),
        arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner = arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner(),
        fradrags_eller_bortseelsesberettiget_principal_tilføjet_kroner = fradrags_eller_bortseelsesberettiget_principal_tilføjet_kroner()
    )
}
| pbl53a_indbetalingsresultat(ordning: Pensionsbeskatningslov53AOrdning, fakta: Pbl53AIndbetalingsfakta) -> Pbl53AIndbetalingssag(ordning, fakta).resultat()

| pbl53a_udbetalingsmodtager_omfattet_af_par55(modtager: Pbl53AUdbetalingsmodtager) -> modtager != Pbl53AAndenUdbetalingsmodtager
| pbl53a_kapitaludbetalingsgrund_omfattet(grund: Pbl53AKapitaludbetalingsgrund) -> grund != Pbl53AAndenUdbetalingsgrund
| pbl53a_kapitalregel_75_procent_anvendes(art: Pbl53AUdbetalingsart) -> match art {
    | Pbl53AUdbetalingFraOrdningen(_, produktart, Pbl53ASamletKapitaludbetaling(grund), _) -> produktart == Pbl53ATilsvarerDanskKapitalforsikringEllerOpsparing && pbl53a_kapitaludbetalingsgrund_omfattet(grund)
    | _ -> Falskt
}
| pbl53a_er_afkastskatteudbetaling(art: Pbl53AUdbetalingsart) -> match art {
    | Pbl53AUdbetalingTilAfkastskat(_, _, _, _, _) -> Sandt
    | _ -> Falskt
}
| pbl53a_afkastskatteudbetaling_rettidig(fakta: Pbl53AUdbetalingsfakta) -> match fakta.art {
    | Pbl53AUdbetalingTilAfkastskat(_, afkast_indkomstår, dokumenteret_skat_kroner, dokumentationsdato, _) -> pbl53a_udbetalingsmodtager_omfattet_af_par55(fakta.modtager) && pbl15a_dato_gyldig(dokumentationsdato) && pbl15a_dato_nøgle(dokumentationsdato) <= pbl15a_dato_nøgle(fakta.tidspunkt.dato) && fakta.tidspunkt.dato.år >= afkast_indkomstår && fakta.tidspunkt.dato.år <= afkast_indkomstår + 1 && fakta.bruttoudbetaling_kroner <= dokumenteret_skat_kroner
    | _ -> Falskt
}
| pbl53a_udbetalingsart_grundfakta_gyldige(ordning: Pensionsbeskatningslov53AOrdning, bruttoudbetaling_kroner: Heltal, art: Pbl53AUdbetalingsart) -> match art {
    | Pbl53AUdbetalingFraOrdningen(kapitalværdi_kroner, _, _, stk6_fakta) -> kapitalværdi_kroner > 0 && bruttoudbetaling_kroner <= kapitalværdi_kroner && pbl20_stk6_kildefakta_gyldige(stk6_fakta)
    | Pbl53AUdbetalingTilAfkastskat(kapitalværdi_kroner, afkast_indkomstår, dokumenteret_skat_kroner, dokumentationsdato, stk6_fakta) -> kapitalværdi_kroner > 0 && bruttoudbetaling_kroner <= kapitalværdi_kroner && afkast_indkomstår > 0 && dokumenteret_skat_kroner > 0 && pbl15a_dato_gyldig(dokumentationsdato) && pbl20_stk6_kildefakta_gyldige(stk6_fakta)
    | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(sikkerhed_kroner) -> ordning == Pbl53ADirektørSikkerhedLivsforsikringEllerPensionskasse && sikkerhed_kroner >= 0
}
| pbl53a_udbetalingsfakta_gyldige(ordning: Pensionsbeskatningslov53AOrdning, resterende_principal_kroner: Heltal, fakta: Pbl53AUdbetalingsfakta) -> fakta.identifikation != "" && pbl53a_tidspunkt_gyldigt(fakta.tidspunkt) && fakta.bruttoudbetaling_kroner > 0 && resterende_principal_kroner >= 0 && pbl53a_udbetalingsart_grundfakta_gyldige(ordning, fakta.bruttoudbetaling_kroner, fakta.art) && match fakta.art {
    | Pbl53AUdbetalingFraOrdningen(kapitalværdi_kroner, _, _, _) -> resterende_principal_kroner <= kapitalværdi_kroner
    | Pbl53AUdbetalingTilAfkastskat(kapitalværdi_kroner, _, _, _, _) -> resterende_principal_kroner <= kapitalværdi_kroner
    | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(_) -> pbl53a_udbetalingsmodtager_omfattet_af_par55(fakta.modtager)
}
| pbl53a_principal_fordelt_til_udbetaling_kroner(resterende_principal_kroner: Heltal, fakta: Pbl53AUdbetalingsfakta) -> match fakta.art {
    | Pbl53AUdbetalingFraOrdningen(kapitalværdi_kroner, _, _, _) -> hvis fakta.bruttoudbetaling_kroner == kapitalværdi_kroner { penge_mindste_beløb(fakta.bruttoudbetaling_kroner, resterende_principal_kroner) } ellers { fakta.bruttoudbetaling_kroner * resterende_principal_kroner / kapitalværdi_kroner }
    | Pbl53AUdbetalingTilAfkastskat(kapitalværdi_kroner, _, _, _, _) -> hvis fakta.bruttoudbetaling_kroner == kapitalværdi_kroner { penge_mindste_beløb(fakta.bruttoudbetaling_kroner, resterende_principal_kroner) } ellers { fakta.bruttoudbetaling_kroner * resterende_principal_kroner / kapitalværdi_kroner }
    | _ -> 0
}
| pbl53a_pbl20_stk6_kildefakta(art: Pbl53AUdbetalingsart) -> match art {
    | Pbl53AUdbetalingFraOrdningen(_, _, _, kildefakta) -> kildefakta
    | Pbl53AUdbetalingTilAfkastskat(_, _, _, _, kildefakta) -> kildefakta
    | _ -> pbl20_stk6_ingen_kildefakta()
}
| pbl53a_pensionstilsagn_sikkerhed_kroner(art: Pbl53AUdbetalingsart) -> match art {
    | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(sikkerhed_kroner) -> sikkerhed_kroner
    | _ -> 0
}
| pbl53a_er_arbejdsgiverens_udbetaling_efter_pensionstilsagn(art: Pbl53AUdbetalingsart) -> match art {
    | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(_) -> Sandt
    | _ -> Falskt
}

# Pbl53AUdbetalingssag(ordning: Pensionsbeskatningslov53AOrdning, resterende_principal_kroner: Heltal, fakta: Pbl53AUdbetalingsfakta) {
    | fakta_gyldige() -> pbl53a_udbetalingsfakta_gyldige(ordning, resterende_principal_kroner, fakta)
    | modtager_omfattet_af_par55() -> pbl53a_udbetalingsmodtager_omfattet_af_par55(fakta.modtager)
    | afkastskatteudbetaling_rettidig() -> fakta_gyldige() && pbl53a_afkastskatteudbetaling_rettidig(fakta)
    | principal_fordelt_til_udbetalingen_kroner() -> hvis fakta_gyldige() { pbl53a_principal_fordelt_til_udbetaling_kroner(resterende_principal_kroner, fakta) } ellers { 0 }
    | principal_medregnet_før_75_procent_kroner() -> hvis modtager_omfattet_af_par55() && afkastskatteudbetaling_rettidig() == Falskt { principal_fordelt_til_udbetalingen_kroner() } ellers { 0 }
    | kapitalregel_75_procent_anvendt() -> fakta_gyldige() && modtager_omfattet_af_par55() && pbl53a_kapitalregel_75_procent_anvendes(fakta.art)
    | sikkerhedsstillelse_modsvarer_udbetaling_kroner() -> 0
    | exception pbl53a_stk5_pensionstilsagn_modsvarer_sikkerhed sikkerhedsstillelse_modsvarer_udbetaling_kroner() -> penge_mindste_beløb(fakta.bruttoudbetaling_kroner, pbl53a_pensionstilsagn_sikkerhed_kroner(fakta.art)) under fakta_gyldige() && pbl53a_er_arbejdsgiverens_udbetaling_efter_pensionstilsagn(fakta.art)
    | personlig_indkomst_kroner() -> hvis fakta_gyldige() { match fakta.art {
        | Pbl53AUdbetalingFraOrdningen(_, _, _, _) -> hvis kapitalregel_75_procent_anvendt() { principal_medregnet_før_75_procent_kroner() * 75 / 100 } ellers { principal_medregnet_før_75_procent_kroner() }
        | Pbl53AUdbetalingTilAfkastskat(_, _, _, _, _) -> principal_medregnet_før_75_procent_kroner()
        | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(_) -> fakta.bruttoudbetaling_kroner - sikkerhedsstillelse_modsvarer_udbetaling_kroner()
    } } ellers { 0 }
    | arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner() -> match fakta.art {
        | Pbl53AArbejdsgiverensUdbetalingEfterPensionstilsagn(_) -> personlig_indkomst_kroner()
        | _ -> 0
    }
    | pbl20_stk6_input() -> Pbl20Stk6Input(
        kildefakta = pbl53a_pbl20_stk6_kildefakta(fakta.art),
        dansk_skattepligtig_pensionsindkomst_kroner = match fakta.art {
            | Pbl53AUdbetalingFraOrdningen(_, _, _, _) -> personlig_indkomst_kroner()
            | Pbl53AUdbetalingTilAfkastskat(_, _, _, _, _) -> personlig_indkomst_kroner()
            | _ -> 0
        }
    )
    | stk6_resultat() -> pbl20_stk6_resultat(pbl20_stk6_input())
    | resultat() -> Pbl53AUdbetalingsresultat(
        fakta = fakta,
        fakta_gyldige = fakta_gyldige(),
        modtager_omfattet_af_par55 = modtager_omfattet_af_par55(),
        afkastskatteudbetaling_rettidig = afkastskatteudbetaling_rettidig(),
        fradrags_eller_bortseelsesberettiget_principal_før_kroner = resterende_principal_kroner,
        principal_fordelt_til_udbetalingen_kroner = principal_fordelt_til_udbetalingen_kroner(),
        principal_medregnet_før_75_procent_kroner = principal_medregnet_før_75_procent_kroner(),
        kapitalregel_75_procent_anvendt = kapitalregel_75_procent_anvendt(),
        sikkerhedsstillelse_modsvarer_udbetaling_kroner = sikkerhedsstillelse_modsvarer_udbetaling_kroner(),
        personlig_indkomst_kroner = personlig_indkomst_kroner(),
        arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner = arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner(),
        pbl20_stk6_resultat = stk6_resultat()
    )
}
| pbl53a_udbetalingsresultat(ordning: Pensionsbeskatningslov53AOrdning, resterende_principal_kroner: Heltal, fakta: Pbl53AUdbetalingsfakta) -> Pbl53AUdbetalingssag(ordning, resterende_principal_kroner, fakta).resultat()

| pbl53a_hændelse_identifikation(hændelse: Pbl53AHændelse) -> match hændelse {
    | Pbl53AIndbetaling(fakta) -> fakta.identifikation
    | Pbl53AUdbetaling(fakta) -> fakta.identifikation
}
| pbl53a_hændelse_tidspunkt(hændelse: Pbl53AHændelse) -> match hændelse {
    | Pbl53AIndbetaling(fakta) -> fakta.tidspunkt
    | Pbl53AUdbetaling(fakta) -> fakta.tidspunkt
}
| pbl53a_hændelse_identifikation_unik(hændelser: List(Pbl53AHændelse), hændelse: Pbl53AHændelse) -> length(filter(hændelser, |anden: Pbl53AHændelse| pbl53a_hændelse_identifikation(anden) == pbl53a_hændelse_identifikation(hændelse))) == 1
| pbl53a_hændelsesidentifikationer_entydige(hændelser: List(Pbl53AHændelse)) -> all(hændelser, |hændelse: Pbl53AHændelse| pbl53a_hændelse_identifikation(hændelse) != "" && pbl53a_hændelse_identifikation_unik(hændelser, hændelse))
| pbl53a_hændelsesresultat(ordning: Pensionsbeskatningslov53AOrdning, resterende_principal_kroner: Heltal, hændelse: Pbl53AHændelse) -> match hændelse {
    | Pbl53AIndbetaling(fakta) -> Pbl53AIndbetalingBeregnet(pbl53a_indbetalingsresultat(ordning, fakta))
    | Pbl53AUdbetaling(fakta) -> Pbl53AUdbetalingBeregnet(pbl53a_udbetalingsresultat(ordning, resterende_principal_kroner, fakta))
}
| pbl53a_hændelsesresultat_gyldigt(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AIndbetalingBeregnet(indbetaling) -> indbetaling.fakta_gyldige
    | Pbl53AUdbetalingBeregnet(udbetaling) -> udbetaling.fakta_gyldige
}
| pbl53a_hændelsesresultat_principal_tilføjet_kroner(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AIndbetalingBeregnet(indbetaling) -> indbetaling.fradrags_eller_bortseelsesberettiget_principal_tilføjet_kroner
    | _ -> 0
}
| pbl53a_hændelsesresultat_principal_fordelt_kroner(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AUdbetalingBeregnet(udbetaling) -> udbetaling.principal_fordelt_til_udbetalingen_kroner
    | _ -> 0
}
| pbl53a_hændelsesresultat_personlig_indkomst_kroner(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AIndbetalingBeregnet(indbetaling) -> indbetaling.personlig_indkomst_kroner
    | Pbl53AUdbetalingBeregnet(udbetaling) -> udbetaling.personlig_indkomst_kroner
}
| pbl53a_hændelsesresultat_arbejdsmarkedsbidragspligtig_kroner(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AIndbetalingBeregnet(indbetaling) -> indbetaling.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner
    | Pbl53AUdbetalingBeregnet(udbetaling) -> udbetaling.arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner
}
| pbl53a_hændelsesresultat_arbejdsgiverfradrag_kroner(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AIndbetalingBeregnet(indbetaling) -> indbetaling.arbejdsgiverfradrag_for_sikkerhedsstillelse_kroner
    | _ -> 0
}
| pbl53a_hændelsesresultat_udenlandsk_skat_til_ligningslov33_kroner(resultat: Pbl53AHændelsesresultat) -> match resultat {
    | Pbl53AUdbetalingBeregnet(udbetaling) -> udbetaling.pbl20_stk6_resultat.udenlandsk_indkomstskat_til_ligningslov33_kroner
    | _ -> 0
}

# Pbl53AForløbstrinSag(input: Pbl53AForløbsinput, tilstand: Pbl53AForløbstilstand, hændelse: Pbl53AHændelse) {
    | tidspunkt() -> pbl53a_hændelse_tidspunkt(hændelse)
    | kronologisk() -> pbl53a_tidspunkt_efter_seneste(tilstand.seneste_tidspunkt, tidspunkt())
    | ikke_efter_indkomståret() -> tidspunkt().dato.år <= input.indkomstår
    | hændelsesresultat() -> pbl53a_hændelsesresultat(input.ordning, tilstand.resterende_fradrags_eller_bortseelsesberettiget_principal_kroner, hændelse)
    | hændelse_gyldig() -> kronologisk() && ikke_efter_indkomståret() && pbl53a_hændelsesresultat_gyldigt(hændelsesresultat())
    | principal_efter_kroner() -> hvis hændelse_gyldig() { tilstand.resterende_fradrags_eller_bortseelsesberettiget_principal_kroner + pbl53a_hændelsesresultat_principal_tilføjet_kroner(hændelsesresultat()) - pbl53a_hændelsesresultat_principal_fordelt_kroner(hændelsesresultat()) } ellers { tilstand.resterende_fradrags_eller_bortseelsesberettiget_principal_kroner }
    | medregnes_i_indkomståret() -> hændelse_gyldig() && tidspunkt().dato.år == input.indkomstår
    | resultat() -> Pbl53AForløbstilstand(
        seneste_tidspunkt = Pbl53ARegistreretTidspunkt(tidspunkt()),
        hændelsesresultater = concat(tilstand.hændelsesresultater, [hændelsesresultat()]),
        alle_hændelser_kronologiske = tilstand.alle_hændelser_kronologiske && kronologisk(),
        alle_hændelser_gyldige = tilstand.alle_hændelser_gyldige && hændelse_gyldig(),
        resterende_fradrags_eller_bortseelsesberettiget_principal_kroner = principal_efter_kroner(),
        personlig_indkomst_i_indkomståret_kroner = tilstand.personlig_indkomst_i_indkomståret_kroner + hvis medregnes_i_indkomståret() { pbl53a_hændelsesresultat_personlig_indkomst_kroner(hændelsesresultat()) } ellers { 0 },
        arbejdsmarkedsbidragspligtig_personlig_indkomst_i_indkomståret_kroner = tilstand.arbejdsmarkedsbidragspligtig_personlig_indkomst_i_indkomståret_kroner + hvis medregnes_i_indkomståret() { pbl53a_hændelsesresultat_arbejdsmarkedsbidragspligtig_kroner(hændelsesresultat()) } ellers { 0 },
        arbejdsgiverfradrag_i_indkomståret_kroner = tilstand.arbejdsgiverfradrag_i_indkomståret_kroner + hvis medregnes_i_indkomståret() { pbl53a_hændelsesresultat_arbejdsgiverfradrag_kroner(hændelsesresultat()) } ellers { 0 },
        udenlandsk_indkomstskat_til_ligningslov33_i_indkomståret_kroner = tilstand.udenlandsk_indkomstskat_til_ligningslov33_i_indkomståret_kroner + hvis medregnes_i_indkomståret() { pbl53a_hændelsesresultat_udenlandsk_skat_til_ligningslov33_kroner(hændelsesresultat()) } ellers { 0 }
    )
}
| pbl53a_forløbstrin(input: Pbl53AForløbsinput, tilstand: Pbl53AForløbstilstand, hændelse: Pbl53AHændelse) -> Pbl53AForløbstrinSag(input, tilstand, hændelse).resultat()
| pbl53a_tom_forløbstilstand() -> Pbl53AForløbstilstand(seneste_tidspunkt = Pbl53AIntetTidspunkt, hændelsesresultater = [], alle_hændelser_kronologiske = Sandt, alle_hændelser_gyldige = Sandt, resterende_fradrags_eller_bortseelsesberettiget_principal_kroner = 0, personlig_indkomst_i_indkomståret_kroner = 0, arbejdsmarkedsbidragspligtig_personlig_indkomst_i_indkomståret_kroner = 0, arbejdsgiverfradrag_i_indkomståret_kroner = 0, udenlandsk_indkomstskat_til_ligningslov33_i_indkomståret_kroner = 0)

# Pbl53AForløbssag(input: Pbl53AForløbsinput) {
    | tilstand() -> foldl(input.hændelser, pbl53a_tom_forløbstilstand(), |forløb: Pbl53AForløbstilstand, hændelse: Pbl53AHændelse| pbl53a_forløbstrin(input, forløb, hændelse))
    | identifikationer_entydige() -> pbl53a_hændelsesidentifikationer_entydige(input.hændelser)
    | hændelser_kronologiske() -> tilstand().alle_hændelser_kronologiske
    | alle_hændelser_gyldige() -> tilstand().alle_hændelser_gyldige
    | input_gyldigt() -> input.indkomstår > 0 && input.omfangsresultat.omfattes_af_par53a && pbl53a_omfang_klassifikation_matcher_ordning(input.omfangsresultat, input.ordning) && identifikationer_entydige() && alle_hændelser_gyldige()
    | beløb_eller_nul(beløb_kroner: Heltal) -> hvis input_gyldigt() { beløb_kroner } ellers { 0 }
    | resultat() -> Pbl53AForløbsresultat(
        input = input,
        hændelsesresultater = tilstand().hændelsesresultater,
        identifikationer_entydige = identifikationer_entydige(),
        hændelser_kronologiske = hændelser_kronologiske(),
        alle_hændelser_gyldige = alle_hændelser_gyldige(),
        input_gyldigt = input_gyldigt(),
        resterende_fradrags_eller_bortseelsesberettiget_principal_kroner = beløb_eller_nul(tilstand().resterende_fradrags_eller_bortseelsesberettiget_principal_kroner),
        personlig_indkomst_kroner = beløb_eller_nul(tilstand().personlig_indkomst_i_indkomståret_kroner),
        arbejdsmarkedsbidragspligtig_personlig_indkomst_kroner = beløb_eller_nul(tilstand().arbejdsmarkedsbidragspligtig_personlig_indkomst_i_indkomståret_kroner),
        arbejdsgiverfradrag_kroner = beløb_eller_nul(tilstand().arbejdsgiverfradrag_i_indkomståret_kroner),
        udenlandsk_indkomstskat_til_ligningslov33_kroner = beløb_eller_nul(tilstand().udenlandsk_indkomstskat_til_ligningslov33_i_indkomståret_kroner)
    )
}
| pbl53a_forløbsresultat(input: Pbl53AForløbsinput) -> Pbl53AForløbssag(input).resultat()

= pbl53a_afkastovergang_kildemeta = Metadata(
    attachments = (
        Source(value = pensionsbeskatningsloven_lbk1243_par53a),
        HistoricalSource(value = pensionsbeskatningsloven_lov569_par1_nr11_og_par6_stk1),
        PreparatorySource(value = pensionsbeskatningsloven_lsf229_1992_par6),
        HistoricalSource(value = pensionsbeskatningsloven_historisk_lbk1120_par53a_stk3),
        AmendmentSource(value = pensionsbeskatningsloven_lov313_par9_nr3_og_par19_stk3),
        TransitionSource(value = pensionsbeskatningsloven_lov1534_par1_nr37_og_par11_stk7),
        Guidance(value = skat_juridisk_vejledning_pbl53a_overgang),
        Guidance(value = skat_juridisk_vejledning_pbl53a_afkast),
        DependencySource(value = skattekontrolloven_lbk12_par18_stk1_nr2_litra_e),
    )
)

--@label:pensionsbeskatningsloven_par53a_afkastovergang::meta:pbl53a_afkastovergang_kildemeta--
----
§ 6. Loven træder i kraft dagen efter bekendtgørelsen i Lovtidende og har
virkning for forsikring og pensionsordning, der oprettes eller erhverves den
18. februar 1992 eller senere. Loven har dog ikke virkning for arv faldet den
18. februar 1992 eller senere af en forsikring oprettet før denne dato.

Bemærkninger til § 6:

Med oprettelse sidestilles erhvervelse. Køber en person den 18. februar 1992
eller senere en forsikring, der er oprettet før denne dato, bliver vedkommende
omfattet af reglerne i § 53 A. De foreslåede regler skal ikke have virkning for
forsikring, der er erhvervet den 18. februar 1992 eller senere, hvis den
skattepligtiges rettigheder til forsikringen er overgået til den skattepligtige
som følge af den tidligere ejers død efter denne dato.

§ 53 A.

Stk. 3. Ved opgørelsen af den skattepligtige indkomst medregnes afkastet af
livsforsikrings- og pensionsordninger som nævnt i stk. 1.
Indkomstskattepligten påhviler ejeren, den pensionsberettigede eller den eller
dem, der efter ejerens eller den første pensionsberettigedes død er berettiget
til udbetalinger af eller fra ordningen. I tilfælde omfattet af stk. 1, nr. 6,
påhviler indkomstskattepligten den pågældende direktør eller den eller dem, der
efter direktørens død er berettiget til udbetalinger af eller fra ordningen.
Afkastet opgøres som forskellen mellem på den ene side ordningens kapitalværdi
ved indkomstårets udgang med tillæg af udbetalinger i årets løb og på den anden
side ordningens kapitalværdi ved indkomstårets begyndelse med tillæg af
indbetalinger i årets løb. Ved opgørelsen af afkast på en livsforsikring eller
en pensionskasseordning, der i løbet af indkomståret stilles til sikkerhed for
et løfte om pension (pensionstilsagn) afgivet over for en direktør eller dennes
efterladte i forbindelse med et ansættelsesforhold, jf. stk. 1, nr. 6, eller
hvor sikkerhedsstillelsen ophører, træder kapitalværdien på tidspunktet for
sikkerhedsstillelsen henholdsvis ophøret i stedet for ordningens kapitalværdi
ved indkomstårets begyndelse henholdsvis udgang. Er der efter 2. pkt. flere
berettigede, fordeles det efter 4. pkt. opgjorte afkast efter forholdet mellem
kapitalværdien af de pågældendes respektive dele af ordningen. Et negativt
afkast af en ordning kan kun modregnes i det pågældende indkomstårs og de
følgende indkomstårs positive afkast af samme ordning. Et negativt afkast kan
kun fremføres til et senere indkomstår, hvis det ikke kan rummes i positivt
afkast i et tidligere indkomstår.

§ 9.

3. I § 53 A, stk. 3, 5. pkt., udgår »5«.

§ 19.

Stk. 3. § 2, nr. 1-3, § 3, § 4, nr. 1 og 2, § 5, nr. 2, § 6, § 7, nr. 2-5,
§ 8, nr. 1-5, 7 og 8, § 9, nr. 3, § 10, nr. 2-12, § 12, nr. 1, §§ 13 og 14,
§ 15, nr. 4 og 6, og § 16 har virkning for underskud og tab, der opstår i
indkomståret 2002 eller senere indkomstår, jf. dog stk. 4.

§ 11.

Stk. 7. § 1, nr. 36-38, og § 9, nr. 2, har for pensionsordninger, der er
oprettet eller erhvervet den 18. februar 1992 eller senere, virkning fra og med
den 1. januar 2010. Det gælder dog ikke arv, der falder fra og med den 1. januar
2010, af en forsikring oprettet før den 18. februar 1992.

Skattekontrolloven § 18, stk. 1, nr. 2:

En erklæring fra det udenlandske selskab, jf. dog § 19, hvori selskabet angiver
at ville påtage sig hvert år af egen drift senest den 31. januar at sende
følgende oplysninger vedrørende ordningen for det foregående kalenderår til
told- og skatteforvaltningen:

e) Oplysning om ordningens ophør eller overdragelse med angivelse af tidspunktet
for dette.
----

--@begin::pensionsbeskatningsloven_par53a_afkastovergang--
# Pbl53AAfkastgrundlag = Pbl53AAfkastEfterPal(afkast_efter_pal_par3_til_5_kroner: Heltal) | Pbl53AAlternativtKapitalværdiAfkast(kalenderårets_primo_depotværdi_kroner: Heltal, kalenderårets_ultimo_depotværdi_kroner: Heltal)
# Pbl53ASkattepligtsstatusVedÅretsBegyndelse = Pbl53ASkattepligtigVedÅretsBegyndelse | Pbl53AIkkeSkattepligtigVedÅretsBegyndelse
# Pbl53ASikkerhedsstatusVedÅretsBegyndelse = Pbl53ASikkerhedIkkeRelevant | Pbl53ASikkerhedBestårVedÅretsBegyndelse | Pbl53ASikkerhedBestårIkkeVedÅretsBegyndelse
# Pbl53AOplystAfkastgrænsehændelsesart = Pbl53ASkattepligtIndtræder | Pbl53ASkattepligtOphører | Pbl53ASikkerhedsstillelseEtableres | Pbl53ASikkerhedsstillelseOphører
# Pbl53AOplystAfkastgrænsehændelse(identifikation: Tekst, tidspunkt: Pbl15ATidspunkt, depotværdi_kroner: Heltal, art: Pbl53AOplystAfkastgrænsehændelsesart)
# Pbl53AAfkastgrænsehændelsesart = Pbl53AOplystAfkastgrænse(art: Pbl53AOplystAfkastgrænsehændelsesart) | Pbl53ARettighedErhverves | Pbl53ARettighedAfstås | Pbl53APar53AVirkningIndtræder
# Pbl53AAfkastgrænsehændelse(identifikation: Tekst, tidspunkt: Pbl15ATidspunkt, depotværdi_kroner: Heltal, art: Pbl53AAfkastgrænsehændelsesart)
# Pbl53ASenesteAfkastgrænsetidspunkt = Pbl53AIntetAfkastgrænsetidspunkt | Pbl53ARegistreretAfkastgrænsetidspunkt(tidspunkt: Pbl15ATidspunkt)
# Pbl53AAfkastgrænserækkefølgetilstand(seneste_tidspunkt: Pbl53ASenesteAfkastgrænsetidspunkt, kronologiske: Boolsk)
# Pbl53AAfkastgrænse = Pbl53AIngenAfkastgrænse | Pbl53ARegistreretAfkastgrænse(tidspunkt: Pbl15ATidspunkt, depotværdi_kroner: Heltal)
# Pbl53AAfkastperiode = Pbl53AIngenAfkastperiode | Pbl53ASammenhængendeAfkastperiode(starttidspunkt: Pbl15ATidspunkt, sluttidspunkt_eksklusiv: Pbl15ATidspunkt)
# Pbl53ABerettigetAndel(identifikation: Tekst, indestående_ved_afkastperiodens_udgang_kroner: Heltal)
# Pbl53AAfkastfordelingsfakta = Pbl53AAfledtEnkeltRettighedshaver | Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(rettighedsperiodereference: Pbl53ARettighedsperiodereference, samlet_indestående_ved_afkastperiodens_udgang_kroner: Heltal, andele: List(Pbl53ABerettigetAndel))
# Pbl53ARettighedsperiodevalg = Pbl53AIngenRettighedsperiodeIIndkomståret | Pbl53AEntydigRettighedsperiodeIIndkomståret(identifikation: Tekst) | Pbl53AFlereRettighedsperioderIIndkomståret(identifikationer: List(Tekst))
# Pbl53AAfkastårFakta(indkomstår: Heltal, afkastgrundlag: Pbl53AAfkastgrundlag, pensionsudbyder_opgjorde_afkast_efter_pal: Boolsk, skattepligtsstatus_ved_årets_begyndelse: Pbl53ASkattepligtsstatusVedÅretsBegyndelse, sikkerhedsstatus_ved_årets_begyndelse: Pbl53ASikkerhedsstatusVedÅretsBegyndelse, grænsehændelser: List(Pbl53AOplystAfkastgrænsehændelse), afkastfordeling: Pbl53AAfkastfordelingsfakta)
# Pbl53AAfkastperiodetilstand(skattepligtig: Boolsk, rettighedshaver: Boolsk, sikkerhedsstillelse_består: Boolsk, par53a_har_virkning: Boolsk, afkastbeskatning_aktiv: Boolsk, seneste_tidspunkt: Pbl53ASenesteAfkastgrænsetidspunkt, åbningsgrænse: Pbl53AAfkastgrænse, lukningsgrænse: Pbl53AAfkastgrænse, antal_sammenhængende_perioder: Heltal, hændelser_kronologiske: Boolsk, overgange_gyldige: Boolsk)
# Pbl53AAfkastperiodeResultat(fakta: Pbl53AAfkastårFakta, moderne_afkastvirkningsgrænse: Pbl53AModerneAfkastvirkningsgrænse, moderne_afkastvirkningsgrænse_understøttet: Boolsk, rettighedsperiodevalg: Pbl53ARettighedsperiodevalg, afledte_rettighedsgrænsehændelser: List(Pbl53AAfkastgrænsehændelse), afledte_moderne_virkningsgrænsehændelser: List(Pbl53AAfkastgrænsehændelse), samlede_grænsehændelser: List(Pbl53AAfkastgrænsehændelse), overgangsfakta_gyldige: Boolsk, rettighedsperiode_findes_entydigt: Boolsk, afkastperiode: Pbl53AAfkastperiode, grænsehændelsesidentifikationer_entydige: Boolsk, oplyste_grænsehændelser_kronologiske: Boolsk, hændelser_kronologiske: Boolsk, overgange_gyldige: Boolsk, periode_understøttet: Boolsk, kapitalværdi_primo_kroner: Heltal, kapitalværdi_ultimo_kroner: Heltal, indbetalinger_i_perioden_kroner: Heltal, udbetalinger_i_perioden_kroner: Heltal)

| pbl53a_direktørordning_kræver_sikkerhed(ordning: Pensionsbeskatningslov53AOrdning) -> ordning == Pbl53ADirektørSikkerhedLivsforsikringEllerPensionskasse
| pbl53a_skattepligtig_ved_årets_begyndelse(status: Pbl53ASkattepligtsstatusVedÅretsBegyndelse) -> status == Pbl53ASkattepligtigVedÅretsBegyndelse
| pbl53a_sikkerhed_består_ved_årets_begyndelse(status: Pbl53ASikkerhedsstatusVedÅretsBegyndelse) -> status == Pbl53ASikkerhedBestårVedÅretsBegyndelse
| pbl53a_sikkerhedsstatus_ved_årets_begyndelse_gyldig(ordning: Pensionsbeskatningslov53AOrdning, status: Pbl53ASikkerhedsstatusVedÅretsBegyndelse) -> hvis pbl53a_direktørordning_kræver_sikkerhed(ordning) { status != Pbl53ASikkerhedIkkeRelevant } ellers { status == Pbl53ASikkerhedIkkeRelevant }
| pbl53a_afkastbeskatning_aktiv(ordning: Pensionsbeskatningslov53AOrdning, skattepligtig: Boolsk, rettighedshaver: Boolsk, sikkerhedsstillelse_består: Boolsk, par53a_har_virkning: Boolsk) -> skattepligtig && rettighedshaver && par53a_har_virkning && (pbl53a_direktørordning_kræver_sikkerhed(ordning) == Falskt || sikkerhedsstillelse_består)
| pbl53a_skattepligt_efter_oplyst_grænsehændelse(skattepligtig_før: Boolsk, art: Pbl53AOplystAfkastgrænsehændelsesart) -> match art {
    | Pbl53ASkattepligtIndtræder -> Sandt
    | Pbl53ASkattepligtOphører -> Falskt
    | _ -> skattepligtig_før
}
| pbl53a_skattepligt_efter_grænsehændelse(skattepligtig_før: Boolsk, art: Pbl53AAfkastgrænsehændelsesart) -> match art {
    | Pbl53AOplystAfkastgrænse(oplyst_art) -> pbl53a_skattepligt_efter_oplyst_grænsehændelse(skattepligtig_før, oplyst_art)
    | _ -> skattepligtig_før
}
| pbl53a_sikkerhed_efter_oplyst_grænsehændelse(sikkerhed_før: Boolsk, art: Pbl53AOplystAfkastgrænsehændelsesart) -> match art {
    | Pbl53ASikkerhedsstillelseEtableres -> Sandt
    | Pbl53ASikkerhedsstillelseOphører -> Falskt
    | _ -> sikkerhed_før
}
| pbl53a_sikkerhed_efter_grænsehændelse(sikkerhed_før: Boolsk, art: Pbl53AAfkastgrænsehændelsesart) -> match art {
    | Pbl53AOplystAfkastgrænse(oplyst_art) -> pbl53a_sikkerhed_efter_oplyst_grænsehændelse(sikkerhed_før, oplyst_art)
    | _ -> sikkerhed_før
}
| pbl53a_rettighed_efter_grænsehændelse(rettighed_før: Boolsk, art: Pbl53AAfkastgrænsehændelsesart) -> match art {
    | Pbl53ARettighedErhverves -> Sandt
    | Pbl53ARettighedAfstås -> Falskt
    | _ -> rettighed_før
}
| pbl53a_moderne_afkastvirkningstidspunkt_gyldigt(kilde: Pbl53AModerneAfkastvirkningskilde, tidspunkt: Pbl15ATidspunkt) -> match kilde {
    | Pbl53AVirkningFraOprettelse -> pbl15a_dato_gyldig(tidspunkt.dato) && tidspunkt.rækkefølge_på_dagen == 0
    | Pbl53AVirkningFraErhvervelse(_) -> pbl15a_tidspunkt_gyldigt(tidspunkt)
    | Pbl53AVirkningFraKontraktændring(_) -> pbl15a_dato_gyldig(tidspunkt.dato) && tidspunkt.rækkefølge_på_dagen >= 0
    | Pbl53AVirkningFraOvergangsvalg -> pbl15a_dato_gyldig(tidspunkt.dato) && tidspunkt.rækkefølge_på_dagen >= 0
}
| pbl53a_moderne_afkastvirkningsgrænse_understøttet_i_indkomstår(grænse: Pbl53AModerneAfkastvirkningsgrænse, indkomstår: Heltal) -> match grænse {
    | Pbl53AIngenModerneAfkastvirkningsgrænse -> Sandt
    | Pbl53AKendtModerneAfkastvirkningsgrænse(kilde, tidspunkt, kapitalværdi_kroner) -> pbl53a_moderne_afkastvirkningstidspunkt_gyldigt(kilde, tidspunkt) && kapitalværdi_kroner >= 0
    | Pbl53AModerneAfkastvirkningsgrænseUdenKapitalværdi(_, dato) -> pbl15a_dato_gyldig(dato) && (dato.år != indkomstår || dato.måned == 1 && dato.dag == 1)
}
| pbl53a_moderne_virkning_ved_årets_begyndelse(grænse: Pbl53AModerneAfkastvirkningsgrænse, indkomstår: Heltal) -> {
    = årsbegyndelse = Pbl15ATidspunkt(dato = Pbl15ADato(år = indkomstår, måned = 1, dag = 1), rækkefølge_på_dagen = 0)
    match grænse {
        | Pbl53AIngenModerneAfkastvirkningsgrænse -> Falskt
        | Pbl53AKendtModerneAfkastvirkningsgrænse(_, tidspunkt, _) -> tidspunkt == årsbegyndelse || pbl15a_tidspunkt_før(tidspunkt, årsbegyndelse)
        | Pbl53AModerneAfkastvirkningsgrænseUdenKapitalværdi(_, dato) -> pbl15a_dato_nøgle(dato) <= pbl15a_dato_nøgle(årsbegyndelse.dato)
    }
}
| pbl53a_moderne_virkning_efter_tidspunkt(før: Boolsk, grænse: Pbl53AModerneAfkastvirkningsgrænse, tidspunkt: Pbl15ATidspunkt) -> hvis før {
    Sandt
} ellers {
    match grænse {
        | Pbl53AKendtModerneAfkastvirkningsgrænse(_, virkningstidspunkt, _) -> tidspunkt == virkningstidspunkt || pbl15a_tidspunkt_før(virkningstidspunkt, tidspunkt)
        | _ -> Falskt
    }
}
| pbl53a_oplyst_grænsehændelsesovergang_gyldig(ordning: Pensionsbeskatningslov53AOrdning, tilstand: Pbl53AAfkastperiodetilstand, art: Pbl53AOplystAfkastgrænsehændelsesart) -> match art {
    | Pbl53ASkattepligtIndtræder -> tilstand.skattepligtig == Falskt
    | Pbl53ASkattepligtOphører -> tilstand.skattepligtig
    | Pbl53ASikkerhedsstillelseEtableres -> pbl53a_direktørordning_kræver_sikkerhed(ordning) && tilstand.sikkerhedsstillelse_består == Falskt
    | Pbl53ASikkerhedsstillelseOphører -> pbl53a_direktørordning_kræver_sikkerhed(ordning) && tilstand.sikkerhedsstillelse_består
}
| pbl53a_grænsehændelsesovergang_gyldig(ordning: Pensionsbeskatningslov53AOrdning, tilstand: Pbl53AAfkastperiodetilstand, art: Pbl53AAfkastgrænsehændelsesart) -> match art {
    | Pbl53AOplystAfkastgrænse(oplyst_art) -> pbl53a_oplyst_grænsehændelsesovergang_gyldig(ordning, tilstand, oplyst_art)
    | Pbl53ARettighedErhverves -> tilstand.rettighedshaver == Falskt
    | Pbl53ARettighedAfstås -> tilstand.rettighedshaver
    | Pbl53APar53AVirkningIndtræder -> tilstand.par53a_har_virkning == Falskt
}
| pbl53a_afkastgrænsetidspunkt_efter_seneste(seneste: Pbl53ASenesteAfkastgrænsetidspunkt, tidspunkt: Pbl15ATidspunkt) -> match seneste {
    | Pbl53AIntetAfkastgrænsetidspunkt -> Sandt
    | Pbl53ARegistreretAfkastgrænsetidspunkt(forrige) -> pbl15a_tidspunkt_før(forrige, tidspunkt)
}
| pbl53a_afkastgrænserækkefølge_trin(tilstand: Pbl53AAfkastgrænserækkefølgetilstand, hændelse: Pbl53AOplystAfkastgrænsehændelse) -> Pbl53AAfkastgrænserækkefølgetilstand(
    seneste_tidspunkt = Pbl53ARegistreretAfkastgrænsetidspunkt(tidspunkt = hændelse.tidspunkt),
    kronologiske = tilstand.kronologiske && pbl53a_afkastgrænsetidspunkt_efter_seneste(tilstand.seneste_tidspunkt, hændelse.tidspunkt)
)
| pbl53a_oplyste_grænsehændelser_kronologiske(hændelser: List(Pbl53AOplystAfkastgrænsehændelse)) -> foldl(
    hændelser,
    Pbl53AAfkastgrænserækkefølgetilstand(seneste_tidspunkt = Pbl53AIntetAfkastgrænsetidspunkt, kronologiske = Sandt),
    |tilstand: Pbl53AAfkastgrænserækkefølgetilstand, hændelse: Pbl53AOplystAfkastgrænsehændelse| pbl53a_afkastgrænserækkefølge_trin(tilstand, hændelse)
).kronologiske
| pbl53a_grænsehændelse_identifikation_unik(hændelser: List(Pbl53AAfkastgrænsehændelse), hændelse: Pbl53AAfkastgrænsehændelse) -> length(filter(hændelser, |anden: Pbl53AAfkastgrænsehændelse| anden.identifikation == hændelse.identifikation)) == 1
| pbl53a_grænsehændelsesidentifikationer_entydige(hændelser: List(Pbl53AAfkastgrænsehændelse)) -> all(hændelser, |hændelse: Pbl53AAfkastgrænsehændelse| hændelse.identifikation != "" && pbl53a_grænsehændelse_identifikation_unik(hændelser, hændelse))
| pbl53a_er_afledt_rettighedsgrænse(art: Pbl53AAfkastgrænsehændelsesart) -> art == Pbl53ARettighedErhverves || art == Pbl53ARettighedAfstås
| pbl53a_er_afledt_moderne_virkningsgrænse(art: Pbl53AAfkastgrænsehændelsesart) -> art == Pbl53APar53AVirkningIndtræder
| pbl53a_grænsehændelse_grundfakta_gyldige(indkomstår: Heltal, hændelse: Pbl53AAfkastgrænsehændelse) -> hændelse.identifikation != "" && pbl15a_dato_gyldig(hændelse.tidspunkt.dato) && hændelse.tidspunkt.dato.år == indkomstår && (hændelse.tidspunkt.rækkefølge_på_dagen > 0 || hændelse.tidspunkt.rækkefølge_på_dagen == 0 && (pbl53a_er_afledt_rettighedsgrænse(hændelse.art) || pbl53a_er_afledt_moderne_virkningsgrænse(hændelse.art))) && hændelse.depotværdi_kroner >= 0
| pbl53a_rettighedsperiode_omfatter_tidspunkt(periode: Pbl53ARettighedsperiode, tidspunkt: Pbl15ATidspunkt) -> (periode.starttidspunkt == tidspunkt || pbl15a_tidspunkt_før(periode.starttidspunkt, tidspunkt)) && match periode.slutning {
    | Pbl53AÅbenRettighedsperiode -> Sandt
    | Pbl53ARettighedsperiodeSlutter(_, sluttidspunkt, _) -> pbl15a_tidspunkt_før(tidspunkt, sluttidspunkt)
}
| pbl53a_rettighedsperiode_matcher_afkastfordeling(skatteyder_identifikation: Tekst, afkastfordeling: Pbl53AAfkastfordelingsfakta, periode: Pbl53ARettighedsperiode) -> match afkastfordeling {
    | Pbl53AAfledtEnkeltRettighedshaver -> periode.rettighedshaver_identifikation == skatteyder_identifikation
    | Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(rettighedsperiodereference, _, _) -> periode.reference == rettighedsperiodereference
}
| pbl53a_rettighedsperiode_skærer_indkomstår(indkomstår: Heltal, periode: Pbl53ARettighedsperiode) -> {
    = årsbegyndelse = Pbl15ATidspunkt(dato = Pbl15ADato(år = indkomstår, måned = 1, dag = 1), rækkefølge_på_dagen = 0)
    = næste_årsbegyndelse = Pbl15ATidspunkt(dato = Pbl15ADato(år = indkomstår + 1, måned = 1, dag = 1), rækkefølge_på_dagen = 0)
    = starter_før_årets_slutning = pbl15a_tidspunkt_før(periode.starttidspunkt, næste_årsbegyndelse)
    = slutter_efter_årets_begyndelse = match periode.slutning {
        | Pbl53AÅbenRettighedsperiode -> Sandt
        | Pbl53ARettighedsperiodeSlutter(_, sluttidspunkt, _) -> pbl15a_tidspunkt_før(årsbegyndelse, sluttidspunkt)
    }
    indkomstår > 0 && starter_før_årets_slutning && slutter_efter_årets_begyndelse
}
| pbl53a_rettighedsperioder_for_afkastfordeling_i_indkomstår(skatteyder_identifikation: Tekst, indkomstår: Heltal, overgang: Pbl53AOvergangsresultat, afkastfordeling: Pbl53AAfkastfordelingsfakta) -> filter(overgang.rettighedsperioder, |periode: Pbl53ARettighedsperiode| pbl53a_rettighedsperiode_matcher_afkastfordeling(skatteyder_identifikation, afkastfordeling, periode) && pbl53a_rettighedsperiode_skærer_indkomstår(indkomstår, periode))
| pbl53a_rettighedsperiodeidentifikationer(perioder: List(Pbl53ARettighedsperiode)) -> map(perioder, |periode: Pbl53ARettighedsperiode| periode.identifikation)
| pbl53a_rettighedsperiodevalg(perioder: List(Pbl53ARettighedsperiode)) -> hvis length(perioder) == 0 {
    Pbl53AIngenRettighedsperiodeIIndkomståret
} ellers hvis length(perioder) == 1 {
    Pbl53AEntydigRettighedsperiodeIIndkomståret(identifikation = perioder[0].identifikation)
} ellers {
    Pbl53AFlereRettighedsperioderIIndkomståret(identifikationer = pbl53a_rettighedsperiodeidentifikationer(perioder))
}
| pbl53a_rettighedsperiodevalg_er_entydigt(valg: Pbl53ARettighedsperiodevalg) -> match valg {
    | Pbl53AEntydigRettighedsperiodeIIndkomståret(_) -> Sandt
    | _ -> Falskt
}
| pbl53a_rettighedshaver_ved_årets_begyndelse(indkomstår: Heltal, perioder_i_indkomståret: List(Pbl53ARettighedsperiode)) -> {
    = årsbegyndelse = Pbl15ATidspunkt(dato = Pbl15ADato(år = indkomstår, måned = 1, dag = 1), rækkefølge_på_dagen = 0)
    any(perioder_i_indkomståret, |periode: Pbl53ARettighedsperiode| pbl53a_rettighedsperiode_omfatter_tidspunkt(periode, årsbegyndelse))
}
| pbl53a_rettighedsperiode_startgrænse_i_år(indkomstår: Heltal, periode: Pbl53ARettighedsperiode) -> hvis periode.starttidspunkt.dato.år == indkomstår && periode.starttidspunkt != Pbl15ATidspunkt(dato = Pbl15ADato(år = indkomstår, måned = 1, dag = 1), rækkefølge_på_dagen = 0) {
    [Pbl53AAfkastgrænsehændelse(
        identifikation = "rettighed-erhverves:" + periode.identifikation,
        tidspunkt = periode.starttidspunkt,
        depotværdi_kroner = periode.kapitalværdi_ved_starten_kroner,
        art = Pbl53ARettighedErhverves
    )]
} ellers {
    []
}
| pbl53a_rettighedsperiode_slutgrænse_i_år(indkomstår: Heltal, periode: Pbl53ARettighedsperiode) -> match periode.slutning {
    | Pbl53ARettighedsperiodeSlutter(erhvervelse_identifikation, tidspunkt, kapitalværdi_kroner) -> hvis tidspunkt.dato.år == indkomstår {
        [Pbl53AAfkastgrænsehændelse(
            identifikation = "rettighed-afstås:" + erhvervelse_identifikation,
            tidspunkt = tidspunkt,
            depotværdi_kroner = kapitalværdi_kroner,
            art = Pbl53ARettighedAfstås
        )]
    } ellers {
        []
    }
    | Pbl53AÅbenRettighedsperiode -> []
}
| pbl53a_rettighedsperiode_grænser_i_år(indkomstår: Heltal, periode: Pbl53ARettighedsperiode) -> concat(
    pbl53a_rettighedsperiode_startgrænse_i_år(indkomstår, periode),
    pbl53a_rettighedsperiode_slutgrænse_i_år(indkomstår, periode)
)
| pbl53a_afledte_rettighedsgrænsehændelser(indkomstår: Heltal, perioder_i_indkomståret: List(Pbl53ARettighedsperiode)) -> flat_map(perioder_i_indkomståret, |periode: Pbl53ARettighedsperiode| pbl53a_rettighedsperiode_grænser_i_år(indkomstår, periode))
| pbl53a_moderne_afkastvirkningskilde_identifikation(kilde: Pbl53AModerneAfkastvirkningskilde) -> match kilde {
    | Pbl53AVirkningFraOprettelse -> "oprettelse"
    | Pbl53AVirkningFraErhvervelse(erhvervelsesidentifikation) -> "erhvervelse:" + erhvervelsesidentifikation
    | Pbl53AVirkningFraKontraktændring(ændringsidentifikation) -> "kontraktændring:" + ændringsidentifikation
    | Pbl53AVirkningFraOvergangsvalg -> "overgangsvalg"
}
| pbl53a_rettighedsgrænse_matcher_moderne_afkastvirkningsgrænse(hændelse: Pbl53AAfkastgrænsehændelse, grænse: Pbl53AModerneAfkastvirkningsgrænse) -> match grænse {
    | Pbl53AKendtModerneAfkastvirkningsgrænse(_, tidspunkt, kapitalværdi_kroner) -> pbl53a_er_afledt_rettighedsgrænse(hændelse.art) && hændelse.tidspunkt == tidspunkt && hændelse.depotværdi_kroner == kapitalværdi_kroner
    | _ -> Falskt
}
| pbl53a_afledte_moderne_virkningsgrænsehændelser(indkomstår: Heltal, grænse: Pbl53AModerneAfkastvirkningsgrænse, rettighedsgrænser: List(Pbl53AAfkastgrænsehændelse)) -> match grænse {
    | Pbl53AKendtModerneAfkastvirkningsgrænse(kilde, tidspunkt, kapitalværdi_kroner) -> hvis tidspunkt.dato.år == indkomstår && pbl53a_moderne_virkning_ved_årets_begyndelse(grænse, indkomstår) == Falskt && any(rettighedsgrænser, |hændelse: Pbl53AAfkastgrænsehændelse| pbl53a_rettighedsgrænse_matcher_moderne_afkastvirkningsgrænse(hændelse, grænse)) == Falskt {
        [Pbl53AAfkastgrænsehændelse(
            identifikation = "par53a-virkning:" + pbl53a_moderne_afkastvirkningskilde_identifikation(kilde),
            tidspunkt = tidspunkt,
            depotværdi_kroner = kapitalværdi_kroner,
            art = Pbl53APar53AVirkningIndtræder
        )]
    } ellers {
        []
    }
    | _ -> []
}
| pbl53a_oplyst_afkastgrænsehændelse_som_intern(hændelse: Pbl53AOplystAfkastgrænsehændelse) -> Pbl53AAfkastgrænsehændelse(
    identifikation = hændelse.identifikation,
    tidspunkt = hændelse.tidspunkt,
    depotværdi_kroner = hændelse.depotværdi_kroner,
    art = Pbl53AOplystAfkastgrænse(art = hændelse.art)
)
| pbl53a_oplyste_afkastgrænsehændelser_som_interne(hændelser: List(Pbl53AOplystAfkastgrænsehændelse)) -> map(hændelser, pbl53a_oplyst_afkastgrænsehændelse_som_intern)
| pbl53a_afkastgrænsehændelse_sorteringsnøgle(hændelse: Pbl53AAfkastgrænsehændelse) -> pbl15a_dato_nøgle(hændelse.tidspunkt.dato) * 1000000 + hændelse.tidspunkt.rækkefølge_på_dagen
| pbl53a_samlede_grænsehændelser(oplyste: List(Pbl53AOplystAfkastgrænsehændelse), afledte: List(Pbl53AAfkastgrænsehændelse)) -> sort_by(concat(pbl53a_oplyste_afkastgrænsehændelser_som_interne(oplyste), afledte), pbl53a_afkastgrænsehændelse_sorteringsnøgle)

# Pbl53AAfkastgrænsetrinSag(ordning: Pensionsbeskatningslov53AOrdning, indkomstår: Heltal, moderne_afkastvirkningsgrænse: Pbl53AModerneAfkastvirkningsgrænse, tilstand: Pbl53AAfkastperiodetilstand, hændelse: Pbl53AAfkastgrænsehændelse) {
    | kronologisk() -> pbl53a_afkastgrænsetidspunkt_efter_seneste(tilstand.seneste_tidspunkt, hændelse.tidspunkt)
    | overgang_gyldig() -> pbl53a_grænsehændelsesovergang_gyldig(ordning, tilstand, hændelse.art)
    | hændelse_gyldig() -> pbl53a_grænsehændelse_grundfakta_gyldige(indkomstår, hændelse) && kronologisk() && overgang_gyldig()
    | skattepligtig_efter() -> hvis hændelse_gyldig() { pbl53a_skattepligt_efter_grænsehændelse(tilstand.skattepligtig, hændelse.art) } ellers { tilstand.skattepligtig }
    | rettighedshaver_efter() -> hvis hændelse_gyldig() { pbl53a_rettighed_efter_grænsehændelse(tilstand.rettighedshaver, hændelse.art) } ellers { tilstand.rettighedshaver }
    | sikkerhed_efter() -> hvis hændelse_gyldig() { pbl53a_sikkerhed_efter_grænsehændelse(tilstand.sikkerhedsstillelse_består, hændelse.art) } ellers { tilstand.sikkerhedsstillelse_består }
    | par53a_har_virkning_efter() -> hvis hændelse_gyldig() { pbl53a_moderne_virkning_efter_tidspunkt(tilstand.par53a_har_virkning, moderne_afkastvirkningsgrænse, hændelse.tidspunkt) } ellers { tilstand.par53a_har_virkning }
    | aktiv_efter() -> pbl53a_afkastbeskatning_aktiv(ordning, skattepligtig_efter(), rettighedshaver_efter(), sikkerhed_efter(), par53a_har_virkning_efter())
    | periode_begynder() -> hændelse_gyldig() && tilstand.afkastbeskatning_aktiv == Falskt && aktiv_efter()
    | periode_ophører() -> hændelse_gyldig() && tilstand.afkastbeskatning_aktiv && aktiv_efter() == Falskt
    | åbningsgrænse_efter() -> hvis periode_begynder() && tilstand.antal_sammenhængende_perioder == 0 { Pbl53ARegistreretAfkastgrænse(tidspunkt = hændelse.tidspunkt, depotværdi_kroner = hændelse.depotværdi_kroner) } ellers { tilstand.åbningsgrænse }
    | lukningsgrænse_efter() -> hvis periode_ophører() { Pbl53ARegistreretAfkastgrænse(tidspunkt = hændelse.tidspunkt, depotværdi_kroner = hændelse.depotværdi_kroner) } ellers { tilstand.lukningsgrænse }
    | resultat() -> Pbl53AAfkastperiodetilstand(
        skattepligtig = skattepligtig_efter(),
        rettighedshaver = rettighedshaver_efter(),
        sikkerhedsstillelse_består = sikkerhed_efter(),
        par53a_har_virkning = par53a_har_virkning_efter(),
        afkastbeskatning_aktiv = aktiv_efter(),
        seneste_tidspunkt = Pbl53ARegistreretAfkastgrænsetidspunkt(tidspunkt = hændelse.tidspunkt),
        åbningsgrænse = åbningsgrænse_efter(),
        lukningsgrænse = lukningsgrænse_efter(),
        antal_sammenhængende_perioder = tilstand.antal_sammenhængende_perioder + hvis periode_begynder() { 1 } ellers { 0 },
        hændelser_kronologiske = tilstand.hændelser_kronologiske && kronologisk(),
        overgange_gyldige = tilstand.overgange_gyldige && hændelse_gyldig()
    )
}
| pbl53a_afkastgrænsetrin(ordning: Pensionsbeskatningslov53AOrdning, indkomstår: Heltal, moderne_afkastvirkningsgrænse: Pbl53AModerneAfkastvirkningsgrænse, tilstand: Pbl53AAfkastperiodetilstand, hændelse: Pbl53AAfkastgrænsehændelse) -> Pbl53AAfkastgrænsetrinSag(ordning, indkomstår, moderne_afkastvirkningsgrænse, tilstand, hændelse).resultat()
| pbl53a_tom_afkastperiodetilstand(ordning: Pensionsbeskatningslov53AOrdning, perioder_i_indkomståret: List(Pbl53ARettighedsperiode), omfangsresultat: Pbl53AOmfangsresultat, fakta: Pbl53AAfkastårFakta) -> {
    = overgang = omfangsresultat.overgangsresultat
    = skattepligtig = pbl53a_skattepligtig_ved_årets_begyndelse(fakta.skattepligtsstatus_ved_årets_begyndelse)
    = rettighedshaver = pbl53a_rettighedshaver_ved_årets_begyndelse(fakta.indkomstår, perioder_i_indkomståret)
    = sikkerhed = pbl53a_sikkerhed_består_ved_årets_begyndelse(fakta.sikkerhedsstatus_ved_årets_begyndelse)
    = par53a_har_virkning = pbl53a_moderne_virkning_ved_årets_begyndelse(overgang.moderne_afkastvirkningsgrænse, fakta.indkomstår)
    = aktiv = pbl53a_afkastbeskatning_aktiv(ordning, skattepligtig, rettighedshaver, sikkerhed, par53a_har_virkning)
    = årsbegyndelse = Pbl15ATidspunkt(dato = Pbl15ADato(år = fakta.indkomstår, måned = 1, dag = 1), rækkefølge_på_dagen = 0)
    Pbl53AAfkastperiodetilstand(
        skattepligtig = skattepligtig,
        rettighedshaver = rettighedshaver,
        sikkerhedsstillelse_består = sikkerhed,
        par53a_har_virkning = par53a_har_virkning,
        afkastbeskatning_aktiv = aktiv,
        seneste_tidspunkt = Pbl53AIntetAfkastgrænsetidspunkt,
        åbningsgrænse = hvis aktiv { Pbl53ARegistreretAfkastgrænse(tidspunkt = årsbegyndelse, depotværdi_kroner = pbl53a_kalenderårets_primo_depotværdi_kroner(fakta.afkastgrundlag)) } ellers { Pbl53AIngenAfkastgrænse },
        lukningsgrænse = Pbl53AIngenAfkastgrænse,
        antal_sammenhængende_perioder = hvis aktiv { 1 } ellers { 0 },
        hændelser_kronologiske = Sandt,
        overgange_gyldige = overgang.fakta_gyldige && pbl53a_sikkerhedsstatus_ved_årets_begyndelse_gyldig(ordning, fakta.sikkerhedsstatus_ved_årets_begyndelse)
    )
}
| pbl53a_kalenderårets_primo_depotværdi_kroner(grundlag: Pbl53AAfkastgrundlag) -> match grundlag {
    | Pbl53AAfkastEfterPal(_) -> 0
    | Pbl53AAlternativtKapitalværdiAfkast(primo_kroner, _) -> primo_kroner
}
| pbl53a_kalenderårets_ultimo_depotværdi_kroner(grundlag: Pbl53AAfkastgrundlag) -> match grundlag {
    | Pbl53AAfkastEfterPal(_) -> 0
    | Pbl53AAlternativtKapitalværdiAfkast(_, ultimo_kroner) -> ultimo_kroner
}
| pbl53a_afkastgrundlag_grundfakta_gyldige(grundlag: Pbl53AAfkastgrundlag) -> match grundlag {
    | Pbl53AAfkastEfterPal(_) -> Sandt
    | Pbl53AAlternativtKapitalværdiAfkast(primo_kroner, ultimo_kroner) -> primo_kroner >= 0 && ultimo_kroner >= 0
}
| pbl53a_afkastgrænse_tidspunkt(grænse: Pbl53AAfkastgrænse, indkomstår: Heltal) -> match grænse {
    | Pbl53ARegistreretAfkastgrænse(tidspunkt, _) -> tidspunkt
    | Pbl53AIngenAfkastgrænse -> Pbl15ATidspunkt(dato = Pbl15ADato(år = indkomstår, måned = 1, dag = 1), rækkefølge_på_dagen = 0)
}
| pbl53a_afkastgrænse_depotværdi_kroner(grænse: Pbl53AAfkastgrænse) -> match grænse {
    | Pbl53ARegistreretAfkastgrænse(_, depotværdi_kroner) -> depotværdi_kroner
    | Pbl53AIngenAfkastgrænse -> 0
}
| pbl53a_hændelsestidspunkt_som_pbl15a(tidspunkt: Pbl53ATidspunkt) -> Pbl15ATidspunkt(dato = tidspunkt.dato, rækkefølge_på_dagen = tidspunkt.rækkefølge_på_dagen)
| pbl53a_tidspunkt_i_afkastperiode(tidspunkt: Pbl15ATidspunkt, periode: Pbl53AAfkastperiode) -> match periode {
    | Pbl53ASammenhængendeAfkastperiode(starttidspunkt, sluttidspunkt_eksklusiv) -> (tidspunkt == starttidspunkt || pbl15a_tidspunkt_før(starttidspunkt, tidspunkt)) && pbl15a_tidspunkt_før(tidspunkt, sluttidspunkt_eksklusiv)
    | Pbl53AIngenAfkastperiode -> Falskt
}
| pbl53a_afkastindbetaling_for_hændelse_kroner(hændelse: Pbl53AHændelse) -> match hændelse {
    | Pbl53AIndbetaling(fakta) -> fakta.beløb_kroner
    | _ -> 0
}
| pbl53a_afkastudbetaling_for_hændelse_kroner(hændelse: Pbl53AHændelse) -> match hændelse {
    | Pbl53AUdbetaling(fakta) -> match fakta.art {
        | Pbl53AUdbetalingFraOrdningen(_, _, _, _) -> fakta.bruttoudbetaling_kroner
        | Pbl53AUdbetalingTilAfkastskat(_, _, _, _, _) -> fakta.bruttoudbetaling_kroner
        | _ -> 0
    }
    | _ -> 0
}
| pbl53a_hændelsesbeløb_i_afkastperiode_kroner(hændelser: List(Pbl53AHændelse), periode: Pbl53AAfkastperiode, beløb: (Pbl53AHændelse) -> Heltal) -> foldl(hændelser, 0, |sum: Heltal, hændelse: Pbl53AHændelse| sum + hvis pbl53a_tidspunkt_i_afkastperiode(pbl53a_hændelsestidspunkt_som_pbl15a(pbl53a_hændelse_tidspunkt(hændelse)), periode) { beløb(hændelse) } ellers { 0 })

# Pbl53AAfkastperiodeSag(ordning: Pensionsbeskatningslov53AOrdning, skatteyder_identifikation: Tekst, omfangsresultat: Pbl53AOmfangsresultat, fakta: Pbl53AAfkastårFakta, hændelser: List(Pbl53AHændelse)) {
    | overgang() -> omfangsresultat.overgangsresultat
    | moderne_afkastvirkningsgrænse() -> overgang().moderne_afkastvirkningsgrænse
    | moderne_afkastvirkningsgrænse_understøttet() -> pbl53a_moderne_afkastvirkningsgrænse_understøttet_i_indkomstår(moderne_afkastvirkningsgrænse(), fakta.indkomstår)
    | rettighedsperioder_i_indkomståret() -> pbl53a_rettighedsperioder_for_afkastfordeling_i_indkomstår(skatteyder_identifikation, fakta.indkomstår, overgang(), fakta.afkastfordeling)
    | rettighedsperiodevalg() -> pbl53a_rettighedsperiodevalg(rettighedsperioder_i_indkomståret())
    | rettighedsperiode_findes_entydigt() -> pbl53a_rettighedsperiodevalg_er_entydigt(rettighedsperiodevalg())
    | afledte_rettighedsgrænsehændelser() -> pbl53a_afledte_rettighedsgrænsehændelser(fakta.indkomstår, rettighedsperioder_i_indkomståret())
    | afledte_moderne_virkningsgrænsehændelser() -> pbl53a_afledte_moderne_virkningsgrænsehændelser(fakta.indkomstår, moderne_afkastvirkningsgrænse(), afledte_rettighedsgrænsehændelser())
    | afledte_grænsehændelser() -> concat(afledte_rettighedsgrænsehændelser(), afledte_moderne_virkningsgrænsehændelser())
    | samlede_grænsehændelser() -> pbl53a_samlede_grænsehændelser(fakta.grænsehændelser, afledte_grænsehændelser())
    | foldet_tilstand() -> foldl(samlede_grænsehændelser(), pbl53a_tom_afkastperiodetilstand(ordning, rettighedsperioder_i_indkomståret(), omfangsresultat, fakta), |tilstand: Pbl53AAfkastperiodetilstand, hændelse: Pbl53AAfkastgrænsehændelse| pbl53a_afkastgrænsetrin(ordning, fakta.indkomstår, moderne_afkastvirkningsgrænse(), tilstand, hændelse))
    | lukningsgrænse() -> hvis foldet_tilstand().afkastbeskatning_aktiv { Pbl53ARegistreretAfkastgrænse(tidspunkt = Pbl15ATidspunkt(dato = Pbl15ADato(år = fakta.indkomstår + 1, måned = 1, dag = 1), rækkefølge_på_dagen = 0), depotværdi_kroner = pbl53a_kalenderårets_ultimo_depotværdi_kroner(fakta.afkastgrundlag)) } ellers { foldet_tilstand().lukningsgrænse }
    | afkastperiode() -> hvis foldet_tilstand().antal_sammenhængende_perioder == 1 { Pbl53ASammenhængendeAfkastperiode(starttidspunkt = pbl53a_afkastgrænse_tidspunkt(foldet_tilstand().åbningsgrænse, fakta.indkomstår), sluttidspunkt_eksklusiv = pbl53a_afkastgrænse_tidspunkt(lukningsgrænse(), fakta.indkomstår + 1)) } ellers { Pbl53AIngenAfkastperiode }
    | grænsehændelsesidentifikationer_entydige() -> pbl53a_grænsehændelsesidentifikationer_entydige(samlede_grænsehændelser())
    | oplyste_grænsehændelser_kronologiske() -> pbl53a_oplyste_grænsehændelser_kronologiske(fakta.grænsehændelser)
    | hændelser_kronologiske() -> oplyste_grænsehændelser_kronologiske() && foldet_tilstand().hændelser_kronologiske
    | periode_understøttet() -> skatteyder_identifikation != "" && overgang().fakta_gyldige && moderne_afkastvirkningsgrænse_understøttet() && rettighedsperiode_findes_entydigt() && fakta.indkomstår > 0 && pbl53a_afkastgrundlag_grundfakta_gyldige(fakta.afkastgrundlag) && grænsehændelsesidentifikationer_entydige() && hændelser_kronologiske() && foldet_tilstand().overgange_gyldige && foldet_tilstand().antal_sammenhængende_perioder <= 1
    | kapitalværdi_primo_kroner() -> hvis periode_understøttet() { pbl53a_afkastgrænse_depotværdi_kroner(foldet_tilstand().åbningsgrænse) } ellers { 0 }
    | kapitalværdi_ultimo_kroner() -> hvis periode_understøttet() { pbl53a_afkastgrænse_depotværdi_kroner(lukningsgrænse()) } ellers { 0 }
    | indbetalinger_i_perioden_kroner() -> hvis periode_understøttet() { pbl53a_hændelsesbeløb_i_afkastperiode_kroner(hændelser, afkastperiode(), pbl53a_afkastindbetaling_for_hændelse_kroner) } ellers { 0 }
    | udbetalinger_i_perioden_kroner() -> hvis periode_understøttet() { pbl53a_hændelsesbeløb_i_afkastperiode_kroner(hændelser, afkastperiode(), pbl53a_afkastudbetaling_for_hændelse_kroner) } ellers { 0 }
    | resultat() -> Pbl53AAfkastperiodeResultat(
        fakta = fakta,
        moderne_afkastvirkningsgrænse = moderne_afkastvirkningsgrænse(),
        moderne_afkastvirkningsgrænse_understøttet = moderne_afkastvirkningsgrænse_understøttet(),
        rettighedsperiodevalg = rettighedsperiodevalg(),
        afledte_rettighedsgrænsehændelser = afledte_rettighedsgrænsehændelser(),
        afledte_moderne_virkningsgrænsehændelser = afledte_moderne_virkningsgrænsehændelser(),
        samlede_grænsehændelser = samlede_grænsehændelser(),
        overgangsfakta_gyldige = overgang().fakta_gyldige,
        rettighedsperiode_findes_entydigt = rettighedsperiode_findes_entydigt(),
        afkastperiode = afkastperiode(),
        grænsehændelsesidentifikationer_entydige = grænsehændelsesidentifikationer_entydige(),
        oplyste_grænsehændelser_kronologiske = oplyste_grænsehændelser_kronologiske(),
        hændelser_kronologiske = hændelser_kronologiske(),
        overgange_gyldige = foldet_tilstand().overgange_gyldige,
        periode_understøttet = periode_understøttet(),
        kapitalværdi_primo_kroner = kapitalværdi_primo_kroner(),
        kapitalværdi_ultimo_kroner = kapitalværdi_ultimo_kroner(),
        indbetalinger_i_perioden_kroner = indbetalinger_i_perioden_kroner(),
        udbetalinger_i_perioden_kroner = udbetalinger_i_perioden_kroner()
    )
}
| pbl53a_afkastperiode_resultat(ordning: Pensionsbeskatningslov53AOrdning, skatteyder_identifikation: Tekst, omfangsresultat: Pbl53AOmfangsresultat, fakta: Pbl53AAfkastårFakta, hændelser: List(Pbl53AHændelse)) -> Pbl53AAfkastperiodeSag(ordning, skatteyder_identifikation, omfangsresultat, fakta, hændelser).resultat()

| pbl53a_berettiget_identifikation_unik(andele: List(Pbl53ABerettigetAndel), andel: Pbl53ABerettigetAndel) -> length(filter(andele, |anden: Pbl53ABerettigetAndel| anden.identifikation == andel.identifikation)) == 1
| pbl53a_berettigede_indestående_sum_kroner(andele: List(Pbl53ABerettigetAndel)) -> foldl(andele, 0, |sum: Heltal, andel: Pbl53ABerettigetAndel| sum + andel.indestående_ved_afkastperiodens_udgang_kroner)
| pbl53a_rettighedsperiodereference_grundfakta_gyldige(reference: Pbl53ARettighedsperiodereference) -> match reference {
    | Pbl53ARettighedsperiodeFraOprettelsen -> Sandt
    | Pbl53ARettighedsperiodeFraErhvervelse(erhvervelsesidentifikation) -> erhvervelsesidentifikation != ""
}
| pbl53a_afkastfordelingsfakta_gyldige(skatteyder_identifikation: Tekst, periode_resultat: Pbl53AAfkastperiodeResultat, fakta: Pbl53AAfkastfordelingsfakta) -> match fakta {
    | Pbl53AAfledtEnkeltRettighedshaver -> skatteyder_identifikation != "" && periode_resultat.rettighedsperiode_findes_entydigt
    | Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(rettighedsperiodereference, samlet_indestående_kroner, andele) -> skatteyder_identifikation != "" && pbl53a_rettighedsperiodereference_grundfakta_gyldige(rettighedsperiodereference) && periode_resultat.rettighedsperiode_findes_entydigt && samlet_indestående_kroner > 0 && length(andele) >= 2 && all(andele, |andel: Pbl53ABerettigetAndel| andel.identifikation != "" && andel.indestående_ved_afkastperiodens_udgang_kroner > 0 && pbl53a_berettiget_identifikation_unik(andele, andel)) && pbl53a_berettigede_indestående_sum_kroner(andele) == samlet_indestående_kroner && length(filter(andele, |andel: Pbl53ABerettigetAndel| andel.identifikation == skatteyder_identifikation)) == 1
}
| pbl53a_berettiget_andel_tæller(skatteyder_identifikation: Tekst, fakta: Pbl53AAfkastfordelingsfakta) -> match fakta {
    | Pbl53AAfledtEnkeltRettighedshaver -> 1
    | Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(_, _, andele) -> foldl(andele, 0, |sum: Heltal, andel: Pbl53ABerettigetAndel| sum + hvis andel.identifikation == skatteyder_identifikation { andel.indestående_ved_afkastperiodens_udgang_kroner } ellers { 0 })
}
| pbl53a_berettiget_andel_nævner(fakta: Pbl53AAfkastfordelingsfakta) -> match fakta {
    | Pbl53AAfledtEnkeltRettighedshaver -> 1
    | Pbl53AFlereBerettigedeVedAfkastperiodensUdgang(_, samlet_indestående_kroner, _) -> samlet_indestående_kroner
}

# Pbl53AMetodetilstand = Pbl53AIngenMetodeValgt | Pbl53APalMetodeValgt | Pbl53AAlternativKapitalværdiMetodeValgt
# Pbl53ANegativtAfkastSaldo(opstået_indkomstår: Heltal, resterende_kroner: Heltal)
# Pbl53AAfkastforløbsåbning = Pbl53AIngenTidligereAfkasthistorik | Pbl53ADokumenteretTidligereAfkasthistorik(seneste_indkomstår: Heltal, metodetilstand: Pbl53AMetodetilstand, fremførte_negative_afkast: List(Pbl53ANegativtAfkastSaldo))
# Pbl53ANegativtAfkastRækkefølgetilstand(seneste_opstået_indkomstår: Heltal, kronologiske: Boolsk)
# Pbl53ANegativtAfkastAnvendelsestilstand(resterende_anvendelse_kroner: Heltal, anvendt_kroner: Heltal, saldi_efter_anvendelse: List(Pbl53ANegativtAfkastSaldo))
# Pbl53ANegativtAfkastAnvendelsesresultat(anvendelige_saldi_primo: List(Pbl53ANegativtAfkastSaldo), udløbne_saldi: List(Pbl53ANegativtAfkastSaldo), anvendt_kroner: Heltal, saldi_efter_anvendelse: List(Pbl53ANegativtAfkastSaldo))
# Pbl53AAfkastårsresultat(fakta: Pbl53AAfkastårFakta, periode_resultat: Pbl53AAfkastperiodeResultat, afkastregelregime: Pbl53AAfkastregelregime, regelregime_understøttet: Boolsk, metodehistorik: Pensionsbeskatningslov53AMetodehistorik, afkastfordelingsfakta_gyldige: Boolsk, år_kronologisk: Boolsk, år_sammenhængende: Boolsk, afkastmetode_tilladt_efter_udbyderopgørelse: Boolsk, metodevalg_bindende_opfyldt: Boolsk, fremførte_negative_afkast_primo: List(Pbl53ANegativtAfkastSaldo), udløbne_negative_afkast_i_året: List(Pbl53ANegativtAfkastSaldo), fremførte_negative_afkast_ultimo: List(Pbl53ANegativtAfkastSaldo), input_gyldigt: Boolsk, pensionsbeskatningslov_input: Pensionsbeskatningslov53AInput, pensionsbeskatningslov_resultat: Pensionsbeskatningslov53AResultat)
# Pbl53AAfkastforløbsinput(ordningsidentifikation: Tekst, skatteyder_identifikation: Tekst, ordning: Pensionsbeskatningslov53AOrdning, omfangsresultat: Pbl53AOmfangsresultat, åbning: Pbl53AAfkastforløbsåbning, afkastår: List(Pbl53AAfkastårFakta), hændelsesforløbsresultat: Pbl53AForløbsresultat)
# Pbl53AAfkastforløbstilstand(ordningsidentifikation: Tekst, seneste_indkomstår: Heltal, metodetilstand: Pbl53AMetodetilstand, fremførte_negative_afkast: List(Pbl53ANegativtAfkastSaldo), fremført_negativt_afkast_kroner: Heltal, årsresultater: List(Pbl53AAfkastårsresultat), år_kronologiske: Boolsk, år_sammenhængende: Boolsk, alle_år_gyldige: Boolsk)
# Pbl53AAfkastforløbsresultat(input: Pbl53AAfkastforløbsinput, ordningsidentifikation_stabil: Boolsk, afkastår_entydige: Boolsk, åbningshistorik_gyldig: Boolsk, år_kronologiske: Boolsk, år_sammenhængende: Boolsk, alle_år_gyldige: Boolsk, input_gyldigt: Boolsk, årsresultater: List(Pbl53AAfkastårsresultat), metodetilstand_ultimo: Pbl53AMetodetilstand, fremførte_negative_afkast_ultimo: List(Pbl53ANegativtAfkastSaldo), fremført_negativt_afkast_ultimo_kroner: Heltal)

| pbl53a_afkastmetode(grundlag: Pbl53AAfkastgrundlag) -> match grundlag {
    | Pbl53AAfkastEfterPal(_) -> Pbl53AAfkastEfterPalPar3Til5
    | Pbl53AAlternativtKapitalværdiAfkast(_, _) -> Pbl53AAlternativKapitalværdi
}
| pbl53a_pal_afkast_kroner(grundlag: Pbl53AAfkastgrundlag) -> match grundlag {
    | Pbl53AAfkastEfterPal(afkast_kroner) -> afkast_kroner
    | _ -> 0
}
| pbl53a_afkastperiode_har_skattepligt(periode: Pbl53AAfkastperiode) -> match periode {
    | Pbl53ASammenhængendeAfkastperiode(_, _) -> Sandt
    | Pbl53AIngenAfkastperiode -> Falskt
}
| pbl53a_pal_afkast_i_skatteperioden_kroner(grundlag: Pbl53AAfkastgrundlag, periode: Pbl53AAfkastperiode) -> hvis pbl53a_afkastperiode_har_skattepligt(periode) { pbl53a_pal_afkast_kroner(grundlag) } ellers { 0 }
| pbl53a_metodehistorik_fra_tilstand(tilstand: Pbl53AMetodetilstand) -> match tilstand {
    | Pbl53AIngenMetodeValgt -> Pbl53AFørsteAfkastopgørelse
    | Pbl53APalMetodeValgt -> Pbl53ATidligerePalOpgørelse
    | Pbl53AAlternativKapitalværdiMetodeValgt -> Pbl53ATidligereAlternativKapitalværdiOpgørelse
}
| pbl53a_metodetilstand_for_metode(metode: Pensionsbeskatningslov53AAfkastmetode) -> match metode {
    | Pbl53AAfkastEfterPalPar3Til5 -> Pbl53APalMetodeValgt
    | Pbl53AAlternativKapitalværdi -> Pbl53AAlternativKapitalværdiMetodeValgt
}
| pbl53a_negativt_afkast_saldo_anvendelig_i_år(saldo: Pbl53ANegativtAfkastSaldo, indkomstår: Heltal) -> saldo.opstået_indkomstår >= 2002 || indkomstår <= saldo.opstået_indkomstår + 5
| pbl53a_anvendelige_negative_afkast_saldi(saldi: List(Pbl53ANegativtAfkastSaldo), indkomstår: Heltal) -> filter(saldi, |saldo: Pbl53ANegativtAfkastSaldo| pbl53a_negativt_afkast_saldo_anvendelig_i_år(saldo, indkomstår))
| pbl53a_udløbne_negative_afkast_saldi(saldi: List(Pbl53ANegativtAfkastSaldo), indkomstår: Heltal) -> filter(saldi, |saldo: Pbl53ANegativtAfkastSaldo| pbl53a_negativt_afkast_saldo_anvendelig_i_år(saldo, indkomstår) == Falskt)
| pbl53a_negative_afkast_saldi_sum_kroner(saldi: List(Pbl53ANegativtAfkastSaldo)) -> foldl(saldi, 0, |sum: Heltal, saldo: Pbl53ANegativtAfkastSaldo| sum + saldo.resterende_kroner)
| pbl53a_negativt_afkast_rækkefølgetrin(tilstand: Pbl53ANegativtAfkastRækkefølgetilstand, saldo: Pbl53ANegativtAfkastSaldo) -> Pbl53ANegativtAfkastRækkefølgetilstand(
    seneste_opstået_indkomstår = saldo.opstået_indkomstår,
    kronologiske = tilstand.kronologiske && saldo.opstået_indkomstår > tilstand.seneste_opstået_indkomstår
)
| pbl53a_negative_afkast_saldi_kronologiske(saldi: List(Pbl53ANegativtAfkastSaldo)) -> foldl(
    saldi,
    Pbl53ANegativtAfkastRækkefølgetilstand(seneste_opstået_indkomstår = 0, kronologiske = Sandt),
    pbl53a_negativt_afkast_rækkefølgetrin
).kronologiske
| pbl53a_negativt_afkast_anvendelsestrin(tilstand: Pbl53ANegativtAfkastAnvendelsestilstand, saldo: Pbl53ANegativtAfkastSaldo) -> {
    = anvendt_på_saldo_kroner = penge_mindste_beløb(tilstand.resterende_anvendelse_kroner, saldo.resterende_kroner)
    = resterende_saldo_kroner = saldo.resterende_kroner - anvendt_på_saldo_kroner
    Pbl53ANegativtAfkastAnvendelsestilstand(
        resterende_anvendelse_kroner = tilstand.resterende_anvendelse_kroner - anvendt_på_saldo_kroner,
        anvendt_kroner = tilstand.anvendt_kroner + anvendt_på_saldo_kroner,
        saldi_efter_anvendelse = concat(
            tilstand.saldi_efter_anvendelse,
            hvis resterende_saldo_kroner > 0 { [Pbl53ANegativtAfkastSaldo(opstået_indkomstår = saldo.opstået_indkomstår, resterende_kroner = resterende_saldo_kroner)] } ellers { [] }
        )
    )
}
| pbl53a_anvend_negativt_afkast(saldi: List(Pbl53ANegativtAfkastSaldo), indkomstår: Heltal, anvendelse_kroner: Heltal) -> {
    = anvendelige_saldi = pbl53a_anvendelige_negative_afkast_saldi(saldi, indkomstår)
    = tilstand = foldl(
        anvendelige_saldi,
        Pbl53ANegativtAfkastAnvendelsestilstand(
            resterende_anvendelse_kroner = penge_positivt_beløb(anvendelse_kroner),
            anvendt_kroner = 0,
            saldi_efter_anvendelse = []
        ),
        pbl53a_negativt_afkast_anvendelsestrin
    )
    Pbl53ANegativtAfkastAnvendelsesresultat(
        anvendelige_saldi_primo = anvendelige_saldi,
        udløbne_saldi = pbl53a_udløbne_negative_afkast_saldi(saldi, indkomstår),
        anvendt_kroner = tilstand.anvendt_kroner,
        saldi_efter_anvendelse = tilstand.saldi_efter_anvendelse
    )
}
| pbl53a_første_afkastår(input: Pbl53AAfkastforløbsinput) -> hvis length(input.afkastår) > 0 { input.afkastår[0].indkomstår } ellers { 0 }
| pbl53a_metodetilstand_gyldig_ved_åbning(overgang: Pbl53AOvergangsresultat, seneste_indkomstår: Heltal, metodetilstand: Pbl53AMetodetilstand) -> hvis seneste_indkomstår <= 2009 {
    metodetilstand == Pbl53AIngenMetodeValgt
} ellers {
    pbl53a_afkastregelregime(seneste_indkomstår, overgang) == Pbl53AModerneMetodevalgFra2010
}
| pbl53a_åbningssaldi_gyldige(input: Pbl53AAfkastforløbsinput, seneste_indkomstår: Heltal, saldi: List(Pbl53ANegativtAfkastSaldo)) -> pbl53a_negative_afkast_saldi_kronologiske(saldi) && all(saldi, |saldo: Pbl53ANegativtAfkastSaldo| saldo.opstået_indkomstår >= input.omfangsresultat.fakta.oprettelsesdato.år && saldo.opstået_indkomstår <= seneste_indkomstår && saldo.resterende_kroner > 0 && pbl53a_negativt_afkast_saldo_anvendelig_i_år(saldo, pbl53a_første_afkastår(input)))
| pbl53a_afkastforløbsåbning_gyldig(input: Pbl53AAfkastforløbsinput) -> match input.åbning {
    | Pbl53AIngenTidligereAfkasthistorik -> Sandt
    | Pbl53ADokumenteretTidligereAfkasthistorik(seneste_indkomstår, metodetilstand, saldi) -> seneste_indkomstår > 0 && pbl53a_første_afkastår(input) == seneste_indkomstår + 1 && input.omfangsresultat.fakta.oprettelsesdato.år <= seneste_indkomstår && pbl53a_metodetilstand_gyldig_ved_åbning(input.omfangsresultat.overgangsresultat, seneste_indkomstår, metodetilstand) && pbl53a_åbningssaldi_gyldige(input, seneste_indkomstår, saldi)
}
| pbl53a_afkastforløbstilstand_fra_åbning(input: Pbl53AAfkastforløbsinput) -> match input.åbning {
    | Pbl53AIngenTidligereAfkasthistorik -> Pbl53AAfkastforløbstilstand(
        ordningsidentifikation = input.ordningsidentifikation,
        seneste_indkomstår = 0,
        metodetilstand = Pbl53AIngenMetodeValgt,
        fremførte_negative_afkast = [],
        fremført_negativt_afkast_kroner = 0,
        årsresultater = [],
        år_kronologiske = Sandt,
        år_sammenhængende = Sandt,
        alle_år_gyldige = Sandt
    )
    | Pbl53ADokumenteretTidligereAfkasthistorik(seneste_indkomstår, metodetilstand, saldi) -> Pbl53AAfkastforløbstilstand(
        ordningsidentifikation = input.ordningsidentifikation,
        seneste_indkomstår = seneste_indkomstår,
        metodetilstand = metodetilstand,
        fremførte_negative_afkast = saldi,
        fremført_negativt_afkast_kroner = pbl53a_negative_afkast_saldi_sum_kroner(saldi),
        årsresultater = [],
        år_kronologiske = Sandt,
        år_sammenhængende = Sandt,
        alle_år_gyldige = Sandt
    )
}
| pbl53a_afkastår_indkomstår_unikt(afkastår: List(Pbl53AAfkastårFakta), fakta: Pbl53AAfkastårFakta) -> length(filter(afkastår, |andet: Pbl53AAfkastårFakta| andet.indkomstår == fakta.indkomstår)) == 1
| pbl53a_afkastår_entydige(afkastår: List(Pbl53AAfkastårFakta)) -> all(afkastår, |fakta: Pbl53AAfkastårFakta| fakta.indkomstår > 0 && pbl53a_afkastår_indkomstår_unikt(afkastår, fakta))
| pbl53a_afkastskatteudbetaling_for_sen_personlig_indkomst_kroner(resultat: Pbl53AHændelsesresultat, indkomstår: Heltal) -> match resultat {
    | Pbl53AUdbetalingBeregnet(udbetaling) -> hvis pbl53a_er_afkastskatteudbetaling(udbetaling.fakta.art) && udbetaling.fakta.tidspunkt.dato.år == indkomstår && udbetaling.afkastskatteudbetaling_rettidig == Falskt { udbetaling.personlig_indkomst_kroner } ellers { 0 }
    | _ -> 0
}
| pbl53a_afkastskatteudbetaling_for_sen_i_år_kroner(hændelsesresultater: List(Pbl53AHændelsesresultat), indkomstår: Heltal) -> foldl(hændelsesresultater, 0, |sum: Heltal, resultat: Pbl53AHændelsesresultat| sum + pbl53a_afkastskatteudbetaling_for_sen_personlig_indkomst_kroner(resultat, indkomstår))

# Pbl53AAfkastårstrinSag(input: Pbl53AAfkastforløbsinput, tilstand: Pbl53AAfkastforløbstilstand, fakta: Pbl53AAfkastårFakta) {
    | periode_resultat() -> pbl53a_afkastperiode_resultat(input.ordning, input.skatteyder_identifikation, input.omfangsresultat, fakta, input.hændelsesforløbsresultat.input.hændelser)
    | skatteperiode_findes() -> pbl53a_afkastperiode_har_skattepligt(periode_resultat().afkastperiode)
    | afkastregelregime() -> pbl53a_afkastregelregime(fakta.indkomstår, input.omfangsresultat.overgangsresultat)
    | regelregime_understøttet() -> pbl53a_afkastregelregime_understøttet(afkastregelregime())
    | afkastmetode() -> pbl53a_afkastmetode(fakta.afkastgrundlag)
    | afkastmetode_for_beregning() -> match afkastregelregime() {
        | Pbl53AHistoriskKapitalværdiTilOgMed2009 -> Pbl53AAlternativKapitalværdi
        | Pbl53AModerneMetodevalgFra2010 -> hvis skatteperiode_findes() { afkastmetode() } ellers { match tilstand.metodetilstand {
            | Pbl53AIngenMetodeValgt -> afkastmetode()
            | Pbl53APalMetodeValgt -> Pbl53AAfkastEfterPalPar3Til5
            | Pbl53AAlternativKapitalværdiMetodeValgt -> Pbl53AAlternativKapitalværdi
        } }
        | Pbl53AHistorikIkkeUnderstøttet -> afkastmetode()
    }
    | pensionsudbyder_opgjorde_pal_for_beregning() -> hvis afkastregelregime() == Pbl53AHistoriskKapitalværdiTilOgMed2009 || skatteperiode_findes() == Falskt && tilstand.metodetilstand == Pbl53AAlternativKapitalværdiMetodeValgt { Falskt } ellers { fakta.pensionsudbyder_opgjorde_afkast_efter_pal }
    | metodehistorik() -> hvis afkastregelregime() == Pbl53AHistoriskKapitalværdiTilOgMed2009 { Pbl53AFørsteAfkastopgørelse } ellers { pbl53a_metodehistorik_fra_tilstand(tilstand.metodetilstand) }
    | år_kronologisk() -> fakta.indkomstår > tilstand.seneste_indkomstår
    | år_sammenhængende() -> tilstand.seneste_indkomstår == 0 || fakta.indkomstår == tilstand.seneste_indkomstår + 1
    | afkastfordelingsfakta_gyldige() -> pbl53a_afkastfordelingsfakta_gyldige(input.skatteyder_identifikation, periode_resultat(), fakta.afkastfordeling)
    | afkastmetode_tilladt_efter_udbyderopgørelse() -> hvis skatteperiode_findes() { pbl53a_afkastmetode_tilladt_i_regime(afkastregelregime(), afkastmetode(), fakta.pensionsudbyder_opgjorde_afkast_efter_pal) } ellers { regelregime_understøttet() && (afkastregelregime() != Pbl53AHistoriskKapitalværdiTilOgMed2009 || afkastmetode() == Pbl53AAlternativKapitalværdi) }
    | metodevalg_bindende_opfyldt() -> skatteperiode_findes() == Falskt && regelregime_understøttet() || pbl53a_metodevalg_bindende_i_regime(afkastregelregime(), afkastmetode(), metodehistorik())
    | fremførte_negative_afkast_primo() -> pbl53a_anvendelige_negative_afkast_saldi(tilstand.fremførte_negative_afkast, fakta.indkomstår)
    | udløbne_negative_afkast_i_året() -> pbl53a_udløbne_negative_afkast_saldi(tilstand.fremførte_negative_afkast, fakta.indkomstår)
    | pensionsbeskatningslov_input() -> Pensionsbeskatningslov53AInput(
        indkomstår = fakta.indkomstår,
        ordning = input.ordning,
        omfangsresultat = input.omfangsresultat,
        afkastmetode = afkastmetode_for_beregning(),
        metodehistorik = metodehistorik(),
        pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget = pensionsudbyder_opgjorde_pal_for_beregning(),
        afkast_efter_pal_par3_til_5_kroner = pbl53a_pal_afkast_i_skatteperioden_kroner(fakta.afkastgrundlag, periode_resultat().afkastperiode),
        kapitalværdi_primo_kroner = periode_resultat().kapitalværdi_primo_kroner,
        kapitalværdi_ultimo_kroner = periode_resultat().kapitalværdi_ultimo_kroner,
        udbetalinger_i_året_kroner = periode_resultat().udbetalinger_i_perioden_kroner,
        indbetalinger_i_året_kroner = periode_resultat().indbetalinger_i_perioden_kroner,
        fremført_negativt_afkast_primo_kroner = pbl53a_negative_afkast_saldi_sum_kroner(fremførte_negative_afkast_primo()),
        andel_tæller = pbl53a_berettiget_andel_tæller(input.skatteyder_identifikation, fakta.afkastfordeling),
        andel_nævner = pbl53a_berettiget_andel_nævner(fakta.afkastfordeling),
        udbetaling_til_afkastskat_kroner = pbl53a_afkastskatteudbetaling_for_sen_i_år_kroner(input.hændelsesforløbsresultat.hændelsesresultater, fakta.indkomstår)
    )
    | pensionsbeskatningslov_resultat() -> pensionsbeskatningslov53a_resultat(pensionsbeskatningslov_input())
    | negativt_afkast_anvendelsesresultat() -> pbl53a_anvend_negativt_afkast(tilstand.fremførte_negative_afkast, fakta.indkomstår, pensionsbeskatningslov_resultat().fremført_negativt_afkast_anvendt_kroner)
    | nyt_negativt_afkast_kroner() -> penge_positivt_beløb(pensionsbeskatningslov_resultat().fremført_negativt_afkast_ultimo_kroner - pbl53a_negative_afkast_saldi_sum_kroner(negativt_afkast_anvendelsesresultat().saldi_efter_anvendelse))
    | fremførte_negative_afkast_ultimo() -> concat(
        negativt_afkast_anvendelsesresultat().saldi_efter_anvendelse,
        hvis nyt_negativt_afkast_kroner() > 0 { [Pbl53ANegativtAfkastSaldo(opstået_indkomstår = fakta.indkomstår, resterende_kroner = nyt_negativt_afkast_kroner())] } ellers { [] }
    )
    | input_gyldigt() -> input.ordningsidentifikation != "" && input.skatteyder_identifikation != "" && input.omfangsresultat.omfattes_af_par53a && pbl53a_omfang_klassifikation_matcher_ordning(input.omfangsresultat, input.ordning) && input.hændelsesforløbsresultat.input_gyldigt && fakta.indkomstår >= input.omfangsresultat.fakta.oprettelsesdato.år && regelregime_understøttet() && år_kronologisk() && år_sammenhængende() && periode_resultat().periode_understøttet && afkastfordelingsfakta_gyldige() && afkastmetode_tilladt_efter_udbyderopgørelse() && metodevalg_bindende_opfyldt()
    | årsresultat() -> Pbl53AAfkastårsresultat(
        fakta = fakta,
        periode_resultat = periode_resultat(),
        afkastregelregime = afkastregelregime(),
        regelregime_understøttet = regelregime_understøttet(),
        metodehistorik = metodehistorik(),
        afkastfordelingsfakta_gyldige = afkastfordelingsfakta_gyldige(),
        år_kronologisk = år_kronologisk(),
        år_sammenhængende = år_sammenhængende(),
        afkastmetode_tilladt_efter_udbyderopgørelse = afkastmetode_tilladt_efter_udbyderopgørelse(),
        metodevalg_bindende_opfyldt = metodevalg_bindende_opfyldt(),
        fremførte_negative_afkast_primo = fremførte_negative_afkast_primo(),
        udløbne_negative_afkast_i_året = udløbne_negative_afkast_i_året(),
        fremførte_negative_afkast_ultimo = hvis input_gyldigt() { fremførte_negative_afkast_ultimo() } ellers { tilstand.fremførte_negative_afkast },
        input_gyldigt = input_gyldigt(),
        pensionsbeskatningslov_input = pensionsbeskatningslov_input(),
        pensionsbeskatningslov_resultat = pensionsbeskatningslov_resultat()
    )
    | resultat() -> Pbl53AAfkastforløbstilstand(
        ordningsidentifikation = tilstand.ordningsidentifikation,
        seneste_indkomstår = hvis år_kronologisk() { fakta.indkomstår } ellers { tilstand.seneste_indkomstår },
        metodetilstand = hvis input_gyldigt() && skatteperiode_findes() && afkastregelregime() == Pbl53AModerneMetodevalgFra2010 { pbl53a_metodetilstand_for_metode(afkastmetode()) } ellers { tilstand.metodetilstand },
        fremførte_negative_afkast = hvis input_gyldigt() { fremførte_negative_afkast_ultimo() } ellers { tilstand.fremførte_negative_afkast },
        fremført_negativt_afkast_kroner = hvis input_gyldigt() { pbl53a_negative_afkast_saldi_sum_kroner(fremførte_negative_afkast_ultimo()) } ellers { tilstand.fremført_negativt_afkast_kroner },
        årsresultater = concat(tilstand.årsresultater, [årsresultat()]),
        år_kronologiske = tilstand.år_kronologiske && år_kronologisk(),
        år_sammenhængende = tilstand.år_sammenhængende && år_sammenhængende(),
        alle_år_gyldige = tilstand.alle_år_gyldige && input_gyldigt()
    )
}
| pbl53a_afkastårstrin(input: Pbl53AAfkastforløbsinput, tilstand: Pbl53AAfkastforløbstilstand, fakta: Pbl53AAfkastårFakta) -> Pbl53AAfkastårstrinSag(input, tilstand, fakta).resultat()

# Pbl53AAfkastforløbssag(input: Pbl53AAfkastforløbsinput) {
    | tilstand() -> foldl(input.afkastår, pbl53a_afkastforløbstilstand_fra_åbning(input), |forløb: Pbl53AAfkastforløbstilstand, fakta: Pbl53AAfkastårFakta| pbl53a_afkastårstrin(input, forløb, fakta))
    | ordningsidentifikation_stabil() -> input.ordningsidentifikation != "" && tilstand().ordningsidentifikation == input.ordningsidentifikation
    | afkastår_entydige() -> length(input.afkastår) > 0 && pbl53a_afkastår_entydige(input.afkastår)
    | åbningshistorik_gyldig() -> pbl53a_afkastforløbsåbning_gyldig(input)
    | input_gyldigt() -> ordningsidentifikation_stabil() && afkastår_entydige() && åbningshistorik_gyldig() && tilstand().år_kronologiske && tilstand().år_sammenhængende && tilstand().alle_år_gyldige
    | resultat() -> Pbl53AAfkastforløbsresultat(
        input = input,
        ordningsidentifikation_stabil = ordningsidentifikation_stabil(),
        afkastår_entydige = afkastår_entydige(),
        åbningshistorik_gyldig = åbningshistorik_gyldig(),
        år_kronologiske = tilstand().år_kronologiske,
        år_sammenhængende = tilstand().år_sammenhængende,
        alle_år_gyldige = tilstand().alle_år_gyldige,
        input_gyldigt = input_gyldigt(),
        årsresultater = tilstand().årsresultater,
        metodetilstand_ultimo = tilstand().metodetilstand,
        fremførte_negative_afkast_ultimo = tilstand().fremførte_negative_afkast,
        fremført_negativt_afkast_ultimo_kroner = tilstand().fremført_negativt_afkast_kroner
    )
}
| pbl53a_afkastforløbsresultat(input: Pbl53AAfkastforløbsinput) -> Pbl53AAfkastforløbssag(input).resultat()
| pbl53a_afkastårsresultat_for_indkomstår(resultat: Pbl53AAfkastforløbsresultat, indkomstår: Heltal) -> filter(resultat.årsresultater, |årsresultat: Pbl53AAfkastårsresultat| årsresultat.fakta.indkomstår == indkomstår)[0]
| pbl53a_afkastårsresultat_findes_entydigt(resultat: Pbl53AAfkastforløbsresultat, indkomstår: Heltal) -> length(filter(resultat.årsresultater, |årsresultat: Pbl53AAfkastårsresultat| årsresultat.fakta.indkomstår == indkomstår)) == 1
--@end::pensionsbeskatningsloven_par53a_afkastovergang--

= pbl53a_privat_finansiering_fixture = Pbl53AInstitutionsfinansiering(
    samlet_drift_løn_og_pension_kroner = 1000000,
    statsligt_finansieret_drift_løn_og_pension_kroner = 0
)
= pbl53a_dansk_oprettelsesposition_fixture = Pbl53BOprettetUnderDanskSkattepligtOgHjemsted
= pbl53a_almindelige_livsvilkår_fixture = Pbl53ALivsforsikringsvilkår(
    dækninger = [Pbl53AAndenLivsforsikringsdækning],
    aftalt_udløbsdato = Pbl15ADato(år = 2050, måned = 1, dag = 1),
    første_policedag_efter_fyldte_80_år = Pbl15ADato(år = 2060, måned = 1, dag = 1)
)
= pbl53a_pensionskassekarakteristika_fixture = Pbl53APensionskassekarakteristika(
    selvstændig_juridisk_person = Sandt,
    uafhængig_af_arbejdsgiver = Sandt,
    midler_afsondret_fra_berettigedes_formue = Sandt,
    vedtægter_fastlægger_pensionsydelser = Sandt
)
= pbl53a_pengeinstitutkarakteristika_fixture = Pbl53APengeinstitutkarakteristika(
    standardiseret_lovreguleret_pensionsprodukt = Sandt,
    pensionsmidler_adskilt_fra_øvrig_formue = Sandt,
    kan_disponeres_som_almindelig_bankkonto = Falskt
)
| pbl53a_omfang_fixture(produkt: Pbl53AProduktfakta) -> pbl53a_omfangsresultat(2026, Pbl53AOmfangsfakta(
    oprettelsesdato = Pbl15ADato(år = 2020, måned = 1, dag = 1),
    oprindelig_rettighedshaver_identifikation = "person-1",
    kapitalværdi_ved_oprettelsen_kroner = 0,
    repræsenteret_kontraktdel = Pbl53AHeleKontrakten,
    kontraktændringer = [],
    erhvervelser = [],
    overgangsvalgfristfakta = Pbl53AIntetOvergangsvalgfristgrundlag,
    overgangsvalg = [],
    historiske_blanket49020_indsendelser = [],
    produkt = produkt,
    afsnit_i_valg = Pbl53AIntetAfkaldPåAfsnitI,
    institutionsfinansiering = pbl53a_privat_finansiering_fixture,
    par53b_oprettelsesposition = pbl53a_dansk_oprettelsesposition_fixture
    ), [])
= pbl53a_liv_uden_kapitel1_omfang_fixture = pbl53a_omfang_fixture(Pbl53ALivsforsikringsprodukt(
    ejer_identifikation = "person-1",
    forsikret_identifikation = "person-1",
    kapitel1fakta = Pbl53AIkkeOmfattetAfKapitel1,
    vilkår = pbl53a_almindelige_livsvilkår_fixture,
    direktørsikkerhed = Pbl53AIngenDirektørsikkerhed
))
= pbl53a_pengeinstitut_uden_kapitel1_omfang_fixture = pbl53a_omfang_fixture(Pbl53APengeEllerKreditinstitutprodukt(
    kontohaver_identifikation = "person-1",
    kapitel1fakta = Pbl53AIkkeOmfattetAfKapitel1,
    institutionssted = Pbl53ADanskInstitution,
    karakteristika = pbl53a_pengeinstitutkarakteristika_fixture
))
= pbl53a_pensionskasse_uden_kapitel1_omfang_fixture = pbl53a_omfang_fixture(Pbl53APensionskasseprodukt(
    pensionsberettiget_identifikation = "person-1",
    kapitel1fakta = Pbl53AIkkeOmfattetAfKapitel1,
    karakteristika = pbl53a_pensionskassekarakteristika_fixture,
    direktørsikkerhed = Pbl53AIngenDirektørsikkerhed
))
= pbl53a_direktørpensionstilsagn_fixture = Pbl53ADirektørpensionstilsagnsfakta(
    identifikation = "direktørtilsagn-1",
    ansættelsesforhold_identifikation = "ansættelse-1",
    berettigede = [Pbl53ADirektørenSomBerettiget(identifikation = "person-1")]
)
= pbl53a_direktørsikkerhed_omfang_fixture = pbl53a_omfang_fixture(Pbl53ALivsforsikringsprodukt(
    ejer_identifikation = "arbejdsgiver-1",
    forsikret_identifikation = "person-1",
    kapitel1fakta = Pbl53AIkkeOmfattetAfKapitel1,
    vilkår = pbl53a_almindelige_livsvilkår_fixture,
    direktørsikkerhed = Pbl53ASikkerhedForDirektørpensionstilsagn(tilsagn = pbl53a_direktørpensionstilsagn_fixture)
))
= pbl53a_syge_ulykke_omfang_fixture = pbl53a_omfang_fixture(Pbl53ASygeOgUlykkesforsikringsprodukt(
    ejer_identifikation = "person-1",
    forsikret_identifikation = "person-1"
))
= pbl53a_par53b_indbetaling_fixture = Pbl53AIndbetaling(fakta = Pbl53AIndbetalingsfakta(
    identifikation = "udenlandsk-bidrag-1",
    tidspunkt = Pbl53ATidspunkt(dato = Pbl15ADato(år = 2018, måned = 1, dag = 1), rækkefølge_på_dagen = 1),
    beløb_kroner = 50000,
    periode = Pbl53AHistoriskIndbetalingFørOrdningenBlevOmfattet,
    indbetaler = Pbl53AEjeren,
    ejerens_fradragsstatus = Pbl53AFradragEllerBortseelsesretIUdlandet,
    par53b_udenlandsk_skattebehandling = Pbl53BEjerbidragFuldtFradragetIPositivIndkomst(positiv_skattepligtig_indkomst_kroner = 500000, faktisk_fradrag_kroner = 50000)
))
= pbl53a_par53b_omfang_fixture = pbl53a_omfangsresultat(2026, Pbl53AOmfangsfakta(
    oprettelsesdato = Pbl15ADato(år = 2017, måned = 1, dag = 1),
    oprindelig_rettighedshaver_identifikation = "person-1",
    kapitalværdi_ved_oprettelsen_kroner = 0,
    repræsenteret_kontraktdel = Pbl53AHeleKontrakten,
    kontraktændringer = [],
    erhvervelser = [],
    overgangsvalgfristfakta = Pbl53AIntetOvergangsvalgfristgrundlag,
    overgangsvalg = [],
    historiske_blanket49020_indsendelser = [],
    produkt = Pbl53ALivsforsikringsprodukt(
        ejer_identifikation = "person-1",
        forsikret_identifikation = "person-1",
        kapitel1fakta = Pbl53ATidligereGodkendtEfterPar15D(
            godkendt_fra = Pbl15ADato(år = 2017, måned = 1, dag = 1),
            godkendt_til = Pbl15ADato(år = 2022, måned = 12, dag = 31)
        ),
        vilkår = pbl53a_almindelige_livsvilkår_fixture,
        direktørsikkerhed = Pbl53AIngenDirektørsikkerhed
    ),
    afsnit_i_valg = Pbl53AIntetAfkaldPåAfsnitI,
    institutionsfinansiering = pbl53a_privat_finansiering_fixture,
    par53b_oprettelsesposition = Pbl53BOprettetUdenFuldDanskSkattepligt(
        hjemsted = Pbl53BFremmedStat(stat = "Sverige"),
        sidste_dato_uden_dansk_skattepligt = Pbl15ADato(år = 2019, måned = 12, dag = 31)
    )
    ), [pbl53a_par53b_indbetaling_fixture])

= pbl53a_pal_afkast_fixture = pensionsbeskatningslov53a_resultat(Pensionsbeskatningslov53AInput(
    indkomstår = 2026,
    ordning = Pbl53ALivsforsikringUdenKapitel1,
    omfangsresultat = pbl53a_liv_uden_kapitel1_omfang_fixture,
    afkastmetode = Pbl53AAfkastEfterPalPar3Til5,
    metodehistorik = Pbl53AFørsteAfkastopgørelse,
    pensionsudbyder_opgjorde_afkast_efter_pal_ved_metodevalget = Sandt,
    afkast_efter_pal_par3_til_5_kroner = 28000,
    kapitalværdi_primo_kroner = 0,
    kapitalværdi_ultimo_kroner = 0,
    udbetalinger_i_året_kroner = 0,
    indbetalinger_i_året_kroner = 0,
