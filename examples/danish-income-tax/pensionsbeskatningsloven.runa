# Pbl18Fradragsramme(personlig_indkomst_før_pensionsfradrag_kroner: Heltal, forfaldne_ikke_tidligere_fratrukket_kroner: Heltal, særligt_ordningsmaksimum_kroner: Heltal, selvstændig_overskud: Pbl18SelvstændigOverskudInput, valg: Pbl18Fradragsvalg)
# Pbl18Begrænsninger(pbl54_personkreds_opfyldt: Boolsk, afgiftspligt_for_hele_ordningen_indtrådt: Boolsk, udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens: Boolsk)
# Pbl18Input(indkomstår: Heltal, ordning: Pbl18Ordning, indbetalingskilde: Pbl18Indbetalingskilde, fradragsretshaver: Pbl18Fradragsretshaver, betaling: Pbl18Betaling, fordelingsforløb: Pbl18Fordelingsforløb, indeksvalg: Pbl18Indeksvalg, fradragsramme: Pbl18Fradragsramme, begrænsninger: Pbl18Begrænsninger)
# Pbl18Resultat(indkomstår: Heltal, fradragsår: Heltal, ordning: Pbl18Ordning, grundlæggende_fradragsret: Boolsk, indekskontrakter_medregnet: Heltal, indbetalt_beløb_kroner: Heltal, ordningsbeløb_efter_indeksbegrænsning_kroner: Heltal, par16_reguleret_bruttoloft_kroner: Heltal, reducerende_arbejdsgiverindbetalinger_kroner: Heltal, fradragsloft_efter_stk2_kroner: Heltal, beregnet_årsfradrag_kroner: Heltal, opfyldningsgrundbeløb_kroner: Heltal, selvstændig_30_pct_kroner: Heltal, valgt_årsfradrag_kroner: Heltal, fradrag_i_skattepligtig_indkomst_kroner: Heltal, ikke_fratrukket_i_indkomståret_kroner: Heltal)

| pbl18_ordning_omfattet_af_kapitel1(ordning: Pbl18Ordning) -> ordning != Pbl18UdenForKapitel1
| pbl18_ordning_udelukket_fra_fradrag(ordning: Pbl18Ordning) -> ordning == Pbl18Aldersopsparing || ordning == Pbl18Aldersforsikring || ordning == Pbl18SupplerendeEngangssum
| pbl18_ordning_har_indbetalingsprincip(ordning: Pbl18Ordning) -> ordning == Pbl18Rateopsparing || ordning == Pbl18OpsparingIPensionsøjemed || ordning == Pbl18Par15ALøbendeUdbetaling || ordning == Pbl18Par15ARateordning || ordning == Pbl18Par15BRateopsparing
| pbl18_ordning_er_par15a(ordning: Pbl18Ordning) -> ordning == Pbl18Par15ALøbendeUdbetaling || ordning == Pbl18Par15ARateordning
| pbl18_ordning_har_særligt_maksimum(ordning: Pbl18Ordning) -> ordning == Pbl18Par15Rateordning || ordning == Pbl18Par15ALøbendeUdbetaling || ordning == Pbl18Par15ARateordning || ordning == Pbl18Par15BRateforsikring || ordning == Pbl18Par15BRateopsparing
| pbl18_ordning_har_rate_loft(ordning: Pbl18Ordning) -> ordning == Pbl18Rateforsikring || ordning == Pbl18Rateopsparing || ordning == Pbl18OphørendeLivrente
| pbl18_ordning_har_kapital_loft(ordning: Pbl18Ordning) -> ordning == Pbl18Kapitalforsikring || ordning == Pbl18OpsparingIPensionsøjemed || ordning == Pbl18SupplerendeEngangsydelse
| pbl18_ordning_har_personlig_indkomst_loft(ordning: Pbl18Ordning) -> pbl18_ordning_har_kapital_loft(ordning)
| pbl18_fradragsretshaver_opfyldt(fradragsretshaver: Pbl18Fradragsretshaver) -> fradragsretshaver == Pbl18OrdningensEjer || fradragsretshaver == Pbl18SamlevendeLængstlevendeÆgtefælle

| pbl18_almindeligt_fradragsår(ordning: Pbl18Ordning, betaling: Pbl18Betaling) -> betaling.betalingsår
| exception pbl18_rettidig_forfaldsbetaling pbl18_almindeligt_fradragsår(ordning: Pbl18Ordning, betaling: Pbl18Betaling) -> betaling.forfaldsår under pbl18_ordning_har_indbetalingsprincip(ordning) == Falskt && betaling.hidrører_fra_par22e_tilbagebetaling == Falskt && betaling.betalt_senest_bankjusteret_1_april_efter_forfald
| pbl18_fradragsår(ordning: Pbl18Ordning, betaling: Pbl18Betaling) -> match betaling.par15a_fradragsplacering {
    | Pbl18IkkePar15APlacering -> pbl18_almindeligt_fradragsår(ordning, betaling)
    | Pbl18Par15AIndbetalingsår -> betaling.betalingsår
    | Pbl18Par15AAfståelsesår(valgt_fradragsår, rettidig) -> hvis pbl18_ordning_er_par15a(ordning) && rettidig { valgt_fradragsår } ellers { betaling.betalingsår }
}

| pbl18_indeksbidrag_første_seks_kroner(indeksvalg: Pbl18Indeksvalg) -> foldl(take(indeksvalg.fradragsvalgte_kontraktbidrag_kroner, 6), 0, |sum, bidrag| sum + penge_positivt_beløb(bidrag))
| pbl18_indbetalt_beløb_kroner(input: Pbl18Input) -> penge_positivt_beløb(input.betaling.beløb_kroner)
| pbl18_ordningsbeløb_kroner(input: Pbl18Input) -> pbl18_indbetalt_beløb_kroner(input)
| exception pbl18_højst_seks_indekskontrakter pbl18_ordningsbeløb_kroner(input: Pbl18Input) -> penge_mindste_beløb(penge_positivt_beløb(input.betaling.beløb_kroner), pbl18_indeksbidrag_første_seks_kroner(input.indeksvalg)) under input.ordning == Pbl18Indeksordning
| pbl18_tiårsperiode_omfatter_indkomstår(første_år: Heltal, indkomstår: Heltal) -> indkomstår >= første_år && indkomstår <= første_år + 9
| pbl18_fordelingsfradrag_kroner(input: Pbl18Input) -> match input.fordelingsforløb {
    | Pbl18IngenTiårsfordeling -> pbl18_ordningsbeløb_kroner(input)
    | Pbl18Kapitalindskud(indskudsår, indskud_kroner) -> hvis pbl18_tiårsperiode_omfatter_indkomstår(indskudsår, input.indkomstår) { penge_positivt_beløb(indskud_kroner) / 10 } ellers { 0 }
    | Pbl18KortIndbetalingsperiode(første_forfaldsår, samlet_beløb_kroner, efterfølgende_tilsvarende, samlet_periode_år) -> hvis efterfølgende_tilsvarende && samlet_periode_år >= 10 { pbl18_ordningsbeløb_kroner(input) } ellers { hvis pbl18_tiårsperiode_omfatter_indkomstår(første_forfaldsår, input.indkomstår) { penge_positivt_beløb(samlet_beløb_kroner) / 10 } ellers { 0 } }
    | Pbl18ForhøjelseKortRestperiode(første_forhøjelsesår, samlet_forhøjelse_kroner) -> hvis pbl18_tiårsperiode_omfatter_indkomstår(første_forhøjelsesår, input.indkomstår) { penge_positivt_beløb(samlet_forhøjelse_kroner) / 10 } ellers { 0 }
    | Pbl18PristalsreguleretForhøjelse -> pbl18_ordningsbeløb_kroner(input)
}
| pbl18_beregnet_årsfradrag_kroner(input: Pbl18Input) -> pbl18_ordningsbeløb_kroner(input)
| exception pbl18_livsvarig_livrente_fordeles pbl18_beregnet_årsfradrag_kroner(input: Pbl18Input) -> pbl18_fordelingsfradrag_kroner(input) under input.ordning == Pbl18LivsvarigLivrente

| pbl18_par16_art(ordning: Pbl18Ordning) -> Pbl16Kapitalordning
| exception pbl18_rateordning_bruger_par16_stk2 pbl18_par16_art(ordning: Pbl18Ordning) -> Pbl16Rateordning under pbl18_ordning_har_rate_loft(ordning)
| pbl18_par16_resultat(input: Pbl18Input) -> pbl16_fradragsloft_resultat(Pbl16FradragsloftInput(
    indkomstår = input.indkomstår,
    art = pbl18_par16_art(input.ordning)
))
| pbl18_reducerende_arbejdsgiverindbetalinger_kroner(input: Pbl18Input) -> 0
| exception pbl18_stk2_arbejdsgiverindbetalinger_reducerer pbl18_reducerende_arbejdsgiverindbetalinger_kroner(input: Pbl18Input) -> penge_positivt_beløb(penge_positivt_beløb(input.betaling.arbejdsgiverindbetalinger_kroner) - penge_positivt_beløb(input.betaling.arbejdsmarkedsbidrag_i_arbejdsgiverindbetalinger_kroner)) under pbl18_ordning_har_rate_loft(input.ordning) || pbl18_ordning_har_kapital_loft(input.ordning)
| pbl18_fradragsloft_efter_stk2_kroner(input: Pbl18Input) -> penge_positivt_beløb(pbl18_par16_resultat(input).reguleret_bruttoloft_kroner - pbl18_reducerende_arbejdsgiverindbetalinger_kroner(input))
| pbl18_beløb_efter_par16_loft_kroner(input: Pbl18Input) -> pbl18_beregnet_årsfradrag_kroner(input)
| exception pbl18_par16_loft_begrænser pbl18_beløb_efter_par16_loft_kroner(input: Pbl18Input) -> penge_mindste_beløb(pbl18_beregnet_årsfradrag_kroner(input), pbl18_fradragsloft_efter_stk2_kroner(input)) under pbl18_ordning_har_rate_loft(input.ordning) || pbl18_ordning_har_kapital_loft(input.ordning)

| pbl18_opfyldningsgrundbeløb_kroner(indkomstår: Heltal) -> 0
| exception pbl18_opfyldningsgrundbeløb_reguleres pbl18_opfyldningsgrundbeløb_kroner(indkomstår: Heltal) -> par20_reguleret_og_afrundet_kroner(Par20ReguleringInput(
    grundbeløb_2010_niveau_kroner = 46000,
    reguleringstal_tiendedele = par20_reguleringstal_tiendedele(indkomstår)
)) under pbl16_understøttet_indkomstår(indkomstår)
| pbl18_selvstændige_tillæg_kroner(input: Pbl18SelvstændigOverskudInput) -> penge_positivt_beløb(input.renteudgifter_kroner) + penge_positivt_beløb(input.kurstab_kroner)
| pbl18_selvstændige_fradrag_fra_overskud_kroner(input: Pbl18SelvstændigOverskudInput) -> penge_positivt_beløb(input.renteindtægter_kroner) + penge_positivt_beløb(input.udbytteindtægter_kroner) + penge_positivt_beløb(input.kursgevinster_kroner) + penge_positivt_beløb(input.udelukkede_afståelsesindkomster_kroner)
| pbl18_selvstændigt_overskud_kroner(input: Pbl18SelvstændigOverskudInput) -> penge_positivt_beløb(input.skattepligtigt_overskud_før_vsl22b_kroner + pbl18_selvstændige_tillæg_kroner(input) - pbl18_selvstændige_fradrag_fra_overskud_kroner(input))
| pbl18_selvstændig_30_pct_kroner(input: Pbl18Input) -> pbl18_selvstændigt_overskud_kroner(input.fradragsramme.selvstændig_overskud) * 3000 / 10000
| pbl18_resterende_fradragsramme_kroner(input: Pbl18Input) -> penge_positivt_beløb(input.fradragsramme.forfaldne_ikke_tidligere_fratrukket_kroner)
| pbl18_valgt_årsfradrag_kroner(input: Pbl18Input) -> match input.fradragsramme.valg {
    | Pbl18FordeltFradrag -> pbl18_beløb_efter_par16_loft_kroner(input)
    | Pbl18Grundbeløbsvalg(ønsket_fradrag_kroner) -> hvis input.ordning == Pbl18LivsvarigLivrente && pbl18_beregnet_årsfradrag_kroner(input) < pbl18_opfyldningsgrundbeløb_kroner(input.indkomstår) { penge_mindste_beløb(penge_mindste_beløb(penge_positivt_beløb(ønsket_fradrag_kroner), pbl18_opfyldningsgrundbeløb_kroner(input.indkomstår)), pbl18_resterende_fradragsramme_kroner(input)) } ellers { pbl18_beløb_efter_par16_loft_kroner(input) }
    | Pbl18Selvstændig30PctValg -> hvis input.ordning == Pbl18LivsvarigLivrente && pbl18_beregnet_årsfradrag_kroner(input) < pbl18_selvstændig_30_pct_kroner(input) { penge_mindste_beløb(pbl18_selvstændig_30_pct_kroner(input), pbl18_resterende_fradragsramme_kroner(input)) } ellers { pbl18_beløb_efter_par16_loft_kroner(input) }
}
| pbl18_beløb_efter_særligt_maksimum_kroner(input: Pbl18Input) -> pbl18_valgt_årsfradrag_kroner(input)
| exception pbl18_særlige_ordninger_skal_have_kildeloft pbl18_beløb_efter_særligt_maksimum_kroner(input: Pbl18Input) -> penge_mindste_beløb(pbl18_valgt_årsfradrag_kroner(input), penge_positivt_beløb(input.fradragsramme.særligt_ordningsmaksimum_kroner)) under pbl18_ordning_har_særligt_maksimum(input.ordning)
| pbl18_beløb_efter_personlig_indkomst_loft_kroner(input: Pbl18Input) -> pbl18_beløb_efter_særligt_maksimum_kroner(input)
| exception pbl18_kapitalordning_begrænses_af_personlig_indkomst pbl18_beløb_efter_personlig_indkomst_loft_kroner(input: Pbl18Input) -> penge_mindste_beløb(pbl18_beløb_efter_særligt_maksimum_kroner(input), penge_positivt_beløb(input.fradragsramme.personlig_indkomst_før_pensionsfradrag_kroner)) under pbl18_ordning_har_personlig_indkomst_loft(input.ordning)
| pbl18_grundlæggende_fradragsret(input: Pbl18Input) -> pbl18_ordning_omfattet_af_kapitel1(input.ordning) && pbl18_ordning_udelukket_fra_fradrag(input.ordning) == Falskt && input.indbetalingskilde == Pbl18EgenIndbetaling && pbl18_fradragsretshaver_opfyldt(input.fradragsretshaver) && input.begrænsninger.pbl54_personkreds_opfyldt && input.begrænsninger.afgiftspligt_for_hele_ordningen_indtrådt == Falskt && input.begrænsninger.udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens == Falskt && pbl18_fradragsår(input.ordning, input.betaling) == input.indkomstår
| pbl18_fradrag_i_skattepligtig_indkomst_kroner(input: Pbl18Input) -> 0
| exception pbl18_fradragsret_opfyldt pbl18_fradrag_i_skattepligtig_indkomst_kroner(input: Pbl18Input) -> pbl18_beløb_efter_personlig_indkomst_loft_kroner(input) under pbl18_grundlæggende_fradragsret(input)

# Pbl18Sag(input: Pbl18Input) {
    | fradragsår() -> pbl18_fradragsår(input.ordning, input.betaling)
    | grundlæggende_fradragsret() -> pbl18_grundlæggende_fradragsret(input)
    | par16_resultat() -> pbl18_par16_resultat(input)
    | beregnet_årsfradrag_kroner() -> pbl18_beregnet_årsfradrag_kroner(input)
    | valgt_årsfradrag_kroner() -> pbl18_valgt_årsfradrag_kroner(input)
    | fradrag_i_skattepligtig_indkomst_kroner() -> pbl18_fradrag_i_skattepligtig_indkomst_kroner(input)
    | ikke_fratrukket_i_indkomståret_kroner() -> penge_positivt_beløb(pbl18_indbetalt_beløb_kroner(input) - fradrag_i_skattepligtig_indkomst_kroner())
    | resultat() -> Pbl18Resultat(
        indkomstår = input.indkomstår,
        fradragsår = fradragsår(),
        ordning = input.ordning,
        grundlæggende_fradragsret = grundlæggende_fradragsret(),
        indekskontrakter_medregnet = penge_mindste_beløb(length(input.indeksvalg.fradragsvalgte_kontraktbidrag_kroner), 6),
        indbetalt_beløb_kroner = pbl18_indbetalt_beløb_kroner(input),
        ordningsbeløb_efter_indeksbegrænsning_kroner = pbl18_ordningsbeløb_kroner(input),
        par16_reguleret_bruttoloft_kroner = par16_resultat().reguleret_bruttoloft_kroner,
        reducerende_arbejdsgiverindbetalinger_kroner = pbl18_reducerende_arbejdsgiverindbetalinger_kroner(input),
        fradragsloft_efter_stk2_kroner = pbl18_fradragsloft_efter_stk2_kroner(input),
        beregnet_årsfradrag_kroner = beregnet_årsfradrag_kroner(),
        opfyldningsgrundbeløb_kroner = pbl18_opfyldningsgrundbeløb_kroner(input.indkomstår),
        selvstændig_30_pct_kroner = pbl18_selvstændig_30_pct_kroner(input),
        valgt_årsfradrag_kroner = valgt_årsfradrag_kroner(),
        fradrag_i_skattepligtig_indkomst_kroner = fradrag_i_skattepligtig_indkomst_kroner(),
        ikke_fratrukket_i_indkomståret_kroner = ikke_fratrukket_i_indkomståret_kroner()
    )
}
| pbl18_sag(input: Pbl18Input) -> Pbl18Sag(input)
| pbl18_resultat(input: Pbl18Input) -> pbl18_sag(input).resultat()
--@end::pensionsbeskatningsloven_par18--

--@label:pensionsbeskatningsloven_par52::source:pensionsbeskatningsloven_lbk1243_par52--
----
§ 52. Ved opgørelsen af en arbejdsgivers skattepligtige indkomst kan fradrages
bidrag til en hjælpe- og understøttelsesfond, hvis betingelserne i stk. 2-4 er
opfyldt.

Stk. 2. Fonden må alene have til formål at yde understøttelse til personer, der
tidligere har været ansat i arbejdsgiverens virksomhed, eller til sådanne
arbejdstageres efterladte ægtefælle, fraskilte ægtefælle, samlever, jf. § 2, nr.
4, litra e, børn eller stedbørn under 24 år.

Stk. 3. Fondens midler skal være anbragt efter de regler, som gælder for
pensionskasser, der er omfattet af lov om firmapensionskasser.

Stk. 4. Mindst et af fondsbestyrelsens medlemmer skal vælges af og blandt de af
virksomhedens ansatte, der kan nyde godt af fondens virke.
----

--@begin::pensionsbeskatningsloven_par52--
# Pbl52Understøttelsesmodtager = Pbl52TidligereAnsat | Pbl52EfterladtÆgtefælle | Pbl52FraskiltÆgtefælle | Pbl52Samlever | Pbl52BarnUnder24 | Pbl52StedbarnUnder24 | Pbl52AndenModtager
# Pbl52FondVilkår(modtagerkreds: List(Pbl52Understøttelsesmodtager), har_andet_formål: Boolsk, midler_anbragt_efter_firmapensionskasseregler: Boolsk, medarbejdervalgt_bestyrelsesmedlem_opfyldt: Boolsk)
# Pbl52Input(arbejdsgiverbidrag_kroner: Heltal, fond: Pbl52FondVilkår)
# Pbl52Resultat(modtagerkreds_alene_tilladt: Boolsk, formål_opfyldt: Boolsk, anbringelseskrav_opfyldt: Boolsk, bestyrelseskrav_opfyldt: Boolsk, alle_betingelser_opfyldt: Boolsk, arbejdsgiverfradrag_i_skattepligtig_indkomst_kroner: Heltal)

| pbl52_understøttelsesmodtager_tilladt(modtager: Pbl52Understøttelsesmodtager) -> modtager != Pbl52AndenModtager
| pbl52_modtagerkreds_alene_tilladt(fond: Pbl52FondVilkår) -> length(fond.modtagerkreds) > 0 && all(fond.modtagerkreds, |modtager| pbl52_understøttelsesmodtager_tilladt(modtager))
| pbl52_formål_opfyldt(fond: Pbl52FondVilkår) -> pbl52_modtagerkreds_alene_tilladt(fond) && fond.har_andet_formål == Falskt
| pbl52_alle_betingelser_opfyldt(fond: Pbl52FondVilkår) -> pbl52_formål_opfyldt(fond) && fond.midler_anbragt_efter_firmapensionskasseregler && fond.medarbejdervalgt_bestyrelsesmedlem_opfyldt
| pbl52_arbejdsgiverfradrag_kroner(input: Pbl52Input) -> 0
| exception pbl52_stk2_til_stk4_opfyldt pbl52_arbejdsgiverfradrag_kroner(input: Pbl52Input) -> penge_positivt_beløb(input.arbejdsgiverbidrag_kroner) under pbl52_alle_betingelser_opfyldt(input.fond)
# Pbl52Sag(input: Pbl52Input) {
    | modtagerkreds_alene_tilladt() -> pbl52_modtagerkreds_alene_tilladt(input.fond)
    | formål_opfyldt() -> pbl52_formål_opfyldt(input.fond)
    | alle_betingelser_opfyldt() -> pbl52_alle_betingelser_opfyldt(input.fond)
    | resultat() -> Pbl52Resultat(
        modtagerkreds_alene_tilladt = modtagerkreds_alene_tilladt(),
        formål_opfyldt = formål_opfyldt(),
        anbringelseskrav_opfyldt = input.fond.midler_anbragt_efter_firmapensionskasseregler,
        bestyrelseskrav_opfyldt = input.fond.medarbejdervalgt_bestyrelsesmedlem_opfyldt,
        alle_betingelser_opfyldt = alle_betingelser_opfyldt(),
        arbejdsgiverfradrag_i_skattepligtig_indkomst_kroner = pbl52_arbejdsgiverfradrag_kroner(input)
    )
}
| pbl52_sag(input: Pbl52Input) -> Pbl52Sag(input)
| pbl52_resultat(input: Pbl52Input) -> pbl52_sag(input).resultat()
--@end::pensionsbeskatningsloven_par52--

--@label:pensionsbeskatningsloven_par53a::source:pensionsbeskatningsloven_lbk1243_par53a--
----
§ 53 A. Reglerne i stk. 2-5 gælder for livsforsikring, der ikke omfattes af
kapitel 1, livsforsikring, der opfylder betingelserne i kapitel 1, men hvor
forsikringens ejer ved ordningens oprettelse har givet afkald på beskatning
efter reglerne i afsnit I, pensionskasseordning, der ikke omfattes af kapitel 1,
pensionskasseordning, der opfylder betingelserne i kapitel 1, men hvor den
pensionsberettigede ved ordningens oprettelse har givet afkald på beskatning
efter reglerne i afsnit I, syge- og ulykkesforsikring, der ejes af den
forsikrede, livsforsikring, der omfattes af nr. 1, eller pensionskasseordning,
der omfattes af nr. 3, men som er stillet til sikkerhed for et løfte om pension
(pensionstilsagn) afgivet over for en direktør eller dennes efterladte i
forbindelse med et ansættelsesforhold, samt garantiforsikring el. lign., som er
oprettet med en direktør eller dennes efterladte som berettiget til ydelser fra
forsikringen som sikkerhed for et tilsvarende løfte om pension, pensionsordning
oprettet i pengeinstitutter eller kreditinstitutter, der ikke omfattes af
kapitel 1, pensionsordning oprettet i pengeinstitut eller kreditinstitut, der
opfylder betingelserne i kapitel 1, men hvor kontohaveren ved ordningens
oprettelse har givet afkald på beskatning efter reglerne i afsnit I, og
pensionsordning, som har været godkendt af told- og skatteforvaltningen efter
§ 15 D, i det omfang pensionsordningen ikke omfattes af § 53 B.

Stk. 2. Præmier eller bidrag til pensionsordninger m.v. som nævnt i stk. 1 kan
ikke fradrages ved opgørelsen af den skattepligtige indkomst. Præmier og bidrag
m.v. til sikkerhedsstillelse omfattet af stk. 1, nr. 6, er fradragsberettigede
for arbejdsgiveren i det indkomstår, hvor sikkerhedsstillelsen er etableret, og
efterfølgende år. Ved opgørelsen af en arbejdstagers skattepligtige indkomst
medregnes præmier eller bidrag, der er indbetalt af arbejdsgiveren eller en
tidligere arbejdsgiver. Ved opgørelsen af den skattepligtige indkomst for en
person medregnes beløb, der af den pågældendes ægtefælles eller samlevers
arbejdsgiver indbetales til en pensionsordning m.v. som nævnt i stk. 1 for den
pågældende i en periode af mindst en måneds varighed, hvori den pågældendes
ægtefælle eller samlever af sin arbejdsgiver er udsendt for at arbejde i en
fremmed stat, Færøerne eller Grønland, og hvori den pågældende har fælles bopæl
med den udsendte i den fremmede stat, Færøerne eller Grønland. 3. pkt. finder
dog ikke anvendelse, hvis der under udsendelsen indbetales præmier eller bidrag
til en pensionsordning i ansættelsesforhold omfattet af denne lovs afsnit I
eller II A for den pågældende.

Stk. 3. Ved opgørelsen af den skattepligtige indkomst medregnes afkastet af
pensionsordninger som nævnt i stk. 1. Indkomstskattepligten påhviler ejeren, den
pensionsberettigede eller den eller dem, der efter ejerens eller den første
pensionsberettigedes død er berettiget til udbetalinger af eller fra ordningen.
I tilfælde omfattet af stk. 1, nr. 6, påhviler indkomstskattepligten den
pågældende direktør eller den eller dem, der efter direktørens død er berettiget
til udbetalinger af eller fra ordningen. Afkastet opgøres efter §§ 3-5 i
pensionsafkastbeskatningsloven, jf. dog 6. pkt. Efter
pensionsafkastbeskatningslovens § 4, stk. 1, 1. pkt., skal dog alene medregnes
forskellen mellem værdien af forsikringens depot ved indkomstårets udgang
korrigeret efter § 4, stk. 3, og værdien af forsikringens depot ved
indkomstårets begyndelse korrigeret efter § 4, stk. 4. Hvis pensionsudbyderen
ikke opgør afkastet efter 4. og 5. pkt., kan afkastet i stedet opgøres som
forskellen mellem på den ene side ordningens kapitalværdi ved indkomstårets
udgang med tillæg af udbetalinger i årets løb og på den anden side ordningens
kapitalværdi ved indkomstårets begyndelse med tillæg af indbetalinger i årets
løb. Valget mellem opgørelse af afkastet efter 4. og 5. pkt. eller 6 pkt. er
bindende for efterfølgende indkomstår. I indkomstår, hvor skattepligten
indtræder eller ophører, er indkomståret den del af kalenderåret, hvori
skattepligten har bestået. Ved opgørelsen af afkast på en livsforsikring eller
en pensionskasseordning, der i løbet af indkomståret stilles til sikkerhed for
et løfte om pension (pensionstilsagn) afgivet over for en direktør eller dennes
efterladte i forbindelse med et ansættelsesforhold, jf. stk. 1, nr. 6, eller
hvor sikkerhedsstillelsen ophører, træder værdien af forsikringens depot på
tidspunktet for sikkerhedsstillelsen henholdsvis ophøret i stedet for værdien af
forsikringens depot ved indkomstårets begyndelse henholdsvis udgang. 6. og 7.
pkt. finder tilsvarende anvendelse. Er der efter 2. pkt. flere berettigede,
fordeles det opgjorte afkast efter forholdet mellem de pågældendes andele af
indeståendet på ordningen ved indkomstårets udgang. Et negativt afkast af en
ordning kan kun modregnes i det pågældende indkomstårs og de følgende
indkomstårs positive afkast af samme ordning. Et negativt afkast kan kun
fremføres til et senere indkomstår, hvis det ikke kan rummes i positivt afkast i
et tidligere indkomstår. Udbetalinger fra pensionsordninger m.v. som nævnt i
stk. 1 til dækning af beskatningen af det løbende afkast medregnes ikke til den
skattepligtige indkomst. Udbetaling af beløb til dækning af skatten skal
foretages senest året efter det år, hvori afkastet er optjent.

Stk. 4. Syge- og ulykkesforsikringer som nævnt i stk. 1, nr. 5, og
garantiforsikringer eller lignende omfattet af stk. 1, nr. 6, er undtaget fra
beskatningen efter stk. 3. Det samme gælder livsforsikringer, der alene kan
komme til udbetaling i tilfælde af den forsikredes død, invaliditet eller
livstruende sygdom inden forsikringens aftalte udløbstidspunkt, såfremt det
aftalte udløbstidspunkt ikke ligger senere end første policedag efter den
forsikredes fyldte 80. år.

Stk. 5. Udbetalinger fra pensionsordninger m.v. som nævnt i stk. 1 til den
personkreds, der er nævnt i § 55, 1. pkt., og som svarer til indbetalinger på
ordningen, som der ved opgørelsen af ejerens skattepligtige indkomst har været
hel eller delvis fradrags- eller bortseelsesret for her i landet eller i
udlandet, medregnes til den skattepligtige indkomst. Dog medregnes udbetalinger
fra ordninger svarende til danske kapitalforsikringer og opsparinger i
pensionsøjemed med 75 pct., når udbetalingen efter betingelserne i ordningen
sker samlet, efter at ejeren har nået pensionsudbetalingsalderen, ved ejerens
invaliditet, ved indtrådt livstruende sygdom hos ejeren eller ved ejerens død.
Ved beskatning efter 1. pkt. finder § 20, stk. 6, tilsvarende anvendelse.
Arbejdsgiverens udbetalinger i henhold til et løfte om pension, jf. stk. 1,
nr. 6, medregnes ikke ved opgørelsen af den skattepligtige indkomst, i den
udstrækning de foretagne indbetalinger modsvarer sikkerhedsstillelsen eller den
tidligere sikkerhedsstillelse.

Stk. 6. Uanset stk. 1, nr. 2 og 4, kan der ikke ved oprettelsen af en
pensionsordning gives afkald på beskatning efter reglerne i afsnit I, hvis
pensionsordningen modtager statsstøtte.
----

--@begin::pensionsbeskatningsloven_par53a--
# Pensionsbeskatningslov53AOrdning = Pbl53ALivsforsikringUdenKapitel1 | Pbl53ALivsforsikringAfkaldAfsnitI | Pbl53APensionskasseUdenKapitel1 | Pbl53APensionskasseAfkaldAfsnitI | Pbl53ASygeOgUlykkesforsikring | Pbl53ADirektørSikkerhedLivsforsikringEllerPensionskasse | Pbl53ADirektørGarantiforsikring | Pbl53APengeinstitutUdenKapitel1 | Pbl53APengeinstitutAfkaldAfsnitI | Pbl53ATidligerePar15DGodkendt
# Pensionsbeskatningslov53AAfkastmetode = Pbl53AAfkastEfterPalPar3Til5 | Pbl53AAlternativKapitalværdi
# Pensionsbeskatningslov53AInput(indkomstår: Heltal, ordning: Pensionsbeskatningslov53AOrdning, omfattes_af_par53b: Boolsk, alene_død_invaliditet_livstruende_sygdom_til_senest_80_år: Boolsk, afkastmetode: Pensionsbeskatningslov53AAfkastmetode, afkast_efter_pal_par3_til_5_kroner: Heltal, kapitalværdi_primo_kroner: Heltal, kapitalværdi_ultimo_kroner: Heltal, udbetalinger_i_året_kroner: Heltal, indbetalinger_i_året_kroner: Heltal, fremført_negativt_afkast_primo_kroner: Heltal, andel_tæller: Heltal, andel_nævner: Heltal, udbetaling_til_afkastskat_kroner: Heltal)
# Pensionsbeskatningslov53AResultat(indkomstår: Heltal, ordning: Pensionsbeskatningslov53AOrdning, omfattet_af_stk1: Boolsk, undtaget_efter_stk4: Boolsk, afkast_efter_valgt_metode_kroner: Heltal, afkastandel_før_negativ_fremførsel_kroner: Heltal, fremført_negativt_afkast_anvendt_kroner: Heltal, skattepligtigt_afkast_kroner: Heltal, fremført_negativt_afkast_ultimo_kroner: Heltal, udbetaling_til_afkastskat_medregnes_kroner: Heltal, kapitalindkomst_kroner: Heltal)

| pbl53a_ordning_stk4_undtaget(ordning: Pensionsbeskatningslov53AOrdning) -> Falskt
| exception pbl53a_syge_ulykke_undtages pbl53a_ordning_stk4_undtaget(ordning: Pensionsbeskatningslov53AOrdning) -> Sandt under ordning == Pbl53ASygeOgUlykkesforsikring
| exception pbl53a_garantiforsikring_undtages pbl53a_ordning_stk4_undtaget(ordning: Pensionsbeskatningslov53AOrdning) -> Sandt under ordning == Pbl53ADirektørGarantiforsikring

# Pensionsbeskatningslov53ASag(input: Pensionsbeskatningslov53AInput) {
    | omfattet_af_stk1() -> input.omfattes_af_par53b == Falskt
    | undtaget_efter_stk4() -> pbl53a_ordning_stk4_undtaget(input.ordning) || input.alene_død_invaliditet_livstruende_sygdom_til_senest_80_år
    | beløb_medregnes_efter_stk3() -> omfattet_af_stk1() && undtaget_efter_stk4() == Falskt
    | afkast_efter_valgt_metode_kroner() -> input.afkast_efter_pal_par3_til_5_kroner under input.afkastmetode == Pbl53AAfkastEfterPalPar3Til5
    | exception pbl53a_alternativ_kapitalværdi_afkast afkast_efter_valgt_metode_kroner() -> (input.kapitalværdi_ultimo_kroner + penge_positivt_beløb(input.udbetalinger_i_året_kroner)) - (input.kapitalværdi_primo_kroner + penge_positivt_beløb(input.indbetalinger_i_året_kroner)) under input.afkastmetode == Pbl53AAlternativKapitalværdi
    | andel_nævner() -> penge_største_beløb(input.andel_nævner, 1)
    | afkastandel_før_negativ_fremførsel_kroner() -> afkast_efter_valgt_metode_kroner() * penge_positivt_beløb(input.andel_tæller) / andel_nævner()
    | fremført_negativt_afkast_primo_kroner() -> penge_positivt_beløb(input.fremført_negativt_afkast_primo_kroner)
    | fremført_negativt_afkast_anvendt_kroner() -> 0
    | exception pbl53a_fremført_negativt_afkast_modregnes fremført_negativt_afkast_anvendt_kroner() -> penge_mindste_beløb(penge_positivt_beløb(afkastandel_før_negativ_fremførsel_kroner()), fremført_negativt_afkast_primo_kroner()) under beløb_medregnes_efter_stk3()
    | skattepligtigt_afkast_kroner() -> 0
    | exception pbl53a_positivt_afkast_medregnes skattepligtigt_afkast_kroner() -> penge_positivt_beløb(afkastandel_før_negativ_fremførsel_kroner()) - fremført_negativt_afkast_anvendt_kroner() under beløb_medregnes_efter_stk3()
    | fremført_negativt_afkast_ultimo_kroner() -> 0
    | exception pbl53a_negativt_afkast_fremføres fremført_negativt_afkast_ultimo_kroner() -> fremført_negativt_afkast_primo_kroner() - fremført_negativt_afkast_anvendt_kroner() + penge_positivt_beløb(0 - afkastandel_før_negativ_fremførsel_kroner()) under beløb_medregnes_efter_stk3()
    | udbetaling_til_afkastskat_medregnes_kroner() -> 0
    | kapitalindkomst_kroner() -> skattepligtigt_afkast_kroner()
    | resultat() -> Pensionsbeskatningslov53AResultat(
        indkomstår = input.indkomstår,
        ordning = input.ordning,
        omfattet_af_stk1 = omfattet_af_stk1(),
        undtaget_efter_stk4 = undtaget_efter_stk4(),
        afkast_efter_valgt_metode_kroner = afkast_efter_valgt_metode_kroner(),
        afkastandel_før_negativ_fremførsel_kroner = afkastandel_før_negativ_fremførsel_kroner(),
        fremført_negativt_afkast_anvendt_kroner = fremført_negativt_afkast_anvendt_kroner(),
        skattepligtigt_afkast_kroner = skattepligtigt_afkast_kroner(),
        fremført_negativt_afkast_ultimo_kroner = fremført_negativt_afkast_ultimo_kroner(),
        udbetaling_til_afkastskat_medregnes_kroner = udbetaling_til_afkastskat_medregnes_kroner(),
        kapitalindkomst_kroner = kapitalindkomst_kroner()
    )
}
| pensionsbeskatningslov53a_sag(input: Pensionsbeskatningslov53AInput) -> Pensionsbeskatningslov53ASag(input)
| pensionsbeskatningslov53a_resultat(input: Pensionsbeskatningslov53AInput) -> pensionsbeskatningslov53a_sag(input).resultat()

= pbl53a_pal_afkast_fixture = pensionsbeskatningslov53a_resultat(Pensionsbeskatningslov53AInput(
    indkomstår = 2026,
    ordning = Pbl53ALivsforsikringUdenKapitel1,
    omfattes_af_par53b = Falskt,
    alene_død_invaliditet_livstruende_sygdom_til_senest_80_år = Falskt,
    afkastmetode = Pbl53AAfkastEfterPalPar3Til5,
    afkast_efter_pal_par3_til_5_kroner = 28000,
    kapitalværdi_primo_kroner = 0,
    kapitalværdi_ultimo_kroner = 0,
    udbetalinger_i_året_kroner = 0,
    indbetalinger_i_året_kroner = 0,
    fremført_negativt_afkast_primo_kroner = 6000,
    andel_tæller = 1,
    andel_nævner = 1,
    udbetaling_til_afkastskat_kroner = 0
))
= pbl53a_alternativt_afkast_fixture = pensionsbeskatningslov53a_resultat(Pensionsbeskatningslov53AInput(
    indkomstår = 2026,
    ordning = Pbl53APengeinstitutUdenKapitel1,
    omfattes_af_par53b = Falskt,
    alene_død_invaliditet_livstruende_sygdom_til_senest_80_år = Falskt,
    afkastmetode = Pbl53AAlternativKapitalværdi,
    afkast_efter_pal_par3_til_5_kroner = 0,
    kapitalværdi_primo_kroner = 200000,
    kapitalværdi_ultimo_kroner = 230000,
    udbetalinger_i_året_kroner = 12000,
    indbetalinger_i_året_kroner = 15000,
    fremført_negativt_afkast_primo_kroner = 0,
    andel_tæller = 1,
    andel_nævner = 2,
    udbetaling_til_afkastskat_kroner = 3000
))
= pbl53a_negativt_afkast_fixture = pensionsbeskatningslov53a_resultat(Pensionsbeskatningslov53AInput(
    indkomstår = 2026,
    ordning = Pbl53APensionskasseUdenKapitel1,
    omfattes_af_par53b = Falskt,
    alene_død_invaliditet_livstruende_sygdom_til_senest_80_år = Falskt,
    afkastmetode = Pbl53AAlternativKapitalværdi,
    afkast_efter_pal_par3_til_5_kroner = 0,
    kapitalværdi_primo_kroner = 140000,
    kapitalværdi_ultimo_kroner = 128000,
    udbetalinger_i_året_kroner = 4000,
    indbetalinger_i_året_kroner = 0,
    fremført_negativt_afkast_primo_kroner = 5000,
    andel_tæller = 1,
    andel_nævner = 1,
    udbetaling_til_afkastskat_kroner = 0
))
= pbl53a_stk4_undtaget_fixture = pensionsbeskatningslov53a_resultat(Pensionsbeskatningslov53AInput(
    indkomstår = 2026,
    ordning = Pbl53ASygeOgUlykkesforsikring,
    omfattes_af_par53b = Falskt,
    alene_død_invaliditet_livstruende_sygdom_til_senest_80_år = Falskt,
    afkastmetode = Pbl53AAfkastEfterPalPar3Til5,
    afkast_efter_pal_par3_til_5_kroner = 18000,
    kapitalværdi_primo_kroner = 0,
    kapitalværdi_ultimo_kroner = 0,
    udbetalinger_i_året_kroner = 0,
    indbetalinger_i_året_kroner = 0,
    fremført_negativt_afkast_primo_kroner = 0,
    andel_tæller = 1,
    andel_nævner = 1,
    udbetaling_til_afkastskat_kroner = 0
))
= pbl53a_par53b_udelukket_fixture = pensionsbeskatningslov53a_resultat(Pensionsbeskatningslov53AInput(
    indkomstår = 2026,
    ordning = Pbl53ATidligerePar15DGodkendt,
    omfattes_af_par53b = Sandt,
    alene_død_invaliditet_livstruende_sygdom_til_senest_80_år = Falskt,
    afkastmetode = Pbl53AAfkastEfterPalPar3Til5,
    afkast_efter_pal_par3_til_5_kroner = 12000,
    kapitalværdi_primo_kroner = 0,
    kapitalværdi_ultimo_kroner = 0,
    udbetalinger_i_året_kroner = 0,
    indbetalinger_i_året_kroner = 0,
    fremført_negativt_afkast_primo_kroner = 0,
    andel_tæller = 1,
    andel_nævner = 1,
    udbetaling_til_afkastskat_kroner = 0
))

| pbl53a_pal_afkast_medregnes_efter_negativ_fremførsel: pbl53a_pal_afkast_fixture -> pbl53a_pal_afkast_fixture.afkast_efter_valgt_metode_kroner == 28000 && pbl53a_pal_afkast_fixture.fremført_negativt_afkast_anvendt_kroner == 6000 && pbl53a_pal_afkast_fixture.skattepligtigt_afkast_kroner == 22000
| pbl53a_alternativt_afkast_med_andel_medregnes: pbl53a_alternativt_afkast_fixture -> pbl53a_alternativt_afkast_fixture.afkast_efter_valgt_metode_kroner == 27000 && pbl53a_alternativt_afkast_fixture.afkastandel_før_negativ_fremførsel_kroner == 13500 && pbl53a_alternativt_afkast_fixture.skattepligtigt_afkast_kroner == 13500 && pbl53a_alternativt_afkast_fixture.udbetaling_til_afkastskat_medregnes_kroner == 0
| pbl53a_negativt_afkast_fremføres_kun_samme_ordning: pbl53a_negativt_afkast_fixture -> pbl53a_negativt_afkast_fixture.afkast_efter_valgt_metode_kroner == -8000 && pbl53a_negativt_afkast_fixture.skattepligtigt_afkast_kroner == 0 && pbl53a_negativt_afkast_fixture.fremført_negativt_afkast_ultimo_kroner == 13000
| pbl53a_stk4_undtagelse_afskærer_afkast: pbl53a_stk4_undtaget_fixture -> pbl53a_stk4_undtaget_fixture.undtaget_efter_stk4 == Sandt && pbl53a_stk4_undtaget_fixture.skattepligtigt_afkast_kroner == 0
| pbl53a_par53b_udelukker_stk1: pbl53a_par53b_udelukket_fixture -> pbl53a_par53b_udelukket_fixture.omfattet_af_stk1 == Falskt && pbl53a_par53b_udelukket_fixture.skattepligtigt_afkast_kroner == 0
--@end::pensionsbeskatningsloven_par53a--
