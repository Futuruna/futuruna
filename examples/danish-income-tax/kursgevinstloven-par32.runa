@ importer ./kursgevinstloven
@ importer ./aktieavancebeskatningsloven

# KursgevinstlovPar32KildeInfo(url: Tekst, identifier: Tekst, hentet_dato: Tekst)

= kursgevinstloven_lbk1176_par32 = KursgevinstlovPar32KildeInfo(
    url = "https://www.retsinformation.dk/eli/lta/2025/1176",
    identifier = "Kursgevinstloven § 32",
    hentet_dato = "2026-07-18"
)

