@ sprog da

@ importer ./personskat.calculate

----
Regressionsscenarie for den maskinlæsbare beregningsgrænse.

Scenariet er ikke lovtekst. Det fastholder, at den samme LønmodtagerInput, som
kan udfyldes gennem JSON, TOML eller XLSX, går gennem beregn_personskat og giver
samme resultat som den øvrige lønmodtagermodel.
----

= personskat_calculate_input = LønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    nettokapitalindkomst_kroner = 0,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
= personskat_calculate_resultat = beregn_personskat(personskat_calculate_input)

| personskat_calculate_am_bidrag: personskat_calculate_resultat -> personskat_calculate_resultat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_personfradrag: personskat_calculate_resultat -> personskat_calculate_resultat.personfradrag_kroner == 54100
| personskat_calculate_samlet_skat: personskat_calculate_resultat -> personskat_calculate_resultat.samlet_inkl_am_efter_personfradrag_kroner == 208726

? personskat_calculate_am_bidrag
? personskat_calculate_personfradrag
? personskat_calculate_samlet_skat
