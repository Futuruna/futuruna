@ sprog da

@ importer ./personskat.calculate

----
Regressionsscenarie for den maskinlæsbare beregningsgrænse.

Scenariet er ikke lovtekst. Det fastholder, at den samme typede PersonskatInput,
som kan udfyldes gennem JSON, TOML eller XLSX, går gennem beregn_personskat og
giver samme resultat som den øvrige lønmodtagermodel. Standardvarianterne gør
særlige skatte-, underskuds- og årsopgørelsesfelter valgfrie.
----

= personskat_calculate_lønmodtager = PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
= personskat_calculate_input = PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
= personskat_calculate_resultat = beregn_personskat(personskat_calculate_input)

| personskat_calculate_input_med_aktieavance(aktieavance: PersonskatAktieavanceInput) -> PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = aktieavance,
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_input_med_kapitalindkomst(kapitalindkomst: PersonskatKapitalindkomstInput) -> PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = kapitalindkomst,
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_input_med_lønmodtager(lønmodtager: PersonskatLønmodtagerInput) -> PersonskatInput(
    lønmodtager = lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_befordringsfakta(fri_befordring: Boolsk, ligningslov9d: PersonskatLigningslov9DInput) -> PersonskatBefordringsfradragFakta(
    arbejdsdage = 203,
    daglige_befordringskilometer = 60,
    bopæl_i_yderkommune_eller_lille_ø = Falskt,
    befordringsformål = IndtægtsgivendeArbejdsplads,
    modtaget_skattefri_befordringsgodtgørelse_for_strækning = Falskt,
    modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = Falskt,
    ligningslov9d = ligningslov9d,
    fradrag_udelukket_folketingshverv_m_v = Falskt,
    fri_befordring_betalt_af_arbejdsgiver_for_hele_strækningen = fri_befordring,
    broer = ll9c_ingen_bropassager(),
    særlig_transport = ll9c_ingen_særlig_transport()
)
| personskat_calculate_lønmodtager_med_befordring(fakta: PersonskatBefordringsfradragFakta) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    ligningsfradrag = PersonskatLigningsfradragInput(
        befordring = MedBefordringsfradrag(fakta = fakta)
    ),
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)

= personskat_calculate_ll6_input = Ligningslov6KurstabInput(
    indkomstår = 2026,
    kontantlån_optaget_i_realkreditinstitut_før_19_maj_1993 = Sandt,
    indfrielse_sker_ved_realkreditlån = Sandt,
    nyt_lån_optaget_før_1_januar_1996 = Sandt,
    nyt_lån_mindst_samme_løbetid = Sandt,
    transaktioner_inden_for_1_år = Sandt,
    lånetilbud_før_indfrielse_hvis_indfrielse_før_optagelse = Sandt,
    kurstab_kroner = 24000,
    samlet_antal_terminer = 12,
    forfaldne_terminer_i_indkomståret = 1,
    ekstraordinær_indfrielse_af_nyt_lån = Falskt,
    stk4_omlægning_undtager_stk3 = Falskt,
    stk3_nedsættelse_basispoint = 0,
    debitorskifte_i_året = Falskt,
    debitordage_for_skattepligtig = 0,
    dage_i_overdragelsesår = 0,
    kurstab_medregnes_efter_kursgevinstloven = Falskt
)
= personskat_calculate_ll6a_input = Ligningslov6AInput(
    indkomstår = 2026,
    skattepligtig_person = Sandt,
    arbejderboliger_beløb_kroner = 1000,
    arbejderboliger_betalt = Sandt,
    statshusmandsbrug_jordrente_beløb_kroner = 0,
    statshusmandsbrug_jordrente_betalt = Falskt
)
= personskat_calculate_rente_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = MedLigningslov6Kurstab(input = personskat_calculate_ll6_input),
        ligningslov6a = MedLigningslov6AFradrag(input = personskat_calculate_ll6a_input)
    ),
    ejendomsavance = UdenEjendomsavance,
    omkostninger = [
        PersonskatKapitalomkostningInput(identifikation = "bankgebyr", beløb_kroner = 2000)
    ]
)))
= personskat_calculate_finansieringsnæring_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = FinansieringsNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    ejendomsavance = UdenEjendomsavance,
    omkostninger = [
        PersonskatKapitalomkostningInput(identifikation = "finansieringsomkostning", beløb_kroner = 3000)
    ]
)))
= personskat_calculate_ll6_forkert_år = Ligningslov6KurstabInput(
    indkomstår = 2025,
    kontantlån_optaget_i_realkreditinstitut_før_19_maj_1993 = Sandt,
    indfrielse_sker_ved_realkreditlån = Sandt,
    nyt_lån_optaget_før_1_januar_1996 = Sandt,
    nyt_lån_mindst_samme_løbetid = Sandt,
    transaktioner_inden_for_1_år = Sandt,
    lånetilbud_før_indfrielse_hvis_indfrielse_før_optagelse = Sandt,
    kurstab_kroner = 24000,
    samlet_antal_terminer = 12,
    forfaldne_terminer_i_indkomståret = 1,
    ekstraordinær_indfrielse_af_nyt_lån = Falskt,
    stk4_omlægning_undtager_stk3 = Falskt,
    stk3_nedsættelse_basispoint = 0,
    debitorskifte_i_året = Falskt,
    debitordage_for_skattepligtig = 0,
    dage_i_overdragelsesår = 0,
    kurstab_medregnes_efter_kursgevinstloven = Falskt
)
= personskat_calculate_ll6_forkert_år_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = MedLigningslov6Kurstab(input = personskat_calculate_ll6_forkert_år),
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    ejendomsavance = UdenEjendomsavance,
    omkostninger = []
)))

| personskat_calculate_ejendomsavancefakta(identifikation: Tekst, anskaffelsessum_kroner: Heltal, afståelsessum_kroner: Heltal, ejendomstype: EjendomsavanceEjendomstype) -> PersonskatEjendomsavanceFakta(
    identifikation = identifikation,
    afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = anskaffelsessum_kroner,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = ebl_par5_standardfakta(EblDato(år = 2026, måned = 1, dag = 1), EblPar4AlmindeligtAnskaffelsesgrundlag),
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = afståelsessum_kroner,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = ejendomstype,
    par11_stk2_genanbragt_erhvervsejendom = Falskt,
    par6d_valg = EblUdenPar6DValg
)
| personskat_calculate_par6a_genanbringelse(erhvervsfortjeneste_kroner: Heltal) -> EblMedGenanbringelseEfterPar6A(fakta = EblPar6AFakta(
    oprindelig_fortjeneste = EblOprindeligErhvervsfortjeneste(
        afståelsesindkomstår = 2025,
        erhvervsfortjeneste_før_par6_stk2_kroner = erhvervsfortjeneste_kroner,
        regulering = EblGenanbragtFortjenesteregulering(
            tillæg_for_genanbragt_del_kroner = 0,
            nedslag_for_genanbragt_del_kroner = 0
        )
    ),
    afstået_ejendoms_erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
    investering = EblPar6AInvestering(
        indkomstår = 2026,
        erhvervsmæssigt_anskaffelsesgrundlag_kroner = 1000000,
        ejendomsstatus = EblPar6AEjendomOmfattetAfLovenIkkePar8,
        erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
        placering = EblPar6AEjendomIDanmark
    ),
    begæring = EblPar6ABegæringVedRettidigAfgivelseEfterSkattekontrollovensPar2,
    ejerskab = EblPar6ASammeSkattepligtige
))
| personskat_calculate_kapitalindkomst_med_ejendomsavance(ejendomsavance: PersonskatEjendomsavanceInput) -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    ejendomsavance = ejendomsavance,
    omkostninger = []
)
= personskat_calculate_ejendomsavance_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(personskat_calculate_kapitalindkomst_med_ejendomsavance(MedEjendomsavance(fakta = PersonskatEjendomsavanceÅrsfakta(
    egne_afståelser = [
        personskat_calculate_ejendomsavancefakta("egen-fortjeneste", 1000000, 1200000, EblBoligejendom(fakta = EblPar8Fakta(
            ejendomsart = EblPar8Ejerlejlighed,
            tjent_til_bolig_eller_privat_formål = Sandt,
            betingelser_opfyldt_i_ejerperioden = Sandt,
            afståelsesforhold = EblPar8AlmindeligAfståelse,
            genanbringelsesforhold = EblPar8GenanbringelseEfterStk5(
                genanbringelse = personskat_calculate_par6a_genanbringelse(190000),
                ejendommen_ændrede_anvendelse_til_par8_før_15_december_2005 = Falskt
            )
        ))),
        personskat_calculate_ejendomsavancefakta("eget-tab", 500000, 450000, ebl_anden_fast_ejendom_uden_genanbringelse())
    ],
    eget_fremført_tab = MedFremførtEjendomstab(fra_indkomstår = 2025, tab_kroner = 25000),
    ægtefælles_afståelser = [
        personskat_calculate_ejendomsavancefakta("ægtefælles-tab", 300000, 270000, ebl_anden_fast_ejendom_uden_genanbringelse())
    ],
    ægtefælles_fremførte_tab = UdenFremførtEjendomstab,
    gift_samlevende_ved_indkomstårets_udgang = Sandt
)))))
= personskat_calculate_ejendomsavance_overførselsloft_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(personskat_calculate_kapitalindkomst_med_ejendomsavance(MedEjendomsavance(fakta = PersonskatEjendomsavanceÅrsfakta(
    egne_afståelser = [
        personskat_calculate_ejendomsavancefakta("egen-fortjeneste-loft", 1000000, 1200000, ebl_anden_fast_ejendom_uden_genanbringelse()),
        personskat_calculate_ejendomsavancefakta("eget-tab-loft", 500000, 450000, ebl_anden_fast_ejendom_uden_genanbringelse())
    ],
    eget_fremført_tab = MedFremførtEjendomstab(fra_indkomstår = 2025, tab_kroner = 25000),
    ægtefælles_afståelser = [
        personskat_calculate_ejendomsavancefakta("ægtefælles-tab-loft", 300000, 150000, ebl_anden_fast_ejendom_uden_genanbringelse())
    ],
    ægtefælles_fremførte_tab = UdenFremførtEjendomstab,
    gift_samlevende_ved_indkomstårets_udgang = Sandt
)))))
= personskat_calculate_par8_fortjeneste_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(personskat_calculate_kapitalindkomst_med_ejendomsavance(MedEjendomsavance(fakta = PersonskatEjendomsavanceÅrsfakta(
    egne_afståelser = [personskat_calculate_ejendomsavancefakta("par8-fortjeneste", 1000000, 1200000, EblBoligejendom(fakta = EblPar8Fakta(
        ejendomsart = EblPar8EnEllerTofamilieshus(grundbetingelse = EblPar8GrundarealUnder1400M2),
        tjent_til_bolig_eller_privat_formål = Sandt,
        betingelser_opfyldt_i_ejerperioden = Sandt,
        afståelsesforhold = EblPar8AlmindeligAfståelse,
        genanbringelsesforhold = EblPar8UdenGenanbringelseEfterStk5
    )))],
    eget_fremført_tab = UdenFremførtEjendomstab,
    ægtefælles_afståelser = [],
    ægtefælles_fremførte_tab = UdenFremførtEjendomstab,
    gift_samlevende_ved_indkomstårets_udgang = Falskt
)))))
= personskat_calculate_ordinær_genanbringelse_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(personskat_calculate_kapitalindkomst_med_ejendomsavance(MedEjendomsavance(fakta = PersonskatEjendomsavanceÅrsfakta(
    egne_afståelser = [personskat_calculate_ejendomsavancefakta(
        identifikation = "ordinær-genanbringelse",
        anskaffelsessum_kroner = 1000000,
        afståelsessum_kroner = 1000000,
        ejendomstype = EblAndenFastEjendom(
            genanbringelse = personskat_calculate_par6a_genanbringelse(erhvervsfortjeneste_kroner = 200000)
        )
    )],
    eget_fremført_tab = UdenFremførtEjendomstab,
    ægtefælles_afståelser = [],
    ægtefælles_fremførte_tab = UdenFremførtEjendomstab,
    gift_samlevende_ved_indkomstårets_udgang = Falskt
)))))

= personskat_calculate_befordring_resultat = beregn_personskat(personskat_calculate_input_med_lønmodtager(personskat_calculate_lønmodtager_med_befordring(personskat_calculate_befordringsfakta(Falskt, UdenLigningslov9D))))
= personskat_calculate_fri_befordring_resultat = beregn_personskat(personskat_calculate_input_med_lønmodtager(personskat_calculate_lønmodtager_med_befordring(personskat_calculate_befordringsfakta(Sandt, UdenLigningslov9D))))
= personskat_calculate_ll9d_input = Ligningslov9DInput(
    skatteår = 2026,
    befordringsformål = Par9DArbejdsplads,
    godtgjort_varigt_nedsat_funktionsevne_eller_kronisk_sygdom = Sandt,
    særlige_udgifter_til_befordring = Sandt,
    offentlig_befordring_kan_anvendes = Sandt,
    billigste_offentlige_befordring_kroner = 3000,
    befordringsudgifter = Ligningslov9DBefordringsudgifter(
        årlige_kilometer_egen_befordring = 0,
        dokumenteret_faktisk_udgift_kroner = 10000,
        faktisk_udgift_opgøres_efter_erhvervssats = Falskt
    )
)
= personskat_calculate_ll9d_resultat = beregn_personskat(personskat_calculate_input_med_lønmodtager(personskat_calculate_lønmodtager_med_befordring(personskat_calculate_befordringsfakta(Falskt, MedLigningslov9D(input = personskat_calculate_ll9d_input)))))
= personskat_calculate_ll9d_forkert_år_input = Ligningslov9DInput(
    skatteår = 2025,
    befordringsformål = Par9DArbejdsplads,
    godtgjort_varigt_nedsat_funktionsevne_eller_kronisk_sygdom = Sandt,
    særlige_udgifter_til_befordring = Sandt,
    offentlig_befordring_kan_anvendes = Sandt,
    billigste_offentlige_befordring_kroner = 3000,
    befordringsudgifter = Ligningslov9DBefordringsudgifter(
        årlige_kilometer_egen_befordring = 0,
        dokumenteret_faktisk_udgift_kroner = 10000,
        faktisk_udgift_opgøres_efter_erhvervssats = Falskt
    )
)
= personskat_calculate_ll9d_forkert_år_resultat = beregn_personskat(personskat_calculate_input_med_lønmodtager(personskat_calculate_lønmodtager_med_befordring(personskat_calculate_befordringsfakta(Falskt, MedLigningslov9D(input = personskat_calculate_ll9d_forkert_år_input)))))

= personskat_calculate_ordinær_position = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-ORDINÆR-1",
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    anskaffelsessum_kroner = 10000
)
= personskat_calculate_ordinær_afståelse = AblOrdinærAfståelse(
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    afståelsessum_kroner = 15000,
    vilkår = AktieavanceOrdinærAfståelsesvilkår(
        markedsstatus = AblIkkeOptagetTilHandel,
        har_tidligere_været_optaget_til_handel = Falskt,
        hovedaktionæraktier = Falskt,
        afståede_aktiers_handelsværdi_kroner = 0,
        beholdte_aktiers_handelsværdi_kroner = 0,
        oplysningsstatus = AblOplystRettidigt,
        boligret = AblUdenBoligret
    )
)
= personskat_calculate_ordinært_aktieår = AktieavanceOrdinærPersonÅrsinput(
    indkomstår = 2026,
    hændelsesforløb = [
        AktieavanceOrdinærHændelsesforløbInput(
            position_primo = personskat_calculate_ordinær_position,
            hændelser = [personskat_calculate_ordinær_afståelse]
        )
    ],
    investeringsbeviser = [],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
    ),
    gift_og_samlevende_ved_årets_udgang = Falskt
)
= personskat_calculate_ordinær_aktie_resultat = beregn_personskat(personskat_calculate_input_med_aktieavance(PersonskatAktieavanceInput(
    ordinært_aktieår = MedOrdinærtAktieår(input = personskat_calculate_ordinært_aktieår),
    særlige_aktiver = []
)))
= personskat_calculate_boligret_afståelse = AblOrdinærAfståelse(
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    afståelsessum_kroner = 15000,
    vilkår = AktieavanceOrdinærAfståelsesvilkår(
        markedsstatus = AblIkkeOptagetTilHandel,
        har_tidligere_været_optaget_til_handel = Falskt,
        hovedaktionæraktier = Falskt,
        afståede_aktiers_handelsværdi_kroner = 0,
        beholdte_aktiers_handelsværdi_kroner = 0,
        oplysningsstatus = AblOplystRettidigt,
        boligret = AblBoligretEfterPar15(
            fakta = EblPar8Stk4VærdipapirFakta(
                værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
                udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Sandt,
                lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Sandt,
                grundforhold = EblPar8Stk4UdenBestemtGrundareal
            ),
            afståelsesform = AblPar15AlmindeligAfståelse
        )
    )
)
= personskat_calculate_boligret_aktieår = AktieavanceOrdinærPersonÅrsinput(
    indkomstår = 2026,
    hændelsesforløb = [
        AktieavanceOrdinærHændelsesforløbInput(
            position_primo = personskat_calculate_ordinær_position,
            hændelser = [personskat_calculate_boligret_afståelse]
        )
    ],
