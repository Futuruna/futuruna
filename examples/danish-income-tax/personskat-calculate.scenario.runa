@ sprog da

@ importer ./personskat.calculate

----
Regressionsscenarie for den maskinlæsbare beregningsgrænse.

Scenariet er ikke lovtekst. Det fastholder, at den samme typede PersonskatInput,
som kan udfyldes gennem JSON, TOML eller XLSX, går gennem beregn_personskat og
giver samme resultat som den øvrige lønmodtagermodel. Standardvarianterne gør
særlige skatte-, underskuds- og årsopgørelsesfelter valgfrie.
----

= personskat_calculate_lønmodtager = PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = personskat_ingen_ligningsfradrag(),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
= personskat_calculate_input = PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
= personskat_calculate_resultat = beregn_personskat(personskat_calculate_input)

| personskat_calculate_input_med_aktieavance(aktieavance: PersonskatAktieavanceInput) -> PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = aktieavance,
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_input_med_kapitalindkomst(kapitalindkomst: PersonskatKapitalindkomstInput) -> PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = kapitalindkomst,
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_input_med_lønmodtager(lønmodtager: PersonskatLønmodtagerInput) -> PersonskatInput(
    lønmodtager = lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    udenlandske_sociale_bidrag = personskat_ingen_udenlandske_sociale_bidrag(),
    cfc = personskat_ingen_cfc(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    ægtefælle = UdenÆgtefælle,
    ejendomsskatter = ejendomsskattelov_ingen_person_årsfakta(),
    negativ_aktieskat_fremførsel = personskat_ingen_fremført_negativ_aktieskat(),
    ligningslov33 = personskat_uden_ligningslov33(),
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_befordringsfakta(arbejdsgiverbetalt_befordring: PersonskatArbejdsgiverbetaltBefordring, ligningslov9d: PersonskatLigningslov9DInput) -> PersonskatBefordringsfradragFakta(
    identifikation = "beregning-befordring",
    befordringsmål_identifikation = "beregning-arbejde",
    arbejdsdage = 203,
    daglige_befordringskilometer = 60,
    bopæl_i_yderkommune_eller_lille_ø = Falskt,
    befordringsformål = IndtægtsgivendeArbejdsplads,
    modtaget_skattefri_befordringsgodtgørelse_for_strækning = Falskt,
    modtaget_uddannelsesbefordringsrabat_eller_godtgørelse_for_strækning = Falskt,
    ligningslov9d = ligningslov9d,
    fradrag_udelukket_folketingshverv_m_v = Falskt,
    arbejdsgiverbetalt_befordring = arbejdsgiverbetalt_befordring,
    broer = ll9c_ingen_bropassager(),
    særlig_transport = ll9c_ingen_særlig_transport()
)
| personskat_calculate_lønmodtager_med_befordring(fakta: PersonskatBefordringsfradragFakta) -> PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    personlig_indkomst = personskat_ingen_personlig_indkomst(),
    erhvervsbefordring = personskat_ingen_erhvervsbefordring(),
    ligningsfradrag = PersonskatLigningsfradragInput(
        sømandsfradrag = sømandsbeskatningslov3_intet_årsinput(),
        sømandsbeskatningslov4 = sømandsbeskatningslov4_intet_årsinput(),
        fiskerfradrag = ligningslov9g_intet_årsinput(),
        øvrige_lønmodtagerudgifter = ligningslov9_stk1_intet_årsinput(),
        befordring = PersonskatBefordringsfradragInput(forhold = [fakta]),
        rejser = ligningslov9a_intet_årsinput(),
        faglige_kontingenter = Ligningslov13Årsinput(skatteyderstatus = Ll13Lønmodtager, kontingenter = []),
        arbejdsløshed_efterløn_og_fleksydelse = Pbl49Til49BÅrsinput(skattepligtsposition = Pbl49FuldtSkattepligtigOgHjemmehørendeIDanmark, bidrag = []),
        gaver = LigningslovGaveÅrsinput(gaver = [])
    ),
    pension = personskat_ingen_pension(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)

= personskat_calculate_ll6_input = Ligningslov6KurstabInput(
    indkomstår = 2026,
    kontantlån_optaget_i_realkreditinstitut_før_19_maj_1993 = Sandt,
    indfrielse_sker_ved_realkreditlån = Sandt,
    nyt_lån_optaget_før_1_januar_1996 = Sandt,
    nyt_lån_mindst_samme_løbetid = Sandt,
    transaktioner_inden_for_1_år = Sandt,
    lånetilbud_før_indfrielse_hvis_indfrielse_før_optagelse = Sandt,
    kurstab_kroner = 24000,
    samlet_antal_terminer = 12,
    forfaldne_terminer_i_indkomståret = 1,
    ekstraordinær_indfrielse_af_nyt_lån = Falskt,
    stk4_omlægning_undtager_stk3 = Falskt,
    stk3_nedsættelse_basispoint = 0,
    debitorskifte_i_året = Falskt,
    debitordage_for_skattepligtig = 0,
    dage_i_overdragelsesår = 0,
    kurstab_medregnes_efter_kursgevinstloven = Falskt
)
= personskat_calculate_ll6a_input = Ligningslov6AInput(
    indkomstår = 2026,
    skattepligtig_person = Sandt,
    arbejderboliger_beløb_kroner = 1000,
    arbejderboliger_betalt = Sandt,
    statshusmandsbrug_jordrente_beløb_kroner = 0,
    statshusmandsbrug_jordrente_betalt = Falskt
)
= personskat_calculate_rente_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = MedLigningslov6Kurstab(input = personskat_calculate_ll6_input),
        ligningslov6a = MedLigningslov6AFradrag(input = personskat_calculate_ll6a_input)
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = [
        PersonskatKapitalomkostningInput(
            identifikation = "dokumenteret-kapitalomkostning-1",
            anvendelsesår = 2026,
            anvendelse = Par4Stk2ErhverveKapitalindkomst,
            omkostningsart = Ll17CAndenOmkostning,
            næringsstatus = IkkeNæring,
            beløb_kroner = 2000
        )
    ]
)))
= personskat_calculate_finansieringsnæring_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = FinansieringsNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = [
        PersonskatKapitalomkostningInput(
            identifikation = "finansieringsomkostning",
            anvendelsesår = 2026,
            anvendelse = Par4Stk2VedligeholdeKapitalindkomst,
            omkostningsart = Ll17CAndenOmkostning,
            næringsstatus = FinansieringsNæring,
            beløb_kroner = 3000
        )
    ]
)))
= personskat_calculate_depotgebyr_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = [
        PersonskatKapitalomkostningInput(
            identifikation = "depotgebyr-1",
            anvendelsesår = 2026,
            anvendelse = Par4Stk2VedligeholdeKapitalindkomst,
            omkostningsart = Ll17CDepotgebyr,
            næringsstatus = IkkeNæring,
            beløb_kroner = 2000
        )
    ]
)))
= personskat_calculate_ugyldig_kapitalomkostning_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = [
        PersonskatKapitalomkostningInput(
            identifikation = "ugyldigt-anvendelsesår-1",
            anvendelsesår = 0,
            anvendelse = Par4Stk2ErhverveKapitalindkomst,
            omkostningsart = Ll17CAndenOmkostning,
            næringsstatus = IkkeNæring,
            beløb_kroner = 2000
        )
    ]
)))
= personskat_calculate_ll6_forkert_år = Ligningslov6KurstabInput(
    indkomstår = 2025,
    kontantlån_optaget_i_realkreditinstitut_før_19_maj_1993 = Sandt,
    indfrielse_sker_ved_realkreditlån = Sandt,
    nyt_lån_optaget_før_1_januar_1996 = Sandt,
    nyt_lån_mindst_samme_løbetid = Sandt,
    transaktioner_inden_for_1_år = Sandt,
    lånetilbud_før_indfrielse_hvis_indfrielse_før_optagelse = Sandt,
    kurstab_kroner = 24000,
    samlet_antal_terminer = 12,
    forfaldne_terminer_i_indkomståret = 1,
    ekstraordinær_indfrielse_af_nyt_lån = Falskt,
    stk4_omlægning_undtager_stk3 = Falskt,
    stk3_nedsættelse_basispoint = 0,
    debitorskifte_i_året = Falskt,
    debitordage_for_skattepligtig = 0,
    dage_i_overdragelsesår = 0,
    kurstab_medregnes_efter_kursgevinstloven = Falskt
)
= personskat_calculate_ll6_forkert_år_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = MedLigningslov6Kurstab(input = personskat_calculate_ll6_forkert_år),
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = UdenFremlejeEfterLigningslov15Q,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = []
)))

| personskat_calculate_kapitalindkomst_med_fremleje(fremleje: PersonskatFremlejeInput) -> PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 0,
        renteudgifter_kroner = 0,
        næringsstatus = IkkeNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    virksomhedskapital = personskat_ingen_virksomhedskapital(),
    pbl53a = personskat_ingen_pbl53a(),
    ejendomsdrift = UdenEjendomsdriftEfterPar4Nr6,
    ejendomsavance = UdenEjendomsavance,
    kursgevinst = UdenKursgevinst,
    fremleje = fremleje,
    finansielle_poster = [],
    særlige_kapitalposter = [],
    omkostninger = []
)
| personskat_calculate_fremlejefakta(bruttolejeindtægt_kroner: Heltal, tidligere_anvendt_par15p_stk3: Boolsk, stk4_samordning: PersonskatLigningslov15QStk4Input) -> PersonskatFremlejeFakta(
    rolle = PersonskatFremlejendeLejer,
    udlejningsform = Ll15QVærelserIHelårsbolig,
    boligstatus = Ll15QHelårsbolig,
    indberetningsstatus = Ll15QIndberettetEfterSkatteindberetningslov43,
    metode = Ll15QStk1Bundfradrag,
    bruttolejeindtægt_kroner = bruttolejeindtægt_kroner,
    faktiske_udgifter_kroner = 0,
    tidligere_anvendt_par15p_stk3 = tidligere_anvendt_par15p_stk3,
    stk4_samordning = stk4_samordning
)
| personskat_calculate_med_fremleje(fakta: PersonskatFremlejeFakta) -> beregn_personskat(personskat_calculate_input_med_kapitalindkomst(personskat_calculate_kapitalindkomst_med_fremleje(MedFremlejeEfterLigningslov15Q(fakta = fakta))))

= personskat_calculate_fremleje_resultat = personskat_calculate_med_fremleje(personskat_calculate_fremlejefakta(
    bruttolejeindtægt_kroner = 60000,
    tidligere_anvendt_par15p_stk3 = Falskt,
    stk4_samordning = UdenSamordningMedLigningslov15P
))
= personskat_calculate_fremleje_stk4_resultat = personskat_calculate_med_fremleje(personskat_calculate_fremlejefakta(
    bruttolejeindtægt_kroner = 32500,
    tidligere_anvendt_par15p_stk3 = Falskt,
    stk4_samordning = MedSamordningMedLigningslov15P(
        par15q_udlejningsdage = 65,
        par15p_fakta = PersonskatLigningslov15PSamordningsfakta(
            udlejningsform = Ll15PHeleBoligen,
            bruttolejeindtægt_kroner = 300000,
            årlig_leje_eller_boligafgift_kroner = 60000,
            samme_personer_mindst_fire_måneder = Sandt,
            lejet_eller_ejet_dage = 365,
            udlejningsdage = 300
        ),
        loftvalg = Ll15QStk4BevarPar15QAndel
    )
))
= personskat_calculate_fremleje_tidligere_par15p_stk3_resultat = personskat_calculate_med_fremleje(personskat_calculate_fremlejefakta(
    bruttolejeindtægt_kroner = 60000,
    tidligere_anvendt_par15p_stk3 = Sandt,
    stk4_samordning = UdenSamordningMedLigningslov15P
))

| personskat_calculate_ejendomsavancefakta_med_par5(identifikation: Tekst, anskaffelsessum_kroner: Heltal, afståelsessum_kroner: Heltal, ejendomstype: EjendomsavanceEjendomstype, par5_fakta: EblPar5Fakta) -> PersonskatEjendomsavanceFakta(
    identifikation = identifikation,
    afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = anskaffelsessum_kroner,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = par5_fakta,
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = afståelsessum_kroner,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = ejendomstype,
    par11_stk2_valg = EblPar11Stk2IngenNyGenanbringelse,
    par6d_valg = EblUdenPar6DValg
)
| personskat_calculate_ejendomsavancefakta(identifikation: Tekst, anskaffelsessum_kroner: Heltal, afståelsessum_kroner: Heltal, ejendomstype: EjendomsavanceEjendomstype) -> personskat_calculate_ejendomsavancefakta_med_par5(
    identifikation = identifikation,
    anskaffelsessum_kroner = anskaffelsessum_kroner,
    afståelsessum_kroner = afståelsessum_kroner,
    ejendomstype = ejendomstype,
    par5_fakta = ebl_par5_standardfakta(EblDato(år = 2026, måned = 1, dag = 1), EblPar4AlmindeligtAnskaffelsesgrundlag)
)
| personskat_calculate_par6a_fakta(erhvervsfortjeneste_kroner: Heltal) -> EblPar6AFakta(
    oprindelig_fortjeneste = EblOprindeligErhvervsfortjeneste(
        afståelsesindkomstår = 2025,
        erhvervsfortjeneste_før_par6_stk2_kroner = erhvervsfortjeneste_kroner,
        regulering = EblGenanbragtFortjenesteregulering(
            tillæg_for_genanbragt_del_kroner = 0,
            nedslag_for_genanbragt_del_kroner = 0
        )
    ),
    afstået_ejendoms_erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
    investering = EblPar6AInvestering(
        indkomstår = 2026,
        erhvervsmæssigt_anskaffelsesgrundlag_kroner = 1000000,
        ejendomsstatus = EblPar6AEjendomOmfattetAfLovenIkkePar8,
        erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
        placering = EblPar6AEjendomIDanmark
    ),
    begæring = EblPar6ABegæringVedRettidigAfgivelseEfterSkattekontrollovensPar2,
    ejerskab = EblPar6ASammeSkattepligtige
)
| personskat_calculate_par6a_genanbringelse(erhvervsfortjeneste_kroner: Heltal) -> EblMedGenanbringelseEfterPar6A(
    fakta = personskat_calculate_par6a_fakta(erhvervsfortjeneste_kroner)
)
| personskat_calculate_par6c_genanbringelse(erhvervsfortjeneste_kroner: Heltal) -> EblMedGenanbringelseEfterPar6C(fakta = EblPar6CFakta(
    par6a_fakta = personskat_calculate_par6a_fakta(erhvervsfortjeneste_kroner),
    arbejdsart = EblPar6CNybygning,
    arbejde_påbegyndt = Sandt
))
