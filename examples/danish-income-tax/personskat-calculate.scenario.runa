@ sprog da

@ importer ./personskat.calculate

----
Regressionsscenarie for den maskinlæsbare beregningsgrænse.

Scenariet er ikke lovtekst. Det fastholder, at den samme typede PersonskatInput,
som kan udfyldes gennem JSON, TOML eller XLSX, går gennem beregn_personskat og
giver samme resultat som den øvrige lønmodtagermodel. Standardvarianterne gør
særlige skatte-, underskuds- og årsopgørelsesfelter valgfrie.
----

= personskat_calculate_lønmodtager = PersonskatLønmodtagerInput(
    skatteår = 2026,
    kommune = København,
    bruttoløn_kroner = 600000,
    ligningsmæssige_fradrag_kroner = 0,
    pensionsfradrag = lønmodtager_ingen_ekstra_pensionsfradrag(),
    personfradrag_alder_status = Fyldt18EllerGift,
    betaler_kirkeskat = Falskt
)
= personskat_calculate_input = PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
= personskat_calculate_resultat = beregn_personskat(personskat_calculate_input)

| personskat_calculate_input_med_aktieavance(aktieavance: PersonskatAktieavanceInput) -> PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = aktieavance,
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)
| personskat_calculate_input_med_kapitalindkomst(kapitalindkomst: PersonskatKapitalindkomstInput) -> PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = kapitalindkomst,
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = UdenÅrsopgørelse
)

= personskat_calculate_ll6_input = Ligningslov6KurstabInput(
    indkomstår = 2026,
    kontantlån_optaget_i_realkreditinstitut_før_19_maj_1993 = Sandt,
    indfrielse_sker_ved_realkreditlån = Sandt,
    nyt_lån_optaget_før_1_januar_1996 = Sandt,
    nyt_lån_mindst_samme_løbetid = Sandt,
    transaktioner_inden_for_1_år = Sandt,
    lånetilbud_før_indfrielse_hvis_indfrielse_før_optagelse = Sandt,
    kurstab_kroner = 24000,
    samlet_antal_terminer = 12,
    forfaldne_terminer_i_indkomståret = 1,
    ekstraordinær_indfrielse_af_nyt_lån = Falskt,
    stk4_omlægning_undtager_stk3 = Falskt,
    stk3_nedsættelse_basispoint = 0,
    debitorskifte_i_året = Falskt,
    debitordage_for_skattepligtig = 0,
    dage_i_overdragelsesår = 0,
    kurstab_medregnes_efter_kursgevinstloven = Falskt
)
= personskat_calculate_ll6a_input = Ligningslov6AInput(
    indkomstår = 2026,
    skattepligtig_person = Sandt,
    arbejderboliger_beløb_kroner = 1000,
    arbejderboliger_betalt = Sandt,
    statshusmandsbrug_jordrente_beløb_kroner = 0,
    statshusmandsbrug_jordrente_betalt = Falskt
)
= personskat_calculate_rente_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = MedLigningslov6Kurstab(input = personskat_calculate_ll6_input),
        ligningslov6a = MedLigningslov6AFradrag(input = personskat_calculate_ll6a_input)
    ),
    omkostninger = [
        PersonskatKapitalomkostningInput(identifikation = "bankgebyr", beløb_kroner = 2000)
    ]
)))
= personskat_calculate_finansieringsnæring_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = FinansieringsNæring,
        ligningslov6 = UdenLigningslov6Kurstab,
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    omkostninger = [
        PersonskatKapitalomkostningInput(identifikation = "finansieringsomkostning", beløb_kroner = 3000)
    ]
)))
= personskat_calculate_ll6_forkert_år = Ligningslov6KurstabInput(
    indkomstår = 2025,
    kontantlån_optaget_i_realkreditinstitut_før_19_maj_1993 = Sandt,
    indfrielse_sker_ved_realkreditlån = Sandt,
    nyt_lån_optaget_før_1_januar_1996 = Sandt,
    nyt_lån_mindst_samme_løbetid = Sandt,
    transaktioner_inden_for_1_år = Sandt,
    lånetilbud_før_indfrielse_hvis_indfrielse_før_optagelse = Sandt,
    kurstab_kroner = 24000,
    samlet_antal_terminer = 12,
    forfaldne_terminer_i_indkomståret = 1,
    ekstraordinær_indfrielse_af_nyt_lån = Falskt,
    stk4_omlægning_undtager_stk3 = Falskt,
    stk3_nedsættelse_basispoint = 0,
    debitorskifte_i_året = Falskt,
    debitordage_for_skattepligtig = 0,
    dage_i_overdragelsesår = 0,
    kurstab_medregnes_efter_kursgevinstloven = Falskt
)
= personskat_calculate_ll6_forkert_år_resultat = beregn_personskat(personskat_calculate_input_med_kapitalindkomst(PersonskatKapitalindkomstInput(
    renter = PersonskatRenteInput(
        renteindtægter_kroner = 20000,
        renteudgifter_kroner = 5000,
        næringsstatus = IkkeNæring,
        ligningslov6 = MedLigningslov6Kurstab(input = personskat_calculate_ll6_forkert_år),
        ligningslov6a = UdenLigningslov6AFradrag
    ),
    omkostninger = []
)))

= personskat_calculate_ordinær_position = AktieavanceOrdinærPosition(
    selskabsidentifikation = "DK-ORDINÆR-1",
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    anskaffelsessum_kroner = 10000
)
= personskat_calculate_ordinær_afståelse = AblOrdinærAfståelse(
    kapitalmængde = AblAktiekapitalUdenPålydendeVærdi(antal_aktier = 10),
    afståelsessum_kroner = 15000,
    vilkår = AktieavanceOrdinærAfståelsesvilkår(
        markedsstatus = AblIkkeOptagetTilHandel,
        har_tidligere_været_optaget_til_handel = Falskt,
        hovedaktionæraktier = Falskt,
        afståede_aktiers_handelsværdi_kroner = 0,
        beholdte_aktiers_handelsværdi_kroner = 0,
        oplysningsstatus = AblOplystRettidigt,
        boligret = AktieavanceOrdinærBoligretInput(
            forbundet_med_brugsret_til_beboelseslejlighed = Falskt,
            beboelseskrav_opfyldt = Falskt,
            likvidationsprovenu = Falskt,
            udloddet_i_endeligt_opløsningsår = Falskt
        )
    )
)
= personskat_calculate_ordinært_aktieår = AktieavanceOrdinærPersonÅrsinput(
    indkomstår = 2026,
    hændelsesforløb = [
        AktieavanceOrdinærHændelsesforløbInput(
            position_primo = personskat_calculate_ordinær_position,
            hændelser = [personskat_calculate_ordinær_afståelse]
        )
    ],
    investeringsbeviser = [],
    fremført_tab_efter_par13a_kroner = 0,
    modregningsgrundlag = AktieavanceOrdinærPar13AModregningsgrundlag(
        udbytter_for_aktier_med_gevinst_efter_par12_kroner = 0,
        udbytter_og_nettogevinster_for_aktier_med_gevinst_efter_par19b_kroner = 0,
        udbytter_for_aktier_omfattet_af_par44_kroner = 0,
        ægtefælles_positive_nettobeløb_efter_par13a_kroner = 0
    ),
    gift_og_samlevende_ved_årets_udgang = Falskt
)
= personskat_calculate_ordinær_aktie_resultat = beregn_personskat(personskat_calculate_input_med_aktieavance(PersonskatAktieavanceInput(
    ordinært_aktieår = MedOrdinærtAktieår(input = personskat_calculate_ordinært_aktieår),
    særlige_aktiver = []
)))
= personskat_calculate_19c_kapital_resultat = beregn_personskat(personskat_calculate_input_med_aktieavance(PersonskatAktieavanceInput(
    ordinært_aktieår = UdenOrdinærtAktieår,
    særlige_aktiver = [abl19c_kapital_input]
)))
= personskat_calculate_19c_personlig_resultat = beregn_personskat(personskat_calculate_input_med_aktieavance(PersonskatAktieavanceInput(
    ordinært_aktieår = UdenOrdinærtAktieår,
    særlige_aktiver = [abl19c_hvis17_input]
)))
= personskat_calculate_ugyldig_22_input = AktieavancebeskatningslovInput(
    indkomstår = 2026,
    aktiv = AblMinimumsbevis22,
    afståelsessum_kroner = 15000,
    anskaffelsessum_kroner = 10000,
    par17_modprøve = AktieavancePar17Modprøve(
        næringsstatus = AblPar17UdøverIkkeNæringVedKøbOgSalgAfAktier,
        erhvervelsesstatus = AblPar17IkkeErhvervetSomLedINæringsvej
    ),
    koncernintern_konvertibel_eller_tegningsret = Falskt,
    andelsforening_stiftet_før_22_maj_1987 = Falskt,
    afståelse_sker_for_at_undgå_likvidationsbeskatning = Falskt,
    investeringsklassifikation = AblIngenInvesteringsklassifikation,
    årets_netto_med_kgl_par14_23_kroner = 5000
)
= personskat_calculate_ugyldig_resultat = beregn_personskat(personskat_calculate_input_med_aktieavance(PersonskatAktieavanceInput(
    ordinært_aktieår = UdenOrdinærtAktieår,
    særlige_aktiver = [personskat_calculate_ugyldig_22_input]
)))

= personskat_calculate_med_årsopgørelse_input = PersonskatInput(
    lønmodtager = personskat_calculate_lønmodtager,
    kapitalindkomst = personskat_ingen_kapitalindkomst(),
    aktieavance = personskat_ingen_aktieavance(),
    skatteforhold = StandardSkatteforhold,
    underskudsforhold = StandardUnderskudsforhold,
    årsopgørelse = MedÅrsopgørelse(
        overført_restskat_mv_kroner = 1000,
        pensionsbeskatningsafgift_kroner = 500,
        kreditter = KildeskatPar60Kreditter(
            a_skat_og_am_indeholdt_kroner = 0,
            par68_indbetalt_kroner = 0,
            b_skat_betalt_kroner = 0,
            udbytteskat_modregningsberettiget_kroner = 0,
            frivillig_indbetaling_par59_kroner = 0,
            virksomhedsordning_beløb_kroner = 0,
            personskattelov_par8a_stk5_beløb_kroner = 0,
            afskrivningslov_acontoskat_kroner = 0,
            am_lov_par6_beløb_kroner = 0,
            seniornedslag_kroner = 0,
            energiafgiftskompensation_kroner = 0,
            tilbagebetalt_par55_kroner = 0
        )
    )
)
= personskat_calculate_med_årsopgørelse_resultat = beregn_personskat(personskat_calculate_med_årsopgørelse_input)

| personskat_calculate_am_bidrag: personskat_calculate_resultat -> personskat_calculate_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_personfradrag: personskat_calculate_resultat -> personskat_calculate_resultat.skat.personfradrag_kroner == 54100
| personskat_calculate_samlet_skat: personskat_calculate_resultat -> personskat_calculate_resultat.skat.samlet_inkl_am_efter_personfradrag_kroner == 208726
| personskat_calculate_renter_og_ll_fradrag_afledes: personskat_calculate_rente_resultat -> personskat_calculate_rente_resultat.kapitalindkomst.alle_input_gyldige && personskat_calculate_rente_resultat.kapitalindkomst.ligningslov6_resultat.fradrag_kroner == 2000 && personskat_calculate_rente_resultat.kapitalindkomst.ligningslov6a_resultat.fradrag_kroner == 1000 && personskat_calculate_rente_resultat.kapitalindkomst.rente_resultat.kapitalindkomst_kroner == 12000 && personskat_calculate_rente_resultat.kapitalindkomst.kapitalindkomst_resultat.fradragsberettigede_omkostninger_kroner == 2000 && personskat_calculate_rente_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 10000 && personskat_calculate_rente_resultat.skat.nettokapitalindkomst_kroner == 10000 && personskat_calculate_rente_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_finansieringsnæring_reklassificeres: personskat_calculate_finansieringsnæring_resultat -> personskat_calculate_finansieringsnæring_resultat.kapitalindkomst.alle_input_gyldige && personskat_calculate_finansieringsnæring_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 0 && personskat_calculate_finansieringsnæring_resultat.kapitalindkomst.kapitalindkomst_resultat.omklassificerede_personlige_omkostninger_kroner == 3000 && personskat_calculate_finansieringsnæring_resultat.kapitalindkomst.kapitalindkomst_resultat.omklassificeret_personlig_indkomst_kroner == 12000 && personskat_calculate_finansieringsnæring_resultat.skat.øvrig_personlig_indkomst_kroner == 12000 && personskat_calculate_finansieringsnæring_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_ll6_forkert_år_afvises: personskat_calculate_ll6_forkert_år_resultat -> personskat_calculate_ll6_forkert_år_resultat.kapitalindkomst.ligningslov6_input_gyldigt == Falskt && personskat_calculate_ll6_forkert_år_resultat.kapitalindkomst.alle_input_gyldige == Falskt && personskat_calculate_ll6_forkert_år_resultat.kapitalindkomst.ligningslov6_resultat.fradrag_kroner == 2000 && personskat_calculate_ll6_forkert_år_resultat.kapitalindkomst.rente_resultat.ligningslov6_fradrag_kroner == 0 && personskat_calculate_ll6_forkert_år_resultat.kapitalindkomst.kapitalindkomst_resultat.nettokapitalindkomst_kroner == 15000 && personskat_calculate_ll6_forkert_år_resultat.skat.nettokapitalindkomst_kroner == 15000
| personskat_calculate_ordinær_aktieavance_afledes: personskat_calculate_ordinær_aktie_resultat -> personskat_calculate_ordinær_aktie_resultat.aktieavance.alle_input_gyldige && personskat_calculate_ordinær_aktie_resultat.aktieavance.aktieindkomst_kroner == 5000 && personskat_calculate_ordinær_aktie_resultat.aktieavance.kapitalindkomst_kroner == 0 && personskat_calculate_ordinær_aktie_resultat.aktieavance.personlig_indkomst_kroner == 0 && personskat_calculate_ordinær_aktie_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_19c_kapital_afledes: personskat_calculate_19c_kapital_resultat -> personskat_calculate_19c_kapital_resultat.aktieavance.alle_input_gyldige && personskat_calculate_19c_kapital_resultat.aktieavance.kapitalindkomst_kroner == 12000 && personskat_calculate_19c_kapital_resultat.skat.nettokapitalindkomst_kroner == 12000 && personskat_calculate_19c_kapital_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_19c_personlig_afledes_uden_am: personskat_calculate_19c_personlig_resultat -> personskat_calculate_19c_personlig_resultat.aktieavance.alle_input_gyldige && personskat_calculate_19c_personlig_resultat.aktieavance.personlig_indkomst_kroner == 7000 && personskat_calculate_19c_personlig_resultat.skat.øvrig_personlig_indkomst_kroner == 7000 && personskat_calculate_19c_personlig_resultat.skat.personlig_indkomst_efter_am_kroner == 559000 && personskat_calculate_19c_personlig_resultat.skat.arbejdsmarkedsbidrag_kroner == 48000
| personskat_calculate_ugyldig_abl_kæde_afvises_samlet: personskat_calculate_ugyldig_resultat -> personskat_calculate_ugyldig_resultat.aktieavance.alle_input_gyldige == Falskt && personskat_calculate_ugyldig_resultat.aktieavance.personlig_indkomst_kroner == 0 && personskat_calculate_ugyldig_resultat.aktieavance.kapitalindkomst_kroner == 0 && personskat_calculate_ugyldig_resultat.aktieavance.aktieindkomst_kroner == 0 && personskat_calculate_ugyldig_resultat.skat.samlet_inkl_am_efter_personfradrag_kroner == 208726
| personskat_calculate_årsopgørelse_valgfri: personskat_calculate_resultat -> personskat_calculate_resultat.årsopgørelse == IngenÅrsopgørelse
| personskat_calculate_årsopgørelse_beregnes: personskat_calculate_med_årsopgørelse_resultat -> match personskat_calculate_med_årsopgørelse_resultat.årsopgørelse {
    | IngenÅrsopgørelse -> Falskt
    | BeregnetÅrsopgørelse(årsopgørelsesinput, årsopgørelsesresultat) -> årsopgørelsesinput.slutskat_kroner == 208726 && årsopgørelsesresultat.slutskat_med_tillæg_kroner == 210226 && årsopgørelsesresultat.restskat_kroner == 210226 && årsopgørelsesresultat.art == Restskat
}

? personskat_calculate_am_bidrag
? personskat_calculate_personfradrag
? personskat_calculate_samlet_skat
? personskat_calculate_renter_og_ll_fradrag_afledes
? personskat_calculate_finansieringsnæring_reklassificeres
? personskat_calculate_ll6_forkert_år_afvises
? personskat_calculate_ordinær_aktieavance_afledes
? personskat_calculate_19c_kapital_afledes
? personskat_calculate_19c_personlig_afledes_uden_am
? personskat_calculate_ugyldig_abl_kæde_afvises_samlet
? personskat_calculate_årsopgørelse_valgfri
? personskat_calculate_årsopgørelse_beregnes
