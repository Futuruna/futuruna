    afholdelsesår = 2026,
    rettighed = Al42Ejer,
    ombygnings_og_forbedringsudgift_kroner = 16900,
    eksisterende_bygning_i_landbrugsejendom = Sandt,
    værelser_anvendes_til_turistudlejning = Sandt,
    landbrugsejendommen_er_erhvervsmæssigt_drevet = Sandt,
    momspligtig_udlejning = Sandt,
    tidligere_afskrivninger = []
)
= al42_straks = afskrivningslov42_års_resultat(Afskrivningslov42ÅrsInput(
