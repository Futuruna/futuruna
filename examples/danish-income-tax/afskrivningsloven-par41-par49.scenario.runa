@ sprog da

@ importer ./afskrivningsloven

-- Fokuserede scenarier for Afskrivningslovens §§ 41-49. Den ordrette
-- lovtekst og de maskinlæsbare kildeankre står i afskrivningsloven.runa.

= al42_position = Afskrivningslov42Position(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    afholdelsesår = 2025,
    rettighed = Al42Forpagter,
    ombygnings_og_forbedringsudgift_kroner = 100000,
    eksisterende_bygning_i_landbrugsejendom = Sandt,
    værelser_anvendes_til_turistudlejning = Sandt,
    landbrugsejendommen_er_erhvervsmæssigt_drevet = Sandt,
    momspligtig_udlejning = Sandt,
    tidligere_afskrivninger = [AfskrivningslovÅrsafskrivning(indkomstår = 2025, afskrivning_kroner = 20000)]
)
= al42_indtægtsbegrænset = afskrivningslov42_års_resultat(Afskrivningslov42ÅrsInput(
    indkomstår = 2026,
    position = al42_position,
    årets_skattepligtige_udlejningsindtægt_kroner = 15000,
    valg = AlSærligOrdinærAfskrivning(valgt_beløb_kroner = 15000)
))
= al42_for_højt_valg = afskrivningslov42_års_resultat(Afskrivningslov42ÅrsInput(
    indkomstår = 2026,
    position = al42_position,
    årets_skattepligtige_udlejningsindtægt_kroner = 15000,
    valg = AlSærligOrdinærAfskrivning(valgt_beløb_kroner = 20000)
))
= al42_straks_position = Afskrivningslov42Position(
