    position = al42_straks_position,
    årets_skattepligtige_udlejningsindtægt_kroner = 20000,
    valg = AlSærligStraksafskrivning
))
= al42_salg = afskrivningslov42_afståelses_resultat(Afskrivningslov42AfståelsesInput(
