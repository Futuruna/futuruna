    position = al42_position,
    afståelsessum_henført_til_ombygning_og_forbedring_kroner = 90000,
    forlods_afskrivninger_kroner = 10000
))

= al43_position = Afskrivningslov43Position(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    forfaldsår = 2025,
    tilslutningsafgift_kroner = 100000,
    engangsudgift = Sandt,
