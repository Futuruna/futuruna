))
= al44a_salg = afskrivningslov44a_afståelses_resultat(Afskrivningslov44AAfståelsesInput(
    indkomstår = 2026,
    position = al44a_position,
    hændelse = Al44AFjernetFraBygningEllerNæreOmgivelser,
    afståelsessum_eller_handelsværdi_kroner = 90000,
    kontrol = Afskrivningslov21Kontrol(sælgerne_er_en_eller_flere_personer = Falskt, køber_er_selskab_mv = Falskt, kapitalandel_basispoint = 0, stemmerettigheder_basispoint = 0, anden_bestemmende_indflydelse = Falskt)
))
= al44a_skade = afskrivningslov44a_skade_resultat(Afskrivningslov44ASkadeInput(
