    position = al43_position,
    tilsluttet_aktiv_solgt = Sandt,
    samlet_afståelsessum_for_aktivet_før_tilslutningsværdi_kroner = 900000,
    del_af_afståelsessum_henført_til_tilslutningsværdi_kroner = 50000
))

= al44_resultat = afskrivningslov44_resultat(Afskrivningslov44Input(
    indkomstår = 2026,
    anskaffelsesår = 2026,
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    afskrivningsberettiget_aktiv = Sandt,
    anskaffelsesudgift_kroner = 100000,
    tilskudsbetalinger = [
        Afskrivningslov44Tilskudsbetaling(kategori = Al44Landdistriktsfonden, betalt_til_anskaffelsesudgiften_kroner = 50000),
        Afskrivningslov44Tilskudsbetaling(kategori = Al44HavOgFiskerifondenEndeligtFartøjsophør, betalt_til_anskaffelsesudgiften_kroner = 30000)
    ],
    valgt_straksafskrivning_kroner = 50000
))

= al44a_position = Afskrivningslov44APosition(
    skatteyder = AlSelvstændigErhvervsdrivendePerson,
    identifikation = "integreret-kunst-1",
    anskaffelsesår = 2022,
    anskaffelsessum_kroner = 100000,
    afskrivningsgrundlag_kroner = 100000,
    bygningsdel = Al44AErhvervsbygning,
    placering = Al44AIndføjetIBygningen,
    anskaffelsesmåde = Al44AFørstegangskøbAfOriginalBilledkunst,
    kunststatus = Al44AKunstKvalificeret,
    skatteyder_nærtstående_til_kunstneren = Falskt,
    kunstner_eller_nærtstående_har_bestemmende_indflydelse = Falskt,
    kan_afskrives_efter_anden_bestemmelse = Falskt,
    tidligere_afskrivninger = [AfskrivningslovÅrsafskrivning(indkomstår = 2022, afskrivning_kroner = 20000)]
)
= al44a_årsresultat = afskrivningslov44a_års_resultat(Afskrivningslov44AÅrsInput(
