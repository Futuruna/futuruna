)
= al43_årsresultat = afskrivningslov43_års_resultat(Afskrivningslov43ÅrsInput(
    indkomstår = 2026,
    position = al43_position,
    valg = AlSærligOrdinærAfskrivning(valgt_beløb_kroner = 10000)
))
= al43_salg = afskrivningslov43_salg_resultat(Afskrivningslov43SalgInput(
