@ sprog da

@ importer ./ejendomsavancebeskatningsloven

--@label:ebl_par5_par9_konsistensaudit::source:ebl_par5_lbk132::source:ebl_par8_par9_lbk132::source:ebl_genanbringelse_lbk132::amendment_source:ebl_genanbringelse_lov308--
--@begin:ebl_par5_par9_konsistensaudit--
| ebl_audit_par5_fakta(særforhold: EblPar5Særforhold, reguleringsvalg: EblPar5Reguleringsvalg) -> EblPar5Fakta(
    anskaffelsesdato = EblDato(år = 2020, måned = 1, dag = 1),
    anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag,
    forholdsmæssig_andel_promille = 1000,
    vedligeholdelses_og_forbedringsudgifter = [],
    nedsættelser = [],
    særforhold = særforhold,
    reguleringsvalg = reguleringsvalg
)

= ebl_audit_par5_resultater = [
    ebl_par5_resultat(
        ebl_audit_par5_fakta(
            EblPar5UdenMælkekvoteEllerStk6Overførsel,
            EblPar5UdenIndeksering
        ),
        EblDato(år = 2026, måned = 12, dag = 31),
        1000000
    ),
    ebl_par5_resultat(
        ebl_audit_par5_fakta(
            EblPar5MedMælkekvote,
            EblPar5UdenIndeksering
        ),
        EblDato(år = 2026, måned = 12, dag = 31),
        1000000
    ),
    ebl_par5_resultat(
        ebl_audit_par5_fakta(
            EblPar5UdenMælkekvoteEllerStk6Overførsel,
            EblPar5AMedIndeksering(kategori = EblPar5ANaturejendom)
        ),
        EblDato(år = 2026, måned = 12, dag = 31),
        1000000
    )
]

| ebl_audit_par9_fakta(bolig_anskaffelsessum_kroner: Heltal, bolig_afståelsessum_kroner: Heltal) -> EblPar9Fakta(
    kategori = EblPar9Landbrugsejendom,
    bolig_har_tjent_til_bolig_for_ejer_eller_husstand = Sandt,
    boligbetingelser_opfyldt_i_ejerperioden = Sandt,
    grundbetingelse = EblPar8GrundarealUnder1400M2,
    bolig_anskaffelsessum_kroner = bolig_anskaffelsessum_kroner,
    bolig_afståelsessum_kroner = bolig_afståelsessum_kroner,
    skadeforhold = EblPar9IngenVæsentligSkade,
    genanbringelsesforhold = EblPar9IngenGenanbringelseEfterStk4
)
| ebl_audit_par6a_fakta(erhvervsfortjeneste_kroner: Heltal) -> EblPar6AFakta(
    oprindelig_fortjeneste = EblOprindeligErhvervsfortjeneste(
        afståelsesindkomstår = 2024,
        erhvervsfortjeneste_før_par6_stk2_kroner = erhvervsfortjeneste_kroner,
        regulering = EblGenanbragtFortjenesteregulering(
            tillæg_for_genanbragt_del_kroner = 0,
            nedslag_for_genanbragt_del_kroner = 0
        )
    ),
    afstået_ejendoms_erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
    investering = EblPar6AInvestering(
        indkomstår = 2025,
        erhvervsmæssigt_anskaffelsesgrundlag_kroner = 100000,
        ejendomsstatus = EblPar6AEjendomOmfattetAfLovenIkkePar8,
        erhvervsanvendelse = EblPar6AEgenEllerSamlevendeÆgtefællesErhvervsvirksomhed,
        placering = EblPar6AEjendomIDanmark
    ),
    begæring = EblPar6ABegæringVedRettidigAfgivelseEfterSkattekontrollovensPar2,
    ejerskab = EblPar6ASammeSkattepligtige
)

= ebl_audit_par9_resultater = [
    ebl_par9_resultat(
        ebl_audit_par9_fakta(100000, 150000),
        EblDato(år = 2026, måned = 12, dag = 31),
        EblPar9Beløbsgrundlag(
            erhvervsdel_reguleret_anskaffelsessum_kroner = 200000,
            erhvervsdel_afståelsessum_kroner = 260000,
            samlet_reguleret_anskaffelsessum_kroner = 300000,
            samlet_afståelsessum_kroner = 410000
        )
    ),
    ebl_par9_resultat(
        ebl_audit_par9_fakta(50000, 20000),
        EblDato(år = 2026, måned = 12, dag = 31),
        EblPar9Beløbsgrundlag(
            erhvervsdel_reguleret_anskaffelsessum_kroner = 150000,
            erhvervsdel_afståelsessum_kroner = 80000,
            samlet_reguleret_anskaffelsessum_kroner = 200000,
            samlet_afståelsessum_kroner = 100000
        )
    )
]

= ebl_audit_par9_ikke_understøttet_genanbringelse = ebl_par9_resultat(
    EblPar9Fakta(
        kategori = EblPar9Landbrugsejendom,
        bolig_har_tjent_til_bolig_for_ejer_eller_husstand = Sandt,
        boligbetingelser_opfyldt_i_ejerperioden = Sandt,
        grundbetingelse = EblPar8GrundarealUnder1400M2,
        bolig_anskaffelsessum_kroner = 100000,
        bolig_afståelsessum_kroner = 150000,
        skadeforhold = EblPar9IngenVæsentligSkade,
        genanbringelsesforhold = EblPar9GenanbringelseEfterStk4(
            genanbringelse = EblMedGenanbringelseEfterPar10(fakta = EblPar10Fakta(
                skadedato = EblDato(år = 2024, måned = 3, dag = 1),
                erstatningssum_endeligt_fastsat_indkomstår = 2024,
                genopførelsesindkomstår = 2025,
                skadelidt_ejendom_omfattet_af_par8 = Falskt,
                erstatnings_eller_forsikringssum_ikke_skattefri_efter_par9_kroner = 500000,
                reguleret_anskaffelsessum_for_skaderamt_erhvervsdel_kroner = 300000,
                genopførelsesudgifter_kroner = 600000,
                genopførelsessted = EblPar10GenopførelsePåFlereAndreEjendomme(
                    antal_ejendomme = 2
                ),
                fristforhold = EblPar10UdenFristforlængelse,
                erhvervserstatning_anvendt_til_ejerbolig_kroner = 0,
                bygninger_afskrivningsberettigede = Falskt,
                afskrivningslov_par24_anvendt = Falskt,
                regulering = EblGenanbragtFortjenesteregulering(
                    tillæg_for_genanbragt_del_kroner = 0,
                    nedslag_for_genanbragt_del_kroner = 0
                )
            )),
            boligandel_forøget = Sandt,
            boligandel_forøget_før_15_december_2005 = Falskt
        )
    ),
    EblDato(år = 2026, måned = 12, dag = 31),
    EblPar9Beløbsgrundlag(
        erhvervsdel_reguleret_anskaffelsessum_kroner = 200000,
        erhvervsdel_afståelsessum_kroner = 260000,
        samlet_reguleret_anskaffelsessum_kroner = 300000,
        samlet_afståelsessum_kroner = 410000
    )
)

= ebl_audit_par9_stk4_uden_dobbeltbeskatning = ebl_par9_resultat(
    EblPar9Fakta(
        kategori = EblPar9Landbrugsejendom,
        bolig_har_tjent_til_bolig_for_ejer_eller_husstand = Sandt,
        boligbetingelser_opfyldt_i_ejerperioden = Sandt,
        grundbetingelse = EblPar8GrundarealUnder1400M2,
        bolig_anskaffelsessum_kroner = 100000,
        bolig_afståelsessum_kroner = 150000,
        skadeforhold = EblPar9IngenVæsentligSkade,
        genanbringelsesforhold = EblPar9GenanbringelseEfterStk4(
            genanbringelse = EblMedGenanbringelseEfterPar6A(
                fakta = ebl_audit_par6a_fakta(40000)
            ),
            boligandel_forøget = Sandt,
            boligandel_forøget_før_15_december_2005 = Falskt
        )
    ),
    EblDato(år = 2026, måned = 12, dag = 31),
    EblPar9Beløbsgrundlag(
        erhvervsdel_reguleret_anskaffelsessum_kroner = 200000,
        erhvervsdel_afståelsessum_kroner = 170000,
        samlet_reguleret_anskaffelsessum_kroner = 300000,
        samlet_afståelsessum_kroner = 320000
    )
)

= ebl_audit_par9_uafstemt_beløbsgrundlag = ebl_par9_resultat(
    ebl_audit_par9_fakta(100000, 150000),
    EblDato(år = 2026, måned = 12, dag = 31),
    EblPar9Beløbsgrundlag(
        erhvervsdel_reguleret_anskaffelsessum_kroner = 200000,
        erhvervsdel_afståelsessum_kroner = 260000,
        samlet_reguleret_anskaffelsessum_kroner = 310000,
        samlet_afståelsessum_kroner = 410000
    )
)

= ebl_audit_modstridende_par5a_kategori = ejendomsavancebeskatningslov_resultat(EjendomsavancebeskatningslovInput(
    indkomstår = 2026,
    afståelsesdato = EblDato(år = 2026, måned = 12, dag = 31),
    afståelse = EblAlmindeligAfståelse,
    erhvervet_som_led_i_næring = Falskt,
    kontant_anskaffelsessum_kroner = 1000000,
    gæld_kursværdi_ved_anskaffelse_kroner = 0,
    par5_fakta = EblPar5Fakta(
        anskaffelsesdato = EblDato(år = 2020, måned = 1, dag = 1),
        anskaffelsesgrundlag = EblPar4AlmindeligtAnskaffelsesgrundlag,
        forholdsmæssig_andel_promille = 1000,
        vedligeholdelses_og_forbedringsudgifter = [],
        nedsættelser = [],
        særforhold = EblPar5UdenMælkekvoteEllerStk6Overførsel,
        reguleringsvalg = EblPar5AMedIndeksering(kategori = EblPar5ALandbrugsejendom)
    ),
    par4_stk8_anskaffelse_udeladt_kroner = 0,
    kontant_afståelsessum_kroner = 1500000,
    overdragne_gældsposter_kursværdi_kroner = 0,
    par4_stk8_afståelsesværdi_udeladt_kroner = 0,
    ejendomstype = EblAndenFastEjendom,
    par11_stk2_genanbragt_erhvervsejendom = Falskt
))

= ebl_audit_par8_stk4_uden_bestemt_grundareal = ebl_par8_stk4_værdipapir_resultat(
    EblPar8Stk4VærdipapirFakta(
        værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
        udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Sandt,
        lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Sandt,
        grundforhold = EblPar8Stk4UdenBestemtGrundareal
    )
)

= ebl_audit_par8_stk4_uopfyldt_bestemt_grundareal = ebl_par8_stk4_værdipapir_resultat(
    EblPar8Stk4VærdipapirFakta(
        værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
        udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Sandt,
        lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Sandt,
        grundforhold = EblPar8Stk4MedBestemtGrundareal(
            grundbetingelse = EblPar8GrundbetingelseIkkeOpfyldt
        )
    )
)

= ebl_audit_par8_stk4_uden_udsteders_direkte_ejerskab = ebl_par8_stk4_værdipapir_resultat(
    EblPar8Stk4VærdipapirFakta(
        værdipapir_forbundet_med_brugsret_til_beboelseslejlighed = Sandt,
        udsteder_ejer_direkte_ejendom_med_flere_beboelseslejligheder = Falskt,
        lejlighed_har_tjent_til_bolig_mens_skattefrihedsbetingelser_var_opfyldt_i_ejertiden = Sandt,
        grundforhold = EblPar8Stk4UdenBestemtGrundareal
    )
)

= ebl_audit_plejehjemsregel_kræver_en_eller_tofamilieshus = ebl_par8_resultat(
    EblPar8Fakta(
        ejendomsart = EblPar8Ejerlejlighed,
        tjent_til_bolig_eller_privat_formål = Sandt,
        betingelser_opfyldt_i_ejerperioden = Sandt,
        afståelsesforhold = EblPar8PlejehjemUnderUdstykning(fakta = EblPar8Plejehjemsfakta(
            grundareal_under_1400_m2 = Sandt,
            matrikulær_udstykning_anmodet = Sandt,
            sagsbehandling_ikke_færdig_ved_flytning = Sandt,
            socialmyndighedserklæring_foreligger = Sandt,
            flyttet_til_beskyttet_bolig_eller_plejehjem = Sandt,
            tjente_til_bolig_umiddelbart_før_fraflytning = Sandt
        )),
        genanbringelsesforhold = EblPar8UdenGenanbringelseEfterStk5
    ),
    EblDato(år = 2026, måned = 12, dag = 31),
    200000
)

| ebl_par5_audit_beregning_er_enten_kildeunderstøttet_eller_fail_closed: ebl_audit_par5_resultater -> all(ebl_audit_par5_resultater, |resultat: EblPar5Resultat| hvis resultat.beregning_anvendt { resultat.input_gyldigt && resultat.regelgrundlag_understøttet } ellers { resultat.reguleret_anskaffelsessum_kroner == resultat.anskaffelsessum_før_par5_kroner && resultat.regulering_efter_par5_og_par5a_kroner == 0 })
| ebl_par5_audit_regulering_afstemmer_til_anskaffelsessummen: ebl_audit_par5_resultater -> all(ebl_audit_par5_resultater, |resultat: EblPar5Resultat| resultat.regulering_efter_par5_og_par5a_kroner == resultat.reguleret_anskaffelsessum_kroner - resultat.anskaffelsessum_før_par5_kroner)
| ebl_par9_audit_delresultater_afstemmer: ebl_audit_par9_resultater -> all(ebl_audit_par9_resultater, |resultat: EblPar9Resultat| resultat.samlet_fortjeneste_eller_tab_kroner == resultat.bolig_fortjeneste_eller_tab_kroner + resultat.erhvervsdel_fortjeneste_eller_tab_kroner)
| ebl_par9_audit_boligdelen_bliver_ikke_skattepligtig: ebl_audit_par9_resultater -> all(ebl_audit_par9_resultater, |resultat: EblPar9Resultat| resultat.betingelser_for_skattefri_boligdel_opfyldt && resultat.skattepligtig_fortjeneste_kroner == penge_positivt_beløb(resultat.erhvervsdel_fortjeneste_eller_tab_kroner) && resultat.tab_kroner == penge_positivt_beløb(0 - resultat.erhvervsdel_fortjeneste_eller_tab_kroner))
| ebl_par9_audit_ikke_understøttet_genanbringelse_er_fail_closed: ebl_audit_par9_ikke_understøttet_genanbringelse -> ebl_audit_par9_ikke_understøttet_genanbringelse.input_gyldigt && ebl_audit_par9_ikke_understøttet_genanbringelse.regelgrundlag_understøttet == Falskt && ebl_audit_par9_ikke_understøttet_genanbringelse.beregning_anvendt == Falskt && ebl_audit_par9_ikke_understøttet_genanbringelse.skattepligtig_fortjeneste_kroner == 0 && ebl_audit_par9_ikke_understøttet_genanbringelse.tab_kroner == 0
| ebl_par9_audit_stk4_beskatter_uden_at_beholde_nedslaget: ebl_audit_par9_stk4_uden_dobbeltbeskatning -> ebl_audit_par9_stk4_uden_dobbeltbeskatning.stk4_anvendt && ebl_audit_par9_stk4_uden_dobbeltbeskatning.aktivt_anskaffelsessumsnedslag_kroner == 40000 && ebl_audit_par9_stk4_uden_dobbeltbeskatning.bortfaldet_anskaffelsessumsnedslag_kroner == 40000 && ebl_audit_par9_stk4_uden_dobbeltbeskatning.erhvervsdel_fortjeneste_eller_tab_med_aktivt_nedslag_kroner == 10000 && ebl_audit_par9_stk4_uden_dobbeltbeskatning.erhvervsdel_fortjeneste_eller_tab_kroner == -30000 && ebl_audit_par9_stk4_uden_dobbeltbeskatning.særskilt_skattepligtig_genanbragt_fortjeneste_kroner == 40000 && ebl_audit_par9_stk4_uden_dobbeltbeskatning.skattepligtig_fortjeneste_kroner == 40000 && ebl_audit_par9_stk4_uden_dobbeltbeskatning.tab_kroner == 30000
| ebl_par9_audit_uafstemt_beløbsgrundlag_er_fail_closed: ebl_audit_par9_uafstemt_beløbsgrundlag -> ebl_audit_par9_uafstemt_beløbsgrundlag.input_gyldigt == Falskt && ebl_audit_par9_uafstemt_beløbsgrundlag.beregning_anvendt == Falskt && ebl_audit_par9_uafstemt_beløbsgrundlag.skattepligtig_fortjeneste_kroner == 0 && ebl_audit_par9_uafstemt_beløbsgrundlag.tab_kroner == 0
| ebl_audit_modstridende_par5a_kategori_afvises: ebl_audit_modstridende_par5a_kategori -> ebl_audit_modstridende_par5a_kategori.input_gyldigt == Falskt && ebl_audit_modstridende_par5a_kategori.skattepligtig_efter_par1 == Falskt && ebl_audit_modstridende_par5a_kategori.skattepligtig_fortjeneste_kroner == 0 && ebl_audit_modstridende_par5a_kategori.tab_kroner == 0
| ebl_audit_par8_stk4_uden_bestemt_grundareal_kræver_ikke_grundprøve: ebl_audit_par8_stk4_uden_bestemt_grundareal -> ebl_audit_par8_stk4_uden_bestemt_grundareal.værdipapir_og_ejendom_omfattet && ebl_audit_par8_stk4_uden_bestemt_grundareal.beboelseskrav_opfyldt && ebl_audit_par8_stk4_uden_bestemt_grundareal.grundkrav_opfyldt && ebl_audit_par8_stk4_uden_bestemt_grundareal.betingelser_for_skattefrihed_opfyldt
| ebl_audit_par8_stk4_bestemt_grundareal_anvender_stk1_grundkrav: ebl_audit_par8_stk4_uopfyldt_bestemt_grundareal -> ebl_audit_par8_stk4_uopfyldt_bestemt_grundareal.værdipapir_og_ejendom_omfattet && ebl_audit_par8_stk4_uopfyldt_bestemt_grundareal.beboelseskrav_opfyldt && ebl_audit_par8_stk4_uopfyldt_bestemt_grundareal.grundkrav_opfyldt == Falskt && ebl_audit_par8_stk4_uopfyldt_bestemt_grundareal.betingelser_for_skattefrihed_opfyldt == Falskt
| ebl_audit_par8_stk4_kræver_udsteders_direkte_ejerskab: ebl_audit_par8_stk4_uden_udsteders_direkte_ejerskab -> ebl_audit_par8_stk4_uden_udsteders_direkte_ejerskab.værdipapir_og_ejendom_omfattet == Falskt && ebl_audit_par8_stk4_uden_udsteders_direkte_ejerskab.beboelseskrav_opfyldt && ebl_audit_par8_stk4_uden_udsteders_direkte_ejerskab.grundkrav_opfyldt && ebl_audit_par8_stk4_uden_udsteders_direkte_ejerskab.betingelser_for_skattefrihed_opfyldt == Falskt
| ebl_audit_plejehjemsregel_afledes_af_ejendomstypen: ebl_audit_plejehjemsregel_kræver_en_eller_tofamilieshus -> ebl_audit_plejehjemsregel_kræver_en_eller_tofamilieshus.input_gyldigt && ebl_audit_plejehjemsregel_kræver_en_eller_tofamilieshus.betingelser_for_skattefrihed_opfyldt == Falskt && ebl_audit_plejehjemsregel_kræver_en_eller_tofamilieshus.skattepligtig_fortjeneste_kroner == 200000

? ebl_par5_audit_beregning_er_enten_kildeunderstøttet_eller_fail_closed
? ebl_par5_audit_regulering_afstemmer_til_anskaffelsessummen
? ebl_par9_audit_delresultater_afstemmer
? ebl_par9_audit_boligdelen_bliver_ikke_skattepligtig
? ebl_par9_audit_ikke_understøttet_genanbringelse_er_fail_closed
? ebl_par9_audit_stk4_beskatter_uden_at_beholde_nedslaget
? ebl_par9_audit_uafstemt_beløbsgrundlag_er_fail_closed
? ebl_audit_modstridende_par5a_kategori_afvises
? ebl_audit_par8_stk4_uden_bestemt_grundareal_kræver_ikke_grundprøve
? ebl_audit_par8_stk4_bestemt_grundareal_anvender_stk1_grundkrav
? ebl_audit_par8_stk4_kræver_udsteders_direkte_ejerskab
? ebl_audit_plejehjemsregel_afledes_af_ejendomstypen

@ print("EBL §§ 5-9 consistency audit passed")
--@end:ebl_par5_par9_konsistensaudit--
