@ sprog da

@ importer ./personskat - income - cliffs.audit

-- Scaling probe for exact finite income-cliff exploration.  Each named query
-- widens one independent axis while preserving the same canonical tax model.

= personskat_skaleringsprobe_kommuner_2026: List(Kommune) = map(
    kommunale_parametre_2026,
    |parametre: KommunaleParametre| parametre.kommune
)

= personskat_skaleringsprobe_kandidatgrænser: List(Heltal) = concat(
    [342499],
    personskat_indkomstklint_resterende_grænser
)

= personskat_skaleringsprobe_kandidatpunkter: List(Heltal) = flat_map(
    personskat_skaleringsprobe_kandidatgrænser,
    |indkomst_før_kroner: Heltal| [indkomst_før_kroner, indkomst_før_kroner + 1]
)

| personskat_skaleringsprobe_overgang(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    indkomst_før_kroner: Heltal
) -> personskat_indkomstklint_overgang(
    personskat_indkomstklint_profil(
        kommunale_parametre_for(2026, kommune),
        betaler_kirkeskat,
        daglige_befordringskilometer
    ),
    indkomst_før_kroner
)

| personskat_skaleringsprobe_er_indkomstklint(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    indkomst_før_kroner: Heltal,
    trin: Heltal
) -> {
    = overgang = personskat_skaleringsprobe_overgang(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        indkomst_før_kroner
    )
    trin == 1 && overgang.ligningsfradrag_input_gyldige && overgang.netto_efter_øre < overgang.netto_før_øre
}

| personskat_skaleringsprobe_kommunekode(
    kommune: Kommune
) -> kommunale_parametre_for(2026, kommune).kommunekode

| personskat_skaleringsprobe_nettotab_øre(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    indkomst_før_kroner: Heltal
) -> personskat_skaleringsprobe_overgang(
    kommune,
    betaler_kirkeskat,
    daglige_befordringskilometer,
    indkomst_før_kroner
).nettotab_øre

| personskat_skaleringsprobe_input_gyldige(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    indkomst_før_kroner: Heltal
) -> personskat_skaleringsprobe_overgang(
    kommune,
    betaler_kirkeskat,
    daglige_befordringskilometer,
    indkomst_før_kroner
).ligningsfradrag_input_gyldige

| personskat_skaleringsprobe_er_kandidatgrænseklint(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    grænse_nummer: Heltal
) -> personskat_skaleringsprobe_er_indkomstklint(
    kommune,
    betaler_kirkeskat,
    daglige_befordringskilometer,
    341499 + grænse_nummer * 1000,
    1
)

| personskat_skaleringsprobe_kandidatgrænsetab_øre(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    grænse_nummer: Heltal
) -> personskat_skaleringsprobe_nettotab_øre(
    kommune,
    betaler_kirkeskat,
    daglige_befordringskilometer,
    341499 + grænse_nummer * 1000
)

| personskat_skaleringsprobe_positiv(beløb: Heltal) -> if beløb > 0 { beløb } else { 0 }

| personskat_skaleringsprobe_grundfradrag_kroner(
    kommune: Kommune,
    daglige_befordringskilometer: Heltal
) -> if daglige_befordringskilometer == 60 {
    if personskat_indkomstklint_yderkommune(kommune) { 25651 } else { 23166 }
} else {
    if personskat_indkomstklint_yderkommune(kommune) { 75528 } else { 65005 }
}

| personskat_skaleringsprobe_lavindkomsttillæg_kroner(
    grundfradrag_kroner: Heltal,
    aftrapningstrin: Heltal
) -> {
    = procent_basispoint = personskat_skaleringsprobe_positiv(6400 - aftrapningstrin * 128)
    = maksimum_kroner = personskat_skaleringsprobe_positiv(50 - aftrapningstrin) * 616
    = procentbeløb_kroner = grundfradrag_kroner * procent_basispoint / 10000
    if procentbeløb_kroner < maksimum_kroner { procentbeløb_kroner } else { maksimum_kroner }
}

| personskat_skaleringsprobe_mekanismegren(
    daglige_befordringskilometer: Heltal
) -> if daglige_befordringskilometer == 60 {
    "lavindkomst-procentgren"
} else {
    "lavindkomst-maksimumsgren"
}

| personskat_skaleringsprobe_specialiseret_nettotab_øre(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    grænse_nummer: Heltal
) -> {
    = parametre = kommunale_parametre_for(2026, kommune)
    = bruttoløn_kroner = 341499 + grænse_nummer * 1000
    = arbejdsmarkedsbidrag_kroner = bruttoløn_kroner * 2 / 25
    = beskæftigelsesfradrag_kroner = bruttoløn_kroner * 1275 / 10000
    = jobfradrag_kroner = 3100
    = grundfradrag_kroner = personskat_skaleringsprobe_grundfradrag_kroner(
        kommune,
        daglige_befordringskilometer
    )
    = tillæg_før_kroner = personskat_skaleringsprobe_lavindkomsttillæg_kroner(
        grundfradrag_kroner,
        grænse_nummer - 1
    )
    = tillæg_efter_kroner = personskat_skaleringsprobe_lavindkomsttillæg_kroner(
        grundfradrag_kroner,
        grænse_nummer
    )
    = tillægstab_kroner = tillæg_før_kroner - tillæg_efter_kroner
    = kommunalt_skattegrundlag_før_kroner = bruttoløn_kroner - arbejdsmarkedsbidrag_kroner - beskæftigelsesfradrag_kroner - jobfradrag_kroner - grundfradrag_kroner - tillæg_før_kroner
    = kommunalt_skattegrundlag_efter_kroner = kommunalt_skattegrundlag_før_kroner + tillægstab_kroner
    = kommuneskattestigning_øre = kommunalt_skattegrundlag_efter_kroner * parametre.kommuneskat_basispoint / 100 - kommunalt_skattegrundlag_før_kroner * parametre.kommuneskat_basispoint / 100
    = kirkeskattestigning_øre = if betaler_kirkeskat {
        kommunalt_skattegrundlag_efter_kroner * parametre.kirkeskat_basispoint / 100 - kommunalt_skattegrundlag_før_kroner * parametre.kirkeskat_basispoint / 100
    } else {
        0
    }
    kommuneskattestigning_øre + kirkeskattestigning_øre
}

| personskat_skaleringsprobe_specialiseret_er_klint(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    grænse_nummer: Heltal
) -> personskat_skaleringsprobe_specialiseret_nettotab_øre(
    kommune,
    betaler_kirkeskat,
    daglige_befordringskilometer,
    grænse_nummer
) > 0

| personskat_skaleringsprobe_specialiseret_nettotab_bin_fra_øre(
    kommune: Kommune,
    betaler_kirkeskat: Boolsk,
    daglige_befordringskilometer: Heltal,
    grænse_nummer: Heltal
) -> personskat_skaleringsprobe_specialiseret_nettotab_øre(
    kommune,
    betaler_kirkeskat,
    daglige_befordringskilometer,
    grænse_nummer
) / 5000 * 5000

? explore personskat_indkomstklint_to_kommuner {
    over personskat_skaleringsprobe_er_indkomstklint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        indkomst_før_kroner,
        trin
    )
    find matches
    bounds {
        kommune in [København, Læsø]
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        indkomst_før_kroner in range(342495, 342501)
        trin = 1
    }
    boundaries on indkomst_før_kroner by trin
    output {
        key [
            kommunekode = personskat_skaleringsprobe_kommunekode(kommune),
            betaler_kirkeskat,
            daglige_befordringskilometer,
            indkomst_før_kroner
        ]
        show [
            indkomst_efter_kroner = indkomst_før_kroner + trin,
            nettotab_øre = personskat_skaleringsprobe_nettotab_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                indkomst_før_kroner
            ),
            ligningsfradrag_input_gyldige = personskat_skaleringsprobe_input_gyldige(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                indkomst_før_kroner
            )
        ]
        representative first
    }
}

? explore personskat_indkomstklint_to_kommuner_alle_kandidatgrænser {
    over personskat_skaleringsprobe_er_kandidatgrænseklint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        grænse_nummer
    )
    find matches
    bounds {
        kommune in [København, Læsø]
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        grænse_nummer in range(1, 51)
    }
    output {
        key [
            kommunekode = personskat_skaleringsprobe_kommunekode(kommune),
            betaler_kirkeskat,
            daglige_befordringskilometer,
            indkomst_før_kroner = 341499 + grænse_nummer * 1000
        ]
        show [
            indkomst_efter_kroner = 341500 + grænse_nummer * 1000,
            nettotab_øre = personskat_skaleringsprobe_kandidatgrænsetab_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                grænse_nummer
            )
        ]
        representative first
    }
}

? explore personskat_indkomstklint_alle_kommuner_fem_kandidatgrænser {
    over personskat_skaleringsprobe_er_kandidatgrænseklint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        grænse_nummer
    )
    find matches
    bounds {
        kommune in values(Kommune)
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        grænse_nummer in range(1, 6)
    }
    output {
        key [
            kommunekode = personskat_skaleringsprobe_kommunekode(kommune),
            betaler_kirkeskat,
            daglige_befordringskilometer,
            indkomst_før_kroner = 341499 + grænse_nummer * 1000
        ]
        representative first
    }
}

? explore personskat_indkomstklint_specialiseret_fuld_matrix {
    over personskat_skaleringsprobe_specialiseret_er_klint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        grænse_nummer
    )
    find matches
    bounds {
        kommune in values(Kommune)
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        grænse_nummer in range(1, 51)
    }
    output {
        key [
            kommunekode = personskat_skaleringsprobe_kommunekode(kommune),
            betaler_kirkeskat,
            daglige_befordringskilometer,
            indkomst_før_kroner = 341499 + grænse_nummer * 1000
        ]
        show [
            nettotab_øre = personskat_skaleringsprobe_specialiseret_nettotab_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                grænse_nummer
            ),
            mekanismegren = personskat_skaleringsprobe_mekanismegren(
                daglige_befordringskilometer
            )
        ]
        representative first
    }
}

-- Exact case supports grouped by a source-derived calculation-branch
-- hypothesis and 50-DKK loss bins.  These branches are useful explanatory
-- candidates; they are not the deferred replay-proven mechanism signatures.
? explore personskat_indkomstklint_specialiseret_mekanismehypoteser_i_50_dkk_bins {
    over personskat_skaleringsprobe_specialiseret_er_klint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        grænse_nummer
    )
    find matches
    bounds {
        kommune in values(Kommune)
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        grænse_nummer in range(1, 51)
    }
    output {
        key [
            beregningsgren_hypotese = personskat_skaleringsprobe_mekanismegren(
                daglige_befordringskilometer
            ),
            nettotab_bin_fra_øre = personskat_skaleringsprobe_specialiseret_nettotab_bin_fra_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                grænse_nummer
            )
        ]
        show [
            nettotab_bin_til_eksklusiv_øre = personskat_skaleringsprobe_specialiseret_nettotab_bin_fra_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                grænse_nummer
            ) + 5000,
            eksempel_nettotab_øre = personskat_skaleringsprobe_specialiseret_nettotab_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                grænse_nummer
            )
        ]
        representative first
    }
}

? explore personskat_indkomstklint_alle_kommuner {
    over personskat_skaleringsprobe_er_indkomstklint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        indkomst_før_kroner,
        trin
    )
    find matches
    bounds {
        kommune in values(Kommune)
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        indkomst_før_kroner in range(342495, 342501)
        trin = 1
    }
    boundaries on indkomst_før_kroner by trin
    output {
        key [
            kommunekode = personskat_skaleringsprobe_kommunekode(kommune),
            betaler_kirkeskat,
            daglige_befordringskilometer,
            indkomst_før_kroner
        ]
        show [
            indkomst_efter_kroner = indkomst_før_kroner + trin,
            nettotab_øre = personskat_skaleringsprobe_nettotab_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                indkomst_før_kroner
            ),
            ligningsfradrag_input_gyldige = personskat_skaleringsprobe_input_gyldige(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                indkomst_før_kroner
            )
        ]
        representative first
    }
}

? explore personskat_indkomstklint_alle_kandidatgrænser {
    over personskat_skaleringsprobe_er_indkomstklint(
        kommune,
        betaler_kirkeskat,
        daglige_befordringskilometer,
        indkomst_før_kroner,
        trin
    )
    find matches
    bounds {
        kommune in values(Kommune)
        betaler_kirkeskat in [Falskt, Sandt]
        daglige_befordringskilometer in [60, 130]
        -- Kept on the known first boundary while the smaller scaling stages run.
        -- The next experiment replaces this with the full curated boundary axis.
        indkomst_før_kroner in range(342495, 342501)
        trin = 1
    }
    boundaries on indkomst_før_kroner by trin
    output {
        key [
            kommunekode = personskat_skaleringsprobe_kommunekode(kommune),
            betaler_kirkeskat,
            daglige_befordringskilometer,
            indkomst_før_kroner
        ]
        show [
            indkomst_efter_kroner = indkomst_før_kroner + trin,
            nettotab_øre = personskat_skaleringsprobe_nettotab_øre(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                indkomst_før_kroner
            ),
            ligningsfradrag_input_gyldige = personskat_skaleringsprobe_input_gyldige(
                kommune,
                betaler_kirkeskat,
                daglige_befordringskilometer,
                indkomst_før_kroner
            )
        ]
        representative first
    }
}
