= ll33_scenarie_udokumenteret_indkomstskat = ll33_scenarie_kildekrav_resultat(Ll33Indkomstskat, "")

| ll33_person_scenarie_kreditgruppe(
    identifikation: Tekst,
    landekode: Tekst,
    grupperingsgrundlag: Ligningslov33Kreditgrupperingsgrundlag,
    indkomstposter: List(Ligningslov33Indkomstpost),
    betalt_udenlandsk_skat_øre: Heltal,
    lønlempelsesstatus: Ligningslov33Lønlempelsesstatus
) -> Ligningslov33PersonKreditgruppe(
    identifikation = identifikation,
    grupperingsgrundlag = grupperingsgrundlag,
    område = Ll33FremmedStat(landekode),
    indkomstposter = indkomstposter,
    skattebetalinger = [Ligningslov33Skattebetaling(
        opkrævningsmåde = Ll33Indeholdelse,
        betalt_udenlandsk_skat_øre = betalt_udenlandsk_skat_øre,
        skatteart = Ll33Indkomstskat,
        betalingsdokumentreference = "Dokumentation " + identifikation,
        overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst
    )],
    lønlempelsesstatus = lønlempelsesstatus
)

