            ],
            1000000,
            status
        )],
        par6_kreditter = [],
        fragtskat_åbningssaldi = []
    ),
    Ligningslov33PersonDanskSkattekreds(
        komponenter = [Ligningslov33DanskSkattekomponent(Ll33PersonskattelovPar6, Ll33PersonligOgPositivKapitalindkomst(200000), 2400000)],
        samlet_dansk_indkomstskat_tilgængelig_øre = 2400000
    )
)
