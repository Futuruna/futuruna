| ll33_par6_scenarie_kreditfakta(hændelse: Kildeskat10Grænsehændelse, særregel: Kildeskat10Særregel, overenskomstgrundlag: Ligningslov33Overenskomstgrundlag, aktivgrundlag: Ligningslov33Par6Aktivgrundlag) -> Ligningslov33Par6Kreditfakta(
    grundlag = Ligningslov33Par6Kreditgrundlag(
        kildeskat10_aktivfakta = Kildeskat10Aktivfakta(
            identifikation = "udenlandsk-fast-ejendom",
