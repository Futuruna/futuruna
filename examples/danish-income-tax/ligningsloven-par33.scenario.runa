| ll33_person_scenarie_udelukket_løn(status: Ligningslov33Lønlempelsesstatus) -> ligningslov33_person_årsresultat(
    Ligningslov33PersonÅrsinput(
        indkomstår = 2026,
        dansk_bruttoindkomst_kroner = 100000,
        ikke_henførbare_udgifter = [],
        kreditgrupper = [ll33_person_scenarie_kreditgruppe(
            "udelukket-løn",
            "YY",
            Ll33SamletIndkomstFraSkatteområdet,
            [
                ligningslov33_bruttoindkomstpost("udelukket-løn-brutto", 100000, [Ll33SkattepligtigIndkomstkategori, Ll33PersonligIndkomstkategori, Ll33Arbejdsmarkedsbidragskategori], "Lønbilag YY-2026"),
                ligningslov33_direkte_udgiftspost("udelukket-løn-personlig-udgift", 8000, [Ll33SkattepligtigIndkomstkategori, Ll33PersonligIndkomstkategori], "Udgiftsbilag YY-2026-1"),
