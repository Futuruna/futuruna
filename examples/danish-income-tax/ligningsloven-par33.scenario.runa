| ll33_scenarie_kildekrav_resultat(skatteart: Ligningslov33UdenlandskSkatteart, betalingsdokumentreference: Tekst) -> ligningslov33_årsresultat(
    Ligningslov33Årsinput(
        dansk_bruttoindkomst_kroner = 9000,
        ikke_henførbare_udgifter_kroner = 0,
        eksportkreditrenteudgifter_omfattet_af_par33f_stk3_kroner = 0,
        landelinjer = [Ligningslov33LandelinjeFakta(
            indkomstfakta = Ligningslov33Indkomstfakta(
                område = Ll33FremmedStat("EE"),
                udenlandsk_bruttoindkomst_kroner = 1000,
                direkte_henførbare_udgifter_kroner = 0
            ),
            skattebetaling = Ligningslov33Skattebetaling(
                opkrævningsmåde = Ll33Indeholdelse,
                betalt_udenlandsk_skat_øre = 27000,
                skatteart = skatteart,
                betalingsdokumentreference = betalingsdokumentreference,
                overenskomstgrundlag = Ll33IngenDobbeltbeskatningsoverenskomst
            )
        )]
    ),
    Ligningslov33DanskSkattekreds(
        samlet_beskattet_indkomst_kroner = 10000,
        dansk_skat_før_nedslag_øre = 270000
    )
)
