        )
        kildeidentifikation: Tekst
    ) |
    Ll9GLigningslov9ARejse(
        @ field(
            label = "Identifikation for § 9 A-rejsen",
            question = "Hvilken oplyst rejse vedrører tilknytningen?",
            sources = personskat_fiskerfradrag_kilder
        )
        kildeidentifikation: Tekst
    ) |
    Ll9GLigningslov9AØlogiophold(
        @ field(
            label = "Identifikation for § 9 A-ølogiopholdet",
            question = "Hvilket oplyst ølogiophold vedrører tilknytningen?",
            sources = personskat_fiskerfradrag_kilder
        )
        kildeidentifikation: Tekst
    ) |
    Ll9GLigningslov9BErhvervsbefordring(
        @ field(
            label = "Identifikation for § 9 B-befordringen",
            question = "Hvilken oplyst erhvervsbefordringssag vedrører tilknytningen?",
            sources = personskat_fiskerfradrag_kilder
        )
        kildeidentifikation: Tekst
    ) |
    Ll9GLigningslov9COg9DBefordringsforhold(
        @ field(
            label = "Identifikation for § 9 C- eller § 9 D-befordringen",
