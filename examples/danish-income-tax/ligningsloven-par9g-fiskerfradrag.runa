--@label:ligningsloven_par9g_fiskerfradrag::meta:ligningsloven_par9g_metadata--
----
§ 9 G. Personer, der ved indkomstårets udløb er, eller som i løbet af
indkomståret har været registreret som erhvervsfiskere efter fiskeriloven, kan
ved opgørelsen af den skattepligtige indkomst fradrage 190 kr. pr. påbegyndt
havdag ved fangstture af mindst 12 timers varighed. Fradraget vælges for hele
indkomståret og kan højst udgøre 41.800 kr. årligt.

Stk. 2. Hvis fradrag foretages efter stk. 1, kan udgifter i forbindelse med
erhvervelsen af indkomsten som registreret erhvervsfisker ikke fradrages efter
§§ 9 A-9 D. Der indrømmes heller ikke fradrag efter § 13 eller efter § 49,
stk. 1, i lov om beskatningen af pensionsordninger m.v., hvis medlemskabet af
fagforeningen m.v. eller arbejdsløshedskassen har tilknytning til beskæftigelsen
som erhvervsfisker. For ansatte fiskere træder fradraget endvidere i stedet for
fradrag efter § 9, stk. 1. Selvstændige fiskere kan ikke fradrage driftsudgifter,
som kan sidestilles med lønmodtagerudgifter efter § 9, stk. 1.
----

----
Den juridiske vejledning C.A.4.3.2.12 opgør en havdag som 24 timer, kræver at
den enkelte fangsttur varer mindst 12 timer og anser turen for afbrudt ved ophold
i havn eller på land. Den samme vejledning bevarer fradrag for et særskilt
kontingent eller en særskilt udgift, der vedrører andet arbejde end fiskeriet.
----

--@begin::ligningsloven_par9g_fiskerfradrag--
# Ligningslov9GFradragsvalg = Ll9GFravælgFiskerfradrag | Ll9GVælgFiskerfradrag
# Ligningslov9GRegistreringsstatus = Ll9GErhvervsfiskerMedAStatus | Ll9GErhvervsfiskerMedBStatus
# Ligningslov9GErhvervsform = Ll9GAnsatFisker | Ll9GSelvstændigFisker
# Ligningslov9GRegistreringsperiode(identifikation: Tekst, status: Ligningslov9GRegistreringsstatus, fra_dato: Dato, til_dato: Dato)
# Ligningslov9GArbejdsforhold(identifikation: Tekst, erhvervsform: Ligningslov9GErhvervsform, fra_dato: Dato, til_dato: Dato)
# Ligningslov9GFangsttur(identifikation: Tekst, arbejdsforhold_identifikation: Tekst, afgang_fra_havn: DatoTidspunkt, ankomst_til_havn: DatoTidspunkt)
# Ligningslov9GSelvstændigUdgiftssammenlignelighed = Ll9GSidstillesMedLønmodtagerudgift | Ll9GSidstillesIkkeMedLønmodtagerudgift
# Ligningslov9GSelvstændigUdgiftsnøgle(virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst)
# Ligningslov9GSelvstændigUdgiftsvurdering(virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst, sammenlignelighed: Ligningslov9GSelvstændigUdgiftssammenlignelighed)
# Ligningslov9GFradragskilde = Ll9GLigningslov9Stk1Udgift(kildeidentifikation: Tekst) | Ll9GLigningslov9ARejse(kildeidentifikation: Tekst) | Ll9GLigningslov9AØlogiophold(kildeidentifikation: Tekst) | Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation: Tekst) | Ll9GLigningslov9COg9DBefordringsforhold(kildeidentifikation: Tekst) | Ll9GLigningslov13Kontingent(kildeidentifikation: Tekst) | Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation: Tekst) | Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst)
# Ligningslov9GArbejdstilknytning = Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation: Tekst) | Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation: Tekst)
# Ligningslov9GKildetilknytning(kilde: Ligningslov9GFradragskilde, arbejdstilknytning: Ligningslov9GArbejdstilknytning)
# Ligningslov9GÅrsinput(valg: Ligningslov9GFradragsvalg, registreringer: List(Ligningslov9GRegistreringsperiode), arbejdsforhold: List(Ligningslov9GArbejdsforhold), fangstture: List(Ligningslov9GFangsttur), selvstændige_udgiftsvurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering), kildetilknytninger: List(Ligningslov9GKildetilknytning))
# Ligningslov9GFangstturResultat(fakta: Ligningslov9GFangsttur, input_gyldigt: Boolsk, arbejdsforhold_fundet: Boolsk, tur_inden_for_arbejdsforhold: Boolsk, varighed_minutter: Heltal, mindst_tolvtimers_fangsttur: Boolsk, påbegyndte_havdage: Heltal)
# Ligningslov9GÅrsresultat(indkomstår: Heltal, input: Ligningslov9GÅrsinput, fangstturresultater: List(Ligningslov9GFangstturResultat), skatteår_understøttet: Boolsk, registreringsidentifikationer_entydige: Boolsk, arbejdsforholdsidentifikationer_entydige: Boolsk, fangstturidentifikationer_entydige: Boolsk, fangstture_ikke_overlappende: Boolsk, selvstændige_udgiftsvurderinger_entydige: Boolsk, selvstændige_udgiftsvurderinger_grundgyldige: Boolsk, kildetilknytninger_entydige: Boolsk, kildetilknytninger_grundgyldige: Boolsk, alle_input_gyldige: Boolsk, registreret_som_erhvervsfisker_i_indkomståret: Boolsk, kan_vælge_fiskerfradrag: Boolsk, fradrag_foretaget_efter_par9g: Boolsk, påbegyndte_havdage_før_årsloft: Heltal, havdage_efter_årsloft: Heltal, sats_pr_havdag_kroner: Heltal, årsloft_kroner: Heltal, samlet_fradrag_kroner: Heltal)

| ligningslov9g_intet_årsinput() -> Ligningslov9GÅrsinput(
    valg = Ll9GFravælgFiskerfradrag,
    registreringer = [],
    arbejdsforhold = [],
    fangstture = [],
    selvstændige_udgiftsvurderinger = [],
    kildetilknytninger = []
)
| ligningslov9g_skatteår_understøttet(indkomstår: Heltal) -> indkomstår == 2025 || indkomstår == 2026
| ligningslov9g_årets_første_dato(indkomstår: Heltal) -> Dato(år = indkomstår, måned = 1, dag = 1)
| ligningslov9g_årets_sidste_dato(indkomstår: Heltal) -> Dato(år = indkomstår, måned = 12, dag = 31)
| ligningslov9g_datoperiode_gyldig(fra_dato: Dato, til_dato: Dato) -> dato_før_eller_lig_med(fra_dato, til_dato)
| ligningslov9g_datoperiode_overlapper_indkomstår(fra_dato: Dato, til_dato: Dato, indkomstår: Heltal) -> ligningslov9g_datoperiode_gyldig(fra_dato, til_dato) && dato_før_eller_lig_med(fra_dato, ligningslov9g_årets_sidste_dato(indkomstår)) && dato_før_eller_lig_med(ligningslov9g_årets_første_dato(indkomstår), til_dato)
| ligningslov9g_registrering_input_gyldig(registrering: Ligningslov9GRegistreringsperiode) -> registrering.identifikation != "" && ligningslov9g_datoperiode_gyldig(registrering.fra_dato, registrering.til_dato)
| ligningslov9g_arbejdsforhold_input_gyldigt(arbejdsforhold: Ligningslov9GArbejdsforhold) -> arbejdsforhold.identifikation != "" && ligningslov9g_datoperiode_gyldig(arbejdsforhold.fra_dato, arbejdsforhold.til_dato)
| ligningslov9g_registreringsidentifikationer_entydige(registreringer: List(Ligningslov9GRegistreringsperiode)) -> length(distinct(map(registreringer, |registrering: Ligningslov9GRegistreringsperiode| registrering.identifikation))) == length(registreringer) && all(registreringer, |registrering: Ligningslov9GRegistreringsperiode| registrering.identifikation != "")
| ligningslov9g_arbejdsforholdsidentifikationer_entydige(arbejdsforhold: List(Ligningslov9GArbejdsforhold)) -> length(distinct(map(arbejdsforhold, |forhold: Ligningslov9GArbejdsforhold| forhold.identifikation))) == length(arbejdsforhold) && all(arbejdsforhold, |forhold: Ligningslov9GArbejdsforhold| forhold.identifikation != "")
| ligningslov9g_fangstturidentifikationer_entydige(fangstture: List(Ligningslov9GFangsttur)) -> length(distinct(map(fangstture, |tur: Ligningslov9GFangsttur| tur.identifikation))) == length(fangstture) && all(fangstture, |tur: Ligningslov9GFangsttur| tur.identifikation != "")
| ligningslov9g_selvstændig_udgiftsvurdering_nøgle(vurdering: Ligningslov9GSelvstændigUdgiftsvurdering) -> Ligningslov9GSelvstændigUdgiftsnøgle(virksomhedsidentifikation = vurdering.virksomhedsidentifikation, kildeidentifikation = vurdering.kildeidentifikation)
| ligningslov9g_selvstændig_udgiftsvurdering_grundgyldig(vurdering: Ligningslov9GSelvstændigUdgiftsvurdering) -> vurdering.virksomhedsidentifikation != "" && vurdering.kildeidentifikation != ""
| ligningslov9g_selvstændige_udgiftsvurderinger_entydige(vurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering)) -> length(distinct(map(vurderinger, ligningslov9g_selvstændig_udgiftsvurdering_nøgle))) == length(vurderinger)
| ligningslov9g_selvstændige_udgiftsvurderinger_grundgyldige(vurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering)) -> all(vurderinger, ligningslov9g_selvstændig_udgiftsvurdering_grundgyldig)
| ligningsloven9g_arbejdsforhold_for(input: Ligningslov9GÅrsinput, identifikation: Tekst) -> find(input.arbejdsforhold, |forhold: Ligningslov9GArbejdsforhold| forhold.identifikation == identifikation)
| ligningslov9g_fangsttur_inden_for_arbejdsforhold(tur: Ligningslov9GFangsttur, arbejdsforhold: Ligningslov9GArbejdsforhold) -> dato_før_eller_lig_med(arbejdsforhold.fra_dato, tur.afgang_fra_havn.dato) && dato_før_eller_lig_med(tur.ankomst_til_havn.dato, arbejdsforhold.til_dato)
| ligningslov9g_fangsttur_i_indkomståret(tur: Ligningslov9GFangsttur, indkomstår: Heltal) -> tur.afgang_fra_havn.dato.år == indkomstår && tur.ankomst_til_havn.dato.år == indkomstår
| ligningslov9g_påbegyndte_havdage(varighed_minutter: Heltal) -> hvis varighed_minutter >= 720 { (varighed_minutter + 1439) / 1440 } ellers { 0 }
| ligningslov9g_fangsttur_resultat(indkomstår: Heltal, input: Ligningslov9GÅrsinput, tur: Ligningslov9GFangsttur) -> {
    = arbejdsforhold = ligningsloven9g_arbejdsforhold_for(input, tur.arbejdsforhold_identifikation)
    = arbejdsforhold_fundet = match arbejdsforhold { | Some(_) -> Sandt | None -> Falskt }
    = tur_inden_for_arbejdsforhold = match arbejdsforhold { | Some(forhold) -> ligningslov9g_fangsttur_inden_for_arbejdsforhold(tur, forhold) | None -> Falskt }
    = tidspunkter_gyldige = dato_tidspunkt_gyldigt(tur.afgang_fra_havn) && dato_tidspunkt_gyldigt(tur.ankomst_til_havn) && dato_tidspunkt_før(tur.afgang_fra_havn, tur.ankomst_til_havn)
    = varighed_minutter = hvis tidspunkter_gyldige { dato_tidspunkt_minutter_mellem(tur.afgang_fra_havn, tur.ankomst_til_havn) } ellers { 0 }
    = input_gyldigt = tur.identifikation != "" && tur.arbejdsforhold_identifikation != "" && tidspunkter_gyldige && ligningslov9g_fangsttur_i_indkomståret(tur, indkomstår) && arbejdsforhold_fundet && tur_inden_for_arbejdsforhold
    = mindst_tolvtimers_fangsttur = input_gyldigt && varighed_minutter >= 720
    Ligningslov9GFangstturResultat(
        fakta = tur,
        input_gyldigt = input_gyldigt,
        arbejdsforhold_fundet = arbejdsforhold_fundet,
        tur_inden_for_arbejdsforhold = tur_inden_for_arbejdsforhold,
        varighed_minutter = varighed_minutter,
        mindst_tolvtimers_fangsttur = mindst_tolvtimers_fangsttur,
        påbegyndte_havdage = hvis mindst_tolvtimers_fangsttur { ligningslov9g_påbegyndte_havdage(varighed_minutter) } ellers { 0 }
    )
}
| ligningslov9g_fangstture_overlapper(a: Ligningslov9GFangsttur, b: Ligningslov9GFangsttur) -> a.identifikation != b.identifikation && dato_tidspunkt_før(a.afgang_fra_havn, b.ankomst_til_havn) && dato_tidspunkt_før(b.afgang_fra_havn, a.ankomst_til_havn)
| ligningslov9g_fangstture_ikke_overlappende(fangstture: List(Ligningslov9GFangsttur)) -> all(fangstture, |a: Ligningslov9GFangsttur| all(fangstture, |b: Ligningslov9GFangsttur| ligningslov9g_fangstture_overlapper(a, b) == Falskt))
| ligningslov9g_registreret_i_indkomståret(registreringer: List(Ligningslov9GRegistreringsperiode), indkomstår: Heltal) -> any(registreringer, |registrering: Ligningslov9GRegistreringsperiode| ligningslov9g_registrering_input_gyldig(registrering) && ligningslov9g_datoperiode_overlapper_indkomstår(registrering.fra_dato, registrering.til_dato, indkomstår))
| ligningslov9g_fradragskilde_identifikation_gyldig(kilde: Ligningslov9GFradragskilde) -> match kilde {
    | Ll9GLigningslov9Stk1Udgift(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GLigningslov9ARejse(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GLigningslov9AØlogiophold(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GLigningslov9BErhvervsbefordring(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GLigningslov9COg9DBefordringsforhold(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GLigningslov13Kontingent(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GPensionsbeskatningslov49Stk1Bidrag(kildeidentifikation) -> kildeidentifikation != ""
    | Ll9GSelvstændigUdgiftSidestilletMedLønmodtagerudgift(virksomhedsidentifikation, kildeidentifikation) -> virksomhedsidentifikation != "" && kildeidentifikation != ""
}
| ligningslov9g_arbejdstilknytning_grundgyldig(input: Ligningslov9GÅrsinput, arbejdstilknytning: Ligningslov9GArbejdstilknytning) -> match arbejdstilknytning {
    | Ll9GTilknyttetErhvervsfiskerarbejde(arbejdsforhold_identifikation) -> arbejdsforhold_identifikation != "" && match ligningsloven9g_arbejdsforhold_for(input, arbejdsforhold_identifikation) { | Some(_) -> Sandt | None -> Falskt }
    | Ll9GTilknyttetAndetArbejde(arbejdsforhold_identifikation) -> arbejdsforhold_identifikation != "" && match ligningsloven9g_arbejdsforhold_for(input, arbejdsforhold_identifikation) { | Some(_) -> Falskt | None -> Sandt }
}
| ligningslov9g_kildetilknytninger_entydige(kildetilknytninger: List(Ligningslov9GKildetilknytning)) -> length(distinct(map(kildetilknytninger, |tilknytning: Ligningslov9GKildetilknytning| tilknytning.kilde))) == length(kildetilknytninger)
| ligningslov9g_kildetilknytninger_grundgyldige(input: Ligningslov9GÅrsinput) -> all(input.kildetilknytninger, |tilknytning: Ligningslov9GKildetilknytning| ligningslov9g_fradragskilde_identifikation_gyldig(tilknytning.kilde) && ligningslov9g_arbejdstilknytning_grundgyldig(input, tilknytning.arbejdstilknytning))
| ligningslov9g_kildetilknytninger_for(input: Ligningslov9GÅrsinput, kilde: Ligningslov9GFradragskilde) -> filter(input.kildetilknytninger, |tilknytning: Ligningslov9GKildetilknytning| tilknytning.kilde == kilde)
| ligningslov9g_kildetilknytning(input: Ligningslov9GÅrsinput, kilde: Ligningslov9GFradragskilde) -> find(input.kildetilknytninger, |tilknytning: Ligningslov9GKildetilknytning| tilknytning.kilde == kilde)
| ligningslov9g_kilde_tilknyttet_erhvervsfiskerarbejde(input: Ligningslov9GÅrsinput, kilde: Ligningslov9GFradragskilde) -> match ligningslov9g_kildetilknytning(input, kilde) {
    | Some(tilknytning) -> match tilknytning.arbejdstilknytning { | Ll9GTilknyttetErhvervsfiskerarbejde(_) -> Sandt | Ll9GTilknyttetAndetArbejde(_) -> Falskt }
    | None -> Falskt
}
| ligningslov9g_årsresultat(indkomstår: Heltal, input: Ligningslov9GÅrsinput) -> {
    = fangstturresultater = map(input.fangstture, |tur: Ligningslov9GFangsttur| ligningslov9g_fangsttur_resultat(indkomstår, input, tur))
    = skatteår_understøttet = length(input.registreringer) == 0 && length(input.arbejdsforhold) == 0 && length(input.fangstture) == 0 || ligningslov9g_skatteår_understøttet(indkomstår)
    = registreringsidentifikationer_entydige = ligningslov9g_registreringsidentifikationer_entydige(input.registreringer)
    = arbejdsforholdsidentifikationer_entydige = ligningslov9g_arbejdsforholdsidentifikationer_entydige(input.arbejdsforhold)
    = fangstturidentifikationer_entydige = ligningslov9g_fangstturidentifikationer_entydige(input.fangstture)
    = fangstture_ikke_overlappende = ligningslov9g_fangstture_ikke_overlappende(input.fangstture)
    = selvstændige_udgiftsvurderinger_entydige = ligningslov9g_selvstændige_udgiftsvurderinger_entydige(input.selvstændige_udgiftsvurderinger)
    = selvstændige_udgiftsvurderinger_grundgyldige = ligningslov9g_selvstændige_udgiftsvurderinger_grundgyldige(input.selvstændige_udgiftsvurderinger)
    = kildetilknytninger_entydige = ligningslov9g_kildetilknytninger_entydige(input.kildetilknytninger)
    = kildetilknytninger_grundgyldige = ligningslov9g_kildetilknytninger_grundgyldige(input)
    = alle_input_gyldige = skatteår_understøttet && registreringsidentifikationer_entydige && arbejdsforholdsidentifikationer_entydige && fangstturidentifikationer_entydige && fangstture_ikke_overlappende && selvstændige_udgiftsvurderinger_entydige && selvstændige_udgiftsvurderinger_grundgyldige && kildetilknytninger_entydige && kildetilknytninger_grundgyldige && all(input.registreringer, ligningslov9g_registrering_input_gyldig) && all(input.arbejdsforhold, ligningslov9g_arbejdsforhold_input_gyldigt) && all(fangstturresultater, |resultat: Ligningslov9GFangstturResultat| resultat.input_gyldigt)
    = registreret_som_erhvervsfisker_i_indkomståret = ligningslov9g_registreret_i_indkomståret(input.registreringer, indkomstår)
    = påbegyndte_havdage_før_årsloft = hvis alle_input_gyldige { foldl(fangstturresultater, 0, |sum_havdage: Heltal, resultat: Ligningslov9GFangstturResultat| sum_havdage + resultat.påbegyndte_havdage) } ellers { 0 }
    = havdage_efter_årsloft = hvis påbegyndte_havdage_før_årsloft < 220 { påbegyndte_havdage_før_årsloft } ellers { 220 }
    = kan_vælge_fiskerfradrag = alle_input_gyldige && registreret_som_erhvervsfisker_i_indkomståret && påbegyndte_havdage_før_årsloft > 0
    = fradrag_foretaget_efter_par9g = input.valg == Ll9GVælgFiskerfradrag && kan_vælge_fiskerfradrag
    Ligningslov9GÅrsresultat(
        indkomstår = indkomstår,
        input = input,
        fangstturresultater = fangstturresultater,
        skatteår_understøttet = skatteår_understøttet,
        registreringsidentifikationer_entydige = registreringsidentifikationer_entydige,
        arbejdsforholdsidentifikationer_entydige = arbejdsforholdsidentifikationer_entydige,
        fangstturidentifikationer_entydige = fangstturidentifikationer_entydige,
