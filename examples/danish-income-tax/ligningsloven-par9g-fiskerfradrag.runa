        )
        arbejdsforhold_identifikation: Tekst
    )
# Ligningslov9GKildetilknytning(kilde: Ligningslov9GFradragskilde, arbejdstilknytning: Ligningslov9GArbejdstilknytning)
# Ligningslov9GÅrsinput(
    @ field(
        label = "Valg af fiskerfradrag",
        question = "Skal fiskerfradraget efter ligningslovens § 9 G anvendes for indkomståret?",
        help = "Valget gælder hele indkomståret. Futuruna udleder registreringskravet, havdagene, årsloftet og de fradrag, som valget erstatter.",
        sources = personskat_fiskerfradrag_kilder
    )
    valg: Ligningslov9GFradragsvalg,
    @ field(
        label = "Registreringer som erhvervsfisker",
        question = "I hvilke perioder var personen registreret som erhvervsfisker med A- eller B-status?",
        help = "Opret én række pr. registreringsperiode. En registrering i blot en del af indkomståret kan opfylde registreringsbetingelsen for årets fangstture.",
        sources = personskat_fiskerfradrag_kilder
    )
    registreringer: List(Ligningslov9GRegistreringsperiode),
    @ field(
        label = "Arbejdsforhold som erhvervsfisker",
        question = "Hvilke ansættelser eller selvstændige virksomheder vedrørte erhvervsfiskeriet?",
        help = "Opret én række pr. arbejdsforhold. Identifikationen bruges til fangstture og til at afgrænse de udgifter og kontingenter, som fiskerfradraget erstatter.",
        sources = personskat_fiskerfradrag_kilder
    )
    arbejdsforhold: List(Ligningslov9GArbejdsforhold),
    @ field(
        label = "Fangstture",
        question = "Hvilke fangstture på mindst 12 timer overlappede indkomståret?",
        help = "Opret én række pr. sammenhængende tur fra afgang fra havn til ankomst til havn. En tur over nytår oplyses med de samme fulde tidspunkter i hvert relevant års beregning; Futuruna henfører hver påbegyndt 24-timers-havdag til året, hvor perioden starter.",
        sources = personskat_fiskerfradrag_kilder
    )
    fangstture: List(Ligningslov9GFangsttur),
    @ field(
        label = "Vurdering af selvstændige fiskeres udgifter",
        question = "Kan hver driftsudgift i fiskerivirksomheden sidestilles med en lønmodtagerudgift efter ligningslovens § 9, stk. 1?",
        help = "Opret én række for hver oplyst driftsudgift i en selvstændig fiskerivirksomhed. Kun udgifter, som kan sidestilles med lønmodtagerudgifter, afskæres af § 9 G; almindelige driftsudgifter bevares.",
        sources = personskat_fiskerfradrag_kilder
    )
    selvstændige_udgiftsvurderinger: List(Ligningslov9GSelvstændigUdgiftsvurdering),
    @ field(
        label = "Konkrete bedømmelser af kontingentperioder",
        question = "Er et kontingent til fiskeriets faglige forening konkret godkendt for en periode før første registrering eller efter fuldstændigt ophør med fiskeriet?",
        help = "Opret kun en række, når der foreligger en konkret ligningsmæssig bedømmelse. Midlertidigt andet arbejde, arbejdsløshed eller en pause mellem registreringer er ikke et fuldstændigt ophør.",
        sources = personskat_fiskerfradrag_kilder
    )
    kontingentperiodeundtagelser: List(Ligningslov9GKontingentperiodeundtagelse),
    @ field(
        label = "Arbejdstilknytning for fradragskilder",
        question = "Hvilket fiskerarbejde eller andet arbejde vedrører hver udgift, faglig forening og bidragskilde, som § 9 G kan erstatte?",
        help = "Opret én række pr. oplyst § 9, stk. 1-, §§ 9 A-9 D-, faglig § 13-forening eller PBL § 49, stk. 1-kilde og pr. selvstændig udgift, der er vurderet som sidestillet med en lønmodtagerudgift. Postkilder bruger postens identifikation; § 13 bruger den stabile foreningsidentifikation.",
        sources = personskat_fiskerfradrag_kilder
