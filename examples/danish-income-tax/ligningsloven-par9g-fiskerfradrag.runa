----
Den juridiske vejledning C.A.4.3.2.12 opgør en havdag som 24 timer, kræver at
den enkelte fangsttur varer mindst 12 timer og anser turen for afbrudt ved ophold
i havn eller på land. Vejledningen angiver særskilt, at ansatte fiskere kun kan
anvende LL § 9 A om skattefri godtgørelse eller fradrag for rejseudgifter til
kost og småfornødenheder, når de ikke har valgt § 9 G for fangstture i året.
Andet arbejde eller arbejdsløshed bevarer ikke fradraget for kontingent til den
samme fiskeritilknyttede fagforening. Er fiskeren medlem af en anden fagforening
i forbindelse med andet arbejde, bevares fradraget til denne anden forening.
Den samme vejledning bevarer også befordringsfradrag, rejseudgifter og andre
lønmodtagerudgifter ved andet arbejde end fiskeriet. Kontingent for tiden før
den første registrering kan efter en konkret ligningsmæssig bedømmelse bevares,
når personen havde andet arbejde i årets første del. Det samme gælder tiden
efter, at personen fuldstændig er ophørt med fiskerierhvervet, ikke længere er
registreret og har påbegyndt et andet erhverv. En midlertidig periode uden
fiskeri er ikke et fuldstændigt ophør. Se også C.A.4.3.1.3 og TfS 1996, 105 DEP.

Lov, forarbejder og vejledning angiver ingen særregel for en sammenhængende
fangsttur over 31. december. Modellen henfører derfor hver påbegyndt
24-timers-havdag til det indkomstår, hvor den pågældende periode påbegyndes.
Fortolkningen er typet i metadata, så den kan findes og efterprøves særskilt.
----

----
Ligningsloven, LBK nr. 42 af 13/01/2023 og LBK nr. 1500 af 24/11/2025,
enslydende § 9 G:

§ 9 G. Personer, der ved indkomstårets udløb er, eller som i løbet af
indkomståret har været registreret som erhvervsfiskere efter fiskeriloven, kan
ved opgørelsen af den skattepligtige indkomst fradrage 190 kr. pr. påbegyndt
havdag ved fangstture af mindst 12 timers varighed. Fradraget vælges for hele
indkomståret og kan højst udgøre 41.800 kr. årligt.

Stk. 2. Hvis fradrag foretages efter stk. 1, kan udgifter i forbindelse med
erhvervelsen af indkomsten som registreret erhvervsfisker ikke fradrages efter
§§ 9 A-9 D. Der indrømmes heller ikke fradrag efter § 13 eller efter § 49,
stk. 1, i lov om beskatningen af pensionsordninger m.v., hvis medlemskabet af
fagforeningen m.v. eller arbejdsløshedskassen har tilknytning til beskæftigelsen
som erhvervsfisker. For ansatte fiskere træder fradraget endvidere i stedet for
fradrag efter § 9, stk. 1. Selvstændige fiskere kan ikke fradrage driftsudgifter,
som kan sidestilles med lønmodtagerudgifter efter § 9, stk. 1.
----

@ meta(ligningsloven_par9g_metadata)
@ section ligningsloven_par9g_fiskerfradrag {

# Ligningslov9GLovversion = Ll9GLbk42Af2023 | Ll9GLbk1500Af2025 | Ll9GLovUdenKildedækning
# Ligningslov9GFradragsvalg = Ll9GFravælgFiskerfradrag | Ll9GVælgFiskerfradrag
# Ligningslov9GRegistreringsstatus = Ll9GErhvervsfiskerMedAStatus | Ll9GErhvervsfiskerMedBStatus
# Ligningslov9GErhvervsform = Ll9GAnsatFisker | Ll9GSelvstændigFisker
= personskat_fiskerfradrag_kilder = [
    Source(value = ligningsloven_lbk1500_par9g),
    DependencySource(value = fiskeriloven_lbk205_par14),
    AmendmentSource(value = fiskeriloven_lov333_par9_og_par10_stk4),
    Guidance(value = juridisk_vejledning_ligningslov9g_fiskere)
]
# Ligningslov9GRegistreringsperiode(
    @ field(
        label = "Fiskerregistreringens identifikation",
        question = "Hvilken entydig identifikation har registreringsperioden?",
        help = "Brug en stabil reference fra Fiskeristyrelsens registrering.",
        sources = personskat_fiskerfradrag_kilder
    )
    identifikation: Tekst,
    @ field(
        label = "Erhvervsfiskerens registreringsstatus",
        question = "Var registreringen A-status eller B-status?",
        sources = personskat_fiskerfradrag_kilder
    )
    status: Ligningslov9GRegistreringsstatus,
    fra_dato: Dato,
    til_dato: Dato
)
# Ligningslov9GArbejdsforhold(
    @ field(
        label = "Fiskerarbejdsforholdets identifikation",
        question = "Hvilken entydig identifikation har fiskerarbejdsforholdet?",
        help = "For en selvstændig fisker skal identifikationen svare til virksomhedens identifikation i de personlige indkomstfakta.",
        sources = personskat_fiskerfradrag_kilder
    )
    identifikation: Tekst,
    @ field(
        label = "Erhvervsform for fiskerarbejdet",
        question = "Blev arbejdet udført som ansat eller selvstændig fisker?",
        sources = personskat_fiskerfradrag_kilder
    )
    erhvervsform: Ligningslov9GErhvervsform,
    fra_dato: Dato,
    til_dato: Dato
)
# Ligningslov9GFangsttur(
    @ field(
        label = "Fangstturens identifikation",
        question = "Hvilken entydig identifikation har fangstturen?",
        help = "Brug en stabil reference fra fartøjets afregning, logbog eller besætningsopgørelse.",
        sources = personskat_fiskerfradrag_kilder
    )
    identifikation: Tekst,
    @ field(
        label = "Fiskerarbejdsforhold for fangstturen",
        question = "Hvilket oplyst fiskerarbejdsforhold vedrører fangstturen?",
        help = "Identifikationen skal svare præcist til et arbejdsforhold som erhvervsfisker.",
        sources = personskat_fiskerfradrag_kilder
    )
    arbejdsforhold_identifikation: Tekst,
    afgang_fra_havn: DatoTidspunkt,
    ankomst_til_havn: DatoTidspunkt
)
# Ligningslov9GSelvstændigUdgiftssammenlignelighed = Ll9GSidstillesMedLønmodtagerudgift | Ll9GSidstillesIkkeMedLønmodtagerudgift
# Ligningslov9GSelvstændigUdgiftsnøgle(virksomhedsidentifikation: Tekst, kildeidentifikation: Tekst)
# Ligningslov9GSelvstændigUdgiftsvurdering(
    @ field(
        label = "Fiskerivirksomhed for udgiftsvurderingen",
        question = "Hvilken selvstændig fiskerivirksomhed har afholdt udgiften?",
        help = "Identifikationen skal svare præcist til både virksomheden og et selvstændigt fiskerarbejdsforhold.",
        sources = personskat_fiskerfradrag_kilder
    )
    virksomhedsidentifikation: Tekst,
    @ field(
        label = "Driftsudgift for udgiftsvurderingen",
        question = "Hvilken oplyst driftsudgift i fiskerivirksomheden vurderes?",
        help = "Brug udgiftens entydige identifikation fra virksomhedens udgiftstabel.",
        sources = personskat_fiskerfradrag_kilder
    )
    kildeidentifikation: Tekst,
    @ field(
        label = "Sammenlignelighed med lønmodtagerudgift",
        question = "Kan udgiften sidestilles med en lønmodtagerudgift efter § 9, stk. 1?",
        help = "Vælg nej for en almindelig driftsudgift, som ikke erstattes af fiskerfradraget.",
        sources = personskat_fiskerfradrag_kilder
    )
    sammenlignelighed: Ligningslov9GSelvstændigUdgiftssammenlignelighed
)
@ field(
    label = "Kontingentperiodens overgangstype",
    question = "Vedrører bedømmelsen tiden før den første registrering eller tiden efter fuldstændigt ophør med fiskeriet?",
    help = "Futuruna kontrollerer den valgte overgangstype mod alle oplyste registreringsperioder.",
    sources = personskat_fiskerfradrag_kilder
)
# Ligningslov9GKontingentperiodebedømmelse =
    Ll9GFørFørsteRegistreringGodkendtEfterKonkretBedømmelse(
        @ field(
            label = "Andet arbejde før første fiskerregistrering",
            question = "Hvilket andet arbejdsforhold havde personen før den første registrering som erhvervsfisker?",
            help = "Identifikationen må ikke være et oplyst fiskerarbejdsforhold.",
            sources = personskat_fiskerfradrag_kilder
        )
        andet_arbejdsforhold_identifikation: Tekst,
        @ field(
            label = "Reference for bedømmelsen før første registrering",
            question = "Hvilken afgørelse, kontrollerbar vurdering eller anden reference dokumenterer den konkrete ligningsmæssige bedømmelse?",
            help = "Henvisningen skal identificere den konkrete bedømmelse; en generel henvisning til § 9 G er ikke tilstrækkelig.",
            sources = personskat_fiskerfradrag_kilder
        )
        ligningsmæssig_bedømmelsesreference: Tekst
    ) |
    Ll9GEfterFuldtOphørGodkendtEfterKonkretBedømmelse(
        @ field(
            label = "Andet erhverv efter fuldstændigt ophør med fiskeriet",
            question = "Hvilket andet erhverv påbegyndte personen efter fuldstændigt ophør med fiskeriet?",
            help = "Identifikationen må ikke være et oplyst fiskerarbejdsforhold.",
            sources = personskat_fiskerfradrag_kilder
        )
        andet_erhverv_identifikation: Tekst,
        @ field(
            label = "Reference for bedømmelsen efter fuldstændigt ophør",
            question = "Hvilken afgørelse, kontrollerbar vurdering eller anden reference dokumenterer den konkrete ligningsmæssige bedømmelse?",
            help = "Henvisningen skal identificere den konkrete bedømmelse; en generel henvisning til § 9 G er ikke tilstrækkelig.",
            sources = personskat_fiskerfradrag_kilder
        )
        ligningsmæssig_bedømmelsesreference: Tekst
    )
# Ligningslov9GKontingentperiodeundtagelse(
    @ field(
        label = "Kontingentbetaling for den konkrete bedømmelse",
        question = "Hvilken oplyst kontingentbetaling vedrører den konkrete bedømmelse?",
        help = "Identifikationen skal svare præcist til én række i tabellen over faglige kontingenter.",
        sources = personskat_fiskerfradrag_kilder
    )
    kontingent_identifikation: Tekst,
    bedømmelse: Ligningslov9GKontingentperiodebedømmelse
)
@ field(
    label = "Fradragskildens lovtype",
    question = "Hvilken lovbestemt fradragstype har kilden?",
    help = "Vælg den type, som svarer til den allerede oplyste post. Efterløns- og fleksydelsesbidrag efter PBL §§ 49 A-49 B skal ikke tilknyttes.",
    sources = personskat_fiskerfradrag_kilder
)
# Ligningslov9GFradragskilde =
    Ll9GLigningslov9Stk1Udgift(
        @ field(
            label = "Identifikation for § 9, stk. 1-udgiften",
            question = "Hvilken oplyst lønmodtagerudgift vedrører tilknytningen?",
