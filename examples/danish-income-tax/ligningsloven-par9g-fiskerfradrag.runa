# Ligningslov9GFangstturResultat(fakta: Ligningslov9GFangsttur, input_gyldigt: Boolsk, arbejdsforhold_fundet: Boolsk, tur_inden_for_arbejdsforhold: Boolsk, fangsttur_overlapper_indkomståret: Boolsk, varighed_minutter: Heltal, mindst_tolvtimers_fangsttur: Boolsk, samlede_påbegyndte_havdage_på_fangstturen: Heltal, påbegyndte_havdage: Heltal)
# Ligningslov9GÅrsresultat(indkomstår: Heltal, lovversion: Ligningslov9GLovversion, input: Ligningslov9GÅrsinput, fangstturresultater: List(Ligningslov9GFangstturResultat), skatteår_understøttet: Boolsk, registreringsidentifikationer_entydige: Boolsk, arbejdsforholdsidentifikationer_entydige: Boolsk, fangstturidentifikationer_entydige: Boolsk, fangstture_ikke_overlappende: Boolsk, selvstændige_udgiftsvurderinger_entydige: Boolsk, selvstændige_udgiftsvurderinger_grundgyldige: Boolsk, kontingentperiodeundtagelser_entydige: Boolsk, kontingentperiodeundtagelser_grundgyldige: Boolsk, kildetilknytninger_entydige: Boolsk, kildetilknytninger_grundgyldige: Boolsk, alle_input_gyldige: Boolsk, registreret_som_erhvervsfisker_i_indkomståret: Boolsk, kan_vælge_fiskerfradrag: Boolsk, fradrag_foretaget_efter_par9g: Boolsk, påbegyndte_havdage_før_årsloft: Heltal, havdage_efter_årsloft: Heltal, sats_pr_havdag_kroner: Heltal, årsloft_kroner: Heltal, samlet_fradrag_kroner: Heltal)

| ligningslov9g_intet_årsinput() -> Ligningslov9GÅrsinput(
    valg = Ll9GFravælgFiskerfradrag,
    registreringer = [],
    arbejdsforhold = [],
    fangstture = [],
    selvstændige_udgiftsvurderinger = [],
    kontingentperiodeundtagelser = [],
    kildetilknytninger = []
