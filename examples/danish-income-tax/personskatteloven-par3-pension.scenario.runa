@ sprog da

@ importer ./kapitel - 01 - indkomst
@ importer ./pbl15a - source - fixtures.scenario

-- Scenarier for Pensionsbeskatningsloven §§ 16, 18 og 52 samt
-- Personskatteloven § 3, stk. 2, nr. 3. Lovtekst og kildeankre ligger i
-- pensionsbeskatningsloven.runa og kapitel-01-indkomst.runa.

= pension_intet_selvstændigt_overskud = Pbl18SelvstændigOverskudInput(
    skattepligtigt_overskud_før_vsl22b_kroner = 0,
    renteudgifter_kroner = 0,
    kurstab_kroner = 0,
    renteindtægter_kroner = 0,
    udbytteindtægter_kroner = 0,
    kursgevinster_kroner = 0,
    udelukkede_afståelsesindkomster_kroner = 0
)

= pension_selvstændigt_overskud = Pbl18SelvstændigOverskudInput(
    skattepligtigt_overskud_før_vsl22b_kroner = 300000,
    renteudgifter_kroner = 20000,
    kurstab_kroner = 10000,
    renteindtægter_kroner = 5000,
    udbytteindtægter_kroner = 15000,
    kursgevinster_kroner = 10000,
    udelukkede_afståelsesindkomster_kroner = 0
)

= pension_ingen_indekskontrakter = Pbl18Indeksvalg(
    fradragsvalgte_kontraktbidrag_kroner = []
)

= pension_tomt_par15a_årsgrundlag = Pbl15AÅrsgrundlag(
    afståelser = [],
    ordninger = [],
    kvalifikationsår = [],
    tidligere_indbetalinger = []
)

= pension_standardbegrænsninger = Pbl18Begrænsninger(
    pbl54_personkreds_opfyldt = Sandt,
    afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
    udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Falskt
)

= pension_udenlandsk_overførsel = Pbl18Begrænsninger(
    pbl54_personkreds_opfyldt = Sandt,
    afgiftspligt_for_hele_ordningen_indtrådt = Falskt,
    udenlandsk_overførsel_med_tidligere_fradrag_uden_skatte_eller_afgiftskonsekvens = Sandt
)

= pension_par16_rate_2026 = pbl16_fradragsloft_resultat(Pbl16FradragsloftInput(
    indkomstår = 2026,
    art = Pbl16Rateordning
))

= pension_par16_kapital_2026 = pbl16_fradragsloft_resultat(Pbl16FradragsloftInput(
    indkomstår = 2026,
    art = Pbl16Kapitalordning
))

= pension_rate_med_arbejdsgiver = pbl18_resultat(Pbl18Input(
    indkomstår = 2026,
    ordning = Pbl18Rateopsparing,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Betaling(
        beløb_kroner = 100000,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsgiverindbetalinger_kroner = 20000,
        arbejdsmarkedsbidrag_i_arbejdsgiverindbetalinger_kroner = 1600
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = pension_ingen_indekskontrakter,
    fradragsramme = Pbl18Fradragsramme(
        personlig_indkomst_før_pensionsfradrag_kroner = 600000,
        forfaldne_ikke_tidligere_fratrukket_kroner = 100000,
        selvstændig_overskud = pension_intet_selvstændigt_overskud,
        valg = Pbl18FordeltFradrag
    ),
    begrænsninger = pension_standardbegrænsninger
))

= pension_livrente_opfyldningsfradrag = pbl18_resultat(Pbl18Input(
    indkomstår = 2026,
    ordning = Pbl18LivsvarigLivrente,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Betaling(
        beløb_kroner = 200000,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsgiverindbetalinger_kroner = 0,
        arbejdsmarkedsbidrag_i_arbejdsgiverindbetalinger_kroner = 0
    ),
    fordelingsforløb = Pbl18Kapitalindskud(
        indskudsår = 2026,
        indskud_kroner = 200000
    ),
    indeksvalg = pension_ingen_indekskontrakter,
    fradragsramme = Pbl18Fradragsramme(
        personlig_indkomst_før_pensionsfradrag_kroner = 600000,
        forfaldne_ikke_tidligere_fratrukket_kroner = 200000,
        selvstændig_overskud = pension_intet_selvstændigt_overskud,
        valg = Pbl18Grundbeløbsvalg(ønsket_fradrag_kroner = 100000)
    ),
    begrænsninger = pension_standardbegrænsninger
))

= pension_livrente_selvstændig_30_pct = pbl18_resultat(Pbl18Input(
