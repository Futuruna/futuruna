))

= pension_udenlandsk_overførsel_uden_fradrag = pbl18_resultat(Pbl18Input(
    indkomstår = 2026,
    ordning = Pbl18LivsvarigLivrente,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Betaling(
        beløb_kroner = 50000,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsgiverindbetalinger_kroner = 0,
        arbejdsmarkedsbidrag_i_arbejdsgiverindbetalinger_kroner = 0
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = pension_ingen_indekskontrakter,
    fradragsramme = Pbl18Fradragsramme(
        personlig_indkomst_før_pensionsfradrag_kroner = 600000,
        forfaldne_ikke_tidligere_fratrukket_kroner = 50000,
        selvstændig_overskud = pension_intet_selvstændigt_overskud,
        valg = Pbl18FordeltFradrag
    ),
    begrænsninger = pension_udenlandsk_overførsel
))

| pension_par15a_regnskabsperiode(indkomstår: Heltal, rækkefølge: Heltal) -> Pbl15ARegnskabsperiode(
    rækkefølge_fra_ældste = rækkefølge,
    startdato = Pbl15ADato(år = indkomstår, måned = 1, dag = 1),
    slutdato = Pbl15ADato(år = indkomstår, måned = 12, dag = 31),
    virksomhedens_indtægter = [
        Pbl15AIndtægtspost(
            identifikation = "aktiv-drift",
            beløb_kroner = 1000000,
            art = Pbl15AØvrigDriftsindtægt
        )
    ],
    virksomhedens_aktiver = [
        Pbl15AAktivpost(
            identifikation = "driftsaktiv",
            handelsværdi_kroner = 2000000,
            art = Pbl15AØvrigtDriftsaktiv
        )
    ],
    selskabsregnskaber = []
)

= pension_par15a_årsgrundlag = Pbl15AÅrsgrundlag(
    afståelser = [
        Pbl15AAfståelsesfakta(
            identifikation = "virksomhedsafståelse-2026",
            afståelsesdato = Pbl15ADato(år = 2026, måned = 7, dag = 1),
            grundlag = Pbl15AHovedaktionæraktier,
            fortjenestegrundlag = pbl15a_fixture_hovedaktionær_fortjenestegrundlag("virksomhedsafståelse-2026", 80000),
            alder_hele_år_ved_afståelsen = 60,
            passiv_kapital = Pbl15APassivKapitalFakta(
                seneste_tre_regnskabsperioder = [
                    pension_par15a_regnskabsperiode(2023, 1),
                    pension_par15a_regnskabsperiode(2024, 2),
                    pension_par15a_regnskabsperiode(2025, 3)
                ],
                aktuel_regnskabsperiodes_startdato = Pbl15ADato(år = 2026, måned = 1, dag = 1),
                virksomhedens_aktiver_på_overdragelsestidspunktet = [
                    Pbl15AAktivpost(
                        identifikation = "driftsaktiv-ved-afståelse",
                        handelsværdi_kroner = 2000000,
                        art = Pbl15AØvrigtDriftsaktiv
                    )
                ],
                selskabsaktiver_på_overdragelsestidspunktet = [],
                holdingforløb = pbl15a_uden_holdingforløb(),
                næringsvirksomhed_med_værdipapirer_eller_finansiering = Falskt
            ),
            udlejning_af_afskrivningsberettigede_driftsmidler_eller_skibe = Falskt,
            antal_ejere = 1,
            opretter_deltog_i_driften_i_væsentligt_omfang = Sandt
        )
    ],
    ordninger = [
        Pbl15AOrdningsfakta(
            identifikation = "ophørspension-2026",
            oprettelsesår = 2026,
            art = Pbl15ARateopsparing,
            oprettelsesafståelse_identifikation = "virksomhedsafståelse-2026"
        )
    ],
    kvalifikationsår = [
        Pbl15AKvalifikationsår(indkomstår = 2016, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2017, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2018, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2019, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2020, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2021, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2022, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2023, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2024, grundlag = Pbl15AEgetHovedaktionærforhold),
        Pbl15AKvalifikationsår(indkomstår = 2025, grundlag = Pbl15AEgetHovedaktionærforhold)
    ],
    tidligere_indbetalinger = []
)

= pension_par15a_indbetaling = Pbl18Årsindbetaling(
    identifikation = "ophørspensionsindbetaling-2026",
    ordning = Pbl18Par15ARateordning,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = 80000,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18Par15AAfståelsesår(
            fradragsår = 2026,
            indbetalt_senest_1_juli_efterfølgende = Sandt
        ),
        arbejdsmarkedsbidrag_kroner = 0
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = pension_ingen_indekskontrakter,
    indeksordningsgrundlag = Pbl18IkkeIndeksordning,
    forfaldne_ikke_tidligere_fratrukket_kroner = 80000,
    særligt_ordningsgrundlag = Pbl18Par15AIndbetalingsgrundlag(
        ordning_identifikation = "ophørspension-2026",
        afståelse_identifikation = "virksomhedsafståelse-2026"
    ),
    begrænsninger = pension_standardbegrænsninger
)

= pension_par15a = pbl18_årsresultat(Pbl18Årsinput(
    indkomstår = 2026,
    personlig_indkomst_før_pensionsfradrag_kroner = 600000,
    selvstændig_overskud = pension_intet_selvstændigt_overskud,
    livrentevalg = Pbl18FordeltFradrag,
    par15a_årsgrundlag = pension_par15a_årsgrundlag,
    par15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    indbetalinger = [pension_par15a_indbetaling]
))

= pension_aktiefradragsvalg = par4a_pensionsfradrag_valg_resultat(AktiePensionsFradragValgInput(
    indkomstår = 2026,
    ønsket_fradrag_kroner = 20000,
    meddelelse_dato_yyyymmdd = 20260630,
    omgørelse_dato_yyyymmdd = 0,
    personlig_indkomst_status = IkkeFradragetIPersonligIndkomst
))

= pension_aktiefradrag = par4a_pensionsfradrag_resultat(AktiePensionsFradragInput(
    aktieindkomst_efter_stk1_og_2_kroner = 50000,
    pbl15a_grundlag = par4a_pbl15a_grundlag_fra_pbl18_år(pension_par15a),
    valg_resultat = pension_aktiefradragsvalg
))

= pension_par3_par15a = par3_stk2_nr3_resultat(Par3Stk2Nr3Input(
    grundlag = Par3Nr3Pbl18År(resultat = pension_par15a),
    aktiepensionsfradrag_resultat = pension_aktiefradrag
))

= pension_par3_almindelig_rate = par3_stk2_nr3_resultat(Par3Stk2Nr3Input(
    grundlag = Par3Nr3Pbl18(resultat = pension_rate_med_arbejdsgiver),
    aktiepensionsfradrag_resultat = pension_aktiefradrag
))

= pension_fond_godkendt = pbl52_resultat(Pbl52Input(
    arbejdsgiverbidrag_kroner = 40000,
    fond = Pbl52FondVilkår(
        modtagerkreds = [Pbl52TidligereAnsat, Pbl52EfterladtÆgtefælle, Pbl52BarnUnder24],
        har_andet_formål = Falskt,
        midler_anbragt_efter_firmapensionskasseregler = Sandt,
        medarbejdervalgt_bestyrelsesmedlem_opfyldt = Sandt
    )
))

= pension_fond_anden_modtager = pbl52_resultat(Pbl52Input(
    arbejdsgiverbidrag_kroner = 40000,
    fond = Pbl52FondVilkår(
        modtagerkreds = [Pbl52TidligereAnsat, Pbl52AndenModtager],
        har_andet_formål = Falskt,
        midler_anbragt_efter_firmapensionskasseregler = Sandt,
        medarbejdervalgt_bestyrelsesmedlem_opfyldt = Sandt
    )
))

= pension_par3_fond = par3_stk2_nr3_resultat(Par3Stk2Nr3Input(
    grundlag = Par3Nr3Pbl52(resultat = pension_fond_godkendt),
    aktiepensionsfradrag_resultat = pension_aktiefradrag
))

= pension_personlig_indkomst = par3_personlig_indkomst_resultat(Par3PersonligIndkomstInput(
    indkomstposter = [
        Par3Indkomstpost(
            indgår_i_skattepligtig_indkomst = Sandt,
            er_kapitalindkomst = Falskt,
            beløb_kroner = 200000
        )
    ],
    stk2_nr1_udgifter = [],
    stk2_nr2_input = Par3Stk2Nr2Input(poster = []),
    stk2_nr3_til_11_input = Par3Stk2Nr3Til11Input(poster = [
        Par3Stk2Nr3Post(resultat = par3_stk2_nr3_resultat(Par3Stk2Nr3Input(
            grundlag = Par3Nr3Pbl18År(resultat = pension_par15a),
            aktiepensionsfradrag_resultat = pension_aktiefradrag
        )))
    ])
))

| pension_årsrateindbetaling(identifikation: Tekst, indbetalingskilde: Pbl18Indbetalingskilde, beløb_kroner: Heltal, arbejdsmarkedsbidrag_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = identifikation,
    ordning = Pbl18Rateopsparing,
    indbetalingskilde = indbetalingskilde,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = beløb_kroner,
        forfaldsår = 2026,
        betalingsår = 2026,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsmarkedsbidrag_kroner = arbejdsmarkedsbidrag_kroner
    ),
    fordelingsforløb = Pbl18IngenTiårsfordeling,
    indeksvalg = pension_ingen_indekskontrakter,
    indeksordningsgrundlag = Pbl18IkkeIndeksordning,
    forfaldne_ikke_tidligere_fratrukket_kroner = beløb_kroner,
    særligt_ordningsgrundlag = Pbl18IntetSærligtOrdningsgrundlag,
    begrænsninger = pension_standardbegrænsninger
)
| pension_årslivrenteindbetaling_med_resterende_fradragsramme(identifikation: Tekst, indskudsår: Heltal, indskud_kroner: Heltal, resterende_fradragsramme_kroner: Heltal) -> Pbl18Årsindbetaling(
    identifikation = identifikation,
    ordning = Pbl18LivsvarigLivrente,
    indbetalingskilde = Pbl18EgenIndbetaling,
    fradragsretshaver = Pbl18OrdningensEjer,
    betaling = Pbl18Årsbetaling(
        beløb_kroner = indskud_kroner,
        forfaldsår = indskudsår,
        betalingsår = indskudsår,
        betalt_senest_bankjusteret_1_april_efter_forfald = Sandt,
        hidrører_fra_par22e_tilbagebetaling = Falskt,
        par15a_fradragsplacering = Pbl18IkkePar15APlacering,
        arbejdsmarkedsbidrag_kroner = 0
    ),
    fordelingsforløb = Pbl18Kapitalindskud(
        indskudsår = indskudsår,
        indskud_kroner = indskud_kroner
    ),
    indeksvalg = pension_ingen_indekskontrakter,
    indeksordningsgrundlag = Pbl18IkkeIndeksordning,
    forfaldne_ikke_tidligere_fratrukket_kroner = resterende_fradragsramme_kroner,
    særligt_ordningsgrundlag = Pbl18IntetSærligtOrdningsgrundlag,
    begrænsninger = pension_standardbegrænsninger
)
| pension_årslivrenteindbetaling(identifikation: Tekst, indskud_kroner: Heltal) -> pension_årslivrenteindbetaling_med_resterende_fradragsramme(
    identifikation = identifikation,
    indskudsår = 2026,
    indskud_kroner = indskud_kroner,
    resterende_fradragsramme_kroner = indskud_kroner
)

= pension_årsrate_med_fælles_loft = pbl18_årsresultat(Pbl18Årsinput(
    indkomstår = 2026,
    personlig_indkomst_før_pensionsfradrag_kroner = 600000,
    selvstændig_overskud = pension_intet_selvstændigt_overskud,
    livrentevalg = Pbl18FordeltFradrag,
    par15a_årsgrundlag = pension_tomt_par15a_årsgrundlag,
    par15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    indbetalinger = [
        pension_årsrateindbetaling("Arbejdsgiverordning", Pbl18Arbejdsgiverindbetaling, 40000, 3200),
        pension_årsrateindbetaling("Privat rate A", Pbl18EgenIndbetaling, 40000, 0),
        pension_årsrateindbetaling("Privat rate B", Pbl18EgenIndbetaling, 50000, 0)
    ]
))

= pension_årslivrenter_med_fælles_opfyldning = pbl18_årsresultat(Pbl18Årsinput(
    indkomstår = 2026,
    personlig_indkomst_før_pensionsfradrag_kroner = 600000,
    selvstændig_overskud = pension_intet_selvstændigt_overskud,
    livrentevalg = Pbl18Grundbeløbsvalg(ønsket_fradrag_kroner = 100000),
    par15a_årsgrundlag = pension_tomt_par15a_årsgrundlag,
    par15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    indbetalinger = [
        pension_årslivrenteindbetaling("Livrente A", 100000),
        pension_årslivrenteindbetaling("Livrente B", 100000)
    ]
))

= pension_årslivrente_med_begrænset_resterende_fradragsramme = pbl18_årsresultat(Pbl18Årsinput(
    indkomstår = 2026,
    personlig_indkomst_før_pensionsfradrag_kroner = 600000,
    selvstændig_overskud = pension_intet_selvstændigt_overskud,
    livrentevalg = Pbl18FordeltFradrag,
    par15a_årsgrundlag = pension_tomt_par15a_årsgrundlag,
    par15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    indbetalinger = [
        pension_årslivrenteindbetaling_med_resterende_fradragsramme(
            identifikation = "Livrente med næsten opbrugt fradragsramme",
            indskudsår = 2017,
            indskud_kroner = 100000,
            resterende_fradragsramme_kroner = 5000
        )
    ]
))

= pension_årsinput_med_dublet = pbl18_årsresultat(Pbl18Årsinput(
    indkomstår = 2026,
    personlig_indkomst_før_pensionsfradrag_kroner = 600000,
    selvstændig_overskud = pension_intet_selvstændigt_overskud,
    livrentevalg = Pbl18FordeltFradrag,
    par15a_årsgrundlag = pension_tomt_par15a_årsgrundlag,
    par15b_årsgrundlag = pbl15b_tomt_årsgrundlag(),
    indbetalinger = [
        pension_årsrateindbetaling("Samme ordning", Pbl18EgenIndbetaling, 20000, 0),
        pension_årsrateindbetaling("Samme ordning", Pbl18EgenIndbetaling, 30000, 0)
    ]
))

| pension_par16_rate_loft_2026: pension_par16_rate_2026 -> pension_par16_rate_2026.understøttet_indkomstår && pension_par16_rate_2026.grundbeløb_2010_niveau_kroner == 50000 && pension_par16_rate_2026.reguleret_bruttoloft_kroner == 68700
| pension_par16_kapital_loft_bortfaldet: pension_par16_kapital_2026 -> pension_par16_kapital_2026.grundbeløb_2010_niveau_kroner == 0 && pension_par16_kapital_2026.reguleret_bruttoloft_kroner == 0
| pension_rate_loft_reduceres_efter_stk2: pension_rate_med_arbejdsgiver -> pension_rate_med_arbejdsgiver.par16_reguleret_bruttoloft_kroner == 68700 && pension_rate_med_arbejdsgiver.reducerende_arbejdsgiverindbetalinger_kroner == 18400 && pension_rate_med_arbejdsgiver.fradragsloft_efter_stk2_kroner == 50300 && pension_rate_med_arbejdsgiver.fradrag_i_skattepligtig_indkomst_kroner == 50300
| pension_livrente_fordeles_og_opfyldes: pension_livrente_opfyldningsfradrag -> pension_livrente_opfyldningsfradrag.beregnet_årsfradrag_kroner == 20000 && pension_livrente_opfyldningsfradrag.opfyldningsgrundbeløb_kroner == 63200 && pension_livrente_opfyldningsfradrag.valgt_årsfradrag_kroner == 63200 && pension_livrente_opfyldningsfradrag.fradrag_i_skattepligtig_indkomst_kroner == 63200
| pension_selvstændig_kan_vælge_30_pct: pension_livrente_selvstændig_30_pct -> pension_livrente_selvstændig_30_pct.beregnet_årsfradrag_kroner == 20000 && pension_livrente_selvstændig_30_pct.selvstændig_30_pct_kroner == 90000 && pension_livrente_selvstændig_30_pct.fradrag_i_skattepligtig_indkomst_kroner == 90000
| pension_rettidig_betaling_følger_forfaldsår: pension_rettidig_forfaldsbetaling -> pension_rettidig_forfaldsbetaling.fradragsår == 2025 && pension_rettidig_forfaldsbetaling.grundlæggende_fradragsret && pension_rettidig_forfaldsbetaling.fradrag_i_skattepligtig_indkomst_kroner == 20000
| pension_sen_betaling_følger_betalingsår: pension_sen_betaling -> pension_sen_betaling.fradragsår == 2026 && pension_sen_betaling.grundlæggende_fradragsret && pension_sen_betaling.fradrag_i_skattepligtig_indkomst_kroner == 20000
| pension_indeks_højst_seks_kontrakter: pension_syvende_indekskontrakt_afskåret -> pension_syvende_indekskontrakt_afskåret.indekskontrakter_medregnet == 6 && pension_syvende_indekskontrakt_afskåret.indbetalt_beløb_kroner == 70000 && pension_syvende_indekskontrakt_afskåret.ordningsbeløb_efter_indeksbegrænsning_kroner == 60000 && pension_syvende_indekskontrakt_afskåret.fradrag_i_skattepligtig_indkomst_kroner == 60000 && pension_syvende_indekskontrakt_afskåret.ikke_fratrukket_i_indkomståret_kroner == 10000
| pension_aldersopsparing_har_ikke_fradrag: pension_aldersopsparing_uden_fradrag -> pension_aldersopsparing_uden_fradrag.grundlæggende_fradragsret == Falskt && pension_aldersopsparing_uden_fradrag.fradrag_i_skattepligtig_indkomst_kroner == 0
| pension_udenlandsk_overførsel_afskæres: pension_udenlandsk_overførsel_uden_fradrag -> pension_udenlandsk_overførsel_uden_fradrag.grundlæggende_fradragsret == Falskt && pension_udenlandsk_overførsel_uden_fradrag.fradrag_i_skattepligtig_indkomst_kroner == 0
| pension_fond_betingelser_opfyldt: pension_fond_godkendt -> pension_fond_godkendt.alle_betingelser_opfyldt && pension_fond_godkendt.arbejdsgiverfradrag_i_skattepligtig_indkomst_kroner == 40000
| pension_fond_anden_modtager_afskæres: pension_fond_anden_modtager -> pension_fond_anden_modtager.modtagerkreds_alene_tilladt == Falskt && pension_fond_anden_modtager.arbejdsgiverfradrag_i_skattepligtig_indkomst_kroner == 0
| pension_par15a_dobbeltfradrag_afskæres: pension_par3_par15a -> pension_par3_par15a.hjemmel == Par3Nr3Pensionsbeskatningslov18 && pension_par3_par15a.brutto_fradrag_efter_pensionsbeskatningsloven_kroner == 80000 && pension_par3_par15a.fradrag_i_aktieindkomst_kroner == 20000 && pension_par3_par15a.dobbeltfradrag_afskåret_kroner == 20000 && pension_par3_par15a.fradrag_i_personlig_indkomst_kroner == 60000
| pension_almindelig_rate_er_ikke_par4a_stk4: pension_par3_almindelig_rate -> pension_par3_almindelig_rate.fradrag_i_aktieindkomst_kroner == 0 && pension_par3_almindelig_rate.dobbeltfradrag_afskåret_kroner == 0 && pension_par3_almindelig_rate.fradrag_i_personlig_indkomst_kroner == 50300
| pension_fond_er_ikke_par4a_stk4: pension_par3_fond -> pension_par3_fond.hjemmel == Par3Nr3Pensionsbeskatningslov52 && pension_par3_fond.fradrag_i_aktieindkomst_kroner == 0 && pension_par3_fond.fradrag_i_personlig_indkomst_kroner == 40000
| pension_fradrag_føres_i_personlig_indkomst: pension_personlig_indkomst -> pension_personlig_indkomst.brutto_personlig_indkomst_kroner == 200000 && pension_personlig_indkomst.fradrag_i_personlig_indkomst_kroner == 60000 && pension_personlig_indkomst.netto_personlig_indkomst_kroner == 140000
| pension_årsrate_deler_loft_efter_arbejdsgiver: pension_årsrate_med_fælles_loft -> pension_årsrate_med_fælles_loft.input_gyldigt && pension_årsrate_med_fælles_loft.arbejdsgivergrundlag.rate_og_ophørende_brutto_kroner == 40000 && pension_årsrate_med_fælles_loft.arbejdsgivergrundlag.rate_og_ophørende_am_bidrag_kroner == 3200 && pension_årsrate_med_fælles_loft.egne_rate_og_ophørende_før_fælles_loft_kroner == 90000 && pension_årsrate_med_fælles_loft.rate_og_ophørende_fradragsloft_efter_arbejdsgiver_kroner == 31900 && pension_årsrate_med_fælles_loft.rate_og_ophørende_fradrag_kroner == 31900 && pension_årsrate_med_fælles_loft.samlet_fradrag_i_skattepligtig_indkomst_kroner == 31900
| pension_årslivrenter_deler_opfyldningsvalg: pension_årslivrenter_med_fælles_opfyldning -> pension_årslivrenter_med_fælles_opfyldning.input_gyldigt && pension_årslivrenter_med_fælles_opfyldning.livrente_beregnet_årsfradrag_kroner == 20000 && pension_årslivrenter_med_fælles_opfyldning.livrente_valgt_årsfradrag_kroner == 63200 && pension_årslivrenter_med_fælles_opfyldning.samlet_fradrag_i_skattepligtig_indkomst_kroner == 63200
| pension_tiårsfordeling_fortsætter_og_begrænses_af_resterende_fradragsramme: pension_årslivrente_med_begrænset_resterende_fradragsramme -> pension_årslivrente_med_begrænset_resterende_fradragsramme.input_gyldigt && pension_årslivrente_med_begrænset_resterende_fradragsramme.postresultater[0].fradragsår == 2017 && pension_årslivrente_med_begrænset_resterende_fradragsramme.postresultater[0].grundlæggende_fradragsret && pension_årslivrente_med_begrænset_resterende_fradragsramme.livrente_beregnet_årsfradrag_kroner == 10000 && pension_årslivrente_med_begrænset_resterende_fradragsramme.livrente_valgt_årsfradrag_kroner == 5000 && pension_årslivrente_med_begrænset_resterende_fradragsramme.samlet_fradrag_i_skattepligtig_indkomst_kroner == 5000
| pension_årsidentifikationer_skal_være_entydige: pension_årsinput_med_dublet -> pension_årsinput_med_dublet.input_gyldigt == Falskt && pension_årsinput_med_dublet.samlet_fradrag_i_skattepligtig_indkomst_kroner == 0

? pension_par16_rate_loft_2026
? pension_par16_kapital_loft_bortfaldet
? pension_rate_loft_reduceres_efter_stk2
? pension_livrente_fordeles_og_opfyldes
? pension_selvstændig_kan_vælge_30_pct
? pension_rettidig_betaling_følger_forfaldsår
? pension_sen_betaling_følger_betalingsår
? pension_indeks_højst_seks_kontrakter
? pension_aldersopsparing_har_ikke_fradrag
? pension_udenlandsk_overførsel_afskæres
? pension_fond_betingelser_opfyldt
? pension_fond_anden_modtager_afskæres
? pension_par15a_dobbeltfradrag_afskæres
? pension_almindelig_rate_er_ikke_par4a_stk4
? pension_fond_er_ikke_par4a_stk4
? pension_fradrag_føres_i_personlig_indkomst
? pension_årsrate_deler_loft_efter_arbejdsgiver
? pension_årslivrenter_deler_opfyldningsvalg
? pension_tiårsfordeling_fortsætter_og_begrænses_af_resterende_fradragsramme
? pension_årsidentifikationer_skal_være_entydige
