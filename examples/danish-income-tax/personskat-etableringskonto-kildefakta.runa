@ sprog da

@ importer ./kapitel - 01 - indkomst
@ importer ./metadata
@ importer ./source - status

= personskat_etableringskonto_kildefakta_metadata = Metadata(
    attachments = (
        Source(value = etableringskontoloven_lbk1307_par1_par4),
        DependencySource(value = personskatteloven_2021_1284),
    )
)

--@label:personskat_etableringskonto_kildefakta::meta:personskat_etableringskonto_kildefakta_metadata--
--@begin:personskat_etableringskonto_kildefakta--
# PersonskatEtableringskontoInput = UdenEtableringskontoindskud | MedEtableringskontoindskud(input: EtableringskontoIndskudInput)
# PersonskatPersonligIndkomstInput(etableringskonto: PersonskatEtableringskontoInput)
# PersonskatEtableringskontoResultat = IngenEtableringskontoindskud | UgyldigtEtableringskontoindskud(input: EtableringskontoIndskudInput, etableringskontolov_resultat: EtableringskontoIndskudResultat, skatteår_matcher: Boolsk, grundfakta_gyldige: Boolsk) | BeregnetEtableringskontoindskud(input: EtableringskontoIndskudInput, etableringskontolov_resultat: EtableringskontoIndskudResultat, par3_stk2_nr11_resultat: Par3Stk2Nr11Resultat)
# PersonskatPersonligIndkomstResultat(input: PersonskatPersonligIndkomstInput, etableringskonto: PersonskatEtableringskontoResultat, alle_input_gyldige: Boolsk, fradrag_i_personlig_indkomst_kroner: Heltal, ligningsmæssigt_fradrag_kroner: Heltal)

| personskat_ingen_personlig_indkomst() -> PersonskatPersonligIndkomstInput(
    etableringskonto = UdenEtableringskontoindskud
)

# PersonskatEtableringskontoSag(input: EtableringskontoIndskudInput, skatteår: Heltal) {
    | skatteår_matcher() -> input.indkomstår == skatteår
    | fasegrundlag_gyldigt() -> match input.fase {
        | EtblEfterEtablering(antal_år) -> antal_år >= 1
        | _ -> Sandt
    }
    | grundfakta_gyldige() -> fasegrundlag_gyldigt() && all([
        input.kontant_løn_kroner,
        input.skatteværdi_af_frit_ophold_og_andre_goder_kroner,
        input.skattepligtige_arbejdsgivergodtgørelser_kroner,
        input.ligningslov9_til_9d_fradrag_kroner,
        input.skattepligtigt_virksomhedsoverskud_efter_vsl22b_fradrag_kroner,
        input.vsl22b_henlæggelse_kroner,
        input.renteudgifter_og_kurstab_kroner,
        input.rente_udbytte_og_kursgevinst_kroner,
        input.forskudsafskrivning_efter_al29_kroner,
        input.faktisk_etableringskontoindskud_kroner,
        input.faktisk_iværksætterkontoindskud_kroner,
        input.undladt_etableringskontoindskud_efter_par4_stk2_kroner,
        input.undladt_iværksætterkontoindskud_efter_par4_stk2_kroner
        ], |beløb_kroner: Heltal| beløb_kroner >= 0)
    | etableringskontolov_resultat() -> etableringskonto_indskud_resultat(input)
    | par3_resultat() -> par3_stk2_nr11_resultat(Par3Stk2Nr11Input(
        etableringskonto_resultat = etableringskontolov_resultat()
    ))
    | resultat() -> hvis skatteår_matcher() && grundfakta_gyldige() {
        BeregnetEtableringskontoindskud(
            input = input,
            etableringskontolov_resultat = etableringskontolov_resultat(),
            par3_stk2_nr11_resultat = par3_resultat()
        )
    } ellers {
        UgyldigtEtableringskontoindskud(
            input = input,
            etableringskontolov_resultat = etableringskontolov_resultat(),
            skatteår_matcher = skatteår_matcher(),
            grundfakta_gyldige = grundfakta_gyldige()
        )
    }
}

| personskat_etableringskonto_resultat(input: PersonskatEtableringskontoInput, skatteår: Heltal) -> match input {
    | UdenEtableringskontoindskud -> IngenEtableringskontoindskud
    | MedEtableringskontoindskud(etableringskonto_input) -> PersonskatEtableringskontoSag(etableringskonto_input, skatteår).resultat()
}
| personskat_etableringskonto_input_gyldigt(resultat: PersonskatEtableringskontoResultat) -> match resultat {
    | UgyldigtEtableringskontoindskud(_, _, _, _) -> Falskt
    | _ -> Sandt
}
| personskat_etableringskonto_personligt_fradrag_kroner(resultat: PersonskatEtableringskontoResultat) -> match resultat {
    | BeregnetEtableringskontoindskud(_, _, par3_resultat) -> par3_resultat.fradrag_i_personlig_indkomst_kroner
    | _ -> 0
}
| personskat_etableringskonto_ligningsfradrag_kroner(resultat: PersonskatEtableringskontoResultat) -> match resultat {
    | BeregnetEtableringskontoindskud(_, _, par3_resultat) -> par3_resultat.etableringskonto_fradrag_uden_for_personlig_indkomst_kroner
    | _ -> 0
}

# PersonskatPersonligIndkomstSag(input: PersonskatPersonligIndkomstInput, skatteår: Heltal) {
    | etableringskonto() -> personskat_etableringskonto_resultat(input.etableringskonto, skatteår)
    | resultat() -> PersonskatPersonligIndkomstResultat(
        input = input,
        etableringskonto = etableringskonto(),
        alle_input_gyldige = personskat_etableringskonto_input_gyldigt(etableringskonto()),
        fradrag_i_personlig_indkomst_kroner = personskat_etableringskonto_personligt_fradrag_kroner(etableringskonto()),
        ligningsmæssigt_fradrag_kroner = personskat_etableringskonto_ligningsfradrag_kroner(etableringskonto())
    )
}

| personskat_personlig_indkomst_resultat(input: PersonskatPersonligIndkomstInput, skatteår: Heltal) -> PersonskatPersonligIndkomstSag(input, skatteår).resultat()
--@end:personskat_etableringskonto_kildefakta--
