-- ============================================================================
-- FIDELITY 1: kapitel-01.runa does not use @ use imports
--
-- Chapters II, III, IV all use `@ use grundlov::*`.
-- Chapter I was written BEFORE imports worked. It duplicates all types.
-- This means Chapter I has its OWN copy of Rigsdel, Institution, etc.
-- If grundlov.runa types change, Chapter I diverges silently.
-- ============================================================================

@ print("--- F1: Chapter I does not use imports ---")
@ print("Chapters II-IV: @ use grundlov::*")
@ print("Chapter I: types duplicated locally")
@ print("Risk: grundlov.runa changes → Chapter I diverges silently")
@ print("Severity: STRUCTURAL — types are incompatible across chapters")
@ print("Fix: add @ use grundlov::* to kapitel-01.runa, remove local type defs")
@ print("")

-- ============================================================================
-- FIDELITY 2: Institution type is redefined in every chapter
--
-- grundlov.runa:  Institution = Kongen | Folketinget | Domstolene | Folkekirken | Rigsdagen
-- kapitel-02.runa: + Statsraadet
-- kapitel-03.runa: + Statsraadet + Rigsretten + Ministerraadet
-- kapitel-04.runa: uses grundlov (no extension)
--
-- Each chapter creates a DIFFERENT Institution type.
-- A function from Chapter II cannot accept a Chapter III Institution.
-- This is a fundamental limitation of our current approach.
-- ============================================================================

@ print("--- F2: Institution type redefined per chapter ---")
@ print("grundlov.runa:   Kongen | Folketinget | Domstolene | Folkekirken | Rigsdagen")
@ print("kapitel-02.runa: + Statsraadet")
@ print("kapitel-03.runa: + Statsraadet + Rigsretten + Ministerraadet")
@ print("kapitel-04.runa: (uses grundlov, no extension)")
@ print("Problem: types are INCOMPATIBLE across chapters")
@ print("A cross-chapter function like 'kan_tiltale(institution)' would need")
@ print("the UNION of all Institution variants — which doesn't exist.")
@ print("Severity: STRUCTURAL — reveals need for open/extensible types in Futuruna")
@ print("")

