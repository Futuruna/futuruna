--
-- This is the second pass. The first (analyse.runa) found 10 issues in
-- Chapters I-II. Now we have 34 paragraphs encoded and can see patterns
-- that only emerge at scale.
-- ============================================================================

@ use grundlov::*

-- Types needed for cross-chapter analysis
# Institution = Kongen | Folketinget | Domstolene | Folkekirken | Rigsdagen | Statsraadet | Rigsretten | Ministerraadet
# Statsmagt = Lovgivende | Udovende | Dommende
# Ansvarstype = AnsvarsFri | Ansvarlig
# Samtykke = Givet | IkkeGivet
# Trossamfund = EvangeliskLuthersk | Andet(navn: String)
# Magtholder = Hos(institution: Institution) | IForening(a: Institution, b: Institution)

-- Fidelity scoring
# Fidelitet = Trofast | Forenkling | Udeladelse | Fejl
# Alvor = Kosmetisk | Strukturel | Meningsaendrende

