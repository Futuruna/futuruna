-- ============================================================================

@ print("--- F8: § 27 transfer requires pension choice, not just no income loss ---")
@ print("Text: 'valget imellem saadan forflytning og afsked med pension'")
@ print("Our code: only checks tab_i_indtaegt (income loss)")
@ print("Missing: must also offer pension as alternative")
@ print("The civil servant gets a CHOICE: accept transfer OR take pension")
@ print("Severity: STRUKTUREL — changes the rights analysis")
