-- ============================================================================
-- VERIFIKATION 1: § 85 MILITÆRUNDTAGELSEN
--
-- § 85 siger: militæret KAN begrænse §§ 71, 78, 79
-- § 85 siger: militæret KAN IKKE begrænse §§ 72, 73, 77
--
-- Importerede regler fra kapitel-08:
--   personlig_frihed_ukrænkelig(), bolig_ukrænkelig(),
--   ytringsfrihed(), censur_tilladt(),
--   foreningsfrihed_forudgående_tilladelse(),
--   adelsforrettigheder_eksisterer()
-- ============================================================================

# Paragraf = P71 | P72 | P73 | P74 | P77 | P78 | P79

-- § 85: Kan militæret begrænse denne rettighed?
> militæret_kan_begrænse(p: Paragraf) -> Bool {
    skel p {
        | P71 -> Sandt    -- personlig frihed: JA (kan låses inde)
        | P78 -> Sandt    -- foreningsfrihed: JA (kan forbyde foreninger)
        | P79 -> Sandt    -- forsamlingsfrihed: JA (kan forbyde forsamlinger)
        | P72 -> Falskt   -- boligens ukrænkelighed: NEJ
        | P73 -> Falskt   -- ejendomsret: NEJ
        | P74 -> Falskt   -- erhvervsfrihed: NEJ
        | P77 -> Falskt   -- ytringsfrihed: NEJ
    }
}

@ skriv("""
================================================================
  VERIFIKATION AF GRUNDLOVEN
  Krydskontrol på tværs af 11 kapitler
================================================================

===  VERIFIKATION 1: § 85 MILITÆRUNDTAGELSEN  ===

Importerede regler fra kapitel-08:
  Personlig frihed ukrænkelig (§ 71): {{personlig_frihed_ukrænkelig()}}
  Bolig ukrænkelig (§ 72): {{bolig_ukrænkelig()}}
  Ytringsfrihed (§ 77): {{ytringsfrihed()}}
  Censur tilladt (§ 77): {{censur_tilladt()}}

Militæret KAN begrænse:
