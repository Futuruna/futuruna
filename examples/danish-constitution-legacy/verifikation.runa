DEN ENESTE IKKE-PARLAMENTARISKE SAMTYKKE:
  § 27: tjenestemanden selv. Alle andre → Folketinget.
""")


-- ============================================================================
-- VERIFIKATION 3: § 77 vs § 88 — PARADOKSET
--
-- Importerede regler:
--   kapitel-08: censur_tilladt() -> Falskt
--   kapitel-10: har_evighedsklausul() -> Falskt
-- ============================================================================

-- § 88 siger enhver bestemmelse kan ændres
> paragraf_88_kan_ændre_77() -> Bool {
    -- Hvis ENHVER bestemmelse kan ændres (kapitel-10: ingen evighedsklausul),
    -- så kan § 77 ændres.
    hvis har_evighedsklausul() { Falskt } ellers { Sandt }
}

-- § 77 siger censur aldrig kan genindføres
> paragraf_77_blokerer_88() -> Bool {
    -- Censur er IKKE tilladt (kapitel-08), og det er permanent ("ingensinde").
    -- Hvis § 77 er absolut, kan § 88 ikke røre den.
    hvis censur_tilladt() { Falskt } ellers { Sandt }
}

-- Er der en modsigelse?
> paradoks_eksisterer() -> Bool {
    hvis paragraf_88_kan_ændre_77() {
        hvis paragraf_77_blokerer_88() { Sandt }
        ellers { Falskt }
    } ellers { Falskt }
}

@ skriv("""
===  VERIFIKATION 3: § 77 vs § 88 — PARADOKSET  ===

IMPORTEREDE REGLER:
  Censur tilladt (kapitel-08, § 77): {{censur_tilladt()}}
  Har evighedsklausul (kapitel-10, § 88): {{har_evighedsklausul()}}

KAN § 88 ÆNDRE § 77?
  § 88 siger ja (ingen evighedsklausul): {{paragraf_88_kan_ændre_77()}}

KAN § 77 BLOKERE § 88?
  § 77 siger ja (censur aldrig tilladt): {{paragraf_77_blokerer_88()}}

PARADOKS EKSISTERER: {{paradoks_eksisterer()}}

  Hvis § 88 vinder: 'ingensinde' var en løgn fra starten.
  Hvis § 77 vinder: § 88 er ufuldstændig — den når ikke alle bestemmelser.
  Grundloven modsiger sig selv. Bevidst? Sandsynligvis.

  'Vi mener det skal vare evigt, men ved vi ikke kan garantere det.'
""")


-- ============================================================================
-- VERIFIKATION 4: TERSKELHIERARKIET
--
-- 8 niveauer fra 0 (ingen afstemning) til INF (absolut).
-- Importerede regler fra kapitel-10:
--   regering_kan_blokere() -> Sandt
--   tekst_må_ændres_mellem_vedtagelser() -> Falskt
-- ============================================================================

# TerskelNiveau = N0 | N1 | N2 | N3 | N4 | N5 | N6 | NINF

> terskel_beskrivelse(n: TerskelNiveau) -> String {
    skel n {
        | N0 -> "Ingen afstemning (§ 19 selvforsvar)"
        | N1 -> "Simpelt flertal (samtykke, 8 tilfælde)"
        | N2 -> "2/5 minoritet forsinker (§§ 39, 41)"
        | N3 -> "1/3 minoritet fremtvinger valg/afstemning (§§ 42, 73)"
        | N4 -> "5/6 superflertal (§ 20 suverænitetsafgivelse)"
        | N5 -> "§ 88: 2× Folketing + nyvalg + 40% folkeafstemning"
        | N6 -> "'Ingensinde' (§ 77 — sprogligt absolut)"
        | NINF -> "Sande absolutter (§ 10.2, § 13, § 34)"
    }
}

> terskel_minimum_pct(n: TerskelNiveau) -> Int {
    skel n {
        | N0 -> 0
        | N1 -> 51
        | N2 -> 60
        | N3 -> 67
        | N4 -> 84
        | N5 -> 90
        | N6 -> 100
        | NINF -> 100
    }
}

> niveau_er_strengere(lavere: TerskelNiveau, højere: TerskelNiveau) -> Bool {
    terskel_minimum_pct(højere) > terskel_minimum_pct(lavere)
}

@ skriv("""
