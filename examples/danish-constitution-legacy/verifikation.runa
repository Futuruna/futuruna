-- ============================================================================
-- VERIFIKATION 2: SAMTYKKE-REVISION
--
-- Påstand: Der er præcis 8 samtykke-instanser i grundloven.
-- ============================================================================

> samtykke_paragraf(nr: Int) -> String {
    skel nr {
        | 1 -> "§ 5: Regent i udlandet → Folketinget"
        | 2 -> "§ 11: Årpenge i udlandet → Folketinget"
        | 3 -> "§ 19.1: Territorium/forpligtelser → Folketinget"
        | 4 -> "§ 19.2: Militær magt → Folketinget"
        | 5 -> "§ 20: Suverænitetsafgivelse → 5/6 eller folkeafstemning"
        | 6 -> "§ 24: Benådning rigsretsminister → Folketinget"
        | 7 -> "§ 27: Overflytning tjenestemand → tjenestemanden"
        | 8 -> "§ 60: Rigsretstiltale → Folketinget"
        | _ -> "UKENDT — FEJL!"
    }
}

