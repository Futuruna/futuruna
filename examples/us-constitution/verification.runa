= rep_min_age = 25
= sen_min_age = 30
= pres_min_age = 35
= rep_min_cit = 7
= sen_min_cit = 9

| age_ladder_rep_sen: rep_min_age -> rep_min_age < sen_min_age
| age_ladder_sen_pres: sen_min_age -> sen_min_age < pres_min_age
| cit_ladder_rep_sen: rep_min_cit -> rep_min_cit < sen_min_cit

= house_term = 2
= senate_term = 6
| term_ladder: house_term -> house_term < senate_term

? age_ladder_rep_sen -> { @ print("? Rep age < Senator age:         VERIFIED") } else { @ print("? Rep age < Senator age:         FAILED") }
? age_ladder_sen_pres -> { @ print("? Senator age < President age:   VERIFIED") } else { @ print("? Senator age < President age:   FAILED") }
? cit_ladder_rep_sen -> { @ print("? Rep citizen < Senator citizen:  VERIFIED") } else { @ print("? Rep citizen < Senator citizen:  FAILED") }
? term_ladder -> { @ print("? House term < Senate term:      VERIFIED") } else { @ print("? House term < Senate term:      FAILED") }

| house_more_replaceable: house_term -> entire_house_replaceable_at_once() == True
| senate_not_replaceable: senate_term -> entire_senate_replaceable_at_once() == False

? house_more_replaceable -> { @ print("? House fully replaceable:       VERIFIED") } else { @ print("? House fully replaceable:       FAILED") }
? senate_not_replaceable -> { @ print("? Senate NOT fully replaceable:  VERIFIED") } else { @ print("? Senate NOT fully replaceable:  FAILED") }

> impeachment_bodies_separated() -> Bool {
    match impeachment_power() {
        | ExclusiveChamber(House) -> match impeachment_trial_power() {
            | ExclusiveChamber(Senate) -> True
            | _ -> False
        }
        | _ -> False
    }
}

= separated = impeachment_bodies_separated()
| bodies_separated: separated -> separated == True
? bodies_separated -> { @ print("? Accuser != Trier:              VERIFIED") } else { @ print("? Accuser != Trier:              FAILED") }

= leg_enum = legislative_power_is_enumerated()
= exec_enum = executive_power_is_enumerated()
| legislative_is_limited: leg_enum -> leg_enum == True
| executive_is_unlimited: exec_enum -> exec_enum == False

? legislative_is_limited -> { @ print("? Legislative IS enumerated:     VERIFIED") } else { @ print("? Legislative IS enumerated:     FAILED") }
? executive_is_unlimited -> { @ print("? Executive NOT enumerated:      VERIFIED") } else { @ print("? Executive NOT enumerated:      FAILED") }

= house_appoint = house_can_appoint()
= gov_appoint = governor_can_appoint_representative()
| no_house_appointment: house_appoint -> house_appoint == False
| no_gov_appointment: gov_appoint -> gov_appoint == False

? no_house_appointment -> { @ print("? House cannot appoint:          VERIFIED") } else { @ print("? House cannot appoint:          FAILED") }
? no_gov_appointment -> { @ print("? Governor cannot appoint:       VERIFIED") } else { @ print("? Governor cannot appoint:       FAILED") }

> vp_conflict_resolved() -> Bool {
    match presiding_officer_presidential_trial() {
        | ChiefJustice -> True
        | VicePresident -> False
    }
}

= conflict_resolved = vp_conflict_resolved()
| no_vp_conflict: conflict_resolved -> conflict_resolved == True
? no_vp_conflict -> { @ print("? VP excluded from pres. trial:  VERIFIED") } else { @ print("? VP excluded from pres. trial:  FAILED") }

= three_fifths_active = three_fifths_clause_in_effect()
| clause_superseded: three_fifths_active -> three_fifths_active == False

= rep_tax_linked = representation_linked_to_taxation()
= taxes_collected = direct_taxes_commonly_levied()
| rep_tax_link: rep_tax_linked -> rep_tax_linked == True
| tax_toothless: taxes_collected -> taxes_collected == False

? clause_superseded -> { @ print("? Three-Fifths superseded:       VERIFIED") } else { @ print("? Three-Fifths superseded:       FAILED") }
? rep_tax_link -> { @ print("? Representation linked to tax:  VERIFIED") } else { @ print("? Representation linked to tax:  FAILED") }
? tax_toothless -> { @ print("? Direct taxes rarely levied:    VERIFIED") } else { @ print("? Direct taxes rarely levied:    FAILED") }

= r_exact_age = qualifies_as_representative(25, 7, True)
= r_under_age = qualifies_as_representative(24, 7, True)
= r_exact_cit = qualifies_as_representative(25, 7, True)
= r_under_cit = qualifies_as_representative(25, 6, True)
= r_no_state = qualifies_as_representative(25, 7, False)

| r_exact_passes: r_exact_age -> r_exact_age == True
| r_under_fails: r_under_age -> r_under_age == False
| r_cit_exact_passes: r_exact_cit -> r_exact_cit == True
| r_cit_under_fails: r_under_cit -> r_under_cit == False
| r_no_state_fails: r_no_state -> r_no_state == False

? r_exact_passes -> { @ print("? Rep age 25 (exact):            PASS") } else { @ print("? Rep age 25 (exact):            FAIL") }
? r_under_fails -> { @ print("? Rep age 24 (below):            REJECTED") } else { @ print("? Rep age 24 (below):            ERROR") }
? r_cit_exact_passes -> { @ print("? Rep citizen 7yr (exact):       PASS") } else { @ print("? Rep citizen 7yr (exact):       FAIL") }
? r_cit_under_fails -> { @ print("? Rep citizen 6yr (below):       REJECTED") } else { @ print("? Rep citizen 6yr (below):       ERROR") }
? r_no_state_fails -> { @ print("? Rep non-inhabitant:            REJECTED") } else { @ print("? Rep non-inhabitant:            ERROR") }

