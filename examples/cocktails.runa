-- === WHAT CAN I MIX? ===

@ print("=== Mixable cocktails ===")

= cocktails = distinct(findall(c, needs(c, _)))

for c in cocktails {
    = ingredients = findall(i, needs(c, i))
    = missing = filter(ingredients, |i| not(have(i)))
    if length(missing) == 0 {
        @ print(c)
    }
}

-- === SHOPPING LIST ===
-- What single ingredient would unlock a new cocktail?

@ print("")
@ print("=== Shopping list (one buy = one new cocktail) ===")

for c in cocktails {
    = ingredients = findall(i, needs(c, i))
    = missing = filter(ingredients, |i| not(have(i)))
    if length(missing) == 1 {
        @ print("  " + head(missing) + " -> " + c)
    }
}

-- === BEST BUYS ===
-- Rank every missing ingredient by how many recipes it appears in.
-- The top items give you the most optionality.

@ print("")
@ print("=== Best buys (top 10 by versatility) ===")

= all_missing = flat_map(cocktails, |c| filter(findall(i, needs(c, i)), |i| not(have(i))))
= unique_missing = distinct(all_missing)

-- Score each ingredient: 99-count for ascending sort → descending by count
= scored = map(unique_missing, |ing| {
    = count = length(filter(all_missing, |x| x == ing))
    = key = show(99 - count)
    key + "|" + show(count) + "x  " + ing
})
= top = take(sort(scored), 10)

for entry in top {
    @ print("  " + substring(entry, 3, string_length(entry)))
}
