-- parser-e2e.runa — End-to-end test: the self-hosting parser parses the lexer
-- and itself. Run from the repository root: runa run examples/parser-e2e.runa

@ import ./lexer
@ import ./parser

> read_source(path: String) -> String {
    match read_file(path) {
        | Ok(text) -> text
        | Err(e) -> {
            = _ = assert_with_message(false, "cannot read " + path + ": " + e)
            ""
        }
    }
}

-- Tokenize and parse lexer.runa end-to-end
= lexer_src = read_source("examples/lexer.runa")
@ print("Read lexer.runa: " + show(string_length(lexer_src)) + " chars")

= lexer_toks = tokenize(lexer_src)
@ print("Tokenized: " + show(length(lexer_toks)) + " tokens")

= lexer_ast = parse_program(make_state(lexer_toks))
@ print("Parsed: " + show(length(lexer_ast)) + " statements")
@ print("")

for s in lexer_ast {
    @ print("  " + show_stmt(s))
}

@ print("")
@ print("End-to-end: self-hosting parser parses the lexer.")

-- Self-parse: the parser parses itself
= parser_src = read_source("examples/parser.runa")
= parser_toks = tokenize(parser_src)
= parser_ast = parse_program(make_state(parser_toks))

@ print("")
@ print("--- parser.runa (" + show(length(parser_ast)) + " statements) ---")

= fn_count = length(filter(parser_ast, |s| match s { SDefn(_) -> true | _ -> false }))
= type_count = length(filter(parser_ast, |s| match s { SType(_) -> true | _ -> false }))
= bind_count = length(filter(parser_ast, |s| match s { SBind(_, _, _) -> true | _ -> false }))
= for_count = length(filter(parser_ast, |s| match s { SFor(_, _, _) -> true | _ -> false }))
= import_count = length(filter(parser_ast, |s| match s { SImport(_) -> true | _ -> false }))

@ print("  functions: " + show(fn_count))
@ print("  types:     " + show(type_count))
@ print("  bindings:  " + show(bind_count))
@ print("  for loops: " + show(for_count))
@ print("  imports:   " + show(import_count))

@ print("")
@ print("Self-hosting step 5: the parser parses itself.")
