-- lexer.runa — Futuruna self-hosting lexer
-- Tokenizes .runa source into a token stream
-- See lexer-audit.runa for invariants + verification

-- ============================================================================
-- # What exists — token types
-- ============================================================================

# TokenKind = TkKW | TkIdent | TkOp | TkType | TkLParen | TkRParen | TkLBrace | TkRBrace | TkLBracket | TkRBracket | TkSemi | TkDot | TkArrow | TkFatArrow | TkComma | TkColon | TkPipe | TkHash | TkAt | TkGt | TkEq | TkSend | TkTilde | TkPipeGt | TkSafeCall | TkElvis | TkAmp | TkString | TkChar | TkInt | TkFloat | TkBool | TkEof

# Token(kind: TokenKind, text: String, line: Int, col: Int)

-- Lexer state carriers
# Span(pos: Int, line: Int, col: Int, text: String)
# Lexed(pos: Int, line: Int, col: Int, tok: Token)

-- ============================================================================
-- > What happens — character classification
-- ============================================================================

> is_digit(ch: String) -> Bool {
    contains("0123456789", ch) && string_length(ch) == 1
}

> is_alpha(ch: String) -> Bool {
    contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) && string_length(ch) == 1
}

> is_alnum(ch: String) -> Bool {
    is_alpha(ch) || is_digit(ch) || ch == "_"
}

> is_upper(ch: String) -> Bool {
    contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) && string_length(ch) == 1
}

> is_kw(word: String) -> Bool {
    contains(" fn if else for in match return let mut pub use actor spawn ask scope under exception inout comptime from_list import export effect handle perform resume with shared where trait impl module on type do then ", " " + word + " ")
}

-- ============================================================================
-- > What happens — source navigation
-- ============================================================================

> pk(src: String, pos: Int) -> String {
    if pos < string_length(src) { char_at(src, pos) } else { "" }
}

> pk2(src: String, pos: Int) -> String {
    if pos + 1 < string_length(src) { char_at(src, pos + 1) } else { "" }
}

-- ============================================================================
-- > What happens — skip whitespace and comments
-- ============================================================================

> skip_ws(src: String, pos: Int, ln: Int, col: Int) -> Span {
    = ch = pk(src, pos)
    if ch == " " || ch == "\t" || ch == "\r" {
        skip_ws(src, pos + 1, ln, col + 1)
    } else {
        Span(pos, ln, col, "")
    }
}

> skip_line(src: String, pos: Int, ln: Int, col: Int) -> Span {
    = ch = pk(src, pos)
    if ch == "" || ch == "\n" { Span(pos, ln, col, "") }
    else { skip_line(src, pos + 1, ln, col + 1) }
}

> skip_block_inner(src: String, pos: Int, ln: Int, col: Int) -> Span {
    = ch = pk(src, pos)
    if ch == "" { Span(pos, ln, col, "") }
    else if ch == "\n" { skip_block_inner(src, pos + 1, ln + 1, 1) }
    else if ch == "-" && pk2(src, pos) == "-" {
        if pk(src, pos + 2) == "-" && pk(src, pos + 3) == "-" {
            Span(pos + 4, ln, col + 4, "")
        } else {
            skip_block_inner(src, pos + 1, ln, col + 1)
        }
    } else {
        skip_block_inner(src, pos + 1, ln, col + 1)
    }
}

> skip_block(src: String, pos: Int, ln: Int, col: Int) -> Span {
    skip_block_inner(src, pos + 4, ln, col + 4)
}

-- ============================================================================
-- > What happens — read spans (O(n) via substring, not O(n^2) concat)
-- ============================================================================

> read_span(src: String, start: Int, pos: Int, ln: Int, col: Int, pred: String -> Bool) -> Span {
    = ch = pk(src, pos)
    if ch != "" && pred(ch) { read_span(src, start, pos + 1, ln, col + 1, pred) }
    else { Span(pos, ln, col, substring(src, start, pos)) }
}

> read_word(src: String, pos: Int, ln: Int, col: Int) -> Lexed {
    = r = read_span(src, pos, pos, ln, col, |ch| is_alnum(ch))
    = word = r.text
    = kind = if word == "true" || word == "false" { TkBool }
    else if is_kw(word) { TkKW }
    else if is_upper(char_at(word, 0)) { TkType }
    else { TkIdent }
    Lexed(r.pos, r.line, r.col, Token(kind, word, ln, col))
}

> read_number(src: String, pos: Int, ln: Int, col: Int) -> Lexed {
    = r = read_span(src, pos, pos, ln, col, |ch| is_digit(ch))
    if pk(src, r.pos) == "." && is_digit(pk2(src, r.pos)) {
        = r2 = read_span(src, r.pos + 1, r.pos + 1, r.line, r.col + 1, |ch| is_digit(ch))
        Lexed(r2.pos, r2.line, r2.col, Token(TkFloat, r.text + "." + r2.text, ln, col))
    } else {
        Lexed(r.pos, r.line, r.col, Token(TkInt, r.text, ln, col))
    }
}

> read_str_inner(src: String, pos: Int, ln: Int, col: Int, acc: String, sl: Int, sc: Int) -> Lexed {
    = ch = pk(src, pos)
    if ch == "" { Lexed(pos, ln, col, Token(TkString, acc, sl, sc)) }
    else if ch == "\\" {
        = nx = pk2(src, pos)
        = esc = if nx == "n" { "\n" } else if nx == "t" { "\t" } else if nx == "\\" { "\\" } else if nx == "\"" { "\"" } else { "\\" + nx }
        read_str_inner(src, pos + 2, ln, col + 2, acc + esc, sl, sc)
    }
    else if ch == "\"" { Lexed(pos + 1, ln, col + 1, Token(TkString, acc, sl, sc)) }
    else if ch == "\n" { read_str_inner(src, pos + 1, ln + 1, 1, acc + ch, sl, sc) }
    else { read_str_inner(src, pos + 1, ln, col + 1, acc + ch, sl, sc) }
}

> read_str(src: String, pos: Int, ln: Int, col: Int) -> Lexed {
    read_str_inner(src, pos + 1, ln, col + 1, "", ln, col)
}

> read_chr(src: String, pos: Int, ln: Int, col: Int) -> Lexed {
    = ch = pk(src, pos + 1)
    if ch == "\\" {
        = nx = pk(src, pos + 2)
        = esc = if nx == "n" { "\n" } else if nx == "t" { "\t" } else if nx == "\\" { "\\" } else if nx == "'" { "'" } else { nx }
        Lexed(pos + 4, ln, col + 4, Token(TkChar, esc, ln, col))
    } else {
        Lexed(pos + 3, ln, col + 3, Token(TkChar, ch, ln, col))
    }
}

-- ============================================================================
-- > What happens — two-char and one-char classification
-- ============================================================================

-- Two-character token lookup. Returns TkEof as "no match" sentinel.
> two_char_kind(pair: String) -> TokenKind {
    if pair == "->" { TkArrow }
    else if pair == "=>" { TkFatArrow }
    else if pair == "<-" { TkSend }
    else if pair == "|>" { TkPipeGt }
    else if pair == "?." { TkSafeCall }
    else if pair == "?:" { TkElvis }
    else if pair == "==" { TkOp }
    else if pair == "!=" { TkOp }
    else if pair == ">=" { TkOp }
    else if pair == "<=" { TkOp }
    else if pair == "&&" { TkOp }
    else if pair == "||" { TkOp }
    else { TkEof }
}

-- Single-character token lookup (non-context-sensitive). TkEof = no match.
> one_char_kind(ch: String) -> TokenKind {
    if ch == "(" { TkLParen }
    else if ch == ")" { TkRParen }
    else if ch == "{" { TkLBrace }
    else if ch == "}" { TkRBrace }
    else if ch == "[" { TkLBracket }
    else if ch == "]" { TkRBracket }
    else if ch == "." { TkDot }
    else if ch == "," { TkComma }
    else if ch == ":" { TkColon }
    else if ch == "&" { TkAmp }
    else if ch == "#" { TkHash }
    else if ch == "@" { TkAt }
    else if ch == "~" { TkTilde }
    else { TkEof }
}

-- Is this character an always-operator? (not context-sensitive, not a two-char prefix)
> is_simple_op(ch: String) -> Bool {
    ch == "+" || ch == "*" || ch == "/" || ch == "%" || ch == "^" || ch == "!"
}

-- Context: are we at the start of a statement?
> is_stmt_start(toks: List(Token)) -> Bool {
    if length(toks) == 0 { true }
    else {
        = last = nth(toks, length(toks) - 1)
        last.kind == TkSemi || last.kind == TkLBrace
    }
}

-- ============================================================================
-- > What happens — main tokenize loop
-- ============================================================================

> tok_loop(src: String, pos: Int, ln: Int, col: Int, toks: List(Token)) -> List(Token) {
    = w = skip_ws(src, pos, ln, col)
    = pos = w.pos
    = ln = w.line
    = col = w.col
    = ch = pk(src, pos)
    = ch2 = pk2(src, pos)
    = pair = ch + ch2
    = pair_kind = two_char_kind(pair)

    -- EOF
    if ch == "" { push(toks, Token(TkEof, "", ln, col)) }

    -- Comments: ---- block ---- or -- line
    else if ch == "-" && ch2 == "-" {
        if pk(src, pos + 2) == "-" && pk(src, pos + 3) == "-" {
            = b = skip_block(src, pos, ln, col)
            tok_loop(src, b.pos, b.line, b.col, toks)
        } else {
            = c = skip_line(src, pos, ln, col)
            tok_loop(src, c.pos, c.line, c.col, toks)
        }
    }

    -- Newline -> Semi (deduplicated)
    else if ch == "\n" {
        if length(toks) > 0 && nth(toks, length(toks) - 1).kind == TkSemi {
            tok_loop(src, pos + 1, ln + 1, 1, toks)
        } else {
            tok_loop(src, pos + 1, ln + 1, 1, push(toks, Token(TkSemi, "\\n", ln, col)))
        }
    }

    -- Two-char tokens (operators, arrows, pipes)
    else if pair_kind != TkEof {
        tok_loop(src, pos + 2, ln, col + 2, push(toks, Token(pair_kind, pair, ln, col)))
    }

    -- Context-sensitive runes: > and = are runes at statement start, operators mid-expression
    else if ch == ">" {
        = kind = if is_stmt_start(toks) { TkGt } else { TkOp }
        tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(kind, ">", ln, col)))
    }
    else if ch == "=" {
        = kind = if is_stmt_start(toks) { TkEq } else { TkOp }
        tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(kind, "=", ln, col)))
    }

    -- Remaining | and ? (two-char cases already handled above)
    else if ch == "|" { tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(TkPipe, "|", ln, col))) }
    else if ch == "?" { tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(TkOp, "?", ln, col))) }

    -- One-char tokens (delimiters, runes #@~), operators, literals, words
    else {
        = kind = one_char_kind(ch)
        if kind != TkEof { tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(kind, ch, ln, col))) }
        else if is_simple_op(ch) { tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(TkOp, ch, ln, col))) }
        else if ch == "<" || ch == "-" { tok_loop(src, pos + 1, ln, col + 1, push(toks, Token(TkOp, ch, ln, col))) }
        else if ch == "\"" {
            = r = read_str(src, pos, ln, col)
            tok_loop(src, r.pos, r.line, r.col, push(toks, r.tok))
        }
        else if ch == "'" {
            = r = read_chr(src, pos, ln, col)
            tok_loop(src, r.pos, r.line, r.col, push(toks, r.tok))
        }
        else if is_digit(ch) {
            = r = read_number(src, pos, ln, col)
            tok_loop(src, r.pos, r.line, r.col, push(toks, r.tok))
        }
        else if is_alpha(ch) || ch == "_" {
            = r = read_word(src, pos, ln, col)
            tok_loop(src, r.pos, r.line, r.col, push(toks, r.tok))
        }
        else { tok_loop(src, pos + 1, ln, col + 1, toks) }
    }
}

> tokenize(source: String) -> List(Token) {
    tok_loop(source, 0, 1, 1, [])
}

-- ============================================================================
-- > What happens — display
-- ============================================================================

> show_kind(k: TokenKind) -> String {
    match k {
        TkKW -> "KW"
        TkIdent -> "Ident"
        TkOp -> "Op"
        TkType -> "Type"
        TkLParen -> "("
        TkRParen -> ")"
        TkLBrace -> "{"
        TkRBrace -> "}"
        TkLBracket -> "["
        TkRBracket -> "]"
        TkSemi -> "Semi"
        TkDot -> "."
        TkArrow -> "->"
        TkFatArrow -> "=>"
        TkComma -> ","
        TkColon -> ":"
        TkPipe -> "|"
        TkHash -> "#"
        TkAt -> "@"
        TkGt -> ">"
        TkEq -> "="
        TkSend -> "<-"
        TkTilde -> "~"
        TkPipeGt -> "|>"
        TkSafeCall -> "?."
        TkElvis -> "?:"
        TkAmp -> "&"
        TkString -> "Str"
        TkChar -> "Char"
        TkInt -> "Int"
        TkFloat -> "Float"
        TkBool -> "Bool"
        TkEof -> "EOF"
    }
}

> show_token(t: Token) -> String {
    show_kind(t.kind) + "(" + t.text + ")" + " " + show(t.line) + ":" + show(t.col)
}

-- ============================================================================
-- Demo: tokenize a small program
-- ============================================================================

= demo = "# Point(x: Float, y: Float)\n> dist(p: Point) -> Float {\n    sqrt(p.x * p.x + p.y * p.y)\n}\n= origin = Point(0.0, 0.0)\n@ print(show(dist(origin)))\n"

= tokens = tokenize(demo)

@ print("--- Lexer: " + show(length(tokens)) + " tokens ---")
for t in tokens {
    @ print("  " + show_token(t))
}

@ print("")
@ print("Self-hosting step 1: the lexer lexes.")
