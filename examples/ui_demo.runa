-- ui_demo.runa — Conscious UI in Futuruna
--
-- This demonstrates what UI code looks like in Futuruna.
-- The syntax was designed by measuring consciousness metrics.
-- The renderer uses S_τ on the component graph (5D perception + learning).
--
-- Not yet compilable — this is the design target for the WASM backend.

-- ============================================================================
-- Type declarations: UI components are ADTs
-- ============================================================================

# State(a) = State(a)

# UI =
    Div(List(UI))
  | Text(String)
  | Button(String, State(a) -> State(a))
  | Input(String, String -> State(a) -> State(a))
  | Chart(String)
  | When(Bool, UI)

# FormState = FormState(String, String, String, Bool)

-- ============================================================================
-- Pure view functions: State → UI (no side effects)
-- ============================================================================

> field(label, value, on_change) =
  Div([
    Text(label + ":"),
    Input(value, on_change),
    When(value == "", Text("Required"))
  ])

> form(state) =
  | FormState(name, email, phone, valid) ->
    Div([
      Text("User Profile"),
      field("Name", name, |v| |s|
        | FormState(_, e, p, _) -> FormState(v, e, p, v != "" && e != "")),
      field("Email", email, |v| |s|
        | FormState(n, _, p, _) -> FormState(n, v, p, n != "" && v != "")),
      field("Phone", phone, |v| |s|
        | FormState(n, e, _, _) -> FormState(n, e, v, n != "" && e != "")),
      When(valid, Button("Submit", |s| s))
    ])

-- ============================================================================
-- Dashboard: browsing-heavy, expensive charts
-- ============================================================================

# DashState = DashState(String, Int, Int, Int, List(Int))

> kpi_card(label, value) =
  Div([Text(label), Text(show(value))])

> dashboard(state) =
  | DashState(tab, revenue, users, orders, history) ->
    Div([
      Div([
        Button("Overview", |s| | DashState(_, r, u, o, h) -> DashState("overview", r, u, o, h)),
        Button("Sales", |s| | DashState(_, r, u, o, h) -> DashState("sales", r, u, o, h)),
        Button("Users", |s| | DashState(_, r, u, o, h) -> DashState("users", r, u, o, h))
      ]),
      Div([
        kpi_card("Revenue", revenue),
        kpi_card("Users", users),
        kpi_card("Orders", orders)
      ]),
      Chart("revenue_trend"),
      Chart("user_growth")
    ])

-- ============================================================================
-- Effects: tracked, composable, first-class
-- ============================================================================

-- @ mount : mounts a component with initial state
-- @ render : triggers a render cycle (conscious: 5D perception)
-- @ fetch : network request (returns a future)
-- @ animate : requestAnimationFrame wrapper

> app() =
  @ mount(form, FormState("", "", "", False))

-- ============================================================================
-- What the conscious renderer does under the hood:
--
-- 1. Builds component graph from the UI tree
-- 2. Computes S_τ on the graph (topological importance)
-- 3. Perceives each component across 5 dimensions:
--    D1: S_τ (topological reach)
--    D2: Interaction recency (user touched recently?)
--    D3: State coupling (how many state deps?)
--    D4: Render cost (expensive chart vs cheap text?)
--    D5: Phase alignment (editing vs browsing vs searching)
-- 4. Bayesian learner decides: render or skip?
-- 5. Learns from outcomes: was the render useful?
--
-- Result: fewer renders, same visual correctness,
--         automatic layout detection, phase adaptation.
--
-- d_eff = 1 → thermostat (React)
-- d_eff = 5 → conscious (Futuruna)
-- ============================================================================
