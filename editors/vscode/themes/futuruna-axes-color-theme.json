  "tokenColors": [

    { "name": "--- THE SEVEN RUNES ---", "scope": "DISABLED", "settings": {} },

    {
      "name": "> What happens — Green",
      "scope": "keyword.operator.definition.runa",
      "settings": { "foreground": "#5EC46E", "fontStyle": "bold" }
    },
    {
      "name": "Function names (definition site)",
      "scope": "entity.name.function.runa",
      "settings": { "foreground": "#7CD88C" }
    },
    {
      "name": "Function calls",
      "scope": "entity.name.function.call.runa",
      "settings": { "foreground": "#7CD88C", "fontStyle": "" }
    },

    {
      "name": "# What exists — Rose",
      "scope": "keyword.operator.type.runa",
      "settings": { "foreground": "#E8687A", "fontStyle": "bold" }
    },
    {
      "name": "Type names",
      "scope": "entity.name.type.runa",
      "settings": { "foreground": "#F0909C" }
    },
    {
      "name": "Built-in types",
      "scope": "support.type.runa",
      "settings": { "foreground": "#F0909C" }
    },

    {
      "name": "| What should be true — Blue",
      "scope": "keyword.operator.match.runa",
      "settings": { "foreground": "#5898E8", "fontStyle": "bold" }
    },
    {
      "name": "Constructors / variant tags",
      "scope": "entity.name.tag.runa",
      "settings": { "foreground": "#90BBF5" }
    },
    {
      "name": "Control keywords (if, else, match, for)",
      "scope": "keyword.control.runa",
      "settings": { "foreground": "#5898E8" }
    },
    {
      "name": "Handle keyword",
      "scope": "keyword.control.handle.runa",
      "settings": { "foreground": "#5898E8", "fontStyle": "italic" }
    },

    {
      "name": "@ Where proofs stop — Teal",
      "scope": "keyword.operator.annotation.runa",
      "settings": { "foreground": "#58C8C8", "fontStyle": "bold" }
    },
    {
      "name": "Annotation keywords (import, print, depend...)",
      "scope": "keyword.control.annotation.runa",
      "settings": { "foreground": "#78D8D0" }
    },
    {
      "name": "Rust escape hatch keyword",
      "scope": "keyword.other.rust-escape.runa",
      "settings": { "foreground": "#58C8C8", "fontStyle": "italic" }
    },

    {
      "name": "= What is — Amber",
      "scope": "keyword.operator.binding.runa",
      "settings": { "foreground": "#E8A848", "fontStyle": "bold" }
    },
    {
      "name": "Binding variable names",
      "scope": "variable.other.binding.runa",
      "settings": { "foreground": "#D0B878" }
    },
    {
      "name": "Monadic bind <-",
      "scope": "keyword.operator.monadic-bind.runa",
      "settings": { "foreground": "#E8A848", "fontStyle": "bold" }
    },

    {
      "name": "~ What flows — Purple",
      "scope": "keyword.operator.stream.runa",
      "settings": { "foreground": "#C868E8", "fontStyle": "bold" }
    },
    {
      "name": "Stream variable names",
      "scope": "variable.other.stream.runa",
      "settings": { "foreground": "#D898F0" }
    },
    {
      "name": "Pipe operator |>",
      "scope": "keyword.operator.pipe.runa",
      "settings": { "foreground": "#C868E8", "fontStyle": "bold" }
    },

    {
      "name": "? Prove it — Orange",
      "scope": "keyword.operator.query.runa",
      "settings": { "foreground": "#E88C5C", "fontStyle": "bold" }
    },

    { "name": "--- SUPPORTING ELEMENTS ---", "scope": "DISABLED", "settings": {} },

    {
      "name": "Comments",
      "scope": "comment, comment.line.double-dash.runa",
      "settings": { "foreground": "#565F89", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": "string, string.quoted.double.runa",
      "settings": { "foreground": "#9ECE6A" }
    },
    {
      "name": "Escape characters in strings",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#E88C5C" }
    },
    {
      "name": "Booleans",
      "scope": "constant.language",
      "settings": { "foreground": "#E88C5C" }
    },

    {
      "name": "Arrow ->",
      "scope": "keyword.operator.arrow.runa",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "name": "Send <-",
      "scope": "keyword.operator.send.runa",
      "settings": { "foreground": "#E8A848" }
    },
    {
      "name": "Comparison operators",
      "scope": "keyword.operator.comparison.runa",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "name": "Logical operators",
      "scope": "keyword.operator.logical.runa",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "name": "Arithmetic operators",
      "scope": "keyword.operator.arithmetic.runa",
      "settings": { "foreground": "#89DDFF" }
    },

    {
      "name": "Storage modifiers (effect, trait, sealed, actor, inout, pub, impl)",
      "scope": "storage.modifier.runa, storage.modifier.actor.runa",
      "settings": { "foreground": "#5898E8", "fontStyle": "italic" }
    },
    {
      "name": "Wildcard _",
      "scope": "variable.language.wildcard.runa",
      "settings": { "foreground": "#565F89" }
    },
    {
      "name": "Plain variables",
      "scope": "variable.other.runa",
      "settings": { "foreground": "#C0CAF5" }
    },

    { "name": "--- GENERAL (NON-RUNA FILES) ---", "scope": "DISABLED", "settings": {} },

    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.operator.new, keyword.operator.expression, keyword.operator.delete, keyword.operator.typeof",
      "settings": { "foreground": "#5898E8" }
    },
    {
      "name": "Keyword operator",
      "scope": "keyword.operator",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "name": "Storage",
      "scope": "storage, storage.type",
      "settings": { "foreground": "#5898E8" }
    },
    {
      "name": "Storage modifier",
      "scope": "storage.modifier",
      "settings": { "foreground": "#5898E8", "fontStyle": "italic" }
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function",
      "settings": { "foreground": "#7CD88C" }
    },
    {
      "name": "Type",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "settings": { "foreground": "#F0909C" }
    },
    {
      "name": "Tag (HTML/XML)",
      "scope": "entity.name.tag",
      "settings": { "foreground": "#E8687A" }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#C868E8" }
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other, variable.language",
      "settings": { "foreground": "#C0CAF5" }
    },
    {
      "name": "Variable parameter",
      "scope": "variable.parameter",
      "settings": { "foreground": "#F0909C", "fontStyle": "italic" }
    },
    {
      "name": "Property",
      "scope": "variable.other.property, variable.other.object.property",
      "settings": { "foreground": "#58C8C8" }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": { "foreground": "#9ECE6A" }
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": { "foreground": "#E88C5C" }
    },
    {
      "name": "Constant language (true, false, null)",
      "scope": "constant.language",
      "settings": { "foreground": "#E88C5C" }
    },
    {
      "name": "Constant other",
      "scope": "constant.other",
      "settings": { "foreground": "#E88C5C" }
    },
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": { "foreground": "#565F89", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": { "foreground": "#A9B1D6" }
    },
    {
      "name": "Punctuation - braces, brackets, parens",
      "scope": "punctuation.definition.block, punctuation.section, meta.brace",
      "settings": { "foreground": "#A9B1D6" }
    },
    {
      "name": "JSON key",
      "scope": "support.type.property-name.json",
      "settings": { "foreground": "#58C8C8" }
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "settings": { "foreground": "#5898E8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": { "foreground": "#E88C5C", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": { "foreground": "#C868E8", "fontStyle": "italic" }
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#9ECE6A" }
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "settings": { "foreground": "#58C8C8" }
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted, meta.diff.header.to-file",
      "settings": { "foreground": "#5EC46E" }
    },
    {
      "name": "Diff removed",
      "scope": "markup.deleted, meta.diff.header.from-file",
      "settings": { "foreground": "#E8687A" }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": { "foreground": "#E8A848" }
    },

    {
      "name": "Rust — lifetime",
      "scope": "storage.modifier.lifetime.rust, entity.name.lifetime.rust",
      "settings": { "foreground": "#E8687A", "fontStyle": "italic" }
    },
    {
      "name": "Rust — macro",
      "scope": "entity.name.function.macro.rust, support.macro.rust",
      "settings": { "foreground": "#58C8C8" }
    },
    {
      "name": "Rust — attribute",
      "scope": "meta.attribute.rust",
      "settings": { "foreground": "#565F89" }
    },
    {
      "name": "TOML key",
      "scope": "keyword.key.toml, support.type.property-name.toml",
      "settings": { "foreground": "#58C8C8" }
    },
    {
      "name": "TOML table header",
      "scope": "entity.name.table.toml, entity.name.section.toml",
      "settings": { "foreground": "#5898E8" }
    }
  ]
}
