{
  "name": "futuruna-lang",
  "displayName": "Futuruna Language",
  "description": "Syntax highlighting, diagnostics, and code intelligence for the Futuruna programming language",
  "version": "0.4.0",
  "publisher": "futuruna",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces the language server always starts from the machine-level `futuruna.serverPath`; workspace settings cannot choose the executable.",
      "restrictedConfigurations": ["futuruna.serverPath"]
    }
  },
  "categories": ["Programming Languages", "Themes"],
  "contributes": {
    "languages": [
      {
        "id": "runa",
        "aliases": ["Futuruna", "runa"],
        "extensions": [".runa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "runa",
        "scopeName": "source.runa",
        "path": "./syntaxes/runa.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Futuruna Axes",
        "uiTheme": "vs-dark",
        "path": "./themes/futuruna-axes-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Futuruna",
      "properties": {
        "futuruna.serverPath": {
          "type": "string",
          "default": "runa",
          "scope": "machine",
          "description": "Path to the runa compiler binary. Machine setting: a workspace cannot choose the executable."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.2.0"
  }
}
